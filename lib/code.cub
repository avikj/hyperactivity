-- code.cub — codes of terms as data, and the evaluator as a term (paper 5.26).
-- Variables are de Bruijn indices (words) over one context of term and
-- dimension variables; globals are indices (words) into a signature, data types
-- and their constructors indices into its data part. (code t) writes the code of
-- a source term. eval maps a code to the value the machine gives the term; a
-- question about the evaluator is a term.
data Lst (A : Type) = lnil | lcons (x : A) (xs : Lst A)
data Opt (A : Type) = none | some (x : A)
-- binding times (a schedule's stages, lib/specialize.cub) and the reader's verdict (plan 5.4, lib/machine.cub):
-- a first-order machine program, or the construct that has none and why
data Stage = st-now | st-build | st-run-known | st-run
-- a schedule (plan 5.7): the rewrite bound, the binding-time stages, the held definitions and the
-- register assignment; its operations are in lib/specialize.cub
data Sched = sched (rewrites : Word) (stages : Lst) (holds : Lst) (regs : Lst)
data Reason = dim | dep-type | higher | kan | reflect | mult | copy | infinite
data Verdict = fo m | not-fo reason at
-- a value a code names as itself (cfree): a variable or a dimension of the checker's, which typed
-- code passes along and never reads
data CFree = cfree-opaque
data Code
  = cvar (n : Word)
  | cglob (n : Word)
  | clam (b : Code)
  | capp (f : Code) (a : Code)
  | cpair (a : Code) (b : Code)
  | cfst (p : Code)
  | csnd (p : Code)
  | cpi (m : Word) (A : Code) (B : Code)
  | csigma (A : Code) (B : Code)
  | cuniv (l : Code)
  | cpathp (A : Code) (a : Code) (b : Code)
  | cplam (b : Code)
  | cpapp (p : Code) (r : Code)
  | ci0
  | ci1
  | cneg (r : Code)
  | cmeet (r : Code) (s : Code)
  | cjoin (r : Code) (s : Code)
  | ceq0 (r : Code)
  | ceq1 (r : Code)
  | cfand (a : Code) (b : Code)
  | cfor (a : Code) (b : Code)
  | cftt
  | cfff
  | cforall (b : Code)
  | csys0
  | csysc (f : Code) (t : Code) (r : Code)
  | ccomp (A : Code) (u : Code) (a : Code)
  | cgluet (A : Code) (S : Code)
  | cglue (S : Code) (a : Code)
  | cunglue (S : Code) (b : Code)
  | chcompu (A : Code) (S : Code)
  | cunglueu (S : Code) (b : Code)
  | clet (t : Code) (b : Code)
  | cann (t : Code) (T : Code)
  | cdata (d : Word) (ps : Lst Code)
  | ccon (d : Word) (c : Word) (fs : Lst Code) (ds : Lst Code)
  | celim (d : Word) (P : Code) (B : Lst Code) (x : Code)
  | ccase (d : Word) (B : Lst Code) (x : Code)
  | chcomp (u : Code) (a : Code)
  | cdlam (b : Code)
  | cforce (t : Code)
  | cthunk (t : Code)
  | clevel
  | clzero
  | clsuc (l : Code)
  | clmax (a : Code) (b : Code)
  | cword
  | cwlit (n : Word)
  | cpty (k : Word) (n : Code)
  | cplit (k : Word) (b : Word)
  | cwsucc (a : Code)
  | cwop (k : Word) (a : Code) (b : Code)
  | cwelim (w : Code) (z : Code) (s : Code) (mo : Opt Code)   -- mo: some P, the motive's code (Word → U), or none
  | ctrans (d : Word) (psi : Code) (ls : Lst Code) (x : Code)
  | cproj (d : Word) (k : Word) (x : Code)
  | crec (d : Word) (fs : Lst Code)
  | cfree (x : CFree)
  | cclock
  | ctick (k : Code)
  | cclock0
  | ctick0
  | cprim (k : Word) (as : Lst Code)
-- a value's head as data (%view, src/net.c): its parts are the value's own parts, values;
-- data types, constructors and variables by words
data View
  = wlam f
  | wpair a b
  | wpi A B
  | wsigma A B
  | wu l
  | wpath A a b
  | wplam p
  | wiv r
  | wface a
  | wsys bs
  | wglue A S
  | wgluev S a
  | wdata d ps
  | wcon d c fs ds
  | whcomp u a
  | wvar l T
  | wapp f a T
  | wfst p T
  | wsnd p T
  | wpapp p r T
  | wcomp A u a0 T
  | wunglue S b T
  | whcompu A S
  | wunglueu S b T
  | welim d x f T
  | wtrans d psi ls x T
  | wlevel
  | wother
  | wword
  | wwlit n
  | wpty k n
  | wplit k b
  | wbytes n
  | wwplus k x
  | wwop k a b
  | wwelim x z s mo                         -- mo: some P, the motive, when written with one (%welimP)
  | wcofix n T
  | wproj d k x T
  | wrec d fs
  -- clocks, the ticks of a clock, the closed clock κ0, the tick constant ⋄
  | wclock
  | wtick k
  | wclock0
  | wtick0
  -- a primitive operation (B12) stuck on a neutral: the operation's number and its arguments
  | wprim k as
-- two λs of one record (%clos): the pairs of (copies of) their environments, and the λs; else
-- both, untouched
data CloCmp = csame ps f g | cdiff f g
-- a data type's and a global's index from a code (code D), (code f)
didx c = case c of cdata d ps → d; _ → #0
gidx c = case c of cglob n → n; _ → #0
cl-at l n = case l of lnil → l; lcons x xs → if %weq n #0 then x else cl-at xs (%wsub n #1)
cl-map f l = case l of lnil → lnil; lcons x xs → lcons (f x) (cl-map f xs)
cl-app l m = case l of lnil → m; lcons x xs → lcons x (cl-app xs m)
lapp2 l m = cl-app l m
lst-count l = case l of lnil → #0; lcons x xs → %wsucc (lst-count xs)
app-all f xs = case xs of lnil → f; lcons x r → app-all (f x) r
-- the machine's data types, for the evaluator: (dtab former constructors elim case); a data
-- type's transport as a function is the table %dtrans. A codata type's entry is (dtab former
-- projections record former): its fields' projections, and the record as a function
data DTab = dtab former cons el cs
dt-former t = case t of dtab f c e s → f
dt-cons t = case t of dtab f c e s → c
dt-elim t = case t of dtab f c e s → e
dt-case t = case t of dtab f c e s → s
-- eval-g e c: the value of code c, e the values of its variables (a list); checked definitions
-- and data types are read from the checker's tables (%gval, %dtab)
-- A primitive operation (B12) by its number k = class·256 + sub, as %view names a stuck one (wprim k as)
-- and a code names it (cprim k as): class 1 a unary operation, 2 a binary one (sub in the order of
-- lib/prim.cub's %i64add ... %wofu64, the PO_* index of src/core.h), 3 a load and 4 a store of sub bytes, 5 %blen, 6 %bytes.
-- Applied to its evaluated arguments: the machine's operation, which computes on values and stays a
-- neutral (wprim) on unknowns; so a code over the byte layer evaluates and quotes under unknowns
prim-apply k as =
  if %wlt k #512 then prim-1 (%wsub k #256) (cl-at as #0)
  else if %wlt k #768 then prim-2 (%wsub k #512) (cl-at as #0) (cl-at as #1)
  else if %wlt k #1024 then prim-ld (%wsub k #768) (cl-at as #0) (cl-at as #1)
  else if %wlt k #1280 then prim-st (%wsub k #1024) (cl-at as #0) (cl-at as #1) (cl-at as #2)
  else if %wlt k #1536 then %blen (cl-at as #0) else %bytes (cl-at as #0)
prim-1 sb a =
  if %weq sb #35 then %i64ofw a else if %weq sb #36 then %wofi64 a else if %weq sb #37 then %u32ofw a
  else if %weq sb #38 then %wofu32 a else if %weq sb #39 then %f64ofw a else if %weq sb #40 then %f64ofi64 a
  else if %weq sb #41 then %i64off64 a else if %weq sb #42 then %f64bits a else if %weq sb #43 then %f64ofbits a
  else if %weq sb #44 then %f32bits a else if %weq sb #45 then %f32ofbits a else if %weq sb #46 then %u64ofw a else %wofu64 a
prim-2 sb a b =
  if %weq sb #0 then %i64add a b else if %weq sb #1 then %i64sub a b else if %weq sb #2 then %i64mul a b
  else if %weq sb #3 then %i64eq a b else if %weq sb #4 then %i64lt a b
  else if %weq sb #5 then %u32add a b else if %weq sb #6 then %u32sub a b else if %weq sb #7 then %u32mul a b
  else if %weq sb #8 then %u32eq a b else if %weq sb #9 then %u32lt a b
  else if %weq sb #10 then %f64add a b else if %weq sb #11 then %f64sub a b else if %weq sb #12 then %f64mul a b
  else if %weq sb #13 then %f64div a b else if %weq sb #14 then %f64eq a b else if %weq sb #15 then %f64lt a b
  else if %weq sb #16 then %u64add a b else if %weq sb #17 then %u64sub a b else if %weq sb #18 then %u64mul a b
  else if %weq sb #19 then %u64eq a b else if %weq sb #20 then %u64lt a b else if %weq sb #21 then %u64div a b
  else if %weq sb #22 then %u64mod a b else if %weq sb #23 then %u64and a b else if %weq sb #24 then %u64or a b
  else if %weq sb #25 then %u64xor a b else if %weq sb #26 then %u64shl a b else if %weq sb #27 then %u64shr a b
  else if %weq sb #28 then %i64div a b else if %weq sb #29 then %i64mod a b else if %weq sb #30 then %i64and a b
  else if %weq sb #31 then %i64or a b else if %weq sb #32 then %i64xor a b else if %weq sb #33 then %i64shl a b else %i64shr a b
prim-ld w b off =
  if %weq w #1 then %load8 b off else if %weq w #2 then %load16 b off else if %weq w #4 then %load32 b off else %load64 b off
prim-st w b off v =
  if %weq w #1 then %store8 b off v else if %weq w #2 then %store16 b off v else if %weq w #4 then %store32 b off v else %store64 b off v
eval-g e c =
  case c of
    cvar n → cl-at e n
    cglob n → %gval n
    clam b → λ x → eval-g (lcons x e) b
    capp f a → eval-g e f (eval-g e a)
    cpair a b → (eval-g e a , eval-g e b)
    cfst p → fst (eval-g e p)
    csnd p → snd (eval-g e p)
    cpi m A B → %pim m (eval-g e A) (λ x → eval-g (lcons x e) B)
    csigma A B → (x : eval-g e A) × eval-g (lcons x e) B
    cuniv l → Type (eval-g e l)
    cpathp A a b → PathP (eval-g e A) (eval-g e a) (eval-g e b)
    cplam b → λ (i : I) → eval-g (lcons i e) b
    cpapp p r → eval-g e p @ eval-g e r
    ci0 → i0
    ci1 → i1
    cneg r → ~ (eval-g e r)
    cmeet r s → eval-g e r /\ eval-g e s
    cjoin r s → eval-g e r \/ eval-g e s
    ceq0 r → ((eval-g e r) = 0)
    ceq1 r → ((eval-g e r) = 1)
    cfand a b → %fand (eval-g e a) (eval-g e b)
    cfor a b → %for (eval-g e a) (eval-g e b)
    cftt → tt
    cfff → ff
    cforall b → (∀ i → (eval-g (lcons i e) b))
    csys0 → []
    csysc f t r → sys+ (eval-g e f) (eval-g e t) (eval-g e r)
    ccomp A u a → comp (eval-g e A) (eval-g e u) (eval-g e a)
    cgluet A S → Glue (eval-g e A) (eval-g e S)
    cglue S a → glue (eval-g e S) (eval-g e a)
    cunglue S b → unglue (eval-g e S) (eval-g e b)
    chcompu A S → %hcompU (eval-g e A) (eval-g e S)
    cunglueu S b → %unglueU (eval-g e S) (eval-g e b)
    clet t b → let x = eval-g e t in eval-g (lcons x e) b
    cann t T → eval-g e t
    cdata d ps → app-all (dt-former (%dtab d)) (cl-map (eval-g e) ps)
    ccon d k fs ds → 
      app-all (cl-at (dt-cons (%dtab d)) k) (cl-app (cl-map (eval-g e) fs) (cl-map (eval-g e) ds))
    celim d P B x → 
      app-all (dt-elim (%dtab d) (eval-g e P))
        (cl-app (cl-map (eval-g e) B) (lcons (eval-g e x) lnil))
    ccase d B x → 
      app-all (dt-case (%dtab d)) (cl-app (cl-map (eval-g e) B) (lcons (eval-g e x) lnil))
    chcomp u a → hcompD (eval-g e u) (eval-g e a)
    cdlam b → λ i → eval-g (lcons i e) b
    cforce t → force (eval-g e t)
    cthunk t → delay (eval-g e t)
    clevel → Level
    clzero → lzero
    clsuc l → lsuc (eval-g e l)
    clmax a b → lmax (eval-g e a) (eval-g e b)
    cword → Word
    cwlit n → n
    cpty k n → (if %weq k #4 then %bytesty (eval-g e n) else %pty k)
    cplit k b → %pval k b
    cwsucc a → %wsucc (eval-g e a)
    cwop k a b → 
      let x = eval-g e a
          y = eval-g e b
      in if %weq k #0
           then %weq x y
           else if %weq k #1
                  then %wlt x y
                  else if %weq k #2 then %wadd x y else if %weq k #3 then %wmax x y else if %weq k #4 then %wsub x y
                  else if %weq k #5 then %wmul x y else if %weq k #6 then %wdiv x y else if %weq k #7 then %wmod x y
                  else if %weq k #8 then %wand x y else if %weq k #9 then %wor x y else if %weq k #10 then %wxor x y
                  else if %weq k #11 then %wshl x y else %wshr x y
    cprim k as → prim-apply k (cl-map (eval-g e) as)
    cwelim w z s mo → (case mo of some P → %welimP (eval-g e P) (eval-g e w) (eval-g e z) (eval-g e s); none → %welim (eval-g e w) (eval-g e z) (eval-g e s))
    ctrans d psi ls x → 
      app-all (%dtrans d)
        (lcons (eval-g e psi) (cl-app (cl-map (eval-g e) ls) (lcons (eval-g e x) lnil)))
    cproj d k x → cl-at (dt-cons (%dtab d)) k (eval-g e x)
    crec d fs → app-all (dt-elim (%dtab d)) (cl-map (eval-g e) fs)
    cfree x → x
    cclock → Clock
    ctick k → Tick (eval-g e k)
    cclock0 → κ0
    ctick0 → ⋄
eval = eval-g
