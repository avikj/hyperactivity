-- lib/proc.cub — processes over a signature of commands, as terms (plan 7.1, D24–D25; the
-- inductive part). Loaded after lib/std.cub. A signature is a type of commands with a response
-- type per command; a process is a tree of commands ending in a result, here in its Church form —
-- a process is what it does to any interpretation of return and command — which needs no
-- positivity rule (18.18) and covers every process that terminates; the guarded (infinite) form is
-- the codata version and waits on 18.18. A world is a handler: a state and, per command, the
-- response and the next state; runp is the process at that interpretation. Outcomes: a process may
-- end done, or stopped by its world (a command the world refuses), which runp reports as a value.
-- ---------------------------------------------------------------- signatures and processes
Sig : Type (lsuc lzero)
Sig = (Cmd : Type) × (Cmd → Type)
Cmd : Sig → Type
Cmd S = fst S
Resp : (S : Sig) → Cmd S → Type
Resp S c = snd S c
-- the level is the level of the interpretations a process admits: a process written at every
-- level ({l : Level} → Proc {l} S A) can be interpreted into processes (level 1) by a handler
Proc : {l : Level} → Sig → Type → Type (lsuc l)
Proc {l} S A = (R : Type l) → (A → R) → ((c : Cmd S) → (Resp S c → R) → R) → R
ret : {l : Level} {S : Sig} {A : Type} → A → Proc {l} S A
ret a = λ R k h → k a
cmd : {l : Level} {S : Sig} → (c : Cmd S) → Proc {l} S (Resp S c)
cmd c = λ R k h → h c k
bind : {l : Level} {S : Sig} {A B : Type} → Proc {l} S A → (A → Proc {l} S B) → Proc {l} S B
bind p f = λ R k h → p R (λ a → f a R k h) h
-- a handler: each command of S as a process of W; a process of S becomes one of W (a world is a
-- handler into the drivers' signature; handlers compose as functions)
Handler : Sig → Sig → Type (lsuc lzero)
Handler S W = (c : Cmd S) → Proc {lzero} W (Resp S c)
handle : {S W : Sig} {A : Type} → Handler S W → Proc {lsuc lzero} S A → Proc {lzero} W A
handle hd p = p (Proc {lzero} W A) (ret {lzero} {W} {A}) (λ c k → bind {lzero} {W} {Resp S c} {A} (hd c) k)
-- ---------------------------------------------------------------- worlds and running
-- a world with state St answers a command (the response and the next state) or refuses it (the
-- state after the refusal)
World : Sig → Type → Type
World S St = (c : Cmd S) → St → Sum (Resp S c × St) St
data Outcome (A : Type) = done (a : A) | stopped
-- runp p w st: the process interpreted in the state monad over St with refusal
runp : {S : Sig} {A : Type} {St : Type} → Proc S A → World S St → St → Outcome A × St
runp p w st =
  p (St → Outcome A × St) (λ a s → (done a , s))
    (λ c k s → case w c s of inl r → k (fst r) (snd r); inr s2 → (stopped , s2))
    st
-- ---------------------------------------------------------------- readings: a key-value world
-- commands: get k, put k v; responses: a word for get, unit for put
data KV = get (k : Word) | put (k : Word) (v : Word)
kv-resp : KV → Type
kv-resp c = case c of get k → Word; put k v → Unit
KVS : Sig
KVS = (KV , kv-resp)
-- the state: an association list, as a function from keys to words (absent keys 0); the world
-- refuses puts at key 0
kv-world : World KVS (Word → Word)
kv-world c st =
  case c return (λ x → Sum (kv-resp x × (Word → Word)) (Word → Word)) of
    get k → inl (st k , st)
    put k v → (case weq k #0 of true → inr st; false → inl (unit , (λ j → case weq j k of true → v; false → st j)))
-- a process: put 1 := 5, put 2 := 7, then get 1 and get 2, returning their sum
pr1 : {l : Level} → Proc {l} KVS Word
pr1 {l} = bind {l} {KVS} {Unit} {Word} (cmd {l} {KVS} (put #1 #5)) (λ u →
     bind {l} {KVS} {Unit} {Word} (cmd {l} {KVS} (put #2 #7)) (λ u2 →
     bind {l} {KVS} {Word} {Word} (cmd {l} {KVS} (get #1)) (λ a →
     bind {l} {KVS} {Word} {Word} (cmd {l} {KVS} (get #2)) (λ b → ret {l} {KVS} {Word} (%wadd a b)))))
empty-st : Word → Word
empty-st k = #0
#same fst (runp {KVS} {Word} {Word → Word} (pr1 {lzero}) kv-world empty-st) = done #12
#same snd (runp {KVS} {Word} {Word → Word} (pr1 {lzero}) kv-world empty-st) #2 = #7
-- a refused command stops the process; the state is the one at the refusal
pr2 : {l : Level} → Proc {l} KVS Word
pr2 {l} = bind {l} {KVS} {Unit} {Word} (cmd {l} {KVS} (put #1 #5)) (λ u →
     bind {l} {KVS} {Unit} {Word} (cmd {l} {KVS} (put #0 #9)) (λ u2 → ret {l} {KVS} {Word} #1))
#same fst (runp {KVS} {Word} {Word → Word} (pr2 {lzero}) kv-world empty-st) = stopped
#same snd (runp {KVS} {Word} {Word → Word} (pr2 {lzero}) kv-world empty-st) #1 = #5
-- the monad laws hold by computation: bind (ret a) f = f a and bind p ret = p at the interpretation
#same runp {KVS} {Word} {Word → Word} (bind {lzero} {KVS} {Word} {Word} (ret {lzero} {KVS} {Word} #3) (λ a → ret {lzero} {KVS} {Word} (%wadd a #1))) kv-world empty-st = runp {KVS} {Word} {Word → Word} (ret {lzero} {KVS} {Word} #4) kv-world empty-st
-- ---------------------------------------------------------------- handlers
-- a logging handler into a signature with one more command: every put is also logged (cmd log k),
-- then performed; the handled process is run in a world that counts the logs in its state
data KVL = kv (c : KV) | log (k : Word)
kvl-resp : KVL → Type
kvl-resp c = case c of kv c2 → kv-resp c2; log k → Unit
KVLS : Sig
KVLS = (KVL , kvl-resp)
logging : Handler KVS KVLS
logging c =
  case c return (λ x → Proc {lzero} KVLS (kv-resp x)) of
    get k → cmd {lzero} {KVLS} (kv (get k))
    put k v → bind {lzero} {KVLS} {Unit} {Unit} (cmd {lzero} {KVLS} (log k)) (λ u → cmd {lzero} {KVLS} (kv (put k v)))
-- the world: the store and a log count
kvl-world : World KVLS ((Word → Word) × Word)
kvl-world c st =
  case c return (λ x → Sum (kvl-resp x × ((Word → Word) × Word)) ((Word → Word) × Word)) of
    kv c2 → (case kv-world c2 (fst st) of inl r → inl (fst r , (snd r , snd st)); inr s2 → inr (s2 , snd st))
    log k → inl (unit , (fst st , %wsucc (snd st)))
pr1-logged : Proc {lzero} KVLS Word
pr1-logged = handle {KVS} {KVLS} {Word} logging (pr1 {lsuc lzero})
#same fst (runp {KVLS} {Word} {(Word → Word) × Word} pr1-logged kvl-world (empty-st , #0)) = done #12
#same snd (snd (runp {KVLS} {Word} {(Word → Word) × Word} pr1-logged kvl-world (empty-st , #0))) = #2
-- ---------------------------------------------------------------- supervision (D25)
-- a restart strategy: given the outcome and the number of runs so far, restart or give up
data Action = restart | give-up
Strategy : Type → Type
Strategy A = Outcome A → Nat → Action
-- supervise fuel s p w st: run p; when the strategy answers restart, run it again from the state
-- the world was left in; the outcome, the state and the number of runs
supervise : {S : Sig} {A : Type} {St : Type} → Nat → Strategy A → Proc {lzero} S A → World S St → St → Outcome A × (St × Nat)
supervise fuel s p w st =
  (case fuel return (λ f → St → Nat → Outcome A × (St × Nat)) of
     zero → λ st2 n → (stopped , (st2 , n))
     suc k → λ st2 n →
       (let r = runp {S} {A} {St} p w st2
        in case s (fst r) (suc n) of
             restart → rec k (snd r) (suc n)
             give-up → (fst r , (snd r , suc n))))
  st zero
lt3 : Nat → Action
lt3 n = case n of zero → restart; suc k → (case k of zero → restart; suc k2 → (case k2 of zero → restart; suc k3 → give-up))
-- restart on stopped while fewer than three runs; never on done
upto3 : {A : Type} → Strategy A
upto3 o n = case o of done a → give-up; stopped → lt3 n
lt2 : Nat → Bool
lt2 n = case n of zero → true; suc k → (case k of zero → true; suc k2 → false)
andb2 : Bool → Bool → Bool
andb2 a b = case a of true → b; false → false
-- a world that refuses the first two puts at key 0, counting its refusals in its state
flaky : World KVS ((Word → Word) × Nat)
flaky c st =
  case c return (λ x → Sum (kv-resp x × ((Word → Word) × Nat)) ((Word → Word) × Nat)) of
    get k → inl (fst st k , st)
    put k v →
      (case andb2 (weq k #0) (lt2 (snd st)) of
         true → inr (fst st , suc (snd st))
         false → inl (unit , ((λ j → case weq j k of true → v; false → fst st j) , snd st)))
-- a process putting at key 0 then reading it: stopped twice, done on the third run, with the
-- world's refusal count at two
pr3 : {l : Level} → Proc {l} KVS Word
pr3 {l} = bind {l} {KVS} {Unit} {Word} (cmd {l} {KVS} (put #0 #9)) (λ u → bind {l} {KVS} {Word} {Word} (cmd {l} {KVS} (get #0)) (λ a → ret {l} {KVS} {Word} a))
sup3 : Outcome Word × (((Word → Word) × Nat) × Nat)
sup3 = supervise {KVS} {Word} {(Word → Word) × Nat} 5 (upto3 {Word}) (pr3 {lzero}) flaky (empty-st , zero)
#same fst sup3 = done #9
#same snd (snd sup3) = 3
#same snd (fst (snd sup3)) = 2
-- a world that always refuses: three runs, then the strategy gives up, stopped
always-refusing : World KVS Unit
always-refusing c st = case c return (λ x → Sum (kv-resp x × Unit) Unit) of get k → inl (#0 , unit); put k v → inr unit
sup-bad : Outcome Word × (Unit × Nat)
sup-bad = supervise {KVS} {Word} {Unit} 5 (upto3 {Word}) (pr3 {lzero}) always-refusing unit
#same fst sup-bad = stopped
#same snd (snd sup-bad) = 3
-- ---------------------------------------------------------------- replay (7.3)
-- a run is reproduced from the world's responses: a recording world keeps, beside its own state,
-- the responses given (encoded as words by the signature's encoder), and a replaying world answers
-- from such a record alone. The run under the replaying world has the same outcome: replay is a
-- property of the process and the responses, not of the world's internals
Encoder : Sig → Type
Encoder S = (c : Cmd S) → Resp S c → Word
Decoder : Sig → Type
Decoder S = (c : Cmd S) → Word → Resp S c
-- a refusal is recorded as absent (the list ends); responses are recorded in order (reversed)
recording : {S : Sig} {St : Type} → Encoder S → World S St → World S (St × List Word)
recording {S} {St} enc w c st =
  case w c (fst st) of
    inl r → inl (fst r , (snd r , cons (enc c (fst r)) (snd st)))
    inr s2 → inr (s2 , snd st)
-- the replaying world: the next recorded response, else a refusal
replaying : {S : Sig} → Decoder S → World S (List Word)
replaying {S} dec c log = case log of nil → inr nil; cons x rest → inl (dec c x , rest)
rev-list : {A : Type} → List A → List A → List A
rev-list l acc = (case l return (λ w → List A → List A) of nil → λ a → a; cons x r → λ a → rec r (cons x a)) acc
kv-enc : Encoder KVS
kv-enc c = case c return (λ x → kv-resp x → Word) of get k → λ w → w; put k v → λ u → #0
kv-dec : Decoder KVS
kv-dec c = case c return (λ x → Word → kv-resp x) of get k → λ w → w; put k v → λ w → unit
-- pr1 recorded under the key-value world, then replayed from the record alone: 12 both times
rec1 : Outcome Word × ((Word → Word) × List Word)
rec1 = runp {KVS} {Word} {(Word → Word) × List Word} (pr1 {lzero}) (recording {KVS} {Word → Word} kv-enc kv-world) (empty-st , nil)
#same fst rec1 = done #12
log1 : List Word
log1 = rev-list (snd (snd rec1)) nil
#same log1 = cons #0 (cons #0 (cons #5 (cons #7 nil)))
#same fst (runp {KVS} {Word} {List Word} (pr1 {lzero}) (replaying {KVS} kv-dec) log1) = done #12
-- a record cut short replays as a refusal where it ends
#same fst (runp {KVS} {Word} {List Word} (pr1 {lzero}) (replaying {KVS} kv-dec) (cons #0 (cons #0 nil))) = stopped
-- ---------------------------------------------------------------- signature inclusion (7.1)
-- an inclusion of S in T: each command of S is a command of T, with T's response read back as
-- S's. A process of S is lifted to T by transport along it: the handler that issues the included
-- command and returns the response read back, which is handle at that handler
Incl : Sig → Sig → Type
Incl S T = (f : Cmd S → Cmd T) × ((c : Cmd S) → Resp T (f c) → Resp S c)
incl-handler : {S T : Sig} → Incl S T → Handler S T
incl-handler {S} {T} i c = bind {lzero} {T} {Resp T (fst i c)} {Resp S c} (cmd {lzero} {T} (fst i c)) (λ r → ret {lzero} {T} {Resp S c} (snd i c r))
lift-proc : {S T : Sig} {A : Type} → Incl S T → Proc {lsuc lzero} S A → Proc {lzero} T A
lift-proc {S} {T} {A} i p = handle {S} {T} {A} (incl-handler {S} {T} i) p
-- ---------------------------------------------------------------- session types (7.3)
-- a protocol decides which commands are allowed after the responses so far: a predicate on the
-- trace (the commands issued with their responses, latest first) and the next command. (The
-- codata form — allowed now, and the protocol after each response — is the same thing unfolded;
-- the elaborator does not yet accept a codata type with its self-reference under a Π as a type
-- in a body, so the protocol is the predicate.) A process follows a session when, run under the
-- session's guard over any world, it is never refused; the guard is a world transformer that
-- refuses what the session does not allow and extends the trace by the response
Hist : Sig → Type
Hist S = List ((c : Cmd S) × Resp S c)
Session : Sig → Type
Session S = Hist S → Cmd S → Bool
session-guard : {S : Sig} {St : Type} → Session S → World S St → World S (Hist S × St)
session-guard {S} {St} ses w c st =
  case ses (fst st) c of
    true → (case w c (snd st) of
              inl r → inl (fst r , (cons (c , fst r) (fst st) , snd r))
              inr s2 → inr (fst st , s2))
    false → inr st
IsDone : {A : Type} → Outcome A → Type
IsDone o = case o of done a → Unit; stopped → Empty
-- a process typed by a session: the process with the fact that it follows the session over the
-- given world from the given state (the fact is decided by running it: its proof is unit)
SProc : {St : Type} (S : Sig) (A : Type) → Session S → World S St → St → Type (lsuc lzero)
SProc {St} S A ses w st = (p : Proc {lzero} S A) × IsDone {A} (fst (runp {S} {A} {Hist S × St} p (session-guard {S} {St} ses w) (nil , st)))
-- ---------------------------------------------------------------- push events (7.1)
-- the world pushes: a feed, an interrupt or a signal is a recv whose response is the next event.
-- A pushing world answers recv from its queue of events and refuses when the queue is empty
data Push (E : Type) = recv
push-resp : {E : Type} → Push E → Type
push-resp {E} c = E
PushS : Type → Sig
PushS E = (Push E , push-resp {E})
feed-world : {E : Type} → World (PushS E) (List E)
feed-world {E} c q = case q of nil → inr nil; cons e r → inl (e , r)
-- ---------------------------------------------------------------- choreographies (7.3)
-- a global protocol once, as first-order data over roles (words): a value sent from one role to
-- another, a choice made by one role between two continuations, or the end. Each binary is the
-- endpoint projection to its role: a process over the local signature (send, receive, pick a
-- label, announce it, be offered one). Projection is defined for globals meeting the
-- projectability condition, decided over the data: at a choice, every role other than the chooser
-- is either told the choice (the chooser's first step towards it in both branches is a
-- communication, so the offer that precedes it is meaningful) or behaves the same in both branches
data Chor = cend | xfer (from : Word) (to : Word) (v : Word) (k : Chor) | choice (who : Word) (l : Chor) (r : Chor)
data Loc = send (to : Word) (v : Word) | recvf (from : Word) | pick | tell (lbl : Word) | offer (from : Word)
loc-resp : Loc → Type
loc-resp c = case c of send t v → Unit; recvf f → Word; pick → Word; tell l → Unit; offer f → Word
LocS : Sig
LocS = (Loc , loc-resp)
orB : Bool → Bool → Bool
orB a b = if a then true else b
app-w : List Word → List Word → List Word
app-w xs ys = case xs of nil → ys; cons x r → cons x (rec r)
-- the roles a global mentions, as a list (with repeats)
chor-roles : Chor → List Word
chor-roles g = case g of
  cend → nil
  xfer a b v k → cons a (cons b (rec k))
  choice a l r → cons a (app-w (rec l) (rec r))
-- the endpoint projection, unguarded: a role not involved in a step skips it; the chooser picks a
-- label and announces it; another role is offered the label and follows the branch
project-raw : Word → Chor → Proc {lzero} LocS Unit
project-raw me g = case g of
  cend → ret {lzero} {LocS} {Unit} unit
  xfer a b v k →
    (case weq me a of
       true → bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (send b v)) (λ u → rec k)
       false → (case weq me b of
                  true → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (recvf a)) (λ w → rec k)
                  false → rec k))
  choice a l r →
    (case weq me a of
       true → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} pick) (λ lbl →
                bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (tell lbl)) (λ u →
                  case weq lbl #0 of true → rec l; false → rec r))
       false → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (offer a)) (λ lbl → case weq lbl #0 of true → rec l; false → rec r))
-- the projectability condition
drop-others : Word → Chor → Chor
drop-others me g = case g of
  cend → cend
  xfer a b v k → (case orB (weq me a) (weq me b) of true → xfer a b v (rec k); false → rec k)
  choice a l r → choice a (rec l) (rec r)
first-from : Word → Word → Chor → Bool
first-from me a g = case g of
  cend → false
  xfer x y v k → (case weq me y of true → weq x a; false → (case weq me x of true → false; false → rec k))
  choice x l r → false
chor-eq : Chor → Chor → Bool
chor-eq g = case g return (λ x → Chor → Bool) of
  cend → λ h → (case h of cend → true; xfer a b v k → false; choice a l r → false)
  xfer a b v k → λ h → (case h of cend → false; xfer a2 b2 v2 k2 → andB (andB (weq a a2) (weq b b2)) (andB (weq v v2) (rec k k2)); choice a2 l r → false)
  choice a l r → λ h → (case h of cend → false; xfer a2 b2 v2 k2 → false; choice a2 l2 r2 → andB (weq a a2) (andB (rec l l2) (rec r r2)))
told-or-same : Word → Word → Chor → Chor → Bool
told-or-same me a l r = orB (andB (first-from me a l) (first-from me a r)) (chor-eq (drop-others me l) (drop-others me r))
all-roles : (Word → Bool) → List Word → Bool
all-roles p rs = case rs of nil → true; cons x xs → andB (p x) (rec xs)
projectable : Chor → Bool
projectable g = case g of
  cend → true
  xfer a b v k → rec k
  choice a l r → andB (andB (rec l) (rec r)) (all-roles (λ me → if weq me a then true else told-or-same me a l r) (chor-roles (choice a l r)))
-- the projection, defined for projectable globals (the proof is by computation, unit)
Projectable : Chor → Type
Projectable g = case projectable g of true → Unit; false → Empty
project : Word → (g : Chor) → Projectable g → Proc {lzero} LocS Unit
project me g pf = project-raw me g
