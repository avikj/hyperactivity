pstep A df CD G GC n inc co lo (fqclos u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqclos u0 u1) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlam u0) ckt d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlam u0) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlam u0) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlam u0) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqapp u0 u1) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqapp u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
