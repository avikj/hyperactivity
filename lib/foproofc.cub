cpc-7 p cs = if weq p #10 then c-ld #4 cs else cpc-8 p cs
cpr-7 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-7 p as) (cpc-7 p cs)
cpr-7 A df p as cs h = cr-bif A df (weq p #10) (q-ld4 as) (c-ld #4 cs) (cpq-8 p as) (cpc-8 p cs) (cr-ld4 A df as cs h) (cpr-8 A df p as cs h)
cpq-6 : Word → KQ → KQ
cpq-6 p as = if weq p #9 then q-st8 as else cpq-7 p as
cpc-6 : Word → CV → CV
cpc-6 p cs = if weq p #9 then c-st #8 cs else cpc-7 p cs
cpr-6 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-6 p as) (cpc-6 p cs)
cpr-6 A df p as cs h = cr-bif A df (weq p #9) (q-st8 as) (c-st #8 cs) (cpq-7 p as) (cpc-7 p cs) (cr-st8 A df as cs h) (cpr-7 A df p as cs h)
cpq-5 : Word → KQ → KQ
cpq-5 p as = if weq p #8 then q-ld8 as else cpq-6 p as
cpc-5 : Word → CV → CV
cpc-5 p cs = if weq p #8 then c-ld #8 cs else cpc-6 p cs
cpr-5 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-5 p as) (cpc-5 p cs)
cpr-5 A df p as cs h = cr-bif A df (weq p #8) (q-ld8 as) (c-ld #8 cs) (cpq-6 p as) (cpc-6 p cs) (cr-ld8 A df as cs h) (cpr-6 A df p as cs h)
cpq-4 : Word → KQ → KQ
cpq-4 p as = if weq p #4 then q-ww (λ a b → dbw (wlt a b)) as else cpq-5 p as
cpc-4 : Word → CV → CV
cpc-4 p cs = if weq p #4 then c-ww (λ a b → dbw (wlt a b)) cs else cpc-5 p cs
cpr-4 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-4 p as) (cpc-4 p cs)
cpr-4 A df p as cs h = cr-bif A df (weq p #4) (q-ww (λ a b → dbw (wlt a b)) as) (c-ww (λ a b → dbw (wlt a b)) cs) (cpq-5 p as) (cpc-5 p cs) (cr-ww A df (λ a b → dbw (wlt a b)) as cs h) (cpr-5 A df p as cs h)
cpq-3 : Word → KQ → KQ
cpq-3 p as = if weq p #3 then q-ww (λ a b → dbw (weq a b)) as else cpq-4 p as
cpc-3 : Word → CV → CV
cpc-3 p cs = if weq p #3 then c-ww (λ a b → dbw (weq a b)) cs else cpc-4 p cs
cpr-3 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-3 p as) (cpc-3 p cs)
cpr-3 A df p as cs h = cr-bif A df (weq p #3) (q-ww (λ a b → dbw (weq a b)) as) (c-ww (λ a b → dbw (weq a b)) cs) (cpq-4 p as) (cpc-4 p cs) (cr-ww A df (λ a b → dbw (weq a b)) as cs h) (cpr-4 A df p as cs h)
cpq-2 : Word → KQ → KQ
cpq-2 p as = if weq p #2 then q-ww dmulw as else cpq-3 p as
cpc-2 : Word → CV → CV
cpc-2 p cs = if weq p #2 then c-ww dmulw cs else cpc-3 p cs
cpr-2 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-2 p as) (cpc-2 p cs)
cpr-2 A df p as cs h = cr-bif A df (weq p #2) (q-ww dmulw as) (c-ww dmulw cs) (cpq-3 p as) (cpc-3 p cs) (cr-ww A df dmulw as cs h) (cpr-3 A df p as cs h)
cpq-1 : Word → KQ → KQ
cpq-1 p as = if weq p #1 then q-ww wsub as else cpq-2 p as
cpc-1 : Word → CV → CV
cpc-1 p cs = if weq p #1 then c-ww wsub cs else cpc-2 p cs
cpr-1 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-1 p as) (cpc-1 p cs)
cpr-1 A df p as cs h = cr-bif A df (weq p #1) (q-ww wsub as) (c-ww wsub cs) (cpq-2 p as) (cpc-2 p cs) (cr-ww A df wsub as cs h) (cpr-2 A df p as cs h)
cpq-0 : Word → KQ → KQ
cpq-0 p as = if weq p #0 then q-ww wadd as else cpq-1 p as
cpc-0 : Word → CV → CV
cpc-0 p cs = if weq p #0 then c-ww wadd cs else cpc-1 p cs
cpr-0 : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (cpq-0 p as) (cpc-0 p cs)
cpr-0 A df p as cs h = cr-bif A df (weq p #0) (q-ww wadd as) (c-ww wadd cs) (cpq-1 p as) (cpc-1 p cs) (cr-ww A df wadd as cs h) (cpr-1 A df p as cs h)
-- q-prim is the chain from its first test, as c-prim is
cr-prim : (A : Word → Nat) (df : Word → Bool) (p : Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-prim p as) (c-prim p cs)
cr-prim A df p as cs h = cpr-0 A df p as cs h
-- ---------------------------------------------------------------- the other operations, refined
cr-proj : (A : Word → Nat) (df : Word → Bool) (j : Word) (v : KQ) (c : CV) → CR A df v c → CR A df (q-proj j v) (c-proj j c)
cr-proj A df j (kqcon d k fs) (cvcon i gs) h = cr-nth A df fs gs (snd h) (dnat j)
cr-proj A df j (kqcon d k fs) c h = Empty-rec h
cr-proj A df j v c h = unit
cr-if : (A : Word → Nat) (df : Word → Bool) (cv : KQ) (cc : CV) (a : KQ) (ca : CV) (b : KQ) (cb2 : CV) → CR A df cv cc → CR A df a ca → CR A df b cb2 → CR A df (q-if cv a b) (c-if cc ca cb2)
cr-if A df (kqw w) cc a ca b cb2 hc ha hb =
  subst {lzero} {lzero} {CV} {λ u → CR A df (q-if (kqw w) a b) (c-if u ca cb2)} {cw w} {cc} (sym hc)
    (%welimP (λ u → CR A df (%welimP (λ u2 → KQ) u b (λ m h → a)) (%welimP (λ u2 → CV) u cb2 (λ m h → ca))) w hb (λ m h → ha))
cr-if A df cv cc a ca b cb2 hc ha hb = unit
-- ---------------------------------------------------------------- names and depths
q-le-refl : (a : Nat) → q-le a a ≡ true
q-le-refl zero = λ t → true
q-le-refl (suc a) = q-le-refl a
q-le-step : (x a : Nat) → q-le x a ≡ true → q-le x (suc a) ≡ true
q-le-step zero a h = λ t → true
q-le-step (suc x) zero h = Empty-rec (false≢true h)
q-le-step (suc x) (suc a) h = q-le-step x a h
q-le-trans : (x y z : Nat) → q-le x y ≡ true → q-le y z ≡ true → q-le x z ≡ true
q-le-trans zero y z h1 h2 = λ t → true
q-le-trans (suc x) zero z h1 h2 = Empty-rec (false≢true h1)
q-le-trans (suc x) (suc y) zero h1 h2 = Empty-rec (false≢true h2)
q-le-trans (suc x) (suc y) (suc z) h1 h2 = q-le-trans x y z h1 h2
le-flip : (n d : Nat) → q-le (suc n) d ≡ false → q-le d n ≡ true
le-flip n zero h = λ t → true
le-flip zero (suc d) h = Empty-rec (true≢false h)
le-flip (suc n) (suc d) h = le-flip n d h
sub-suc : (d k : Nat) → cn-sub d (suc k) ≡ cn-sub (cn-pred d) k
sub-suc d zero = λ t → cn-pred d
sub-suc d (suc k) = cong cn-pred (sub-suc d k)
le-of-suc : (x a : Nat) → q-le (suc x) a ≡ true → q-le x a ≡ true
le-of-suc x zero h = Empty-rec (false≢true h)
le-of-suc x (suc a) h = q-le-step x a h
pred-le : (x a : Nat) → q-le x a ≡ true → q-le (cn-pred x) a ≡ true
pred-le zero a h = λ t → true
pred-le (suc x) a h = le-of-suc x a h
sub-le : (a k : Nat) → q-le (cn-sub a k) a ≡ true
sub-le a zero = q-le-refl a
sub-le a (suc k) = pred-le (cn-sub a k) a (sub-le a k)
-- variable k below d is a name below d
lt-lvl : (d k : Nat) → q-le (suc k) d ≡ true → q-le (suc (ca-lvl d k)) d ≡ true
lt-lvl zero k h = Empty-rec (false≢true h)
lt-lvl (suc d) k h = sub-le d k
neq-lt : (x m : Nat) → q-le (suc x) m ≡ true → neqb m x ≡ false
neq-lt x zero h = Empty-rec (false≢true h)
neq-lt zero (suc m) h = λ t → false
neq-lt (suc x) (suc m) h = neq-lt x m h
neqb-refl : (d : Nat) → neqb d d ≡ true
neqb-refl zero = λ t → true
neqb-refl (suc d) = neqb-refl d
qadd-0l : (m : Nat) → qadd zero m ≡ m
qadd-0l zero = λ t → zero
qadd-0l (suc m) = λ t → suc (qadd-0l m t)
get-hit : (m : Nat) (v : CV) (r : CS) → cs-get (csb m v r) m ≡ v
get-hit m v r = cong (λ b → if b then v else cs-get r m) (neqb-refl m)
get-miss : (m l : Nat) (v : CV) (r : CS) → neqb m l ≡ false → cs-get (csb m v r) l ≡ cs-get r l
get-miss m l v r h = cong (λ b → if b then v else cs-get r l) h
-- ---------------------------------------------------------------- the environments
-- the first-order environment e at depth d and the C locals s: variable k below d refined by its name
-- v<d-1-k>, nothing from d up
Corr : (Word → Nat) → (Word → Bool) → Nat → KQ → CS → Type
Corr A df d e s = ((k : Nat) → q-le (suc k) d ≡ true → CR A df (q-nth e k) (cs-get s (ca-lvl d k))) × ((k : Nat) → q-le d k ≡ true → q-nth e k ≡ kqbot)
corr-nil : (A : Word → Nat) (df : Word → Bool) → Corr A df zero kqnil csnil
corr-nil A df = ((λ k hk → Empty-rec (false≢true hk)) , (λ k hk → λ t → kqbot))
-- a declaration v<d> = c of a value refining v
corr-e1 : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : CS) (v : KQ) (c : CV) → Corr A df d e s → CR A df v c → (k : Nat) → q-le (suc k) (suc d) ≡ true → CR A df (q-nth (kqcons v e) k) (cs-get (csb d c s) (ca-lvl (suc d) k))
corr-e1 A df d e s v c h hv zero hk = subst {lzero} {lzero} {CV} {λ u → CR A df v u} {c} {cs-get (csb d c s) d} (sym (get-hit d c s)) hv
corr-e1 A df d e s v c h hv (suc k) hk =
  subst {lzero} {lzero} {Nat} {λ u → CR A df (q-nth e k) (cs-get (csb d c s) u)} {ca-lvl d k} {cn-sub d (suc k)} (sym (sub-suc d k))
    (subst {lzero} {lzero} {CV} {λ u → CR A df (q-nth e k) u} {cs-get s (ca-lvl d k)} {cs-get (csb d c s) (ca-lvl d k)}
       (sym (get-miss d (ca-lvl d k) c s (neq-lt (ca-lvl d k) d (lt-lvl d k hk)))) (fst h k hk))
corr-e2 : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : CS) (v : KQ) (c : CV) → Corr A df d e s → (k : Nat) → q-le (suc d) k ≡ true → q-nth (kqcons v e) k ≡ kqbot
corr-e2 A df d e s v c h zero hk = Empty-rec (false≢true hk)
corr-e2 A df d e s v c h (suc k) hk = snd h k hk
corr-ext : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : CS) (v : KQ) (c : CV) → Corr A df d e s → CR A df v c → Corr A df (suc d) (kqcons v e) (csb d c s)
corr-ext A df d e s v c h hv = (corr-e1 A df d e s v c h hv , corr-e2 A df d e s v c h)
-- a declaration of a name from d up hides none of the first d
corr-weaken : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : CS) (m : Nat) (c : CV) → Corr A df d e s → q-le d m ≡ true → Corr A df d e (csb m c s)
corr-weaken A df d e s m c h hm =
  ((λ k hk → subst {lzero} {lzero} {CV} {λ u → CR A df (q-nth e k) u} {cs-get s (ca-lvl d k)} {cs-get (csb m c s) (ca-lvl d k)}
                (sym (get-miss m (ca-lvl d k) c s (neq-lt (ca-lvl d k) m (q-le-trans (suc (ca-lvl d k)) d m (lt-lvl d k hk) hm)))) (fst h k hk)) ,
   snd h)
-- a chain of j values declared from v<d>, refining the chain pushed
push-corr : (A : Word → Nat) (df : Word → Bool) (j : Nat) (xs : KQ) (cs : CV) (d : Nat) (e : KQ) (s : CS) → q-isn j xs ≡ true → CR A df xs cs → Corr A df d e s → Corr A df (qadd d j) (q-push xs e) (cs-push cs d s)
push-corr A df zero kqnil cs d e s hj h he = subst {lzero} {lzero} {CV} {λ u → Corr A df d e (cs-push u d s)} {cvnil} {cs} (sym h) he
push-corr A df zero xs cs d e s hj h he = Empty-rec (false≢true hj)
push-corr A df (suc j) (kqcons x r) (cvcons y q) d e s hj h he =
  subst {lzero} {lzero} {Nat} {λ u → Corr A df u (q-push r (kqcons x e)) (cs-push q (suc d) (csb d y s))} {qadd (suc d) j} {suc (qadd d j)} (qadd-s d j)
    (push-corr A df j r q (suc d) (kqcons x e) (csb d y s) hj (snd h) (corr-ext A df d e s x y he (fst h)))
push-corr A df (suc j) (kqcons x r) cs d e s hj h he = Empty-rec h
push-corr A df (suc j) xs cs d e s hj h he = Empty-rec (false≢true hj)
-- a variable's value
var-ok : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : CS) (k : Nat) → Corr A df d e s → CR A df (q-nth e k) (cs-get s (ca-lvl d k))
var-ok A df d e s k h =
  (case q-le (suc k) d return (λ b → q-le (suc k) d ≡ b → CR A df (q-nth e k) (cs-get s (ca-lvl d k))) of
     true → λ eb → fst h k eb
     false → λ eb → subst {lzero} {lzero} {KQ} {λ v → CR A df v (cs-get s (ca-lvl d k))} {kqbot} {q-nth e k} (sym (snd h k (le-flip k d eb))) unit) (λ t → q-le (suc k) d)
-- ---------------------------------------------------------------- lists, by their length
ev-isn : (G : Word → FQ) (K : QE) (m : Nat) (t : FQ) (e : KQ) → fq-isn m t ≡ true → q-isn m (evT G K t e) ≡ true
ev-isn G K zero fqnil e h = λ i → true
ev-isn G K (suc m) (fqcons x r) e h = ev-isn G K m r e h
ev-isn G K m t e h = Empty-rec (false≢true h)
ev-isar : (G : Word → FQ) (K : QE) (m : Nat) (t : FQ) (e : KQ) → fq-isar m t ≡ true → q-isar m (evT G K t e) ≡ true
ev-isar G K zero t e h = Empty-rec (false≢true h)
ev-isar G K (suc m) t e h = ev-isn G K m t e h
ok-len : (A : Word → Nat) (df : Word → Bool) (t : FQ) → ca-ok A df t ckl ≡ true → fq-isn (fq-len t) t ≡ true
ok-len A df fqnil h = λ i → true
ok-len A df (fqcons x r) h = ok-len A df r (andr (ca-ok A df x ckt) (ca-ok A df r ckl) h)
ok-len A df t h = Empty-rec (false≢true h)
-- ---------------------------------------------------------------- loops
-- a loop body's answer: none, or a constructor, tag 0 with k fields
lres : Nat → KQ → Bool
lres k kqbot = true
lres k (kqcon d c fs) = if weq c #0 then q-isn k fs else true
lres k v = false
lres-if : (k : Nat) (cv a b : KQ) → lres k a ≡ true → lres k b ≡ true → lres k (q-if cv a b) ≡ true
lres-if k (kqw w) a b ha hb = %welimP (λ u → lres k (%welimP (λ u2 → KQ) u b (λ m h → a)) ≡ true) w hb (λ m h → ha)
lres-if k cv a b ha hb = λ t → true
lres-con : (b x y : Bool) → (if b then x else true) ≡ true → (x ≡ true → y ≡ true) → (if b then y else true) ≡ true
lres-con true x y h f = f h
lres-con false x y h f = λ t → true
lb-res : (G : Word → FQ) (K : QE) (k : Nat) (t : FQ) (e : KQ) → lbok k t ≡ true → lres k (evT G K t e) ≡ true
lb-res G K k (fqif c a b) e h = lres-if k (evT G K c e) (evT G K a e) (evT G K b e) (lb-res G K k a e (andl (lbok k a) (lbok k b) h)) (lb-res G K k b e (andr (lbok k a) (lbok k b) h))
lb-res G K k (fqlet a b) e h = lb-res G K k b (kqcons (evT G K a e) e) h
lb-res G K k (fqcon dd c fs) e h = lres-con (weq c #0) (fq-isn k fs) (q-isn k (evT G K fs e)) h (ev-isn G K k fs e)
lb-res G K k t e h = Empty-rec (false≢true h)
lstep-b : (A : Word → Nat) (df : Word → Bool) (b q cb : Bool) (X : KQ) (Y : CV) (X2 : KQ) (Y2 : CV) → (if b then q else true) ≡ true → (q ≡ true → cb ≡ true) → (q ≡ true → CR A df X Y) → CR A df X2 Y2
        → CR A df (if b then X else X2) (if b then (if cb then Y else cbot) else Y2)
lstep-b A df true q cb X Y X2 Y2 hl hq hx h2 = subst {lzero} {lzero} {Bool} {λ u → CR A df X (if u then Y else cbot)} {true} {cb} (sym (hq hl)) (hx hl)
lstep-b A df false q cb X Y X2 Y2 hl hq hx h2 = h2
cr-lstep : (A : Word → Nat) (df : Word → Bool) (k : Nat) (v : KQ) (c : CV) (cont : KQ → KQ) (cont2 : CV → CV) → CR A df v c → lres k v ≡ true
         → ((x : KQ) (y : CV) → q-isn k x ≡ true → CR A df x y → CR A df (cont x) (cont2 y)) → CR A df (q-lstep v cont) (c-lstep k c cont2)
cr-lstep A df k (kqcon d j fs) (cvcon i gs) cont cont2 h hl hc =
  subst {lzero} {lzero} {Word} {λ u → CR A df (if weq j #0 then cont fs else q-nth fs zero) (if weq u #0 then (if c-isn k gs then cont2 gs else cbot) else c-nth gs zero)} {j} {i} (fst h)
    (lstep-b A df (weq j #0) (q-isn k fs) (c-isn k gs) (cont fs) (cont2 gs) (q-nth fs zero) (c-nth gs zero) hl (cr-isn A df k fs gs (snd h)) (λ hq → hc fs gs hq (snd h)) (cr-nth A df fs gs (snd h) zero))
cr-lstep A df k (kqcon d j fs) c cont cont2 h hl hc = Empty-rec h
cr-lstep A df k v c cont cont2 h hl hc = unit
-- ---------------------------------------------------------------- closures applied, calls
-- the callee's environments: f_g(f->f[0], ..., a)
ap-corr : (A : Word → Nat) (df : Word → Bool) (m : Nat) (env : KQ) (caps : CV) (a : KQ) (a2 : CV) → q-isar m env ≡ true → CR A df env caps → CR A df a a2 → Corr A df m (kqcons a (q-push env kqnil)) (c-apenv m a2 caps)
ap-corr A df zero env caps a a2 hi h ha = Empty-rec (false≢true hi)
ap-corr A df (suc m) env caps a a2 hi h ha =
  corr-ext A df m (q-push env kqnil) (cs-push caps zero csnil) a a2
    (subst {lzero} {lzero} {Nat} {λ u → Corr A df u (q-push env kqnil) (cs-push caps zero csnil)} {qadd zero m} {m} (qadd-0l m) (push-corr A df m env caps zero kqnil csnil hi h (corr-nil A df))) ha
clo-df : (A : Word → Nat) (df : Word → Bool) (g : Word) (env : KQ) → cr-clo A df g env ≡ true → df g ≡ true
clo-df A df g env h = andl (df g) (andbt (wlt g #1000000) (q-isar (A g) env)) h
clo-ar : (A : Word → Nat) (df : Word → Bool) (g : Word) (env : KQ) → cr-clo A df g env ≡ true → q-isar (A g) env ≡ true
clo-ar A df g env h = andr (wlt g #1000000) (q-isar (A g) env) (andr (df g) (andbt (wlt g #1000000) (q-isar (A g) env)) h)
clo-c : (A : Word → Nat) (df CD : Word → Bool) → ((g : Word) → df g ≡ true → CD g ≡ true) → (g : Word) (env : KQ) (caps : CV) → cr-clo A df g env ≡ true → CR A df env caps
      → andbt (CD g) (andbt (wlt g #1000000) (c-isar (A g) caps)) ≡ true
clo-c A df CD inc g env caps h hc =
  andt-i (CD g) (andbt (wlt g #1000000) (c-isar (A g) caps)) (inc g (clo-df A df g env h))
    (andt-i (wlt g #1000000) (c-isar (A g) caps) (andl (wlt g #1000000) (q-isar (A g) env) (andr (df g) (andbt (wlt g #1000000) (q-isar (A g) env)) h))
       (cr-isar A df (A g) env caps hc (clo-ar A df g env h)))
-- the calls at fuel n refined: every defined key's body, in refining parameters
CallOK : (Word → Nat) → (Word → Bool) → (Word → Bool) → (Word → FQ) → (Word → CA) → Nat → Type
CallOK A df CD G GC n = (g : Word) (e2 : KQ) (s2 : CS) → df g ≡ true → Corr A df (A g) e2 s2 → CR A df (qe-ev (qeN G n) (G g) e2) (ce-ev (ceN GC A CD n) (GC g) s2)
cr-ap1 : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) (n : Nat) → ((g : Word) → df g ≡ true → CD g ≡ true) → CallOK A df CD G GC n
       → (f : KQ) (f2 : CV) (a : KQ) (a2 : CV) → CR A df f f2 → CR A df a a2 → CR A df (q-ap1 G (qeN G n) f a) (c-ap1 GC A CD (ceN GC A CD n) f2 a2)
cr-ap1 A df CD G GC n inc co (kqclos g env) (cclo g2 caps) a a2 h ha =
  subst {lzero} {lzero} {Word} {λ u → CR A df (qe-ev (qeN G n) (G g) (kqcons a (q-push env kqnil))) (if andbt (CD u) (andbt (wlt u #1000000) (c-isar (A u) caps)) then ce-ev (ceN GC A CD n) (GC u) (c-apenv (A u) a2 caps) else cbot)} {g} {g2} (fst (fst h))
    (subst {lzero} {lzero} {Bool} {λ b → CR A df (qe-ev (qeN G n) (G g) (kqcons a (q-push env kqnil))) (if b then ce-ev (ceN GC A CD n) (GC g) (c-apenv (A g) a2 caps) else cbot)} {true} {andbt (CD g) (andbt (wlt g #1000000) (c-isar (A g) caps))}
       (sym (clo-c A df CD inc g env caps (snd (fst h)) (snd h)))
       (co g (kqcons a (q-push env kqnil)) (c-apenv (A g) a2 caps) (clo-df A df g env (snd (fst h))) (ap-corr A df (A g) env caps a a2 (clo-ar A df g env (snd (fst h))) (snd h) ha)))
cr-ap1 A df CD G GC n inc co (kqclos g env) f2 a a2 h ha = Empty-rec h
cr-ap1 A df CD G GC n inc co (kqlam b env) f2 a a2 h ha = Empty-rec h
cr-ap1 A df CD G GC n inc co f f2 a a2 h ha = unit
cr-app : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) (n : Nat) → ((g : Word) → df g ≡ true → CD g ≡ true) → CallOK A df CD G GC n
       → (m : Nat) (as : KQ) (cs : CV) (f : KQ) (f2 : CV) → q-isn m as ≡ true → CR A df as cs → CR A df f f2 → CR A df (q-app G (qeN G n) as f) (c-appl GC A CD (ceN GC A CD n) cs f2)
cr-app A df CD G GC n inc co (suc m) (kqcons a r) (cvcons a2 q) f f2 hm h hf =
  cr-app A df CD G GC n inc co m r q (q-ap1 G (qeN G n) f a) (c-ap1 GC A CD (ceN GC A CD n) f2 a2) hm (snd h) (cr-ap1 A df CD G GC n inc co f f2 a a2 hf (fst h))
cr-app A df CD G GC n inc co zero kqnil cs f f2 hm h hf = subst {lzero} {lzero} {CV} {λ u → CR A df f (c-appl GC A CD (ceN GC A CD n) u f2)} {cvnil} {cs} (sym h) hf
cr-app A df CD G GC n inc co (suc m) (kqcons a r) cs f f2 hm h hf = Empty-rec h
cr-app A df CD G GC n inc co m as cs f f2 hm h hf = Empty-rec (false≢true hm)
-- the loops at fuel n refined: from a state of k values refining one another, a body answering its
-- state's shape, in refining environments
LoopOK : (Word → Nat) → (Word → Bool) → (Word → Bool) → (Word → FQ) → (Word → CA) → Nat → Type
LoopOK A df CD G GC n = (k : Nat) (st : KQ) (st2 : CV) (b : FQ) (d : Nat) (e : KQ) (s : CS) → q-isn k st ≡ true → CR A df st st2 → ca-ok A df b ckt ≡ true → lbok k b ≡ true → Corr A df d e s
  → CR A df (qe-lp (qeN G n) st b e) (ce-lp (ceN GC A CD n) d k st2 (fq-to-ca b ckt (qadd d k)) s)
-- ---------------------------------------------------------------- the theorem
-- what is shown of a term in each mode: a term or a list, its value refined; alternatives, theirs with
-- the scrutinee on top refined by x; a loop's state declared from v<l> (l from d up), its values refined
okm : CK → CK
okm ckt = ckt
okm ckl = ckl
okm cka = cka
okm (ckd l) = ckl
-- the extra premise of each mode: for alternatives, the scrutinee refined; for declarations from v<l>,
-- l from d up
CPre : (Word → Nat) → (Word → Bool) → CK → Nat → Type
CPre A df ckt d = Unit
CPre A df ckl d = Unit
CPre A df cka d = (v : KQ) × ((c : CV) × CR A df v c)
CPre A df (ckd l) d = q-le d l ≡ true
CGoal : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) (n : Nat) (m : CK) (t : FQ) (d : Nat) (e : KQ) (s : CS) → CPre A df m d → Type
CGoal A df CD G GC n ckt t d e s x = CR A df (evT G (qeN G n) t e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca t ckt d) s)
CGoal A df CD G GC n ckl t d e s x = CR A df (evT G (qeN G n) t e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca t ckl d) s)
CGoal A df CD G GC n cka t d e s x = CR A df (evT G (qeN G n) t (kqcons (fst x) e)) (cevT GC A CD (ceN GC A CD n) (fq-to-ca t cka d) (csx (fst (snd x)) s))
CGoal A df CD G GC n (ckd l) t d e s x = CR A df (evT G (qeN G n) t e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca t (ckd l) d) s)
-- a case alternative: the tag picked, the fields counted and declared from v<d>
alt-b : (A : Word → Nat) (df : Word → Bool) (bq bc : Bool) (X : KQ) (Y : CV) → (bq ≡ true → bc ≡ true) → (bq ≡ true → CR A df X Y) → CR A df (if bq then X else kqbot) (if bc then Y else cbot)
alt-b A df true bc X Y hb hx = subst {lzero} {lzero} {Bool} {λ u → CR A df X (if u then Y else cbot)} {true} {bc} (sym (hb (λ i → true))) (hx (λ i → true))
alt-b A df false bc X Y hb hx = unit
cr-alt : (A : Word → Nat) (df : Word → Bool) (j : Word) (k d : Nat) (e : KQ) (s : CS) (v : KQ) (c : CV) (fb : KQ → KQ) (fc : CS → CV) (R : KQ) (Rc : CV) → CR A df v c → CR A df R Rc
       → ((fs : KQ) (gs : CV) → q-isn k fs ≡ true → CR A df fs gs → CR A df (fb (q-push fs e)) (fc (cs-push gs d (csx c s))))
       → CR A df (q-altsel j k fb R (kqcons v e)) (c-altsel j k d fc Rc (csx c s))
cr-alt A df j k d e s (kqcon dd i fs) (cvcon i2 gs) fb fc R Rc h hr hb =
  subst {lzero} {lzero} {Word} {λ u → CR A df (if weq i j then (if q-isn k fs then fb (q-push fs e) else kqbot) else R) (if weq u j then (if c-isn k gs then fc (cs-push gs d (csx (cvcon i2 gs) s)) else cbot) else Rc)} {i} {i2} (fst h)
    (cr-bif A df (weq i j) (if q-isn k fs then fb (q-push fs e) else kqbot) (if c-isn k gs then fc (cs-push gs d (csx (cvcon i2 gs) s)) else cbot) R Rc
       (alt-b A df (q-isn k fs) (c-isn k gs) (fb (q-push fs e)) (fc (cs-push gs d (csx (cvcon i2 gs) s))) (cr-isn A df k fs gs (snd h)) (λ hq → hb fs gs hq (snd h))) hr)
cr-alt A df j k d e s (kqcon dd i fs) c fb fc R Rc h hr hb = Empty-rec h
cr-alt A df j k d e s v c fb fc R Rc h hr hb = unit
-- every form at fuel n, given the calls and loops at fuel n
pstep : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) (n : Nat) → ((g : Word) → df g ≡ true → CD g ≡ true) → CallOK A df CD G GC n → LoopOK A df CD G GC n
      → (t : FQ) (m : CK) (d : Nat) (e : KQ) (s : CS) → ca-ok A df t (okm m) ≡ true → Corr A df d e s → (x : CPre A df m d) → CGoal A df CD G GC n m t d e s x
pstep A df CD G GC n inc co lo (fql w) ckt d e s hk h x = λ i → cw w
pstep A df CD G GC n inc co lo (fqv k) ckt d e s hk h x = var-ok A df d e s k h
pstep A df CD G GC n inc co lo (fqprim p as) ckt d e s hk h x = cr-prim A df p (evT G (qeN G n) as e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca as ckl d) s) (pstep A df CD G GC n inc co lo as ckl d e s hk h unit)
pstep A df CD G GC n inc co lo (fqlet a b) ckt d e s hk h x =
  pstep A df CD G GC n inc co lo b ckt (suc d) (kqcons (evT G (qeN G n) a e) e) (csb d (cevT GC A CD (ceN GC A CD n) (fq-to-ca a ckt d) s) s) (andr (ca-ok A df a ckt) (ca-ok A df b ckt) hk)
    (corr-ext A df d e s (evT G (qeN G n) a e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca a ckt d) s) h (pstep A df CD G GC n inc co lo a ckt d e s (andl (ca-ok A df a ckt) (ca-ok A df b ckt) hk) h unit)) unit
pstep A df CD G GC n inc co lo (fqcon dd c fs) ckt d e s hk h x = ((λ i → c) , pstep A df CD G GC n inc co lo fs ckl d e s hk h unit)
pstep A df CD G GC n inc co lo (fqproj dd c j y) ckt d e s hk h x = cr-proj A df j (evT G (qeN G n) y e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca y ckt d) s) (pstep A df CD G GC n inc co lo y ckt d e s hk h unit)
pstep A df CD G GC n inc co lo (fqsw y alts) ckt d e s hk h x =
  pstep A df CD G GC n inc co lo alts cka d e s (andr (ca-ok A df y ckt) (ca-ok A df alts cka) hk) h ((evT G (qeN G n) y e) , ((cevT GC A CD (ceN GC A CD n) (fq-to-ca y ckt d) s) , pstep A df CD G GC n inc co lo y ckt d e s (andl (ca-ok A df y ckt) (ca-ok A df alts cka) hk) h unit))
pstep A df CD G GC n inc co lo (fqif c a b) ckt d e s hk h x =
  cr-if A df (evT G (qeN G n) c e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca c ckt d) s) (evT G (qeN G n) a e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca a ckt d) s) (evT G (qeN G n) b e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca b ckt d) s)
    (pstep A df CD G GC n inc co lo c ckt d e s (andl (ca-ok A df c ckt) (andbt (ca-ok A df a ckt) (ca-ok A df b ckt)) hk) h unit)
    (pstep A df CD G GC n inc co lo a ckt d e s (andl (ca-ok A df a ckt) (ca-ok A df b ckt) (andr (ca-ok A df c ckt) (andbt (ca-ok A df a ckt) (ca-ok A df b ckt)) hk)) h unit)
    (pstep A df CD G GC n inc co lo b ckt d e s (andr (ca-ok A df a ckt) (ca-ok A df b ckt) (andr (ca-ok A df c ckt) (andbt (ca-ok A df a ckt) (ca-ok A df b ckt)) hk)) h unit)
pstep A df CD G GC n inc co lo (fqclos g env) ckt d e s hk h x =
  (((λ i → g) ,
    andt-i (df g) (andbt (wlt g #1000000) (q-isar (A g) (evT G (qeN G n) env e))) (andl (df g) (andbt (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl))) hk)
      (andt-i (wlt g #1000000) (q-isar (A g) (evT G (qeN G n) env e))
         (andl (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl)) (andr (df g) (andbt (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl))) hk))
         (ev-isar G (qeN G n) (A g) env e (andl (fq-isar (A g) env) (ca-ok A df env ckl) (andr (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl)) (andr (df g) (andbt (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl))) hk)))))) ,
   pstep A df CD G GC n inc co lo env ckl d e s (andr (fq-isar (A g) env) (ca-ok A df env ckl) (andr (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl)) (andr (df g) (andbt (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl))) hk))) h unit)
pstep A df CD G GC n inc co lo (fqapp f as) ckt d e s hk h x =
  cr-app A df CD G GC n inc co (fq-len as) (evT G (qeN G n) as e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca as ckl d) s) (evT G (qeN G n) f e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca f ckt d) s)
    (ev-isn G (qeN G n) (fq-len as) as e (ok-len A df as (andr (ca-ok A df f ckt) (ca-ok A df as ckl) hk)))
    (pstep A df CD G GC n inc co lo as ckl d e s (andr (ca-ok A df f ckt) (ca-ok A df as ckl) hk) h unit)
    (pstep A df CD G GC n inc co lo f ckt d e s (andl (ca-ok A df f ckt) (ca-ok A df as ckl) hk) h unit)
pstep A df CD G GC n inc co lo (fqcall g as) ckt d e s hk h x =
  co g (q-push (evT G (qeN G n) as e) kqnil) (cs-push (cevT GC A CD (ceN GC A CD n) (fq-to-ca as ckl d) s) zero csnil) (andl (df g) (andbt (fq-isn (A g) as) (ca-ok A df as ckl)) hk)
    (subst {lzero} {lzero} {Nat} {λ u → Corr A df u (q-push (evT G (qeN G n) as e) kqnil) (cs-push (cevT GC A CD (ceN GC A CD n) (fq-to-ca as ckl d) s) zero csnil)} {qadd zero (A g)} {A g} (qadd-0l (A g))
       (push-corr A df (A g) (evT G (qeN G n) as e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca as ckl d) s) zero kqnil csnil
          (ev-isn G (qeN G n) (A g) as e (andl (fq-isn (A g) as) (ca-ok A df as ckl) (andr (df g) (andbt (fq-isn (A g) as) (ca-ok A df as ckl)) hk)))
          (pstep A df CD G GC n inc co lo as ckl d e s (andr (fq-isn (A g) as) (ca-ok A df as ckl) (andr (df g) (andbt (fq-isn (A g) as) (ca-ok A df as ckl)) hk)) h unit)
          (corr-nil A df)))
pstep A df CD G GC n inc co lo (fqloop init b) ckt d e s hk h x =
  lo (fq-len init) (evT G (qeN G n) init e) (cevT GC A CD (ceN GC A CD n) (fq-to-ca init (ckd d) d) s) b d e s
    (ev-isn G (qeN G n) (fq-len init) init e (ok-len A df init (andl (ca-ok A df init ckl) (andbt (lbok (fq-len init) b) (ca-ok A df b ckt)) hk)))
    (pstep A df CD G GC n inc co lo init (ckd d) d e s (andl (ca-ok A df init ckl) (andbt (lbok (fq-len init) b) (ca-ok A df b ckt)) hk) h (q-le-refl d))
    (andr (lbok (fq-len init) b) (ca-ok A df b ckt) (andr (ca-ok A df init ckl) (andbt (lbok (fq-len init) b) (ca-ok A df b ckt)) hk))
    (andl (lbok (fq-len init) b) (ca-ok A df b ckt) (andr (ca-ok A df init ckl) (andbt (lbok (fq-len init) b) (ca-ok A df b ckt)) hk)) h
pstep A df CD G GC n inc co lo fqanone ckt d e s hk h x = unit
pstep A df CD G GC n inc co lo fqnet ckt d e s hk h x = unit
pstep A df CD G GC n inc co lo fqnil ckl d e s hk h x = λ i → cvnil
pstep A df CD G GC n inc co lo (fqcons y r) ckl d e s hk h x =
  (pstep A df CD G GC n inc co lo y ckt d e s (andl (ca-ok A df y ckt) (ca-ok A df r ckl) hk) h unit , pstep A df CD G GC n inc co lo r ckl d e s (andr (ca-ok A df y ckt) (ca-ok A df r ckl) hk) h unit)
pstep A df CD G GC n inc co lo (fqalt j k b r) cka d e s hk h x =
  cr-alt A df j k d e s (fst x) (fst (snd x)) (λ e2 → evT G (qeN G n) b e2) (λ s2 → cevT GC A CD (ceN GC A CD n) (fq-to-ca b ckt (qadd d k)) s2)
    (evT G (qeN G n) r (kqcons (fst x) e)) (cevT GC A CD (ceN GC A CD n) (fq-to-ca r cka d) (csx (fst (snd x)) s)) (snd (snd x))
    (pstep A df CD G GC n inc co lo r cka d e s (andr (ca-ok A df b ckt) (ca-ok A df r cka) hk) h x)
    (λ fs gs hq hfs → pstep A df CD G GC n inc co lo b ckt (qadd d k) (q-push fs e) (cs-push gs d (csx (fst (snd x)) s)) (andl (ca-ok A df b ckt) (ca-ok A df r cka) hk)
                        (push-corr A df k fs gs d e (csx (fst (snd x)) s) hq hfs h) unit)
pstep A df CD G GC n inc co lo fqanone cka d e s hk h x = unit
pstep A df CD G GC n inc co lo fqnil (ckd l) d e s hk h x = λ i → cvnil
pstep A df CD G GC n inc co lo (fqcons y r) (ckd l) d e s hk h x =
  (pstep A df CD G GC n inc co lo y ckt d e s (andl (ca-ok A df y ckt) (ca-ok A df r ckl) hk) h unit ,
   pstep A df CD G GC n inc co lo r (ckd (suc l)) d e (csb l (cevT GC A CD (ceN GC A CD n) (fq-to-ca y ckt d) s) s) (andr (ca-ok A df y ckt) (ca-ok A df r ckl) hk)
     (corr-weaken A df d e s l (cevT GC A CD (ceN GC A CD n) (fq-to-ca y ckt d) s) h x) (q-le-step d l x))
pstep A df CD G GC n inc co lo (fql u0) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fql u0) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fql u0) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqv u0) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqv u0) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqv u0) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqprim u0 u1) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqprim u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqprim u0 u1) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlet u0 u1) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlet u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqlet u0 u1) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqcon u0 u1 u2) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqcon u0 u1 u2) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqcon u0 u1 u2) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqproj u0 u1 u2 u3) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqproj u0 u1 u2 u3) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqproj u0 u1 u2 u3) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqsw u0 u1) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqsw u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqsw u0 u1) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
