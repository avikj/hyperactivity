-- lib/foproofc.cub — the C link of the justifying path (plan 18.5 step 7, B15/B16): from the first-order
-- form's checked meaning (lib/foproofq.cub's FQ and evq) to the C the back end prints. CA is the C
-- subset lib/emitc.cub prints, as checked syntax: every construct is one shape of emitted C text, its
-- local names (v<l>) explicit; evc is that subset's meaning, on C's own values (cells: a word, a
-- constructor cell, a closure cell, a byte string; no kinds, no data-type indices) and named locals
-- with C's block scoping; fq-to-ca the checked translation; ca-sound proves it right (whatever the
-- first-order form computes, the C computes, at every fuel); ca-to-c prints CA as C text, construct for
-- construct, and is with gcc what stays outside the path.
-- Loaded after lib/foproofq.cub; tested on its own line (tests/foproofc.cub, tests/foproofc-progs.cub).
--
-- The subset is narrower than C, and evc stricter than C, at these points (each a place where evc has
-- no value, so nothing is claimed there; wherever evc has a value the emitted C computes it):
--   * the runtime's operations (mkw, mkc, mkb, ld64, ld32, st64, st32 and the n<p> helpers of
--     lib/emitc.cub's s-runtime) are taken at their specification: c-prim, one clause per primitive,
--     the same machine functions as the mirrors' (two's complement Int64, IEEE Float64 by bits);
--     malloc and calloc never fail;
--   * an operation on a cell of the wrong shape (a word operation on a constructor cell, a load from a
--     word, a field of a word, a ternary on a non-word) has no value in evc, where C would read the
--     cell's n field or a stray pointer;
--   * a switch whose scrutinee matches no case, or matches with a field count other than the case's,
--     has no value (C: the default arm's mkw(0), or reads past the cell);
--   * a loop body answering a continuing cell with a field count other than the state's, or a cell
--     that is not a constructor, has no value;
--   * apply on a closure whose key has no dispatcher case, a key from 1000000 up (the dispatcher's tag
--     arithmetic), or a capture count other than its definition's parameters less one, has no value;
--   * a call's argument count is its definition's (an ill-formed call does not compile: ca-ok);
--   * reading a local that is not in scope has no value; locals are never assigned except a loop's
--     state, which is modelled as its rebinding at each turn (no local's address is ever taken);
--   * constructor and closure cells are immutable (the proved route emits no in-place store).
-- ---------------------------------------------------------------- the syntax
-- caw w            mkw(w)
-- cav l            v<l>
-- caprim p as      the runtime's operation p on as (prim-c's text)
-- cablk l a b      ({ V *v<l> = a; b; })
-- cacon c fs       mkc(c, n, fs)
-- caproj k x       x->f[k]
-- casw x alts      ({ V *r; V *x = x; switch (x->tag - 1) { alts default: r = mkw(0); } r; })
-- caalt c n l b r  case c: { V *v<l> = x->f[0]; ... V *v<l+n-1> = x->f[n-1]; r = b; break; } r
-- canone           the end of the alternatives
-- caif c a b       ((c->n != 0) ? (a) : (b))
-- caclo g caps     mkc(999999 + g, n, caps)
-- caap f as        apply(apply(f, a0), a1) ...
-- cacall g as      f_g(as)
-- caloop l k i b   ({ V *r; i for (;;) { V *b = b; if (b->tag == 1) { v<l> = b->f[0]; ... } else { r = b->f[0]; break; } } r; })
-- cadecl l x r     V *v<l> = x; r  (a loop's state, declared in order)
-- canil, cacons    argument lists
-- caunsup          unsupported()
data CA = caw (w : Word) | cav (l : Nat) | caprim (p : Word) (as : CA) | cablk (l : Nat) (a : CA) (b : CA) | cacon (c : Word) (fs : CA) | caproj (k : Word) (x : CA) | casw (x : CA) (alts : CA) | caalt (c : Word) (n : Nat) (l : Nat) (b : CA) (r : CA) | canone | caif (c : CA) (a : CA) (b : CA) | caclo (g : Word) (caps : CA) | caap (f : CA) (as : CA) | cacall (g : Word) (as : CA) | caloop (l : Nat) (k : Nat) (init : CA) (b : CA) | cadecl (l : Nat) (x : CA) (r : CA) | canil | cacons (x : CA) (r : CA) | caunsup
-- ---------------------------------------------------------------- C's values and locals
-- a word cell (tag 0, n the word); a constructor cell (tag c + 1, its fields); a closure cell (tag
-- 1000000 + g, its captures); a byte string (tag 2, its bytes as the mirrors model them); chains for a
-- cell's fields and for argument lists; cbot no value
data CV = cw (n : Word) | cvcon (c : Word) (fs : CV) | cclo (g : Word) (caps : CV) | cb (l : BL) | cvnil | cvcons (x : CV) (r : CV) | cbot
-- the locals in scope, innermost first: v<l> bound to a value, or the switch's x
data CS = csnil | csb (l : Nat) (v : CV) (r : CS) | csx (v : CV) (r : CS)
-- v<l>: the innermost binding of the name
cs-get : CS → Nat → CV
cs-get csnil l = cbot
cs-get (csb m v r) l = if neqb m l then v else cs-get r l
cs-get (csx v r) l = cs-get r l
-- x: the innermost switch's scrutinee
cs-x : CS → CV
cs-x csnil = cbot
cs-x (csb m v r) = cs-x r
cs-x (csx v r) = v
-- a chain's values declared as v<l>, v<l+1>, ...
cs-push : CV → Nat → CS → CS
cs-push (cvcons v r) l s = cs-push r (suc l) (csb l v s)
cs-push cvnil l s = s
cs-push (cw n) l s = s
cs-push (cvcon c fs) l s = s
cs-push (cclo g caps) l s = s
cs-push (cb b) l s = s
cs-push cbot l s = s
c-nth : CV → Nat → CV
c-nth (cvcons x r) zero = x
c-nth (cvcons x r) (suc k) = c-nth r k
c-nth cvnil k = cbot
c-nth (cw n) k = cbot
c-nth (cvcon c fs) k = cbot
c-nth (cclo g caps) k = cbot
c-nth (cb b) k = cbot
c-nth cbot k = cbot
c-isn : Nat → CV → Bool
c-isn zero cvnil = true
c-isn (suc m) (cvcons x r) = c-isn m r
c-isn n v = false
c-isar : Nat → CV → Bool
c-isar zero v = false
c-isar (suc m) v = c-isn m v
-- ---------------------------------------------------------------- the runtime's operations
-- a binary operation on two word cells (the C reads both n fields: every fixed-width and floating
-- operation is on the words, Int64 and Float64 by their bits)
c-ww : (Word → Word → Word) → CV → CV
c-ww f (cvcons (cw a) (cvcons (cw b) cvnil)) = cw (f a b)
c-ww f v = cbot
c-1 : (CV → CV) → CV → CV
c-1 f (cvcons a cvnil) = f a
c-1 f v = cbot
-- a unary operation on a word cell
c-wm : (Word → Word) → CV → CV
c-wm f (cw w) = cw (f w)
c-wm f v = cbot
-- mkb(n), mkw(b->n), mkw(ld64(b, o->n)) / mkw(ld32(..)), st64(b, o->n, v->n) / st32(..)
c-bytes : CV → CV
c-bytes (cw n) = cb (blm n bzero)
c-bytes v = cbot
c-blen : CV → CV
c-blen (cb l) = cw (bl-len l)
c-blen v = cbot
c-ld : Word → CV → CV
c-ld w (cvcons (cb l) (cvcons (cw o) cvnil)) = cw (bl-ld w o l)
c-ld w v = cbot
c-st : Word → CV → CV
c-st w (cvcons (cb l) (cvcons (cw o) (cvcons (cw v) cvnil))) = cb (bl-st w o v l)
c-st w v = cbot
-- lib/foproofq.cub's q-prim on cells, primitive for primitive (the identity conversions are the
-- runtime's n25, n26, n32, n33, which return their word)
c-prim : Word → CV → CV
c-prim p as =
  if weq p #0 then c-ww wadd as
  else if weq p #1 then c-ww wsub as
  else if weq p #2 then c-ww dmulw as
  else if weq p #3 then c-ww (λ a b → dbw (weq a b)) as
  else if weq p #4 then c-ww (λ a b → dbw (wlt a b)) as
  else if weq p #8 then c-ld #8 as
  else if weq p #9 then c-st #8 as
  else if weq p #10 then c-ld #4 as
  else if weq p #11 then c-st #4 as
  else if weq p #12 then c-1 c-bytes as
  else if weq p #13 then c-1 c-blen as
  else if weq p #14 then c-ww (λ a b → dib (i64add (dbi a) (dbi b))) as
  else if weq p #15 then c-ww (λ a b → dib (i64sub (dbi a) (dbi b))) as
  else if weq p #16 then c-ww (λ a b → dib (i64mul (dbi a) (dbi b))) as
  else if weq p #17 then c-ww (λ a b → dbw (i64eq (dbi a) (dbi b))) as
  else if weq p #18 then c-ww (λ a b → dbw (i64lt (dbi a) (dbi b))) as
  else if weq p #19 then c-ww (λ a b → dfb (f64add (dbf a) (dbf b))) as
  else if weq p #20 then c-ww (λ a b → dfb (f64sub (dbf a) (dbf b))) as
  else if weq p #21 then c-ww (λ a b → dfb (f64mul (dbf a) (dbf b))) as
  else if weq p #22 then c-ww (λ a b → dfb (f64div (dbf a) (dbf b))) as
  else if weq p #23 then c-ww (λ a b → dbw (f64eq (dbf a) (dbf b))) as
  else if weq p #24 then c-ww (λ a b → dbw (f64lt (dbf a) (dbf b))) as
  else if weq p #25 then c-1 (c-wm (λ w → w)) as
  else if weq p #26 then c-1 (c-wm (λ w → w)) as
  else if weq p #27 then c-1 (c-wm (λ b → dfb (f64ofi64 (dbi b)))) as
  else if weq p #28 then c-1 (c-wm (λ b → dib (i64off64 (dbf b)))) as
  else if weq p #29 then c-1 (c-wm (λ w → dfb (f64 w))) as
  else if weq p #32 then c-1 (c-wm (λ w → w)) as
  else if weq p #33 then c-1 (c-wm (λ w → w)) as
  else cbot
-- x->f[k] of a constructor cell
c-proj : Word → CV → CV
c-proj j (cvcon c fs) = c-nth fs (dnat j)
c-proj j v = cbot
-- ((c->n != 0) ? (a) : (b)), c a word cell
c-if : CV → CV → CV → CV
c-if (cw w) a b = %welimP (λ u → CV) w b (λ m h → a)
c-if v a b = cbot
-- ---------------------------------------------------------------- the meaning
-- fuel is spent where the C may not end — entering a function (a call, apply) and each turn of a loop
-- — as lib/foproofq.cub's evq spends it; CE is the meaning one unit down
data CE = ce (ev : CA → CS → CV) (lp : Nat → Nat → CV → CA → CS → CV)
ce-ev : CE → CA → CS → CV
ce-ev (ce f l) = f
ce-lp : CE → Nat → Nat → CV → CA → CS → CV
ce-lp (ce f l) = l
-- a function's parameters: apply(f, a) calls f_g(f->f[0], ..., f->f[m-2], a), the m parameters v0 ..
-- v<m-1>
c-apenv : Nat → CV → CV → CS
c-apenv zero a caps = csnil
c-apenv (suc m) a caps = csb m a (cs-push caps zero csnil)
-- apply on a closure cell: its key has a dispatcher case (CD), is below 1000000, and the cell holds its
-- definition's parameters less one
c-ap1 : (Word → CA) → (Word → Nat) → (Word → Bool) → CE → CV → CV → CV
c-ap1 GC A CD k (cclo g caps) a = if andbt (CD g) (andbt (wlt g #1000000) (c-isar (A g) caps)) then ce-ev k (GC g) (c-apenv (A g) a caps) else cbot
c-ap1 GC A CD k (cw n) a = cbot
c-ap1 GC A CD k (cvcon c fs) a = cbot
c-ap1 GC A CD k (cb b) a = cbot
c-ap1 GC A CD k cvnil a = cbot
c-ap1 GC A CD k (cvcons x r) a = cbot
c-ap1 GC A CD k cbot a = cbot
c-appl : (Word → CA) → (Word → Nat) → (Word → Bool) → CE → CV → CV → CV
c-appl GC A CD k (cvcons a r) f = c-appl GC A CD k r (c-ap1 GC A CD k f a)
c-appl GC A CD k cvnil f = f
c-appl GC A CD k (cw n) f = f
c-appl GC A CD k (cvcon c fs) f = f
c-appl GC A CD k (cclo g caps) f = f
c-appl GC A CD k (cb b) f = f
c-appl GC A CD k cbot f = f
-- a case on x (the innermost switch's): its tag the case's, exactly n fields, declared from v<l>
c-altsel : Word → Nat → Nat → (CS → CV) → CV → CS → CV
c-altsel j n l fb rest s =
  case cs-x s of
    cvcon c fs → (if weq c j then (if c-isn n fs then fb (cs-push fs l s) else cbot) else rest)
    _ → cbot
-- a loop's body has answered b: tag 1 (constructor 0) continues, its k fields the state; any other
-- constructor breaks with its field 0
c-lstep : Nat → CV → (CV → CV) → CV
c-lstep k (cvcon c fs) cont = if weq c #0 then (if c-isn k fs then cont fs else cbot) else c-nth fs zero
c-lstep k (cw n) cont = cbot
c-lstep k (cclo g caps) cont = cbot
c-lstep k (cb b) cont = cbot
c-lstep k cvnil cont = cbot
c-lstep k (cvcons x r) cont = cbot
c-lstep k cbot cont = cbot
cevT : (Word → CA) → (Word → Nat) → (Word → Bool) → CE → CA → CS → CV
cevT GC A CD k (caw w) s = cw w
cevT GC A CD k (cav l) s = cs-get s l
cevT GC A CD k (caprim p as) s = c-prim p (cevT GC A CD k as s)
cevT GC A CD k (cablk l a b) s = cevT GC A CD k b (csb l (cevT GC A CD k a s) s)
cevT GC A CD k (cacon c fs) s = cvcon c (cevT GC A CD k fs s)
cevT GC A CD k (caproj j x) s = c-proj j (cevT GC A CD k x s)
cevT GC A CD k (casw x alts) s = cevT GC A CD k alts (csx (cevT GC A CD k x s) s)
cevT GC A CD k (caalt j n l b r) s = c-altsel j n l (λ s2 → cevT GC A CD k b s2) (cevT GC A CD k r s) s
cevT GC A CD k canone s = cbot
cevT GC A CD k (caif c a b) s = c-if (cevT GC A CD k c s) (cevT GC A CD k a s) (cevT GC A CD k b s)
cevT GC A CD k (caclo g caps) s = cclo g (cevT GC A CD k caps s)
cevT GC A CD k (caap f as) s = c-appl GC A CD k (cevT GC A CD k as s) (cevT GC A CD k f s)
cevT GC A CD k (cacall g as) s = ce-ev k (GC g) (cs-push (cevT GC A CD k as s) zero csnil)
cevT GC A CD k (caloop l n init b) s = ce-lp k l n (cevT GC A CD k init s) b s
cevT GC A CD k (cadecl l x r) s = cvcons (cevT GC A CD k x s) (cevT GC A CD k r (csb l (cevT GC A CD k x s) s))
cevT GC A CD k canil s = cvnil
cevT GC A CD k (cacons x r) s = cvcons (cevT GC A CD k x s) (cevT GC A CD k r s)
cevT GC A CD k caunsup s = cbot
-- the meaning at each fuel: none at 0; at n + 1 a construct over the meaning at n, a loop's turn its
-- body at n with the state declared, continuing at n
ceN : (Word → CA) → (Word → Nat) → (Word → Bool) → Nat → CE
ceN GC A CD zero = ce (λ t s → cbot) (λ l n st b s → cbot)
ceN GC A CD (suc m) = ce (λ t s → cevT GC A CD (ceN GC A CD m) t s) (λ l n st b s → c-lstep n (cevT GC A CD (ceN GC A CD m) b (cs-push st l s)) (λ st2 → ce-lp (ceN GC A CD m) l n st2 b s))
-- the meaning of a C construct at fuel n: GC the program's functions, A their parameter counts, CD the
-- keys with a dispatcher case
evc : (Word → CA) → (Word → Nat) → (Word → Bool) → Nat → CA → CS → CV
evc GC A CD n t s = cevT GC A CD (ceN GC A CD n) t s
-- ---------------------------------------------------------------- the translation
-- a first-order term at depth d (its variable n the local v<d-1-n>); a let declares v<d>, a case's
-- fields v<d> .. v<d+n-1>, a loop's state v<d> ..; argument lists as lists, a loop's state in
-- declaration mode (ckd l: the next declared name l); the mode also says what ca-ok asks of the term
data CK = ckt | ckl | cka | ckd (l : Nat)
cn-pred : Nat → Nat
cn-pred zero = zero
cn-pred (suc m) = m
cn-sub : Nat → Nat → Nat
cn-sub a zero = a
cn-sub a (suc b) = cn-pred (cn-sub a b)
ca-lvl : Nat → Nat → Nat
ca-lvl d k = cn-sub (cn-pred d) k
fq-len : FQ → Nat
fq-len (fqcons x r) = suc (fq-len r)
fq-len t = zero
-- a list's cons: an argument list's, or a declaration (mode ckd l: v<l>, the next one v<l+1>)
ca-cons : CK → CA → CA → CA
ca-cons (ckd l) a b = cadecl l a b
ca-cons ckt a b = cacons a b
ca-cons ckl a b = cacons a b
ca-cons cka a b = cacons a b
ck-next : CK → CK
ck-next (ckd l) = ckd (suc l)
ck-next ckt = ckt
ck-next ckl = ckl
ck-next cka = cka
fq-to-ca : FQ → CK → Nat → CA
fq-to-ca (fql w) m d = caw w
fq-to-ca (fqv n) m d = cav (ca-lvl d n)
fq-to-ca (fqprim p as) m d = caprim p (fq-to-ca as ckl d)
fq-to-ca (fqlet a b) m d = cablk d (fq-to-ca a ckt d) (fq-to-ca b ckt (suc d))
fq-to-ca (fqcon dd c fs) m d = cacon c (fq-to-ca fs ckl d)
fq-to-ca (fqproj dd c k x) m d = caproj k (fq-to-ca x ckt d)
fq-to-ca (fqsw x alts) m d = casw (fq-to-ca x ckt d) (fq-to-ca alts cka d)
fq-to-ca (fqif c a b) m d = caif (fq-to-ca c ckt d) (fq-to-ca a ckt d) (fq-to-ca b ckt d)
fq-to-ca (fqclos g env) m d = caclo g (fq-to-ca env ckl d)
fq-to-ca (fqlam b) m d = caunsup
fq-to-ca (fqapp f as) m d = caap (fq-to-ca f ckt d) (fq-to-ca as ckl d)
fq-to-ca (fqcall g as) m d = cacall g (fq-to-ca as ckl d)
fq-to-ca (fqloop init b) m d = caloop d (fq-len init) (fq-to-ca init (ckd d) d) (fq-to-ca b ckt (qadd d (fq-len init)))
fq-to-ca fqnil m d = canil
fq-to-ca (fqcons x r) m d = ca-cons m (fq-to-ca x ckt d) (fq-to-ca r (ck-next m) d)
fq-to-ca (fqalt j n b r) m d = caalt j n d (fq-to-ca b ckt (qadd d n)) (fq-to-ca r m d)
fq-to-ca fqanone m d = canone
fq-to-ca fqnet m d = caunsup
-- ---------------------------------------------------------------- what the translation needs
-- a syntactic list of exactly n terms; of n + 1 for a positive count
fq-isn : Nat → FQ → Bool
fq-isn zero fqnil = true
fq-isn (suc m) (fqcons x r) = fq-isn m r
fq-isn n t = false
fq-isar : Nat → FQ → Bool
fq-isar zero t = false
fq-isar (suc m) t = fq-isn m t
q-isar : Nat → KQ → Bool
q-isar zero v = false
q-isar (suc m) v = q-isn m v
-- a loop's body answers a constructor: tag 0 with the state's k fields, or any other
lbok : Nat → FQ → Bool
lbok k (fqif c a b) = andbt (lbok k a) (lbok k b)
lbok k (fqlet a b) = lbok k b
lbok k (fqcon dd c fs) = if weq c #0 then fq-isn k fs else true
lbok k t = false
-- the modes' kinds: a term, a list (argument list or declarations), alternatives
ck-t : CK → Bool
ck-t ckt = true
ck-t ckl = false
ck-t cka = false
ck-t (ckd l) = false
ck-l : CK → Bool
ck-l ckt = false
ck-l ckl = true
ck-l cka = false
ck-l (ckd l) = true
ck-a : CK → Bool
ck-a ckt = false
ck-a ckl = false
ck-a cka = true
ck-a (ckd l) = false
ck-ta : CK → Bool
ck-ta ckt = true
ck-ta ckl = false
ck-ta cka = true
ck-ta (ckd l) = false
-- the conditions on a term (mode ckt), a list of terms (ckl, ckd), alternatives (cka), decided: a call
-- of a defined key (df) with its definition's count of arguments, a closure of a defined key below
-- 1000000 capturing its definition's parameters less one, a loop's body answering its state's shape,
-- no λ (closures are lifted), no list or alternative where a term goes
ca-ok : (Word → Nat) → (Word → Bool) → FQ → CK → Bool
ca-ok A df (fql w) m = ck-t m
ca-ok A df (fqv n) m = ck-t m
ca-ok A df (fqprim p as) m = andbt (ck-t m) (ca-ok A df as ckl)
ca-ok A df (fqlet a b) m = andbt (ck-t m) (andbt (ca-ok A df a ckt) (ca-ok A df b ckt))
ca-ok A df (fqcon dd c fs) m = andbt (ck-t m) (ca-ok A df fs ckl)
ca-ok A df (fqproj dd c k x) m = andbt (ck-t m) (ca-ok A df x ckt)
ca-ok A df (fqsw x alts) m = andbt (ck-t m) (andbt (ca-ok A df x ckt) (ca-ok A df alts cka))
ca-ok A df (fqif c a b) m = andbt (ck-t m) (andbt (ca-ok A df c ckt) (andbt (ca-ok A df a ckt) (ca-ok A df b ckt)))
ca-ok A df (fqclos g env) m = andbt (ck-t m) (andbt (df g) (andbt (wlt g #1000000) (andbt (fq-isar (A g) env) (ca-ok A df env ckl))))
ca-ok A df (fqlam b) m = false
ca-ok A df (fqapp f as) m = andbt (ck-t m) (andbt (ca-ok A df f ckt) (ca-ok A df as ckl))
ca-ok A df (fqcall g as) m = andbt (ck-t m) (andbt (df g) (andbt (fq-isn (A g) as) (ca-ok A df as ckl)))
ca-ok A df (fqloop init b) m = andbt (ck-t m) (andbt (ca-ok A df init ckl) (andbt (lbok (fq-len init) b) (ca-ok A df b ckt)))
ca-ok A df fqnil m = ck-l m
ca-ok A df (fqcons x r) m = andbt (ck-l m) (andbt (ca-ok A df x ckt) (ca-ok A df r ckl))
ca-ok A df (fqalt j n b r) m = andbt (ck-a m) (andbt (ca-ok A df b ckt) (ca-ok A df r cka))
ca-ok A df fqanone m = ck-ta m
ca-ok A df fqnet m = ck-t m
-- ---------------------------------------------------------------- the relation
-- a first-order value refined by a C value: none by anything; a word, an Int64 or a Float64 by the word
-- cell of its bits; a byte string by its cell; a constructor by a constructor cell of its tag whose
-- fields refine its own; a closure by a closure cell of its key whose captures refine its own, the key
-- defined (df), below 1000000, the captures its definition's parameters less one (A); a chain by a
-- chain; a λ by nothing (the translated programs make none)
cr-clo : (Word → Nat) → (Word → Bool) → Word → KQ → Bool
cr-clo A df g env = andbt (df g) (andbt (wlt g #1000000) (q-isar (A g) env))
CR : (Word → Nat) → (Word → Bool) → KQ → CV → Type
CR A df kqbot c = Unit
CR A df (kqw w) c = c ≡ cw w
CR A df (kqi b) c = c ≡ cw b
CR A df (kqf b) c = c ≡ cw b
CR A df (kqb l) c = c ≡ cb l
CR A df kqnil c = c ≡ cvnil
CR A df (kqcons x r) (cvcons y q) = CR A df x y × CR A df r q
CR A df (kqcons x r) c = Empty
CR A df (kqcon d k fs) (cvcon j gs) = (k ≡ j) × CR A df fs gs
CR A df (kqcon d k fs) c = Empty
CR A df (kqclos g env) (cclo g2 caps) = ((g ≡ g2) × (cr-clo A df g env ≡ true)) × CR A df env caps
CR A df (kqclos g env) c = Empty
CR A df (kqlam b env) c = Empty
cr-bif : (A : Word → Nat) (df : Word → Bool) (b : Bool) (x : KQ) (y : CV) (x2 : KQ) (y2 : CV) → CR A df x y → CR A df x2 y2 → CR A df (if b then x else x2) (if b then y else y2)
cr-bif A df true x y x2 y2 h1 h2 = h1
cr-bif A df false x y x2 y2 h1 h2 = h2
andt-i : (a b : Bool) → a ≡ true → b ≡ true → andbt a b ≡ true
andt-i true b ha hb = hb
andt-i false b ha hb = Empty-rec (false≢true ha)
-- a chain's length is its refinement's
cr-isn : (A : Word → Nat) (df : Word → Bool) (m : Nat) (x : KQ) (y : CV) → CR A df x y → q-isn m x ≡ true → c-isn m y ≡ true
cr-isn A df zero kqnil y h e = cong (λ u → c-isn zero u) h
cr-isn A df (suc m) (kqcons x r) (cvcons y q) h e = cr-isn A df m r q (snd h) e
cr-isn A df (suc m) (kqcons x r) y h e = Empty-rec h
cr-isn A df m x y h e = Empty-rec (false≢true e)
cr-isar : (A : Word → Nat) (df : Word → Bool) (m : Nat) (x : KQ) (y : CV) → CR A df x y → q-isar m x ≡ true → c-isar m y ≡ true
cr-isar A df zero x y h e = Empty-rec (false≢true e)
cr-isar A df (suc m) x y h e = cr-isn A df m x y h e
-- the k-th of a chain
cr-nth : (A : Word → Nat) (df : Word → Bool) (x : KQ) (y : CV) → CR A df x y → (k : Nat) → CR A df (q-nth x k) (c-nth y k)
cr-nth A df (kqcons x r) (cvcons y q) h zero = fst h
cr-nth A df (kqcons x r) (cvcons y q) h (suc k) = cr-nth A df r q (snd h) k
cr-nth A df (kqcons x r) y h k = Empty-rec h
cr-nth A df x y h k = unit
-- ---------------------------------------------------------------- the primitives, refined
-- q-ww's split, followed: the list, its head's kind, its tail, the second's kind, the rest
cr-wwd : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqw p) (kqcons (kqw q) r)) cs → CR A df (q-ww f (kqcons (kqw p) (kqcons (kqw q) r))) (c-ww f cs)
cr-wwd A df f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h t) (cvcons (fst (snd h) t) (snd (snd h) t)))
cr-wwd A df f p q kqnil (cvcons x y) h = Empty-rec (snd h)
cr-wwd A df f p q kqnil cs h = Empty-rec h
cr-wwd A df f p q r cs h = unit
cr-wwc : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (b r : KQ) (cs : CV) → CR A df (kqcons (kqw p) (kqcons b r)) cs → CR A df (q-ww f (kqcons (kqw p) (kqcons b r))) (c-ww f cs)
cr-wwc A df f p (kqw q) r cs h = cr-wwd A df f p q r cs h
cr-wwc A df f p b r cs h = unit
cr-wwb : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqw p) r) cs → CR A df (q-ww f (kqcons (kqw p) r)) (c-ww f cs)
cr-wwb A df f p (kqcons b r) cs h = cr-wwc A df f p b r cs h
cr-wwb A df f p r cs h = unit
cr-wwa : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (a r : KQ) (cs : CV) → CR A df (kqcons a r) cs → CR A df (q-ww f (kqcons a r)) (c-ww f cs)
cr-wwa A df f (kqw p) r cs h = cr-wwb A df f p r cs h
cr-wwa A df f a r cs h = unit
cr-ww : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-ww f as) (c-ww f cs)
cr-ww A df f (kqcons a r) cs h = cr-wwa A df f a r cs h
cr-ww A df f as cs h = unit
-- q-ii's split, followed: the list, its head's kind, its tail, the second's kind, the rest
cr-iid : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqi p) (kqcons (kqi q) r)) cs → CR A df (q-ii f (kqcons (kqi p) (kqcons (kqi q) r))) (c-ww f cs)
cr-iid A df f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h t) (cvcons (fst (snd h) t) (snd (snd h) t)))
cr-iid A df f p q kqnil (cvcons x y) h = Empty-rec (snd h)
cr-iid A df f p q kqnil cs h = Empty-rec h
cr-iid A df f p q r cs h = unit
cr-iic : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (b r : KQ) (cs : CV) → CR A df (kqcons (kqi p) (kqcons b r)) cs → CR A df (q-ii f (kqcons (kqi p) (kqcons b r))) (c-ww f cs)
cr-iic A df f p (kqi q) r cs h = cr-iid A df f p q r cs h
cr-iic A df f p b r cs h = unit
cr-iib : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqi p) r) cs → CR A df (q-ii f (kqcons (kqi p) r)) (c-ww f cs)
cr-iib A df f p (kqcons b r) cs h = cr-iic A df f p b r cs h
cr-iib A df f p r cs h = unit
cr-iia : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (a r : KQ) (cs : CV) → CR A df (kqcons a r) cs → CR A df (q-ii f (kqcons a r)) (c-ww f cs)
cr-iia A df f (kqi p) r cs h = cr-iib A df f p r cs h
cr-iia A df f a r cs h = unit
cr-ii : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-ii f as) (c-ww f cs)
cr-ii A df f (kqcons a r) cs h = cr-iia A df f a r cs h
cr-ii A df f as cs h = unit
-- q-iw's split, followed: the list, its head's kind, its tail, the second's kind, the rest
cr-iwd : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqi p) (kqcons (kqi q) r)) cs → CR A df (q-iw f (kqcons (kqi p) (kqcons (kqi q) r))) (c-ww f cs)
cr-iwd A df f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h t) (cvcons (fst (snd h) t) (snd (snd h) t)))
cr-iwd A df f p q kqnil (cvcons x y) h = Empty-rec (snd h)
cr-iwd A df f p q kqnil cs h = Empty-rec h
cr-iwd A df f p q r cs h = unit
cr-iwc : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (b r : KQ) (cs : CV) → CR A df (kqcons (kqi p) (kqcons b r)) cs → CR A df (q-iw f (kqcons (kqi p) (kqcons b r))) (c-ww f cs)
cr-iwc A df f p (kqi q) r cs h = cr-iwd A df f p q r cs h
cr-iwc A df f p b r cs h = unit
cr-iwb : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqi p) r) cs → CR A df (q-iw f (kqcons (kqi p) r)) (c-ww f cs)
cr-iwb A df f p (kqcons b r) cs h = cr-iwc A df f p b r cs h
cr-iwb A df f p r cs h = unit
cr-iwa : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (a r : KQ) (cs : CV) → CR A df (kqcons a r) cs → CR A df (q-iw f (kqcons a r)) (c-ww f cs)
cr-iwa A df f (kqi p) r cs h = cr-iwb A df f p r cs h
cr-iwa A df f a r cs h = unit
cr-iw : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-iw f as) (c-ww f cs)
cr-iw A df f (kqcons a r) cs h = cr-iwa A df f a r cs h
cr-iw A df f as cs h = unit
-- q-ff's split, followed: the list, its head's kind, its tail, the second's kind, the rest
cr-ffd : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqf p) (kqcons (kqf q) r)) cs → CR A df (q-ff f (kqcons (kqf p) (kqcons (kqf q) r))) (c-ww f cs)
cr-ffd A df f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h t) (cvcons (fst (snd h) t) (snd (snd h) t)))
cr-ffd A df f p q kqnil (cvcons x y) h = Empty-rec (snd h)
cr-ffd A df f p q kqnil cs h = Empty-rec h
cr-ffd A df f p q r cs h = unit
cr-ffc : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (b r : KQ) (cs : CV) → CR A df (kqcons (kqf p) (kqcons b r)) cs → CR A df (q-ff f (kqcons (kqf p) (kqcons b r))) (c-ww f cs)
cr-ffc A df f p (kqf q) r cs h = cr-ffd A df f p q r cs h
cr-ffc A df f p b r cs h = unit
cr-ffb : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqf p) r) cs → CR A df (q-ff f (kqcons (kqf p) r)) (c-ww f cs)
cr-ffb A df f p (kqcons b r) cs h = cr-ffc A df f p b r cs h
cr-ffb A df f p r cs h = unit
cr-ffa : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (a r : KQ) (cs : CV) → CR A df (kqcons a r) cs → CR A df (q-ff f (kqcons a r)) (c-ww f cs)
cr-ffa A df f (kqf p) r cs h = cr-ffb A df f p r cs h
cr-ffa A df f a r cs h = unit
cr-ff : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-ff f as) (c-ww f cs)
cr-ff A df f (kqcons a r) cs h = cr-ffa A df f a r cs h
cr-ff A df f as cs h = unit
-- q-fw's split, followed: the list, its head's kind, its tail, the second's kind, the rest
cr-fwd : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqf p) (kqcons (kqf q) r)) cs → CR A df (q-fw f (kqcons (kqf p) (kqcons (kqf q) r))) (c-ww f cs)
cr-fwd A df f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h t) (cvcons (fst (snd h) t) (snd (snd h) t)))
cr-fwd A df f p q kqnil (cvcons x y) h = Empty-rec (snd h)
cr-fwd A df f p q kqnil cs h = Empty-rec h
cr-fwd A df f p q r cs h = unit
cr-fwc : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (b r : KQ) (cs : CV) → CR A df (kqcons (kqf p) (kqcons b r)) cs → CR A df (q-fw f (kqcons (kqf p) (kqcons b r))) (c-ww f cs)
cr-fwc A df f p (kqf q) r cs h = cr-fwd A df f p q r cs h
cr-fwc A df f p b r cs h = unit
cr-fwb : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (p : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqf p) r) cs → CR A df (q-fw f (kqcons (kqf p) r)) (c-ww f cs)
cr-fwb A df f p (kqcons b r) cs h = cr-fwc A df f p b r cs h
cr-fwb A df f p r cs h = unit
cr-fwa : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (a r : KQ) (cs : CV) → CR A df (kqcons a r) cs → CR A df (q-fw f (kqcons a r)) (c-ww f cs)
cr-fwa A df f (kqf p) r cs h = cr-fwb A df f p r cs h
cr-fwa A df f a r cs h = unit
cr-fw : (A : Word → Nat) (df : Word → Bool) (f : Word → Word → Word) (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-fw f as) (c-ww f cs)
cr-fw A df f (kqcons a r) cs h = cr-fwa A df f a r cs h
cr-fw A df f as cs h = unit
cr-1 : (A : Word → Nat) (df : Word → Bool) (f : KQ → KQ) (g : CV → CV) → ((a : KQ) (x : CV) → CR A df a x → CR A df (f a) (g x)) → (as : KQ) (cs : CV) → CR A df as cs → CR A df (q-1 f as) (c-1 g cs)
cr-1 A df f g fg (kqcons a kqnil) (cvcons x z) h = subst {lzero} {lzero} {CV} {λ u → CR A df (f a) (c-1 g (cvcons x u))} {cvnil} {z} (sym (snd h)) (fg a x (fst h))
cr-1 A df f g fg (kqcons a kqnil) cs h = Empty-rec h
cr-1 A df f g fg as cs h = unit
cu-iw : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-i-of-w a) (c-wm (λ w → w) x)
cu-iw A df (kqw w) x h = cong (λ u → c-wm (λ w2 → w2) u) h
cu-iw A df a x h = unit
cu-wi : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-w-of-i a) (c-wm (λ w → w) x)
cu-wi A df (kqi b) x h = cong (λ u → c-wm (λ w2 → w2) u) h
cu-wi A df a x h = unit
cu-fi : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-f-of-i a) (c-wm (λ b → dfb (f64ofi64 (dbi b))) x)
cu-fi A df (kqi b) x h = cong (λ u → c-wm (λ b2 → dfb (f64ofi64 (dbi b2))) u) h
cu-fi A df a x h = unit
cu-if : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-i-of-f a) (c-wm (λ b → dib (i64off64 (dbf b))) x)
cu-if A df (kqf b) x h = cong (λ u → c-wm (λ b2 → dib (i64off64 (dbf b2))) u) h
cu-if A df a x h = unit
cu-fw : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-f-of-w a) (c-wm (λ w → dfb (f64 w)) x)
cu-fw A df (kqw w) x h = cong (λ u → c-wm (λ w2 → dfb (f64 w2)) u) h
cu-fw A df a x h = unit
cu-bits : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-bits a) (c-wm (λ w → w) x)
cu-bits A df (kqf b) x h = cong (λ u → c-wm (λ w2 → w2) u) h
cu-bits A df a x h = unit
cu-ofbits : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-ofbits a) (c-wm (λ w → w) x)
cu-ofbits A df (kqi b) x h = cong (λ u → c-wm (λ w2 → w2) u) h
cu-ofbits A df a x h = unit
cu-bytes : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (qk-bytes a) (c-bytes x)
cu-bytes A df (kqw n) x h = cong (λ u → c-bytes u) h
cu-bytes A df a x h = unit
cu-blen : (A : Word → Nat) (df : Word → Bool) (a : KQ) (x : CV) → CR A df a x → CR A df (q-blen a) (c-blen x)
cu-blen A df (kqb l) x h = cong (λ u → c-blen u) h
cu-blen A df a x h = unit
-- q-ld8's split, followed one constructor test at a time (each helper splits one variable, every
-- constructor listed: a stuck bl-ld under an open split does not normalize small)
cr-ld8g : (A : Word → Nat) (df : Word → Bool) (l : BL) (o : Word) (x y z : CV) → CR A df (kqcons (kqb l) (kqcons (kqw o) kqnil)) (cvcons x (cvcons y z)) → CR A df (q-ld8 (kqcons (kqb l) (kqcons (kqw o) kqnil))) (c-ld #8 (cvcons x (cvcons y z)))
cr-ld8g A df l o x y z h = λ t → c-ld #8 (cvcons (fst h t) (cvcons (fst (snd h) t) (snd (snd h) t)))
cr-ld8f : (A : Word → Nat) (df : Word → Bool) (l : BL) (o : Word) (x q : CV) → CR A df (kqcons (kqb l) (kqcons (kqw o) kqnil)) (cvcons x q) → CR A df (q-ld8 (kqcons (kqb l) (kqcons (kqw o) kqnil))) (c-ld #8 (cvcons x q))
cr-ld8f A df l o x (cw u0) h = Empty-rec (snd h)
cr-ld8f A df l o x (cvcon u0 u1) h = Empty-rec (snd h)
cr-ld8f A df l o x (cclo u0 u1) h = Empty-rec (snd h)
cr-ld8f A df l o x (cb u0) h = Empty-rec (snd h)
cr-ld8f A df l o x cvnil h = Empty-rec (snd h)
cr-ld8f A df l o x (cvcons u0 u1) h = cr-ld8g A df l o x u0 u1 h
cr-ld8f A df l o x cbot h = Empty-rec (snd h)
cr-ld8e : (A : Word → Nat) (df : Word → Bool) (l : BL) (o : Word) (cs : CV) → CR A df (kqcons (kqb l) (kqcons (kqw o) kqnil)) cs → CR A df (q-ld8 (kqcons (kqb l) (kqcons (kqw o) kqnil))) (c-ld #8 cs)
cr-ld8e A df l o (cw u0) h = Empty-rec h
cr-ld8e A df l o (cvcon u0 u1) h = Empty-rec h
cr-ld8e A df l o (cclo u0 u1) h = Empty-rec h
cr-ld8e A df l o (cb u0) h = Empty-rec h
cr-ld8e A df l o cvnil h = Empty-rec h
cr-ld8e A df l o (cvcons u0 u1) h = cr-ld8f A df l o u0 u1 h
cr-ld8e A df l o cbot h = Empty-rec h
cr-ld8d : (A : Word → Nat) (df : Word → Bool) (l : BL) (o : Word) (r : KQ) (cs : CV) → CR A df (kqcons (kqb l) (kqcons (kqw o) r)) cs → CR A df (q-ld8 (kqcons (kqb l) (kqcons (kqw o) r))) (c-ld #8 cs)
cr-ld8d A df l o (kqw u0) cs h = unit
cr-ld8d A df l o (kqi u0) cs h = unit
cr-ld8d A df l o (kqf u0) cs h = unit
cr-ld8d A df l o (kqcon u0 u1 u2) cs h = unit
cr-ld8d A df l o (kqclos u0 u1) cs h = unit
cr-ld8d A df l o (kqlam u0 u1) cs h = unit
cr-ld8d A df l o (kqb u0) cs h = unit
cr-ld8d A df l o kqnil cs h = cr-ld8e A df l o cs h
cr-ld8d A df l o (kqcons u0 u1) cs h = unit
cr-ld8d A df l o kqbot cs h = unit
cr-ld8c : (A : Word → Nat) (df : Word → Bool) (l : BL) (b r : KQ) (cs : CV) → CR A df (kqcons (kqb l) (kqcons b r)) cs → CR A df (q-ld8 (kqcons (kqb l) (kqcons b r))) (c-ld #8 cs)
cr-ld8c A df l (kqw u0) r cs h = cr-ld8d A df l u0 r cs h
cr-ld8c A df l (kqi u0) r cs h = unit
cr-ld8c A df l (kqf u0) r cs h = unit
cr-ld8c A df l (kqcon u0 u1 u2) r cs h = unit
cr-ld8c A df l (kqclos u0 u1) r cs h = unit
cr-ld8c A df l (kqlam u0 u1) r cs h = unit
cr-ld8c A df l (kqb u0) r cs h = unit
cr-ld8c A df l kqnil r cs h = unit
cr-ld8c A df l (kqcons u0 u1) r cs h = unit
cr-ld8c A df l kqbot r cs h = unit
cr-ld8b : (A : Word → Nat) (df : Word → Bool) (l : BL) (r : KQ) (cs : CV) → CR A df (kqcons (kqb l) r) cs → CR A df (q-ld8 (kqcons (kqb l) r)) (c-ld #8 cs)
cr-ld8b A df l (kqw u0) cs h = unit
cr-ld8b A df l (kqi u0) cs h = unit
cr-ld8b A df l (kqf u0) cs h = unit
cr-ld8b A df l (kqcon u0 u1 u2) cs h = unit
cr-ld8b A df l (kqclos u0 u1) cs h = unit
cr-ld8b A df l (kqlam u0 u1) cs h = unit
cr-ld8b A df l (kqb u0) cs h = unit
cr-ld8b A df l kqnil cs h = unit
cr-ld8b A df l (kqcons u0 u1) cs h = cr-ld8c A df l u0 u1 cs h
cr-ld8b A df l kqbot cs h = unit
cr-ld8a : (A : Word → Nat) (df : Word → Bool) (a r : KQ) (cs : CV) → CR A df (kqcons a r) cs → CR A df (q-ld8 (kqcons a r)) (c-ld #8 cs)
cr-ld8a A df (kqw u0) r cs h = unit
cr-ld8a A df (kqi u0) r cs h = unit
cr-ld8a A df (kqf u0) r cs h = unit
