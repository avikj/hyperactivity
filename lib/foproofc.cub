pstep A df CD G GC n inc co lo (fqcall u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqcall u0 u1) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqloop u0 u1) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqloop u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqloop u0 u1) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqnil ckt d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqnil cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqcons u0 u1) ckt d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqcons u0 u1) cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqalt u0 u1 u2 u3) ckt d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqalt u0 u1 u2 u3) ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo (fqalt u0 u1 u2 u3) (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqanone ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqanone (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqnet ckl d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqnet cka d e s hk h x = Empty-rec (false≢true hk)
pstep A df CD G GC n inc co lo fqnet (ckd u9) d e s hk h x = Empty-rec (false≢true hk)
-- the theorem one unit of fuel up: a defined key's body (its table entries translated, GC; every
-- defined key's body meeting the conditions), and a loop's next turn
CThm : (Word → Nat) → (Word → Bool) → (Word → Bool) → (Word → FQ) → (Word → CA) → Nat → Type
CThm A df CD G GC n = (t : FQ) (m : CK) (d : Nat) (e : KQ) (s : CS) → ca-ok A df t (okm m) ≡ true → Corr A df d e s → (x : CPre A df m d) → CGoal A df CD G GC n m t d e s x
call-up : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) (n : Nat) → ((g : Word) → df g ≡ true → ca-ok A df (G g) ckt ≡ true) → ((g : Word) → df g ≡ true → GC g ≡ fq-to-ca (G g) ckt (A g))
        → CThm A df CD G GC n → CallOK A df CD G GC (suc n)
call-up A df CD G GC n tok lk th g e2 s2 hd hc =
  subst {lzero} {lzero} {CA} {λ u → CR A df (evT G (qeN G n) (G g) e2) (cevT GC A CD (ceN GC A CD n) u s2)} {fq-to-ca (G g) ckt (A g)} {GC g} (sym (lk g hd))
    (th (G g) ckt (A g) e2 s2 (tok g hd) hc unit)
loop-up : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) (n : Nat) → CThm A df CD G GC n → LoopOK A df CD G GC n → LoopOK A df CD G GC (suc n)
loop-up A df CD G GC n th lo k st st2 b d e s hi hs okb lb h =
  cr-lstep A df k (evT G (qeN G n) b (q-push st e)) (cevT GC A CD (ceN GC A CD n) (fq-to-ca b ckt (qadd d k)) (cs-push st2 d s))
    (λ x → qe-lp (qeN G n) x b e) (λ y → ce-lp (ceN GC A CD n) d k y (fq-to-ca b ckt (qadd d k)) s)
    (th b ckt (qadd d k) (q-push st e) (cs-push st2 d s) okb (push-corr A df k st st2 d e s hi hs h) unit)
    (lb-res G (qeN G n) k b (q-push st e) lb)
    (λ x y hx hy → lo k x y b d e s hx hy okb lb h)
coks : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) → ((g : Word) → df g ≡ true → CD g ≡ true) → ((g : Word) → df g ≡ true → ca-ok A df (G g) ckt ≡ true)
     → ((g : Word) → df g ≡ true → GC g ≡ fq-to-ca (G g) ckt (A g)) → (n : Nat) → CallOK A df CD G GC n × LoopOK A df CD G GC n
coks A df CD G GC inc tok lk zero = ((λ g e2 s2 hd hc → unit) , (λ k st st2 b d e s hi hs okb lb h → unit))
coks A df CD G GC inc tok lk (suc n) =
  (call-up A df CD G GC n tok lk (pstep A df CD G GC n inc (fst (coks A df CD G GC inc tok lk n)) (snd (coks A df CD G GC inc tok lk n))) ,
   loop-up A df CD G GC n (pstep A df CD G GC n inc (fst (coks A df CD G GC inc tok lk n)) (snd (coks A df CD G GC inc tok lk n))) (snd (coks A df CD G GC inc tok lk n)))
-- the theorem: at every fuel, every term meeting the conditions, in refining environments, its C
-- translation computes what it computes (G the first-order table, A its parameter counts, df the
-- defined keys, CD the keys with a dispatcher case, GC the C functions: each defined key's
-- translated body)
ca-sound : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) → ((g : Word) → df g ≡ true → CD g ≡ true) → ((g : Word) → df g ≡ true → ca-ok A df (G g) ckt ≡ true)
         → ((g : Word) → df g ≡ true → GC g ≡ fq-to-ca (G g) ckt (A g)) → (n : Nat) → CThm A df CD G GC n
ca-sound A df CD G GC inc tok lk n = pstep A df CD G GC n inc (fst (coks A df CD G GC inc tok lk n)) (snd (coks A df CD G GC inc tok lk n))
-- for a term: at every fuel, the C's value refines evq's
ca-sound-t : (A : Word → Nat) (df CD : Word → Bool) (G : Word → FQ) (GC : Word → CA) → ((g : Word) → df g ≡ true → CD g ≡ true) → ((g : Word) → df g ≡ true → ca-ok A df (G g) ckt ≡ true)
           → ((g : Word) → df g ≡ true → GC g ≡ fq-to-ca (G g) ckt (A g)) → (n : Nat) (t : FQ) (d : Nat) (e : KQ) (s : CS) → ca-ok A df t ckt ≡ true → Corr A df d e s
           → CR A df (evq G n t e) (evc GC A CD n (fq-to-ca t ckt d) s)
ca-sound-t A df CD G GC inc tok lk n t d e s hk h = ca-sound A df CD G GC inc tok lk n t ckt d e s hk h unit
-- ---------------------------------------------------------------- the printer
-- CA as C text, construct for construct, in lib/emitc.cub's style (its runtime, prototypes, dispatcher
-- and main): each construct prints as the shape the syntax section above gives it. This and gcc are
-- what the path leaves outside it. A name v<l> prints as v and l's decimal digits.
ca-v l = lapp s-v (dec (fromNat l))
ca-c t =
  case t of
    caw w → cat3 s-mkw (dec w) s-close
    cav l → ca-v l
    caprim p as → ca-prim p as
    cablk l a b → cat7 s-bsx s-vstar (ca-v l) s-assign (ca-c a) s-semi (lapp (ca-c b) s-bsend)
    cacon c fs → cat7 s-mkc (dec c) s-comma (dec (ca-len fs)) (ca-rest fs) s-close lnil
    caproj k x → cat4 (ca-c x) s-arrow (dec k) s-rb
    casw x alts → cat6 s-bsx s-rdecl (cat3 s-xbind (ca-c x) s-switchx) (ca-alts alts) s-default (lapp (lcons #114 lnil) s-bsend)
    caif c a b → cat6 s-if (ca-c c) s-ifm (ca-c a) s-ifs (lapp (ca-c b) s-ifend)
    caclo g caps → cat7 s-clo (dec g) s-comma (dec (ca-len caps)) (ca-rest caps) s-close lnil
    caap f as → ca-apply (ca-c f) as
    cacall g as → cat4 s-f (dec g) s-open (lapp (ca-args as) s-close)
    caloop l k init b → cat6 s-bsx s-rdecl (ca-decls init) (cat3 s-for (ca-c b) s-fortest) (ca-reassign l k zero) (lapp s-forelse (lapp (lcons #114 lnil) s-bsend))
    _ → s-unsup
ca-len l = case l of cacons x r → %wsucc (ca-len r); _ → #0
-- ", a, b" (a constructor's fields, a closure's captures)
ca-rest l = case l of cacons x r → cat3 s-comma (ca-c x) (ca-rest r); _ → lnil
-- "a, b" (a call's arguments)
ca-args l = case l of cacons x r → (case r of cacons y r2 → cat3 (ca-c x) s-comma (ca-args r); _ → ca-c x); _ → lnil
ca-apply f l = case l of cacons a r → ca-apply (cat5 s-apply f s-comma (ca-c a) s-close) r; _ → f
-- case c: { V *v<l> = x->f[0]; ... r = b; break; }
ca-alts al = case al of caalt ac an ak ab ar → lapp (cat6 s-case (dec ac) s-colon (ca-fields ak an zero) (cat3 s-rr (ca-c ab) s-semi) s-break) (ca-alts ar); _ → lnil
ca-fields fl fn fi = case fn of zero → lnil; suc fm → cat7 s-vstar (ca-v (qadd fl fi)) s-assign (lcons #120 lnil) s-arrow (dec (fromNat fi)) (lapp s-rb (lapp s-semi (ca-fields fl fm (suc fi))))
-- V *v<l> = x; (a loop's state, in order)
ca-decls dl = case dl of cadecl dk dx dr → cat7 s-vstar (ca-v dk) s-assign (ca-c dx) s-semi (ca-decls dr) lnil; _ → lnil
-- v<l+i> = b->f[i]; for i below k
ca-reassign rl rk ri = case rk of zero → lnil; suc rm → cat6 (ca-v (qadd rl ri)) s-assign (lcons #98 lnil) s-arrow (dec (fromNat ri)) (lapp s-rb (lapp s-semi (ca-reassign rl rm (suc ri))))
-- the primitive operations, as lib/emitc.cub's prim-c prints them
ca-prim p as =
  if store-ip p then ca-bytes p as else
  if %wlt #13 p then ca-num p as else
  if %wlt #7 p then ca-bytes p as else
  case as of
    cacons a r →
      (case r of
         cacons b r2 → cat4 s-mkw (ca-c a) (op-c p) (lapp (ca-c b) (lapp s-n s-close))
         _ → cat5 s-mkw s-not (ca-c a) s-n s-close)
    _ → cat3 s-mkw (dec #0) s-close
ca-bytes p as =
  case as of
    cacons a r →
      (case r of
         cacons b r2 →
           (case r2 of
              cacons c r3 → cat7 (if %weq p P-store64 then s-st64 else if %weq p P-store64-ip then s-st64i else if %weq p P-store32-ip then s-st32i else s-st32) (ca-c a) s-comma (ca-c b) s-nc (ca-c c) s-nn
              _ → cat5 (if %weq p P-load64 then s-ld64 else s-ld32) (ca-c a) s-comma (ca-c b) s-nnn)
         _ → (if %weq p P-bytes then cat3 s-mkb (ca-c a) s-nn else cat3 s-blen (ca-c a) s-nn))
    _ → s-unsup
ca-num p as =
  case as of
    cacons a r →
      (case r of
         cacons b r2 → cat7 s-mkw (lcons #110 (dec p)) (lcons #40 lnil) (ca-c a) s-nn-comma (ca-c b) (lapp s-nn s-close)
         _ → cat6 s-mkw (lcons #110 (dec p)) (lcons #40 lnil) (ca-c a) s-nn s-close)
    _ → s-unsup
-- a program: (key , (parameter count , body)) definitions, main the key 0 one (no parameters)
ca-def g n body = cat6 s-fnhead (dec g) s-open (if %weq n #0 then s-void else params-c n #0) s-body (lapp (ca-c body) s-fnend)
ca-defs-c defs = case defs of lnil → lnil; lcons d r → lapp (ca-def (fst d) (fst (snd d)) (snd (snd d))) (ca-defs-c r)
ca-prog defs = cat4 s-runtime (protos defs) (dispatch defs) (lapp (ca-defs-c defs) s-main)
-- ---------------------------------------------------------------- the proved route's C
-- specialize-proved's first-order definitions as checked terms (key , (parameter count , FQ body)):
-- the word route's main (its λs counted as parameters), the data route's table; the untyped route
-- has none (tag 0)
specialize-proved-q T rules c =
  let n = normalize T c
  in (case wc-of (under-lams n) of
        some w → (#1 , lcons (#0 , (lams-of n , fw-to-fq (spec-w std-vrule w))) lnil)
        none → (case dc-prog n of
                  some p → (if dc-prog-ok p then (#2 , dc-wrap-main-q (sig-ft (fromopt (quote-ty T) cword)) (dc-prog-defs-q p)) else (#0 , lnil))
                  none → (#0 , lnil)))
-- a harness's arguments, first-order values given as FO (literals, constructors of them) read as FQ
fo-arg-fq t = case t of flit w → fql w; fcon d c fs → fqcon d c (fo-args-fq fs); _ → fql #0
fo-args-fq l = case l of lnil → fqnil; lcons x r → fqcons (fo-arg-fq x) (fo-args-fq r)
-- each body translated at its parameter count
ca-tr-defs ds = case ds of lnil → lnil; lcons e r → lcons (fst e , (fst (snd e) , fq-to-ca (snd (snd e)) ckt (dnat (fst (snd e))))) (ca-tr-defs r)
-- a harness's program: its main f_0 calls the program's main (moved to key 1) on args (an FQ list)
ca-harness args ds = lcons (#0 , (#0 , fq-to-ca (fqcall #1 args) ckt zero)) (ca-tr-defs (dc-rekey #1 ds))
ca-table ds g = case ds of lnil → caunsup; lcons e r → if %weq (fst e) g then snd (snd e) else ca-table r g
ca-arity ds g = case ds of lnil → zero; lcons e r → if %weq (fst e) g then dnat (fst (snd e)) else ca-arity r g
-- the keys with a dispatcher case: a definition of at least one parameter
ca-disp ds g = case ds of lnil → false; lcons e r → if %weq (fst e) g then not (%weq (fst (snd e)) #0) else ca-disp r g
-- ---------------------------------------------------------------- the composed path
-- a word the source computes, the C computes: the first-order form's value is that word (qrel at a
-- word), and the C's refines it
ca-word : (A : Word → Nat) (df : Word → Bool) (D : Word → Nat) (x : TV) (v : KQ) (c : CV) (w : Word) → x ≡ tvw w → qrel D x v → CR A df v c → c ≡ cw w
ca-word A df D x v c w hx hq hc = subst {lzero} {lzero} {KQ} {λ u → CR A df u c} {v} {kqw w} (subst {lzero} {lzero} {TV} {λ y → qrel D y v} {x} {tvw w} hx hq) hc
-- the data route, end to end: at every fuel and arguments, the source's value refined by the
-- first-order form's (lib/foproofq.cub's q-path-n), refined by the C's (ca-sound); AN the C functions'
-- parameter counts, df the defined keys, CD the dispatcher's, GC the C functions
ca-path-n : (r : FRule) (G : Word → DC) (T GT : Word → FC) → DGOK G T GT → (D : Word → Nat) (A : Word → Word) → QGOK (fr-tab (fst r) T) (fr-tab (fst r) GT) D A
          → (AN : Word → Nat) (df CD : Word → Bool) (GC : Word → CA) → ((g : Word) → df g ≡ true → CD g ≡ true)
          → ((g : Word) → df g ≡ true → ca-ok AN df (q-ft (fr-tab (fst r) T) (fr-tab (fst r) GT) D A g) ckt ≡ true)
          → ((g : Word) → df g ≡ true → GC g ≡ fq-to-ca (q-ft (fr-tab (fst r) T) (fr-tab (fst r) GT) D A g) ckt (AN g))
          → (n : Nat) (c : DC) (a : QA) (m : Nat) (s : CS) → DTok T c → qa-ok D T a → qtok D A (fr-bu (fst r) (dconv c)) (qa-n a) ≡ true
          → ca-ok AN df (fc-to-fq (qa-n a) (fr-bu (fst r) (dconv c))) ckt ≡ true → Corr AN df (qa-n a) (qa-e a) s
          → qrel D (derase (dsev G n c (qa-ρ a))) (evq (q-ft (fr-tab (fst r) T) (fr-tab (fst r) GT) D A) (fr-addn n m) (fc-to-fq (qa-n a) (fr-bu (fst r) (dconv c))) (qa-e a))
            × CR AN df (evq (q-ft (fr-tab (fst r) T) (fr-tab (fst r) GT) D A) (fr-addn n m) (fc-to-fq (qa-n a) (fr-bu (fst r) (dconv c))) (qa-e a))
                       (evc GC AN CD (fr-addn n m) (fq-to-ca (fc-to-fq (qa-n a) (fr-bu (fst r) (dconv c))) ckt (qa-n a)) s)
ca-path-n r G T GT go D A gq AN df CD GC inc tok lk n c a m s tk ha hq hok hc =
  (q-path-n r G T GT go D A gq n c a m tk ha hq ,
   ca-sound-t AN df CD (q-ft (fr-tab (fst r) T) (fr-tab (fst r) GT) D A) GC inc tok lk (fr-addn n m) (fc-to-fq (qa-n a) (fr-bu (fst r) (dconv c))) (qa-n a) (qa-e a) s hok hc)
-- the word route has no table: no key is defined
no-df : (P : Word → Type) (g : Word) → (λ u → false) g ≡ true → P g
no-df P g h = Empty-rec (false≢true h)
-- a word, refined: none or the word; with a value, the C's word is it
kq-nb : KQ → Type
kq-nb kqbot = Empty
kq-nb (kqw w) = Unit
kq-nb (kqi b) = Unit
kq-nb (kqf b) = Unit
kq-nb (kqcon d c fs) = Unit
kq-nb (kqclos g env) = Unit
kq-nb (kqlam b env) = Unit
kq-nb (kqb l) = Unit
kq-nb kqnil = Unit
kq-nb (kqcons x r) = Unit
qw-c : (A : Word → Nat) (df : Word → Bool) (v : KQ) (c : CV) (w : Word) → qle-w v w → CR A df v c → kq-nb v → c ≡ cw w
qw-c A df (kqw x) c w hq hc hn = hc ∙ cong cw (qw-inj x w hq)
qw-c A df kqbot c w hq hc hn = Empty-rec hn
qw-c A df (kqi b) c w hq hc hn = Empty-rec hq
qw-c A df (kqf b) c w hq hc hn = Empty-rec hq
qw-c A df (kqcon d k fs) c w hq hc hn = Empty-rec hq
qw-c A df (kqclos g env) c w hq hc hn = Empty-rec hq
qw-c A df (kqlam b env) c w hq hc hn = Empty-rec hq
qw-c A df (kqb l) c w hq hc hn = Empty-rec hq
qw-c A df kqnil c w hq hc hn = Empty-rec hq
qw-c A df (kqcons y r) c w hq hc hn = Empty-rec hq
-- the word route, end to end, a one-parameter main: at every fuel, whenever the first-order form has a
-- value at x, the C computes what the source code computes at x
ca-fw-path : (r : VRule) (c : WC) (x : Word) (N : Nat) → ca-ok (λ g → zero) (λ g → false) (fw-to-fq (spec-w r c)) ckt ≡ true
           → kq-nb (evq (λ g → fqnet) N (fw-to-fq (spec-w r c)) (kqcons (kqw x) kqnil))
           → evc (λ g → caunsup) (λ g → zero) (λ g → false) N (fq-to-ca (fw-to-fq (spec-w r c)) ckt (suc zero)) (csb zero (cw x) csnil) ≡ cw (wc-ev c (envx x))
ca-fw-path r c x N hok hn =
  qw-c (λ g → zero) (λ g → false) (evq (λ g → fqnet) N (fw-to-fq (spec-w r c)) (kqcons (kqw x) kqnil)) (evc (λ g → caunsup) (λ g → zero) (λ g → false) N (fq-to-ca (fw-to-fq (spec-w r c)) ckt (suc zero)) (csb zero (cw x) csnil)) (wc-ev c (envx x))
    (fw-path r c (λ g → fqnet) (envx x) (kqcons (kqw x) kqnil) N (fenv-x x))
    (ca-sound-t (λ g → zero) (λ g → false) (λ g → false) (λ g → fqnet) (λ g → caunsup) (no-df (λ g → (λ u → false) g ≡ true)) (no-df (λ g → ca-ok (λ u → zero) (λ u → false) fqnet ckt ≡ true))
       (no-df (λ g → caunsup ≡ fq-to-ca fqnet ckt zero)) N (fw-to-fq (spec-w r c)) (suc zero) (kqcons (kqw x) kqnil) (csb zero (cw x) csnil) hok
       (corr-ext (λ g → zero) (λ g → false) zero kqnil csnil (kqw x) (cw x) (corr-nil (λ g → zero) (λ g → false)) (λ i → cw x)))
    hn
-- ---------------------------------------------------------------- a program's table, by its keys
-- the obligations ca-path-n asks of a table hold of every defined key when the table's keys are a
-- list and the decision over the list computes to true (keys-ok: by the list, weq-sound at each key)
bool-split : (b : Bool) (Q : Type) → (b ≡ true → Q) → (b ≡ false → Q) → Q
bool-split true Q t f = t (λ i → true)
bool-split false Q t f = f (λ i → false)
kmem : Word → List Word → Bool
kmem g nil = false
kmem g (cons k r) = if weq g k then true else kmem g r
kall : (Word → Bool) → List Word → Bool
kall p nil = true
kall p (cons k r) = andbt (p k) (kall p r)
kmem-miss : (g k : Word) (r : List Word) → weq g k ≡ false → kmem g (cons k r) ≡ true → kmem g r ≡ true
kmem-miss g k r h hm = subst {lzero} {lzero} {Bool} {λ b → (if b then true else kmem g r) ≡ true} {weq g k} {false} h hm
keys-ok : (p : Word → Bool) (ks : List Word) → kall p ks ≡ true → (g : Word) → kmem g ks ≡ true → p g ≡ true
keys-ok p nil ha g hm = Empty-rec (false≢true hm)
keys-ok p (cons k r) ha g hm =
  bool-split (weq g k) (p g ≡ true)
    (λ h → subst {lzero} {lzero} {Word} {λ x → p x ≡ true} {k} {g} (sym (weq-sound g k h)) (andbt-l (p k) (kall p r) ha))
    (λ h → keys-ok p r (andbt-r (p k) (kall p r) ha) g (kmem-miss g k r h hm))

