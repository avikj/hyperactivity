-- lib/bits.cub — what the imported ISA models are written against (PLAN Phase 2, track B).
-- Over lib/prim.cub's Word operations (wmul wand wor wxor wshl wshr wquot wrem) and lib/std.cub's
-- (wadd wsub weq wlt). tools/sail2cub.py emits calls to these names;
-- each is the Sail built-in of the same meaning, stated beside it.
--
-- A bitvector of width n is a Word below 2ⁿ: Bits n = Word, a plain alias (the model is
-- first-order code, not a place for proofs). Every operation takes the widths it needs and
-- returns a word below 2 to its result width, given arguments below 2 to theirs.
-- A Sail int is ZI: a sign and a magnitude, zneg #0 never built.
-- A Sail string is the Word whose base-256 digits are its bytes, first byte highest.
-- A Sail vector is a List with the element of index i at position i.
-- ByteMap is a function from addresses to bytes: a write is the function that compares its argument
-- with the written address. Two memories that read alike are equal (function extensionality), so a
-- statement about a run holds for every memory that reads as the one it was stated for.
-- An outcome is a value, an exception thrown, or an abort (an assertion that failed, a
-- recursion that passed its bound); effects are functions of an explicit state.
import "library.cub"

-- ---------------------------------------------------------------- booleans (Sail: not_bool, &, |)
b-not : Bool → Bool
b-not b = if b then false else true
b-and : Bool → Bool → Bool
b-and a b = if a then b else false
b-or : Bool → Bool → Bool
b-or a b = if a then true else b
b-eq : Bool → Bool → Bool
b-eq a b = if a then b else b-not b
w-le : Word → Word → Bool
w-le a b = b-not (wlt b a)

-- ---------------------------------------------------------------- bitvectors
Bits : Word → Type
Bits n = Word
-- 2ⁿ, and x modulo 2ⁿ
bv-pow2 : Word → Word
bv-pow2 n = wshl #1 n
bv-mask : (n : Word) → Word → Bits n
bv-mask n x = wand x (wsub (bv-pow2 n) #1)
-- sail_zeros, sail_ones
bv-zeros : (n : Word) → Bits n
bv-zeros n = #0
bv-ones : (n : Word) → Bits n
bv-ones n = wsub (bv-pow2 n) #1
-- add_bits, sub_bits, modulo 2ⁿ; negation; multiplication modulo 2ⁿ
bv-add : (n : Word) → Bits n → Bits n → Bits n
bv-add n a b = bv-mask n (wadd a b)
bv-sub : (n : Word) → Bits n → Bits n → Bits n
bv-sub n a b = bv-mask n (wsub (wadd a (bv-pow2 n)) b)
bv-mul : (n : Word) → Bits n → Bits n → Bits n
bv-mul n a b = bv-mask n (wmul a b)
-- and_vec, or_vec, xor_vec, not_vec
bv-and : (n : Word) → Bits n → Bits n → Bits n
bv-and n a b = wand a b
bv-or : (n : Word) → Bits n → Bits n → Bits n
bv-or n a b = wor a b
bv-xor : (n : Word) → Bits n → Bits n → Bits n
bv-xor n a b = wxor a b
bv-not : (n : Word) → Bits n → Bits n
bv-not n a = wxor a (bv-ones n)
-- eq_bits, neq_bits
bv-eq : (n : Word) → Bits n → Bits n → Bool
bv-eq n a b = weq a b
-- the bit at position i (vector_access), as Bits 1
bv-bit : (n : Word) → Bits n → Word → Bits #1
bv-bit n a i = wand (wshr a i) #1
-- x[hi .. lo] (vector_subrange): hi − lo + 1 bits
bv-slice : (n : Word) → Bits n → (hi lo : Word) → Bits (wadd (wsub hi lo) #1)
bv-slice n a hi lo = bv-mask (wadd (wsub hi lo) #1) (wshr a lo)
-- [x with hi .. lo = v] (vector_update_subrange)
bv-update : (n : Word) → Bits n → (hi lo : Word) → Bits (wadd (wsub hi lo) #1) → Bits n
bv-update n a hi lo v =
  let m : Word
      m = wshl (bv-ones (wadd (wsub hi lo) #1)) lo
  in wor (wxor a (wand a m)) (wshl v lo)
-- a @ b (append): a above the m bits of b
bv-append : (n m : Word) → Bits n → Bits m → Bits (wadd n m)
bv-append n m a b = wor (wshl a m) b
-- sail_zero_extend, truncate (sail_mask), sail_sign_extend: from n bits to m
bv-zext : (n m : Word) → Bits n → Bits m
bv-zext n m a = a
bv-trunc : (n m : Word) → Bits n → Bits m
bv-trunc n m a = bv-mask m a
bv-neg? : (n : Word) → Bits n → Bool
bv-neg? n a = if weq n #0 then false else weq (wshr a (wsub n #1)) #1
bv-sext : (n m : Word) → Bits n → Bits m
bv-sext n m a = if bv-neg? n a then wor a (wsub (bv-pow2 m) (bv-pow2 n)) else a
-- sail_shiftleft, sail_shiftright, sail_arith_shiftright, by k bits
bv-shl : (n : Word) → Bits n → Word → Bits n
bv-shl n a k = if wlt k n then bv-mask n (wshl a k) else #0
bv-shr : (n : Word) → Bits n → Word → Bits n
bv-shr n a k = wshr a k
bv-sar : (n : Word) → Bits n → Word → Bits n
bv-sar n a k =
  if bv-neg? n a
  then (if wlt k n then wor (wshr a k) (wsub (bv-pow2 n) (bv-pow2 (wsub n k))) else bv-ones n)
  else wshr a k
-- replicate_bits: k copies of the n bits of a
bv-replicate : (n : Word) → Bits n → (k : Word) → Bits (wmul n k)
bv-replicate n a k = %welimP (λ v → Word) k #0 (λ j h → wor (wshl h n) a)

-- ---------------------------------------------------------------- integers
data ZI = zpos (n : Word) | zneg (n : Word)
-- −m, with zneg #0 never built
z-mkneg : Word → ZI
z-mkneg m = if weq m #0 then zpos #0 else zneg m
-- the magnitude of a non-negative integer, #0 of a negative one (a width, a count, an index)
z-nat : ZI → Word
z-nat (zpos n) = n
z-nat (zneg n) = #0
z-mag : ZI → Word
z-mag (zpos n) = n
z-mag (zneg n) = n
z-negate : ZI → ZI
z-negate (zpos n) = z-mkneg n
z-negate (zneg n) = zpos n
-- a − b for words
z-diff : Word → Word → ZI
z-diff a b = if wlt a b then zneg (wsub b a) else zpos (wsub a b)
z-add : ZI → ZI → ZI
z-add (zpos a) (zpos b) = zpos (wadd a b)
z-add (zpos a) (zneg b) = z-diff a b
z-add (zneg a) (zpos b) = z-diff b a
z-add (zneg a) (zneg b) = zneg (wadd a b)
z-sub : ZI → ZI → ZI
z-sub a b = z-add a (z-negate b)
z-mul : ZI → ZI → ZI
z-mul (zpos a) (zpos b) = zpos (wmul a b)
z-mul (zpos a) (zneg b) = z-mkneg (wmul a b)
z-mul (zneg a) (zpos b) = z-mkneg (wmul a b)
z-mul (zneg a) (zneg b) = zpos (wmul a b)
z-eq : ZI → ZI → Bool
z-eq (zpos a) (zpos b) = weq a b
z-eq (zpos a) (zneg b) = false
z-eq (zneg a) (zpos b) = false
z-eq (zneg a) (zneg b) = weq a b
z-lt : ZI → ZI → Bool
z-lt (zpos a) (zpos b) = wlt a b
z-lt (zpos a) (zneg b) = false
z-lt (zneg a) (zpos b) = true
z-lt (zneg a) (zneg b) = wlt b a
z-le : ZI → ZI → Bool
z-le a b = b-not (z-lt b a)
z-abs : ZI → ZI
z-abs (zpos n) = zpos n
z-abs (zneg n) = zpos n
-- tdiv_int, tmod_int: division truncating toward zero, the remainder with the dividend's sign
z-tdiv : ZI → ZI → ZI
z-tdiv (zpos a) (zpos b) = zpos (wquot a b)
z-tdiv (zpos a) (zneg b) = z-mkneg (wquot a b)
z-tdiv (zneg a) (zpos b) = z-mkneg (wquot a b)
z-tdiv (zneg a) (zneg b) = zpos (wquot a b)
z-tmod : ZI → ZI → ZI
z-tmod (zpos a) (zpos b) = zpos (wrem a b)
z-tmod (zpos a) (zneg b) = zpos (wrem a b)
z-tmod (zneg a) (zpos b) = z-mkneg (wrem a b)
z-tmod (zneg a) (zneg b) = z-mkneg (wrem a b)
-- pow2, shl_int / _shl_int, shr_int / _shr_int (the floor of x / 2ᵏ)
z-pow2 : ZI → ZI
z-pow2 k = zpos (bv-pow2 (z-nat k))
z-shl : ZI → ZI → ZI
z-shl (zpos a) k = zpos (wshl a (z-nat k))
z-shl (zneg a) k = zneg (wshl a (z-nat k))
z-shr : ZI → ZI → ZI
z-shr (zpos a) k = zpos (wshr a (z-nat k))
z-shr (zneg a) k = zneg (wadd (wshr (wsub a #1) (z-nat k)) #1)

-- ---------------------------------------------------------------- between integers and bitvectors
-- unsigned, signed
bv-unsigned : (n : Word) → Bits n → ZI
bv-unsigned n a = zpos a
bv-signed : (n : Word) → Bits n → ZI
bv-signed n a = if bv-neg? n a then zneg (wsub (bv-pow2 n) a) else zpos a
-- get_slice_int(len, x, lo): len bits of the two's complement of x from bit lo
bv-of-int : (len : Word) → ZI → (lo : Word) → Bits len
bv-of-int len (zpos a) lo = bv-mask len (wshr a lo)
bv-of-int len (zneg a) lo = wxor (bv-mask len (wshr (wsub a #1) lo)) (bv-ones len)
-- set_slice_int(len, x, lo, v): x with those bits replaced by v
z-set-slice : (len : Word) → ZI → (lo : Word) → Bits len → ZI
z-set-slice len x lo v = z-add (z-sub x (zpos (wshl (bv-of-int len x lo) lo))) (zpos (wshl v lo))
-- add_bits_int: a + x modulo 2ⁿ
bv-add-int : (n : Word) → Bits n → ZI → Bits n
bv-add-int n a x = bv-add n a (bv-of-int n x #0)

-- ---------------------------------------------------------------- strings
Text : Type
Text = Word
-- the number of bytes: the base-256 digits (the recursion is bounded by the string itself)
str-len : Text → Word
str-len s = %welimP (λ v → Word → Word) s (λ x → #0) (λ j h x → if weq x #0 then #0 else wadd #1 (h (wshr x #8))) s
-- concat_str, eq_string
str-cat : Text → Text → Text
str-cat a b = wor (wshl a (wmul #8 (str-len b))) b
str-eq : Text → Text → Bool
str-eq a b = weq a b
-- a digit's character (0-9, A-F), and the k digits of x in a base, highest first
str-digit : Word → Word
str-digit d = if wlt d #10 then wadd #48 d else wadd #55 d
str-digits : (base k : Word) → Word → Text
str-digits base k x =
  %welimP (λ v → Word → Text) k (λ y → #0)
    (λ j h y → wor (wshl (h (wquot y base)) #8) (str-digit (wrem y base))) x
-- how many digits x has in a base (at least one; the recursion is bounded by x itself)
str-count : (base : Word) → Word → Word
str-count base x =
  %welimP (λ v → Word → Word) x (λ y → #1) (λ j h y → if wlt y base then #1 else wadd #1 (h (wquot y base))) x
-- dec_str, and bits_str ("0x" and hex digits when the width is a multiple of 4, else "0b" and bits)
str-of-int : ZI → Text
str-of-int (zpos n) = str-digits #10 (str-count #10 n) n
str-of-int (zneg n) = str-cat #45 (str-digits #10 (str-count #10 n) n)
str-of-bits : (n : Word) → Bits n → Text
str-of-bits n a =
  if weq (wrem n #4) #0
  then str-cat #12408 (str-digits #16 (wquot n #4) a)
  else str-cat #12386 (str-digits #2 n a)

-- ---------------------------------------------------------------- option, lists, vectors
data Option (A : Type) = None | Some (a : A)
is_some : {A : Type} → Option A → Bool
is_some None = false
is_some (Some a) = true
-- v[i] of a vector (d where the list is shorter: Sail has proved it is not), and [v with i = x]
vec-get : {A : Type} → A → List A → Word → A
vec-get d nil i = d
vec-get d (cons x xs) i = if weq i #0 then x else vec-get d xs (wsub i #1)
vec-len : {A : Type} → List A → Word
vec-len nil = #0
vec-len (cons x xs) = wadd #1 (vec-len xs)
vec-set : {A : Type} → List A → Word → A → List A
vec-set nil i y = nil
vec-set (cons x xs) i y = if weq i #0 then cons y xs else cons x (vec-set xs (wsub i #1) y)

-- ---------------------------------------------------------------- memory
-- a byte per 64-bit address; an address never written reads #0
ByteMap : Type
ByteMap = Word → Word
mem-none : ByteMap
mem-none a = #0
mem-load : ByteMap → Bits #64 → Bits #8
mem-load m a = m a
mem-store : ByteMap → Bits #64 → Bits #8 → ByteMap
mem-store m a v x = if weq x a then v else m x
mem-load-n : ByteMap → (n : Word) → Bits #64 → Bits (wmul #8 n)
mem-load-n m n a =
  %welimP (λ v → Word → Word) n (λ x → #0)
    (λ j h x → wor (mem-load m x) (wshl (h (bv-add #64 x #1)) #8)) a
mem-store-n : ByteMap → (n : Word) → Bits #64 → Bits (wmul #8 n) → ByteMap
mem-store-n m n a v =
  %welimP (λ w → ByteMap → Word → Word → ByteMap) n (λ k x y → k)
    (λ j h k x y → h (mem-store k x (wand y #255)) (bv-add #64 x #1) (wshr y #8)) m a v

-- ---------------------------------------------------------------- outcomes
-- E the model's exception type. An abort carries its reason as a string.
data Outc (E : Type) (A : Type) = out-val (a : A) | out-throw (e : E) | out-abort (why : Text)
-- "recursion bound"
recursion-bound : Text
recursion-bound = #595201153381180674530566830812520036
-- the outcome alone (a function that asserts or throws and touches no state)
fl-bind : {E A B : Type} → Outc E A → (A → Outc E B) → Outc E B
fl-bind (out-val a) k = k a
fl-bind (out-throw e) k = out-throw e
fl-bind (out-abort w) k = out-abort w
fl-assert : {E : Type} → Bool → Text → Outc E Unit
fl-assert c msg = if c then out-val unit else out-abort msg
fl-try : {E A : Type} → Outc E A → (E → Outc E A) → Outc E A
fl-try (out-val a) h = out-val a
fl-try (out-throw e) h = h e
fl-try (out-abort w) h = out-abort w
-- state and outcome
State : Type → Type → Type → Type
State S E A = S → Outc E A × S
st-ret : {S E A : Type} → A → State S E A
st-ret a s = (out-val a , s)
st-lift : {S E A : Type} → Outc E A → State S E A
st-lift r s = (r , s)
st-on : {S E A B : Type} → Outc E A → (A → State S E B) → State S E B
st-on (out-val a) k s = k a s
st-on (out-throw e) k s = (out-throw e , s)
st-on (out-abort w) k s = (out-abort w , s)
st-step : {S E A B : Type} → (A → State S E B) → Outc E A × S → Outc E B × S
st-step k r = st-on (fst r) k (snd r)
st-bind : {S E A B : Type} → State S E A → (A → State S E B) → State S E B
st-bind m k s = st-step k (m s)
st-catch : {S E A : Type} → (E → State S E A) → Outc E A × S → Outc E A × S
st-catch {S} {E} {A} h r = case fst r return (λ _ → Outc E A × S) of
  out-val a → r
  out-throw e → h e (snd r)
  out-abort w → r
st-try : {S E A : Type} → State S E A → (E → State S E A) → State S E A
st-try m h s = st-catch h (m s)
-- foreach (i from lo to hi): the body at lo, lo + 1, …, hi, threading an accumulator
st-loop-up : {S E A : Type} → (count : Word) → ZI → A → (ZI → A → State S E A) → State S E A
st-loop-up {S} {E} {A} count lo a f =
  %welimP (λ v → ZI → A → State S E A) count (λ i x → st-ret x)
    (λ j h i x → st-bind (f i x) (λ y → h (z-add i (zpos #1)) y)) lo a
st-foreach : {S E A : Type} → (lo hi : ZI) → A → (ZI → A → State S E A) → State S E A
st-foreach lo hi a f = st-loop-up (z-nat (z-add (z-sub hi lo) (zpos #1))) lo a f
