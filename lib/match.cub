-- lib/match.cub — first-order matching and rewriting over codes. Loaded after lib/code.cub.
-- The one operation behind the specializer's rewriting along marked theorems (plan 18.6 step
-- 3) and the navigation layer's "available transports" (18.14): given an identity whose left
-- side is a pattern, find every position in a term where the pattern matches, and replace it by
-- the right side under the match. A pattern is a code whose variables above a bound are
-- metavariables; matching binds them; the match is a list of (metavariable, code).
-- Variables are de Bruijn indices (code.cub). A pattern with k bound variables (its own λs,
-- counted from the outside) uses cvar n with n ≥ k as metavariables m = n − k. A metavariable
-- that occurs under b binders of the pattern binds a subterm that is then shifted by b when
-- instantiated under different binders.
-- ---------------------------------------------------------------- codes: shifting
-- shift-code d k c: add k to every free variable of c that is ≥ d (variables bound inside c are
-- below their binders' depth and untouched)
shift-code d k c =
  case c of
    cvar n → if %wlt n d then c else cvar (%wadd n k)
    clam b → clam (shift-code (%wsucc d) k b)
    capp f a → capp (shift-code d k f) (shift-code d k a)
    cpair a b → cpair (shift-code d k a) (shift-code d k b)
    cfst p → cfst (shift-code d k p)
    csnd p → csnd (shift-code d k p)
    cpi m A B → cpi m (shift-code d k A) (shift-code (%wsucc d) k B)
    csigma A B → csigma (shift-code d k A) (shift-code (%wsucc d) k B)
    cpathp A a b → cpathp (shift-code d k A) (shift-code d k a) (shift-code d k b)
    cplam b → cplam (shift-code (%wsucc d) k b)
    cpapp p r → cpapp (shift-code d k p) (shift-code d k r)
    clet t b → clet (shift-code d k t) (shift-code (%wsucc d) k b)
    cann t T → cann (shift-code d k t) (shift-code d k T)
    ccon dd c2 fs ds → ccon dd c2 (shift-list d k fs) (shift-list d k ds)
    ccase dd B x → ccase dd (shift-list d k B) (shift-code d k x)
    celim dd P B x → celim dd (shift-code d k P) (shift-list d k B) (shift-code d k x)
    cforce x → cforce (shift-code d k x)
    cthunk x → cthunk (shift-code d k x)
    cdata dd ps → cdata dd (shift-list d k ps)
    cwsucc a → cwsucc (shift-code d k a)
    cwop o a b → cwop o (shift-code d k a) (shift-code d k b)
    cwelim w z s mo → cwelim (shift-code d k w) (shift-code d k z) (shift-code d k s) (omap (shift-code d k) mo)
    _ → c
shift-list d k l = case l of lnil → lnil; lcons x xs → lcons (shift-code d k x) (shift-list d k xs)
-- ---------------------------------------------------------------- substitutions
-- a match: metavariable → code, as an association list; lookup, extension with a consistency
-- check (a metavariable met twice binds equal codes)
data Match = mnil | mcons (m : Word) (c : Code) (rest : Match)
mlookup s m = case s of mnil → none; mcons m2 c r → if %weq m m2 then some c else mlookup r m
-- structural equality of codes (the fragment matching covers)
code-same a b =
  case a of
    cvar n → (case b of cvar m → %weq n m; _ → false)
    cglob n → (case b of cglob m → %weq n m; _ → false)
    clam x → (case b of clam y → code-same x y; _ → false)
    capp f x → (case b of capp g y → andb (code-same f g) (code-same x y); _ → false)
    cpair x y → (case b of cpair x2 y2 → andb (code-same x x2) (code-same y y2); _ → false)
    cfst x → (case b of cfst y → code-same x y; _ → false)
    csnd x → (case b of csnd y → code-same x y; _ → false)
    clet t x → (case b of clet t2 y → andb (code-same t t2) (code-same x y); _ → false)
    ccon d c fs ds → (case b of ccon d2 c2 fs2 ds2 → andb (%weq d d2) (andb (%weq c c2) (andb (list-same fs fs2) (list-same ds ds2))); _ → false)
    ccase d B x → (case b of ccase d2 B2 y → andb (%weq d d2) (andb (list-same B B2) (code-same x y)); _ → false)
    celim d P B x → (case b of celim d2 P2 B2 y → andb (%weq d d2) (andb (code-same P P2) (andb (list-same B B2) (code-same x y))); _ → false)
    cforce x → (case b of cforce y → code-same x y; _ → false)
    cthunk x → (case b of cthunk y → code-same x y; _ → false)
    cdata d ps → (case b of cdata d2 ps2 → andb (%weq d d2) (list-same ps ps2); _ → false)
    cwlit n → (case b of cwlit m → %weq n m; _ → false)
    cwsucc x → (case b of cwsucc y → code-same x y; _ → false)
    cwop o x y → (case b of cwop o2 x2 y2 → andb (%weq o o2) (andb (code-same x x2) (code-same y y2)); _ → false)
    cwelim w z s mo → (case b of cwelim w2 z2 s2 mo2 → andb (code-same w w2) (andb (code-same z z2) (code-same s s2)); _ → false)
    cann t T → (case b of cann t2 T2 → code-same t t2; _ → false)
    -- types, as a residual's motives hold them (a specialized process's eliminations)
    cpi m x y → (case b of cpi m2 x2 y2 → andb (%weq m m2) (andb (code-same x x2) (code-same y y2)); _ → false)
    csigma x y → (case b of csigma x2 y2 → andb (code-same x x2) (code-same y y2); _ → false)
    cuniv l → (case b of cuniv l2 → code-same l l2; _ → false)
    cword → (case b of cword → true; _ → false)
    cpty k n → (case b of cpty k2 n2 → andb (%weq k k2) (code-same n n2); _ → false)
    cplit k x → (case b of cplit k2 x2 → andb (%weq k k2) (%weq x x2); _ → false)
    cprim k as → (case b of cprim k2 as2 → andb (%weq k k2) (list-same as as2); _ → false)
    clzero → (case b of clzero → true; _ → false)
    clsuc l → (case b of clsuc l2 → code-same l l2; _ → false)
    clmax x y → (case b of clmax x2 y2 → andb (code-same x x2) (code-same y y2); _ → false)
    _ → false
list-same l m =
  case l of
    lnil → (case m of lnil → true; _ → false)
    lcons x xs → (case m of lcons y ys → andb (code-same x y) (list-same xs ys); _ → false)
andb a b = case a of true → b; false → false
-- ---------------------------------------------------------------- matching
-- match k b p t s: pattern p (with k pattern-bound variables above which are metavariables),
-- under b binders inside the pattern so far, against t; s the match so far; none on failure.
-- A metavariable binds t shifted down by b (t's variables bound inside the pattern's binders
-- cannot escape: those below b make the match fail)
match k b p t s =
  case p of
    cvar n →
      if %wlt n (%wadd k b)
        then (case t of cvar m → if %weq n m then some s else none; _ → none)
        else (let m = %wsub n (%wadd k b)
              in if mentions-below b t then none
                 else (case mlookup s m of
                         none → some (mcons m (unshift b t) s)
                         some c → if code-same c (unshift b t) then some s else none))
    cglob n → (case t of cglob m → if %weq n m then some s else none; _ → none)
    clam x → (case t of clam y → match k (%wsucc b) x y s; _ → none)
    capp f x → (case t of capp g y → (case match k b f g s of some s2 → match k b x y s2; none → none); _ → none)
    cpair x y → (case t of cpair x2 y2 → (case match k b x x2 s of some s2 → match k b y y2 s2; none → none); _ → none)
    cfst x → (case t of cfst y → match k b x y s; _ → none)
    csnd x → (case t of csnd y → match k b x y s; _ → none)
    clet a x → (case t of clet a2 y → (case match k b a a2 s of some s2 → match k (%wsucc b) x y s2; none → none); _ → none)
    ccon d c fs ds → (case t of ccon d2 c2 fs2 ds2 → if andb (%weq d d2) (%weq c c2) then match-list k b fs fs2 s else none; _ → none)
    celim d P B x → (case t of celim d2 P2 B2 y → if %weq d d2 then (case match k b P P2 s of some s2 → (case match-list k b B B2 s2 of some s3 → match k b x y s3; none → none); none → none) else none; _ → none)
    ccase d B x → (case t of ccase d2 B2 y → if %weq d d2 then (case match-list k b B B2 s of some s2 → match k b x y s2; none → none) else none; _ → none)
    cforce x → (case t of cforce y → match k b x y s; _ → none)
    cthunk x → (case t of cthunk y → match k b x y s; _ → none)
    cdata d ps → (case t of cdata d2 ps2 → if %weq d d2 then match-list k b ps ps2 s else none; _ → none)
    cwlit n → (case t of cwlit m → if %weq n m then some s else none; _ → none)
    cwelim w z st mo → (case t of cwelim w2 z2 st2 mo2 → (case match k b w w2 s of some s2 → (case match k b z z2 s2 of some s3 → match k b st st2 s3; none → none); none → none); _ → none)
    cwsucc x → (case t of cwsucc y → match k b x y s; _ → none)
    cwop o x y → (case t of cwop o2 x2 y2 → if %weq o o2 then (case match k b x x2 s of some s2 → match k b y y2 s2; none → none) else none; _ → none)
    cann a T → match k b a t s
    -- the word type, primitive types and literals, stuck primitives, Π and Σ (a motive or a field's
    -- type in a normal form)
    cword → (case t of cword → some s; _ → none)
    cpty q n → (case t of cpty q2 n2 → if %weq q q2 then match k b n n2 s else none; _ → none)
    cplit q x → (case t of cplit q2 x2 → if andb (%weq q q2) (%weq x x2) then some s else none; _ → none)
    cprim q as → (case t of cprim q2 as2 → if %weq q q2 then match-list k b as as2 s else none; _ → none)
    cpi m x y → (case t of cpi m2 x2 y2 → if %weq m m2 then (case match k b x x2 s of some s2 → match k (%wsucc b) y y2 s2; none → none) else none; _ → none)
    csigma x y → (case t of csigma x2 y2 → (case match k b x x2 s of some s2 → match k (%wsucc b) y y2 s2; none → none); _ → none)
    _ → none
match-list k b ps ts s =
  case ps of
    lnil → (case ts of lnil → some s; _ → none)
    lcons p pr → (case ts of lcons t tr → (case match k b p t s of some s2 → match-list k b pr tr s2; none → none); _ → none)
-- does t mention a variable below depth b (bound inside the pattern's binders)?
mentions-below b t = if %weq b #0 then false else mentions-lt #0 b t
mentions-lt d b t =
  case t of
    cvar n → andb (notb (%wlt n d)) (%wlt n (%wadd d b))
    clam x → mentions-lt (%wsucc d) b x
    capp f x → orb (mentions-lt d b f) (mentions-lt d b x)
    cpair x y → orb (mentions-lt d b x) (mentions-lt d b y)
    cfst x → mentions-lt d b x
    csnd x → mentions-lt d b x
    clet a x → orb (mentions-lt d b a) (mentions-lt (%wsucc d) b x)
    ccon dd c fs ds → mentions-any d b fs
    ccase dd B x → orb (mentions-any d b B) (mentions-lt d b x)
    celim dd P B x → orb (mentions-lt d b P) (orb (mentions-any d b B) (mentions-lt d b x))
    cforce x → mentions-lt d b x
    cthunk x → mentions-lt d b x
    cdata dd ps → mentions-any d b ps
    cwsucc x → mentions-lt d b x
    cwop o x y → orb (mentions-lt d b x) (mentions-lt d b y)
    cwelim w z s mo → orb (mentions-lt d b w) (orb (mentions-lt d b z) (orb (mentions-lt d b s) (case mo of some P → mentions-lt d b P; none → false)))
    cann a T → mentions-lt d b a
    cpty q n → mentions-lt d b n
    cprim q as → mentions-any d b as
    cpi m x y → orb (mentions-lt d b x) (mentions-lt (%wsucc d) b y)
    csigma x y → orb (mentions-lt d b x) (mentions-lt (%wsucc d) b y)
    _ → false
mentions-any d b l = case l of lnil → false; lcons x xs → orb (mentions-lt d b x) (mentions-any d b xs)
orb a b = case a of true → true; false → b
notb a = case a of true → false; false → true
-- shifting down by b: every free variable ≥ b becomes n − b (none below b is present, checked)
unshift b t = unshift-at #0 b t
unshift-at d b c =
  case c of
    cvar n → if %wlt n d then c else cvar (%wsub n b)
    clam x → clam (unshift-at (%wsucc d) b x)
    capp f x → capp (unshift-at d b f) (unshift-at d b x)
    cpair x y → cpair (unshift-at d b x) (unshift-at d b y)
    cfst x → cfst (unshift-at d b x)
    csnd x → csnd (unshift-at d b x)
    clet a x → clet (unshift-at d b a) (unshift-at (%wsucc d) b x)
    ccon dd c2 fs ds → ccon dd c2 (unshift-list d b fs) (unshift-list d b ds)
    ccase dd B x → ccase dd (unshift-list d b B) (unshift-at d b x)
    celim dd P B x → celim dd (unshift-at d b P) (unshift-list d b B) (unshift-at d b x)
    cforce x → cforce (unshift-at d b x)
    cthunk x → cthunk (unshift-at d b x)
    cdata dd ps → cdata dd (unshift-list d b ps)
    cwsucc x → cwsucc (unshift-at d b x)
    cwop o x y → cwop o (unshift-at d b x) (unshift-at d b y)
    cwelim w z s mo → cwelim (unshift-at d b w) (unshift-at d b z) (unshift-at d b s) (omap (unshift-at d b) mo)
    cann a T → cann (unshift-at d b a) (unshift-at d b T)
    cpty q n → cpty q (unshift-at d b n)
    cprim q as → cprim q (unshift-list d b as)
    cpi m x y → cpi m (unshift-at d b x) (unshift-at (%wsucc d) b y)
    csigma x y → csigma (unshift-at d b x) (unshift-at (%wsucc d) b y)
    _ → c
unshift-list d b l = case l of lnil → lnil; lcons x xs → lcons (unshift-at d b x) (unshift-list d b xs)
-- ---------------------------------------------------------------- instantiation
-- inst k b s p: the pattern p with its metavariables replaced from s, each bound code shifted by
-- the binders b it is placed under
inst k b s p =
  case p of
    cvar n →
      if %wlt n (%wadd k b) then p
      else (case mlookup s (%wsub n (%wadd k b)) of some c → shift-code #0 b c; none → p)
    clam x → clam (inst k (%wsucc b) s x)
    capp f x → capp (inst k b s f) (inst k b s x)
    cpair x y → cpair (inst k b s x) (inst k b s y)
    cfst x → cfst (inst k b s x)
    csnd x → csnd (inst k b s x)
    clet a x → clet (inst k b s a) (inst k (%wsucc b) s x)
    ccon d c fs ds → ccon d c (inst-list k b s fs) (inst-list k b s ds)
    ccase d B x → ccase d (inst-list k b s B) (inst k b s x)
    celim d P B x → celim d (inst k b s P) (inst-list k b s B) (inst k b s x)
    cforce x → cforce (inst k b s x)
    cthunk x → cthunk (inst k b s x)
    cdata d ps → cdata d (inst-list k b s ps)
    cwsucc x → cwsucc (inst k b s x)
    cwop o x y → cwop o (inst k b s x) (inst k b s y)
    cwelim w z st mo → cwelim (inst k b s w) (inst k b s z) (inst k b s st) (omap (inst k b s) mo)
    cann a T → cann (inst k b s a) (inst k b s T)
    cpty q n → cpty q (inst k b s n)
    cprim q as → cprim q (inst-list k b s as)
    cpi m x y → cpi m (inst k b s x) (inst k (%wsucc b) s y)
    csigma x y → csigma (inst k b s x) (inst k (%wsucc b) s y)
    _ → p
inst-list k b s l = case l of lnil → lnil; lcons x xs → lcons (inst k b s x) (inst-list k b s xs)
-- ---------------------------------------------------------------- rules and positions
-- a rule: k metavariable-bound pattern depth, left side, right side, and its justification: the
-- theorem of the store it was read from (its global g, the number n of its Π-bound variables, and
-- whether it is read right to left), or none for a hand-written rule, which navigation may use but
-- the specializer refuses (a rewrite it cannot justify by a path is not a rewrite it makes)
data Just = nojust | thm (g : Word) (n : Word) (rev : Bool)
data Rule = rule (k : Word) (lhs : Code) (rhs : Code) (just : Just)
-- a position: a list of child indices from the root (words); child order as the code's fields
-- rewrite-at r t: the term with the rule applied at the root if it matches, else none
rewrite-root r t =
  case r of
    rule k l rh j → (case match k #0 l t mnil of some s → some (inst k #0 s rh); none → none)
-- the rewrite at the root with its justifying path, the root under d binders of the whole term: the
-- rewritten code, and the code of the path λ i → (g σ) @ i from t to it, g the theorem applied to
-- the metavariables' instances (σ, the match), read backwards (@ ~i) for a symmetric rule. The path
-- is placed under the dimension binder, the outermost one: t's variables that refer outside the
-- term (at or above d) shift by one, and the dimension is cvar d. none for a hand-written rule
rewrite-root-path d r t =
  case r of
    rule k l rh j →
      (case j of
         nojust → none
         thm g n rev →
           (case match k #0 l t mnil of
              some s → some (inst k #0 s rh , cpapp (shift-code d #1 (thm-app g n s)) (if rev then cneg (cvar d) else cvar d))
              none → none))
-- the theorem g applied to its n variables' instances from the match s: variable x_j (de Bruijn n−1−j
-- in the theorem's body) is metavariable n−1−j, so x_1 is metavariable n−1 and x_n is metavariable 0
thm-app g n s = thm-app-from g n #0 s (cglob g)
thm-app-from g n i s acc = if %weq i n then acc else thm-app-from g n (%wsucc i) s (capp acc (case mlookup s (%wsub (%wsub n #1) i) of some c → c; none → cwlit #0))
-- rewrite-first-path r t: the first position in pre-order where the rule applies, rewritten, with
-- the path λ i → t[(g σ) @ i at that position]; every untouched part is shifted by one for the
-- dimension binder (d the binder depth, so the hole's reference to the dimension is cvar d)
rewrite-first-path r t = case rfp r #0 t of none → none; some p → some (fst p , cplam (snd p))
rfp r d t =
  case rewrite-root-path d r t of
    some p → some p
    none →
      (case t of
         clam x → omap2 clam clam (rfp r (%wsucc d) x)
         capp f a → (case rfp r d f of some p → some (capp (fst p) a , capp (snd p) (sh1 d a)); none → omap2 (capp f) (capp (sh1 d f)) (rfp r d a))
         cpair a b → (case rfp r d a of some p → some (cpair (fst p) b , cpair (snd p) (sh1 d b)); none → omap2 (cpair a) (cpair (sh1 d a)) (rfp r d b))
         cfst x → omap2 cfst cfst (rfp r d x)
         csnd x → omap2 csnd csnd (rfp r d x)
         clet a x → (case rfp r d a of some p → some (clet (fst p) x , clet (snd p) (sh1 (%wsucc d) x)); none → omap2 (clet a) (clet (sh1 d a)) (rfp r (%wsucc d) x))
         ccon dd c fs ds → omap2 (λ fs2 → ccon dd c fs2 ds) (λ fs2 → ccon dd c fs2 (sh1-list d ds)) (rfp-list r d fs)
         ccase dd B x → (case rfp r d x of some p → some (ccase dd B (fst p) , ccase dd (sh1-list d B) (snd p)); none → omap2 (λ B2 → ccase dd B2 x) (λ B2 → ccase dd B2 (sh1 d x)) (rfp-list r d B))
         celim dd P B x → (case rfp r d x of some p → some (celim dd P B (fst p) , celim dd (sh1 d P) (sh1-list d B) (snd p)); none → omap2 (λ B2 → celim dd P B2 x) (λ B2 → celim dd (sh1 d P) B2 (sh1 d x)) (rfp-list r d B))
         cwop o a b → (case rfp r d a of some p → some (cwop o (fst p) b , cwop o (snd p) (sh1 d b)); none → omap2 (cwop o a) (cwop o (sh1 d a)) (rfp r d b))
         cwsucc a → omap2 cwsucc cwsucc (rfp r d a)
         cwelim w z s mo → (case rfp r d w of
                              some p → some (cwelim (fst p) z s mo , cwelim (snd p) (sh1 d z) (sh1 d s) (omap (sh1 d) mo))
                              none → (case rfp r d z of
                                        some p → some (cwelim w (fst p) s mo , cwelim (sh1 d w) (snd p) (sh1 d s) (omap (sh1 d) mo))
                                        none → omap2 (λ s2 → cwelim w z s2 mo) (λ s2 → cwelim (sh1 d w) (sh1 d z) s2 (omap (sh1 d) mo)) (rfp r d s)))
         cprim q as → omap2 (cprim q) (cprim q) (rfp-list r d as)
         cann a T → omap2 (λ a2 → cann a2 T) (λ a2 → cann a2 (sh1 d T)) (rfp r d a)
         cforce x → omap2 cforce cforce (rfp r d x)
         cthunk x → omap2 cthunk cthunk (rfp r d x)
         _ → none)
rfp-list r d l =
  case l of
    lnil → none
    lcons x xs → (case rfp r d x of some p → some (lcons (fst p) xs , lcons (snd p) (sh1-list d xs)); none → omap2 (lcons x) (lcons (sh1 d x)) (rfp-list r d xs))
sh1 d c = shift-code d #1 c
sh1-list d l = case l of lnil → lnil; lcons x xs → lcons (sh1 d x) (sh1-list d xs)
omap2 f g o = case o of none → none; some p → some (f (fst p) , g (snd p))
-- rewrite-anywhere r t: the first position in pre-order where the rule applies, rewritten; the
-- binder depth is tracked so that a metavariable never captures (match refuses it)
rewrite-first r t =
  case rewrite-root r t of
    some t2 → some t2
    none →
      (case t of
         clam x → omap clam (rewrite-first r x)
         capp f a → (case rewrite-first r f of some f2 → some (capp f2 a); none → omap (capp f) (rewrite-first r a))
         cpair a b → (case rewrite-first r a of some a2 → some (cpair a2 b); none → omap (cpair a) (rewrite-first r b))
         cfst p → omap cfst (rewrite-first r p)
         csnd p → omap csnd (rewrite-first r p)
         clet a b → (case rewrite-first r a of some a2 → some (clet a2 b); none → omap (clet a) (rewrite-first r b))
         ccon d c fs ds → omap (λ fs2 → ccon d c fs2 ds) (rewrite-first-list r fs)
         ccase d B x → (case rewrite-first r x of some x2 → some (ccase d B x2); none → omap (λ B2 → ccase d B2 x) (rewrite-first-list r B))
         celim d P B x → (case rewrite-first r x of some x2 → some (celim d P B x2); none → (case rewrite-first-list r B of some B2 → some (celim d P B2 x); none → omap (λ P2 → celim d P2 B x) (rewrite-first r P)))
         cforce x → omap cforce (rewrite-first r x)
         cthunk x → omap cthunk (rewrite-first r x)
         cdata d ps → omap (cdata d) (rewrite-first-list r ps)
         cwsucc a → omap cwsucc (rewrite-first r a)
         cwelim w z st mo → (case rewrite-first r w of some w2 → some (cwelim w2 z st mo); none → (case rewrite-first r z of some z2 → some (cwelim w z2 st mo); none → omap (λ st2 → cwelim w z st2 mo) (rewrite-first r st)))
         cwop o a b → (case rewrite-first r a of some a2 → some (cwop o a2 b); none → omap (cwop o a) (rewrite-first r b))
         cprim q as → omap (cprim q) (rewrite-first-list r as)
         _ → none)
rewrite-first-list r l =
  case l of
    lnil → none
    lcons x xs → (case rewrite-first r x of some x2 → some (lcons x2 xs); none → omap (lcons x) (rewrite-first-list r xs))
omap f o = case o of none → none; some x → some (f x)
-- count-applicable r t: how many positions the rule applies at (the size of "available" for one
-- identity); navigation chooses among them
count-applicable r t =
  %wadd (case rewrite-root r t of some x → #1; none → #0)
    (case t of
       clam x → count-applicable r x
       capp f a → %wadd (count-applicable r f) (count-applicable r a)
       cpair a b → %wadd (count-applicable r a) (count-applicable r b)
       cfst p → count-applicable r p
       csnd p → count-applicable r p
       clet a b → %wadd (count-applicable r a) (count-applicable r b)
       ccon d c fs ds → count-list r fs
       ccase d B x → %wadd (count-applicable r x) (count-list r B)
       cwsucc a → count-applicable r a
       cwop o a b → %wadd (count-applicable r a) (count-applicable r b)
       _ → #0)
count-list r l = case l of lnil → #0; lcons x xs → %wadd (count-applicable r x) (count-list r xs)
-- ---------------------------------------------------------------- the terminating discipline (18.6 step 3)
-- A rule is oriented when its right side is smaller than its left (node count) and no
-- metavariable occurs more often on the right than on the left: then every instance of the right
-- side is strictly smaller than the instance of the left it replaces (a metavariable's code of size
-- s replaces a node of size 1 on each side, at most as often on the right), so rewriting along
-- oriented rules terminates by the size of the term and needs no bound. A rule whose sides are of
-- one size (commutativity shapes, associativity read either way) is unoriented and rejected
-- (E-rule-unoriented); the specializer applies those only under its bound
code-size c =
  case c of
    clam x → %wsucc (code-size x)
    capp f a → %wsucc (%wadd (code-size f) (code-size a))
    cpair a b → %wsucc (%wadd (code-size a) (code-size b))
    cfst p → %wsucc (code-size p)
    csnd p → %wsucc (code-size p)
    clet a b → %wsucc (%wadd (code-size a) (code-size b))
    ccon d k fs ds → %wsucc (%wadd (size-list fs) (size-list ds))
    ccase d B x → %wsucc (%wadd (size-list B) (code-size x))
    celim d P B x → %wsucc (%wadd (code-size P) (%wadd (size-list B) (code-size x)))
    cforce x → %wsucc (code-size x)
    cthunk x → %wsucc (code-size x)
    cdata d ps → %wsucc (size-list ps)
    cwsucc a → %wsucc (code-size a)
    cwop o a b → %wsucc (%wadd (code-size a) (code-size b))
    cwelim w z s mo → %wsucc (%wadd (code-size w) (%wadd (code-size z) (code-size s)))
    cann a T → %wsucc (%wadd (code-size a) (code-size T))
    cpi m A B → %wsucc (%wadd (code-size A) (code-size B))
    csigma A B → %wsucc (%wadd (code-size A) (code-size B))
    cprim k as → %wsucc (size-list as)
    _ → #1
size-list l = case l of lnil → #0; lcons x xs → %wadd (code-size x) (size-list xs)
-- occurrences of metavariable m (cvar m at pattern depth 0, cvar (m + d) under d binders) in a code
mv-count m d c =
  case c of
    cvar n → if %weq n (%wadd m d) then #1 else #0
    clam x → mv-count m (%wsucc d) x
    capp f a → %wadd (mv-count m d f) (mv-count m d a)
    cpair a b → %wadd (mv-count m d a) (mv-count m d b)
    cfst p → mv-count m d p
    csnd p → mv-count m d p
    clet a b → %wadd (mv-count m d a) (mv-count m (%wsucc d) b)
    ccon dd k fs ds → %wadd (mv-list m d fs) (mv-list m d ds)
    ccase dd B x → %wadd (mv-list m d B) (mv-count m d x)
    celim dd P B x → %wadd (mv-count m d P) (%wadd (mv-list m d B) (mv-count m d x))
    cforce x → mv-count m d x
    cthunk x → mv-count m d x
    cdata dd ps → mv-list m d ps
    cwsucc a → mv-count m d a
    cwop o a b → %wadd (mv-count m d a) (mv-count m d b)
    cwelim w z s mo → %wadd (mv-count m d w) (%wadd (mv-count m d z) (mv-count m d s))
    cann a T → %wadd (mv-count m d a) (mv-count m d T)
    cpi mm A B → %wadd (mv-count m d A) (mv-count m (%wsucc d) B)
    csigma A B → %wadd (mv-count m d A) (mv-count m (%wsucc d) B)
    cprim k as → mv-list m d as
    _ → #0
mv-list m d l = case l of lnil → #0; lcons x xs → %wadd (mv-count m d x) (mv-list m d xs)
oriented r = case r of rule k l rh j → andb (%wlt (code-size rh) (code-size l)) (mv-ok k #0 l rh)
mv-ok k m l rh = if %weq m k then true else andb (notb (%wlt (mv-count m #0 l) (mv-count m #0 rh))) (mv-ok k (%wsucc m) l rh)
-- the rules split: (oriented , rejected)
orient-rules rules = case rules of lnil → (lnil , lnil); lcons r rest → (let o = orient-rules rest in if oriented r then (lcons r (fst o) , snd o) else (fst o , lcons r (snd o)))
-- rewriting along oriented rules until none applies: terminates by the size of the term
rewrite-fix rules c = case first-applicable rules c of none → c; some c2 → rewrite-fix rules c2
first-applicable rules c =
  case rules of
    lnil → none
    lcons r rest → (case rewrite-first r c of some c2 → some c2; none → first-applicable rest c)
