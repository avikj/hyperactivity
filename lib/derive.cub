-- lib/derive.cub — generic programming over the data table (plan 18.13, F31: deriving as terms
-- over %dent producing codes). Loaded after lib/check.cub and lib/lower.cub (didx). derive-eq d: the code of a decidable
-- equality on the data type d, read off its constructors' telescopes: a word field compares by
-- %weq, a recursive field by the hypothesis the case provides, a field of another data type by that
-- type's derived equality; constructors with dimensions (higher inductive types) and other field
-- types are not covered (none). The code evaluates (eval-g) and quotes like any other.
-- ---------------------------------------------------------------- shapes
-- the kinds of a constructor's fields, by walking its telescope with fresh variables: a Lst of
-- (kind , d2): kind 0 a word, 1 recursive, 2 a data type d2 without parameters; none otherwise
-- (some kinds, or none)
dfield-kind d A =
  if is-rec-ty d A then some (#1 , d)
  else (case A of
          tword → some (#0 , d)
          tdata d2 ps V → (case ps of lnil → some (#2 , d2); _ → none)
          tg g nm → (case %view (%gval g) of wpty k n → (if %weq k #4 then none else some (#3 , k)); _ → none)
          _ → none)
-- a primitive type's equality is the machine's operation on it (lib/code.cub prim-apply's
-- numbering: the binary operations from 512; i64eq 3, u32eq 8, f64eq 14), as a cprim code
prim-eq-op k = %wadd #512 (if %weq k #0 then #3 else if %weq k #1 then #8 else #14)
dtel-kinds d tel acc =
  case tel of
    tx A nm r → (case dfield-kind d A of
                   some k → (let Av = tval A in dtel-kinds d (r (%var nm Av) Av) (lsnoc acc k))
                   none → none)
    ty nm r → none
    tz e → some acc
dshape d c = dtel-kinds d (centry d c lnil) lnil
nctors d = lst-count (ctors-at d lnil)
count-rec ks = case ks of lnil → #0; lcons k r → %wadd (if %weq (fst k) #1 then #1 else #0) (count-rec r)
-- ---------------------------------------------------------------- codes
-- Bool is the first checked data type: true = con 0, false = con 1
bool-d = didx (code Bool)
c-true = ccon bool-d #0 lnil lnil
c-false = ccon bool-d #1 lnil lnil
c-and a b = ccase bool-d (lcons b (lcons c-false lnil)) a
clams n b = if %weq n #0 then b else clam (clams (%wsub n #1) b)
-- derive-eq d = λ x. case x of c (fields, hyps) → λ y. case y of c' (fields', hyps') → …
derive-eq d =
  case all-shapes d (nctors d) #0 of
    none → none
    some shapes → some (clam (ccase d (outer-branches d shapes shapes #0) (cvar #0)))
all-shapes d n c =
  if %weq c n then some lnil
  else (case dshape d c of
          none → none
          some ks → (case all-shapes d n (%wsucc c) of none → none; some rest → some (lcons ks rest)))
outer-branches d shapes rest c =
  case rest of
    lnil → lnil
    lcons ks more →
      lcons (clams (%wadd (lst-count ks) (count-rec ks)) (clam (ccase d (inner-branches d shapes ks shapes #0 c) (cvar #0))))
            (outer-branches d shapes more (%wsucc c))
-- the inner branch for constructor c2 against the outer constructor c with field kinds ks
inner-branches d shapes ks rest c2 c =
  case rest of
    lnil → lnil
    lcons ks2 more →
      lcons (clams (%wadd (lst-count ks2) (count-rec ks2))
               (if %weq c2 c then compare-fields d ks ks2 (lst-count ks) (count-rec ks) (lst-count ks2) (count-rec ks2) #0 #0
                else c-false))
            (inner-branches d shapes ks more (%wsucc c2) c)
-- at the innermost body: inner hyps r2 (0..), inner fields n2, y, outer hyps r, outer fields n, x
compare-fields d ks ks2 n r n2 r2 j t =
  case ks of
    lnil → c-true
    lcons k kr →
      let outer-f = cvar (%wadd (%wadd (%wadd r2 n2) (%wsucc r)) (%wsub (%wsub n #1) j))
          inner-f = cvar (%wadd r2 (%wsub (%wsub n2 #1) j))
          outer-h = cvar (%wadd (%wadd r2 n2) (%wsucc (%wsub (%wsub r #1) t)))
          this = (if %weq (fst k) #0 then cwop #0 outer-f inner-f
                  else if %weq (fst k) #1 then capp (cforce outer-h) inner-f
                  else if %weq (fst k) #3 then cprim (prim-eq-op (snd k)) (lcons outer-f (lcons inner-f lnil))
                  else capp (capp (fromopt (derive-eq (snd k)) c-false) outer-f) inner-f)
          rest = compare-fields d kr ks2 n r n2 r2 (%wsucc j) (if %weq (fst k) #1 then %wsucc t else t)
      in (case kr of lnil → this; _ → c-and this rest)
lappw : List Word → List Word → List Word
lappw xs ys = case xs return (λ w → List Word) of nil → ys; cons x r → cons x (rec r)
lapp-same : List Word → List Word → Bool
lapp-same xs ys =
  case xs return (λ w → List Word → Bool) of
    nil → λ ys → (case ys return (λ w → Bool) of nil → true; cons y s → false)
    cons x r → λ ys → (case ys return (λ w → Bool) of nil → false; cons y s → andB (weq x y) (rec r s))
  ys
-- ---------------------------------------------------------------- deriving show
-- derive-show d: the code of a function D → List Word writing a value in preorder — each
-- constructor's index, then its fields: a word as itself, a recursive field by the hypothesis the
-- case provides (its own writing), a field of another data type by that type's derived writing.
-- The same shapes as derive-eq, the same coverage (none for higher inductive types)
list-d = didx (code (List Word))
c-nil = ccon list-d #0 lnil lnil
c-cons h t = ccon list-d #1 (lcons h (lcons t lnil)) lnil
c-app a b = capp (capp (code lappw) a) b
-- a primitive written as a word: the machine's conversion (i64 17, u32 19; a float through its
-- Int64 part, 22 then 17), unary operations from 256
prim-to-word k f =
  if %weq k #0 then cprim #273 (lcons f lnil)
  else if %weq k #1 then cprim #275 (lcons f lnil)
  else cprim #273 (lcons (cprim #278 (lcons f lnil)) lnil)
derive-show d =
  case all-shapes d (nctors d) #0 of
    none → none
    some shapes → some (clam (ccase d (show-branches d shapes #0) (cvar #0)))
show-branches d rest c =
  case rest of
    lnil → lnil
    lcons ks more →
      lcons (clams (%wadd (lst-count ks) (count-rec ks)) (c-cons (cwlit c) (show-fields d ks (lst-count ks) (count-rec ks) #0 #0)))
            (show-branches d more (%wsucc c))
-- in the branch: hyps 0.. (latest), then the fields, then x; field j is cvar (r + n - 1 - j), hyp t
-- is cvar (r - 1 - t)
show-fields d ks n r j t =
  case ks of
    lnil → c-nil
    lcons k kr →
      let f = cvar (%wadd r (%wsub (%wsub n #1) j))
          h = cvar (%wsub (%wsub r #1) t)
          this = (if %weq (fst k) #0 then c-cons f c-nil
                  else if %weq (fst k) #1 then cforce h
                  else if %weq (fst k) #3 then c-cons (prim-to-word (snd k) f) c-nil
                  else capp (fromopt (derive-show (snd k)) c-nil) f)
      in c-app this (show-fields d kr n r (%wsucc j) (if %weq (fst k) #1 then %wsucc t else t))
-- ---------------------------------------------------------------- readings
-- equality on Nat, derived and evaluated
eqNat = eval-g lnil (fromopt (derive-eq (didx (code Nat))) c-false)
#same eqNat (suc (suc zero)) (suc (suc zero)) = true
#same eqNat (suc (suc zero)) (suc zero) = false
#same eqNat zero (suc zero) = false
#same eqNat zero zero = true
-- on Bool
eqBool = eval-g lnil (fromopt (derive-eq (didx (code Bool))) c-false)
#same eqBool true true = true
#same eqBool true false = false
-- on a type with word fields and two recursive fields, declared here
data Tree = leaf (w : Word) | node (l : Tree) (r : Tree)
eqTree = eval-g lnil (fromopt (derive-eq (didx (code Tree))) c-false)
#same eqTree (node (leaf #1) (leaf #2)) (node (leaf #1) (leaf #2)) = true
#same eqTree (node (leaf #1) (leaf #2)) (node (leaf #1) (leaf #3)) = false
#same eqTree (leaf #1) (node (leaf #1) (leaf #1)) = false
-- a field of another data type: Nat inside
data Box = box (n : Nat) (b : Bool)
eqBox = eval-g lnil (fromopt (derive-eq (didx (code Box))) c-false)
#same eqBox (box (suc zero) true) (box (suc zero) true) = true
#same eqBox (box (suc zero) true) (box (suc zero) false) = false
-- a higher inductive type is not covered (its constructors have dimensions)
data Circ = cbase | cloop (i : I) [ i = 0 ↦ cbase , i = 1 ↦ cbase ]
#same derive-eq (didx (code Circ)) = none
-- the derived function quotes back at its type (η-expanded by the quote) and runs again
eqNat2 = eval-g lnil (fromopt (quote-top (Nat → Nat → Bool) eqNat) cword)
#same eqNat2 (suc zero) (suc zero) = true
#same eqNat2 (suc zero) zero = false
-- the derived code lowered to the first-order form (lib/lower.cub) and run natively: the
-- recursion on the first argument returns a function of the second; Bool is a word there
eq-fo = lower (fromopt (derive-eq (didx (code Nat))) c-false)
n2 = fcon (didx (code Nat)) #1 (lcons (fcon (didx (code Nat)) #1 (lcons (fcon (didx (code Nat)) #0 lnil) lnil)) lnil)
n1 = fcon (didx (code Nat)) #1 (lcons (fcon (didx (code Nat)) #0 lnil) lnil)
#same eval-fo (λ g → flit #0) lnil (fapply eq-fo (lcons n2 (lcons n2 lnil))) = vw #1
#same eval-fo (λ g → flit #0) lnil (fapply eq-fo (lcons n2 (lcons n1 lnil))) = vw #0
-- and lifted: the recursion and the inner λs are definitions
#same (case lift #1 eq-fo of lifted t2 ds k → eval-fo (table-of ds) lnil (fapply t2 (lcons n2 (lcons n2 lnil)))) = vw #1
#same (case lift #1 eq-fo of lifted t2 ds k → eval-fo (table-of ds) lnil (fapply t2 (lcons n1 (lcons n2 lnil)))) = vw #0
-- writing: Nat in unary, a tree in preorder with its words, a box through Nat's writing
showNat = eval-g lnil (fromopt (derive-show (didx (code Nat))) c-nil)
#same showNat (suc (suc zero)) = cons #1 (cons #1 (cons #0 nil))
showTree = eval-g lnil (fromopt (derive-show (didx (code Tree))) c-nil)
#same showTree (node (leaf #7) (node (leaf #8) (leaf #9))) = cons #1 (cons #0 (cons #7 (cons #1 (cons #0 (cons #8 (cons #0 (cons #9 nil)))))))
showBox = eval-g lnil (fromopt (derive-show (didx (code Box))) c-nil)
#same showBox (box (suc zero) false) = cons #0 (cons #1 (cons #0 (cons #1 nil)))
#same derive-show (didx (code Circ)) = none
-- a writing is injective where the equality says so: equal writings, equal by derived equality
#same eqTree (node (leaf #1) (leaf #2)) (node (leaf #1) (leaf #2)) = lapp-same (showTree (node (leaf #1) (leaf #2))) (showTree (node (leaf #1) (leaf #2)))
-- fields of primitive types (B12): compared and written by the machine's operations as cprim
-- codes (i64eq, f64eq; wofi64, a float through its Int64 part)
data PrimRec = prec (a : Int64) (w : Word) | pflt (f : Float64)
eqPrimRec = eval-g lnil (fromopt (derive-eq (didx (code PrimRec))) c-false)
#same eqPrimRec (prec (i64 #5) #1) (prec (i64 #5) #1) = true
#same eqPrimRec (prec (i64 #5) #1) (prec (i64 #6) #1) = false
#same eqPrimRec (pflt (f64 #3)) (pflt (f64 #3)) = true
#same eqPrimRec (pflt (f64 #3)) (prec (i64 #3) #3) = false
showPrimRec = eval-g lnil (fromopt (derive-show (didx (code PrimRec))) c-nil)
#same showPrimRec (prec (i64 #5) #1) = cons #0 (cons #5 (cons #1 nil))
#same showPrimRec (pflt (f64 #3)) = cons #1 (cons #3 nil)
-- ---------------------------------------------------------------- deriving eq D [as name]: the derived code checked and
-- defined at D → D → Bool (D·eq by default)
deriving eq Nat
#same Nat·eq 3 3 = true
#same Nat·eq 3 4 = false
data Tree2 = leaf2 (w : Word) | node2 (l : Tree2) (r : Tree2)
deriving eq Tree2 as eqTree2
#same eqTree2 (node2 (leaf2 #1) (leaf2 #2)) (node2 (leaf2 #1) (leaf2 #2)) = true
#same eqTree2 (leaf2 #1) (node2 (leaf2 #1) (leaf2 #1)) = false
#check Nat·eq : Nat → Nat → Bool
-- a field of a primitive type: the derived code's cprim reads back as lib/prim.cub's checked
-- primitive, so the surface form checks it (deriving eq PI)
-- (PrimRec above has such fields)
deriving eq PrimRec as eqPrimRec
#same eqPrimRec (prec (i64 #3) #4) (prec (i64 #3) #4) = true
#same eqPrimRec (prec (i64 #3) #4) (pflt (f64 #4)) = false
