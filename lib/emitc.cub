s-net-end = (lcons #32 (lcons #125 (lcons #41 lnil)))
#same net-c (dec #7) #1 (dec #5) = (lcons #99 (lcons #117 (lcons #98 (lcons #105 (lcons #99 (lcons #97 (lcons #108 (lcons #95 (lcons #99 (lcons #97 (lcons #108 (lcons #108 (lcons #40 (lcons #55 (lcons #44 (lcons #32 (lcons #49 (lcons #44 (lcons #32 (lcons #40 (lcons #86 (lcons #32 (lcons #42 (lcons #91 (lcons #93 (lcons #41 (lcons #123 (lcons #32 (lcons #53 (lcons #32 (lcons #125 (lcons #41 lnil))))))))))))))))))))))))))))))))
