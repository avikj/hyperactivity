proto-c g n = cat6 s-fnhead (dec g) s-open (if %weq n #0 then s-void else params-c n #0) (lcons #41 lnil) (lapp s-semi (lcons #10 lnil))
emit-prog defs = cat4 s-runtime (protos defs) (dispatch defs) (lapp (defs-c defs) s-main)
