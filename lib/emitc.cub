-- lib/emitc.cub — the C printer for the first-order form (plan 18.7, B16, milestone 1: the residue
-- printer). Loaded after lib/fo.cub. emit-prog defs: the C source, as a list of bytes, of a program
-- whose definitions are (g , (arity , body)) and whose main prints f_0's word. Every value is a
-- boxed V (a word, or a constructor with its fields): the layout of B12's representations comes
-- later; this printer is for agreement with eval-fo. let, switch and loops print as GNU statement
-- expressions, so every form is an expression. Closures, thunks and calls into the net print as
-- unsupported(): milestone 2.
-- ---------------------------------------------------------------- bytes
lapp l m = case l of lnil → m; lcons x xs → lcons x (lapp xs m)
cat3 a b c = lapp a (lapp b c)
cat4 a b c d = lapp a (cat3 b c d)
cat5 a b c d e = lapp a (cat4 b c d e)
cat6 a b c d e f = lapp a (cat5 b c d e f)
cat7 a b c d e f g = lapp a (cat6 b c d e f g)
-- decimal digits of a word, by repeated subtraction of the powers of ten (no division primitive;
-- at most ten subtractions per digit, so any word, including 2^64-1 as an Int64 literal)
dec w = if %wlt w #10 then lcons (%wadd #48 w) lnil else dec-pows w pows false
pows = (lcons #10000000000000000000 (lcons #1000000000000000000 (lcons #100000000000000000 (lcons #10000000000000000 (lcons #1000000000000000 (lcons #100000000000000 (lcons #10000000000000 (lcons #1000000000000 (lcons #100000000000 (lcons #10000000000 (lcons #1000000000 (lcons #100000000 (lcons #10000000 (lcons #1000000 (lcons #100000 (lcons #10000 (lcons #1000 (lcons #100 (lcons #10 lnil)))))))))))))))))))
dec-pows w ps started = case ps of lnil → lcons (%wadd #48 w) lnil; lcons p r → dec-digit (dec-count w p #0) r started
dec-digit qr r started = if started then lcons (%wadd #48 (fst qr)) (dec-pows (snd qr) r true) else if %weq (fst qr) #0 then dec-pows (snd qr) r false else lcons (%wadd #48 (fst qr)) (dec-pows (snd qr) r true)
dec-count w p q = if %wlt w p then (q , w) else dec-count (%wsub w p) p (%wsucc q)
#same dec #18446744073709551615 = (lcons #49 (lcons #56 (lcons #52 (lcons #52 (lcons #54 (lcons #55 (lcons #52 (lcons #52 (lcons #48 (lcons #55 (lcons #51 (lcons #55 (lcons #48 (lcons #57 (lcons #53 (lcons #53 (lcons #49 (lcons #54 (lcons #49 (lcons #53 lnil))))))))))))))))))))
#same dec #1000 = (lcons #49 (lcons #48 (lcons #48 (lcons #48 lnil))))
