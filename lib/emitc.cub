inits-c d l i = case l of lnil → lnil; lcons x xs → cat7 s-vstar (var (%wsucc (%wadd d i)) #0) s-assign (emit d x) s-semi (inits-c d xs (%wsucc i)) lnil
reassign-c d k i = if %weq i k then lnil else cat6 (var (%wsucc (%wadd d i)) #0) s-assign (lcons #98 lnil) s-arrow (dec i) (lapp s-rb (lapp s-semi (reassign-c d k (%wsucc i))))
-- ---------------------------------------------------------------- definitions and programs
-- a definition: static V *f_g(V *v0, ..., V *v(n-1)) { return body; }
params-c n i = if %weq i n then lnil else (case %weq (%wsucc i) n of true → cat3 s-vstar (var (%wsucc i) #0) lnil; false → cat4 s-vstar (var (%wsucc i) #0) s-comma (params-c n (%wsucc i)))
emit-def g n body = cat6 s-fnhead (dec g) s-open (if %weq n #0 then s-void else params-c n #0) s-body (lapp (emit n body) s-fnend)
