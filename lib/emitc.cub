s-asmend = (lcons #41 (lcons #59 (lcons #32 lnil)))
s-bsend2 = (lcons #59 (lcons #32 (lcons #125 (lcons #41 lnil))))
s-eqop = (lcons #32 (lcons #61 (lcons #61 (lcons #32 lnil))))
s-ltop = (lcons #32 (lcons #60 (lcons #32 lnil)))
s-addop = (lcons #32 (lcons #43 (lcons #32 lnil)))
s-subop = (lcons #32 (lcons #45 (lcons #32 lnil)))
s-maxa = (lcons #40 (lcons #40 lnil))
s-maxb = (lcons #41 (lcons #32 (lcons #62 (lcons #32 (lcons #40 lnil)))))
s-maxc = (lcons #41 (lcons #32 (lcons #63 (lcons #32 (lcons #40 lnil)))))
