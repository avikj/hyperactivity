-- an assumed fact: ({ ASSUME(expr); body; }) with the fact (a Bool-valued word code over the
-- environment) rendered as a C expression; ASSUME is __builtin_assume / [[assume]] / nothing
fact-c d c =
  case c of
    cwlit n → dec n
    cvar n → cat3 (var d n) s-n2 lnil
    cwsucc a → cat3 s-lp (fact-c d a) s-one
    cwop k a b → if %weq k #3 then cat6 s-maxa (fact-c d a) s-maxb (fact-c d b) s-maxc (cat4 (fact-c d a) s-maxd (fact-c d b) s-maxe) else if %wlt k #3 then cat5 s-lp (fact-c d a) (fop-c k) (fact-c d b) s-rp else cat5 s-n1o (fact-c d a) s-n1c (fact-c d b) s-rp
    cann a T → fact-c d a
    _ → dec #1
fop-c k = if %weq k #0 then s-eqop else if %weq k #1 then s-ltop else if %weq k #2 then s-addop else s-subop
emit d t =
  case t of
    fvar n → var d n
    flit w → cat3 s-mkw (dec w) s-close
    fi64 n → cat3 s-mkw (dec n) s-close
    ff64 w → cat3 s-mkw (dec w) s-close
    fcon dd c fs → cat7 s-mkc (dec c) s-comma (dec (lst-len fs)) (args-rest d fs) s-close lnil
    fswitch x alts → cat6 s-bsx s-rdecl (cat3 s-xbind (emit d x) s-switchx) (alts-c d alts) s-default (lapp (lcons #114 lnil) s-bsend)
    fproj dd c k x → cat4 (emit d x) s-arrow (dec k) s-rb
