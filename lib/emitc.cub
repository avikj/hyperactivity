-- a thunk: the closure lift made of it, tagged 2000000 + g (the dispatcher takes both tag ranges,
-- force() only this one), computed once: force() stores the value in the first field and retags
-- the cell 3000000 (a thunk without captures gets one field for it)
thunk-c g n args = if %weq n #0 then cat3 s-thk g s-thk0 else cat7 s-thk g s-comma (dec n) args s-close lnil
s-thk0 = (lcons #44 (lcons #32 (lcons #49 (lcons #44 (lcons #32 (lcons #109 (lcons #107 (lcons #119 (lcons #40 (lcons #48 (lcons #41 (lcons #41 lnil))))))))))))
s-thk = (lcons #109 (lcons #107 (lcons #99 (lcons #40 (lcons #49 (lcons #57 (lcons #57 (lcons #57 (lcons #57 (lcons #57 (lcons #57 (lcons #32 (lcons #43 (lcons #32 lnil))))))))))))))
dispatch-cases defs =
  case defs of
    lnil → lnil
    lcons d r →
      (if %weq (def-n d) #0 then dispatch-cases r
       else lapp (cat6 s-casef (dec (fst d)) s-retf (dec (fst d)) s-open (lapp (caps-c (%wsub (def-n d) #1) #0) (lapp s-aclose (lcons #10 lnil)))) (dispatch-cases r))

caps-c n i = if %weq i n then lnil else cat4 s-ff (dec i) s-rb (lapp s-comma (caps-c n (%wsucc i)))
protos defs = case defs of lnil → lnil; lcons d r → lapp (proto-c (fst d) (def-n d)) (protos r)
defs-c defs = case defs of lnil → lnil; lcons d r → lapp (emit-def (fst d) (def-n d) (snd (snd d))) (defs-c r)
