s-upd-cp = (lcons #40 (lcons #123 (lcons #32 (lcons #86 (lcons #32 (lcons #42 (lcons #117 (lcons #112 (lcons #32 (lcons #61 (lcons #32 (lcons #99 (lcons #112 (lcons #99 (lcons #40 lnil)))))))))))))))
s-upd-f = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #45 (lcons #62 (lcons #102 (lcons #91 lnil))))))))
s-upd-fc = (lcons #41 (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #45 (lcons #62 (lcons #102 (lcons #91 lnil)))))))))
s-upd-set = (lcons #93 (lcons #32 (lcons #61 (lcons #32 lnil))))
s-upd-end = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #59 (lcons #32 (lcons #125 (lcons #41 lnil))))))))
-- a λ applied: one argument at a time, through the dispatcher
apply-c d f args = case args of lnil → f; lcons a r → apply-c d (cat5 s-apply f s-comma (emit d a) s-close) r
lst-len l = case l of lnil → #0; lcons x xs → %wsucc (lst-len xs)
-- ", a, b, c" for the fields of a constructor
args-rest d fs = case fs of lnil → lnil; lcons x xs → cat3 s-comma (emit d x) (args-rest d xs)
-- "a, b, c" for call arguments
args-c d l = case l of lnil → lnil; lcons x xs → (case xs of lnil → emit d x; _ → cat3 (emit d x) s-comma (args-c d xs))
-- a switch alternative: case c: { V *v_d = x->f[0]; ... r = body; break; } (x is re-evaluated:
-- the scrutinee is bound first as a let in the enclosing expression by the caller of emit when
-- it is not a variable; here it is read as the statement expression's x)
alts-c d alts =
  case alts of
    lnil → lnil
    lcons a r → lapp (alt-c d (fst a) (fst (snd a)) (snd (snd a))) (alts-c d r)
alt-c d c n body = cat6 s-case (dec c) s-colon (fields-c d n #0) (cat3 s-rr (emit (%wadd d n) body) s-semi) s-break
-- the fields of the scrutinee bound as v_d .. v_(d+n-1): the scrutinee is x, kept in a local
-- named x by the switch's statement expression
fields-c d n i = if %weq i n then lnil else cat7 s-vstar (var (%wsucc (%wadd d i)) #0) s-assign (lcons #120 lnil) s-arrow (dec i) (lapp s-rb (lapp s-semi (fields-c d n (%wsucc i))))
s-ld64 = (lcons #109 (lcons #107 (lcons #119 (lcons #40 (lcons #108 (lcons #100 (lcons #54 (lcons #52 (lcons #40 lnil)))))))))
s-ld32 = (lcons #109 (lcons #107 (lcons #119 (lcons #40 (lcons #108 (lcons #100 (lcons #51 (lcons #50 (lcons #40 lnil)))))))))
s-st64 = (lcons #115 (lcons #116 (lcons #54 (lcons #52 (lcons #40 lnil)))))
s-st64i = (lcons #115 (lcons #116 (lcons #54 (lcons #52 (lcons #105 (lcons #40 lnil))))))
s-st32i = (lcons #115 (lcons #116 (lcons #51 (lcons #50 (lcons #105 (lcons #40 lnil))))))
s-st32 = (lcons #115 (lcons #116 (lcons #51 (lcons #50 (lcons #40 lnil)))))
s-mkb = (lcons #109 (lcons #107 (lcons #98 (lcons #40 lnil))))
s-blen = (lcons #109 (lcons #107 (lcons #119 (lcons #40 lnil))))
s-nn = (lcons #45 (lcons #62 (lcons #110 (lcons #41 lnil))))
s-nnn = (lcons #45 (lcons #62 (lcons #110 (lcons #41 (lcons #41 lnil)))))
s-nc = (lcons #45 (lcons #62 (lcons #110 (lcons #44 (lcons #32 lnil)))))
-- the byte layer: loads and stores on a byte string V (tag 2, the bytes in f[]); words in and out
bytes-c d p args =
  case args of
    lcons a r →
      (case r of
         lnil → (if %weq p P-bytes then cat3 s-mkb (emit d a) s-nn else cat3 s-blen (emit d a) s-nn)
         lcons b r2 →
           (case r2 of
              lnil → cat5 (if %weq p P-load64 then s-ld64 else s-ld32) (emit d a) s-comma (emit d b) s-nnn
              lcons c r3 → cat7 (if %weq p P-store64 then s-st64 else if %weq p P-store64-ip then s-st64i else if %weq p P-store32-ip then s-st32i else s-st32) (emit d a) s-comma (emit d b) s-nc (emit d c) s-nn))
    lnil → s-unsup
-- the fixed-width and floating-point primitives: n<p>(a->n, b->n), the runtime's helpers
s-nn-comma = (lcons #45 (lcons #62 (lcons #110 (lcons #44 (lcons #32 lnil)))))
num-c d p args =
  case args of
    lcons a r →
      (case r of
         lcons b r2 → cat7 s-mkw (lcons #110 (dec p)) (lcons #40 lnil) (emit d a) s-nn-comma (emit d b) (lapp s-nn s-close)
         lnil → cat6 s-mkw (lcons #110 (dec p)) (lcons #40 lnil) (emit d a) s-nn s-close)
    lnil → s-unsup
-- word subtraction is the source's truncating wsub (0 when b > a), the runtime's n1: C's uint64_t
-- subtraction wraps (fixed 2026-11-08: mkw(a->n - b->n) computed 2^64 - 1 for 0 - 1)
s-n1o = (lcons #110 (lcons #49 (lcons #40 lnil)))
s-ncomma = (lcons #45 (lcons #62 (lcons #110 (lcons #44 (lcons #32 lnil)))))
s-n1c = (lcons #44 (lcons #32 lnil))
-- a binary word operation on two operand texts: mkw(a->n op b->n), subtraction mkw(n1(a->n, b->n))
wop-c p a b = if %weq p #1 then cat5 s-mkw s-n1o a s-ncomma (lapp b (lapp s-n (lapp s-close s-close))) else cat4 s-mkw a (op-c p) (lapp b (lapp s-n s-close))
prim-c d p args =
  if store-ip p then bytes-c d p args else
  if %wlt #13 p then num-c d p args else
  if %wlt #7 p then bytes-c d p args else
  case args of
    lcons a r →
      (case r of
         lcons b r2 → wop-c p (emit d a) (emit d b)
         lnil → cat5 s-mkw s-not (emit d a) s-n s-close)
    lnil → cat3 s-mkw (dec #0) s-close
op-c p = if %weq p #0 then s-plus else if %weq p #1 then s-minus else if %weq p #2 then s-times else if %weq p #3 then s-eq else if %weq p #4 then s-lt else if %weq p #5 then s-and else s-or
