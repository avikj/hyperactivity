-- lib/eqproof.cub — equality certificates over uninterpreted functions, verified (plan 18.13,
-- F32: "equalities with uninterpreted functions, a sequence of rewrites"). Loaded after
-- lib/linproof.cub (catw, symw, weq-sound, andbt). A certificate is a trace of rewrite steps, each naming a position, a hypothesis and
-- a direction; the checker runs the trace on the left side and compares the result with the right
-- side; eq-cert-sound: a trace that checks proves its goal in every model where the hypotheses hold.
-- Terms are curried applications of constants to variables, so every first-order signature is
-- covered (f(a, b) is eapp (eapp (etc f) a) b). The search for a trace (lib/match.cub, lib/nav.cub
-- over codes) is separate and unverified; what it finds is checked here.
-- ---------------------------------------------------------------- terms and models
-- t19 (2026-11-12): needs-work. 3 definitions here are untyped and refused by the checker, which
-- has rejected untyped definitions outside the bootstrap files since 2026-11-09, deliberately,
-- after about 10,000 lines of untyped code were written by an agent. They are to be written with
-- types; nothing in the checker changes.
data ETm = etv (v : Word) | etc (f : Word) | eapp (a : ETm) (b : ETm)
-- a model: values of variables, values of constants, and application as a binary operation
Model : Type
Model = (Word → Word) × ((Word → Word) × (Word → Word → Word))
tev : Model → ETm → Word
tev m t =
  case t return (λ w → Word) of
    etv v → fst m v
    etc f → fst (snd m) f
    eapp a b → snd (snd m) (rec a) (rec b)
congt : (m : Model) → {s t : ETm} → s ≡ t → tev m s ≡ tev m t
congt m p = λ i → tev m (p i)
-- ---------------------------------------------------------------- deciding syntactic equality
cong-etv : {v w : Word} → v ≡ w → etv v ≡ etv w
cong-etv p = λ i → etv (p i)
cong-etc : {v w : Word} → v ≡ w → etc v ≡ etc w
cong-etc p = λ i → etc (p i)
cong-eapp : {a b c d : ETm} → a ≡ c → b ≡ d → eapp a b ≡ eapp c d
cong-eapp p q = λ i → eapp (p i) (q i)
tm-same : ETm → ETm → Bool
tm-same s t =
  case s return (λ w → ETm → Bool) of
    etv v → λ t → (case t return (λ w → Bool) of etv w → weq v w; etc f → false; eapp a b → false)
    etc f → λ t → (case t return (λ w → Bool) of etv w → false; etc g → weq f g; eapp a b → false)
    eapp a b → λ t → (case t return (λ w → Bool) of etv w → false; etc g → false; eapp c d → andbt (rec a c) (rec b d))
  t
tm-same-sound : (s t : ETm) → tm-same s t ≡ true → s ≡ t
tm-same-sound s t =
  case s return (λ w → (t : ETm) → tm-same w t ≡ true → w ≡ t) of
    etv v → λ t →
      (case t return (λ w → tm-same (etv v) w ≡ true → etv v ≡ w) of
         etv w → λ p → cong-etv (weq-sound v w p)
         etc f → λ p → Empty-rec {lzero} {etv v ≡ etc f} (false≢true p)
         eapp a b → λ p → Empty-rec {lzero} {etv v ≡ eapp a b} (false≢true p))
    etc f → λ t →
      (case t return (λ w → tm-same (etc f) w ≡ true → etc f ≡ w) of
         etv w → λ p → Empty-rec {lzero} {etc f ≡ etv w} (false≢true p)
         etc g → λ p → cong-etc (weq-sound f g p)
         eapp a b → λ p → Empty-rec {lzero} {etc f ≡ eapp a b} (false≢true p))
    eapp a b → λ t →
      (case t return (λ w → tm-same (eapp a b) w ≡ true → eapp a b ≡ w) of
         etv w → λ p → Empty-rec {lzero} {eapp a b ≡ etv w} (false≢true p)
         etc g → λ p → Empty-rec {lzero} {eapp a b ≡ etc g} (false≢true p)
         eapp c d → λ p →
           cong-eapp (rec a c (andbt-l (tm-same a c) (tm-same b d) p))
                     (rec b d (andbt-r (tm-same a c) (tm-same b d) p)))
  t
-- ---------------------------------------------------------------- positions
data Pos = here | pl (p : Pos) | pr (p : Pos)
-- the subterm at a position; a position outside the term returns the term itself, and replace
-- leaves such a term unchanged, so a step at a bad position is a step that does nothing
subterm : Pos → ETm → ETm
subterm p t =
  case p return (λ w → ETm → ETm) of
    here → λ t → t
    pl q → λ t → (case t return (λ w → ETm) of etv v → etv v; etc f → etc f; eapp a b → rec q a)
    pr q → λ t → (case t return (λ w → ETm) of etv v → etv v; etc f → etc f; eapp a b → rec q b)
  t
replace : Pos → ETm → ETm → ETm
replace p r t =
  case p return (λ w → ETm → ETm) of
    here → λ t → r
    pl q → λ t → (case t return (λ w → ETm) of etv v → etv v; etc f → etc f; eapp a b → eapp (rec q a) b)
    pr q → λ t → (case t return (λ w → ETm) of etv v → etv v; etc f → etc f; eapp a b → eapp a (rec q b))
  t
-- a rewrite at a position by an equation whose left side is the subterm there preserves the value
rw-sound : (m : Model) (p : Pos) (l r : ETm) → tev m l ≡ tev m r →
           (t : ETm) → tm-same (subterm p t) l ≡ true → tev m t ≡ tev m (replace p r t)
rw-sound m p l r h t q =
  case p return (λ w → (t : ETm) → tm-same (subterm w t) l ≡ true → tev m t ≡ tev m (replace w r t)) of
    here → λ t q → catw (congt m (tm-same-sound t l q)) h
    pl q2 → λ t →
      (case t return (λ w → tm-same (subterm (pl q2) w) l ≡ true → tev m w ≡ tev m (replace (pl q2) r w)) of
         etv v → λ q i → fst m v
         etc f → λ q i → fst (snd m) f
         eapp a b → λ q i → snd (snd m) (rec q2 a q i) (tev m b))
    pr q2 → λ t →
      (case t return (λ w → tm-same (subterm (pr q2) w) l ≡ true → tev m w ≡ tev m (replace (pr q2) r w)) of
         etv v → λ q i → fst m v
         etc f → λ q i → fst (snd m) f
         eapp a b → λ q i → snd (snd m) (tev m a) (rec q2 b q i))
  t q
-- ---------------------------------------------------------------- substitution
-- hypotheses are schematic: their variables range over all valuations. A step instantiates one
-- by a substitution (a finite map from variables to terms; the identity elsewhere)
data Subst = snil | scons (v : Word) (t : ETm) (rest : Subst)
lookup : Subst → Word → ETm
lookup σ v =
  case σ return (λ w → ETm) of
    snil → etv v
    scons v2 t rest → (case weq v v2 return (λ w → ETm) of true → t; false → rec rest)
tsubst : Subst → ETm → ETm
tsubst σ t =
  case t return (λ w → ETm) of
    etv v → lookup σ v
    etc f → etc f
    eapp a b → eapp (rec a) (rec b)
-- the value of an instance is the value at the substituted valuation
msub : Model → Subst → Model
msub m σ = ((λ v → tev m (lookup σ v)) , snd m)
tsubst-sound : (m : Model) (σ : Subst) (t : ETm) → tev m (tsubst σ t) ≡ tev (msub m σ) t
tsubst-sound m σ t =
  case t return (λ w → tev m (tsubst σ w) ≡ tev (msub m σ) w) of
    etv v → λ i → tev m (lookup σ v)
    etc f → λ i → fst (snd m) f
    eapp a b → λ i → snd (snd m) (rec a i) (rec b i)
-- ---------------------------------------------------------------- hypotheses and traces
data Eqs = enil | econs (l : ETm) (r : ETm) (rest : Eqs)
Vals : Type
Vals = Word → Word
-- the hypotheses hold in a model when each holds at every valuation of its variables
EqHolds : Model → Eqs → Type
EqHolds m hs =
  case hs return (λ w → Type) of
    enil → Unit
    econs l r rest → ((vals : Vals) → tev (vals , snd m) l ≡ tev (vals , snd m) r) × rec rest
-- the i-th equation; past the end, a trivial one (which holds in every model)
hyp-at : Word → Eqs → ETm × ETm
hyp-at i hs =
  case hs return (λ w → Word → ETm × ETm) of
    enil → λ i → (etc #0 , etc #0)
    econs l r rest → λ i → %welimP (λ v → ETm × ETm) i (l , r) (λ j h → rec rest j)
  i
hyp-holds : (m : Model) (hs : Eqs) (i : Word) → EqHolds m hs →
            (vals : Vals) → tev (vals , snd m) (fst (hyp-at i hs)) ≡ tev (vals , snd m) (snd (hyp-at i hs))
hyp-holds m hs i hh =
  case hs return (λ w → (i : Word) → EqHolds m w →
                        (vals : Vals) → tev (vals , snd m) (fst (hyp-at i w)) ≡ tev (vals , snd m) (snd (hyp-at i w))) of
    enil → λ i hh vals j → fst (snd m) #0
    econs l r rest → λ i hh →
      %welimP (λ v → (vals : Vals) → tev (vals , snd m) (fst (hyp-at v (econs l r rest))) ≡ tev (vals , snd m) (snd (hyp-at v (econs l r rest)))) i
        (fst hh) (λ j h → rec rest j (snd hh))
  i hh
-- the instance of a hypothesis holds in the model itself
inst-holds : (m : Model) (hs : Eqs) (i : Word) (σ : Subst) → EqHolds m hs →
             tev m (tsubst σ (fst (hyp-at i hs))) ≡ tev m (tsubst σ (snd (hyp-at i hs)))
inst-holds m hs i σ hh =
  catw (tsubst-sound m σ (fst (hyp-at i hs)))
    (catw (hyp-holds m hs i hh (λ v → tev m (lookup σ v))) (symw (tsubst-sound m σ (snd (hyp-at i hs)))))
-- an equation read in a direction
lhs : Bool → ETm × ETm → ETm
lhs d eq = case d return (λ w → ETm) of true → snd eq; false → fst eq
rhs : Bool → ETm × ETm → ETm
rhs d eq = case d return (λ w → ETm) of true → fst eq; false → snd eq
dir-sound : (m : Model) (d : Bool) (σ : Subst) (eq : ETm × ETm) → tev m (tsubst σ (fst eq)) ≡ tev m (tsubst σ (snd eq)) →
            tev m (tsubst σ (lhs d eq)) ≡ tev m (tsubst σ (rhs d eq))
dir-sound m d σ eq h = case d return (λ w → tev m (tsubst σ (lhs w eq)) ≡ tev m (tsubst σ (rhs w eq))) of true → symw h; false → h
-- a trace: steps (position, hypothesis, direction, substitution)
data Trace = tnil | tstep (p : Pos) (i : Word) (d : Bool) (σ : Subst) (rest : Trace)
-- one step: rewrite if the subterm is the instance of the equation's side, else leave the term
step : Eqs → Pos → Word → Bool → Subst → ETm → ETm
step hs p i d σ t =
  case tm-same (subterm p t) (tsubst σ (lhs d (hyp-at i hs))) return (λ w → ETm) of
    true → replace p (tsubst σ (rhs d (hyp-at i hs))) t
    false → t
step-sound : (m : Model) (hs : Eqs) (p : Pos) (i : Word) (d : Bool) (σ : Subst) → EqHolds m hs →
             (t : ETm) → tev m t ≡ tev m (step hs p i d σ t)
step-sound m hs p i d σ hh t =
  case tm-same (subterm p t) (tsubst σ (lhs d (hyp-at i hs)))
    return (λ b → tm-same (subterm p t) (tsubst σ (lhs d (hyp-at i hs))) ≡ b →
                  tev m t ≡ tev m (case b return (λ w → ETm) of true → replace p (tsubst σ (rhs d (hyp-at i hs))) t; false → t)) of
    true → λ q → rw-sound m p (tsubst σ (lhs d (hyp-at i hs))) (tsubst σ (rhs d (hyp-at i hs)))
                    (dir-sound m d σ (hyp-at i hs) (inst-holds m hs i σ hh)) t q
    false → λ q j → tev m t
  (λ j → tm-same (subterm p t) (tsubst σ (lhs d (hyp-at i hs))))
run : Eqs → Trace → ETm → ETm
run hs tr t =
  case tr return (λ w → ETm → ETm) of
    tnil → λ t → t
    tstep p i d σ rest → λ t → rec rest (step hs p i d σ t)
  t
run-sound : (m : Model) (hs : Eqs) (tr : Trace) → EqHolds m hs → (t : ETm) → tev m t ≡ tev m (run hs tr t)
run-sound m hs tr hh t =
  case tr return (λ w → (t : ETm) → tev m t ≡ tev m (run hs w t)) of
    tnil → λ t i → tev m t
    tstep p i d σ rest → λ t → catw (step-sound m hs p i d σ hh t) (rec rest (step hs p i d σ t))
  t
-- the checker and its theorem
check-eq : Eqs → Trace → ETm → ETm → Bool
check-eq hs tr s t = tm-same (run hs tr s) t
eq-cert-sound : (m : Model) (hs : Eqs) (tr : Trace) (s t : ETm) → EqHolds m hs → check-eq hs tr s t ≡ true → tev m s ≡ tev m t
eq-cert-sound m hs tr s t hh q = catw (run-sound m hs tr hh s) (congt m (tm-same-sound (run hs tr s) t q))
-- ---------------------------------------------------------------- search (unverified)
-- a trace is found by bounded depth-first search: at every position of the term, every
-- hypothesis in either direction whose side matches there. Nothing here is trusted: the trace
-- found is checked by check-eq, and eq-cert-sound is about the check
data OSubst = nosub | asub (σ : Subst)
bound : Subst → Word → Bool
bound σ v = case σ return (λ w → Bool) of snil → false; scons v2 t rest → (case weq v v2 return (λ w → Bool) of true → true; false → rec rest)
-- matching a pattern (its variables are the hypothesis's) against a term, extending σ
tmatch : ETm → ETm → Subst → OSubst
tmatch p t σ =
  case p return (λ w → ETm → Subst → OSubst) of
    etv v → λ t σ → (case bound σ v return (λ w → OSubst) of true → (case tm-same (lookup σ v) t return (λ w → OSubst) of true → asub σ; false → nosub); false → asub (scons v t σ))
    etc f → λ t σ → (case t return (λ w → OSubst) of etv w → nosub; etc g → (case weq f g return (λ w → OSubst) of true → asub σ; false → nosub); eapp a b → nosub)
    eapp a b → λ t σ →
      (case t return (λ w → OSubst) of
         etv w → nosub
         etc g → nosub
         eapp c d → (case rec a c σ return (λ w → OSubst) of nosub → nosub; asub σ2 → rec b d σ2))
  t σ
data Poss = pnil | pcons (p : Pos) (rest : Poss)
pmap-l : Poss → Poss
pmap-l ps = case ps return (λ w → Poss) of pnil → pnil; pcons p r → pcons (pl p) (rec r)
pmap-r : Poss → Poss
pmap-r ps = case ps return (λ w → Poss) of pnil → pnil; pcons p r → pcons (pr p) (rec r)
pcat : Poss → Poss → Poss
pcat a b = case a return (λ w → Poss) of pnil → b; pcons p r → pcons p (rec r)
positions : ETm → Poss
positions t =
  case t return (λ w → Poss) of
    etv v → pcons here pnil
    etc f → pcons here pnil
    eapp a b → pcons here (pcat (pmap-l (rec a)) (pmap-r (rec b)))
data OTrace = notr | atrace (tr : Trace)
eqs-len : Eqs → Word
eqs-len hs = case hs return (λ w → Word) of enil → #0; econs l r rest → %wsucc (rec rest)
try-dir : (ETm → OTrace) → Eqs → Pos → Word → Bool → ETm → OTrace
try-dir deeper hs p i d s =
  case tmatch (lhs d (hyp-at i hs)) (subterm p s) snil return (λ w → OTrace) of
    nosub → notr
    asub σ →
      (case deeper (step hs p i d σ s) return (λ w → OTrace) of
         notr → notr
         atrace tr → atrace (tstep p i d σ tr))
try-hyp : (ETm → OTrace) → Eqs → Pos → Word → Word → ETm → OTrace
try-hyp deeper hs p n i s =
  %welimP (λ v → Word → OTrace) n (λ i → notr)
    (λ k h i →
       (case try-dir deeper hs p i false s return (λ w → OTrace) of
          atrace tr → atrace tr
          notr → (case try-dir deeper hs p i true s return (λ w → OTrace) of atrace tr → atrace tr; notr → h (%wsucc i))))
  i
-- try every position, hypothesis and direction; deeper : ETm → OTrace searches from the result
try-pos : (ETm → OTrace) → Eqs → Poss → ETm → OTrace
try-pos deeper hs ps s =
  case ps return (λ w → OTrace) of
    pnil → notr
    pcons p rest → (case try-hyp deeper hs p (eqs-len hs) #0 s return (λ w → OTrace) of atrace tr → atrace tr; notr → rec rest)
-- find-trace n hs s t: a trace of at most n steps from s to t, or none
find-trace : Word → Eqs → ETm → ETm → OTrace
find-trace n hs s t =
  %welimP (λ v → ETm → OTrace) n
    (λ s → (case tm-same s t return (λ w → OTrace) of true → atrace tnil; false → notr))
    (λ k deeper s →
       (case tm-same s t return (λ w → OTrace) of
          true → atrace tnil
          false → try-pos deeper hs (positions s) s))
  s
-- ---------------------------------------------------------------- the bridge from codes (unverified)
-- a code that is an application of globals to variables and other such codes reads as a term:
-- a global is a constant (by its index), a variable a variable, an application an application;
-- anything else is outside the fragment. The equations the store holds (lib/rules.cub reads them
-- as rules) are hypotheses of this form once their Π binders are peeled; the goal, a code, is
-- read the same way, and what check-eq accepts about the terms eq-cert-sound proves about them
tm-of-code c =
  case c of
    cvar v → some (etv v)
    cglob g → some (etc g)
    cann t T → tm-of-code t
    capp f x → obind (tm-of-code f) (λ tf → omap (λ tx → eapp tf tx) (tm-of-code x))
    _ → none
code-of-tm t = case t of etv v → cvar v; etc f → cglob f; eapp a b → capp (code-of-tm a) (code-of-tm b)
-- a list of (l , r) codes as hypotheses, in order; none when one is outside the fragment
eqs-of-codes hs =
  case hs of
    lnil → some enil
    lcons h r → obind (tm-of-code (fst h)) (λ l → obind (tm-of-code (snd h)) (λ rr → omap (λ rest → econs l rr rest) (eqs-of-codes r)))
