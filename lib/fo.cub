-- lib/fo.cub — the first-order form (plan 18.5, B14): what the specializer produces and every
-- back end consumes. Loaded after lib/code.cub. Untyped data, as Code is: programs over it are
-- checked as programs; the form itself is data the machine lays out.
-- A first-order program has no types, paths, dimensions or universes in it: words and
-- fixed-width numbers, constructors with their non-erased fields, switches on constructor tags,
-- projections, calls of compiled definitions by key, native primitives, lets, loops, closures,
-- thunks for lazy positions, and calls into the net for regions that stay symbolic.
data FO
  = fvar (n : Word)                          -- de Bruijn index into the environment
  | flit (w : Word)                          -- a word
  | fi64 (n : Word)                          -- an Int64 literal, by the word it converts from (two's complement)
  | ff64 (w : Word)                          -- a Float64 literal by its bits (the quote of a Float64 value, cplit 2 w)
  | fcon (d : Word) (c : Word) (fs : Lst)    -- constructor c of data type d, its fields (a Lst of FO)
  | fswitch (x : FO) (alts : Lst)            -- case on x's tag: alts a Lst of (c , (n , body)), body over the n fields pushed
  | fproj (d : Word) (c : Word) (k : Word) (x : FO)   -- field k of constructor c of x
  | fcall (g : Word) (args : Lst)            -- a compiled definition g (a key) on arguments
  | fprim (p : Word) (args : Lst)            -- a native primitive p on arguments
  | flet (t : FO) (b : FO)                   -- let: t pushed, b over it
  | fif (c : FO) (t : FO) (e : FO)           -- a word condition: nonzero is true
  | floop (init : Lst) (body : FO)           -- a loop: state pushed; body returns continue (tag 0) or break (tag 1)
  | fclos (g : Word) (env : Lst)             -- a closure: definition g over captured values env
  | flam (b : FO)                            -- a λ as a value over the environment at its creation
  | fapply (f : FO) (args : Lst)             -- call through a function value
  | fthunk (t : FO)                          -- a lazy position: evaluated on force
  | fforce (x : FO)
  | fnet (k : Word) (args : Lst)             -- a call into the net (B18)
  | fassume (fact : Code) (b : FO)           -- a proven fact at this point (for [[assume]]); b the body
  | frec (d : Word) (x : FO) (alts : Lst)    -- structural recursion on x : d; alts a Lst of (c , (n , (hyps , body))): the n
                                             -- fields pushed, then for each field index in hyps the recursion's result on
                                             -- that field (a suspension, read with fforce); lift turns it into a definition
-- values of first-order programs: words, constructor trees, closures, thunks
data FV
  = vw (w : Word)
  | vcon (d : Word) (c : Word) (fs : Lst)
  | vclos (g : Word) (env : Lst)
  | vlam (b : FO) (env : Lst)
  | vthunk (t : FO) (env : Lst)
  | vnet (k : Word) (args : Lst)
  | vrec (d : Word) (alts : Lst) (x : FV) (env : Lst)   -- a suspended recursion on x (frec's hypothesis)
  | vbytes (b : Word)                        -- a machine byte string (B12's Bytes; the field's type is nominal: FO is untyped)
  | vi64 (x : Word)                          -- a machine Int64 (nominal, as vbytes)
  | vf64 (x : Word)                          -- a machine Float64 (nominal)
-- first-order types (the FT of the plan), for the printers; eval-fo does not consult them.
-- A definition's signature is (params : Lst of FT , ret : FT), read off its elaborated type by
-- lib/lower.cub's ft-of; ftany is what the printer infers for itself
data FT
  = ftword
  | fti64
  | ftf64
  | ftbytes (n : Word)
  | ftdata (d : Word) (ps : Lst) (rep : Word)
  | ftfun (args : Lst) (ret : FT)
  | ftlazy (t : FT)
  | ftpair (a : FT) (b : FT)
  | ftany
-- ---------------------------------------------------------------- primitives
-- the native primitives, by number; a printer maps each to its C operator or call
P-add = #0
P-sub = #1
P-mul = #2
P-eq = #3
P-lt = #4
P-and = #5
P-or = #6
P-not = #7
-- the byte layer (B12): load64 b off, store64 b off v, load32, store32, bytes n, blen b; words in
-- and out (the machine's Int64/UInt32 converted at the boundary)
P-load64 = #8
P-store64 = #9
P-load32 = #10
P-store32 = #11
P-bytes = #12
P-blen = #13
-- fixed-width and floating-point arithmetic (B12's primitive types): Int64 as the machine's
-- Int64 values (vi64), Float64 as its Float64 values (vf64); comparisons answer words
P-i64add = #14
P-i64sub = #15
P-i64mul = #16
P-i64eq = #17
P-i64lt = #18
P-f64add = #19
P-f64sub = #20
P-f64mul = #21
P-f64div = #22
P-f64eq = #23
P-f64lt = #24
P-i64ofw = #25
P-wofi64 = #26
P-f64ofi64 = #27
P-i64off64 = #28
P-f64ofw = #29
iof v = case v of vi64 x → x; vw w → %i64ofw w; _ → %i64ofw #0
fof v = case v of vf64 x → x; vw w → %f64ofw w; _ → %f64ofw #0
bw b = case b of true → #1; false → #0
prim-num p args =
  case args of
    lcons a r →
      (case r of
         lnil →
           if %weq p P-i64ofw then vi64 (%i64ofw (wof a))
           else if %weq p P-wofi64 then vw (%wofi64 (iof a))
           else if %weq p P-f64ofi64 then vf64 (%f64ofi64 (iof a))
           else if %weq p P-i64off64 then vi64 (%i64off64 (fof a))
           else vf64 (%f64ofw (wof a))
         lcons b r2 →
           if %weq p P-i64add then vi64 (%i64add (iof a) (iof b))
           else if %weq p P-i64sub then vi64 (%i64sub (iof a) (iof b))
           else if %weq p P-i64mul then vi64 (%i64mul (iof a) (iof b))
           else if %weq p P-i64eq then vw (bw (%i64eq (iof a) (iof b)))
           else if %weq p P-i64lt then vw (bw (%i64lt (iof a) (iof b)))
           else if %weq p P-f64add then vf64 (%f64add (fof a) (fof b))
           else if %weq p P-f64sub then vf64 (%f64sub (fof a) (fof b))
           else if %weq p P-f64mul then vf64 (%f64mul (fof a) (fof b))
           else if %weq p P-f64div then vf64 (%f64div (fof a) (fof b))
           else if %weq p P-f64eq then vw (bw (%f64eq (fof a) (fof b)))
           else vw (bw (%f64lt (fof a) (fof b))))
    lnil → vw #0
bof v = case v of vbytes b → b; _ → %bytes #0
prim-bytes p args =
  case args of
    lcons a r →
      (case r of
         lnil → (if %weq p P-bytes then vbytes (%bytes (wof a)) else vw (%blen (bof a)))
         lcons b r2 →
           (case r2 of
              lnil → (if %weq p P-load64 then vi64 (%load64 (bof a) (wof b)) else vw (%wofu32 (%load32 (bof a) (wof b))))
              lcons c r3 → (if %weq p P-store64 then vbytes (%store64 (bof a) (wof b) (iof c)) else vbytes (%store32 (bof a) (wof b) (%u32ofw (wof c))))))
    lnil → vw #0
prim-ap p a b =
  if %weq p P-add then %wadd a b
  else if %weq p P-sub then %wsub a b
  else if %weq p P-mul then wmul a b
  else if %weq p P-eq then (if %weq a b then #1 else #0)
  else if %weq p P-lt then (if %wlt a b then #1 else #0)
  else if %weq p P-and then (if %weq a #0 then #0 else (if %weq b #0 then #0 else #1))
  else if %weq p P-or then (if %weq a #0 then (if %weq b #0 then #0 else #1) else #1)
  else #0
-- multiplication by repeated addition (no %wmul primitive yet; B12 adds it with its spec)
wmul a b = %welim b #0 (λ n h → %wadd h a)
-- ---------------------------------------------------------------- the evaluator
-- eval-fo G e t: the value of t in environment e (a Lst of FV, innermost first), G the table of
-- compiled definitions (a function from a key to a closure body: the definition's FO and arity).
-- A definition's body is evaluated with its arguments pushed. Loops run until fbreak.
wof v = case v of vw w → w; _ → #0
lst-nth l n = case l of lnil → vw #0; lcons x xs → if %weq n #0 then x else lst-nth xs (%wsub n #1)
lst-len l = case l of lnil → #0; lcons x xs → %wsucc (lst-len xs)
lst-rev l = lst-rev-onto l lnil
lst-rev-onto l acc = case l of lnil → acc; lcons x xs → lst-rev-onto xs (lcons x acc)
lst-app l m = case l of lnil → m; lcons x xs → lcons x (lst-app xs m)
-- push a list of values (in argument order) onto an environment: the last argument innermost
push-all vs e = case vs of lnil → e; lcons v r → push-all r (lcons v e)
eval-fo G e t =
  case t of
    fvar n → lst-nth e n
    flit w → vw w
    fi64 n → vi64 (%i64ofw n)
    ff64 w → vf64 (%pval #2 w)
    fcon d c fs → vcon d c (eval-list G e fs)
    fswitch x alts →
      (case eval-fo G e x of
         vcon d c fs → eval-fo G (push-all fs e) (alt-of alts c)
         _ → vw #0)
    fproj d c k x → (case eval-fo G e x of vcon d2 c2 fs → lst-nth fs k; _ → vw #0)
    fcall g args → eval-fo G (push-all (eval-list G e args) lnil) (G g)
    fprim p args →
      if %wlt #13 p then prim-num p (eval-list G e args) else
      if %wlt #7 p then prim-bytes p (eval-list G e args) else
      (case eval-list G e args of
         lcons a r →
           (case r of
              lcons b r2 → vw (prim-ap p (wof a) (wof b))
              lnil → vw (if %weq p P-not then (if %weq (wof a) #0 then #1 else #0) else wof a))
         lnil → vw #0)
    flet t2 b → eval-fo G (lcons (eval-fo G e t2) e) b
    fif c th el → if %weq (wof (eval-fo G e c)) #0 then eval-fo G e el else eval-fo G e th
    floop init body → run-loop G e (eval-list G e init) body
    fclos g env → vclos g (eval-list G e env)
    flam b → vlam b e
    fapply f args → apply-args G (eval-fo G e f) (eval-list G e args)
    fthunk t2 → vthunk t2 e
    fforce x → (case eval-fo G e x of vthunk t2 e2 → eval-fo G e2 t2; vrec d alts v e2 → enter-rec G e2 d alts v; v → v)
    frec d x alts → enter-rec G e d alts (eval-fo G e x)
    fnet k args → vnet k (eval-list G e args)
    fassume fact b → eval-fo G e b
    _ → vw #0
eval-list G e l = case l of lnil → lnil; lcons x xs → lcons (eval-fo G e x) (eval-list G e xs)
-- a recursion entered on a value: the fields pushed, then the hypotheses (suspended recursions on
-- the fields named), then the alternative's body
enter-rec G e d alts v =
  case v of
    vcon d2 c fs → (case ralt-of alts c of
                      some a → eval-fo G (push-all (hyp-vals d alts fs e (fst (snd (snd a)))) (push-all fs e)) (snd (snd (snd a)))
                      none → vw #0)
    _ → vw #0
ralt-of alts c = case alts of lnil → none; lcons a r → if %weq (fst a) c then some a else ralt-of r c
hyp-vals d alts fs e hyps = case hyps of lnil → lnil; lcons j r → lcons (vrec d alts (lst-nth fs j) e) (hyp-vals d alts fs e r)
-- applying a function value to arguments: a lifted λ's closure takes one (its definition's last
-- parameter) and the result takes the rest; a λ takes one and
-- its body is applied to the rest
apply-args G f args =
  case args of
    lnil → f
    lcons a rest →
      (case f of
         vclos g env → apply-args G (eval-fo G (lcons a (push-all env lnil)) (G g)) rest
         vlam b env → apply-args G (eval-fo G (lcons a env) b) rest
         _ → vw #0)
alt-of alts c = case alts of lnil → flit #0; lcons a r → if %weq (fst a) c then snd (snd a) else alt-of r c
-- a loop: the state is pushed (in order), the body runs; fcontinue restarts with the new state,
-- fbreak ends. Runs by structural recursion on nothing: a loop is a reading, total only when the
-- body breaks; the first-order criterion admits loops that come from terminating recursion
run-loop G e st body =
  case eval-fo G (push-all st e) body of
    vcon d c fs → (if %weq c #0 then run-loop G e fs body else lst-nth fs #0)
    v → v
-- the loop's body returns constructors of this two-constructor type: tag 0 continue, tag 1 break
fcontinue-v st = vcon #0 #0 st
fbreak-v r = vcon #0 #1 (lcons r lnil)
-- ---------------------------------------------------------------- examples
-- plus on words: fprim add over the two arguments
fo-plus = fprim P-add (lcons (fvar #1) (lcons (fvar #0) lnil))
-- factorial as a loop: state (n, acc); continue while n > 0
fo-fact =
  floop (lcons (fvar #0) (lcons (flit #1) lnil))
    (fif (fprim P-lt (lcons (flit #0) (lcons (fvar #1) lnil)))
       (fcon #0 #0 (lcons (fprim P-sub (lcons (fvar #1) (lcons (flit #1) lnil)))
                          (lcons (fprim P-mul (lcons (fvar #0) (lcons (fvar #1) lnil))) lnil)))
       (fcon #0 #1 (lcons (fvar #0) lnil)))
no-defs g = flit #0
#same eval-fo no-defs (lcons (vw #3) (lcons (vw #4) lnil)) fo-plus = vw #7
#same eval-fo no-defs (lcons (vw #5) lnil) fo-fact = vw #120
-- a compiled definition called by key: key 1 is fo-plus
defs g = if %weq g #1 then fo-plus else flit #0
#same eval-fo defs lnil (fcall #1 (lcons (flit #20) (lcons (flit #22) lnil))) = vw #42
-- a closure capturing one value, applied
#same eval-fo defs lnil (fapply (fclos #1 (lcons (flit #10) lnil)) (lcons (flit #5) lnil)) = vw #15
-- a switch on a constructor
#same eval-fo defs lnil (fswitch (fcon #7 #1 (lcons (flit #9) lnil)) (lcons (#0 , (#0 , flit #0)) (lcons (#1 , (#1 , fvar #0)) lnil))) = vw #9
-- a thunk is not evaluated until forced
#same eval-fo defs lnil (fforce (fthunk (fprim P-add (lcons (flit #1) (lcons (flit #2) lnil))))) = vw #3
-- shifting free variables of a first-order term by k (binders: flet 1, flam by its arity as applied,
-- fswitch alternatives by their constructor's field count, floop 3). A λ's body is shifted below
-- its own binders: flam binds an unknown number of arguments, so a λ in a shifted position is
-- closed over by the environment at its creation and needs no shift of its body (vlam keeps e)
shift k t = shift-at #0 k t
shift-at d k t =
  case t of
    fvar n → if %wlt n d then fvar n else fvar (%wadd n k)
    flit w → t
    fcon dd c fs → fcon dd c (fshift-list d k fs)
    fswitch x alts → fswitch (shift-at d k x) (shift-alts d k alts)
    fproj dd c j x → fproj dd c j (shift-at d k x)
    fcall g args → fcall g (fshift-list d k args)
    fprim p args → fprim p (fshift-list d k args)
    flet a b → flet (shift-at d k a) (shift-at (%wsucc d) k b)
    fif c a b → fif (shift-at d k c) (shift-at d k a) (shift-at d k b)
    floop init body → floop (fshift-list d k init) (shift-at (%wadd d #3) k body)
    fclos g env → fclos g (fshift-list d k env)
    flam b → flam b
    fapply f args → fapply (shift-at d k f) (fshift-list d k args)
    fthunk a → fthunk (shift-at d k a)
    fforce x → fforce (shift-at d k x)
    fnet g args → fnet g (fshift-list d k args)
    fassume f b → fassume f (shift-at d k b)
    frec dd x alts → frec dd (shift-at d k x) alts
    _ → t
fshift-list d k l = case l of lnil → lnil; lcons x xs → lcons (shift-at d k x) (fshift-list d k xs)
-- an alternative's body sees its constructor's fields pushed; their count is not known here, so
-- alternatives are shifted as closed over the switch's environment: a branch's variables above
-- the fields are the switch's (the printer and specializer know the counts from %dent)
shift-alts d k alts = alts
-- ---------------------------------------------------------------- closure conversion
-- A λ in the first-order form captures the whole environment at its creation (vlam). For a
-- printer, every λ becomes a definition of its own over its free variables: lift k t walks t,
-- replacing each flam b by fclos g (the free variables of b, as fvars at the λ's position) and
-- emitting the definition g = (arity 1 + n, body with its free variables renumbered to the n
-- captured parameters below the argument). Definitions are numbered from k upward and returned
-- with the converted term. A converted program has no flam left; fapply on an fclos calls g with
-- the captured values then the arguments.
data Lifted = lifted (t : FO) (defs : Lst) (next : Word)
data Lifted2 = lifted2 (ts : Lst) (defs : Lst) (next : Word)
-- free variables of t at depth 0: the set of indices ≥ d that occur, as a sorted Lst of words
free-vars d t = fv-sorted (fv d t lnil)
fv d t acc =
  case t of
    fvar n → if %wlt n d then acc else ins-sorted (%wsub n d) acc
    fcon dd c fs → fv-list d fs acc
    fswitch x alts → fv-alts d alts (fv d x acc)
    fproj dd c k x → fv d x acc
    fcall g args → fv-list d args acc
    fprim p args → fv-list d args acc
    flet a b → fv (%wsucc d) b (fv d a acc)
    fif c a b → fv d b (fv d a (fv d c acc))
    floop init body → fv (%wadd d #3) body (fv-list d init acc)
    fclos g env → fv-list d env acc
    flam b → fv (%wsucc d) b acc
    fapply f args → fv-list d args (fv d f acc)
    fthunk a → fv d a acc
    fforce x → fv d x acc
    fnet g args → fv-list d args acc
    fassume f b → fv d b acc
    frec dd x alts → fv-ralts d alts (fv d x acc)
    _ → acc
fv-ralts d alts acc = case alts of lnil → acc; lcons a r → fv-ralts d r (fv (%wadd d (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) (snd (snd (snd a))) acc)
fv-list d l acc = case l of lnil → acc; lcons x xs → fv-list d xs (fv d x acc)
fv-alts d alts acc = case alts of lnil → acc; lcons a r → fv-alts d r (fv (%wadd d (fst (snd a))) (snd (snd a)) acc)
ins-sorted n l = case l of lnil → lcons n lnil; lcons m r → if %wlt n m then lcons n l else if %weq n m then l else lcons m (ins-sorted n r)
fv-sorted l = l
-- the index of n in a sorted list (its position), for renumbering
index-of n l = case l of lnil → #0; lcons m r → if %weq n m then #0 else %wsucc (index-of n r)
lst-len2 l = case l of lnil → #0; lcons x xs → %wsucc (lst-len2 xs)
-- renumber the free variables of a λ body: inside the lifted definition the environment is the
-- captured values c_0 .. c_(n-1) (c_0 innermost? no: pushed in order, so c_(n-1) is innermost,
-- index 0 above the argument) then the argument at index 0. A free variable m of the body (at
-- body depth d, index m ≥ d, referring to outer index m − d) becomes d + (position of (m − d) in
-- the captured list, counted from the end)
renumber d caps t =
  case t of
    fvar n → if %wlt n d then t else fvar (%wadd d (%wsub (%wsub (lst-len2 caps) #1) (index-of (%wsub n d) caps)))
    fcon dd c fs → fcon dd c (renumber-list d caps fs)
    fswitch x alts → fswitch (renumber d caps x) (renumber-alts d caps alts)
    fproj dd c k x → fproj dd c k (renumber d caps x)
    fcall g args → fcall g (renumber-list d caps args)
    fprim p args → fprim p (renumber-list d caps args)
    flet a b → flet (renumber d caps a) (renumber (%wsucc d) caps b)
    fif c a b → fif (renumber d caps c) (renumber d caps a) (renumber d caps b)
    floop init body → floop (renumber-list d caps init) (renumber (%wadd d #3) caps body)
    fclos g env → fclos g (renumber-list d caps env)
    flam b → flam (renumber (%wsucc d) caps b)
    fapply f args → fapply (renumber d caps f) (renumber-list d caps args)
    fthunk a → fthunk (renumber d caps a)
    fforce x → fforce (renumber d caps x)
    fnet g args → fnet g (renumber-list d caps args)
    fassume f b → fassume f (renumber d caps b)
    frec dd x alts → frec dd (renumber d caps x) (renumber-ralts d caps alts)
    _ → t
renumber-ralts d caps alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , renumber (%wadd d (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) caps (snd (snd (snd a)))))) (renumber-ralts d caps r)
renumber-list d caps l = case l of lnil → lnil; lcons x xs → lcons (renumber d caps x) (renumber-list d caps xs)
renumber-alts d caps alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , renumber (%wadd d (fst (snd a))) caps (snd (snd a)))) (renumber-alts d caps r)
-- lift: definitions numbered from k; innermost λs first so that a λ's body is already converted
lift k t =
  case t of
    flam b →
      (case lift k b of
         lifted b2 ds k2 →
           let caps = free-vars #1 b2
           in lifted (fclos k2 (caps-as-vars caps)) (lapp2 ds (lcons (k2 , (%wsucc (lst-len2 caps) , renumber #1 caps b2)) lnil)) (%wsucc k2))
    fcon dd c fs → (case lift-list k fs of lifted2 fs2 ds k2 → lifted (fcon dd c fs2) ds k2)
    fswitch x alts → (case lift k x of lifted x2 ds k2 → (case lift-alts k2 alts of lifted2 alts2 ds2 k3 → lifted (fswitch x2 alts2) (lapp2 ds ds2) k3))
    fproj dd c j x → (case lift k x of lifted x2 ds k2 → lifted (fproj dd c j x2) ds k2)
    fcall g args → (case lift-list k args of lifted2 as ds k2 → lifted (fcall g as) ds k2)
    fprim p args → (case lift-list k args of lifted2 as ds k2 → lifted (fprim p as) ds k2)
    flet a b → (case lift k a of lifted a2 ds k2 → (case lift k2 b of lifted b2 ds2 k3 → lifted (flet a2 b2) (lapp2 ds ds2) k3))
    fif c a b → (case lift k c of lifted c2 ds k2 → (case lift k2 a of lifted a2 ds2 k3 → (case lift k3 b of lifted b2 ds3 k4 → lifted (fif c2 a2 b2) (lapp2 ds (lapp2 ds2 ds3)) k4)))
    floop init body → (case lift-list k init of lifted2 is ds k2 → (case lift k2 body of lifted b2 ds2 k3 → lifted (floop is b2) (lapp2 ds ds2) k3))
    fapply f args → (case lift k f of lifted f2 ds k2 → (case lift-list k2 args of lifted2 as ds2 k3 → lifted (fapply f2 as) (lapp2 ds ds2) k3))
    frec dd x alts →
      (case lift k x of
         lifted x2 ds k2 →
           (case lift-ralts k2 alts of
              lifted2 alts2 ds2 k3 →
                let caps = free-vars #0 (frec dd (flit #0) alts2)
                in lifted (fcall k3 (lapp2 (caps-as-vars caps) (lcons x2 lnil)))
                     (lapp2 ds (lapp2 ds2 (lcons (k3 , (%wsucc (lst-len2 caps) , renumber #1 caps (fswitch (fvar #0) (rec-alts k3 caps alts2)))) lnil)))
                     (%wsucc k3)))
    _ → lifted t lnil k
-- the switch of a lifted recursion: each alternative binds its hypotheses by let, each a call of
-- the definition on the field (the captured variables passed again), after the n fields; outer
-- variables are written for the depth they are read at (renumber maps them to the parameters);
-- the body's outer variables move up by one for the definition's own parameter
rec-alts g caps alts =
  case alts of
    lnil → lnil
    lcons a r → lcons (fst a , (fst (snd a) , hyp-lets g caps (fst (snd a)) #0 (fst (snd (snd a))) (shift-at (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a))))) #1 (snd (snd (snd a)))))) (rec-alts g caps r)
hyp-lets g caps n t hyps body =
  case hyps of
    lnil → body
    lcons j r → flet (fcall g (lapp2 (caps-at (%wsucc (%wadd n t)) caps) (lcons (fvar (%wadd (%wsub (%wsub n #1) j) t)) lnil))) (hyp-lets g caps n (%wsucc t) r body)
caps-at d caps = case caps of lnil → lnil; lcons v r → lcons (fvar (%wadd v d)) (caps-at d r)
lift-ralts k alts =
  case alts of
    lnil → lifted2 lnil lnil k
    lcons a r → (case lift k (snd (snd (snd a))) of lifted b2 ds k2 → (case lift-ralts k2 r of lifted2 r2 ds2 k3 → lifted2 (lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , b2))) r2) (lapp2 ds ds2) k3))
lift-list k l =
  case l of
    lnil → lifted2 lnil lnil k
    lcons x xs → (case lift k x of lifted x2 ds k2 → (case lift-list k2 xs of lifted2 xs2 ds2 k3 → lifted2 (lcons x2 xs2) (lapp2 ds ds2) k3))
lift-alts k alts =
  case alts of
    lnil → lifted2 lnil lnil k
    lcons a r → (case lift k (snd (snd a)) of lifted b2 ds k2 → (case lift-alts k2 r of lifted2 r2 ds2 k3 → lifted2 (lcons (fst a , (fst (snd a) , b2)) r2) (lapp2 ds ds2) k3))
caps-as-vars caps = case caps of lnil → lnil; lcons n r → lcons (fvar n) (caps-as-vars r)
lapp2 l m = case l of lnil → m; lcons x xs → lcons x (lapp2 xs m)
-- a converted λ applied through eval-fo: fclos g env with the definition table from the lifted
-- definitions; the definitions' bodies take the captured values then the argument
table-of defs g = case defs of lnil → flit #0; lcons d r → if %weq (fst d) g then snd (snd d) else table-of r g
-- (λ x → x + c) with c captured, lifted and applied: 5 + 10
t-clo = flet (flit #10) (fapply (flam (fprim P-add (lcons (fvar #0) (lcons (fvar #1) lnil)))) (lcons (flit #5) lnil))
#same (case lift #1 t-clo of lifted t2 ds k → eval-fo (table-of ds) lnil t2) = vw #15
#same (case lift #1 t-clo of lifted t2 ds k → k) = #2
-- the lifted definition captures one variable: arity 2
#same (case lift #1 t-clo of lifted t2 ds k → (case ds of lcons d r → fst (snd d); lnil → #0)) = #2
-- the byte layer in the evaluator: a store then a load, 64 and 32 bits, and the length
#same eval-fo (λ g → flit #0) lnil (fprim P-wofi64 (lcons (fprim P-load64 (lcons (fprim P-store64 (lcons (fprim P-bytes (lcons (flit #16) lnil)) (lcons (flit #8) (lcons (flit #9) lnil)))) (lcons (flit #8) lnil))) lnil)) = vw #9
#same eval-fo (λ g → flit #0) lnil (fprim P-load32 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #16) lnil)) (lcons (flit #4) (lcons (flit #258) lnil)))) (lcons (flit #4) lnil))) = vw #258
#same eval-fo (λ g → flit #0) lnil (fprim P-blen (lcons (fprim P-bytes (lcons (flit #16) lnil)) lnil)) = vw #16
-- the numeric layer: Int64 arithmetic wraps, Float64 divides; comparisons are words
#same eval-fo no-defs lnil (fprim P-wofi64 (lcons (fprim P-i64add (lcons (fi64 #40) (lcons (fi64 #2) lnil))) lnil)) = vw #42
#same eval-fo no-defs lnil (fprim P-i64lt (lcons (fi64 #1) (lcons (fi64 #2) lnil))) = vw #1
#same eval-fo no-defs lnil (fprim P-f64lt (lcons (fprim P-f64div (lcons (ff64 #4607182418800017408) (lcons (ff64 #4611686018427387904) lnil))) (lcons (ff64 #4607182418800017408) lnil))) = vw #1
#same eval-fo no-defs lnil (fprim P-wofi64 (lcons (fprim P-i64off64 (lcons (fprim P-f64mul (lcons (ff64 #4618441417868443648) (lcons (ff64 #4619567317775286272) lnil))) lnil)) lnil)) = vw #42
-- structural recursion: the length of a list of data type 7 (nil = 0, cons x xs = 1), as frec
-- with the hypothesis on the second field; evaluated directly, and lifted to a definition
fo-len = frec #7 (fvar #0) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lcons #1 lnil , fprim P-add (lcons (fforce (fvar #0)) (lcons (flit #1) lnil))))) lnil))
l3 = fcon #7 #1 (lcons (flit #5) (lcons (fcon #7 #1 (lcons (flit #6) (lcons (fcon #7 #0 lnil) lnil))) lnil))
#same eval-fo no-defs (lcons (eval-fo no-defs lnil l3) lnil) fo-len = vw #2
#same (case lift #1 (flam fo-len) of lifted t2 ds k → eval-fo (table-of ds) lnil (fapply t2 (lcons l3 lnil))) = vw #2
-- a captured variable in the recursion (the increment c), lifted: the definition takes c then the list
fo-lenc = flet (flit #10) (frec #7 (fvar #1) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lcons #1 lnil , fprim P-add (lcons (fforce (fvar #0)) (lcons (fvar #3) lnil))))) lnil)))
#same (case lift #1 (flam fo-lenc) of lifted t2 ds k → eval-fo (table-of ds) lnil (fapply t2 (lcons l3 lnil))) = vw #20
#same (case lift #1 (flam fo-lenc) of lifted t2 ds k → k) = #3
