-- lib/fo.cub — the first-order form (plan 18.5, B14): what the specializer produces and every
-- back end consumes. Loaded after lib/code.cub. Untyped data, as Code is: programs over it are
-- checked as programs; the form itself is data the machine lays out.
-- A first-order program has no types, paths, dimensions or universes in it: words and
-- fixed-width numbers, constructors with their non-erased fields, switches on constructor tags,
-- projections, calls of compiled definitions by key, native primitives, lets, loops, closures,
-- thunks for lazy positions, and calls into the net for regions that stay symbolic.
data FO
  = fvar (n : Word)                          -- de Bruijn index into the environment
  | flit (w : Word)                          -- a word
  | fi64 (n : Word)                          -- an Int64 literal, by the word it converts from (two's complement)
  | ff64 (w : Word)                          -- a Float64 literal by its bits (the quote of a Float64 value, cplit 2 w)
  | fcon (d : Word) (c : Word) (fs : Lst)    -- constructor c of data type d, its fields (a Lst of FO)
  | fswitch (x : FO) (alts : Lst)            -- case on x's tag: alts a Lst of (c , (n , body)), body over the n fields pushed
  | fproj (d : Word) (c : Word) (k : Word) (x : FO)   -- field k of constructor c of x
  | fcall (g : Word) (args : Lst)            -- a compiled definition g (a key) on arguments
  | fprim (p : Word) (args : Lst)            -- a native primitive p on arguments
  | flet (t : FO) (b : FO)                   -- let: t pushed, b over it
  | fif (c : FO) (t : FO) (e : FO)           -- a word condition: nonzero is true
  | floop (init : Lst) (body : FO)           -- a loop: state pushed; body returns continue (tag 0) or break (tag 1)
  | fclos (g : Word) (env : Lst)             -- a closure: definition g over captured values env
  | flam (b : FO)                            -- a λ as a value over the environment at its creation
  | fapply (f : FO) (args : Lst)             -- call through a function value
  | fthunk (t : FO)                          -- a lazy position: evaluated on force
  | fforce (x : FO)
  | fnet (k : Word) (args : Lst)             -- a call into the net (B18)
  | fassume (fact : Code) (b : FO)           -- a proven fact at this point (for [[assume]]); b the body
  | frec (d : Word) (x : FO) (alts : Lst)    -- structural recursion on x : d; alts a Lst of (c , (n , (hyps , body))): the n
                                             -- fields pushed, then for each field index in hyps the recursion's result on
                                             -- that field (a suspension, read with fforce); lift turns it into a definition
  | fupd (u : Word) (d : Word) (x : FO) (c : Word) (k : Word) (v : FO)   -- x (of constructor c of type d) with field k replaced by v (C21): a
                                             -- fresh value in meaning; u = 1 says x is unique here and the printer stores
                                             -- into it in place, u = 0 that it copies first (copy-on-write); mark-uniq sets u
-- values of first-order programs: words, constructor trees, closures, thunks
data FV
  = vw (w : Word)
  | vcon (d : Word) (c : Word) (fs : Lst)
  | vclos (g : Word) (env : Lst)
  | vlam (b : FO) (env : Lst)
  | vthunk (t : FO) (env : Lst)
  | vnet (k : Word) (args : Lst)
  | vrec (d : Word) (alts : Lst) (x : FV) (env : Lst)   -- a suspended recursion on x (frec's hypothesis)
  | vbytes (b : Word)                        -- a machine byte string (B12's Bytes; the field's type is nominal: FO is untyped)
  | vi64 (x : Word)                          -- a machine Int64 (nominal, as vbytes)
  | vf64 (x : Word)                          -- a machine Float64 (nominal)
-- first-order types (the FT of the plan), for the printers; eval-fo does not consult them.
-- A definition's signature is (params : Lst of FT , ret : FT), read off its elaborated type by
-- lib/lower.cub's ft-of; ftany is what the printer infers for itself
data FT
  = ftword
  | fti64
  | ftf64
  | ftbytes (n : Word)
  | ftdata (d : Word) (ps : Lst) (rep : Word)
  | ftfun (args : Lst) (ret : FT)
  | ftlazy (t : FT)
  | ftpair (a : FT) (b : FT)
  | ftany
-- a schedule (plan 5.2, 18.3 §6), the value the specializer takes (lib/specialize.cub reads it;
-- declared here, before the checker, as untyped data): the rewrite bound, the binding-time
-- assignment (a Lst of (binder index , Stage)), the representations consumed (a Lst of data
-- type indices; every declared one when empty)
data Sched = sched (rewrites : Word) (stages : Lst) (reps : Lst)
-- ---------------------------------------------------------------- primitives
-- the native primitives, by number; a printer maps each to its C operator or call
P-add = #0
P-sub = #1
P-mul = #2
P-eq = #3
P-lt = #4
P-and = #5
P-or = #6
P-not = #7
-- the byte layer (B12): load64 b off, store64 b off v, load32, store32, bytes n, blen b; words in
-- and out (the machine's Int64/UInt32 converted at the boundary)
P-load64 = #8
P-store64 = #9
P-load32 = #10
P-store32 = #11
P-bytes = #12
P-blen = #13
-- fixed-width and floating-point arithmetic (B12's primitive types): Int64 as the machine's
-- Int64 values (vi64), Float64 as its Float64 values (vf64); comparisons answer words
P-i64add = #14
P-i64sub = #15
P-i64mul = #16
P-i64eq = #17
P-i64lt = #18
P-f64add = #19
P-f64sub = #20
P-f64mul = #21
P-f64div = #22
P-f64eq = #23
P-f64lt = #24
P-i64ofw = #25
P-wofi64 = #26
P-f64ofi64 = #27
P-i64off64 = #28
P-f64ofw = #29
-- a store into a buffer nobody else holds (C21's uniqueness on the byte layer, set by mark-uniq):
-- the same value as P-store64 / P-store32; the printers store in place instead of copying first
P-store64-ip = #30
P-store32-ip = #31
-- a Float64's bits as an Int64 and back (item 22: Float64 elements stored by the byte layer); the
-- printers' n32/n33 are the identity on the word of bits
P-f64bits = #32
P-f64ofbits = #33
-- word maximum (the machine's %wmax, code cwop 3): one primitive, printed as one expression
P-max = #34
-- UInt32 arithmetic (B12's primitive type, the machine's %u32add … %u32lt): a UInt32 is held as the
-- word of its 32 bits, and each operation is the machine's, wrapping at 2^32 (until 2026-11-09 they
-- were lowered to the word operations: u32add past 2^32 carried, u32sub truncated at 0); u32ofw
-- keeps the low 32 bits, wofu32 reads the 32 bits as a word
P-u32add = #35
P-u32sub = #36
P-u32mul = #37
P-u32eq = #38
P-u32lt = #39
P-u32ofw = #40
P-wofu32 = #41
-- (as booleans by case: orf is defined below)
store-ip p = if %weq p P-store64-ip then true else %weq p P-store32-ip
store-any p = if store-ip p then true else (if %weq p P-store64 then true else %weq p P-store32)
-- a read of a buffer (a load or its length): a read, not a hold
load-p p = if %weq p P-load64 then true else (if %weq p P-load32 then true else %weq p P-blen)
plain-p p = if %weq p P-store64-ip then P-store64 else if %weq p P-store32-ip then P-store32 else p
ip-p p = if %weq p P-store64 then P-store64-ip else if %weq p P-store32 then P-store32-ip else p
iof v = case v of vi64 x → x; vw w → %i64ofw w; _ → %i64ofw #0
fof v = case v of vf64 x → x; vw w → %f64ofw w; _ → %f64ofw #0
bw b = case b of true → #1; false → #0
prim-num p args =
  case args of
    lcons a r →
      (case r of
         lnil →
           if %weq p P-i64ofw then vi64 (%i64ofw (wof a))
           else if %weq p P-wofi64 then vw (%wofi64 (iof a))
           else if %weq p P-f64ofi64 then vf64 (%f64ofi64 (iof a))
           else if %weq p P-i64off64 then vi64 (%i64off64 (fof a))
           else if %weq p P-f64bits then vi64 (%f64bits (fof a))
           else if %weq p P-f64ofbits then vf64 (%f64ofbits (iof a))
           else vf64 (%f64ofw (wof a))
         lcons b r2 →
           if %weq p P-i64add then vi64 (%i64add (iof a) (iof b))
           else if %weq p P-i64sub then vi64 (%i64sub (iof a) (iof b))
           else if %weq p P-i64mul then vi64 (%i64mul (iof a) (iof b))
           else if %weq p P-i64eq then vw (bw (%i64eq (iof a) (iof b)))
           else if %weq p P-i64lt then vw (bw (%i64lt (iof a) (iof b)))
           else if %weq p P-f64add then vf64 (%f64add (fof a) (fof b))
           else if %weq p P-f64sub then vf64 (%f64sub (fof a) (fof b))
           else if %weq p P-f64mul then vf64 (%f64mul (fof a) (fof b))
           else if %weq p P-f64div then vf64 (%f64div (fof a) (fof b))
           else if %weq p P-f64eq then vw (bw (%f64eq (fof a) (fof b)))
           else vw (bw (%f64lt (fof a) (fof b))))
    lnil → vw #0
bof v = case v of vbytes b → b; _ → %bytes #0
prim-bytes p args =
  case args of
    lcons a r →
      (case r of
         lnil → (if %weq p P-bytes then vbytes (%bytes (wof a)) else vw (%blen (bof a)))
         lcons b r2 →
           (case r2 of
              lnil → (if %weq p P-load64 then vi64 (%load64 (bof a) (wof b)) else vw (%wofu32 (%load32 (bof a) (wof b))))
              lcons c r3 → (if %weq p P-store64 then vbytes (%store64 (bof a) (wof b) (iof c)) else vbytes (%store32 (bof a) (wof b) (%u32ofw (wof c))))))
    lnil → vw #0
-- the word-valued primitives from P-max on: the machine's operation on the words (a UInt32 by its bits)
prim-wd p args =
  case args of
    lcons a r →
      (case r of
         lnil → (if %weq p P-u32ofw then vw (%wofu32 (%u32ofw (wof a))) else vw (wof a))
         lcons b r2 →
           if %weq p P-max then vw (%wmax (wof a) (wof b))
           else if %weq p P-u32add then vw (%wofu32 (%u32add (%u32ofw (wof a)) (%u32ofw (wof b))))
           else if %weq p P-u32sub then vw (%wofu32 (%u32sub (%u32ofw (wof a)) (%u32ofw (wof b))))
           else if %weq p P-u32mul then vw (%wofu32 (%u32mul (%u32ofw (wof a)) (%u32ofw (wof b))))
           else if %weq p P-u32eq then vw (bw (%u32eq (%u32ofw (wof a)) (%u32ofw (wof b))))
           else vw (bw (%u32lt (%u32ofw (wof a)) (%u32ofw (wof b)))))
    lnil → vw #0
prim-ap p a b =
  if %weq p P-add then %wadd a b
  else if %weq p P-sub then %wsub a b
  else if %weq p P-mul then wmul a b
  else if %weq p P-eq then (if %weq a b then #1 else #0)
  else if %weq p P-lt then (if %wlt a b then #1 else #0)
  else if %weq p P-and then (if %weq a #0 then #0 else (if %weq b #0 then #0 else #1))
  else if %weq p P-or then (if %weq a #0 then (if %weq b #0 then #0 else #1) else #1)
  else #0
-- multiplication by repeated addition (no %wmul primitive yet; B12 adds it with its spec)
wmul a b = %welim b #0 (λ n h → %wadd h a)
-- ---------------------------------------------------------------- the evaluator
-- eval-fo G e t: the value of t in environment e (a Lst of FV, innermost first), G the table of
-- compiled definitions (a function from a key to a closure body: the definition's FO and arity).
-- A definition's body is evaluated with its arguments pushed. Loops run until fbreak.
wof v = case v of vw w → w; _ → #0
lst-nth l n = case l of lnil → vw #0; lcons x xs → if %weq n #0 then x else lst-nth xs (%wsub n #1)
lst-len l = case l of lnil → #0; lcons x xs → %wsucc (lst-len xs)
lst-rev l = lst-rev-onto l lnil
lst-rev-onto l acc = case l of lnil → acc; lcons x xs → lst-rev-onto xs (lcons x acc)
lst-app l m = case l of lnil → m; lcons x xs → lcons x (lst-app xs m)
-- push a list of values (in argument order) onto an environment: the last argument innermost
push-all vs e = case vs of lnil → e; lcons v r → push-all r (lcons v e)
eval-fo G e t =
  case t of
    fvar n → lst-nth e n
    flit w → vw w
    fi64 n → vi64 (%i64ofw n)
    ff64 w → vf64 (%pval #2 w)
    fcon d c fs → vcon d c (eval-list G e fs)
    fswitch x alts →
      (case eval-fo G e x of
         vcon d c fs → eval-fo G (push-all fs e) (alt-of alts c)
         _ → vw #0)
    fproj d c k x → (case eval-fo G e x of vcon d2 c2 fs → lst-nth fs k; _ → vw #0)
    fcall g args → eval-fo G (push-all (eval-list G e args) lnil) (G g)
    fprim p args →
      if store-ip p then prim-bytes (plain-p p) (eval-list G e args) else
      if %wlt #33 p then prim-wd p (eval-list G e args) else
      if %wlt #13 p then prim-num p (eval-list G e args) else
      if %wlt #7 p then prim-bytes p (eval-list G e args) else
      (case eval-list G e args of
         lcons a r →
           (case r of
              lcons b r2 → vw (prim-ap p (wof a) (wof b))
              lnil → vw (if %weq p P-not then (if %weq (wof a) #0 then #1 else #0) else wof a))
         lnil → vw #0)
    flet t2 b → eval-fo G (lcons (eval-fo G e t2) e) b
    fif c th el → if %weq (wof (eval-fo G e c)) #0 then eval-fo G e el else eval-fo G e th
    floop init body → run-loop G e (eval-list G e init) body
    fclos g env → vclos g (eval-list G e env)
    flam b → vlam b e
    fapply f args → apply-args G (eval-fo G e f) (eval-list G e args)
    fthunk t2 → vthunk t2 e
    fforce x → (case eval-fo G e x of vthunk t2 e2 → eval-fo G e2 t2; vrec d alts v e2 → enter-rec G e2 d alts v; v → v)
    frec d x alts → enter-rec G e d alts (eval-fo G e x)
    fnet k args → vnet k (eval-list G e args)
    fassume fact b → eval-fo G e b
    fupd u dd x c k v → (case eval-fo G e x of vcon d c2 fs → vcon d c2 (lst-set fs k (eval-fo G e v)); _ → vw #0)
    _ → vw #0
lst-set l k v = case l of lnil → lnil; lcons x xs → if %weq k #0 then lcons v xs else lcons x (lst-set xs (%wsub k #1) v)
eval-list G e l = case l of lnil → lnil; lcons x xs → lcons (eval-fo G e x) (eval-list G e xs)
-- a recursion entered on a value: the fields pushed, then the hypotheses (suspended recursions on
-- the fields named), then the alternative's body
enter-rec G e d alts v =
  case v of
    vcon d2 c fs → (case ralt-of alts c of
                      some a → eval-fo G (push-all (hyp-vals d alts fs e (fst (snd (snd a)))) (push-all fs e)) (snd (snd (snd a)))
                      none → vw #0)
    _ → vw #0
ralt-of alts c = case alts of lnil → none; lcons a r → if %weq (fst a) c then some a else ralt-of r c
hyp-vals d alts fs e hyps = case hyps of lnil → lnil; lcons j r → lcons (vrec d alts (lst-nth fs j) e) (hyp-vals d alts fs e r)
-- applying a function value to arguments: a lifted λ's closure takes one (its definition's last
-- parameter) and the result takes the rest; a λ takes one and
-- its body is applied to the rest
apply-args G f args =
  case args of
    lnil → f
    lcons a rest →
      (case f of
         vclos g env → apply-args G (eval-fo G (lcons a (push-all env lnil)) (G g)) rest
         vlam b env → apply-args G (eval-fo G (lcons a env) b) rest
         _ → vw #0)
alt-of alts c = case alts of lnil → flit #0; lcons a r → if %weq (fst a) c then snd (snd a) else alt-of r c
-- a loop: the state is pushed (in order), the body runs; fcontinue restarts with the new state,
-- fbreak ends. Runs by structural recursion on nothing: a loop is a reading, total only when the
-- body breaks; the first-order criterion admits loops that come from terminating recursion
run-loop G e st body =
  case eval-fo G (push-all st e) body of
    vcon d c fs → (if %weq c #0 then run-loop G e fs body else lst-nth fs #0)
    v → v
-- the loop's body returns constructors of this two-constructor type: tag 0 continue, tag 1 break
fcontinue-v st = vcon #0 #0 st
fbreak-v r = vcon #0 #1 (lcons r lnil)
-- ---------------------------------------------------------------- examples
-- plus on words: fprim add over the two arguments
fo-plus = fprim P-add (lcons (fvar #1) (lcons (fvar #0) lnil))
-- factorial as a loop: state (n, acc); continue while n > 0
fo-fact =
  floop (lcons (fvar #0) (lcons (flit #1) lnil))
    (fif (fprim P-lt (lcons (flit #0) (lcons (fvar #1) lnil)))
       (fcon #0 #0 (lcons (fprim P-sub (lcons (fvar #1) (lcons (flit #1) lnil)))
                          (lcons (fprim P-mul (lcons (fvar #0) (lcons (fvar #1) lnil))) lnil)))
       (fcon #0 #1 (lcons (fvar #0) lnil)))
no-defs g = flit #0
#same eval-fo no-defs (lcons (vw #3) (lcons (vw #4) lnil)) fo-plus = vw #7
#same eval-fo no-defs (lcons (vw #5) lnil) fo-fact = vw #120
-- a compiled definition called by key: key 1 is fo-plus
defs g = if %weq g #1 then fo-plus else flit #0
#same eval-fo defs lnil (fcall #1 (lcons (flit #20) (lcons (flit #22) lnil))) = vw #42
-- a closure capturing one value, applied
#same eval-fo defs lnil (fapply (fclos #1 (lcons (flit #10) lnil)) (lcons (flit #5) lnil)) = vw #15
-- a switch on a constructor
#same eval-fo defs lnil (fswitch (fcon #7 #1 (lcons (flit #9) lnil)) (lcons (#0 , (#0 , flit #0)) (lcons (#1 , (#1 , fvar #0)) lnil))) = vw #9
-- a thunk is not evaluated until forced
#same eval-fo defs lnil (fforce (fthunk (fprim P-add (lcons (flit #1) (lcons (flit #2) lnil))))) = vw #3
-- shifting free variables of a first-order term by k (binders: flet 1, flam by its arity as applied,
-- fswitch alternatives by their constructor's field count, floop 3). A λ's body is shifted below
-- its own binders: flam binds an unknown number of arguments, so a λ in a shifted position is
-- closed over by the environment at its creation and needs no shift of its body (vlam keeps e)
shift k t = shift-at #0 k t
shift-at d k t =
  case t of
    fvar n → if %wlt n d then fvar n else fvar (%wadd n k)
    flit w → t
    fcon dd c fs → fcon dd c (fshift-list d k fs)
    fswitch x alts → fswitch (shift-at d k x) (shift-alts d k alts)
    fproj dd c j x → fproj dd c j (shift-at d k x)
    fcall g args → fcall g (fshift-list d k args)
    fprim p args → fprim p (fshift-list d k args)
    flet a b → flet (shift-at d k a) (shift-at (%wsucc d) k b)
    fif c a b → fif (shift-at d k c) (shift-at d k a) (shift-at d k b)
    floop init body → floop (fshift-list d k init) (shift-at (%wadd d #3) k body)
    fclos g env → fclos g (fshift-list d k env)
    flam b → flam b
    fapply f args → fapply (shift-at d k f) (fshift-list d k args)
    fthunk a → fthunk (shift-at d k a)
    fforce x → fforce (shift-at d k x)
    fnet g args → fnet g (fshift-list d k args)
    fassume f b → fassume f (shift-at d k b)
    frec dd x alts → frec dd (shift-at d k x) alts
    fupd u dd x c j v → fupd u dd (shift-at d k x) c j (shift-at d k v)
    _ → t
fshift-list d k l = case l of lnil → lnil; lcons x xs → lcons (shift-at d k x) (fshift-list d k xs)
-- an alternative's body sees its constructor's fields pushed; their count is not known here, so
-- alternatives are shifted as closed over the switch's environment: a branch's variables above
-- the fields are the switch's (the printer and specializer know the counts from %dent)
shift-alts d k alts = alts
-- ---------------------------------------------------------------- closure conversion
-- A λ in the first-order form captures the whole environment at its creation (vlam). For a
-- printer, every λ becomes a definition of its own over its free variables: lift k t walks t,
-- replacing each flam b by fclos g (the free variables of b, as fvars at the λ's position) and
-- emitting the definition g = (arity 1 + n, body with its free variables renumbered to the n
-- captured parameters below the argument). Definitions are numbered from k upward and returned
-- with the converted term. A converted program has no flam left; fapply on an fclos calls g with
-- the captured values then the arguments.
data Lifted = lifted (t : FO) (defs : Lst) (next : Word)
data Lifted2 = lifted2 (ts : Lst) (defs : Lst) (next : Word)
-- free variables of t at depth 0: the set of indices ≥ d that occur, as a sorted Lst of words
free-vars d t = fv-sorted (fv d t lnil)
fv d t acc =
  case t of
    fvar n → if %wlt n d then acc else ins-sorted (%wsub n d) acc
    fcon dd c fs → fv-list d fs acc
    fswitch x alts → fv-alts d alts (fv d x acc)
    fproj dd c k x → fv d x acc
    fcall g args → fv-list d args acc
    fprim p args → fv-list d args acc
    flet a b → fv (%wsucc d) b (fv d a acc)
    fif c a b → fv d b (fv d a (fv d c acc))
    floop init body → fv (%wadd d #3) body (fv-list d init acc)
    fclos g env → fv-list d env acc
    flam b → fv (%wsucc d) b acc
    fapply f args → fv-list d args (fv d f acc)
    fthunk a → fv d a acc
    fforce x → fv d x acc
    fnet g args → fv-list d args acc
    fassume f b → fv d b acc
    frec dd x alts → fv-ralts d alts (fv d x acc)
    fupd u dd x c k v → fv d v (fv d x acc)
    _ → acc
fv-ralts d alts acc = case alts of lnil → acc; lcons a r → fv-ralts d r (fv (%wadd d (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) (snd (snd (snd a))) acc)
fv-list d l acc = case l of lnil → acc; lcons x xs → fv-list d xs (fv d x acc)
fv-alts d alts acc = case alts of lnil → acc; lcons a r → fv-alts d r (fv (%wadd d (fst (snd a))) (snd (snd a)) acc)
ins-sorted n l = case l of lnil → lcons n lnil; lcons m r → if %wlt n m then lcons n l else if %weq n m then l else lcons m (ins-sorted n r)
fv-sorted l = l
-- the index of n in a sorted list (its position), for renumbering
index-of n l = case l of lnil → #0; lcons m r → if %weq n m then #0 else %wsucc (index-of n r)
lst-len2 l = case l of lnil → #0; lcons x xs → %wsucc (lst-len2 xs)
-- renumber the free variables of a λ body: inside the lifted definition the environment is the
-- captured values c_0 .. c_(n-1) (c_0 innermost? no: pushed in order, so c_(n-1) is innermost,
-- index 0 above the argument) then the argument at index 0. A free variable m of the body (at
-- body depth d, index m ≥ d, referring to outer index m − d) becomes d + (position of (m − d) in
-- the captured list, counted from the end)
renumber d caps t =
  case t of
    fvar n → if %wlt n d then t else fvar (%wadd d (%wsub (%wsub (lst-len2 caps) #1) (index-of (%wsub n d) caps)))
    fcon dd c fs → fcon dd c (renumber-list d caps fs)
    fswitch x alts → fswitch (renumber d caps x) (renumber-alts d caps alts)
    fproj dd c k x → fproj dd c k (renumber d caps x)
    fcall g args → fcall g (renumber-list d caps args)
    fprim p args → fprim p (renumber-list d caps args)
    flet a b → flet (renumber d caps a) (renumber (%wsucc d) caps b)
    fif c a b → fif (renumber d caps c) (renumber d caps a) (renumber d caps b)
    floop init body → floop (renumber-list d caps init) (renumber (%wadd d #3) caps body)
    fclos g env → fclos g (renumber-list d caps env)
    flam b → flam (renumber (%wsucc d) caps b)
    fapply f args → fapply (renumber d caps f) (renumber-list d caps args)
    fthunk a → fthunk (renumber d caps a)
    fforce x → fforce (renumber d caps x)
    fnet g args → fnet g (renumber-list d caps args)
    fassume f b → fassume f (renumber d caps b)
    frec dd x alts → frec dd (renumber d caps x) (renumber-ralts d caps alts)
    fupd u dd x c k v → fupd u dd (renumber d caps x) c k (renumber d caps v)
    _ → t
renumber-ralts d caps alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , renumber (%wadd d (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) caps (snd (snd (snd a)))))) (renumber-ralts d caps r)
renumber-list d caps l = case l of lnil → lnil; lcons x xs → lcons (renumber d caps x) (renumber-list d caps xs)
renumber-alts d caps alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , renumber (%wadd d (fst (snd a))) caps (snd (snd a)))) (renumber-alts d caps r)
-- lift: definitions numbered from k; innermost λs first so that a λ's body is already converted
lift k t =
  case t of
    flam b →
      (case lift k b of
         lifted b2 ds k2 →
           let caps = free-vars #1 b2
           in lifted (fclos k2 (caps-as-vars caps)) (lapp2 ds (lcons (k2 , (%wsucc (lst-len2 caps) , renumber #1 caps b2)) lnil)) (%wsucc k2))
    fcon dd c fs → (case lift-list k fs of lifted2 fs2 ds k2 → lifted (fcon dd c fs2) ds k2)
    fswitch x alts → (case lift k x of lifted x2 ds k2 → (case lift-alts k2 alts of lifted2 alts2 ds2 k3 → lifted (fswitch x2 alts2) (lapp2 ds ds2) k3))
    fproj dd c j x → (case lift k x of lifted x2 ds k2 → lifted (fproj dd c j x2) ds k2)
    fcall g args → (case lift-list k args of lifted2 as ds k2 → lifted (fcall g as) ds k2)
    fprim p args → (case lift-list k args of lifted2 as ds k2 → lifted (fprim p as) ds k2)
    flet a b → (case lift k a of lifted a2 ds k2 → (case lift k2 b of lifted b2 ds2 k3 → lifted (flet a2 b2) (lapp2 ds ds2) k3))
    fif c a b → (case lift k c of lifted c2 ds k2 → (case lift k2 a of lifted a2 ds2 k3 → (case lift k3 b of lifted b2 ds3 k4 → lifted (fif c2 a2 b2) (lapp2 ds (lapp2 ds2 ds3)) k4)))
    floop init body → (case lift-list k init of lifted2 is ds k2 → (case lift k2 body of lifted b2 ds2 k3 → lifted (floop is b2) (lapp2 ds ds2) k3))
    fapply f args → (case lift k f of lifted f2 ds k2 → (case lift-list k2 args of lifted2 as ds2 k3 → lifted (fapply f2 as) (lapp2 ds ds2) k3))
    fupd u dd x c j v → (case lift k x of lifted x2 ds k2 → (case lift k2 v of lifted v2 ds2 k3 → lifted (fupd u dd x2 c j v2) (lapp2 ds ds2) k3))
    -- a thunk is lifted to a closure over its free variables taking one ignored argument (the
    -- printers have closures of one argument through the dispatcher), kept under fthunk as the
    -- suspended application of that closure to 0: the evaluator forces it by evaluating the
    -- application, and a printer builds a closure tagged as a thunk, which its force() applies.
    -- Lifted recursion hypotheses are forced too and are values, which force leaves alone; a
    -- thunk forced twice is computed twice (the first-order form shares by let, not by memoized
    -- suspensions)
    fthunk a → (case lift k (flam (shift-at #0 #1 a)) of lifted c ds k2 → lifted (fthunk (fapply c (lcons (flit #0) lnil))) ds k2)
    fforce x → (case lift k x of lifted x2 ds k2 → lifted (fforce x2) ds k2)
    frec dd x alts →
      (case lift k x of
         lifted x2 ds k2 →
           (case lift-ralts k2 alts of
              lifted2 alts2 ds2 k3 →
                let caps = free-vars #0 (frec dd (flit #0) alts2)
                in lifted (fcall k3 (lapp2 (caps-as-vars caps) (lcons x2 lnil)))
                     (lapp2 ds (lapp2 ds2 (lcons (k3 , (%wsucc (lst-len2 caps) , renumber #1 caps (frec dd (fvar #0) (rec-alts k3 caps alts2)))) lnil)))
                     (%wsucc k3)))
    _ → lifted t lnil k
-- the switch of a lifted recursion — a recursion form with no hypotheses left (the printers read
-- it as a switch that knows its data type, so the scrutinee is typed): each alternative binds its
-- hypotheses by let, each a call of the definition on the field (the captured variables passed
-- again), after the n fields; outer variables are written for the depth they are read at
-- (renumber maps them to the parameters); the body's outer variables move up by one for the
-- definition's own parameter
rec-alts g caps alts =
  case alts of
    lnil → lnil
    lcons a r → lcons (fst a , (fst (snd a) , (lnil , inline-hyps (lst-len2 (fst (snd (snd a)))) (hyp-lets g caps (fst (snd a)) #0 (fst (snd (snd a))) (shift-at (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a))))) #1 (snd (snd (snd a)))))))) (rec-alts g caps r)
-- a hypothesis bound by let is computed before the alternative's body runs, whether the body
-- reads it or not; one the body never reads is dropped, one it reads exactly once, outside any
-- λ or loop (where it would be computed again), is put in place of its variable: the recursive
-- call then happens where the source makes it (a head's recursion does not walk the list, an
-- insertion stops where it inserts). The k innermost lets of t are the hypotheses
inline-hyps k t =
  if %weq k #0 then t
  else (case t of
          flet a b →
            let b2 = inline-hyps (%wsub k #1) b
                n = occ-count #0 b2
            in if %weq n #0 then funshift0 #0 b2 else if %weq n #1 then fsubst #0 a b2 else flet a b2
          _ → t)
-- occurrences of variable v in t; one under a λ, a thunk or a loop body counts as many
occ-count v t =
  case t of
    fvar n → if %weq n v then #1 else #0
    fcon d c fs → occ-list v fs
    fswitch x alts → %wadd (occ-count v x) (occ-alts v alts)
    frec d x alts → %wadd (occ-count v x) (occ-ralts v alts)
    fproj d c k x → occ-count v x
    fcall g args → occ-list v args
    fprim p args → occ-list v args
    flet a b → %wadd (occ-count v a) (occ-count (%wsucc v) b)
    fif c a b → %wadd (occ-count v c) (%wadd (occ-count v a) (occ-count v b))
    floop init body → %wadd (occ-list v init) (occ-many (occ-count (%wadd v (lst-len2 init)) body))
    fclos g env → occ-list v env
    flam b → occ-many (occ-count (%wsucc v) b)
    fapply f args → %wadd (occ-count v f) (occ-list v args)
    fthunk a → occ-many (occ-count v a)
    fforce x → occ-count v x
    fnet g args → occ-list v args
    fassume f b → %wadd (if fact-has v f then #2 else #0) (occ-count v b)
    fupd u d x c k w → %wadd (occ-count v x) (occ-count v w)
    _ → #0
occ-many n = if %weq n #0 then #0 else #2
occ-list v l = case l of lnil → #0; lcons x r → %wadd (occ-count v x) (occ-list v r)
occ-alts v alts = case alts of lnil → #0; lcons a r → %wadd (occ-count (%wadd v (fst (snd a))) (snd (snd a))) (occ-alts v r)
occ-ralts v alts = case alts of lnil → #0; lcons a r → %wadd (occ-count (%wadd v (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) (snd (snd (snd a)))) (occ-ralts v r)
fact-has v c = case c of cvar n → %weq n v; cwop k a b → (case fact-has v a of true → true; false → fact-has v b); cwsucc a → fact-has v a; cann a T → fact-has v a; _ → false
-- fsubst d e t: e (closed over the environment below binder d) in place of variable d in t, the
-- variables above d moved down; funshift0 d t: the same with no occurrence of d
fsubst d e t =
  case t of
    fvar n → if %weq n d then shift d e else if %wlt d n then fvar (%wsub n #1) else t
    fcon dd c fs → fcon dd c (fsubst-list d e fs)
    fswitch x alts → fswitch (fsubst d e x) (fsubst-alts d e alts)
    frec dd x alts → frec dd (fsubst d e x) (fsubst-ralts d e alts)
    fproj dd c j x → fproj dd c j (fsubst d e x)
    fcall g args → fcall g (fsubst-list d e args)
    fprim p args → fprim p (fsubst-list d e args)
    flet a b → flet (fsubst d e a) (fsubst (%wsucc d) e b)
    fif c a b → fif (fsubst d e c) (fsubst d e a) (fsubst d e b)
    floop init body → floop (fsubst-list d e init) (fsubst (%wadd d (lst-len2 init)) e body)
    fclos g env → fclos g (fsubst-list d e env)
    flam b → flam (fsubst (%wsucc d) e b)
    fapply f args → fapply (fsubst d e f) (fsubst-list d e args)
    fthunk a → fthunk (fsubst d e a)
    fforce x → fforce (fsubst d e x)
    fnet g args → fnet g (fsubst-list d e args)
    fassume f b → if fact-has d f then fsubst d e b else fassume (fact-down d f) (fsubst d e b)
    fupd u dd x c k w → fupd u dd (fsubst d e x) c k (fsubst d e w)
    _ → t
fsubst-list d e l = case l of lnil → lnil; lcons x r → lcons (fsubst d e x) (fsubst-list d e r)
fsubst-alts d e alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , fsubst (%wadd d (fst (snd a))) e (snd (snd a)))) (fsubst-alts d e r)
fsubst-ralts d e alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , fsubst (%wadd d (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) e (snd (snd (snd a)))))) (fsubst-ralts d e r)
fact-down d c = case c of cvar n → (if %wlt d n then cvar (%wsub n #1) else c); cwop k a b → cwop k (fact-down d a) (fact-down d b); cwsucc a → cwsucc (fact-down d a); cann a T → fact-down d a; _ → c
funshift0 d t = fsubst d (flit #0) t
hyp-lets g caps n t hyps body =
  case hyps of
    lnil → body
    lcons j r → flet (fcall g (lapp2 (caps-at (%wsucc (%wadd n t)) caps) (lcons (fvar (%wadd (%wsub (%wsub n #1) j) t)) lnil))) (hyp-lets g caps n (%wsucc t) r body)
caps-at d caps = case caps of lnil → lnil; lcons v r → lcons (fvar (%wadd v d)) (caps-at d r)
lift-ralts k alts =
  case alts of
    lnil → lifted2 lnil lnil k
    lcons a r → (case lift k (snd (snd (snd a))) of lifted b2 ds k2 → (case lift-ralts k2 r of lifted2 r2 ds2 k3 → lifted2 (lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , b2))) r2) (lapp2 ds ds2) k3))
lift-list k l =
  case l of
    lnil → lifted2 lnil lnil k
    lcons x xs → (case lift k x of lifted x2 ds k2 → (case lift-list k2 xs of lifted2 xs2 ds2 k3 → lifted2 (lcons x2 xs2) (lapp2 ds ds2) k3))
lift-alts k alts =
  case alts of
    lnil → lifted2 lnil lnil k
    lcons a r → (case lift k (snd (snd a)) of lifted b2 ds k2 → (case lift-alts k2 r of lifted2 r2 ds2 k3 → lifted2 (lcons (fst a , (fst (snd a) , b2)) r2) (lapp2 ds ds2) k3))
caps-as-vars caps = case caps of lnil → lnil; lcons n r → lcons (fvar n) (caps-as-vars r)
lapp2 l m = case l of lnil → m; lcons x xs → lcons x (lapp2 xs m)
-- a converted λ applied through eval-fo: fclos g env with the definition table from the lifted
-- definitions; the definitions' bodies take the captured values then the argument
table-of defs g = case defs of lnil → flit #0; lcons d r → if %weq (fst d) g then snd (snd d) else table-of r g
-- (λ x → x + c) with c captured, lifted and applied: 5 + 10
t-clo = flet (flit #10) (fapply (flam (fprim P-add (lcons (fvar #0) (lcons (fvar #1) lnil)))) (lcons (flit #5) lnil))
-- a thunk over a let-bound value, forced twice and the forcings added: 10 + 1 twice = 22, before
-- and after lifting (the thunk a closure, force its application to 0)
t-thunk = flet (flit #10) (flet (fthunk (fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)))) (fprim P-add (lcons (fforce (fvar #0)) (lcons (fforce (fvar #0)) lnil))))
defs-table ds g = case ds of lnil → flit #0; lcons d r → if %weq (fst d) g then snd (snd d) else defs-table r g
#same eval-fo lnil lnil t-thunk = vw #22
#same (case lift #1 t-thunk of lifted t2 ds k → eval-fo (defs-table ds) lnil t2) = vw #22
#same (case lift #1 t-clo of lifted t2 ds k → eval-fo (table-of ds) lnil t2) = vw #15
#same (case lift #1 t-clo of lifted t2 ds k → k) = #2
-- the lifted definition captures one variable: arity 2
#same (case lift #1 t-clo of lifted t2 ds k → (case ds of lcons d r → fst (snd d); lnil → #0)) = #2
-- the byte layer in the evaluator: a store then a load, 64 and 32 bits, and the length
#same eval-fo (λ g → flit #0) lnil (fprim P-wofi64 (lcons (fprim P-load64 (lcons (fprim P-store64 (lcons (fprim P-bytes (lcons (flit #16) lnil)) (lcons (flit #8) (lcons (flit #9) lnil)))) (lcons (flit #8) lnil))) lnil)) = vw #9
#same eval-fo (λ g → flit #0) lnil (fprim P-load32 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #16) lnil)) (lcons (flit #4) (lcons (flit #258) lnil)))) (lcons (flit #4) lnil))) = vw #258
#same eval-fo (λ g → flit #0) lnil (fprim P-blen (lcons (fprim P-bytes (lcons (flit #16) lnil)) lnil)) = vw #16
-- the numeric layer: Int64 arithmetic wraps, Float64 divides; comparisons are words
#same eval-fo no-defs lnil (fprim P-wofi64 (lcons (fprim P-i64add (lcons (fi64 #40) (lcons (fi64 #2) lnil))) lnil)) = vw #42
#same eval-fo no-defs lnil (fprim P-i64lt (lcons (fi64 #1) (lcons (fi64 #2) lnil))) = vw #1
#same eval-fo no-defs lnil (fprim P-f64lt (lcons (fprim P-f64div (lcons (ff64 #4607182418800017408) (lcons (ff64 #4611686018427387904) lnil))) (lcons (ff64 #4607182418800017408) lnil))) = vw #1
#same eval-fo no-defs lnil (fprim P-wofi64 (lcons (fprim P-i64off64 (lcons (fprim P-f64mul (lcons (ff64 #4618441417868443648) (lcons (ff64 #4619567317775286272) lnil))) lnil)) lnil)) = vw #42
-- structural recursion: the length of a list of data type 7 (nil = 0, cons x xs = 1), as frec
-- with the hypothesis on the second field; evaluated directly, and lifted to a definition
fo-len = frec #7 (fvar #0) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lcons #1 lnil , fprim P-add (lcons (fforce (fvar #0)) (lcons (flit #1) lnil))))) lnil))
l3 = fcon #7 #1 (lcons (flit #5) (lcons (fcon #7 #1 (lcons (flit #6) (lcons (fcon #7 #0 lnil) lnil))) lnil))
#same eval-fo no-defs (lcons (eval-fo no-defs lnil l3) lnil) fo-len = vw #2
#same (case lift #1 (flam fo-len) of lifted t2 ds k → eval-fo (table-of ds) lnil (fapply t2 (lcons l3 lnil))) = vw #2
-- a captured variable in the recursion (the increment c), lifted: the definition takes c then the list
fo-lenc = flet (flit #10) (frec #7 (fvar #1) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lcons #1 lnil , fprim P-add (lcons (fforce (fvar #0)) (lcons (fvar #3) lnil))))) lnil)))
#same (case lift #1 (flam fo-lenc) of lifted t2 ds k → eval-fo (table-of ds) lnil (fapply t2 (lcons l3 lnil))) = vw #20
#same (case lift #1 (flam fo-lenc) of lifted t2 ds k → k) = #3
-- ---------------------------------------------------------------- in-place update (C21)
-- A constructor rebuilt from another value's fields is an update of that value: reuse-cons turns
-- fcon d c fs, where some field i is field i of one base X (a projection fproj d c i X, or the
-- variable a recursion on X bound for it), into fupd 0 X c k v for each field k that differs (X
-- itself when none does). Every fupd is a copy here (u = 0, always correct); mark-uniq then sets
-- u = 1 where the base is unique at that point, so the printer stores into it in place:
-- a let-bound or loop-state value built fresh (a constructor, an update, a byte store) whose only
-- uses are field reads sequenced before the one update, and any update of a value that is itself
-- fresh. The printer evaluates an update's base before its new field, so reads inside the new
-- field see the old value. (Parameters are shared by default: the caller may hold them.)
-- flds: some (d , (c , (n , (h , base)))) under an alternative of a recursion on a variable: at
-- depth dd below the alternative's body, fvar (dd + h + n - 1 - i) is field i of fvar (base + dd)
andf a b = case a of true → b; false → false
orf a b = case a of true → true; false → b
reuse-cons t = reuse-at none #0 t
reuse-at flds dd t =
  case t of
    fcon d c fs → (let fs2 = reuse-list flds dd fs in case base-of flds dd d c fs2 #0 of some X → fold-upd flds dd X d c fs2 #0; none → fcon d c fs2)
    fswitch x alts → fswitch (reuse-at flds dd x) (reuse-alts flds dd alts)
    frec d x alts → frec d (reuse-at flds dd x) (reuse-ralts d x alts)
    fproj d c k x → fproj d c k (reuse-at flds dd x)
    fcall g args → fcall g (reuse-list flds dd args)
    fprim p args → fprim p (reuse-list flds dd args)
    flet a b → flet (reuse-at flds dd a) (reuse-at flds (%wsucc dd) b)
    fif c a b → fif (reuse-at flds dd c) (reuse-at flds dd a) (reuse-at flds dd b)
    floop init body → floop (reuse-list flds dd init) (reuse-at flds (%wadd dd (lst-len2 init)) body)
    fclos g env → fclos g (reuse-list flds dd env)
    flam b → flam (reuse-at flds (%wsucc dd) b)
    fapply f args → fapply (reuse-at flds dd f) (reuse-list flds dd args)
    fthunk a → fthunk (reuse-at flds dd a)
    fforce x → fforce (reuse-at flds dd x)
    fnet g args → fnet g (reuse-list flds dd args)
    fassume f b → fassume f (reuse-at flds dd b)
    fupd u dd x c k v → fupd u dd (reuse-at flds dd x) c k (reuse-at flds dd v)
    _ → t
reuse-list flds dd l = case l of lnil → lnil; lcons x xs → lcons (reuse-at flds dd x) (reuse-list flds dd xs)
-- a switch's alternatives know no data type: only projections are read under them
reuse-alts flds dd alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , reuse-at none #0 (snd (snd a)))) (reuse-alts flds dd r)
-- under a recursion with hypotheses the alternatives are entered again on the fields, where the
-- scrutinee variable still names the value the recursion started on, not the node at hand: the
-- field variables are then no base. (A lifted recursion has no hypotheses: there they are.)
no-hyps-r alts = case alts of lnil → true; lcons a r → (case fst (snd (snd a)) of lnil → no-hyps-r r; _ → false)
reuse-ralts d x alts =
  case alts of
    lnil → lnil
    lcons a r →
      let c = fst a
          n = fst (snd a)
          h = lst-len2 (fst (snd (snd a)))
          flds = (case x of fvar m → (if no-hyps-r alts then some (d , (c , (n , (h , %wadd m (%wadd n h))))) else none); _ → none)
      in lcons (c , (n , (fst (snd (snd a)) , reuse-at flds #0 (snd (snd (snd a)))))) (reuse-ralts d x r)
-- is field f field i of some base: the base, if so
field-base flds dd d c i f =
  case f of
    fproj d2 c2 i2 x → if andf (%weq d d2) (andf (%weq c c2) (andf (%weq i i2) (is-path x))) then some x else none
    fvar m → (case flds of
                some fl → if andf (%weq (fst fl) d) (andf (%weq (fst (snd fl)) c) (%weq m (%wadd dd (%wadd (fst (snd (snd (snd fl)))) (%wsub (%wsub (fst (snd (snd fl))) #1) i)))))
                            then some (fvar (%wadd (snd (snd (snd (snd fl)))) dd)) else none
                none → none)
    _ → none
-- a base is a variable or a projection chain from one (so that its reads can be compared)
is-path x = case x of fvar m → true; fproj d c k y → is-path y; _ → false
fo-eq a b =
  case a of
    fvar m → (case b of fvar m2 → %weq m m2; _ → false)
    fproj d c k x → (case b of fproj d2 c2 k2 y → andf (%weq d d2) (andf (%weq c c2) (andf (%weq k k2) (fo-eq x y))); _ → false)
    _ → false
-- the first field that is a field of some base names the base; the alternative's field count must
-- be the constructor's
base-of flds dd d c fs i =
  case fs of
    lnil → none
    lcons f r → (case field-base flds dd d c i f of
                   some x → (case flds of some fl → (if orf (%weq (fst (snd (snd fl))) (%wadd i (lst-len2 fs))) (is-proj f) then some x else none); none → some x)
                   none → base-of flds dd d c r (%wsucc i))
is-proj f = case f of fproj d c k x → true; _ → false
-- the base updated at every field that is not its own
fold-upd flds dd X d c fs i =
  case fs of
    lnil → X
    lcons f r → (case field-base flds dd d c i f of
                   some y → if fo-eq X y then fold-upd flds dd X d c r (%wsucc i) else fold-upd flds dd (fupd #0 d X c i f) d c r (%wsucc i)
                   none → fold-upd flds dd (fupd #0 d X c i f) d c r (%wsucc i))
-- ---- uniqueness: safe v t classifies the uses of variable v in t: 0 none, 1 field reads only,
-- 2 exactly one update of v as its base on some path, every other use a read sequenced before
-- the store, 3 the value held (a bare use, which makes another holder) without an update, 4
-- unsafe (an update after a hold or beside an unsequenced use, two updates, an update under a λ
-- or a loop body, which may run again)
safe v t =
  case t of
    fvar m → if %weq m v then #3 else #0
    fproj d c k x → (case x of fvar m → (if %weq m v then #1 else #0); _ → safe v x)
    fupd u dd x c k w → (case x of
                        fvar m → (if %weq m v then (if %wlt (safe v w) #2 then #2 else #4) else safe v w)
                        _ → safe-seq (safe v x) (safe v w))
    fswitch x alts → safe-seq (safe-scrut v x) (safe-alts v alts)
    frec d x alts → safe-seq (safe-scrut v x) (safe-ralts v alts)
    flet a b → safe-seq (safe v a) (safe (%wsucc v) b)
    fif c a b → safe-seq (safe v c) (safe-branch (safe v a) (safe v b))
    fcon d c fs → safe-list v fs
    fcall g args → safe-list v args
    fprim p args → (if store-any p then (case args of
                                            lcons x rest → (case x of
                                                              fvar m → (if %weq m v then (if %wlt (safe-list v rest) #2 then #2 else #4) else safe-list v rest)
                                                              _ → safe-list v args)
                                            lnil → #0)
                     else if load-p p then (case args of
                                              lcons x rest → (case x of
                                                                fvar m → (if %weq m v then safe-par #1 (safe-list v rest) else safe-list v rest)
                                                                _ → safe-list v args)
                                              lnil → #0)
                     else safe-list v args)
    fclos g env → safe-list v env
    fnet g args → safe-list v args
    fapply f args → safe-par (safe v f) (safe-list v args)
    floop init body → safe-par (safe-list v init) (safe-again (safe (%wadd v (lst-len2 init)) body))
    flam b → safe-again (safe (%wsucc v) b)
    fthunk a → safe-again (safe v a)
    fforce x → safe v x
    fassume f b → safe v b
    _ → #0
-- a scrutinee is read (its tag and fields are bound before the alternative runs)
safe-scrut v x = case x of fvar m → (if %weq m v then #1 else #0); _ → safe v x
-- a before b: a's update must be the last use; reads in a before an update in b are fine; a
-- hold in a before an update in b is not (the holder would see the store)
safe-seq a b = if orf (%weq a #4) (%weq b #4) then #4 else if %weq a #2 then (if %weq b #0 then #2 else #4) else if andf (%weq a #3) (%weq b #2) then #4 else (if %wlt a b then b else a)
-- unsequenced: an update beside any other use is unsafe
safe-par a b = if orf (%weq a #4) (%weq b #4) then #4 else if %weq a #2 then (if %weq b #0 then #2 else #4) else if %weq b #2 then (if %weq a #0 then #2 else #4) else (if %wlt a b then b else a)
-- exclusive branches: an update on one path, reads or a hold on another, are fine
safe-branch a b = if orf (%weq a #4) (%weq b #4) then #4 else if orf (%weq a #2) (%weq b #2) then #2 else (if %wlt a b then b else a)
-- a region that may run more than once: an update in it would store twice
safe-again a = if %weq a #2 then #4 else a
safe-list v l = case l of lnil → #0; lcons x xs → safe-par (safe v x) (safe-list v xs)
safe-alts v alts = case alts of lnil → #0; lcons a r → safe-branch (safe (%wadd v (fst (snd a))) (snd (snd a))) (safe-alts v r)
safe-ralts v alts = case alts of lnil → #0; lcons a r → safe-branch (safe (%wadd v (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) (snd (snd (snd a)))) (safe-ralts v r)
-- a term whose value is a cell nobody else holds
fresh t =
  case t of
    fcon d c fs → true
    fupd u dd x c k v → true
    flet a b → fresh b
    fif c a b → andf (fresh a) (fresh b)
    fswitch x alts → fresh-alts alts
    frec d x alts → fresh-ralts alts
    fassume f b → fresh b
    fprim p args → orf (store-any p) (%weq p P-bytes)
    _ → false
fresh-alts alts = case alts of lnil → true; lcons a r → andf (fresh (snd (snd a))) (fresh-alts r)
fresh-ralts alts = case alts of lnil → true; lcons a r → andf (fresh (snd (snd (snd a)))) (fresh-ralts r)
-- set u = 1 on the update whose base is variable v
set-ip v t =
  case t of
    fupd u dd x c k w → (case x of fvar m → (if %weq m v then fupd #1 dd x c k w else fupd u dd x c k (set-ip v w)); _ → fupd u dd (set-ip v x) c k (set-ip v w))
    fswitch x alts → fswitch (set-ip v x) (set-ip-alts v alts)
    frec d x alts → frec d (set-ip v x) (set-ip-ralts v alts)
    fproj d c k x → fproj d c k (set-ip v x)
    fcall g args → fcall g (set-ip-list v args)
    fprim p args → (if store-any p then (case args of
                                            lcons x rest → (case x of
                                                              fvar m → (if %weq m v then fprim (ip-p p) args else fprim p (set-ip-list v args))
                                                              _ → fprim p (set-ip-list v args))
                                            lnil → t)
                     else fprim p (set-ip-list v args))
    flet a b → flet (set-ip v a) (set-ip (%wsucc v) b)
    fif c a b → fif (set-ip v c) (set-ip v a) (set-ip v b)
    fcon d c fs → fcon d c (set-ip-list v fs)
    fapply f args → fapply (set-ip v f) (set-ip-list v args)
    fforce x → fforce (set-ip v x)
    fassume f b → fassume f (set-ip v b)
    _ → t
set-ip-list v l = case l of lnil → lnil; lcons x xs → lcons (set-ip v x) (set-ip-list v xs)
set-ip-alts v alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , set-ip (%wadd v (fst (snd a))) (snd (snd a)))) (set-ip-alts v r)
set-ip-ralts v alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , set-ip (%wadd v (%wadd (fst (snd a)) (lst-len2 (fst (snd (snd a)))))) (snd (snd (snd a)))))) (set-ip-ralts v r)
-- does every continue of a loop body pass a fresh value in state slot i (slot i is field i of
-- the continue constructor, tag 0 of type 0; a break passes nothing)
cont-fresh i body =
  case body of
    fcon d c fs → if %weq c #0 then fresh (lst-nth-fo fs i) else true
    fif c a b → andf (cont-fresh i a) (cont-fresh i b)
    flet a b → cont-fresh i b
    fswitch x alts → cont-fresh-alts i alts
    frec d x alts → cont-fresh-ralts i alts
    fassume f b → cont-fresh i b
    _ → false
cont-fresh-alts i alts = case alts of lnil → true; lcons a r → andf (cont-fresh i (snd (snd a))) (cont-fresh-alts i r)
cont-fresh-ralts i alts = case alts of lnil → true; lcons a r → andf (cont-fresh i (snd (snd (snd a)))) (cont-fresh-ralts i r)
lst-nth-fo l n = case l of lnil → flit #0; lcons x xs → if %weq n #0 then x else lst-nth-fo xs (%wsub n #1)
-- mark-uniq: every update of a fresh base stores in place; a let whose value is fresh and whose
-- body uses it safely marks its update; a loop state slot initialized fresh, continued fresh and
-- used safely in the body likewise
mark-uniq t =
  case t of
    fupd u dd x c k v → fupd (if fresh x then #1 else u) dd (mark-uniq x) c k (mark-uniq v)
    flet a b → (let b2 = mark-uniq b in flet (mark-uniq a) (if andf (fresh a) (%weq (safe #0 b2) #2) then set-ip #0 b2 else b2))
    floop init body → floop (mark-list init) (mark-slots (lst-len2 init) init #0 (mark-uniq body))
    fswitch x alts → fswitch (mark-uniq x) (mark-alts alts)
    frec d x alts → frec d (mark-uniq x) (mark-ralts alts)
    fproj d c k x → fproj d c k (mark-uniq x)
    fcall g args → fcall g (mark-list args)
    fprim p args → (case args of
                      lcons x rest → fprim (if andf (store-any p) (fresh x) then ip-p p else p) (mark-list args)
                      lnil → t)
    fif c a b → fif (mark-uniq c) (mark-uniq a) (mark-uniq b)
    fcon d c fs → fcon d c (mark-list fs)
    fclos g env → fclos g (mark-list env)
    flam b → flam (mark-uniq b)
    fapply f args → fapply (mark-uniq f) (mark-list args)
    fthunk a → fthunk (mark-uniq a)
    fforce x → fforce (mark-uniq x)
    fnet g args → fnet g (mark-list args)
    fassume f b → fassume f (mark-uniq b)
    _ → t
mark-slots k init i body =
  case init of
    lnil → body
    lcons x xs → mark-slots k xs (%wsucc i) (if andf (fresh x) (andf (cont-fresh i body) (%weq (safe (%wsub (%wsub k #1) i) body) #2)) then set-ip (%wsub (%wsub k #1) i) body else body)
mark-list l = case l of lnil → lnil; lcons x xs → lcons (mark-uniq x) (mark-list xs)
mark-alts alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , mark-uniq (snd (snd a)))) (mark-alts r)
mark-ralts alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , mark-uniq (snd (snd (snd a)))))) (mark-ralts r)
-- the pass the pipeline runs after lowering
inplace t = mark-uniq (reuse-cons t)
-- ---- readings. A rebuild of a pair with its first field kept is an update of the pair
pr-upd = fcon #0 #0 (lcons (fproj #0 #0 #0 (fvar #0)) (lcons (flit #9) lnil))
#same reuse-cons pr-upd = fupd #0 #0 (fvar #0) #0 #1 (flit #9)
-- and evaluates to the pair with the field replaced
#same eval-fo no-defs (lcons (vcon #0 #0 (lcons (vw #1) (lcons (vw #2) lnil))) lnil) (reuse-cons pr-upd) = vcon #0 #0 (lcons (vw #1) (lcons (vw #9) lnil))
-- a let-bound pair updated once, its old field read in the new value: unique, so in place
let-upd = flet (fcon #0 #0 (lcons (flit #1) (lcons (flit #2) lnil))) (fcon #0 #0 (lcons (fproj #0 #0 #0 (fvar #0)) (lcons (fprim P-add (lcons (fproj #0 #0 #1 (fvar #0)) (lcons (flit #40) lnil))) lnil)))
#same inplace let-upd = flet (fcon #0 #0 (lcons (flit #1) (lcons (flit #2) lnil))) (fupd #1 #0 (fvar #0) #0 #1 (fprim P-add (lcons (fproj #0 #0 #1 (fvar #0)) (lcons (flit #40) lnil))))
#same eval-fo no-defs lnil (inplace let-upd) = vcon #0 #0 (lcons (vw #1) (lcons (vw #42) lnil))
-- the same pair also read beside the update (unsequenced): a copy
let-upd2 = flet (fcon #0 #0 (lcons (flit #1) (lcons (flit #2) lnil))) (fcon #0 #0 (lcons (fproj #0 #0 #0 (fvar #0)) (lcons (fcon #0 #0 (lcons (fproj #0 #0 #0 (fvar #0)) (lcons (flit #9) lnil))) lnil)))
#same inplace let-upd2 = flet (fcon #0 #0 (lcons (flit #1) (lcons (flit #2) lnil))) (fupd #0 #0 (fvar #0) #0 #1 (fupd #0 #0 (fvar #0) #0 #1 (flit #9)))
-- a parameter updated (the base is not fresh): a copy; a recursion's alternative rebuilding its
-- constructor with one field changed is the update of the scrutinee (no hypotheses here)
rec-upd = frec #12 (fvar #0) (lcons (#0 , (#2 , (lnil , fcon #12 #0 (lcons (fvar #1) (lcons (fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil))) lnil))))) lnil)
#same inplace rec-upd = frec #12 (fvar #0) (lcons (#0 , (#2 , (lnil , fupd #0 #12 (fvar #2) #0 #1 (fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)))))) lnil)
#same eval-fo no-defs (lcons (vcon #12 #0 (lcons (vw #5) (lcons (vw #6) lnil))) lnil) (inplace rec-upd) = vcon #12 #0 (lcons (vw #5) (lcons (vw #7) lnil))
-- a loop over a fresh record, updated each iteration: in place
loop-upd = floop (lcons (flit #3) (lcons (fcon #7712 #0 (lcons (flit #0) (lcons (flit #10) lnil))) lnil))
  (fif (fprim P-lt (lcons (flit #0) (lcons (fvar #1) lnil)))
     (fcon #0 #0 (lcons (fprim P-sub (lcons (fvar #1) (lcons (flit #1) lnil))) (lcons (frec #7712 (fvar #0) (lcons (#0 , (#2 , (lnil , fcon #7712 #0 (lcons (fvar #1) (lcons (fprim P-add (lcons (fvar #0) (lcons (fvar #3) lnil))) lnil))))) lnil)) lnil)))
     (fcon #0 #1 (lcons (fvar #0) lnil)))
#same (case inplace loop-upd of floop i b → (case b of fif c a e → (case a of fcon d k st → (case lst-nth-fo st #1 of frec dd x alts → (case alts of lcons al r → (case snd (snd (snd al)) of fupd u dd y c k v → u; _ → #9); _ → #9); _ → #9); _ → #9); _ → #9); _ → #9) = #1
#same eval-fo no-defs lnil (inplace loop-upd) = vcon #7712 #0 (lcons (vw #0) (lcons (vw #16) lnil))
-- the byte layer (C21 on buffers, item 22's arrays): a store into a fresh buffer, or into a
-- let-bound one whose other uses are reads before it, stores in place; into a parameter, or beside
-- an unsequenced read, it copies
st-fresh = fprim P-store64 (lcons (fprim P-bytes (lcons (flit #16) lnil)) (lcons (flit #8) (lcons (fi64 #9) lnil)))
#same inplace st-fresh = fprim P-store64-ip (lcons (fprim P-bytes (lcons (flit #16) lnil)) (lcons (flit #8) (lcons (fi64 #9) lnil)))
st-let = flet (fprim P-bytes (lcons (flit #16) lnil)) (fprim P-store64 (lcons (fvar #0) (lcons (flit #8) (lcons (fprim P-load64 (lcons (fvar #0) (lcons (flit #0) lnil))) lnil))))
#same inplace st-let = flet (fprim P-bytes (lcons (flit #16) lnil)) (fprim P-store64-ip (lcons (fvar #0) (lcons (flit #8) (lcons (fprim P-load64 (lcons (fvar #0) (lcons (flit #0) lnil))) lnil))))
st-par = fprim P-store64 (lcons (fvar #0) (lcons (flit #8) (lcons (fi64 #9) lnil)))
#same inplace st-par = st-par
st-beside = flet (fprim P-bytes (lcons (flit #16) lnil)) (fprim P-add (lcons (fprim P-wofi64 (lcons (fprim P-load64 (lcons (fprim P-store64 (lcons (fvar #0) (lcons (flit #8) (lcons (fi64 #9) lnil)))) (lcons (flit #8) lnil))) lnil)) (lcons (fprim P-wofi64 (lcons (fprim P-load64 (lcons (fvar #0) (lcons (flit #8) lnil))) lnil)) lnil)))
#same inplace st-beside = st-beside
-- a loop filling an 8-word buffer, the buffer its own state: each iteration's store in place; the
-- value is unchanged (slot k holds k; 7 + 3 read back)
loop-buf = flet (floop (lcons (flit #8) (lcons (fprim P-bytes (lcons (flit #64) lnil)) lnil))
    (fif (fprim P-lt (lcons (flit #0) (lcons (fvar #1) lnil)))
       (fcon #0 #0 (lcons (fprim P-sub (lcons (fvar #1) (lcons (flit #1) lnil))) (lcons (fprim P-store64 (lcons (fvar #0) (lcons (fprim P-mul (lcons (fprim P-sub (lcons (fvar #1) (lcons (flit #1) lnil))) (lcons (flit #8) lnil))) (lcons (fprim P-i64ofw (lcons (fprim P-sub (lcons (fvar #1) (lcons (flit #1) lnil))) lnil)) lnil)))) lnil)))
       (fcon #0 #1 (lcons (fvar #0) lnil))))
  (fprim P-add (lcons (fprim P-wofi64 (lcons (fprim P-load64 (lcons (fvar #0) (lcons (flit #56) lnil))) lnil)) (lcons (fprim P-wofi64 (lcons (fprim P-load64 (lcons (fvar #0) (lcons (flit #24) lnil))) lnil)) lnil)))
#same (case inplace loop-buf of flet l b → (case l of floop i body → (case body of fif c a e → (case a of fcon d k st → (case lst-nth-fo st #1 of fprim p as → p; _ → #99); _ → #99); _ → #99); _ → #99); _ → #99) = P-store64-ip
#same eval-fo no-defs lnil (inplace loop-buf) = vw #10
#same eval-fo no-defs lnil loop-buf = vw #10
-- with hypotheses the rebuild stays a constructor: the alternative runs again on the tail, where
-- the scrutinee variable is the whole list. The identity on a list, rebuilt node by node
rec-id = frec #7 (fvar #0) (lcons (#0 , (#0 , (lnil , fcon #7 #0 lnil))) (lcons (#1 , (#2 , (lcons #1 lnil , fcon #7 #1 (lcons (fvar #2) (lcons (fforce (fvar #0)) lnil))))) lnil))
#same inplace rec-id = rec-id
#same eval-fo no-defs (lcons (eval-fo no-defs lnil l3) lnil) (inplace rec-id) = eval-fo no-defs lnil l3
-- a lifted recursion computes a hypothesis where it is read: the head of a list does not walk
-- it (the hypothesis is dropped), the length reads it once (the call is in place of the let)
head-fo = frec #7 (fvar #0) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lcons #1 lnil , fvar #2))) lnil))
#same (case lift #1 (flam head-fo) of lifted t2 ds k → (case ds of lcons d r → snd (snd d); lnil → flit #0)) = frec #7 (fvar #0) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lnil , fvar #1))) lnil))
#same (case lift #1 (flam fo-len) of lifted t2 ds k → (case ds of lcons d r → snd (snd d); lnil → flit #0)) = frec #7 (fvar #0) (lcons (#0 , (#0 , (lnil , flit #0))) (lcons (#1 , (#2 , (lnil , fprim P-add (lcons (fforce (fcall #1 (lcons (fvar #0) lnil))) (lcons (flit #1) lnil))))) lnil))
