-- Layer: capacity demonstrated and mentioned in the paper: a metacircular extension on the unchanged core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/capacities/rewrite.cub — first-order matching and rewriting over codes, with types (2026-11-15):
-- lib/bootstrap/match.cub's functions written as checked definitions, so the traversal of codes and
-- rewriting by rules are no longer trusted primitives (lib/bootstrap/exposed.cub's code-map,
-- code-shift, code-unshift, rule-rewrite and rules-orient are defined here) and the untyped files leave
-- the core's load order. A function over a code recurses through its lists of codes by the nested
-- field's hypothesis (rec ks, the tuple of the recursive results at the list's elements, %iht-Lst);
-- recursion on a word is %welimP. The design is match.cub's (PLAN.md revision 7.9, 6 Nov 2026, git
-- 2ca8d747aaa5:PLAN.md, §18.6 “B15 — The specializer” step 3 “Rewrite”, §18.14 “F33 — Navigation”):
-- a pattern is a code whose variables above a bound are metavariables; matching binds them; a rule is
-- an identity read left to right, justified by a theorem of the store or not at all.
import "codes.cub"
-- ---------------------------------------------------------------- options
orelse : {A : Type} → Opt A → Opt A → Opt A
orelse (some x) o = some x
orelse none o = o
omap2 : {A B C D : Type} → (A → C) → (B → D) → Opt (A × B) → Opt (C × D)
omap2 f g none = none
omap2 f g (some p) = some (f (fst p) , g (snd p))
-- ---------------------------------------------------------------- the traversal of codes
-- cmap-r f c d: c with each part p at binder depth d replaced by f p d where f gives one, every
-- constructor of Code with parts traversed (the leaves have no variables)
cmap-l : (f : Code → Word → Opt Code) (ks : Lst Code) → %iht-Lst lzero Code (λ _ → Word → Code) ks → Word → Lst Code
cmap-l f lnil h d = lnil
cmap-l f (lcons k r) h d = lcons (fst h d) (cmap-l f r (fst (snd h)) d)
cmap-o : (f : Code → Word → Opt Code) (mo : Opt Code) → %iht-Opt lzero Code (λ _ → Word → Code) mo → Word → Opt Code
cmap-o f none h d = none
cmap-o f (some x) h d = some (fst h d)
cmap-r : (Code → Word → Opt Code) → Code → Word → Code
cmap-r f (clam b) d = opt-or (f (clam b) d) (clam (cmap-r f b (%wsucc d)))
cmap-r f (capp a b) d = opt-or (f (capp a b) d) (capp (cmap-r f a d) (cmap-r f b d))
cmap-r f (cpair a b) d = opt-or (f (cpair a b) d) (cpair (cmap-r f a d) (cmap-r f b d))
cmap-r f (cfst p) d = opt-or (f (cfst p) d) (cfst (cmap-r f p d))
cmap-r f (csnd p) d = opt-or (f (csnd p) d) (csnd (cmap-r f p d))
cmap-r f (cpi m A B) d = opt-or (f (cpi m A B) d) (cpi m (cmap-r f A d) (cmap-r f B (%wsucc d)))
cmap-r f (csigma A B) d = opt-or (f (csigma A B) d) (csigma (cmap-r f A d) (cmap-r f B (%wsucc d)))
cmap-r f (cuniv l) d = opt-or (f (cuniv l) d) (cuniv (cmap-r f l d))
cmap-r f (cpathp A a b) d = opt-or (f (cpathp A a b) d) (cpathp (cmap-r f A d) (cmap-r f a d) (cmap-r f b d))
cmap-r f (cplam b) d = opt-or (f (cplam b) d) (cplam (cmap-r f b (%wsucc d)))
cmap-r f (cpapp p r) d = opt-or (f (cpapp p r) d) (cpapp (cmap-r f p d) (cmap-r f r d))
cmap-r f (cneg r) d = opt-or (f (cneg r) d) (cneg (cmap-r f r d))
cmap-r f (cmeet r s) d = opt-or (f (cmeet r s) d) (cmeet (cmap-r f r d) (cmap-r f s d))
cmap-r f (cjoin r s) d = opt-or (f (cjoin r s) d) (cjoin (cmap-r f r d) (cmap-r f s d))
cmap-r f (ceq0 r) d = opt-or (f (ceq0 r) d) (ceq0 (cmap-r f r d))
cmap-r f (ceq1 r) d = opt-or (f (ceq1 r) d) (ceq1 (cmap-r f r d))
cmap-r f (cfand a b) d = opt-or (f (cfand a b) d) (cfand (cmap-r f a d) (cmap-r f b d))
cmap-r f (cfor a b) d = opt-or (f (cfor a b) d) (cfor (cmap-r f a d) (cmap-r f b d))
cmap-r f (cforall b) d = opt-or (f (cforall b) d) (cforall (cmap-r f b (%wsucc d)))
cmap-r f (csysc a t r) d = opt-or (f (csysc a t r) d) (csysc (cmap-r f a d) (cmap-r f t d) (cmap-r f r d))
cmap-r f (ccomp A u a) d = opt-or (f (ccomp A u a) d) (ccomp (cmap-r f A d) (cmap-r f u d) (cmap-r f a d))
cmap-r f (cgluet A S) d = opt-or (f (cgluet A S) d) (cgluet (cmap-r f A d) (cmap-r f S d))
cmap-r f (cglue S a) d = opt-or (f (cglue S a) d) (cglue (cmap-r f S d) (cmap-r f a d))
cmap-r f (cunglue S b) d = opt-or (f (cunglue S b) d) (cunglue (cmap-r f S d) (cmap-r f b d))
cmap-r f (chcompu A S) d = opt-or (f (chcompu A S) d) (chcompu (cmap-r f A d) (cmap-r f S d))
cmap-r f (cunglueu S b) d = opt-or (f (cunglueu S b) d) (cunglueu (cmap-r f S d) (cmap-r f b d))
cmap-r f (clet t b) d = opt-or (f (clet t b) d) (clet (cmap-r f t d) (cmap-r f b (%wsucc d)))
cmap-r f (cann t T) d = opt-or (f (cann t T) d) (cann (cmap-r f t d) (cmap-r f T d))
cmap-r f (cdata dd ps) d = opt-or (f (cdata dd ps) d) (cdata dd (cmap-l f ps (rec ps) d))
cmap-r f (ccon dd k fs ds) d = opt-or (f (ccon dd k fs ds) d) (ccon dd k (cmap-l f fs (rec fs) d) (cmap-l f ds (rec ds) d))
cmap-r f (celim dd P B x) d = opt-or (f (celim dd P B x) d) (celim dd (cmap-r f P d) (cmap-l f B (rec B) d) (cmap-r f x d))
cmap-r f (ccase dd B x) d = opt-or (f (ccase dd B x) d) (ccase dd (cmap-l f B (rec B) d) (cmap-r f x d))
cmap-r f (chcomp u a) d = opt-or (f (chcomp u a) d) (chcomp (cmap-r f u d) (cmap-r f a d))
cmap-r f (cdlam b) d = opt-or (f (cdlam b) d) (cdlam (cmap-r f b (%wsucc d)))
cmap-r f (cforce t) d = opt-or (f (cforce t) d) (cforce (cmap-r f t d))
cmap-r f (cthunk t) d = opt-or (f (cthunk t) d) (cthunk (cmap-r f t d))
cmap-r f (clsuc l) d = opt-or (f (clsuc l) d) (clsuc (cmap-r f l d))
cmap-r f (clmax a b) d = opt-or (f (clmax a b) d) (clmax (cmap-r f a d) (cmap-r f b d))
cmap-r f (cpty k n) d = opt-or (f (cpty k n) d) (cpty k (cmap-r f n d))
cmap-r f (cwsucc a) d = opt-or (f (cwsucc a) d) (cwsucc (cmap-r f a d))
cmap-r f (cwop k a b) d = opt-or (f (cwop k a b) d) (cwop k (cmap-r f a d) (cmap-r f b d))
cmap-r f (cwelim w z s mo) d = opt-or (f (cwelim w z s mo) d) (cwelim (cmap-r f w d) (cmap-r f z d) (cmap-r f s d) (cmap-o f mo (rec mo) d))
cmap-r f (ctrans dd psi ls x) d = opt-or (f (ctrans dd psi ls x) d) (ctrans dd (cmap-r f psi d) (cmap-l f ls (rec ls) d) (cmap-r f x d))
cmap-r f (cproj dd k x) d = opt-or (f (cproj dd k x) d) (cproj dd k (cmap-r f x d))
cmap-r f (crec dd fs) d = opt-or (f (crec dd fs) d) (crec dd (cmap-l f fs (rec fs) d))
cmap-r f (ctick k) d = opt-or (f (ctick k) d) (ctick (cmap-r f k d))
cmap-r f (cprim k as) d = opt-or (f (cprim k as) d) (cprim k (cmap-l f as (rec as) d))
cmap-r f c d = opt-or (f c d) c
code-map : (Code → Word → Opt Code) → Word → Code → Code
code-map f d c = cmap-r f c d
-- shifting free variables at or above d up by k, and down by b (none below b present, checked)
shift-f : Word → Code → Word → Opt Code
shift-f k (cvar n) e = some (if %wlt n e then cvar n else cvar (%wadd n k))
shift-f k c e = none
code-shift : Word → Word → Code → Code
code-shift d k c = code-map (shift-f k) d c
unshift-f : Word → Code → Word → Opt Code
unshift-f b (cvar n) e = some (if %wlt n e then cvar n else cvar (%wsub n b))
unshift-f b c e = none
code-unshift : Word → Word → Code → Code
code-unshift d b c = code-map (unshift-f b) d c
-- ---------------------------------------------------------------- matches
data Match = mnil | mcons (m : Word) (c : Code) (rest : Match)
mlookup : Match → Word → Opt Code
mlookup mnil m = none
mlookup (mcons m2 c r) m = if %weq m m2 then some c else mlookup r m
-- structural equality of codes (the fragment matching covers)
cs-l : (ks : Lst Code) → %iht-Lst lzero Code (λ _ → Code → Bool) ks → Lst Code → Bool
cs-l lnil h lnil = true
cs-l lnil h (lcons y ys) = false
cs-l (lcons k r) h lnil = false
cs-l (lcons k r) h (lcons y ys) = c-and (fst h y) (cs-l r (fst (snd h)) ys)
code-same : Code → Code → Bool
code-same (cvar n) b = (case b of cvar m → %weq n m; _ → false)
code-same (cglob n) b = (case b of cglob m → %weq n m; _ → false)
code-same (clam x) b = (case b of clam y → code-same x y; _ → false)
code-same (capp f x) b = (case b of capp g y → c-and (code-same f g) (code-same x y); _ → false)
code-same (cpair x y) b = (case b of cpair x2 y2 → c-and (code-same x x2) (code-same y y2); _ → false)
code-same (cfst x) b = (case b of cfst y → code-same x y; _ → false)
code-same (csnd x) b = (case b of csnd y → code-same x y; _ → false)
code-same (clet t x) b = (case b of clet t2 y → c-and (code-same t t2) (code-same x y); _ → false)
code-same (ccon d c fs ds) b = (case b of ccon d2 c2 fs2 ds2 → c-and (%weq d d2) (c-and (%weq c c2) (c-and (cs-l fs (rec fs) fs2) (cs-l ds (rec ds) ds2))); _ → false)
code-same (ccase d B x) b = (case b of ccase d2 B2 y → c-and (%weq d d2) (c-and (cs-l B (rec B) B2) (code-same x y)); _ → false)
code-same (celim d P B x) b = (case b of celim d2 P2 B2 y → c-and (%weq d d2) (c-and (code-same P P2) (c-and (cs-l B (rec B) B2) (code-same x y))); _ → false)
code-same (cforce x) b = (case b of cforce y → code-same x y; _ → false)
code-same (cthunk x) b = (case b of cthunk y → code-same x y; _ → false)
code-same (cdata d ps) b = (case b of cdata d2 ps2 → c-and (%weq d d2) (cs-l ps (rec ps) ps2); _ → false)
code-same (cwlit n) b = (case b of cwlit m → %weq n m; _ → false)
code-same (cwsucc x) b = (case b of cwsucc y → code-same x y; _ → false)
code-same (cwop o x y) b = (case b of cwop o2 x2 y2 → c-and (%weq o o2) (c-and (code-same x x2) (code-same y y2)); _ → false)
code-same (cwelim w z s mo) b = (case b of cwelim w2 z2 s2 mo2 → c-and (code-same w w2) (c-and (code-same z z2) (code-same s s2)); _ → false)
code-same (cann t T) b = (case b of cann t2 T2 → code-same t t2; _ → false)
code-same (cpi m x y) b = (case b of cpi m2 x2 y2 → c-and (%weq m m2) (c-and (code-same x x2) (code-same y y2)); _ → false)
code-same (csigma x y) b = (case b of csigma x2 y2 → c-and (code-same x x2) (code-same y y2); _ → false)
code-same (cuniv l) b = (case b of cuniv l2 → code-same l l2; _ → false)
code-same (cword) b = (case b of cword → true; _ → false)
code-same (cpty k n) b = (case b of cpty k2 n2 → c-and (%weq k k2) (code-same n n2); _ → false)
code-same (cplit k x) b = (case b of cplit k2 x2 → c-and (%weq k k2) (%weq x x2); _ → false)
code-same (cprim k as) b = (case b of cprim k2 as2 → c-and (%weq k k2) (cs-l as (rec as) as2); _ → false)
code-same (clzero) b = (case b of clzero → true; _ → false)
code-same (clsuc l) b = (case b of clsuc l2 → code-same l l2; _ → false)
code-same (clmax x y) b = (case b of clmax x2 y2 → c-and (code-same x x2) (code-same y y2); _ → false)
code-same a b = false
-- does t mention a variable in [d, d + b)?
ment-l : (l : Lst Code) → %iht-Lst lzero Code (λ _ → Word → Bool) l → Word → Word → Bool
ment-l lnil h d b = false
ment-l (lcons x xs) h d b = c-or (fst h d) (ment-l xs (fst (snd h)) d b)
ment-o : (mo : Opt Code) → %iht-Opt lzero Code (λ _ → Word → Bool) mo → Word → Word → Bool
ment-o none h d b = false
ment-o (some x) h d b = fst h d
ment : Code → Word → Word → Bool
ment (cvar n) d b = c-and (c-not (%wlt n d)) (%wlt n (%wadd d b))
ment (clam x) d b = ment x (%wsucc d) b
ment (capp f x) d b = c-or (ment f d b) (ment x d b)
ment (cpair x y) d b = c-or (ment x d b) (ment y d b)
ment (cfst x) d b = ment x d b
ment (csnd x) d b = ment x d b
ment (clet a x) d b = c-or (ment a d b) (ment x (%wsucc d) b)
ment (ccon dd c fs ds) d b = ment-l fs (rec fs) d b
ment (ccase dd B x) d b = c-or (ment-l B (rec B) d b) (ment x d b)
ment (celim dd P B x) d b = c-or (ment P d b) (c-or (ment-l B (rec B) d b) (ment x d b))
ment (cforce x) d b = ment x d b
ment (cthunk x) d b = ment x d b
ment (cdata dd ps) d b = ment-l ps (rec ps) d b
ment (cwsucc x) d b = ment x d b
ment (cwop o x y) d b = c-or (ment x d b) (ment y d b)
ment (cwelim w z s mo) d b = c-or (ment w d b) (c-or (ment z d b) (c-or (ment s d b) (ment-o mo (rec mo) d b)))
ment (cann a T) d b = ment a d b
ment (cpty q n) d b = ment n d b
ment (cprim q as) d b = ment-l as (rec as) d b
ment (cpi m x y) d b = c-or (ment x d b) (ment y (%wsucc d) b)
ment (csigma x y) d b = c-or (ment x d b) (ment y (%wsucc d) b)
ment t d b = false
mentions-below : Word → Code → Bool
mentions-below b t = if %weq b #0 then false else ment t #0 b
unshift : Word → Code → Code
unshift b t = code-unshift #0 b t
-- ---------------------------------------------------------------- matching
-- mt k p b t s: pattern p (k pattern-bound variables, above which are metavariables), under b binders
-- inside the pattern so far, against t, s the match so far; none on failure
mt-l : (k : Word) (ps : Lst Code) → %iht-Lst lzero Code (λ _ → Word → Code → Match → Opt Match) ps → Word → Lst Code → Match → Opt Match
mt-l k lnil h b lnil s = some s
mt-l k lnil h b (lcons t tr) s = none
mt-l k (lcons p pr) h b lnil s = none
mt-l k (lcons p pr) h b (lcons t tr) s = case fst h b t s of some s2 → mt-l k pr (fst (snd h)) b tr s2; none → none
mt : Word → Code → Word → Code → Match → Opt Match
mt k (cvar n) b t s = if %wlt n (%wadd k b) then (case t of cvar m → if %weq n m then some s else none; _ → none) else (let m = %wsub n (%wadd k b) in if mentions-below b t then none else (case mlookup s m of none → some (mcons m (unshift b t) s); some c → if code-same c (unshift b t) then some s else none))
mt k (cglob n) b t s = (case t of cglob m → if %weq n m then some s else none; _ → none)
mt k (clam x) b t s = (case t of clam y → mt k x (%wsucc b) y s; _ → none)
mt k (capp f x) b t s = (case t of capp g y → (case mt k f b g s of some s2 → mt k x b y s2; none → none); _ → none)
mt k (cpair x y) b t s = (case t of cpair x2 y2 → (case mt k x b x2 s of some s2 → mt k y b y2 s2; none → none); _ → none)
mt k (cfst x) b t s = (case t of cfst y → mt k x b y s; _ → none)
mt k (csnd x) b t s = (case t of csnd y → mt k x b y s; _ → none)
mt k (clet a x) b t s = (case t of clet a2 y → (case mt k a b a2 s of some s2 → mt k x (%wsucc b) y s2; none → none); _ → none)
mt k (ccon d c fs ds) b t s = (case t of ccon d2 c2 fs2 ds2 → if c-and (%weq d d2) (%weq c c2) then mt-l k fs (rec fs) b fs2 s else none; _ → none)
mt k (celim d P B x) b t s = (case t of celim d2 P2 B2 y → if %weq d d2 then (case mt k P b P2 s of some s2 → (case mt-l k B (rec B) b B2 s2 of some s3 → mt k x b y s3; none → none); none → none) else none; _ → none)
mt k (ccase d B x) b t s = (case t of ccase d2 B2 y → if %weq d d2 then (case mt-l k B (rec B) b B2 s of some s2 → mt k x b y s2; none → none) else none; _ → none)
mt k (cforce x) b t s = (case t of cforce y → mt k x b y s; _ → none)
mt k (cthunk x) b t s = (case t of cthunk y → mt k x b y s; _ → none)
mt k (cdata d ps) b t s = (case t of cdata d2 ps2 → if %weq d d2 then mt-l k ps (rec ps) b ps2 s else none; _ → none)
mt k (cwlit n) b t s = (case t of cwlit m → if %weq n m then some s else none; _ → none)
mt k (cwelim w z st mo) b t s = (case t of cwelim w2 z2 st2 mo2 → (case mt k w b w2 s of some s2 → (case mt k z b z2 s2 of some s3 → mt k st b st2 s3; none → none); none → none); _ → none)
mt k (cwsucc x) b t s = (case t of cwsucc y → mt k x b y s; _ → none)
mt k (cwop o x y) b t s = (case t of cwop o2 x2 y2 → if %weq o o2 then (case mt k x b x2 s of some s2 → mt k y b y2 s2; none → none) else none; _ → none)
mt k (cann a T) b t s = mt k a b t s
mt k (cword) b t s = (case t of cword → some s; _ → none)
mt k (cpty q n) b t s = (case t of cpty q2 n2 → if %weq q q2 then mt k n b n2 s else none; _ → none)
mt k (cplit q x) b t s = (case t of cplit q2 x2 → if c-and (%weq q q2) (%weq x x2) then some s else none; _ → none)
mt k (cprim q as) b t s = (case t of cprim q2 as2 → if %weq q q2 then mt-l k as (rec as) b as2 s else none; _ → none)
mt k (cpi m x y) b t s = (case t of cpi m2 x2 y2 → if %weq m m2 then (case mt k x b x2 s of some s2 → mt k y (%wsucc b) y2 s2; none → none) else none; _ → none)
mt k (csigma x y) b t s = (case t of csigma x2 y2 → (case mt k x b x2 s of some s2 → mt k y (%wsucc b) y2 s2; none → none); _ → none)
mt k p b t s = none
-- ---------------------------------------------------------------- instantiation
inst-f : Word → Match → Code → Word → Opt Code
inst-f k s (cvar n) e =
  if %wlt n (%wadd k e) then some (cvar n)
  else (case mlookup s (%wsub n (%wadd k e)) of some c → some (code-shift #0 e c); none → some (cvar n))
inst-f k s q e = none
inst : Word → Word → Match → Code → Code
inst k b s p = code-map (inst-f k s) b p
-- ---------------------------------------------------------------- rules
data Just = nojust | thm (g : Word) (n : Word) (rev : Bool)
data Rule = rule (k : Word) (lhs : Code) (rhs : Code) (just : Just)
rewrite-root : Rule → Code → Opt Code
rewrite-root (rule k l rh j) t = case mt k l #0 t mnil of some s → some (inst k #0 s rh); none → none
-- the theorem g applied to its n variables' instances: x_1 is metavariable n−1, x_n is 0
thm-app : Word → Word → Match → Code
thm-app g n s = %welimP (λ _ → Code → Code) n (λ acc → acc) (λ m h acc → h (capp acc (opt-or (mlookup s m) (cwlit #0)))) (cglob g)
-- the rewrite at the root with its justifying path's code (the root under d binders; the dimension is
-- cvar d), none for a hand-written rule
rewrite-root-path : Word → Rule → Code → Opt (Code × Code)
rewrite-root-path d (rule k l rh nojust) t = none
rewrite-root-path d (rule k l rh (thm g n rev)) t =
  case mt k l #0 t mnil of
    some s → some (inst k #0 s rh , cpapp (code-shift d #1 (thm-app g n s)) (if rev then cneg (cvar d) else cvar d))
    none → none
sh1 : Word → Code → Code
sh1 d c = code-shift d #1 c
sh1-list : Word → Lst Code → Lst Code
sh1-list d lnil = lnil
sh1-list d (lcons x xs) = lcons (sh1 d x) (sh1-list d xs)
-- the first position in pre-order where the rule applies, rewritten, with the path's body
rfp-l : (r : Rule) (l : Lst Code) → %iht-Lst lzero Code (λ _ → Word → Opt (Code × Code)) l → Word → Opt (Lst Code × Lst Code)
rfp-l r lnil h d = none
rfp-l r (lcons x xs) h d = case fst h d of some p → some (lcons (fst p) xs , lcons (snd p) (sh1-list d xs)); none → omap2 (lcons x) (lcons (sh1 d x)) (rfp-l r xs (fst (snd h)) d)
rfp : Rule → Code → Word → Opt (Code × Code)
rfp r (clam x) d = orelse (rewrite-root-path d r (clam x)) (omap2 clam clam (rfp r x (%wsucc d)))
rfp r (capp f a) d = orelse (rewrite-root-path d r (capp f a)) ((case rfp r f d of some p → some (capp (fst p) a , capp (snd p) (sh1 d a)); none → omap2 (capp f) (capp (sh1 d f)) (rfp r a d)))
rfp r (cpair a b) d = orelse (rewrite-root-path d r (cpair a b)) ((case rfp r a d of some p → some (cpair (fst p) b , cpair (snd p) (sh1 d b)); none → omap2 (cpair a) (cpair (sh1 d a)) (rfp r b d)))
rfp r (cfst x) d = orelse (rewrite-root-path d r (cfst x)) (omap2 cfst cfst (rfp r x d))
rfp r (csnd x) d = orelse (rewrite-root-path d r (csnd x)) (omap2 csnd csnd (rfp r x d))
rfp r (clet a x) d = orelse (rewrite-root-path d r (clet a x)) ((case rfp r a d of some p → some (clet (fst p) x , clet (snd p) (sh1 (%wsucc d) x)); none → omap2 (clet a) (clet (sh1 d a)) (rfp r x (%wsucc d))))
rfp r (ccon dd c fs ds) d = orelse (rewrite-root-path d r (ccon dd c fs ds)) (omap2 (λ fs2 → ccon dd c fs2 ds) (λ fs2 → ccon dd c fs2 (sh1-list d ds)) (rfp-l r fs (rec fs) d))
rfp r (ccase dd B x) d = orelse (rewrite-root-path d r (ccase dd B x)) ((case rfp r x d of some p → some (ccase dd B (fst p) , ccase dd (sh1-list d B) (snd p)); none → omap2 (λ B2 → ccase dd B2 x) (λ B2 → ccase dd B2 (sh1 d x)) (rfp-l r B (rec B) d)))
rfp r (celim dd P B x) d = orelse (rewrite-root-path d r (celim dd P B x)) ((case rfp r x d of some p → some (celim dd P B (fst p) , celim dd (sh1 d P) (sh1-list d B) (snd p)); none → omap2 (λ B2 → celim dd P B2 x) (λ B2 → celim dd (sh1 d P) B2 (sh1 d x)) (rfp-l r B (rec B) d)))
rfp r (cwop o a b) d = orelse (rewrite-root-path d r (cwop o a b)) ((case rfp r a d of some p → some (cwop o (fst p) b , cwop o (snd p) (sh1 d b)); none → omap2 (cwop o a) (cwop o (sh1 d a)) (rfp r b d)))
rfp r (cwsucc a) d = orelse (rewrite-root-path d r (cwsucc a)) (omap2 cwsucc cwsucc (rfp r a d))
rfp r (cwelim w z s mo) d = orelse (rewrite-root-path d r (cwelim w z s mo)) ((case rfp r w d of some p → some (cwelim (fst p) z s mo , cwelim (snd p) (sh1 d z) (sh1 d s) (opt-map (sh1 d) mo)); none → (case rfp r z d of some p → some (cwelim w (fst p) s mo , cwelim (sh1 d w) (snd p) (sh1 d s) (opt-map (sh1 d) mo)); none → omap2 (λ s2 → cwelim w z s2 mo) (λ s2 → cwelim (sh1 d w) (sh1 d z) s2 (opt-map (sh1 d) mo)) (rfp r s d))))
rfp r (cprim q as) d = orelse (rewrite-root-path d r (cprim q as)) (omap2 (cprim q) (cprim q) (rfp-l r as (rec as) d))
rfp r (cann a T) d = orelse (rewrite-root-path d r (cann a T)) (omap2 (λ a2 → cann a2 T) (λ a2 → cann a2 (sh1 d T)) (rfp r a d))
rfp r (cforce x) d = orelse (rewrite-root-path d r (cforce x)) (omap2 cforce cforce (rfp r x d))
rfp r (cthunk x) d = orelse (rewrite-root-path d r (cthunk x)) (omap2 cthunk cthunk (rfp r x d))
rfp r t d = rewrite-root-path d r t
rule-rewrite : Rule → Code → Opt (Code × Code)
rule-rewrite r c = case rfp r c #0 of none → none; some p → some (fst p , cplam (snd p))
-- the first position in pre-order where the rule applies, rewritten (no path)
rwf-l : (r : Rule) (l : Lst Code) → %iht-Lst lzero Code (λ _ → Opt Code) l → Opt (Lst Code)
rwf-l r lnil h = none
rwf-l r (lcons x xs) h = case fst h of some x2 → some (lcons x2 xs); none → opt-map (lcons x) (rwf-l r xs (fst (snd h)))
rwf : Rule → Code → Opt Code
rwf r (clam x) = orelse (rewrite-root r (clam x)) (opt-map clam (rwf r x))
rwf r (capp f a) = orelse (rewrite-root r (capp f a)) ((case rwf r f of some f2 → some (capp f2 a); none → opt-map (capp f) (rwf r a)))
rwf r (cpair a b) = orelse (rewrite-root r (cpair a b)) ((case rwf r a of some a2 → some (cpair a2 b); none → opt-map (cpair a) (rwf r b)))
rwf r (cfst p) = orelse (rewrite-root r (cfst p)) (opt-map cfst (rwf r p))
rwf r (csnd p) = orelse (rewrite-root r (csnd p)) (opt-map csnd (rwf r p))
rwf r (clet a b) = orelse (rewrite-root r (clet a b)) ((case rwf r a of some a2 → some (clet a2 b); none → opt-map (clet a) (rwf r b)))
rwf r (ccon d c fs ds) = orelse (rewrite-root r (ccon d c fs ds)) (opt-map (λ fs2 → ccon d c fs2 ds) (rwf-l r fs (rec fs)))
rwf r (ccase d B x) = orelse (rewrite-root r (ccase d B x)) ((case rwf r x of some x2 → some (ccase d B x2); none → opt-map (λ B2 → ccase d B2 x) (rwf-l r B (rec B))))
rwf r (celim d P B x) = orelse (rewrite-root r (celim d P B x)) ((case rwf r x of some x2 → some (celim d P B x2); none → (case rwf-l r B (rec B) of some B2 → some (celim d P B2 x); none → opt-map (λ P2 → celim d P2 B x) (rwf r P))))
rwf r (cforce x) = orelse (rewrite-root r (cforce x)) (opt-map cforce (rwf r x))
rwf r (cthunk x) = orelse (rewrite-root r (cthunk x)) (opt-map cthunk (rwf r x))
rwf r (cdata d ps) = orelse (rewrite-root r (cdata d ps)) (opt-map (cdata d) (rwf-l r ps (rec ps)))
rwf r (cwsucc a) = orelse (rewrite-root r (cwsucc a)) (opt-map cwsucc (rwf r a))
rwf r (cwelim w z st mo) = orelse (rewrite-root r (cwelim w z st mo)) ((case rwf r w of some w2 → some (cwelim w2 z st mo); none → (case rwf r z of some z2 → some (cwelim w z2 st mo); none → opt-map (λ st2 → cwelim w z st2 mo) (rwf r st))))
rwf r (cwop o a b) = orelse (rewrite-root r (cwop o a b)) ((case rwf r a of some a2 → some (cwop o a2 b); none → opt-map (cwop o a) (rwf r b)))
rwf r (cprim q as) = orelse (rewrite-root r (cprim q as)) (opt-map (cprim q) (rwf-l r as (rec as)))
rwf r t = rewrite-root r t
rewrite-first : Rule → Code → Opt Code
rewrite-first r t = rwf r t
-- ---------------------------------------------------------------- the terminating discipline
size-l : (l : Lst Code) → %iht-Lst lzero Code (λ _ → Word) l → Word
size-l lnil h = #0
size-l (lcons x xs) h = %wadd (fst h) (size-l xs (fst (snd h)))
code-size : Code → Word
code-size (clam x) = %wsucc (code-size x)
code-size (capp f a) = %wsucc (%wadd (code-size f) (code-size a))
code-size (cpair a b) = %wsucc (%wadd (code-size a) (code-size b))
code-size (cfst p) = %wsucc (code-size p)
code-size (csnd p) = %wsucc (code-size p)
code-size (clet a b) = %wsucc (%wadd (code-size a) (code-size b))
code-size (ccon d k fs ds) = %wsucc (%wadd (size-l fs (rec fs)) (size-l ds (rec ds)))
code-size (ccase d B x) = %wsucc (%wadd (size-l B (rec B)) (code-size x))
code-size (celim d P B x) = %wsucc (%wadd (code-size P) (%wadd (size-l B (rec B)) (code-size x)))
code-size (cforce x) = %wsucc (code-size x)
code-size (cthunk x) = %wsucc (code-size x)
code-size (cdata d ps) = %wsucc (size-l ps (rec ps))
code-size (cwsucc a) = %wsucc (code-size a)
code-size (cwop o a b) = %wsucc (%wadd (code-size a) (code-size b))
code-size (cwelim w z s mo) = %wsucc (%wadd (code-size w) (%wadd (code-size z) (code-size s)))
code-size (cann a T) = %wsucc (%wadd (code-size a) (code-size T))
code-size (cpi m A B) = %wsucc (%wadd (code-size A) (code-size B))
code-size (csigma A B) = %wsucc (%wadd (code-size A) (code-size B))
code-size (cprim k as) = %wsucc (size-l as (rec as))
code-size c = #1
mvc-l : (m : Word) (l : Lst Code) → %iht-Lst lzero Code (λ _ → Word → Word) l → Word → Word
mvc-l m lnil h d = #0
mvc-l m (lcons x xs) h d = %wadd (fst h d) (mvc-l m xs (fst (snd h)) d)
mvc : Word → Code → Word → Word
mvc m (cvar n) d = if %weq n (%wadd m d) then #1 else #0
mvc m (clam x) d = mvc m x (%wsucc d)
mvc m (capp f a) d = %wadd (mvc m f d) (mvc m a d)
mvc m (cpair a b) d = %wadd (mvc m a d) (mvc m b d)
mvc m (cfst p) d = mvc m p d
mvc m (csnd p) d = mvc m p d
mvc m (clet a b) d = %wadd (mvc m a d) (mvc m b (%wsucc d))
mvc m (ccon dd k fs ds) d = %wadd (mvc-l m fs (rec fs) d) (mvc-l m ds (rec ds) d)
mvc m (ccase dd B x) d = %wadd (mvc-l m B (rec B) d) (mvc m x d)
mvc m (celim dd P B x) d = %wadd (mvc m P d) (%wadd (mvc-l m B (rec B) d) (mvc m x d))
mvc m (cforce x) d = mvc m x d
mvc m (cthunk x) d = mvc m x d
mvc m (cdata dd ps) d = mvc-l m ps (rec ps) d
mvc m (cwsucc a) d = mvc m a d
mvc m (cwop o a b) d = %wadd (mvc m a d) (mvc m b d)
mvc m (cwelim w z s mo) d = %wadd (mvc m w d) (%wadd (mvc m z d) (mvc m s d))
mvc m (cann a T) d = %wadd (mvc m a d) (mvc m T d)
mvc m (cpi mm A B) d = %wadd (mvc m A d) (mvc m B (%wsucc d))
mvc m (csigma A B) d = %wadd (mvc m A d) (mvc m B (%wsucc d))
mvc m (cprim k as) d = mvc-l m as (rec as) d
mvc m c d = #0
-- every metavariable below k occurs on the left at least as often as on the right
mv-ok : Word → Code → Code → Bool
mv-ok k l rh = %welimP (λ _ → Bool) k true (λ m h → c-and h (c-not (%wlt (mvc m l #0) (mvc m rh #0))))
oriented : Rule → Bool
oriented (rule k l rh j) = c-and (%wlt (code-size rh) (code-size l)) (mv-ok k l rh)
orient-rules : Lst Rule → Lst Rule × Lst Rule
orient-rules lnil = (lnil , lnil)
orient-rules (lcons r rest) = if oriented r then (lcons r (fst (orient-rules rest)) , snd (orient-rules rest)) else (fst (orient-rules rest) , lcons r (snd (orient-rules rest)))
rules-orient : Lst Rule → Lst Rule × Lst Rule
rules-orient rs = orient-rules rs
