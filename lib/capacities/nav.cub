-- Layer: capacity demonstrated and mentioned in the paper: a metacircular extension on the unchanged core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/capacities/nav.cub — navigation over established identities and its cost model, with types
-- (2026-11-15): lib/bootstrap/nav.cub and lib/bootstrap/cost.cub written as checked definitions over
-- lib/capacities/rewrite.cub, so they leave the core's load order. The design is theirs (PLAN.md
-- revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.14 “F33 — Navigation: the concrete form”):
-- a view is a list of rules, each an identity read left to right; the available steps are every
-- rule that applies, each with its first rewrite; validity never enters the choice (every available
-- step is a transport along an identity in view); choice is by a score, the size of the result first,
-- and a purpose is a goal pattern, a step that makes the goal match taken first. Recursion on a
-- budget of steps is %welimP on the word.
import "rewrite.cub"
-- ---------------------------------------------------------------- available steps
data Stepv = stepv (r : Rule) (result : Code)
available : Lst Rule → Code → Lst Stepv
available lnil t = lnil
available (lcons r rest) t =
  case rewrite-first r t of
    some t2 → lcons (stepv r t2) (available rest t)
    none → available rest t
-- ---------------------------------------------------------------- choice
step-term : Stepv → Code
step-term (stepv r t) = t
-- the step whose result scores least under cost; among equals the first in view
best-by-from : (Code → Word) → Stepv → Lst Stepv → Stepv
best-by-from cost s lnil = s
best-by-from cost s (lcons s2 r2) =
  if %wlt (cost (step-term s2)) (cost (step-term s)) then best-by-from cost s2 r2 else best-by-from cost s r2
best-by : (Code → Word) → Lst Stepv → Opt Stepv
best-by cost lnil = none
best-by cost (lcons s rest) = some (best-by-from cost s rest)
best : Lst Stepv → Opt Stepv
best steps = best-by code-size steps
-- a purpose: a goal pattern; a step whose result the goal matches at the root is taken over any other
reaches : Code → Code → Bool
reaches goal t = case mt #0 goal #0 t mnil of some s → true; none → false
first-reaching : Code → Lst Stepv → Opt Stepv
first-reaching goal lnil = none
first-reaching goal (lcons s rest) = if reaches goal (step-term s) then some s else first-reaching goal rest
choose-by : (Code → Word) → Code → Lst Stepv → Opt Stepv
choose-by cost goal steps = orelse (first-reaching goal steps) (best-by cost steps)
choose : Code → Lst Stepv → Opt Stepv
choose goal steps = choose-by code-size goal steps
-- ---------------------------------------------------------------- navigation
-- navigate-by cost n goal view t: up to n steps, stopping when the goal matches or nothing applies;
-- the result and the number of steps taken. Every intermediate term equals t by the composite of
-- the rules' identities (each a path in the store); the composite is the trace
data Navr = navr (result : Code) (steps : Word)
navr-succ : Navr → Navr
navr-succ (navr t k) = navr t (%wsucc k)
nav-step : (Code → Word) → Code → Lst Rule → (Code → Navr) → Code → Navr
nav-step cost goal view h t =
  if reaches goal t then navr t #0
  else (case choose-by cost goal (available view t) of
          none → navr t #0
          some s → navr-succ (h (step-term s)))
navigate-by : (Code → Word) → Word → Code → Lst Rule → Code → Navr
navigate-by cost n goal view t = %welimP (λ _ → Code → Navr) n (λ t0 → navr t0 #0) (λ m h → nav-step cost goal view h) t
navigate : Word → Code → Lst Rule → Code → Navr
navigate n goal view t = navigate-by code-size n goal view t
-- ---------------------------------------------------------------- cost models (lib/bootstrap/cost.cub)
-- The score of a step is the recorded cost of its result: the machine's own step count for the key
-- at the result's head, as the store records it beside each accepted definition, estimated by the
-- result's size where no record exists. A table: a Lst of (global index , recorded steps)
CostTbl : Type
CostTbl = Lst (Word × Word)
cost-lookup : Word → CostTbl → Opt Word
cost-lookup g lnil = none
cost-lookup g (lcons e r) = if %weq (fst e) g then some (snd e) else cost-lookup g r
-- the head global of a code (an application's function, through annotations and lets)
head-glob : Code → Opt Word
head-glob (cglob g) = some g
head-glob (capp f a) = head-glob f
head-glob (cann t T) = head-glob t
head-glob (clet t b) = head-glob b
head-glob c = none
size-cost : Code → Word
size-cost c = code-size c
-- the recorded model: the recorded steps of the head's key, plus the size of the rest, else the size
table-cost : CostTbl → Code → Word
table-cost tbl c =
  case head-glob c of
    none → code-size c
    some g → (case cost-lookup g tbl of none → code-size c; some s → %wadd s (code-size c))
-- the store's model: the steps the machine recorded for the head's key, plus the size
store-cost : Code → Word
store-cost c =
  case head-glob c of
    none → code-size c
    some g → %wadd (def-steps g) (code-size c)
-- a model refined by what a reading measured: an entry replaced or added
cost-record : Word → Word → CostTbl → CostTbl
cost-record g steps lnil = lcons (g , steps) lnil
cost-record g steps (lcons e r) = if %weq (fst e) g then lcons (g , steps) r else lcons e (cost-record g steps r)
-- ---------------------------------------------------------------- the cost model and the choice rule
-- (PLAN.md revision 7.9, §18.14 and §15 “Open threads”; the decision of 2026-11-06): a cost model is
-- a value of three measures and their weights (the steps recorded for the calls a term makes, its
-- size, a latency estimate from a schedule); a purpose is a value (reach a goal, minimize the cost,
-- or reach a goal at least cost); the choice rule is best-first, the frontier ordered by cost, ties
-- by the term's key, a visited set against cycles, a budget on the expansions
wtimes : Word → Word → Word
wtimes a n = %welimP (λ _ → Word) n #0 (λ m h → %wadd a h)
-- the globals a code mentions (with repetition: a call made twice costs twice)
code-globs : Code → Lst Word → Lst Word
code-globs (cglob g) acc = lcons g acc
code-globs (capp f a) acc = code-globs f (code-globs a acc)
code-globs (clam b) acc = code-globs b acc
code-globs (cpair a b) acc = code-globs a (code-globs b acc)
code-globs (cfst p) acc = code-globs p acc
code-globs (csnd p) acc = code-globs p acc
code-globs (clet a b) acc = code-globs a (code-globs b acc)
code-globs (cann a T) acc = code-globs a acc
code-globs c acc = acc
sum-tbl : CostTbl → Lst Word → Word
sum-tbl tbl lnil = #0
sum-tbl tbl (lcons g r) = %wadd (opt-or (cost-lookup g tbl) #0) (sum-tbl tbl r)
-- a schedule's latency estimate: each global placed on the net (its recorded steps), compiled (one
-- unit per call) or foreign (a fixed boundary cost)
data Place = pl-net | pl-compiled | pl-foreign
place-lat : Word → Place → Word
place-lat g pl-net = def-steps g
place-lat g pl-compiled = #1
place-lat g pl-foreign = #1000
lat-of-sched : Lst (Word × Place) → CostTbl
lat-of-sched lnil = lnil
lat-of-sched (lcons e r) = lcons (fst e , place-lat (fst e) (snd e)) (lat-of-sched r)
-- the model: (weights for steps, size, latency) , the steps table, the latency table
data CostModel = cmodel (ws : Word) (wz : Word) (wl : Word) (steps : CostTbl) (lat : CostTbl)
cm-cost : CostModel → Code → Word
cm-cost (cmodel ws wz wl st lt) c =
  %wadd (wtimes (sum-tbl st (code-globs c lnil)) ws)
        (%wadd (wtimes (code-size c) wz) (wtimes (sum-tbl lt (code-globs c lnil)) wl))
-- the store's figures as a steps table for the globals of a term
store-steps-of : Lst Word → CostTbl
store-steps-of lnil = lnil
store-steps-of (lcons g r) = lcons (g , def-steps g) (store-steps-of r)
store-steps : Code → CostTbl
store-steps c = store-steps-of (code-globs c lnil)
-- ---------------------------------------------------------------- keys: a term's canonical serialization
code-ser : Code → Lst Word → Lst Word
code-ser (cvar n) acc = lcons #1 (lcons n acc)
code-ser (cglob n) acc = lcons #2 (lcons n acc)
code-ser (clam b) acc = lcons #3 (code-ser b acc)
code-ser (capp f a) acc = lcons #4 (code-ser f (code-ser a acc))
code-ser (cpair a b) acc = lcons #5 (code-ser a (code-ser b acc))
code-ser (cfst p) acc = lcons #6 (code-ser p acc)
code-ser (csnd p) acc = lcons #7 (code-ser p acc)
code-ser (cwlit n) acc = lcons #8 (lcons n acc)
code-ser (cann a T) acc = lcons #9 (code-ser a (code-ser T acc))
code-ser (clet a b) acc = lcons #10 (code-ser a (code-ser b acc))
code-ser c acc = lcons #11 acc
-- lexicographic order on word lists (a shorter prefix first)
key-lt : Lst Word → Lst Word → Bool
key-lt lnil lnil = false
key-lt lnil (lcons y s) = true
key-lt (lcons x r) lnil = false
key-lt (lcons x r) (lcons y s) = if %wlt x y then true else if %weq x y then key-lt r s else false
-- ---------------------------------------------------------------- purposes
data Purpose = reach-p (goal : Code → Bool) | minimize | reach-min (goal : Code → Bool)
goal-pat : Code → Code → Bool
goal-pat g = λ t → reaches g t
p-goal : Purpose → Code → Bool
p-goal (reach-p g) t = g t
p-goal minimize t = false
p-goal (reach-min g) t = g t
-- ---------------------------------------------------------------- best-first search
-- a node: its cost, its key, the term and its depth
data SNode = snode (cost : Word) (key : Lst Word) (term : Code) (depth : Word)
node-of : CostModel → Code → Word → SNode
node-of m t d = snode (cm-cost m t) (code-ser t lnil) t d
node-lt : SNode → SNode → Bool
node-lt (snode ca ka ta da) (snode cb kb tb db) = if %wlt ca cb then true else if %weq ca cb then key-lt ka kb else false
insert-node : SNode → Lst SNode → Lst SNode
insert-node n lnil = lcons n lnil
insert-node n (lcons x r) = if node-lt n x then lcons n (lcons x r) else lcons x (insert-node n r)
seen : Code → Lst Code → Bool
seen t lnil = false
seen t (lcons u r) = if code-same t u then true else seen t r
expand : CostModel → Word → Lst Stepv → Lst SNode → Lst Code → Lst SNode
expand m d lnil fr vs = fr
expand m d (lcons s rest) fr vs =
  if seen (step-term s) vs then expand m d rest fr vs else expand m d rest (insert-node (node-of m (step-term s) (%wsucc d)) fr) vs
-- the result: the term chosen, the number of steps to it, its cost, whether the goal was reached
data Navp = navp (result : Code) (steps : Word) (cost : Word) (reached : Bool)
nav-of : SNode → Bool → Navp
nav-of (snode c k t d) reached = navp t d c reached
better : SNode → SNode → Bool
better a b = node-lt a b
-- one expansion of the frontier; k the search with one less in the budget (none: the budget is spent)
search-step : CostModel → Purpose → Lst Rule → Opt (Lst SNode → Lst Code → SNode → Navp) → Lst SNode → Lst Code → SNode → Navp
search-step m p view k lnil vs bst = nav-of bst false
search-step m p view k (lcons (snode c ky t d) rest) vs bst =
  if p-goal p t then nav-of (snode c ky t d) true
  else (case k of
          none → nav-of (if better (snode c ky t d) bst then snode c ky t d else bst) false
          some k2 → k2 (expand m d (available view t) rest (lcons t vs)) (lcons t vs) (if better (snode c ky t d) bst then snode c ky t d else bst))
search : CostModel → Purpose → Lst Rule → Word → Lst SNode → Lst Code → SNode → Navp
search m p view budget =
  %welimP (λ _ → Lst SNode → Lst Code → SNode → Navp) budget (search-step m p view none) (λ n h → search-step m p view (some h))
-- navigate-best m p n view t: best-first under the model m toward the purpose p, at most n
-- expansions. For minimize, the least-cost term reached; for a goal, the first goal term in cost
-- order (none reached: the least-cost term, reached = false)
navigate-best : CostModel → Purpose → Word → Lst Rule → Code → Navp
navigate-best m p n view t = search m p view n (lcons (node-of m t #0) lnil) lnil (node-of m t #0)
