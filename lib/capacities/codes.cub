-- Layer: capacity demonstrated and mentioned in the paper: a metacircular extension on the unchanged core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/capacities/codes.cub — typed helpers for programs over codes (the specializer, lib/capacities/machine.cub, the
-- compiler). Loaded after lib/library/std.cub.
-- ---------------------------------------------------------------- Booleans, options, lists
c-not : Bool → Bool
c-not b = if b then false else true
c-and : Bool → Bool → Bool
c-and a b = if a then b else false
c-or : Bool → Bool → Bool
c-or a b = if a then true else b
opt-or : {A : Type} → Opt A → A → A
opt-or none d = d
opt-or (some x) d = x
opt-map : {A B : Type} → (A → B) → Opt A → Opt B
opt-map f none = none
opt-map f (some x) = some (f x)
l-app : {A : Type} → Lst A → Lst A → Lst A
l-app lnil ys = ys
l-app (lcons x xs) ys = lcons x (l-app xs ys)
l-count : {A : Type} → Lst A → Word
l-count lnil = #0
l-count (lcons x xs) = %wsucc (l-count xs)
l-map : {A B : Type} → (A → B) → Lst A → Lst B
l-map f lnil = lnil
l-map f (lcons x xs) = lcons (f x) (l-map f xs)
l-filter : {A : Type} → (A → Bool) → Lst A → Lst A
l-filter p lnil = lnil
l-filter p (lcons x xs) = if p x then lcons x (l-filter p xs) else l-filter p xs
l-any : {A : Type} → (A → Bool) → Lst A → Bool
l-any p lnil = false
l-any p (lcons x xs) = if p x then true else l-any p xs
l-isnil : {A : Type} → Lst A → Bool
l-isnil lnil = true
l-isnil (lcons x xs) = false
-- element n (counted from 0), when there is one
l-nth : {A : Type} → Lst A → Word → Opt A
l-nth lnil n = none
l-nth (lcons x xs) n = if %weq n #0 then some x else l-nth xs (%wsub n #1)
l-at : {A : Type} → A → Lst A → Word → A
l-at d l n = opt-or (l-nth l n) d
w-mem : Word → Lst Word → Bool
w-mem g lnil = false
w-mem g (lcons x xs) = if %weq x g then true else w-mem g xs
-- the position of g in l from i, when it is there
w-index : Word → Lst Word → Word → Opt Word
w-index g lnil i = none
w-index g (lcons x xs) i = if %weq x g then some i else w-index g xs (%wsucc i)
-- ---------------------------------------------------------------- walking codes
-- A code's parts are codes and lists of codes, so a walk over a code recurses through lists: it is
-- given fuel, a bound on the depth it goes to (a code deeper than the fuel is walked as far as the
-- fuel goes; c-fuel is past any code a checked definition quotes to)
nat-pow2 : Nat → Nat
nat-pow2 zero = suc zero
nat-pow2 (suc n) = plus (nat-pow2 n) (nat-pow2 n)
c-fuel : Nat
c-fuel = nat-pow2 (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))
-- a code's immediate parts
code-kids : Code → Lst Code
code-kids (clam b) = lcons b lnil
code-kids (capp a b) = lcons a (lcons b lnil)
code-kids (cpair a b) = lcons a (lcons b lnil)
code-kids (cfst p) = lcons p lnil
code-kids (csnd p) = lcons p lnil
code-kids (cpi m A B) = lcons A (lcons B lnil)
code-kids (csigma A B) = lcons A (lcons B lnil)
code-kids (cuniv l) = lcons l lnil
code-kids (cpathp A a b) = lcons A (lcons a (lcons b lnil))
code-kids (cplam b) = lcons b lnil
code-kids (cpapp p r) = lcons p (lcons r lnil)
code-kids (cneg r) = lcons r lnil
code-kids (cmeet r s) = lcons r (lcons s lnil)
code-kids (cjoin r s) = lcons r (lcons s lnil)
code-kids (ceq0 r) = lcons r lnil
code-kids (ceq1 r) = lcons r lnil
code-kids (cfand a b) = lcons a (lcons b lnil)
code-kids (cfor a b) = lcons a (lcons b lnil)
code-kids (cforall b) = lcons b lnil
code-kids (csysc a t r) = lcons a (lcons t (lcons r lnil))
code-kids (ccomp A u a) = lcons A (lcons u (lcons a lnil))
code-kids (cgluet A S) = lcons A (lcons S lnil)
code-kids (cglue S a) = lcons S (lcons a lnil)
code-kids (cunglue S b) = lcons S (lcons b lnil)
code-kids (chcompu A S) = lcons A (lcons S lnil)
code-kids (cunglueu S b) = lcons S (lcons b lnil)
code-kids (clet t b) = lcons t (lcons b lnil)
code-kids (cann t T) = lcons t (lcons T lnil)
code-kids (cdata dd ps) = ps
code-kids (ccon dd k fs ds) = l-app fs ds
code-kids (celim dd P B x) = lcons P (lcons x B)
code-kids (ccase dd B x) = lcons x B
code-kids (chcomp u a) = lcons u (lcons a lnil)
code-kids (cdlam b) = lcons b lnil
code-kids (cforce t) = lcons t lnil
code-kids (cthunk t) = lcons t lnil
code-kids (clsuc l) = lcons l lnil
code-kids (clmax a b) = lcons a (lcons b lnil)
code-kids (cpty k n) = lcons n lnil
code-kids (cwsucc a) = lcons a lnil
code-kids (cwop k a b) = lcons a (lcons b lnil)
code-kids (cwelim w z s none) = lcons w (lcons z (lcons s lnil))
code-kids (cwelim w z s (some P)) = lcons P (lcons w (lcons z (lcons s lnil)))
code-kids (ctrans dd psi ls x) = lcons psi (lcons x ls)
code-kids (cproj dd k x) = lcons x lnil
code-kids (crec dd fs) = fs
code-kids (ctick k) = lcons k lnil
code-kids (cprim k as) = as
code-kids _ = lnil
-- the globals a code names, each once
cg-list : (Code → Lst Word → Lst Word) → Lst Code → Lst Word → Lst Word
cg-list f lnil acc = acc
cg-list f (lcons x r) acc = cg-list f r (f x acc)
cg-acc : Nat → Code → Lst Word → Lst Word
cg-acc zero c acc = acc
cg-acc (suc n) (cglob g) acc = if w-mem g acc then acc else lcons g acc
cg-acc (suc n) c acc = cg-list (λ x a → cg-acc n x a) (code-kids c) acc
code-globals : Code → Lst Word
code-globals c = cg-acc c-fuel c lnil
-- ---------------------------------------------------------------- counting
-- f applied n times
w-iter : {A : Type} → Word → (A → A) → A → A
w-iter {A} n f x = %welimP (λ _ → A) n x (λ j h → f h)
-- f 0 (…), then f 1, …, f (n−1): the fold of the counter from 0 up to n − 1
w-fold-up : {A : Type} → Word → (Word → A → A) → A → A
w-fold-up {A} n f z = %welimP (λ _ → A) n z (λ j h → f j h)
