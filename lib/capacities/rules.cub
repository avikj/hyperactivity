-- Layer: capacity demonstrated and mentioned in the paper: a metacircular extension on the unchanged core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/capacities/rules.cub — identities in the store as rewrite rules (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.14 “F33 — Navigation: the concrete form”; §18.6 “B15 — The specializer”, “Steps, in order”, step 3 “Rewrite”).
-- Loaded after lib/core/check.cub, lib/bootstrap/match.cub, lib/bootstrap/nav.cub, lib/capacities/specialize.cub and lib/library/std.cub.
-- A checked definition whose type is Π x1 … xk. l ≡ r is an identity; rule-of reads its type
-- through quote-ty and makes the rule l → r with the bound variables as metavariables; rule-of-sym
-- reads it right to left. A view (nav.cub) is a list of such rules, so navigation runs over the
-- theorems of the store, and the specializer rewrites along proved laws: the "marked theorems"
-- of 18.6 are definitions, named.
peel-pi : Code → Opt (Code × Code)
peel-pi (cpi m A B) = peel-pi B
peel-pi (cpathp A l r) = some (l , r)
peel-pi c = none
-- the number of Π binders before the identity: the theorem's variables, the rule's metavariables
pi-count : Code → Word
pi-count (cpi m A B) = %wsucc (pi-count B)
pi-count c = #0
thm-type : Word → Code
thm-type g = opt-or (def-type-code g) cword
rule-of : Word → Opt Rule
rule-of g = opt-map (λ lr → rule #0 (fst lr) (snd lr) (thm g (pi-count (thm-type g)) false)) (peel-pi (thm-type g))
rule-of-sym : Word → Opt Rule
rule-of-sym g = opt-map (λ lr → rule #0 (snd lr) (fst lr) (thm g (pi-count (thm-type g)) true)) (peel-pi (thm-type g))
view-of : Lst Word → Lst Rule
view-of lnil = lnil
view-of (lcons g rest) = case rule-of g return (λ _ → Lst Rule) of
  some r → lcons r (view-of rest)
  none → view-of rest
