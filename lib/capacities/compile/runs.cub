-- Layer: capacity demonstrated and mentioned in the paper: a metacircular extension on the unchanged core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/capacities/compile/runs.cub — runs of a step function as a relation, and the meaning of bytes
-- (lib/capacities/compile/meaning.cub) reduced to one run.
--
-- Runs stp stop k s s2: k steps of stp lead from s to s2, each outcome a value, and none of the k
-- steps is taken from a state whose rip is stop. Runs compose (runs-cat). run-to (meaning.cub)
-- from s, whatever its fuel, either runs out or stops at s2 when a run reaches s2 at stop
-- (run-to-runs). So bytes are correct for f at an argument as soon as one run from the call's
-- state reaches the return with f's value (correct-at): every other fuel gives f's value too.
-- Everything here is of a step function that is a variable; the model is not unfolded.
import "meaning.cub"
import "x86ok.cub"

X86Step : Type
X86Step = X86 → Outc exception Unit × X86
Runs : X86Step → Word → Word → X86 → X86 → Type
Runs stp stop k =
  %welimP (λ _ → X86 → X86 → Type) k (λ s s2 → s ≡ s2)
    (λ j h s s2 → (weq (x86-rip s) stop ≡ false) × ((s1 : X86) × ((stp s ≡ the (Outc exception Unit × X86) (out-val unit , s1)) × h s1 s2)))
-- one step, then a run
runs-step : (stp : X86Step) → (stop k : Word) → (s s1 s2 : X86) → weq (x86-rip s) stop ≡ false →
            stp s ≡ the (Outc exception Unit × X86) (out-val unit , s1) → Runs stp stop k s1 s2 → Runs stp stop (%wsucc k) s s2
runs-step stp stop k s s1 s2 ne e r = (ne , (s1 , (e , r)))
-- runs compose
runs-cat-step : (stp : X86Step) → (stop k2 j : Word) →
                ((s s1 s2 : X86) → Runs stp stop j s s1 → Runs stp stop k2 s1 s2 → Runs stp stop (%wadd k2 j) s s2) →
                (s s1 s2 : X86) → Runs stp stop (%wsucc j) s s1 → Runs stp stop k2 s1 s2 → Runs stp stop (%wadd k2 (%wsucc j)) s s2
runs-cat-step stp stop k2 j ih s s1 s2 r1 r2 = (fst r1 , (fst (snd r1) , (fst (snd (snd r1)) , ih (fst (snd r1)) s1 s2 (snd (snd (snd r1))) r2)))
runs-cat : (stp : X86Step) → (stop k1 k2 : Word) → (s s1 s2 : X86) → Runs stp stop k1 s s1 → Runs stp stop k2 s1 s2 → Runs stp stop (%wadd k2 k1) s s2
runs-cat stp stop k1 k2 =
  %welimP (λ v → (s s1 s2 : X86) → Runs stp stop v s s1 → Runs stp stop k2 s1 s2 → Runs stp stop (%wadd k2 v) s s2) k1
    (λ s s1 s2 p r2 → subst {lzero} {lzero} {X86} {λ x → Runs stp stop k2 x s2} (sym p) r2)
    (λ j ih → runs-cat-step stp stop k2 j ih)

-- run-to at a state whose rip is stop stops there, whatever the fuel
at-stop : (stp : X86Step) → (stop : Word) → (s : X86) → weq (x86-rip s) stop ≡ true → (n : Word) → run-to stp n stop s ≡ some s
at-stop stp stop s h n =
  %welimP (λ v → run-to stp v stop s ≡ some s) n
    (cong (λ b → if b then some s else none) h)
    (λ j ih → cong (λ b → if b then some s else x86-run-on (run-to stp j stop) (stp s)) h)
-- what run-to from s gives, by its fuel: none, or s2
RunTo : Opt X86 → X86 → Type
RunTo o s2 = Sum (o ≡ none) (o ≡ some s2)
runto-pre : {o1 o2 : Opt X86} → (s2 : X86) → o1 ≡ o2 → RunTo o2 s2 → RunTo o1 s2
runto-pre {o1} {o2} s2 p (inl q) = inl (p ∙ q)
runto-pre {o1} {o2} s2 p (inr q) = inr (p ∙ q)
-- run-to over a run that ends at stop: none or its end
run-to-runs-step : (stp : X86Step) → (stop j : Word) → (s2 : X86) →
                   ((s : X86) → Runs stp stop j s s2 → (n : Word) → RunTo (run-to stp n stop s) s2) →
                   (s : X86) → Runs stp stop (%wsucc j) s s2 → (n : Word) → RunTo (run-to stp n stop s) s2
run-to-runs-step stp stop j s2 ih s r n =
  %welimP (λ v → RunTo (run-to stp v stop s) s2) n
    (inl (cong (λ b → if b then some s else none) (fst r)))
    (λ m g → runto-pre s2
       (cong (λ b → if b then some s else x86-run-on (run-to stp m stop) (stp s)) (fst r)
        ∙ cong (x86-run-on (run-to stp m stop)) (fst (snd (snd r))))
       (ih (fst (snd r)) (snd (snd (snd r))) m))
run-to-runs : (stp : X86Step) → (stop k : Word) → (s2 : X86) → weq (x86-rip s2) stop ≡ true →
              (s : X86) → Runs stp stop k s s2 → (n : Word) → RunTo (run-to stp n stop s) s2
run-to-runs stp stop k s2 h =
  %welimP (λ v → (s : X86) → Runs stp stop v s s2 → (n : Word) → RunTo (run-to stp n stop s) s2) k
    (λ s p n → inr (subst {lzero} {lzero} {X86} {λ x → run-to stp n stop x ≡ some s2} (sym p) (at-stop stp stop s2 h n)))
    (λ j ih → run-to-runs-step stp stop j s2 ih)

-- ---------------------------------------------------------------- correct at an argument
-- a run from the call's state to the return whose result is f's value (or the overflow exit)
Reaches : Lst Word → Lst Word → Word → Type
Reaches bs args v =
  (k : Word) × ((s2 : X86) × (Runs x86-step mn-ret k (mn-init bs args) s2 × ((weq (x86-rip s2) mn-ret ≡ true) × (opt-or (mn-result (some s2)) v ≡ v))))
-- then ⟦bs⟧ is v at those arguments for every fuel (stated of a state that is a variable: the
-- call's state is not unfolded)
reaches-gen : (stp : X86Step) → (s s2 : X86) → (v k : Word) → Runs stp mn-ret k s s2 → weq (x86-rip s2) mn-ret ≡ true →
              opt-or (mn-result (some s2)) v ≡ v → (n : Word) → opt-or (mn-result (run-to stp n mn-ret s)) v ≡ v
reaches-gen stp s s2 v k r h e n =
  case run-to-runs stp mn-ret k s2 h s r n return (λ _ → opt-or (mn-result (run-to stp n mn-ret s)) v ≡ v) of
    inl q → cong (λ o → opt-or (mn-result o) v) q
    inr q → cong (λ o → opt-or (mn-result o) v) q ∙ e
reaches-run : (bs args : Lst Word) → (v : Word) → Reaches bs args v → (n : Word) → opt-or (mn-run bs n args) v ≡ v
reaches-run bs args v r n =
  reaches-gen x86-step (mn-init bs args) (fst (snd r)) v (fst r) (fst (snd (snd r))) (fst (snd (snd (snd r)))) (snd (snd (snd (snd r)))) n
correct2-at : (bs : Lst Word) → (f : Word → Word → Word) → (a b : Word) → Reaches bs (lcons a (lcons b lnil)) (f a b) →
              (n : Word) → mn-call2 bs f n a b ≡ f a b
correct2-at bs f a b r n = reaches-run bs (lcons a (lcons b lnil)) (f a b) r n
correct1-at : (bs : Lst Word) → (f : Word → Word) → (a : Word) → Reaches bs (lcons a lnil) (f a) →
              (n : Word) → mn-call1 bs f n a ≡ f a
correct1-at bs f a r n = reaches-run bs (lcons a lnil) (f a) r n
-- Correct from a run at every argument
correct2 : (bs : Lst Word) → (f : Word → Word → Word) → ((a b : Word) → Reaches bs (lcons a (lcons b lnil)) (f a b)) → Correct2 bs f
correct2 bs f h n a b = correct2-at bs f a b (h a b) n
correct1 : (bs : Lst Word) → (f : Word → Word) → ((a : Word) → Reaches bs (lcons a lnil) (f a)) → Correct1 bs f
correct1 bs f h n a = correct1-at bs f a (h a) n

-- ---------------------------------------------------------------- a run found by computation
-- k steps of stp from s, as a run when each outcome is a value and no state before the last is at
-- stop: the run, to the state the steps compute
RunFrom : X86Step → Word → Word → X86 → Type
RunFrom stp stop k s = Opt ((s2 : X86) × Runs stp stop k s s2)
runs-exec-val : (stp : X86Step) → (stop j : Word) → ((s1 : X86) → RunFrom stp stop j s1) → (s : X86) →
                weq (x86-rip s) stop ≡ false → (r : Outc exception Unit × X86) → stp s ≡ r →
                (o : Outc exception Unit) → fst r ≡ o → RunFrom stp stop (%wsucc j) s
runs-exec-val stp stop j h s ne r er o eo =
  case o return (λ o2 → fst r ≡ o2 → RunFrom stp stop (%wsucc j) s) of
    out-val u → λ q →
      (case u return (λ u2 → fst r ≡ out-val u2 → RunFrom stp stop (%wsucc j) s) of
         unit → λ q2 →
           (case h (snd r) return (λ _ → RunFrom stp stop (%wsucc j) s) of
              none → none
              some p → some (fst p , runs-step stp stop j s (snd r) (fst p) ne
                                       (er ∙ (λ i → the (Outc exception Unit × X86) (q2 i , snd r))) (snd p))))
      q
    out-throw e → λ q → none
    out-abort w → λ q → none
  eo
runs-exec-step : (stp : X86Step) → (stop j : Word) → ((s1 : X86) → RunFrom stp stop j s1) → (s : X86) →
                 (b : Bool) → weq (x86-rip s) stop ≡ b → (r : Outc exception Unit × X86) → stp s ≡ r → RunFrom stp stop (%wsucc j) s
runs-exec-step stp stop j h s b eb r er =
  case b return (λ c → weq (x86-rip s) stop ≡ c → RunFrom stp stop (%wsucc j) s) of
    true → λ e → none
    false → λ e → runs-exec-val stp stop j h s e r er (fst r) refl
  eb
runs-exec : (stp : X86Step) → (stop k : Word) → (s : X86) → RunFrom stp stop k s
runs-exec stp stop k =
  %welimP (λ v → (s : X86) → RunFrom stp stop v s) k
    (λ s → some (s , refl))
    (λ j h s → runs-exec-step stp stop j h s (weq (x86-rip s) stop) refl (stp s) refl)
-- the run's last obligations decided: at the return, and the result v (or the overflow exit)
-- (a word result compared with v)
res-word : (v x : Word) → (b : Bool) → weq x v ≡ b → Opt (opt-or (some x) v ≡ v)
res-word v x b e =
  case b return (λ c → weq x v ≡ c → Opt (opt-or (some x) v ≡ v)) of
    true → λ q → some (weq-sound x v q)
    false → λ q → none
  e
res-ok : (v : Word) → (o : Opt Word) → Opt (opt-or o v ≡ v)
res-ok v none = some refl
res-ok v (some x) = res-word v x (weq x v) refl
at-ret : (s2 : X86) → (b : Bool) → weq (x86-rip s2) mn-ret ≡ b → Opt (weq (x86-rip s2) mn-ret ≡ true)
at-ret s2 b e =
  case b return (λ c → weq (x86-rip s2) mn-ret ≡ c → Opt (weq (x86-rip s2) mn-ret ≡ true)) of
    true → λ q → some q
    false → λ q → none
  e
-- k steps from the call's state, checked as a run that reaches the return with v
reaches-exec : (bs args : Lst Word) → (v k : Word) → Opt (Reaches bs args v)
reaches-exec bs args v k =
  case runs-exec x86-step mn-ret k (mn-init bs args) return (λ _ → Opt (Reaches bs args v)) of
    none → none
    some p → (case at-ret (fst p) (weq (x86-rip (fst p)) mn-ret) refl return (λ _ → Opt (Reaches bs args v)) of
                none → none
                some h → (case res-ok v (mn-result (some (fst p))) return (λ _ → Opt (Reaches bs args v)) of
                            none → none
                            some e → some (k , (fst p , (snd p , (h , e))))))
-- the number of steps from s to the first state at stop, within the fuel
run-count : (stp : X86Step) → Word → Word → X86 → Opt Word
run-count stp n stop =
  %welimP (λ _ → X86 → Opt Word) n (λ s → if weq (x86-rip s) stop then some #0 else none)
    (λ j h s → if weq (x86-rip s) stop then some #0 else
       (case fst (stp s) return (λ _ → Opt Word) of
          out-val u → opt-map (λ c → %wsucc c) (h (snd (stp s)))
          out-throw e → none
          out-abort w → none))
-- an Opt known to hold a value, and the value
IsSome : {A : Type} → Opt A → Type
IsSome {A} none = Empty
IsSome {A} (some x) = Unit
the-some : {A : Type} → (o : Opt A) → IsSome o → A
the-some {A} none h = Empty-rec h
the-some {A} (some x) h = x

-- ---------------------------------------------------------------- a run computed, as a run
-- k steps of stp from s each end in a value and start away from stop (decided by computing them)
run-ok : X86Step → Word → Word → X86 → Bool
run-ok stp stop k =
  %welimP (λ _ → X86 → Bool) k (λ s → true)
    (λ j h s → if weq (x86-rip s) stop then false else
       (case fst (stp s) return (λ _ → Bool) of
          out-val u → h (snd (stp s))
          out-throw e → false
          out-abort w → false))
-- then they are a run, to the state they compute
runs-run-tail : (stp : X86Step) → (stop j : Word) → (s : X86) → weq (x86-rip s) stop ≡ false → fst (stp s) ≡ out-val unit →
                Runs stp stop j (snd (stp s)) (snd (run-of stp j (snd (stp s)))) →
                Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))
runs-run-tail stp stop j s ne q r =
  (ne , (snd (stp s) , ((λ i → the (Outc exception Unit × X86) (q i , snd (stp s))) ,
    subst {lzero} {lzero} {X86} {λ x → Runs stp stop j (snd (stp s)) x}
      (sym (cong (λ o → snd (st-on {X86} {exception} {Unit} {Unit} o (λ _ → run-of stp j) (snd (stp s)))) q)) r)))
runs-run-val : (stp : X86Step) → (stop j : Word) → ((s1 : X86) → run-ok stp stop j s1 ≡ true → Runs stp stop j s1 (snd (run-of stp j s1))) →
               (s : X86) → weq (x86-rip s) stop ≡ false → (o : Outc exception Unit) → fst (stp s) ≡ o →
               (case o return (λ _ → Bool) of
                  out-val u → run-ok stp stop j (snd (stp s))
                  out-throw e → false
                  out-abort w → false) ≡ true →
               Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))
runs-run-val stp stop j ih s ne o eo =
  case o return (λ o2 → fst (stp s) ≡ o2 → (case o2 return (λ _ → Bool) of
                                              out-val u → run-ok stp stop j (snd (stp s))
                                              out-throw e → false
                                              out-abort w → false) ≡ true →
                        Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))) of
    out-val u → λ q h →
      (case u return (λ u2 → fst (stp s) ≡ out-val u2 → Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))) of
         unit → λ q2 → runs-run-tail stp stop j s ne q2 (ih (snd (stp s)) h))
      q
    out-throw e → λ q h → bool-ft (Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))) h
    out-abort w → λ q h → bool-ft (Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))) h
  eo
runs-run-at : (stp : X86Step) → (stop j : Word) → ((s1 : X86) → run-ok stp stop j s1 ≡ true → Runs stp stop j s1 (snd (run-of stp j s1))) →
              (s : X86) → (b : Bool) → weq (x86-rip s) stop ≡ b →
              (if b then false else (case fst (stp s) return (λ _ → Bool) of
                                       out-val u → run-ok stp stop j (snd (stp s))
                                       out-throw e → false
                                       out-abort w → false)) ≡ true →
              Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))
runs-run-at stp stop j ih s b eb =
  case b return (λ c → weq (x86-rip s) stop ≡ c →
                       (if c then false else (case fst (stp s) return (λ _ → Bool) of
                                                out-val u → run-ok stp stop j (snd (stp s))
                                                out-throw e → false
                                                out-abort w → false)) ≡ true →
                       Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))) of
    true → λ e h → bool-ft (Runs stp stop (%wsucc j) s (snd (run-of stp (%wsucc j) s))) h
    false → λ e h → runs-run-val stp stop j ih s e (fst (stp s)) refl h
  eb
runs-run : (stp : X86Step) → (stop k : Word) → (s : X86) → run-ok stp stop k s ≡ true → Runs stp stop k s (snd (run-of stp k s))
runs-run stp stop k =
  %welimP (λ v → (s : X86) → run-ok stp stop v s ≡ true → Runs stp stop v s (snd (run-of stp v s))) k
    (λ s h → refl)
    (λ j ih s h → runs-run-at stp stop j ih s (weq (x86-rip s) stop) refl h)
-- Correct on the words a call passes, from a run at each
correct2w : (bs : Lst Word) → (f : Word → Word → Word) → ((a b : Word) → W64 a → W64 b → Reaches bs (lcons a (lcons b lnil)) (f a b)) → Correct2w bs f
correct2w bs f h n a b ha hb = correct2-at bs f a b (h a b ha hb) n
correct1w : (bs : Lst Word) → (f : Word → Word) → ((a : Word) → W64 a → Reaches bs (lcons a lnil) (f a)) → Correct1w bs f
correct1w bs f h n a ha = correct1-at bs f a (h a ha) n

-- ---------------------------------------------------------------- a property of every fuel's result
-- Q of run-to at every fuel, from s; a computed stretch, one step given by an equation, or the stop
QAll : X86Step → Word → (Opt X86 → Type) → X86 → Type
QAll stp stop Q s = (n : Word) → Q (run-to stp n stop s)
q-stop : (stp : X86Step) → (stop : Word) → (Q : Opt X86 → Type) → (s : X86) → weq (x86-rip s) stop ≡ true → Q (some s) → QAll stp stop Q s
q-stop stp stop Q s h q n = subst {lzero} {lzero} {Opt X86} {Q} (sym (at-stop stp stop s h n)) q
q-step : (stp : X86Step) → (stop : Word) → (Q : Opt X86 → Type) → (s s2 : X86) → weq (x86-rip s) stop ≡ false →
         stp s ≡ the (Outc exception Unit × X86) (out-val unit , s2) → Q none → QAll stp stop Q s2 → QAll stp stop Q s
q-step stp stop Q s s2 ne e q0 qa n =
  %welimP (λ v → Q (run-to stp v stop s)) n
    (subst {lzero} {lzero} {Opt X86} {Q} (sym (cong (λ b → if b then some s else none) ne)) q0)
    (λ m g → subst {lzero} {lzero} {Opt X86} {Q}
               (sym (cong (λ b → if b then some s else x86-run-on (run-to stp m stop) (stp s)) ne ∙ cong (x86-run-on (run-to stp m stop)) e))
               (qa m))
-- k computed steps: a step that is a value, then the rest
q-run-val : (stp : X86Step) → (stop j : Word) → (Q : Opt X86 → Type) → Q none →
            ((s1 : X86) → run-ok stp stop j s1 ≡ true → QAll stp stop Q (snd (run-of stp j s1)) → QAll stp stop Q s1) →
            (s : X86) → weq (x86-rip s) stop ≡ false → (o : Outc exception Unit) → fst (stp s) ≡ o →
            (case o return (λ _ → Bool) of
               out-val u → run-ok stp stop j (snd (stp s))
               out-throw e → false
               out-abort w → false) ≡ true →
            QAll stp stop Q (snd (run-of stp (%wsucc j) s)) → QAll stp stop Q s
q-run-val stp stop j Q q0 ih s ne o eo =
  case o return (λ o2 → fst (stp s) ≡ o2 → (case o2 return (λ _ → Bool) of
                                              out-val u → run-ok stp stop j (snd (stp s))
                                              out-throw e → false
                                              out-abort w → false) ≡ true →
                        QAll stp stop Q (snd (run-of stp (%wsucc j) s)) → QAll stp stop Q s) of
    out-val u → λ q h qa →
      (case u return (λ u2 → fst (stp s) ≡ out-val u2 → QAll stp stop Q s) of
         unit → λ q2 →
           q-step stp stop Q s (snd (stp s)) ne (λ i → the (Outc exception Unit × X86) (q2 i , snd (stp s))) q0
             (ih (snd (stp s)) h
                (subst {lzero} {lzero} {X86} {QAll stp stop Q}
                   (cong (λ o3 → snd (st-on {X86} {exception} {Unit} {Unit} o3 (λ _ → run-of stp j) (snd (stp s)))) q2) qa)))
      q
    out-throw e → λ q h qa → bool-ft (QAll stp stop Q s) h
    out-abort w → λ q h qa → bool-ft (QAll stp stop Q s) h
  eo
-- k computed steps
q-run-at : (stp : X86Step) → (stop j : Word) → (Q : Opt X86 → Type) → Q none →
           ((s1 : X86) → run-ok stp stop j s1 ≡ true → QAll stp stop Q (snd (run-of stp j s1)) → QAll stp stop Q s1) →
           (s : X86) → (b : Bool) → weq (x86-rip s) stop ≡ b →
           (if b then false else (case fst (stp s) return (λ _ → Bool) of
                                    out-val u → run-ok stp stop j (snd (stp s))
                                    out-throw e → false
                                    out-abort w → false)) ≡ true →
           QAll stp stop Q (snd (run-of stp (%wsucc j) s)) → QAll stp stop Q s
q-run-at stp stop j Q q0 ih s b eb =
  case b return (λ c → weq (x86-rip s) stop ≡ c →
                       (if c then false else (case fst (stp s) return (λ _ → Bool) of
                                                out-val u → run-ok stp stop j (snd (stp s))
                                                out-throw e → false
                                                out-abort w → false)) ≡ true →
                       QAll stp stop Q (snd (run-of stp (%wsucc j) s)) → QAll stp stop Q s) of
    true → λ e h qa → bool-ft (QAll stp stop Q s) h
    false → λ e h qa → q-run-val stp stop j Q q0 ih s e (fst (stp s)) refl h qa
  eb
q-run : (stp : X86Step) → (stop k : Word) → (Q : Opt X86 → Type) → Q none → (s : X86) → run-ok stp stop k s ≡ true →
        QAll stp stop Q (snd (run-of stp k s)) → QAll stp stop Q s
q-run stp stop k Q q0 =
  %welimP (λ v → (s : X86) → run-ok stp stop v s ≡ true → QAll stp stop Q (snd (run-of stp v s)) → QAll stp stop Q s) k
    (λ s h qa → qa)
    (λ j ih s h qa → q-run-at stp stop j Q q0 ih s (weq (x86-rip s) stop) refl h qa)
-- the result read at every fuel is v
RQ : Word → Opt X86 → Type
RQ v o = opt-or (mn-result o) v ≡ v
-- rax replaced by a value proved equal to it (eta: the state rebuilt with its own rax is itself,
-- by computation where the state is concrete)
q-rax : (stp : X86Step) → (stop : Word) → (Q : Opt X86 → Type) → (X : X86) → (v : Word) →
        x86-rax X ≡ v → x86-set-rax (x86-rax X) X ≡ X → QAll stp stop Q (x86-set-rax v X) → QAll stp stop Q X
q-rax stp stop Q X v p eta qa =
  subst {lzero} {lzero} {X86} {QAll stp stop Q} eta
    (subst {lzero} {lzero} {X86} {QAll stp stop Q} (cong (λ r → x86-set-rax r X) (sym p)) qa)
