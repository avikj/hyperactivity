-- lib/cxx/machine.cub — the C++ abstract machine's ground: outcomes, the unit's tables, types,
-- memory accesses, the environment of a reading (tracks/F-cxx.md item 1). Loaded after the
-- library, lib/mem/{target,scalar,memory,layout,monad}.cub and the AST (lib/cxx/ast.cub; while
-- its bo-… constructors collide with lib/mem/scalar.cub's, the renamed copy
-- experiments/cxx/sem/gen/ast.cub, where CBinOp's constructors are cbo-…).
--
-- A reading is a computation of lib/mem/monad.cub's Ev at the signature CxS, whose one command
-- is the refusal of a construct the reader has no meaning for: the command carries the AST
-- node (or type, or cast) refused and has no response, so the computation ends there and the
-- outcome names what was refused. Returned values are CxR.

-- ---------------------------------------------------------------- outcomes
-- what a refusal names: the expression, statement, type, cast or declaration the reader does
-- not give a meaning to (cxw-form: an expression in a form its rule does not cover, with the
-- number of the rule's note in tracks/F-cxx.md's Limits)
data CxWhat = cxw-expr (e : CExpr) | cxw-stmt (s : CStmt) | cxw-type (t : CType)
            | cxw-cast (k : CCastKind) (from : CType) (to : CType) | cxw-decl (id : Word)
            | cxw-form (note : Word) (e : CExpr) | cxw-builtin (id : Word)
CxS : Sig
CxS = (CxWhat , λ c → Empty)
-- the result of evaluating an expression, by what the expression is:
--   cxr-void    nothing: a void expression, or a class prvalue that has initialized its object
--   cxr-val     a scalar prvalue
--   cxr-lv      a glvalue: the object's address and the alignment its accesses may assume (0:
--               the type's own; a member of a packed record has less). A function is mp-fn.
--   cxr-bf      a bit-field glvalue: the address of the byte holding its first bit, the bit's
--               position in that byte, the width, and the alignment-free unit it is read through
--   cxr-bound   a member function bound to an object (obj.f before the call): the object, the
--               function, whether the call is virtual
--   cxr-mfp     a pointer to member function (Itanium C++ ABI 2.3: the function, or 1 + the
--               vtable offset of a virtual one; the adjustment of this)
--   cxr-nil/cxr-cons  the results of an argument list; cxr-parm one parameter object made by
--               the caller (owned: it was allocated for the call; else a reference's referent)
--   cxr-ext     the answer of a full-expression that left a lifetime-extended temporary of a
--               type at an address ([class.temporary]/6): the declaration it initializes ends it
data CxR = cxr-void | cxr-val (v : SV) | cxr-lv (p : MPtr) (al : Word)
         | cxr-bf (p : MPtr) (bit : Word) (width : Word)
         | cxr-bound (this : MPtr) (fn : Word) (virt : Bool)
         | cxr-mfp (f : SV) (adj : UInt64)
         | cxr-nil | cxr-cons (x : CxR) (xs : CxR) | cxr-parm (p : MPtr) (owned : Bool)
         | cxr-ext (p : MPtr) (t : CType) (r : CxR)
CxEv : Type → Type 1
CxEv A = Ev {lzero} CxS CxR A
cx-ret : {A : Type} → A → CxEv A
cx-ret {A} a = ev-ret {lzero} {CxS} {CxR} {A} a
cx-bind : {A B : Type} → CxEv A → (A → CxEv B) → CxEv B
cx-bind {A} {B} e f = ev-bind {lzero} {CxS} {CxR} {A} {B} e f
cx-then : {A B : Type} → CxEv A → CxEv B → CxEv B
cx-then {A} {B} e f = ev-bind {lzero} {CxS} {CxR} {A} {B} e (λ a → f)
cx-res : {A : Type} → MRes A → CxEv A
cx-res {A} r = ev-res {lzero} {CxS} {CxR} {A} r
cx-ub : {A : Type} → UB → CxEv A
cx-ub {A} w = ev-ub {lzero} {CxS} {CxR} {A} w
cx-stop : {A : Type} → Stop → CxEv A
cx-stop {A} w = ev-stop {lzero} {CxS} {CxR} {A} w
cx-unsupported : {A : Type} → CxWhat → CxEv A
cx-unsupported {A} w = λ m R k h → h w (λ x → Empty-rec x)
cx-finally : {A : Type} → CxEv A → CxEv Unit → CxEv A
cx-finally {A} e fin = ev-finally {lzero} {CxS} {CxR} {A} e fin
-- a continuation of an expression's result, and an expression's meaning given one (the answer
-- is that of the full-expression the expression is in: a temporary's lifetime is the extent of
-- the continuation it is handed to)
CxK : Type 1
CxK = CxR → CxEv CxR
cx-k0 : CxK
cx-k0 r = cx-ret {CxR} r
-- the outcome of a run: how control left it with the memory, or undefined behaviour, a stop
-- (fuel, an unsupported Target, a reader's error), or a refusal naming the construct
data CxOut (A : Type) = cxo-ok (a : A) | cxo-ub (why : UB) | cxo-stop (why : Stop) | cxo-unsupported (what : CxWhat)
cx-run : {A : Type} → CxEv A → AMem → CxOut (Ctl CxR A × AMem)
cx-run {A} e m = e m (CxOut (Ctl CxR A × AMem)) (λ r → case r of
  mok x → cxo-ok x
  mub w → cxo-ub w
  mstop w → cxo-stop w) (λ c k → cxo-unsupported c)

-- ---------------------------------------------------------------- names
-- a byte of a name (lib/cxx/ast.cub's CStr has a writer, cstr-put, and no reader): %load8 is
-- bounds-checked by the machine (outside the string it reads 0); trusted like cstr-put
primitive cx-byte : (n : Nat) → Bytes n → Word → Word = λ n b off → %wofu32 (%load8 b off)
cx-len : List Word → Word
cx-len nil = #0
cx-len (cons c cs) = wadd #1 (cx-len cs)
cx-str-go : (n : Nat) → Bytes n → List Word → Word → Bool
cx-str-go n b nil off = true
cx-str-go n b (cons c cs) off = case weq (cx-byte n b off) c of
  true → cx-str-go n b cs (wadd off #1)
  false → false
-- a name is exactly these bytes
cx-name-is : CStr → List Word → Bool
cx-name-is s cs = case weq (fromNat (fst s)) (cx-len cs) of
  true → cx-str-go (fst s) (snd s) cs #0
  false → false
cx-name-len : CStr → Word
cx-name-len s = fromNat (fst s)
cx-name-at : CStr → Word → Word
cx-name-at s i = cx-byte (fst s) (snd s) i

-- ---------------------------------------------------------------- the unit's tables
-- every lookup is a case on program data (the declarations): at a fixed unit it computes away
cx-tu-decls : CTU → List CDecl
cx-tu-decls u = case u of
  ctu name target roots statics decls → decls
cx-tu-statics : CTU → List Word
cx-tu-statics u = case u of
  ctu name target roots statics decls → statics
cx-fn-id : CFunction → Word
cx-fn-id f = case f of
  cfunction id name mangled t params storage inl cexpr impl body → id
cx-fn-name : CFunction → CStr
cx-fn-name f = case f of
  cfunction id name mangled t params storage inl cexpr impl body → name
cx-fn-type : CFunction → CType
cx-fn-type f = case f of
  cfunction id name mangled t params storage inl cexpr impl body → t
cx-fn-params : CFunction → List CVar
cx-fn-params f = case f of
  cfunction id name mangled t params storage inl cexpr impl body → params
cx-fn-body : CFunction → CBody
cx-fn-body f = case f of
  cfunction id name mangled t params storage inl cexpr impl body → body
-- a function of the unit, by what kind of declaration it is
data CxFK = cxfk-function | cxfk-method | cxfk-constructor | cxfk-destructor | cxfk-conversion
data CxFn = cxfn-none | cxfn (k : CxFK) (parent : Word) (virt : Bool) (inits : List CCtorInit) (f : CFunction)
cx-find-fn : List CDecl → Word → CxFn
cx-find-fn nil i = cxfn-none
cx-find-fn (cons d ds) i = case d of
  cd-function f → (case weq (cx-fn-id f) i of
    true → cxfn cxfk-function #0 false nil f
    false → cx-find-fn ds i)
  cd-method parent virt f → (case weq (cx-fn-id f) i of
    true → cxfn cxfk-method parent virt nil f
    false → cx-find-fn ds i)
  cd-constructor parent inits f → (case weq (cx-fn-id f) i of
    true → cxfn cxfk-constructor parent false inits f
    false → cx-find-fn ds i)
  cd-destructor parent virt f → (case weq (cx-fn-id f) i of
    true → cxfn cxfk-destructor parent virt nil f
    false → cx-find-fn ds i)
  cd-conversion parent virt f → (case weq (cx-fn-id f) i of
    true → cxfn cxfk-conversion parent virt nil f
    false → cx-find-fn ds i)
  cd-record r → cx-find-fn ds i
  cd-class-template-specialization args r → cx-find-fn ds i
  cd-enum id name under scoped es → cx-find-fn ds i
  cd-var mangled v → cx-find-fn ds i
-- the destructor declared for a class (the importer writes one for every class that has one)
cx-find-dtor : List CDecl → Word → CxFn
cx-find-dtor nil i = cxfn-none
cx-find-dtor (cons d ds) i = case d of
  cd-destructor parent virt f → (case weq parent i of
    true → cxfn cxfk-destructor parent virt nil f
    false → cx-find-dtor ds i)
  _ → cx-find-dtor ds i
cx-rec-id : CRecord → Word
cx-rec-id r = case r of
  crecord id name tag lm bases fields layout vtable → id
cx-rec-fields : CRecord → List CField
cx-rec-fields r = case r of
  crecord id name tag lm bases fields layout vtable → fields
cx-rec-bases : CRecord → List CBase
cx-rec-bases r = case r of
  crecord id name tag lm bases fields layout vtable → bases
cx-rec-layout : CRecord → CLayout
cx-rec-layout r = case r of
  crecord id name tag lm bases fields layout vtable → layout
cx-rec-vtable : CRecord → CVTable
cx-rec-vtable r = case r of
  crecord id name tag lm bases fields layout vtable → vtable
cx-rec-lambda : CRecord → Bool
cx-rec-lambda r = case r of
  crecord id name tag lm bases fields layout vtable → lm
cx-rec-union : CRecord → Bool
cx-rec-union r = case r of
  crecord id name tag lm bases fields layout vtable → (case tag of
    ctg-union → true
    _ → false)
-- a class of the unit; one the unit does not hold is a reader's error (the importer writes
-- every class a written declaration needs)
cx-find-rec : List CDecl → Word → MRes CRecord
cx-find-rec nil i = mstop st-ill-typed
cx-find-rec (cons d ds) i = case d of
  cd-record r → (case weq (cx-rec-id r) i of
    true → mok r
    false → cx-find-rec ds i)
  cd-class-template-specialization args r → (case weq (cx-rec-id r) i of
    true → mok r
    false → cx-find-rec ds i)
  _ → cx-find-rec ds i
cx-fld-id : CField → Word
cx-fld-id f = case f of
  cfield id name t off width mut cap init → id
cx-fld-type : CField → CType
cx-fld-type f = case f of
  cfield id name t off width mut cap init → t
cx-fld-bits : CField → Word
cx-fld-bits f = case f of
  cfield id name t off width mut cap init → off
cx-fld-width : CField → CBitWidth
cx-fld-width f = case f of
  cfield id name t off width mut cap init → width
cx-fld-capture : CField → CCapture
cx-fld-capture f = case f of
  cfield id name t off width mut cap init → cap
cx-fld-init : CField → CExpr
cx-fld-init f = case f of
  cfield id name t off width mut cap init → init
cx-find-field : List CField → Word → MRes CField
cx-find-field nil i = mstop st-ill-typed
cx-find-field (cons f fs) i = case weq (cx-fld-id f) i of
  true → mok f
  false → cx-find-field fs i
-- a field with the class it is a member of, by the field's id alone (ids are unique in a unit)
cx-field-in : List CField → Word → CRecord → MRes (CRecord × CField) → MRes (CRecord × CField)
cx-field-in nil i r other = other
cx-field-in (cons f fs) i r other = case weq (cx-fld-id f) i of
  true → mok (r , f)
  false → cx-field-in fs i r other
cx-field-any : List CDecl → Word → MRes (CRecord × CField)
cx-field-any nil i = mstop st-ill-typed
cx-field-any (cons d ds) i = case d of
  cd-record r → cx-field-in (cx-rec-fields r) i r (cx-field-any ds i)
  cd-class-template-specialization args r → cx-field-in (cx-rec-fields r) i r (cx-field-any ds i)
  _ → cx-field-any ds i
-- the field of a closure class that holds a captured variable, or the captured this
cx-cap-var : List CField → Word → MRes CField
cx-cap-var nil i = mstop st-ill-typed
cx-cap-var (cons f fs) i = case cx-fld-capture f of
  ccap-var id → (case weq id i of
    true → mok f
    false → cx-cap-var fs i)
  _ → cx-cap-var fs i
cx-cap-this : List CField → MRes CField
cx-cap-this nil = mstop st-ill-typed
cx-cap-this (cons f fs) = case cx-fld-capture f of
  ccap-this → mok f
  _ → cx-cap-this fs
-- an enumeration's underlying type; an enumerator's value with it
cx-enum-under : List CDecl → Word → MRes CType
cx-enum-under nil i = mstop st-ill-typed
cx-enum-under (cons d ds) i = case d of
  cd-enum id name under scoped es → (case weq id i of
    true → mok under
    false → cx-enum-under ds i)
  _ → cx-enum-under ds i
cx-enumerator-in : List CEnumerator → Word → CType → MRes (CType × CInt) → MRes (CType × CInt)
cx-enumerator-in nil i t other = other
cx-enumerator-in (cons e es) i t other = case e of
  cenumerator id name v → (case weq id i of
    true → mok (t , v)
    false → cx-enumerator-in es i t other)
cx-enumerator : List CDecl → Word → MRes (CType × CInt)
cx-enumerator nil i = mstop st-ill-typed
cx-enumerator (cons d ds) i = case d of
  cd-enum id name under scoped es → cx-enumerator-in es i under (cx-enumerator ds i)
  _ → cx-enumerator ds i
-- a variable of namespace scope
cx-var-id : CVar → Word
cx-var-id v = case v of
  cv-var id name t storage align cexpr nrvo init → id
  cv-parm id name t → id
cx-var-type : CVar → CType
cx-var-type v = case v of
  cv-var id name t storage align cexpr nrvo init → t
  cv-parm id name t → t
cx-find-var : List CDecl → Word → MRes CVar
cx-find-var nil i = mstop st-ill-typed
cx-find-var (cons d ds) i = case d of
  cd-var mangled v → (case weq (cx-var-id v) i of
    true → mok v
    false → cx-find-var ds i)
  _ → cx-find-var ds i

-- ---------------------------------------------------------------- types
-- a type without its top-level qualifiers
cx-strip : CType → CType
cx-strip (ct-builtin b) = ct-builtin b
cx-strip (ct-pointer u) = ct-pointer u
cx-strip (ct-lref u) = ct-lref u
cx-strip (ct-rref u) = ct-rref u
cx-strip (ct-array u n) = ct-array u n
cx-strip (ct-record id) = ct-record id
cx-strip (ct-enum id) = ct-enum id
cx-strip (ct-function ret ps va cn vo rf ne) = ct-function ret ps va cn vo rf ne
cx-strip (ct-member-pointer cls u) = ct-member-pointer cls u
cx-strip (ct-qual cn vo rs u) = cx-strip u
cx-strip ct-nil = ct-nil
cx-strip (ct-cons x xs) = ct-cons x xs
-- the scalar C type of a builtin type; void and Clang's two placeholders have none
cx-cty : CBuiltin → MRes CTy
cx-cty b = case b of
  ctb-void → mstop st-ill-typed
  ctb-bool → mok ct-bool
  ctb-char → mok ct-char
  ctb-schar → mok ct-schar
  ctb-uchar → mok ct-uchar
  ctb-short → mok ct-short
  ctb-ushort → mok ct-ushort
  ctb-int → mok ct-int
  ctb-uint → mok ct-uint
  ctb-long → mok ct-long
  ctb-ulong → mok ct-ulong
  ctb-llong → mok ct-llong
  ctb-ullong → mok ct-ullong
  ctb-int128 → mok ct-int128
  ctb-uint128 → mok ct-uint128
  ctb-double → mok ct-double
  ctb-nullptr → mok ct-ptr
  ctb-bound-member → mstop st-ill-typed
  ctb-builtin-fn → mstop st-ill-typed
-- what a type is, for the rules of evaluation: void; a scalar (arithmetic, enumeration,
-- pointer, nullptr_t, pointer to data member); a class; an array; a reference; a pointer to
-- member function (two words); a function
data CxTC = cxtc-void | cxtc-scalar | cxtc-record (id : Word) | cxtc-array (e : CType) (n : Word)
          | cxtc-ref (t : CType) | cxtc-mfp | cxtc-fn
cx-tc : CType → CxTC
cx-tc (ct-builtin b) = case b of
  ctb-void → cxtc-void
  ctb-bound-member → cxtc-fn
  ctb-builtin-fn → cxtc-fn
  _ → cxtc-scalar
cx-tc (ct-pointer u) = cxtc-scalar
cx-tc (ct-lref u) = cxtc-ref u
cx-tc (ct-rref u) = cxtc-ref u
cx-tc (ct-array u n) = cxtc-array u n
cx-tc (ct-record id) = cxtc-record id
cx-tc (ct-enum id) = cxtc-scalar
cx-tc (ct-function ret ps va cn vo rf ne) = cxtc-fn
cx-tc (ct-member-pointer cls u) = case cx-tc u of
  cxtc-fn → cxtc-mfp
  _ → cxtc-scalar
cx-tc (ct-qual cn vo rs u) = cx-tc u
cx-tc ct-nil = cxtc-void
cx-tc (ct-cons x xs) = cxtc-void
-- the signed integer of a pointer's size (ptrdiff_t; a pointer to data member is one, Itanium
-- C++ ABI 2.3)
cx-ptrdiff-sk : Target → SK
cx-ptrdiff-sk t = sk-int true (case weq (tg-size t ck-ptr) #8 of
  true → iw64
  false → iw32)
-- CType → MTy (lib/mem/layout.cub): a scalar type is its C type at the Target; an enumeration
-- its underlying type; a pointer, and a reference where it has storage, a pointer; a class the
-- record of its id (its layout is the unit's, below); a pointer to data member a ptrdiff_t; a
-- pointer to member function two of them. void and function types are not object types.
cx-mty : Target → List CDecl → CType → MRes MTy
cx-mty t ds (ct-builtin b) = mr-map ty-c (cx-cty b)
cx-mty t ds (ct-pointer u) = mok (ty-c ct-ptr)
cx-mty t ds (ct-lref u) = mok (ty-c ct-ptr)
cx-mty t ds (ct-rref u) = mok (ty-c ct-ptr)
cx-mty t ds (ct-array u n) = mr-map (λ e → ty-arr e n) (cx-mty t ds u)
cx-mty t ds (ct-record id) = mok (ty-rec id)
cx-mty t ds (ct-enum id) = mr-bind (cx-enum-under ds id) (λ u → case cx-strip u of
  ct-builtin b → mr-map ty-c (cx-cty b)
  _ → mstop st-ill-typed)
cx-mty t ds (ct-function ret ps va cn vo rf ne) = mstop st-ill-typed
cx-mty t ds (ct-member-pointer cls u) = case cx-tc u of
  cxtc-fn → mok (ty-arr (ty-sk (cx-ptrdiff-sk t) (tg-align t ck-ptr)) #2)
  _ → mok (ty-sk (cx-ptrdiff-sk t) (tg-align t ck-ptr))
cx-mty t ds (ct-qual cn vo rs u) = cx-mty t ds u
cx-mty t ds ct-nil = mstop st-ill-typed
cx-mty t ds (ct-cons x xs) = mstop st-ill-typed
-- the unit's record layouts (Clang's for the target: the implementation parameters of PLAN
-- 5.1) as lib/mem/layout.cub's table. A bit-field is not a Field there (a Field is whole
-- bytes): the reader takes a bit-field's position from the unit's cfield directly.
cx-lay-fields : List CField → Target → List CDecl → MRes (List Field)
cx-lay-fields nil t ds = mok nil
cx-lay-fields (cons f fs) t ds = case cx-fld-width f of
  cbw-bits n → cx-lay-fields fs t ds
  cbw-none → mr-bind (cx-mty t ds (cx-fld-type f)) (λ ty → mr-map (λ r →
    cons (Field { fd-name = cx-fld-id f ; fd-off = wquot (cx-fld-bits f) #8 ; fd-ty = ty }) r) (cx-lay-fields fs t ds))
cx-lay-bases : List CBase → List Base
cx-lay-bases nil = nil
cx-lay-bases (cons b bs) = case b of
  cbase id off prim virt → cons (Base { bs-id = id ; bs-off = off }) (cx-lay-bases bs)
cx-layout : Target → List CDecl → CRecord → MRes Layout
cx-layout t ds r = case cx-rec-layout r of
  clayout size align dsize nvsize nvalign vptr → mr-map (λ fs →
    Layout { ly-id = cx-rec-id r ; ly-size = size ; ly-align = align ; ly-union = cx-rec-union r
           ; ly-fields = fs ; ly-bases = cx-lay-bases (cx-rec-bases r)
           ; ly-has-vptr = (case vptr of
               cvp-none → false
               cvp-at o → true)
           ; ly-vptr = (case vptr of
               cvp-none → #0
               cvp-at o → o) }) (cx-lay-fields (cx-rec-fields r) t ds)
cx-layenv : List CDecl → Target → List CDecl → MRes LayEnv
cx-layenv nil t all = mok nil
cx-layenv (cons d ds) t all = case d of
  cd-record r → mr-bind (cx-layout t all r) (λ l → mr-map (λ ls → cons l ls) (cx-layenv ds t all))
  cd-class-template-specialization args r → mr-bind (cx-layout t all r) (λ l → mr-map (λ ls → cons l ls) (cx-layenv ds t all))
  _ → cx-layenv ds t all

-- ---------------------------------------------------------------- a unit at its parameters
-- what a reading is a function of besides the unit: the Target; the layouts (the unit's); the
-- order of evaluation where the standard leaves it unspecified (cxu-ltr: the operands of an
-- operator with no sequencing rule, the arguments of a call among themselves: left to right,
-- or right to left); when a parameter's lifetime ends ([expr.call]/6: implementation-defined:
-- cxu-parm-full true: at the end of the enclosing full-expression; false: when the function
-- returns); the fuel of each loop and the fuel of calls (their nesting depth).
record CxU = { cxu-t : Target ; cxu-ds : List CDecl ; cxu-lay : LayEnv ; cxu-ltr : Bool
             ; cxu-parm-full : Bool ; cxu-loop-fuel : Word ; cxu-call-fuel : Word }
cx-unit : Target → CTU → Bool → Bool → Word → Word → MRes CxU
cx-unit t tu ltr pf lf cf = mr-map (λ le →
  CxU { cxu-t = t ; cxu-ds = cx-tu-decls tu ; cxu-lay = le ; cxu-ltr = ltr ; cxu-parm-full = pf
      ; cxu-loop-fuel = lf ; cxu-call-fuel = cf }) (cx-layenv (cx-tu-decls tu) t (cx-tu-decls tu))
cx-size : CxU → CType → MRes Word
cx-size u ty = mr-bind (cx-mty (cxu-t u) (cxu-ds u) ty) (ty-size (cxu-t u) (cxu-lay u))
cx-align : CxU → CType → MRes Word
cx-align u ty = mr-bind (cx-mty (cxu-t u) (cxu-ds u) ty) (ty-align (cxu-t u) (cxu-lay u))
-- the kind of a scalar type and the alignment of its objects
cx-scalar : CxU → CType → MRes (SK × Word)
cx-scalar u ty = mr-bind (cx-mty (cxu-t u) (cxu-ds u) ty) (ty-scalar (cxu-t u))
cx-sk : CxU → CType → MRes SK
cx-sk u ty = mr-map (λ ka → fst ka) (cx-scalar u ty)

-- ---------------------------------------------------------------- memory: the commands the reader uses
-- The reader never touches a memory value (tracks/README.md, "Memory is a signature"): every
-- access is one of the operations of this section and a pointer is abstract outside it. The
-- first group are lib/mem/monad.cub's named operations as they are. The second group are
-- operations the reader needs that the monad does not name yet: each is written here once over
-- lib/mem/memory.cub's function of the same meaning and is listed in tracks/F-cxx.md under
-- "Needs from track M"; when track M's signature of memory commands lands, each becomes that
-- command and nothing outside this section changes.
cx-load : CxU → SK → MPtr → CxEv SV
cx-load u k p = ev-load {lzero} {CxS} {CxR} (cxu-t u) k p
cx-store : CxU → SK → MPtr → SV → CxEv Unit
cx-store u k p v = ev-store {lzero} {CxS} {CxR} (cxu-t u) k p v
cx-alloc : AKind → Bool → Word → Word → CxEv MPtr
cx-alloc kd z size al = ev-alloc {lzero} {CxS} {CxR} kd z size al
cx-release : AKind → MPtr → CxEv Unit
cx-release kd p = ev-release {lzero} {CxS} {CxR} kd p
cx-ptr-add : MPtr → Word → UInt64 → CxEv MPtr
cx-ptr-add p size i = ev-ptr-add {lzero} {CxS} {CxR} p size i
-- (second group: to become commands)
-- a load and a store at an alignment less than the kind's own (a member of a packed record)
cx-load-al : CxU → SK → Word → MPtr → CxEv SV
cx-load-al u k al p = ev-rd {lzero} {CxS} {CxR} {SV} (mem-load-al (cxu-t u) k al p)
cx-store-al : CxU → SK → Word → MPtr → SV → CxEv Unit
cx-store-al u k al p v = ev-wr {lzero} {CxS} {CxR} (mem-store-al (cxu-t u) k al p v)
-- the end of dynamic storage (a null pointer: nothing)
cx-free : MPtr → CxEv Unit
cx-free p = ev-wr {lzero} {CxS} {CxR} (mem-free p)
cx-memmove : MPtr → MPtr → Word → CxEv Unit
cx-memmove dst src n = ev-wr {lzero} {CxS} {CxR} (mem-memmove dst src n)
cx-memcpy : MPtr → MPtr → Word → CxEv Unit
cx-memcpy dst src n = ev-wr {lzero} {CxS} {CxR} (mem-memcpy dst src n)
cx-memset : MPtr → UInt64 → Word → CxEv Unit
cx-memset dst v n = ev-wr {lzero} {CxS} {CxR} (mem-memset dst v n)
cx-ptr-diff : MPtr → MPtr → Word → CxEv UInt64
cx-ptr-diff p q size = ev-rd {lzero} {CxS} {CxR} {UInt64} (mem-ptr-diff p q size)
cx-ptr-cmp : CxU → CmpOp → MPtr → MPtr → CxEv Bool
cx-ptr-cmp u o p q = ev-rd {lzero} {CxS} {CxR} {Bool} (mem-ptr-cmp (cxu-t u) o p q)
-- a conversion between scalar kinds (pointer ↔ integer as the Target allows)
cx-conv : CxU → SK → SK → SV → CxEv SV
cx-conv u from to v = ev-rd {lzero} {CxS} {CxR} {SV} (mem-conv (cxu-t u) from to v)
-- the null pointer, the pointer to a function of the unit, and the function a pointer is to
-- (a call through a pointer that is not to a function is undefined)
cx-null : MPtr
cx-null = mp-null
cx-fn-ptr : Word → MPtr
cx-fn-ptr f = mp-fn f
cx-fn-of : MPtr → CxEv Word
cx-fn-of p = case p of
  mp-fn f → cx-ret {Word} f
  mp-null → cx-ub {Word} ub-null
  mp-obj a o → cx-ub {Word} ub-fn-as-object
  mp-addr x → cx-ub {Word} ub-fn-as-object
-- (end of the section: nothing below names a constructor of MPtr or a field of the memory)
cx-is-null : CxU → MPtr → CxEv Bool
cx-is-null u p = cx-ptr-cmp u co-eq p cx-null
-- an automatic object of a size and alignment for the extent of a computation
cx-local : {A : Type} → Word → Word → (MPtr → CxEv A) → CxEv A
cx-local {A} size al body =
  cx-bind {MPtr} {A} (cx-alloc ak-auto false size al) (λ p →
    cx-finally {A} (body p) (cx-release ak-auto p))
-- the subobject at a byte offset of the object at a pointer (a member, a base), and back from
-- a base subobject to the object it is in: pointer arithmetic in bytes
cx-sub : MPtr → Word → CxEv MPtr
cx-sub p off = cx-ptr-add p #1 (uq-of-word off)
cx-super : MPtr → Word → CxEv MPtr
cx-super p off = cx-ptr-add p #1 (uq-neg (uq-of-word off))

-- ---------------------------------------------------------------- values
-- an integer written in the unit (a literal's magnitude, a constant's sign and magnitude) at a kind
cx-dq-of-word : Word → DQ
cx-dq-of-word v = (uq-of-word v , uq-of-word (wshr v #64))
cx-lit : SK → DQ → MRes SV
cx-lit k d = case k of
  sk-int sg w → mok (dq-to-int sg w d)
  sk-bool → mok (sv-b (not (dq-iszero d)))
  sk-f32 → mstop st-ill-typed
  sk-f64 → mstop st-ill-typed
  sk-ptr → mstop st-ill-typed
cx-cint : CInt → DQ
cx-cint c = case c of
  cint-pos n → cx-dq-of-word n
  cint-neg n → dq-neg (cx-dq-of-word n)
-- the results an expression's rule expects of its operands; anything else is a reader's error
cx-as-val : CxR → CxEv SV
cx-as-val r = case r of
  cxr-val v → cx-ret {SV} v
  _ → cx-stop {SV} st-ill-typed
cx-as-ptr : CxR → CxEv MPtr
cx-as-ptr r = case r of
  cxr-val v → cx-res {MPtr} (sv-as-p v)
  _ → cx-stop {MPtr} st-ill-typed
cx-as-lv : CxR → CxEv MPtr
cx-as-lv r = case r of
  cxr-lv p al → cx-ret {MPtr} p
  _ → cx-stop {MPtr} st-ill-typed

-- ---------------------------------------------------------------- the environment of a reading
-- what a declaration id denotes while a function runs. A variable (a local, a parameter, a
-- variable of static storage) is the object at an address; a reference is bound to its
-- referent's address directly and has no object of its own (cxb-obj), except a reference of
-- static storage, which is initialized when control first passes its declaration and so has a
-- pointer-sized object holding the referent's address (cxb-ref).
data CxBind = cxb-obj (p : MPtr) (al : Word) | cxb-ref (p : MPtr)
-- the unit's objects of static storage once allocated: variables by id; for a block-scope
-- static with dynamic initialization, its guard (a byte: 0 before the initialization
-- completes, [stmt.dcl]/3); the vtable of each polymorphic class by the class's id
record CxG = { cxg-vars : List (Word × CxBind) ; cxg-guards : List (Word × MPtr) ; cxg-vts : List (Word × MPtr) }
-- a function's activation: its locals and parameters by id; this; the closure class when the
-- function is a lambda's call operator (0 otherwise: a captured variable, and this, are then
-- members of *this, tracks/C-clang.md); the result object of a function returning a class
record CxEnv = { cxe-g : CxG ; cxe-locals : List (Word × CxBind) ; cxe-this : MPtr
               ; cxe-closure : Word ; cxe-result : MPtr }
cx-lookup : List (Word × CxBind) → Word → MRes CxBind
cx-lookup nil i = mstop st-ill-typed
cx-lookup (cons b bs) i = case weq (fst b) i of
  true → mok (snd b)
  false → cx-lookup bs i
cx-has : List (Word × CxBind) → Word → Bool
cx-has nil i = false
cx-has (cons b bs) i = case weq (fst b) i of
  true → true
  false → cx-has bs i
cx-lookup-ptr : List (Word × MPtr) → Word → MRes MPtr
cx-lookup-ptr nil i = mstop st-ill-typed
cx-lookup-ptr (cons b bs) i = case weq (fst b) i of
  true → mok (snd b)
  false → cx-lookup-ptr bs i
cx-env-bind : CxEnv → Word → CxBind → CxEnv
cx-env-bind e i b = CxEnv { cxe-g = cxe-g e ; cxe-locals = cons (i , b) (cxe-locals e) ; cxe-this = cxe-this e
                          ; cxe-closure = cxe-closure e ; cxe-result = cxe-result e }
-- calling a function of the unit: its id (for a destructor through a deleting slot, see
-- read.cub), the object for a member, the parameter objects, the result object
CxCall : Type 1
CxCall = Word → MPtr → List MPtr → MPtr → CxEv CxR
