-- lib/cxx/ast.cub — Clang's AST after semantic analysis, as plain first-order data (PLAN §6
-- Phase 4 item 2; tracks/C-clang.md). GENERATED by `python3 tools/clang2cub.py --emit-ast`: the
-- schema in that file is the one description of these constructors, and every unit it writes
-- (experiments/cxx/*.cub) is a value of CTU built against it. Loaded after lib/prim.cub.
--
-- A constructor exists for each Clang node kind, cast kind, operator and builtin type the
-- importer has met in the units imported so far; an unmet kind stops the import, and the
-- constructor is added then. Declaration ids are Words, unique within a unit. Clang's Sema is
-- the oracle for a value of this type: "the AST written is the AST Sema produced" is trusted.
--
-- The checker has no mutual data and rejects `List D` as a field of `data D`, so the three
-- recursive types carry their own list constructors (ct-nil/ct-cons, ce-nil/ce-cons,
-- cs-nil/cs-cons): a field documented as a list of expressions is a CExpr built from those two,
-- and one function recursing structurally over CExpr reads both nodes and lists. An absent
-- expression child is ce-nil, an absent statement child cs-none.

-- ---------------------------------------------------------------- strings
-- A string is its length and its bytes. There is no byte-string literal: cstr builds one from
-- the list of its bytes. cstr-put is %store8 (bounds-checked by the machine: a store outside
-- the string leaves it unchanged), trusted like the stores of lib/prim.cub.
primitive cstr-put : (n : Nat) → Bytes n → Word → Word → Bytes n = λ n b off v → %store8 b off (%u32ofw v)
CStr : Type
CStr = (n : Nat) × Bytes n
cstr-fill : (n : Nat) → List Word → Word → Bytes n → Bytes n
cstr-fill n nil off b = b
cstr-fill n (cons c cs) off b = cstr-fill n cs (wadd off #1) (cstr-put n b off c)
cstr-len : List Word → Nat
cstr-len nil = zero
cstr-len (cons c cs) = suc (cstr-len cs)
cstr : List Word → CStr
cstr cs = (cstr-len cs , cstr-fill (cstr-len cs) cs #0 (bytes (cstr-len cs)))
-- reading a string: its length, the byte at an index (0 outside the string: %load8 is
-- bounds-checked by the machine; trusted like cstr-put), and whether it is exactly these bytes
primitive cstr-get : (n : Nat) → Bytes n → Word → Word = λ n b off → %wofu32 (%load8 b off)
cstr-length : CStr → Word
cstr-length s = fromNat (fst s)
cstr-at : CStr → Word → Word
cstr-at s i = cstr-get (fst s) (snd s) i
cstr-count : List Word → Word
cstr-count nil = #0
cstr-count (cons c cs) = wadd #1 (cstr-count cs)
cstr-from : (n : Nat) → Bytes n → List Word → Word → Bool
cstr-from n b nil off = true
cstr-from n b (cons c cs) off = case weq (cstr-get n b off) c of
  true → cstr-from n b cs (wadd off #1)
  false → false
cstr-is : CStr → List Word → Bool
cstr-is s cs = case weq (cstr-length s) (cstr-count cs) of
  true → cstr-from (fst s) (snd s) cs #0
  false → false

-- ---------------------------------------------------------------- the AST
-- CInt: an integer value: its magnitude and sign (the type beside it gives the width)
data CInt = cint-pos (n : Word) | cint-neg (n : Word)
-- COptId: a declaration id that may be absent
data COptId = coi-none | coi-some (id : Word)
-- CBuiltin: Clang's BuiltinType kinds met
data CBuiltin =
    ctb-void
  | ctb-bool
  | ctb-char
  | ctb-schar
  | ctb-uchar
  | ctb-short
  | ctb-ushort
  | ctb-int
  | ctb-uint
  | ctb-long
  | ctb-ulong
  | ctb-llong
  | ctb-ullong
  | ctb-int128
  | ctb-uint128
  | ctb-float
  | ctb-double
  | ctb-ldouble
  | ctb-wchar
  | ctb-char8
  | ctb-char16
  | ctb-char32
  | ctb-nullptr
  | ctb-bound-member
  | ctb-builtin-fn
-- CRefQual: the ref-qualifier of a function type
data CRefQual = crq-none | crq-lvalue | crq-rvalue
-- CType: a type, structured; ct-nil/ct-cons build the parameter list of ct-function
data CType =
    ct-builtin (b : CBuiltin)
  | ct-pointer (t : CType)
  | ct-lref (t : CType)
  | ct-rref (t : CType)
  | ct-array (t : CType) (n : Word)
  | ct-record (id : Word)
  | ct-enum (id : Word)
  | ct-function (ret : CType) (params : CType) (variadic : Bool) (const : Bool) (volatile : Bool) (ref : CRefQual) (noexcept : Bool)
  | ct-member-pointer (class : Word) (t : CType)
  | ct-qual (const : Bool) (volatile : Bool) (restrict : Bool) (t : CType)
  | ct-nil
  | ct-cons (x : CType) (xs : CType)
-- CValCat: value categories
data CValCat = vc-prvalue | vc-lvalue | vc-xvalue
-- CCastKind: Clang's cast kinds met
data CCastKind =
    ck-LValueToRValue
  | ck-NoOp
  | ck-FunctionToPointerDecay
  | ck-ArrayToPointerDecay
  | ck-IntegralCast
  | ck-IntegralToBoolean
  | ck-BitCast
  | ck-DerivedToBase
  | ck-UncheckedDerivedToBase
  | ck-NullToPointer
  | ck-ToVoid
  | ck-BuiltinFnToFnPtr
  | ck-ConstructorConversion
  | ck-PointerToBoolean
  | ck-NullToMemberPointer
  | ck-UserDefinedConversion
  | ck-IntegralToFloating
  | ck-FloatingToIntegral
  | ck-FloatingCast
  | ck-BaseToDerived
  | ck-Dynamic
-- CUnOp: unary operators met
data CUnOp =
    uo-post-inc
  | uo-post-dec
  | uo-pre-inc
  | uo-pre-dec
  | uo-addr-of
  | uo-deref
  | uo-plus
  | uo-minus
  | uo-not
  | uo-lnot
-- CBinOp: binary operators met (a compound assignment names the operator applied)
data CBinOp =
    cbo-mul
  | cbo-div
  | cbo-rem
  | cbo-add
  | cbo-sub
  | cbo-shl
  | cbo-shr
  | cbo-lt
  | cbo-gt
  | cbo-le
  | cbo-ge
  | cbo-eq
  | cbo-ne
  | cbo-and
  | cbo-xor
  | cbo-or
  | cbo-land
  | cbo-lor
  | cbo-assign
  | cbo-comma
  | cbo-ptr-mem-d
  | cbo-ptr-mem-i
-- CRefKind: the kind of declaration a reference names
data CRefKind = crk-function | crk-method | crk-var | crk-parm | crk-enum-constant | crk-field
-- CConstructKind: what a constructor call constructs
data CConstructKind = cck-complete | cck-non-virtual-base | cck-delegating | cck-virtual-base
-- CStorageDuration: the storage duration of a materialized temporary
data CStorageDuration = csd-full-expression | csd-automatic | csd-static
-- CTraitKind: sizeof, alignof
data CTraitKind = ctk-sizeof | ctk-alignof
-- CAtomicOp: the operation of an AtomicExpr, by Clang's builtin name
data CAtomicOp =
    cao-atomic-load
  | cao-atomic-load-n
  | cao-atomic-store-n
  | cao-atomic-exchange-n
  | cao-atomic-compare-exchange-n
  | cao-atomic-fetch-add
  | cao-atomic-fetch-sub
-- CNewInit: the initializer style of a new-expression
data CNewInit = cni-none | cni-parens | cni-braces
-- CExpr: an expression; every node has its type and value category. One constructor per Clang Expr kind met; ce-nil/ce-cons build argument and initializer lists
data CExpr =
    ce-integer-literal (t : CType) (vc : CValCat) (v : Word)
  | ce-character-literal (t : CType) (vc : CValCat) (v : Word)
  | ce-bool-literal (t : CType) (vc : CValCat) (v : Bool)
  | ce-floating-literal (t : CType) (vc : CValCat) (bits : Word)
  | ce-string-literal (t : CType) (vc : CValCat) (s : CStr)
  | ce-string-literal-units (t : CType) (vc : CValCat) (units : List Word)
  | ce-nullptr-literal (t : CType) (vc : CValCat)
  | ce-declref (t : CType) (vc : CValCat) (k : CRefKind) (id : Word)
  | ce-member (t : CType) (vc : CValCat) (base : CExpr) (arrow : Bool) (qualified : Bool) (k : CRefKind) (id : Word)
  | ce-call (t : CType) (vc : CValCat) (callee : CExpr) (args : CExpr)
  | ce-member-call (t : CType) (vc : CValCat) (callee : CExpr) (args : CExpr)
  | ce-operator-call (t : CType) (vc : CValCat) (callee : CExpr) (args : CExpr)
  | ce-construct (t : CType) (vc : CValCat) (ctor : Word) (k : CConstructKind) (elidable : Bool) (list : Bool) (zeroing : Bool) (args : CExpr)
  | ce-temporary-object (t : CType) (vc : CValCat) (ctor : Word) (k : CConstructKind) (elidable : Bool) (list : Bool) (zeroing : Bool) (args : CExpr)
  | ce-implicit-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-static-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-reinterpret-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-functional-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-cstyle-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-unary (t : CType) (vc : CValCat) (op : CUnOp) (e : CExpr)
  | ce-binary (t : CType) (vc : CValCat) (op : CBinOp) (l : CExpr) (r : CExpr)
  | ce-compound-assign (t : CType) (vc : CValCat) (op : CBinOp) (lhs-type : CType) (result-type : CType) (l : CExpr) (r : CExpr)
  | ce-conditional (t : CType) (vc : CValCat) (c : CExpr) (a : CExpr) (b : CExpr)
  | ce-paren (t : CType) (vc : CValCat) (e : CExpr)
  | ce-array-subscript (t : CType) (vc : CValCat) (base : CExpr) (index : CExpr)
  | ce-init-list (t : CType) (vc : CValCat) (union-field : COptId) (filler : CExpr) (inits : CExpr)
  | ce-implicit-value-init (t : CType) (vc : CValCat)
  | ce-default-init (t : CType) (vc : CValCat) (field : Word)
  | ce-default-arg (t : CType) (vc : CValCat) (parm : Word)
  | ce-this (t : CType) (vc : CValCat)
  | ce-materialize-temporary (t : CType) (vc : CValCat) (sd : CStorageDuration) (extending : COptId) (e : CExpr)
  | ce-with-cleanups (t : CType) (vc : CValCat) (e : CExpr)
  | ce-constant (t : CType) (vc : CValCat) (v : CInt) (e : CExpr)
  | ce-lambda (t : CType) (vc : CValCat) (closure : Word) (captures : CExpr)
  | ce-unary-or-type-trait (t : CType) (vc : CValCat) (k : CTraitKind) (arg-type : CType) (arg : CExpr)
  | ce-subst-nttp (t : CType) (vc : CValCat) (e : CExpr)
  | ce-rewritten-binary (t : CType) (vc : CValCat) (e : CExpr)
  | ce-throw (t : CType) (vc : CValCat) (e : CExpr)
  | ce-bind-temporary (t : CType) (vc : CValCat) (dtor : Word) (e : CExpr)
  | ce-dynamic-cast (t : CType) (vc : CValCat) (k : CCastKind) (path : List Word) (e : CExpr)
  | ce-typeid (t : CType) (vc : CValCat) (arg-type : CType) (arg : CExpr)
  | ce-noexcept (t : CType) (vc : CValCat) (e : CExpr)
  | ce-atomic (t : CType) (vc : CValCat) (op : CAtomicOp) (args : CExpr)
  | ce-std-initializer-list (t : CType) (vc : CValCat) (e : CExpr)
  | ce-new (t : CType) (vc : CValCat) (global : Bool) (array : Bool) (operator-new : COptId) (init-style : CNewInit) (array-size : CExpr) (placement : CExpr) (init : CExpr)
  | ce-delete (t : CType) (vc : CValCat) (global : Bool) (array : Bool) (operator-delete : COptId) (e : CExpr)
  | ce-nil
  | ce-cons (x : CExpr) (xs : CExpr)
-- CStorage: storage class as written
data CStorage =
    cst-none
  | cst-static
  | cst-extern
  | cst-thread-local
  | cst-static-thread-local
  | cst-extern-thread-local
-- CVarInit: the initializer of a variable, by its style
data CVarInit = cvi-none | cvi-c (e : CExpr) | cvi-call (e : CExpr) | cvi-list (e : CExpr)
-- CAlign: an alignment specifier on a variable: a number of bytes, or as of a type
data CAlign = cal-none | cal-bytes (n : Word) | cal-type (t : CType)
-- CVar: VarDecl and ParmVarDecl (with its default argument, ce-nil when it has none)
data CVar =
    cv-var (id : Word) (name : CStr) (t : CType) (storage : CStorage) (align : CAlign) (constexpr : Bool) (nrvo : Bool) (init : CVarInit)
  | cv-parm (id : Word) (name : CStr) (t : CType) (default : CExpr)
-- CStmt: a statement. One constructor per Clang Stmt kind met; cs-expr is an expression in statement position; cs-none an absent child; cs-nil/cs-cons the children of cs-compound and the handlers of cs-try (each a cs-catch, whose var is empty for catch (...))
data CStmt =
    cs-compound (ss : CStmt)
  | cs-decl (vars : List CVar)
  | cs-expr (e : CExpr)
  | cs-if (init : CStmt) (cond-var : CStmt) (cond : CExpr) (then-s : CStmt) (else-s : CStmt)
  | cs-if-constexpr (init : CStmt) (cond-var : CStmt) (cond : CExpr) (then-s : CStmt) (else-s : CStmt)
  | cs-while (cond-var : CStmt) (cond : CExpr) (body : CStmt)
  | cs-do (body : CStmt) (cond : CExpr)
  | cs-for (init : CStmt) (cond-var : CStmt) (cond : CExpr) (inc : CExpr) (body : CStmt)
  | cs-for-range (init : CStmt) (range : CStmt) (begin : CStmt) (end : CStmt) (cond : CExpr) (inc : CExpr) (loop-var : CStmt) (body : CStmt)
  | cs-return (e : CExpr)
  | cs-break
  | cs-continue
  | cs-switch (init : CStmt) (cond-var : CStmt) (cond : CExpr) (body : CStmt)
  | cs-case (value : CExpr) (s : CStmt)
  | cs-default (s : CStmt)
  | cs-try (body : CStmt) (handlers : CStmt)
  | cs-catch (var : List CVar) (body : CStmt)
  | cs-goto (label : Word)
  | cs-label (id : Word) (name : CStr) (s : CStmt)
  | cs-null
  | cs-none
  | cs-nil
  | cs-cons (x : CStmt) (xs : CStmt)
-- CTag: struct, class, union
data CTag = ctg-struct | ctg-class | ctg-union
-- CBitWidth: a bit-field width
data CBitWidth = cbw-none | cbw-bits (n : Word)
-- CCapture: what a field of a lambda's closure class holds: inside the lambda's body a reference to that variable of the enclosing function, or `this`, is this field; ccap-init is an init-capture, whose variable (the id) exists only as this field
data CCapture = ccap-none | ccap-var (id : Word) | ccap-init (id : Word) | ccap-this
-- CField: FieldDecl: offset in bits from the record layout; the default member initializer (ce-nil when absent)
data CField =
    cfield (id : Word) (name : CStr) (t : CType) (offset-bits : Word) (width : CBitWidth) (mutable : Bool) (capture : CCapture) (init : CExpr)
-- CBase: a direct base class with its offset in bytes from the record layout
data CBase = cbase (base : Word) (offset : Word) (primary : Bool) (virtual : Bool)
-- CVPtr: the vtable pointer's offset in bytes, when the record has its own
data CVPtr = cvp-none | cvp-at (offset : Word)
-- COptInt: an integer that may be absent
data COptInt = coin-none | coin-some (v : CInt)
-- CVTEntry: one vtable slot, as the target ABI lays it out. cvt-thunk is a slot that holds a thunk to the function of the entry inside: `this` adjusted by this-nv bytes and then, when this-vcall is there, by the vcall offset stored that many bytes from the vtable address; the result adjusted by ret-nv and, when ret-vbase is there, by the virtual base offset stored that many bytes from the result's vtable address
data CVTEntry =
    cvt-offset-to-top (v : CInt)
  | cvt-rtti
  | cvt-method (id : Word)
  | cvt-pure (id : Word)
  | cvt-complete-dtor (id : Word)
  | cvt-deleting-dtor (id : Word)
  | cvt-vbase-offset (v : CInt)
  | cvt-vcall-offset (v : CInt)
  | cvt-thunk (e : CVTEntry) (this-nv : CInt) (this-vcall : COptInt) (ret-nv : CInt) (ret-vbase : COptInt)
-- CVAddrPoint: an address point of a vtable: the vtable pointer of the base subobject `base` at `offset` bytes addresses the slot `index`
data CVAddrPoint = cvap (base : Word) (offset : Word) (index : Word)
-- CVBaseOffsetOffset: where a vtable holds the offset of a virtual base: `at` bytes from the address point
data CVBaseOffsetOffset = cvboo (vbase : Word) (at : CInt)
-- CCtorVTable: a construction vtable: the vtable of the base subobject `base` at `offset` while the complete object is under construction
data CCtorVTable =
    cctor-vtable (base : Word) (offset : Word) (address-points : List CVAddrPoint) (entries : List CVTEntry)
-- CVTTEntry: an entry of the VTT: a slot index in the class's own vtable, or in the construction vtable of the base at that offset
data CVTTEntry = cvtt-own (index : Word) | cvtt-construction (base : Word) (offset : Word) (index : Word)
-- CVTable: a record's vtable. cvtable: the slots and the one index the object's vtable pointer addresses, for a vtable this unit emits that has one address point and no thunks. cvtable-full: every other vtable: whether this unit emits it (false: its key function is defined in another unit, or nothing here refers to it), its address points, slots, virtual base offset offsets, VTT, construction vtables; with no slots at all: a polymorphic class Clang laid out no vtable for in this unit (nothing here constructs it or calls a virtual function of it)
data CVTable =
    cvt-none
  | cvtable (address-point : Word) (entries : List CVTEntry)
  | cvtable-full (emitted : Bool) (address-points : List CVAddrPoint) (entries : List CVTEntry) (vbase-offsets : List CVBaseOffsetOffset) (vtt : List CVTTEntry) (construction : List CCtorVTable)
-- CVBase: a virtual base (direct or not) with its offset in bytes in an object whose most derived class is this one
data CVBase = cvbase (base : Word) (offset : Word)
-- CLayout: the record's layout on the target, in bytes: the implementation parameters of PLAN 5.1. clayout-v is the layout of a class with virtual bases
data CLayout =
    clayout (size : Word) (align : Word) (dsize : Word) (nvsize : Word) (nvalign : Word) (vptr : CVPtr)
  | clayout-v (size : Word) (align : Word) (dsize : Word) (nvsize : Word) (nvalign : Word) (vptr : CVPtr) (vbases : List CVBase)
-- CRecord: the definition of a class
data CRecord =
    crecord (id : Word) (name : CStr) (tag : CTag) (lambda : Bool) (bases : List CBase) (fields : List CField) (layout : CLayout) (vtable : CVTable)
-- CTArg: a template argument of a specialization
data CTArg = cta-type (t : CType) | cta-integral (v : CInt)
-- CEnumerator: EnumConstantDecl with its value
data CEnumerator = cenumerator (id : Word) (name : CStr) (v : CInt)
-- CBody: the body of a function
data CBody = cfb-none | cfb-defaulted | cfb-pure | cfb-stmt (s : CStmt)
-- CCtorInit: CXXCtorInitializer, in the order of initialization
data CCtorInit =
    cci-field (field : Word) (e : CExpr)
  | cci-base (t : CType) (e : CExpr)
  | cci-delegating (e : CExpr)
-- CFunction: what every function declaration has
data CFunction =
    cfunction (id : Word) (name : CStr) (mangled : CStr) (t : CType) (params : List CVar) (storage : CStorage) (inline : Bool) (constexpr : Bool) (implicit : Bool) (body : CBody)
-- CDecl: a declaration of the unit. One constructor per Clang Decl kind met at the top level (members are listed flat, with the id of their class). cd-var-dynamic is a variable of static storage that the unit's start-up code initializes (Clang did not make its initializer a constant), in the order of the unit's `statics`
data CDecl =
    cd-function (f : CFunction)
  | cd-method (parent : Word) (virtual : Bool) (f : CFunction)
  | cd-constructor (parent : Word) (inits : List CCtorInit) (f : CFunction)
  | cd-destructor (parent : Word) (virtual : Bool) (f : CFunction)
  | cd-conversion (parent : Word) (virtual : Bool) (f : CFunction)
  | cd-record (r : CRecord)
  | cd-class-template-specialization (args : List CTArg) (r : CRecord)
  | cd-enum (id : Word) (name : CStr) (underlying : CType) (scoped : Bool) (enumerators : List CEnumerator)
  | cd-var (mangled : CStr) (v : CVar)
  | cd-var-dynamic (mangled : CStr) (v : CVar)
  | cd-var-template-specialization (args : List CTArg) (mangled : CStr) (v : CVar)
-- CTU: the translation unit: its name, the target, the ids of its roots, the ids of its variables of static storage in the order of their definitions, its declarations
data CTU = ctu (name : CStr) (target : CStr) (roots : List Word) (statics : List Word) (decls : List CDecl)
