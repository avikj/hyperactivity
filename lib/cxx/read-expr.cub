-- lib/cxx/read-expr.cub — the meaning of every expression of the AST (tracks/F-cxx.md item 2).
-- Loaded after lib/cxx/machine.cub. cx-expr, at the end, is one structural recursion over CExpr
-- (nodes and the ce-nil/ce-cons lists); each of its cases hands the meanings of the
-- sub-expressions to a rule written before it. Clause references are to C++20 (N4860).

-- ---------------------------------------------------------------- what is asked of an expression
-- a place an initializer list or a closure fills: a type at a bit offset from the object, a
-- bit-field's width, and the alignment the place has (0: the type's own)
data CxSlot = cxsl (t : CType) (bits : Word) (width : CBitWidth) (al : Word)
-- cxm-get      the expression's result by its category: a scalar prvalue's value, a glvalue's
--              address, nothing for void; a class or array prvalue is materialized as a
--              temporary of the full-expression and its address given ([class.temporary]/2)
-- cxm-init p   the expression initializes the object at p (a class or array prvalue's result
--              object, [basic.lval]/5); the answer is cxr-void
-- cxm-args     (on a list) each expression initializes a new parameter object of the matching
--              type ([expr.call]/7); ltr: the first argument first
-- cxm-vals     (on a list) each expression by cxm-get, in the unit's order
-- cxm-oper     (on a list) the first expression is the object of a member operator function,
--              the rest its arguments; ltr: the object first
-- cxm-inits    (on a list) each expression initializes the matching slot of the object at p,
--              in order ([dcl.init.list]/4)
data CxMode = cxm-get | cxm-init (p : MPtr) | cxm-args (ps : List CType) (ltr : Bool) | cxm-vals
            | cxm-oper (ps : List CType) (ltr : Bool) | cxm-inits (p : MPtr) (slots : List CxSlot)
-- the meaning of a sub-expression; the reader's two ways out of structural recursion (a call
-- of a function of the unit; a field's default member initializer, an expression of another
-- declaration), both tied by fuel in read.cub
CxSub : Type 1
CxSub = CxEnv → CxMode → CxK → CxEv CxR
CxDInit : Type 1
CxDInit = Word → CxEnv → CxMode → CxK → CxEv CxR
CxH : Type 1
CxH = CxCall × CxDInit

-- ---------------------------------------------------------------- an expression's type and category
cx-etype : CExpr → CType
cx-etype e = case e of
  ce-integer-literal t vc v → t
  ce-character-literal t vc v → t
  ce-bool-literal t vc v → t
  ce-floating-literal t vc v → t
  ce-string-literal t vc s → t
  ce-nullptr-literal t vc → t
  ce-declref t vc k id → t
  ce-member t vc b ar q k id → t
  ce-call t vc c as → t
  ce-member-call t vc c as → t
  ce-operator-call t vc c as → t
  ce-construct t vc ct k el ls z as → t
  ce-temporary-object t vc ct k el ls z as → t
  ce-implicit-cast t vc k pa x → t
  ce-static-cast t vc k pa x → t
  ce-reinterpret-cast t vc k pa x → t
  ce-functional-cast t vc k pa x → t
  ce-cstyle-cast t vc k pa x → t
  ce-unary t vc op x → t
  ce-binary t vc op l r → t
  ce-compound-assign t vc op lt rt l r → t
  ce-conditional t vc c a b → t
  ce-paren t vc x → t
  ce-array-subscript t vc b i → t
  ce-init-list t vc uf fl is → t
  ce-implicit-value-init t vc → t
  ce-default-init t vc f → t
  ce-this t vc → t
  ce-materialize-temporary t vc sd ex x → t
  ce-with-cleanups t vc x → t
  ce-constant t vc v x → t
  ce-lambda t vc cl cs → t
  ce-unary-or-type-trait t vc k at x → t
  ce-subst-nttp t vc x → t
  ce-new t vc g ar on st sz pl i → t
  ce-delete t vc g ar od x → t
  ce-nil → ct-nil
  ce-cons x xs → ct-nil
cx-count : CExpr → Word
cx-count (ce-cons x xs) = wadd #1 (cx-count xs)
cx-count e = #0

-- ---------------------------------------------------------------- types of operands
cx-pointee : CType → CType
cx-pointee (ct-pointer u) = u
cx-pointee (ct-qual cn vo rs u) = cx-pointee u
cx-pointee t = ct-nil
cx-unref : CType → CType
cx-unref (ct-lref u) = u
cx-unref (ct-rref u) = u
cx-unref (ct-qual cn vo rs u) = cx-unref u
cx-unref t = t
cx-is-ptr : CType → Bool
cx-is-ptr (ct-pointer u) = true
cx-is-ptr (ct-qual cn vo rs u) = cx-is-ptr u
cx-is-ptr t = false
cx-rec-of : CType → MRes Word
cx-rec-of (ct-record id) = mok id
cx-rec-of (ct-qual cn vo rs u) = cx-rec-of u
cx-rec-of t = mstop st-ill-typed
-- the C type of an arithmetic or enumeration type (for the usual arithmetic conversions)
cx-cty-of : CxU → CType → MRes CTy
cx-cty-of u ty = mr-bind (cx-mty (cxu-t u) (cxu-ds u) ty) (λ m → case m of
  ty-c c → mok c
  ty-sk k al → mstop st-ill-typed
  ty-arr e n → mstop st-ill-typed
  ty-rec i → mstop st-ill-typed)
cx-wsize : CxU → Word
cx-wsize u = tg-size (cxu-t u) ck-ptr
cx-pd : CxU → SK
cx-pd u = cx-ptrdiff-sk (cxu-t u)

-- ---------------------------------------------------------------- scalar objects
cx-ld : CxU → CType → Word → MPtr → CxEv SV
cx-ld u ty al p = cx-bind {SK × Word} {SV} (cx-res {SK × Word} (cx-scalar u ty)) (λ ka → case weq al #0 of
  true → cx-load u (fst ka) p
  false → cx-load-al u (fst ka) al p)
cx-st : CxU → CType → Word → MPtr → SV → CxEv Unit
cx-st u ty al p v = cx-bind {SK × Word} {Unit} (cx-res {SK × Word} (cx-scalar u ty)) (λ ka → case weq al #0 of
  true → cx-store u (fst ka) p v
  false → cx-store-al u (fst ka) al p v)
-- a bit-field ([class.bit]): width bits starting at a bit of the byte at p. The allocation of
-- bit-fields within a class object is implementation-defined; this is the x86-64 psABI's
-- (little-endian: bit b of the field's storage is bit b mod 8 of byte b / 8); a big-endian
-- Target's is another and is not written (the reading stops: Limits)
cx-bf-mask : Word → UInt64
cx-bf-mask w = case weq w #64 of
  true → uq-ones
  false → u64sub (u64shl uq1 (u64 w)) uq1
cx-bf-n : Word → Word → Word
cx-bf-n bit w = wquot (wadd (wadd bit w) #7) #8
cx-bf-raw : CxU → MPtr → Word → CxEv UInt64
cx-bf-raw u p n =
  %welimP (λ x → CxEv UInt64) n (cx-ret {UInt64} uq0)
    (λ j acc → cx-bind {UInt64} {UInt64} acc (λ a →
       cx-bind {MPtr} {UInt64} (cx-ptr-add p #1 (uq-of-word j)) (λ q →
       cx-bind {SV} {UInt64} (cx-load u (sk-int false iw8) q) (λ b →
       cx-bind {UInt64} {UInt64} (cx-res {UInt64} (sv-as-i b)) (λ x →
         cx-ret {UInt64} (u64or a (u64shl x (u64 (wmul j #8)))))))))
cx-bf-put : CxU → MPtr → Word → UInt64 → CxEv Unit
cx-bf-put u p n v =
  %welimP (λ x → CxEv Unit) n (cx-ret {Unit} unit)
    (λ j acc → cx-then {Unit} {Unit} acc (
       cx-bind {MPtr} {Unit} (cx-ptr-add p #1 (uq-of-word j)) (λ q →
         cx-store u (sk-int false iw8) q (sv-i (u64and (u64shr v (u64 (wmul j #8))) (u64 #255))))))
cx-bf-ok : CxU → Word → Word → Bool
cx-bf-ok u bit w = case tg-endian (cxu-t u) of
  en-little → not (wlt #8 (cx-bf-n bit w))
  en-big → false
-- the value of a bit-field at its declared type: the bits, extended by the type's sign
cx-bf-val : SK → Word → UInt64 → MRes SV
cx-bf-val k w x = case k of
  sk-int sg iw → (case sg of
    false → mok (sv-i x)
    true → (case weq w #64 of
      true → mok (sv-i x)
      false → mok (sv-i (uq-sar (u64shl x (u64 (wsub #64 w))) (u64 (wsub #64 w))))))
  sk-bool → mok (sv-b (not (uq-iszero x)))
  sk-f32 → mstop st-ill-typed
  sk-f64 → mstop st-ill-typed
  sk-ptr → mstop st-ill-typed
cx-bf-load : CxU → CType → MPtr → Word → Word → CxEv SV
cx-bf-load u ty p bit w = case cx-bf-ok u bit w of
  false → cx-stop {SV} st-unsupported
  true → cx-bind {SK} {SV} (cx-res {SK} (cx-sk u ty)) (λ k →
    cx-bind {UInt64} {SV} (cx-bf-raw u p (cx-bf-n bit w)) (λ raw →
      cx-res {SV} (cx-bf-val k w (u64and (u64shr raw (u64 bit)) (cx-bf-mask w)))))
cx-bf-bits : SV → MRes UInt64
cx-bf-bits v = case v of
  sv-i x → mok x
  sv-b b → mok (uq-b b)
  sv-w lo hi → mstop st-ill-typed
  sv-f x → mstop st-ill-typed
  sv-d x → mstop st-ill-typed
  sv-p p → mstop st-ill-typed
-- storing keeps the low width bits of the value ([conv.integral]: the value modulo 2^width)
cx-bf-store : CxU → MPtr → Word → Word → SV → CxEv Unit
cx-bf-store u p bit w v = case cx-bf-ok u bit w of
  false → cx-stop {Unit} st-unsupported
  true → cx-bind {UInt64} {Unit} (cx-res {UInt64} (cx-bf-bits v)) (λ x →
    cx-bind {UInt64} {Unit} (cx-bf-raw u p (cx-bf-n bit w)) (λ raw →
      cx-bf-put u p (cx-bf-n bit w)
        (u64or (u64and raw (uq-not (u64shl (cx-bf-mask w) (u64 bit))))
               (u64shl (u64and x (cx-bf-mask w)) (u64 bit)))))
-- a pointer to member function in memory: two words. The first is the function's address, or
-- for a virtual function the offset of its slot from the vtable's address point; the second
-- is twice the adjustment of this, plus 1 for a virtual function (the Itanium C++ ABI's 2.3
-- variant for targets whose function addresses carry no alignment, as this machine's do not)
cx-mfp-load : CxU → MPtr → CxEv CxR
cx-mfp-load u p =
  cx-bind {MPtr} {CxR} (cx-ptr-add p #1 (uq-of-word (cx-wsize u))) (λ q →
  cx-bind {SV} {CxR} (cx-load u (cx-pd u) q) (λ a2 →
  cx-bind {UInt64} {CxR} (cx-res {UInt64} (sv-as-i a2)) (λ x →
    case uq-iszero (u64and x uq1) of
      true → cx-bind {SV} {CxR} (cx-load u sk-ptr p) (λ f → cx-ret {CxR} (cxr-mfp f (uq-sar x uq1)))
      false → cx-bind {SV} {CxR} (cx-load u (cx-pd u) p) (λ f → cx-ret {CxR} (cxr-mfp f (uq-sar x uq1))))))
cx-mfp-store : CxU → MPtr → SV → UInt64 → CxEv Unit
cx-mfp-store u p f adj =
  cx-bind {MPtr} {Unit} (cx-ptr-add p #1 (uq-of-word (cx-wsize u))) (λ q → case f of
    sv-p fp → cx-then {Unit} {Unit} (cx-store u sk-ptr p f) (cx-store u (cx-pd u) q (sv-i (u64shl adj uq1)))
    sv-i off → cx-then {Unit} {Unit} (cx-store u (cx-pd u) p f) (cx-store u (cx-pd u) q (sv-i (u64or (u64shl adj uq1) uq1)))
    sv-w lo hi → cx-stop {Unit} st-ill-typed
    sv-b b → cx-stop {Unit} st-ill-typed
    sv-f x → cx-stop {Unit} st-ill-typed
    sv-d x → cx-stop {Unit} st-ill-typed)
-- the value of a glvalue ([conv.lval]); of a class type it is not asked (a class is copied by
-- its constructor)
cx-lv-load : CxU → CType → CxR → CxEv CxR
cx-lv-load u ty r = case r of
  cxr-lv p al → (case cx-tc ty of
    cxtc-scalar → cx-bind {SV} {CxR} (cx-ld u ty al p) (λ v → cx-ret {CxR} (cxr-val v))
    cxtc-mfp → cx-mfp-load u p
    _ → cx-stop {CxR} st-ill-typed)
  cxr-bf p bit w → cx-bind {SV} {CxR} (cx-bf-load u ty p bit w) (λ v → cx-ret {CxR} (cxr-val v))
  _ → cx-stop {CxR} st-ill-typed
-- a value stored through a glvalue
cx-lv-store : CxU → CType → CxR → CxR → CxEv Unit
cx-lv-store u ty r x = case r of
  cxr-lv p al → (case x of
    cxr-val v → cx-st u ty al p v
    cxr-mfp f adj → cx-mfp-store u p f adj
    _ → cx-stop {Unit} st-ill-typed)
  cxr-bf p bit w → (case x of
    cxr-val v → cx-bf-store u p bit w v
    _ → cx-stop {Unit} st-ill-typed)
  _ → cx-stop {Unit} st-ill-typed
-- a value stored into a slot of the object at p
cx-slot-ptr : MPtr → CxSlot → CxEv CxR
cx-slot-ptr p s = case s of
  cxsl t bits width al → (case width of
    cbw-none → cx-bind {MPtr} {CxR} (cx-sub p (wquot bits #8)) (λ q → cx-ret {CxR} (cxr-lv q al))
    cbw-bits w → cx-bind {MPtr} {CxR} (cx-sub p (wquot bits #8)) (λ q → cx-ret {CxR} (cxr-bf q (wrem bits #8) w)))
cx-slot-type : CxSlot → CType
cx-slot-type s = case s of
  cxsl t bits width al → t
-- the zero of a scalar type ([dcl.init]/6: zero-initialization; the null pointer to data
-- member is -1, Itanium C++ ABI 2.3)
cx-zero : CxU → CType → CxEv CxR
cx-zero u ty = case cx-tc ty of
  cxtc-mfp → cx-ret {CxR} (cxr-mfp (sv-p cx-null) uq0)
  cxtc-scalar → (case cx-strip ty of
    ct-member-pointer cls x → cx-ret {CxR} (cxr-val (sv-i uq-ones))
    _ → cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u ty)) (λ k → case k of
      sk-int sg w → cx-ret {CxR} (cxr-val (dq-to-int sg w dq0))
      sk-bool → cx-ret {CxR} (cxr-val (sv-b false))
      sk-f32 → cx-ret {CxR} (cxr-val (sv-f (f32-of-bits uq0)))
      sk-f64 → cx-ret {CxR} (cxr-val (sv-d (f64-of-bits uq0)))
      sk-ptr → cx-ret {CxR} (cxr-val (sv-p cx-null))))
  _ → cx-stop {CxR} st-ill-typed

-- ---------------------------------------------------------------- conversions between scalar types
cx-sk-ptr : SK → Bool
cx-sk-ptr k = case k of
  sk-ptr → true
  _ → false
-- pointer ↔ integer is the memory's (the Target's choice); every other pair is the scalar layer's
cx-cvk : CxU → SK → SK → SV → CxEv SV
cx-cvk u kf kt v = case cx-sk-ptr kf of
  true → (case cx-sk-ptr kt of
    true → cx-ret {SV} v
    false → (case kt of
      sk-bool → cx-res {SV} (sv-conv kf kt v)
      _ → cx-conv u kf kt v))
  false → (case cx-sk-ptr kt of
    true → cx-conv u kf kt v
    false → cx-res {SV} (sv-conv kf kt v))
cx-cv : CxU → CType → CType → SV → CxEv SV
cx-cv u from to v =
  cx-bind {SK} {SV} (cx-res {SK} (cx-sk u from)) (λ kf →
  cx-bind {SK} {SV} (cx-res {SK} (cx-sk u to)) (λ kt → cx-cvk u kf kt v))
-- an index or a count of elements as a signed 64-bit number: an unsigned value that is not
-- one is beyond every array ([expr.add]/4: undefined)
cx-index : CxU → CType → SV → CxEv UInt64
cx-index u ty v = cx-bind {SK} {UInt64} (cx-res {SK} (cx-sk u ty)) (λ k → case k of
  sk-int sg w → (case w of
    iw128 → cx-stop {UInt64} st-unsupported
    _ → cx-bind {UInt64} {UInt64} (cx-res {UInt64} (sv-as-i v)) (λ x → case sg of
      true → cx-ret {UInt64} x
      false → (case uq-isneg x of
        true → cx-ub {UInt64} ub-ptr-arith
        false → cx-ret {UInt64} x)))
  sk-bool → cx-bind {Bool} {UInt64} (cx-res {Bool} (sv-as-b v)) (λ b → cx-ret {UInt64} (uq-b b))
  sk-f32 → cx-stop {UInt64} st-ill-typed
  sk-f64 → cx-stop {UInt64} st-ill-typed
  sk-ptr → cx-stop {UInt64} st-ill-typed)
cx-truth : CxR → CxEv Bool
cx-truth r = case r of
  cxr-val v → cx-res {Bool} (sv-as-b v)
  _ → cx-stop {Bool} st-ill-typed
cx-val : SV → CxEv CxR
cx-val v = cx-ret {CxR} (cxr-val v)

-- ---------------------------------------------------------------- classes: bases, vtables, destruction
-- the offset of a base subobject reached along a path of direct bases (the unit's layouts)
cx-base-off : List CBase → Word → MRes Word
cx-base-off nil b = mstop st-ill-typed
cx-base-off (cons x xs) b = case x of
  cbase id off prim virt → (case weq id b of
    true → (case virt of
      true → mstop st-unsupported
      false → mok off)
    false → cx-base-off xs b)
cx-path-off : List Word → List CDecl → Word → MRes Word
cx-path-off nil ds cur = mok #0
cx-path-off (cons b bs) ds cur =
  mr-bind (cx-find-rec ds cur) (λ r →
  mr-bind (cx-base-off (cx-rec-bases r) b) (λ o →
  mr-map (λ rest → wadd o rest) (cx-path-off bs ds b)))
-- where an object of a class keeps its vtable pointer: the class's own, or its primary base's
-- (Itanium C++ ABI 2.4); the walk down primary bases is bounded by the number given
cx-primary : List CBase → MRes (Word × Word)
cx-primary nil = mstop st-ill-typed
cx-primary (cons x xs) = case x of
  cbase id off prim virt → (case prim of
    true → mok (id , off)
    false → cx-primary xs)
cx-vptr-off : List CDecl → Word → Word → MRes Word
cx-vptr-off ds fuel id =
  %welimP (λ x → Word → MRes Word) fuel (λ i → mstop st-fuel)
    (λ n go i → mr-bind (cx-find-rec ds i) (λ r → case cx-rec-layout r of
       clayout size align dsize nvsize nvalign vptr → (case vptr of
         cvp-at o → mok o
         cvp-none → mr-bind (cx-primary (cx-rec-bases r)) (λ b → mr-map (λ o → wadd (snd b) o) (go (fst b))))))
    id
-- a destructor has two entries in a vtable: the complete-object destructor, and the deleting
-- destructor (the same, then operator delete). As a function of the unit the second is the
-- first's id plus this number (ids are below it; read.cub's cx-fun gives it its meaning)
cx-deleting : Word
cx-deleting = #32768
-- the slot of a virtual function in its class's vtable, counted from the address point
cx-slot-go : List CVTEntry → Word → Bool → Word → MRes Word
cx-slot-go nil f del i = mstop st-ill-typed
cx-slot-go (cons e es) f del i = case e of
  cvt-method id → (case weq id f of
    true → mok i
    false → cx-slot-go es f del (wadd i #1))
  cvt-pure id → (case weq id f of
    true → mok i
    false → cx-slot-go es f del (wadd i #1))
  cvt-complete-dtor id → (case m-and (weq id f) (not del) of
    true → mok i
    false → cx-slot-go es f del (wadd i #1))
  cvt-deleting-dtor id → (case m-and (weq id f) del of
    true → mok i
    false → cx-slot-go es f del (wadd i #1))
  cvt-offset-to-top v → cx-slot-go es f del (wadd i #1)
  cvt-rtti → cx-slot-go es f del (wadd i #1)
-- the byte offset from the address point of the slot of function f (deleting: its deleting
-- entry) in the vtable of class cls
cx-slot : CxU → Word → Word → Bool → MRes Word
cx-slot u cls f del = mr-bind (cx-find-rec (cxu-ds u) cls) (λ r → case cx-rec-vtable r of
  cvt-none → mstop st-ill-typed
  cvtable ap es → mr-bind (cx-slot-go es f del #0) (λ i → case wlt i ap of
    true → mstop st-ill-typed
    false → mok (wmul (wsub i ap) (cx-wsize u))))
-- the function a virtual call reaches: the vtable pointer of the object (at the class the
-- function was named in), the slot's entry ([class.virtual]: the final overrider is what the
-- most derived object's vtable holds). A pure virtual function's entry is null: calling it
-- is undefined ([class.abstract]/6)
cx-virtual : CxU → Word → Word → Bool → MPtr → CxEv Word
cx-virtual u cls f del this =
  cx-bind {Word} {Word} (cx-res {Word} (cx-vptr-off (cxu-ds u) #64 cls)) (λ vo →
  cx-bind {Word} {Word} (cx-res {Word} (cx-slot u cls f del)) (λ so →
  cx-bind {MPtr} {Word} (cx-sub this vo) (λ vpp →
  cx-bind {SV} {Word} (cx-load u sk-ptr vpp) (λ vp →
  cx-bind {MPtr} {Word} (cx-res {MPtr} (sv-as-p vp)) (λ vt →
  cx-bind {MPtr} {Word} (cx-sub vt so) (λ sp →
  cx-bind {SV} {Word} (cx-load u sk-ptr sp) (λ fv →
  cx-bind {MPtr} {Word} (cx-res {MPtr} (sv-as-p fv)) (λ fp → cx-fn-of fp))))))))
-- whether ending an object of a type runs anything: a class whose destructor is declared
-- with a body, or defaulted over a base or a member that is a class or an array of classes
-- (decided one level down: a defaulted destructor over such members is called and finds out)
cx-plain : CType → Bool
cx-plain (ct-record id) = false
cx-plain (ct-array e n) = cx-plain e
cx-plain (ct-qual cn vo rs e) = cx-plain e
cx-plain t = true
cx-fields-plain : List CField → Bool
cx-fields-plain nil = true
cx-fields-plain (cons f fs) = m-and (cx-plain (cx-fld-type f)) (cx-fields-plain fs)
cx-no-bases : List CBase → Bool
cx-no-bases nil = true
cx-no-bases (cons b bs) = false
cx-dtor-of : CxU → Word → MRes Word
cx-dtor-of u id = case cx-find-dtor (cxu-ds u) id of
  cxfn-none → mok #0
  cxfn k parent virt inits f → (case cx-fn-body f of
    cfb-defaulted → mr-map (λ r → case m-and (cx-no-bases (cx-rec-bases r)) (cx-fields-plain (cx-rec-fields r)) of
      true → #0
      false → wadd (cx-fn-id f) #1) (cx-find-rec (cxu-ds u) id)
    _ → mok (wadd (cx-fn-id f) #1))
-- the end of an object's lifetime by its destructor ([class.dtor]); an array's elements in
-- reverse order; a scalar has none
cx-destroy : CType → CxCall → CxU → MPtr → CxEv Unit
cx-destroy (ct-record id) call u p = cx-bind {Word} {Unit} (cx-res {Word} (cx-dtor-of u id)) (λ d → case weq d #0 of
  true → cx-ret {Unit} unit
  false → cx-bind {CxR} {Unit} (call (wsub d #1) p nil cx-null) (λ r → cx-ret {Unit} unit))
cx-destroy (ct-array e n) call u p = case cx-plain e of
  true → cx-ret {Unit} unit
  false → cx-bind {Word} {Unit} (cx-res {Word} (cx-size u e)) (λ sz →
    %welimP (λ x → CxEv Unit) n (cx-ret {Unit} unit)
      (λ j acc → cx-then {Unit} {Unit}
         (cx-bind {MPtr} {Unit} (cx-sub p (wmul j sz)) (λ q → cx-destroy e call u q)) acc))
cx-destroy (ct-qual cn vo rs e) call u p = cx-destroy e call u p
cx-destroy t call u p = cx-ret {Unit} unit

-- ---------------------------------------------------------------- the built-in operators on evaluated operands
-- the AST has made the usual arithmetic conversions explicit as casts ([expr.arith.conv]), so
-- an arithmetic operator's operands are both of the type the node gives
cx-ar : CxU → BinOp → CType → CxR → CxR → CxEv CxR
cx-ar u o t x y =
  cx-bind {SV} {CxR} (cx-as-val x) (λ a →
  cx-bind {SV} {CxR} (cx-as-val y) (λ b →
  cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u t)) (λ k →
  cx-bind {SV} {CxR} (cx-res {SV} (sv-arith o k a b)) cx-val)))
-- pointer ± integer ([expr.add]/4): in elements of the pointee type
cx-ptr-plus : CxU → CType → CxR → CType → CxR → Bool → CxEv CxR
cx-ptr-plus u pt x it y neg =
  cx-bind {MPtr} {CxR} (cx-as-ptr x) (λ p →
  cx-bind {SV} {CxR} (cx-as-val y) (λ i →
  cx-bind {UInt64} {CxR} (cx-index u it i) (λ n →
  cx-bind {Word} {CxR} (cx-res {Word} (cx-size u (cx-pointee pt))) (λ sz →
  cx-bind {MPtr} {CxR} (cx-ptr-add p sz (case neg of
                                           true → uq-neg n
                                           false → n)) (λ q → cx-val (sv-p q))))))
-- pointer − pointer ([expr.add]/5)
cx-ptr-minus : CxU → CType → CxR → CxR → CxEv CxR
cx-ptr-minus u pt x y =
  cx-bind {MPtr} {CxR} (cx-as-ptr x) (λ p →
  cx-bind {MPtr} {CxR} (cx-as-ptr y) (λ q →
  cx-bind {Word} {CxR} (cx-res {Word} (cx-size u (cx-pointee pt))) (λ sz →
  cx-bind {UInt64} {CxR} (cx-ptr-diff p q sz) (λ d → cx-val (sv-i d)))))
-- a shift ([expr.shift]: the count below 0 or at least the width of the promoted left operand
-- is undefined; a left shift is modular in C++20)
cx-sh : CxU → Bool → CType → CType → CxR → CxR → CxEv CxR
cx-sh u left lt rt x y =
  cx-bind {SV} {CxR} (cx-as-val x) (λ a →
  cx-bind {SV} {CxR} (cx-as-val y) (λ c →
  cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u lt)) (λ k →
  cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u rt)) (λ kc →
  cx-bind {SV} {CxR} (cx-res {SV} (case left of
                                     true → sv-shl k kc a c
                                     false → sv-shr k kc a c)) cx-val))))
-- a comparison ([expr.rel], [expr.eq]) at the operands' type: pointers by the memory
cx-cmp : CxU → CExpr → CmpOp → CType → CxR → CxR → CxEv CxR
cx-cmp u e o lt x y = case cx-tc lt of
  cxtc-scalar → cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u lt)) (λ k → case cx-sk-ptr k of
    true → cx-bind {MPtr} {CxR} (cx-as-ptr x) (λ p → cx-bind {MPtr} {CxR} (cx-as-ptr y) (λ q →
             cx-bind {Bool} {CxR} (cx-ptr-cmp u o p q) (λ b → cx-val (sv-b b))))
    false → cx-bind {SV} {CxR} (cx-as-val x) (λ a → cx-bind {SV} {CxR} (cx-as-val y) (λ b →
              cx-bind {Bool} {CxR} (cx-res {Bool} (sv-cmp o k a b)) (λ r → cx-val (sv-b r)))))
  cxtc-mfp → cx-unsupported {CxR} (cxw-form #1 e)
  _ → cx-stop {CxR} st-ill-typed
cx-binop : CxU → CExpr → CBinOp → CType → CType → CType → CxR → CxR → CxEv CxR
cx-binop u e op t lt rt x y = case op of
  cbo-mul → cx-ar u bo-mul t x y
  cbo-div → cx-ar u bo-div t x y
  cbo-rem → cx-ar u bo-rem t x y
  cbo-add → (case cx-is-ptr lt of
    true → cx-ptr-plus u lt x rt y false
    false → (case cx-is-ptr rt of
      true → cx-ptr-plus u rt y lt x false
      false → cx-ar u bo-add t x y))
  cbo-sub → (case cx-is-ptr lt of
    true → (case cx-is-ptr rt of
      true → cx-ptr-minus u lt x y
      false → cx-ptr-plus u lt x rt y true)
    false → cx-ar u bo-sub t x y)
  cbo-shl → cx-sh u true lt rt x y
  cbo-shr → cx-sh u false lt rt x y
  cbo-lt → cx-cmp u e co-lt lt x y
  cbo-gt → cx-cmp u e co-gt lt x y
  cbo-le → cx-cmp u e co-le lt x y
  cbo-ge → cx-cmp u e co-ge lt x y
  cbo-eq → cx-cmp u e co-eq lt x y
  cbo-ne → cx-cmp u e co-ne lt x y
  cbo-and → cx-ar u bo-and t x y
  cbo-xor → cx-ar u bo-xor t x y
  cbo-or → cx-ar u bo-or t x y
  cbo-land → cx-stop {CxR} st-ill-typed
  cbo-lor → cx-stop {CxR} st-ill-typed
  cbo-assign → cx-stop {CxR} st-ill-typed
  cbo-comma → cx-stop {CxR} st-ill-typed
  cbo-ptr-mem-d → cx-stop {CxR} st-ill-typed
  cbo-ptr-mem-i → cx-stop {CxR} st-ill-typed
-- ++ and -- ([expr.pre.incr], [expr.post.incr]): x += 1 or x -= 1 at the operand's type: of
-- an arithmetic type through the usual arithmetic conversions with int and back; of a
-- pointer one element. pre: the result is the operand (a glvalue); post: its old value
cx-incdec : CxU → CType → Bool → Bool → CxR → CxEv CxR
cx-incdec u t inc pre r =
  cx-bind {CxR} {CxR} (cx-lv-load u t r) (λ old → case cx-is-ptr t of
    true → cx-bind {CxR} {CxR} (cx-ptr-plus u t old (ct-builtin ctb-int) (cxr-val (sv-i uq1)) (not inc)) (λ new →
      cx-then {Unit} {CxR} (cx-lv-store u t r new) (cx-ret {CxR} (case pre of
        true → r
        false → old)))
    false →
      cx-bind {SV} {CxR} (cx-as-val old) (λ a →
      cx-bind {CTy} {CxR} (cx-res {CTy} (cx-cty-of u t)) (λ c →
      cx-bind {CTy × SV} {CxR} (cx-res {CTy × SV} (ct-arith (cxu-t u) (case inc of
                                                                         true → bo-add
                                                                         false → bo-sub) c ct-int a (sv-i uq1))) (λ cr →
      cx-bind {SK} {CxR} (cx-res {SK} (ct-sk (cxu-t u) (fst cr))) (λ kc →
      cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u t)) (λ k →
      cx-bind {SV} {CxR} (cx-cvk u kc k (snd cr)) (λ new →
      cx-then {Unit} {CxR} (cx-lv-store u t r (cxr-val new)) (cx-ret {CxR} (case pre of
        true → r
        false → old)))))))))
-- E1 op= E2 ([expr.ass]/6) with E2's value and E1's glvalue in hand: E1's value converted to
-- the type the operation is computed at, the operation, the result converted to E1's type
cx-cassign : CxU → CExpr → CBinOp → CType → CType → CType → CType → CxR → CxR → CxEv CxR
cx-cassign u e op lty comp res rty r y =
  cx-bind {CxR} {CxR} (cx-lv-load u lty r) (λ old → case cx-is-ptr lty of
    true → cx-bind {CxR} {CxR} (cx-binop u e op lty lty rty old y) (λ new →
      cx-then {Unit} {CxR} (cx-lv-store u lty r new) (cx-ret {CxR} r))
    false →
      cx-bind {SV} {CxR} (cx-as-val old) (λ a →
      cx-bind {SV} {CxR} (cx-cv u lty comp a) (λ a2 →
      cx-bind {CxR} {CxR} (cx-binop u e op res comp rty (cxr-val a2) y) (λ v →
      cx-bind {SV} {CxR} (cx-as-val v) (λ v2 →
      cx-bind {SV} {CxR} (cx-cv u res lty v2) (λ new →
      cx-then {Unit} {CxR} (cx-lv-store u lty r (cxr-val new)) (cx-ret {CxR} r)))))))
-- the unary operators on a value
cx-unop : CxU → CExpr → CUnOp → CType → CxR → CxEv CxR
cx-unop u e op t x = case op of
  uo-plus → cx-ret {CxR} x
  uo-minus → cx-bind {SV} {CxR} (cx-as-val x) (λ a → cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u t)) (λ k →
    cx-bind {SV} {CxR} (cx-res {SV} (sv-neg k a)) cx-val))
  uo-not → cx-bind {SV} {CxR} (cx-as-val x) (λ a → cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u t)) (λ k →
    cx-bind {SV} {CxR} (cx-res {SV} (sv-not k a)) cx-val))
  uo-lnot → cx-bind {Bool} {CxR} (cx-truth x) (λ b → cx-val (sv-b (not b)))
  uo-deref → cx-bind {MPtr} {CxR} (cx-as-ptr x) (λ p → cx-ret {CxR} (cxr-lv p #0))
  uo-addr-of → (case x of
    cxr-lv p al → (case cx-tc t of
      cxtc-mfp → cx-ret {CxR} (cxr-mfp (sv-p p) uq0)
      _ → cx-val (sv-p p))
    cxr-val v → cx-ret {CxR} x
    cxr-mfp f adj → cx-ret {CxR} x
    _ → cx-stop {CxR} st-ill-typed)
  uo-post-inc → cx-stop {CxR} st-ill-typed
  uo-post-dec → cx-stop {CxR} st-ill-typed
  uo-pre-inc → cx-stop {CxR} st-ill-typed
  uo-pre-dec → cx-stop {CxR} st-ill-typed

-- ---------------------------------------------------------------- references to declarations
cx-bind-lv : CxU → CxBind → CxEv CxR
cx-bind-lv u b = case b of
  cxb-obj p al → cx-ret {CxR} (cxr-lv p al)
  cxb-ref p → cx-bind {SV} {CxR} (cx-load u sk-ptr p) (λ v → cx-bind {MPtr} {CxR} (cx-res {MPtr} (sv-as-p v)) (λ q → cx-ret {CxR} (cxr-lv q #0)))
-- the alignment a member's accesses may assume (0: its type's own): no more than its class's
-- (a packed class's members are at alignment 1) and no more than the object expression's
cx-al-cap : Word → Word → Word
cx-al-cap a b = case weq b #0 of
  true → a
  false → (case wlt b a of
    true → b
    false → a)
cx-fld-al : CxU → CRecord → CField → Word → MRes Word
cx-fld-al u r f base = mr-bind (cx-align u (cx-fld-type f)) (λ nat → case cx-rec-layout r of
  clayout size align dsize nvsize nvalign vptr → mok (case weq (cx-al-cap (cx-al-cap nat align) base) nat of
    true → #0
    false → cx-al-cap (cx-al-cap nat align) base))
-- the member f of the object at p ([expr.ref]): a bit-field, a reference member's referent,
-- or the member subobject
cx-field-lv : CxU → CRecord → CField → MPtr → Word → CxEv CxR
cx-field-lv u r f p al = case cx-fld-width f of
  cbw-bits w → cx-bind {MPtr} {CxR} (cx-sub p (wquot (cx-fld-bits f) #8)) (λ q → cx-ret {CxR} (cxr-bf q (wrem (cx-fld-bits f) #8) w))
  cbw-none → cx-bind {MPtr} {CxR} (cx-sub p (wquot (cx-fld-bits f) #8)) (λ q → case cx-tc (cx-fld-type f) of
    cxtc-ref t → cx-bind-lv u (cxb-ref q)
    _ → cx-bind {Word} {CxR} (cx-res {Word} (cx-fld-al u r f al)) (λ a → cx-ret {CxR} (cxr-lv q a)))
-- a variable named in a function: a local or a parameter; else, in a lambda's body, the
-- closure's member that captured it; else a variable of static storage
cx-var-ref : CxU → CxEnv → Word → CxEv CxR
cx-var-ref u env id = case cx-has (cxe-locals env) id of
  true → cx-bind {CxBind} {CxR} (cx-res {CxBind} (cx-lookup (cxe-locals env) id)) (cx-bind-lv u)
  false → (case cx-has (cxg-vars (cxe-g env)) id of
    true → cx-bind {CxBind} {CxR} (cx-res {CxBind} (cx-lookup (cxg-vars (cxe-g env)) id)) (cx-bind-lv u)
    false → (case weq (cxe-closure env) #0 of
      true → cx-unsupported {CxR} (cxw-decl id)
      false → cx-bind {CRecord} {CxR} (cx-res {CRecord} (cx-find-rec (cxu-ds u) (cxe-closure env))) (λ r →
              cx-bind {CField} {CxR} (cx-res {CField} (cx-cap-var (cx-rec-fields r) id)) (λ f →
                cx-field-lv u r f (cxe-this env) #0))))
cx-declref : CxU → CExpr → CType → CRefKind → Word → CxEnv → CxEv CxR
cx-declref u e t k id env = case k of
  crk-function → cx-ret {CxR} (cxr-lv (cx-fn-ptr id) #0)
  crk-method → (case cx-find-fn (cxu-ds u) id of
    cxfn-none → cx-unsupported {CxR} (cxw-decl id)
    cxfn fk parent virt inits f → cx-ret {CxR} (cxr-bound cx-null id virt))
  crk-var → cx-var-ref u env id
  crk-parm → cx-var-ref u env id
  crk-enum-constant → cx-bind {CType × CInt} {CxR} (cx-res {CType × CInt} (cx-enumerator (cxu-ds u) id)) (λ tv →
    cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u t)) (λ sk → cx-bind {SV} {CxR} (cx-res {SV} (cx-lit sk (cx-cint (snd tv)))) cx-val))
  crk-field → cx-bind {CRecord × CField} {CxR} (cx-res {CRecord × CField} (cx-field-any (cxu-ds u) id)) (λ rf →
    cx-val (sv-i (uq-of-word (wquot (cx-fld-bits (snd rf)) #8))))
-- this ([expr.prim.this]); in a lambda's body, the this the closure captured
cx-this : CxU → CxEnv → CxEv CxR
cx-this u env = case weq (cxe-closure env) #0 of
  true → cx-val (sv-p (cxe-this env))
  false → cx-bind {CRecord} {CxR} (cx-res {CRecord} (cx-find-rec (cxu-ds u) (cxe-closure env))) (λ r →
          cx-bind {CField} {CxR} (cx-res {CField} (cx-cap-this (cx-rec-fields r))) (λ f →
          cx-bind {CxR} {CxR} (cx-field-lv u r f (cxe-this env) #0) (λ lv → cx-lv-load u (cx-fld-type f) lv)))
-- E.m and E->m with E evaluated
cx-member : CxU → CExpr → Bool → Bool → CRefKind → Word → CxR → CxEnv → CxEv CxR
cx-member u e arrow qual k id b env =
  cx-bind {MPtr × Word} {CxR} (case arrow of
    true → cx-bind {MPtr} {MPtr × Word} (cx-as-ptr b) (λ p → cx-ret {MPtr × Word} (p , #0))
    false → (case b of
      cxr-lv p al → cx-ret {MPtr × Word} (p , al)
      _ → cx-stop {MPtr × Word} st-ill-typed)) (λ pa → case k of
    crk-field → cx-bind {CRecord × CField} {CxR} (cx-res {CRecord × CField} (cx-field-any (cxu-ds u) id)) (λ rf →
      cx-field-lv u (fst rf) (snd rf) (fst pa) (snd pa))
    crk-method → (case cx-find-fn (cxu-ds u) id of
      cxfn-none → cx-unsupported {CxR} (cxw-decl id)
      cxfn fk parent virt inits f → cx-ret {CxR} (cxr-bound (fst pa) id (m-and virt (not qual))))
    crk-var → cx-var-ref u env id
    _ → cx-unsupported {CxR} (cxw-expr e))
-- a cast to a base class along a path ([conv.ptr]/3: of a null pointer, null)
cx-to-base : CxU → List Word → CType → CxR → CxEv CxR
cx-to-base u path st r = case r of
  cxr-lv p al → cx-bind {Word} {CxR} (cx-res {Word} (mr-bind (cx-rec-of st) (cx-path-off path (cxu-ds u)))) (λ off → case weq off #0 of
    true → cx-ret {CxR} r
    false → cx-bind {MPtr} {CxR} (cx-sub p off) (λ q → cx-ret {CxR} (cxr-lv q #0)))
  cxr-val v → cx-bind {Word} {CxR} (cx-res {Word} (mr-bind (cx-rec-of (cx-pointee st)) (cx-path-off path (cxu-ds u)))) (λ off → case weq off #0 of
    true → cx-ret {CxR} r
    false → cx-bind {MPtr} {CxR} (cx-res {MPtr} (sv-as-p v)) (λ p → cx-bind {Bool} {CxR} (cx-is-null u p) (λ z → case z of
      true → cx-ret {CxR} r
      false → cx-bind {MPtr} {CxR} (cx-sub p off) (λ q → cx-val (sv-p q)))))
  _ → cx-stop {CxR} st-ill-typed

-- ---------------------------------------------------------------- temporaries and result objects
-- the object a class or array prvalue initializes: the one asked for, or, asked for its
-- result, a temporary that lives until the full-expression's continuation returns and is then
-- destroyed ([class.temporary]/4), its address the result
cx-with-dest : CxCall → CxU → CType → CxMode → CxK → (MPtr → CxK → CxEv CxR) → CxEv CxR
cx-with-dest call u t mode k body = case mode of
  cxm-init p → body p k
  cxm-get →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-size u t)) (λ sz →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-align u t)) (λ al →
    cx-bind {MPtr} {CxR} (cx-alloc ak-auto false sz al) (λ q →
      cx-finally {CxR} (body q (λ r → k (cxr-lv q #0)))
        (cx-then {Unit} {Unit} (cx-destroy t call u q) (cx-release ak-auto q)))))
  _ → cx-stop {CxR} st-ill-typed
-- the end of a full-expression inside an expression (ExprWithCleanups): the temporaries of e
-- end before the continuation; lifetime-extended ones pass outward on the answer
cx-unwrap : CxR → CxK → CxEv CxR
cx-unwrap (cxr-ext p t r) k = cx-bind {CxR} {CxR} (cx-unwrap r k) (λ a → cx-ret {CxR} (cxr-ext p t a))
cx-unwrap r k = k r
cx-cut : CxEv CxR → CxK → CxEv CxR
cx-cut e k = cx-bind {CxR} {CxR} e (λ r → cx-unwrap r k)
-- a temporary materialized from a prvalue ([conv.rval]) with the storage duration Clang
-- determined: of the full-expression; of the reference it is bound to (automatic: the
-- declaration ends it, cxr-ext; static: it is never ended by an entry)
cx-materialize : CxCall → CxU → CType → CStorageDuration → CxSub → CxEnv → CxK → CxEv CxR
cx-materialize call u t sd sub env k =
  cx-bind {Word} {CxR} (cx-res {Word} (cx-size u t)) (λ sz →
  cx-bind {Word} {CxR} (cx-res {Word} (cx-align u t)) (λ al →
  cx-bind {MPtr} {CxR} (cx-alloc (case sd of
                                    csd-static → ak-static
                                    _ → ak-auto) false sz al) (λ q →
    (λ (after : CxEv CxR → CxEv CxR) → case cx-tc t of
       cxtc-record id → after (sub env (cxm-init q) (λ r → k (cxr-lv q #0)))
       cxtc-array el n → after (sub env (cxm-init q) (λ r → k (cxr-lv q #0)))
       _ → after (sub env cxm-get (λ r → cx-then {Unit} {CxR} (cx-lv-store u t (cxr-lv q #0) r) (k (cxr-lv q #0)))))
    (λ body → case sd of
       csd-full-expression → cx-finally {CxR} body (cx-then {Unit} {Unit} (cx-destroy t call u q) (cx-release ak-auto q))
       csd-automatic → cx-bind {CxR} {CxR} body (λ a → cx-ret {CxR} (cxr-ext q t a))
       csd-static → body))))

-- ---------------------------------------------------------------- initialization of parts
-- the object (or bit-field, or reference member) at a slot of the object at p initialized by
-- an expression ([dcl.init]): a class or an array by the expression itself; a reference by
-- the glvalue's address; a scalar by the value
cx-init-slot : CxU → MPtr → CxSlot → CxSub → CxEnv → CxK → CxEv CxR
cx-init-slot u p s sub env k = case cx-tc (cx-slot-type s) of
  cxtc-record id → cx-bind {CxR} {CxR} (cx-slot-ptr p s) (λ lv → cx-bind {MPtr} {CxR} (cx-as-lv lv) (λ q → sub env (cxm-init q) k))
  cxtc-array el n → cx-bind {CxR} {CxR} (cx-slot-ptr p s) (λ lv → cx-bind {MPtr} {CxR} (cx-as-lv lv) (λ q → sub env (cxm-init q) k))
  cxtc-ref t → sub env cxm-get (λ r → cx-bind {MPtr} {CxR} (cx-as-lv r) (λ ref →
    cx-bind {CxR} {CxR} (cx-slot-ptr p s) (λ lv → cx-bind {MPtr} {CxR} (cx-as-lv lv) (λ q →
      cx-then {Unit} {CxR} (cx-store u sk-ptr q (sv-p ref)) (k cxr-void)))))
  cxtc-scalar → sub env cxm-get (λ r → cx-bind {CxR} {CxR} (cx-slot-ptr p s) (λ lv →
    cx-then {Unit} {CxR} (cx-lv-store u (cx-slot-type s) lv r) (k cxr-void)))
  cxtc-mfp → sub env cxm-get (λ r → cx-bind {CxR} {CxR} (cx-slot-ptr p s) (λ lv →
    cx-then {Unit} {CxR} (cx-lv-store u (cx-slot-type s) lv r) (k cxr-void)))
  cxtc-void → cx-stop {CxR} st-ill-typed
  cxtc-fn → cx-stop {CxR} st-ill-typed
-- the slots an initializer list fills: of a class, its direct bases then its named members in
-- declaration order ([dcl.init.aggr]/2; an unnamed bit-field is not a member); of a union, the
-- member named; of an array, its first elements
cx-base-slots : List CBase → List CxSlot → List CxSlot
cx-base-slots nil rest = rest
cx-base-slots (cons b bs) rest = case b of
  cbase id off prim virt → cons (cxsl (ct-record id) (wmul off #8) cbw-none #0) (cx-base-slots bs rest)
cx-fld-unnamed : CField → Bool
cx-fld-unnamed f = case f of
  cfield id name t off width mut cap init → (case width of
    cbw-none → false
    cbw-bits w → weq (cx-name-len name) #0)
cx-fld-slot : CxU → CRecord → CField → MRes CxSlot
cx-fld-slot u r f = mr-map (λ a → cxsl (cx-fld-type f) (cx-fld-bits f) (cx-fld-width f) a) (case cx-fld-width f of
  cbw-bits w → mok #0
  cbw-none → (case cx-tc (cx-fld-type f) of
    cxtc-ref t → mok #0
    _ → cx-fld-al u r f #0))
cx-field-slots : List CField → CxU → CRecord → MRes (List CxSlot)
cx-field-slots nil u r = mok nil
cx-field-slots (cons f fs) u r = case cx-fld-unnamed f of
  true → cx-field-slots fs u r
  false → mr-bind (cx-fld-slot u r f) (λ s → mr-map (λ ss → cons s ss) (cx-field-slots fs u r))
cx-rec-slots : CxU → Word → COptId → MRes (List CxSlot)
cx-rec-slots u id uf = mr-bind (cx-find-rec (cxu-ds u) id) (λ r → case uf of
  coi-some fid → mr-bind (cx-find-field (cx-rec-fields r) fid) (λ f → mr-map (λ s → cons s nil) (cx-fld-slot u r f))
  coi-none → (case cx-rec-union r of
    true → mok nil
    false → mr-map (cx-base-slots (cx-rec-bases r)) (cx-field-slots (cx-rec-fields r) u r)))
cx-arr-slots : CType → Word → Word → List CxSlot
cx-arr-slots el sz m =
  %welimP (λ x → List CxSlot) m nil (λ j acc → cons (cxsl el (wmul (wmul (wsub (wsub m j) #1) sz) #8) cbw-none #0) acc)

-- ---------------------------------------------------------------- calls
cx-ptypes : List CVar → List CType
cx-ptypes nil = nil
cx-ptypes (cons v vs) = cons (cx-var-type v) (cx-ptypes vs)
-- an argument initializes a new object of the parameter's type ([expr.call]/7); a reference
-- parameter is bound to the argument's object and has none
cx-arg : CxU → CType → CxSub → CxEnv → CxK → CxEv CxR
cx-arg u pt x env k = case cx-tc pt of
  cxtc-ref t → x env cxm-get (λ r → cx-bind {MPtr} {CxR} (cx-as-lv r) (λ p → k (cxr-parm p false)))
  cxtc-record id →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-size u pt)) (λ sz →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-align u pt)) (λ al →
    cx-bind {MPtr} {CxR} (cx-alloc ak-auto false sz al) (λ q → x env (cxm-init q) (λ r → k (cxr-parm q true)))))
  cxtc-scalar → x env cxm-get (λ r →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-size u pt)) (λ sz →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-align u pt)) (λ al →
    cx-bind {MPtr} {CxR} (cx-alloc ak-auto false sz al) (λ q →
      cx-then {Unit} {CxR} (cx-lv-store u pt (cxr-lv q #0) r) (k (cxr-parm q true))))))
  cxtc-mfp → x env cxm-get (λ r →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-size u pt)) (λ sz →
    cx-bind {Word} {CxR} (cx-res {Word} (cx-align u pt)) (λ al →
    cx-bind {MPtr} {CxR} (cx-alloc ak-auto false sz al) (λ q →
      cx-then {Unit} {CxR} (cx-lv-store u pt (cxr-lv q #0) r) (k (cxr-parm q true))))))
  cxtc-array el n → cx-stop {CxR} st-ill-typed
  cxtc-void → cx-stop {CxR} st-ill-typed
  cxtc-fn → cx-stop {CxR} st-ill-typed
cx-parm-ptrs : CxR → List MPtr
cx-parm-ptrs (cxr-cons x xs) = case x of
  cxr-parm p owned → cons p (cx-parm-ptrs xs)
  _ → cx-parm-ptrs xs
cx-parm-ptrs r = nil
-- the end of the parameter objects of a call, last first: destroyed, their storage released
cx-parms-end : CxR → List CType → CxCall → CxU → CxEv Unit
cx-parms-end (cxr-cons x xs) ts call u = case ts of
  nil → cx-stop {Unit} st-ill-typed
  cons t ts2 → cx-then {Unit} {Unit} (cx-parms-end xs ts2 call u) (case x of
    cxr-parm p owned → (case owned of
      true → cx-then {Unit} {Unit} (cx-destroy t call u p) (cx-release ak-auto p)
      false → cx-ret {Unit} unit)
    _ → cx-stop {Unit} st-ill-typed)
cx-parms-end r ts call u = cx-ret {Unit} unit
-- the call of a function of the unit with its parameter objects made: a class result is
-- initialized in the object asked for (or a temporary); the parameters end when the function
-- returns or with the full-expression, as the unit's parameter says ([expr.call]/6)
cx-call-fn : CxCall → CxU → CType → Word → MPtr → CxR → List CType → CxMode → CxK → CxEv CxR
cx-call-fn call u t fid this parms pts mode k =
  (λ (go : MPtr → CxK → CxEv CxR) → case cx-tc t of
     cxtc-record id → cx-with-dest call u t mode k go
     _ → go cx-null k)
  (λ dest k2 → case cxu-parm-full u of
     true → cx-finally {CxR} (cx-bind {CxR} {CxR} (call fid this (cx-parm-ptrs parms) dest) k2) (cx-parms-end parms pts call u)
     false → cx-bind {CxR} {CxR} (cx-finally {CxR} (call fid this (cx-parm-ptrs parms) dest) (cx-parms-end parms pts call u)) k2)

-- ---------------------------------------------------------------- functions the unit declares without a body
-- an integer as a sign and a magnitude (a Word is an exact natural number), and back at a kind
cx-word-of-dq : DQ → Word
cx-word-of-dq d = wadd (u64toWord (fst d)) (wshl (u64toWord (snd d)) #64)
cx-sm : CxU → CType → SV → MRes (Bool × Word)
cx-sm u t v = mr-bind (cx-sk u t) (λ k → case k of
  sk-int sg w → mr-map (λ d → case m-and sg (dq-isneg d) of
    true → (true , cx-word-of-dq (dq-neg d))
    false → (false , cx-word-of-dq (case w of
      iw128 → d
      _ → (fst d , uq0)))) (sv-int-dq sg w v)
  sk-bool → mr-map (λ b → (false , u64toWord (uq-b b))) (sv-as-b v)
  _ → mstop st-ill-typed)
cx-sm-add : Bool × Word → Bool × Word → Bool × Word
cx-sm-add a b = case fst a of
  true → (case fst b of
    true → (true , wadd (snd a) (snd b))
    false → (case wlt (snd b) (snd a) of
      true → (true , wsub (snd a) (snd b))
      false → (false , wsub (snd b) (snd a))))
  false → (case fst b of
    false → (false , wadd (snd a) (snd b))
    true → (case wlt (snd a) (snd b) of
      true → (true , wsub (snd b) (snd a))
      false → (false , wsub (snd a) (snd b))))
cx-sm-sign : Bool → Bool → Word → Bool
cx-sm-sign a b m = case weq m #0 of
  true → false
  false → (case a of
    true → not b
    false → b)
cx-sm-mul : Bool × Word → Bool × Word → Bool × Word
cx-sm-mul a b = (cx-sm-sign (fst a) (fst b) (wmul (snd a) (snd b)) , wmul (snd a) (snd b))
cx-iw-bits : IW → Word
cx-iw-bits w = wmul (iw-bytes w) #8
-- whether a value is one of a kind's, and the kind's value congruent to it modulo 2^bits
cx-sm-fits : Bool → IW → Bool × Word → Bool
cx-sm-fits sg w x = case sg of
  false → m-and (not (fst x)) (wlt (snd x) (wshl #1 (cx-iw-bits w)))
  true → (case fst x of
    false → wlt (snd x) (wshl #1 (wsub (cx-iw-bits w) #1))
    true → not (wlt (wshl #1 (wsub (cx-iw-bits w) #1)) (snd x)))
cx-sm-wrap : Bool → IW → Bool × Word → SV
cx-sm-wrap sg w x = dq-to-int sg w (case fst x of
  false → cx-dq-of-word (snd x)
  true → dq-neg (cx-dq-of-word (wrem (snd x) (wshl #1 #128))))
-- __builtin_add_overflow, __builtin_mul_overflow (GCC's documented meaning): the operation on
-- the mathematical values of the first two arguments; the result converted to the type the
-- third points to and stored there; true when it is not that value
cx-overflow : CxU → Bool → CType → CType → CType → SV → SV → MPtr → CxEv CxR
cx-overflow u mul ta tb tr a b rp =
  cx-bind {Bool × Word} {CxR} (cx-res {Bool × Word} (cx-sm u ta a)) (λ x →
  cx-bind {Bool × Word} {CxR} (cx-res {Bool × Word} (cx-sm u tb b)) (λ y →
  cx-bind {SK} {CxR} (cx-res {SK} (cx-sk u tr)) (λ k → case k of
    sk-int sg w →
      (λ (z : Bool × Word) → cx-then {Unit} {CxR} (cx-st u tr #0 rp (cx-sm-wrap sg w z)) (cx-val (sv-b (not (cx-sm-fits sg w z)))))
      (case mul of
         true → cx-sm-mul x y
         false → cx-sm-add x y)
    _ → cx-stop {CxR} st-ill-typed)))
cx-n-memcpy : List Word
cx-n-memcpy = cons #109 (cons #101 (cons #109 (cons #99 (cons #112 (cons #121 nil)))))
cx-n-opnew : List Word
cx-n-opnew = cons #111 (cons #112 (cons #101 (cons #114 (cons #97 (cons #116 (cons #111 (cons #114 (cons #32 (cons #110 (cons #101 (cons #119 nil)))))))))))
cx-n-opnewa : List Word
cx-n-opnewa = cons #111 (cons #112 (cons #101 (cons #114 (cons #97 (cons #116 (cons #111 (cons #114 (cons #32 (cons #110 (cons #101 (cons #119 (cons #91 (cons #93 nil)))))))))))))
cx-n-opdel : List Word
cx-n-opdel = cons #111 (cons #112 (cons #101 (cons #114 (cons #97 (cons #116 (cons #111 (cons #114 (cons #32 (cons #100 (cons #101 (cons #108 (cons #101 (cons #116 (cons #101 nil))))))))))))))
cx-n-opdela : List Word
cx-n-opdela = cons #111 (cons #112 (cons #101 (cons #114 (cons #97 (cons #116 (cons #111 (cons #114 (cons #32 (cons #100 (cons #101 (cons #108 (cons #101 (cons #116 (cons #101 (cons #91 (cons #93 nil))))))))))))))))
cx-n-mulov : List Word
cx-n-mulov = cons #95 (cons #95 (cons #98 (cons #117 (cons #105 (cons #108 (cons #116 (cons #105 (cons #110 (cons #95 (cons #109 (cons #117 (cons #108 (cons #95 (cons #111 (cons #118 (cons #101 (cons #114 (cons #102 (cons #108 (cons #111 (cons #119 nil)))))))))))))))))))))
cx-n-addov : List Word
cx-n-addov = cons #95 (cons #95 (cons #98 (cons #117 (cons #105 (cons #108 (cons #116 (cons #105 (cons #110 (cons #95 (cons #97 (cons #100 (cons #100 (cons #95 (cons #111 (cons #118 (cons #101 (cons #114 (cons #102 (cons #108 (cons #111 (cons #119 nil)))))))))))))))))))))
data CxBuiltin = cxbi-memcpy | cxbi-new | cxbi-delete | cxbi-mul-overflow | cxbi-add-overflow | cxbi-none
cx-builtin-of : CStr → CxBuiltin
cx-builtin-of s = case cx-name-is s cx-n-memcpy of
  true → cxbi-memcpy
  false → (case m-or (cx-name-is s cx-n-opnew) (cx-name-is s cx-n-opnewa) of
    true → cxbi-new
    false → (case m-or (cx-name-is s cx-n-opdel) (cx-name-is s cx-n-opdela) of
      true → cxbi-delete
      false → (case cx-name-is s cx-n-mulov of
        true → cxbi-mul-overflow
        false → (case cx-name-is s cx-n-addov of
          true → cxbi-add-overflow
          false → cxbi-none))))
cx-ptypes-len : List CType → List Word
cx-ptypes-len nil = nil
cx-ptypes-len (cons t ts) = cons #0 (cx-ptypes-len ts)
cx-nth : CxR → Word → CxR
cx-nth (cxr-cons x xs) i = case weq i #0 of
  true → x
  false → cx-nth xs (wsub i #1)
cx-nth r i = cxr-void
cx-tnth : List CType → Word → CType
cx-tnth nil i = ct-nil
cx-tnth (cons t ts) i = case weq i #0 of
  true → t
  false → cx-tnth ts (wsub i #1)
-- memcpy ([cstring.syn], C17 7.24.2.1: overlapping objects are undefined); the replaceable
-- allocation functions ([new.delete.single], [new.delete.array]: storage of dynamic duration,
-- aligned for any object; the size as a number of bytes) and the non-allocating placement
-- forms ([new.delete.placement]: the pointer given); the deallocation functions; the
-- overflow builtins. vals: the arguments' results; ats: their types; pts: the parameter types
cx-builtin : CxU → CFunction → List CType → CxR → List CType → CxEv CxR
cx-builtin u f pts vals ats = case cx-builtin-of (cx-fn-name f) of
  cxbi-memcpy →
    cx-bind {MPtr} {CxR} (cx-as-ptr (cx-nth vals #0)) (λ d →
    cx-bind {MPtr} {CxR} (cx-as-ptr (cx-nth vals #1)) (λ s →
    cx-bind {SV} {CxR} (cx-as-val (cx-nth vals #2)) (λ n →
    cx-bind {UInt64} {CxR} (cx-res {UInt64} (sv-as-i n)) (λ nn →
    cx-then {Unit} {CxR} (cx-memcpy d s (u64toWord nn)) (cx-val (sv-p d))))))
  cxbi-new → (case weq (cx-len (cx-ptypes-len pts)) #1 of
    true →
      cx-bind {SV} {CxR} (cx-as-val (cx-nth vals #0)) (λ n →
      cx-bind {UInt64} {CxR} (cx-res {UInt64} (sv-as-i n)) (λ nn →
      cx-bind {MPtr} {CxR} (cx-alloc ak-dynamic false (u64toWord nn) (tg-alloc-align (cxu-t u))) (λ p → cx-val (sv-p p))))
    false → (case weq (cx-len (cx-ptypes-len pts)) #2 of
      true → (case cx-is-ptr (cx-tnth pts #1) of
        true → cx-ret {CxR} (cx-nth vals #1)
        false → cx-unsupported {CxR} (cxw-builtin (cx-fn-id f)))
      false → cx-unsupported {CxR} (cxw-builtin (cx-fn-id f))))
  cxbi-delete → cx-bind {MPtr} {CxR} (cx-as-ptr (cx-nth vals #0)) (λ p → cx-then {Unit} {CxR} (cx-free p) (cx-ret {CxR} cxr-void))
  cxbi-mul-overflow →
    cx-bind {SV} {CxR} (cx-as-val (cx-nth vals #0)) (λ a →
    cx-bind {SV} {CxR} (cx-as-val (cx-nth vals #1)) (λ b →
    cx-bind {MPtr} {CxR} (cx-as-ptr (cx-nth vals #2)) (λ rp →
      cx-overflow u true (cx-tnth ats #0) (cx-tnth ats #1) (cx-pointee (cx-tnth ats #2)) a b rp)))
  cxbi-add-overflow →
    cx-bind {SV} {CxR} (cx-as-val (cx-nth vals #0)) (λ a →
    cx-bind {SV} {CxR} (cx-as-val (cx-nth vals #1)) (λ b →
    cx-bind {MPtr} {CxR} (cx-as-ptr (cx-nth vals #2)) (λ rp →
      cx-overflow u false (cx-tnth ats #0) (cx-tnth ats #1) (cx-pointee (cx-tnth ats #2)) a b rp)))
  cxbi-none → cx-unsupported {CxR} (cxw-builtin (cx-fn-id f))
