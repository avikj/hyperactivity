-- lib/os/platform.cub — the platform a program is specialized at (PLAN Phase 3 item 3), as a value.
-- Loaded after the library (lib/world.cub, lib/prim.cub). A program that relies on a platform
-- fact takes a Platform and reads the fact from it, so its type names what it relies on, a binary
-- is the program at one Platform, and moving it is specializing it at another.
--
-- The facts: the page size, the cache line, the cores, the clock a timestamp is read from (a
-- clockid_t), the byte order, the system call numbers (a table over the calls lib/os/linux.cub
-- performs) and the layout of the one structure the kernel's ABI packs differently per
-- architecture (struct epoll_event: 12 bytes with the data at offset 4 on x86-64, 16 and 8
-- elsewhere).
data Sys = sys-read | sys-write | sys-open | sys-close | sys-mmap | sys-mprotect | sys-munmap
  | sys-nanosleep | sys-getpid | sys-socket | sys-connect | sys-sendto | sys-recvfrom | sys-bind
  | sys-listen | sys-setsockopt | sys-futex | sys-clock-gettime | sys-exit-group | sys-epoll-wait
  | sys-epoll-ctl | sys-accept4 | sys-epoll-create1
record Platform = { pf-page : Word ; pf-cache-line : Word ; pf-cores : Word ; pf-clock : Word
                  ; pf-little-endian : Bool ; pf-sysnr : Sys → Word
                  ; pf-epoll-event-size : Word ; pf-epoll-data-off : Word }
-- the fact a layout written for little-endian words relies on
os-So : Bool → Type
os-So b = case b of true → Unit; false → Empty
LittleEndian : Platform → Type
LittleEndian pf = os-So (pf-little-endian pf)
-- ---------------------------------------------------------------- x86-64 Linux
-- the numbers of arch/x86/entry/syscalls/syscall_64.tbl
x86-64-sysnr : Sys → Word
x86-64-sysnr s = case s of
  sys-read → #0
  sys-write → #1
  sys-open → #2
  sys-close → #3
  sys-mmap → #9
  sys-mprotect → #10
  sys-munmap → #11
  sys-nanosleep → #35
  sys-getpid → #39
  sys-socket → #41
  sys-connect → #42
  sys-sendto → #44
  sys-recvfrom → #45
  sys-bind → #49
  sys-listen → #50
  sys-setsockopt → #54
  sys-futex → #202
  sys-clock-gettime → #228
  sys-exit-group → #231
  sys-epoll-wait → #232
  sys-epoll-ctl → #233
  sys-accept4 → #288
  sys-epoll-create1 → #291
-- 4 KiB pages, 64-byte lines, CLOCK_REALTIME (0); the cores are the machine's, given
x86-64-linux : Word → Platform
x86-64-linux cores = Platform { pf-page = #4096 ; pf-cache-line = #64 ; pf-cores = cores ; pf-clock = #0
                              ; pf-little-endian = true ; pf-sysnr = x86-64-sysnr
                              ; pf-epoll-event-size = #12 ; pf-epoll-data-off = #4 }
x86-64-linux-le : (cores : Word) → LittleEndian (x86-64-linux cores)
x86-64-linux-le cores = unit
