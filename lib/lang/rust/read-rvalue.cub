-- lib/lang/rust/read-rvalue.cub — the reading of MIR, second part: every Rvalue.
-- An rvalue assigned to a place of a register class is a value
-- (rm-rv-val); assigned to a place in memory it is written there (rm-rv-into).
--
-- The integer operations are MIR's, not C's: Add, Sub, Mul and Neg wrap at the type's width;
-- the *Unchecked forms are undefined on overflow; Div and Rem are undefined on a zero divisor
-- and on MIN / -1 (rustc puts an Assert before them: the abort is the Assert's, see
-- read.cub); Shl and Shr take the count modulo the width; comparisons are the kind's order.
import "read-place.cub"

-- ---------------------------------------------------------------- scalar operations
rm-as-s : RV → REv SV
rm-as-s v = case v of
  rv-s x → rm-ret x
  rv-dead → rm-throw (rx-ub rub-dead-local)
  _ → rm-throw (rx-ill-formed ri-operand-class)
-- + - * modulo 2^width
rm-wrap : BinOp → SK → SV → SV → MRes SV
rm-wrap o k a b = case k of
  sk-int sg w → (case w of
    iw128 → mstop st-unsupported
    _ → mr-bind (sv-as-i a) (λ x → mr-bind (sv-as-i b) (λ y →
          mr-map (λ r → sv-i (uq-cn sg w r)) (ni-op o false w x y))))
  _ → mstop st-ill-typed
-- + - with overflow undefined: a signed kind by the scalar layer's rule, an unsigned one by the
-- wrapped result being on the wrong side of the first operand
rm-unchecked : Bool → SK → SV → SV → REv SV
rm-unchecked add k a b = case k of
  sk-int sg w → (case sg of
    true → rm-res (sv-arith (case add of
                               true → ao-add
                               false → ao-sub) k a b)
    false → rm-bind (rm-res (sv-as-i a)) (λ x → rm-bind (rm-res (sv-as-i b)) (λ y →
      case add of
        true → rm-bind (rm-res (ni-op ao-add false w x y)) (λ r → case u64lt r x of
          true → rm-throw (rx-ub rub-unchecked-overflow)
          false → rm-ret (sv-i r))
        false → (case u64lt x y of
          true → rm-throw (rx-ub rub-unchecked-overflow)
          false → rm-res (mr-map sv-i (ni-op ao-sub false w x y))))))
  _ → rm-stop st-ill-typed
-- & | ^ at an integer kind or at bool
rm-bit : BinOp → SK → SV → SV → MRes SV
rm-bit o k a b = case k of
  sk-bool → mr-bind (sv-as-b a) (λ x → mr-bind (sv-as-b b) (λ y → case o of
    ao-and → mok (sv-b (m-and x y))
    ao-or → mok (sv-b (m-or x y))
    ao-xor → mok (sv-b (not (u64eq (uq-b x) (uq-b y))))
    _ → mstop st-ill-typed))
  _ → sv-arith o k a b
-- shifts: the count (of any integer kind) modulo the width of the shifted kind
rm-shift : Bool → SK → SV → SV → MRes SV
rm-shift left k a b = case k of
  sk-int sg w → mr-bind (sv-as-i b) (λ c →
    (case left of
       true → sv-shl k (sk-int false iw64) a (sv-i (u64and c (u64sub (iw-bits w) uq1)))
       false → sv-shr k (sk-int false iw64) a (sv-i (u64and c (u64sub (iw-bits w) uq1)))))
  _ → mstop st-ill-typed
rm-cmp : CmpOp → SK → SV → SV → MRes SV
rm-cmp o k a b = mr-map sv-b (sv-cmp o k a b)
-- a binary operator at the kind of its operands (Offset and Cmp are not here: they need the
-- pointee's size and an enum's layout)
rm-binop : RBinOp → SK → SV → SV → REv SV
rm-binop o k = case o of
  rbin-add → λ a b → rm-res (rm-wrap ao-add k a b)
  rbin-sub → λ a b → rm-res (rm-wrap ao-sub k a b)
  rbin-mul → λ a b → rm-res (rm-wrap ao-mul k a b)
  rbin-add-unchecked → rm-unchecked true k
  rbin-sub-unchecked → rm-unchecked false k
  rbin-div → λ a b → rm-res (sv-arith ao-div k a b)
  rbin-rem → λ a b → rm-res (sv-arith ao-rem k a b)
  rbin-bit-xor → λ a b → rm-res (rm-bit ao-xor k a b)
  rbin-bit-and → λ a b → rm-res (rm-bit ao-and k a b)
  rbin-bit-or → λ a b → rm-res (rm-bit ao-or k a b)
  rbin-shl → λ a b → rm-res (rm-shift true k a b)
  rbin-shr → λ a b → rm-res (rm-shift false k a b)
  rbin-eq → λ a b → rm-res (rm-cmp co-eq k a b)
  rbin-lt → λ a b → rm-res (rm-cmp co-lt k a b)
  rbin-le → λ a b → rm-res (rm-cmp co-le k a b)
  rbin-ne → λ a b → rm-res (rm-cmp co-ne k a b)
  rbin-ge → λ a b → rm-res (rm-cmp co-ge k a b)
  rbin-gt → λ a b → rm-res (rm-cmp co-gt k a b)
  _ → λ a b → rm-throw (rx-unsupported (rz-binop o))
rm-sk-same : SK → SK → Bool
rm-sk-same a b = case a of
  sk-int s w → (case b of
    sk-int s2 w2 → m-and (u64eq (uq-b s) (uq-b s2)) (u64eq (iw-bits w) (iw-bits w2))
    _ → false)
  sk-bool → (case b of
    sk-bool → true
    _ → false)
  sk-ptr → (case b of
    sk-ptr → true
    _ → false)
  _ → false

-- ---------------------------------------------------------------- references
-- the projections without a final deref (the place a wide pointer is reborrowed from)
rm-is-nil : List RProj → Bool
rm-is-nil nil = true
rm-is-nil (cons p ps) = false
rm-init-deref : List RProj → RSt (List RProj)
rm-init-deref nil = sr-unsup rz-borrow-of-register
rm-init-deref (cons pr ps) = case rm-is-nil ps of
  true → (case pr of
    rproj-deref → sr-ok nil
    _ → sr-unsup rz-borrow-of-register)
  false → sr-map (λ r → cons pr r) (rm-init-deref ps)
-- &place and &raw place at the type of the result: a thin pointer is the place's address; a
-- wide one (the place is a slice or a dyn, reached by a deref) is the pointer derefed
rm-ref-of : RCx → RPlace → RTy → RFrame → REv RV
rm-ref-of cx pl dty =
  sr-on (cx-class cx dty) (λ e fr → rm-throw e) (λ c → case c of
    cl-scalar k →
                  (let addr = rm-place-addr cx pl
                   in λ fr → rm-bind (addr fr) (λ q → rm-ret (rv-s (sv-p q))))
    cl-fat mk → (case pl of
      rplace l ps → sr-on (rm-init-deref ps) (λ e fr → rm-throw e) (λ ps2 → rm-place-rv cx (rplace l ps2)))
    _ → λ fr → rm-throw (rx-ill-formed ri-operand-class))

-- ---------------------------------------------------------------- casts
rm-vt-index : List RVtable → RTy → Word → Word → RSt Word
rm-vt-index nil ty tr n = sr-ill (ri-no-vtable ty tr)
rm-vt-index (cons v vs) ty tr n = case v of
  rvtable t2 tr2 sz al dr ms → (case m-and (weq tr tr2) (rm-ty-eq ty t2) of
    true → sr-ok n
    false → rm-vt-index vs ty tr (wadd n #1))
cx-vtable : RCx → RTy → Word → RSt Word
cx-vtable cx ty tr = sr-map (cx-vtable-slot cx) (rm-vt-index (cr-vtables (cx-crate cx)) ty tr #0)
-- the discriminant of an enum operand converted to an integer kind (a cast of a C-like enum)
rm-cast-enum : RCx → RPlace → RTy → SK → RFrame → REv RV
rm-cast-enum cx pl sty kd =
  sr-on (rm-lay (cx-ls cx) sty) (λ e fr → rm-throw e) (λ l →
    let f = rm-discr (cx-t cx) l kd
        addr = rm-place-addr cx pl
    in λ fr → rm-bind (addr fr) (λ q → rm-bind (f q) (λ v → rm-ret (rv-s v))))
rm-cast-int : RCx → ROperand → RTy → RClass → RClass → RFrame → REv RV
rm-cast-int cx op sty sc dc = case dc of
  cl-scalar kd → (case sc of
    cl-scalar ks →
                   (let ev = rm-opd-rv cx op
                    in λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x →
                              rm-bind (rm-res (sv-conv ks kd x)) (λ y → rm-ret (rv-s y)))))
    cl-mem → (case op of
      rop-const c → λ fr → rm-throw (rx-unsupported (rz-cast rcast-int-to-int))
      rop-copy pl → rm-cast-enum cx pl sty kd
      rop-move pl → rm-cast-enum cx pl sty kd)
    _ → λ fr → rm-throw (rx-ill-formed ri-operand-class))
  _ → λ fr → rm-throw (rx-ill-formed ri-operand-class)
rm-cast-unsize : RCx → ROperand → RTy → RTy → RFrame → REv RV
rm-cast-unsize cx op sty dty =
  sr-on (rm-pointee sty) (λ e fr → rm-throw e) (λ sp →
  sr-on (rm-pointee dty) (λ e fr → rm-throw e) (λ dp →
    let ev = rm-opd-rv cx op
    in case dp of
         rty-slice e → (case sp of
           rty-array e2 n → (case n of
             rty-const c → λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x →
                                  rm-ret (rv-fat x (sv-i (uq-of-word c)))))
             _ → λ fr → rm-throw (rx-ill-formed (ri-open-type sp)))
           _ → λ fr → rm-throw (rx-unsupported (rz-cast rcast-unsize)))
         rty-dyn tr → sr-on (cx-vtable cx sp tr) (λ e fr → rm-throw e) (λ vi →
           λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x →
                  rm-bind (rm-image-rv fr vi) (λ vt → rm-bind (rm-as-s vt) (λ y → rm-ret (rv-fat x y))))))
         _ → λ fr → rm-throw (rx-unsupported (rz-cast rcast-unsize))))
rm-transmute-tmp : RCx → ROperand → RTy → RClass → RClass → RFrame → REv RV
rm-transmute-tmp cx op sty sc dc =
  sr-on (cx-size cx sty) (λ e fr → rm-throw e) (λ sz →
    let ev = rm-opd-rv cx op
    in λ fr → rm-bind (ev fr) (λ v →
              rm-bind (rm-alloc sz #8) (λ tp →
              rm-then (rm-wr-at (cx-t cx) sc #8 tp v)
             (rm-bind (rm-rd-at (cx-t cx) dc #8 tp) (λ r →
              rm-then (rm-release tp) (rm-ret r))))))
-- an object read at a register class, at the alignment of the place it is in
rm-transmute-rd : RCx → RPlace → RClass → RFrame → REv RV
rm-transmute-rd cx pl dc =
  sr-on (rm-place-al cx pl) (λ e fr → rm-throw e) (λ sa →
    let addr = rm-place-addr cx pl
    in λ fr → rm-bind (addr fr) (λ p → rm-rd-at (cx-t cx) dc sa p))
-- a transmute whose result is of a register class: the bytes of the operand read at the
-- result's class. An object operand is read where it is; a register operand of the same kind
-- is the value; otherwise its bytes are written to a temporary and read back.
rm-cast-transmute : RCx → ROperand → RTy → RClass → RTy → RClass → RFrame → REv RV
rm-cast-transmute cx op sty sc dty dc = case sc of
  cl-mem → (case op of
    rop-const c → λ fr → rm-throw (rx-unsupported (rz-transmute sty dty))
    rop-copy pl → rm-transmute-rd cx pl dc
    rop-move pl → rm-transmute-rd cx pl dc)
  cl-scalar ks → (case dc of
    cl-scalar kd → (case rm-sk-same ks kd of
      true → rm-opd-rv cx op
      false → rm-transmute-tmp cx op sty sc dc)
    _ → rm-transmute-tmp cx op sty sc dc)
  _ → rm-transmute-tmp cx op sty sc dc
rm-cast : RCx → RCastKind → ROperand → RTy → RFrame → REv RV
rm-cast cx k op dty =
  sr-on (rm-opd-ty cx op) (λ e fr → rm-throw e) (λ sty →
  sr-on (cx-class cx sty) (λ e fr → rm-throw e) (λ sc →
  sr-on (cx-class cx dty) (λ e fr → rm-throw e) (λ dc → case k of
    rcast-int-to-int → rm-cast-int cx op sty sc dc
    rcast-transmute → rm-cast-transmute cx op sty sc dty dc
    rcast-ptr-to-ptr → (case dc of
      cl-scalar kd →
                     (let ev = rm-opd-rv cx op
                      in λ fr → rm-bind (ev fr) (λ v → case v of
                           rv-s x → rm-ret (rv-s x)
                           rv-fat a m → rm-ret (rv-s a)
                           rv-dead → rm-throw (rx-ub rub-dead-local)
                           rv-unit → rm-throw (rx-ill-formed ri-operand-class)))
      cl-fat mk → (case sc of
        cl-fat mk2 → rm-opd-rv cx op
        _ → λ fr → rm-throw (rx-unsupported (rz-cast rcast-ptr-to-ptr)))
      _ → λ fr → rm-throw (rx-ill-formed ri-operand-class))
    rcast-unsize → rm-cast-unsize cx op sty dty
    rcast-reify-fn-pointer → rm-opd-rv cx op)))

-- ---------------------------------------------------------------- binary and unary operators
rm-binop-rv : RCx → RBinOp → ROperand → ROperand → RFrame → REv RV
rm-binop-rv cx o a b =
  sr-on (rm-opd-ty cx a) (λ e fr → rm-throw e) (λ aty →
  sr-on (cx-class cx aty) (λ e fr → rm-throw e) (λ ac →
    let ea = rm-opd-rv cx a
        eb = rm-opd-rv cx b
    in case o of
         rbin-offset →
           sr-on (rm-pointee aty) (λ e fr → rm-throw e) (λ pt →
           sr-on (cx-size cx pt) (λ e fr → rm-throw e) (λ es →
             λ fr → rm-bind (ea fr) (λ va → rm-bind (eb fr) (λ vb →
                    rm-bind (rm-as-s va) (λ x → rm-bind (rm-as-s vb) (λ y →
                    rm-bind (rm-res (sv-as-p x)) (λ p → rm-bind (rm-res (sv-as-i y)) (λ ix →
                    rm-bind (rm-elem-ptr p es ix) (λ q → rm-ret (rv-s (sv-p q)))))))))))
         rbin-cmp → λ fr → rm-throw (rx-ill-formed ri-operand-class)
         _ → (case ac of
           cl-scalar k →
                         (let f = rm-binop o k
                          in λ fr → rm-bind (ea fr) (λ va → rm-bind (eb fr) (λ vb →
                                    rm-bind (rm-as-s va) (λ x → rm-bind (rm-as-s vb) (λ y →
                                    rm-bind (f x y) (λ r → rm-ret (rv-s r)))))))
           _ → λ fr → rm-throw (rx-unsupported (rz-binop o)))))
rm-unop-rv : RCx → RUnOp → ROperand → RFrame → REv RV
rm-unop-rv cx o a =
  sr-on (rm-opd-ty cx a) (λ e fr → rm-throw e) (λ aty →
  sr-on (cx-class cx aty) (λ e fr → rm-throw e) (λ ac →
    let ea = rm-opd-rv cx a
    in case o of
         run-ptr-metadata → λ fr → rm-bind (ea fr) (λ v → case v of
           rv-fat p m → rm-ret (rv-s m)
           rv-s x → rm-ret rv-unit
           rv-dead → rm-throw (rx-ub rub-dead-local)
           rv-unit → rm-throw (rx-ill-formed ri-operand-class))
         run-not → (case ac of
           cl-scalar k → λ fr → rm-bind (ea fr) (λ v → rm-bind (rm-as-s v) (λ x →
                                rm-bind (rm-res (sv-not k x)) (λ r → rm-ret (rv-s r))))
           _ → λ fr → rm-throw (rx-unsupported (rz-unop o)))
         run-neg → (case ac of
           cl-scalar k → (case k of
             sk-int sg w → (case w of
               iw128 → λ fr → rm-throw (rx-unsupported rz-wide-128)
               _ → λ fr → rm-bind (ea fr) (λ v → rm-bind (rm-as-s v) (λ x →
                          rm-bind (rm-res (sv-as-i x)) (λ n → rm-ret (rv-s (sv-i (uq-cn sg w (uq-neg n))))))))
             _ → λ fr → rm-throw (rx-unsupported (rz-unop o)))
           _ → λ fr → rm-throw (rx-unsupported (rz-unop o)))))

-- ---------------------------------------------------------------- the rvalue as a value
rm-discr-rv : RCx → RPlace → RTy → RFrame → REv RV
rm-discr-rv cx pl dty =
  sr-on (rm-place-ty cx pl) (λ e fr → rm-throw e) (λ pty →
  sr-on (rm-lay (cx-ls cx) pty) (λ e fr → rm-throw e) (λ l →
  sr-on (cx-class cx dty) (λ e fr → rm-throw e) (λ dc → case dc of
    cl-scalar kd →
                   (let f = rm-discr (cx-t cx) l kd
                        addr = rm-place-addr cx pl
                    in λ fr → rm-bind (addr fr) (λ q → rm-bind (f q) (λ v → rm-ret (rv-s v))))
    _ → λ fr → rm-throw (rx-ill-formed ri-operand-class))))
rm-agg-rv : RCx → RAggregate → List ROperand → RFrame → REv RV
rm-agg-rv cx k ops = case k of
  rag-raw-ptr pt m → (case ops of
    cons a as → (case as of
      cons b bs → (case rm-unsized (cx-ty cx pt) of
        true →
               (let ea = rm-opd-rv cx a
                    eb = rm-opd-rv cx b
                in λ fr → rm-bind (ea fr) (λ va → rm-bind (eb fr) (λ vb →
                          rm-bind (rm-as-s va) (λ x → rm-bind (rm-as-s vb) (λ y → rm-ret (rv-fat x y))))))
        false → rm-opd-rv cx a)
      nil → λ fr → rm-throw (rx-ill-formed ri-arity))
    nil → λ fr → rm-throw (rx-ill-formed ri-arity))
  rag-tuple → (case ops of
    nil → λ fr → rm-ret rv-unit
    cons a as → λ fr → rm-throw (rx-ill-formed ri-operand-class))
  _ → λ fr → rm-throw (rx-ill-formed ri-operand-class)
-- rm-rv-val cx rvalue type-of-the-destination
rm-rv-val : RCx → RRvalue → RTy → RFrame → REv RV
rm-rv-val cx rv dty = case rv of
  rrv-use op rt → rm-opd-rv cx op
  rrv-repeat op n → λ fr → rm-throw (rx-ill-formed ri-operand-class)
  rrv-ref k p → rm-ref-of cx p dty
  rrv-raw-ptr m p → rm-ref-of cx p dty
  rrv-cast k op ty → rm-cast cx k op dty
  rrv-binop o a b → rm-binop-rv cx o a b
  rrv-unop o a → rm-unop-rv cx o a
  rrv-discriminant p → rm-discr-rv cx p dty
  rrv-aggregate k ops → rm-agg-rv cx k ops

-- ---------------------------------------------------------------- the rvalue written to memory
-- operands stored at the fields they fill
rm-agg-fields : List ROperand → RCx → List RFieldLayout → Word → RFrame → MPtr → REv Unit
rm-agg-fields nil cx fls al = λ fr p → rm-ret unit
rm-agg-fields (cons op ops) cx fls al = case fls of
  nil → λ fr p → rm-throw (rx-ill-formed ri-arity)
  cons f fs →
    sr-on (cx-align cx (rf-ty f)) (λ e fr p → rm-throw e) (λ fa →
      let one = rm-opd-into cx op (rf-ty f) (rm-wmin al fa)
          rest = rm-agg-fields ops cx fs al
      in λ fr p → rm-bind (rm-off p (rf-off f)) (λ q → rm-then (one fr q) (rest fr p)))
-- operands stored at consecutive elements: rm-agg-elems ops cx element-type element-size alignment index
rm-agg-elems : List ROperand → RCx → RTy → Word → Word → Word → RFrame → MPtr → REv Unit
rm-agg-elems nil cx et es al j = λ fr p → rm-ret unit
rm-agg-elems (cons op ops) cx et es al j =
  let one = rm-opd-into cx op et al
      rest = rm-agg-elems ops cx et es al (wadd j #1)
  in λ fr p → rm-bind (rm-off p (wmul j es)) (λ q → rm-then (one fr q) (rest fr p))
rm-repeat : Word → Word → (RFrame → MPtr → REv Unit) → RFrame → MPtr → REv Unit
rm-repeat n es one =
  %welimP (λ x → RFrame → MPtr → REv Unit) n (λ fr p → rm-ret unit)
    (λ j acc fr p → rm-then (acc fr p) (rm-bind (rm-off p (wmul j es)) (λ q → one fr q)))
rm-agg-mem : RCx → RAggregate → List ROperand → RTy → Word → RFrame → MPtr → REv Unit
rm-agg-mem cx k ops dty al = case k of
  rag-array →
    sr-on (rm-elem dty) (λ e fr p → rm-throw e) (λ et →
    sr-on (cx-size cx et) (λ e fr p → rm-throw e) (λ es →
    sr-on (cx-align cx et) (λ e fr p → rm-throw e) (λ ea →
      rm-agg-elems ops cx et es (rm-wmin al ea) #0)))
  rag-tuple →
    sr-on (rm-lay (cx-ls cx) dty) (λ e fr p → rm-throw e) (λ l → case ly-variants-of l of
      nil → λ fr p → rm-throw (rx-ill-formed (ri-no-variant dty #0))
      cons v vs → rm-agg-fields ops cx (vl-fields-of v) al)
  rag-adt a v gs →
    sr-on (rm-lay (cx-ls cx) dty) (λ e fr p → rm-throw e) (λ l →
    sr-on (rm-nth (ly-variants-of l) v (ri-no-variant dty v)) (λ e fr p → rm-throw e) (λ vl →
      let body = rm-agg-fields ops cx (vl-fields-of vl) al
          tag = rm-set-tag (cx-t cx) l dty v
      in λ fr p → rm-then (body fr p) (tag p)))
  rag-raw-ptr pt m → λ fr p → rm-throw (rx-ill-formed ri-operand-class)
rm-transmute-cp : RCx → RPlace → RTy → Word → RFrame → MPtr → REv Unit
rm-transmute-cp cx pl dty al =
  sr-on (rm-place-al cx pl) (λ e fr p → rm-throw e) (λ sa →
    let addr = rm-place-addr cx pl
        cp = cx-copy cx dty al sa
    in λ fr p → rm-bind (addr fr) (λ s → cp p s))
-- a transmute into memory: an object operand copied at the destination's type from where it
-- is; a register operand's value written
rm-transmute-mem : RCx → ROperand → RTy → Word → RFrame → MPtr → REv Unit
rm-transmute-mem cx op dty al =
  sr-on (rm-opd-ty cx op) (λ e fr p → rm-throw e) (λ sty →
  sr-on (cx-class cx sty) (λ e fr p → rm-throw e) (λ sc → case sc of
    cl-mem → (case op of
      rop-const c → λ fr p → rm-throw (rx-unsupported (rz-transmute sty dty))
      rop-copy pl → rm-transmute-cp cx pl dty al
      rop-move pl → rm-transmute-cp cx pl dty al)
    _ →
        (let ev = rm-opd-rv cx op
         in λ fr p → rm-bind (ev fr) (λ v → rm-wr-at (cx-t cx) sc al p v))))
-- the three-way comparison: the variant Less, Equal or Greater (0, 1, 2) of the result's enum
rm-cmp3-into : RCx → ROperand → ROperand → RTy → RFrame → MPtr → REv Unit
rm-cmp3-into cx a b dty =
  sr-on (rm-opd-ty cx a) (λ e fr p → rm-throw e) (λ aty →
  sr-on (cx-class cx aty) (λ e fr p → rm-throw e) (λ ac →
  sr-on (rm-lay (cx-ls cx) dty) (λ e fr p → rm-throw e) (λ l → case ac of
    cl-scalar k →
      (let ea = rm-opd-rv cx a
           eb = rm-opd-rv cx b
           t0 = rm-set-tag (cx-t cx) l dty #0
           t1 = rm-set-tag (cx-t cx) l dty #1
           t2 = rm-set-tag (cx-t cx) l dty #2
       in λ fr p → rm-bind (ea fr) (λ va → rm-bind (eb fr) (λ vb →
                   rm-bind (rm-as-s va) (λ x → rm-bind (rm-as-s vb) (λ y →
                   rm-bind (rm-res (sv-cmp co-lt k x y)) (λ lt → case lt of
                     true → t0 p
                     false → rm-bind (rm-res (sv-cmp co-eq k x y)) (λ eq → case eq of
                       true → t1 p
                       false → t2 p)))))))
    _ → λ fr p → rm-throw (rx-unsupported (rz-binop rbin-cmp)))))
rm-rv-mem : RCx → RRvalue → RTy → Word → RFrame → MPtr → REv Unit
rm-rv-mem cx rv dty al = case rv of
  rrv-use op rt → rm-opd-into cx op dty al
  rrv-repeat op n →
    sr-on (rm-elem dty) (λ e fr p → rm-throw e) (λ et →
    sr-on (cx-size cx et) (λ e fr p → rm-throw e) (λ es →
    sr-on (cx-align cx et) (λ e fr p → rm-throw e) (λ ea → case cx-ty cx n of
      rty-const c → rm-repeat c es (rm-opd-into cx op et (rm-wmin al ea))
      _ → λ fr p → rm-throw (rx-ill-formed (ri-open-type n)))))
  rrv-aggregate k ops → rm-agg-mem cx k ops dty al
  rrv-cast k op ty → (case k of
    rcast-transmute → rm-transmute-mem cx op dty al
    _ → λ fr p → rm-throw (rx-unsupported (rz-cast k)))
  rrv-binop o a b → (case o of
    rbin-cmp → rm-cmp3-into cx a b dty
    _ → λ fr p → rm-throw (rx-ill-formed ri-operand-class))
  rrv-ref k p → λ fr p2 → rm-throw (rx-ill-formed ri-operand-class)
  rrv-raw-ptr m p → λ fr p2 → rm-throw (rx-ill-formed ri-operand-class)
  rrv-unop o a → λ fr p → rm-throw (rx-ill-formed ri-operand-class)
  rrv-discriminant p → λ fr p2 → rm-throw (rx-ill-formed ri-operand-class)
-- rm-rv-into cx rvalue type alignment frame pointer
rm-rv-into : RCx → RRvalue → RTy → Word → RFrame → MPtr → REv Unit
rm-rv-into cx rv dty al =
  sr-on (cx-class cx dty) (λ e fr p → rm-throw e) (λ c → case c of
    cl-mem → rm-rv-mem cx rv dty al
    _ →
        (let ev = rm-rv-val cx rv dty
         in λ fr p → rm-bind (ev fr) (λ v → rm-wr-at (cx-t cx) c al p v)))
