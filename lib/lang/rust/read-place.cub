-- lib/lang/rust/read-place.cub — the reading of MIR, first part: memory access at a class,
-- typed copies by layout, tags and discriminants, places with their projections, operands and
-- constants. Loaded after lib/lang/rust/machine.cub.
--
-- Binding time: every function here takes what the MIR decides (the context RCx, the syntax, a
-- type, an alignment) and returns a function of the run-time values (the frame, pointers). All
-- cases on syntax, type substitution, layout lookups and offset arithmetic stand before that
-- function is returned, so a block read once is a closure whose applications do only loads,
-- stores, scalar operations and frame accesses.

-- ---------------------------------------------------------------- the memory commands the reader uses
-- The reader never holds a memory: these are all the ways it reaches one, each a named
-- operation of lib/mem/monad.cub, and a pointer is only ever a value they return or take.
-- (tracks/README.md, "Memory is a signature"; when track M's signature of memory commands
-- lands, this section is restated over its commands and nothing else in the reader changes.
-- What is missing from the named operations today is under "Needs from track M" in
-- tracks/R-rust.md.)
rm-alloc : Word → Word → REv MPtr
rm-alloc size al = ev-alloc {lzero} {NoS} {RExc} ak-auto false size al
rm-alloc-static : Word → Word → REv MPtr
rm-alloc-static size al = ev-alloc {lzero} {NoS} {RExc} ak-static false size al
rm-release : MPtr → REv Unit
rm-release p = ev-release {lzero} {NoS} {RExc} ak-auto p
-- a pointer advanced by a number of elements of a size, and by a number of bytes
rm-elem-ptr : MPtr → Word → UInt64 → REv MPtr
rm-elem-ptr p es ix = ev-ptr-add {lzero} {NoS} {RExc} p es ix
rm-off : MPtr → Word → REv MPtr
rm-off p n = rm-elem-ptr p #1 (uq-of-word n)
-- the null pointer, a function as a pointer (an instance's index), and the function a pointer is
rm-null : SV
rm-null = sv-p mp-null
rm-fn-ptr : Word → SV
rm-fn-ptr j = sv-p (mp-fn j)
rm-fn-of : SV → REv Word
rm-fn-of v = rm-bind (rm-res (sv-as-p v)) (λ p → case p of
  mp-fn j → rm-ret j
  _ → rm-throw (rx-ub rub-bad-fn-pointer))
-- An integer of 2, 4 or 8 bytes at an alignment below its kind's (a field of a packed struct,
-- an array of bytes transmuted): the monad's load and store are at the kind's own alignment,
-- so it is read and written as its bytes in the Target's order.
rm-bytes-rd : Word → Target → MPtr → REv UInt64
rm-bytes-rd n t p =
  %welimP (λ x → REv UInt64) n (rm-ret uq0)
    (λ j acc → rm-bind acc (λ hi →
       rm-bind (rm-off p (case tg-endian t of
                            en-little → wsub (wsub n #1) j
                            en-big → j)) (λ q →
       rm-bind (ev-load {lzero} {NoS} {RExc} t (sk-int false iw8) q) (λ b →
       rm-bind (rm-res (sv-as-i b)) (λ x → rm-ret (u64or (u64shl hi (u64 #8)) x))))))
rm-bytes-wr : Word → Target → MPtr → UInt64 → REv Unit
rm-bytes-wr n t p v =
  %welimP (λ x → REv Unit) n (rm-ret unit)
    (λ j acc → rm-then acc
       (rm-bind (rm-off p (case tg-endian t of
                             en-little → j
                             en-big → wsub (wsub n #1) j)) (λ q →
        ev-store {lzero} {NoS} {RExc} t (sk-int false iw8) q
          (sv-i (u64and (u64shr v (u64 (wmul j #8))) (u64 #255))))))
rm-load : Target → SK → Word → MPtr → REv SV
rm-load t k al p = case wlt al (sk-align t k) of
  false → ev-load {lzero} {NoS} {RExc} t k p
  true → (case k of
    sk-int sg w → (case w of
      iw128 → rm-throw (rx-unsupported (rz-unaligned k))
      _ → rm-bind (rm-bytes-rd (iw-bytes w) t p) (λ x → rm-ret (sv-i (uq-cn sg w x))))
    _ → rm-throw (rx-unsupported (rz-unaligned k)))
rm-store : Target → SK → Word → MPtr → SV → REv Unit
rm-store t k al p v = case wlt al (sk-align t k) of
  false → ev-store {lzero} {NoS} {RExc} t k p v
  true → (case k of
    sk-int sg w → (case w of
      iw128 → rm-throw (rx-unsupported (rz-unaligned k))
      _ → rm-bind (rm-res (sv-as-i v)) (λ x → rm-bytes-wr (iw-bytes w) t p (uq-zx w x)))
    _ → rm-throw (rx-unsupported (rz-unaligned k)))

-- a value of a register class read from and written to memory at an alignment
rm-rd-at : Target → RClass → Word → MPtr → REv RV
rm-rd-at t c al p = case c of
  cl-scalar k → rm-bind (rm-load t k al p) (λ v → rm-ret (rv-s v))
  cl-fat mk → rm-bind (rm-load t sk-ptr al p) (λ a →
              rm-bind (rm-off p (tg-size t ck-ptr)) (λ q →
              rm-bind (rm-load t mk al q) (λ m → rm-ret (rv-fat a m))))
  cl-unit → rm-ret rv-unit
  cl-mem → rm-throw (rx-ill-formed ri-operand-class)
rm-wr-at : Target → RClass → Word → MPtr → RV → REv Unit
rm-wr-at t c al p v = case c of
  cl-scalar k → (case v of
    rv-s x → rm-store t k al p x
    _ → rm-throw (rx-ill-formed ri-operand-class))
  cl-fat mk → (case v of
    rv-fat a m → rm-then (rm-store t sk-ptr al p a)
                   (rm-bind (rm-off p (tg-size t ck-ptr)) (λ q → rm-store t mk al q m))
    _ → rm-throw (rx-ill-formed ri-operand-class))
  cl-unit → rm-ret unit
  cl-mem → rm-throw (rx-ill-formed ri-operand-class)

-- ---------------------------------------------------------------- typed copy
-- A value of a type copied from one place to another, by the type: a scalar is loaded and
-- stored (so an unwritten scalar is undefined to copy, and padding is not copied), a struct or
-- tuple field by field, an array element by element, an enum by its tag: the active variant's
-- fields, then the tag. A tag that is no variant's is undefined behaviour (a niche encoding
-- has an untagged variant, which every other tag value means). Layouts refer to types and
-- types to layouts, so the recursion is on a depth (the number of layouts bounds it).
rm-copy-fields : List RFieldLayout → (RTy → Word → Word → MPtr → MPtr → REv Unit) → Target → List RLayoutEntry → Word → Word → MPtr → MPtr → REv Unit
rm-copy-fields nil cpy t ls da sa = λ dst src → rm-ret unit
rm-copy-fields (cons f fs) cpy t ls da sa =
  sr-on (rm-align t ls (rf-ty f)) (λ e dst src → rm-throw e) (λ fa →
    let one = cpy (rf-ty f) (rm-wmin da fa) (rm-wmin sa fa)
        rest = rm-copy-fields fs cpy t ls da sa
    in λ dst src → rm-bind (rm-off dst (rf-off f)) (λ d →
                   rm-bind (rm-off src (rf-off f)) (λ s →
                   rm-then (one d s) (rest dst src))))
rm-copy-elems : Word → Word → (MPtr → MPtr → REv Unit) → MPtr → MPtr → REv Unit
rm-copy-elems n es ce =
  %welimP (λ x → MPtr → MPtr → REv Unit) n (λ dst src → rm-ret unit)
    (λ j acc dst src → rm-then (acc dst src)
       (rm-bind (rm-off dst (wmul j es)) (λ d →
        rm-bind (rm-off src (wmul j es)) (λ s → ce d s))))
-- the fields of the variant a niche encoding leaves untagged, and its discriminant
rm-untagged-fields : List RVariantLayout → List RFieldLayout
rm-untagged-fields nil = nil
rm-untagged-fields (cons v vs) = case vl-tag-of v of
  rtv-none → vl-fields-of v
  rtv-some x → rm-untagged-fields vs
rm-untagged-discr : List RVariantLayout → RSt RInt
rm-untagged-discr nil = sr-no (rx-ub rub-invalid-discriminant)
rm-untagged-discr (cons v vs) = case vl-tag-of v of
  rtv-none → sr-ok (vl-discr-of v)
  rtv-some x → rm-untagged-discr vs
-- by the tag read: the variant whose tag it is (its fields, then the tag written), else the fallback
rm-copy-variants : List RVariantLayout → (List RFieldLayout → MPtr → MPtr → REv Unit) → (UInt64 → MPtr → REv Unit) → (MPtr → MPtr → REv Unit) → UInt64 → MPtr → MPtr → REv Unit
rm-copy-variants nil cf wt fb = λ tg dst src → fb dst src
rm-copy-variants (cons v vs) cf wt fb = case vl-tag-of v of
  rtv-none → rm-copy-variants vs cf wt fb
  rtv-some x →
    (let me = cf (vl-fields-of v)
         rest = rm-copy-variants vs cf wt fb
     in λ tg dst src → case u64eq tg (uq-of-word x) of
          true → rm-then (me dst src) (wt tg dst)
          false → rest tg dst src)
rm-copy-tagged : Bool → Word → Word → List RVariantLayout → (RTy → Word → Word → MPtr → MPtr → REv Unit) → Target → List RLayoutEntry → Word → Word → MPtr → MPtr → REv Unit
rm-copy-tagged niche off size vs cpy t ls da sa =
  sr-on (rm-tag-sk size) (λ e dst src → rm-throw e) (λ tk →
    let go = rm-copy-variants vs (λ fs → rm-copy-fields fs cpy t ls da sa)
               (λ tg dst → rm-bind (rm-off dst off) (λ q → rm-store t tk #1 q (sv-i tg)))
               (case niche of
                  true → rm-copy-fields (rm-untagged-fields vs) cpy t ls da sa
                  false → λ dst src → rm-throw (rx-ub rub-invalid-discriminant))
    in λ dst src → rm-bind (rm-off src off) (λ q →
                   rm-bind (rm-load t tk #1 q) (λ tv →
                   rm-bind (rm-res (sv-as-i tv)) (λ tg → go tg dst src))))
rm-copy-mem : (RTy → Word → Word → MPtr → MPtr → REv Unit) → Target → List RLayoutEntry → RTy → Word → Word → MPtr → MPtr → REv Unit
rm-copy-mem cpy t ls ty da sa = case ty of
  rty-array e n → (case n of
    rty-const c →
      sr-on (rm-size t ls e) (λ x dst src → rm-throw x) (λ es →
      sr-on (rm-align t ls e) (λ x dst src → rm-throw x) (λ ea →
        rm-copy-elems c es (cpy e (rm-wmin da ea) (rm-wmin sa ea))))
    _ → λ dst src → rm-throw (rx-ill-formed (ri-open-type ty)))
  _ → sr-on (rm-lay ls ty) (λ x dst src → rm-throw x) (λ l → case ly-tag-of l of
    rtag-none → (case ly-variants-of l of
      nil → λ dst src → rm-ret unit
      cons v vs → rm-copy-fields (vl-fields-of v) cpy t ls da sa)
    rtag-direct off size → rm-copy-tagged false off size (ly-variants-of l) cpy t ls da sa
    rtag-niche off size → rm-copy-tagged true off size (ly-variants-of l) cpy t ls da sa)
-- rm-copy depth target layouts type dst-alignment src-alignment dst src
rm-copy : Word → Target → List RLayoutEntry → RTy → Word → Word → MPtr → MPtr → REv Unit
rm-copy d t ls =
  %welimP (λ x → RTy → Word → Word → MPtr → MPtr → REv Unit) d
    (λ ty da sa dst src → rm-throw (rx-ill-formed ri-layout-depth))
    (λ k cpy ty da sa → sr-on (rm-class t ty) (λ e dst src → rm-throw e) (λ c → case c of
       cl-mem → rm-copy-mem cpy t ls ty da sa
       cl-unit → λ dst src → rm-ret unit
       cl-scalar sk → λ dst src → rm-bind (rm-rd-at t (cl-scalar sk) sa src) (rm-wr-at t (cl-scalar sk) da dst)
       cl-fat mk → λ dst src → rm-bind (rm-rd-at t (cl-fat mk) sa src) (rm-wr-at t (cl-fat mk) da dst)))

-- ---------------------------------------------------------------- tags and discriminants
rm-set-tag-at : Target → Word → Word → List RVariantLayout → RTy → Word → MPtr → REv Unit
rm-set-tag-at t off size vs ty v =
  sr-on (rm-nth vs v (ri-no-variant ty v)) (λ e p → rm-throw e) (λ vl → case vl-tag-of vl of
    rtv-none → λ p → rm-ret unit
    rtv-some x → sr-on (rm-tag-sk size) (λ e p → rm-throw e) (λ tk →
      λ p → rm-bind (rm-off p off) (λ q → rm-store t tk #1 q (sv-i (uq-of-word x)))))
-- the tag of a variant written (nothing for a single-variant type and for the untagged variant)
rm-set-tag : Target → RLayout → RTy → Word → MPtr → REv Unit
rm-set-tag t l ty v = case ly-tag-of l of
  rtag-none → λ p → rm-ret unit
  rtag-direct off size → rm-set-tag-at t off size (ly-variants-of l) ty v
  rtag-niche off size → rm-set-tag-at t off size (ly-variants-of l) ty v
-- the discriminant of the value at a pointer, as a value of an integer kind
rm-discr-chain : List RVariantLayout → SK → REv SV → UInt64 → REv SV
rm-discr-chain nil k fb = λ tg → fb
rm-discr-chain (cons v vs) k fb = case vl-tag-of v of
  rtv-none → rm-discr-chain vs k fb
  rtv-some x → sr-on (rm-int-sv k (vl-discr-of v)) (λ e tg → rm-throw e) (λ dv →
    let rest = rm-discr-chain vs k fb
    in λ tg → case u64eq tg (uq-of-word x) of
         true → rm-ret dv
         false → rest tg)
rm-discr-tagged : Target → Bool → Word → Word → List RVariantLayout → SK → MPtr → REv SV
rm-discr-tagged t niche off size vs k =
  sr-on (rm-tag-sk size) (λ e p → rm-throw e) (λ tk →
    let go = rm-discr-chain vs k (case niche of
               true → rm-st (sr-bind (rm-untagged-discr vs) (rm-int-sv k)) (λ dv → rm-ret dv)
               false → rm-throw (rx-ub rub-invalid-discriminant))
    in λ p → rm-bind (rm-off p off) (λ q →
             rm-bind (rm-load t tk #1 q) (λ tv →
             rm-bind (rm-res (sv-as-i tv)) go)))
rm-discr : Target → RLayout → SK → MPtr → REv SV
rm-discr t l k = case ly-tag-of l of
  rtag-none → (case ly-variants-of l of
    nil → λ p → rm-throw (rx-ub rub-invalid-discriminant)
    cons v vs → sr-on (rm-int-sv k (vl-discr-of v)) (λ e p → rm-throw e) (λ dv → λ p → rm-ret dv))
  rtag-direct off size → rm-discr-tagged t false off size (ly-variants-of l) k
  rtag-niche off size → rm-discr-tagged t true off size (ly-variants-of l) k

-- ---------------------------------------------------------------- the context of a reading
-- what is fixed while one instance's body is read: the Target, the crate, the instance's
-- generic arguments, the body's locals, and the depth bound for recursion through layouts
record RCx = { cx-t : Target ; cx-crate : RCrate ; cx-args : RTy ; cx-locals : List RLocal ; cx-depth : Word }
cx-ls : RCx → List RLayoutEntry
cx-ls cx = cr-layouts (cx-crate cx)
cx-ty : RCx → RTy → RTy
cx-ty cx ty = rm-subst ty (cx-args cx)
cx-lty : RCx → Word → RSt RTy
cx-lty cx i = sr-map (λ l → rm-subst (rl-ty l) (cx-args cx)) (rm-nth (cx-locals cx) i (ri-no-local i))
cx-class : RCx → RTy → RSt RClass
cx-class cx ty = rm-class (cx-t cx) ty
cx-size : RCx → RTy → RSt Word
cx-size cx ty = rm-size (cx-t cx) (cx-ls cx) ty
cx-align : RCx → RTy → RSt Word
cx-align cx ty = rm-align (cx-t cx) (cx-ls cx) ty
cx-copy : RCx → RTy → Word → Word → MPtr → MPtr → REv Unit
cx-copy cx ty da sa = rm-copy (cx-depth cx) (cx-t cx) (cx-ls cx) ty da sa

-- ---------------------------------------------------------------- places
-- the offset of field i of variant v of an ADT or tuple type
rm-field-off : RCx → RTy → Word → Word → RSt Word
rm-field-off cx ty v i =
  sr-bind (rm-lay (cx-ls cx) ty) (λ l →
  sr-bind (rm-nth (ly-variants-of l) v (ri-no-variant ty v)) (λ vl →
  sr-map rf-off (rm-nth (vl-fields-of vl) i (ri-no-field ty i))))
-- the type of a place: the local's type through the projections
rm-proj-ty : List RProj → RCx → RTy → RSt RTy
rm-proj-ty nil cx ty = sr-ok ty
rm-proj-ty (cons pr ps) cx ty = case pr of
  rproj-deref → sr-bind (rm-pointee ty) (λ t2 → rm-proj-ty ps cx t2)
  rproj-field i ft → rm-proj-ty ps cx (cx-ty cx ft)
  rproj-index l → sr-bind (rm-elem ty) (λ t2 → rm-proj-ty ps cx t2)
  rproj-const-index o n fe → sr-bind (rm-elem ty) (λ t2 → rm-proj-ty ps cx t2)
  rproj-downcast v → rm-proj-ty ps cx ty
-- the alignment of a place: its type's, but no more than the alignment of the place it is a
-- part of (a field of a packed struct is aligned as the struct); a deref starts again from
-- the pointee's
rm-proj-al : List RProj → RCx → RTy → Word → RSt Word
rm-proj-al nil cx ty al = sr-ok al
rm-proj-al (cons pr ps) cx ty al = case pr of
  rproj-deref → sr-bind (rm-pointee ty) (λ t2 → sr-bind (cx-align cx t2) (λ a2 → rm-proj-al ps cx t2 a2))
  rproj-field i ft → sr-bind (cx-align cx (cx-ty cx ft)) (λ fa → rm-proj-al ps cx (cx-ty cx ft) (rm-wmin al fa))
  rproj-index l → sr-bind (rm-elem ty) (λ t2 → sr-bind (cx-align cx t2) (λ a2 → rm-proj-al ps cx t2 (rm-wmin al a2)))
  rproj-const-index o n fe → sr-bind (rm-elem ty) (λ t2 → sr-bind (cx-align cx t2) (λ a2 → rm-proj-al ps cx t2 (rm-wmin al a2)))
  rproj-downcast v → rm-proj-al ps cx ty al
-- the integer in a register local (an index)
rm-reg-int : RFrame → Word → REv UInt64
rm-reg-int fr l = rm-bind (fr-get fr l) (λ s → case s of
  sl-reg v → (case v of
    rv-s x → rm-res (sv-as-i x)
    rv-dead → rm-throw (rx-ub rub-dead-local)
    _ → rm-throw (rx-ill-formed ri-operand-class))
  sl-mem p → rm-throw (rx-ill-formed ri-operand-class)
  sl-none → rm-throw (rx-ill-formed ri-operand-class))
-- the pointer a register holds (the address part of a wide one)
rm-slot-ptr : RSlot → REv MPtr
rm-slot-ptr s = case s of
  sl-reg v → (case v of
    rv-s x → rm-res (sv-as-p x)
    rv-fat a m → rm-res (sv-as-p a)
    rv-dead → rm-throw (rx-ub rub-dead-local)
    rv-unit → rm-throw (rx-ill-formed ri-operand-class))
  sl-mem p → rm-throw (rx-ill-formed ri-operand-class)
  sl-none → rm-throw (rx-ill-formed ri-operand-class)
-- the projections applied to a pointer: rm-proj-go projs cx type variant alignment frame pointer
rm-proj-go : List RProj → RCx → RTy → Word → Word → RFrame → MPtr → REv MPtr
rm-proj-go nil cx ty var al = λ fr p → rm-ret p
rm-proj-go (cons pr ps) cx ty var al = case pr of
  rproj-deref →
    sr-on (rm-pointee ty) (λ e fr p → rm-throw e) (λ t2 →
    sr-on (cx-align cx t2) (λ e fr p → rm-throw e) (λ a2 →
      let rest = rm-proj-go ps cx t2 #0 a2
      in λ fr p → rm-bind (rm-load (cx-t cx) sk-ptr al p) (λ v →
                  rm-bind (rm-res (sv-as-p v)) (λ q → rest fr q))))
  rproj-field i ft →
    sr-on (rm-field-off cx ty var i) (λ e fr p → rm-throw e) (λ off →
    sr-on (cx-align cx (cx-ty cx ft)) (λ e fr p → rm-throw e) (λ fa →
      let rest = rm-proj-go ps cx (cx-ty cx ft) #0 (rm-wmin al fa)
      in λ fr p → rm-bind (rm-off p off) (λ q → rest fr q)))
  rproj-index l →
    sr-on (rm-elem ty) (λ e fr p → rm-throw e) (λ et →
    sr-on (cx-size cx et) (λ e fr p → rm-throw e) (λ es →
    sr-on (cx-align cx et) (λ e fr p → rm-throw e) (λ ea →
      let rest = rm-proj-go ps cx et #0 (rm-wmin al ea)
      in λ fr p → rm-bind (rm-reg-int fr l) (λ ix →
                  rm-bind (rm-elem-ptr p es ix) (λ q → rest fr q)))))
  rproj-const-index o n fe →
    sr-on (rm-elem ty) (λ e fr p → rm-throw e) (λ et →
    sr-on (cx-size cx et) (λ e fr p → rm-throw e) (λ es →
    sr-on (cx-align cx et) (λ e fr p → rm-throw e) (λ ea →
      let rest = rm-proj-go ps cx et #0 (rm-wmin al ea)
      in case fe of
           false → λ fr p → rm-bind (rm-off p (wmul o es)) (λ q → rest fr q)
           true → (case ty of
             rty-array e2 n2 → (case n2 of
               rty-const c → λ fr p → rm-bind (rm-off p (wmul (wsub c o) es)) (λ q → rest fr q)
               _ → λ fr p → rm-throw (rx-ill-formed (ri-open-type ty)))
             _ → λ fr p → rm-throw (rx-unsupported rz-const-index-from-end-of-slice)))))
  rproj-downcast v → rm-proj-go ps cx ty v al
-- the address of a place. An object local: its allocation, through the projections. A
-- register local: only through its value (the place starts with a deref).
rm-place-addr : RCx → RPlace → RFrame → REv MPtr
rm-place-addr cx (rplace l ps) =
  sr-on (cx-lty cx l) (λ e fr → rm-throw e) (λ lt →
  sr-on (cx-class cx lt) (λ e fr → rm-throw e) (λ c → case c of
    cl-mem → sr-on (cx-align cx lt) (λ e fr → rm-throw e) (λ la →
      let go = rm-proj-go ps cx lt #0 la
      in λ fr → rm-bind (fr-get fr l) (λ s → case s of
           sl-mem p → go fr p
           sl-none → rm-throw (rx-ub rub-dead-local)
           sl-reg v → rm-throw (rx-ill-formed ri-operand-class)))
    cl-unit → λ fr → rm-throw (rx-unsupported rz-borrow-of-register)
    _ → (case ps of
      nil → λ fr → rm-throw (rx-unsupported rz-borrow-of-register)
      cons pr ps2 → (case pr of
        rproj-deref →
          sr-on (rm-pointee lt) (λ e fr → rm-throw e) (λ t2 →
          sr-on (cx-align cx t2) (λ e fr → rm-throw e) (λ a2 →
            let go = rm-proj-go ps2 cx t2 #0 a2
            in λ fr → rm-bind (fr-get fr l) (λ s → rm-bind (rm-slot-ptr s) (λ p → go fr p))))
        _ → λ fr → rm-throw (rx-ill-formed (ri-place lt))))))
rm-place-ty : RCx → RPlace → RSt RTy
rm-place-ty cx (rplace l ps) = sr-bind (cx-lty cx l) (λ lt → rm-proj-ty ps cx lt)
rm-place-al : RCx → RPlace → RSt Word
rm-place-al cx (rplace l ps) =
  sr-bind (cx-lty cx l) (λ lt → sr-bind (cx-align cx lt) (λ la → rm-proj-al ps cx lt la))
-- whether a place is a register itself (a register local with no projection)
rm-place-is-reg : RCx → RPlace → RSt Bool
rm-place-is-reg cx (rplace l ps) = case ps of
  cons pr ps2 → sr-ok false
  nil → sr-bind (cx-lty cx l) (λ lt → sr-map (λ c → case c of
    cl-mem → false
    _ → true) (cx-class cx lt))
rm-place-local : RPlace → Word
rm-place-local (rplace l ps) = l
-- the value of a place of a register class
rm-place-rv : RCx → RPlace → RFrame → REv RV
rm-place-rv cx pl =
  sr-on (rm-place-is-reg cx pl) (λ e fr → rm-throw e) (λ isr → case isr of
    true → λ fr → rm-bind (fr-get fr (rm-place-local pl)) (λ s → case s of
      sl-reg v → (case v of
        rv-s x → rm-ret (rv-s x)
        rv-fat a m → rm-ret (rv-fat a m)
        rv-unit → rm-ret rv-unit
        rv-dead → rm-throw (rx-ub rub-dead-local))
      sl-mem p → rm-throw (rx-ill-formed ri-operand-class)
      sl-none → rm-throw (rx-ill-formed ri-operand-class))
    false →
      sr-on (rm-place-ty cx pl) (λ e fr → rm-throw e) (λ ty →
      sr-on (cx-class cx ty) (λ e fr → rm-throw e) (λ c →
      sr-on (rm-place-al cx pl) (λ e fr → rm-throw e) (λ al →
        let addr = rm-place-addr cx pl
        in λ fr → rm-bind (addr fr) (λ p → rm-rd-at (cx-t cx) c al p)))))
-- a value written to a place of a register class: the frame after it
rm-place-wr : RCx → RPlace → RFrame → RV → REv RFrame
rm-place-wr cx pl =
  sr-on (rm-place-is-reg cx pl) (λ e fr v → rm-throw e) (λ isr → case isr of
    true → λ fr v → rm-ret (fr-set fr (rm-place-local pl) (sl-reg v))
    false →
      sr-on (rm-place-ty cx pl) (λ e fr v → rm-throw e) (λ ty →
      sr-on (cx-class cx ty) (λ e fr v → rm-throw e) (λ c →
      sr-on (rm-place-al cx pl) (λ e fr v → rm-throw e) (λ al →
        let addr = rm-place-addr cx pl
        in λ fr v → rm-bind (addr fr) (λ p → rm-then (rm-wr-at (cx-t cx) c al p v) (rm-ret fr))))))

-- ---------------------------------------------------------------- constants and operands
-- the index of an instance (a body at closed generic arguments) in the crate's list: the id of
-- the function as a function pointer's target
rm-inst-index : List RInstance → Word → RTy → Word → RSt Word
rm-inst-index nil b a n = sr-ill (ri-no-instance b a)
rm-inst-index (cons i is) b a n = case i of
  rinstance b2 a2 → (case m-and (weq b b2) (rm-ty-eq a a2) of
    true → sr-ok n
    false → rm-inst-index is b a (wadd n #1))
cx-inst : RCx → Word → RTy → RSt Word
cx-inst cx b a = rm-inst-index (cr-instances (cx-crate cx)) b (cx-ty cx a) #0
rm-const-ty : RCx → RConst → RSt RTy
rm-const-ty cx c = case c of
  rc-int v k → sr-ok (rty-int k)
  rc-bool b → sr-ok rty-bool
  rc-param i → sr-ok (rty-int ri-usize)
  rc-zst ty → sr-ok (cx-ty cx ty)
  rc-adt ty v fs → sr-ok (cx-ty cx ty)
  rc-static i ty → sr-ok (cx-ty cx ty)
  rc-fn b a → sr-ok (rty-fn-ptr rtys-nil rty-never)
  rcs-nil → sr-ill ri-operand-class
  rcs-cons x xs → sr-ill ri-operand-class
-- The addresses of the statics and of the vtables are run-time values (rust-init's
-- allocations): a frame carries them after its locals, statics first.
cx-static-slot : RCx → Word → Word
cx-static-slot cx i = wadd (rm-len (cx-locals cx)) i
cx-vtable-slot : RCx → Word → Word
cx-vtable-slot cx j = wadd (rm-len (cx-locals cx)) (wadd (rm-len (cr-statics (cx-crate cx))) j)
rm-image-rv : RFrame → Word → REv RV
rm-image-rv fr i = rm-bind (fr-get fr i) (λ s → case s of
  sl-reg v → rm-ret v
  sl-mem p → rm-throw (rx-ill-formed ri-operand-class)
  sl-none → rm-throw (rx-ill-formed ri-operand-class))
-- a constant of a register class other than a static's address: its value, decided before run time
rm-const-rv : RCx → RConst → RSt RV
rm-const-rv cx c = case c of
  rc-int v k → sr-map rv-s (rm-int-sv (rm-ik (cx-t cx) k) v)
  rc-bool b → sr-ok (rv-s (sv-b b))
  rc-param i → (case rm-tys-nth (cx-args cx) i of
    rty-const n → sr-ok (rv-s (sv-i (uq-of-word n)))
    _ → sr-ill (ri-open-type (rty-const-param i)))
  rc-zst ty → sr-ok rv-unit
  rc-adt ty v fs → sr-ill ri-operand-class
  rc-static i ty → sr-unsup (rz-const c)
  rc-fn b a → sr-map (λ j → rv-s (rm-fn-ptr j)) (cx-inst cx b a)
  rcs-nil → sr-ill ri-operand-class
  rcs-cons x xs → sr-ill ri-operand-class
rm-opd-ty : RCx → ROperand → RSt RTy
rm-opd-ty cx op = case op of
  rop-copy p → rm-place-ty cx p
  rop-move p → rm-place-ty cx p
  rop-const c → rm-const-ty cx c
-- an operand of a register class. A move reads as a copy: what a move leaves behind is not
-- read again by rustc's MIR, and this machine does not mark it.
rm-opd-rv : RCx → ROperand → RFrame → REv RV
rm-opd-rv cx op = case op of
  rop-copy p → rm-place-rv cx p
  rop-move p → rm-place-rv cx p
  rop-const c → (case c of
    rc-static i ty → λ fr → rm-image-rv fr (cx-static-slot cx i)
    _ → sr-on (rm-const-rv cx c) (λ e fr → rm-throw e) (λ v → λ fr → rm-ret v))
-- a constant of an ADT type written at a pointer: rm-const-into c cx type fields. At an
-- rc-adt node the type is the constant's own; at a list of field constants (rcs-cons) the
-- fields are the layouts of the fields they fill.
rm-const-into : RConst → RCx → RTy → List RFieldLayout → MPtr → REv Unit
rm-const-into (rc-adt ty v fs) cx ty0 fls =
  sr-on (rm-lay (cx-ls cx) (cx-ty cx ty)) (λ e p → rm-throw e) (λ l →
  sr-on (rm-nth (ly-variants-of l) v (ri-no-variant (cx-ty cx ty) v)) (λ e p → rm-throw e) (λ vl →
    let body = rm-const-into fs cx (cx-ty cx ty) (vl-fields-of vl)
        tag = rm-set-tag (cx-t cx) l (cx-ty cx ty) v
    in λ p → rm-then (body p) (tag p)))
rm-const-into (rc-zst ty) cx ty0 fls = λ p → rm-ret unit
rm-const-into rcs-nil cx ty0 fls = λ p → rm-ret unit
rm-const-into (rcs-cons c cs) cx ty0 fls = case fls of
  nil → λ p → rm-throw (rx-ill-formed ri-arity)
  cons f fr →
    sr-on (cx-class cx (rf-ty f)) (λ e p → rm-throw e) (λ cl →
      let rest = rm-const-into cs cx ty0 fr
      in case cl of
           cl-mem →
                    (let one = rm-const-into c cx (rf-ty f) nil
                     in λ p → rm-bind (rm-off p (rf-off f)) (λ q → rm-then (one q) (rest p)))
           cl-unit → rest
           _ → sr-on (rm-const-rv cx c) (λ e p → rm-throw e) (λ v →
                 λ p → rm-bind (rm-off p (rf-off f)) (λ q →
                       rm-then (rm-wr-at (cx-t cx) cl #1 q v) (rest p))))
rm-const-into c cx ty0 fls = λ p → rm-throw (rx-unsupported (rz-const c))
rm-copy-from : RCx → RPlace → RTy → Word → RFrame → MPtr → REv Unit
rm-copy-from cx pl ty al =
  sr-on (rm-place-al cx pl) (λ e fr p → rm-throw e) (λ sa →
    let addr = rm-place-addr cx pl
        cp = cx-copy cx ty al sa
    in λ fr p → rm-bind (addr fr) (λ s → cp p s))
-- an operand stored at a pointer, at a type and the alignment of the place stored to
rm-opd-into : RCx → ROperand → RTy → Word → RFrame → MPtr → REv Unit
rm-opd-into cx op ty al =
  sr-on (cx-class cx ty) (λ e fr p → rm-throw e) (λ c → case c of
    cl-mem → (case op of
      rop-copy pl → rm-copy-from cx pl ty al
      rop-move pl → rm-copy-from cx pl ty al
      rop-const k →
                    (let w = rm-const-into k cx ty nil
                     in λ fr p → w p))
    cl-unit → λ fr p → rm-ret unit
    _ →
        (let ev = rm-opd-rv cx op
         in λ fr p → rm-bind (ev fr) (λ v → rm-wr-at (cx-t cx) c al p v)))
