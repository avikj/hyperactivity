-- lib/lang/rust/machine.cub — what the reading of MIR (lib/lang/rust/read.cub) stands on: the
-- outcomes special to Rust, values and frames, and everything about a crate that is decided
-- before any run-time value exists (types under an instance's generic arguments, their class,
-- size and alignment, layouts, the tables of the crate).
--
-- The abstract machine. A body runs in a frame: one slot per local. A local whose type is a
-- scalar (bool, an integer, a thin pointer or reference, a function pointer), a wide pointer
-- (to a slice or a dyn Trait: address and metadata) or zero-sized-unit is a REGISTER: its slot
-- holds the value, or rv-dead between StorageDead and the next assignment. Every other local
-- (an ADT, a tuple, an array) is an OBJECT: its slot holds the pointer to an allocation of
-- the memory, made at StorageLive (or at entry when the body has no storage statement
-- for it) and released at StorageDead and at return. A register has no address: a place
-- expression rooted at a register local is the register itself or goes through its value
-- (a deref). rustc's MIR borrows only objects in the two samples; a borrow of a register local
-- is the outcome rx-unsupported rz-borrow-of-register (see tracks/R-rust.md, item 4).
--
-- Outcomes of a meaning (lib/mem/monad.cub's EvR at V = RExc): mok with a value; mub w,
-- undefined behaviour by a rule of the memory or scalar layer; mstop st-fuel, the fuel ran
-- out; and a thrown RExc, which nothing catches: rx-abort (a failed Assert under
-- -Cpanic=abort: the process ends, defined behaviour), rx-ub (undefined behaviour by a rule of
-- MIR that the lower layers do not have), rx-unsupported (a construct the reader does not
-- give a meaning to, named), rx-ill-formed (the crate's data contradicts itself: an importer's
-- error, named).
import "../../library.cub"
import "../../mem/monad.cub"

-- ---------------------------------------------------------------- outcomes
data RAbort = rab-bounds-check | rab-division-by-zero | rab-remainder-by-zero | rab-overflow (o : RBinOp)
data RUB = rub-unreachable            -- an Unreachable terminator was reached
         | rub-unchecked-overflow     -- AddUnchecked/SubUnchecked/MulUnchecked/ShlUnchecked/ShrUnchecked out of range
         | rub-invalid-discriminant   -- a tag that is no variant's
         | rub-bad-fn-pointer         -- a call through a pointer that is not a function of the crate
         | rub-dead-local             -- a register read between StorageDead and the next write, or never written
data RUnsup = rz-binop (o : RBinOp) | rz-unop (o : RUnOp) | rz-cast (k : RCastKind)
            | rz-borrow-of-register | rz-type (t : RTy) | rz-const-index-from-end-of-slice
            | rz-drop-of-enum (t : RTy) | rz-wide-128 | rz-transmute (from : RTy) (to : RTy)
            | rz-const (c : RConst) | rz-switch-on (t : RTy) | rz-unwind (u : RUnwind)
            | rz-unaligned (k : SK)
data RIll = ri-no-layout (t : RTy) | ri-no-local (i : Word) | ri-no-block (i : Word) | ri-no-body (i : Word)
          | ri-no-instance (body : Word) (args : RTy) | ri-no-field (t : RTy) (i : Word) | ri-no-variant (t : RTy) (i : Word)
          | ri-no-vtable (t : RTy) (trait : Word) | ri-no-static (i : Word) | ri-open-type (t : RTy)
          | ri-class (t : RTy) | ri-operand-class | ri-arity | ri-layout-depth | ri-place (t : RTy)
data RExc = rx-abort (m : RAbort) | rx-ub (w : RUB) | rx-unsupported (what : RUnsup) | rx-ill-formed (what : RIll)

-- what is decided before run time: a value, or why there is none
data RSt (A : Type) = sr-ok (a : A) | sr-no (e : RExc)
sr-bind : {A B : Type} → RSt A → (A → RSt B) → RSt B
sr-bind r f = case r of
  sr-ok a → f a
  sr-no e → sr-no e
sr-map : {A B : Type} → (A → B) → RSt A → RSt B
sr-map f r = case r of
  sr-ok a → sr-ok (f a)
  sr-no e → sr-no e
sr-ill : {A : Type} → RIll → RSt A
sr-ill w = sr-no (rx-ill-formed w)
sr-unsup : {A : Type} → RUnsup → RSt A
sr-unsup w = sr-no (rx-unsupported w)

-- ---------------------------------------------------------------- the monad at this reader
REv : Type → Type (lsuc lzero)
REv A = Ev {lzero} NoS RExc A
rm-ret : {A : Type} → A → REv A
rm-ret {A} a = ev-ret {lzero} {NoS} {RExc} {A} a
rm-bind : {A B : Type} → REv A → (A → REv B) → REv B
rm-bind {A} {B} e f = ev-bind {lzero} {NoS} {RExc} {A} {B} e f
rm-then : {A B : Type} → REv A → REv B → REv B
rm-then {A} {B} e f = ev-then {lzero} {NoS} {RExc} {A} {B} e f
rm-res : {A : Type} → MRes A → REv A
rm-res {A} r = ev-res {lzero} {NoS} {RExc} {A} r
rm-throw : {A : Type} → RExc → REv A
rm-throw {A} e = ev-throw {lzero} {NoS} {RExc} {A} e
rm-stop : {A : Type} → Stop → REv A
rm-stop {A} w = ev-stop {lzero} {NoS} {RExc} {A} w
-- a static result continued into a computation
rm-st : {A B : Type} → RSt A → (A → REv B) → REv B
rm-st r f = case r of
  sr-ok a → f a
  sr-no e → rm-throw e

-- ---------------------------------------------------------------- values, slots, frames
data RV = rv-s (v : SV) | rv-fat (p : SV) (m : SV) | rv-unit | rv-dead
-- (sl-none: an object local that has no storage now)
data RSlot = sl-reg (v : RV) | sl-mem (p : MPtr) | sl-none
RFrame : Type
RFrame = List RSlot
data RNext = rn-goto (fr : RFrame) (bb : Word) | rn-ret (v : RSlot)

rm-nth : {A : Type} → List A → Word → RIll → RSt A
rm-nth nil i w = sr-ill w
rm-nth (cons x xs) i w = case weq i #0 of
  true → sr-ok x
  false → rm-nth xs (wsub i #1) w
rm-len : {A : Type} → List A → Word
rm-len nil = #0
rm-len (cons x xs) = wadd #1 (rm-len xs)
fr-get : RFrame → Word → REv RSlot
fr-get nil i = rm-throw (rx-ill-formed (ri-no-local i))
fr-get (cons s ss) i = case weq i #0 of
  true → rm-ret s
  false → fr-get ss (wsub i #1)
fr-set : RFrame → Word → RSlot → RFrame
fr-set nil i s = nil
fr-set (cons x xs) i s = case weq i #0 of
  true → cons s xs
  false → cons x (fr-set xs (wsub i #1) s)

-- ---------------------------------------------------------------- the crate's tables
cr-bodies : RCrate → List RBody
cr-bodies (rcrate n e bs as ts ls vs ss ds is) = bs
cr-layouts : RCrate → List RLayoutEntry
cr-layouts (rcrate n e bs as ts ls vs ss ds is) = ls
cr-vtables : RCrate → List RVtable
cr-vtables (rcrate n e bs as ts ls vs ss ds is) = vs
cr-statics : RCrate → List RStatic
cr-statics (rcrate n e bs as ts ls vs ss ds is) = ss
cr-drops : RCrate → List RDropImpl
cr-drops (rcrate n e bs as ts ls vs ss ds is) = ds
cr-instances : RCrate → List RInstance
cr-instances (rcrate n e bs as ts ls vs ss ds is) = is
cr-entry : RCrate → Word
cr-entry (rcrate n e bs as ts ls vs ss ds is) = e
rb-generics : RBody → List RGeneric
rb-generics (rbody n gs ac ls bs) = gs
rb-argc : RBody → Word
rb-argc (rbody n gs ac ls bs) = ac
rb-locals : RBody → List RLocal
rb-locals (rbody n gs ac ls bs) = ls
rb-blocks : RBody → List RBlock
rb-blocks (rbody n gs ac ls bs) = bs
rl-ty : RLocal → RTy
rl-ty (rlocal t m) = t
rl-ty (rlocal-arg t) = t

-- ---------------------------------------------------------------- types under generic arguments
-- t39 (2026-11-12): needs-work. Measured 2026-11-11: these deriving lines fail because
-- lib/derive.cub, which deriving needs, is refused as untyped (t16); the Rust readers then fail on
-- what follows (machine 6, read-place 21, read-rvalue 26, read 22 failures). Typing derive.cub
-- repairs the root.
--
deriving eq RMut as rm-mut-eq
deriving eq RIntTy as rm-ik-eq
-- equality of types (deriving eq does not go through a field of another data type: see the track file)
rm-ty-eq : RTy → RTy → Bool
rm-ty-eq rty-bool b = case b of
  rty-bool → true
  _ → false
rm-ty-eq (rty-int a0) b = case b of
  rty-int b0 → rm-ik-eq a0 b0
  _ → false
rm-ty-eq rty-never b = case b of
  rty-never → true
  _ → false
rm-ty-eq (rty-ref a0 a1) b = case b of
  rty-ref b0 b1 → m-and (rm-mut-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-ptr a0 a1) b = case b of
  rty-ptr b0 b1 → m-and (rm-mut-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-array a0 a1) b = case b of
  rty-array b0 b1 → m-and (rm-ty-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-slice a0) b = case b of
  rty-slice b0 → rm-ty-eq a0 b0
  _ → false
rm-ty-eq (rty-tuple a0) b = case b of
  rty-tuple b0 → rm-ty-eq a0 b0
  _ → false
rm-ty-eq (rty-adt a0 a1) b = case b of
  rty-adt b0 b1 → m-and (weq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-dyn a0) b = case b of
  rty-dyn b0 → weq a0 b0
  _ → false
rm-ty-eq (rty-fn-ptr a0 a1) b = case b of
  rty-fn-ptr b0 b1 → m-and (rm-ty-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
rm-ty-eq (rty-param a0) b = case b of
  rty-param b0 → weq a0 b0
  _ → false
rm-ty-eq (rty-const a0) b = case b of
  rty-const b0 → weq a0 b0
  _ → false
rm-ty-eq (rty-const-param a0) b = case b of
  rty-const-param b0 → weq a0 b0
  _ → false
rm-ty-eq rtys-nil b = case b of
  rtys-nil → true
  _ → false
rm-ty-eq (rtys-cons a0 a1) b = case b of
  rtys-cons b0 b1 → m-and (rm-ty-eq a0 b0) (rm-ty-eq a1 b1)
  _ → false
-- element i of a list of types (rty-never when there is none: the caller reports it)
rm-tys-nth : RTy → Word → RTy
rm-tys-nth (rtys-cons t ts) i = case weq i #0 of
  true → t
  false → rm-tys-nth ts (wsub i #1)
rm-tys-nth t i = rty-never
-- a type (or list of types) with the parameters replaced by an instance's arguments
rm-subst : RTy → RTy → RTy
rm-subst rty-bool a = rty-bool
rm-subst (rty-int k) a = rty-int k
rm-subst rty-never a = rty-never
rm-subst (rty-ref m t) a = rty-ref m (rm-subst t a)
rm-subst (rty-ptr m t) a = rty-ptr m (rm-subst t a)
rm-subst (rty-array t n) a = rty-array (rm-subst t a) (rm-subst n a)
rm-subst (rty-slice t) a = rty-slice (rm-subst t a)
rm-subst (rty-tuple ts) a = rty-tuple (rm-subst ts a)
rm-subst (rty-adt i ts) a = rty-adt i (rm-subst ts a)
rm-subst (rty-dyn tr) a = rty-dyn tr
rm-subst (rty-fn-ptr ps r) a = rty-fn-ptr (rm-subst ps a) (rm-subst r a)
rm-subst (rty-param i) a = rm-tys-nth a i
rm-subst (rty-const v) a = rty-const v
rm-subst (rty-const-param i) a = rm-tys-nth a i
rm-subst rtys-nil a = rtys-nil
rm-subst (rtys-cons t ts) a = rtys-cons (rm-subst t a) (rm-subst ts a)

-- the kind of an integer type at a Target (isize/usize are the pointer's width)
rm-pw : Target → IW
rm-pw t = case weq (tg-size t ck-ptr) #8 of
  true → iw64
  false → iw32
rm-ik : Target → RIntTy → SK
rm-ik t k = case k of
  ri-i8 → sk-int true iw8
  ri-i16 → sk-int true iw16
  ri-i32 → sk-int true iw32
  ri-i64 → sk-int true iw64
  ri-isize → sk-int true (rm-pw t)
  ri-u8 → sk-int false iw8
  ri-u16 → sk-int false iw16
  ri-u32 → sk-int false iw32
  ri-u64 → sk-int false iw64
  ri-usize → sk-int false (rm-pw t)
rm-usize : Target → SK
rm-usize t = sk-int false (rm-pw t)

-- a pointee that makes a pointer wide
rm-unsized : RTy → Bool
rm-unsized (rty-slice t) = true
rm-unsized (rty-dyn tr) = true
rm-unsized t = false
-- how a value of a (closed) type is held
-- (cl-fat: the kind of the metadata, a length or a vtable pointer)
data RClass = cl-scalar (k : SK) | cl-fat (mk : SK) | cl-unit | cl-mem
rm-meta-sk : Target → RTy → SK
rm-meta-sk t (rty-dyn tr) = sk-ptr
rm-meta-sk t ty = rm-usize t
rm-class : Target → RTy → RSt RClass
rm-class t rty-bool = sr-ok (cl-scalar sk-bool)
rm-class t (rty-int k) = sr-ok (cl-scalar (rm-ik t k))
rm-class t rty-never = sr-ok cl-unit
rm-class t (rty-ref m p) = case rm-unsized p of
  true → sr-ok (cl-fat (rm-meta-sk t p))
  false → sr-ok (cl-scalar sk-ptr)
rm-class t (rty-ptr m p) = case rm-unsized p of
  true → sr-ok (cl-fat (rm-meta-sk t p))
  false → sr-ok (cl-scalar sk-ptr)
rm-class t (rty-array e n) = sr-ok cl-mem
rm-class t (rty-tuple ts) = case ts of
  rtys-nil → sr-ok cl-unit
  _ → sr-ok cl-mem
rm-class t (rty-adt i ts) = sr-ok cl-mem
rm-class t (rty-fn-ptr ps r) = sr-ok (cl-scalar sk-ptr)
rm-class t ty = sr-ill (ri-class ty)

-- ---------------------------------------------------------------- layouts
rm-lay : List RLayoutEntry → RTy → RSt RLayout
rm-lay nil ty = sr-ill (ri-no-layout ty)
rm-lay (cons e es) ty = case e of
  rlayout-of t l → (case rm-ty-eq t ty of
    true → sr-ok l
    false → rm-lay es ty)
ly-size-of : RLayout → Word
ly-size-of (rlayout s a tg vs) = s
ly-align-of : RLayout → Word
ly-align-of (rlayout s a tg vs) = a
ly-tag-of : RLayout → RTagLayout
ly-tag-of (rlayout s a tg vs) = tg
ly-variants-of : RLayout → List RVariantLayout
ly-variants-of (rlayout s a tg vs) = vs
vl-fields-of : RVariantLayout → List RFieldLayout
vl-fields-of (rvariant n d tg fs) = fs
vl-discr-of : RVariantLayout → RInt
vl-discr-of (rvariant n d tg fs) = d
vl-tag-of : RVariantLayout → RTagValue
vl-tag-of (rvariant n d tg fs) = tg
rf-off : RFieldLayout → Word
rf-off (rfield n o t) = o
rf-ty : RFieldLayout → RTy
rf-ty (rfield n o t) = t
-- size and alignment of a closed type at a Target: scalars by the Target, arrays from their
-- element, ADTs and tuples from the crate's layouts
rm-size : Target → List RLayoutEntry → RTy → RSt Word
rm-size t ls rty-bool = sr-ok (sk-size t sk-bool)
rm-size t ls (rty-int k) = sr-ok (sk-size t (rm-ik t k))
rm-size t ls rty-never = sr-ok #0
rm-size t ls (rty-ref m p) = case rm-unsized p of
  true → sr-ok (wmul #2 (tg-size t ck-ptr))
  false → sr-ok (tg-size t ck-ptr)
rm-size t ls (rty-ptr m p) = case rm-unsized p of
  true → sr-ok (wmul #2 (tg-size t ck-ptr))
  false → sr-ok (tg-size t ck-ptr)
rm-size t ls (rty-array e n) = case n of
  rty-const c → sr-map (λ s → wmul s c) (rm-size t ls e)
  _ → sr-ill (ri-open-type (rty-array e n))
rm-size t ls (rty-tuple ts) = case ts of
  rtys-nil → sr-ok #0
  _ → sr-map ly-size-of (rm-lay ls (rty-tuple ts))
rm-size t ls (rty-adt i ts) = sr-map ly-size-of (rm-lay ls (rty-adt i ts))
rm-size t ls (rty-fn-ptr ps r) = sr-ok (tg-size t ck-ptr)
rm-size t ls ty = sr-ill (ri-class ty)
rm-align : Target → List RLayoutEntry → RTy → RSt Word
rm-align t ls rty-bool = sr-ok (sk-align t sk-bool)
rm-align t ls (rty-int k) = sr-ok (sk-align t (rm-ik t k))
rm-align t ls rty-never = sr-ok #1
rm-align t ls (rty-ref m p) = sr-ok (tg-align t ck-ptr)
rm-align t ls (rty-ptr m p) = sr-ok (tg-align t ck-ptr)
rm-align t ls (rty-array e n) = rm-align t ls e
rm-align t ls (rty-slice e) = rm-align t ls e
rm-align t ls (rty-dyn tr) = sr-ok #1
rm-align t ls (rty-tuple ts) = case ts of
  rtys-nil → sr-ok #1
  _ → sr-map ly-align-of (rm-lay ls (rty-tuple ts))
rm-align t ls (rty-adt i ts) = sr-map ly-align-of (rm-lay ls (rty-adt i ts))
rm-align t ls (rty-fn-ptr ps r) = sr-ok (tg-align t ck-ptr)
rm-align t ls ty = sr-ill (ri-class ty)
rm-wmin : Word → Word → Word
rm-wmin a b = case wlt a b of
  true → a
  false → b

-- ---------------------------------------------------------------- integers of the AST as values
rm-uq : RInt → UInt64
rm-uq (rint-pos n) = uq-of-word n
rm-uq (rint-neg n) = uq-neg (uq-of-word n)
-- an integer constant at a kind (a bool kind: 0 is false)
rm-int-sv : SK → RInt → RSt SV
rm-int-sv k n = case k of
  sk-int sg w → (case w of
    iw128 → sr-unsup rz-wide-128
    _ → sr-ok (sv-i (uq-cn sg w (rm-uq n))))
  sk-bool → sr-ok (sv-b (not (uq-iszero (rm-uq n))))
  _ → sr-ill ri-operand-class

-- ---------------------------------------------------------------- decided before the frame
-- a static result continued into something that waits for run-time values (R is a function
-- type: the failure is the function that throws)
sr-on : {A : Type} {R : Type (lsuc lzero)} → RSt A → (RExc → R) → (A → R) → R
sr-on r g f = case r of
  sr-ok a → f a
  sr-no e → g e
-- the pointee of a pointer or reference type
rm-pointee : RTy → RSt RTy
rm-pointee (rty-ref m p) = sr-ok p
rm-pointee (rty-ptr m p) = sr-ok p
rm-pointee ty = sr-ill (ri-place ty)
-- the element type of an array or slice type
rm-elem : RTy → RSt RTy
rm-elem (rty-array e n) = sr-ok e
rm-elem (rty-slice e) = sr-ok e
rm-elem ty = sr-ill (ri-place ty)
-- the unsigned kind of a tag of a size
rm-tag-sk : Word → RSt SK
rm-tag-sk n = case weq n #1 of
  true → sr-ok (sk-int false iw8)
  false → (case weq n #2 of
    true → sr-ok (sk-int false iw16)
    false → (case weq n #4 of
      true → sr-ok (sk-int false iw32)
      false → (case weq n #8 of
        true → sr-ok (sk-int false iw64)
        false → sr-unsup rz-wide-128)))
