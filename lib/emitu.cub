-- ---------------------------------------------------------------- flat data types by value: 6 + d
-- a data type whose layout is a union of structs of words and bytes (no pointer: no recursive or
-- boxed field) is the typedef T_d of lib/emitt.cub by value; its values are built as compound
-- literals, projected as fields, switched on their tag, and boxed/unboxed through generated
-- functions box_d/unbox_d where a V is wanted or given. Loaded after lib/check.cub for the layouts
-- (lib/emitt.cub's flat-lay: a field a word, or a flat record with a field, inline)
is-flat-layout l = flat-lay l
is-flat d = if %weq d #0 then false else is-flat-layout (layout d)
is-dt t = %wlt #5 t
dt-of t = %wsub t #6
dt-ty d = %wadd #6 d
-- pointer data (B16 milestone 2, the rest): a data type whose fields are words, the type itself
-- (a typed pointer to its own struct, lib/emitt.cub) or other data types, with at least one such
-- field — lists, trees: its values are T_d *, allocated once per constructor, projected and
-- switched through the pointer, updated in place when unique (C21); a field of a flat type is by
-- value, of a pointer type a pointer, anything else a boxed V *
is-ptr-dt d = if %weq d #0 then false else andb (notb-u (is-flat d)) (andb (has-layout d) (ptr-ctors d (nctors-t d) #0))
ptr-ctors d n c = if %weq c n then true else andb (ptr-fields (cshape-r d c)) (ptr-ctors d n (%wsucc c))
ptr-fields ks = case ks of lnil → true; lcons k r → andb (%wlt (fst k) #3) (ptr-fields r)
is-udata d = orb (is-flat d) (is-ptr-dt d)
-- the type of field k (cshape-r kinds, lib/emitt.cub: 0 a word, 1 the type itself, 2 another data
-- type, 3 anything else)
fk-ty d k = if %weq (fst k) #0 then tW else if %weq (fst k) #1 then dt-ty d else (if is-udata (snd k) then dt-ty (snd k) else tP)
ctor-tys d c = lmap (fk-ty d) (cshape-r d c)
fld-ty d c j = ty-at (ctor-tys d c) j
push-tys tys env = case tys of lnil → env; lcons t r → push-tys r (lcons t env)
-- the field types of constructor c of d (all W for a flat type), and their count
dt-nfields d c = count-fields (alt-layout (layout d) c)
alt-layout l c = case l of lunion alts → alt-nth alts c; _ → lnone
alt-nth alts c = case alts of lalt l r → (if %weq c #0 then l else alt-nth r (%wsub c #1)); _ → lnone
count-fields l = case l of lstruct fs → count-fields fs; lfield nm fl al r → %wsucc (count-fields r); _ → #0
-- ---------------------------------------------------------------- types: W = #0, P = #1, pairs 2..5
-- a pair of two components, each W or P (a pair component that is itself a pair is boxed), is a C
-- struct by value: Pr0 (W, W), Pr1 (W, P), Pr2 (P, W), Pr3 (P, P); its type is 2 + 2·fst + snd
tW = #0
tP = #1
is-pr t = andb (%wlt #1 t) (%wlt t #6)
pr-ty a b = %wadd #2 (%wadd (%wadd (flat a) (flat a)) (flat b))
flat t = if %weq t tW then tW else tP
pr-fst t = if %wlt (%wsub t #2) #2 then tW else tP
pr-snd t = if %weq (%wsub t #2) #0 then tW else if %weq (%wsub t #2) #2 then tW else tP
pr-k t k = if %weq k #0 then pr-fst t else pr-snd t
ty-decl t = if %weq t tW then u-w else if %weq t tP then u-p else if is-dt t then (if is-flat (dt-of t) then cat3 u-T (dec (dt-of t)) u-sp else cat3 u-T (dec (dt-of t)) (lcons #32 (lcons #42 lnil))) else cat3 u-pr (dec (%wsub t #2)) u-sp
-- signatures: (g , (params , ret)), params a Lst of types; a def not in the table has P everywhere
sig-of sigs g = case sigs of lnil → none; lcons s r → if %weq (fst s) g then some (snd s) else sig-of r g
param-ty sigs g j = case sig-of sigs g of some s → (case lnth-ty (fst s) j of some t → t; none → tP); none → tP
ret-ty sigs g = case sig-of sigs g of some s → snd s; none → tP
lnth-ty l j = case l of lnil → none; lcons x xs → if %weq j #0 then some x else lnth-ty xs (%wsub j #1)
env-ty env n = case env of lnil → tP; lcons t r → if %weq n #0 then t else env-ty r (%wsub n #1)
push-n t n env = if %weq n #0 then env else push-n t (%wsub n #1) (lcons t env)
-- the natural type of a term in an environment of types (innermost first)
infer-u sigs env t =
  case t of
    fvar n → env-ty env n
    flit w → tW
    fi64 n → tW
    ff64 w → tW
    fcon d c fs → if %weq d #0 then (if %weq c #0 then (case fs of lcons a r → (case r of lcons b r2 → (case r2 of lnil → pr-ty (infer-u sigs env a) (infer-u sigs env b); _ → tP); _ → tP); _ → tP) else tP) else (if is-udata d then dt-ty d else tP)
    fswitch x alts → alts-ty sigs env (infer-u sigs env x) alts
    frec dd x alts → if no-hyps alts then alts-ty sigs env (if is-udata dd then dt-ty dd else tP) (ralts-as-alts alts) else tP
    fproj d c k x → (let tx = infer-u sigs env x in if is-pr tx then pr-k tx k else if is-dt tx then fld-ty (dt-of tx) c k else tP)
    fcall g args → ret-ty sigs g
    fprim p args → if store-any p then tP else if %weq p P-bytes then tP else tW
    flet a b → infer-u sigs (lcons (infer-u sigs env a) env) b
    fif c a b → join-ty (infer-u sigs env a) (infer-u sigs env b)
    floop init body → loop-ty sigs env init body
    fassume f b → infer-u sigs env b
    fforce x → infer-u sigs env x
    fthunk a → tP
    fupd u dd x c k v → if is-udata dd then dt-ty dd else infer-u sigs env x
    fnet k args → tP
    _ → tP
join-ty a b = if %weq a b then a else tP
-- the alternatives' fields are typed by the scrutinee's type (a data type's constructor types;
-- boxed otherwise)
alts-ty sigs env tx alts =
  case alts of
    lnil → tP
    lcons a r → (case r of lnil → infer-u sigs (alt-env tx (fst a) (fst (snd a)) env) (snd (snd a)); _ → join-ty (infer-u sigs (alt-env tx (fst a) (fst (snd a)) env) (snd (snd a))) (alts-ty sigs env tx r))
alt-env tx c n env = if is-dt tx then push-tys (ctor-tys (dt-of tx) c) env else push-n tP n env
-- a loop's result: the break's payload when the body has the shape, else P
loop-ty sigs env init body =
  let env2 = push-types sigs env init
  in case body of
       fif c a b → (case b of fcon d k fs → (case fs of lcons r rest → infer-u sigs env2 r; _ → tP); _ → tP)
       _ → tP
push-types sigs env l = case l of lnil → env; lcons x xs → push-types sigs (lcons (infer-u sigs env x) env) xs
-- ---------------------------------------------------------------- parameter types by use
-- use-ty sigs env d n body: the type a variable at depth n (from the body's top, d binders deep)
-- is used at: W when an operand of arithmetic or a fact, P when a scrutinee, a projected value, a
-- buffer, an applied function; an argument of a call takes the callee's parameter type; the first
-- use found decides, P when none
use-ty sigs d n t =
  case t of
    fvar m → none
    flit w → none
    fi64 n → none
    ff64 w → none
    fcon dd c fs → use-list sigs d n fs
    fswitch x alts → first-some (if is-var d n x then some tP else use-ty sigs d n x) (use-alts sigs d n alts)
    frec dd x alts → first-some (if is-var d n x then some (if is-udata dd then dt-ty dd else tP) else use-ty sigs d n x) (use-ralts sigs d n alts)
    fproj dd c k x → if is-var d n x then some tP else use-ty sigs d n x
    fcall g args → use-args sigs d n g #0 args
    fprim p args → if %wlt #13 p then use-arith sigs d n args else if %wlt #7 p then use-bytes sigs d n p args else use-arith sigs d n args
    flet a b → first-some (use-ty sigs d n a) (use-ty sigs (%wsucc d) n b)
    fif c a b → first-some (if is-var d n c then some tW else use-ty sigs d n c) (first-some (use-ty sigs d n a) (use-ty sigs d n b))
    floop init body → first-some (use-init sigs d n (lst-len init) init #0 body) (use-ty sigs (%wadd d (lst-len init)) n body)
    fclos g env → use-list sigs d n env
    fapply f args → first-some (if is-var d n f then some tP else use-ty sigs d n f) (use-list sigs d n args)
    fassume f b → use-ty sigs d n b
    fforce x → use-ty sigs d n x
    fthunk a → use-ty sigs d n a
    fupd u dd x c k v → first-some (if is-var d n x then some (if is-udata dd then dt-ty dd else tP) else use-ty sigs d n x) (use-ty sigs d n v)
    _ → none
is-var d n t = case t of fvar m → %weq m (%wadd d n); _ → false
-- a variable that initializes loop state i is used as that state is used in the body (state i is
-- the body's variable k − 1 − i)
use-init sigs d n k init i body =
  case init of
    lnil → none
    lcons x xs → first-some (if is-var d n x then use-ty sigs #0 (%wsub (%wsub k #1) i) body else use-ty sigs d n x) (use-init sigs d n k xs (%wsucc i) body)
first-some a b = case a of some x → a; none → b
use-list sigs d n l = case l of lnil → none; lcons x xs → first-some (use-ty sigs d n x) (use-list sigs d n xs)
use-alts sigs d n alts = case alts of lnil → none; lcons a r → first-some (use-ty sigs (%wadd d (fst (snd a))) n (snd (snd a))) (use-alts sigs d n r)
use-ralts sigs d n alts = case alts of lnil → none; lcons a r → first-some (use-ty sigs (%wadd d (%wadd (fst (snd a)) (lst-len (fst (snd (snd a)))))) n (snd (snd (snd a)))) (use-ralts sigs d n r)
use-args sigs d n g j args = case args of lnil → none; lcons a r → first-some (if is-var d n a then some (param-ty sigs g j) else use-ty sigs d n a) (use-args sigs d n g (%wsucc j) r)
use-arith sigs d n args = case args of lnil → none; lcons a r → first-some (if is-var d n a then some tW else use-ty sigs d n a) (use-arith sigs d n r)
-- the byte primitives: the buffer P, the offset and the stored value W
use-bytes sigs d n p args =
  case args of
    lnil → none
    lcons a r → first-some (if is-var d n a then some (if %weq p P-bytes then tW else tP) else use-ty sigs d n a) (use-arith sigs d n r)
-- the signature of a definition (arity n): parameter i is the variable n − 1 − i at the top
def-sig sigs n body = (param-tys sigs n #0 body , infer-u sigs (param-env sigs n #0 body) body)
param-tys sigs n i body = if %weq i n then lnil else lcons (case use-ty sigs #0 (%wsub (%wsub n #1) i) body of some t → t; none → tP) (param-tys sigs n (%wsucc i) body)
-- the environment of the body: parameters innermost-last (variable 0 is the last parameter)
param-env sigs n i body = if %weq i n then lnil else lapp (param-env sigs n (%wsucc i) body) (lcons (case use-ty sigs #0 (%wsub (%wsub n #1) i) body of some t → t; none → tP) lnil)
-- all signatures, iterated so that calls see their callees' types
sigs-of defs = let ct = clos-targets defs in sigs-round ct (sigs-round ct (sigs-round ct lnil defs) defs) defs
sigs-round ct sigs defs =
  case defs of
    lnil → lnil
    lcons d r → lcons (fst d , (if lmem-w (fst d) ct then (push-n tP (fst (snd d)) lnil , tP) else def-sig sigs (fst (snd d)) (snd (snd d)))) (sigs-round ct sigs r)
-- the targets of closures are called through the dispatcher with boxed arguments: P throughout;
-- the dispatcher lists only them (a definition with typed parameters is called directly)
clos-defs defs = let ct = clos-targets defs in keep-if (λ d → lmem-w (fst d) ct) defs
lmem-w g l = case l of lnil → false; lcons x xs → if %weq x g then true else lmem-w g xs
clos-targets defs = case defs of lnil → lnil; lcons d r → clos-in (snd (snd d)) (clos-targets r)
clos-in t acc =
  case t of
    fclos g env → clos-list env (lcons g acc)
    fthunk a → clos-in a acc
    fcon d c fs → clos-list fs acc
    fswitch x alts → clos-alts alts (clos-in x acc)
    frec d x alts → clos-ralts alts (clos-in x acc)
    fproj d c k x → clos-in x acc
    fcall g args → clos-list args acc
    fprim p args → clos-list args acc
    flet a b → clos-in b (clos-in a acc)
    fif c a b → clos-in b (clos-in a (clos-in c acc))
    floop init body → clos-in body (clos-list init acc)
    fapply f args → clos-list args (clos-in f acc)
    fassume f b → clos-in b acc
    fforce x → clos-in x acc
    fupd u dd x c k v → clos-in v (clos-in x acc)
    _ → acc
clos-list l acc = case l of lnil → acc; lcons x xs → clos-list xs (clos-in x acc)
clos-alts alts acc = case alts of lnil → acc; lcons a r → clos-alts r (clos-in (snd (snd a)) acc)
clos-ralts alts acc = case alts of lnil → acc; lcons a r → clos-ralts r (clos-in (snd (snd (snd a))) acc)
-- ---------------------------------------------------------------- printing
-- emit-at sigs env d want t: the C expression of t at the wanted type; env the types of the
-- variables (innermost first); d the depth for naming (as lib/emitc.cub: v_(d-1-n))
emit-at sigs env d want t =
  let nat = infer-u sigs env t
  in if %weq nat want then emit-u sigs env d t
     else if is-pr want then pair-at sigs env d want t
     else if is-dt want then cat5 u-unboxname-c (dec (dt-of want)) u-lp (emit-at sigs env d tP t) u-rp
     else if %weq want tW then cat3 (emit-u sigs env d t) u-n lnil
     else if is-pr nat then box-pr nat (emit-u sigs env d t)
     else if is-dt nat then cat5 u-boxname-c (dec (dt-of nat)) u-lp (emit-u sigs env d t) u-rp
     else cat3 u-mkw (emit-u sigs env d t) u-rp
u-unboxname-c = (lcons #117 (lcons #110 (lcons #98 (lcons #111 (lcons #120 lnil)))))
u-boxname-c = (lcons #98 (lcons #111 (lcons #120 lnil)))
-- a pair wanted: built from its components at their types, or unboxed from a V
pair-at sigs env d want t =
  case t of
    fcon dd c fs → (case fs of lcons a r → (case r of lcons b r2 → cat7 u-cast u-pr (dec (%wsub want #2)) u-brace (emit-at sigs env d (pr-fst want) a) u-comma (cat3 (emit-at sigs env d (pr-snd want) b) u-bend u-rp); _ → s-unsup); _ → s-unsup)
    _ → (let nat = infer-u sigs env t
         in if is-pr nat then box-pr nat (emit-u sigs env d t) else
            cat7 u-box (emit-at sigs env d tP t) u-semi (cat4 u-cast u-pr (dec (%wsub want #2)) u-brace) (comp-of (pr-fst want) u-q0) u-comma (cat4 (comp-of (pr-snd want) u-q1) u-bend u-rp u-boxend))
comp-of t q = if %weq t tW then lapp q u-n else q
-- a pair boxed: mkc(0, 2, box f0, box f1)
box-pr nat e = cat7 u-box e u-semi u-mkc2 (box-comp (pr-fst nat) (lcons #113 u-f0)) u-comma (cat3 (box-comp (pr-snd nat) (lcons #113 u-f1)) u-rp u-boxend)
box-comp t e = if %weq t tW then cat3 u-mkw e u-rp else e
emit-u sigs env d t =
  case t of
    fvar n → var d n
    flit w → dec w
    fi64 n → dec n
    ff64 w → dec w
    fcon dd c fs → (let nat = infer-u sigs env t in if is-pr nat then pair-at sigs env d nat t else if is-dt nat then (if is-flat dd then dt-lit sigs env d dd c fs else ptr-lit sigs env d dd c fs) else cat7 u-mkc (dec c) u-comma (dec (lst-len fs)) (args-rest-u sigs env d fs) u-rp lnil)
    fswitch x alts →
      let rt = infer-u sigs env t
          tx = infer-u sigs env x
      in if is-dt tx then switch-dt sigs env d rt tx x alts else cat6 u-bsx (cat3 (ty-decl rt) (lcons #114 lnil) u-semi) (cat3 u-xbind (emit-at sigs env d tP x) u-switch) (alts-u sigs env d rt alts) (default-of rt) (lapp (lcons #114 lnil) u-bsend)
    frec dd x alts → if no-hyps alts then (if is-udata dd then emit-u sigs env d (fswitch (typed-at (dt-ty dd) x) (ralts-as-alts alts)) else emit-u sigs env d (fswitch x (ralts-as-alts alts))) else s-unsup
    fproj dd c k x → (let tx = infer-u sigs env x in if is-pr tx then cat3 u-lp (emit-u sigs env d x) (if %weq k #0 then u-f0 else u-f1) else if is-dt tx then cat7 u-lp (emit-u sigs env d x) u-rp (if is-flat (dt-of tx) then u-u-c else u-pu-c) (dec c) u-dot-f (dec k) else cat4 (emit-at sigs env d tP x) u-arrow (dec k) u-rb)
    fcall g args → cat4 u-f (dec g) u-lp (lapp (args-u sigs env d g #0 args) u-rp)
    fprim p args → prim-u sigs env d p args
    flet a b →
      let ta = infer-u sigs env a
      in cat7 u-bsx (ty-decl ta) (var (%wsucc d) #0) u-assign (emit-u sigs env d a) u-semi (lapp (emit-u sigs (lcons ta env) (%wsucc d) b) u-bsend)
    fif c a b →
      let rt = infer-u sigs env t
      in cat6 u-if (emit-at sigs env d tW c) u-ifm (emit-at sigs env d rt a) u-ifs (lapp (emit-at sigs env d rt b) u-ifend)
    floop init body → loop-u sigs env d init body
    fclos g cenv → cat7 u-clo (dec g) u-comma (dec (lst-len cenv)) (args-rest-u sigs env d cenv) u-rp lnil
    fapply f args → apply-u sigs env d (emit-at sigs env d tP f) args
    fassume fact b → cat5 u-assume (fact-u sigs env d fact) u-asmend (emit-u sigs env d b) u-bsend
    -- force: a pointer (a thunk's closure, or a value held boxed) through force(), a word is itself
    fforce x → if %weq (infer-u sigs env x) tP then cat3 s-forcec (emit-u sigs env d x) u-rp else emit-u sigs env d x
    fupd u dd x c k v → upd-u sigs env d u x c k v
    fthunk a → (case a of fapply f args → (case f of fclos g cenv → thunk-c (dec g) (lst-len cenv) (args-rest-u sigs env d cenv); _ → s-unsup); _ → s-unsup)
    fnet k args → net-c (dec k) (lst-len args) (args-rest-u0 sigs env d args)
    _ → s-unsup
args-rest-u0 sigs env d fs = case fs of lnil → lnil; lcons x xs → (case xs of lnil → emit-at sigs env d tP x; _ → cat3 (emit-at sigs env d tP x) u-comma (args-rest-u0 sigs env d xs))
-- an update (C21) at the base's type: a pair or a flat value by value is copied into a local and
-- its field assigned (value semantics); a boxed V in place when unique (u = 1), else on a copy
upd-u sigs env d u x c k v =
  let nat = infer-u sigs env x
  in if is-pr nat then cat7 u-bsx (ty-decl nat) u-upd (emit-u sigs env d x) (if %weq k #0 then u-upd-f0 else u-upd-f1) (emit-at sigs env d (pr-k nat k) v) u-upd-end
     else if is-dt nat then (if is-flat (dt-of nat) then cat7 u-bsx (ty-decl nat) u-upd (emit-u sigs env d x) (cat4 u-upd-uc (dec c) u-dot-f (dec k)) (cat3 u-assign (emit-at sigs env d tW v) lnil) u-upd-end
                             else cat7 u-bsx (ty-decl nat) (if %weq u #1 then u-upd else cat3 u-pcopy (dec (dt-of nat)) u-pcopy2) (emit-u sigs env d x) (cat4 (if %weq u #1 then u-upd-puc else u-pcopy3) (dec c) u-dot-f (dec k)) (cat3 u-assign (emit-at sigs env d (fld-ty (dt-of nat) c k) v) lnil) u-upd-end)
     else cat7 (if %weq u #1 then s-upd-ip else s-upd-cp) (emit-at sigs env d tP x) (if %weq u #1 then s-upd-f else s-upd-fc) (dec k) s-upd-set (emit-at sigs env d tP v) s-upd-end
u-upd-puc = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #45 (lcons #62 (lcons #117 (lcons #46 (lcons #99 lnil)))))))))
u-pcopy = (lcons #117 (lcons #112 (lcons #32 (lcons #61 (lcons #32 (lcons #109 (lcons #97 (lcons #108 (lcons #108 (lcons #111 (lcons #99 (lcons #40 (lcons #115 (lcons #105 (lcons #122 (lcons #101 (lcons #111 (lcons #102 (lcons #40 (lcons #84 lnil))))))))))))))))))))
u-pcopy2 = (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #42 (lcons #117 (lcons #112 (lcons #32 (lcons #61 (lcons #32 (lcons #42 lnil)))))))))))
u-pcopy3 = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #45 (lcons #62 (lcons #117 (lcons #46 (lcons #99 lnil)))))))))
u-upd = (lcons #117 (lcons #112 (lcons #32 (lcons #61 (lcons #32 lnil)))))
u-upd-f0 = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #46 (lcons #102 (lcons #48 (lcons #32 (lcons #61 (lcons #32 lnil))))))))))
u-upd-f1 = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #46 (lcons #102 (lcons #49 (lcons #32 (lcons #61 (lcons #32 lnil))))))))))
u-upd-uc = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #46 (lcons #117 (lcons #46 (lcons #99 lnil))))))))
u-upd-end = (lcons #59 (lcons #32 (lcons #117 (lcons #112 (lcons #59 (lcons #32 (lcons #125 (lcons #41 lnil))))))))
-- an assumed fact over typed variables
fact-u sigs env d c =
  case c of
    cwlit n → dec n
    cvar n → emit-at sigs env d tW (fvar n)
    cwsucc a → cat3 s-lp (fact-u sigs env d a) s-one
    cwop k a b → if %weq k #3 then cat6 s-maxa (fact-u sigs env d a) s-maxb (fact-u sigs env d b) s-maxc (cat4 (fact-u sigs env d a) s-maxd (fact-u sigs env d b) s-maxe) else cat5 s-lp (fact-u sigs env d a) (fop-c k) (fact-u sigs env d b) s-rp
    cann a T → fact-u sigs env d a
    _ → dec #1
-- a flat value as a compound literal: ((T_d){ .tag = c, .u = { .cK = { f0, f1 } } })
dt-lit sigs env d dd c fs = cat7 u-cast u-T (dec dd) (cat3 u-brace u-tagdecl (dec c)) (cat3 u-udecl (dec c) u-fdecl) (fields-list sigs env d (ctor-tys dd c) fs) (lapp u-cend u-rcend)
fields-list sigs env d tys fs = case fs of lnil → lnil; lcons x xs → (case xs of lnil → emit-at sigs env d (ty-at tys #0) x; _ → cat3 (emit-at sigs env d (ty-at tys #0) x) u-comma (fields-list sigs env d (ltail-u tys) xs))
ltail-u l = case l of lnil → lnil; lcons x r → r
-- a pointer value: ({ T_d *p = malloc(sizeof(T_d)); *p = (T_d){ .tag = c, .u = { .cK = { … } } }; p; })
ptr-lit sigs env d dd c fs = cat7 (cat3 u-pnew (dec dd) u-pnew2) (dec dd) u-pnew3 (cat5 u-cast u-T (dec dd) (cat3 u-brace u-tagdecl (dec c)) (cat3 u-udecl (dec c) u-fdecl)) (fields-list sigs env d (ctor-tys dd c) fs) (lapp u-cend u-rcend) u-pnew4
u-pnew = (lcons #40 (lcons #123 (lcons #32 (lcons #84 lnil))))
u-pnew2 = (lcons #32 (lcons #42 (lcons #112 (lcons #32 (lcons #61 (lcons #32 (lcons #109 (lcons #97 (lcons #108 (lcons #108 (lcons #111 (lcons #99 (lcons #40 (lcons #115 (lcons #105 (lcons #122 (lcons #101 (lcons #111 (lcons #102 (lcons #40 (lcons #84 lnil)))))))))))))))))))))
u-pnew3 = (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #42 (lcons #112 (lcons #32 (lcons #61 (lcons #32 lnil)))))))))
u-pnew4 = (lcons #59 (lcons #32 (lcons #112 (lcons #59 (lcons #32 (lcons #125 (lcons #41 lnil)))))))
u-pu-c = (lcons #45 (lcons #62 (lcons #117 (lcons #46 (lcons #99 lnil)))))
-- an expression at a wanted type, as a form: typed-at wraps nothing; it is the hint switch-dt reads
typed-at t x = x
apply-u sigs env d f args = case args of lnil → f; lcons a r → apply-u sigs env d (cat5 u-apply f u-comma (emit-at sigs env d tP a) u-rp) r
args-rest-u sigs env d fs = case fs of lnil → lnil; lcons x xs → cat3 u-comma (emit-at sigs env d tP x) (args-rest-u sigs env d xs)
args-u sigs env d g j l = case l of lnil → lnil; lcons x xs → (case xs of lnil → emit-at sigs env d (param-ty sigs g j) x; _ → cat3 (emit-at sigs env d (param-ty sigs g j) x) u-comma (args-u sigs env d g (%wsucc j) xs))
-- a switch on a data value: T_d x = …; switch (x.tag) { case c: uint64_t v = x.u.cK.fJ; … } (a
-- pointer value through x->)
switch-dt sigs env d rt tx x alts =
  let fl = is-flat (dt-of tx)
  in cat6 u-bsx (cat3 (ty-decl rt) (lcons #114 lnil) u-semi) (cat5 (ty-decl tx) u-x u-assign (emit-at sigs env d tx x) (if fl then u-switch-dt else u-switch-pt)) (alts-dt sigs env d rt (dt-of tx) fl alts) (default-of rt) (lapp (lcons #114 lnil) u-bsend)
u-switch-pt = (lcons #59 (lcons #32 (lcons #115 (lcons #119 (lcons #105 (lcons #116 (lcons #99 (lcons #104 (lcons #32 (lcons #40 (lcons #120 (lcons #45 (lcons #62 (lcons #116 (lcons #97 (lcons #103 (lcons #41 (lcons #32 (lcons #123 (lcons #32 lnil))))))))))))))))))))
u-default-pr = (lcons #100 (lcons #101 (lcons #102 (lcons #97 (lcons #117 (lcons #108 (lcons #116 (lcons #58 (lcons #32 (lcons #125 (lcons #32 lnil)))))))))))
-- a switch's default: a word 0, a boxed value mkw(0), a pair or a data value nothing (abort)
default-of rt = if %weq rt tW then u-default-w else if %weq rt tP then u-default-p else u-default-abort
u-default-abort = (lcons #100 (lcons #101 (lcons #102 (lcons #97 (lcons #117 (lcons #108 (lcons #116 (lcons #58 (lcons #32 (lcons #97 (lcons #98 (lcons #111 (lcons #114 (lcons #116 (lcons #40 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #32 lnil))))))))))))))))))))
u-switch-dt = (lcons #59 (lcons #32 (lcons #115 (lcons #119 (lcons #105 (lcons #116 (lcons #99 (lcons #104 (lcons #32 (lcons #40 (lcons #120 (lcons #46 (lcons #116 (lcons #97 (lcons #103 (lcons #41 (lcons #32 (lcons #123 (lcons #32 lnil)))))))))))))))))))
alts-dt sigs env d rt dd fl alts =
  case alts of
    lnil → lnil
    lcons a r → lapp (alt-dt sigs env d rt dd fl (fst a) (fst (snd a)) (snd (snd a))) (alts-dt sigs env d rt dd fl r)
alt-dt sigs env d rt dd fl c n body =
  let tys = ctor-tys dd c
  in cat6 u-case (dec c) u-colonb (fields-dt d tys fl c n #0) (cat3 u-rr (emit-at sigs (push-tys tys env) (%wadd d n) rt body) u-semi) u-break
fields-dt d tys fl c n i = if %weq i n then lnil else cat7 (ty-decl (ty-at tys i)) (var (%wsucc (%wadd d i)) #0) u-assign (cat3 (if fl then u-xu else u-xpu) (dec c) u-dot-f) (dec i) u-semi (fields-dt d tys fl c n (%wsucc i))
u-xpu = (lcons #120 (lcons #45 (lcons #62 (lcons #117 (lcons #46 (lcons #99 lnil))))))
-- alternatives: fields bound as boxed locals, the body at the switch's type
alts-u sigs env d rt alts =
  case alts of
    lnil → lnil
    lcons a r → lapp (alt-u sigs env d rt (fst a) (fst (snd a)) (snd (snd a))) (alts-u sigs env d rt r)
alt-u sigs env d rt c n body = cat6 u-case (dec c) u-colonb (fields-u d n #0) (cat3 u-rr (emit-at sigs (push-n tP n env) (%wadd d n) rt body) u-semi) u-break
fields-u d n i = if %weq i n then lnil else cat7 u-p (var (%wsucc (%wadd d i)) #0) u-assign u-x u-arrow (dec i) (lapp u-rb (lapp u-semi (fields-u d n (%wsucc i))))
-- primitives: arithmetic on words; the byte layer
num-u sigs env d p args =
  case args of
    lcons a r →
      (case r of
         lcons b r2 → cat6 (lcons #110 (dec p)) u-lp (emit-at sigs env d tW a) u-comma (emit-at sigs env d tW b) u-rp
         lnil → cat4 (lcons #110 (dec p)) u-lp (emit-at sigs env d tW a) u-rp)
    lnil → s-unsup
prim-u sigs env d p args =
  if store-ip p then bytes-u sigs env d p args else
  if %wlt #13 p then num-u sigs env d p args else
  if %wlt #7 p then bytes-u sigs env d p args else
  (case args of
     lcons a r →
       (case r of
          lcons b r2 → cat5 u-lp (emit-at sigs env d tW a) (op-u p) (emit-at sigs env d tW b) u-rp
          lnil → cat4 u-lp u-not (emit-at sigs env d tW a) u-rp)
     lnil → dec #0)
op-u p = if %weq p #0 then u-plus else if %weq p #1 then u-minus else if %weq p #2 then u-times else if %weq p #3 then u-eq else if %weq p #4 then u-lt else if %weq p #5 then u-and else u-or
bytes-u sigs env d p args =
  case args of
    lcons a r →
      (case r of
         lnil → (if %weq p P-bytes then cat3 u-mkb (emit-at sigs env d tW a) u-rp else cat3 u-blen (emit-at sigs env d tP a) (lapp u-n u-rp))
         lcons b r2 →
           (case r2 of
              lnil → cat5 (if %weq p P-load64 then u-ld64 else u-ld32) (emit-at sigs env d tP a) u-comma (emit-at sigs env d tW b) u-rp
              lcons c r3 → cat7 (if %weq p P-store64 then u-st64 else if %weq p P-store64-ip then s-st64i else if %weq p P-store32-ip then s-st32i else u-st32) (emit-at sigs env d tP a) u-comma (emit-at sigs env d tW b) u-comma (emit-at sigs env d tW c) u-rp))
    lnil → s-unsup
-- a loop: typed state locals; the body's shape if c then continue (state) else break r prints as
-- a for with reassignments; any other body falls back to the boxed protocol of lib/emitc.cub
loop-u sigs env d init body =
  let k = lst-len init
      tys = init-types sigs env init
      env2 = push-types sigs env init
      rt = loop-ty sigs env init body
  in case body of
       fif c a b →
         (case a of
            fcon dd kk st →
              (case b of
                 fcon dd2 kk2 fs →
                   (case fs of
                      lcons r rest →
                        cat6 u-bsx (cat3 (ty-decl rt) (lcons #114 lnil) u-semi) (inits-u sigs env d tys init #0)
                          (cat4 u-for (emit-at sigs env2 (%wadd d k) tW c) u-forthen (reassign-u sigs env2 (%wadd d k) tys k st #0))
                          (cat3 u-cont (emit-at sigs env2 (%wadd d k) rt r) u-forend)
                          (lapp (lcons #114 lnil) u-bsend)
                      _ → emit d (floop init body))
                 _ → emit d (floop init body))
            _ → emit d (floop init body))
       _ → emit d (floop init body)
init-types sigs env l = case l of lnil → lnil; lcons x xs → lcons (infer-u sigs env x) (init-types sigs (lcons (infer-u sigs env x) env) xs)
-- state variable i is v_(d+1+i); typed by tys
inits-u sigs env d tys l i =
  case l of
    lnil → lnil
    lcons x xs → cat7 (ty-decl (ty-at tys i)) (var (%wsucc (%wadd d i)) #0) u-assign (emit-at sigs env d (ty-at tys i) x) u-semi (inits-u sigs (lcons (infer-u sigs env x) env) d tys xs (%wsucc i)) lnil
ty-at tys i = case tys of lnil → tP; lcons t r → if %weq i #0 then t else ty-at r (%wsub i #1)
-- the new state: computed into temporaries first (each reads the old state), then assigned
reassign-u sigs env d tys k st i =
  case st of
    lnil → assign-back d k #0
    lcons x xs → cat6 (ty-decl (ty-at tys i)) (lapp (lcons #116 lnil) (dec i)) u-assign (emit-at sigs env d (ty-at tys i) x) u-semi (reassign-u sigs env d tys k xs (%wsucc i))
assign-back d k i = if %weq i k then lnil else cat5 (var (%wsub d (%wsub (%wsub k #1) i)) #0) u-assign (lapp (lcons #116 lnil) (dec i)) u-semi (assign-back d k (%wsucc i))
-- definitions and programs
params-u tys i n = if %weq i n then lnil else (case %weq (%wsucc i) n of true → cat3 (ty-decl (ty-at tys i)) (var (%wsucc i) #0) lnil; false → cat4 (ty-decl (ty-at tys i)) (var (%wsucc i) #0) u-comma (params-u tys (%wsucc i) n))
head-u sigs g n = case sig-of sigs g of
  some s → cat7 u-fn (ty-decl (snd s)) u-f (dec g) u-lp (if %weq n #0 then u-void else params-u (fst s) #0 n) lnil
  none → cat7 u-fn u-p u-f (dec g) u-lp (if %weq n #0 then u-void else params-u lnil #0 n) lnil
emit-def-u sigs g n body =
  case sig-of sigs g of
    some s → cat3 (head-u sigs g n) u-body (lapp (emit-at sigs (lst-rev (fst s)) n (snd s) body) u-end)
    none → cat3 (head-u sigs g n) u-body (lapp (emit-at sigs lnil n tP body) u-end)
proto-u sigs g n = lapp (head-u sigs g n) u-proto-end
protos-u sigs defs = case defs of lnil → lnil; lcons d r → lapp (proto-u sigs (fst d) (fst (snd d))) (protos-u sigs r)
defs-u sigs defs = case defs of lnil → lnil; lcons d r → lapp (emit-def-u sigs (fst d) (fst (snd d)) (snd (snd d))) (defs-u sigs r)
-- box_d and unbox_d for every flat type a program constructs
flat-types defs = case defs of lnil → lnil; lcons d r → flat-in (snd (snd d)) (flat-types r)
flat-in t acc =
  case t of
    fcon d c fs → flat-list fs (add-dts d acc)
    frec d c alts → flat-ralts-in alts (flat-in c (add-dts d acc))
    fswitch x alts → flat-alts-in alts (flat-in x acc)
    fproj d c k x → flat-in x (add-dts d acc)
    fcall g args → flat-list args acc
    fprim p args → flat-list args acc
    flet a b → flat-in b (flat-in a acc)
    fif c a b → flat-in b (flat-in a (flat-in c acc))
    floop init body → flat-in body (flat-list init acc)
    fclos g env → flat-list env acc
    fapply f args → flat-list args (flat-in f acc)
    fassume f b → flat-in b acc
    fforce x → flat-in x acc
    fthunk a → flat-in a acc
    fupd u dd x c k v → flat-in v (flat-in x (add-dts dd acc))
    _ → acc
notb-u b = case b of true → false; false → true
-- a data type the program names, with the data types its fields reach (a list of trees needs the
-- tree's typedef too); flat types first, since a pointer type may hold one by value
add-dts d acc = if orb (%weq d #0) (lmem-w d acc) then acc else (if is-udata d then reach-dts d (lcons d acc) else acc)
reach-dts d acc = reach-ctors d (nctors-t d) #0 acc
reach-ctors d n c acc = if %weq c n then acc else reach-ctors d n (%wsucc c) (reach-fields (cshape-r d c) acc)
reach-fields ks acc = case ks of lnil → acc; lcons k r → reach-fields r (if %weq (fst k) #2 then add-dts (snd k) acc else acc)
flat-first ds = lapp (flat-by-depth ds #0) (keep-if (λ d → notb-u (is-flat d)) ds)
-- the flat types by how deep they nest records (a type holding one by value after it)
flat-by-depth ds k = if %wlt #6 k then lnil else lapp (keep-if (λ d → andb (is-flat d) (%weq (flat-depth d #0) k)) ds) (flat-by-depth ds (%wsucc k))
flat-depth d lim = if %wlt #6 lim then #0 else depth-ctors d (nctors-t d) #0 lim #0
depth-ctors d n c lim acc = if %weq c n then acc else depth-ctors d n (%wsucc c) lim (depth-fields (cshape-r d c) lim acc)
depth-fields ks lim acc = case ks of lnil → acc; lcons k r → depth-fields r lim (if %weq (fst k) #2 then %wmax acc (%wsucc (flat-depth (snd k) (%wsucc lim))) else acc)
keep-if p l = case l of lnil → lnil; lcons x r → (if p x then lcons x (keep-if p r) else keep-if p r)
flat-list l acc = case l of lnil → acc; lcons x xs → flat-list xs (flat-in x acc)
flat-alts-in alts acc = case alts of lnil → acc; lcons a r → flat-alts-in r (flat-in (snd (snd a)) acc)
flat-ralts-in alts acc = case alts of lnil → acc; lcons a r → flat-ralts-in r (flat-in (snd (snd (snd a))) acc)
box-fns ds0 =
  let ds = flat-first ds0
  in cat4 (fwds-of ds) (types-of ds) (box-protos ds) (box-bodies ds)
fwds-of ds = case ds of lnil → lnil; lcons d r → lapp (type-fwd d) (fwds-of r)
types-of ds = case ds of lnil → lnil; lcons d r → lapp (type-c d) (types-of r)
box-protos ds = case ds of lnil → lnil; lcons d r → cat3 (box-proto d) (unbox-proto d) (box-protos r)
box-bodies ds = case ds of lnil → lnil; lcons d r → cat3 (if is-flat d then box-fn d else pbox-fn d) (if is-flat d then unbox-fn d else punbox-fn d) (box-bodies r)
box-proto d = cat6 u-boxfn (dec d) u-boxhead (dec d) (if is-flat d then u-boxp-end else u-pboxp-end) lnil
unbox-proto d = cat7 (if is-flat d then u-unboxfn else u-punboxfn) (dec d) (if is-flat d then u-unboxname else u-punboxname) (dec d) u-unboxp-end lnil lnil
u-boxp-end = (lcons #32 (lcons #120 (lcons #41 (lcons #59 (lcons #10 lnil)))))
u-pboxp-end = (lcons #32 (lcons #42 (lcons #120 (lcons #41 (lcons #59 (lcons #10 lnil))))))
u-unboxp-end = (lcons #40 (lcons #86 (lcons #32 (lcons #42 (lcons #118 (lcons #41 (lcons #59 (lcons #10 lnil))))))))
u-punboxfn = (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #32 (lcons #84 lnil))))))))
u-punboxname = (lcons #32 (lcons #42 (lcons #117 (lcons #110 (lcons #98 (lcons #111 (lcons #120 lnil)))))))
-- static V *box_d(T_d *x) { switch (x->tag) { case c: return mkc(c, n, mkw(x->u.cK.f0), box_d2(x->u.cK.f1), …); … } }
pbox-fn d = cat7 u-boxfn (dec d) u-boxhead (dec d) u-pboxbody (pbox-alts d (nctors-t d) #0) u-abort
u-pboxbody = (lcons #32 (lcons #42 (lcons #120 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #115 (lcons #119 (lcons #105 (lcons #116 (lcons #99 (lcons #104 (lcons #32 (lcons #40 (lcons #120 (lcons #45 (lcons #62 (lcons #116 (lcons #97 (lcons #103 (lcons #41 (lcons #32 (lcons #123 (lcons #32 lnil)))))))))))))))))))))))))
pbox-alts d n c = if %weq c n then lnil else lapp (pbox-alt d c (cshape-r d c)) (pbox-alts d n (%wsucc c))
pbox-alt d c ks = cat7 u-case2 (dec c) u-colon u-mkcc (dec c) u-comma (cat3 (dec (lst-len ks)) (pbox-fields d c ks #0) (lapp u-rp u-semi))
pbox-fields d c ks i =
  case ks of
    lnil → lnil
    lcons k r →
      let acc = cat4 u-xpu (dec c) u-dot-f (dec i)
          e = (if %weq (fst k) #0 then cat3 u-mkw acc u-rp else if %weq (fst k) #1 then cat4 u-boxname-c (dec d) u-lp (lapp acc u-rp) else if %weq (fst k) #2 then (if is-udata (snd k) then cat4 u-boxname-c (dec (snd k)) u-lp (lapp acc u-rp) else acc) else acc)
      in cat3 u-comma e (pbox-fields d c r (%wsucc i))
-- static T_d *unbox_d(V *v) { T_d *p = malloc(sizeof(T_d)); switch (v->tag - 1) { case c: *p = (T_d){ .tag = c, .u = { .cK = { v->f[0]->n, unbox_d2(v->f[1]), … } } }; return p; … } }
punbox-fn d = cat7 u-punboxfn (dec d) u-punboxname (dec d) (cat5 u-unboxpbody (dec d) u-unboxpbody2 (dec d) u-unboxpbody3) (punbox-alts d (nctors-t d) #0) u-abort
u-unboxpbody = (lcons #40 (lcons #86 (lcons #32 (lcons #42 (lcons #118 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #84 lnil))))))))))
u-unboxpbody2 = (lcons #32 (lcons #42 (lcons #112 (lcons #32 (lcons #61 (lcons #32 (lcons #109 (lcons #97 (lcons #108 (lcons #108 (lcons #111 (lcons #99 (lcons #40 (lcons #115 (lcons #105 (lcons #122 (lcons #101 (lcons #111 (lcons #102 (lcons #40 (lcons #84 lnil)))))))))))))))))))))
u-unboxpbody3 = (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #115 (lcons #119 (lcons #105 (lcons #116 (lcons #99 (lcons #104 (lcons #32 (lcons #40 (lcons #118 (lcons #45 (lcons #62 (lcons #116 (lcons #97 (lcons #103 (lcons #32 (lcons #45 (lcons #32 (lcons #49 (lcons #41 (lcons #32 (lcons #123 (lcons #32 lnil))))))))))))))))))))))))))
punbox-alts d n c = if %weq c n then lnil else lapp (punbox-alt d c (cshape-r d c)) (punbox-alts d n (%wsucc c))
punbox-alt d c ks = cat7 u-case2 (dec c) u-colon (cat3 u-pstar (dec d) (cat3 u-brace u-tagdecl (dec c))) (cat5 u-udecl (dec c) u-fdecl (punbox-fields d ks #0) (lapp u-cend (lcons #32 (lcons #125 u-semi)))) u-retp lnil
u-pstar = (lcons #42 (lcons #112 (lcons #32 (lcons #61 (lcons #32 (lcons #40 (lcons #84 lnil)))))))
u-retp = (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #112 (lcons #59 (lcons #32 lnil)))))))))))
punbox-fields d ks i =
  case ks of
    lnil → lnil
    lcons k r →
      let acc = cat3 u-vf (dec i) u-rb
          e = (if %weq (fst k) #0 then lapp acc u-n else if %weq (fst k) #1 then cat4 u-unboxname-c (dec d) u-lp (lapp acc u-rp) else if %weq (fst k) #2 then (if is-udata (snd k) then cat4 u-unboxname-c (dec (snd k)) u-lp (lapp acc u-rp) else acc) else acc)
      in (case r of lnil → e; _ → cat3 e u-comma (punbox-fields d r (%wsucc i)))
-- static V *box_d(T_d x) { switch (x.tag) { case c: return mkc(c, n, mkw(x.u.cK.f0), …); … default: abort(); } }
box-fn d = cat6 u-boxfn (dec d) u-boxhead (dec d) u-boxbody (lapp (box-cases d (layout d) #0) u-abort)
box-cases d l c = case l of lunion alts → box-alts d alts c; _ → lnil
box-alts d alts c = case alts of lalt l r → lapp (box-alt d c (count-fields l)) (box-alts d r (%wsucc c)); _ → lnil
box-alt d c n = cat7 u-case2 (dec c) u-colon u-mkcc (dec c) u-comma (cat3 (dec n) (box-fields-k c (cshape-r d c) #0) (lapp u-rp u-semi))
-- a field: a word mkw(x.u.cK.fI), a nested record box_d2(x.u.cK.fI)
box-fields-k c ks i =
  case ks of
    lnil → lnil
    lcons k r →
      let acc = cat4 u-xu (dec c) u-dot-f (dec i)
          e = if %weq (fst k) #2 then cat4 u-boxname-c (dec (snd k)) u-lp (lapp acc u-rp) else cat3 u-mkw acc u-rp
      in cat3 u-comma e (box-fields-k c r (%wsucc i))
box-fields c n i = if %weq i n then lnil else cat7 u-comma u-mkw u-xu (dec c) u-dot-f (dec i) (lapp u-rp (box-fields c n (%wsucc i)))
-- static T_d unbox_d(V *v) { switch (v->tag - 1) { case c: return (T_d){ .tag = c, .u = { .cK = { v->f[0]->n, … } } }; … } }
unbox-fn d = cat7 u-unboxfn (dec d) u-unboxname (dec d) u-unboxbody (unbox-cases d (layout d) #0) u-abort
unbox-cases d l c = case l of lunion alts → unbox-alts d alts c; _ → lnil
unbox-alts d alts c = case alts of lalt l r → lapp (unbox-alt d c (count-fields l)) (unbox-alts d r (%wsucc c)); _ → lnil
unbox-alt d c n = cat7 u-case2 (dec c) u-colon u-rcastT (dec d) (cat3 u-brace u-tagdecl (dec c)) (cat5 u-udecl (dec c) u-fdecl (unbox-fields-k (cshape-r d c) #0) (lapp u-cend (lcons #32 (lcons #125 u-semi))))
-- a field: a word v->f[I]->n, a nested record unbox_d2(v->f[I])
unbox-fields-k ks i =
  case ks of
    lnil → lnil
    lcons k r →
      let acc = cat3 u-vf (dec i) u-rb
          e = if %weq (fst k) #2 then cat4 u-unboxname-c (dec (snd k)) u-lp (lapp acc u-rp) else lapp acc u-n
      in (case r of lnil → e; _ → cat3 e u-comma (unbox-fields-k r (%wsucc i)))
unbox-fields n i = if %weq i n then lnil else (case %weq (%wsucc i) n of true → cat3 u-vf (dec i) (lapp u-rb u-n); false → cat5 u-vf (dec i) (lapp u-rb u-n) u-comma (unbox-fields n (%wsucc i)))
emit-prog-u defs =
  let sigs = sigs-of defs
  in cat6 s-runtime u-prdecl (box-fns (flat-types defs)) (protos-u sigs defs) (dispatch (clos-defs defs)) (lapp (defs-u sigs defs) (if %weq (ret-ty sigs #0) tW then u-main-w else if is-pr (ret-ty sigs #0) then u-main-pr else u-main-p))
-- the program as a library (B18's call boundary, the emit side): no main; definition 0 is exported
-- (not static) as cubical_entry over the signature's C types, calling f_0. A C program or the
-- machine (#native, src/lang.c) links it and calls cubical_entry
entry-args i n = if %weq i n then lnil else (case %weq (%wsucc i) n of true → var (%wsucc i) #0; false → cat3 (var (%wsucc i) #0) u-comma (entry-args (%wsucc i) n))
entry-u sigs n = export-u sigs #0 n u-entry-name
emit-lib-u defs = emit-lib-named-u defs (lcons (#0 , u-entry-name) lnil)
u-entry-name = (lcons #99 (lcons #117 (lcons #98 (lcons #105 (lcons #99 (lcons #97 (lcons #108 (lcons #95 (lcons #101 (lcons #110 (lcons #116 (lcons #114 (lcons #121 lnil)))))))))))))
-- the library with every definition in names (a Lst of (g , name bytes)) exported under its name:
-- <ret> name(<typed params>) { return f_g(v0, ...); } — a compiled definition over declared
-- representations called from C by the name the store gives it (B18's exported C functions)
emit-lib-named-u defs names =
  let sigs = sigs-of defs
  in cat6 s-runtime u-prdecl (box-fns (flat-types defs)) (protos-u sigs defs) (dispatch (clos-defs defs)) (lapp (defs-u sigs defs) (exports-u sigs defs names))
exports-u sigs defs names = case names of lnil → lnil; lcons nm r → lapp (export-u sigs (fst nm) (def-arity defs (fst nm)) (snd nm)) (exports-u sigs defs r)
export-u sigs g n name =
  let s = fromopt (sig-of sigs g) (push-n tP n lnil , tP)
  in cat7 (ty-decl (snd s)) (lapp name u-lp) (if %weq n #0 then u-void else params-u (fst s) #0 n) u-body (cat3 u-f (dec g) u-lp) (entry-args #0 n) (lapp u-rp u-end)
def-arity defs g = case defs of lnil → #0; lcons d r → if %weq (fst d) g then fst (snd d) else def-arity r g
-- the boxed export (B18, the machine's #native with data values): every data-typed parameter and
-- result crosses as the boxed V (unbox<d> on the way in, box<d> on the way out), words as
-- uint64_t; <ret> name(V *v0, uint64_t v1) { return box<d>(f_g(unbox<d2>(v0), v1)); }
export-boxed-u sigs g n name =
  let s = fromopt (sig-of sigs g) (push-n tP n lnil , tP)
      rt = snd s
  in cat7 (if is-dt rt then u-p else ty-decl rt) (lapp name u-lp) (if %weq n #0 then u-void else bparams-u (fst s) #0 n) u-body
       (if is-dt rt then cat5 u-boxname-c (dec (dt-of rt)) u-lp (cat3 u-f (dec g) u-lp) (lapp (bentry-args (fst s) #0 n) u-rp) else cat3 u-f (dec g) (lapp u-lp (bentry-args (fst s) #0 n)))
       (lapp u-rp u-end) lnil
bparams-u tys i n = if %weq i n then lnil else (case %weq (%wsucc i) n of true → cat3 (if is-dt (ty-at tys i) then u-p else ty-decl (ty-at tys i)) (var (%wsucc i) #0) lnil; false → cat4 (if is-dt (ty-at tys i) then u-p else ty-decl (ty-at tys i)) (var (%wsucc i) #0) u-comma (bparams-u tys (%wsucc i) n))
bentry-args tys i n =
  if %weq i n then lnil
  else (let a = (if is-dt (ty-at tys i) then cat4 u-unboxname-c (dec (dt-of (ty-at tys i))) u-lp (lapp (var (%wsucc i) #0) u-rp) else var (%wsucc i) #0)
        in case %weq (%wsucc i) n of true → a; false → cat3 a u-comma (bentry-args tys (%wsucc i) n))
emit-lib-boxed-u defs =
  let sigs = sigs-of defs
  in cat6 s-runtime u-prdecl (box-fns (flat-types defs)) (protos-u sigs defs) (dispatch (clos-defs defs)) (lapp (defs-u sigs defs) (export-boxed-u sigs #0 (def-arity defs #0) u-entry-name))
-- a program's bytes as a byte string (item 17's re-entry, #native f n at k: the net computes the C
-- program at the values a running program supplies, and the machine compiles this byte string)
bytes-of-list l = bl-fill (%bytes (lst-len l)) #0 l
bl-fill b i l = case l of lnil → b; lcons x r → bl-fill (%store8 b i (%u32ofw x)) (%wsucc i) r
-- ---------------------------------------------------------------- declared signatures (item 14)
-- A definition of a program from the store (program-at / program-rep-at m: global g is definition
-- g + 1; the entry m, definition 0 and the lifted closures from 100000 are not globals) is typed
-- from its checked type (FT by global-sig, lib/lower.cub): each parameter and the result by its
-- declared type — a word, an Int64 or Float64 (a word here), a pair of such, a data type (by value
-- when flat, a typed pointer when pointer data, else boxed) — and by use where FT says nothing
-- (ftany, byte strings, functions) or where the FT's arity is not the definition's (an erased
-- parameter). ft-of reads a represented type as its representation, so these printers are for
-- programs with the representations consumed (program-rep). The entries: emit-prog-d m defs,
-- emit-lib-d m defs
ft-ty t =
  case t of
    ftword → some tW
    fti64 → some tW
    ftf64 → some tW
    ftpair a b → (case ft-ty a of some x → (case ft-ty b of some y → some (pr-ty x y); none → none); none → none)
    ftdata d ps r → some (if is-udata d then dt-ty d else tP)
    _ → none
from-store m g = andb (notb-u (%weq g #0)) (andb (notb-u (%weq g m)) (%wlt g #100000))
merge-tys fs us = case fs of lnil → us; lcons f fr → (case us of lnil → lnil; lcons u ur → lcons (fromopt (ft-ty f) u) (merge-tys fr ur))
decl-or-use m sigs g n body =
  let u = def-sig sigs n body
  in if from-store m g
       then (case quote-ty (%gty (%wsub g #1)) of
               some T → (let s = sig-ft T in if %weq (lst-len (fst s)) n then (merge-tys (fst s) (fst u) , fromopt (ft-ty (snd s)) (snd u)) else u)
               none → u)
       else u
sigs-of-d m defs = let ct = clos-targets defs in sigs-round-d m ct (sigs-round-d m ct (sigs-round-d m ct lnil defs) defs) defs
sigs-round-d m ct sigs defs =
  case defs of
    lnil → lnil
    lcons d r → lcons (fst d , (if lmem-w (fst d) ct then (push-n tP (fst (snd d)) lnil , tP) else decl-or-use m sigs (fst d) (fst (snd d)) (snd (snd d)))) (sigs-round-d m ct sigs r)
emit-prog-d m defs =
  let sigs = sigs-of-d m defs
  in cat6 s-runtime u-prdecl (box-fns (flat-types defs)) (protos-u sigs defs) (dispatch (clos-defs defs)) (lapp (defs-u sigs defs) (if %weq (ret-ty sigs #0) tW then u-main-w else if is-pr (ret-ty sigs #0) then u-main-pr else u-main-p))
emit-lib-d m defs =
  let sigs = sigs-of-d m defs
  in cat6 s-runtime u-prdecl (box-fns (flat-types defs)) (protos-u sigs defs) (dispatch (clos-defs defs)) (lapp (defs-u sigs defs) (exports-u sigs defs (lcons (#0 , u-entry-name) lnil)))
-- the exported entry of a one-definition program over two words: uint64_t cubical_entry(uint64_t v0, uint64_t v1) { return f_0(v0, v1); }
#same entry-u (sigs-of (lcons (#0 , (#2 , fprim P-add (lcons (fvar #1) (lcons (fvar #0) lnil)))) lnil)) #2 = (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #99 (lcons #117 (lcons #98 (lcons #105 (lcons #99 (lcons #97 (lcons #108 (lcons #95 (lcons #101 (lcons #110 (lcons #116 (lcons #114 (lcons #121 (lcons #40 (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #118 (lcons #48 (lcons #44 (lcons #32 (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #118 (lcons #49 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #102 (lcons #95 (lcons #48 (lcons #40 (lcons #118 (lcons #48 (lcons #44 (lcons #32 (lcons #118 (lcons #49 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
