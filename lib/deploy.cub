-- lib/deploy.cub — deployment as a term (PLAN Phase 8). Loaded after the library (lib/os/platform.cub,
-- lib/os/linux.cub) and lib/net.cub, lib/fleet.cub.
--
-- A corpus is the node programs by role: for each role a machine (a state type with a view over
-- the node signature), its initial state, the wire form of its messages, and what the process
-- leaves with when the machine stops. A configuration is a value: the platform, and per node
-- its role and its address (the list is the wiring: a node's peers are the others' addresses).
-- deploy corpus config is the fleet: the behaviour by node id and the initial state (what
-- lib/fleet.cub's properties are stated of), and for each node the process that runs on its
-- box — the machine's process handled into Linux commands over UDP (net-on-linux) and those
-- into the drivers' signature W (linux-run), a Step W that #build writes as a binary.
-- ---------------------------------------------------------------- handlers at any level
-- lib/proc.cub's handle with the level free: the node's process is interpreted into Linux, and
-- that into W, so the first interpretation is at the level above
handle-l : {l : Level} {S T : Sig} {A : Type} → ((c : Cmd S) → Proc {l} T (Resp S c)) → Proc {lsuc l} S A → Proc {l} T A
handle-l {l} {S} {T} {A} hd p = p (Proc {l} T A) (ret {l} {T} {A}) (λ c k → bind {l} {T} {Resp S c} {A} (hd c) k)
-- ---------------------------------------------------------------- the wire and the configuration
-- a message on the wire: four 64-bit words (32 bytes, little-endian words by the platform)
Wire : Type
Wire = Word × (Word × (Word × Word))
record Codec (M : Type) = { cd-enc : M → Wire ; cd-dec : Wire → M }
record NodeCfg = { nc-role : Word ; nc-addr : SockAddr }
record ConfigData = { cf-platform : Platform ; cf-nodes : List NodeCfg ; cf-fuel : Word }
-- a configuration: the data and the platform fact the wire layout relies on
Config : Type
Config = (c : ConfigData) × LittleEndian (cf-platform c)
dp-nth : {A : Type} → Nat → List A → Sum A Unit
dp-nth i l = case take-at i l of inl pr → inl (fst pr); inr u → inr unit
dp-len : {A : Type} → List A → Nat
dp-len l = case l of nil → zero; cons x r → suc (rec r)
-- the node an address belongs to: its index in the configuration, or the number of nodes (no
-- node) when it is nobody's
dp-id-of : List NodeCfg → SockAddr → Nat
dp-id-of l a = case l of
  nil → zero
  cons nc r → (case andB (weq (sa-port (nc-addr nc)) (sa-port a)) (weq (sa-ip (nc-addr nc)) (sa-ip a)) of true → zero; false → suc (rec r))
-- ---------------------------------------------------------------- the corpus
record Corpus (M : Type) (St : Type) = { cp-view : Word → St → NView M St ; cp-init : Word → St ; cp-codec : Codec M ; cp-exit : St → Word }
-- ---------------------------------------------------------------- the network over Linux
-- a node's commands as Linux commands on a bound UDP socket fd with a 32-byte buffer buf:
-- send writes the four words and sends them to the addressee's address (a node that is not in
-- the configuration, and a failed send, are a lost packet); receive takes one datagram and
-- reads the four words, its sender the node the source address belongs to (an error or a short
-- datagram is a timeout); now is the platform's clock in nanoseconds
dp-poke4 : {l : Level} → Word → Wire → Proc {l} Linux Unit
dp-poke4 {l} buf w =
  bind {l} {Linux} {Unit} {Unit} (lx {l} (lx-poke64 buf (fst w))) (λ u1 →
  bind {l} {Linux} {Unit} {Unit} (lx {l} (lx-poke64 (%wadd buf #8) (fst (snd w)))) (λ u2 →
  bind {l} {Linux} {Unit} {Unit} (lx {l} (lx-poke64 (%wadd buf #16) (fst (snd (snd w))))) (λ u3 →
  lx {l} (lx-poke64 (%wadd buf #24) (snd (snd (snd w)))))))
dp-peek4 : {l : Level} → Word → Proc {l} Linux Wire
dp-peek4 {l} buf =
  bind {l} {Linux} {Word} {Wire} (lx {l} (lx-peek64 buf)) (λ a →
  bind {l} {Linux} {Word} {Wire} (lx {l} (lx-peek64 (%wadd buf #8))) (λ b →
  bind {l} {Linux} {Word} {Wire} (lx {l} (lx-peek64 (%wadd buf #16))) (λ c →
  bind {l} {Linux} {Word} {Wire} (lx {l} (lx-peek64 (%wadd buf #24))) (λ d →
  ret {l} {Linux} {Wire} (a , (b , (c , d)))))))
dp-send : {l : Level} → List NodeCfg → Word → Word → Sum NodeCfg Unit → Wire → Proc {l} Linux Unit
dp-send {l} nodes fd buf dst w = case dst of
  inl nc → bind {l} {Linux} {Unit} {Unit} (dp-poke4 {l} buf w) (λ u →
           bind {l} {Linux} {Sum Errno (Upto #32)} {Unit} (lx {l} (lx-sendto fd buf #32 #0 (nc-addr nc))) (λ r → ret {l} {Linux} {Unit} unit))
  inr u → ret {l} {Linux} {Unit} unit
dp-recv : {l : Level} {M : Type} → Codec M → List NodeCfg → Word → Word → Proc {l} Linux (Rcv M)
dp-recv {l} {M} cd nodes fd buf =
  bind {l} {Linux} {Sum Errno (Upto #32 × SockAddr)} {Rcv M} (lx {l} (lx-recvfrom fd buf #32 #0)) (λ r →
    case r of
      inl e → ret {l} {Linux} {Rcv M} r-timeout
      inr x → (case weq (fst (fst x)) #32 of
                 true → bind {l} {Linux} {Wire} {Rcv M} (dp-peek4 {l} buf) (λ w → ret {l} {Linux} {Rcv M} (r-msg (dp-id-of nodes (snd x)) (cd-dec cd w)))
                 false → ret {l} {Linux} {Rcv M} r-timeout))
dp-now : {l : Level} → Proc {l} Linux Word
dp-now {l} =
  bind {l} {Linux} {Sum Errno Timespec} {Word} (lx {l} lx-clock-gettime) (λ r →
    case r of inl e → ret {l} {Linux} {Word} #0; inr ts → ret {l} {Linux} {Word} (%wadd (wmul (ts-sec ts) #1000000000) (ts-nsec ts)))
net-on-linux : {l : Level} {M : Type} → Codec M → List NodeCfg → Word → Word → (c : NetCmd M) → Proc {l} Linux (net-resp {M} c)
net-on-linux {l} {M} cd nodes fd buf c =
  case c return (λ x → Proc {l} Linux (net-resp {M} x)) of
    n-send to m → dp-send {l} nodes fd buf (dp-nth {NodeCfg} to nodes) (cd-enc cd m)
    n-recv → dp-recv {l} {M} cd nodes fd buf
    n-now → dp-now {l}
-- ---------------------------------------------------------------- one node's process
-- open and bind the socket at the node's address, take the buffer, run the role's machine
-- through net-on-linux, and leave with the corpus's status of the state it stopped in. The
-- fuel (the configuration's bound on the machine's steps) is written to the buffer and read
-- back, so that it is a value of the run: a bound known to the compiler is unfolded by it. A node id outside the configuration is a process that ends at once
dp-node-at : {l : Level} {M St : Type} → Corpus M St → ConfigData → Sum NodeCfg Unit → Proc {l} Linux (Sum Errno Word)
dp-node-at {l} {M} {St} cp cf n = case n of
  inl nc →
    lx-then {l} {Word} {Word} (lx {l} (lx-socket #2 #2 #0)) (λ fd →
    lx-then {l} {Unit} {Word} (lx {l} (lx-bind fd (nc-addr nc))) (λ u →
    bind {l} {Linux} {Word} {Sum Errno Word} (lx {l} (lx-alloc #32)) (λ buf →
    bind {l} {Linux} {Unit} {Sum Errno Word} (lx {l} (lx-poke64 buf (cf-fuel cf))) (λ u1 →
    bind {l} {Linux} {Word} {Sum Errno Word} (lx {l} (lx-peek64 buf)) (λ fuel →
    bind {l} {Linux} {St} {Sum Errno Word}
      (handle-l {l} {NetSig M} {Linux} {St} (net-on-linux {l} {M} (cp-codec cp) (cf-nodes cf) fd buf)
         (mach-proc-w {lsuc l} {M} {St} (cp-view cp (nc-role nc)) fuel (cp-init cp (nc-role nc)))) (λ st →
    bind {l} {Linux} {Unit} {Sum Errno Word} (lx {l} (lx-exit-group (cp-exit cp st))) (λ u2 →
    ret {l} {Linux} {Sum Errno Word} (inr (cp-exit cp st)))))))))
  inr u → ret {l} {Linux} {Sum Errno Word} (inr #0)
dp-node : {l : Level} {M St : Type} → Corpus M St → ConfigData → NodeId → Proc {l} Linux (Sum Errno Word)
dp-node {l} {M} {St} cp cf i = dp-node-at {l} {M} {St} cp cf (dp-nth {NodeCfg} i (cf-nodes cf))
-- ---------------------------------------------------------------- the fleet and deploy
dp-role-view : {M St : Type} → Corpus M St → Sum NodeCfg Unit → St → NView M St
dp-role-view cp n s = case n of inl nc → cp-view cp (nc-role nc) s; inr u → v-halt
dp-role-init : {M St : Type} → Corpus M St → Sum NodeCfg Unit → St
dp-role-init cp n = case n of inl nc → cp-init cp (nc-role nc); inr u → cp-init cp #0
-- the fleet value: its size, the behaviour and initial state the properties are stated of, the
-- configuration it was placed by, and each node's process over W
record Fleet (M : Type) (St : Type) = { fl-size : Nat ; fl-beh : NodeId → St → NView M St ; fl-init : FState M St ; fl-config : ConfigData ; fl-node : NodeId → Step W (Sum Errno Word) }
-- t14 (2026-11-12): needs-work. fl-beh (what lib/fleet.cub's properties are stated of) and fl-node
-- (the process each binary runs) are both built from cp-view, but nothing relates them: the
-- properties proved of the behaviour are not shown to hold of the binaries. The relation comes
-- from processes realized as executables with their system-call events equal to the process's
-- interaction (work/graph.cub, native), applied here; nothing specific to this file is owed.
deploy : {M St : Type} → Corpus M St → Config → Fleet M St
deploy {M} {St} cp cfg =
  Fleet { fl-size = dp-len {NodeCfg} (cf-nodes (fst cfg))
        ; fl-beh = λ i s → dp-role-view {M} {St} cp (dp-nth {NodeCfg} i (cf-nodes (fst cfg))) s
        ; fl-init = ((λ i → dp-role-init {M} {St} cp (dp-nth {NodeCfg} i (cf-nodes (fst cfg)))) , net-empty {M})
        ; fl-config = fst cfg
        ; fl-node = λ i → to-step {W} {Sum Errno Word} (linux-run {Sum Errno Word} (cf-platform (fst cfg)) (snd cfg) (dp-node {lsuc lzero} {M} {St} cp (fst cfg) i)) }
