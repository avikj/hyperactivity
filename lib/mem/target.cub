-- lib/mem/target.cub — the implementation's choices as a value (archive/2026-11-11/PLAN-rev9.md, revision 9, 9 Nov 2026, sha256 4d012c3a10fd…, §5 “The distinctions everything above x86 rests on”, item 1 “The abstract machine is written; implementations are lifted”).
-- A language's abstract machine leaves these to the
-- implementation; here they are a record every definition of lib/mem/ that depends on one takes
-- as a parameter, so a meaning is stated at a Target and a binary is the meaning at one.
--
-- The choices: the byte order of scalar representations; the size and the alignment, in bytes,
-- of each kind of scalar the C family names without fixing (bool, char, short, int, long,
-- long long, a pointer, float, double, the 128-bit integer); whether plain char is signed; how
-- pointers convert to integers and back (not offered, or a flat address space in which an
-- allocation has a base address); the alignment the allocator gives dynamic storage; and the
-- address the flat address space starts handing out bases from.
import "../library.cub"
data Endian = en-little | en-big
data CK = ck-bool | ck-char | ck-short | ck-int | ck-long | ck-llong | ck-ptr | ck-float | ck-double | ck-int128
-- pointer ↔ integer: refused (the conversions are not offered: the meaning stops), or flat (an
-- allocation has a base address, a pointer's integer is base + offset, and an integer converts
-- back to the live allocation whose span, one past the end included, holds it)
data PtrInt = pi-refused | pi-flat
record Target = { tg-endian : Endian ; tg-size : CK → Word ; tg-align : CK → Word
                ; tg-char-signed : Bool ; tg-ptr-int : PtrInt ; tg-alloc-align : Word
                ; tg-base : Word }
-- ---------------------------------------------------------------- x86-64 System V (LP64)
-- sizes and alignments of the psABI's figure 3.1; char signed; little-endian; malloc aligns 16
x86-64-sysv-size : CK → Word
x86-64-sysv-size k = case k of
  ck-bool → #1
  ck-char → #1
  ck-short → #2
  ck-int → #4
  ck-long → #8
  ck-llong → #8
  ck-ptr → #8
  ck-float → #4
  ck-double → #8
  ck-int128 → #16
x86-64-sysv : Target
x86-64-sysv = Target { tg-endian = en-little ; tg-size = x86-64-sysv-size ; tg-align = x86-64-sysv-size
                     ; tg-char-signed = true ; tg-ptr-int = pi-flat ; tg-alloc-align = #16
                     ; tg-base = #65536 }
-- ---------------------------------------------------------------- two more, so that nothing below is written
-- for one target only: i386 System V (ILP32: long and pointers 4 bytes, long long and double
-- 8 bytes aligned 4, no 128-bit integer: its size is 0, which no scalar kind has), and s390x
-- (LP64, big-endian, char unsigned, 128-bit aligned 8)
i386-sysv-size : CK → Word
i386-sysv-size k = case k of
  ck-bool → #1
  ck-char → #1
  ck-short → #2
  ck-int → #4
  ck-long → #4
  ck-llong → #8
  ck-ptr → #4
  ck-float → #4
  ck-double → #8
  ck-int128 → #0
i386-sysv-align : CK → Word
i386-sysv-align k = case k of
  ck-llong → #4
  ck-double → #4
  ck-int128 → #1
  _ → i386-sysv-size k
i386-sysv : Target
i386-sysv = Target { tg-endian = en-little ; tg-size = i386-sysv-size ; tg-align = i386-sysv-align
                   ; tg-char-signed = true ; tg-ptr-int = pi-flat ; tg-alloc-align = #16
                   ; tg-base = #65536 }
s390x-elf-align : CK → Word
s390x-elf-align k = case k of
  ck-int128 → #8
  _ → x86-64-sysv-size k
s390x-elf : Target
s390x-elf = Target { tg-endian = en-big ; tg-size = x86-64-sysv-size ; tg-align = s390x-elf-align
                   ; tg-char-signed = false ; tg-ptr-int = pi-flat ; tg-alloc-align = #8
                   ; tg-base = #65536 }
#show tg-size x86-64-sysv ck-long
#show tg-size i386-sysv ck-long
#show tg-align i386-sysv ck-double
#show tg-align s390x-elf ck-int128
