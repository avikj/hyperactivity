-- lib/mem/scalar.cub — scalar kinds, scalar values and their total semantics.
-- Every operation is a function into MRes: a value, or undefined behaviour
-- with its reason, or a stop (the meaning is not given: the reason says why). Nothing here
-- depends on a language: C and C++ reach the kinds through their types and a Target (the last
-- section), Rust and Go name the kinds directly.
--
-- Binding time (PLAN §5.4): every operation takes the kind first and is a case on it, so at a
-- fixed program (kinds known) what remains is arithmetic on UInt64/Float64 values.
import "target.cub"

-- ---------------------------------------------------------------- outcomes
-- why a behaviour is undefined (each constructor is one rule of the abstract machine)
data UB = ub-signed-overflow | ub-div-zero | ub-div-overflow | ub-shift-count | ub-shift-negative
        | ub-float-int-range | ub-out-of-bounds | ub-dead | ub-misaligned | ub-uninit
        | ub-double-free | ub-free-not-dynamic | ub-free-interior | ub-null | ub-fn-as-object
        | ub-ptr-arith | ub-ptr-compare | ub-ptr-sub | ub-bad-bool | ub-overlap | ub-no-return
-- why a meaning stops without being undefined: the loop fuel ran out; the Target does not offer
-- what was asked (a 128-bit integer on i386, a pointer↔integer conversion under pi-refused); an
-- operation was applied at a kind it has no meaning at (a reader's error, not the program's:
-- adding pointers, a value whose constructor is not the kind's); the standard leaves the result
-- unspecified and no parameter here fixes it (an order between pointers into different allocations)
data Stop = st-fuel | st-unsupported | st-ill-typed | st-unspecified
data MRes (A : Type) = mok (a : A) | mub (why : UB) | mstop (why : Stop)
mr-bind : {A B : Type} → MRes A → (A → MRes B) → MRes B
mr-bind r f = case r of
  mok a → f a
  mub w → mub w
  mstop w → mstop w
mr-map : {A B : Type} → (A → B) → MRes A → MRes B
mr-map f r = case r of
  mok a → mok (f a)
  mub w → mub w
  mstop w → mstop w

-- ---------------------------------------------------------------- kinds and values
-- integer widths; a kind: an integer (signed or not) of a width, bool, the two binary floats, a pointer
data IW = iw8 | iw16 | iw32 | iw64 | iw128
data SK = sk-int (sg : Bool) (w : IW) | sk-bool | sk-f32 | sk-f64 | sk-ptr
-- a pointer: null, a place in an allocation (its id and a byte offset), a function (its id), or
-- an address that is in no allocation (what an integer converted to a pointer may be: it
-- converts back to the integer, and every access through it is undefined)
data MPtr = mp-null | mp-obj (a : Word) (off : Word) | mp-fn (f : Word) | mp-addr (x : Word)
-- a value. An integer of at most 64 bits is sv-i of its value extended to 64 bits (by its sign
-- when the kind is signed, by zeros otherwise): the canonical form every operation keeps. A
-- 128-bit integer is its two halves.
data SV = sv-i (v : UInt64) | sv-w (lo : UInt64) (hi : UInt64) | sv-b (b : Bool)
        | sv-f (x : Float32) | sv-d (x : Float64) | sv-p (p : MPtr)

-- ---------------------------------------------------------------- booleans and 64-bit helpers
m-and : Bool → Bool → Bool
m-and a b = case a of
  true → b
  false → false
m-or : Bool → Bool → Bool
m-or a b = case a of
  true → true
  false → b
uq0 : UInt64
uq0 = u64 #0
uq1 : UInt64
uq1 = u64 #1
uq-ones : UInt64
uq-ones = u64 #18446744073709551615
uq-top : UInt64
uq-top = u64 #9223372036854775808
uq-b : Bool → UInt64
uq-b b = case b of
  true → uq1
  false → uq0
uq-not : UInt64 → UInt64
uq-not x = u64xor x uq-ones
uq-neg : UInt64 → UInt64
uq-neg x = u64sub uq0 x
uq-isneg : UInt64 → Bool
uq-isneg x = not (u64lt x uq-top)
uq-slt : UInt64 → UInt64 → Bool
uq-slt a b = u64lt (u64xor a uq-top) (u64xor b uq-top)
uq-iszero : UInt64 → Bool
uq-iszero x = u64eq x uq0
-- arithmetic shift right by a count below 64
uq-sar : UInt64 → UInt64 → UInt64
uq-sar x n = u64or (u64shr x n) (case uq-isneg x of
  true → uq-not (u64shr uq-ones n)
  false → uq0)
-- the width in bits, the mask of a width's bits, its sign bit (for 128 bits: of a half)
iw-bits : IW → UInt64
iw-bits w = case w of
  iw8 → u64 #8
  iw16 → u64 #16
  iw32 → u64 #32
  iw64 → u64 #64
  iw128 → u64 #128
iw-bytes : IW → Word
iw-bytes w = case w of
  iw8 → #1
  iw16 → #2
  iw32 → #4
  iw64 → #8
  iw128 → #16
iw-mask : IW → UInt64
iw-mask w = case w of
  iw8 → u64 #255
  iw16 → u64 #65535
  iw32 → u64 #4294967295
  iw64 → uq-ones
  iw128 → uq-ones
iw-sign : IW → UInt64
iw-sign w = case w of
  iw8 → u64 #128
  iw16 → u64 #32768
  iw32 → u64 #2147483648
  iw64 → uq-top
  iw128 → uq-top
-- the canonical form at a width of at most 64 bits: the low bits extended by zeros, or by the sign
uq-zx : IW → UInt64 → UInt64
uq-zx w x = u64and x (iw-mask w)
uq-sx : IW → UInt64 → UInt64
uq-sx w x = u64sub (u64xor (u64and x (iw-mask w)) (iw-sign w)) (iw-sign w)
uq-cn : Bool → IW → UInt64 → UInt64
uq-cn sg w x = case sg of
  true → uq-sx w x
  false → uq-zx w x

-- ---------------------------------------------------------------- 128 bits as two halves (lo , hi)
DQ : Type
DQ = UInt64 × UInt64
dq0 : DQ
dq0 = (uq0 , uq0)
dq1 : DQ
dq1 = (uq1 , uq0)
dq-eq : DQ → DQ → Bool
dq-eq a b = m-and (u64eq (fst a) (fst b)) (u64eq (snd a) (snd b))
dq-iszero : DQ → Bool
dq-iszero a = m-and (uq-iszero (fst a)) (uq-iszero (snd a))
dq-ult : DQ → DQ → Bool
dq-ult a b = case u64eq (snd a) (snd b) of
  true → u64lt (fst a) (fst b)
  false → u64lt (snd a) (snd b)
dq-slt : DQ → DQ → Bool
dq-slt a b = case u64eq (snd a) (snd b) of
  true → u64lt (fst a) (fst b)
  false → uq-slt (snd a) (snd b)
dq-isneg : DQ → Bool
dq-isneg a = uq-isneg (snd a)
dq-add : DQ → DQ → DQ
dq-add a b =
  let lo = u64add (fst a) (fst b)
  in (lo , u64add (u64add (snd a) (snd b)) (uq-b (u64lt lo (fst a))))
dq-not : DQ → DQ
dq-not a = (uq-not (fst a) , uq-not (snd a))
dq-neg : DQ → DQ
dq-neg a = dq-add (dq-not a) dq1
dq-sub : DQ → DQ → DQ
dq-sub a b = dq-add a (dq-neg b)
dq-and : DQ → DQ → DQ
dq-and a b = (u64and (fst a) (fst b) , u64and (snd a) (snd b))
dq-or : DQ → DQ → DQ
dq-or a b = (u64or (fst a) (fst b) , u64or (snd a) (snd b))
dq-xor : DQ → DQ → DQ
dq-xor a b = (u64xor (fst a) (fst b) , u64xor (snd a) (snd b))
-- a 64-bit value extended to 128: by zeros, or by its sign
dq-zx : UInt64 → DQ
dq-zx x = (x , uq0)
dq-sx : UInt64 → DQ
dq-sx x = (x , (case uq-isneg x of
  true → uq-ones
  false → uq0))
-- the full product of two 64-bit values, by 32-bit halves
uq-mulw : UInt64 → UInt64 → DQ
uq-mulw a b =
  let m32 = u64 #4294967295
      s32 = u64 #32
      a0 = u64and a m32
      a1 = u64shr a s32
      b0 = u64and b m32
      b1 = u64shr b s32
      p00 = u64mul a0 b0
      p01 = u64mul a0 b1
      p10 = u64mul a1 b0
      p11 = u64mul a1 b1
      mid = u64add (u64add (u64shr p00 s32) (u64and p01 m32)) (u64and p10 m32)
  in (u64or (u64and p00 m32) (u64shl mid s32)
     , u64add (u64add p11 (u64shr p01 s32)) (u64add (u64shr p10 s32) (u64shr mid s32)))
-- the product modulo 2^128
dq-mul : DQ → DQ → DQ
dq-mul a b =
  let p = uq-mulw (fst a) (fst b)
  in (fst p , u64add (snd p) (u64add (u64mul (fst a) (snd b)) (u64mul (snd a) (fst b))))
-- shifts by a count below 128 (the 64-bit shifts take their count modulo 64, so the cases are split here)
dq-shl : DQ → UInt64 → DQ
dq-shl a n = case uq-iszero n of
  true → a
  false → (case u64lt n (u64 #64) of
    true → (u64shl (fst a) n , u64or (u64shl (snd a) n) (u64shr (fst a) (u64sub (u64 #64) n)))
    false → (uq0 , u64shl (fst a) (u64sub n (u64 #64))))
dq-shr : DQ → UInt64 → DQ
dq-shr a n = case uq-iszero n of
  true → a
  false → (case u64lt n (u64 #64) of
    true → (u64or (u64shr (fst a) n) (u64shl (snd a) (u64sub (u64 #64) n)) , u64shr (snd a) n)
    false → (u64shr (snd a) (u64sub n (u64 #64)) , uq0))
dq-sar : DQ → UInt64 → DQ
dq-sar a n = case uq-iszero n of
  true → a
  false → (case u64lt n (u64 #64) of
    true → (u64or (u64shr (fst a) n) (u64shl (snd a) (u64sub (u64 #64) n)) , uq-sar (snd a) n)
    false → (uq-sar (snd a) (u64sub n (u64 #64)) , snd (dq-sx (snd a))))
-- unsigned division with remainder, divisor not zero: one bit of the quotient per step from the
-- top (the remainder's bit shifted out is a carry: the subtraction is then exact modulo 2^128)
dq-div-go : Nat → DQ → DQ → DQ → DQ → DQ × DQ
dq-div-go zero a b q r = (q , r)
dq-div-go (suc k) a b q r =
  let carry = dq-isneg r
      r2 = dq-or (dq-shl r uq1) (dq-shr a (u64 #127))
      q2 = dq-shl q uq1
      a2 = dq-shl a uq1
  in case m-or carry (not (dq-ult r2 b)) of
       true → dq-div-go k a2 b (dq-or q2 dq1) (dq-sub r2 b)
       false → dq-div-go k a2 b q2 r2
dq-udivmod : DQ → DQ → DQ × DQ
dq-udivmod a b = case m-and (uq-iszero (snd a)) (uq-iszero (snd b)) of
  true → ((u64div (fst a) (fst b) , uq0) , (u64mod (fst a) (fst b) , uq0))
  false → dq-div-go 128 a b dq0 dq0
dq-abs : DQ → DQ
dq-abs a = case dq-isneg a of
  true → dq-neg a
  false → a
-- signed division truncating toward zero, and its remainder (the dividend's sign)
dq-sdiv : DQ → DQ → DQ
dq-sdiv a b =
  let q = fst (dq-udivmod (dq-abs a) (dq-abs b))
  in case dq-isneg a of
       true → (case dq-isneg b of
         true → q
         false → dq-neg q)
       false → (case dq-isneg b of
         true → dq-neg q
         false → q)
dq-srem : DQ → DQ → DQ
dq-srem a b =
  let r = snd (dq-udivmod (dq-abs a) (dq-abs b))
  in case dq-isneg a of
       true → dq-neg r
       false → r
dq-min : DQ
dq-min = (uq0 , uq-top)

-- ---------------------------------------------------------------- reading a value at its kind
-- a value whose constructor is not its kind's is a reader's error: the meaning stops
sv-as-i : SV → MRes UInt64
sv-as-i v = case v of
  sv-i x → mok x
  _ → mstop st-ill-typed
sv-as-w : SV → MRes DQ
sv-as-w v = case v of
  sv-w lo hi → mok (lo , hi)
  _ → mstop st-ill-typed
sv-as-b : SV → MRes Bool
sv-as-b v = case v of
  sv-b b → mok b
  _ → mstop st-ill-typed
sv-as-f : SV → MRes Float32
sv-as-f v = case v of
  sv-f x → mok x
  _ → mstop st-ill-typed
sv-as-d : SV → MRes Float64
sv-as-d v = case v of
  sv-d x → mok x
  _ → mstop st-ill-typed
sv-as-p : SV → MRes MPtr
sv-as-p v = case v of
  sv-p p → mok p
  _ → mstop st-ill-typed
sv-of-dq : DQ → SV
sv-of-dq a = sv-w (fst a) (snd a)
-- an integer value as 128 bits (extended by its kind's sign), and 128 bits wrapped to a kind:
-- the low bits kept, in canonical form. Every integer conversion is the second after the first
-- (modulo 2^N for an unsigned target; for a signed one the same, C++20's two's complement)
sv-int-dq : Bool → IW → SV → MRes DQ
sv-int-dq sg w v = case w of
  iw128 → sv-as-w v
  _ → mr-map (λ x → case sg of
                 true → dq-sx x
                 false → dq-zx x) (sv-as-i v)
dq-to-int : Bool → IW → DQ → SV
dq-to-int sg w a = case w of
  iw128 → sv-of-dq a
  _ → sv-i (uq-cn sg w (fst a))
sv-bool : Bool → MRes SV
sv-bool b = mok (sv-b b)

-- ---------------------------------------------------------------- integer arithmetic at 64 bits and below
-- operands and results in canonical form; signed overflow, division by zero and MIN / -1 undefined
uq-sdiv : UInt64 → UInt64 → UInt64
uq-sdiv a b = u64 (i64toWord (i64div (i64 (u64toWord a)) (i64 (u64toWord b))))
uq-srem : UInt64 → UInt64 → UInt64
uq-srem a b = u64 (i64toWord (i64mod (i64 (u64toWord a)) (i64 (u64toWord b))))
-- a signed result computed in 64 bits is in range of a narrower width when extending it changes nothing
ni-fit : IW → UInt64 → MRes UInt64
ni-fit w r = case u64eq (uq-sx w r) r of
  true → mok r
  false → mub ub-signed-overflow
ni-min : IW → UInt64
ni-min w = uq-neg (iw-sign w)
ni-add : Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-add sg w a b =
  let r = u64add a b
  in case sg of
       false → mok (uq-zx w r)
       true → (case w of
         iw64 → (case uq-isneg (u64and (u64xor a r) (u64xor b r)) of
           true → mub ub-signed-overflow
           false → mok r)
         _ → ni-fit w r)
ni-sub : Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-sub sg w a b =
  let r = u64sub a b
  in case sg of
       false → mok (uq-zx w r)
       true → (case w of
         iw64 → (case uq-isneg (u64and (u64xor a b) (u64xor a r)) of
           true → mub ub-signed-overflow
           false → mok r)
         _ → ni-fit w r)
ni-mul : Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-mul sg w a b =
  let r = u64mul a b
  in case sg of
       false → mok (uq-zx w r)
       true → (case w of
         iw64 → (let p = dq-mul (dq-sx a) (dq-sx b)
                 in case u64eq (snd p) (snd (dq-sx (fst p))) of
                      true → mok r
                      false → mub ub-signed-overflow)
         _ → ni-fit w r)
ni-div : Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-div sg w a b = case uq-iszero b of
  true → mub ub-div-zero
  false → (case sg of
    false → mok (u64div a b)
    true → (case m-and (u64eq a (ni-min w)) (u64eq b uq-ones) of
      true → mub ub-div-overflow
      false → mok (uq-sdiv a b)))
ni-rem : Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-rem sg w a b = case uq-iszero b of
  true → mub ub-div-zero
  false → (case sg of
    false → mok (u64mod a b)
    true → (case m-and (u64eq a (ni-min w)) (u64eq b uq-ones) of
      true → mub ub-div-overflow
      false → mok (uq-srem a b)))

-- ---------------------------------------------------------------- integer arithmetic at 128 bits
wi-add : Bool → DQ → DQ → MRes DQ
wi-add sg a b =
  let r = dq-add a b
  in case sg of
       false → mok r
       true → (case uq-isneg (u64and (u64xor (snd a) (snd r)) (u64xor (snd b) (snd r))) of
         true → mub ub-signed-overflow
         false → mok r)
wi-sub : Bool → DQ → DQ → MRes DQ
wi-sub sg a b =
  let r = dq-sub a b
  in case sg of
       false → mok r
       true → (case uq-isneg (u64and (u64xor (snd a) (snd b)) (u64xor (snd a) (snd r))) of
         true → mub ub-signed-overflow
         false → mok r)
-- a signed product overflows exactly when dividing the wrapped product by a (not zero) does not
-- give b back, or a is -1 and b the minimum (whose wrapped quotient is b again)
wi-mul : Bool → DQ → DQ → MRes DQ
wi-mul sg a b =
  let r = dq-mul a b
  in case sg of
       false → mok r
       true → (case dq-iszero a of
         true → mok r
         false → (case m-and (dq-eq a (uq-ones , uq-ones)) (dq-eq b dq-min) of
           true → mub ub-signed-overflow
           false → (case dq-eq (dq-sdiv r a) b of
             true → mok r
             false → mub ub-signed-overflow)))
wi-div : Bool → DQ → DQ → MRes DQ
wi-div sg a b = case dq-iszero b of
  true → mub ub-div-zero
  false → (case sg of
    false → mok (fst (dq-udivmod a b))
    true → (case m-and (dq-eq a dq-min) (dq-eq b (uq-ones , uq-ones)) of
      true → mub ub-div-overflow
      false → mok (dq-sdiv a b)))
wi-rem : Bool → DQ → DQ → MRes DQ
wi-rem sg a b = case dq-iszero b of
  true → mub ub-div-zero
  false → (case sg of
    false → mok (snd (dq-udivmod a b))
    true → (case m-and (dq-eq a dq-min) (dq-eq b (uq-ones , uq-ones)) of
      true → mub ub-div-overflow
      false → mok (dq-srem a b)))

-- ---------------------------------------------------------------- the binary operations on integers
data BinOp = ao-add | ao-sub | ao-mul | ao-div | ao-rem | ao-and | ao-or | ao-xor
ni-op : BinOp → Bool → IW → UInt64 → UInt64 → MRes UInt64
ni-op o sg w a b = case o of
  ao-add → ni-add sg w a b
  ao-sub → ni-sub sg w a b
  ao-mul → ni-mul sg w a b
  ao-div → ni-div sg w a b
  ao-rem → ni-rem sg w a b
  ao-and → mok (u64and a b)
  ao-or → mok (u64or a b)
  ao-xor → mok (u64xor a b)
wi-op : BinOp → Bool → DQ → DQ → MRes DQ
wi-op o sg a b = case o of
  ao-add → wi-add sg a b
  ao-sub → wi-sub sg a b
  ao-mul → wi-mul sg a b
  ao-div → wi-div sg a b
  ao-rem → wi-rem sg a b
  ao-and → mok (dq-and a b)
  ao-or → mok (dq-or a b)
  ao-xor → mok (dq-xor a b)
int-op : BinOp → Bool → IW → SV → SV → MRes SV
int-op o sg w a b = case w of
  iw128 → mr-bind (sv-as-w a) (λ x → mr-bind (sv-as-w b) (λ y → mr-map sv-of-dq (wi-op o sg x y)))
  _ → mr-bind (sv-as-i a) (λ x → mr-bind (sv-as-i b) (λ y → mr-map sv-i (ni-op o sg w x y)))
-- negation (0 - a: the minimum of a signed kind overflows) and the complement
int-neg : Bool → IW → SV → MRes SV
int-neg sg w a = case w of
  iw128 → mr-bind (sv-as-w a) (λ x → mr-map sv-of-dq (wi-sub sg dq0 x))
  _ → mr-bind (sv-as-i a) (λ x → mr-map sv-i (ni-sub sg w uq0 x))
int-not : Bool → IW → SV → MRes SV
int-not sg w a = case w of
  iw128 → mr-map (λ x → sv-of-dq (dq-not x)) (sv-as-w a)
  _ → mr-map (λ x → sv-i (uq-cn sg w (uq-not x))) (sv-as-i a)

-- ---------------------------------------------------------------- shifts
-- the count, an integer of its own kind, must be at least 0 and below the width of the shifted
-- kind: anything else is undefined. A left shift is modular (C++20, Rust's wrapping shift); a
-- right shift of a signed kind fills with the sign. shift-count gives the count checked.
shift-count : IW → Bool → IW → SV → MRes UInt64
shift-count w sgc wc c = mr-bind (sv-int-dq sgc wc c) (λ n →
  case m-and (uq-iszero (snd n)) (u64lt (fst n) (iw-bits w)) of
    true → mok (fst n)
    false → mub ub-shift-count)
int-shl : Bool → IW → Bool → IW → SV → SV → MRes SV
int-shl sg w sgc wc a c = mr-bind (shift-count w sgc wc c) (λ n → case w of
  iw128 → mr-map (λ x → sv-of-dq (dq-shl x n)) (sv-as-w a)
  _ → mr-map (λ x → sv-i (uq-cn sg w (u64shl x n))) (sv-as-i a))
int-shr : Bool → IW → Bool → IW → SV → SV → MRes SV
int-shr sg w sgc wc a c = mr-bind (shift-count w sgc wc c) (λ n → case w of
  iw128 → mr-map (λ x → sv-of-dq (case sg of
                                    true → dq-sar x n
                                    false → dq-shr x n)) (sv-as-w a)
  _ → mr-map (λ x → sv-i (case sg of
                            true → uq-sar x n
                            false → u64shr x n)) (sv-as-i a))
-- C's left shift (C17 6.5.7): of a signed kind, a negative operand is undefined, and so is a
-- result the kind cannot represent (the shift back must give the operand, and no sign appear)
int-shl-c : Bool → IW → Bool → IW → SV → SV → MRes SV
int-shl-c sg w sgc wc a c = case sg of
  false → int-shl sg w sgc wc a c
  true → mr-bind (shift-count w sgc wc c) (λ n → case w of
    iw128 → mr-bind (sv-as-w a) (λ x → case dq-isneg x of
      true → mub ub-shift-negative
      false → (let r = dq-shl x n
               in case m-and (not (dq-isneg r)) (dq-eq (dq-shr r n) x) of
                    true → mok (sv-of-dq r)
                    false → mub ub-signed-overflow))
    _ → mr-bind (sv-as-i a) (λ x → case uq-isneg x of
      true → mub ub-shift-negative
      false → (let r = uq-sx w (u64shl x n)
               in case m-and (not (uq-isneg r)) (u64eq (u64shr r n) x) of
                    true → mok (sv-i r)
                    false → mub ub-signed-overflow)))

-- ---------------------------------------------------------------- comparisons of integers
data CmpOp = co-eq | co-ne | co-lt | co-le | co-gt | co-ge
-- a comparison from the two tests every ordered kind has
cmp-by : CmpOp → Bool → Bool → Bool → Bool
cmp-by o eq lt gt = case o of
  co-eq → eq
  co-ne → not eq
  co-lt → lt
  co-le → m-or lt eq
  co-gt → gt
  co-ge → m-or gt eq
int-cmp : CmpOp → Bool → IW → SV → SV → MRes Bool
int-cmp o sg w a b = case w of
  iw128 → mr-bind (sv-as-w a) (λ x → mr-bind (sv-as-w b) (λ y → mok (case sg of
    true → cmp-by o (dq-eq x y) (dq-slt x y) (dq-slt y x)
    false → cmp-by o (dq-eq x y) (dq-ult x y) (dq-ult y x))))
  _ → mr-bind (sv-as-i a) (λ x → mr-bind (sv-as-i b) (λ y → mok (case sg of
    true → cmp-by o (u64eq x y) (uq-slt x y) (uq-slt y x)
    false → cmp-by o (u64eq x y) (u64lt x y) (u64lt y x))))

-- ---------------------------------------------------------------- floats: bits
-- The primitives give Float64 arithmetic and comparison, Float64 ↔ Int64, and the bits of both
-- formats; there is no Float32 arithmetic and no conversion between the formats. Both are
-- written here on the bits: fp-pack rounds an integer magnitude times a power of two to the
-- nearest value of a format (ties to even), which is every conversion into a format; binary32
-- arithmetic is then binary64's on the widened operands, narrowed (one rounding of the exact
-- result, since 53 ≥ 2·24 + 2).
uq-bl-step : UInt64 → DQ → DQ
uq-bl-step k s = case uq-iszero (u64shr (fst s) k) of
  true → s
  false → (u64shr (fst s) k , u64add (snd s) k)
-- the number of significant bits (0 for 0)
uq-bitlen : UInt64 → UInt64
uq-bitlen x =
  let s = uq-bl-step uq1 (uq-bl-step (u64 #2) (uq-bl-step (u64 #4) (uq-bl-step (u64 #8) (uq-bl-step (u64 #16) (uq-bl-step (u64 #32) (x , uq0))))))
  in u64add (snd s) (fst s)
dq-bitlen : DQ → UInt64
dq-bitlen a = case uq-iszero (snd a) of
  true → uq-bitlen (fst a)
  false → u64add (u64 #64) (uq-bitlen (snd a))
-- a format: its precision p, the exponent of its smallest subnormal's unit (emin - (p - 1), kept
-- negated), the all-ones exponent field, and the sign's position
data FF = ff32 | ff64
ff-p1 : FF → UInt64
ff-p1 f = case f of
  ff32 → u64 #23
  ff64 → u64 #52
ff-nqmin : FF → UInt64
ff-nqmin f = case f of
  ff32 → u64 #149
  ff64 → u64 #1074
ff-emax : FF → UInt64
ff-emax f = case f of
  ff32 → u64 #255
  ff64 → u64 #2047
ff-sign : FF → UInt64
ff-sign f = case f of
  ff32 → u64 #2147483648
  ff64 → uq-top
uq-smax : UInt64 → UInt64 → UInt64
uq-smax a b = case uq-slt a b of
  true → b
  false → a
-- M · 2^-sh (sh at least 1) rounded to the nearest integer, ties to even
dq-round-shr : DQ → UInt64 → UInt64
dq-round-shr m sh = case u64lt (u64 #127) sh of
  true → uq-b (m-and (u64eq sh (u64 #128)) (dq-ult dq-min m))
  false →
    (let r0 = dq-shr m sh
         rest = dq-sub m (dq-shl r0 sh)
         half = dq-shl dq1 (u64sub sh uq1)
     in case m-or (dq-ult half rest) (m-and (dq-eq half rest) (u64eq (u64and (fst r0) uq1) uq1)) of
          true → u64add (fst r0) uq1
          false → fst r0)
-- the bits of the format's value nearest to (-1)^sign · m · 2^e (e a two's-complement exponent);
-- beyond the largest finite value, the infinity. With x the exponent of m's top bit, the unit of
-- the result is q = max (x - (p - 1)) qmin; the integer r = m · 2^(e - q) rounded has at most
-- p + 1 bits, and the bits are ((q - qmin) << (p - 1)) + r: r's top bit is the exponent field's
-- unit (a subnormal has none, a carry out of the rounding raises the exponent)
fp-pack : FF → Bool → DQ → UInt64 → UInt64
fp-pack f sign m e =
  let sbit = (case sign of
        true → ff-sign f
        false → uq0)
  in case dq-iszero m of
       true → sbit
       false →
         (let x = u64add (u64sub (dq-bitlen m) uq1) e
              q = uq-smax (u64sub x (ff-p1 f)) (uq-neg (ff-nqmin f))
              sh = u64sub q e
              r = (case uq-slt uq0 sh of
                     true → dq-round-shr m sh
                     false → fst (dq-shl m (uq-neg sh)))
              ef = u64add q (ff-nqmin f)
          in case u64lt ef (ff-emax f) of
               false → u64or sbit (u64shl (ff-emax f) (ff-p1 f))
               true → (let b = u64add (u64shl ef (ff-p1 f)) r
                       in case u64lt (u64shr b (ff-p1 f)) (ff-emax f) of
                            true → u64or sbit b
                            false → u64or sbit (u64shl (ff-emax f) (ff-p1 f))))
f64-bits : Float64 → UInt64
f64-bits x = u64 (i64toWord (f64bits x))
f64-of-bits : UInt64 → Float64
f64-of-bits b = f64ofbits (i64 (u64toWord b))
f32-bits : Float32 → UInt64
f32-bits x = u64 (u32toWord (f32bits x))
f32-of-bits : UInt64 → Float32
f32-of-bits b = f32ofbits (u32 (u64toWord b))
-- a format's bits taken apart: the sign, the exponent field, the fraction field
ff-neg : FF → UInt64 → Bool
ff-neg f b = not (uq-iszero (u64and b (ff-sign f)))
ff-exp : FF → UInt64 → UInt64
ff-exp f b = u64and (u64shr b (ff-p1 f)) (ff-emax f)
ff-frac : FF → UInt64 → UInt64
ff-frac f b = u64and b (u64sub (u64shl uq1 (ff-p1 f)) uq1)
-- a finite value's magnitude as an integer and its exponent: m · 2^e
ff-mant : FF → UInt64 → UInt64
ff-mant f b = case uq-iszero (ff-exp f b) of
  true → ff-frac f b
  false → u64or (ff-frac f b) (u64shl uq1 (ff-p1 f))
ff-e : FF → UInt64 → UInt64
ff-e f b = u64sub (uq-smax (ff-exp f b) uq1) (u64add (ff-nqmin f) uq1)
-- binary32 to binary64, exact; an infinity or a NaN keeps its sign and its payload's top bits
f32-widen : Float32 → Float64
f32-widen x =
  let b = f32-bits x
  in f64-of-bits (case u64eq (ff-exp ff32 b) (ff-emax ff32) of
       true → u64or (u64shl (u64shr b (u64 #31)) (u64 #63))
                (u64or (u64shl (ff-emax ff64) (u64 #52)) (u64shl (ff-frac ff32 b) (u64 #29)))
       false → fp-pack ff64 (ff-neg ff32 b) (dq-zx (ff-mant ff32 b)) (ff-e ff32 b))
-- binary64 to binary32, rounded to nearest (ties to even); a NaN becomes quiet with its payload's top bits
f64-narrow : Float64 → Float32
f64-narrow x =
  let b = f64-bits x
      s = u64shl (u64shr b (u64 #63)) (u64 #31)
  in f32-of-bits (case u64eq (ff-exp ff64 b) (ff-emax ff64) of
       true → (case uq-iszero (ff-frac ff64 b) of
         true → u64or s (u64 #2139095040)
         false → u64or s (u64or (u64 #2143289344) (u64shr (ff-frac ff64 b) (u64 #29))))
       false → fp-pack ff32 (ff-neg ff64 b) (dq-zx (ff-mant ff64 b)) (ff-e ff64 b))

-- ---------------------------------------------------------------- float arithmetic and comparison
-- IEEE 754 (IEC 60559): no operation is undefined; a division by zero is an infinity or a NaN
f64-op : BinOp → Float64 → Float64 → MRes Float64
f64-op o a b = case o of
  ao-add → mok (f64add a b)
  ao-sub → mok (f64sub a b)
  ao-mul → mok (f64mul a b)
  ao-div → mok (f64div a b)
  _ → mstop st-ill-typed
f32-op : BinOp → Float32 → Float32 → MRes Float32
f32-op o a b = mr-map f64-narrow (f64-op o (f32-widen a) (f32-widen b))
-- negation is the sign bit (0 - x is wrong at +0)
f64-neg : Float64 → Float64
f64-neg x = f64-of-bits (u64xor (f64-bits x) uq-top)
f32-neg : Float32 → Float32
f32-neg x = f32-of-bits (u64xor (f32-bits x) (ff-sign ff32))
f64-cmp : CmpOp → Float64 → Float64 → Bool
f64-cmp o a b = cmp-by o (f64eq a b) (f64lt a b) (f64lt b a)
f64-zero : Float64
f64-zero = f64 #0

-- ---------------------------------------------------------------- integer → float
-- to binary64: the primitive's conversion at 64 bits and below (one rounding), fp-pack at 128;
-- to binary32: through binary64 at 32 bits and below (exact, then one rounding), fp-pack above
-- (through binary64 would round twice)
dq-mag : Bool → DQ → DQ
dq-mag sg a = case sg of
  true → dq-abs a
  false → a
int-to-f64 : Bool → IW → SV → MRes Float64
int-to-f64 sg w v = case w of
  iw128 → mr-map (λ a → f64-of-bits (fp-pack ff64 (m-and sg (dq-isneg a)) (dq-mag sg a) uq0)) (sv-as-w v)
  _ → mr-map (λ x → case sg of
                 true → f64ofi64 (i64 (u64toWord x))
                 false → f64 (u64toWord x)) (sv-as-i v)
int-to-f32 : Bool → IW → SV → MRes Float32
int-to-f32 sg w v = case w of
  iw128 → mr-map (λ a → f32-of-bits (fp-pack ff32 (m-and sg (dq-isneg a)) (dq-mag sg a) uq0)) (sv-as-w v)
  iw64 → mr-map (λ x → f32-of-bits (fp-pack ff32 (m-and sg (uq-isneg x))
                                      (case m-and sg (uq-isneg x) of
                                         true → (uq-neg x , uq0)
                                         false → (x , uq0)) uq0)) (sv-as-i v)
  _ → mr-map f64-narrow (int-to-f64 sg w v)

-- ---------------------------------------------------------------- float → integer
-- the value truncated toward zero; undefined when the truncated value is not the kind's (a NaN
-- and the infinities included). At 64 bits and below: the range decided on the Float64 (every
-- bound is exact), then the primitive's truncation; at 128: the bits shifted.
f64-neg-of : Word → Float64
f64-neg-of w = f64sub f64-zero (f64 w)
fi-lo-ok : Bool → IW → Float64 → Bool
fi-lo-ok sg w x = case sg of
  false → f64lt (f64-neg-of #1) x
  true → (case w of
    iw8 → f64lt (f64-neg-of #129) x
    iw16 → f64lt (f64-neg-of #32769) x
    iw32 → f64lt (f64-neg-of #2147483649) x
    _ → m-or (f64lt (f64-neg-of #9223372036854775808) x) (f64eq (f64-neg-of #9223372036854775808) x))
fi-hi : Bool → IW → Float64
fi-hi sg w = case sg of
  true → (case w of
    iw8 → f64 #128
    iw16 → f64 #32768
    iw32 → f64 #2147483648
    _ → f64 #9223372036854775808)
  false → (case w of
    iw8 → f64 #256
    iw16 → f64 #65536
    iw32 → f64 #4294967296
    _ → f64mul (f64 #4294967296) (f64 #4294967296))
f64-trunc-uq : Float64 → UInt64
f64-trunc-uq x = u64 (i64toWord (i64off64 x))
-- the truncated magnitude t with the sign: in range of the 128-bit kind or undefined
dq-signed-in : Bool → Bool → DQ → MRes DQ
dq-signed-in sg neg t = case neg of
  true → (case sg of
    true → (case dq-ult dq-min t of
      true → mub ub-float-int-range
      false → mok (dq-neg t))
    false → (case dq-iszero t of
      true → mok dq0
      false → mub ub-float-int-range))
  false → (case m-and sg (not (dq-ult t dq-min)) of
    true → mub ub-float-int-range
    false → mok t)
-- m · 2^e truncated: shifted right when e is negative (to 0 at 64 or more), left otherwise
-- (m has at most 53 bits: beyond 75 the value is 2^128 or more)
f64-mag-trunc : UInt64 → UInt64 → MRes DQ
f64-mag-trunc m e = case uq-slt e uq0 of
  true → (case u64lt (uq-neg e) (u64 #64) of
    true → mok (u64shr m (uq-neg e) , uq0)
    false → mok dq0)
  false → (case u64lt (u64 #75) e of
    true → mub ub-float-int-range
    false → mok (dq-shl (m , uq0) e))
f64-to-dq : Bool → Float64 → MRes DQ
f64-to-dq sg x =
  let b = f64-bits x
  in case u64eq (ff-exp ff64 b) (ff-emax ff64) of
       true → mub ub-float-int-range
       false → mr-bind (f64-mag-trunc (ff-mant ff64 b) (ff-e ff64 b)) (dq-signed-in sg (ff-neg ff64 b))
f64-to-int : Bool → IW → Float64 → MRes SV
f64-to-int sg w x = case w of
  iw128 → mr-map sv-of-dq (f64-to-dq sg x)
  _ → (case m-and (fi-lo-ok sg w x) (f64lt x (fi-hi sg w)) of
    false → mub ub-float-int-range
    true → mok (sv-i (case m-and (not sg) (not (f64lt x (f64 #9223372036854775808))) of
      true → u64add (f64-trunc-uq (f64sub x (f64 #9223372036854775808))) uq-top
      false → f64-trunc-uq x)))

-- ---------------------------------------------------------------- pointers
mp-eq : MPtr → MPtr → Bool
mp-eq p q = case p of
  mp-null → (case q of
    mp-null → true
    _ → false)
  mp-obj a o → (case q of
    mp-obj b o2 → m-and (weq a b) (weq o o2)
    _ → false)
  mp-fn f → (case q of
    mp-fn g → weq f g
    _ → false)
  mp-addr x → (case q of
    mp-addr y → weq x y
    _ → false)
-- equality is decided for every pair (pointers into different allocations are different: a
-- pointer one past the end of one allocation is not the start of another here). An order is
-- given between equal pointers and between places of one allocation, by offset; any other is
-- unspecified (lib/mem/memory.cub's order by address answers it under a flat address space)
ptr-cmp : CmpOp → MPtr → MPtr → MRes Bool
ptr-cmp o p q = case o of
  co-eq → mok (mp-eq p q)
  co-ne → mok (not (mp-eq p q))
  _ → (case mp-eq p q of
    true → mok (cmp-by o true false false)
    false → (case p of
      mp-obj a x → (case q of
        mp-obj b y → (case weq a b of
          true → mok (cmp-by o false (wlt x y) (wlt y x))
          false → mstop st-unspecified)
        _ → mstop st-unspecified)
      _ → mstop st-unspecified))

-- ---------------------------------------------------------------- the operations by kind
-- conversion between every pair of kinds. Pointer ↔ integer needs the memory (an allocation's
-- address) and the Target's choice: it is lib/mem/memory.cub's, and stops here
sv-conv : SK → SK → SV → MRes SV
sv-conv from to v = case from of
  sk-int s1 w1 → (case to of
    sk-int s2 w2 → mr-map (dq-to-int s2 w2) (sv-int-dq s1 w1 v)
    sk-bool → mr-map (λ a → sv-b (not (dq-iszero a))) (sv-int-dq s1 w1 v)
    sk-f32 → mr-map sv-f (int-to-f32 s1 w1 v)
    sk-f64 → mr-map sv-d (int-to-f64 s1 w1 v)
    sk-ptr → mstop st-ill-typed)
  sk-bool → (case to of
    sk-int s2 w2 → mr-map (λ b → dq-to-int s2 w2 (uq-b b , uq0)) (sv-as-b v)
    sk-bool → mr-map sv-b (sv-as-b v)
    sk-f32 → mr-map (λ b → sv-f (f64-narrow (f64 (u64toWord (uq-b b))))) (sv-as-b v)
    sk-f64 → mr-map (λ b → sv-d (f64 (u64toWord (uq-b b)))) (sv-as-b v)
    sk-ptr → mstop st-ill-typed)
  sk-f32 → (case to of
    sk-int s2 w2 → mr-bind (sv-as-f v) (λ x → f64-to-int s2 w2 (f32-widen x))
    sk-bool → mr-map (λ x → sv-b (not (f64eq (f32-widen x) f64-zero))) (sv-as-f v)
    sk-f32 → mr-map sv-f (sv-as-f v)
    sk-f64 → mr-map (λ x → sv-d (f32-widen x)) (sv-as-f v)
    sk-ptr → mstop st-ill-typed)
  sk-f64 → (case to of
    sk-int s2 w2 → mr-bind (sv-as-d v) (λ x → f64-to-int s2 w2 x)
    sk-bool → mr-map (λ x → sv-b (not (f64eq x f64-zero))) (sv-as-d v)
    sk-f32 → mr-map (λ x → sv-f (f64-narrow x)) (sv-as-d v)
    sk-f64 → mr-map sv-d (sv-as-d v)
    sk-ptr → mstop st-ill-typed)
  sk-ptr → (case to of
    sk-bool → mr-map (λ p → sv-b (not (mp-eq p mp-null))) (sv-as-p v)
    sk-ptr → mr-map sv-p (sv-as-p v)
    _ → mstop st-ill-typed)
-- a value as a condition (the conversion to bool, read)
sv-truthy : SK → SV → MRes Bool
sv-truthy k v = mr-bind (sv-conv k sk-bool v) sv-as-b
-- + - * / % & | ^ at a kind (both operands of it: the reader has applied its language's
-- conversions). Pointer arithmetic is the memory's
sv-arith : BinOp → SK → SV → SV → MRes SV
sv-arith o k a b = case k of
  sk-int sg w → int-op o sg w a b
  sk-f32 → mr-bind (sv-as-f a) (λ x → mr-bind (sv-as-f b) (λ y → mr-map sv-f (f32-op o x y)))
  sk-f64 → mr-bind (sv-as-d a) (λ x → mr-bind (sv-as-d b) (λ y → mr-map sv-d (f64-op o x y)))
  _ → mstop st-ill-typed
sv-neg : SK → SV → MRes SV
sv-neg k a = case k of
  sk-int sg w → int-neg sg w a
  sk-f32 → mr-map (λ x → sv-f (f32-neg x)) (sv-as-f a)
  sk-f64 → mr-map (λ x → sv-d (f64-neg x)) (sv-as-d a)
  _ → mstop st-ill-typed
sv-not : SK → SV → MRes SV
sv-not k a = case k of
  sk-int sg w → int-not sg w a
  sk-bool → mr-map (λ b → sv-b (not b)) (sv-as-b a)
  _ → mstop st-ill-typed
-- shifts: the shifted kind, the count's kind
sv-shl : SK → SK → SV → SV → MRes SV
sv-shl k kc a c = case k of
  sk-int sg w → (case kc of
    sk-int sgc wc → int-shl sg w sgc wc a c
    _ → mstop st-ill-typed)
  _ → mstop st-ill-typed
sv-shl-c : SK → SK → SV → SV → MRes SV
sv-shl-c k kc a c = case k of
  sk-int sg w → (case kc of
    sk-int sgc wc → int-shl-c sg w sgc wc a c
    _ → mstop st-ill-typed)
  _ → mstop st-ill-typed
sv-shr : SK → SK → SV → SV → MRes SV
sv-shr k kc a c = case k of
  sk-int sg w → (case kc of
    sk-int sgc wc → int-shr sg w sgc wc a c
    _ → mstop st-ill-typed)
  _ → mstop st-ill-typed
sv-cmp : CmpOp → SK → SV → SV → MRes Bool
sv-cmp o k a b = case k of
  sk-int sg w → int-cmp o sg w a b
  sk-bool → mr-bind (sv-as-b a) (λ x → mr-bind (sv-as-b b) (λ y →
    mok (cmp-by o (u64eq (uq-b x) (uq-b y)) (u64lt (uq-b x) (uq-b y)) (u64lt (uq-b y) (uq-b x)))))
  sk-f32 → mr-bind (sv-as-f a) (λ x → mr-bind (sv-as-f b) (λ y → mok (f64-cmp o (f32-widen x) (f32-widen y))))
  sk-f64 → mr-bind (sv-as-d a) (λ x → mr-bind (sv-as-d b) (λ y → mok (f64-cmp o x y)))
  sk-ptr → mr-bind (sv-as-p a) (λ x → mr-bind (sv-as-p b) (λ y → ptr-cmp o x y))

-- ---------------------------------------------------------------- kinds in memory, by Target
-- the size of a kind's representation, and the alignment its accesses need when the type
-- naming it says nothing else (a C type's alignment is ct-align below: two types of one kind
-- may differ, as long long and double do from their sizes on i386)
sk-size : Target → SK → Word
sk-size t k = case k of
  sk-int sg w → iw-bytes w
  sk-bool → tg-size t ck-bool
  sk-f32 → #4
  sk-f64 → #8
  sk-ptr → tg-size t ck-ptr
sk-align : Target → SK → Word
sk-align t k = case k of
  sk-int sg w → (case w of
    iw8 → tg-align t ck-char
    iw16 → tg-align t ck-short
    iw32 → tg-align t ck-int
    iw64 → tg-align t ck-llong
    iw128 → tg-align t ck-int128)
  sk-bool → tg-align t ck-bool
  sk-f32 → tg-align t ck-float
  sk-f64 → tg-align t ck-double
  sk-ptr → tg-align t ck-ptr

-- ---------------------------------------------------------------- the C family's arithmetic types
-- C and C++ name scalar types whose kind is the implementation's: a type's kind, size and
-- alignment are functions of the Target, and so are the integer promotions and the usual
-- arithmetic conversions (C17 6.3.1.1, 6.3.1.8; C++20 [conv.prom], [expr.arith.conv]).
-- (char8_t, char16_t, char32_t, wchar_t and enumerations are their underlying types: the
-- reader names those. long double is not here: see the track's Limits.)
data CTy = ct-bool | ct-char | ct-schar | ct-uchar | ct-short | ct-ushort | ct-int | ct-uint
         | ct-long | ct-ulong | ct-llong | ct-ullong | ct-int128 | ct-uint128
         | ct-float | ct-double | ct-ptr
ct-ck : CTy → CK
ct-ck c = case c of
  ct-bool → ck-bool
  ct-char → ck-char
  ct-schar → ck-char
  ct-uchar → ck-char
  ct-short → ck-short
  ct-ushort → ck-short
  ct-int → ck-int
  ct-uint → ck-int
  ct-long → ck-long
  ct-ulong → ck-long
  ct-llong → ck-llong
  ct-ullong → ck-llong
  ct-int128 → ck-int128
  ct-uint128 → ck-int128
  ct-float → ck-float
  ct-double → ck-double
  ct-ptr → ck-ptr
ct-size : Target → CTy → Word
ct-size t c = tg-size t (ct-ck c)
ct-align : Target → CTy → Word
ct-align t c = tg-align t (ct-ck c)
-- signed, for the integer types (bool and the others: false)
ct-signed : Target → CTy → Bool
ct-signed t c = case c of
  ct-char → tg-char-signed t
  ct-schar → true
  ct-short → true
  ct-int → true
  ct-long → true
  ct-llong → true
  ct-int128 → true
  _ → false
-- the width of a size in bytes; a size no kind has (0: the type is not offered) stops
iw-of-size : Word → MRes IW
iw-of-size n = case weq n #1 of
  true → mok iw8
  false → (case weq n #2 of
    true → mok iw16
    false → (case weq n #4 of
      true → mok iw32
      false → (case weq n #8 of
        true → mok iw64
        false → (case weq n #16 of
          true → mok iw128
          false → mstop st-unsupported))))
-- the kind of a C type at a Target
ct-sk : Target → CTy → MRes SK
ct-sk t c = case c of
  ct-bool → mok sk-bool
  ct-float → (case weq (ct-size t c) #4 of
    true → mok sk-f32
    false → mstop st-unsupported)
  ct-double → (case weq (ct-size t c) #8 of
    true → mok sk-f64
    false → mstop st-unsupported)
  ct-ptr → mok sk-ptr
  _ → mr-map (sk-int (ct-signed t c)) (iw-of-size (ct-size t c))
-- the conversion rank of an integer type (C17 6.3.1.1p1); the 128-bit types above long long
ct-rank : CTy → Word
ct-rank c = case c of
  ct-bool → #0
  ct-char → #1
  ct-schar → #1
  ct-uchar → #1
  ct-short → #2
  ct-ushort → #2
  ct-int → #3
  ct-uint → #3
  ct-long → #4
  ct-ulong → #4
  ct-llong → #5
  ct-ullong → #5
  ct-int128 → #6
  ct-uint128 → #6
  _ → #7
ct-unsigned-of : CTy → CTy
ct-unsigned-of c = case c of
  ct-int → ct-uint
  ct-long → ct-ulong
  ct-llong → ct-ullong
  ct-int128 → ct-uint128
  _ → c
-- every value of type a is a value of the signed type b: a signed and no wider, or a unsigned and narrower
ct-fits-signed : Target → CTy → CTy → Bool
ct-fits-signed t a b = case ct-signed t a of
  true → not (wlt (ct-size t b) (ct-size t a))
  false → wlt (ct-size t a) (ct-size t b)
-- integer promotion: a type of rank below int becomes int when int holds all its values, else
-- unsigned int; every other type is unchanged
ct-promote : Target → CTy → CTy
ct-promote t c = case wlt (ct-rank c) #3 of
  false → c
  true → (case c of
    ct-bool → ct-int
    _ → (case ct-fits-signed t c ct-int of
      true → ct-int
      false → ct-uint))
-- the usual arithmetic conversions: the common type of two arithmetic operands. double if either
-- is, else float if either is, else on the promoted types: the same type; of two of one
-- signedness the higher rank; else the unsigned one when its rank is at least the signed one's,
-- else the signed one when it holds every value of the unsigned one, else the signed one's
-- unsigned counterpart. A pointer has no common type with anything: the meaning stops
ct-uac-int : Target → CTy → CTy → CTy
ct-uac-int t a b = case ct-signed t a of
  true → (case ct-signed t b of
    true → (case wlt (ct-rank a) (ct-rank b) of
      true → b
      false → a)
    false → (case wlt (ct-rank b) (ct-rank a) of
      false → b
      true → (case ct-fits-signed t b a of
        true → a
        false → ct-unsigned-of a)))
  false → (case ct-signed t b of
    false → (case wlt (ct-rank a) (ct-rank b) of
      true → b
      false → a)
    true → (case wlt (ct-rank a) (ct-rank b) of
      false → a
      true → (case ct-fits-signed t a b of
        true → b
        false → ct-unsigned-of b)))
ct-is : CTy → CTy → Bool
ct-is a b = case a of
  ct-double → (case b of
    ct-double → true
    _ → false)
  ct-float → (case b of
    ct-float → true
    _ → false)
  ct-ptr → (case b of
    ct-ptr → true
    _ → false)
  _ → false
ct-uac : Target → CTy → CTy → MRes CTy
ct-uac t a b = case m-or (ct-is a ct-ptr) (ct-is b ct-ptr) of
  true → mstop st-ill-typed
  false → (case m-or (ct-is a ct-double) (ct-is b ct-double) of
    true → mok ct-double
    false → (case m-or (ct-is a ct-float) (ct-is b ct-float) of
      true → mok ct-float
      false → mok (ct-uac-int t (ct-promote t a) (ct-promote t b))))
-- a binary arithmetic operation of C on operands of two types: both converted to the common
-- type, the operation at its kind; the result with its type
ct-arith : Target → BinOp → CTy → CTy → SV → SV → MRes (CTy × SV)
ct-arith t o ta tb a b =
  mr-bind (ct-uac t ta tb) (λ tc →
  mr-bind (ct-sk t ta) (λ ka →
  mr-bind (ct-sk t tb) (λ kb →
  mr-bind (ct-sk t tc) (λ kc →
  mr-bind (sv-conv ka kc a) (λ x →
  mr-bind (sv-conv kb kc b) (λ y →
  mr-map (λ r → (tc , r)) (sv-arith o kc x y)))))))
