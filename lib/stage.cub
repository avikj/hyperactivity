-- lib/stage.cub — binding times, the first-order criterion and schedules (plan 18.3, B13).
-- Loaded after lib/check.cub (it quotes types and reads the data and representation tables).
--
-- The criterion answers, for a region (a code c at a type T, the type's binders the region's
-- inputs), whether it may be printed as native code: `first-order T c` is `fo`, or
-- `not-fo reason at` with the first failing reason and the code where it fails. It runs
-- nothing: it reads the code and the type. #fo f (a checked definition) or #fo (the T t) runs
-- it on the normal form (the specializer's step 2: evaluated and quoted at T), so a closed
-- Kan operation has reduced and a path in path-free data has gone.
--
-- Reasons (18.3 §3): dim, an interval binder or variable or a path abstraction left in the
-- region; dep-type, a type at the boundary depending on an input other than through an
-- erased (:0) binder; higher, a type at the boundary with path constructors and no
-- representation, a Glue or %hcompU type, or a universe; kan, a composition or transport left
-- in the region; reflect, %view, eval or quote in the region (they are not constructs of
-- checked terms, so a checked code has none: the reason is kept for the specializer's
-- rewritten codes); mult, the multiplicities not decided (every checked definition's are).

-- (The data types Stage, Reason, Verdict and the schedule's are declared in lib/code.cub beside
-- Code, untyped data as Code is.)

-- ---------------------------------------------------------------- the boundary: the type's inputs and result
-- a type at the boundary: path-free data (or represented), primitives, words, functions between
-- such (closures), pairs of such; a path is dim; the rest higher
fo-type A =
  case %view A of
    wdata d ps → (if lany tel-has-dims (ctors-at d ps) then (case %rtab d of some R → fo; none → not-fo higher (cdata d lnil)) else fo)
    wword → fo
    wpty k n → fo
    wpi D B → fo-type-pi A D B
    wsigma D B → (case fo-type D of fo → fo-type (B (%var D)); v → v)
    wpath L a b → not-fo dim (cplam (cvar #0))
    wu l → not-fo higher (cuniv clzero)
    wglue X S → not-fo higher (cgluet (cvar #0) (cvar #0))
    whcompu X S → not-fo higher (chcompu (cvar #0) (cvar #0))
    _ → not-fo higher (cvar #0)
-- a Π at the boundary: its domain, then its codomain, which may not depend on the binder unless
-- the binder is erased (:0)
fo-type-pi A D B =
  case fo-type D of
    fo →
      let x = %var D
          Bx = B x
      in if andb (notb (%weq (%pimult A) #0)) (type-mentions x Bx) then not-fo dep-type (cvar #0) else fo-type Bx
    v → v
-- does the type Bx mention the variable x: its code under x mentions index 0
type-mentions x Bx = case qty (lcons (qv (var-level x)) lnil) Bx of some c → code-mentions #0 c; none → false
code-mentions k c =
  case c of
    cvar n → %weq n k
    clam b → code-mentions (%wsucc k) b
    cplam b → code-mentions (%wsucc k) b
    cdlam b → code-mentions (%wsucc k) b
    cforall b → code-mentions (%wsucc k) b
    cpi m A B → orb (code-mentions k A) (code-mentions (%wsucc k) B)
    csigma A B → orb (code-mentions k A) (code-mentions (%wsucc k) B)
    clet t b → orb (code-mentions k t) (code-mentions (%wsucc k) b)
    capp f a → orb (code-mentions k f) (code-mentions k a)
    cpair a b → orb (code-mentions k a) (code-mentions k b)
    cfst p → code-mentions k p
    csnd p → code-mentions k p
    cpathp A a b → orb (code-mentions k A) (orb (code-mentions k a) (code-mentions k b))
    cpapp p r → orb (code-mentions k p) (code-mentions k r)
    cann t T → orb (code-mentions k t) (code-mentions k T)
    cdata d ps → lany (code-mentions k) ps
    ccon d c fs ds → orb (lany (code-mentions k) fs) (lany (code-mentions k) ds)
    ccase d B x → orb (lany (code-mentions k) B) (code-mentions k x)
    celim d P B x → orb (code-mentions k P) (orb (lany (code-mentions k) B) (code-mentions k x))
    cuniv l → code-mentions k l
    clsuc l → code-mentions k l
    clmax a b → orb (code-mentions k a) (code-mentions k b)
    cwsucc a → code-mentions k a
    cwop p a b → orb (code-mentions k a) (code-mentions k b)
    cprim p as → lany (code-mentions k) as
    cwelim w z s → orb (code-mentions k w) (orb (code-mentions k z) (code-mentions k s))
    ccomp A u a → orb (code-mentions k A) (orb (code-mentions k u) (code-mentions k a))
    chcomp u a → orb (code-mentions k u) (code-mentions k a)
    cforce t → code-mentions k t
    cthunk t → code-mentions k t
    cproj d f x → code-mentions k x
    crec d fs → lany (code-mentions k) fs
    cpty j n → code-mentions k n
    _ → false

-- ---------------------------------------------------------------- the region's code
-- the first failing reason in a code, or fo: an interval form is dim; a composition, a transport
-- or a Glue form kan; the rest by its parts (a type as a term is erased or at the boundary; a
-- case's motive is not looked at; a constructor with dimensions is dim)
fo-code c =
  case c of
    cvar n → fo
    cglob n → fo
    clam b → fo-code b
    capp f a → fo-seq (fo-code f) a
    cpair a b → fo-seq (fo-code a) b
    cfst p → fo-code p
    csnd p → fo-code p
    clet t b → fo-seq (fo-code t) b
    cann t T → fo-code t
    cplam b → not-fo dim c
    cpapp p r → not-fo dim c
    ci0 → not-fo dim c
    ci1 → not-fo dim c
    cneg r → not-fo dim c
    cmeet r s → not-fo dim c
    cjoin r s → not-fo dim c
    ceq0 r → not-fo dim c
    ceq1 r → not-fo dim c
    cfand a b → not-fo dim c
    cfor a b → not-fo dim c
    cftt → not-fo dim c
    cfff → not-fo dim c
    cforall b → not-fo dim c
    csys0 → not-fo dim c
    csysc f t r → not-fo dim c
    cdlam b → not-fo dim c
    ccomp A u a → not-fo kan c
    chcomp u a → not-fo kan c
    ctrans d psi ls x → not-fo kan c
    cgluet A S → not-fo kan c
    cglue S a → not-fo kan c
    cunglue S b → not-fo kan c
    chcompu A S → not-fo kan c
    cunglueu S b → not-fo kan c
    -- a type as a term stands at an erased position (an argument at :0, a motive), or at the
    -- boundary, where fo-type looks: nothing here
    cpi m A B → fo
    csigma A B → fo
    cuniv l → fo
    cpathp A a b → fo
    cdata d ps → fo
    clevel → fo
    cword → fo
    cpty k n → fo
    ccon d k fs ds → (case ds of lnil → fo-list fs; _ → not-fo dim c)
    ccase d B x → fo-seq (fo-list B) x
    celim d P B x → fo-seq (fo-list B) x
    cwsucc a → fo-code a
    cwop p a b → fo-seq (fo-code a) b
    cprim p as → fo-list as
    cwelim w z s → fo-seq (fo-seq (fo-code w) z) s
    cforce t → fo-code t
    cthunk t → fo-code t
    cproj d f x → fo-code x
    crec d fs → fo-list fs
    _ → fo
fo-seq v c = case v of fo → fo-code c; _ → v
-- (the tail is a list: fo-seq would read it as a code)
fo-list cs = case cs of lnil → fo; lcons c r → (case fo-code c of fo → fo-list r; v → v)
first-order T c = case fo-type T of fo → fo-code c; v → v
-- a code at its type, after the specializer's normalization (evaluated, quoted at T)
fo-normal T c = first-order T (fromopt (quote-top T (eval-g lnil c)) c)

