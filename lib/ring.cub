-- lib/ring.cub — the commutative semiring of Nat decided by reflection, verified (plan 18.13,
-- F32, and the method of F31: a decision procedure is a term, its soundness is checked once,
-- and each use is an evaluation). Loaded after lib/linproof.cub (weq-sound).
-- An expression over variables (indexed by words) with constants, + and × is normalized to a
-- polynomial: a list of (coefficient, monomial) with monomials sorted lists of variables and the
-- list sorted by monomial; ring-eq: two expressions with the same normal form are equal at every
-- valuation. The normal form is a sum of products, so each normalization step is sound by the
-- semiring laws of lib/std.cub; canonicity (that equal polynomials normalize alike) is what
-- makes the procedure complete and is not needed for soundness.
-- ---------------------------------------------------------------- Nat lemmas
-- t17 (2026-11-12): needs-work. 9 definitions here are untyped and refused by the checker, which
-- has rejected untyped definitions outside the bootstrap files since 2026-11-09, deliberately,
-- after about 10,000 lines of untyped code were written by an agent. They are to be written with
-- types; nothing in the checker changes.
times-one-l : (n : Nat) → times (suc zero) n ≡ n
times-one-l n = plus-zero n
times-distr-r : (a b c : Nat) → times a (plus b c) ≡ plus (times a b) (times a c)
times-distr-r a b c =
  transN (times-comm a (plus b c))
    (transN (times-distr b c a) (cong2N (λ x y → plus x y) (times-comm b a) (times-comm c a)))
times-comm-mid : (a b c : Nat) → times a (times b c) ≡ times b (times a c)
times-comm-mid a b c =
  transN (symN (times-assoc a b c))
    (transN (congN (λ z → times z c) (times-comm a b)) (times-assoc b a c))
-- (a·b)·(c·d) = (a·c)·(b·d)
times-swap : (a b c d : Nat) → times (times a b) (times c d) ≡ times (times a c) (times b d)
times-swap a b c d =
  transN (times-assoc a b (times c d))
    (transN (congN (λ z → times a z) (times-comm-mid b c d))
      (symN (times-assoc a c (times b d))))
-- ---------------------------------------------------------------- monomials
-- a monomial: a sorted list of variables (a product with repetition)
data Mono = mone | mvar (v : Word) (rest : Mono)
Val : Type
Val = Word → Nat
mev : Val → Mono → Nat
mev e m = case m return (λ w → Nat) of mone → suc zero; mvar v r → times (e v) (rec r)
-- insertion keeps the order; the product of monomials is the fold of insertions
minsert : Word → Mono → Mono
minsert v m =
  case m return (λ w → Mono) of
    mone → mvar v mone
    mvar v2 r → (case %wlt v2 v return (λ w → Mono) of true → mvar v2 (rec r); false → mvar v (mvar v2 r))
mmul : Mono → Mono → Mono
mmul a b = case a return (λ w → Mono) of mone → b; mvar v r → minsert v (rec r)
minsert-step : (e : Val) (v v2 : Word) (r ir : Mono) → mev e ir ≡ times (e v) (mev e r) →
               times (e v2) (mev e ir) ≡ times (e v) (times (e v2) (mev e r))
minsert-step e v v2 r ir h = transN (congN (λ z → times (e v2) z) h) (times-comm-mid (e v2) (e v) (mev e r))
minsert-sound : (e : Val) (v : Word) (m : Mono) → mev e (minsert v m) ≡ times (e v) (mev e m)
minsert-sound e v m =
  case m return (λ w → mev e (minsert v w) ≡ times (e v) (mev e w)) of
    mone → λ i → times (e v) (suc zero)
    mvar v2 r →
      (case %wlt v2 v return (λ b → mev e (case b return (λ w → Mono) of true → mvar v2 (minsert v r); false → mvar v (mvar v2 r)) ≡ times (e v) (times (e v2) (mev e r))) of
         true → minsert-step e v v2 r (minsert v r) (rec r)
         false → λ i → times (e v) (times (e v2) (mev e r)))
mmul-step : (e : Val) (v : Word) (r b ir : Mono) → mev e ir ≡ times (mev e r) (mev e b) →
            mev e (minsert v ir) ≡ times (times (e v) (mev e r)) (mev e b)
mmul-step e v r b ir h = transN (minsert-sound e v ir) (transN (congN (λ z → times (e v) z) h) (symN (times-assoc (e v) (mev e r) (mev e b))))
mmul-sound : (e : Val) (a b : Mono) → mev e (mmul a b) ≡ times (mev e a) (mev e b)
mmul-sound e a b =
  case a return (λ w → mev e (mmul w b) ≡ times (mev e w) (mev e b)) of
    mone → symN (times-one-l (mev e b))
    mvar v r → mmul-step e v r b (mmul r b) (rec r)
-- comparison: equality and a lexicographic order, equality sound
andbn : Bool → Bool → Bool
andbn a b = case a return (λ w → Bool) of true → b; false → false
andbn-l : (a b : Bool) → andbn a b ≡ true → a ≡ true
andbn-l a b = case a return (λ w → andbn w b ≡ true → w ≡ true) of true → λ p i → true; false → λ p → p
andbn-r : (a b : Bool) → andbn a b ≡ true → b ≡ true
andbn-r a b =
  case a return (λ w → andbn w b ≡ true → b ≡ true) of
    true → λ p → p
    false → λ p → Empty-rec {lzero} {b ≡ true} (false≢true p)
msame : Mono → Mono → Bool
msame a b =
  case a return (λ w → Mono → Bool) of
    mone → λ b → (case b return (λ w → Bool) of mone → true; mvar v2 r2 → false)
    mvar v r → λ b → (case b return (λ w → Bool) of mone → false; mvar v2 r2 → andbn (weq v v2) (rec r r2))
  b
cong-mvar : {v v2 : Word} {r r2 : Mono} → v ≡ v2 → r ≡ r2 → mvar v r ≡ mvar v2 r2
cong-mvar p q = λ i → mvar (p i) (q i)
msame-sound : (a b : Mono) → msame a b ≡ true → a ≡ b
msame-sound a b =
  case a return (λ w → (b : Mono) → msame w b ≡ true → w ≡ b) of
    mone → λ b →
      (case b return (λ w → msame mone w ≡ true → mone ≡ w) of
         mone → λ p i → mone
         mvar v2 r2 → λ p → Empty-rec {lzero} {mone ≡ mvar v2 r2} (false≢true p))
    mvar v r → λ b →
      (case b return (λ w → msame (mvar v r) w ≡ true → mvar v r ≡ w) of
         mone → λ p → Empty-rec {lzero} {mvar v r ≡ mone} (false≢true p)
         mvar v2 r2 → λ p → cong-mvar (weq-sound v v2 (andbn-l (weq v v2) (msame r r2) p)) (rec r r2 (andbn-r (weq v v2) (msame r r2) p)))
  b
mlt : Mono → Mono → Bool
mlt a b =
  case a return (λ w → Mono → Bool) of
    mone → λ b → (case b return (λ w → Bool) of mone → false; mvar v2 r2 → true)
    mvar v r → λ b →
      (case b return (λ w → Bool) of
         mone → false
         mvar v2 r2 → (case %wlt v v2 return (λ w → Bool) of true → true; false → (case weq v v2 return (λ w → Bool) of true → rec r r2; false → false)))
  b
-- ---------------------------------------------------------------- polynomials
data Poly = pzero | pterm (c : Nat) (m : Mono) (rest : Poly)
pev : Val → Poly → Nat
pev e p = case p return (λ w → Nat) of pzero → zero; pterm c m r → plus (times c (mev e m)) (rec r)
-- insertion of a term: merged with the term of the same monomial, else placed in order
pins-case : Bool → Bool → Nat → Mono → Nat → Mono → Poly → Poly → Poly
pins-case eq lt c m c2 m2 r2 ir =
  case eq return (λ w → Poly) of
    true → pterm (plus c c2) m2 r2
    false → (case lt return (λ w → Poly) of true → pterm c m (pterm c2 m2 r2); false → pterm c2 m2 ir)
pinsert : Nat → Mono → Poly → Poly
pinsert c m p =
  case p return (λ w → Poly) of
    pzero → pterm c m pzero
    pterm c2 m2 r2 → pins-case (msame m m2) (mlt m m2) c m c2 m2 r2 (rec r2)
padd : Poly → Poly → Poly
padd p q = case p return (λ w → Poly) of pzero → q; pterm c m r → pinsert c m (rec r)
-- a term times a polynomial, and the product
pscale : Nat → Mono → Poly → Poly
pscale c m q = case q return (λ w → Poly) of pzero → pzero; pterm c2 m2 r2 → pterm (times c c2) (mmul m m2) (rec r2)
pmul : Poly → Poly → Poly
pmul p q = case p return (λ w → Poly) of pzero → pzero; pterm c m r → padd (pscale c m q) (rec r)
-- ---------------------------------------------------------------- soundness
pins-gt : (e : Val) (c : Nat) (m : Mono) (c2 : Nat) (m2 : Mono) (r2 ir : Poly) →
          pev e ir ≡ plus (times c (mev e m)) (pev e r2) →
          plus (times c2 (mev e m2)) (pev e ir) ≡ plus (times c (mev e m)) (plus (times c2 (mev e m2)) (pev e r2))
pins-gt e c m c2 m2 r2 ir h =
  transN (congN (λ z → plus (times c2 (mev e m2)) z) h) (plus-comm-mid (times c2 (mev e m2)) (times c (mev e m)) (pev e r2))
congm : (e : Val) → {m m2 : Mono} → m ≡ m2 → mev e m ≡ mev e m2
congm e q = λ i → mev e (q i)
pins-same : (e : Val) (c : Nat) (m : Mono) (c2 : Nat) (m2 : Mono) (r2 : Poly) → m ≡ m2 →
            plus (times (plus c c2) (mev e m2)) (pev e r2) ≡ plus (times c (mev e m)) (plus (times c2 (mev e m2)) (pev e r2))
pins-same e c m c2 m2 r2 q =
  transN (congN (λ z → plus z (pev e r2)) (times-distr c c2 (mev e m2)))
    (transN (plus-assoc (times c (mev e m2)) (times c2 (mev e m2)) (pev e r2))
      (congN (λ z → plus (times c z) (plus (times c2 (mev e m2)) (pev e r2))) (symN (congm e q))))
pins-case-sound : (e : Val) (eq lt : Bool) (c : Nat) (m : Mono) (c2 : Nat) (m2 : Mono) (r2 ir : Poly) →
                  msame m m2 ≡ eq → pev e ir ≡ plus (times c (mev e m)) (pev e r2) →
                  pev e (pins-case eq lt c m c2 m2 r2 ir) ≡ plus (times c (mev e m)) (pev e (pterm c2 m2 r2))
pins-case-sound e eq lt c m c2 m2 r2 ir pe h =
  case eq return (λ b → msame m m2 ≡ b → pev e (pins-case b lt c m c2 m2 r2 ir) ≡ plus (times c (mev e m)) (pev e (pterm c2 m2 r2))) of
    true → λ pe2 → pins-same e c m c2 m2 r2 (msame-sound m m2 pe2)
    false → λ pe2 →
      (case lt return (λ b → pev e (pins-case false b c m c2 m2 r2 ir) ≡ plus (times c (mev e m)) (pev e (pterm c2 m2 r2))) of
         true → λ i → plus (times c (mev e m)) (plus (times c2 (mev e m2)) (pev e r2))
         false → pins-gt e c m c2 m2 r2 ir h)
  pe
pinsert-sound : (e : Val) (c : Nat) (m : Mono) (p : Poly) → pev e (pinsert c m p) ≡ plus (times c (mev e m)) (pev e p)
pinsert-sound e c m p =
  case p return (λ w → pev e (pinsert c m w) ≡ plus (times c (mev e m)) (pev e w)) of
    pzero → λ i → plus (times c (mev e m)) zero
    pterm c2 m2 r2 → pins-case-sound e (msame m m2) (mlt m m2) c m c2 m2 r2 (pinsert c m r2) (λ i → msame m m2) (rec r2)
padd-step : (e : Val) (c : Nat) (m : Mono) (r q : Poly) →
            pev e (padd r q) ≡ plus (pev e r) (pev e q) →
            pev e (pinsert c m (padd r q)) ≡ plus (plus (times c (mev e m)) (pev e r)) (pev e q)
padd-step e c m r q h =
  transN (pinsert-sound e c m (padd r q))
    (transN (congN (λ z → plus (times c (mev e m)) z) h) (symN (plus-assoc (times c (mev e m)) (pev e r) (pev e q))))
padd-sound : (e : Val) (p q : Poly) → pev e (padd p q) ≡ plus (pev e p) (pev e q)
padd-sound e p q =
  case p return (λ w → pev e (padd w q) ≡ plus (pev e w) (pev e q)) of
    pzero → λ i → pev e q
    pterm c m r → padd-step e c m r q (rec r)
pscale-step : (e : Val) (c : Nat) (m : Mono) (c2 : Nat) (m2 : Mono) (r2 ir : Poly) →
              pev e ir ≡ times (times c (mev e m)) (pev e r2) →
              plus (times (times c c2) (mev e (mmul m m2))) (pev e ir) ≡ times (times c (mev e m)) (plus (times c2 (mev e m2)) (pev e r2))
pscale-step e c m c2 m2 r2 ir h =
  transN (cong2N (λ x y → plus x y)
            (transN (congN (λ z → times (times c c2) z) (mmul-sound e m m2)) (times-swap c c2 (mev e m) (mev e m2)))
            h)
    (symN (times-distr-r (times c (mev e m)) (times c2 (mev e m2)) (pev e r2)))
pscale-sound : (e : Val) (c : Nat) (m : Mono) (q : Poly) → pev e (pscale c m q) ≡ times (times c (mev e m)) (pev e q)
pscale-sound e c m q =
  case q return (λ w → pev e (pscale c m w) ≡ times (times c (mev e m)) (pev e w)) of
    pzero → symN (times-zero (times c (mev e m)))
    pterm c2 m2 r2 → pscale-step e c m c2 m2 r2 (pscale c m r2) (rec r2)
pmul-step : (e : Val) (c : Nat) (m : Mono) (r q : Poly) →
            pev e (pmul r q) ≡ times (pev e r) (pev e q) →
            pev e (padd (pscale c m q) (pmul r q)) ≡ times (plus (times c (mev e m)) (pev e r)) (pev e q)
pmul-step e c m r q h =
  transN (padd-sound e (pscale c m q) (pmul r q))
    (transN (cong2N (λ x y → plus x y) (pscale-sound e c m q) h)
      (symN (times-distr (times c (mev e m)) (pev e r) (pev e q))))
pmul-sound : (e : Val) (p q : Poly) → pev e (pmul p q) ≡ times (pev e p) (pev e q)
pmul-sound e p q =
  case p return (λ w → pev e (pmul w q) ≡ times (pev e w) (pev e q)) of
    pzero → λ i → zero
    pterm c m r → pmul-step e c m r q (rec r)
-- ---------------------------------------------------------------- expressions
data Ex = ec (n : Nat) | ev (v : Word) | eadd (a : Ex) (b : Ex) | emul (a : Ex) (b : Ex)
xeval : Val → Ex → Nat
xeval e x =
  case x return (λ w → Nat) of
    ec n → n
    ev v → e v
    eadd a b → plus (rec a) (rec b)
    emul a b → times (rec a) (rec b)
norm : Ex → Poly
norm x =
  case x return (λ w → Poly) of
    ec n → (case n return (λ w → Poly) of zero → pzero; suc k → pterm (suc k) mone pzero)
    ev v → pterm (suc zero) (mvar v mone) pzero
    eadd a b → padd (rec a) (rec b)
    emul a b → pmul (rec a) (rec b)
norm-const : (n : Nat) → plus (times n (suc zero)) zero ≡ n
norm-const n = transN (plus-zero (times n (suc zero))) (times-one n)
norm-var : (e : Val) (v : Word) → plus (times (suc zero) (times (e v) (suc zero))) zero ≡ e v
norm-var e v = transN (plus-zero (times (suc zero) (times (e v) (suc zero)))) (transN (times-one-l (times (e v) (suc zero))) (times-one (e v)))
norm-sound : (e : Val) (x : Ex) → pev e (norm x) ≡ xeval e x
norm-sound e x =
  case x return (λ w → pev e (norm w) ≡ xeval e w) of
    ec n → (case n return (λ w → pev e (norm (ec w)) ≡ w) of zero → λ i → zero; suc k → norm-const (suc k))
    ev v → norm-var e v
    eadd a b → transN (padd-sound e (norm a) (norm b)) (cong2N (λ x y → plus x y) (rec a) (rec b))
    emul a b → transN (pmul-sound e (norm a) (norm b)) (cong2N (λ x y → times x y) (rec a) (rec b))
-- the decision procedure: same normal form, same value everywhere
congp : (e : Val) → {p q : Poly} → p ≡ q → pev e p ≡ pev e q
congp e r = λ i → pev e (r i)
ring-eq : (e : Val) (a b : Ex) → norm a ≡ norm b → xeval e a ≡ xeval e b
ring-eq e a b r = transN (symN (norm-sound e a)) (transN (congp e r) (norm-sound e b))
-- ---------------------------------------------------------------- the bridge from codes (unverified)
-- a code of the fragment — applications of the globals plus and times, variables, Nat literals
-- as constructor codes — read as an expression; a code outside the fragment reads as none. What
-- it produces is decided by norm and the theorem is ring-eq about the typed expression, so the
-- bridge is the unverified part (18.13: search is unverified, the checker verified)
nat-of-code c =
  case c of
    ccon d k fs ds → (if %weq k #0 then some zero else (case fs of lcons n r → omap (λ m → suc m) (nat-of-code n); _ → none))
    _ → none
rg-glob c = case c of cglob g → some g; _ → none
ex-of-code c =
  case c of
    cvar v → some (ev v)
    cann t T → ex-of-code t
    ccon d k fs ds → omap (λ n → ec n) (nat-of-code c)
    capp f x →
      (case f of
         capp g a →
           (case rg-glob g of
              some gi →
                if %weq gi (gidx-r (code plus)) then obind (ex-of-code a) (λ ea → omap (λ ex → eadd ea ex) (ex-of-code x))
                else if %weq gi (gidx-r (code times)) then obind (ex-of-code a) (λ ea → omap (λ ex → emul ea ex) (ex-of-code x))
                else none
              none → none)
         _ → none)
    _ → none
gidx-r c = case c of cglob n → n; _ → #0
lam-body c = case c of clam b → b; _ → c
-- the same expression as a code again: the globals applied
code-of-ex x =
  case x of
    ec n → code-of-nat n
    ev v → cvar v
    eadd a b → capp (capp (code plus) (code-of-ex a)) (code-of-ex b)
    emul a b → capp (capp (code times) (code-of-ex a)) (code-of-ex b)
code-of-nat n = case n of zero → ccon #1 #0 lnil lnil; suc k → ccon #1 #1 (lcons (code-of-nat k) lnil) lnil
-- (x + 1)·(x + 1) and x·x + 2·x + 1 written as source terms, quoted, read as expressions: the
-- same normal form, so ring-eq applies to them; and a round trip through codes is the identity
csq1 = lam-body (code (λ x → times (plus x 1) (plus x 1)))
csq2 = lam-body (code (λ x → plus (plus (times x x) (times 2 x)) 1))
