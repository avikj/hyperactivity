-- Layer: misplaced in the core's load order: machine representations (Word, Int64, UInt32, UInt64, Float64, Float32, Bytes n) that do not arise in pure mathematics; they belong in the library as definitions (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- prim.cub — primitive types and operations (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.2 “B12 — Representations as a construct”): the machine's fixed-width numbers and byte
-- strings, as constants of the type theory. Each is a `primitive`: its type is checked, its
-- computation is the machine's (trusted), and `#trusted` lists it. Loaded after lib/library/std.cub.
--
-- A primitive value prints as #i64:n, #u32:n, #f64:x, #bytes:n:..., and is made only by these
-- operations (there are no literals): i64 #5 is the Int64 5.

primitive Int64 : Type = %pty #0
primitive UInt32 : Type = %pty #1
primitive Float64 : Type = %pty #2
primitive Float32 : Type = %pty #3
primitive Bytes : Nat → Type = λ n → %bytesty n
-- the modular 64-bit unsigned type (PLAN.md revision 8, 9 Nov 2026, git 91167ad638c0:PLAN.md, §5.3 “The target is a data type with a meaning”): U64 arithmetic is what the hardware's 64-bit registers
-- compute; Word is the unbounded natural, and nothing prints one as the other
-- Word arithmetic beyond the eliminator's: on numerals of any size (stuck on a neutral);
-- x / 0 = 0 and x mod 0 = x, a shift right by any count, a shift left by at most 2^32
wmul : Word → Word → Word
wmul a b = %wmul a b
wand : Word → Word → Word
wand a b = %wand a b
wor : Word → Word → Word
wor a b = %wor a b
wxor : Word → Word → Word
wxor a b = %wxor a b
wshl : Word → Word → Word
wshl a b = %wshl a b
wshr : Word → Word → Word
wshr a b = %wshr a b
wquot : Word → Word → Word
wquot a b = %wdiv a b
wrem : Word → Word → Word
wrem a b = %wmod a b
primitive UInt64 : Type = %pty #5

-- ---------------------------------------------------------------- integers, modular (two's complement)
primitive i64 : Word → Int64 = λ w → %i64ofw w
primitive i64toWord : Int64 → Word = λ a → %wofi64 a
primitive i64add : Int64 → Int64 → Int64 = λ a b → %i64add a b
primitive i64sub : Int64 → Int64 → Int64 = λ a b → %i64sub a b
primitive i64mul : Int64 → Int64 → Int64 = λ a b → %i64mul a b
primitive i64eq : Int64 → Int64 → Bool = λ a b → %i64eq a b
primitive i64lt : Int64 → Int64 → Bool = λ a b → %i64lt a b
primitive u32 : Word → UInt32 = λ w → %u32ofw w
primitive u32toWord : UInt32 → Word = λ a → %wofu32 a
primitive u32add : UInt32 → UInt32 → UInt32 = λ a b → %u32add a b
primitive u32sub : UInt32 → UInt32 → UInt32 = λ a b → %u32sub a b
primitive u32mul : UInt32 → UInt32 → UInt32 = λ a b → %u32mul a b
primitive u32eq : UInt32 → UInt32 → Bool = λ a b → %u32eq a b
primitive u32lt : UInt32 → UInt32 → Bool = λ a b → %u32lt a b
primitive u64 : Word → UInt64 = λ w → %u64ofw w
primitive u64toWord : UInt64 → Word = λ a → %wofu64 a
primitive u64add : UInt64 → UInt64 → UInt64 = λ a b → %u64add a b
primitive u64sub : UInt64 → UInt64 → UInt64 = λ a b → %u64sub a b
primitive u64mul : UInt64 → UInt64 → UInt64 = λ a b → %u64mul a b
primitive u64eq : UInt64 → UInt64 → Bool = λ a b → %u64eq a b
primitive u64lt : UInt64 → UInt64 → Bool = λ a b → %u64lt a b
primitive u64div : UInt64 → UInt64 → UInt64 = λ a b → %u64div a b
primitive u64mod : UInt64 → UInt64 → UInt64 = λ a b → %u64mod a b
primitive u64and : UInt64 → UInt64 → UInt64 = λ a b → %u64and a b
primitive u64or : UInt64 → UInt64 → UInt64 = λ a b → %u64or a b
primitive u64xor : UInt64 → UInt64 → UInt64 = λ a b → %u64xor a b
primitive u64shl : UInt64 → UInt64 → UInt64 = λ a b → %u64shl a b
primitive u64shr : UInt64 → UInt64 → UInt64 = λ a b → %u64shr a b
primitive i64div : Int64 → Int64 → Int64 = λ a b → %i64div a b
primitive i64mod : Int64 → Int64 → Int64 = λ a b → %i64mod a b
primitive i64and : Int64 → Int64 → Int64 = λ a b → %i64and a b
primitive i64or : Int64 → Int64 → Int64 = λ a b → %i64or a b
primitive i64xor : Int64 → Int64 → Int64 = λ a b → %i64xor a b
primitive i64shl : Int64 → Int64 → Int64 = λ a b → %i64shl a b
primitive i64shr : Int64 → Int64 → Int64 = λ a b → %i64shr a b

-- ---------------------------------------------------------------- floating point (IEEE 754 binary64; no
-- specification in the language yet: wholly trusted, listed by #trusted)
primitive f64 : Word → Float64 = λ w → %f64ofw w
primitive f64ofi64 : Int64 → Float64 = λ a → %f64ofi64 a
primitive i64off64 : Float64 → Int64 = λ a → %i64off64 a
primitive f64add : Float64 → Float64 → Float64 = λ a b → %f64add a b
primitive f64sub : Float64 → Float64 → Float64 = λ a b → %f64sub a b
primitive f64mul : Float64 → Float64 → Float64 = λ a b → %f64mul a b
primitive f64div : Float64 → Float64 → Float64 = λ a b → %f64div a b
primitive f64eq : Float64 → Float64 → Bool = λ a b → %f64eq a b
primitive f64lt : Float64 → Float64 → Bool = λ a b → %f64lt a b
-- a Float64's bits as an Int64 and back (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.10 “C20–C22 — Memory and state”, its part C22, and §12 “The build list”, “C. Memory and state”, item 22: how a Float64 is stored by the byte layer)
primitive f64bits : Float64 → Int64 = λ a → %f64bits a
primitive f64ofbits : Int64 → Float64 = λ a → %f64ofbits a
primitive f32bits : Float32 → UInt32 = λ a → %f32bits a
primitive f32ofbits : UInt32 → Float32 = λ a → %f32ofbits a

-- ---------------------------------------------------------------- the byte layer: a string of n bytes,
-- loads and stores at an offset with the proof that they fit (le (plus off w) n, from lib/library/std.cub);
-- a store is a copy with the value written
primitive bytes : (n : Nat) → Bytes n = λ n → %bytes n
primitive load32 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 4) n → UInt32 = λ n b off pf → %load32 b off
primitive store32 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 4) n → UInt32 → Bytes n = λ n b off pf v → %store32 b off v
primitive load64 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 8) n → Int64 = λ n b off pf → %load64 b off
primitive store64 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 8) n → Int64 → Bytes n = λ n b off pf v → %store64 b off v

primitive blen : (n : Nat) → Bytes n → Nat = λ n b → n
-- a byte of a byte string, written and read (lib/languages/cxx/ast.cub's strings): %store8 and %load8 are
-- bounds-checked by the machine, a store outside the string leaving it unchanged and a load there 0
primitive cstr-put : (n : Nat) → Bytes n → Word → Word → Bytes n = λ n b off v → %store8 b off (%u32ofw v)
primitive cstr-get : (n : Nat) → Bytes n → Word → Word = λ n b off → %wofu32 (%load8 b off)

-- ---------------------------------------------------------------- memory the program does not own (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.10 “C20–C22 — Memory and state”, its part C20):
-- the address of a byte string (the string is then pinned, so the address stays valid), and the
-- bytes at an address (copied in). Trusted: the program vouches for the address; #safe f lists
-- them when f reaches them
primitive ptr-of : (n : Nat) → Bytes n → Word = λ n b → %ptr-of b
primitive region-at : Word → (n : Nat) → Bytes n = λ a n → %region-at n a


-- ---------------------------------------------------------------- the word operations' laws, trusted: what the
-- C code (src/big.c) computes on every pair of numerals, stated for variables (the evaluator runs
-- these operations only on numerals). Product by recursion on the second factor; division and
-- remainder by their defining property (every word is quotient times divisor plus remainder, the
-- remainder below a nonzero divisor, and those determine them); shifts as product and quotient by a power of two; and with
-- a mask of k ones as the remainder; and, or of operands with disjoint bits as 0 and as their sum;
-- xor with 0 the identity
primitive wmul-zero : (a : Word) → PathP (λ (i : I) → Word) (wmul a #0) #0
primitive wmul-suc : (a b : Word) → PathP (λ (i : I) → Word) (wmul a (%wsucc b)) (wadd (wmul a b) a)
primitive wdiv-unique : (q r n : Word) → PathP (λ (i : I) → Bool) (wlt r n) true → PathP (λ (i : I) → Word) (wquot (wadd (wmul q n) r) n) q
primitive wmod-unique : (q r n : Word) → PathP (λ (i : I) → Bool) (wlt r n) true → PathP (λ (i : I) → Word) (wrem (wadd (wmul q n) r) n) r
primitive wdiv-mod : (v n : Word) → PathP (λ (i : I) → Word) v (wadd (wmul (wquot v n) n) (wrem v n))
primitive wrem-lt : (v n : Word) → PathP (λ (i : I) → Bool) (wlt #0 n) true → PathP (λ (i : I) → Bool) (wlt (wrem v n) n) true
primitive wshl-mul : (a k : Word) → PathP (λ (i : I) → Word) (wshl a k) (wmul a (wshl #1 k))
primitive wshr-div : (a k : Word) → PathP (λ (i : I) → Word) (wshr a k) (wquot a (wshl #1 k))
primitive wand-mask : (a k : Word) → PathP (λ (i : I) → Word) (wand a (wsub (wshl #1 k) #1)) (wrem a (wshl #1 k))
primitive wand-disj : (a b k : Word) → PathP (λ (i : I) → Bool) (wlt a (wshl #1 k)) true → PathP (λ (i : I) → Word) (wand a (wmul b (wshl #1 k))) #0
primitive wor-zero : (a : Word) → PathP (λ (i : I) → Word) (wor a #0) a
primitive wxor-zero : (a : Word) → PathP (λ (i : I) → Word) (wxor a #0) a
primitive wor-disj : (a b k : Word) → PathP (λ (i : I) → Bool) (wlt a (wshl #1 k)) true → PathP (λ (i : I) → Word) (wor a (wmul b (wshl #1 k))) (wadd a (wmul b (wshl #1 k)))

-- the bitwise operations bit by bit: bit i of x is x's base-2 digit i; and, or, xor act on each
-- bit; a shift moves the bits; a word is determined by its bits
bit-and : Bool → Bool → Bool
bit-and a b = if a then b else false
bit-or : Bool → Bool → Bool
bit-or a b = if a then true else b
bit-xor : Bool → Bool → Bool
bit-xor a b = if a then (if b then false else true) else b
wbit : Word → Word → Bool
wbit x i = weq (wrem (wquot x (wshl #1 i)) #2) #1
primitive wbit-and : (a b i : Word) → PathP (λ (j : I) → Bool) (wbit (wand a b) i) (bit-and (wbit a i) (wbit b i))
primitive wbit-or : (a b i : Word) → PathP (λ (j : I) → Bool) (wbit (wor a b) i) (bit-or (wbit a i) (wbit b i))
primitive wbit-xor : (a b i : Word) → PathP (λ (j : I) → Bool) (wbit (wxor a b) i) (bit-xor (wbit a i) (wbit b i))
primitive wbit-shl : (a k i : Word) → PathP (λ (j : I) → Bool) (wbit (wshl a k) i) (if wlt i k then false else wbit a (wsub i k))
primitive wbit-shr : (a k i : Word) → PathP (λ (j : I) → Bool) (wbit (wshr a k) i) (wbit a (wadd i k))
primitive wbit-ext : (a b : Word) → ((i : Word) → PathP (λ (j : I) → Bool) (wbit a i) (wbit b i)) → PathP (λ (j : I) → Word) a b

-- ---------------------------------------------------------------- the byte layer's laws, trusted: a load after a
-- store at the same offset is the value stored. A primitive operation on a variable is a neutral
-- (%view: wprim), so the laws of what is built over the byte layer follow by unfolding
primitive load32-store32 : (n : Nat) → (b : Bytes n) → (off : Nat) → (h : le (plus off 4) n) → (v : UInt32) → PathP (λ (i : I) → UInt32) (load32 n (store32 n b off h v) off h) v
primitive load64-store64 : (n : Nat) → (b : Bytes n) → (off : Nat) → (h : le (plus off 8) n) → (v : Int64) → PathP (λ (i : I) → Int64) (load64 n (store64 n b off h v) off h) v
-- the bits are the value, trusted: a Float64 and its bits correspond one to one
primitive f64ofbits-bits : (x : Float64) → PathP (λ (i : I) → Float64) (f64ofbits (f64bits x)) x
primitive f64bits-ofbits : (y : Int64) → PathP (λ (i : I) → Int64) (f64bits (f64ofbits y)) y
primitive f32ofbits-bits : (x : Float32) → PathP (λ (i : I) → Float32) (f32ofbits (f32bits x)) x
primitive f32bits-ofbits : (y : UInt32) → PathP (λ (i : I) → UInt32) (f32bits (f32ofbits y)) y

-- ---------------------------------------------------------------- arrays of Int64 over the byte layer (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.10 “C20–C22 — Memory and state”, its part C22):
-- Array n is Bytes (times n 8); an index with its proof of fitting (le (suc i) n) is a load or
-- store at offset times i 8 with the proof that the access fits, by arithmetic; tabulate n f
-- writes f at every index; index-update, the law of arrays, is the byte layer's law unfolded
Array : Nat → Type
Array n = Bytes (times n 8)
anew : (n : Nat) → Array n
anew n = bytes (times n 8)
-- times (suc i) 8 = plus 8 (times i 8) by the definition of times, so an index below n fits
fits-eq : (k i : Nat) → plus (times k 8) (plus (times i 8) 8) ≡ times (plus k (suc i)) 8
fits-eq k i =
  calc plus (times k 8) (plus (times i 8) 8) ≡ plus (times k 8) (times (suc i) 8) by (λ j → plus (times k 8) (plus-comm (times i 8) 8 j))
                                             ≡ times (plus k (suc i)) 8 by sym (times-distr k (suc i) 8)
index-fits : (n i : Nat) → le (suc i) n → le (plus (times i 8) 8) (times n 8)
index-fits n i h = (times (fst h) 8 , concat (fits-eq (fst h) i) (cong (λ m → times m 8) (snd h)))
index : (n : Nat) → Array n → (i : Nat) → le (suc i) n → Int64
index n a i h = load64 (times n 8) a (times i 8) (index-fits n i h)
update : (n : Nat) → Array n → (i : Nat) → le (suc i) n → Int64 → Array n
update n a i h v = store64 (times n 8) a (times i 8) (index-fits n i h) v
-- below n: zero is, and the predecessor of what is
le-pred : (m n : Nat) → le (suc m) n → le m n
le-pred m n h = (suc (fst h) , concat (sym (plus-suc (fst h) m)) (snd h))
le-zero : (n : Nat) → le zero n
le-zero n = (n , plus-zero n)
-- the array of f at every index: a loop from the last index down
tab-go : (n : Nat) → (Nat → Int64) → (m : Nat) → le m n → Array n → Array n
tab-go n f zero h a = a
tab-go n f (suc m) h a = tab-go n f m (le-pred m n h) (update n a m h (f m))
tabulate : (n : Nat) → (Nat → Int64) → Array n
tabulate n f = tab-go n f n (le-refl n) (anew n)
index-update : (n : Nat) → (a : Array n) → (i : Nat) → (h : le (suc i) n) → (v : Int64) → index n (update n a i h v) i h ≡ v
index-update n a i h v = load64-store64 (times n 8) a (times i 8) (index-fits n i h) v

-- ---------------------------------------------------------------- the laws of arrays (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.10 “C20–C22 — Memory and state”, its part C22): two more
-- trusted laws of the byte layer (a load elsewhere than a store is the old value, when the two
-- 8-byte spans are disjoint; two arrays equal at every index are equal), then the arithmetic
-- (le is a proposition; below suc m is below m or equal; trichotomy), then Fin n, tabulate over
-- Fin n (atab) and index over Fin n (aindex) with the laws index-tabulate, tabulate-index, and
-- index-update-eq/ne/if; so Fin n → Int64 ≃ Array n (Fin→Array). Then two dimensions, row-major (mdspan's layout_right)
-- the byte layer's second law, trusted: a load at an offset disjoint from a store reads what was
-- there (the stored 8 bytes end before the load begins, or the loaded ones before the store)
primitive load64-store64-disj : (n : Nat) → (b : Bytes n) → (o1 o2 : Nat) → (h1 : le (plus o1 8) n) → (h2 : le (plus o2 8) n) → (v : Int64) → Sum (le (plus o1 8) o2) (le (plus o2 8) o1) → PathP (λ (i : I) → Int64) (load64 n (store64 n b o1 h1 v) o2 h2) (load64 n b o2 h2)
-- arrays are determined by their elements, trusted: two arrays equal at every index are equal
primitive array-ext : (n : Nat) → (a b : Array n) → ((i : Nat) → (h : le (suc i) n) → PathP (λ (j : I) → Int64) (index n a i h) (index n b i h)) → PathP (λ (i : I) → Array n) a b
-- ---------------------------------------------------------------- arithmetic on the order
-- le is a proposition: its witness is determined (addition cancels) and Nat is a set
isSetNat : isSet Nat
isSetNat = Discrete→isSet {Nat} discreteNat
le-prop : (m n : Nat) → isProp (le m n)
le-prop m n u v =
  let p = plus-cancel {m} {fst u} {fst v} (concat (plus-comm m (fst u)) (concat (snd u) (concat (sym (snd v)) (plus-comm (fst v) m))))
  in λ i → (p i , isProp→PathP {lzero} {plus (fst u) m ≡ n} {plus (fst v) m ≡ n} (λ j → plus (p j) m ≡ n) (isSetNat (plus (fst v) m) n) (snd u) (snd v) i)
-- below suc m: below m, or m itself
le-split : (i m : Nat) → le (suc i) (suc m) → Sum (le (suc i) m) (i ≡ m)
le-split i m h = case fst h return (λ k → plus k (suc i) ≡ suc m → Sum (le (suc i) m) (i ≡ m)) of
    zero → λ e → inr (suc-inj e)
    suc k → λ e → inl (k , suc-inj e)
  (snd h)
-- three cases for two numbers
trich : (i j : Nat) → Sum (le (suc i) j) (Sum (i ≡ j) (le (suc j) i))
trich zero zero = inr (inl (λ t → zero))
trich zero (suc k) = inl (k , concat (plus-suc k zero) (cong suc (plus-zero k)))
trich (suc a) zero = inr (inr (a , concat (plus-suc a zero) (cong suc (plus-zero a))))
trich (suc a) (suc k) =
  case trich a k of
    inl l → inl (fst l , concat (plus-suc (fst l) (suc a)) (cong suc (snd l)))
    inr m → (case m of
               inl e → inr (inl (cong suc e))
               inr l → inr (inr (fst l , concat (plus-suc (fst l) (suc k)) (cong suc (snd l)))))

Fin : Nat → Type
Fin n = (i : Nat) × le (suc i) n
aindex : (n : Nat) → Array n → Fin n → Int64
aindex n a p = index n a (fst p) (snd p)
tabF-go : (n : Nat) → (Fin n → Int64) → (m : Nat) → le m n → Array n → Array n
tabF-go n f zero h a = a
tabF-go n f (suc m) h a = tabF-go n f m (le-pred m n h) (update n a m h (f (m , h)))
atab : (n : Nat) → (Fin n → Int64) → Array n
atab n f = tabF-go n f n (le-refl n) (anew n)
le-suc-zero : (j : Nat) → le (suc j) zero → Empty
le-suc-zero j h = case fst h return (λ k → plus k (suc j) ≡ zero → Empty) of
    zero → λ e → snotz {j} e
    suc k → λ e → snotz {plus k (suc j)} e
  (snd h)
fin-eq : (n j m : Nat) → (hj : le (suc j) n) → (h : le (suc m) n) → j ≡ m → Path (Fin n) (j , hj) (m , h)
fin-eq n j m hj h e = λ i → (e i , isProp→PathP {lzero} {le (suc j) n} {le (suc m) n} (λ k → le (suc (e k)) n) (le-prop (suc m) n) hj h i)
index-update-ne : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → Sum (le (suc i) j) (le (suc j) i) → index n (update n a i hi v) j hj ≡ index n a j hj
index-update-ne n a i j hi hj v d = load64-store64-disj (times n 8) a (times i 8) (times j 8) (index-fits n i hi) (index-fits n j hj) v (case d of inl l → inl (index-fits j i l); inr l → inr (index-fits i j l))
go-above : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array n) → le m j → index n (tabF-go n f m h a) j hj ≡ index n a j hj
go-above n f zero j h hj a l = λ i → index n a j hj
go-above n f (suc m) j h hj a l = concat (go-above n f m j (le-pred m n h) hj (update n a m h (f (m , h))) (le-pred m j l)) (index-update-ne n a m j h hj (f (m , h)) (inl l))
go-below-last : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le (suc m) n) → (hj : le (suc j) n) → (a : Array n) → j ≡ m → index n (update n a m h (f (m , h))) j hj ≡ f (j , hj)
go-below-last n f m j h hj a e =
  let q = fin-eq n j m hj h e
  in concat (cong {lzero} {lzero} {Fin n} {Int64} (λ p → index n (update n a m h (f (m , h))) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)
            (concat (index-update n a m h (f (m , h))) (cong {lzero} {lzero} {Fin n} {Int64} f {(m , h)} {(j , hj)} (sym {lzero} {Fin n} {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)))
go-below : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array n) → le (suc j) m → index n (tabF-go n f m h a) j hj ≡ f (j , hj)
go-below n f zero j h hj a l = Empty-rec (le-suc-zero j l)
go-below n f (suc m) j h hj a l =
  case le-split j m l of
    inl l2 → go-below n f m j (le-pred m n h) hj (update n a m h (f (m , h))) l2
    inr e → concat (go-above n f m j (le-pred m n h) hj (update n a m h (f (m , h))) (subst {lzero} {lzero} {Nat} {λ x → le m x} {m} {j} (sym {lzero} {Nat} {j} {m} e) (le-refl m)))
                   (go-below-last n f m j h hj a e)
index-tabulate : (n : Nat) → (f : Fin n → Int64) → (p : Fin n) → aindex n (atab n f) p ≡ f p
index-tabulate n f p = go-below n f n (fst p) (le-refl n) (snd p) (anew n) (snd p)
tabulate-index : (n : Nat) → (a : Array n) → atab n (aindex n a) ≡ a
tabulate-index n a = array-ext n (atab n (aindex n a)) a (λ i h → index-tabulate n (aindex n a) (i , h))
index-update-eq : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → i ≡ j → index n (update n a i hi v) j hj ≡ v
index-update-eq n a i j hi hj v e =
  concat (cong {lzero} {lzero} {Fin n} {Int64} (λ p → index n (update n a i hi v) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (i , hi)} (fin-eq n j i hj hi (sym {lzero} {Nat} {i} {j} e)))
         (index-update n a i hi v)
-- the three laws as one: a read after a write is the value at the written index, the old value elsewhere
index-update-if : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → index n (update n a i hi v) j hj ≡ (if eqb i j then v else index n a j hj)
index-update-if n a i j hi hj v =
  ifP {λ b → index n (update n a i hi v) j hj ≡ (if b then v else index n a j hj)} {eqb i j}
    (λ e → index-update-eq n a i j hi hj v (eqb-sound {i} {j} (eq→isTrue {eqb i j} e)))
    (λ e → index-update-ne n a i j hi hj v
             (case trich i j of
                inl l → inl l
                inr m → (case m of
                           inl q → Empty-rec (subst {lzero} {lzero} {Bool} {isTrue} {eqb i j} {false} e (eqb-complete {i} {j} q))
                           inr l → inr l)))
-- arrays as functions out of Fin n
Fin→Array : (n : Nat) → Equiv (Fin n → Int64) (Array n)
Fin→Array n = isoToEquiv {lzero} {Fin n → Int64} {Array n} (atab n) (aindex n) (tabulate-index n) (λ f → funExt {lzero} {lzero} {Fin n} {Int64} {aindex n (atab n f)} {f} (index-tabulate n f))
-- the interface carried across the equivalence (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.10 “C20–C22 — Memory and state”, its part C22, and §12 “The build list”, “C. Memory and state”, item 22): a program written against Fin n → Int64
-- uses application and the functional update fin-set; under atab they are index and update, so a
-- program on functions is the program on arrays along the paths below
fin-set : (n : Nat) → (Fin n → Int64) → Fin n → Int64 → Fin n → Int64
fin-set n f p v = λ q → if eqb (fst p) (fst q) then v else f q
-- application is index
apply-by : (n : Nat) → (f : Fin n → Int64) → (p : Fin n) → aindex n (atab n f) p ≡ f p
apply-by n f p = index-tabulate n f p
-- the functional update is update
fin-set-by : (n : Nat) → (f : Fin n → Int64) → (i : Nat) → (h : le (suc i) n) → (v : Int64) →
  atab n (fin-set n f (i , h) v) ≡ update n (atab n f) i h v
fin-set-by n f i h v = array-ext n (atab n (fin-set n f (i , h) v)) (update n (atab n f) i h v)
  (λ j hj → concat {lzero} {Int64} {index n (atab n (fin-set n f (i , h) v)) j hj} {if eqb i j then v else f (j , hj)} {index n (update n (atab n f) i h v) j hj}
     (index-tabulate n (fin-set n f (i , h) v) (j , hj))
     (sym {lzero} {Int64} {index n (update n (atab n f) i h v) j hj} {if eqb i j then v else f (j , hj)}
        (concat {lzero} {Int64} {index n (update n (atab n f) i h v) j hj} {if eqb i j then v else index n (atab n f) j hj} {if eqb i j then v else f (j , hj)}
           (index-update-if n (atab n f) i j h hj v)
           (λ k → if eqb i j then v else index-tabulate n f (j , hj) k))))
-- tabulate is the identity on functions
tabulate-by : (n : Nat) → (a : Array n) → atab n (aindex n a) ≡ a
tabulate-by n a = tabulate-index n a
-- two dimensions, row-major (mdspan's layout_right): row i column j at i*m + j
Array2 : Nat → Nat → Type
Array2 n m = Array (times n m)
idx2-fits : (n m i j : Nat) → le (suc i) n → le (suc j) m → le (suc (plus (times i m) j)) (times n m)
idx2-fits n m i j hi hj =
  let K = fst hi
      J = fst hj
      im = times i m
      inner : plus J (suc (plus im j)) ≡ plus im m
      inner = concat (plus-suc J (plus im j))
              (concat (cong suc (plus-comm-mid J im j))
              (concat (sym (plus-suc im (plus J j)))
              (concat (cong (plus im) (sym (plus-suc J j))) (cong (plus im) (snd hj)))))
      outer : plus (times K m) (plus im m) ≡ times n m
      outer = concat (sym (plus-assoc (times K m) im m))
              (concat (cong (λ x → plus x m) (sym (times-distr K i m)))
              (concat (plus-comm (times (plus K i) m) m)
              (concat (cong (λ x → times x m) (sym (plus-suc K i))) (cong (λ x → times x m) (snd hi)))))
  in (plus (times K m) J , concat (plus-assoc (times K m) J (suc (plus im j))) (concat (cong (plus (times K m)) inner) outer))
index2 : (n m : Nat) → Array2 n m → (i j : Nat) → le (suc i) n → le (suc j) m → Int64
index2 n m a i j hi hj = index (times n m) a (plus (times i m) j) (idx2-fits n m i j hi hj)
update2 : (n m : Nat) → Array2 n m → (i j : Nat) → le (suc i) n → le (suc j) m → Int64 → Array2 n m
update2 n m a i j hi hj v = update (times n m) a (plus (times i m) j) (idx2-fits n m i j hi hj) v
index2-update2 : (n m : Nat) → (a : Array2 n m) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) m) → (v : Int64) → index2 n m (update2 n m a i j hi hj v) i j hi hj ≡ v
index2-update2 n m a i j hi hj v = index-update (times n m) a (plus (times i m) j) (idx2-fits n m i j hi hj) v

-- ---------------------------------------------------------------- Fin n → A beyond Int64 (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.10 “C20–C22 — Memory and state”, its part C22, and §12 “The build list”, “C. Memory and state”, item 22)
-- UInt32 elements: the 4-byte layer, the Int64 development at width 4 (two more trusted laws of
-- the byte layer: a 32-bit load disjoint from a store, and 32-bit arrays determined by their
-- elements); UInt32 is not equivalent to Int64, so it has its own layer
Array32 : Nat → Type
Array32 n = Bytes (times n 4)
anew32 : (n : Nat) → Array32 n
anew32 n = bytes (times n 4)
fits-eq32 : (k i : Nat) → plus (times k 4) (plus (times i 4) 4) ≡ times (plus k (suc i)) 4
fits-eq32 k i =
  calc plus (times k 4) (plus (times i 4) 4) ≡ plus (times k 4) (times (suc i) 4) by (λ j → plus (times k 4) (plus-comm (times i 4) 4 j))
                                             ≡ times (plus k (suc i)) 4 by sym (times-distr k (suc i) 4)
index-fits32 : (n i : Nat) → le (suc i) n → le (plus (times i 4) 4) (times n 4)
index-fits32 n i h = (times (fst h) 4 , concat (fits-eq32 (fst h) i) (cong (λ m → times m 4) (snd h)))
index32 : (n : Nat) → Array32 n → (i : Nat) → le (suc i) n → UInt32
index32 n a i h = load32 (times n 4) a (times i 4) (index-fits32 n i h)
update32 : (n : Nat) → Array32 n → (i : Nat) → le (suc i) n → UInt32 → Array32 n
update32 n a i h v = store32 (times n 4) a (times i 4) (index-fits32 n i h) v
tab-go32 : (n : Nat) → (Nat → UInt32) → (m : Nat) → le m n → Array32 n → Array32 n
tab-go32 n f zero h a = a
tab-go32 n f (suc m) h a = tab-go32 n f m (le-pred m n h) (update32 n a m h (f m))
tabulate32 : (n : Nat) → (Nat → UInt32) → Array32 n
tabulate32 n f = tab-go32 n f n (le-refl n) (anew32 n)
index-update32 : (n : Nat) → (a : Array32 n) → (i : Nat) → (h : le (suc i) n) → (v : UInt32) → index32 n (update32 n a i h v) i h ≡ v
index-update32 n a i h v = load32-store32 (times n 4) a (times i 4) (index-fits32 n i h) v
primitive load32-store32-disj : (n : Nat) → (b : Bytes n) → (o1 o2 : Nat) → (h1 : le (plus o1 4) n) → (h2 : le (plus o2 4) n) → (v : UInt32) → Sum (le (plus o1 4) o2) (le (plus o2 4) o1) → PathP (λ (i : I) → UInt32) (load32 n (store32 n b o1 h1 v) o2 h2) (load32 n b o2 h2)
primitive array32-ext : (n : Nat) → (a b : Array32 n) → ((i : Nat) → (h : le (suc i) n) → PathP (λ (j : I) → UInt32) (index32 n a i h) (index32 n b i h)) → PathP (λ (i : I) → Array32 n) a b
aindex32 : (n : Nat) → Array32 n → Fin n → UInt32
aindex32 n a p = index32 n a (fst p) (snd p)
tabF-go32 : (n : Nat) → (Fin n → UInt32) → (m : Nat) → le m n → Array32 n → Array32 n
tabF-go32 n f zero h a = a
tabF-go32 n f (suc m) h a = tabF-go32 n f m (le-pred m n h) (update32 n a m h (f (m , h)))
atab32 : (n : Nat) → (Fin n → UInt32) → Array32 n
atab32 n f = tabF-go32 n f n (le-refl n) (anew32 n)
index-update-ne32 : (n : Nat) → (a : Array32 n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : UInt32) → Sum (le (suc i) j) (le (suc j) i) → index32 n (update32 n a i hi v) j hj ≡ index32 n a j hj
index-update-ne32 n a i j hi hj v d = load32-store32-disj (times n 4) a (times i 4) (times j 4) (index-fits32 n i hi) (index-fits32 n j hj) v (case d of inl l → inl (index-fits32 j i l); inr l → inr (index-fits32 i j l))
go-above32 : (n : Nat) → (f : Fin n → UInt32) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array32 n) → le m j → index32 n (tabF-go32 n f m h a) j hj ≡ index32 n a j hj
go-above32 n f zero j h hj a l = λ i → index32 n a j hj
go-above32 n f (suc m) j h hj a l = concat (go-above32 n f m j (le-pred m n h) hj (update32 n a m h (f (m , h))) (le-pred m j l)) (index-update-ne32 n a m j h hj (f (m , h)) (inl l))
go-below-last32 : (n : Nat) → (f : Fin n → UInt32) → (m j : Nat) → (h : le (suc m) n) → (hj : le (suc j) n) → (a : Array32 n) → j ≡ m → index32 n (update32 n a m h (f (m , h))) j hj ≡ f (j , hj)
go-below-last32 n f m j h hj a e =
  let q = fin-eq n j m hj h e
  in concat (cong {lzero} {lzero} {Fin n} {UInt32} (λ p → index32 n (update32 n a m h (f (m , h))) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)
            (concat (index-update32 n a m h (f (m , h))) (cong {lzero} {lzero} {Fin n} {UInt32} f {(m , h)} {(j , hj)} (sym {lzero} {Fin n} {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)))
go-below32 : (n : Nat) → (f : Fin n → UInt32) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array32 n) → le (suc j) m → index32 n (tabF-go32 n f m h a) j hj ≡ f (j , hj)
go-below32 n f zero j h hj a l = Empty-rec (le-suc-zero j l)
go-below32 n f (suc m) j h hj a l =
  case le-split j m l of
    inl l2 → go-below32 n f m j (le-pred m n h) hj (update32 n a m h (f (m , h))) l2
    inr e → concat (go-above32 n f m j (le-pred m n h) hj (update32 n a m h (f (m , h))) (subst {lzero} {lzero} {Nat} {λ x → le m x} {m} {j} (sym {lzero} {Nat} {j} {m} e) (le-refl m)))
                   (go-below-last32 n f m j h hj a e)
index-tabulate32 : (n : Nat) → (f : Fin n → UInt32) → (p : Fin n) → aindex32 n (atab32 n f) p ≡ f p
index-tabulate32 n f p = go-below32 n f n (fst p) (le-refl n) (snd p) (anew32 n) (snd p)
tabulate-index32 : (n : Nat) → (a : Array32 n) → atab32 n (aindex32 n a) ≡ a
tabulate-index32 n a = array32-ext n (atab32 n (aindex32 n a)) a (λ i h → index-tabulate32 n (aindex32 n a) (i , h))
index-update-eq32 : (n : Nat) → (a : Array32 n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : UInt32) → i ≡ j → index32 n (update32 n a i hi v) j hj ≡ v
index-update-eq32 n a i j hi hj v e =
  concat (cong {lzero} {lzero} {Fin n} {UInt32} (λ p → index32 n (update32 n a i hi v) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (i , hi)} (fin-eq n j i hj hi (sym {lzero} {Nat} {i} {j} e)))
         (index-update32 n a i hi v)
index-update-if32 : (n : Nat) → (a : Array32 n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : UInt32) → index32 n (update32 n a i hi v) j hj ≡ (if eqb i j then v else index32 n a j hj)
index-update-if32 n a i j hi hj v =
  ifP {λ b → index32 n (update32 n a i hi v) j hj ≡ (if b then v else index32 n a j hj)} {eqb i j}
    (λ e → index-update-eq32 n a i j hi hj v (eqb-sound {i} {j} (eq→isTrue {eqb i j} e)))
    (λ e → index-update-ne32 n a i j hi hj v
             (case trich i j of
                inl l → inl l
                inr m → (case m of
                           inl q → Empty-rec (subst {lzero} {lzero} {Bool} {isTrue} {eqb i j} {false} e (eqb-complete {i} {j} q))
                           inr l → inr l)))
Fin→Array32 : (n : Nat) → Equiv (Fin n → UInt32) (Array32 n)
Fin→Array32 n = isoToEquiv {lzero} {Fin n → UInt32} {Array32 n} (atab32 n) (aindex32 n) (tabulate-index32 n) (λ f → funExt {lzero} {lzero} {Fin n} {UInt32} {aindex32 n (atab32 n f)} {f} (index-tabulate32 n f))
fin-set32 : (n : Nat) → (Fin n → UInt32) → Fin n → UInt32 → Fin n → UInt32
fin-set32 n f p v = λ q → if eqb (fst p) (fst q) then v else f q
apply-by32 : (n : Nat) → (f : Fin n → UInt32) → (p : Fin n) → aindex32 n (atab32 n f) p ≡ f p
apply-by32 n f p = index-tabulate32 n f p
fin-set-by32 : (n : Nat) → (f : Fin n → UInt32) → (i : Nat) → (h : le (suc i) n) → (v : UInt32) →
  atab32 n (fin-set32 n f (i , h) v) ≡ update32 n (atab32 n f) i h v
fin-set-by32 n f i h v = array32-ext n (atab32 n (fin-set32 n f (i , h) v)) (update32 n (atab32 n f) i h v)
  (λ j hj → concat {lzero} {UInt32} {index32 n (atab32 n (fin-set32 n f (i , h) v)) j hj} {if eqb i j then v else f (j , hj)} {index32 n (update32 n (atab32 n f) i h v) j hj}
     (index-tabulate32 n (fin-set32 n f (i , h) v) (j , hj))
     (sym {lzero} {UInt32} {index32 n (update32 n (atab32 n f) i h v) j hj} {if eqb i j then v else f (j , hj)}
        (concat {lzero} {UInt32} {index32 n (update32 n (atab32 n f) i h v) j hj} {if eqb i j then v else index32 n (atab32 n f) j hj} {if eqb i j then v else f (j , hj)}
           (index-update-if32 n (atab32 n f) i j h hj v)
           (λ k → if eqb i j then v else index-tabulate32 n f (j , hj) k))))
tabulate-by32 : (n : Nat) → (a : Array32 n) → atab32 n (aindex32 n a) ≡ a
tabulate-by32 n a = tabulate-index32 n a
-- A stored by the Int64 layer through an equivalence A ≃ Int64, given as its maps and their laws:
-- Float64 by its bits (f64bits, f64ofbits). Arrays of A are Arrays; index is from after index, update is
-- update at to (store64); every law carried from Int64's
if-map : (A B : Type) → (g : A → B) → (b : Bool) → (x y : A) → g (if b then x else y) ≡ (if b then g x else g y)
if-map A B g b x y = case b return (λ c → g (if c then x else y) ≡ (if c then g x else g y)) of
    true → λ i → g x
    false → λ i → g y
fin-setA : (A : Type) → (n : Nat) → (Fin n → A) → Fin n → A → Fin n → A
fin-setA A n f p v = λ q → if eqb (fst p) (fst q) then v else f q
indexV : (A : Type) → (Int64 → A) → (n : Nat) → Array n → (i : Nat) → le (suc i) n → A
indexV A from n a i h = from (index n a i h)
updateV : (A : Type) → (A → Int64) → (n : Nat) → Array n → (i : Nat) → le (suc i) n → A → Array n
updateV A to n a i h v = update n a i h (to v)
aindexV : (A : Type) → (Int64 → A) → (n : Nat) → Array n → Fin n → A
aindexV A from n a p = from (aindex n a p)
atabV : (A : Type) → (A → Int64) → (n : Nat) → (Fin n → A) → Array n
atabV A to n f = atab n (λ p → to (f p))
index-updateV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (a : Array n) → (i : Nat) → (h : le (suc i) n) → (v : A) → indexV A from n (updateV A to n a i h v) i h ≡ v
index-updateV A to from ft n a i h v =
  concat {lzero} {A} {from (index n (update n a i h (to v)) i h)} {from (to v)} {v}
    (cong {lzero} {lzero} {Int64} {A} from {index n (update n a i h (to v)) i h} {to v} (index-update n a i h (to v))) (ft v)
index-update-neV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : A) → Sum (le (suc i) j) (le (suc j) i) → indexV A from n (updateV A to n a i hi v) j hj ≡ indexV A from n a j hj
index-update-neV A to from n a i j hi hj v d =
  cong {lzero} {lzero} {Int64} {A} from {index n (update n a i hi (to v)) j hj} {index n a j hj} (index-update-ne n a i j hi hj (to v) d)
index-tabulateV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (f : Fin n → A) → (p : Fin n) → aindexV A from n (atabV A to n f) p ≡ f p
index-tabulateV A to from ft n f p =
  concat {lzero} {A} {from (aindex n (atab n (λ q → to (f q))) p)} {from (to (f p))} {f p}
    (cong {lzero} {lzero} {Int64} {A} from {aindex n (atab n (λ q → to (f q))) p} {to (f p)} (index-tabulate n (λ q → to (f q)) p)) (ft (f p))
tabulate-indexV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → ((w : Int64) → to (from w) ≡ w) → (n : Nat) → (a : Array n) → atabV A to n (aindexV A from n a) ≡ a
tabulate-indexV A to from tf n a = array-ext n (atab n (λ q → to (from (aindex n a q)))) a
  (λ i h → concat {lzero} {Int64} {index n (atab n (λ q → to (from (aindex n a q)))) i h} {to (from (index n a i h))} {index n a i h}
             (index-tabulate n (λ q → to (from (aindex n a q))) (i , h)) (tf (index n a i h)))
Fin→ArrayV : (A : Type) → (to : A → Int64) → (from : Int64 → A) → ((v : A) → from (to v) ≡ v) → ((w : Int64) → to (from w) ≡ w) → (n : Nat) → Equiv (Fin n → A) (Array n)
Fin→ArrayV A to from ft tf n = isoToEquiv {lzero} {Fin n → A} {Array n} (atabV A to n) (aindexV A from n) (tabulate-indexV A to from tf n)
  (λ f → funExt {lzero} {lzero} {Fin n} {A} {aindexV A from n (atabV A to n f)} {f} (index-tabulateV A to from ft n f))
-- the functional update is update at to
fin-set-byV : (A : Type) → (to : A → Int64) → (n : Nat) → (f : Fin n → A) → (i : Nat) → (h : le (suc i) n) → (v : A) →
  atabV A to n (fin-setA A n f (i , h) v) ≡ updateV A to n (atabV A to n f) i h v
fin-set-byV A to n f i h v = array-ext n (atab n (λ q → to (fin-setA A n f (i , h) v q))) (update n (atab n (λ q → to (f q))) i h (to v))
  (λ j hj → concat {lzero} {Int64} {index n (atab n (λ q → to (fin-setA A n f (i , h) v q))) j hj} {if eqb i j then to v else to (f (j , hj))} {index n (update n (atab n (λ q → to (f q))) i h (to v)) j hj}
     (concat {lzero} {Int64} {index n (atab n (λ q → to (fin-setA A n f (i , h) v q))) j hj} {to (if eqb i j then v else f (j , hj))} {if eqb i j then to v else to (f (j , hj))}
        (index-tabulate n (λ q → to (fin-setA A n f (i , h) v q)) (j , hj))
        (if-map A Int64 to (eqb i j) v (f (j , hj))))
     (sym {lzero} {Int64} {index n (update n (atab n (λ q → to (f q))) i h (to v)) j hj} {if eqb i j then to v else to (f (j , hj))}
        (concat {lzero} {Int64} {index n (update n (atab n (λ q → to (f q))) i h (to v)) j hj} {if eqb i j then to v else index n (atab n (λ q → to (f q))) j hj} {if eqb i j then to v else to (f (j , hj))}
           (index-update-if n (atab n (λ q → to (f q))) i j h hj (to v))
           (λ k → if eqb i j then to v else index-tabulate n (λ q → to (f q)) (j , hj) k))))
-- Float64 elements, by their bits
indexF : (n : Nat) → Array n → (i : Nat) → le (suc i) n → Float64
indexF n a i h = indexV Float64 f64ofbits n a i h
updateF : (n : Nat) → Array n → (i : Nat) → le (suc i) n → Float64 → Array n
updateF n a i h v = updateV Float64 f64bits n a i h v
atabF : (n : Nat) → (Fin n → Float64) → Array n
atabF n f = atabV Float64 f64bits n f
aindexF : (n : Nat) → Array n → Fin n → Float64
aindexF n a p = aindexV Float64 f64ofbits n a p
index-updateF : (n : Nat) → (a : Array n) → (i : Nat) → (h : le (suc i) n) → (v : Float64) → indexF n (updateF n a i h v) i h ≡ v
index-updateF n a i h v = index-updateV Float64 f64bits f64ofbits f64ofbits-bits n a i h v
Fin→ArrayF : (n : Nat) → Equiv (Fin n → Float64) (Array n)
Fin→ArrayF n = Fin→ArrayV Float64 f64bits f64ofbits f64ofbits-bits f64bits-ofbits n
fin-set-byF : (n : Nat) → (f : Fin n → Float64) → (i : Nat) → (h : le (suc i) n) → (v : Float64) →
  atabF n (fin-setA Float64 n f (i , h) v) ≡ updateF n (atabF n f) i h v
fin-set-byF n f i h v = fin-set-byV Float64 f64bits n f i h v

-- A stored by the UInt32 layer through an equivalence A ≃ UInt32: the same development on Array32
indexV32 : (A : Type) → (UInt32 → A) → (n : Nat) → Array32 n → (i : Nat) → le (suc i) n → A
indexV32 A from n a i h = from (index32 n a i h)
updateV32 : (A : Type) → (A → UInt32) → (n : Nat) → Array32 n → (i : Nat) → le (suc i) n → A → Array32 n
updateV32 A to n a i h v = update32 n a i h (to v)
aindexV32 : (A : Type) → (UInt32 → A) → (n : Nat) → Array32 n → Fin n → A
aindexV32 A from n a p = from (aindex32 n a p)
atabV32 : (A : Type) → (A → UInt32) → (n : Nat) → (Fin n → A) → Array32 n
atabV32 A to n f = atab32 n (λ p → to (f p))
index-updateV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (a : Array32 n) → (i : Nat) → (h : le (suc i) n) → (v : A) → indexV32 A from n (updateV32 A to n a i h v) i h ≡ v
index-updateV32 A to from ft n a i h v =
  concat {lzero} {A} {from (index32 n (update32 n a i h (to v)) i h)} {from (to v)} {v}
    (cong {lzero} {lzero} {UInt32} {A} from {index32 n (update32 n a i h (to v)) i h} {to v} (index-update32 n a i h (to v))) (ft v)
index-update-neV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → (n : Nat) → (a : Array32 n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : A) → Sum (le (suc i) j) (le (suc j) i) → indexV32 A from n (updateV32 A to n a i hi v) j hj ≡ indexV32 A from n a j hj
index-update-neV32 A to from n a i j hi hj v d =
  cong {lzero} {lzero} {UInt32} {A} from {index32 n (update32 n a i hi (to v)) j hj} {index32 n a j hj} (index-update-ne32 n a i j hi hj (to v) d)
index-tabulateV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → ((v : A) → from (to v) ≡ v) → (n : Nat) → (f : Fin n → A) → (p : Fin n) → aindexV32 A from n (atabV32 A to n f) p ≡ f p
index-tabulateV32 A to from ft n f p =
  concat {lzero} {A} {from (aindex32 n (atab32 n (λ q → to (f q))) p)} {from (to (f p))} {f p}
    (cong {lzero} {lzero} {UInt32} {A} from {aindex32 n (atab32 n (λ q → to (f q))) p} {to (f p)} (index-tabulate32 n (λ q → to (f q)) p)) (ft (f p))
tabulate-indexV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → ((w : UInt32) → to (from w) ≡ w) → (n : Nat) → (a : Array32 n) → atabV32 A to n (aindexV32 A from n a) ≡ a
tabulate-indexV32 A to from tf n a = array32-ext n (atab32 n (λ q → to (from (aindex32 n a q)))) a
  (λ i h → concat {lzero} {UInt32} {index32 n (atab32 n (λ q → to (from (aindex32 n a q)))) i h} {to (from (index32 n a i h))} {index32 n a i h}
             (index-tabulate32 n (λ q → to (from (aindex32 n a q))) (i , h)) (tf (index32 n a i h)))
Fin→ArrayV32 : (A : Type) → (to : A → UInt32) → (from : UInt32 → A) → ((v : A) → from (to v) ≡ v) → ((w : UInt32) → to (from w) ≡ w) → (n : Nat) → Equiv (Fin n → A) (Array32 n)
Fin→ArrayV32 A to from ft tf n = isoToEquiv {lzero} {Fin n → A} {Array32 n} (atabV32 A to n) (aindexV32 A from n) (tabulate-indexV32 A to from tf n)
  (λ f → funExt {lzero} {lzero} {Fin n} {A} {aindexV32 A from n (atabV32 A to n f)} {f} (index-tabulateV32 A to from ft n f))
-- the functional update32 is update32 at to
fin-set-byV32 : (A : Type) → (to : A → UInt32) → (n : Nat) → (f : Fin n → A) → (i : Nat) → (h : le (suc i) n) → (v : A) →
  atabV32 A to n (fin-setA A n f (i , h) v) ≡ updateV32 A to n (atabV32 A to n f) i h v
fin-set-byV32 A to n f i h v = array32-ext n (atab32 n (λ q → to (fin-setA A n f (i , h) v q))) (update32 n (atab32 n (λ q → to (f q))) i h (to v))
  (λ j hj → concat {lzero} {UInt32} {index32 n (atab32 n (λ q → to (fin-setA A n f (i , h) v q))) j hj} {if eqb i j then to v else to (f (j , hj))} {index32 n (update32 n (atab32 n (λ q → to (f q))) i h (to v)) j hj}
     (concat {lzero} {UInt32} {index32 n (atab32 n (λ q → to (fin-setA A n f (i , h) v q))) j hj} {to (if eqb i j then v else f (j , hj))} {if eqb i j then to v else to (f (j , hj))}
        (index-tabulate32 n (λ q → to (fin-setA A n f (i , h) v q)) (j , hj))
        (if-map A UInt32 to (eqb i j) v (f (j , hj))))
     (sym {lzero} {UInt32} {index32 n (update32 n (atab32 n (λ q → to (f q))) i h (to v)) j hj} {if eqb i j then to v else to (f (j , hj))}
        (concat {lzero} {UInt32} {index32 n (update32 n (atab32 n (λ q → to (f q))) i h (to v)) j hj} {if eqb i j then to v else index32 n (atab32 n (λ q → to (f q))) j hj} {if eqb i j then to v else to (f (j , hj))}
           (index-update-if32 n (atab32 n (λ q → to (f q))) i j h hj (to v))
           (λ k → if eqb i j then to v else index-tabulate32 n (λ q → to (f q)) (j , hj) k))))
-- Float32 elements, by their bits on the 4-byte layer (Array32, store32: in place when unique)
indexF32 : (n : Nat) → Array32 n → (i : Nat) → le (suc i) n → Float32
indexF32 n a i h = indexV32 Float32 f32ofbits n a i h
updateF32 : (n : Nat) → Array32 n → (i : Nat) → le (suc i) n → Float32 → Array32 n
updateF32 n a i h v = updateV32 Float32 f32bits n a i h v
atabF32 : (n : Nat) → (Fin n → Float32) → Array32 n
atabF32 n f = atabV32 Float32 f32bits n f
aindexF32 : (n : Nat) → Array32 n → Fin n → Float32
aindexF32 n a p = aindexV32 Float32 f32ofbits n a p
index-updateF32 : (n : Nat) → (a : Array32 n) → (i : Nat) → (h : le (suc i) n) → (v : Float32) → indexF32 n (updateF32 n a i h v) i h ≡ v
index-updateF32 n a i h v = index-updateV32 Float32 f32bits f32ofbits f32ofbits-bits n a i h v
Fin→ArrayF32 : (n : Nat) → Equiv (Fin n → Float32) (Array32 n)
Fin→ArrayF32 n = Fin→ArrayV32 Float32 f32bits f32ofbits f32ofbits-bits f32bits-ofbits n
fin-set-byF32 : (n : Nat) → (f : Fin n → Float32) → (i : Nat) → (h : le (suc i) n) → (v : Float32) →
  atabF32 n (fin-setA Float32 n f (i , h) v) ≡ updateF32 n (atabF32 n f) i h v
fin-set-byF32 n f i h v = fin-set-byV32 Float32 f32bits n f i h v

-- ---------------------------------------------------------------- Nat and Word: addition on words is addition
-- on numbers across the equivalence (fromNat, toNat)
toNat-plusw : (a b : Nat) → toNat (plusw (fromNat a) (fromNat b)) ≡ plus a b
toNat-plusw a b = case b return (λ y → toNat (plusw (fromNat a) (fromNat y)) ≡ plus a y) of
    zero → concat (toNat-fromNat a) (sym (plus-zero a))
    suc k → concat (λ i → suc (rec k i)) (sym (plus-suc a k))
-- read right to left it is a rule of the specializer (#jit … using toNat-wadd): plus becomes wadd,
-- the machine's addition, along the path
toNat-wadd : (a b : Nat) → toNat (wadd (fromNat a) (fromNat b)) ≡ plus a b
toNat-wadd a b = concat (λ i → toNat (plusw≡wadd (fromNat a) (fromNat b) (~ i))) (toNat-plusw a b)
