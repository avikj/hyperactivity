-- lib/foproofe.cub — the first-order form's checked meaning, on its own (split from lib/foproofq.cub so
-- the back-end links, lib/foproofc.cub and lib/foproofx.cub, load it without the printers' proofs):
-- KQ, the values lib/fo.cub's eval-fo computes, as checked data; q-prim, its primitives; evq, the
-- checked evaluator by fuel, mirroring eval-fo construct by construct. lib/foproofq.cub proves the
-- printers into FQ right against evq; tests/foproofq.cub shows evq and eval-fo agree.
-- Loaded after lib/foproofd.cub.
-- ---------------------------------------------------------------- values
-- lib/fo.cub's FV, as the mirrors model them: a word; an Int64 and a Float64 by the word of their bits
-- (the machine's operation between the conversions, as the mirrors' primitives are); a constructor of
-- data type d with its fields (a chain); a closure (a definition's key over its captures); a λ over its
-- environment; a byte string as the mirrors' stores (BL); chains (kqnil, kqcons) for lists and
-- environments; kqbot no value (out of fuel, or a form applied to what it does not take, where eval-fo
-- answers a default: the reference meaning is the stricter one)
data KQ = kqw (w : Word) | kqi (b : Word) | kqf (b : Word) | kqcon (d : Word) (c : Word) (fs : KQ) | kqclos (g : Word) (env : KQ) | kqlam (b : FQ) (env : KQ) | kqb (l : BL) | kqnil | kqcons (x : KQ) (r : KQ) | kqbot
-- the n-th of a chain (variable n of an environment, innermost first)
q-nth : KQ → Nat → KQ
q-nth (kqcons x r) zero = x
q-nth (kqcons x r) (suc k) = q-nth r k
q-nth kqnil k = kqbot
q-nth (kqw w) k = kqbot
q-nth (kqi b) k = kqbot
q-nth (kqf b) k = kqbot
q-nth (kqcon d c fs) k = kqbot
q-nth (kqclos g env) k = kqbot
q-nth (kqlam b env) k = kqbot
q-nth (kqb l) k = kqbot
q-nth kqbot k = kqbot
-- lib/fo.cub's push-all: a chain's values pushed in order, the last innermost
q-push : KQ → KQ → KQ
q-push (kqcons v r) e = q-push r (kqcons v e)
q-push kqnil e = e
q-push (kqw w) e = e
q-push (kqi b) e = e
q-push (kqf b) e = e
q-push (kqcon d c fs) e = e
q-push (kqclos g env) e = e
q-push (kqlam b env) e = e
q-push (kqb l) e = e
q-push kqbot e = e
-- a chain of exactly n values
q-isn : Nat → KQ → Bool
q-isn zero kqnil = true
q-isn (suc m) (kqcons x r) = q-isn m r
q-isn zero (kqcons x r) = false
q-isn (suc m) kqnil = false
q-isn n (kqw w) = false
q-isn n (kqi b) = false
q-isn n (kqf b) = false
q-isn n (kqcon d c fs) = false
q-isn n (kqclos g env) = false
q-isn n (kqlam b env) = false
q-isn n (kqb l) = false
q-isn n kqbot = false
-- a chain of fields as the mirrors' tuple: pairs (constructor 0 of data type 0, two fields) ending in 0
q-tupv : KQ → KQ
q-tupv kqnil = kqw #0
q-tupv (kqcons x r) = kqcon #0 #0 (kqcons x (kqcons (q-tupv r) kqnil))
q-tupv (kqw w) = kqbot
q-tupv (kqi b) = kqbot
q-tupv (kqf b) = kqbot
q-tupv (kqcon d c fs) = kqbot
q-tupv (kqclos g env) = kqbot
q-tupv (kqlam b env) = kqbot
q-tupv (kqb l) = kqbot
q-tupv kqbot = kqbot
-- ---------------------------------------------------------------- the primitives
-- lib/fo.cub's prim-ap, prim-num and prim-bytes on the values above, each on the kinds it takes
-- (Int64 and Float64 by their bits: the mirrors' dbi/dib/dbf/dfb between the bits and the machine's
-- values, so each clause is the mirrors' own dprim2/dprim1 clause)
q-ww : (Word → Word → Word) → KQ → KQ
q-ww f (kqcons (kqw a) (kqcons (kqw b) kqnil)) = kqw (f a b)
q-ww f v = kqbot
q-ii : (Word → Word → Word) → KQ → KQ
q-ii f (kqcons (kqi a) (kqcons (kqi b) kqnil)) = kqi (f a b)
q-ii f v = kqbot
q-iw : (Word → Word → Word) → KQ → KQ
q-iw f (kqcons (kqi a) (kqcons (kqi b) kqnil)) = kqw (f a b)
q-iw f v = kqbot
q-ff : (Word → Word → Word) → KQ → KQ
q-ff f (kqcons (kqf a) (kqcons (kqf b) kqnil)) = kqf (f a b)
q-ff f v = kqbot
q-fw : (Word → Word → Word) → KQ → KQ
q-fw f (kqcons (kqf a) (kqcons (kqf b) kqnil)) = kqw (f a b)
q-fw f v = kqbot
q-1 : (KQ → KQ) → KQ → KQ
q-1 f (kqcons a kqnil) = f a
q-1 f v = kqbot
-- the unary conversions
q-i-of-w : KQ → KQ
q-i-of-w (kqw w) = kqi w
q-i-of-w v = kqbot
q-w-of-i : KQ → KQ
q-w-of-i (kqi b) = kqw b
q-w-of-i v = kqbot
q-f-of-i : KQ → KQ
q-f-of-i (kqi b) = kqf (dfb (f64ofi64 (dbi b)))
q-f-of-i v = kqbot
q-i-of-f : KQ → KQ
q-i-of-f (kqf b) = kqi (dib (i64off64 (dbf b)))
q-i-of-f v = kqbot
q-f-of-w : KQ → KQ
q-f-of-w (kqw w) = kqf (dfb (f64 w))
q-f-of-w v = kqbot
q-bits : KQ → KQ
q-bits (kqf b) = kqi b
q-bits v = kqbot
q-ofbits : KQ → KQ
q-ofbits (kqi b) = kqf b
q-ofbits v = kqbot
-- the byte layer: a fresh string of n zero bytes, its length, the loads (64 bits as an Int64, 32 as a
-- word) and the stores (an Int64's bits, a word's low 32)
qk-bytes : KQ → KQ
qk-bytes (kqw n) = kqb (blm n bzero)
qk-bytes v = kqbot
q-blen : KQ → KQ
q-blen (kqb l) = kqw (bl-len l)
q-blen v = kqbot
q-ld8 : KQ → KQ
q-ld8 (kqcons (kqb l) (kqcons (kqw o) kqnil)) = kqi (bl-ld #8 o l)
q-ld8 v = kqbot
q-ld4 : KQ → KQ
q-ld4 (kqcons (kqb l) (kqcons (kqw o) kqnil)) = kqw (bl-ld #4 o l)
q-ld4 v = kqbot
q-st8 : KQ → KQ
q-st8 (kqcons (kqb l) (kqcons (kqw o) (kqcons (kqi v) kqnil))) = kqb (bl-st #8 o v l)
q-st8 v = kqbot
q-st4 : KQ → KQ
q-st4 (kqcons (kqb l) (kqcons (kqw o) (kqcons (kqw v) kqnil))) = kqb (bl-st #4 o v l)
q-st4 v = kqbot
q-prim : Word → KQ → KQ
q-prim p as =
  if weq p #0 then q-ww wadd as
  else if weq p #1 then q-ww wsub as
  else if weq p #2 then q-ww dmulw as
  else if weq p #3 then q-ww (λ a b → dbw (weq a b)) as
  else if weq p #4 then q-ww (λ a b → dbw (wlt a b)) as
  else if weq p #8 then q-ld8 as
  else if weq p #9 then q-st8 as
  else if weq p #10 then q-ld4 as
  else if weq p #11 then q-st4 as
  else if weq p #12 then q-1 qk-bytes as
  else if weq p #13 then q-1 q-blen as
  else if weq p #14 then q-ii (λ a b → dib (i64add (dbi a) (dbi b))) as
  else if weq p #15 then q-ii (λ a b → dib (i64sub (dbi a) (dbi b))) as
  else if weq p #16 then q-ii (λ a b → dib (i64mul (dbi a) (dbi b))) as
  else if weq p #17 then q-iw (λ a b → dbw (i64eq (dbi a) (dbi b))) as
  else if weq p #18 then q-iw (λ a b → dbw (i64lt (dbi a) (dbi b))) as
  else if weq p #19 then q-ff (λ a b → dfb (f64add (dbf a) (dbf b))) as
  else if weq p #20 then q-ff (λ a b → dfb (f64sub (dbf a) (dbf b))) as
  else if weq p #21 then q-ff (λ a b → dfb (f64mul (dbf a) (dbf b))) as
  else if weq p #22 then q-ff (λ a b → dfb (f64div (dbf a) (dbf b))) as
  else if weq p #23 then q-fw (λ a b → dbw (f64eq (dbf a) (dbf b))) as
  else if weq p #24 then q-fw (λ a b → dbw (f64lt (dbf a) (dbf b))) as
  else if weq p #25 then q-1 q-i-of-w as
  else if weq p #26 then q-1 q-w-of-i as
  else if weq p #27 then q-1 q-f-of-i as
  else if weq p #28 then q-1 q-i-of-f as
  else if weq p #29 then q-1 q-f-of-w as
  else if weq p #32 then q-1 q-bits as
  else if weq p #33 then q-1 q-ofbits as
  else kqbot
-- ---------------------------------------------------------------- the evaluator
-- fuel is spent where eval-fo may not end — entering a definition (a call, a closure applied) and each
-- turn of a loop — and nowhere else: QE is the evaluator one unit of fuel down (a form's meaning and a
-- loop's run from a state), evT the evaluation of every other form, by structure, over it
data QE = qe (ev : FQ → KQ → KQ) (lp : KQ → FQ → KQ → KQ)
qe-ev : QE → FQ → KQ → KQ
qe-ev (qe f l) = f
qe-lp : QE → KQ → FQ → KQ → KQ
qe-lp (qe f l) = l
-- a function value applied to one argument: a closure's definition over the argument then its captures
-- (pushed, as apply-args does), a λ's body over the argument and its environment
q-ap1 : (Word → FQ) → QE → KQ → KQ → KQ
q-ap1 G k (kqclos g env) a = qe-ev k (G g) (kqcons a (q-push env kqnil))
q-ap1 G k (kqlam b env) a = qe-ev k b (kqcons a env)
q-ap1 G k (kqw w) a = kqbot
q-ap1 G k (kqi b) a = kqbot
q-ap1 G k (kqf b) a = kqbot
q-ap1 G k (kqcon d c fs) a = kqbot
q-ap1 G k (kqb l) a = kqbot
q-ap1 G k kqnil a = kqbot
q-ap1 G k (kqcons x r) a = kqbot
q-ap1 G k kqbot a = kqbot
-- applied to a chain of arguments, one at a time
q-app : (Word → FQ) → QE → KQ → KQ → KQ
q-app G k (kqcons a r) f = q-app G k r (q-ap1 G k f a)
q-app G k kqnil f = f
q-app G k (kqw w) f = f
q-app G k (kqi b) f = f
q-app G k (kqf b) f = f
q-app G k (kqcon d c fs) f = f
q-app G k (kqclos g env) f = f
q-app G k (kqlam b env) f = f
q-app G k (kqb l) f = f
q-app G k kqbot f = f
-- an alternative of a switch, the scrutinee's value on top of the environment: the first whose tag is
-- the constructor's, its fields (exactly n of them) pushed; otherwise the rest
q-altsel : Word → Nat → (KQ → KQ) → KQ → KQ → KQ
q-altsel j n fb rest e =
  case e of
    kqcons v e2 → (case v of
                     kqcon d c fs → (if weq c j then (if q-isn n fs then fb (q-push fs e2) else kqbot) else rest)
                     _ → kqbot)
    _ → kqbot
-- a word condition, nonzero true (as the mirrors' tv-if)
q-if : KQ → KQ → KQ → KQ
q-if (kqw w) a b = %welimP (λ u → KQ) w b (λ m h → a)
q-if (kqi x) a b = kqbot
q-if (kqf x) a b = kqbot
q-if (kqcon d c fs) a b = kqbot
q-if (kqclos g env) a b = kqbot
q-if (kqlam t env) a b = kqbot
q-if (kqb l) a b = kqbot
q-if kqnil a b = kqbot
q-if (kqcons x r) a b = kqbot
q-if kqbot a b = kqbot
-- field j of a constructor
q-proj : Word → KQ → KQ
q-proj j (kqcon d c fs) = q-nth fs (dnat j)
q-proj j (kqw w) = kqbot
q-proj j (kqi b) = kqbot
q-proj j (kqf b) = kqbot
q-proj j (kqclos g env) = kqbot
q-proj j (kqlam b env) = kqbot
q-proj j (kqb l) = kqbot
q-proj j kqnil = kqbot
q-proj j (kqcons x r) = kqbot
q-proj j kqbot = kqbot
-- a loop's body has answered: constructor tag 0 continues with its fields as the state, any other tag
-- breaks with its first field (lib/fo.cub's run-loop)
q-lstep : KQ → (KQ → KQ) → KQ
q-lstep v cont = case v of
  kqcon d c fs → (if weq c #0 then cont fs else q-nth fs zero)
  _ → kqbot
evT : (Word → FQ) → QE → FQ → KQ → KQ
evT G k (fql w) e = kqw w
evT G k (fqv n) e = q-nth e n
evT G k (fqprim p as) e = q-prim p (evT G k as e)
evT G k (fqlet a b) e = evT G k b (kqcons (evT G k a e) e)
evT G k (fqcon d c fs) e = kqcon d c (evT G k fs e)
evT G k (fqproj d c j x) e = q-proj j (evT G k x e)
evT G k (fqsw x alts) e = evT G k alts (kqcons (evT G k x e) e)
evT G k (fqif c a b) e = q-if (evT G k c e) (evT G k a e) (evT G k b e)
evT G k (fqclos g env) e = kqclos g (evT G k env e)
evT G k (fqlam b) e = kqlam b e
evT G k (fqapp f as) e = q-app G k (evT G k as e) (evT G k f e)
evT G k (fqcall g as) e = qe-ev k (G g) (q-push (evT G k as e) kqnil)
evT G k (fqloop init b) e = qe-lp k (evT G k init e) b e
evT G k fqnil e = kqnil
evT G k (fqcons x r) e = kqcons (evT G k x e) (evT G k r e)
evT G k (fqalt j n b r) e = q-altsel j n (λ e2 → evT G k b e2) (evT G k r e) e
evT G k fqanone e = kqbot
evT G k fqnet e = kqbot
-- the evaluator at each fuel: none at 0; at n + 1 a form by evT over the evaluator at n, and a loop's
-- turn its body at n, continuing at n
qeN : (Word → FQ) → Nat → QE
qeN G zero = qe (λ t e → kqbot) (λ st b e → kqbot)
qeN G (suc n) = qe (λ t e → evT G (qeN G n) t e) (λ st b e → q-lstep (evT G (qeN G n) b (q-push st e)) (λ st2 → qe-lp (qeN G n) st2 b e))
-- the meaning of a first-order term at fuel n, G the table of definitions
evq : (Word → FQ) → Nat → FQ → KQ → KQ
evq G n t e = evT G (qeN G n) t e
-- ---------------------------------------------------------------- small facts the proofs share
-- order on Nat as a decision, the halves of a conjunction, qadd past a successor, a case on a
-- Bool (used by lib/foproofq.cub, lib/foproofc.cub, lib/foproofm.cub)
q-le : Nat → Nat → Bool
q-le zero n = true
q-le (suc m) zero = false
q-le (suc m) (suc n) = q-le m n
andl : (a b : Bool) → andbt a b ≡ true → a ≡ true
andl a b h = andbt-l a b h
andr : (a b : Bool) → andbt a b ≡ true → b ≡ true
andr a b h = andbt-r a b h
qadd-s : (d m : Nat) → qadd (suc d) m ≡ suc (qadd d m)
qadd-s d zero = λ t → suc d
qadd-s d (suc m) = λ t → suc (qadd-s d m t)
bool-split : (b : Bool) (Q : Type) → (b ≡ true → Q) → (b ≡ false → Q) → Q
bool-split true Q t f = t (λ i → true)
bool-split false Q t f = f (λ i → false)
