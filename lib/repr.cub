-- lib/repr.cub — the back end consuming the representations (plan B12/B14: the table %rtab and
-- the primitive definitions of lib/prim.cub). Loaded after lib/specialize.cub and lib/prim.cub.
-- consume-reps t: a first-order program after lower, with (1) calls of the word operations of
-- lib/std.cub (plusw, wadd, …, and plus on Nat under its representation) replaced by the
-- native primitives, (2) closed constructor trees of a type represented by Word (%rtab)
-- replaced by the word they represent, and (3) Nat numerals in assumed facts read as words.
-- The byte layer and the fixed-width and floating-point primitives no longer pass here: a stuck
-- primitive quotes as cprim (lib/code.cub prim-apply) and lower.cub's lower-prim is their path.
consume-call g as = case as of lnil → (case unfold g of some cd → (case cd of cwlit n → flit n; _ → fcall g as); none → fcall g as); _ → fcall g as
-- the word operations of lib/std.cub are the native ones by definition (plusw≡wadd, ...), and
-- plus on Nat is plusw by its representation's op line
g-plusw = gidx (code plusw)
g-wadd = gidx (code wadd)
g-wsub = gidx (code wsub)
g-weq = gidx (code weq)
g-wlt = gidx (code wlt)
g-plus = gidx (code plus)
nat-d = didx (code Nat)
nat-rep = case %rtab nat-d of some R → true; none → false
-- a closed Nat tree as a word (the representation's `to`, fromNat, by counting)
nat-lit t =
  case t of
    fcon d c fs → if %weq d nat-d then (if %weq c #0 then some #0 else (case fs of lcons x r → omap (λ n → %wsucc n) (nat-lit x); _ → none)) else none
    _ → none
-- a Nat numeral in a code (a fact's offset or length) as the word it represents
nat-code c =
  case c of
    ccon d k fs ds → (if %weq d nat-d then (if %weq k #0 then some #0 else (case fs of lcons x r → omap (λ n → %wsucc n) (nat-code x); lnil → none)) else none)
    _ → none
nat-lits c =
  case c of
    ccon d k fs ds → (case nat-code c of some n → cwlit n; none → c)
    cwop o a b → cwop o (nat-lits a) (nat-lits b)
    cwsucc a → cwsucc (nat-lits a)
    _ → c
consume-reps t =
  case t of
    fcall g args →
      let as = consume-list args
      in if %weq g g-plusw then fprim P-add as
         else if %weq g g-wadd then fprim P-add as
         else if %weq g g-wsub then fprim P-sub as
         else if %weq g g-weq then fprim P-eq as
         else if %weq g g-wlt then fprim P-lt as
         else if andb nat-rep (%weq g g-plus) then fprim P-add as
         else consume-call g as
    fcon d c fs → (case (if nat-rep then nat-lit t else none) of some n → flit n; none → fcon d c (consume-list fs))
    fswitch x alts → fswitch (consume-reps x) (consume-alts alts)
    frec d x alts → frec d (consume-reps x) (consume-ralts alts)
    fproj d c k x → fproj d c k (consume-reps x)
    fprim p args → fprim p (consume-list args)
    flet a b → flet (consume-reps a) (consume-reps b)
    fif c a b → fif (consume-reps c) (consume-reps a) (consume-reps b)
    floop init body → floop (consume-list init) (consume-reps body)
    fclos g env → fclos g (consume-list env)
    flam b → flam (consume-reps b)
    fapply f args → fapply (consume-reps f) (consume-list args)
    fthunk a → fthunk (consume-reps a)
    fforce a → fforce (consume-reps a)
    fassume fact b → fassume (if nat-rep then nat-lits fact else fact) (consume-reps b)
    fupd u x c k v → fupd u (consume-reps x) c k (consume-reps v)
    _ → t
consume-list l = case l of lnil → lnil; lcons x xs → lcons (consume-reps x) (consume-list xs)
consume-ralts l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , consume-reps (snd (snd (snd a)))))) (consume-ralts r)
consume-alts l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , consume-reps (snd (snd a)))) (consume-alts r)
-- specialize, then consume: the pipeline with representations; with a schedule, only the
-- representations it names are consumed (every declared one when it names none)
specialize-r T rules c = consume-reps (specialize T rules c)
specialize-rs sch T rules c = consume-reps-of (sched-reps sch) (specialize-s sch T rules c)
consume-reps-of reps t = case reps of lnil → consume-reps t; _ → (if lmem-l nat-d reps then consume-reps t else t)
-- a schedule naming Nat consumes its representation: the numerals are words; one naming
-- another type leaves the Nat constructor trees
#same specialize-rs (sched #64 lnil (lcons nat-d lnil)) (Bool → Nat) lnil (code (λ (b : Bool) → if b then 5 else 7)) = flam (fif (fvar #0) (flit #5) (flit #7))
#same (case specialize-rs (sched #64 lnil (lcons #0 lnil)) (Bool → Nat) lnil (code (λ (b : Bool) → if b then 5 else 7)) of flam b → (case b of fif c t e → (case t of fcon d k fs → true; _ → false); _ → false); _ → false) = true
-- ---------------------------------------------------------------- readings
-- two loads at literal offsets from an unknown buffer, as the decoder's loop computes them: the
-- Nat lengths and offsets (constructor trees in the code) become words, the bound proofs are gone,
-- the conversions are gone, and each dropped proof is an assumed fact around its load. (sum-msgs itself, applied to the unknown buffer, is not unfolded by
-- normalization and its call has no first-order form: a finding for B15, plan 18.6.)
two-loads = code (λ b → plusw (i64toWord (load64 32 b 16 (8 , λ i → 32))) (i64toWord (load64 32 b 0 (24 , λ i → 32))))
sum2 = specialize-r (Bytes 32 → Word) (view-of (lcons (gidx (code plusw≡wadd)) lnil)) two-loads
ld16 = fprim P-load64 (lcons (fvar #0) (lcons (flit #16) lnil))
ld0 = fprim P-load64 (lcons (fvar #0) (lcons (flit #0) lnil))
wof64 t = fprim P-wofi64 (lcons t lnil)
#same sum2 = flam (fprim P-add (lcons (wof64 (fassume (cwop #1 (cwop #2 (cwlit #16) (cwlit #8)) (cwsucc (cwlit #32))) ld16)) (lcons (wof64 (fassume (cwop #1 (cwop #2 (cwlit #0) (cwlit #8)) (cwsucc (cwlit #32))) ld0)) lnil)))
-- it runs natively on a buffer built by the same primitives
buf2 = fprim P-store64 (lcons (fprim P-store64 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (fi64 #5) lnil)))) (lcons (flit #16) (lcons (fi64 #9) lnil)))
#same eval-fo (λ g → flit #0) lnil (fapply sum2 (lcons buf2 lnil)) = vw #14
-- the tagged message decoder of lib/decode.cub, lowered from its code: a switch on the loaded
-- tag, loads at literal offsets, each under its assumed bound (a word constant of the store, one-w,
-- becomes its literal)
one-w : Word
one-w = #1
dm-code = code (λ (b : Bytes 32) → case weq (u32toWord (load32 32 b 0 (28 , λ i → 32))) one-w of true → i64toWord (load64 32 b 8 (16 , λ i → 32)); false → i64toWord (load64 32 b 16 (8 , λ i → 32)))
dm-fo = specialize-r (Bytes 32 → Word) lnil dm-code
mb1 = fprim P-store64 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (flit #1) lnil)))) (lcons (flit #8) (lcons (fi64 #500) lnil)))
mb2 = fprim P-store64 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (flit #2) lnil)))) (lcons (flit #16) (lcons (fi64 #7) lnil)))
#same eval-fo (λ g → flit #0) lnil (fapply dm-fo (lcons mb1 lnil)) = vw #500
#same eval-fo (λ g → flit #0) lnil (fapply dm-fo (lcons mb2 lnil)) = vw #7
-- ---------------------------------------------------------------- processes specialized (D24 with B15)
-- a process run against its world, with the initial state unknown, specializes by normalization: pr1 puts before it gets, so its run is the constant 12
-- whatever the store; pr4 reads key 3 of the store, so its run is a function of the store
out-w : Outcome Word → Word
out-w o = case o of done a → a; stopped → #0; failed r → #0
run1 : (Word → Word) → Word
run1 st = out-w (fst (runp {KVS} {Word} {Word → Word} (pr1 {lzero}) kv-world st))
#same specialize ((Word → Word) → Word) lnil (code (λ (st : Word → Word) → run1 st)) = flam (flit #12)
pr4 : {l : Level} → Proc {l} KVS Word
pr4 {l} = bind {l} {KVS} {Word} {Word} (cmd {l} {KVS} (get #3)) (λ a → ret {l} {KVS} {Word} (%wadd a #1))
run4 : (Word → Word) → Word
run4 st = out-w (fst (runp {KVS} {Word} {Word → Word} (pr4 {lzero}) kv-world st))
spec4 = specialize ((Word → Word) → Word) lnil (code (λ (st : Word → Word) → run4 st))
#same spec4 = flam (fprim P-add (lcons (fapply (fvar #0) (lcons (flit #3) lnil)) (lcons (flit #1) lnil)))
-- and run natively on a store given as a λ
#same eval-fo (λ g → flit #0) lnil (fapply spec4 (lcons (flam (flit #40)) lnil)) = vw #41
