-- lib/repr.cub — representations consumed by the specializer (plan B12/B14, item 15): the table %rtab,
-- the conversions %rops and the laws %rlaws of each declared representation (lib/prim.cub's). Loaded
-- after lib/specialize.cub and lib/prim.cub.
-- specialize-r T rules c: the program transported along the representations of the data types at
-- its boundary — p_R = to ∘ p ∘ from at each parameter and result of T whose type d is represented
-- (T[d := R]) — normalized by the machine and rewritten along the representations' own paths: the
-- laws to-from and from-to (oriented: from (to x) → x), and each op line's law read right to left
-- (plus a b → from (wadd (to a) (to b))), which, with to-from, leaves the native operation where the
-- program had the clean one. Nothing is consumed after lowering: lower sees a normal form in which
-- the represented boundary no longer appears, and every step was a path of the store.
-- (Until 2026-11-09 the representations were consumed by an untyped pass over the first-order form,
-- consume-reps: word operations replaced by name, closed Nat trees counted into words, facts' numerals
-- read as words.)
-- the rules of d's representation: its two laws, and its op lines read from right to left
rep-rules d =
  case %rlaws d of
    some t → lapp2 (view-of (lcons (fst t) (lcons (fst (snd t)) lnil))) (rep-op-rules (snd (snd t)))
    none → lnil
rep-op-rules gs = case gs of lnil → lnil; lcons g r → (case rule-of-sym g of some ru → lcons ru (rep-op-rules r); none → rep-op-rules r)
rep-rules-of ds = case ds of lnil → lnil; lcons d r → lapp2 (rep-rules d) (rep-rules-of r)
-- the boundary of T (a type code, a non-dependent Π chain): (the represented data types met , (the
-- transported type's code , the program's code transported)), the parameters converted by from and
-- the result by to; okd d decides which represented types are consumed
rep-of-code okd A = case A of cdata d ps → rep-of-d okd d A; _ → none
rep-of-d okd d A = if okd d then rep-of-tab d A (%rtab d) (%rops d) else none
rep-of-tab d A rt ro = case rt of none → none; some R → (case ro of none → none; some t → some (d , (fromopt (quote-ty R) A , t)))
-- the arguments of the transported program: parameter i of n (from the outside) is cvar (n − 1 − i),
-- converted by from when its type is represented
tr-args okd As n i =
  case As of
    lnil → lnil
    lcons A r → lcons (case rep-of-code okd A of some e → capp (cglob (rep-e-from e)) (cvar (%wsub (%wsub n #1) i)); none → cvar (%wsub (%wsub n #1) i)) (tr-args okd r n (%wsucc i))
pi-chain T = case T of cpi m A B → (let tr = pi-chain (unshift #1 B) in (lcons (m , A) (fst tr) , snd tr)); _ → (lnil , T)
tr-ty okd ps B = case ps of lnil → (case rep-of-code okd B of some e → fst (snd e); none → B); lcons p r → cpi (fst p) (case rep-of-code okd (snd p) of some e → fst (snd e); none → snd p) (shift-code #0 #1 (tr-ty okd r B))
tr-ds okd ps B = lapp2 (lmap-opt (λ p → omap (λ e → fst e) (rep-of-code okd (snd p))) ps) (case rep-of-code okd B of some e → lcons (fst e) lnil; none → lnil)
lmap-opt f l = case l of lnil → lnil; lcons x r → (case f x of some y → lcons y (lmap-opt f r); none → lmap-opt f r)
lam-n n b = if %weq n #0 then b else clam (lam-n (%wsub n #1) b)
app-list f as = case as of lnil → f; lcons a r → app-list (capp f a) r
transport-rep okd T c =
  let ch = pi-chain (fromopt (quote-ty T) cword)
      ps = fst ch
      B = snd ch
      n = lst-count ps
      As = lmap-snd ps
      body = app-list c (tr-args okd As n #0)
      out = (case rep-of-code okd B of some e → capp (cglob (rep-e-to e)) body; none → body)
  in (tr-ds okd ps B , (eval-g lnil (tr-ty okd ps B) , lam-n n out))
rep-e-to e = fst (snd (snd e))
rep-e-from e = fst (snd (snd (snd e)))
lmap-snd l = case l of lnil → lnil; lcons p r → lcons (snd p) (lmap-snd r)
all-reps d = true
-- specialize, with the representations consumed in the term; with a schedule, only those it names
-- (every declared one when it names none)
specialize-r T rules c = specialize-r-of all-reps T rules c
specialize-r-of okd T rules c =
  let tr = transport-rep okd T c
  in specialize (fst (snd tr)) (lapp2 rules (rep-rules-of (rep-all-ds okd (fst tr)))) (snd (snd tr))
-- the laws of every representation the boundary names, and of Nat's (a numeral's representation,
-- met inside any program over the byte layer) when the schedule consumes it
rep-all-ds okd ds = if okd nat-d then (if lmem-l nat-d ds then ds else lcons nat-d ds) else ds
specialize-rs sch T rules c =
  let okd = sched-okd (sched-reps sch)
      tr = transport-rep okd T c
  in specialize-s sch (fst (snd tr)) (lapp2 rules (rep-rules-of (rep-all-ds okd (fst tr)))) (snd (snd tr))
sched-okd reps d = case reps of lnil → true; _ → lmem-l d reps
nat-d = didx (code Nat)
-- the word operations of lib/std.cub, by global (program-rep's word-native, below)
g-plusw = gidx (code plusw)
g-wadd = gidx (code wadd)
g-wsub = gidx (code wsub)
g-weq = gidx (code weq)
g-wlt = gidx (code wlt)
-- a schedule naming Nat consumes its representation: a Nat result is a word; one naming another type
-- leaves the Nat at the boundary (its numerals constructor trees)
#same run-fo (fapply (specialize-rs (sched #64 lnil (lcons nat-d lnil) lnil) (Bool → Nat) lnil (code (λ (b : Bool) → if b then 5 else 7))) (lcons (flit #0) lnil)) = #7
#same (case specialize-rs (sched #64 lnil (lcons #0 lnil) lnil) (Bool → Nat) lnil (code (λ (b : Bool) → if b then 5 else 7)) of flam ty b → (case b of fif c t e → (case t of fcon d k fs → true; _ → false); _ → false); _ → false) = true
-- plus on Nat at the boundary: transported, its op line's law and to-from leave the machine's addition
dbl-tr : Nat → Nat
dbl-tr n = plus n n
#same specialize-r (Nat → Nat) lnil (code (λ (n : Nat) → dbl-tr n)) = flam ftword (fprim P-add (lcons (fvar #0) (lcons (fvar #0) lnil)))
#same specialize-r (Nat → Nat → Nat) lnil (code (λ (a : Nat) (b : Nat) → plus (plus a b) a)) = flam ftword (flam ftword (fprim P-add (lcons (fprim P-add (lcons (fvar #1) (lcons (fvar #0) lnil))) (lcons (fvar #1) lnil))))
-- ---------------------------------------------------------------- readings
-- two loads at literal offsets from an unknown buffer, as the decoder's loop computes them: the
-- Nat lengths and offsets (constructor trees in the code) become words, the bound proofs are gone,
-- the conversions are gone, and each dropped proof is an assumed fact around its load. (sum-msgs itself, applied to the unknown buffer, is not unfolded by
-- normalization and its call has no first-order form: a finding for B15, plan 18.6.)
two-loads = code (λ b → plusw (i64toWord (load64 32 b 16 (8 , λ i → 32))) (i64toWord (load64 32 b 0 (24 , λ i → 32))))
sum2 = specialize-r (Bytes 32 → Word) (view-of (lcons (gidx (code plusw≡wadd)) lnil)) two-loads
ld16 = fprim P-load64 (lcons (fvar #0) (lcons (flit #16) lnil))
ld0 = fprim P-load64 (lcons (fvar #0) (lcons (flit #0) lnil))
wof64 t = fprim P-wofi64 (lcons t lnil)
#same sum2 = flam (ftbytes #32) (fprim P-add (lcons (wof64 (fassume (cwop #1 (cwop #2 (cwlit #16) (cwlit #8)) (cwsucc (cwlit #32))) ld16)) (lcons (wof64 (fassume (cwop #1 (cwop #2 (cwlit #0) (cwlit #8)) (cwsucc (cwlit #32))) ld0)) lnil)))
-- it runs natively on a buffer built by the same primitives
buf2 = fprim P-store64 (lcons (fprim P-store64 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (fi64 #5) lnil)))) (lcons (flit #16) (lcons (fi64 #9) lnil)))
#same eval-fo (λ g → flit #0) lnil (fapply sum2 (lcons buf2 lnil)) = vw #14
-- the tagged message decoder of lib/decode.cub, lowered from its code: a switch on the loaded
-- tag, loads at literal offsets, each under its assumed bound (a word constant of the store, one-w,
-- becomes its literal)
one-w : Word
one-w = #1
dm-code = code (λ (b : Bytes 32) → case weq (u32toWord (load32 32 b 0 (28 , λ i → 32))) one-w of true → i64toWord (load64 32 b 8 (16 , λ i → 32)); false → i64toWord (load64 32 b 16 (8 , λ i → 32)))
dm-fo = specialize-r (Bytes 32 → Word) lnil dm-code
mb1 = fprim P-store64 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (flit #1) lnil)))) (lcons (flit #8) (lcons (fi64 #500) lnil)))
mb2 = fprim P-store64 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (flit #2) lnil)))) (lcons (flit #16) (lcons (fi64 #7) lnil)))
#same eval-fo (λ g → flit #0) lnil (fapply dm-fo (lcons mb1 lnil)) = vw #500
#same eval-fo (λ g → flit #0) lnil (fapply dm-fo (lcons mb2 lnil)) = vw #7
-- ---------------------------------------------------------------- processes specialized (D24 with B15)
-- a process run against its world, with the initial state unknown, specializes by normalization: pr1 puts before it gets, so its run is the constant 12
-- whatever the store; pr4 reads key 3 of the store, so its run is a function of the store
out-w : Outcome Word → Word
out-w o = case o of done a → a; stopped → #0; failed r → #0
run1 : (Word → Word) → Word
run1 st = out-w (fst (runp {KVS} {Word} {Word → Word} (pr1 {lzero}) kv-world st))
#same specialize ((Word → Word) → Word) lnil (code (λ (st : Word → Word) → run1 st)) = flam (ftfun (lcons ftword lnil) ftword) (flit #12)
pr4 : {l : Level} → Proc {l} KVS Word
pr4 {l} = bind {l} {KVS} {Word} {Word} (cmd {l} {KVS} (get #3)) (λ a → ret {l} {KVS} {Word} (%wadd a #1))
run4 : (Word → Word) → Word
run4 st = out-w (fst (runp {KVS} {Word} {Word → Word} (pr4 {lzero}) kv-world st))
spec4 = specialize ((Word → Word) → Word) lnil (code (λ (st : Word → Word) → run4 st))
#same spec4 = flam (ftfun (lcons ftword lnil) ftword) (fprim P-add (lcons (fapply (fvar #0) (lcons (flit #3) lnil)) (lcons (flit #1) lnil)))
-- and run natively on a store given as a λ
#same eval-fo (λ g → flit #0) lnil (fapply spec4 (lcons (flam ftword (flit #40)) lnil)) = vw #41
-- ---------------------------------------------------------------- representations consumed in general (B12 §6, B14)
-- program-rep reps fuel c: the program of a code (lib/specialize.cub's program-of) with every value
-- of a data type d in reps laid out as d's first representation R (%rtab d), by the table %rops d
-- = some (to , (from , ops)): a call of an operation with an op line becomes its native
-- counterpart; a constructor of d becomes its tb value (a closed constructor tree computed now,
-- through to on the net and quoted at tb; an open one is to at run time, its fields of a
-- represented type read back by their from); a recursion on a d value recurses on from of it, the
-- fields of a represented type the body reads converted by to (one representation throughout the
-- program, so a value of d is tb everywhere: in a variable, a field of another type, a result).
-- The program's own to and from are left as written (they convert between the two forms). What
-- has no op is correct and slow (B12 §6, W-slow-op): a case on a d value costs from.
-- reps empty: every representation the program meets.
rep-entry d = case %rops d of some t → some (alias-of #8 (fst t) , (alias-of #8 (fst (snd t)) , snd (snd t))); none → none
rep-to e = fst e
rep-from e = fst (snd e)
rep-ops e = snd (snd e)
-- the table for the representations chosen: (d , entry) for each d of reps with a declared one,
-- or for every data type the code mentions when reps is empty (read off the program as lowered)
rep-table reps ds = case reps of lnil → rep-table-of ds; _ → rep-table-of reps
rep-table-of ds = case ds of lnil → lnil; lcons d r → (case rep-entry d of some e → lcons (d , e) (rep-table-of r); none → rep-table-of r)
rep-lookup tb d = case tb of lnil → none; lcons x r → if %weq (fst x) d then some (snd x) else rep-lookup r d
op-native ops g = case ops of lnil → none; lcons o r → if %weq (fst o) g then some (snd o) else op-native r g
rep-op tb g = case tb of lnil → g; lcons x r → (case op-native (rep-ops (snd x)) g of some n → alias-of #8 n; none → rep-op r g)
-- a native counterpart written as another definition's name (op plus : … = plusw): that definition
alias-of k g = if %weq k #0 then g else (case %gcode g of some c → (case c of cglob h → alias-of (%wsub k #1) h; _ → g); none → g)
-- the data types a lowered term constructs or recurses on
fo-datas t acc =
  case t of
    fcon d c fs → fo-datas-list fs (if lmem-l d acc then acc else lcons d acc)
    frec d x alts → fo-datas-ralts alts (fo-datas x (if lmem-l d acc then acc else lcons d acc))
    fswitch x alts → fo-datas-alts alts (fo-datas x acc)
    fproj d c k x → fo-datas x acc
    fcall g args → fo-datas-list args acc
    fprim p args → fo-datas-list args acc
    flet ty a b → fo-datas b (fo-datas a acc)
    fif c a b → fo-datas b (fo-datas a (fo-datas c acc))
    floop tys init body → fo-datas body (fo-datas-list init acc)
    fclos g env → fo-datas-list env acc
    flam ty b → fo-datas b acc
    fapply f args → fo-datas-list args (fo-datas f acc)
    fthunk a → fo-datas a acc
    fforce x → fo-datas x acc
    fassume f b → fo-datas b acc
    fupd u dd x c k v → fo-datas v (fo-datas x acc)
    _ → acc
fo-datas-list l acc = case l of lnil → acc; lcons x xs → fo-datas-list xs (fo-datas x acc)
fo-datas-alts l acc = case l of lnil → acc; lcons a r → fo-datas-alts r (fo-datas (snd (snd a)) acc)
fo-datas-ralts l acc = case l of lnil → acc; lcons a r → fo-datas-ralts r (fo-datas (snd (snd (snd a))) acc)
-- a closed first-order constructor tree of d as a code (its fields by the constructor's shape: a
-- word a literal, a field of a data type a tree of it); none when a leaf is not a literal
tree-code d t =
  case t of
    fcon d2 c fs → if %weq d2 d then omap (λ cs → ccon d c cs lnil) (tree-fields d (cshape d c) fs) else none
    _ → none
tree-fields d ks fs =
  case ks of
    lnil → (case fs of lnil → some lnil; _ → none)
    lcons k kr → (case fs of
                    lnil → none
                    lcons f fr → (case (if %weq (fst k) #0 then (case f of flit w → some (cwlit w); _ → none)
                                        else if %weq (fst k) #1 then tree-code d f
                                        else if %weq (fst k) #2 then tree-code (snd k) f else none) of
                                    some c → omap (λ cs → lcons c cs) (tree-fields d kr fr)
                                    none → none))
-- its representation computed now: to applied on the net, quoted at tb; a word literal
rep-lit d e t =
  case %rtab d of
    some RT → (case tree-code d t of
                some c → (case quote-top RT (eval-g lnil (capp (cglob (rep-to e)) c)) of some q → (case q of cwlit w → some (flit w); _ → none); none → none)
                none → none)
    none → none
-- the fields of a constructor of d built at run time, back in d's own form: a field of a
-- represented type read back by its from (the field holds the representation, to wants the tree)
raw-fields tb ks fs = case ks of lnil → fs; lcons k kr → (case fs of lnil → lnil; lcons f fr → lcons (raw-field tb k f) (raw-fields tb kr fr))
raw-field tb k f = case field-rep tb k of some e → fcall (rep-from e) (lcons f lnil); none → f
field-rep tb k = if %weq (fst k) #0 then none else if %weq (fst k) #3 then none else rep-lookup tb (snd k)
-- the shape's kinds with the type itself named (kind 1 carries d)
shape-of d c = lmap-k d (cshape d c)
kind-at ks k = case ks of lnil → (#3 , #0); lcons x r → if %weq k #0 then x else kind-at r (%wsub k #1)
lmap-k d ks = case ks of lnil → lnil; lcons k r → lcons (if %weq (fst k) #1 then (#1 , d) else k) (lmap-k d r)
-- a representation that is itself a data type (represent Box by Pt): its to and from are not left
-- as written but consumed like the rest of the program with Box itself not represented (tb-del),
-- so the Pt they make or take is in the program's own form (a Nat field a word) — a constructor
-- of Box is to of the Box built from the program's fields, a case on a Box reads from of it, its
-- fields already in the program's form. Run as written, to would move tree fields into a Pt whose
-- fields the program reads as words (bump (rbox 1 2) answered rbox 10 0), and a C back end
-- types one layout per data type, so tree and word fields cannot both sit in it
rcv-data d = case %rtab d of some RT → (case %view RT of wdata dR ps → some dR; _ → none); none → none
rcv-is d = case rcv-data d of some dR → true; none → false
tb-del tb d = case tb of lnil → lnil; lcons x r → if %weq (fst x) d then r else lcons x (tb-del r d)
-- the record representations' conversions, (g , d) for each
rcv-convs tb = case tb of lnil → lnil; lcons x r → if rcv-is (fst x) then lcons (rep-to (snd x) , fst x) (lcons (rep-from (snd x) , fst x) (rcv-convs r)) else rcv-convs r
rcv-conv-of g l = case l of lnil → none; lcons x r → if %weq (fst x) g then some (snd x) else rcv-conv-of g r
rc tb t =
  case t of
    fcon d c fs →
      let fs2 = rc-list tb fs
      in (case rep-lookup tb d of
            some e → (if rcv-is d then fcall (rep-to e) (lcons (fcon d c fs2) lnil)
                      else case rep-lit d e t of some l → l; none → fcall (rep-to e) (lcons (fcon d c (raw-fields tb (shape-of d c) fs2)) lnil))
            none → fcon d c fs2)
    frec d x alts →
      (case rep-lookup tb d of
         some e → (if rcv-is d then frec d (fcall (rep-from e) (lcons (rc tb x) lnil)) (rc-ralts tb alts)
                   else frec d (fcall (rep-from e) (lcons (rc tb x) lnil)) (rc-ralts-rep tb d alts))
         none → frec d (rc tb x) (rc-ralts tb alts))
    fswitch x alts → fswitch (rc tb x) (rc-alts tb alts)
    fproj d c k x → fproj d c k (rc tb x)
    fcall g args → fcall (rep-op tb g) (rc-list tb args)
    fprim p args → fprim p (rc-list tb args)
    flet ty a b → flet (rc-ft tb ty) (rc tb a) (rc tb b)
    fif c a b → fif (rc tb c) (rc tb a) (rc tb b)
    floop tys init body → floop (rc-fts tb tys) (rc-list tb init) (rc tb body)
    fclos g env → fclos g (rc-list tb env)
    flam ty b → flam (rc-ft tb ty) (rc tb b)
    fapply f args → fapply (rc tb f) (rc-list tb args)
    fthunk a → fthunk (rc tb a)
    fforce a → fforce (rc tb a)
    fassume fact b → fassume fact (rc tb b)
    -- an update of a represented type's value (reuse-cons made it from a constructor rebuilt from
    -- a case's fields, before the representation is consumed): the value is its representation in
    -- the program, so the update is of from of it, and to of the result, as a constructor is (until
    -- 2026-11-09 the update was left on the representation's value, which the typed printer refuses:
    -- RBox's update of an RPt; it compiled before only because the two records have one layout)
    fupd u dd x c k v →
      (case rep-lookup tb dd of
         some e → fcall (rep-to e) (lcons (fupd u dd (fcall (rep-from e) (lcons (rc tb x) lnil)) c k (if rcv-is dd then rc tb v else raw-field tb (kind-at (shape-of dd c) k) (rc tb v))) lnil)
         none → fupd u dd (rc tb x) c k (rc tb v))
    _ → t
rc-list tb l = case l of lnil → lnil; lcons x xs → lcons (rc tb x) (rc-list tb xs)
-- a binder's type where the representations are consumed: a value of a represented type is its
-- representation's value in the consumed program, so its binder is retyped to the representation's
-- type (Nat as a word; a type represented by a record as that record)
rc-ft tb t =
  case t of
    ftdata d ps r → (case rep-lookup tb d of some e → (case %rtab d of some RT → ft-of-rep RT; none → t); none → t)
    ftpair a b → ftpair (rc-ft tb a) (rc-ft tb b)
    ftfun as r → ftfun (rc-fts tb as) (rc-ft tb r)
    ftlazy a → ftlazy (rc-ft tb a)
    _ → t
rc-fts tb l = case l of lnil → lnil; lcons t r → lcons (rc-ft tb t) (rc-fts tb r)
rc-alts tb l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , rc tb (snd (snd a)))) (rc-alts tb r)
rc-ralts tb l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , rc tb (snd (snd (snd a)))))) (rc-ralts tb r)
-- a recursion on a represented d: the branch's fields are those of from's tree; the ones of a
-- represented type are read through its to (the hypotheses are the recursion's results, already
-- in the program's form). Field j of n, under m hypotheses, is the body's variable m + n − 1 − j
rc-ralts-rep tb d l =
  case l of
    lnil → lnil
    lcons a r →
      let c = fst a
          n = fst (snd a)
          hs = fst (snd (snd a))
          m = lst-count hs
      in lcons (c , (n , (hs , wrap-fields tb (shape-of d c) n m #0 (rc tb (snd (snd (snd a))))))) (rc-ralts-rep tb d r)
wrap-fields tb ks n m j b = case ks of lnil → b; lcons k kr → wrap-fields tb kr n m (%wsucc j) (case field-rep tb k of some e → to-at (rep-to e) (%wsub (%wadd m n) (%wsucc j)) b; none → b)
-- every occurrence of the variable at index k (from b's top) replaced by to of it
to-at g k b = var-map g #0 k b
var-map g d k t =
  case t of
    fvar m → if %weq m (%wadd d k) then fcall g (lcons t lnil) else t
    fcon dd c fs → fcon dd c (var-map-list g d k fs)
    fswitch x alts → fswitch (var-map g d k x) (var-map-alts g d k alts)
    frec dd x alts → frec dd (var-map g d k x) (var-map-ralts g d k alts)
    fproj dd c j x → fproj dd c j (var-map g d k x)
    fcall h args → fcall h (var-map-list g d k args)
    fprim p args → fprim p (var-map-list g d k args)
    flet ty a b → flet ty (var-map g d k a) (var-map g (%wsucc d) k b)
    fif c a b → fif (var-map g d k c) (var-map g d k a) (var-map g d k b)
    floop tys init body → floop tys (var-map-list g d k init) (var-map g (%wadd d (lst-count init)) k body)
    fclos h env → fclos h (var-map-list g d k env)
    flam ty b → flam ty (var-map g (%wsucc d) k b)
    fapply f args → fapply (var-map g d k f) (var-map-list g d k args)
    fthunk a → fthunk (var-map g d k a)
    fforce a → fforce (var-map g d k a)
    fassume fact b → fassume fact (var-map g d k b)
    fupd u dd x c j v → fupd u dd (var-map g d k x) c j (var-map g d k v)
    _ → t
var-map-list g d k l = case l of lnil → lnil; lcons x xs → lcons (var-map g d k x) (var-map-list g d k xs)
var-map-alts g d k l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , var-map g (%wadd d (fst (snd a))) k (snd (snd a)))) (var-map-alts g d k r)
var-map-ralts g d k l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , var-map g (%wadd d (%wadd (fst (snd a)) (lst-count (fst (snd (snd a)))))) k (snd (snd (snd a)))))) (var-map-ralts g d k r)
-- the program: the code and every definition it calls, each lowered from its code as written
-- (%gcode: the calls it makes stay calls, so an operation with an op line is still a call to
-- replace — normalization would have unfolded it), each consumed; the conversions to and from
-- and what they call are left as written (they convert between the two forms); the word
-- operations of lib/std.cub become the native primitives (word-native)
def-code g = case %gcode g of some c → some c; none → unfold g
word-native g args =
  if isnil-l args then fcall g args
  else if %weq g g-plusw then fprim P-add args
  else if %weq g g-wadd then fprim P-add args
  else if %weq g g-wsub then fprim P-sub args
  else if %weq g g-weq then fprim P-eq args
  else if %weq g g-wlt then fprim P-lt args
  else fcall g args
wn t =
  case t of
    fcall g args → word-native g (wn-list args)
    fcon d c fs → fcon d c (wn-list fs)
    fswitch x alts → fswitch (wn x) (wn-alts alts)
    frec d x alts → frec d (wn x) (wn-ralts alts)
    fproj d c k x → fproj d c k (wn x)
    fprim p args → fprim p (wn-list args)
    flet ty a b → flet ty (wn a) (wn b)
    fif c a b → fif (wn c) (wn a) (wn b)
    floop tys init body → floop tys (wn-list init) (wn body)
    fclos g env → fclos g (wn-list env)
    flam ty b → flam ty (wn b)
    fapply f args → fapply (wn f) (wn-list args)
    fthunk a → fthunk (wn a)
    fforce a → fforce (wn a)
    fassume fact b → fassume fact (wn b)
    fupd u dd x c k v → fupd u dd (wn x) c k (wn v)
    _ → t
wn-list l = case l of lnil → lnil; lcons x xs → lcons (wn x) (wn-list xs)
wn-alts l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , wn (snd (snd a)))) (wn-alts r)
wn-ralts l = case l of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , wn (snd (snd (snd a)))))) (wn-ralts r)
lower-def g = case def-code g of some cd → some (inplace (erase-lams (g-erased g) #0 (lower (%gty g) cd))); none → none
-- the definitions reached from the globals todo, (g , (arity , body)), each body passed through
-- f g t (the consumption, or none)
defs-reach f fuel todo seen =
  if %weq fuel #0 then lnil else
  (case todo of
     lnil → lnil
     lcons g rest →
       if lmem g seen then defs-reach f fuel rest seen
       else (case lower-def g of
               none → defs-reach f (%wsub fuel #1) rest (lcons g seen)
               some t0 →
                 let t = f g t0
                 in lcons (g , (lam-sig t , strip-flams t)) (defs-reach f (%wsub fuel #1) (lapp2 rest (fcalls t lnil)) (lcons g seen))))
def-names ds = case ds of lnil → lnil; lcons x r → lcons (fst x) (def-names r)
datas-of-defs ds acc = case ds of lnil → acc; lcons x r → datas-of-defs r (fo-datas (snd (snd x)) acc)
keep-t g t = t
isnil-l l = case l of lnil → true; _ → false
rep-convs tb = case tb of lnil → lnil; lcons x r → if rcv-is (fst x) then rep-convs r else lcons (rep-to (snd x)) (lcons (rep-from (snd x)) (rep-convs r))
program-rep T reps fuel c = program-rep-at T #0 reps fuel c
program-rep-at T m reps fuel c =
  let t0 = inplace (lower T c)
      raw = defs-reach keep-t fuel (fcalls t0 lnil) lnil
      tb = rep-table reps (datas-of-defs raw (fo-datas t0 lnil))
      cv = def-names (defs-reach keep-t fuel (rep-convs tb) lnil)
      rv = rcv-convs tb
      cons = λ g t → if lmem-l g cv then t else (case rcv-conv-of g rv of some d → wn (rc (tb-del tb d) t); none → wn (rc tb t))
      t = wn (rc tb t0)
  in lcons (m , (lam-sig t , offset-calls (strip-flams t))) (offset-defs (defs-reach cons fuel (fcalls t lnil) lnil))
-- readings: a program over Nat with Nat laid out as Word — plus the native addition (its op line),
-- a case on a Nat through from, a constructor through to, a Nat field of a list a word
dbl-rp : Nat → Nat
dbl-rp n = plus n n
pred-rp : Nat → Nat
pred-rp n = case n of zero → zero; suc k → k
suml-r : List Nat → Nat
suml-r l = case l of nil → 0; cons x xs → plus x (rec xs)
run-rep T c args = eval-fo (table-of (lift-program #100000 (program-rep T lnil #20 c))) lnil (fcall #0 args)
#same program-rep (Nat → Nat) lnil #20 (code (λ (n : Nat) → dbl-rp n)) = lcons (#0 , (lcons ftword lnil , fcall (%wsucc (gidx (code dbl-rp))) (lcons (fvar #0) lnil))) (lcons (%wsucc (gidx (code dbl-rp)) , (lcons ftword lnil , fprim P-add (lcons (fvar #0) (lcons (fvar #0) lnil)))) lnil)
#same run-rep (Nat → Nat) (code (λ (n : Nat) → dbl-rp n)) (lcons (flit #21) lnil) = vw #42
#same run-rep (Nat → Nat) (code (λ (n : Nat) → pred-rp (dbl-rp n))) (lcons (flit #21) lnil) = vw #41
#same run-rep (Nat → Nat) (code (λ (n : Nat) → suml-r (cons n (cons 5 (cons (suc n) nil))))) (lcons (flit #3) lnil) = vw #12
#same run-rep (Nat → Nat) (code (λ (n : Nat) → plus 7 n)) (lcons (flit #3) lnil) = vw #10
-- a type represented by a record (represent RBox by RPt): a constructor of RBox is to of the RPt
-- built from words, its Nat fields read back through from (a Nat field of the record is a word); a
-- case on an RBox reads from of it. Before the fix the fields were passed to RPt's from as if trees:
-- bump (rbox 1 2) answered rbox 10 0, so the sum read 10, not 12
data RPt = rpt (a : Nat) (b : Nat)
data RBox = rbox (x : Nat) (y : Nat)
rbox-to : RBox → RPt
rbox-to b = case b of rbox x y → rpt x y
rbox-from : RPt → RBox
rbox-from p = case p of rpt a c → rbox a c
represent RBox by RPt where
  to : RBox → RPt = rbox-to
  from : RPt → RBox = rbox-from
  to-from : (p : RPt) → to (from p) ≡ p = λ p → case p return (λ q → rbox-to (rbox-from q) ≡ q) of rpt a c → (λ i → rpt a c)
  from-to : (b : RBox) → from (to b) ≡ b = λ b → case b return (λ q → rbox-from (rbox-to q) ≡ q) of rbox x y → (λ i → rbox x y)
rbox-bump : RBox → RBox
rbox-bump b = case b of rbox x y → rbox (plus x 9) y
rbox-sum : RBox → Nat
rbox-sum b = case b of rbox x y → plus x y
#same run-rep (Nat → Nat) (code (λ (n : Nat) → rbox-sum (rbox-bump (rbox n 2)))) (lcons (flit #1) lnil) = vw #12
#same run-rep (Nat → Nat) (code (λ (n : Nat) → rbox-sum (rbox n 2))) (lcons (flit #1) lnil) = vw #3
