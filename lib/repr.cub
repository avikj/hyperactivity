-- lib/repr.cub — representations consumed by the specializer (plan B12/B14, item 15): the table %rtab,
-- the conversions %rops and the laws %rlaws of each declared representation (lib/prim.cub's). Loaded
-- after lib/specialize.cub and lib/prim.cub.
-- specialize-r T rules c: the program transported along the representations of the data types at
-- its boundary — p_R = to ∘ p ∘ from at each parameter and result of T whose type d is represented
-- (T[d := R]) — normalized by the machine and rewritten along the representations' own paths: the
-- laws to-from and from-to (oriented: from (to x) → x), and each op line's law read right to left
-- (plus a b → from (wadd (to a) (to b))), which, with to-from, leaves the native operation where the
-- program had the clean one. Nothing is consumed after lowering: lower sees a normal form in which
-- the represented boundary no longer appears, and every step was a path of the store.
-- (Until 2026-11-09 the representations were consumed by an untyped pass over the first-order form,
-- consume-reps: word operations replaced by name, closed Nat trees counted into words, facts' numerals
-- read as words.)
-- the rules of d's representation: its two laws, and its op lines read from right to left
rep-rules d =
  case %rlaws d of
    some t → lapp2 (view-of (lcons (fst t) (lcons (fst (snd t)) lnil))) (rep-op-rules (snd (snd t)))
    none → lnil
rep-op-rules gs = case gs of lnil → lnil; lcons g r → (case rule-of-sym g of some ru → lcons ru (rep-op-rules r); none → rep-op-rules r)
rep-rules-of ds = case ds of lnil → lnil; lcons d r → lapp2 (rep-rules d) (rep-rules-of r)
-- the boundary of T (a type code, a non-dependent Π chain): (the represented data types met , (the
-- transported type's code , the program's code transported)), the parameters converted by from and
-- the result by to; okd d decides which represented types are consumed
rep-of-code okd A = case A of cdata d ps → rep-of-d okd d A; _ → none
rep-of-d okd d A = if okd d then rep-of-tab d A (%rtab d) (%rops d) else none
rep-of-tab d A rt ro = case rt of none → none; some R → (case ro of none → none; some t → some (d , (fromopt (quote-ty R) A , t)))
-- the arguments of the transported program: parameter i of n (from the outside) is cvar (n − 1 − i),
-- converted by from when its type is represented
tr-args okd As n i =
  case As of
    lnil → lnil
    lcons A r → lcons (case rep-of-code okd A of some e → capp (cglob (rep-e-from e)) (cvar (%wsub (%wsub n #1) i)); none → cvar (%wsub (%wsub n #1) i)) (tr-args okd r n (%wsucc i))
pi-chain T = case T of cpi m A B → (let tr = pi-chain (unshift #1 B) in (lcons (m , A) (fst tr) , snd tr)); _ → (lnil , T)
tr-ty okd ps B = case ps of lnil → (case rep-of-code okd B of some e → fst (snd e); none → B); lcons p r → cpi (fst p) (case rep-of-code okd (snd p) of some e → fst (snd e); none → snd p) (shift-code #0 #1 (tr-ty okd r B))
tr-ds okd ps B = lapp2 (lmap-opt (λ p → omap (λ e → fst e) (rep-of-code okd (snd p))) ps) (case rep-of-code okd B of some e → lcons (fst e) lnil; none → lnil)
lmap-opt f l = case l of lnil → lnil; lcons x r → (case f x of some y → lcons y (lmap-opt f r); none → lmap-opt f r)
lam-n n b = if %weq n #0 then b else clam (lam-n (%wsub n #1) b)
app-list f as = case as of lnil → f; lcons a r → app-list (capp f a) r
transport-rep okd T c =
  let ch = pi-chain (fromopt (quote-ty T) cword)
      ps = fst ch
      B = snd ch
      n = lst-count ps
      As = lmap-snd ps
      body = app-list c (tr-args okd As n #0)
      out = (case rep-of-code okd B of some e → capp (cglob (rep-e-to e)) body; none → body)
  in (tr-ds okd ps B , (eval-g lnil (tr-ty okd ps B) , lam-n n out))
rep-e-to e = fst (snd (snd e))
rep-e-from e = fst (snd (snd (snd e)))
lmap-snd l = case l of lnil → lnil; lcons p r → lcons (snd p) (lmap-snd r)
all-reps d = true
-- specialize, with the representations consumed in the term; with a schedule, only those it names
-- (every declared one when it names none)
specialize-r T rules c = specialize-r-of all-reps T rules c
specialize-r-of okd T rules c =
  let tr = transport-rep okd T c
  in specialize (fst (snd tr)) (lapp2 rules (rep-rules-of (rep-all-ds okd (fst tr)))) (snd (snd tr))
-- the laws of every representation the boundary names, and of Nat's (a numeral's representation,
-- met inside any program over the byte layer) when the schedule consumes it
rep-all-ds okd ds = if okd nat-d then (if lmem-l nat-d ds then ds else lcons nat-d ds) else ds
specialize-rs sch T rules c =
  let okd = sched-okd (sched-reps sch)
      tr = transport-rep okd T c
  in specialize-s sch (fst (snd tr)) (lapp2 rules (rep-rules-of (rep-all-ds okd (fst tr)))) (snd (snd tr))
sched-okd reps d = case reps of lnil → true; _ → lmem-l d reps
nat-d = didx (code Nat)
-- a schedule naming Nat consumes its representation: a Nat result is a word; one naming another type
-- leaves the Nat at the boundary (its numerals constructor trees)
#same run-fo (fapply (specialize-rs (sched #64 lnil (lcons nat-d lnil) lnil) (Bool → Nat) lnil (code (λ (b : Bool) → if b then 5 else 7))) (lcons (flit #0) lnil)) = #7
#same (case specialize-rs (sched #64 lnil (lcons #0 lnil) lnil) (Bool → Nat) lnil (code (λ (b : Bool) → if b then 5 else 7)) of flam ty b → (case b of fif c t e → (case t of fcon d k fs → true; _ → false); _ → false); _ → false) = true
-- plus on Nat at the boundary: transported, its op line's law and to-from leave the machine's addition
dbl-tr : Nat → Nat
dbl-tr n = plus n n
#same specialize-r (Nat → Nat) lnil (code (λ (n : Nat) → dbl-tr n)) = flam ftword (fprim P-add (lcons (fvar #0) (lcons (fvar #0) lnil)))
#same specialize-r (Nat → Nat → Nat) lnil (code (λ (a : Nat) (b : Nat) → plus (plus a b) a)) = flam ftword (flam ftword (fprim P-add (lcons (fprim P-add (lcons (fvar #1) (lcons (fvar #0) lnil))) (lcons (fvar #1) lnil))))
-- ---------------------------------------------------------------- readings
-- two loads at literal offsets from an unknown buffer, as the decoder's loop computes them: the
-- Nat lengths and offsets (constructor trees in the code) become words, the bound proofs are gone,
-- the conversions are gone, and each dropped proof is an assumed fact around its load. (sum-msgs itself, applied to the unknown buffer, is not unfolded by
-- normalization and its call has no first-order form: a finding for B15, plan 18.6.)
two-loads = code (λ b → plusw (i64toWord (load64 32 b 16 (8 , λ i → 32))) (i64toWord (load64 32 b 0 (24 , λ i → 32))))
sum2 = specialize-r (Bytes 32 → Word) (view-of (lcons (gidx (code plusw≡wadd)) lnil)) two-loads
ld16 = fprim P-load64 (lcons (fvar #0) (lcons (flit #16) lnil))
ld0 = fprim P-load64 (lcons (fvar #0) (lcons (flit #0) lnil))
wof64 t = fprim P-wofi64 (lcons t lnil)
#same sum2 = flam (ftbytes #32) (fprim P-add (lcons (wof64 (fassume (cwop #1 (cwop #2 (cwlit #16) (cwlit #8)) (cwsucc (cwlit #32))) ld16)) (lcons (wof64 (fassume (cwop #1 (cwop #2 (cwlit #0) (cwlit #8)) (cwsucc (cwlit #32))) ld0)) lnil)))
-- it runs natively on a buffer built by the same primitives
buf2 = fprim P-store64 (lcons (fprim P-store64 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (fi64 #5) lnil)))) (lcons (flit #16) (lcons (fi64 #9) lnil)))
#same eval-fo (λ g → flit #0) lnil (fapply sum2 (lcons buf2 lnil)) = vw #14
-- the tagged message decoder of lib/decode.cub, lowered from its code: a switch on the loaded
-- tag, loads at literal offsets, each under its assumed bound (a word constant of the store, one-w,
-- becomes its literal)
one-w : Word
one-w = #1
dm-code = code (λ (b : Bytes 32) → case weq (u32toWord (load32 32 b 0 (28 , λ i → 32))) one-w of true → i64toWord (load64 32 b 8 (16 , λ i → 32)); false → i64toWord (load64 32 b 16 (8 , λ i → 32)))
dm-fo = specialize-r (Bytes 32 → Word) lnil dm-code
mb1 = fprim P-store64 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (flit #1) lnil)))) (lcons (flit #8) (lcons (fi64 #500) lnil)))
mb2 = fprim P-store64 (lcons (fprim P-store32 (lcons (fprim P-bytes (lcons (flit #32) lnil)) (lcons (flit #0) (lcons (flit #2) lnil)))) (lcons (flit #16) (lcons (fi64 #7) lnil)))
#same eval-fo (λ g → flit #0) lnil (fapply dm-fo (lcons mb1 lnil)) = vw #500
#same eval-fo (λ g → flit #0) lnil (fapply dm-fo (lcons mb2 lnil)) = vw #7
-- ---------------------------------------------------------------- processes specialized (D24 with B15)
-- a process run against its world, with the initial state unknown, specializes by normalization: pr1 puts before it gets, so its run is the constant 12
-- whatever the store; pr4 reads key 3 of the store, so its run is a function of the store
out-w : Outcome Word → Word
out-w o = case o of done a → a; stopped → #0; failed r → #0
run1 : (Word → Word) → Word
run1 st = out-w (fst (runp {KVS} {Word} {Word → Word} (pr1 {lzero}) kv-world st))
#same specialize ((Word → Word) → Word) lnil (code (λ (st : Word → Word) → run1 st)) = flam (ftfun (lcons ftword lnil) ftword) (flit #12)
pr4 : {l : Level} → Proc {l} KVS Word
pr4 {l} = bind {l} {KVS} {Word} {Word} (cmd {l} {KVS} (get #3)) (λ a → ret {l} {KVS} {Word} (%wadd a #1))
run4 : (Word → Word) → Word
run4 st = out-w (fst (runp {KVS} {Word} {Word → Word} (pr4 {lzero}) kv-world st))
spec4 = specialize ((Word → Word) → Word) lnil (code (λ (st : Word → Word) → run4 st))
#same spec4 = flam (ftfun (lcons ftword lnil) ftword) (fprim P-add (lcons (fapply (fvar #0) (lcons (flit #3) lnil)) (lcons (flit #1) lnil)))
-- and run natively on a store given as a λ
#same eval-fo (λ g → flit #0) lnil (fapply spec4 (lcons (flam ftword (flit #40)) lnil)) = vw #41
-- ---------------------------------------------------------------- representations consumed in general (B12 §6, B14)
-- program-rep T reps fuel c: the whole program of the code c (at type T) with the representations
-- consumed in the term, each definition transported at its own boundary. Every definition the
-- program reaches is transported along the representations of the data types at its boundary —
-- g_R = to ∘ g ∘ from, T[d := R], a representation's representation followed to the end (RBox by
-- RPt by RPt·W) — with the calls it makes held as calls: the code is normalized with every other
-- definition it names held neutral (lib/specialize.cub's normalize-abs: a variable to the machine),
-- each held h standing for h_R as from ∘ h_R ∘ to, so the conversions between two transported
-- definitions meet in the normal form and cancel by the representation's own laws (to (from x) → x
-- and from (to x) → x, oriented; the op lines read right to left, plus a b → from (wadd (to a) (to
-- b)); plusw a b → wadd a b, plusw≡wadd). Records come through their induced representations
-- (src/syntax.c x_rep_induce: Pt ≃ Pt·W, field by field), so a Nat field of Pt is a word because the
-- program holds a Pt·W, not because a printer reads Pt's fields so. A parameter of a type
-- represented by a record is opened by its eliminator at the boundary (a case on the Pt·W, the
-- record's fields at the constructor, a nested record's opened in turn), so from meets a constructor
-- and computes: λ w → case w of pt·W a b → to (g (from (pt·W a b))), which is to ∘ g ∘ from at every
-- constructor of Pt·W (each branch is it, by refl). Not held: the representations' conversions and
-- what they call (the machine unfolds them, and the rules match their normal forms), the operations
-- the rules rewrite (op lines' sources, plusw), types, and a definition whose code is a primitive
-- operation on its parameters (wadd, wsub, weq, wlt: inlined, as their bodies). reps empty: every declared
-- representation; else those named. Until 2026-11-09 this was an untyped pass over the lowered form
-- (rc: constructors of represented types replaced by to calls or computed literals, recursions on
-- them routed through from, word operations replaced by name, a record's fields read as words by the
-- printers).
rep-entry d = case %rops d of some t → some (alias-of #8 (fst t) , (alias-of #8 (fst (snd t)) , snd (snd t))); none → none
-- a native counterpart written as another definition's name (op plus : … = plusw): that definition
alias-of k g = if %weq k #0 then g else (case %gcode g of some c → (case c of cglob h → alias-of (%wsub k #1) h; _ → g); none → g)
-- the representations of a type code, followed: d by R1, R1 by R2, … while each is a parameterless
-- data type with a representation the schedule consumes; entries as rep-of-d's
rep-chain okd A = case A of cdata d ps → (case ps of lnil → rep-chain-d okd d lnil; _ → lnil); _ → lnil
rep-chain-d okd d seen =
  if lmem-l d seen then lnil
  else (case rep-of-d okd d (cdata d lnil) of
          some e → lcons e (case fst (snd e) of cdata d2 ps2 → (case ps2 of lnil → rep-chain-d okd d2 (lcons d seen); _ → lnil); _ → lnil)
          none → lnil)
chain-final A ch = case ch of lnil → A; lcons e r → chain-final (fst (snd e)) r
-- the last represented type of a chain (the one whose representation is the final type)
chain-last ch = case ch of lnil → none; lcons e r → (case r of lnil → some (fst e); _ → chain-last r)
-- from along the chain (the final type's value to the type's), to along it (the type's to the final's)
chain-from ch x = case ch of lnil → x; lcons e r → capp (cglob (rep-e-from e)) (chain-from r x)
chain-to ch y = case ch of lnil → y; lcons e r → chain-to r (capp (cglob (rep-e-to e)) y)
chain-ds ch = case ch of lnil → lnil; lcons e r → lcons (fst e) (chain-ds r)
-- the transported type: each domain of the Π chain and its codomain by its chain's final type
tr-ty-c okd T = case T of cpi m A B → cpi m (chain-final A (rep-chain okd A)) (tr-ty-c okd B); _ → chain-final T (rep-chain okd T)
-- the domains of a Π chain (as written under their binders) and its codomain
pi-doms T = case T of cpi m A B → lcons A (pi-doms B); _ → lnil
pi-cod T = case T of cpi m A B → pi-cod B; _ → T
-- the represented data types at a type's boundary
ty-ds okd T = lapp2 (lconcat-r (lmap-r (λ A → chain-ds (rep-chain okd A)) (pi-doms T))) (chain-ds (rep-chain okd (pi-cod T)))
lmap-r f l = case l of lnil → lnil; lcons x r → lcons (f x) (lmap-r f r)
lconcat-r l = case l of lnil → lnil; lcons x r → lapp2 x (lconcat-r r)
-- ---- opening a record at the boundary
-- a record: a parameterless data type, not Bool, with constructors and no recursive field
rec-dt d = if %weq d bool-idx then false else andb (notb (%weq (nctors-t d) #0)) (rec-ctors d (nctors-t d) #0)
rec-ctors d n c = if %weq c n then true else andb (notb (lmem-l #1 (lmap-r (λ k → fst k) (cshape d c)))) (rec-ctors d n (%wsucc c))
-- what to open a value of type A by: (its final type dF , the type dP before it) when the chain ends
-- in a record
open-target ch = case chain-final cword ch of cdata dF ps → (case chain-last ch of some dP → (if rec-dt dF then some (dF , dP) else none); none → none); _ → none
-- field j of constructor c of dF opens when dP's field j is a type whose chain ends in that field's
-- record (a nested record's representation): (its dF2 , dP2)
field-open okd dF dP c j k =
  if %weq (fst k) #2
    then (case lnth (cshape dP c) j of
            some ko → (if andb (%weq (fst ko) #2) (notb (%weq (snd ko) (snd k)))
                         then (case open-target (rep-chain okd (cdata (snd ko) lnil)) of some p → (if %weq (fst p) (snd k) then some p else none); none → none)
                         else none)
            none → none)
    else none
field-opens okd dF dP c ks j = case ks of lnil → lnil; lcons k r → lcons (field-open okd dF dP c j k) (field-opens okd dF dP c r (%wsucc j))
-- the variable at level L under D binders
ix D L = cvar (%wsub (%wsub D #1) L)
-- open-raw okd dF dP L D k: a case on the value at level L (a dF), each constructor's fields bound at
-- levels D …, those that open opened in turn; k fb D2 is the body at depth D2, fb D3 the record
-- rebuilt from its fields (a constructor of dF) at depth D3
open-raw okd dF dP L D k = ccase dF (open-alts okd dF dP L D k (nctors-t dF) #0) (ix D L)
open-alts okd dF dP L D k n c = if %weq c n then lnil else lcons (open-alt okd dF dP L D k c) (open-alts okd dF dP L D k n (%wsucc c))
open-alt okd dF dP L D k c =
  let ks = cshape dF c
      nf = lst-count ks
  in lam-n nf (open-fields okd dF dP c (field-opens okd dF dP c ks #0) D #0 (%wadd D nf) lnil k)
open-fields okd dF dP c specs D0 j D acc k =
  case specs of
    lnil → k (λ D2 → ccon dF c (lmap-r (λ fb → fb D2) acc) lnil) D
    lcons s r → (case s of
                   some p → open-raw okd (fst p) (snd p) (%wadd D0 j) D (λ fb D2 → open-fields okd dF dP c r D0 (%wsucc j) D2 (lsnoc acc fb) k)
                   none → open-fields okd dF dP c r D0 (%wsucc j) D (lsnoc acc (λ D2 → ix D2 (%wadd D0 j))) k)
-- the parameters (types As, at levels L …): each one's argument builder, from along its chain of
-- its value (opened when its chain ends in a record); k args D is the body at depth D
open-params okd As L D acc k =
  case As of
    lnil → k acc D
    lcons A r →
      (let ch = rep-chain okd A
       in case open-target ch of
            some p → open-raw okd (fst p) (snd p) L D (λ fb D2 → open-params okd r (%wsucc L) D2 (lsnoc acc (λ D3 → chain-from ch (fb D3))) k)
            none → open-params okd r (%wsucc L) D (lsnoc acc (λ D3 → chain-from ch (ix D3 L))) k)
-- ---- the held definitions
-- a held definition h standing for h_R (the variable at index v): λ x… → from (v (to x) …), each
-- along its type's chain
held-wrap okd h v =
  let T = fromopt (quote-ty (%gty h)) cword
      As = pi-doms T
      n = lst-count As
  in lam-n n (chain-from (rep-chain okd (pi-cod T)) (app-list (cvar (%wadd v n)) (held-args okd As n #0)))
held-args okd As n i = case As of lnil → lnil; lcons A r → lcons (chain-to (rep-chain okd A) (cvar (%wsub (%wsub n #1) i))) (held-args okd r n (%wsucc i))
-- the definitions a code's normalization holds: every global it names but the conversions and what
-- the rules rewrite (ex), types, and definitions of primitive operations only
holds-of ex c = lfilter-g (λ g → hold-ok ex g) (code-globals c)
hold-ok ex g = if lmem-l g ex then false else (case %view (%gty g) of wu l → false; _ → notb (prim-only g))
-- (λs over one primitive operation on variables and literals: wadd a b = %wadd a b; not an identity
-- or a constant, which stay calls)
prim-only g = case %gcode g of some c → prim-op-code (strip-clams c); none → false
strip-clams c = case c of clam b → strip-clams b; _ → c
prim-op-code c = case c of cwop k a b → andb (prim-op-arg a) (prim-op-arg b); cwsucc a → prim-op-arg a; cprim k as → lall-r prim-op-arg as; _ → false
prim-op-arg c = case c of cvar n → true; cwlit n → true; cplit k b → true; _ → prim-op-code c
lall-r p l = case l of lnil → true; lcons x r → andb (p x) (lall-r p r)
-- the conversions of the representations of ds (to and from, and the definitions they are written
-- as), and the sources of their op lines
rep-ex ds = lconcat-r (lmap-r rep-ex-d ds)
rep-ex-d d = case %rops d of some t → lcons (fst t) (lcons (fst (snd t)) (lcons (alias-of #8 (fst t)) (lcons (alias-of #8 (fst (snd t))) (lmap-r (λ o → fst o) (snd (snd t)))))); none → lnil
-- the word laws the program is rewritten along beyond the representations', and what they rewrite
word-laws = lcons (gidx (code plusw≡wadd)) lnil
word-law-ex = lcons (gidx (code plusw)) lnil
-- ---- one definition transported
-- tr-def okd T c: the code c at type T transported at its boundary, its calls held, normalized,
-- rewritten and its held calls back as globals (each standing for its definition transported)
tr-def okd T c =
  let gs = code-globals c
      ds0 = lapp2 (ty-ds okd T) (lconcat-r (lmap-r (λ g → ty-ds okd (fromopt (quote-ty (%gty g)) cword)) gs))
      ds = if okd nat-d then lcons nat-d ds0 else ds0
      hs = holds-of (lapp2 (rep-ex ds) word-law-ex) c
      k = lst-count hs
      As = pi-doms T
      n = lst-count As
      chB = rep-chain okd (pi-cod T)
      body = open-params okd As k (%wadd k n) lnil (λ args D → chain-to chB (app-list (glob-map (λ g d → omap (λ j → held-wrap okd g (%wsub (%wsub (%wadd D d) #1) j)) (lindex-g g hs #0)) #0 c) (lmap-r (λ a → a D) args)))
      TR = eval-g lnil (tr-ty-c okd T)
      Ts = lmap-r (λ g → eval-g lnil (tr-ty-c okd (fromopt (quote-ty (%gty g)) cword))) hs
      TT = pis-g Ts TR
      rules = lapp2 (rep-rules-of ds) (view-of word-laws)
      n0 = fromopt (norm-held-form hs Ts TR (lam-n n body)) (lam-k k (lam-n n body))
  in eta-cases (unhold-tr okd hs (norm-rewrite TT rules #4 n0))
-- the held λs stripped, each variable its global again, annotated with the global's transported type
-- (the call is of g_R: lowering types it by the annotation, not by g's own type)
unhold-tr okd hs n =
  let k = lst-count hs
  in var-map-c (λ m e → (let i = %wsub m e in if %wlt i k then (case lnth hs (%wsub (%wsub k #1) i) of some g → cann (cglob g) (tr-ty-c okd (fromopt (quote-ty (%gty g)) cword)); none → cvar m) else cvar (%wsub m k))) #0 (strip-k k n)
-- rewriting and normalizing in turn, in the held form (under the held λs, typed TT), to the fixpoint
-- or i rounds: a rule's right side can expose a redex the machine computes (to of a numeral, in
-- plus a 1 → from (wadd (to a) (to 1))), and the machine's result can hold a rule's left side
norm-rewrite TT rules i c =
  let r = rewrite-all #64 rules c
  in if orb (%weq i #0) (code-same r c) then r else norm-rewrite TT rules (%wsub i #1) (fromopt (quote-top TT (eval-g lnil r)) r)
-- the eliminator's η, on a case of a variable of a record: in branch k the constructor k rebuilt from
-- the branch's fields is the variable itself; a case whose branches are one body naming none of their
-- fields is that body (each holds of the case by elimination on the variable, refl per constructor).
-- The boundary's opening leaves such cases where a record is passed on whole
eta-cases c = cmap eta-at #0 c
eta-at p d =
  case p of
    ccase dd B x → (case x of cvar v → (if rec-dt dd then some (eta-case dd (lmap-r (λ b → cmap eta-at d b) B) v) else none); _ → none)
    _ → none
eta-case dd B v =
  let bs = eta-alts dd B v #0
  in if lall-r (λ b → notb (uses-fields (fst b) (snd b))) bs
       then (case bs of lcons b0 r → (let u = unshift-fields (fst b0) (snd b0) in if lall-r (λ b → code-same (unshift-fields (fst b) (snd b)) u) r then u else ccase dd (lmap-r (λ b → lam-n (fst b) (snd b)) bs) (cvar v)); lnil → ccase dd B (cvar v))
       else ccase dd (lmap-r (λ b → lam-n (fst b) (snd b)) bs) (cvar v)
-- each branch as (its field count , its body with the rebuilt constructor the variable)
eta-alts dd B v k = case B of lnil → lnil; lcons b r → (let nf = lst-count (cshape dd k) in lcons (nf , cmap (rebuilt-var dd k nf v) #0 (strip-n nf b)) (eta-alts dd r v (%wsucc k)))
rebuilt-var dd k nf v p e = case p of ccon d2 k2 fs ds → (if andb (%weq d2 dd) (andb (%weq k2 k) (andb (isnil-g ds) (fields-in-order fs e nf))) then some (cvar (%wadd v (%wadd nf e))) else none); _ → none
fields-in-order fs e j = case fs of lnil → %weq j #0; lcons f r → (case f of cvar m → andb (notb (%weq j #0)) (andb (%weq m (%wadd e (%wsub j #1))) (fields-in-order r e (%wsub j #1))); _ → false)
-- whether a branch body names one of its nf fields (the variables below nf at its top)
uses-fields nf b = lmem field-mark (code-globals (var-map-c (λ m e → if %wlt (%wsub m e) nf then cglob field-mark else cvar m) #0 b))
field-mark = #4294967295000
unshift-fields nf b = var-map-c (λ m e → cvar (%wsub m nf)) #0 b
def-code g = case %gcode g of some c → some c; none → unfold g
-- the definitions reached from the globals todo, (g , (arity , body)), each transported
defs-rep okd fuel todo seen =
  if %weq fuel #0 then lnil else
  (case todo of
     lnil → lnil
     lcons g rest →
       if lmem g seen then defs-rep okd fuel rest seen
       else (case def-code g of
               none → defs-rep okd (%wsub fuel #1) rest (lcons g seen)
               some cd →
                 let t = inplace (erase-lams (g-erased g) #0 (lower-tr okd (fromopt (quote-ty (%gty g)) cword) cd))
                 in lcons (g , (lam-sig t , strip-flams t)) (defs-rep okd (%wsub fuel #1) (lapp2 rest (fcalls t lnil)) (lcons g seen))))
-- a code at the type T (a code) transported and lowered at the transported type
lower-tr okd T c = lower (eval-g lnil (tr-ty-c okd T)) (tr-def okd T c)
program-rep T reps fuel c = program-rep-at T #0 reps fuel c
program-rep-at T m reps fuel c =
  let okd = sched-okd reps
      t = inplace (lower-tr okd (fromopt (quote-ty T) cword) c)
  in lcons (m , (lam-sig t , offset-calls (strip-flams t))) (offset-defs (defs-rep okd fuel (fcalls t lnil) lnil))
-- readings: a program over Nat with Nat laid out as Word — plus the native addition (its op line),
-- a case on a Nat through from, a constructor through to, a Nat field of a list a word
dbl-rp : Nat → Nat
dbl-rp n = plus n n
pred-rp : Nat → Nat
pred-rp n = case n of zero → zero; suc k → k
suml-r : List Nat → Nat
suml-r l = case l of nil → 0; cons x xs → plus x (rec xs)
run-rep T c args = eval-fo (table-of (lift-program #100000 (program-rep T lnil #20 c))) lnil (fcall #0 args)
#same program-rep (Nat → Nat) lnil #20 (code (λ (n : Nat) → dbl-rp n)) = lcons (#0 , (lcons ftword lnil , fcall (%wsucc (gidx (code dbl-rp))) (lcons (fvar #0) lnil))) (lcons (%wsucc (gidx (code dbl-rp)) , (lcons ftword lnil , fprim P-add (lcons (fvar #0) (lcons (fvar #0) lnil)))) lnil)
#same run-rep (Nat → Nat) (code (λ (n : Nat) → dbl-rp n)) (lcons (flit #21) lnil) = vw #42
#same run-rep (Nat → Nat) (code (λ (n : Nat) → pred-rp (dbl-rp n))) (lcons (flit #21) lnil) = vw #41
#same run-rep (Nat → Nat) (code (λ (n : Nat) → suml-r (cons n (cons 5 (cons (suc n) nil))))) (lcons (flit #3) lnil) = vw #12
#same run-rep (Nat → Nat) (code (λ (n : Nat) → plus 7 n)) (lcons (flit #3) lnil) = vw #10
-- a type represented by a record (represent RBox by RPt): a constructor of RBox is to of the RPt
-- built from words, its Nat fields read back through from (a Nat field of the record is a word); a
-- case on an RBox reads from of it. Before the fix the fields were passed to RPt's from as if trees:
-- bump (rbox 1 2) answered rbox 10 0, so the sum read 10, not 12
data RPt = rpt (a : Nat) (b : Nat)
data RBox = rbox (x : Nat) (y : Nat)
rbox-to : RBox → RPt
rbox-to b = case b of rbox x y → rpt x y
rbox-from : RPt → RBox
rbox-from p = case p of rpt a c → rbox a c
represent RBox by RPt where
  to : RBox → RPt = rbox-to
  from : RPt → RBox = rbox-from
  to-from : (p : RPt) → to (from p) ≡ p = λ p → case p return (λ q → rbox-to (rbox-from q) ≡ q) of rpt a c → (λ i → rpt a c)
  from-to : (b : RBox) → from (to b) ≡ b = λ b → case b return (λ q → rbox-from (rbox-to q) ≡ q) of rbox x y → (λ i → rbox x y)
rbox-bump : RBox → RBox
rbox-bump b = case b of rbox x y → rbox (plus x 9) y
rbox-sum : RBox → Nat
rbox-sum b = case b of rbox x y → plus x y
#same run-rep (Nat → Nat) (code (λ (n : Nat) → rbox-sum (rbox-bump (rbox n 2)))) (lcons (flit #1) lnil) = vw #12
#same run-rep (Nat → Nat) (code (λ (n : Nat) → rbox-sum (rbox n 2))) (lcons (flit #1) lnil) = vw #3
