-- Layer: not core: in the core's load order only because untyped (the bootstrap admits untyped files); leaves it when written with types (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/lin.cub — linear arithmetic over codes: normal forms, equality, and certificate checking
-- (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.13 “F31–F32 — Reflection and certificates”, its part F32). Loaded after lib/code.cub, before lib/check.cub.
-- The fragment: words built from literals (cwlit), variables (cvar), addition (cwop #2) and
-- successor (cwsucc). A linear form is a constant and a list of (variable, coefficient) sorted by
-- variable, coefficients nonzero. Two codes of the fragment denote equal words exactly when their
-- forms are equal (the normalizer is complete for the commutative monoid of words under
-- addition). For order over naturals: a ≤ b holds whenever b's form dominates a's pointwise
-- (constant and every coefficient), since every variable is ≥ 0; a Farkas certificate for a goal
-- under hypotheses h_i : l_i ≤ r_i is a list of nonnegative multipliers c_i, and the goal a ≤ b
-- follows when a + Σ c_i r_i ≤ b + Σ c_i l_i pointwise. The checker verifies that; it does not
-- search for the multipliers (18.13: search is unverified and separate). Soundness of the check
-- is a theorem about these definitions (to be stated in lib/std.cub against the ring laws of
-- plusw); the checker is the small verified part, the search the unverified part.
-- ---------------------------------------------------------------- forms
-- a form: constant, then the sorted coefficient list
data Lin = lin (k : Word) (cs : Lst)
-- coefficient lists: Lst of (variable , coefficient), sorted by variable, coefficients nonzero
coef-add cs ds =
  case cs of
    lnil → ds
    lcons p cr →
      (case ds of
         lnil → cs
         lcons q dr →
           if %wlt (fst p) (fst q) then lcons p (coef-add cr ds)
           else if %wlt (fst q) (fst p) then lcons q (coef-add cs dr)
           else lcons (fst p , %wadd (snd p) (snd q)) (coef-add cr dr))
coef-scale c cs = if %weq c #0 then lnil else scale-go c cs
scale-go c cs = case cs of lnil → lnil; lcons p r → lcons (fst p , wmulw c (snd p)) (scale-go c r)
wmulw a b = %wmul a b
lin-add a b = case a of lin k cs → (case b of lin m ds → lin (%wadd k m) (coef-add cs ds))
lin-scale c a = case a of lin k cs → lin (wmulw c k) (coef-scale c cs)
lin-const k = lin k lnil
lin-var v = lin #0 (lcons (v , #1) lnil)
-- the form of a code of the fragment; none outside it
linearize c =
  case c of
    cwlit n → some (lin-const n)
    cvar v → some (lin-var v)
    cwsucc a → omap (lin-add (lin-const #1)) (linearize a)
    cwop o a b →
      if %weq o #2
        then obind (linearize a) (λ la → omap (lin-add la) (linearize b))
        else none
    cann t T → linearize t
    _ → none
obind o f = case o of none → none; some x → f x
-- ---------------------------------------------------------------- equality and order
coef-same cs ds =
  case cs of
    lnil → (case ds of lnil → true; _ → false)
    lcons p r → (case ds of lcons q s → andb (%weq (fst p) (fst q)) (andb (%weq (snd p) (snd q)) (coef-same r s)); _ → false)
lin-same a b = case a of lin k cs → (case b of lin m ds → andb (%weq k m) (coef-same cs ds))
-- a ≤ b pointwise: every coefficient of a is ≤ b's (a variable absent from b has coefficient 0)
coef-le cs ds =
  case cs of
    lnil → true
    lcons p r →
      (case ds of
         lnil → false
         lcons q s →
           if %wlt (fst p) (fst q) then false
           else if %wlt (fst q) (fst p) then coef-le cs s
           else andb (notb (%wlt (snd q) (snd p))) (coef-le r s))
lin-le a b = case a of lin k cs → (case b of lin m ds → andb (notb (%wlt m k)) (coef-le cs ds))
-- decide a = b and a ≤ b on codes of the fragment, with no hypotheses
dec-eq a b = case linearize a of some la → (case linearize b of some lb → lin-same la lb; none → false); none → false
dec-le a b = case linearize a of some la → (case linearize b of some lb → lin-le la lb; none → false); none → false
-- ---------------------------------------------------------------- certificates
-- hypotheses: a Lst of (l , r) codes meaning l ≤ r; a certificate: a Lst of multipliers, one per
-- hypothesis, in order. check-cert hs cert a b: a ≤ b follows
sum-scaled hs cert pick =
  case hs of
    lnil → some (lin-const #0)
    lcons h hr →
      (case cert of
         lnil → none
         lcons c cr →
           obind (linearize (pick h)) (λ lh →
             obind (sum-scaled hr cr pick) (λ rest → some (lin-add (lin-scale c lh) rest))))
check-cert hs cert a b =
  case linearize a of
    none → false
    some la →
      (case linearize b of
         none → false
         some lb →
           (case sum-scaled hs cert (λ h → snd h) of
              none → false
              some sr →
                (case sum-scaled hs cert (λ h → fst h) of
                   none → false
                   some sl → lin-le (lin-add la sr) (lin-add lb sl))))
-- ---------------------------------------------------------------- search (unverified)
-- find a certificate with multipliers up to m per hypothesis, by enumeration: small problems
-- only (the validity facts of a decoder have a handful of hypotheses). What it returns is checked
-- by check-cert before use, so nothing here is trusted
find-cert m hs a b = search-cert m (lst-len hs) hs a b lnil
lst-len l = case l of lnil → #0; lcons x xs → %wsucc (lst-len xs)
-- enumerate multiplier lists of length n over 0..m, left to right, checking each complete one
search-cert m n hs a b acc =
  if %weq n #0
    then (if check-cert hs (lst-rev acc) a b then some (lst-rev acc) else none)
    else try-from #0 m n hs a b acc
try-from c m n hs a b acc =
  if %wlt m c then none
  else (case search-cert m (%wsub n #1) hs a b (lcons c acc) of
          some r → some r
          none → try-from (%wsucc c) m n hs a b acc)
lst-rev l = rev-onto l lnil
rev-onto l acc = case l of lnil → acc; lcons x xs → rev-onto xs (lcons x acc)
-- ---------------------------------------------------------------- search, directed (unverified)
-- Fourier–Motzkin elimination with the multipliers tracked (the omega test's core, over the
-- nonnegative combinations, which is all a Farkas certificate over Nat needs): the goal a ≤ b is
-- refuted by adding b + 1 ≤ a to the hypotheses and eliminating the variables one at a time;
-- each constraint carries the multipliers of the hypotheses it is a combination of (the last
-- one the negated goal's); a constraint with no variables and a left constant above its right
-- is the contradiction, and its multipliers, divided by the goal's, are the certificate, which
-- check-cert then checks. Enumeration (find-cert) is for tiny problems; this is for small ones
wdiv a b = %wdiv a b
wmod a b = %wmod a b
wgcd a b = if %weq b #0 then a else wgcd b (wmod a b)
-- coefficient of a variable in a form
coef-of v cs = case cs of lnil → #0; lcons p r → if %weq (fst p) v then snd p else coef-of v r
lin-coef v f = case f of lin k cs → coef-of v cs
lin-k f = case f of lin k cs → k
lin-vars f = case f of lin k cs → cl-map (λ p → fst p) cs
-- the variables of a list of constraints, without repeats
vars-add xs acc = case xs of lnil → acc; lcons x r → vars-add r (if mem-w-lst x acc then acc else lcons x acc)
mem-w-lst x l = case l of lnil → false; lcons y r → if %weq x y then true else mem-w-lst x r
all-vars cs = case cs of lnil → lnil; lcons c r → vars-add (lin-vars (fst (snd c))) (vars-add (lin-vars (snd (snd c))) (all-vars r))
-- a constraint: (multipliers , (l , r)) meaning l ≤ r; scaled and added
lst-scale c l = cl-map (λ x → wmulw c x) l
lst-add a b = case a of lnil → b; lcons x r → (case b of lnil → a; lcons y s → lcons (%wadd x y) (lst-add r s))
con-comb c1 k1 c2 k2 =
  (lst-add (lst-scale k1 (fst c1)) (lst-scale k2 (fst c2)) ,
   (lin-add (lin-scale k1 (fst (snd c1))) (lin-scale k2 (fst (snd c2))) ,
    lin-add (lin-scale k1 (snd (snd c1))) (lin-scale k2 (snd (snd c2)))))
-- eliminating v: the constraints where v's coefficients agree stay; an L (more v on the left) and an
-- R (more on the right) combine so that v cancels; and since v ≥ 0, an L also stays with v dropped
-- from both sides (the step that is specific to Nat: x + y ≤ 3 gives x ≤ 3 with no R to pair)
fm-elim v cs = fm-go v cs lnil lnil lnil
fm-go v cs keep ls rs =
  case cs of
    lnil → lin-app keep (lin-app (cross ls rs) (cl-map (λ l → con-drop v (snd l)) ls))
    lcons c r →
      (let a = lin-coef v (fst (snd c))
           b = lin-coef v (snd (snd c))
       in if %weq a b then fm-go v r (lcons c keep) ls rs
          else if %wlt b a then fm-go v r keep (lcons (%wsub a b , c) ls) rs
          else fm-go v r keep ls (lcons (%wsub b a , c) rs))
lin-app a b = case a of lnil → b; lcons x r → lcons x (lin-app r b)
coef-drop v cs = case cs of lnil → lnil; lcons p r → if %weq (fst p) v then r else lcons p (coef-drop v r)
lin-drop v f = case f of lin k cs → lin k (coef-drop v cs)
con-drop v c = (fst c , (lin-drop v (fst (snd c)) , lin-drop v (snd (snd c))))
cross ls rs = case ls of lnil → lnil; lcons l r → lin-app (cross-one l rs) (cross r rs)
cross-one l rs =
  case rs of
    lnil → lnil
    lcons r s →
      (let g = wgcd (fst l) (fst r)
       in lcons (con-comb (snd l) (wdiv (fst r) g) (snd r) (wdiv (fst l) g)) (cross-one l s))
fm-all vs cs = case vs of lnil → cs; lcons v r → (if %wlt #64 (lst-len cs) then cs else fm-all r (fm-elim v cs))
-- the contradiction: a constraint whose variables cancel and whose left constant exceeds the right
contra cs =
  case cs of
    lnil → none
    lcons c r → if %wlt (lin-k (snd (snd c))) (lin-k (fst (snd c))) then some (fst c) else contra r
-- multipliers divided by the goal's (the last), when it divides them all
divide-by g l = case l of lnil → some lnil; lcons x r → (if %weq (wmod x g) #0 then omap (lcons (wdiv x g)) (divide-by g r) else none)
split-last l = case l of lnil → (lnil , #0); lcons x r → (case r of lnil → (lnil , x); _ → (let p = split-last r in (lcons x (fst p) , snd p)))
unit-vec i n = unit-from #0 i n
unit-from j i n = if %weq j n then lnil else lcons (if %weq i j then #1 else #0) (unit-from (%wsucc j) i n)
hyp-cons hs i n =
  case hs of
    lnil → some lnil
    lcons h r →
      obind (linearize (fst h)) (λ l → obind (linearize (snd h)) (λ rr →
        omap (lcons (unit-vec i n , (l , rr))) (hyp-cons r (%wsucc i) n)))
omega-cert hs a b =
  let n = %wsucc (lst-len hs)
  in obind (linearize a) (λ la → obind (linearize b) (λ lb → obind (hyp-cons hs #0 n) (λ cs0 →
       let cs = lcons (unit-vec (lst-len hs) n , (lin-add lb (lin-const #1) , la)) cs0
           out = fm-all (all-vars cs) cs
       in obind (contra out) (λ ms →
            let p = split-last ms
            in if %weq (snd p) #0 then none
               else obind (divide-by (snd p) (fst p)) (λ cert →
                      if check-cert hs cert a b then some cert else none)))))