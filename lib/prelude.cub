-- prelude.cub — the library over the core forms (HANDOFF §§14–18).
-- The machine's composition rule opens a family at a fresh dimension and,
-- by its head, applies one of the %comp-* clauses below to the family's
-- components as lines. A tube is a system of lines; transformations of a
-- tube act branchwise with sysmap.
-- universe levels: U carries its level; lomega is the level of types quantifying over levels
data Level = lzero | lsuc (l : Level) | lmax (a : Level) (b : Level) | lomega
-- guarded recursion: clocks (κ0 the one closed clock) and the ticks of a clock (⋄ the tick a
-- clock not otherwise in use may give, read only by forceκ). Neither is a type in a universe: the
-- checker takes them as the domains of Π types only (▸ κ A = (α : Tick κ) → A)
data Clock = κ0
data Tick (k : Clock) = ⋄
-- fill^i A [φ ↦ u] a0 (r) = comp^j A(r∧j) [φ ↦ u(r∧j), (r=0) ↦ a0] a0
fill A u a0 r =
  comp (λ (j : I) → A @ (r /\ j))
    (sys+ (r = 0) (λ (j : I) → a0) (sysmap (λ w (j : I) → w @ (r /\ j)) u)) a0
transp A a0 = comp A [] a0
hcomp A u a0 = comp (λ (i : I) → A) u a0
-- equivalences (§15)
Contr X = (c : X) × ((x : X) → PathP (λ (i : I) → X) c x)
fib X Y f y = (x : X) × PathP (λ (i : I) → Y) (f x) y
%Equiv X Y = (f : X → Y) × ((y : Y) → Contr (fib X Y f y))
-- composition clauses (§14, §16, §17)
%comp-pi D E u f0 x1 =
  let vl = λ (k : I) → fill (λ (j : I) → D @ ~ j) [] x1 (~ k)
  in comp (λ (i : I) → (E @ i) (vl @ i)) (sysmap (λ w (i : I) → (w @ i) (vl @ i)) u) (f0 (vl @ 0))
%comp-sigma D E u z0 =
  let al = λ (k : I) → fill D (sysmap (λ w (i : I) → fst (w @ i)) u) (fst z0) k
  in (al @ 1 , comp (λ (i : I) → (E @ i) (al @ i)) (sysmap (λ w (i : I) → snd (w @ i)) u) (snd z0))
%comp-path P l r u p0 =
  λ (j : I) →
    comp (λ (i : I) → P @ i @ j)
      (sys+ (j = 0) l
         (sys+ (j = 1) r (sysmap (λ w (i : I) → %@ (w @ i) j (l @ i) (r @ i)) u)))
      (%@ p0 j (l @ 0) (r @ 0))
-- composition in the universe: a type of its own (Cubical Agda's hcomp in Type) whose faces are
-- the tube's type lines from the base, with the complement of the tube's face on the base itself,
-- so a closed composition of types is a type, never a formal one. Its elements are glue values;
-- on a face unglue is transport back along that face's line
%comp-u u A0 = %hcompU A0 (sys+ (%fneg (faceof u)) (λ (j : I) → A0) u)
%unglue-line w b = comp (λ (j : I) → w @ ~ j) [] b
-- the fibre of transport along L over b that extends the fibres (a , refl) given on the face of
-- pa (b is the transport of a there): the transport fillers along L and one composition back
-- along L, never an equivalence's contractibility
%tproof L pa b =
  let tf = sysmap (λ a (i : I) → fill L [] a i) pa
      gl = λ (k : I) → fill (λ (i : I) → L @ ~ i) (sysmap (λ t (i : I) → t @ ~ i) tf) b k
      x = gl @ 1
  in (x
     , λ (j : I) →
         comp L (sys+ (j = 0) (λ (i : I) → fill L [] x i) (sys+ (j = 1) (λ (i : I) → gl @ ~ i) tf)) x)
-- composition in a line of compositions of types (S a line of systems of type lines from A):
-- the base composed with the unglued tube and, where the whole line is on a face, the unglued
-- filler of the faces' ends; then on the end's faces the transport fibre over it
%comp-gluel A S u u0 =
  let a0 = %unglueU (S @ 0) u0
      delta = (∀ i → (faceof (S @ i)))
      tl = λ (k : I) → fill (λ (i : I) → (S @ i) @ 1) u u0 k
      a1 =
        comp A
          (sys+ delta (λ (i : I) → %unglueU (S @ i) (tl @ i))
             (sysmap (λ w (i : I) → %unglueU (S @ i) (w @ i)) u)) a0
      tp =
        sysmap (λ w → %tproof (λ (j : I) → w @ ~ j) (sys+ delta (tl @ 1) (sysmap (λ v → v @ 1) u)) a1)
          (S @ 1)
  in glue (sysmap (λ e → fst e) tp)
       (hcomp (A @ 1) (sys+ (faceof tp) (sysmap (λ e (q : I) → (snd e) @ (~ q)) tp) (sysmap (λ w (q : I) → a1) u)) a1)
%comp-glue A S u u0 =
  let a0 = unglue (S @ 0) u0
      al = λ (k : I) → fill A (sysmap (λ w (i : I) → unglue (S @ i) (w @ i)) u) a0 k
      a1 = al @ 1
      delta = (∀ i → (faceof (S @ i)))
      S1 = S @ 1
      alpha1 = faceof S1
      vpart = sys+ delta
                (let tl = λ (k : I) → fill (λ (i : I) → fst (S @ i)) u u0 k
                 in (tl @ 1
                    , λ (q : I) →
                        comp A
                          (sys+ (q = 0) (λ (i : I) → fst (snd (S @ i)) (tl @ i))
                             (sys+ (q = 1) al (sysmap (λ w → al) u))) a0))
                (sysmap (λ w → (w @ 1 , λ (q : I) → a1)) u)
      tp = sys+ alpha1
             (let C = snd (snd S1) a1
              in hcomp (fib (fst S1) (A @ 1) (fst (snd S1)) a1)
                   (sysmap (λ w (j : I) → %@ (snd C w) j (fst C) w) vpart) (fst C)) []
      P = sysmap (λ e (q : I) → %@ (snd e) (~ q) (fst (snd S1) (fst e)) a1) tp
  in glue (sysmap (λ e → fst e) tp)
       (hcomp (A @ 1) (sys+ (faceof P) P (sysmap (λ w (q : I) → a1) u)) a1)
-- the partial fibre element over delta ∨ psi
-- extended under alpha1 by the contraction of e1's fibre
-- induction hypotheses of fields recursive under paths, Π codomains and Σ components (18.18): from
-- h, the hypothesis of the fibre, the hypothesis of the field: at every dimension, at every
-- argument, at each recursive component
%ih-path h p = λ (i : I) → h (p @ i)
%ih-pi h k = λ x → h (k x)
%ih-fst h p = h (fst p)
%ih-snd h p = h (snd p)
%ih-pair h1 h2 p = (h1 (fst p) , h2 (snd p))
-- elimination of a higher inductive type on a formal hcomp (CHM):
-- f (hcomp^i [φ ↦ u] u0) = comp^i P(hfill^i [φ ↦ u] u0) [φ ↦ f u] (f u0)
%case-hcomp P f u u0 =
  comp
    (λ (%i : I) →
       P (hcompD (sys+ (%i = 0) (λ (%j : I) → u0) (sysmap (λ %w (%j : I) → %w @ (%i /\ %j)) u)) u0))
    (sysmap (λ %w (%i : I) → f (%w @ %i)) u) (f u0)
-- data types
data Bool = true | false
and a b = if a then b else false
data Nat = zero | suc (n : Nat)
add m n = case m of zero → n; suc k → suc (add k n)
mul m n = case m of zero → zero; suc k → add n (mul k n)
iszero n = case n of zero → true; suc k → false
data List (A : Type) = nil | cons (x : A) (xs : List A)
map f xs = case xs of nil → nil; cons x r → cons (f x) (map f r)
length xs = case xs of nil → zero; cons x r → suc (length r)
append xs ys = case xs of nil → ys; cons x r → cons x (append r ys)
