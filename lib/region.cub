-- region.cub — the Region threading idiom (plan C20, item 20): a region is a byte string the program
-- owns, Bytes n, passed and returned as state. A program over a region is a state transformer
-- RM n A = Bytes n → Bytes n × A; its reads and writes are lib/prim.cub's load64/store64 at an offset
-- with the proof that the access fits, so a program over a region is safe (#safe lists nothing)
-- unless it reaches memory the program does not own (enter-at, through region-at, trusted).
-- Pointers into a region are offsets with their proof (Ptr n): aliasing pointers are integers
-- into the region threaded as state, not wires (6.4). The region is unique along the thread: the
-- idiom is how a program mutates memory without a mutable reference.
-- Loaded after lib/prim.cub.

Region : Nat → Type
Region n = Bytes n
-- a program over a region of n bytes with result A
RM : Nat → Type → Type
RM n A = Region n → Region n × A
-- a pointer to an 8-byte cell of the region: its offset and the proof that the cell fits
Ptr : Nat → Type
Ptr n = (off : Nat) × le (plus off 8) n

rret : {n : Nat} {A : Type} → A → RM n A
rret a = λ r → (r , a)
rbind : {n : Nat} {A B : Type} → RM n A → (A → RM n B) → RM n B
rbind m k = λ r → k (snd (m r)) (fst (m r))
rthen : {n : Nat} {A B : Type} → RM n A → RM n B → RM n B
rthen m m2 = λ r → m2 (fst (m r))
rmap : {n : Nat} {A B : Type} → (A → B) → RM n A → RM n B
rmap f m = λ r → (fst (m r) , f (snd (m r)))
-- the accesses
rd : {n : Nat} → Ptr n → RM n Int64
rd p = λ r → (r , load64 n r (fst p) (snd p))
wr : {n : Nat} → Ptr n → Int64 → RM n Unit
wr p v = λ r → (store64 n r (fst p) (snd p) v , unit)
-- read, change, write back
rmodify : {n : Nat} → Ptr n → (Int64 → Int64) → RM n Unit
rmodify p f = rbind (rd p) (λ v → wr p (f v))
-- running: on a fresh region (zeroed), on a region given, or entered at an address (memory the
-- program does not own: copied in, the result's region is the copy; trusted through region-at)
run-on : {n : Nat} {A : Type} → Region n → RM n A → Region n × A
run-on r m = m r
run-fresh : {A : Type} → (n : Nat) → RM n A → Region n × A
run-fresh n m = m (bytes n)
eval-fresh : {A : Type} → (n : Nat) → RM n A → A
eval-fresh n m = snd (m (bytes n))
enter-at : {A : Type} → Word → (n : Nat) → RM n A → Region n × A
enter-at a n m = m (region-at a n)
-- the region's address, for a foreign call that reads or fills it (ptr-of, trusted)
raddr : {n : Nat} → RM n Word
raddr = λ r → (r , ptr-of n r)

-- ---------------------------------------------------------------- the laws: the monad's by computation, and
-- the region's from the byte layer's (load64-store64, load64-store64-disj)
rbind-ret-l : {n : Nat} {A B : Type} → (a : A) → (k : A → RM n B) → rbind (rret a) k ≡ k a
rbind-ret-l a k = λ i → k a
rbind-ret-r : {n : Nat} {A : Type} → (m : RM n A) → rbind m (λ a → rret a) ≡ m
rbind-ret-r m = λ i → m
rbind-assoc : {n : Nat} {A B C : Type} → (m : RM n A) → (k : A → RM n B) → (k2 : B → RM n C) →
  rbind (rbind m k) k2 ≡ rbind m (λ a → rbind (k a) k2)
rbind-assoc m k k2 = λ i → rbind (rbind m k) k2
-- a read after a write at the same pointer gives the value written
rd-wr : {n : Nat} → (p : Ptr n) → (v : Int64) → (r : Region n) → snd (rthen (wr p v) (rd p) r) ≡ v
rd-wr p v r = load64-store64 n r (fst p) (snd p) v
-- a read after a write at a disjoint pointer gives the old value
rd-wr-disj : {n : Nat} → (p q : Ptr n) → (v : Int64) → (r : Region n) →
  Sum (le (plus (fst p) 8) (fst q)) (le (plus (fst q) 8) (fst p)) →
  PathP (λ (i : I) → Int64) (snd (rthen (wr p v) (rd q) r)) (snd (rd q r))
rd-wr-disj p q v r d = load64-store64-disj n r (fst p) (fst q) (snd p) (snd q) v d
