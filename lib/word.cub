-- lib/word.cub — laws of the machine's word operations, proved. Loaded after lib/prim.cub.
--
-- A Word is a natural number. Addition, subtraction and the comparisons compute on a word that is
-- not a numeral (%wadd x (%wsucc y) is %wsucc (%wadd x y), successors cancel), so their laws are
-- proved by the word eliminator. The bitwise operations and shifts are known through the laws at
-- the end of lib/prim.cub, on a word written by its bits; this is what a statement about x86 code
-- needs, the model computing on bits.

-- ---------------------------------------------------------------- addition, proved
wa-zero-l : (x : Word) → %wadd #0 x ≡ x
wa-zero-l x = %welimP (λ v → %wadd #0 v ≡ v) x (λ i → #0) (λ n h i → %wsucc (h i))

wa-suc-l : (x : Word) → (y : Word) → %wadd (%wsucc x) y ≡ %wsucc (%wadd x y)
wa-suc-l x y = %welimP (λ v → %wadd (%wsucc x) v ≡ %wsucc (%wadd x v)) y (λ i → %wsucc x) (λ n h i → %wsucc (h i))

wa-comm : (x : Word) → (y : Word) → %wadd x y ≡ %wadd y x
wa-comm x y = %welimP (λ v → %wadd x v ≡ %wadd v x) y (sym (wa-zero-l x)) (λ n h → cong (λ z → %wsucc z) h ∙ sym (wa-suc-l n x))

wa-assoc : (x : Word) → (y : Word) → (z : Word) → %wadd (%wadd x y) z ≡ %wadd x (%wadd y z)
wa-assoc x y z = %welimP (λ v → %wadd (%wadd x y) v ≡ %wadd x (%wadd y v)) z (λ i → %wadd x y) (λ n h → cong (λ z → %wsucc z) h)

wa-4 : (a : Word) → (b : Word) → %wadd (%wadd a a) (%wadd b b) ≡ %wadd (%wadd a b) (%wadd a b)
wa-4 a b = wa-assoc a a (%wadd b b)
         ∙ cong (λ z → %wadd a z) (sym (wa-assoc a b b) ∙ wa-comm (%wadd a b) b)
         ∙ sym (wa-assoc a b (%wadd a b))

wa-dbl : (a : Word) → (b : Word) → a ≡ b → %wadd a a ≡ %wadd b b
wa-dbl a b e = λ i → %wadd (e i) (e i)

wa-dbl-suc : (a : Word) → %wadd (%wsucc a) (%wsucc a) ≡ %wsucc (%wsucc (%wadd a a))
wa-dbl-suc a = cong (λ z → %wsucc z) (wa-suc-l a a)

-- ---------------------------------------------------------------- addition on bits
bb-maj : Bool → Bool → Bool → Bool
bb-maj x c h = bb-or (bb-and x c) (bb-and (bb-xor x c) h)

zl-hd : List Bool → Bool
zl-hd nil = false
zl-hd (cons x r) = x

zl-tl : List Bool → List Bool
zl-tl nil = nil
zl-tl (cons x r) = r

-- a carry added to a list; two lists and a carry added (ripple carry)
zl-inc : List Bool → Bool → List Bool
zl-inc nil c = cons c nil
zl-inc (cons y ys) c = cons (bb-xor y c) (zl-inc ys (bb-and y c))

zl-add : List Bool → Bool → List Bool → List Bool
zl-add nil c ys = zl-inc ys c
zl-add (cons x xs) c ys = cons (bb-xor (bb-xor x c) (zl-hd ys)) (zl-add xs (bb-maj x c (zl-hd ys)) (zl-tl ys))

-- doubling
w-dbl : (x : Word) → %wmul x #2 ≡ %wadd x x
w-dbl x = w-mul-suc x #1 ∙ cong (λ z → %wadd z x) (w-mul-suc x #0 ∙ cong (λ z → %wadd z x) (w-mul-zero x) ∙ wa-zero-l x)

nbw-split : (ys : List Bool) → nbw ys ≡ %wadd (%wmul (nbw (zl-tl ys)) #2) (b2w (zl-hd ys))
nbw-split nil = refl
nbw-split (cons y r) = refl

zl-inc-step : (y : Bool) → (c : Bool) → (a : Word) → (n : Word) → %wadd a (b2w (bb-and y c)) ≡ n →
              %wadd (%wadd (%wadd a a) (b2w y)) (b2w c) ≡ %wadd (%wadd n n) (b2w (bb-xor y c))
zl-inc-step false false a n e = wa-dbl a n e
zl-inc-step true false a n e = cong (λ z → %wsucc z) (wa-dbl a n e)
zl-inc-step false true a n e = cong (λ z → %wsucc z) (wa-dbl a n e)
zl-inc-step true true a n e = sym (wa-dbl-suc a) ∙ wa-dbl (%wsucc a) n e

zl-inc-ok : (ys : List Bool) → (c : Bool) → %wadd (nbw ys) (b2w c) ≡ nbw (zl-inc ys c)
zl-inc-ok nil c = refl
zl-inc-ok (cons y ys) c =
  cong (λ z → %wadd (%wadd z (b2w y)) (b2w c)) (w-dbl (nbw ys))
  ∙ zl-inc-step y c (nbw ys) (nbw (zl-inc ys (bb-and y c))) (zl-inc-ok ys (bb-and y c))
  ∙ cong (λ z → %wadd z (b2w (bb-xor y c))) (sym (w-dbl (nbw (zl-inc ys (bb-and y c)))))

-- one position of the ripple: the two lists' rest a and b, the rest of the sum n
zl-add-step : (x : Bool) → (c : Bool) → (h : Bool) → (a : Word) → (b : Word) → (n : Word) →
              %wadd (%wadd a b) (b2w (bb-maj x c h)) ≡ n →
              %wadd (%wadd (%wadd (%wadd a a) (b2w x)) (%wadd (%wadd b b) (b2w h))) (b2w c) ≡ %wadd (%wadd n n) (b2w (bb-xor (bb-xor x c) h))
zl-add-step false false false a b n e = wa-4 a b ∙ wa-dbl (%wadd a b) n e
zl-add-step true false false a b n e = wa-suc-l (%wadd a a) (%wadd b b) ∙ cong (λ z → %wsucc z) (wa-4 a b ∙ wa-dbl (%wadd a b) n e)
zl-add-step false false true a b n e = cong (λ z → %wsucc z) (wa-4 a b ∙ wa-dbl (%wadd a b) n e)
zl-add-step false true false a b n e = cong (λ z → %wsucc z) (wa-4 a b ∙ wa-dbl (%wadd a b) n e)
zl-add-step true false true a b n e =
  cong (λ z → %wsucc z) (wa-suc-l (%wadd a a) (%wadd b b)) ∙ cong (λ z → %wsucc (%wsucc z)) (wa-4 a b)
  ∙ sym (wa-dbl-suc (%wadd a b)) ∙ wa-dbl (%wsucc (%wadd a b)) n e
zl-add-step true true false a b n e =
  cong (λ z → %wsucc z) (wa-suc-l (%wadd a a) (%wadd b b)) ∙ cong (λ z → %wsucc (%wsucc z)) (wa-4 a b)
  ∙ sym (wa-dbl-suc (%wadd a b)) ∙ wa-dbl (%wsucc (%wadd a b)) n e
zl-add-step false true true a b n e =
  cong (λ z → %wsucc (%wsucc z)) (wa-4 a b) ∙ sym (wa-dbl-suc (%wadd a b)) ∙ wa-dbl (%wsucc (%wadd a b)) n e
zl-add-step true true true a b n e =
  cong (λ z → %wsucc (%wsucc z)) (wa-suc-l (%wadd a a) (%wadd b b)) ∙ cong (λ z → %wsucc (%wsucc (%wsucc z))) (wa-4 a b)
  ∙ cong (λ z → %wsucc z) (sym (wa-dbl-suc (%wadd a b)) ∙ wa-dbl (%wsucc (%wadd a b)) n e)

zl-add-ok : (xs : List Bool) → (c : Bool) → (ys : List Bool) → %wadd (%wadd (nbw xs) (nbw ys)) (b2w c) ≡ nbw (zl-add xs c ys)
zl-add-ok nil c ys = cong (λ z → %wadd z (b2w c)) (wa-zero-l (nbw ys)) ∙ zl-inc-ok ys c
zl-add-ok (cons x xs) c ys =
  cong (λ z → %wadd (%wadd (nbw (cons x xs)) z) (b2w c)) (nbw-split ys)
  ∙ (λ i → %wadd (%wadd (%wadd (w-dbl (nbw xs) i) (b2w x)) (%wadd (w-dbl (nbw (zl-tl ys)) i) (b2w (zl-hd ys)))) (b2w c))
  ∙ zl-add-step x c (zl-hd ys) (nbw xs) (nbw (zl-tl ys)) (nbw (zl-add xs (bb-maj x c (zl-hd ys)) (zl-tl ys)))
                (zl-add-ok xs (bb-maj x c (zl-hd ys)) (zl-tl ys))
  ∙ cong (λ z → %wadd z (b2w (bb-xor (bb-xor x c) (zl-hd ys)))) (sym (w-dbl (nbw (zl-add xs (bb-maj x c (zl-hd ys)) (zl-tl ys)))))

-- the sum of two words by their bits
w-add-bits : (xs : List Bool) → (ys : List Bool) → %wadd (nbw xs) (nbw ys) ≡ nbw (zl-add xs false ys)
w-add-bits xs ys = zl-add-ok xs false ys

-- ---------------------------------------------------------------- bits that may be known
-- A bit computed from numerals and variables: 0, 1, or a variable's (or a function of variables).
-- The operations decide by whichever side is known, so a mask or a numeral's bit removes a variable
-- or keeps it as it is: a function of a variable appears only where two variables meet.
data Bit = z0 | z1 | zv (b : Bool)

bt : Bit → Bool
bt z0 = false
bt z1 = true
bt (zv b) = b

lb : Bool → Bit
lb true = z1
lb false = z0

zb-not : Bit → Bit
zb-not z0 = z1
zb-not z1 = z0
zb-not (zv a) = zv (bb-not a)

zb-and : Bit → Bit → Bit
zb-and z0 y = z0
zb-and z1 y = y
zb-and (zv a) z0 = z0
zb-and (zv a) z1 = zv a
zb-and (zv a) (zv c) = zv (bb-and a c)

zb-or : Bit → Bit → Bit
zb-or z0 y = y
zb-or z1 y = z1
zb-or (zv a) z0 = zv a
zb-or (zv a) z1 = z1
zb-or (zv a) (zv c) = zv (bb-or a c)

zb-xor : Bit → Bit → Bit
zb-xor z0 y = y
zb-xor z1 y = zb-not y
zb-xor (zv a) z0 = zv a
zb-xor (zv a) z1 = zv (bb-not a)
zb-xor (zv a) (zv c) = zv (bb-xor a c)

-- each the operation on Bool
bt-not : (x : Bit) → bt (zb-not x) ≡ bb-not (bt x)
bt-not z0 = refl
bt-not z1 = refl
bt-not (zv a) = refl

bb-and-f : (c : Bool) → false ≡ bb-and false c
bb-and-f true = refl
bb-and-f false = refl

bb-and-t : (c : Bool) → c ≡ bb-and true c
bb-and-t true = refl
bb-and-t false = refl

bb-or-f : (c : Bool) → c ≡ bb-or false c
bb-or-f true = refl
bb-or-f false = refl

bb-or-t : (c : Bool) → true ≡ bb-or true c
bb-or-t true = refl
bb-or-t false = refl

bb-xor-f : (c : Bool) → c ≡ bb-xor false c
bb-xor-f true = refl
bb-xor-f false = refl

bb-xor-t : (c : Bool) → bb-not c ≡ bb-xor true c
bb-xor-t true = refl
bb-xor-t false = refl

bt-and : (x : Bit) → (y : Bit) → bt (zb-and x y) ≡ bb-and (bt x) (bt y)
bt-and z0 y = bb-and-f (bt y)
bt-and z1 y = bb-and-t (bt y)
bt-and (zv a) z0 = refl
bt-and (zv a) z1 = refl
bt-and (zv a) (zv c) = refl

bt-or : (x : Bit) → (y : Bit) → bt (zb-or x y) ≡ bb-or (bt x) (bt y)
bt-or z0 y = bb-or-f (bt y)
bt-or z1 y = bb-or-t (bt y)
bt-or (zv a) z0 = refl
bt-or (zv a) z1 = refl
bt-or (zv a) (zv c) = refl

bt-xor : (x : Bit) → (y : Bit) → bt (zb-xor x y) ≡ bb-xor (bt x) (bt y)
bt-xor z0 y = bb-xor-f (bt y)
bt-xor z1 y = bt-not y ∙ bb-xor-t (bt y)
bt-xor (zv a) z0 = refl
bt-xor (zv a) z1 = refl
bt-xor (zv a) (zv c) = refl

-- lists of them
zz-bools : List Bit → List Bool
zz-bools nil = nil
zz-bools (cons x r) = cons (bt x) (zz-bools r)

zz-vars : List Bool → List Bit
zz-vars nil = nil
zz-vars (cons x r) = cons (zv x) (zz-vars r)

zz-lits : List Bool → List Bit
zz-lits nil = nil
zz-lits (cons x r) = cons (lb x) (zz-lits r)

zz-and : List Bit → List Bit → List Bit
zz-and nil ys = nil
zz-and (cons x xs) ys = case ys return (λ z → List Bit) of
  nil → nil
  cons y r → cons (zb-and x y) (zz-and xs r)

zz-or : List Bit → List Bit → List Bit
zz-or nil ys = ys
zz-or (cons x xs) ys = case ys return (λ z → List Bit) of
  nil → cons x xs
  cons y r → cons (zb-or x y) (zz-or xs r)

zz-xor : List Bit → List Bit → List Bit
zz-xor nil ys = ys
zz-xor (cons x xs) ys = case ys return (λ z → List Bit) of
  nil → cons x xs
  cons y r → cons (zb-xor x y) (zz-xor xs r)

zz-zeros : Nat → List Bit
zz-zeros zero = nil
zz-zeros (suc n) = cons z0 (zz-zeros n)

zz-drop : Nat → List Bit → List Bit
zz-drop zero l = l
zz-drop (suc n) l = case l return (λ z → List Bit) of
  nil → nil
  cons x r → zz-drop n r

zz-app : List Bit → List Bit → List Bit
zz-app nil ys = ys
zz-app (cons x r) ys = cons x (zz-app r ys)

zz-vars-ok : (l : List Bool) → zz-bools (zz-vars l) ≡ l
zz-vars-ok nil = refl
zz-vars-ok (cons x r) = cong (cons x) (zz-vars-ok r)

zz-lits-ok : (l : List Bool) → zz-bools (zz-lits l) ≡ l
zz-lits-ok nil = refl
zz-lits-ok (cons true r) = cong (cons true) (zz-lits-ok r)
zz-lits-ok (cons false r) = cong (cons false) (zz-lits-ok r)

zz-and-c : (x : Bit) → (xs : List Bit) → (ys : List Bit) → ((r : List Bit) → zz-bools (zz-and xs r) ≡ zl-and (zz-bools xs) (zz-bools r)) →
           zz-bools (zz-and (cons x xs) ys) ≡ zl-and (zz-bools (cons x xs)) (zz-bools ys)
zz-and-c x xs nil ih = refl
zz-and-c x xs (cons y r) ih = λ i → cons (bt-and x y i) (ih r i)

zz-and-ok : (xs : List Bit) → (ys : List Bit) → zz-bools (zz-and xs ys) ≡ zl-and (zz-bools xs) (zz-bools ys)
zz-and-ok nil ys = refl
zz-and-ok (cons x xs) ys = zz-and-c x xs ys (λ r → zz-and-ok xs r)

zz-or-c : (x : Bit) → (xs : List Bit) → (ys : List Bit) → ((r : List Bit) → zz-bools (zz-or xs r) ≡ zl-or (zz-bools xs) (zz-bools r)) →
          zz-bools (zz-or (cons x xs) ys) ≡ zl-or (zz-bools (cons x xs)) (zz-bools ys)
zz-or-c x xs nil ih = refl
zz-or-c x xs (cons y r) ih = λ i → cons (bt-or x y i) (ih r i)

zz-or-ok : (xs : List Bit) → (ys : List Bit) → zz-bools (zz-or xs ys) ≡ zl-or (zz-bools xs) (zz-bools ys)
zz-or-ok nil ys = refl
zz-or-ok (cons x xs) ys = zz-or-c x xs ys (λ r → zz-or-ok xs r)

zz-xor-c : (x : Bit) → (xs : List Bit) → (ys : List Bit) → ((r : List Bit) → zz-bools (zz-xor xs r) ≡ zl-xor (zz-bools xs) (zz-bools r)) →
           zz-bools (zz-xor (cons x xs) ys) ≡ zl-xor (zz-bools (cons x xs)) (zz-bools ys)
zz-xor-c x xs nil ih = refl
zz-xor-c x xs (cons y r) ih = λ i → cons (bt-xor x y i) (ih r i)

zz-xor-ok : (xs : List Bit) → (ys : List Bit) → zz-bools (zz-xor xs ys) ≡ zl-xor (zz-bools xs) (zz-bools ys)
zz-xor-ok nil ys = refl
zz-xor-ok (cons x xs) ys = zz-xor-c x xs ys (λ r → zz-xor-ok xs r)

zz-shl-ok : (k : Nat) → (xs : List Bit) → zz-bools (zz-app (zz-zeros k) xs) ≡ list-append (zl-falses k) (zz-bools xs)
zz-shl-ok zero xs = refl
zz-shl-ok (suc k) xs = cong (cons false) (zz-shl-ok k xs)

zz-shr-c : (k : Nat) → (xs : List Bit) → ((r : List Bit) → zz-bools (zz-drop k r) ≡ zl-drop k (zz-bools r)) →
           zz-bools (zz-drop (suc k) xs) ≡ zl-drop (suc k) (zz-bools xs)
zz-shr-c k nil ih = refl
zz-shr-c k (cons x r) ih = ih r

zz-shr-ok : (k : Nat) → (xs : List Bit) → zz-bools (zz-drop k xs) ≡ zl-drop k (zz-bools xs)
zz-shr-ok zero xs = refl
zz-shr-ok (suc k) xs = zz-shr-c k xs (λ r → zz-shr-ok k r)

-- ---------------------------------------------------------------- expressions on words, by their bits
-- A word expression of the operations above, its variables bit lists. Its word (be-w) is what the
-- primitives compute; its bits (be-l) are computed on the lists, so on a list of variables each is
-- known or a variable or a function of a few; the two agree (be-sound). A numeral carries its
-- bound, so its n lowest bits are it.
-- a word below 2^n
WFits : Word → Nat → Type
WFits w n = %wlt w (wpow2 n) ≡ true

data BE = be-var (k : Nat)
        | be-lit (w : Word) (n : Nat) (h : WFits w n)
        | be-and (a : BE) (b : BE)
        | be-or (a : BE) (b : BE)
        | be-xor (a : BE) (b : BE)
        | be-shl (a : BE) (k : Nat)
        | be-shr (a : BE) (k : Nat)
        | be-add (a : BE) (b : BE)

zl-get : List (List Bool) → Nat → List Bool
zl-get nil k = nil
zl-get (cons x r) zero = x
zl-get (cons x r) (suc k) = zl-get r k

be-w : BE → List (List Bool) → Word
be-w (be-var k) r = nbw (zl-get r k)
be-w (be-lit w n h) r = w
be-w (be-and a b) r = %wand (be-w a r) (be-w b r)
be-w (be-or a b) r = %wor (be-w a r) (be-w b r)
be-w (be-xor a b) r = %wxor (be-w a r) (be-w b r)
be-w (be-shl a k) r = %wshl (be-w a r) (fromNat k)
be-w (be-shr a k) r = %wshr (be-w a r) (fromNat k)
be-w (be-add a b) r = %wadd (be-w a r) (be-w b r)

be-l : BE → List (List Bool) → List Bit
be-l (be-var k) r = zz-vars (zl-get r k)
be-l (be-lit w n h) r = zz-lits (wbits n w)
be-l (be-and a b) r = zz-and (be-l a r) (be-l b r)
be-l (be-or a b) r = zz-or (be-l a r) (be-l b r)
be-l (be-xor a b) r = zz-xor (be-l a r) (be-l b r)
be-l (be-shl a k) r = zz-app (zz-zeros k) (be-l a r)
be-l (be-shr a k) r = zz-drop k (be-l a r)
be-l (be-add a b) r = zz-vars (zl-add (zz-bools (be-l a r)) false (zz-bools (be-l b r)))

be-sound : (e : BE) → (r : List (List Bool)) → be-w e r ≡ nbw (zz-bools (be-l e r))
be-sound (be-var k) r = cong nbw (sym (zz-vars-ok (zl-get r k)))
be-sound (be-lit w n h) r = sym (w-of-bits n w h) ∙ cong nbw (sym (zz-lits-ok (wbits n w)))
be-sound (be-and a b) r =
  (λ i → %wand (be-sound a r i) (be-sound b r i)) ∙ w-and-bits (zz-bools (be-l a r)) (zz-bools (be-l b r))
  ∙ cong nbw (sym (zz-and-ok (be-l a r) (be-l b r)))
be-sound (be-or a b) r =
  (λ i → %wor (be-sound a r i) (be-sound b r i)) ∙ w-or-bits (zz-bools (be-l a r)) (zz-bools (be-l b r))
  ∙ cong nbw (sym (zz-or-ok (be-l a r) (be-l b r)))
be-sound (be-xor a b) r =
  (λ i → %wxor (be-sound a r i) (be-sound b r i)) ∙ w-xor-bits (zz-bools (be-l a r)) (zz-bools (be-l b r))
  ∙ cong nbw (sym (zz-xor-ok (be-l a r) (be-l b r)))
be-sound (be-shl a k) r =
  cong (λ z → %wshl z (fromNat k)) (be-sound a r) ∙ w-shl-bits (zz-bools (be-l a r)) k ∙ cong nbw (sym (zz-shl-ok k (be-l a r)))
be-sound (be-shr a k) r =
  cong (λ z → %wshr z (fromNat k)) (be-sound a r) ∙ w-shr-bits (zz-bools (be-l a r)) k ∙ cong nbw (sym (zz-shr-ok k (be-l a r)))
be-sound (be-add a b) r =
  (λ i → %wadd (be-sound a r i) (be-sound b r i)) ∙ w-add-bits (zz-bools (be-l a r)) (zz-bools (be-l b r))
  ∙ cong nbw (sym (zz-vars-ok (zl-add (zz-bools (be-l a r)) false (zz-bools (be-l b r)))))

-- ---------------------------------------------------------------- bounds
-- the order on Nat, as a test; the word order is it (the comparison computes on successors)
nlt : Nat → Nat → Bool
nlt zero zero = false
nlt zero (suc n) = true
nlt (suc m) zero = false
nlt (suc m) (suc n) = nlt m n

b2n : Bool → Nat
b2n true = suc zero
b2n false = zero

wb-absurd : (A : Type) → false ≡ true → A
wb-absurd A h = transport (λ i → case h i return (λ z → Type) of true → A; false → Unit) unit

wn-lt0 : (y : Word) → %wlt #0 y ≡ nlt zero (toNat y)
wn-lt0 y = %welimP (λ v → %wlt #0 v ≡ nlt zero (toNat v)) y refl (λ n h → refl)

wn-lt : (x : Word) → (y : Word) → %wlt x y ≡ nlt (toNat x) (toNat y)
wn-lt x = %welimP (λ v → (y : Word) → %wlt v y ≡ nlt (toNat v) (toNat y)) x wn-lt0
  (λ a h y → %welimP (λ v → %wlt (%wsucc a) v ≡ nlt (toNat (%wsucc a)) (toNat v)) y refl (λ b g → h b))

wn-add : (x : Word) → (y : Word) → toNat (%wadd x y) ≡ plus (toNat x) (toNat y)
wn-add x y = %welimP (λ v → toNat (%wadd x v) ≡ plus (toNat x) (toNat v)) y (sym (plus-zero (toNat x)))
  (λ n h → cong suc h ∙ sym (plus-suc (toNat x) (toNat n)))

wn-b2w : (b : Bool) → toNat (b2w b) ≡ b2n b
wn-b2w true = refl
wn-b2w false = refl

-- m < n: 2m + b < 2n
nlt-dbl : (m : Nat) → (n : Nat) → nlt m n ≡ true → (b : Bool) → nlt (plus (plus m m) (b2n b)) (plus n n) ≡ true
nlt-dbl zero zero h b = wb-absurd (nlt (plus (plus zero zero) (b2n b)) (plus zero zero) ≡ true) h
nlt-dbl zero (suc n) h false = refl
nlt-dbl zero (suc n) h true = cong (λ z → nlt zero z) (plus-suc n n)
nlt-dbl (suc m) zero h b = wb-absurd (nlt (plus (plus (suc m) (suc m)) (b2n b)) (plus zero zero) ≡ true) h
nlt-dbl (suc m) (suc n) h b =
  (λ i → nlt (plus (plus-suc m m i) (b2n b)) (plus-suc n n i)) ∙ nlt-dbl m n h b

zl-len : List Bool → Nat
zl-len nil = zero
zl-len (cons x r) = suc (zl-len r)

-- a word of k bits is below 2^k
nbw-fits : (l : List Bool) → WFits (nbw l) (zl-len l)
nbw-fits nil = refl
nbw-fits (cons b r) =
  wn-lt (%wadd (%wmul (nbw r) #2) (b2w b)) (%wmul (wpow2 (zl-len r)) #2)
  ∙ (λ i → nlt ((wn-add (%wmul (nbw r) #2) (b2w b) ∙ (λ j → plus (toNat (w-dbl (nbw r) j)) (wn-b2w b j)) ∙ cong (λ z → plus z (b2n b)) (wn-add (nbw r) (nbw r))) i)
               ((cong toNat (w-dbl (wpow2 (zl-len r))) ∙ wn-add (wpow2 (zl-len r)) (wpow2 (zl-len r))) i))
  ∙ nlt-dbl (toNat (nbw r)) (toNat (wpow2 (zl-len r))) (sym (wn-lt (nbw r) (wpow2 (zl-len r))) ∙ nbw-fits r) b

-- the bitwise operations keep words of 64 bits
w-fits-op : (e : BE) → (x : Word) → (y : Word) → WFits x 64 → WFits y 64 →
            be-w e (cons (wbits 64 x) (cons (wbits 64 y) nil)) ≡ nbw (zz-bools (be-l e (cons (wbits 64 x) (cons (wbits 64 y) nil)))) →
            WFits (nbw (zz-bools (be-l e (cons (wbits 64 x) (cons (wbits 64 y) nil))))) 64 → WFits (be-w e (cons (wbits 64 x) (cons (wbits 64 y) nil))) 64
w-fits-op e x y hx hy p f = transport (λ i → WFits (p (~ i)) 64) f

w-fits-and : (x : Word) → (y : Word) → WFits x 64 → WFits y 64 → WFits (%wand x y) 64
w-fits-and x y hx hy =
  transport (λ i → WFits (%wand (w-of-bits 64 x hx i) (w-of-bits 64 y hy i)) 64)
    (w-fits-op (be-and (be-var 0) (be-var (suc zero))) x y hx hy
       (be-sound (be-and (be-var 0) (be-var (suc zero))) (cons (wbits 64 x) (cons (wbits 64 y) nil)))
       (nbw-fits (zz-bools (be-l (be-and (be-var 0) (be-var (suc zero))) (cons (wbits 64 x) (cons (wbits 64 y) nil))))))

w-fits-or : (x : Word) → (y : Word) → WFits x 64 → WFits y 64 → WFits (%wor x y) 64
w-fits-or x y hx hy =
  transport (λ i → WFits (%wor (w-of-bits 64 x hx i) (w-of-bits 64 y hy i)) 64)
    (w-fits-op (be-or (be-var 0) (be-var (suc zero))) x y hx hy
       (be-sound (be-or (be-var 0) (be-var (suc zero))) (cons (wbits 64 x) (cons (wbits 64 y) nil)))
       (nbw-fits (zz-bools (be-l (be-or (be-var 0) (be-var (suc zero))) (cons (wbits 64 x) (cons (wbits 64 y) nil))))))

w-fits-xor : (x : Word) → (y : Word) → WFits x 64 → WFits y 64 → WFits (%wxor x y) 64
w-fits-xor x y hx hy =
  transport (λ i → WFits (%wxor (w-of-bits 64 x hx i) (w-of-bits 64 y hy i)) 64)
    (w-fits-op (be-xor (be-var 0) (be-var (suc zero))) x y hx hy
       (be-sound (be-xor (be-var 0) (be-var (suc zero))) (cons (wbits 64 x) (cons (wbits 64 y) nil)))
       (nbw-fits (zz-bools (be-l (be-xor (be-var 0) (be-var (suc zero))) (cons (wbits 64 x) (cons (wbits 64 y) nil))))))
