lapp (xb4 #233 #43 #253 #255) (xb4 #255 #72 #139 #64)) (lapp (xb4 #8 #233 #238 #252) (xb2 #255 #255))))))))
-- the start code: mmap(0, 2³⁰, read|write, private|anonymous|noreserve) the arena; the context on
-- the stack (overflow flag, arena next, arena end, stack limit 7 MB below); the blob's stub called
-- with it; exit_group(0), or 3 when the flag is set
i-start = lapp (lapp (lapp (lapp (xb4 #184 #9 #0 #0) (lapp (xb4 #0 #49 #255 #190) (xb4 #0 #0 #0 #64))) (lapp (lapp (xb4 #186 #3 #0 #0) (xb4 #0 #65 #186 #34)) (lapp (xb4 #64 #0 #0 #73) (xb4 #199 #192 #255 #255)))) (lapp (lapp (xb4 #255 #255 #69 #49) (lapp (xb4 #201 #15 #5 #72) (xb4 #131 #236 #32 #72))) (lapp (lapp (xb4 #199 #4 #36 #0) (xb4 #0 #0 #0 #72)) (lapp (xb4 #137 #68 #36 #8) (xb4 #72 #141 #136 #0))))) (lapp (lapp (lapp (xb4 #0 #0 #64 #72) (lapp (xb4 #137 #76 #36 #16) (xb4 #72 #141 #140 #36))) (lapp (lapp (xb4 #0 #0 #144 #255) (xb4 #72 #137 #76 #36)) (lapp (xb4 #24 #72 #137 #226) (xb4 #49 #255 #49 #246)))) (lapp (lapp (lapp (xb4 #232 #27 #0 #0) (xb4 #0 #128 #60 #36)) (lapp (xb4 #0 #117 #9 #49) (xb4 #255 #184 #231 #0))) (lapp (lapp (xb4 #0 #0 #15 #5) (xb4 #191 #3 #0 #0)) (lapp (xb4 #0 #184 #231 #0) (xb4 #0 #0 #15 #5)))))
x-driver-key = #1099511627774
-- push rbp; mov rbp, rsp; push apply-off; call the entry (its step in rax); the loop; the exit
x-driver main-off apply-off = xcat4 (lapp i-push-rbp i-mov-rbp-rsp) (lcons #104 (ximm32 apply-off)) (i-call-off main-off) (lapp i-driver-loop i-exit)
encode-proc m defs =
  let slen = xlen (x-stub #0 #0)
      ars = x-arities defs
      dlen = xlen (x-driver #0 #0)
      aoff = slen
      doff = %wadd slen (xlen i-apply)
      offs = lcons (x-apply-key , aoff) (x-layout ars defs (%wadd doff dlen))
      tbl = (ars , offs)
  in xcat4 (x-stub #0 doff) i-apply (x-driver (x-tbl tbl m) aoff) (x-fns tbl defs)
-- the file: the ELF header (64 bytes), one program header (56: the whole file loaded at 0x400000,
-- read and execute), the code; the entry is the first byte of the code
elf-image bs =
  let total = %wadd #120 (xlen bs)
  in xcat3
       (xcat6 (xb4 #127 #69 #76 #70) (xb4 #2 #1 #1 #0) (xle #0 #8)
              (xcat3 (xle #2 #2) (xle #62 #2) (xle #1 #4))
              (xcat3 (xle #4194424 #8) (xle #64 #8) (xle #0 #8))
              (xcat6 (xle #0 #4) (xle #64 #2) (xle #56 #2) (xle #1 #2) (xle #64 #2) (xle #0 #4)))
       (xcat6 (xle #1 #4) (xle #5 #4) (xle #0 #8) (xle #4194304 #8) (xle #4194304 #8)
              (xcat3 (xle total #8) (xle total #8) (xle #4096 #8)))
       bs
-- is T the type Step W A
is-step-w T = case %view T of wdata d ps → andb (%weq d (didx (code (Step W Unit)))) (case ps of lcons s r → uconv s W; lnil → false); _ → false
-- build-plan g: (verdict , (ok , file)) for checked definition g : Step W A; ok the checker's
-- conversion of g with the meaning of its specialized code
build-plan g =
  let T = %gty g
  in if notb (is-step-w T) then (not-fo dep-type (cglob g) , (false , lnil)) else
     (case unfold g of
        none → (not-fo reflect (cglob g) , (false , lnil))
        some c →
          (let s = specialize T sched-default lnil c
               cs = fst s
               p = program-of g cs #256
               ok = conv T (%gval g) (eval-g lnil cs)
               defs = x-erase g (x-forms-all (snd p))
           in case x-verdict (fst p) defs of
                not-fo w at → (not-fo w at , (ok , lnil))
                fo q → (fo cs , (ok , elf-image (lapp i-start (encode-proc g defs))))))
-- ---------------------------------------------------------------- #build-loop: a process that runs forever
-- #build-loop init step copy copy-id "file": init : St, step : St → Step W St, copy : St → St and
-- copy-id : (s : St) → copy s ≡ s, St a first-order type holding no byte strings. The binary runs
-- step from init; when a round ends (sdone s') the next begins from s'. Memory: the arena is two
-- halves; at each round the state is copied into the other half by copy, compiled like any
-- definition (it rebuilds the value's cells, so its result lives in the half being entered), and
-- everything the last round allocated is free again. copy-id is why this changes no answer: the
-- state the next round sees is the state. w-alloc memory is its own mapping and is never reclaimed.
loop-step-ty : Type → Type
loop-step-ty St = St → Step W St
loop-copy-ty : Type → Type
loop-copy-ty St = St → St
loop-id-ty : (St : Type) → (St → St) → Type
loop-id-ty St c = (s : St) → c s ≡ s
x-round-key = #1099511627773
-- push rbp; mov rbp, rsp; push apply-off, copy-off, step-off, init-off; the round loop; the exit
x-round-driver init-off step-off copy-off apply-off =
  xcat6 (lapp i-push-rbp i-mov-rbp-rsp) (lcons #104 (ximm32 apply-off)) (lcons #104 (ximm32 copy-off)) (lcons #104 (ximm32 step-off))
        (lcons #104 (ximm32 init-off)) (lapp i-driver-round i-exit)
encode-loop gi gs gc defs =
  let slen = xlen (x-stub #0 #0)
      ars = x-arities defs
      dlen = xlen (x-round-driver #0 #0 #0 #0)
      aoff = slen
      doff = %wadd slen (xlen i-apply)
      offs = lcons (x-apply-key , aoff) (x-layout ars defs (%wadd doff dlen))
      tbl = (ars , offs)
  in xcat4 (x-stub #0 doff) i-apply (x-round-driver (x-tbl tbl gi) (x-tbl tbl gs) (x-tbl tbl gc) aoff) (x-fns tbl defs)
-- one entry specialized and checked: (code , ok)
loop-entry g = case unfold g of
  none → (cwlit #0 , false)
  some c → (let cs = fst (specialize (%gty g) sched-default lnil c) in (cs , conv (%gty g) (%gval g) (eval-g lnil cs)))
-- build-loop-plan gi gs gc gp: (verdict , (ok , file)); ok: the three definitions have the types
-- above (gp's type is loop-id-ty St copy) and each specialized code converts with its definition
build-loop-plan gi gs gc gp =
  let St = %gty gi
      tys = andb (uconv (%gty gs) (loop-step-ty St)) (andb (uconv (%gty gc) (loop-copy-ty St)) (uconv (%gty gp) (loop-id-ty St (%gval gc))))
      ei = loop-entry gi
      es = loop-entry gs
      ec = loop-entry gc
      ok = andb tys (andb (snd ei) (andb (snd es) (snd ec)))
      p = program-of-all (lcons (gi , fst ei) (lcons (gs , fst es) (lcons (gc , fst ec) lnil))) #256
      defs = x-erase-roots (lcons gi (lcons gs (lcons gc lnil))) (x-forms-all (snd p))
  in case x-verdict (fst p) defs of
       not-fo w at → (not-fo w at , (ok , lnil))
       fo q → (if andb (x-arity-is defs gi #0) (andb (x-arity-is defs gs #1) (x-arity-is defs gc #1))
                 then (fo (fst es) , (ok , elf-image (lapp i-start (encode-loop gi gs gc defs))))
                 else (not-fo reflect (fst es) , (ok , lnil)))
