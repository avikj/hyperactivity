-- lib/world.cub — the drivers' signature W (D26): the commands the machine's driver loop
-- (src/drivers.c, #run) performs against the operating system, and a process as a tree of
-- steps the loop walks. Loaded after lib/proc.cub (Sig, Proc, Cmd, Resp) and lib/prim.cub
-- (Bytes). A process over any signature is run through a handler into W.
--
-- Commands: the time now (nanoseconds), a write of n bytes to a descriptor (the count
-- written), a read of up to n bytes (the count read and the bytes, the buffer n long), a
-- sleep, an exit. Memory commands (load, store, cas, fence on Regions) are lib/proc.cub's
-- MemS, run through sc-world or atomically; a hardware memory model is not offered yet.
data WCmd = w-now | w-write (fd : Word) (n : Nat) (b : Bytes n) | w-read (fd : Word) (n : Nat) | w-sleep (ns : Word) | w-exit (ec : Word)
  | w-open (n : Nat) (path : Bytes n) (flags : Word) (mode : Word) | w-close (fd : Word)
  -- the memory interface (D26): words at addresses (ptr-of's, or memory the program does not own),
  -- the model named: load acquire, store release, cas acquire-release (the value seen), fence
  -- sequentially consistent
  | w-load (a : Word) | w-store (a : Word) (v : Word) | w-cas (a : Word) (old : Word) (new : Word) | w-fence
  -- the raw system call (Phase 3; lib/os/linux.cub is the typed world over it): the number and six
  -- arguments as the syscall instruction takes them (rax; rdi rsi rdx r10 r8 r9), the response what
  -- it leaves in rax as a 64-bit word (an error is the two's complement of its errno). Buffers are
  -- addresses: w-alloc n is the address of n fresh zero bytes that stay valid for the process's
  -- life; w-load8/w-store8 are one byte at an address (the value's low 8 bits stored). New
  -- commands are added here, at the end: lib/elf.cub dispatches on the constructors' indices
  | w-sys (nr : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word)
  | w-alloc (n : Word) | w-load8 (a : Word) | w-store8 (a : Word) (v : Word)
w-resp : WCmd → Type
w-resp c = case c return (λ _ → Type) of
  w-now → Word
  w-write fd n b → Word
  w-read fd n → Word × Bytes n
  w-sleep ns → Unit
  w-exit ec → Unit
  w-open n p f m → Word
  w-close fd → Word
  w-load a → Word
  w-store a v → Unit
  w-cas a o nw → Word
  w-fence → Unit
  w-sys nr a1 a2 a3 a4 a5 a6 → Word
  w-alloc n → Word
  w-load8 a → Word
  w-store8 a v → Unit
W : Sig
W = (WCmd , w-resp)
-- a process as a tree of steps: done with its answer, or a command with its continuation (a
-- function field into the type, strictly positive by 18.18); the loop reads the head, performs
-- the command, applies the continuation to the response, and reads again
data Step (S : Sig) (A : Type) = sdone (a : A) | scmd (c : Cmd S) (k : Resp S c → Step S A)
to-step : {S : Sig} {A : Type} → Proc S A → Step S A
to-step {S} {A} p = p (Step S A) sdone scmd
-- the commands as processes
time-now : Proc W Word
time-now = cmd {lzero} {W} w-now
write : (fd : Word) → (n : Nat) → Bytes n → Proc W Word
write fd n b = cmd {lzero} {W} (w-write fd n b)
read : (fd : Word) → (n : Nat) → Proc W (Word × Bytes n)
read fd n = cmd {lzero} {W} (w-read fd n)
sleep : Word → Proc W Unit
sleep ns = cmd {lzero} {W} (w-sleep ns)
exit : Word → Proc W Unit
exit c = cmd {lzero} {W} (w-exit c)
-- a file opened by its path (a byte string holding the NUL-terminated name; flags and mode as open(2)
-- takes them, O_RDONLY 0, O_WRONLY 1, O_CREAT 64, O_TRUNC 512), the descriptor or the word of -1
open-file : (n : Nat) → Bytes n → Word → Word → Proc W Word
open-file n p f m = cmd {lzero} {W} (w-open n p f m)
close-file : Word → Proc W Word
close-file fd = cmd {lzero} {W} (w-close fd)
load-at : Word → Proc W Word
load-at a = cmd {lzero} {W} (w-load a)
store-at : Word → Word → Proc W Unit
store-at a v = cmd {lzero} {W} (w-store a v)
cas-at : Word → Word → Word → Proc W Word
cas-at a o n = cmd {lzero} {W} (w-cas a o n)
fence : Proc W Unit
fence = cmd {lzero} {W} w-fence

-- the raw system call and the memory a process names by address
sys-call : (nr a1 a2 a3 a4 a5 a6 : Word) → Proc W Word
sys-call nr a1 a2 a3 a4 a5 a6 = cmd {lzero} {W} (w-sys nr a1 a2 a3 a4 a5 a6)
alloc-bytes : Word → Proc W Word
alloc-bytes n = cmd {lzero} {W} (w-alloc n)
load8-at : Word → Proc W Word
load8-at a = cmd {lzero} {W} (w-load8 a)
store8-at : Word → Word → Proc W Unit
store8-at a v = cmd {lzero} {W} (w-store8 a v)
