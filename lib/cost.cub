-- Layer: not core: in the core's load order only because untyped (the bootstrap admits untyped files); leaves it when written with types (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/cost.cub — the cost model for navigation, first form (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.14 “F33 — Navigation: the concrete form”, "cost model (open
-- thread)"): the score of a step is the recorded cost of its result — the machine's own step
-- count for the key at the result's head, as the store records it beside each accepted
-- definition (`ok <steps> <checker>`) — estimated by the result's size where no record exists.
-- A cost model is a value (Code → Word); navigation parameterized by one (navigate-by) is
-- lib/nav.cub's navigation with the score abstracted; nav.cub's choice is navigate-by size-cost.
-- The recorded steps are read through %gsteps (the steps checked definition n took, from this run
-- or from the store's ok line); a table given as data stands in for them where a reading wants
-- its own figures. Loaded after lib/nav.cub.
-- ---------------------------------------------------------------- tables and models
-- a table: a Lst of (global index , recorded steps)
cost-lookup g tbl = case tbl of lnil → none; lcons e r → (if %weq (fst e) g then some (snd e) else cost-lookup g r)
-- the head global of a code (an application's function, through annotations and lets)
head-glob c =
  case c of
    cglob g → some g
    capp f a → head-glob f
    cann t T → head-glob t
    clet t b → head-glob b
    _ → none
-- the size model: lib/nav.cub's first score
size-cost c = code-size c
-- the recorded model: the recorded steps of the head's key, plus the size of the rest (the
-- arguments still cost their size to build), else the size alone
table-cost tbl c =
  case head-glob c of
    none → code-size c
    some g → (case cost-lookup g tbl of none → code-size c; some s → %wadd s (code-size c))
-- the store's model: the steps the machine recorded for the head's key (zero for a definition it
-- never checked), plus the size
store-cost c =
  case head-glob c of
    none → code-size c
    some g → %wadd (%gsteps g) (code-size c)
-- a model refined by what a reading measured: an entry replaced or added
cost-record g steps tbl =
  case tbl of
    lnil → lcons (g , steps) lnil
    lcons e r → if %weq (fst e) g then lcons (g , steps) r else lcons e (cost-record g steps r)
-- ---------------------------------------------------------------- choice and navigation by a model
best-by cost steps =
  case steps of
    lnil → none
    lcons s rest → some (best-by-from cost s rest)
best-by-from cost s rest =
  case rest of
    lnil → s
    lcons s2 r2 →
      (case s of
         stepv r t → (case s2 of stepv r2 t2 → if %wlt (cost t2) (cost t) then best-by-from cost s2 r2 else best-by-from cost s r2))
choose-by cost goal steps =
  case first-reaching goal steps of
    some s → some s
    none → best-by cost steps
navigate-by cost n goal view t =
  if %weq n #0 then navr t #0
  else if reaches goal t then navr t #0
  else (case choose-by cost goal (available view t) of
          none → navr t #0
          some s → (case s of stepv r t2 → (case navigate-by cost (%wsub n #1) goal view t2 of navr t3 k → navr t3 (%wsucc k))))
-- a recorded cost is read through annotations and applications to the head
-- the store's model has the shape of the table's, with the machine's own figures
-- ---------------------------------------------------------------- the cost model and the choice rule (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §18.14 “F33 — Navigation: the concrete form” and §15 “Open threads”)
-- The decision (2026-11-06). A cost model is a value of three measures and their weights: the
-- steps the machine recorded for the calls a term makes (through %gsteps, or a table), the term's
-- size (what building it costs), and a latency estimate from a schedule (where each global runs:
-- on the net, compiled, or across a foreign boundary). A purpose is a value: reach a term a
-- predicate accepts (a goal), minimize the model's cost, or reach a goal at least cost. The
-- choice rule is best-first: the frontier ordered by the model's cost of each reachable term, ties
-- by the term's key (its canonical serialization, compared as a list of words), so the choice
-- never depends on the order of the view; a visited set keeps the search from cycling; the
-- budget bounds the expansions. Validity never enters: every term reached is equal to the start
-- by the identities in view.
-- weights by repeated addition (weights are small words)
wtimes a n = if %weq n #0 then #0 else %wadd a (wtimes a (%wsub n #1))
-- the globals a code mentions (with repetition: a call made twice costs twice)
code-globs c acc =
  case c of
    cglob g → lcons g acc
    capp f a → code-globs f (code-globs a acc)
    clam b → code-globs b acc
    cpair a b → code-globs a (code-globs b acc)
    cfst p → code-globs p acc
    csnd p → code-globs p acc
    clet a b → code-globs a (code-globs b acc)
    cann a T → code-globs a acc
    _ → acc
sum-tbl tbl gs = case gs of lnil → #0; lcons g r → %wadd (case cost-lookup g tbl of none → #0; some s → s) (sum-tbl tbl r)
-- a schedule's latency estimate: each global placed pl-net (its recorded steps), compiled (one
-- unit per call) or foreign (a fixed boundary cost)
data Place = pl-net | pl-compiled | pl-foreign
lat-of-sched pl =
  case pl of
    lnil → lnil
    lcons e r → lcons (fst e , (case snd e of pl-net → %gsteps (fst e); pl-compiled → #1; pl-foreign → #1000)) (lat-of-sched r)
-- the model: (weights for steps, size, latency) , the steps table, the latency table
data CostModel = cmodel (ws : Word) (wz : Word) (wl : Word) (steps : Lst) (lat : Lst)
cm-cost m c =
  case m of
    cmodel ws wz wl st lt →
      %wadd (wtimes (sum-tbl st (code-globs c lnil)) ws)
            (%wadd (wtimes (code-size c) wz) (wtimes (sum-tbl lt (code-globs c lnil)) wl))
-- the store's figures as a steps table for the globals of a term
store-steps c = store-steps-of (code-globs c lnil)
store-steps-of gs = case gs of lnil → lnil; lcons g r → lcons (g , %gsteps g) (store-steps-of r)
-- ---------------------------------------------------------------- keys: a term's canonical serialization
code-ser c acc =
  case c of
    cvar n → lcons #1 (lcons n acc)
    cglob n → lcons #2 (lcons n acc)
    clam b → lcons #3 (code-ser b acc)
    capp f a → lcons #4 (code-ser f (code-ser a acc))
    cpair a b → lcons #5 (code-ser a (code-ser b acc))
    cfst p → lcons #6 (code-ser p acc)
    csnd p → lcons #7 (code-ser p acc)
    cwlit n → lcons #8 (lcons n acc)
    cann a T → lcons #9 (code-ser a (code-ser T acc))
    clet a b → lcons #10 (code-ser a (code-ser b acc))
    _ → lcons #11 acc
-- lexicographic order on word lists (a shorter prefix first)
key-lt a b =
  case a of
    lnil → (case b of lnil → false; _ → true)
    lcons x r → (case b of lnil → false; lcons y s → if %wlt x y then true else if %weq x y then key-lt r s else false)
-- ---------------------------------------------------------------- purposes
data Purpose = reach-p (goal : Code → Bool) | minimize | reach-min (goal : Code → Bool)
goal-pat g = λ t → reaches g t
p-goal p t = case p of reach-p g → g t; minimize → false; reach-min g → g t
-- ---------------------------------------------------------------- best-first search
-- a node: (cost , key) , (term , depth)
data SNode = snode (cost : Word) (key : Lst) (term : Code) (depth : Word)
node-of m t d = snode (cm-cost m t) (code-ser t lnil) t d
node-lt a b =
  case a of snode ca ka ta da → (case b of snode cb kb tb db → if %wlt ca cb then true else if %weq ca cb then key-lt ka kb else false)
insert-node n fr = case fr of lnil → lcons n lnil; lcons x r → if node-lt n x then lcons n fr else lcons x (insert-node n r)
seen t vs = case vs of lnil → false; lcons u r → if code-same t u then true else seen t r
expand m view d steps fr vs =
  case steps of
    lnil → fr
    lcons s rest → (case s of stepv r t2 → if seen t2 vs then expand m view d rest fr vs else expand m view d rest (insert-node (node-of m t2 (%wsucc d)) fr) vs)
-- the result: the term chosen, the number of steps to it, its cost, whether the goal was reached
data Navp = navp (result : Code) (steps : Word) (cost : Word) (reached : Bool)
nav-of n reached = case n of snode c k t d → navp t d c reached
better a b = node-lt a b
search m p view budget fr vs best =
  case fr of
    lnil → nav-of best false
    lcons n rest →
      (case n of
         snode c k t d →
           if p-goal p t then nav-of n true
           else (let best2 = if better n best then n else best
                 in if %weq budget #0 then nav-of best2 false
                    else search m p view (%wsub budget #1) (expand m view d (available view t) rest (lcons t vs)) (lcons t vs) best2))
-- navigate-best m p n view t: best-first under the model m toward the purpose p, at most n
-- expansions. For minimize, the least-cost term reached; for a goal, the first goal term in cost
-- order (none reached: the least-cost term, reached = false)
navigate-best m p n view t = (let s = node-of m t #0 in search m p view n (lcons s lnil) lnil s)
