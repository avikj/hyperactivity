  onS {Unit} {Unit} (fl-assert {exception} (b-and (z-le (zpos #0) regNum) (z-lt regNum (zpos #16))) #183827459973649001637779079944675911475532001514447081244864818) (λ _ →
    write_gpr regNum (regval_into_reg regval_to_write))
