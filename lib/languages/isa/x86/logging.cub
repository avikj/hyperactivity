    bindS {Bool} {Unit} (getS {Bool} x86-log_register_writes) (λ log_register_writes'2 →
      λ σ →
        if log_register_writes'2 then
          the (MS Unit)
            log_rip_write σ
        else
          the (MS Unit)
            (retS {Unit} unit) σ))
-- wr08: from register_readers_and_writers.sail (it calls what is defined after it there)
-- (part of language-support)
wr08 : (reg' : Bits #4) → (rex : Bits #8) → (byte : Bits #8) → MS Unit
wr08 reg' rex byte =
