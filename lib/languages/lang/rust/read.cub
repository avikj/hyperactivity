-- Layer: language support: lifted languages and machines (goal 3), not the core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/languages/lang/rust/read.cub — the reading of MIR, third part: statements, terminators, frames,
-- the table of a crate's instances, the run by fuel, static storage, and the entry.
--
--
--   rust-init t crate          a program's static storage made: its statics, then its vtables;
--                              the value is the image, their addresses as slots
--   rust-call t crate fuel image j args    instance j (an index into the crate's instances) applied
--   rust-entry t crate fuel image args     the crate's entry body
-- An argument and a result are slots: sl-reg of a value for a register class; for an object,
-- sl-mem of an allocation holding it, made by the caller, owned (and released) by the callee
-- when an argument and by the caller when a result.
--
-- Fuel. One %welimP on the fuel runs everything: each block entered spends one, in the body
-- running and in every body that called it (a call runs the callee with the fuel left at the
-- calling block). Spent, the meaning is mstop st-fuel.
import "read-rvalue.cub"

-- ---------------------------------------------------------------- statements
-- StorageLive and StorageDead of a local. An object: its allocation released if it has one,
-- and a new one made (live) or none (dead). A register: no value. (StorageLive of a live
-- local is a fresh local, StorageDead of a dead one nothing: as Miri has them.)
rm-storage : RCx → Word → Bool → RFrame → REv RFrame
rm-storage cx l live =
  sr-on (cx-lty cx l) (λ e fr → rm-throw e) (λ lt →
  sr-on (cx-class cx lt) (λ e fr → rm-throw e) (λ c → case c of
    cl-mem →
      sr-on (cx-size cx lt) (λ e fr → rm-throw e) (λ sz →
      sr-on (cx-align cx lt) (λ e fr → rm-throw e) (λ al →
        λ fr → rm-bind (fr-get fr l) (λ s → case s of
          sl-reg v → rm-throw (rx-ill-formed ri-operand-class)
          sl-mem p → rm-then (rm-release p) (case live of
            true → rm-bind (rm-alloc sz al) (λ q → rm-ret (fr-set fr l (sl-mem q)))
            false → rm-ret (fr-set fr l sl-none))
          sl-none → (case live of
            true → rm-bind (rm-alloc sz al) (λ q → rm-ret (fr-set fr l (sl-mem q)))
            false → rm-ret fr))))
    cl-unit → λ fr → rm-ret fr
    _ → λ fr → rm-ret (fr-set fr l (sl-reg rv-dead))))
rm-stmt : RCx → RStmt → RFrame → REv RFrame
rm-stmt cx s = case s of
  rs-assign pl rv →
    sr-on (rm-place-ty cx pl) (λ e fr → rm-throw e) (λ dty →
    sr-on (rm-place-is-reg cx pl) (λ e fr → rm-throw e) (λ isr → case isr of
      true →
        (let ev = rm-rv-val cx rv dty
         in λ fr → rm-bind (ev fr) (λ v → rm-ret (fr-set fr (rm-place-local pl) (sl-reg v))))
      false → sr-on (rm-place-al cx pl) (λ e fr → rm-throw e) (λ al →
        let addr = rm-place-addr cx pl
            wr = rm-rv-into cx rv dty al
        in λ fr → rm-bind (addr fr) (λ p → rm-then (wr fr p) (rm-ret fr)))))
  rs-storage-live l → rm-storage cx l true
  rs-storage-dead l → rm-storage cx l false
rm-stmts : List RStmt → RCx → RFrame → REv RFrame
rm-stmts nil cx = λ fr → rm-ret fr
rm-stmts (cons s ss) cx =
  let one = rm-stmt cx s
      rest = rm-stmts ss cx
  in λ fr → rm-bind (one fr) rest

-- ---------------------------------------------------------------- frames
rm-has-live-s : List RStmt → Word → Bool
rm-has-live-s nil l = false
rm-has-live-s (cons s ss) l = case s of
  rs-storage-live l2 → (case weq l l2 of
    true → true
    false → rm-has-live-s ss l)
  rs-storage-dead l2 → rm-has-live-s ss l
  rs-assign p rv → rm-has-live-s ss l
-- whether a body has a StorageLive of a local (if not, the local lives from entry to return)
rm-has-live : List RBlock → Word → Bool
rm-has-live nil l = false
rm-has-live (cons b bs) l = case b of
  rblock ss t → m-or (rm-has-live-s ss l) (rm-has-live bs l)
-- the frame at entry: rm-frame-go locals cx blocks argc index image arguments. Local 0 (the
-- result) and the locals without a StorageLive are made; the arguments are the slots given;
-- after the locals come the image's slots (the addresses of the statics and the vtables).
rm-frame-go : List RLocal → RCx → List RBlock → Word → Word → List RSlot → List RSlot → REv RFrame
rm-frame-go nil cx bs argc i = λ img args → case args of
  nil → rm-ret img
  cons a rs → rm-throw (rx-ill-formed ri-arity)
rm-frame-go (cons loc ls) cx bs argc i =
  let rest = rm-frame-go ls cx bs argc (wadd i #1)
  in case m-and (not (weq i #0)) (not (wlt argc i)) of
       true → λ img args → (case args of
         nil → rm-throw (rx-ill-formed ri-arity)
         cons a rs → rm-bind (rest img rs) (λ fr → rm-ret (cons a fr)))
       false →
         sr-on (cx-class cx (cx-ty cx (rl-ty loc))) (λ e img args → rm-throw e) (λ c → case c of
           cl-mem → (case m-and (not (weq i #0)) (rm-has-live bs i) of
             true → λ img args → rm-bind (rest img args) (λ fr → rm-ret (cons sl-none fr))
             false →
               sr-on (cx-size cx (cx-ty cx (rl-ty loc))) (λ e img args → rm-throw e) (λ sz →
               sr-on (cx-align cx (cx-ty cx (rl-ty loc))) (λ e img args → rm-throw e) (λ al →
                 λ img args → rm-bind (rm-alloc sz al) (λ p →
                              rm-bind (rest img args) (λ fr → rm-ret (cons (sl-mem p) fr))))))
           cl-unit → λ img args → rm-bind (rest img args) (λ fr → rm-ret (cons (sl-reg rv-unit) fr))
           _ → λ img args → rm-bind (rest img args) (λ fr → rm-ret (cons (sl-reg rv-dead) fr)))
rm-release-slots : RFrame → REv Unit
rm-release-slots nil = rm-ret unit
rm-release-slots (cons s ss) = case s of
  sl-mem p → rm-then (rm-release p) (rm-release-slots ss)
  sl-reg v → rm-release-slots ss
  sl-none → rm-release-slots ss
-- Return: every object of the frame but the result released; the result's slot handed back
rm-return : RFrame → REv RNext
rm-return fr = case fr of
  nil → rm-throw (rx-ill-formed (ri-no-local #0))
  cons s0 ss → rm-then (rm-release-slots ss) (rm-ret (rn-ret s0))

-- ---------------------------------------------------------------- calls
-- what a body's reading is given to call another instance
RCall : Type (lsuc lzero)
RCall = Word → List RSlot → REv RSlot
-- the arguments of a call as slots: a register operand's value; an object operand copied into
-- a new allocation that becomes the callee's local
rm-args : List ROperand → RCx → RFrame → REv (List RSlot)
rm-args nil cx = λ fr → rm-ret nil
rm-args (cons op ops) cx =
  sr-on (rm-opd-ty cx op) (λ e fr → rm-throw e) (λ ty →
  sr-on (cx-class cx ty) (λ e fr → rm-throw e) (λ c →
    let rest = rm-args ops cx
    in case c of
         cl-mem →
           sr-on (cx-size cx ty) (λ e fr → rm-throw e) (λ sz →
           sr-on (cx-align cx ty) (λ e fr → rm-throw e) (λ al →
             let st = rm-opd-into cx op ty al
             in λ fr → rm-bind (rm-alloc sz al) (λ p →
                       rm-then (st fr p)
                      (rm-bind (rest fr) (λ r → rm-ret (cons (sl-mem p) r))))))
         _ →
           (let ev = rm-opd-rv cx op
            in λ fr → rm-bind (ev fr) (λ v → rm-bind (rest fr) (λ r → rm-ret (cons (sl-reg v) r))))))
-- the result of a call put in the destination: a register value written; an object copied
-- from the callee's result allocation, which is then released
rm-ret-into : RCx → RPlace → RFrame → RSlot → REv RFrame
rm-ret-into cx pl =
  sr-on (rm-place-ty cx pl) (λ e fr r → rm-throw e) (λ dty →
  sr-on (cx-class cx dty) (λ e fr r → rm-throw e) (λ c → case c of
    cl-mem →
      sr-on (rm-place-al cx pl) (λ e fr r → rm-throw e) (λ al →
      sr-on (cx-align cx dty) (λ e fr r → rm-throw e) (λ ta →
        let addr = rm-place-addr cx pl
            cp = cx-copy cx dty al ta
        in λ fr r → case r of
             sl-reg v → rm-throw (rx-ill-formed ri-operand-class)
             sl-none → rm-throw (rx-ill-formed ri-operand-class)
             sl-mem q → rm-bind (addr fr) (λ d → rm-then (cp d q) (rm-then (rm-release q) (rm-ret fr)))))
    _ →
      (let wr = rm-place-wr cx pl
       in λ fr r → case r of
            sl-reg v → wr fr v
            sl-mem q → rm-throw (rx-ill-formed ri-operand-class)
            sl-none → rm-throw (rx-ill-formed ri-operand-class))))
rm-call : RCx → RCallee → List ROperand → RPlace → Word → RCall → RFrame → REv RNext
rm-call cx f args dest target =
  let ea = rm-args args cx
      fin = rm-ret-into cx dest
  in case f of
       rcallee-fn b a →
         sr-on (cx-inst cx b a) (λ e call fr → rm-throw e) (λ j →
           λ call fr → rm-bind (ea fr) (λ slots →
                       rm-bind (call j slots) (λ r →
                       rm-bind (fin fr r) (λ f2 → rm-ret (rn-goto f2 target)))))
       rcallee-dyn tr m →
         λ call fr → rm-bind (ea fr) (λ slots → case slots of
           nil → rm-throw (rx-ill-formed ri-arity)
           cons s0 rest → (case s0 of
             sl-mem q → rm-throw (rx-ill-formed ri-operand-class)
             sl-none → rm-throw (rx-ill-formed ri-operand-class)
             sl-reg v → (case v of
               rv-fat p vt →
                 rm-bind (rm-res (sv-as-p vt)) (λ vp →
                 rm-bind (rm-elem-ptr vp (tg-size (cx-t cx) ck-ptr) (uq-of-word (wadd #3 m))) (λ q →
                 rm-bind (rm-load (cx-t cx) sk-ptr (tg-align (cx-t cx) ck-ptr) q) (λ fp →
                 rm-bind (rm-fn-of fp) (λ j →
                 rm-bind (call j (cons (sl-reg (rv-s p)) rest)) (λ r →
                 rm-bind (fin fr r) (λ f2 → rm-ret (rn-goto f2 target)))))))
               _ → rm-throw (rx-ill-formed ri-operand-class))))
       rcallee-ptr op →
         (let ef = rm-opd-rv cx op
          in λ call fr → rm-bind (ef fr) (λ fv →
                         rm-bind (rm-as-s fv) (λ x →
                         rm-bind (rm-fn-of x) (λ j →
                         rm-bind (ea fr) (λ slots →
                         rm-bind (call j slots) (λ r →
                         rm-bind (fin fr r) (λ f2 → rm-ret (rn-goto f2 target))))))))

-- ---------------------------------------------------------------- drop
data ROptW = ro-none | ro-some (w : Word)
-- the Drop impl of a closed type, as an instance's index
rm-drop-find : List RDropImpl → List RInstance → RTy → RSt ROptW
rm-drop-find nil is ty = sr-ok ro-none
rm-drop-find (cons d ds) is ty = case d of
  rdrop-impl t b a → (case rm-ty-eq t ty of
    true → sr-map ro-some (rm-inst-index is b a #0)
    false → rm-drop-find ds is ty)
rm-any-fields : List RFieldLayout → (RTy → RSt Bool) → RSt Bool
rm-any-fields nil f = sr-ok false
rm-any-fields (cons x xs) f = sr-bind (f (rf-ty x)) (λ b → case b of
  true → sr-ok true
  false → rm-any-fields xs f)
rm-any-variants : List RVariantLayout → (RTy → RSt Bool) → RSt Bool
rm-any-variants nil f = sr-ok false
rm-any-variants (cons v vs) f = sr-bind (rm-any-fields (vl-fields-of v) f) (λ b → case b of
  true → sr-ok true
  false → rm-any-variants vs f)
-- whether dropping a value of a type does anything: it has a Drop impl, or something in it has
rm-needs-drop : Word → RCx → RTy → RSt Bool
rm-needs-drop d cx =
  %welimP (λ x → RTy → RSt Bool) d (λ ty → sr-ill ri-layout-depth)
    (λ k again ty → sr-bind (cx-class cx ty) (λ c → case c of
       cl-mem → (case ty of
         rty-array e n → again e
         _ → sr-bind (rm-drop-find (cr-drops (cx-crate cx)) (cr-instances (cx-crate cx)) ty) (λ o → case o of
           ro-some j → sr-ok true
           ro-none → sr-bind (rm-lay (cx-ls cx) ty) (λ l → rm-any-variants (ly-variants-of l) again)))
       _ → sr-ok false))
rm-drop-fields : List RFieldLayout → (RTy → RCall → MPtr → REv Unit) → RCall → MPtr → REv Unit
rm-drop-fields nil g = λ call p → rm-ret unit
rm-drop-fields (cons f fs) g =
  let one = g (rf-ty f)
      rest = rm-drop-fields fs g
  in λ call p → rm-bind (rm-off p (rf-off f)) (λ q → rm-then (one call q) (rest call p))
rm-drop-elems : Word → Word → (RCall → MPtr → REv Unit) → RCall → MPtr → REv Unit
rm-drop-elems n es one =
  %welimP (λ x → RCall → MPtr → REv Unit) n (λ call p → rm-ret unit)
    (λ j acc call p → rm-then (acc call p) (rm-bind (rm-off p (wmul j es)) (λ q → one call q)))
-- an enum: none of the samples drops one whose fields need dropping
rm-drop-enum : RCx → RTy → RLayout → RCall → MPtr → REv Unit
rm-drop-enum cx ty l = λ call p → rm-throw (rx-unsupported (rz-drop-of-enum ty))
rm-drop-body : RCx → RTy → RLayout → (RTy → RCall → MPtr → REv Unit) → RCall → MPtr → REv Unit
rm-drop-body cx ty l again = case ly-tag-of l of
  rtag-none → (case ly-variants-of l of
    nil → λ call p → rm-ret unit
    cons v vs → rm-drop-fields (vl-fields-of v) again)
  rtag-direct off size → rm-drop-enum cx ty l
  rtag-niche off size → rm-drop-enum cx ty l
-- the drop of a value of a closed type at a pointer: its own Drop impl called with the
-- pointer, then its fields dropped in declaration order (an array: its elements). A type
-- nothing in which needs dropping: nothing. An enum with a field that needs dropping is not
-- written (the samples have none): rx-unsupported.
rm-drop-glue : Word → RCx → RTy → RCall → MPtr → REv Unit
rm-drop-glue d cx =
  %welimP (λ x → RTy → RCall → MPtr → REv Unit) d (λ ty call p → rm-throw (rx-ill-formed ri-layout-depth))
    (λ k again ty → sr-on (rm-needs-drop (cx-depth cx) cx ty) (λ e call p → rm-throw e) (λ nd → case nd of
       false → λ call p → rm-ret unit
       true → (case ty of
         rty-array e n → (case n of
           rty-const c → sr-on (cx-size cx e) (λ x call p → rm-throw x) (λ es → rm-drop-elems c es (again e))
           _ → λ call p → rm-throw (rx-ill-formed (ri-open-type ty)))
         _ →
           sr-on (rm-drop-find (cr-drops (cx-crate cx)) (cr-instances (cx-crate cx)) ty) (λ x call p → rm-throw x) (λ o →
           sr-on (rm-lay (cx-ls cx) ty) (λ x call p → rm-throw x) (λ l → case o of
             ro-none → rm-drop-body cx ty l again
             ro-some j →
               (let fields = rm-drop-body cx ty l again
                in λ call p → rm-bind (call j (cons (sl-reg (rv-s (sv-p p))) nil)) (λ r → fields call p)))))))

-- ---------------------------------------------------------------- terminators
rm-arms : List RSwitchArm → SK → Word → SV → REv Word
rm-arms nil k other = λ v → rm-ret other
rm-arms (cons a rs) k other = case a of
  rarm val bb → sr-on (rm-int-sv k val) (λ e v → rm-throw e) (λ c →
    let rest = rm-arms rs k other
    in λ v → rm-bind (rm-res (sv-cmp co-eq k v c)) (λ b → case b of
         true → rm-ret bb
         false → rest v))
rm-switch : RCx → ROperand → List RSwitchArm → Word → RFrame → REv RNext
rm-switch cx op arms other =
  sr-on (rm-opd-ty cx op) (λ e fr → rm-throw e) (λ ty →
  sr-on (cx-class cx ty) (λ e fr → rm-throw e) (λ c → case c of
    cl-scalar k →
      (let ev = rm-opd-rv cx op
           ch = rm-arms arms k other
       in λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x →
                 rm-bind (ch x) (λ bb → rm-ret (rn-goto fr bb)))))
    _ → λ fr → rm-throw (rx-unsupported (rz-switch-on ty))))
-- what a failed Assert reports: the abort's kind
rm-assert-kind : RAssertMsg → RAbort
rm-assert-kind m = case m of
  rassert-bounds-check len idx → rab-bounds-check
  rassert-division-by-zero a → rab-division-by-zero
  rassert-remainder-by-zero a → rab-remainder-by-zero
  rassert-overflow o a b → rab-overflow o
rm-assert : RCx → ROperand → Bool → RAssertMsg → Word → RFrame → REv RNext
rm-assert cx cond expected msg target =
  let ev = rm-opd-rv cx cond
  in λ fr → rm-bind (ev fr) (λ v → rm-bind (rm-as-s v) (λ x → rm-bind (rm-res (sv-as-b x)) (λ b →
            case u64eq (uq-b b) (uq-b expected) of
              true → rm-ret (rn-goto fr target)
              false → rm-throw (rx-abort (rm-assert-kind msg)))))
-- an unwind action: nothing unwinds under -Cpanic=abort, so continue, unreachable and
-- terminate say nothing here; a cleanup block is not read
rm-unwind-ok : RUnwind → Bool
rm-unwind-ok u = case u of
  ru-continue → true
  ru-unreachable → true
  ru-terminate → true
  ru-cleanup bb → false
rm-term : RCx → RTerm → RCall → RFrame → REv RNext
rm-term cx tm = case tm of
  rt-goto bb → λ call fr → rm-ret (rn-goto fr bb)
  rt-switch-int op arms other →
    (let f = rm-switch cx op arms other
     in λ call fr → f fr)
  rt-return → λ call fr → rm-return fr
  rt-unreachable → λ call fr → rm-throw (rx-ub rub-unreachable)
  rt-call f args dest target uw → (case rm-unwind-ok uw of
    true → rm-call cx f args dest target
    false → λ call fr → rm-throw (rx-unsupported (rz-unwind uw)))
  rt-assert c e m target uw → (case rm-unwind-ok uw of
    true →
      (let f = rm-assert cx c e m target
       in λ call fr → f fr)
    false → λ call fr → rm-throw (rx-unsupported (rz-unwind uw)))
  rt-drop p target uw → (case rm-unwind-ok uw of
    true →
      sr-on (rm-place-ty cx p) (λ e call fr → rm-throw e) (λ pty →
        let addr = rm-place-addr cx p
            g = rm-drop-glue (cx-depth cx) cx pty
        in λ call fr → rm-bind (addr fr) (λ q → rm-then (g call q) (rm-ret (rn-goto fr target))))
    false → λ call fr → rm-throw (rx-unsupported (rz-unwind uw)))
rm-block : RCx → RBlock → RCall → RFrame → REv RNext
rm-block cx b = case b of
  rblock ss tm →
    (let run = rm-stmts ss cx
         fin = rm-term cx tm
     in λ call fr → rm-bind (run fr) (λ f2 → fin call f2))

-- ---------------------------------------------------------------- the crate as a table
-- element i of a table: the head at 0
rm-tcons : {R : Type (lsuc lzero)} → R → (Word → R) → Word → R
rm-tcons f rest i = case weq i #0 of
  true → f
  false → rest (wsub i #1)
RBlockFn : Type (lsuc lzero)
RBlockFn = RCall → RFrame → REv RNext
rm-blocks : List RBlock → RCx → Word → RBlockFn
rm-blocks nil cx = λ i call fr → rm-throw (rx-ill-formed (ri-no-block i))
rm-blocks (cons b bs) cx = rm-tcons {RBlockFn} (rm-block cx b) (rm-blocks bs cx)
-- the context and the body of an instance
rm-inst-cx : Target → RCrate → RInstance → RSt (RCx × RBody)
rm-inst-cx t c i = case i of
  rinstance b a → sr-map (λ bd →
    ( RCx { cx-t = t ; cx-crate = c ; cx-args = a ; cx-locals = rb-locals bd
          ; cx-depth = wadd (rm-len (cr-layouts c)) #2 }
    , bd )) (rm-nth (cr-bodies c) b (ri-no-body b))
-- block bb of instance i
rm-prog-go : List RInstance → Target → RCrate → Word → Word → RBlockFn
rm-prog-go nil t c = λ i bb call fr → rm-throw (rx-ill-formed (ri-no-body i))
rm-prog-go (cons x xs) t c =
  rm-tcons {Word → RBlockFn}
    (sr-on (rm-inst-cx t c x) (λ e bb call fr → rm-throw e) (λ cb → rm-blocks (rb-blocks (snd cb)) (fst cb)))
    (rm-prog-go xs t c)
-- the frame of instance i at entry, from the argument slots
rm-frames-go : List RInstance → Target → RCrate → Word → List RSlot → List RSlot → REv RFrame
rm-frames-go nil t c = λ i img args → rm-throw (rx-ill-formed (ri-no-body i))
rm-frames-go (cons x xs) t c =
  rm-tcons {List RSlot → List RSlot → REv RFrame}
    (sr-on (rm-inst-cx t c x) (λ e img args → rm-throw e) (λ cb →
       rm-frame-go (rb-locals (snd cb)) (fst cb) (rb-blocks (snd cb)) (rb-argc (snd cb)) #0))
    (rm-frames-go xs t c)

-- ---------------------------------------------------------------- the run
-- rm-run fuel blocks frames image i frame bb: instance i from block bb in a frame, to its return
rm-run : Word → (Word → Word → RBlockFn) → (Word → List RSlot → List RSlot → REv RFrame) → List RSlot → Word → RFrame → Word → REv RSlot
rm-run fuel prog mkf img =
  %welimP (λ x → Word → RFrame → Word → REv RSlot) fuel (λ i fr bb → rm-stop st-fuel)
    (λ k again i fr bb →
       rm-bind (prog i bb (λ j args → rm-bind (mkf j img args) (λ f2 → again j f2 #0)) fr) (λ nx → case nx of
         rn-goto f2 b2 → again i f2 b2
         rn-ret v → rm-ret v))
-- rust-call t crate fuel image j args
rust-call : Target → RCrate → Word → List RSlot → Word → List RSlot → REv RSlot
rust-call t c fuel img j args =
  let prog = rm-prog-go (cr-instances c) t c
      mkf = rm-frames-go (cr-instances c) t c
  in rm-bind (mkf j img args) (λ fr → rm-run fuel prog mkf img j fr #0)
rust-entry : Target → RCrate → Word → List RSlot → List RSlot → REv RSlot
rust-entry t c fuel img args =
  rm-st (rm-inst-index (cr-instances c) (cr-entry c) rtys-nil #0) (λ j → rust-call t c fuel img j args)

-- ---------------------------------------------------------------- static storage
-- rust-init: the statics and then the vtables allocated and written; its value is the image,
-- their addresses in that order, which every frame carries.
rm-init-bytes : List Word → Target → MPtr → Word → REv Unit
rm-init-bytes nil t p off = rm-ret unit
rm-init-bytes (cons b bs) t p off =
  rm-then (rm-bind (rm-off p off) (λ q → rm-store t (sk-int false iw8) #1 q (sv-i (uq-of-word b))))
          (rm-init-bytes bs t p (wadd off #1))
rm-wlen : List Word → Word
rm-wlen nil = #0
rm-wlen (cons x xs) = wadd #1 (rm-wlen xs)
-- the runs of a static's initial bytes: written ones stored, the others left unwritten
rm-init-runs : List RBytes → Target → MPtr → Word → REv Unit
rm-init-runs nil t p off = rm-ret unit
rm-init-runs (cons r rs) t p off = case r of
  rbytes-init bs → rm-then (rm-init-bytes bs t p off) (rm-init-runs rs t p (wadd off (rm-wlen bs)))
  rbytes-uninit n → rm-init-runs rs t p (wadd off n)
rm-init-statics : List RStatic → Target → REv (List RSlot)
rm-init-statics nil t = rm-ret nil
rm-init-statics (cons s ss) t = case s of
  rstatic nm ty mu size al init →
    rm-bind (rm-alloc-static size al) (λ p →
    rm-then (rm-init-runs init t p #0)
   (rm-bind (rm-init-statics ss t) (λ r → rm-ret (cons (sl-reg (rv-s (sv-p p))) r))))
-- a vtable's method slots: pointers to the instances
rm-init-methods : List RCallee → Target → List RInstance → MPtr → Word → REv Unit
rm-init-methods nil t is p off = rm-ret unit
rm-init-methods (cons f fs) t is p off = case f of
  rcallee-fn b args → rm-st (rm-inst-index is b args #0) (λ j →
    rm-then (rm-bind (rm-off p off) (λ q → rm-store t sk-ptr (tg-align t ck-ptr) q (rm-fn-ptr j)))
            (rm-init-methods fs t is p (wadd off (tg-size t ck-ptr))))
  rcallee-dyn tr mi → rm-throw (rx-ill-formed ri-operand-class)
  rcallee-ptr op → rm-throw (rx-ill-formed ri-operand-class)
rm-clen : List RCallee → Word
rm-clen nil = #0
rm-clen (cons x xs) = wadd #1 (rm-clen xs)
-- a vtable in memory: the drop slot (null: no drop glue), the size, the alignment, the methods
rm-init-vtables : List RVtable → Target → List RInstance → REv (List RSlot)
rm-init-vtables nil t is = rm-ret nil
rm-init-vtables (cons v vs) t is = case v of
  rvtable ty tr size al dr ms → (case dr of
    rdrop-fn b args → rm-throw (rx-unsupported (rz-type ty))
    rdrop-none →
      rm-bind (rm-alloc-static (wmul (wadd #3 (rm-clen ms)) (tg-size t ck-ptr)) (tg-align t ck-ptr)) (λ p →
      rm-then (rm-store t sk-ptr (tg-align t ck-ptr) p rm-null)
     (rm-then (rm-bind (rm-off p (tg-size t ck-ptr)) (λ q → rm-store t (rm-usize t) (tg-align t ck-ptr) q (sv-i (uq-of-word size))))
     (rm-then (rm-bind (rm-off p (wmul #2 (tg-size t ck-ptr))) (λ q → rm-store t (rm-usize t) (tg-align t ck-ptr) q (sv-i (uq-of-word al))))
     (rm-then (rm-init-methods ms t is p (wmul #3 (tg-size t ck-ptr)))
     (rm-bind (rm-init-vtables vs t is) (λ r → rm-ret (cons (sl-reg (rv-s (sv-p p))) r))))))))
rm-app : List RSlot → List RSlot → List RSlot
rm-app nil ys = ys
rm-app (cons x xs) ys = cons x (rm-app xs ys)
rust-init : Target → RCrate → REv (List RSlot)
rust-init t c =
  rm-bind (rm-init-statics (cr-statics c) t) (λ ss →
  rm-bind (rm-init-vtables (cr-vtables c) t (cr-instances c)) (λ vs → rm-ret (rm-app ss vs)))
