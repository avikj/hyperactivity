-- Layer: language support: lifted languages and machines (goal 3), not the core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/languages/mem/rc11.cub — the language-level memory model: RC11 consistency (Lahav, Vafeiadis, Kang,
-- Hur, Dreyer, "Repairing sequential consistency in C/C++11", PLDI 2017) for the five orderings
-- of lib/languages/mem/atomics.cub, over the events and witness of lib/languages/isa/tso.cub. Loaded after
-- lib/languages/mem/atomics.cub.
--
-- A language-level candidate execution is a `TsoX` (events, rf, the order on writes: RC11's
-- mo is its restriction to each location) with the ordering of each event (`modes`, by event
-- id). An update (exchange, successful compare-exchange) is ONE event that reads and writes
-- (kind k-L), so RC11's rmw relation is the identity on such events: `rf ; rmw` is rf into an
-- update, and atomicity is irreflexivity of rb ; mo.
-- ---------------------------------------------------------------- relations as lists of pairs
RcRel : Type
RcRel = List (Word × Word)
rc-has : Word → Word → RcRel → Bool
rc-has a b nil = false
rc-has a b (cons p r) = if andB (weq a (fst p)) (weq b (snd p)) then true else rc-has a b r
rc-add : Word → Word → RcRel → RcRel
rc-add a b r = if rc-has a b r then r else cons (a , b) r
rc-union : RcRel → RcRel → RcRel
rc-union nil s = s
rc-union (cons p r) s = rc-add (fst p) (snd p) (rc-union r s)
-- the pairs (a , c) for (b , c) in s with b the given word, added to acc
rc-from : RcRel → Word → Word → RcRel → RcRel
rc-from nil a b acc = acc
rc-from (cons p r) a b acc = if weq b (fst p) then rc-add a (snd p) (rc-from r a b acc) else rc-from r a b acc
-- r ; s
rc-comp : RcRel → RcRel → RcRel
rc-comp nil s = nil
rc-comp (cons p r) s = rc-from s (fst p) (snd p) (rc-comp r s)
-- r+ over at most n + 1 steps (n the number of events)
rc-plus-from : Nat → RcRel → RcRel → RcRel
rc-plus-from zero r acc = acc
rc-plus-from (suc n) r acc = rc-plus-from n r (rc-union (rc-comp acc r) acc)
rc-plus : Nat → RcRel → RcRel
rc-plus n r = rc-plus-from n r r
rc-irreflexive : RcRel → Bool
rc-irreflexive nil = true
rc-irreflexive (cons p r) = if weq (fst p) (snd p) then false else rc-irreflexive r
rc-in : Word → List Word → Bool
rc-in x nil = false
rc-in x (cons y r) = if weq x y then true else rc-in x r
-- [S] ; r and r ; [S]
rc-dom : List Word → RcRel → RcRel
rc-dom ids nil = nil
rc-dom ids (cons p r) = if rc-in (fst p) ids then cons p (rc-dom ids r) else rc-dom ids r
rc-cod : List Word → RcRel → RcRel
rc-cod ids nil = nil
rc-cod ids (cons p r) = if rc-in (snd p) ids then cons p (rc-cod ids r) else rc-cod ids r
-- [S]
rc-id : List Word → RcRel
rc-id nil = nil
rc-id (cons x r) = cons (x , x) (rc-id r)
rc-nid : TsoN → Word
rc-nid (tso-n id t k a vr vw s c sc) = id
rc-nkind : TsoN → TsoK
rc-nkind (tso-n id t k a vr vw s c sc) = k
-- the pairs of events a predicate holds of
rc-row : (TsoN → TsoN → Bool) → TsoN → List TsoN → RcRel → RcRel
rc-row p x nil acc = acc
rc-row p x (cons y r) acc = if p x y then cons (rc-nid x , rc-nid y) (rc-row p x r acc) else rc-row p x r acc
rc-rel-from : (TsoN → TsoN → Bool) → List TsoN → List TsoN → RcRel
rc-rel-from p nil all = nil
rc-rel-from p (cons x r) all = rc-row p x all (rc-rel-from p r all)
rc-rel : (TsoN → TsoN → Bool) → List TsoN → RcRel
rc-rel p ns = rc-rel-from p ns ns
-- ---------------------------------------------------------------- orderings of events
mo-ge-rel : MOrd → Bool
mo-ge-rel o = case o of mo-relaxed → false; mo-acquire → false; mo-release → true; mo-acq-rel → true; mo-seq-cst → true
mo-ge-acq : MOrd → Bool
mo-ge-acq o = case o of mo-relaxed → false; mo-acquire → true; mo-release → false; mo-acq-rel → true; mo-seq-cst → true
rc-mode : List (Word × MOrd) → Word → MOrd
rc-mode nil x = mo-relaxed
rc-mode (cons p r) x = if weq x (fst p) then snd p else rc-mode r x
-- the ids of the events a predicate on (kind , ordering) holds of
rc-ids : (TsoK → MOrd → Bool) → List (Word × MOrd) → List TsoN → List Word
rc-ids p ms nil = nil
rc-ids p ms (cons x r) = if p (rc-nkind x) (rc-mode ms (rc-nid x)) then cons (rc-nid x) (rc-ids p ms r) else rc-ids p ms r
-- ---------------------------------------------------------------- RC11
data RcX = rc-x (x : TsoX) (modes : List (Word × MOrd))
-- sb on one location, and sb between events not on one location (a fence has none)
rc-sb-loc : TsoN → TsoN → Bool
rc-sb-loc x y = andB (tso-po x y) (tso-same-loc x y)
rc-sb-nloc : TsoN → TsoN → Bool
rc-sb-nloc x y = andB (tso-po x y) (tso-not (tso-same-loc x y))
rc-same-loc-ids : List TsoN → Word → Word → Bool
rc-same-loc-ids ns a b = tso-any (λ x → andB (weq (rc-nid x) a) (tso-any (λ y → andB (weq (rc-nid y) b) (tso-same-loc x y)) ns)) ns
rc-loc : List TsoN → RcRel → RcRel
rc-loc ns nil = nil
rc-loc ns (cons p r) = if rc-same-loc-ids ns (fst p) (snd p) then cons p (rc-loc ns r) else rc-loc ns r
-- the four axioms over the annotated events ns and the orderings ms
rc11-axioms : List (Word × MOrd) → List TsoN → Bool
rc11-axioms ms ns =
  (let n = tso-len ns
       sb = rc-rel tso-po ns
       rf = rc-rel tso-rf ns
       mo = rc-rel tso-co ns
       rb = rc-rel tso-fr ns
       ws = rc-ids (λ k o → tso-k-writes k) ms ns
       us = rc-ids (λ k o → andB (tso-k-reads k) (tso-k-writes k)) ms ns
       fs = rc-ids (λ k o → tso-k-isF k) ms ns
       e-rel = rc-ids (λ k o → mo-ge-rel o) ms ns
       e-acq = rc-ids (λ k o → mo-ge-acq o) ms ns
       e-sc = rc-ids (λ k o → mo-is-seq-cst o) ms ns
       f-sc = rc-ids (λ k o → andB (tso-k-isF k) (mo-is-seq-cst o)) ms ns
       eco = rc-plus n (rc-union rf (rc-union mo rb))
       -- rs = [W] ; sb|loc? ; [W] ; (rf ; rmw)*
       rs0 = rc-union (rc-id ws) (rc-cod ws (rc-dom ws (rc-rel rc-sb-loc ns)))
       rfu = rc-cod us rf
       rs = rc-union rs0 (rc-comp rs0 (rc-plus n rfu))
       -- sw = [E ⊒ rel] ; ([F] ; sb)? ; rs ; rf ; [R] ; (sb ; [F])? ; [E ⊒ acq]
       sw0 = rc-comp rs rf
       sw1 = rc-union sw0 (rc-comp (rc-dom fs sb) sw0)
       sw2 = rc-union sw1 (rc-comp sw1 (rc-cod fs sb))
       sw = rc-cod e-acq (rc-dom e-rel sw2)
       hb = rc-plus n (rc-union sb sw)
       -- scb = sb ∪ sb|≠loc ; hb ; sb|≠loc ∪ hb|loc ∪ mo ∪ rb
       sbn = rc-rel rc-sb-nloc ns
       scb = rc-union sb (rc-union (rc-comp sbn (rc-comp hb sbn)) (rc-union (rc-loc ns hb) (rc-union mo rb)))
       -- psc_base = ([E_sc] ∪ [F_sc] ; hb?) ; scb ; ([E_sc] ∪ hb? ; [F_sc])
       pl = rc-union (rc-id e-sc) (rc-dom f-sc hb)
       pr = rc-union (rc-id e-sc) (rc-cod f-sc hb)
       psc-base = rc-comp pl (rc-comp scb pr)
       -- psc_F = [F_sc] ; (hb ∪ hb ; eco ; hb) ; [F_sc]
       psc-f = rc-cod f-sc (rc-dom f-sc (rc-union hb (rc-comp hb (rc-comp eco hb))))
   in andB (andB (rc-irreflexive hb) (rc-irreflexive (rc-comp hb eco)))                -- coherence
        (andB (rc-irreflexive (rc-comp rb mo))                                        -- atomicity
          (andB (rc-irreflexive (rc-plus n (rc-union psc-base psc-f)))                -- SC
                (rc-irreflexive (rc-plus n (rc-union sb rf))))))                      -- no thin air
rc11-consistent : Memory → RcX → Bool
rc11-consistent m0 c =
  case c of
    rc-x x ms → (case x of tso-x es rf co → andB (tso-wf m0 x) (rc11-axioms ms (tso-map (tso-annot rf co) es)))
Rc11Consistent : Memory → RcX → Type
Rc11Consistent m0 c = isTrue (rc11-consistent m0 c)
-- ---------------------------------------------------------------- RC11's outcomes of a program
-- as for the axiomatic form of TSO (tso-ax-outcomes): each thread alone with read values from
-- a domain gives its events with their orderings; every rf and every order of each location's
-- writes; the RC11-consistent candidates give the outcomes
RcRun : Type → Type
RcRun R = Word → List TsoEv → List (Word × MOrd) → R → R
rc-instr : {R : Type} → List Word → Word → (c : Atom) → (atom-resp c → RcRun R) → RcRun R
rc-instr dom t c =
  case c return (λ x → (atom-resp x → RcRun R) → RcRun R) of
    at-load o a → λ k nx es ms acc → tso-over-w dom (λ v acc2 → k v (%wsucc nx) (cons (tso-ev nx t k-R a v #0) es) (cons (nx , o) ms) acc2) acc
    at-store o a v → λ k nx es ms acc → k unit (%wsucc nx) (cons (tso-ev nx t k-W a #0 v) es) (cons (nx , o) ms) acc
    at-xchg o a v → λ k nx es ms acc → tso-over-w dom (λ vr acc2 → k vr (%wsucc nx) (cons (tso-ev nx t k-L a vr v) es) (cons (nx , o) ms) acc2) acc
    at-cas so fo a old new → λ k nx es ms acc →
      tso-over-w dom (λ vr acc2 →
        if weq vr old
        then k (true , vr) (%wsucc nx) (cons (tso-ev nx t k-L a vr new) es) (cons (nx , so) ms) acc2
        else k (false , vr) (%wsucc nx) (cons (tso-ev nx t k-R a vr #0) es) (cons (nx , fo) ms) acc2) acc
    at-fence o → λ k nx es ms acc → k unit (%wsucc nx) (cons (tso-ev nx t k-F #0 #0 #0) es) (cons (nx , o) ms) acc
rc-thread : {R : Type} → List Word → Word → (List Word → RcRun R) → AtomThread → RcRun R
rc-thread dom t k th = tso-step-fold {AtomS} {List Word} {RcRun R} k (rc-instr dom t) th
rc-threads : {R : Type} → List AtomThread → List Word → Word → (List TsoEv → List (Word × MOrd) → List Word → R → R) → List Word → RcRun R
rc-threads nil dom t k outs nx es ms acc = k es ms outs acc
rc-threads (cons th r) dom t k outs nx es ms acc =
  rc-thread dom t (λ out nx2 es2 ms2 acc2 → rc-threads r dom (%wsucc t) k (app-w outs out) nx2 es2 ms2 acc2) th nx es ms acc
rc-tally : Memory → List TsoEv → List (Word × MOrd) → List Word → List (Word × Word) → List Word → TsoAx → TsoAx
rc-tally m0 es ms out rf co (tso-ax os c k) =
  if rc11-consistent m0 (rc-x (tso-x es rf co) ms) then tso-ax (tso-ins out os) (%wsucc c) (%wsucc k) else tso-ax os (%wsucc c) k
rc11-outcomes : Memory → List Word → List AtomThread → TsoAx
rc11-outcomes m0 dom ths =
  rc-threads ths dom #0
    (λ es ms out acc →
       tso-ax-rfs es m0 es
         (λ rf acc2 →
            (let ws = tso-keep tso-ev-writes es
             in tso-ax-cos (tso-len ws) ws (λ co acc3 → rc-tally m0 es ms out rf co acc3) nil acc2))
         nil acc)
    nil #1 nil nil (tso-ax nil #0 #0)
-- a set of outcomes within another
rc-subset : List (List Word) → List (List Word) → Bool
rc-subset xs ys = tso-all (λ x → tso-any (λ y → tso-weq-l x y) ys) xs
-- the x86 threads of language-level threads under a handler
rc-x86 : Handler AtomS TsoIS → List AtomThread → List TsoThread
rc-x86 hd nil = nil
rc-x86 hd (cons th r) = cons (at-thread hd th) (rc-x86 hd r)
-- every value a trace reads is in a domain
rc-reads-in : List Word → List TsoL → Bool
rc-reads-in dom nil = true
rc-reads-in dom (cons l r) =
  (case l of
     l-read t id a v src → if rc-in v dom then rc-reads-in dom r else false
     l-write t id a v → rc-reads-in dom r
     l-flush t id a v → rc-reads-in dom r
     l-locked t id a vr src vw → if rc-in vr dom then rc-reads-in dom r else false
     l-fence t id → rc-reads-in dom r)
-- THE STATEMENT of compilation correctness, in general: for every program over the atomics,
-- each handler, a bound within which every schedule ends, and a domain holding every value
-- read on the machine: every outcome of the handled program on the TSO machine is an outcome
-- RC11 allows. No term of it is given here; its instances are in experiments/tso/rc11.cub
-- (as in lib/languages/isa/tso.cub: AtomsX86Correct is stated and has no inhabitant;
-- experiments/tso/rc11.cub checks the inclusion only for four litmus programs at bounded
-- schedules, by computation.)
AtomsX86Correct : Handler AtomS TsoIS → Type
AtomsX86Correct hd =
  (ths : List AtomThread) → (dom : List Word) → (n : Nat) →
  isTrue (tso-every n (rc-x86 hd ths) (λ out s → rc-reads-in dom (ts-log s))) →
  isTrue (rc-subset (tso-sum-outs (tso-outcomes n (rc-x86 hd ths))) (tso-ax-outs (rc11-outcomes (λ a → #0) dom ths)))
