-- lib/autodiff.cub — differentiation of polynomials as a program about programs (plan 18.13,
-- F31's example). Loaded after lib/ring.cub. D is the symbolic derivative over the codes of
-- polynomials in one variable; fwd is forward-mode automatic differentiation (dual numbers);
-- fwd-der: the two agree; taylor: D is the derivative of the function the code denotes, in the
-- form that makes sense over Nat: p(x + h) = p(x) + h·p'(x) + h²·q for some q. Each inductive
-- step of taylor is a ring identity, proved by one evaluation of lib/ring.cub's normalizer.
data Pl = kc (n : Nat) | kx | kadd (a : Pl) (b : Pl) | kmul (a : Pl) (b : Pl)
pat : Nat → Pl → Nat
pat x p =
  case p return (λ w → Nat) of
    kc n → n
    kx → x
    kadd a b → plus (rec a) (rec b)
    kmul a b → times (rec a) (rec b)
D : Pl → Pl
D p =
  case p return (λ w → Pl) of
    kc n → kc zero
    kx → kc (suc zero)
    kadd a b → kadd (rec a) (rec b)
    kmul a b → kadd (kmul (rec a) b) (kmul a (rec b))
-- ---------------------------------------------------------------- forward mode
fwd : Nat → Pl → Nat × Nat
fwd x p =
  case p return (λ w → Nat × Nat) of
    kc n → (n , zero)
    kx → (x , suc zero)
    kadd a b → (plus (fst (rec a)) (fst (rec b)) , plus (snd (rec a)) (snd (rec b)))
    kmul a b → (times (fst (rec a)) (fst (rec b)) , plus (times (snd (rec a)) (fst (rec b))) (times (fst (rec a)) (snd (rec b))))
fwd-val : (x : Nat) (p : Pl) → fst (fwd x p) ≡ pat x p
fwd-val x p =
  case p return (λ w → fst (fwd x w) ≡ pat x w) of
    kc n → λ i → n
    kx → λ i → x
    kadd a b → cong2N (λ u v → plus u v) (rec a) (rec b)
    kmul a b → cong2N (λ u v → times u v) (rec a) (rec b)
fwd-der : (x : Nat) (p : Pl) → snd (fwd x p) ≡ pat x (D p)
fwd-der x p =
  case p return (λ w → snd (fwd x w) ≡ pat x (D w)) of
    kc n → λ i → zero
    kx → λ i → suc zero
    kadd a b → cong2N (λ u v → plus u v) (rec a) (rec b)
    kmul a b →
      cong2N (λ u v → plus u v)
        (cong2N (λ u v → times u v) (rec a) (fwd-val x b))
        (cong2N (λ u v → times u v) (fwd-val x a) (rec b))
-- ---------------------------------------------------------------- the derivative
-- valuations for the ring identities: a list of values, variable i the i-th entry
data NL = nnil | ncons (n : Nat) (rest : NL)
nthv : NL → Word → Nat
nthv l v =
  case l return (λ w → Word → Nat) of
    nnil → λ v → zero
    ncons n r → λ v → %welimP (λ w → Nat) v n (λ j h → rec r j)
  v
-- variables: 0 A, 1 A', 2 QA, 3 B, 4 B', 5 QB, 6 H, 7 X, 8 N
vA : Ex
vA = ev #0
vA' : Ex
vA' = ev #1
vQA : Ex
vQA = ev #2
vB : Ex
vB = ev #3
vB' : Ex
vB' = ev #4
vQB : Ex
vQB = ev #5
vH : Ex
vH = ev #6
vX : Ex
vX = ev #7
vN : Ex
vN = ev #8
-- the Taylor form: v + h·d + h²·q
tf : Ex → Ex → Ex → Ex
tf v d q = eadd v (eadd (emul vH d) (emul (emul vH vH) q))
-- the constant: n = n + h·0 + h²·0
tc-id2 : (n h : Nat) → n ≡ plus n (plus (times h zero) (times (times h h) zero))
tc-id2 n h = ring-eq (λ v → nthv (ncons n (ncons zero (ncons zero (ncons zero (ncons zero (ncons zero (ncons h nnil))))))) v) vA (tf vA (ec zero) (ec zero)) (λ i → norm vA)
-- the variable: x + h = x + h·1 + h²·0
tx-id : (x h : Nat) → plus x h ≡ plus x (plus (times h (suc zero)) (times (times h h) zero))
tx-id x h = ring-eq (λ v → nthv (ncons x (ncons zero (ncons zero (ncons zero (ncons zero (ncons zero (ncons h nnil))))))) v) (eadd vA vH) (tf vA one (ec zero)) (λ i → norm (eadd vA vH))
-- sums: (A + H A' + H² QA) + (B + H B' + H² QB) = (A + B) + H (A' + B') + H² (QA + QB)
val7 : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Word → Nat
val7 a a' qa b b' qb h v = nthv (ncons a (ncons a' (ncons qa (ncons b (ncons b' (ncons qb (ncons h nnil))))))) v
tadd-l : Ex
tadd-l = eadd (tf vA vA' vQA) (tf vB vB' vQB)
tadd-r : Ex
tadd-r = tf (eadd vA vB) (eadd vA' vB') (eadd vQA vQB)
tadd-id : (a a' qa b b' qb h : Nat) → xeval (λ v → val7 a a' qa b b' qb h v) tadd-l ≡ xeval (λ v → val7 a a' qa b b' qb h v) tadd-r
tadd-id a a' qa b b' qb h = ring-eq (λ v → val7 a a' qa b b' qb h v) tadd-l tadd-r (λ i → norm tadd-l)
-- products: (A + H A' + H² QA)(B + H B' + H² QB) = AB + H (A' B + A B') + H² Q with
--   Q = A' B' + A QB + QA B + H (A' QB + QA B') + H² QA QB
tmul-q : Ex
tmul-q = eadd (eadd (emul vA' vB') (eadd (emul vA vQB) (emul vQA vB)))
              (eadd (emul vH (eadd (emul vA' vQB) (emul vQA vB'))) (emul (emul vH vH) (emul vQA vQB)))
tmul-l : Ex
tmul-l = emul (tf vA vA' vQA) (tf vB vB' vQB)
tmul-r : Ex
tmul-r = tf (emul vA vB) (eadd (emul vA' vB) (emul vA vB')) tmul-q
tmul-id : (a a' qa b b' qb h : Nat) → xeval (λ v → val7 a a' qa b b' qb h v) tmul-l ≡ xeval (λ v → val7 a a' qa b b' qb h v) tmul-r
tmul-id a a' qa b b' qb h = ring-eq (λ v → val7 a a' qa b b' qb h v) tmul-l tmul-r (λ i → norm tmul-l)
-- the inductive steps: rewrite by the hypotheses, then the identity (endpoints explicit, as
-- the elaborator needs for composed paths)
TF : Nat → Nat → Nat → Nat → Nat
TF h v d q = plus v (plus (times h d) (times (times h h) q))
Taylor : Pl → Nat → Nat → Type
Taylor p x h = (q : Nat) × pat (plus x h) p ≡ TF h (pat x p) (pat x (D p)) q
taylor-add-path : (x h : Nat) (a b : Pl) (qa qb : Nat) →
                  pat (plus x h) a ≡ TF h (pat x a) (pat x (D a)) qa →
                  pat (plus x h) b ≡ TF h (pat x b) (pat x (D b)) qb →
                  plus (pat (plus x h) a) (pat (plus x h) b) ≡ TF h (plus (pat x a) (pat x b)) (plus (pat x (D a)) (pat x (D b))) (plus qa qb)
taylor-add-path x h a b qa qb pa pb =
  transN (cong2N (λ u v → plus u v) pa pb) (tadd-id (pat x a) (pat x (D a)) qa (pat x b) (pat x (D b)) qb h)
taylor-add : (x h : Nat) (a b : Pl) → Taylor a x h → Taylor b x h → Taylor (kadd a b) x h
taylor-add x h a b ta tb = (plus (fst ta) (fst tb) , taylor-add-path x h a b (fst ta) (fst tb) (snd ta) (snd tb))
Qmul : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat
Qmul a a' qa b b' qb h = xeval (λ v → val7 a a' qa b b' qb h v) tmul-q
taylor-mul-path : (x h : Nat) (a b : Pl) (qa qb : Nat) →
                  pat (plus x h) a ≡ TF h (pat x a) (pat x (D a)) qa →
                  pat (plus x h) b ≡ TF h (pat x b) (pat x (D b)) qb →
                  times (pat (plus x h) a) (pat (plus x h) b) ≡
                  TF h (times (pat x a) (pat x b)) (plus (times (pat x (D a)) (pat x b)) (times (pat x a) (pat x (D b))))
                       (Qmul (pat x a) (pat x (D a)) qa (pat x b) (pat x (D b)) qb h)
taylor-mul-path x h a b qa qb pa pb =
  transN (cong2N (λ u v → times u v) pa pb) (tmul-id (pat x a) (pat x (D a)) qa (pat x b) (pat x (D b)) qb h)
taylor-mul : (x h : Nat) (a b : Pl) → Taylor a x h → Taylor b x h → Taylor (kmul a b) x h
taylor-mul x h a b ta tb =
  (Qmul (pat x a) (pat x (D a)) (fst ta) (pat x b) (pat x (D b)) (fst tb) h ,
   taylor-mul-path x h a b (fst ta) (fst tb) (snd ta) (snd tb))
taylor : (p : Pl) (x h : Nat) → Taylor p x h
taylor p x h =
  case p return (λ w → Taylor w x h) of
    kc n → (zero , tc-id2 n h)
    kx → (zero , tx-id x h)
    kadd a b → taylor-add x h a b (rec a) (rec b)
    kmul a b → taylor-mul x h a b (rec a) (rec b)
-- ---------------------------------------------------------------- readings
-- p = x² + 3x + 1: p' = 2x + 3; at x = 2: p = 11, p' = 7, by both routes
three : Pl
three = kc (suc (suc (suc zero)))
p1 : Pl
p1 = kadd (kadd (kmul kx kx) (kmul three kx)) (kc (suc zero))
#same pat (suc (suc zero)) p1 = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))
#same pat (suc (suc zero)) (D p1) = suc (suc (suc (suc (suc (suc (suc zero))))))
#same snd (fwd (suc (suc zero)) p1) = pat (suc (suc zero)) (D p1)
-- the remainder taylor computes for p1 at x = 2, h = 1: p(3) = 19 = 11 + 1·7 + 1·q, q = 1
#same fst (taylor p1 (suc (suc zero)) (suc zero)) = suc zero
-- ---------------------------------------------------------------- D over codes (F31: D : Code → Code)
-- a code of the fragment — the variable 0 under one λ, plus, times, Nat literals — read as a
-- polynomial through lib/ring.cub's bridge (an expression in the variable 0), differentiated by
-- D, and written as a code again: the derivative of a program is a program, and taylor is the
-- theorem about what it denotes. The bridge is unverified (18.13); D and taylor are checked
pl-of-ex x =
  case x of
    ec n → some (kc n)
    ev v → (if %weq v #0 then some kx else none)
    eadd a b → obind (pl-of-ex a) (λ pa → omap (λ pb → kadd pa pb) (pl-of-ex b))
    emul a b → obind (pl-of-ex a) (λ pa → omap (λ pb → kmul pa pb) (pl-of-ex b))
ex-of-pl p =
  case p of
    kc n → ec n
    kx → ev #0
    kadd a b → eadd (ex-of-pl a) (ex-of-pl b)
    kmul a b → emul (ex-of-pl a) (ex-of-pl b)
-- D-code: the code of λ x → p (the body under one λ) to the code of λ x → p'
D-code c = omap (λ p → clam (code-of-ex (ex-of-pl (D p)))) (obind (ex-of-code (lam-body c)) pl-of-ex)
-- x·x + 3·x + 1 as a source term: its derivative's code evaluates to 2x + 3 (at 2: 7), and the
-- derivative code is the code of what D says
cp1 = code (λ x → plus (plus (times x x) (times 3 x)) 1)
#same omap (λ d → eval-g lnil d 2) (D-code cp1) = some 7
#same D-code cp1 = some (clam (code-of-ex (ex-of-pl (D p1))))
-- outside the fragment (a second variable, a successor): none
#same D-code (code (λ x → λ y → times x y)) = none
#same D-code (code (λ x → suc x)) = none
-- ---------------------------------------------------------------- D-correct over the fragment's codes (F31)
-- The fragment's codes as a typed mirror: one constructor per shape of Code the fragment has —
-- the λ's variable (cvar #0), a numeral's zero and successor (ccon of Nat), and the globals plus
-- and times applied to two codes (capp (capp (cglob g) a) b). Code itself is untyped (it is
-- declared before the checker), so a checked theorem quantifies over this mirror; the copy
-- between the two (pcode-of-code, code-of-pcode, below) is constructor for constructor, and the
-- readings check that it round-trips and that eval-g agrees with cev.
data PCode = qx | qzero | qsuc (k : PCode) | qplus (a : PCode) (b : PCode) | qtimes (a : PCode) (b : PCode)
-- what eval-g computes for the fragment, under the λ applied to x
cev : Nat → PCode → Nat
cev x c =
  case c return (λ w → Nat) of
    qx → x
    qzero → zero
    qsuc k → suc (rec k)
    qplus a b → plus (rec a) (rec b)
    qtimes a b → times (rec a) (rec b)
-- the derivative on codes: a code to a code, the product rule writing plus and times again
dpc : PCode → PCode
dpc c =
  case c return (λ w → PCode) of
    qx → qsuc qzero
    qzero → qzero
    qsuc k → rec k
    qplus a b → qplus (rec a) (rec b)
    qtimes a b → qplus (qtimes (rec a) b) (qtimes a (rec b))
-- the polynomial a code denotes (a numeral's successor is 1 + k, plus recursing on its first)
pl-of-pc : PCode → Pl
pl-of-pc c =
  case c return (λ w → Pl) of
    qx → kx
    qzero → kc zero
    qsuc k → kadd (kc (suc zero)) (rec k)
    qplus a b → kadd (rec a) (rec b)
    qtimes a b → kmul (rec a) (rec b)
cev-pl : (x : Nat) (c : PCode) → cev x c ≡ pat x (pl-of-pc c)
cev-pl x c =
  case c return (λ w → cev x w ≡ pat x (pl-of-pc w)) of
    qx → λ i → x
    qzero → λ i → zero
    qsuc k → λ i → suc (rec k i)
    qplus a b → cong2N (λ u v → plus u v) (rec a) (rec b)
    qtimes a b → cong2N (λ u v → times u v) (rec a) (rec b)
-- the derivative code denotes D of the polynomial
dpc-pl : (x : Nat) (c : PCode) → cev x (dpc c) ≡ pat x (D (pl-of-pc c))
dpc-pl x c =
  case c return (λ w → cev x (dpc w) ≡ pat x (D (pl-of-pc w))) of
    qx → λ i → suc zero
    qzero → λ i → zero
    qsuc k → rec k
    qplus a b → cong2N (λ u v → plus u v) (rec a) (rec b)
    qtimes a b →
      cong2N (λ u v → plus u v)
        (cong2N (λ u v → times u v) (rec a) (cev-pl x b))
        (cong2N (λ u v → times u v) (cev-pl x a) (rec b))
-- D-correct: for every code c of the fragment, the code dpc c is its derivative — what c computes
-- at x + h is what it computes at x, plus h times what dpc c computes at x, plus h² times a
-- remainder (the Taylor form over Nat; taylor above, transported along cev-pl and dpc-pl)
D-correct-at : (c : PCode) (x h q : Nat) →
               pat (plus x h) (pl-of-pc c) ≡ TF h (pat x (pl-of-pc c)) (pat x (D (pl-of-pc c))) q →
               cev (plus x h) c ≡ TF h (cev x c) (cev x (dpc c)) q
D-correct-at c x h q t =
  transN (cev-pl (plus x h) c) (transN t (symN (cong2N (λ u v → TF h u v q) (cev-pl x c) (dpc-pl x c))))
D-correct : (c : PCode) (x h : Nat) → (q : Nat) × cev (plus x h) c ≡ TF h (cev x c) (cev x (dpc c)) q
D-correct c x h = (fst (taylor (pl-of-pc c) x h) , D-correct-at c x h (fst (taylor (pl-of-pc c) x h)) (snd (taylor (pl-of-pc c) x h)))
-- and forward mode over the same codes computes what the derivative code computes
D-correct-fwd : (c : PCode) (x : Nat) → snd (fwd x (pl-of-pc c)) ≡ cev x (dpc c)
D-correct-fwd c x = transN (fwd-der x (pl-of-pc c)) (symN (dpc-pl x c))
-- the copy between Code and the mirror (untyped: Code is). A numeral's constructor is Nat's
nat-di = case code zero of ccon d k fs ds → d; _ → #0
plus-gi = gidx-r (code plus)
times-gi = gidx-r (code times)
pcode-of-code c =
  case c of
    cann t T → pcode-of-code t
    cvar v → (if %weq v #0 then some qx else none)
    ccon d k fs ds →
      (if %weq d nat-di
       then (if %weq k #0 then some qzero
             else (case fs of lcons n r → omap (λ m → qsuc m) (pcode-of-code n); _ → none))
       else none)
    capp f x →
      (case f of
         capp g a →
           (case rg-glob g of
              some gi →
                if %weq gi plus-gi then obind (pcode-of-code a) (λ pa → omap (λ pb → qplus pa pb) (pcode-of-code x))
                else if %weq gi times-gi then obind (pcode-of-code a) (λ pa → omap (λ pb → qtimes pa pb) (pcode-of-code x))
                else none
              none → none)
         _ → none)
    _ → none
code-of-pcode p =
  case p of
    qx → cvar #0
    qzero → ccon nat-di #0 lnil lnil
    qsuc k → ccon nat-di #1 (lcons (code-of-pcode k) lnil) lnil
    qplus a b → capp (capp (cglob plus-gi) (code-of-pcode a)) (code-of-pcode b)
    qtimes a b → capp (capp (cglob times-gi) (code-of-pcode a)) (code-of-pcode b)
-- the derivative of a program of the fragment, by the checked dpc
D-code-c c = omap (λ p → clam (code-of-pcode (dpc p))) (pcode-of-code (lam-body c))
pc1 = pcode-of-code (lam-body cp1)
#same pc1 = some (qplus (qplus (qtimes qx qx) (qtimes (qsuc (qsuc (qsuc qzero))) qx)) (qsuc qzero))
-- the copy round-trips on the mirror, and eval-g of a mirrored code is cev
#same obind pc1 (λ p → pcode-of-code (code-of-pcode p)) = pc1
#same omap (λ p → eval-g lnil (clam (code-of-pcode p)) 2) pc1 = omap (λ p → cev 2 p) pc1
#same omap (λ d → eval-g lnil d 2) (D-code-c cp1) = some 7
#same omap (λ p → cev 2 (dpc p)) pc1 = some 7
-- the theorem at the code read from the source term: remainder 1 at x = 2, h = 1, as taylor's
#same omap (λ p → fst (D-correct p 2 1)) pc1 = some 1
#same D-code-c (code (λ x → suc x)) = some (clam (code-of-pcode (qsuc qzero)))
#same D-code-c (code (λ x → λ y → times x y)) = none
