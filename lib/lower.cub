-- lib/lower.cub — lowering from codes to the first-order form (plan B14, B15 step 6). Loaded after lib/std.cub,
-- lib/check.cub (it reads the data table for the shapes of constructors) and lib/fo.cub.
-- ---------------------------------------------------------------- shapes
-- the kinds of a constructor's fields, by walking its telescope with fresh variables: a Lst of
-- (kind , d2): kind 0 a word, 1 recursive, 2 a data type d2 without parameters, 3 anything else
field-kind d A =
  if is-rec-ty d A then (#1 , d)
  else (case A of tword → (#0 , d); tdata d2 ps V → (case ps of lnil → (#2 , d2); _ → (#3 , d)); _ → (#3 , d))
tel-kinds d tel acc =
  case tel of
    tx A nm r → (let Av = tval A in tel-kinds d (r (%var nm Av) Av) (lsnoc acc (field-kind d A)))
    _ → acc
-- the constructor's telescope with the type's parameters as fresh variables
cshape d c = tel-kinds d (fromopt (lnth (snd (params-fresh (dtel (%dent d)) lnil)) c) (tz (tsys lnil []))) lnil
-- the indices of the recursive fields, in order
rec-fields ks i = case ks of lnil → lnil; lcons k r → if %weq (fst k) #1 then lcons i (rec-fields r (%wsucc i)) else rec-fields r (%wsucc i)
lst-count l = case l of lnil → #0; lcons x xs → %wsucc (lst-count xs)
-- ---------------------------------------------------------------- lowering
-- Bool is a word in the first-order form (true 1, false 0, as the native comparisons answer):
-- its constructors are literals and a case on it is an if
bool-idx = case code Bool of cdata d ps → d; _ → #0
lower-bool B x = case B of lcons t r → (case r of lcons f r2 → fif x (lower (strip-n #0 t)) (lower (strip-n #0 f)); _ → fnet #0 lnil); _ → fnet #0 lnil
-- lower c: the first-order form of a code in the first-order fragment: variables, words and
-- their operations, constructors and case, pairs, λ and application, let, word elimination as a
-- loop. Any other form becomes a call into the net on the code itself (fnet, the code as its
-- argument), which is what the criterion (B13) reports as not-fo; the specializer removes such
-- forms before lowering where it can. Pairs are the constructor 0 of data type 0 with two fields.
-- The word operations' codes: 0 eq, 1 lt, 2 add, 3 max, 4 sub (code.cub cwop)
lower c =
  case c of
    cvar n → fvar n
    cglob n → fcall n lnil
    clam b → flam (lower b)
    capp f a → lower-app f (lcons (lower a) lnil)
    cpair a b → fcon #0 #0 (lcons (lower a) (lcons (lower b) lnil))
    cfst p → fproj #0 #0 #0 (lower p)
    csnd p → fproj #0 #0 #1 (lower p)
    clet t b → flet (lower t) (lower b)
    cann t T → lower t
    ccon d k fs ds → if %weq d bool-idx then flit (if %weq k #0 then #1 else #0) else fcon d k (lower-list fs)
    ccase d B x → if %weq d bool-idx then lower-bool B (lower x) else frec d (lower x) (lower-ralts d B #0)
    celim d P B x → if %weq d bool-idx then lower-bool B (lower x) else frec d (lower x) (lower-ralts d B #0)
    cforce t → fforce (lower t)
    -- a delayed term is transparent (it has its term's type, and every operation meeting it builds
    -- it): the first-order form is strict, so it is the term, evaluated where it stands (a checked
    -- term terminates, so the value is the same); fthunk is for the suspensions lift makes
    cthunk t → lower t
    cwlit n → flit n
    cplit k b → if %weq k #0 then fi64 b else if %weq k #2 then ff64 b else if %weq k #1 then flit b else fnet #0 lnil
    cwsucc a → fprim P-add (lcons (lower a) (lcons (flit #1) lnil))
    cwop k a b → fprim (wop-prim k) (lcons (lower a) (lcons (lower b) lnil))
    cprim k as → lower-prim k as
    cwelim w z s → lower-welim (lower w) (lower z) (lower s)
    _ → fnet #0 lnil
-- A primitive operation's code (cprim k as, lib/code.cub prim-apply's numbering) in the first-order
-- form: the fixed-width integer and floating-point operations are the form's own primitives
-- (P-i64add .. P-f64ofw, P-u32add .. P-wofu32, lib/fo.cub; a UInt32 is the word of its 32 bits and its
-- operations wrap at 2^32; a Float32 is the word of its bits, so f32bits and f32ofbits read the same
-- word: no operation), the 8- and 4-byte loads and stores the byte
-- layer's; the 1- and 2-byte accesses are a call into the net (fnet) until the form gains them
lower-prim k cs =
  let as = lower-list cs
  in if %wlt k #512
       then (let sb = %wsub k #256
             in if %weq sb #16 then fprim P-i64ofw as else if %weq sb #17 then fprim P-wofi64 as
                else if %weq sb #20 then fprim P-f64ofw as else if %weq sb #21 then fprim P-f64ofi64 as
                else if %weq sb #22 then fprim P-i64off64 as
                else if %weq sb #23 then fprim P-f64bits as else if %weq sb #24 then fprim P-f64ofbits as
                else if %weq sb #18 then fprim P-u32ofw as else if %weq sb #19 then fprim P-wofu32 as
                else if %weq sb #25 then (case as of lcons a r → a; lnil → flit #0)
                else if %weq sb #26 then (case as of lcons a r → a; lnil → flit #0) else fnet k as)
       else if %wlt k #768
         then (let sb = %wsub k #512
               in if %wlt sb #5 then fprim (%wadd P-i64add sb) as
                  else if %wlt sb #10 then fprim (%wadd P-u32add (%wsub sb #5)) as
                  else if %wlt sb #16 then fprim (%wadd P-f64add (%wsub sb #10)) as else fnet k as)
         else if %wlt k #1280 then lower-access k cs as
         else if %wlt k #1536 then fprim P-blen as else fprim P-bytes as
-- a load (class 3) or store (class 4) of w bytes at off in a buffer of n bytes: the access, under
-- the fact the dropped proof established, off + w < n + 1, stated for the C compiler (fassume)
-- when the quote carried the length (lib/check.cub bytes-len-code); the proof itself is gone.
-- the offset of a load or store is a Nat (the byte layer's index), and the first-order primitives take
-- a word: a numeral becomes its word, any other offset fromNat of it (a call, lowered with the
-- program; it was passed as the Nat's constructor tree, which the loads read as 0)
lower-off c = case lower-natlit c of some w → flit w; none → lower-app lower-fromnat (lcons (lower c) lnil)
lower-fromnat = code fromNat
lower-nat-d = case code zero of ccon d k fs ds → d; _ → #0
lower-natlit c = case c of cwlit w → some w; ccon d k fs ds → (if %weq d lower-nat-d then (if %weq k #0 then some #0 else (case fs of lcons x r → (case lower-natlit x of some w → some (%wsucc w); none → none); lnil → none)) else none); _ → none
lset-l l n x = case l of lnil → lnil; lcons y r → (if %weq n #0 then lcons x r else lcons y (lset-l r (%wsub n #1) x))
ltake-l n l = if %weq n #0 then lnil else (case l of lnil → lnil; lcons x r → lcons x (ltake-l (%wsub n #1) r))
-- a Nat numeral in the fact (the offset, the length) as the word the machine holds it as (a numeral
-- is a word in the machine, B12 §6.2); any other code as it stands
fact-nat c = case lower-natlit c of some w → cwlit w; none → c
lower-access k cs as =
  let st = if %wlt k #1024 then false else true
      w = %wsub k (if st then #1024 else #768)
      nargs = if st then #3 else #2
      as2 = lset-l as #1 (lower-off (cl-at cs #1))
      body = if %weq w #8 then fprim (if st then P-store64 else P-load64) (ltake-l nargs as2)
             else if %weq w #4 then fprim (if st then P-store32 else P-load32) (ltake-l nargs as2) else fnet k (ltake-l nargs as)
  in if %weq (lst-len cs) (%wsucc nargs)
       then fassume (cwop #1 (cwop #2 (fact-nat (cl-at cs #1)) (cwlit w)) (cwsucc (fact-nat (cl-at cs nargs)))) body
       else body
-- an application spine: nested capps become one fapply; a global head becomes fcall, with the
-- arguments at its erased parameters (usage 0, B11: proofs, lengths only types mention) dropped
-- — erasure by computed usage, the call and the definition (program-defs) agreeing on the
-- positions
lower-app f args =
  case f of
    capp g a → lower-app g (lcons (lower a) args)
    cglob n → fcall n (drop-erased (g-erased n) #0 args)
    _ → fapply (lower f) args
-- the erased parameters of a checked definition: the indices of its type's Π binders at usage 0
g-erased g = case quote-ty (%gty g) of some T → erased-of g #0 T; none → lnil
erased-of g i T = case T of cpi m A B → (if %weq (%gusage g i) #0 then lcons i (erased-of g (%wsucc i) B) else erased-of g (%wsucc i) B); _ → lnil
drop-erased es i args = case args of lnil → lnil; lcons a r → if lmem-l i es then drop-erased es (%wsucc i) r else lcons a (drop-erased es (%wsucc i) r)
lmem-l x l = case l of lnil → false; lcons y r → if %weq x y then true else lmem-l x r
-- a lowered definition with its erased λs removed: the binder at position k (from the outside) is
-- dropped and the variables above it move down; a variable the erased binder bound occurs only in
-- assumed facts (the usage pass admits nothing else), and such a fact is dropped with it
erase-lams es k t =
  case t of
    flam b → if lmem-l k es then erase-lams es (%wsucc k) (funshift-at #0 b) else flam (erase-lams es (%wsucc k) b)
    _ → t
funshift-at d t =
  case t of
    fvar n → if %wlt d n then fvar (%wsub n #1) else t
    fcon dd c fs → fcon dd c (funshift-list d fs)
    fswitch x alts → fswitch (funshift-at d x) (funshift-alts d alts)
    frec dd x alts → frec dd (funshift-at d x) (funshift-ralts d alts)
    fproj dd c j x → fproj dd c j (funshift-at d x)
    fcall g args → fcall g (funshift-list d args)
    fprim p args → fprim p (funshift-list d args)
    flet a b → flet (funshift-at d a) (funshift-at (%wsucc d) b)
    fif c a b → fif (funshift-at d c) (funshift-at d a) (funshift-at d b)
    floop init body → floop (funshift-list d init) (funshift-at (%wadd d (lst-count init)) body)
    fclos g env → fclos g (funshift-list d env)
    flam b → flam (funshift-at (%wsucc d) b)
    fapply f args → fapply (funshift-at d f) (funshift-list d args)
    fthunk a → fthunk (funshift-at d a)
    fforce x → fforce (funshift-at d x)
    fnet g args → fnet g (funshift-list d args)
    fassume f b → if fact-mentions d f then funshift-at d b else fassume (funshift-fact d f) (funshift-at d b)
    fupd u dd x c k v → fupd u dd (funshift-at d x) c k (funshift-at d v)
    _ → t
funshift-list d l = case l of lnil → lnil; lcons x xs → lcons (funshift-at d x) (funshift-list d xs)
funshift-alts d alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , funshift-at (%wadd d (fst (snd a))) (snd (snd a)))) (funshift-alts d r)
funshift-ralts d alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , funshift-at (%wadd d (%wadd (fst (snd a)) (lst-count (fst (snd (snd a)))))) (snd (snd (snd a)))))) (funshift-ralts d r)
fact-mentions d c = case c of cvar n → %weq n d; cwop k a b → orb (fact-mentions d a) (fact-mentions d b); cwsucc a → fact-mentions d a; cann a T → fact-mentions d a; _ → false
funshift-fact d c = case c of cvar n → (if %wlt d n then cvar (%wsub n #1) else c); cwop k a b → cwop k (funshift-fact d a) (funshift-fact d b); cwsucc a → cwsucc (funshift-fact d a); cann a T → funshift-fact d a; _ → c
lower-list l = case l of lnil → lnil; lcons x xs → lcons (lower x) (lower-list xs)
-- branches: the k-th code is a λ over the constructor's fields; its λs are stripped, the fields
-- being pushed by fswitch in order
lower-alts B k = case B of lnil → lnil; lcons b r → lcons (k , (count-lams b , lower (strip-lams b))) (lower-alts r (%wsucc k))
-- a case or elimination: branch k binds the constructor's fields then a hypothesis per recursive
-- field (the shape from the data table); its λs are stripped and the recursion form records
-- which fields carry hypotheses
lower-ralts d B k =
  case B of
    lnil → lnil
    lcons b r →
      let ks = cshape d k
          hs = rec-fields ks #0
      in lcons (k , (lst-count ks , (hs , lower (strip-n (%wadd (lst-count ks) (lst-count hs)) b)))) (lower-ralts d r (%wsucc k))
-- exactly m λs stripped: a branch whose body is itself a λ keeps it
strip-n m b = if %weq m #0 then b else (case b of clam b2 → strip-n (%wsub m #1) b2; _ → b)
count-lams b = case b of clam b2 → %wsucc (count-lams b2); _ → #0
strip-lams b = case b of clam b2 → strip-lams b2; _ → b
-- %weq %wlt %wadd %wmax %wsub are 0..4, each one primitive of the first-order form (max was lowered as
-- addition until 2026-11-07, then expanded into a let and an if; P-max since 2026-11-09)
wop-prim k = if %weq k #0 then P-eq else if %weq k #1 then P-lt else if %weq k #2 then P-add else if %weq k #3 then P-max else P-sub
-- word elimination as a loop over (w, i, acc): while i < w, acc := s i acc; the step s is a
-- two-argument function value, applied through fapply. Variables in w z s refer to the
-- enclosing environment, below the loop's three state slots: shifted by 3 inside the body
lower-welim w z s =
  floop (lcons w (lcons (flit #0) (lcons z lnil)))
    (fif (fprim P-lt (lcons (fvar #1) (lcons (fvar #2) lnil)))
       (fcon #0 #0 (lcons (fvar #2)
                   (lcons (fprim P-add (lcons (fvar #1) (lcons (flit #1) lnil)))
                   (lcons (step-call s) lnil))))
       (fcon #0 #1 (lcons (fvar #0) lnil)))
-- the step applied to (i, acc): when the step is a written λ of two arguments its body is
-- inlined, i and acc being the loop's fvar 1 and fvar 0 and the step's other free variables
-- lying above the loop's three slots (shifted by 1: they were above the λ's two binders)
step-call s =
  case s of
    flam s1 → (case s1 of flam b → shift-at #2 #1 b; _ → fapply (shift #3 s) (lcons (fvar #1) (lcons (fvar #0) lnil)))
    _ → fapply (shift #3 s) (lcons (fvar #1) (lcons (fvar #0) lnil))
-- ---------------------------------------------------------------- types (B14: FT from the elaborated types)
-- ft-of T: the first-order type of a type code: words (Word, UInt32, Bool, a type represented by
-- Word), Int64, Float64, byte strings, pairs, data types (by index, with their parameters' codes),
-- functions (a Π chain, its domains then its codomain; dependencies are not expressible in FT and
-- are read as ftany); a type outside the fragment is ftany
ft-of T =
  case T of
    cword → ftword
    cpty k n → if %weq k #0 then fti64 else if %weq k #2 then ftf64 else if %weq k #4 then ftbytes (bytes-len n) else ftword
    cdata d ps → if %weq d bool-idx then ftword else (case %rtab d of some R → ft-of-rep R; none → ftdata d ps #0)
    csigma A B → ftpair (ft-of A) (ft-of B)
    cpi m A B → ft-pi (lcons (ft-of A) lnil) B
    cann t T2 → ft-of t
    _ → ftany
ft-pi args B = case B of cpi m A B2 → ft-pi (lsnoc args (ft-of A)) B2; _ → ftfun args (ft-of B)
-- a represented type's value: its representation's type, quoted
ft-of-rep R = ft-of (fromopt (quote-ty R) cword)
bytes-len n = case n of cwlit w → w; _ → #0
-- the signature of a Π type: its parameters' types and its result's
sig-ft T = case ft-of T of ftfun args r → (args , r); t → (lnil , t)
-- the signature of a checked definition, from its type in the store
global-sig g = sig-ft (fromopt (quote-ty (%gty g)) cword)
-- ---------------------------------------------------------------- readings
didx c = case c of cdata d ps → d; _ → #0
-- plus on words as code, lowered and evaluated
c-plus = clam (clam (cwop #2 (cvar #1) (cvar #0)))
#same eval-fo no-defs lnil (fapply (lower c-plus) (lcons (flit #3) (lcons (flit #4) lnil))) = vw #7
-- a case on a data type declared here: branch 1 returns its single field
data Two = tw0 | tw1 (w : Word)
c-case = ccase (didx (code Two)) (lcons (cwlit #0) (lcons (clam (cvar #0)) lnil)) (ccon (didx (code Two)) #1 (lcons (cwlit #42) lnil) lnil)
#same eval-fo no-defs lnil (lower c-case) = vw #42
-- structural recursion lowered: the length of a list written with case and rec, on an unknown
-- list, becomes a recursion form with the hypothesis on the second field; evaluated on a list.
-- (The code is the case written out: a call of the definition lenw stays a call, 18.6's finding.)
data LW = lwnil | lwcons (x : Word) (xs : LW)
lenw : LW → Word
lenw l = case l of lwnil → #0; lwcons x xs → %wsucc (rec xs)
zw : Word
zw = #0
sw : Word → Word
sw w = %wsucc w
c-len = code (λ (l : LW) → case l of lwnil → zw; lwcons x xs → sw (rec xs))
lw3 = fcon (didx (code LW)) #1 (lcons (flit #5) (lcons (fcon (didx (code LW)) #1 (lcons (flit #6) (lcons (fcon (didx (code LW)) #0 lnil) lnil))) lnil))
-- the globals zw and sw called by the branches, as first-order definitions
gidx c = case c of cglob n → n; _ → #0
len-defs g = if %weq g (gidx (code zw)) then flit #0 else if %weq g (gidx (code sw)) then fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)) else flit #0
#same eval-fo len-defs lnil (fapply (lower c-len) (lcons lw3 lnil)) = vw #2
-- and lifted: the recursion is a definition of its own (numbered from 1000), called at the site
with-defs ds g = case ds of lnil → len-defs g; lcons d r → if %weq (fst d) g then snd (snd d) else with-defs r g
#same (case lift #1000 (lower c-len) of lifted t2 ds k → eval-fo (with-defs ds) lnil (fapply t2 (lcons lw3 lnil))) = vw #2
-- the signatures read off types: lenw takes a list and returns a word; a pair type is a pair
#same global-sig (gidx (code lenw)) = (lcons (ftdata (didx (code LW)) lnil #0) lnil , ftword)
#same ft-of (code (Word × Word)) = ftpair ftword ftword
#same sig-ft (code (Word → Word → Word)) = (lcons ftword (lcons ftword lnil) , ftword)
-- erasure by usage: a definition taking a proof it never reads (usage 0) loses that parameter
-- in the form, and so does every call of it
useless : Word → Unit → Word
useless w p = %wadd w #1
#same g-erased (gidx (code useless)) = lcons #1 lnil
#same lower (code (λ (w : Word) → useless w unit)) = flam (fcall (gidx (code useless)) (lcons (fvar #0) lnil))
#same erase-lams (g-erased (gidx (code useless))) #0 (lower (fromopt (quote-top (%gty (gidx (code useless))) (%gval (gidx (code useless)))) cword)) = flam (fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)))
