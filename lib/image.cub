x-r-hit = (lcons #97 (lcons #32 (lcons #100 (lcons #97 (lcons #116 (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #119 (lcons #105 (lcons #116 (lcons #104 (lcons #32 (lcons #112 (lcons #97 (lcons #116 (lcons #104 (lcons #32 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #111 (lcons #114 (lcons #115 lnil))))))))))))))))))))))))))))))))))
x-r-ftype = (lcons #97 (lcons #32 (lcons #102 (lcons #105 (lcons #101 (lcons #108 (lcons #100 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #111 (lcons #117 (lcons #116 (lcons #115 (lcons #105 (lcons #100 (lcons #101 (lcons #32 (lcons #116 (lcons #104 (lcons #101 (lcons #32 (lcons #102 (lcons #114 (lcons #97 (lcons #103 (lcons #109 (lcons #101 (lcons #110 (lcons #116 lnil)))))))))))))))))))))))))))))))))
x-r-clos = (lcons #97 (lcons #32 (lcons #102 (lcons #117 (lcons #110 (lcons #99 (lcons #116 (lcons #105 (lcons #111 (lcons #110 (lcons #32 (lcons #118 (lcons #97 (lcons #108 (lcons #117 (lcons #101 (lcons #32 (lcons #119 (lcons #104 (lcons #101 (lcons #114 (lcons #101 (lcons #32 (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #105 (lcons #115 (lcons #32 (lcons #110 (lcons #101 (lcons #101 (lcons #100 (lcons #101 (lcons #100 lnil)))))))))))))))))))))))))))))))))))))))
x-r-con-ty = (lcons #97 (lcons #32 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #111 (lcons #114 (lcons #32 (lcons #111 (lcons #102 (lcons #32 (lcons #97 (lcons #32 (lcons #112 (lcons #97 (lcons #114 (lcons #97 (lcons #109 (lcons #101 (lcons #116 (lcons #101 (lcons #114 (lcons #105 (lcons #122 (lcons #101 (lcons #100 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #97 (lcons #116 (lcons #32 (lcons #97 (lcons #110 (lcons #32 (lcons #117 (lcons #110 (lcons #107 (lcons #110 (lcons #111 (lcons #119 (lcons #110 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 lnil))))))))))))))))))))))))))))))))))))))))))))))))))))))))
x-lam-amp = (lcons #91 (lcons #38 (lcons #93 lnil)))
x-lam-const = (lcons #40 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #32 lnil)))))))
x-r-dep = (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #100 (lcons #101 (lcons #112 (lcons #101 (lcons #110 (lcons #100 (lcons #105 (lcons #110 (lcons #103 (lcons #32 (lcons #111 (lcons #110 (lcons #32 (lcons #97 (lcons #32 (lcons #114 (lcons #117 (lcons #110 (lcons #45 (lcons #116 (lcons #105 (lcons #109 (lcons #101 (lcons #32 (lcons #118 (lcons #97 (lcons #108 (lcons #117 (lcons #101 lnil))))))))))))))))))))))))))))))))))))
-- ---------------------------------------------------------------- the platform and the configuration (18.15)
-- The image is specialized against a configuration: its platform (the target's word width, byte
-- order and the alignment its structs keep) is read at build, so the header's preamble defines
-- cub::word, cub::align and cub::big from it and every part of the image that depends on the target
-- goes through those three (Word is cub::word, a defining struct is alignas(cub::align), the byte
-- layer's loads and stores assemble bytes in cub::big's order). The parameters are the consumers'
-- instantiations (Inst: a checked definition and its type arguments), recorded by a static
-- registration in each translation unit that instantiates a template of the image (cub::note) and
-- written back, at exit, as a configuration (cub::config_out, to $CUB_CONFIG_OUT): a list of them is
-- what the next specialization reads (cxx-image-cfg).
data Endian = little-e | big-e
data Platform = platform (pl-wbits : Word) (pl-endian : Endian) (pl-align : Word)
data Venue = venue (vn-id : Word)
data TyArg = ta-word | ta-i64 | ta-u32 | ta-f64 | ta-bool | ta-data (ta-d : Word) | ta-other
data Inst = inst-at (in-g : Word) (in-args : List TyArg)
data Config (P : Type) (R : Type) = config (cf-venues : List Venue) (cf-params : P) (cf-role : R) (cf-platform : Platform)
plat-default = platform #64 little-e #0
plat-text p = case p of platform w e a → cat3 x-pl-word (dec w) (cat3 x-pl-align (dec a) (cat3 x-pl-big (case e of little-e → x-false; big-e → x-true) x-pl-end))
x-preamble p = cat3 x-once x-pre-inc (cat3 x-pre-ns (plat-text p) x-pre-rest)
-- ---------------------------------------------------------------- names
x-gname names g = case names of lnil → lapp x-g (dec g); lcons nm r → if %weq (fst nm) g then snd nm else x-gname r g
x-dname d = lapp x-D (dec d)
x-cname d c = cat3 (x-dname d) x-c (dec c)
x-fname k = lapp (lcons #102 lnil) (dec k)
x-vname i = lapp x-v (dec i)
x-pname i = lapp x-P (dec i)
-- ---------------------------------------------------------------- the environment
-- a binder is (kind , text): kind 0 a run-time variable named by the text, 1 a template type
-- parameter, 2 an erased binder, 3 a non-type template parameter, 4 a field of a case (the text
-- the member access), 5 a hypothesis (the text the recursive call's head), innermost first
b-run nm = (#0 , nm)
b-type nm = (#1 , nm)
b-erased = (#2 , lnil)
b-const nm = (#3 , nm)
b-field txt = (#4 , txt)
b-hyp txt = (#5 , txt)
-- 6 a record of operations taken as a concept-constrained parameter: (arities , the variable)
b-ops ars nm = (#6 , (ars , nm))
env-at env n = b-at (snd (snd env)) n
b-at bs n = case bs of lnil → b-erased; lcons b r → if %weq n #0 then b else b-at r (%wsub n #1)
env-depth env = lst-len (snd (snd env))
push-b b env = (fst env , (fst (snd env) , lcons b (snd (snd env))))
env-of names = ((names , lnil) , (lnil , lnil))
env-with names stages = ((names , lnil) , (stages , lnil))
-- the data types in their data form (a represented type's own conversions see it as its constructors)
env-dform env ds = ((fst (fst env) , ds) , snd env)
dform-has env d = lmem-w d (snd (fst env))
x-gname-g env n = x-gname (fst (fst env)) n
-- ---------------------------------------------------------------- types
-- the C++ type of a type code; a universe is `class` (a template parameter's kind); a Π type is a
-- function value, which the image passes as a deduced parameter (auto); a data type with
-- parameters or a dependent Σ is outside the fragment
cxx-type env c =
  case c of
    cword → xs x-u64
    cpty k n → (if %weq k #0 then xs x-i64 else if %weq k #2 then xs x-f64 else if %weq k #1 then xs x-u32
                else if %weq k #4 then xcat3 (xs x-bytes) (word-code n) (xs x-gt) else xno (lapp x-r-form (lcons #112 lnil)))
    cdata d ps → if %weq d bool-idx then xs x-bool
                 else if is-codata d then (case ps of lnil → xs (x-dname d); _ → xno x-r-params)
                 else (case %rtab d of some R → (case ps of lnil → xs (rep-name env d); _ → xno x-r-params); none → (case ps of lnil → xs (x-dname d); _ → if %weq (d-arity d) (lst-len ps) then xcat3 (xs (lapp (x-dname d) x-lt)) (join-x (tys-x env ps)) (xs x-gt) else xno x-r-params))
    csigma A B → if x-mentions #0 B then xno x-r-dep else xcat5 (xs x-pair) (cxx-type env A) (xs x-comma) (cxx-type (push-b b-erased env) B) (xs x-gt)
    cpi m A B → xs x-auto
    cvar n → (let b = env-at env n in if %weq (fst b) #1 then xs (snd b) else xno x-r-dep)
    cuniv l → xs x-class
    cann t T → cxx-type env t
    _ → xno (lapp x-r-form (code-head c))
x-mentions k c =
  case c of
    cvar n → %weq n k
    clam b → x-mentions (%wsucc k) b
    cpi m A B → orb (x-mentions k A) (x-mentions (%wsucc k) B)
    csigma A B → orb (x-mentions k A) (x-mentions (%wsucc k) B)
    capp f a → orb (x-mentions k f) (x-mentions k a)
    cdata d ps → lany (x-mentions k) ps
    cann t T → orb (x-mentions k t) (x-mentions k T)
    cwop p a b → orb (x-mentions k a) (x-mentions k b)
    cwsucc a → x-mentions k a
    cpty j n → x-mentions k n
    _ → false
-- a Nat numeral in a code as the word it represents (Nat by Word, lib/prim.cub), read by the image
-- where a word is written
nat-rep = case %rtab nat-d of some R → true; none → false
nat-code c =
  case c of
    ccon d k fs ds → (if %weq d nat-d then (if %weq k #0 then some #0 else (case fs of lcons x r → omap (λ n → %wsucc n) (nat-code x); lnil → none)) else none)
    _ → none
word-code c = case c of cwlit w → xs (dec w); _ → (case nat-code c of some w → xs (dec w); none → xno x-r-dep)
-- the head of a code, for a report
code-head c =
  case c of
    cplam b → x-r-dim
    cpapp p r → x-r-dim
    ccomp A u a → x-r-kan
    ctrans d psi ls x → x-r-kan
    chcomp u a → x-r-kan
    cgluet A S → x-r-kan
    cglue S a → x-r-kan
    cunglue S b → x-r-kan
    cuniv l → x-r-univ
    cpathp A a b → x-r-dim
    _ → (lcons #111 (lcons #116 (lcons #104 (lcons #101 (lcons #114 lnil)))))
-- ---------------------------------------------------------------- terms
-- cxx-expr env want c: the C++ expression of code c; want the expected type's code when known
-- (some T), for the return type a recursion needs
cxx-expr env want c =
  case c of
    cvar n → var-expr (env-at env n)
    cglob n → xs (x-gname-g env n)
    clam b → (let i = env-depth env in xcat4 (xs x-lam) (xs (lapp x-auto (lapp x-sp (x-vname i)))) (xs x-lamr) (xcat2 (cxx-expr (push-b (b-run (x-vname i)) env) none b) (xs x-lamend)))
    capp f a → spine env want f (lcons a lnil)
    cpair a b → xcat5 (xs x-mkpair) (cxx-expr env none a) (xs x-comma) (cxx-expr env none b) (xs x-rb)
    cfst p → (case ops-mem env c of some t → xs t; none → xcat3 (xs x-lp) (cxx-expr env none p) (xs (lapp x-rp x-first)))
    csnd p → (case ops-mem env c of some t → xs t; none → xcat3 (xs x-lp) (cxx-expr env none p) (xs (lapp x-rp x-second)))
    crec d fs → codata-rec env d fs
    cproj d k x → xcat3 (xs x-lp) (cxx-expr env none x) (xs (cat4 x-rp (lcons #46 lnil) (x-oname d k) x-call0))
    clet t b → (let i = env-depth env in xcat7 (xs x-lam0) (xs (lapp x-let (x-vname i))) (xs x-assign) (cxx-expr env none t) (xs (lapp x-semi (lapp x-sp x-ret))) (cxx-expr (push-b (b-run (x-vname i)) env) want b) (xs (lapp x-lamend x-call0)))
    cann t T → cxx-expr env (some T) t
    cwlit n → xs (cat3 x-ulit (dec n) x-rp)
    cwsucc a → xcat3 (xs x-lp) (cxx-expr env none a) (xs x-one)
    cwop k a b → if %weq k #3 then xcat5 (xs x-max) (cxx-expr env none a) (xs x-comma) (cxx-expr env none b) (xs x-rp)
                 else xcat5 (xs x-lp) (cxx-expr env none a) (xs (wop-text k)) (cxx-expr env none b) (xs x-rp)
    cplit k b → if %weq k #0 then xs (cat4 x-i64c x-ulit (dec b) (lapp x-rp x-rp)) else if %weq k #2 then xs (cat4 x-f64bits x-ulit (dec b) (lapp x-rp x-rp)) else if %weq k #1 then xs (cat4 x-u32c x-ulit (dec b) (lapp x-rp x-rp)) else xno (lapp x-r-form (lcons #112 lnil))
    cprim k as → prim-expr env k as
    cwelim w z s → xcat7 (xs x-welim) (cxx-expr env none w) (xs x-comma) (cxx-expr env none z) (xs x-comma) (cxx-expr env none s) (xs x-rp)
    ccon d k fs ds → (case ds of lnil → (if %weq d bool-idx then xs (if %weq k #0 then x-true else x-false) else (case (if andb nat-rep (andb (%weq d nat-d) (notb (dform-has env d))) then nat-code c else none) of some n → xs (cat5 (x-dname d) x-from-c x-ulit (dec n) (lapp x-rp x-rp)); none → con-expr env want d k fs)); _ → xno x-r-dim)
    ccase d B x → if %weq d bool-idx then bool-case env want B x else case-expr env want d none B x
    celim d P B x → if %weq d bool-idx then bool-case env want B x else case-expr env want d (some P) B x
    cforce t → (case t of cvar n → (let b = env-at env n in if %weq (fst b) #5 then xs (snd b) else xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil))))))); _ → xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil)))))))
    -- a delayed term: the term (C++ is strict; a checked definition's normal form, which the image
    -- translates, has none — the machine builds a delay where it is met)
    cthunk t → cxx-expr env want t
    cdata d ps → cxx-type env c
    cword → cxx-type env c
    cpty k n → cxx-type env c
    csigma A B → cxx-type env c
    cpi m A B → cxx-type env c
    _ → xno (lapp x-r-form (code-head c))
var-expr b = if %weq (fst b) #2 then xno x-r-erased else if %weq (fst b) #6 then xs (snd (snd b)) else xs (snd b)
wop-text k = if %weq k #0 then x-eq else if %weq k #1 then x-ltop else if %weq k #2 then x-plus else x-minus
-- an application spine: a type argument (a data type, a word type, a universe, a template type
-- variable) becomes a template argument of the head; the rest are call arguments; a λ head is
-- applied as a parenthesized lambda; a hypothesis head is the recursive call
spine env want f args =
  case f of
    capp g a → spine env want g (lcons a args)
    cglob n → global-call env n args
    cforce t → (case t of cvar n → (let b = env-at env n in if %weq (fst b) #5 then apply-one env (xcat3 (xs x-lp) (xs (snd b)) (xs x-rp)) args else xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil))))))); _ → xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil)))))))
    cvar n → apply-one env (cxx-expr env none f) args
    cfst p → ops-call env f args
    csnd p → ops-call env f args
    _ → apply-one env (xcat3 (xs x-lp) (cxx-expr env none f) (xs x-rp)) args
-- a function value takes its arguments one at a time (λs are curried); a definition takes the
-- arguments its parameters name at once — type and build-time ones as template arguments, erased
-- ones dropped — and what is left one at a time
apply-one env h args = case args of lnil → h; lcons a r → apply-one env (xcat3 h (xs x-lp) (xcat2 (cxx-expr env none a) (xs x-rp))) r
global-call env n args =
  let ks = g-kinds env n
  in apply-one env (call-expr (xs (x-gname-g env n)) (targs-by env ks args) (args-by env ks args)) (drop-n (lst-len ks) args)
call-expr h targs args = xcat3 h (if lst-empty targs then xs lnil else xcat3 (xs x-lt) (join-x targs) (xs x-gt)) (xcat3 (xs x-lp) (join-x args) (xs x-rp))
drop-n n l = if %weq n #0 then l else (case l of lnil → lnil; lcons x r → drop-n (%wsub n #1) r)
targs-by env ks args = case ks of lnil → lnil; lcons k r → (case args of lnil → lnil; lcons a ar → if %weq k #1 then lcons (cxx-type env a) (targs-by env r ar) else if %weq k #3 then lcons (cxx-expr env none a) (targs-by env r ar) else targs-by env r ar)
args-by env ks args = case ks of lnil → lnil; lcons k r → (case args of lnil → lnil; lcons a ar → if %weq k #0 then lcons (cxx-expr env none a) (args-by env r ar) else args-by env r ar)
env-none = env-of lnil
-- the parameter kinds of a definition, from its type and usages (as split-def assigns them)
g-kinds env n = case quote-ty (%gty n) of some T → kinds-of env n #0 T; none → lnil
kinds-of env n i T =
  case T of
    cpi m A B → lcons (case A of cuniv l → #1; _ → if %weq (%gusage n i) #0 then #2 else if %weq (stage-of (fst (snd env)) i) #1 then #3 else #0) (kinds-of env n (%wsucc i) B)
    _ → lnil
lst-empty l = case l of lnil → true; _ → false
join-x l = case l of lnil → xs lnil; lcons a r → (case r of lnil → a; _ → xcat3 a (xs x-comma) (join-x r))
is-type-code env c =
  case c of
    cdata d ps → true
    cword → true
    cpty k n → true
    cuniv l → true
    csigma A B → true
    cpi m A B → true
    cvar n → %weq (fst (env-at env n)) #1
    _ → false
type-args env args = case args of lnil → lnil; lcons a r → if is-type-code env a then lcons (cxx-type env a) (type-args env r) else type-args env r
term-args env args = case args of lnil → lnil; lcons a r → if is-type-code env a then term-args env r else lcons (cxx-expr env none a) (term-args env r)
-- a constructor: D{D_c{fields}}, a recursive field wrapped in make_shared
con-expr env want d k fs =
  let ks = cshape d k
      n = d-arity d
  in if andb (is-rep d) (notb (dform-has env d)) then (if %weq n #0 then xcat3 (xs (lapp (x-dname d) x-of)) (xcat5 (xs (lapp (x-dname d) x-vsuf)) (xs x-lb) (xcat3 (xs (x-cname d k)) (xs x-lb) (fields-expr env d ks fs)) (xs x-rb) (xs x-rb)) (xs x-rp) else xno x-r-params)
     else if %weq n #0 then xcat5 (xs (rep-name env d)) (xs x-lb) (xcat3 (xs (x-cname d k)) (xs x-lb) (fields-expr env d ks fs)) (xs x-rb) (xs x-rb)
     else con-expr-p env want d k fs n
-- a constructor of a parameterized type: D<args>{D_c<args>{fields}}, the arguments those of the
-- expected type (a constructor alone does not say them); each field expected at its type
-- instantiated, a recursive one wrapped in make_shared
con-expr-p env want d k fs n =
  case want of
    some T → (case T of
                cdata d2 ps → (let ta = xcat3 (xs x-lt) (join-x (tys-x env ps)) (xs x-gt)
                               in xcat5 (xcat2 (xs (x-dname d)) ta) (xs x-lb) (xcat3 (xcat2 (xs (x-cname d k)) ta) (xs x-lb) (fields-p env d n ps ta (ctor-tycodes-of d k) fs #0)) (xs x-rb) (xs x-rb))
                _ → xno x-r-con-ty)
    none → xno x-r-con-ty
fields-p env d n ps ta tys fs j =
  case fs of
    lnil → xs lnil
    lcons f r →
      let tc = (case tys of lcons t tr → t; lnil → none)
          e = (if is-rec-code d tc then xcat5 (xs (cat3 x-make-shared (x-dname d) lnil)) ta (xs (lapp x-gt x-lp)) (cxx-expr env (some (cdata d ps)) f) (xs x-rp) else cxx-expr env (inst-ty n ps j tc) f)
      in (case r of lnil → e; _ → xcat3 e (xs x-comma) (fields-p env d n ps ta (ltail-x tys) r (%wsucc j)))
is-rec-code d tc = case tc of some c → (case c of cdata d2 ps → %weq d d2; _ → false); none → false
-- a field's type code (over the parameters, then the preceding fields) at the type arguments:
-- the i-th parameter is variable n-1-i past the j preceding fields
inst-ty n ps j tc = case tc of some c → inst-c n ps j c; none → none
inst-c n ps j c =
  case c of
    cvar k → if %wlt k j then none else lnth ps (%wsub (%wsub n #1) (%wsub k j))
    cdata d2 ps2 → omap (cdata d2) (inst-codes n ps j ps2)
    cword → some c
    cpty k m → some c
    _ → none
inst-codes n ps j cs = case cs of lnil → some lnil; lcons c r → (case inst-c n ps j c of some c2 → omap (lcons c2) (inst-codes n ps j r); none → none)
fields-expr env d ks fs =
  case fs of
    lnil → xs lnil
    lcons f r →
      let k = (case ks of lcons kk kr → fst kk; lnil → #3)
          e = if %weq k #1 then xcat3 (xs (cat3 x-make-shared (data-self env d) x-gt)) (xcat3 (xs x-lp) (cxx-expr env none f) (xs (if andb (is-rep d) (notb (dform-has env d)) then x-data-call else x-rp))) (xs lnil) else cxx-expr env none f
      in (case r of lnil → e; _ → xcat3 e (xs x-comma) (fields-expr env d (ltail-x ks) r))
ltail-x l = case l of lnil → lnil; lcons x r → r
-- a case on a data type: cub::fix([&](auto &self, const D &x) { return std::visit(overloaded{ … }, x.v); })(x);
-- each alternative a lambda on const D_c &k, its fields k.f<j> (a recursive one *k.f<j>), its
-- hypotheses the recursive call self; the result type from the motive or the expected type
case-expr env want d P B x =
  let rt = (case P of some m → (case m of clam T → cxx-type (push-b b-erased env) T; _ → xno x-r-dep); none → (case want of some T → cxx-type env T; none → xs x-auto))
      n = d-arity d
      dn = if is-rep d then lapp (x-dname d) x-vsuf else x-dname d
      scr = if andb (is-rep d) (notb (dform-has env d)) then xcat3 (xs (lapp x-lp x-lp)) (cxx-expr env none x) (xs x-data-call) else xcat3 (xs x-lp) (cxx-expr env none x) (xs x-rp)
  in xcat7 (xs x-fix) (xs (if %weq n #0 then dn else x-auto)) (xcat3 (xs x-fix-end) rt (xs (lapp x-sp (lapp x-lb (lapp x-sp x-ret))))) (xcat4 (xs x-visit) (alts-expr env rt d B #0) (xs x-visit-end) (xs (lapp x-x x-dot-v))) (xs (lapp x-rp x-fix-close)) scr (xs lnil)
alts-expr env rt d B c =
  case B of
    lnil → xs lnil
    lcons b r →
      let ks = cshape d c
          hs = rec-fields ks #0
          n = lst-count ks
          env2 = push-hyps hs (push-fields d c ks #0 env)
          body = strip-n (%wadd n (lst-count hs)) b
          n = d-arity d
          alt = xcat7 (xs (if %weq n #0 then x-case else cat3 x-lam-amp (tpl-params-q n) x-lam-const)) (xs (if %weq n #0 then x-cname d c else lapp (x-cname d c) (targs-text-q n))) (xs x-case-arg) (xs x-lamr) (ret-cast rt (cxx-expr env2 none body)) (xs x-lamend) (xs lnil)
      in (case r of lnil → alt; _ → xcat3 alt (xs x-comma) (alts-expr env rt d r (%wsucc c)))
-- every alternative returns the one result type: a static_cast where it is known
ret-cast rt e = if %weq (fst rt) #0 then (let t = snd rt in if lst-eq t x-auto then e else xcat5 (xs (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #95 (lcons #99 (lcons #97 (lcons #115 (lcons #116 (lcons #60 lnil))))))))))))) (xs t) (xs (lcons #62 (lcons #40 lnil))) e (xs x-rp)) else rt
push-fields d c ks j env = case ks of lnil → env; lcons k r → push-fields d c r (%wsucc j) (push-b (b-field (if %weq (fst k) #1 then rec-field-text env d j else lapp x-k (lapp (lcons #46 lnil) (x-fname j)))) env)
-- a recursive field: the data form's *k.f<j>, a value of the represented type through its class
rec-field-text env d j = let t = cat3 x-star (lapp x-k x-f) (dec j) in if andb (is-rep d) (notb (dform-has env d)) then cat3 (lapp (x-dname d) x-of) t x-rp else t
push-hyps hs env = case hs of lnil → env; lcons j r → push-hyps r (push-b (b-hyp (cat4 x-self x-star (lapp x-k x-f) (lapp (dec j) x-rp))) env)
lst-eq a b = case a of lnil → (case b of lnil → true; _ → false); lcons x r → (case b of lcons y s → andb (%weq x y) (lst-eq r s); lnil → false)
bool-case env want B x =
  case B of
    lcons t r → (case r of lcons f r2 → xcat7 (xs x-lp) (cxx-expr env none x) (xs x-q) (cxx-expr env want (strip-n #0 t)) (xs x-colon) (cxx-expr env want (strip-n #0 f)) (xs x-rp); _ → xno x-r-dep)
    _ → xno x-r-dep
-- the primitive operations (code.cub's numbering): arithmetic as operators on the fixed-width
-- types, conversions as casts, the byte layer as cub's helpers (the bound an assume inside)
prim-expr env k as =
  let es = term-args-all env as
  in if %wlt k #512 then (let sb = %wsub k #256 in xcat3 (xs (conv-text sb)) (arg-n es #0) (xs x-rp))
     else if %wlt k #768 then (let sb = %wsub k #512 in xcat5 (xs x-lp) (arg-n es #0) (xs (bin-text sb)) (arg-n es #1) (xs x-rp))
     else if %wlt k #1024 then xcat5 (xs (lapp x-load (dec (wmul8 (%wsub k #768))))) (xs x-lp) (arg-n es #0) (xcat2 (xs x-comma) (arg-n es #1)) (xs x-rp)
     else if %wlt k #1280 then xcat7 (xs (lapp x-store (dec (wmul8 (%wsub k #1024))))) (xs x-lp) (arg-n es #0) (xcat2 (xs x-comma) (arg-n es #1)) (xs x-comma) (arg-n es #2) (xs x-rp)
     else if %wlt k #1536 then xcat3 (xs x-blen) (arg-n es #0) (xs x-rp)
     else xcat3 (xs x-mkbytes) (case cl-at as #0 of cwlit n → xs (dec n); _ → xno x-r-dep) (xs x-mkbytes-end)
wmul8 w = let w2 = %wadd w w in let w4 = %wadd w2 w2 in %wadd w4 w4
term-args-all env as = case as of lnil → lnil; lcons a r → lcons (prim-arg env a) (term-args-all env r)
-- a primitive's argument: a Nat numeral is the word it stands for (the helpers take words)
prim-arg env a = case (if nat-rep then nat-code a else none) of some n → xs (cat3 x-ulit (dec n) x-rp); none → cxx-expr env none a
arg-n es n = case es of lnil → xno x-r-dep; lcons e r → if %weq n #0 then e else arg-n r (%wsub n #1)
conv-text sb = if %weq sb #16 then x-i64c else if %weq sb #17 then x-u64c else if %weq sb #18 then x-u32c else if %weq sb #19 then x-u64c else if %weq sb #20 then x-f64c else if %weq sb #21 then x-f64c else x-i64c
bin-text sb = let op = (if %wlt sb #5 then sb else if %wlt sb #10 then %wsub sb #5 else %wsub sb #10)
              in if %weq op #0 then x-plus else if %weq op #1 then x-minus else if %weq op #2 then x-times else if %weq op #3 then (if %weq sb #13 then x-slash else x-eq) else if %weq op #4 then (if %weq sb #14 then x-eq else x-ltop) else x-ltop
-- ---------------------------------------------------------------- definitions
-- the Π chain of the type against the λs of the value: the parameters with their kinds, the
-- environment for the body, the body and its result type. stages: a Lst of (index , Stage) naming
-- the binders at `build` (st-build) — non-type template parameters; the rest by their types and
-- usages (%gusage g i: 0 erased)
-- (the template parameters, (the parameters, (the body's environment, (the body, (its type, (the
-- concepts the parameters need, (the specialization's type arguments left, the template
-- parameters as (declaration , name)))))))); fix: type codes for the type parameters, in order
-- (a specialization, 18.15), each replacing its template parameter by the type
split-def names g stages T v = split-at g (x-gname names g) stages lnil #0 lnil lnil (env-with names stages) T v lnil lnil
split-at g gn stages fix i tps ps env T v cps tns =
  case T of
    cpi m A B →
      (case v of
         clam b →
           let st = stage-of stages i
               kind = (case A of cuniv l → #1; _ → if %weq (%gusage g i) #0 then #2 else if %weq st #1 then #3 else if is-ops A then #6 else #0)
               nm = if orb (%weq kind #1) (%weq kind #3) then x-pname i else x-vname i
           in if %weq kind #1 then
                (case fix of
                   lcons fc fr → split-at g gn stages fr (%wsucc i) tps ps (push-b (b-type (fromx (cxx-type env fc))) env) B b cps tns
                   lnil → split-at g gn stages lnil (%wsucc i) (lapp tps (lcons (xs (lapp x-class nm)) lnil)) ps (push-b (b-type nm) env) B b cps (lapp tns (lcons (lapp x-class nm , nm) lnil)))
              else if %weq kind #3 then
                (let td = xcat2 (cxx-type env A) (xs (lapp x-sp nm)) in split-at g gn stages fix (%wsucc i) (lapp tps (lcons td lnil)) ps (push-b (b-const nm) env) B b cps (lapp tns (lcons (fromx td , nm) lnil)))
              else if %weq kind #2 then split-at g gn stages fix (%wsucc i) tps ps (push-b b-erased env) B b cps tns
              else if %weq kind #6 then
                (let cn = cat3 gn x-kname (dec i)
                     cv = lapp (lcons #67 lnil) (dec i)
                     comps = ops-comps A #0
                     ct = concept-text env cn tns comps
                 in split-at g gn stages fix (%wsucc i) (lapp tps (lcons (xs (cat4 cn (targs-of tns) x-sp cv)) lnil)) (lapp ps (lcons (xs (cat4 x-const-sp cv x-sp-amp nm)) lnil)) (push-b (b-ops (comp-arities comps) nm) env) B b (lapp cps (lcons ct lnil)) (lapp tns (lcons (lapp x-class cv , cv) lnil)))
              else split-at g gn stages fix (%wsucc i) tps (lapp ps (lcons (xcat2 (cxx-type env A) (xs (lapp x-sp nm))) lnil)) (push-b (b-run nm) env) B b cps tns
         _ → (tps , (ps , (env , (v , (T , (cps , (fix , tns))))))))
    _ → (tps , (ps , (env , (v , (T , (cps , (fix , tns)))))))
stage-of stages i = case stages of lnil → #0; lcons s r → if %weq (fst s) i then (case snd s of st-build → #1; _ → #0) else stage-of r i
-- image-fn names g stages T v: the C++ entity, or the reason
image-fn names g stages T v = image-fn-m lnil names g stages T v
-- ds: the data types this definition sees in their data form (a representation's conversions)
image-fn-m ds names g stages T v =
  let gn = x-gname names g
      sp = split-at g gn stages lnil #0 lnil lnil (env-dform (env-with names stages) ds) T v lnil lnil
      tps = fst sp
      ps = fst (snd sp)
      env = fst (snd (snd sp))
      body = fst (snd (snd (snd sp)))
      ret = fst (snd (snd (snd (snd sp))))
      cps = fst (snd (snd (snd (snd (snd sp)))))
      tns = snd (snd (snd (snd (snd (snd (snd sp))))))
      reg = andb (notb (lst-empty tns)) (lall-x (λ t → lst-prefix x-class (fst t)) tns)
      head = xcat4 (xconcat cps) (if reg then xs (reg-decl gn g tns) else xs lnil) (if lst-empty tps then xs lnil else xcat3 (xs x-template) (join-x tps) (xs (lapp x-gt x-nl))) (xcat2 (cxx-type env ret) (xs (lapp x-sp (lapp gn x-lp))))
  in xcat4 head (join-x ps) (xs (if reg then cat3 x-body-open (reg-use gn tns) x-ret else x-body)) (xcat2 (cxx-expr env (some ret) body) (xs x-end))
-- image-def names stages g: (bytes , report) for a checked definition
image-def names stages g = image-def-m lnil names stages g
image-def-m ds names stages g =
  case quote-ty (%gty g) of
    none → (lnil , x-r-type)
    some T →
      (case def-src g of
         none → (lnil , x-r-value)
         some v → (let r = (if is-ops T then image-inst names g T v else image-fn-m ds names g stages T v) in if %weq (fst r) #0 then (snd r , x-exported) else (lnil , lapp x-not-exportable (snd r))))
-- the code the image translates: a copattern definition's body as written (its value is its stuck
-- head), any other definition's value
def-src g = case %gcode g of some c → (if is-codef c then some c else unfold g); none → unfold g
is-codef c = case c of clam b → is-codef b; crec d fs → true; _ → false
-- ---------------------------------------------------------------- data types
-- struct D_c0 { … }; struct D_c1 { uint64_t f0; std::shared_ptr<D> f1; }; struct D { std::variant<D_c0, D_c1> v; };
image-data d = image-data-n lnil d
image-data-n names d =
  if is-codata d then image-codata d
  else if lany-x tel-has-dims (ctors-at d lnil) then xno x-r-hit
  else (case %dent d of
          dent tel l → (case tel of
                          tz e → image-data-e (env-dform (env-of names) (if is-rep d then lcons d lnil else lnil)) d
                          _ → image-data-p d tel)
          _ → xno x-r-params)
image-data-e env d = let dn = rep-name env d in xcat4 (xs (cat3 x-struct dn x-fwd)) (ctor-structs-e env d (nctors d) #0) (xcat3 (xs (cat3 x-struct-a dn (lapp x-sp (lapp x-lb (lapp x-sp x-variant))))) (join-x (ctor-names d (nctors d) #0)) (xs x-vdecl)) (if is-rep d then rep-class d else xs lnil)
lany-x p l = case l of lnil → false; lcons x r → (case p x of true → true; false → lany-x p r)
-- ---- parameterized data types (18.9): a type parameter is a template parameter of the structs
-- template<class P0> struct D; template<class P0> struct D_c1 { P0 f0; std::shared_ptr<D<P0>> f1; };
-- template<class P0> struct D { std::variant<D_c0<P0>, D_c1<P0>> v; };
-- A parameter at a value (an index, a length) is outside the fragment.
image-data-p d tel =
  case d-params tel lnil #0 of
    none → xno x-r-params
    some p →
      (let n = fst p
           bs = fst (snd p)
           tels = snd (snd p)
           hd = tpl-head n
       in xcat3 (xs (cat4 hd x-struct (x-dname d) x-fwd)) (ctor-structs-p d n bs tels #0)
                (xcat3 (xs (cat4 hd x-struct-a (x-dname d) (lapp x-sp (lapp x-lb (lapp x-sp x-variant))))) (join-x (ctor-names-p d n (lst-len tels) #0)) (xs x-vdecl)))
-- the parameters of a data type's telescope: some (count , the quoting binders , the constructor
-- telescopes) when every parameter is a type; none otherwise
d-params tel bs n =
  case tel of
    tx A nm r → (let Av = tval A in (case %view Av of wu l → (let x = %var nm Av in d-params (r x Av) (lcons (qv (var-level x)) bs) (%wsucc n)); _ → none))
    tz e → some (n , (bs , e))
    _ → none
d-arity d = case %dent d of dent tel l → (case d-params tel lnil #0 of some p → fst p; none → #0); _ → #0
-- the field types of a constructor telescope as codes over the parameters (then the preceding fields)
ctor-tycodes bs tel = case tel of tx A nm r → (let Av = tval A in let x = %var nm Av in lcons (qty bs Av) (ctor-tycodes (lcons (qv (var-level x)) bs) (r x Av))); _ → lnil
ctor-tycodes-of d k = case %dent d of dent tel l → (case d-params tel lnil #0 of some p → ctor-tycodes (fst (snd p)) (fromopt (lnth (snd (snd p)) k) (tz (tsys lnil []))); none → lnil); _ → lnil
ctor-names-p d n m c = if %weq c m then lnil else lcons (xs (lapp (x-cname d c) (targs-text n))) (ctor-names-p d n m (%wsucc c))
ctor-structs-p d n bs tels c =
  case tels of
    lnil → xs lnil
    lcons tel r → xcat2 (xcat3 (xs (cat4 (tpl-head n) x-struct-a (x-cname d c) (lapp x-sp x-lb))) (ctor-fields-p d n (penv n) (ctor-tycodes bs tel) #0) (xs (lapp x-sp (lapp x-rb (lapp x-semi x-nl))))) (ctor-structs-p d n bs r (%wsucc c))
ctor-fields-p d n env tys j = case tys of lnil → xs lnil; lcons t r → xcat3 (xcat3 (xs x-sp) (fty-x env d n t) (xs (lapp x-sp (x-fname j)))) (xs x-semi) (ctor-fields-p d n (push-b b-erased env) r (%wsucc j))
fty-x env d n t = if is-rec-code d t then xs (cat3 x-shared (lapp (x-dname d) (targs-text n)) x-gt) else (case t of some tc → cxx-type env tc; none → xno x-r-ftype)
-- the environment of the parameters as template type parameters P0 … (P0 outermost)
penv n = penv-at (env-of lnil) n #0
penv-at env n i = if %weq i n then env else penv-at (push-b (b-type (x-pname i)) env) n (%wsucc i)
-- template<class P0, class P1> ␣ and <P0, P1>
tpl-head n = cat3 x-template (join-b (pnames n #0 true)) (lapp x-gt x-sp)
tpl-params-q n = cat3 x-lt (join-b (qnames n #0 true)) x-gt
targs-text n = cat3 x-lt (join-b (pnames n #0 false)) x-gt
targs-text-q n = cat3 x-lt (join-b (qnames n #0 false)) x-gt
pnames n i cl = if %weq i n then lnil else lcons (if cl then lapp x-class (x-pname i) else x-pname i) (pnames n (%wsucc i) cl)
-- a case's alternatives are template lambdas over the scrutinee's arguments Q0 … (a name of their
-- own: a template lambda inside a template function may not redeclare its parameters)
qnames n i cl = if %weq i n then lnil else lcons (if cl then lapp x-class (x-qname i) else x-qname i) (qnames n (%wsucc i) cl)
x-qname i = lapp (lcons #81 lnil) (dec i)
join-b l = case l of lnil → lnil; lcons a r → (case r of lnil → a; _ → cat3 a x-comma (join-b r))
tys-x env ps = case ps of lnil → lnil; lcons a r → lcons (cxx-type env a) (tys-x env r)
ctor-names d n c = if %weq c n then lnil else lcons (xs (x-cname d c)) (ctor-names d n (%wsucc c))
ctor-structs d n c = if %weq c n then xs lnil else xcat2 (xcat3 (xs (cat3 x-struct-a (x-cname d c) (lapp x-sp x-lb))) (ctor-fields d (cshape d c) #0) (xs (lapp x-sp (lapp x-rb (lapp x-semi x-nl))))) (ctor-structs d n (%wsucc c))
ctor-fields d ks j =
  case ks of
    lnil → xs lnil
    lcons k r →
      let ty = (if %weq (fst k) #0 then xs x-u64 else if %weq (fst k) #1 then xs (cat3 x-shared (x-dname d) x-gt) else if %weq (fst k) #2 then xs (x-dname (snd k)) else xno x-r-ftype)
      in xcat3 (xcat3 (xs x-sp) ty (xs (lapp x-sp (x-fname j)))) (xs x-semi) (ctor-fields d r (%wsucc j))
-- ---------------------------------------------------------------- the header
-- the data types a list of codes mentions, in order of first mention
datas-of cs acc = case cs of lnil → acc; lcons c r → datas-of r (datas-in c acc)
datas-in c acc =
  case c of
    cdata d ps → add-d d acc
    ccon d k fs ds → datas-list fs (add-d d acc)
    ccase d B x → datas-list B (datas-in x (add-d d acc))
    celim d P B x → datas-list B (datas-in x (add-d d acc))
    clam b → datas-in b acc
    capp f a → datas-in a (datas-in f acc)
    cpair a b → datas-in b (datas-in a acc)
    cfst p → datas-in p acc
    csnd p → datas-in p acc
    clet t b → datas-in b (datas-in t acc)
    cann t T → datas-in T (datas-in t acc)
    cpi m A B → datas-in B (datas-in A acc)
    csigma A B → datas-in B (datas-in A acc)
    cwsucc a → datas-in a acc
    cwop k a b → datas-in b (datas-in a acc)
    cwelim w z s → datas-in s (datas-in z (datas-in w acc))
    cprim k as → datas-list as acc
    cforce t → datas-in t acc
    cthunk t → datas-in t acc
    crec d fs → datas-list fs (add-d d acc)
    cproj d k x → datas-in x (add-d d acc)
    _ → acc
datas-list l acc = case l of lnil → acc; lcons x r → datas-list r (datas-in x acc)
add-d d acc = if %weq d bool-idx then acc else if lmem-w d acc then acc else lapp acc (lcons d lnil)
-- cxx-image names stages gs: the header for the checked definitions gs (in order) with the data types
-- they mention, and the report, a Lst of (g , report bytes): (header , reports)
codes-of gs = case gs of lnil → lnil; lcons g r → (case def-src g of some v → (case quote-ty (%gty g) of some T → lcons v (lcons T (codes-of r)); none → codes-of r); none → codes-of r)
datas-text ds = case ds of lnil → lnil; lcons d r → (let x = image-data d in if %weq (fst x) #0 then lapp (snd x) (datas-text r) else datas-text r)
defs-text names stages gs =
  case gs of
    lnil → (lnil , lnil)
    lcons g r → (let d = image-def names stages g in let rest = defs-text names stages r in (lapp (fst d) (fst rest) , lcons (g , snd d) (snd rest)))
-- the full report as text: one line per definition
report-text names reps = case reps of lnil → lnil; lcons rp r → cat4 (x-gname names (fst rp)) (lcons #58 (lcons #32 lnil)) (snd rp) (lapp x-nl (report-text names r))
-- ---------------------------------------------------------------- represented types (B12's class)
-- A data type with a declared representation is a class wrapping its representation: `r`, with
-- from (the representation to the class) and to (back) the identity on the representation, as the
-- image computes over representations. Its constructors and cases go through its data form, the
-- structs D<d>_v and D<d>_c<k>, by the representation's own conversions (%rops: to from the data
-- form, from back), exported with it and translated seeing the type as its data form: a
-- constructor is D<d>::of(D<d>_v{…}), a case visits (x).data(), a recursive field read in a branch
-- is D<d>::of(*k.f<j>) — what has no op line is correct and slow (B12 §6).
is-rep d = case %rtab d of some R → true; none → false
rep-name env d = if dform-has env d then lapp (x-dname d) x-vsuf else x-dname d
data-self env d = rep-name env d
rep-class d =
  case %rtab d of
    some R → (case quote-ty R of
                some RC → xbind (cxx-type (env-of lnil) RC) (λ r → let D = x-dname d in xs (lconcat (lcons x-struct-a (lcons D (lcons x-cls-a (lcons r (lcons x-cls-b (lcons D (lcons x-cls-c (lcons r (lcons x-cls-d (lcons D (lcons x-cls-e (lcons r (lcons x-cls-f (lcons D (lcons x-cls-g (lcons D (lcons x-cls-h (lcons D (lcons x-cls-i lnil)))))))))))))))))))))
                none → xno x-r-type)
    none → xs lnil
rep-tail names d =
  case rep-entry d of
    some t → (let D = x-dname d in lconcat (lcons x-tail-a (lcons D (lcons x-sp (lcons D (lcons x-tail-b (lcons D (lcons x-tail-c (lcons D (lcons x-lb (lcons (x-gname names (fst t)) (lcons x-tail-d (lcons D (lcons x-tail-e (lcons D (lcons x-tail-f (lcons (x-gname names (fst (snd t))) (lcons x-tail-g lnil))))))))))))))))))
    none → lnil
-- the data type's structs: field types from the constructor telescope (a word, a primitive, a data
-- type, the type itself through a shared_ptr to its data form when represented)
ctor-structs-e env d n c = if %weq c n then xs lnil else xcat2 (xcat3 (xs (cat3 x-struct-a (x-cname d c) (lapp x-sp x-lb))) (ctor-fields-t env d (ctor-tycodes-of d c) #0) (xs (lapp x-sp (lapp x-rb (lapp x-semi x-nl))))) (ctor-structs-e env d n (%wsucc c))
ctor-fields-t env d tys j = case tys of lnil → xs lnil; lcons t r → xcat3 (xcat3 (xs x-sp) (fty-d env d t) (xs (lapp x-sp (x-fname j)))) (xs x-semi) (ctor-fields-t (push-b b-erased env) d r (%wsucc j))
fty-d env d t = if is-rec-code d t then xs (cat3 x-shared (data-self env d) x-gt) else (case t of some tc → cxx-type env tc; none → xno x-r-ftype)
-- the C++ name of a type argument a consumer instantiated a template at (cub::tyarg)
tya-text d = lconcat (lcons x-tya-a (lcons (x-dname d) (lcons x-tya-b (lcons (dec d) (lcons x-tya-c lnil)))))
-- ---------------------------------------------------------------- codata as classes
-- a codata type (no parameters, no field depending on another): a class with one lazily computed
-- cell per field (cub::lazy behind a shared_ptr: computed at the first observation, then kept) and
-- the observations as member functions D<d>_o<k>(); a copattern definition's record is
-- D<d>{cub::delay<T>([=]() { return e; }), …}, a projection (x).D<d>_o<k>()
image-codata d = case %dent d of dcoent tel l → (case tel of tz fe → codata-struct d (cofield-codes lnil fe); _ → xno x-r-params); _ → xno x-r-params
cofield-codes bs tel = case tel of tx A nm r → (let Av = tval A in let x = %var nm Av in lcons (qty bs Av) (cofield-codes (lcons (qv (var-level x)) bs) (r x Av))); _ → lnil
codata-struct d tys = xcat4 (xs (cat3 x-struct (x-dname d) x-fwd)) (xs (cat3 x-struct-a (x-dname d) (lapp x-sp x-lb))) (xcat2 (co-members (env-of lnil) tys #0) (co-getters d (env-of lnil) tys #0)) (xs x-cstruct-end)
co-members env tys j = case tys of lnil → xs lnil; lcons t r → xcat4 (xs x-co-ptr) (co-fty env t) (xs (cat3 x-co-ptr-end (dec j) x-semi)) (co-members (push-b b-erased env) r (%wsucc j))
co-getters d env tys j = case tys of lnil → xs lnil; lcons t r → xcat5 (xs x-sp) (co-fty env t) (xs (cat3 x-sp (x-oname d j) x-co-get-mid)) (xs (cat3 (dec j) x-co-get-end lnil)) (co-getters d (push-b b-erased env) r (%wsucc j))
co-fty env t = case t of some tc → cxx-type env tc; none → xno x-r-ftype
x-oname d k = cat3 (x-dname d) x-oname-mid (dec k)
codata-rec env d fs = (case %dent d of dcoent tel l → (case tel of tz fe → xcat4 (xs (x-dname d)) (xs x-lb) (co-fields env (env-of lnil) (cofield-codes lnil fe) fs) (xs x-rb); _ → xno x-r-params); _ → xno x-r-params)
co-fields env tenv tys fs = case fs of lnil → xs lnil; lcons f r → (let e = xcat5 (xs x-delay) (co-fty tenv (hd-opt tys)) (xs x-delay-lam) (cxx-expr env none f) (xs x-delay-end) in case r of lnil → e; _ → xcat3 e (xs x-comma) (co-fields env (push-b b-erased tenv) (ltail-x tys) r))
hd-opt tys = case tys of lcons t r → t; lnil → none
-- ---------------------------------------------------------------- records of operations as concepts
-- A record (a Σ, non-dependent) with an operation among its components, taken as a parameter, is a
-- template parameter C<i> constrained by a concept generated from the components' signatures:
-- template<class C, P…> concept g_k<i> = requires(const C &c) { { c.f0(std::declval<A>()…) } ->
-- std::convertible_to<R>; { c.f1_ } -> std::convertible_to<T>; }; (the last component is f<n-1>_,
-- the others f<j>: the Σ's projections fst (snd^j r) and snd^(n-1) r). An operation is called with
-- all its arguments at once. An instance (a checked definition whose type is such a record) is a
-- struct satisfying it, its operations member functions and the rest data members, and an object
-- of it the consumer passes: struct [[cub::instance]] g_t { … }; inline const g_t g{};
is-fn-code c = case c of cpi m A B → true; _ → false
ops-comps A d = case A of csigma X Y → lcons (X , d) (ops-comps Y (%wsucc d)); _ → lcons (A , d) lnil
is-ops A = case A of csigma X Y → lany-x (λ cd → is-fn-code (fst cd)) (ops-comps A #0); _ → false
fn-sig c d = case c of cpi m A B → (let r = fn-sig B (%wsucc d) in (lcons (A , d) (fst r) , snd r)); _ → (lnil , (c , d))
comp-arities comps = case comps of lnil → lnil; lcons cd r → lcons (lst-len (fst (fn-sig (fst cd) (snd cd)))) (comp-arities r)
push-er env n = if %weq n #0 then env else push-er (push-b b-erased env) (%wsub n #1)
targs-of tns = if lst-empty tns then lnil else cat3 x-lt (join-b (lmap (λ t → snd t) tns)) x-gt
concept-text env cn tns comps = xcat3 (xs (lconcat (lcons x-tpl-c (lcons (lconcat (lmap (λ t → lapp x-comma (fst t)) tns)) (lcons x-concept (lcons cn (lcons x-req lnil))))))) (reqs-text env comps #0 (lst-len comps)) (xs x-req-end)
reqs-text env comps j nc = case comps of lnil → xs lnil; lcons cd r → xcat2 (req-text env cd j (%weq j (%wsub nc #1))) (reqs-text env r (%wsucc j) nc)
req-text env cd j last =
  let c = fst cd
      d = snd cd
      sig = fn-sig c d
      mem = xs (cat3 x-req-open (dec j) (if last then (lcons #95 lnil) else lnil))
  in if is-fn-code c then xcat5 mem (xs x-lp) (join-x (lmap (λ ad → xcat3 (xs x-declval) (cxx-type (push-er env (snd ad)) (fst ad)) (xs x-declval-end)) (fst sig))) (xs x-req-call-close) (xcat2 (cxx-type (push-er env (snd (snd sig))) (fst (snd sig))) (xs x-req-end1))
     else xcat4 mem (xs x-req-data-close) (cxx-type (push-er env d) c) (xs x-req-end1)
-- a projection of a record parameter: its member's text
ops-path c j = case c of csnd p → ops-path p (%wsucc j); cvar n → some (n , j); _ → none
ops-mem env c =
  case c of
    cfst p → (case ops-path p #0 of some nj → ops-text env (fst nj) (snd nj) false; none → none)
    csnd p → (case ops-path c #0 of some nj → ops-text env (fst nj) (snd nj) true; none → none)
    _ → none
ops-text env n j last =
  let b = env-at env n
  in if %weq (fst b) #6 then (let nc = lst-len (fst (snd b)) in if (if last then %weq j (%wsub nc #1) else %wlt j (%wsub nc #1)) then some (cat4 (snd (snd b)) (lcons #46 (lcons #102 lnil)) (dec j) (if last then (lcons #95 lnil) else lnil)) else none) else none
ops-arity env c =
  case c of
    cfst p → (case ops-path p #0 of some nj → ops-ar env (fst nj) (snd nj); none → #0)
    csnd p → (case ops-path c #0 of some nj → ops-ar env (fst nj) (snd nj); none → #0)
    _ → #0
ops-ar env n j = let b = env-at env n in if %weq (fst b) #6 then fromopt (lnth (fst (snd b)) j) #0 else #0
ops-call env f args =
  case ops-mem env f of
    some t → (let m = ops-arity env f in if %weq m #0 then apply-one env (xs t) args else if %wlt (lst-len args) m then xno x-r-partial else apply-one env (call-expr (xs t) lnil (lmap (λ a → cxx-expr env none a) (take-n m args))) (drop-n m args))
    none → apply-one env (xcat3 (xs x-lp) (cxx-expr env none f) (xs x-rp)) args
take-n n l = if %weq n #0 then lnil else (case l of lnil → lnil; lcons x r → lcons x (take-n (%wsub n #1) r))
-- an instance: the struct and its object
image-inst names g T v =
  let gn = x-gname names g
      comps = ops-comps T #0
      nc = lst-len comps
      vals = comp-vals v nc
  in if %weq (lst-len vals) nc then xcat4 (xs (cat3 x-inst-head gn x-inst-t)) (inst-members (env-of names) comps vals #0 nc) (xs x-inst-close) (xs (lconcat (lcons x-inline-const (lcons gn (lcons x-inst-t2 (lcons gn (lcons x-inst-obj lnil)))))))
     else xno x-r-inst
comp-vals v k = if %weq k #1 then lcons v lnil else (case v of cpair a b → lcons a (comp-vals b (%wsub k #1)); _ → lnil)
inst-members env comps vals j nc =
  case comps of
    lnil → xs lnil
    lcons cd r → (case vals of lnil → xno x-r-inst; lcons x xr → xcat2 (inst-member env cd x j (%weq j (%wsub nc #1))) (inst-members env r xr (%wsucc j) nc))
inst-member env cd x j last =
  let c = fst cd
      d = snd cd
      sig = fn-sig c d
      m = lst-len (fst sig)
      nm = cat3 x-mem-f (dec j) (if last then (lcons #95 lnil) else lnil)
  in if is-fn-code c then
       (case strip-lams-n m x of
          some b → xcat5 (xs x-sp) (cxx-type (push-er env (snd (snd sig))) (fst (snd sig))) (xs (lapp nm x-lp)) (join-x (inst-params env (fst sig) #0)) (xcat3 (xs x-mem-const) (cxx-expr (push-vars env m #0) none b) (xs x-mem-end))
          none → xno x-r-inst)
     else xcat5 (xs x-sp) (cxx-type (push-er env d) c) (xs (lapp nm x-mem-eq)) (cxx-expr env none x) (xs x-semi)
strip-lams-n m x = if %weq m #0 then some x else (case x of clam b → strip-lams-n (%wsub m #1) b; _ → none)
inst-params env ads q = case ads of lnil → lnil; lcons ad r → lcons (xcat2 (cxx-type (push-er env (snd ad)) (fst ad)) (xs (lapp x-sp (x-vname q)))) (inst-params env r (%wsucc q))
push-vars env m q = if %weq q m then env else push-vars (push-b (b-run (x-vname q)) env) m (%wsucc q)
-- ---------------------------------------------------------------- the consumers' instantiations (18.15)
-- a template whose template parameters are all types registers each instantiation statically
-- (a variable template initialized by cub::note, used in the body); a configuration's recorded
-- instantiations become explicit specializations, the definition translated at those types
reg-decl gn g tns = lconcat (lcons x-template (lcons (join-b (lmap (λ t → fst t) tns)) (lcons x-reg-head (lcons gn (lcons x-reg-mid (lcons (dec g) (lcons x-reg-args (lcons (join-b (lmap (λ t → cat3 x-tyarg (snd t) x-tyarg-end) tns)) (lcons x-reg-end lnil)))))))))
reg-use gn tns = lconcat (lcons x-void (lcons gn (lcons x-reg-use (lcons (join-b (lmap (λ t → snd t) tns)) (lcons x-reg-use-end lnil)))))
image-spec names stages g fix =
  case quote-ty (%gty g) of
    none → xno x-r-type
    some T → (case def-src g of
       none → xno x-r-value
       some v →
         (let gn = x-gname names g
              sp = split-at g gn stages fix #0 lnil lnil (env-with names stages) T v lnil lnil
              tps = fst sp
              ps = fst (snd sp)
              env = fst (snd (snd sp))
              body = fst (snd (snd (snd sp)))
              ret = fst (snd (snd (snd (snd sp))))
              left = fst (snd (snd (snd (snd (snd (snd sp))))))
          in if andb (lst-empty tps) (andb (lst-empty left) (notb (lany-x (λ p → lst-prefix x-auto (snd p)) ps))) then
               xcat5 (xs x-spec) (cxx-type env ret) (xs (lapp x-sp gn)) (xcat3 (xs x-lt) (join-x (lmap (λ c → cxx-type env-none c) fix)) (xs x-gt)) (xcat4 (xs x-lp) (join-x ps) (xs x-body) (xcat2 (cxx-expr env (some ret) body) (xs x-end)))
             else xno x-r-spec))
tyarg-code a = case a of ta-word → cword; ta-i64 → cpty #0 (cwlit #0); ta-u32 → cpty #1 (cwlit #0); ta-f64 → cpty #2 (cwlit #0); ta-bool → cdata bool-idx lnil; ta-data d → cdata d lnil; ta-other → cuniv clzero
tyarg-ok a = case a of ta-other → false; _ → true
tyarg-tag a = case a of ta-word → #0; ta-i64 → #1; ta-u32 → #2; ta-f64 → #3; ta-bool → #4; ta-data d → %wadd #16 d; ta-other → #15
list-to-lst l = case l of nil → lnil; cons x r → lcons x (list-to-lst r)
cfg-platform cfgs = case cfgs of nil → plat-default; cons c r → (case c of config vs ps ro pl → pl)
cfg-insts cfgs = case cfgs of nil → lnil; cons c r → (case c of config vs ps ro pl → lapp (list-to-lst ps) (cfg-insts r))
inst-key i = case i of inst-at g as → (g , lmap tyarg-tag (list-to-lst as))
dedup-insts l acc = case l of lnil → lnil; lcons i r → (let k = inst-key i in if lany-x (λ k2 → andb (%weq (fst k) (fst k2)) (lst-eq (snd k) (snd k2))) acc then dedup-insts r acc else lcons i (dedup-insts r (lcons k acc)))
specs-text names stages gs insts =
  case insts of
    lnil → (lnil , lnil)
    lcons i r → (case i of
                   inst-at g as → (let rest = specs-text names stages gs r
                                in if andb (lmem-w g gs) (lall-x tyarg-ok (list-to-lst as)) then
                                     (let x = image-spec names stages g (lmap tyarg-code (list-to-lst as)) in if %weq (fst x) #0 then (lapp (snd x) (fst rest) , lcons (g , x-specialized) (snd rest)) else (fst rest , lcons (g , lapp x-not-exportable (snd x)) (snd rest)))
                                   else rest))
-- ---------------------------------------------------------------- the header and the module
-- (the data declarations , (the definitions , (the tail: specializations, the represented classes'
-- conversions, the type arguments' names , the report)))
image-parts plat insts names stages gs =
  let codes = codes-of gs
      ds = datas-of codes lnil
      reps = lfilter-x is-rep ds
      allg = lapp gs (conv-globals reps gs)
      decls = datas-text-n names ds
      defs = defs-text-m reps names stages allg
      specs = specs-text names stages gs (dedup-insts insts lnil)
      tail = lapp (fst specs) (lapp (tails-text names reps) (tya-texts names ds))
  in (decls , (fst defs , (tail , lapp (snd defs) (snd specs))))
cxx-image-x plat insts names stages gs = let pp = image-parts plat insts names stages gs in (cat4 (x-preamble plat) (fst pp) (fst (snd pp)) (fst (snd (snd pp))) , snd (snd (snd pp)))
cxx-image names stages gs = cxx-image-x plat-default lnil names stages gs
-- the header specialized against a list of configurations: the first one's platform, every one's
-- recorded instantiations
cxx-image-cfg cfgs names stages gs = cxx-image-x (cfg-platform cfgs) (cfg-insts cfgs) names stages gs
-- the module interface unit: the preamble's includes in the global module fragment, the helpers
-- and the image exported (the tail, specializations and out-of-line members, after the export)
cxx-module mn names stages gs = cxx-module-x plat-default lnil mn names stages gs
cxx-module-x plat insts mn names stages gs =
  let pp = image-parts plat insts names stages gs
  in (lconcat (lcons x-mod-head (lcons x-pre-inc (lcons x-mod-export (lcons mn (lcons x-mod-semi (lcons x-pre-ns (lcons (plat-text plat) (lcons x-pre-rest (lcons x-mod-open (lcons (fst pp) (lcons (fst (snd pp)) (lcons x-mod-close (lcons (fst (snd (snd pp))) lnil))))))))))))) , snd (snd (snd pp)))
datas-text-n names ds = case ds of lnil → lnil; lcons d r → (let x = image-data-n names d in if %weq (fst x) #0 then lapp (snd x) (datas-text-n names r) else datas-text-n names r)
defs-text-m reps names stages gs = case gs of lnil → (lnil , lnil); lcons g r → (let d = image-def-m (conv-dform reps g) names stages g in let rest = defs-text-m reps names stages r in (lapp (fst d) (fst rest) , lcons (g , snd d) (snd rest)))
conv-dform reps g = case reps of lnil → lnil; lcons d r → (case rep-entry d of some t → (if orb (%weq g (fst t)) (%weq g (fst (snd t))) then lcons d lnil else conv-dform r g); none → conv-dform r g)
conv-globals reps gs = case reps of lnil → lnil; lcons d r → (case rep-entry d of some t → (let a = fst t in let b = fst (snd t) in let rest = conv-globals r gs in lapp (if lmem-w a gs then lnil else lcons a lnil) (if orb (lmem-w b gs) (%weq a b) then rest else lcons b rest)); none → conv-globals r gs)
tails-text names reps = case reps of lnil → lnil; lcons d r → lapp (rep-tail names d) (tails-text names r)
tya-texts names ds = case ds of lnil → lnil; lcons d r → lapp (if andb (%weq (d-arity d) #0) (%weq (fst (image-data-n names d)) #0) then tya-text d else lnil) (tya-texts names r)
lfilter-x p l = case l of lnil → lnil; lcons x r → (case p x of true → lcons x (lfilter-x p r); false → lfilter-x p r)
lall-x p l = case l of lnil → true; lcons x r → (case p x of true → lall-x p r; false → false)
lst-prefix p l = case p of lnil → true; lcons x r → (case l of lcons y s → andb (%weq x y) (lst-prefix r s); lnil → false)
lst-has p l = if lst-prefix p l then true else (case l of lnil → false; lcons y s → lst-has p s)
lconcat l = case l of lnil → lnil; lcons a r → lapp a (lconcat r)
xconcat l = case l of lnil → xs lnil; lcons a r → xcat2 a (xconcat r)
-- ---------------------------------------------------------------- readings
fromx r = snd r
-- a word function: its image is one C++ function over uint64_t
add3x : Word → Word → Word
add3x a b = %wadd (%wadd a b) #3
#same fst (image-def lnil lnil (gidx (code add3x))) = (lapp (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #119 (lcons #111 (lcons #114 (lcons #100 (lcons #32 (lcons #103 lnil))))))))))) (lapp (dec (gidx (code add3x))) (lcons #40 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #119 (lcons #111 (lcons #114 (lcons #100 (lcons #32 (lcons #118 (lcons #48 (lcons #44 (lcons #32 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #119 (lcons #111 (lcons #114 (lcons #100 (lcons #32 (lcons #118 (lcons #49 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #40 (lcons #40 (lcons #118 (lcons #48 (lcons #32 (lcons #43 (lcons #32 (lcons #118 (lcons #49 (lcons #41 (lcons #32 (lcons #43 (lcons #32 (lcons #85 (lcons #73 (lcons #78 (lcons #84 (lcons #54 (lcons #52 (lcons #95 (lcons #67 (lcons #40 (lcons #51 (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
#same snd (image-def lnil lnil (gidx (code add3x))) = x-exported
-- a function uniform in a type keeps its template: twice A f a = f (f a)
twicex : (A : Type) → (A → A) → A → A
twicex A f a = f (f a)
#same fst (image-def lnil lnil (gidx (code twicex))) = (lapp (lcons #116 (lcons #101 (lcons #109 (lcons #112 (lcons #108 (lcons #97 (lcons #116 (lcons #101 (lcons #60 (lcons #99 (lcons #108 (lcons #97 (lcons #115 (lcons #115 (lcons #32 (lcons #80 (lcons #48 (lcons #62 (lcons #32 (lcons #105 (lcons #110 (lcons #108 (lcons #105 (lcons #110 (lcons #101 (lcons #32 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #32 (lcons #98 (lcons #111 (lcons #111 (lcons #108 (lcons #32 (lcons #103 lnil)))))))))))))))))))))))))))))))))))))) (lapp (dec (gidx (code twicex))) (lapp (lcons #95 (lcons #114 (lcons #101 (lcons #103 (lcons #32 (lcons #61 (lcons #32 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #110 (lcons #111 (lcons #116 (lcons #101 (lcons #40 lnil))))))))))))))))) (lapp (dec (gidx (code twicex))) (lapp (lcons #44 (lcons #32 (lcons #123 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #116 (lcons #121 (lcons #97 (lcons #114 (lcons #103 (lcons #60 (lcons #80 (lcons #48 (lcons #62 (lcons #58 (lcons #58 (lcons #116 (lcons #101 (lcons #120 (lcons #116 (lcons #40 (lcons #41 (lcons #125 (lcons #41 (lcons #59 (lcons #10 (lcons #116 (lcons #101 (lcons #109 (lcons #112 (lcons #108 (lcons #97 (lcons #116 (lcons #101 (lcons #60 (lcons #99 (lcons #108 (lcons #97 (lcons #115 (lcons #115 (lcons #32 (lcons #80 (lcons #48 (lcons #62 (lcons #10 (lcons #80 (lcons #48 (lcons #32 (lcons #103 lnil)))))))))))))))))))))))))))))))))))))))))))))))))))) (lapp (dec (gidx (code twicex))) (lapp (lcons #40 (lcons #97 (lcons #117 (lcons #116 (lcons #111 (lcons #32 (lcons #118 (lcons #49 (lcons #44 (lcons #32 (lcons #80 (lcons #48 (lcons #32 (lcons #118 (lcons #50 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #40 (lcons #118 (lcons #111 (lcons #105 (lcons #100 (lcons #41 (lcons #103 lnil)))))))))))))))))))))))))) (lapp (dec (gidx (code twicex))) (lcons #95 (lcons #114 (lcons #101 (lcons #103 (lcons #60 (lcons #80 (lcons #48 (lcons #62 (lcons #59 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #118 (lcons #49 (lcons #40 (lcons #118 (lcons #49 (lcons #40 (lcons #118 (lcons #50 (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil)))))))))))))))))))))))))))))))))))))))
-- a proof parameter is absent (usage 0): a bound it carried is a hypothesis the fragment states
-- where the access happens (cub::load64's assume), not here
ld8x : (b : Bytes 32) → le 16 32 → Word
ld8x b h = i64toWord (load64 32 b 8 h)
#same snd (image-def lnil lnil (gidx (code ld8x))) = x-exported
#same fst (image-def lnil lnil (gidx (code ld8x))) = (lapp (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #119 (lcons #111 (lcons #114 (lcons #100 (lcons #32 (lcons #103 lnil))))))))))) (lapp (dec (gidx (code ld8x))) (lcons #40 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #98 (lcons #121 (lcons #116 (lcons #101 (lcons #115 (lcons #60 (lcons #51 (lcons #50 (lcons #62 (lcons #32 (lcons #118 (lcons #48 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #95 (lcons #99 (lcons #97 (lcons #115 (lcons #116 (lcons #60 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #119 (lcons #111 (lcons #114 (lcons #100 (lcons #62 (lcons #40 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #108 (lcons #111 (lcons #97 (lcons #100 (lcons #54 (lcons #52 (lcons #40 (lcons #118 (lcons #48 (lcons #44 (lcons #32 (lcons #85 (lcons #73 (lcons #78 (lcons #84 (lcons #54 (lcons #52 (lcons #95 (lcons #67 (lcons #40 (lcons #56 (lcons #41 (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
-- a data type: one struct per constructor, the variant; a structural recursion: fix and visit
data TLx = tnilx | tconsx (x : Word) (xs : TLx)
tsumx : TLx → Word
tsumx l = case l of tnilx → #0; tconsx x xs → %wadd x (rec xs)
