#same snd (image-def lnil lnil (gidx (code sump))) = x-exported
#same snd (image-def lnil lnil (gidx (code lenp))) = x-exported
#same snd (image-def lnil lnil (gidx (code mk3p))) = x-exported
lst-prefix p l = case p of lnil → true; lcons x r → (case l of lcons y s → andb (%weq x y) (lst-prefix r s); lnil → false)
lst-has p l = if lst-prefix p l then true else (case l of lnil → false; lcons y s → lst-has p s)
-- the parameter of lenp is a template parameter, and the case's alternatives template lambdas
