x-r-univ = (lcons #97 (lcons #32 (lcons #117 (lcons #110 (lcons #105 (lcons #118 (lcons #101 (lcons #114 (lcons #115 (lcons #101 (lcons #32 (lcons #97 (lcons #115 (lcons #32 (lcons #97 (lcons #32 (lcons #118 (lcons #97 (lcons #108 (lcons #117 (lcons #101 lnil)))))))))))))))))))))
x-r-reflect = (lcons #114 (lcons #101 (lcons #102 (lcons #108 (lcons #101 (lcons #99 (lcons #116 (lcons #105 (lcons #111 (lcons #110 lnil))))))))))
x-r-params = (lcons #97 (lcons #32 (lcons #100 (lcons #97 (lcons #116 (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #119 (lcons #105 (lcons #116 (lcons #104 (lcons #32 (lcons #112 (lcons #97 (lcons #114 (lcons #97 (lcons #109 (lcons #101 (lcons #116 (lcons #101 (lcons #114 (lcons #115 lnil)))))))))))))))))))))))))))
x-r-hit = (lcons #97 (lcons #32 (lcons #100 (lcons #97 (lcons #116 (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #119 (lcons #105 (lcons #116 (lcons #104 (lcons #32 (lcons #112 (lcons #97 (lcons #116 (lcons #104 (lcons #32 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #111 (lcons #114 (lcons #115 lnil))))))))))))))))))))))))))))))))))
x-r-ftype = (lcons #97 (lcons #32 (lcons #102 (lcons #105 (lcons #101 (lcons #108 (lcons #100 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #111 (lcons #117 (lcons #116 (lcons #115 (lcons #105 (lcons #100 (lcons #101 (lcons #32 (lcons #116 (lcons #104 (lcons #101 (lcons #32 (lcons #102 (lcons #114 (lcons #97 (lcons #103 (lcons #109 (lcons #101 (lcons #110 (lcons #116 lnil)))))))))))))))))))))))))))))))))
x-r-clos = (lcons #97 (lcons #32 (lcons #102 (lcons #117 (lcons #110 (lcons #99 (lcons #116 (lcons #105 (lcons #111 (lcons #110 (lcons #32 (lcons #118 (lcons #97 (lcons #108 (lcons #117 (lcons #101 (lcons #32 (lcons #119 (lcons #104 (lcons #101 (lcons #114 (lcons #101 (lcons #32 (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #105 (lcons #115 (lcons #32 (lcons #110 (lcons #101 (lcons #101 (lcons #100 (lcons #101 (lcons #100 lnil)))))))))))))))))))))))))))))))))))))))
x-r-con-ty = (lcons #97 (lcons #32 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #111 (lcons #114 (lcons #32 (lcons #111 (lcons #102 (lcons #32 (lcons #97 (lcons #32 (lcons #112 (lcons #97 (lcons #114 (lcons #97 (lcons #109 (lcons #101 (lcons #116 (lcons #101 (lcons #114 (lcons #105 (lcons #122 (lcons #101 (lcons #100 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #97 (lcons #116 (lcons #32 (lcons #97 (lcons #110 (lcons #32 (lcons #117 (lcons #110 (lcons #107 (lcons #110 (lcons #111 (lcons #119 (lcons #110 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 lnil))))))))))))))))))))))))))))))))))))))))))))))))))))))))
x-lam-amp = (lcons #91 (lcons #38 (lcons #93 lnil)))
x-lam-const = (lcons #40 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 (lcons #32 lnil)))))))
x-r-dep = (lcons #97 (lcons #32 (lcons #116 (lcons #121 (lcons #112 (lcons #101 (lcons #32 (lcons #100 (lcons #101 (lcons #112 (lcons #101 (lcons #110 (lcons #100 (lcons #105 (lcons #110 (lcons #103 (lcons #32 (lcons #111 (lcons #110 (lcons #32 (lcons #97 (lcons #32 (lcons #114 (lcons #117 (lcons #110 (lcons #45 (lcons #116 (lcons #105 (lcons #109 (lcons #101 (lcons #32 (lcons #118 (lcons #97 (lcons #108 (lcons #117 (lcons #101 lnil))))))))))))))))))))))))))))))))))))
-- ---------------------------------------------------------------- names
x-gname names g = case names of lnil → lapp x-g (dec g); lcons nm r → if %weq (fst nm) g then snd nm else x-gname r g
x-dname d = lapp x-D (dec d)
x-cname d c = cat3 (x-dname d) x-c (dec c)
x-fname k = lapp (lcons #102 lnil) (dec k)
x-vname i = lapp x-v (dec i)
x-pname i = lapp x-P (dec i)
-- ---------------------------------------------------------------- the environment
-- a binder is (kind , text): kind 0 a run-time variable named by the text, 1 a template type
-- parameter, 2 an erased binder, 3 a non-type template parameter, 4 a field of a case (the text
-- the member access), 5 a hypothesis (the text the recursive call's head), innermost first
b-run nm = (#0 , nm)
b-type nm = (#1 , nm)
b-erased = (#2 , lnil)
b-const nm = (#3 , nm)
b-field txt = (#4 , txt)
b-hyp txt = (#5 , txt)
env-at env n = b-at (snd (snd env)) n
b-at bs n = case bs of lnil → b-erased; lcons b r → if %weq n #0 then b else b-at r (%wsub n #1)
env-depth env = lst-len (snd (snd env))
push-b b env = (fst env , (fst (snd env) , lcons b (snd (snd env))))
env-of names = (names , (lnil , lnil))
env-with names stages = (names , (stages , lnil))
x-gname-g env n = x-gname (fst env) n
-- ---------------------------------------------------------------- types
-- the C++ type of a type code; a universe is `class` (a template parameter's kind); a Π type is a
-- function value, which the image passes as a deduced parameter (auto); a data type with
-- parameters or a dependent Σ is outside the fragment
cxx-type env c =
  case c of
    cword → xs x-u64
    cpty k n → (if %weq k #0 then xs x-i64 else if %weq k #2 then xs x-f64 else if %weq k #1 then xs x-u32
                else if %weq k #4 then xcat3 (xs x-bytes) (word-code n) (xs x-gt) else xno (lapp x-r-form (lcons #112 lnil)))
    cdata d ps → if %weq d bool-idx then xs x-bool else (case %rtab d of some R → cxx-type env (fromopt (quote-ty R) cword); none → (case ps of lnil → xs (x-dname d); _ → if %weq (d-arity d) (lst-len ps) then xcat3 (xs (lapp (x-dname d) x-lt)) (join-x (tys-x env ps)) (xs x-gt) else xno x-r-params))
    csigma A B → if x-mentions #0 B then xno x-r-dep else xcat5 (xs x-pair) (cxx-type env A) (xs x-comma) (cxx-type (push-b b-erased env) B) (xs x-gt)
    cpi m A B → xs x-auto
    cvar n → (let b = env-at env n in if %weq (fst b) #1 then xs (snd b) else xno x-r-dep)
    cuniv l → xs x-class
    cann t T → cxx-type env t
    _ → xno (lapp x-r-form (code-head c))
x-mentions k c =
  case c of
    cvar n → %weq n k
    clam b → x-mentions (%wsucc k) b
    cpi m A B → orb (x-mentions k A) (x-mentions (%wsucc k) B)
    csigma A B → orb (x-mentions k A) (x-mentions (%wsucc k) B)
    capp f a → orb (x-mentions k f) (x-mentions k a)
    cdata d ps → lany (x-mentions k) ps
    cann t T → orb (x-mentions k t) (x-mentions k T)
    cwop p a b → orb (x-mentions k a) (x-mentions k b)
    cwsucc a → x-mentions k a
    cpty j n → x-mentions k n
    _ → false
word-code c = case c of cwlit w → xs (dec w); _ → (case nat-code c of some w → xs (dec w); none → xno x-r-dep)
-- the head of a code, for a report
code-head c =
  case c of
    cplam b → x-r-dim
    cpapp p r → x-r-dim
    ccomp A u a → x-r-kan
    ctrans d psi ls x → x-r-kan
    chcomp u a → x-r-kan
    cgluet A S → x-r-kan
    cglue S a → x-r-kan
    cunglue S b → x-r-kan
    cuniv l → x-r-univ
    cpathp A a b → x-r-dim
    _ → (lcons #111 (lcons #116 (lcons #104 (lcons #101 (lcons #114 lnil)))))
-- ---------------------------------------------------------------- terms
-- cxx-expr env want c: the C++ expression of code c; want the expected type's code when known
-- (some T), for the return type a recursion needs
cxx-expr env want c =
  case c of
    cvar n → var-expr (env-at env n)
    cglob n → xs (x-gname-g env n)
    clam b → (let i = env-depth env in xcat4 (xs x-lam) (xs (lapp x-auto (lapp x-sp (x-vname i)))) (xs x-lamr) (xcat2 (cxx-expr (push-b (b-run (x-vname i)) env) none b) (xs x-lamend)))
    capp f a → spine env want f (lcons a lnil)
    cpair a b → xcat5 (xs x-mkpair) (cxx-expr env none a) (xs x-comma) (cxx-expr env none b) (xs x-rb)
    cfst p → xcat3 (xs x-lp) (cxx-expr env none p) (xs (lapp x-rp x-first))
    csnd p → xcat3 (xs x-lp) (cxx-expr env none p) (xs (lapp x-rp x-second))
    clet t b → (let i = env-depth env in xcat7 (xs x-lam0) (xs (lapp x-let (x-vname i))) (xs x-assign) (cxx-expr env none t) (xs (lapp x-semi (lapp x-sp x-ret))) (cxx-expr (push-b (b-run (x-vname i)) env) want b) (xs (lapp x-lamend x-call0)))
    cann t T → cxx-expr env (some T) t
    cwlit n → xs (cat3 x-ulit (dec n) x-rp)
    cwsucc a → xcat3 (xs x-lp) (cxx-expr env none a) (xs x-one)
    cwop k a b → if %weq k #3 then xcat5 (xs x-max) (cxx-expr env none a) (xs x-comma) (cxx-expr env none b) (xs x-rp)
                 else xcat5 (xs x-lp) (cxx-expr env none a) (xs (wop-text k)) (cxx-expr env none b) (xs x-rp)
    cplit k b → if %weq k #0 then xs (cat4 x-i64c x-ulit (dec b) (lapp x-rp x-rp)) else if %weq k #2 then xs (cat4 x-f64bits x-ulit (dec b) (lapp x-rp x-rp)) else if %weq k #1 then xs (cat4 x-u32c x-ulit (dec b) (lapp x-rp x-rp)) else xno (lapp x-r-form (lcons #112 lnil))
    cprim k as → prim-expr env k as
    cwelim w z s → xcat7 (xs x-welim) (cxx-expr env none w) (xs x-comma) (cxx-expr env none z) (xs x-comma) (cxx-expr env none s) (xs x-rp)
    ccon d k fs ds → (case ds of lnil → (if %weq d bool-idx then xs (if %weq k #0 then x-true else x-false) else (case (if nat-rep then nat-code c else none) of some n → xs (cat3 x-ulit (dec n) x-rp); none → con-expr env want d k fs)); _ → xno x-r-dim)
    ccase d B x → if %weq d bool-idx then bool-case env want B x else case-expr env want d none B x
    celim d P B x → if %weq d bool-idx then bool-case env want B x else case-expr env want d (some P) B x
    cforce t → (case t of cvar n → (let b = env-at env n in if %weq (fst b) #5 then xs (snd b) else xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil))))))); _ → xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil)))))))
    -- a delayed term: the term (C++ is strict; a checked definition's normal form, which the image
    -- translates, has none — the machine builds a delay where it is met)
    cthunk t → cxx-expr env want t
    cdata d ps → cxx-type env c
    cword → cxx-type env c
    cpty k n → cxx-type env c
    csigma A B → cxx-type env c
    cpi m A B → cxx-type env c
    _ → xno (lapp x-r-form (code-head c))
var-expr b = if %weq (fst b) #2 then xno x-r-erased else xs (snd b)
wop-text k = if %weq k #0 then x-eq else if %weq k #1 then x-ltop else if %weq k #2 then x-plus else x-minus
-- an application spine: a type argument (a data type, a word type, a universe, a template type
-- variable) becomes a template argument of the head; the rest are call arguments; a λ head is
-- applied as a parenthesized lambda; a hypothesis head is the recursive call
spine env want f args =
  case f of
    capp g a → spine env want g (lcons a args)
    cglob n → global-call env n args
    cforce t → (case t of cvar n → (let b = env-at env n in if %weq (fst b) #5 then apply-one env (xcat3 (xs x-lp) (xs (snd b)) (xs x-rp)) args else xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil))))))); _ → xno (lapp x-r-form (lcons #102 (lcons #111 (lcons #114 (lcons #99 (lcons #101 lnil)))))))
    cvar n → apply-one env (cxx-expr env none f) args
    _ → apply-one env (xcat3 (xs x-lp) (cxx-expr env none f) (xs x-rp)) args
-- a function value takes its arguments one at a time (λs are curried); a definition takes the
-- arguments its parameters name at once — type and build-time ones as template arguments, erased
-- ones dropped — and what is left one at a time
apply-one env h args = case args of lnil → h; lcons a r → apply-one env (xcat3 h (xs x-lp) (xcat2 (cxx-expr env none a) (xs x-rp))) r
global-call env n args =
  let ks = g-kinds env n
  in apply-one env (call-expr (xs (x-gname-g env n)) (targs-by ks args) (args-by ks args)) (drop-n (lst-len ks) args)
call-expr h targs args = xcat3 h (if lst-empty targs then xs lnil else xcat3 (xs x-lt) (join-x targs) (xs x-gt)) (xcat3 (xs x-lp) (join-x args) (xs x-rp))
drop-n n l = if %weq n #0 then l else (case l of lnil → lnil; lcons x r → drop-n (%wsub n #1) r)
targs-by ks args = case ks of lnil → lnil; lcons k r → (case args of lnil → lnil; lcons a ar → if %weq k #1 then lcons (cxx-type env-none a) (targs-by r ar) else if %weq k #3 then lcons (cxx-expr env-none none a) (targs-by r ar) else targs-by r ar)
args-by ks args = case ks of lnil → lnil; lcons k r → (case args of lnil → lnil; lcons a ar → if %weq k #0 then lcons (cxx-expr env-none none a) (args-by r ar) else args-by r ar)
env-none = env-of lnil
-- the parameter kinds of a definition, from its type and usages (as split-def assigns them)
g-kinds env n = case quote-ty (%gty n) of some T → kinds-of env n #0 T; none → lnil
kinds-of env n i T =
  case T of
    cpi m A B → lcons (case A of cuniv l → #1; _ → if %weq (%gusage n i) #0 then #2 else if %weq (stage-of (fst (snd env)) i) #1 then #3 else #0) (kinds-of env n (%wsucc i) B)
    _ → lnil
lst-empty l = case l of lnil → true; _ → false
join-x l = case l of lnil → xs lnil; lcons a r → (case r of lnil → a; _ → xcat3 a (xs x-comma) (join-x r))
is-type-code env c =
  case c of
    cdata d ps → true
    cword → true
    cpty k n → true
    cuniv l → true
    csigma A B → true
    cpi m A B → true
    cvar n → %weq (fst (env-at env n)) #1
    _ → false
type-args env args = case args of lnil → lnil; lcons a r → if is-type-code env a then lcons (cxx-type env a) (type-args env r) else type-args env r
term-args env args = case args of lnil → lnil; lcons a r → if is-type-code env a then term-args env r else lcons (cxx-expr env none a) (term-args env r)
-- a constructor: D{D_c{fields}}, a recursive field wrapped in make_shared
con-expr env want d k fs =
  let ks = cshape d k
      n = d-arity d
  in if %weq n #0 then xcat5 (xs (x-dname d)) (xs x-lb) (xcat3 (xs (x-cname d k)) (xs x-lb) (fields-expr env d ks fs)) (xs x-rb) (xs x-rb)
     else con-expr-p env want d k fs n
-- a constructor of a parameterized type: D<args>{D_c<args>{fields}}, the arguments those of the
-- expected type (a constructor alone does not say them); each field expected at its type
-- instantiated, a recursive one wrapped in make_shared
con-expr-p env want d k fs n =
  case want of
    some T → (case T of
                cdata d2 ps → (let ta = xcat3 (xs x-lt) (join-x (tys-x env ps)) (xs x-gt)
                               in xcat5 (xcat2 (xs (x-dname d)) ta) (xs x-lb) (xcat3 (xcat2 (xs (x-cname d k)) ta) (xs x-lb) (fields-p env d n ps ta (ctor-tycodes-of d k) fs #0)) (xs x-rb) (xs x-rb))
                _ → xno x-r-con-ty)
    none → xno x-r-con-ty
fields-p env d n ps ta tys fs j =
  case fs of
    lnil → xs lnil
    lcons f r →
      let tc = (case tys of lcons t tr → t; lnil → none)
          e = (if is-rec-code d tc then xcat5 (xs (cat3 x-make-shared (x-dname d) lnil)) ta (xs (lapp x-gt x-lp)) (cxx-expr env (some (cdata d ps)) f) (xs x-rp) else cxx-expr env (inst-ty n ps j tc) f)
      in (case r of lnil → e; _ → xcat3 e (xs x-comma) (fields-p env d n ps ta (ltail-x tys) r (%wsucc j)))
is-rec-code d tc = case tc of some c → (case c of cdata d2 ps → %weq d d2; _ → false); none → false
-- a field's type code (over the parameters, then the preceding fields) at the type arguments:
-- the i-th parameter is variable n-1-i past the j preceding fields
inst-ty n ps j tc = case tc of some c → inst-c n ps j c; none → none
inst-c n ps j c =
  case c of
    cvar k → if %wlt k j then none else lnth ps (%wsub (%wsub n #1) (%wsub k j))
    cdata d2 ps2 → omap (cdata d2) (inst-codes n ps j ps2)
    cword → some c
    cpty k m → some c
    _ → none
inst-codes n ps j cs = case cs of lnil → some lnil; lcons c r → (case inst-c n ps j c of some c2 → omap (lcons c2) (inst-codes n ps j r); none → none)
fields-expr env d ks fs =
  case fs of
    lnil → xs lnil
    lcons f r →
      let k = (case ks of lcons kk kr → fst kk; lnil → #3)
          e = if %weq k #1 then xcat3 (xs (cat3 x-make-shared (x-dname d) x-gt)) (xcat3 (xs x-lp) (cxx-expr env none f) (xs x-rp)) (xs lnil) else cxx-expr env none f
      in (case r of lnil → e; _ → xcat3 e (xs x-comma) (fields-expr env d (ltail-x ks) r))
ltail-x l = case l of lnil → lnil; lcons x r → r
-- a case on a data type: cub::fix([&](auto &self, const D &x) { return std::visit(overloaded{ … }, x.v); })(x);
-- each alternative a lambda on const D_c &k, its fields k.f<j> (a recursive one *k.f<j>), its
-- hypotheses the recursive call self; the result type from the motive or the expected type
case-expr env want d P B x =
  let rt = (case P of some m → (case m of clam T → cxx-type (push-b b-erased env) T; _ → xno x-r-dep); none → (case want of some T → cxx-type env T; none → xs x-auto))
      n = d-arity d
  in xcat7 (xs x-fix) (xs (if %weq n #0 then x-dname d else x-auto)) (xcat3 (xs x-fix-end) rt (xs (lapp x-sp (lapp x-lb (lapp x-sp x-ret))))) (xcat4 (xs x-visit) (alts-expr env rt d B #0) (xs x-visit-end) (xs (lapp x-x x-dot-v))) (xs (lapp x-rp x-fix-close)) (xcat3 (xs x-lp) (cxx-expr env none x) (xs x-rp)) (xs lnil)
alts-expr env rt d B c =
  case B of
    lnil → xs lnil
    lcons b r →
      let ks = cshape d c
          hs = rec-fields ks #0
          n = lst-count ks
          env2 = push-hyps hs (push-fields d c ks #0 env)
          body = strip-n (%wadd n (lst-count hs)) b
          n = d-arity d
          alt = xcat7 (xs (if %weq n #0 then x-case else cat3 x-lam-amp (tpl-params-q n) x-lam-const)) (xs (if %weq n #0 then x-cname d c else lapp (x-cname d c) (targs-text-q n))) (xs x-case-arg) (xs x-lamr) (ret-cast rt (cxx-expr env2 none body)) (xs x-lamend) (xs lnil)
      in (case r of lnil → alt; _ → xcat3 alt (xs x-comma) (alts-expr env rt d r (%wsucc c)))
-- every alternative returns the one result type: a static_cast where it is known
ret-cast rt e = if %weq (fst rt) #0 then (let t = snd rt in if lst-eq t x-auto then e else xcat5 (xs (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #95 (lcons #99 (lcons #97 (lcons #115 (lcons #116 (lcons #60 lnil))))))))))))) (xs t) (xs (lcons #62 (lcons #40 lnil))) e (xs x-rp)) else rt
push-fields d c ks j env = case ks of lnil → env; lcons k r → push-fields d c r (%wsucc j) (push-b (b-field (if %weq (fst k) #1 then cat3 x-star (lapp x-k x-f) (dec j) else lapp x-k (lapp (lcons #46 lnil) (x-fname j)))) env)
push-hyps hs env = case hs of lnil → env; lcons j r → push-hyps r (push-b (b-hyp (cat4 x-self x-star (lapp x-k x-f) (lapp (dec j) x-rp))) env)
lst-eq a b = case a of lnil → (case b of lnil → true; _ → false); lcons x r → (case b of lcons y s → andb (%weq x y) (lst-eq r s); lnil → false)
bool-case env want B x =
  case B of
    lcons t r → (case r of lcons f r2 → xcat7 (xs x-lp) (cxx-expr env none x) (xs x-q) (cxx-expr env want (strip-n #0 t)) (xs x-colon) (cxx-expr env want (strip-n #0 f)) (xs x-rp); _ → xno x-r-dep)
    _ → xno x-r-dep
-- the primitive operations (code.cub's numbering): arithmetic as operators on the fixed-width
-- types, conversions as casts, the byte layer as cub's helpers (the bound an assume inside)
prim-expr env k as =
  let es = term-args-all env as
  in if %wlt k #512 then (let sb = %wsub k #256 in xcat3 (xs (conv-text sb)) (arg-n es #0) (xs x-rp))
     else if %wlt k #768 then (let sb = %wsub k #512 in xcat5 (xs x-lp) (arg-n es #0) (xs (bin-text sb)) (arg-n es #1) (xs x-rp))
     else if %wlt k #1024 then xcat5 (xs (lapp x-load (dec (wmul8 (%wsub k #768))))) (xs x-lp) (arg-n es #0) (xcat2 (xs x-comma) (arg-n es #1)) (xs x-rp)
     else if %wlt k #1280 then xcat7 (xs (lapp x-store (dec (wmul8 (%wsub k #1024))))) (xs x-lp) (arg-n es #0) (xcat2 (xs x-comma) (arg-n es #1)) (xs x-comma) (arg-n es #2) (xs x-rp)
     else if %wlt k #1536 then xcat3 (xs x-blen) (arg-n es #0) (xs x-rp)
     else xcat3 (xs x-mkbytes) (case cl-at as #0 of cwlit n → xs (dec n); _ → xno x-r-dep) (xs x-mkbytes-end)
wmul8 w = let w2 = %wadd w w in let w4 = %wadd w2 w2 in %wadd w4 w4
term-args-all env as = case as of lnil → lnil; lcons a r → lcons (cxx-expr env none a) (term-args-all env r)
arg-n es n = case es of lnil → xno x-r-dep; lcons e r → if %weq n #0 then e else arg-n r (%wsub n #1)
conv-text sb = if %weq sb #16 then x-i64c else if %weq sb #17 then x-u64c else if %weq sb #18 then x-u32c else if %weq sb #19 then x-u64c else if %weq sb #20 then x-f64c else if %weq sb #21 then x-f64c else x-i64c
bin-text sb = let op = (if %wlt sb #5 then sb else if %wlt sb #10 then %wsub sb #5 else %wsub sb #10)
              in if %weq op #0 then x-plus else if %weq op #1 then x-minus else if %weq op #2 then x-times else if %weq op #3 then (if %weq sb #13 then x-slash else x-eq) else if %weq op #4 then (if %weq sb #14 then x-eq else x-ltop) else x-ltop
-- ---------------------------------------------------------------- definitions
-- the Π chain of the type against the λs of the value: the parameters with their kinds, the
-- environment for the body, the body and its result type. stages: a Lst of (index , Stage) naming
-- the binders at `build` (st-build) — non-type template parameters; the rest by their types and
-- usages (%gusage g i: 0 erased)
split-def names g stages T v = split-at g stages #0 lnil lnil (env-with names stages) T v
split-at g stages i tps ps env T v =
  case T of
    cpi m A B →
      (case v of
         clam b →
           let st = stage-of stages i
               kind = (case A of cuniv l → #1; _ → if %weq (%gusage g i) #0 then #2 else if %weq st #1 then #3 else #0)
               nm = if %weq kind #1 then x-pname i else if %weq kind #3 then x-pname i else x-vname i
               binder = if %weq kind #1 then b-type nm else if %weq kind #2 then b-erased else if %weq kind #3 then b-const nm else b-run nm
               tp = if %weq kind #1 then lcons (xs (lapp x-class nm)) lnil else if %weq kind #3 then lcons (xcat2 (cxx-type env A) (xs (lapp x-sp nm))) lnil else lnil
               p = if %weq kind #0 then lcons (xcat2 (cxx-type env A) (xs (lapp x-sp nm))) lnil else lnil
           in split-at g stages (%wsucc i) (lapp tps tp) (lapp ps p) (push-b binder env) B b
         _ → (tps , (ps , (env , (v , T)))))
    _ → (tps , (ps , (env , (v , T))))
stage-of stages i = case stages of lnil → #0; lcons s r → if %weq (fst s) i then (case snd s of st-build → #1; _ → #0) else stage-of r i
-- image-fn names g stages T v: the C++ entity, or the reason
image-fn names g stages T v =
  let sp = split-def names g stages T v
      tps = fst sp
      ps = fst (snd sp)
      env = fst (snd (snd sp))
      body = fst (snd (snd (snd sp)))
      ret = snd (snd (snd (snd sp)))
      head = xcat3 (if lst-empty tps then xs lnil else xcat3 (xs x-template) (join-x tps) (xs (lapp x-gt x-nl))) (cxx-type env ret) (xs (lapp x-sp (lapp (x-gname names g) x-lp)))
  in xcat4 head (join-x ps) (xs x-body) (xcat2 (cxx-expr env (some ret) body) (xs x-end))
-- image-def names stages g: (bytes , report) for a checked definition
image-def names stages g =
  case quote-ty (%gty g) of
    none → (lnil , x-r-type)
    some T →
      (case unfold g of
         none → (lnil , x-r-value)
         some v → (let r = image-fn names g stages T v in if %weq (fst r) #0 then (snd r , x-exported) else (lnil , lapp x-not-exportable (snd r))))
-- ---------------------------------------------------------------- data types
-- struct D_c0 { … }; struct D_c1 { uint64_t f0; std::shared_ptr<D> f1; }; struct D { std::variant<D_c0, D_c1> v; };
image-data d =
  if lany-x tel-has-dims (ctors-at d lnil) then xno x-r-hit
  else (case %dent d of
          dent tel l → (case tel of tz e → xcat3 (xs (cat3 x-struct (x-dname d) x-fwd)) (ctor-structs d (nctors d) #0) (xcat3 (xs (cat3 x-struct (x-dname d) (lapp x-sp (lapp x-lb (lapp x-sp x-variant))))) (join-x (ctor-names d (nctors d) #0)) (xs x-vdecl)); _ → image-data-p d tel)
          _ → xno x-r-params)
lany-x p l = case l of lnil → false; lcons x r → (case p x of true → true; false → lany-x p r)
-- ---- parameterized data types (18.9): a type parameter is a template parameter of the structs
-- template<class P0> struct D; template<class P0> struct D_c1 { P0 f0; std::shared_ptr<D<P0>> f1; };
-- template<class P0> struct D { std::variant<D_c0<P0>, D_c1<P0>> v; };
-- A parameter at a value (an index, a length) is outside the fragment.
image-data-p d tel =
  case d-params tel lnil #0 of
    none → xno x-r-params
    some p →
      (let n = fst p
           bs = fst (snd p)
           tels = snd (snd p)
           hd = tpl-head n
       in xcat3 (xs (cat4 hd x-struct (x-dname d) x-fwd)) (ctor-structs-p d n bs tels #0)
                (xcat3 (xs (cat4 hd x-struct (x-dname d) (lapp x-sp (lapp x-lb (lapp x-sp x-variant))))) (join-x (ctor-names-p d n (lst-len tels) #0)) (xs x-vdecl)))
-- the parameters of a data type's telescope: some (count , the quoting binders , the constructor
-- telescopes) when every parameter is a type; none otherwise
d-params tel bs n =
  case tel of
    tx A nm r → (let Av = tval A in (case %view Av of wu l → (let x = %var nm Av in d-params (r x Av) (lcons (qv (var-level x)) bs) (%wsucc n)); _ → none))
    tz e → some (n , (bs , e))
    _ → none
d-arity d = case %dent d of dent tel l → (case d-params tel lnil #0 of some p → fst p; none → #0); _ → #0
-- the field types of a constructor telescope as codes over the parameters (then the preceding fields)
ctor-tycodes bs tel = case tel of tx A nm r → (let Av = tval A in let x = %var nm Av in lcons (qty bs Av) (ctor-tycodes (lcons (qv (var-level x)) bs) (r x Av))); _ → lnil
ctor-tycodes-of d k = case %dent d of dent tel l → (case d-params tel lnil #0 of some p → ctor-tycodes (fst (snd p)) (fromopt (lnth (snd (snd p)) k) (tz (tsys lnil []))); none → lnil); _ → lnil
ctor-names-p d n m c = if %weq c m then lnil else lcons (xs (lapp (x-cname d c) (targs-text n))) (ctor-names-p d n m (%wsucc c))
ctor-structs-p d n bs tels c =
  case tels of
    lnil → xs lnil
    lcons tel r → xcat2 (xcat3 (xs (cat4 (tpl-head n) x-struct (x-cname d c) (lapp x-sp x-lb))) (ctor-fields-p d n (penv n) (ctor-tycodes bs tel) #0) (xs (lapp x-sp (lapp x-rb (lapp x-semi x-nl))))) (ctor-structs-p d n bs r (%wsucc c))
ctor-fields-p d n env tys j = case tys of lnil → xs lnil; lcons t r → xcat3 (xcat3 (xs x-sp) (fty-x env d n t) (xs (lapp x-sp (x-fname j)))) (xs x-semi) (ctor-fields-p d n (push-b b-erased env) r (%wsucc j))
fty-x env d n t = if is-rec-code d t then xs (cat3 x-shared (lapp (x-dname d) (targs-text n)) x-gt) else (case t of some tc → cxx-type env tc; none → xno x-r-ftype)
-- the environment of the parameters as template type parameters P0 … (P0 outermost)
penv n = penv-at (env-of lnil) n #0
penv-at env n i = if %weq i n then env else penv-at (push-b (b-type (x-pname i)) env) n (%wsucc i)
-- template<class P0, class P1> ␣ and <P0, P1>
tpl-head n = cat3 x-template (join-b (pnames n #0 true)) (lapp x-gt x-sp)
tpl-params-q n = cat3 x-lt (join-b (qnames n #0 true)) x-gt
targs-text n = cat3 x-lt (join-b (pnames n #0 false)) x-gt
targs-text-q n = cat3 x-lt (join-b (qnames n #0 false)) x-gt
pnames n i cl = if %weq i n then lnil else lcons (if cl then lapp x-class (x-pname i) else x-pname i) (pnames n (%wsucc i) cl)
-- a case's alternatives are template lambdas over the scrutinee's arguments Q0 … (a name of their
-- own: a template lambda inside a template function may not redeclare its parameters)
qnames n i cl = if %weq i n then lnil else lcons (if cl then lapp x-class (x-qname i) else x-qname i) (qnames n (%wsucc i) cl)
x-qname i = lapp (lcons #81 lnil) (dec i)
join-b l = case l of lnil → lnil; lcons a r → (case r of lnil → a; _ → cat3 a x-comma (join-b r))
tys-x env ps = case ps of lnil → lnil; lcons a r → lcons (cxx-type env a) (tys-x env r)
ctor-names d n c = if %weq c n then lnil else lcons (xs (x-cname d c)) (ctor-names d n (%wsucc c))
ctor-structs d n c = if %weq c n then xs lnil else xcat2 (xcat3 (xs (cat3 x-struct (x-cname d c) (lapp x-sp x-lb))) (ctor-fields d (cshape d c) #0) (xs (lapp x-sp (lapp x-rb (lapp x-semi x-nl))))) (ctor-structs d n (%wsucc c))
ctor-fields d ks j =
  case ks of
    lnil → xs lnil
    lcons k r →
      let ty = (if %weq (fst k) #0 then xs x-u64 else if %weq (fst k) #1 then xs (cat3 x-shared (x-dname d) x-gt) else if %weq (fst k) #2 then xs (x-dname (snd k)) else xno x-r-ftype)
      in xcat3 (xcat3 (xs x-sp) ty (xs (lapp x-sp (x-fname j)))) (xs x-semi) (ctor-fields d r (%wsucc j))
-- ---------------------------------------------------------------- the header
-- the data types a list of codes mentions, in order of first mention
datas-of cs acc = case cs of lnil → acc; lcons c r → datas-of r (datas-in c acc)
datas-in c acc =
  case c of
    cdata d ps → add-d d acc
    ccon d k fs ds → datas-list fs (add-d d acc)
    ccase d B x → datas-list B (datas-in x (add-d d acc))
    celim d P B x → datas-list B (datas-in x (add-d d acc))
    clam b → datas-in b acc
    capp f a → datas-in a (datas-in f acc)
    cpair a b → datas-in b (datas-in a acc)
    cfst p → datas-in p acc
    csnd p → datas-in p acc
    clet t b → datas-in b (datas-in t acc)
    cann t T → datas-in T (datas-in t acc)
    cpi m A B → datas-in B (datas-in A acc)
    csigma A B → datas-in B (datas-in A acc)
    cwsucc a → datas-in a acc
    cwop k a b → datas-in b (datas-in a acc)
    cwelim w z s → datas-in s (datas-in z (datas-in w acc))
    cprim k as → datas-list as acc
    cforce t → datas-in t acc
    cthunk t → datas-in t acc
    _ → acc
datas-list l acc = case l of lnil → acc; lcons x r → datas-list r (datas-in x acc)
add-d d acc = if %weq d bool-idx then acc else if lmem-w d acc then acc else lapp acc (lcons d lnil)
-- cxx-image names stages gs: the header for the checked definitions gs (in order) with the data types
-- they mention, and the report, a Lst of (g , report bytes): (header , reports)
cxx-image names stages gs =
  let codes = codes-of gs
      ds = datas-of codes lnil
      decls = datas-text ds
      defs = defs-text names stages gs
  in (cat3 x-pragma decls (fst defs) , snd defs)
codes-of gs = case gs of lnil → lnil; lcons g r → (case unfold g of some v → (case quote-ty (%gty g) of some T → lcons v (lcons T (codes-of r)); none → codes-of r); none → codes-of r)
datas-text ds = case ds of lnil → lnil; lcons d r → (let x = image-data d in if %weq (fst x) #0 then lapp (snd x) (datas-text r) else datas-text r)
defs-text names stages gs =
  case gs of
    lnil → (lnil , lnil)
    lcons g r → (let d = image-def names stages g in let rest = defs-text names stages r in (lapp (fst d) (fst rest) , lcons (g , snd d) (snd rest)))
-- the full report as text: one line per definition
report-text names reps = case reps of lnil → lnil; lcons rp r → cat4 (x-gname names (fst rp)) (lcons #58 (lcons #32 lnil)) (snd rp) (lapp x-nl (report-text names r))
-- ---------------------------------------------------------------- readings
fromx r = snd r
-- a word function: its image is one C++ function over uint64_t
add3x : Word → Word → Word
add3x a b = %wadd (%wadd a b) #3
#same fst (image-def lnil lnil (gidx (code add3x))) = lapp (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #103 lnil)))))))))) (lapp (dec (gidx (code add3x))) ((lcons #40 (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #118 (lcons #48 (lcons #44 (lcons #32 (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #118 (lcons #49 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #40 (lcons #40 (lcons #118 (lcons #48 (lcons #32 (lcons #43 (lcons #32 (lcons #118 (lcons #49 (lcons #41 (lcons #32 (lcons #43 (lcons #32 (lcons #85 (lcons #73 (lcons #78 (lcons #84 (lcons #54 (lcons #52 (lcons #95 (lcons #67 (lcons #40 (lcons #51 (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
#same snd (image-def lnil lnil (gidx (code add3x))) = x-exported
-- a function uniform in a type keeps its template: twice A f a = f (f a)
twicex : (A : Type) → (A → A) → A → A
twicex A f a = f (f a)
#same fst (image-def lnil lnil (gidx (code twicex))) = lapp (lcons #116 (lcons #101 (lcons #109 (lcons #112 (lcons #108 (lcons #97 (lcons #116 (lcons #101 (lcons #60 (lcons #99 (lcons #108 (lcons #97 (lcons #115 (lcons #115 (lcons #32 (lcons #80 (lcons #48 (lcons #62 (lcons #10 (lcons #80 (lcons #48 (lcons #32 (lcons #103 lnil))))))))))))))))))))))) (lapp (dec (gidx (code twicex))) ((lcons #40 (lcons #97 (lcons #117 (lcons #116 (lcons #111 (lcons #32 (lcons #118 (lcons #49 (lcons #44 (lcons #32 (lcons #80 (lcons #48 (lcons #32 (lcons #118 (lcons #50 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #118 (lcons #49 (lcons #40 (lcons #118 (lcons #49 (lcons #40 (lcons #118 (lcons #50 (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil))))))))))))))))))))))))))))))))))))))))))
-- a proof parameter is absent (usage 0): a bound it carried is a hypothesis the fragment states
-- where the access happens (cub::load64's assume), not here
ld8x : (b : Bytes 32) → le 16 32 → Word
ld8x b h = i64toWord (load64 32 b 8 h)
#same snd (image-def lnil lnil (gidx (code ld8x))) = x-exported
#same fst (image-def lnil lnil (gidx (code ld8x))) = lapp (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #103 lnil)))))))))) (lapp (dec (gidx (code ld8x))) ((lcons #40 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #98 (lcons #121 (lcons #116 (lcons #101 (lcons #115 (lcons #60 (lcons #51 (lcons #50 (lcons #62 (lcons #32 (lcons #118 (lcons #48 (lcons #41 (lcons #32 (lcons #123 (lcons #32 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 (lcons #32 (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #95 (lcons #99 (lcons #97 (lcons #115 (lcons #116 (lcons #60 (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #62 (lcons #40 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #108 (lcons #111 (lcons #97 (lcons #100 (lcons #54 (lcons #52 (lcons #40 (lcons #118 (lcons #48 (lcons #44 (lcons #32 (lcons #85 (lcons #73 (lcons #78 (lcons #84 (lcons #54 (lcons #52 (lcons #95 (lcons #67 (lcons #40 (lcons #56 (lcons #41 (lcons #41 (lcons #41 (lcons #59 (lcons #32 (lcons #125 (lcons #10 lnil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
-- a data type: one struct per constructor, the variant; a structural recursion: fix and visit
data TLx = tnilx | tconsx (x : Word) (xs : TLx)
tsumx : TLx → Word
tsumx l = case l of tnilx → #0; tconsx x xs → %wadd x (rec xs)
#same fromx (image-data (didx (code TLx))) = lapp (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #32 (lcons #68 lnil)))))))) (lapp (dec (didx (code TLx))) (lapp (lcons #59 (lcons #10 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #32 (lcons #68 lnil)))))))))) (lapp (dec (didx (code TLx))) (lapp (lcons #95 (lcons #99 (lcons #48 (lcons #32 (lcons #123 (lcons #32 (lcons #125 (lcons #59 (lcons #10 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #32 (lcons #68 lnil))))))))))))))))) (lapp (dec (didx (code TLx))) (lapp (lcons #95 (lcons #99 (lcons #49 (lcons #32 (lcons #123 (lcons #32 (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 (lcons #32 (lcons #102 (lcons #48 (lcons #59 (lcons #32 (lcons #115 (lcons #116 (lcons #100 (lcons #58 (lcons #58 (lcons #115 (lcons #104 (lcons #97 (lcons #114 (lcons #101 (lcons #100 (lcons #95 (lcons #112 (lcons #116 (lcons #114 (lcons #60 (lcons #68 lnil)))))))))))))))))))))))))))))))))))) (lapp (dec (didx (code TLx))) (lapp (lcons #62 (lcons #32 (lcons #102 (lcons #49 (lcons #59 (lcons #32 (lcons #125 (lcons #59 (lcons #10 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 (lcons #32 (lcons #68 lnil))))))))))))))))) (lapp (dec (didx (code TLx))) (lapp (lcons #32 (lcons #123 (lcons #32 (lcons #115 (lcons #116 (lcons #100 (lcons #58 (lcons #58 (lcons #118 (lcons #97 (lcons #114 (lcons #105 (lcons #97 (lcons #110 (lcons #116 (lcons #60 (lcons #68 lnil))))))))))))))))) (lapp (dec (didx (code TLx))) (lapp (lcons #95 (lcons #99 (lcons #48 (lcons #44 (lcons #32 (lcons #68 lnil)))))) (lapp (dec (didx (code TLx))) ((lcons #95 (lcons #99 (lcons #49 (lcons #62 (lcons #32 (lcons #118 (lcons #59 (lcons #32 (lcons #125 (lcons #59 (lcons #10 lnil)))))))))))))))))))))))))
#same snd (image-def lnil lnil (gidx (code tsumx))) = x-exported
-- a path-typed definition is not exportable, with the reason
#same snd (image-def lnil lnil (gidx (code plusw-zero-l))) = lapp x-not-exportable (lapp x-r-form x-r-dim)

-- a parameterized data type: one template parameter per type parameter, the recursive field a
-- shared_ptr to the type at its own parameters; a function over it at a type argument is a plain
-- function, one uniform in the parameter a template; a constructor at the expected type's arguments
data TLp (A : Type) = tnilp | tconsp (x : A) (xs : TLp A)
sump : TLp Word → Word
sump l = case l of tnilp → #0; tconsp x xs → %wadd x (rec xs)
lenp : (A : Type) → TLp A → Word
lenp A l = case l of tnilp → #0; tconsp x xs → %wadd #1 (rec xs)
mk3p : Word → TLp Word
mk3p a = tconsp a (tconsp (%wadd a #1) (tconsp (%wadd a #2) tnilp))
