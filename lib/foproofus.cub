wr-1 A df T f g fg (kqcons a kqnil) (cvcons x z) h = subst {lzero} {lzero} {CV} {λ u → CR A df (f a) (c-1 g (cvcons x u))} {cvnil} {z} (sym (snd h)) (fg a x (fst h))
wr-1 A df T f g fg (kqcons a kqnil) cs h = Empty-rec h
wr-1 A df T f g fg as cs h = unit
