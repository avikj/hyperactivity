-- lib/foproofus.cub — the unboxed C link, U3 (plan item 15): cu-sound, whatever the first-order form
-- computes the unboxed C computes. lib/foproofu.cub's U1 gives the kinds (ksyn, kok, kind-sound);
-- lib/foproofcu.cub's U2 the unboxed C (CU), its meaning on C's words (evcu, lib/foproofm.cub's MV and
-- MSt) and the translation guided by the kinds (fq-to-cu). Loaded after lib/foproofcu.cub.
--
-- The relation (UR): an unboxed C value refines a first-order value when it holds a limit (a C word
-- operation left the exact words: no claim, as lib/foproofm.cub's evc), or it is, read as a C cell, a
-- value lib/foproofc.cub's CR relates to it. A uint64_t is a word cell in this model (evcu's), so the
-- representation the kinds choose changes no value: what the kinds decide is where a conversion is
-- sound. (x)->n (cuunw) is the identity on a word cell and has no value on any other cell, so it is
-- sound exactly where the first-order value is a word or none: kind kw (U1's Kv T kw). A term the
-- translation wants as a uint64_t (W) is related only where its value has kind kw (VR); a let's local,
-- a parameter and a result are uint64_t exactly where their kind is kw, and kind-sound gives that kind
-- to the value, so every local and every function's value is related in full (vr-k); a word primitive's
-- operands, uint64_t whatever their kinds, are related only where they are words, which is all a word
-- primitive reads (its value is none otherwise: wrp-k, the chain over q-prim).
--
-- cu-sound is one induction over the term (ustep: lib/foproofc.cub's pstep and lib/foproofm.cub's
-- mstep at once, the kinds alongside) inside one over the fuel for calls and loops (ucoks), kind-sound
-- read at each let, call, loop and definition. A closure's target is called by apply through the
-- dispatcher with V * arguments: such a key (dc) has a dispatcher case (CD), its parameters' kinds are
-- anything (kanys) so any arguments have them, and the term's closures name only such keys (uok, the
-- boxed link's ca-ok with that one condition more). cu-sound-k states it for a term translated at its
-- kind's C type (as fq-to-cu-def and U2's main are); cu-word, cu-agree read it at a word against the
-- boxed link's evc (lib/foproofm.cub's cm-sound-t): when the first-order form answers a word, the boxed
-- C and the unboxed C each answer that word or hit a limit.
-- ---------------------------------------------------------------- small facts
mor-fl : (a b : Bool) → mor a b ≡ false → a ≡ false
mor-fl true b h = h
mor-fl false b h = λ i → false
mor-fr : (a b : Bool) → mor a b ≡ false → b ≡ false
mor-fr true b h = Empty-rec (true≢false h)
mor-fr false b h = h
-- a machine value without a limit is a C value read back
c2m-m2c : (u : MV) → haslim u ≡ false → c2m (m2c u) ≡ u
c2m-m2c (mw n) h = λ i → mw n
c2m-m2c (mcon c fs) h = λ i → mcon c (c2m-m2c fs h i)
c2m-m2c (mclo g caps) h = λ i → mclo g (c2m-m2c caps h i)
c2m-m2c (mb l) h = λ i → mb l
c2m-m2c mvnil h = λ i → mvnil
c2m-m2c (mvcons x r) h = λ i → mvcons (c2m-m2c x (mor-fl (haslim x) (haslim r) h) i) (c2m-m2c r (mor-fr (haslim x) (haslim r) h) i)
c2m-m2c mbot h = λ i → mbot
c2m-m2c mlim h = Empty-rec (true≢false h)
-- a dependent if on CU (a case's goal stated through a function of the test, met on each side)
bif-el : (P : CU → Type) (b : Bool) (X Y : CU) → (b ≡ true → P X) → (b ≡ false → P Y) → P (if b then X else Y)
bif-el P true X Y hx hy = hx (λ i → true)
bif-el P false X Y hx hy = hy (λ i → false)
-- a chain of m anythings, decided
kanysb : Kd → Nat → Bool
kanysb knil zero = true
kanysb (kcons ka r) (suc m) = kanysb r m
kanysb k m = false
kanysb-ok : (k : Kd) (m : Nat) → kanysb k m ≡ true → k ≡ kanys m
kanysb-ok knil zero h = λ i → knil
kanysb-ok (kcons ka r) (suc m) h = λ i → kcons ka (kanysb-ok r m h i)
kanysb-ok k m h = Empty-rec (false≢true h)
-- ---------------------------------------------------------------- the relation
-- an unboxed C value refines a first-order value: a limit inside, or a C value CR relates, read as a
-- machine value
UR : (Word → Nat) → (Word → Bool) → KQ → MV → Type
UR A df q u = Sum (haslim u ≡ true) ((c : CV) × (CR A df q c × (u ≡ c2m c)))
ur-c : (A : Word → Nat) (df : Word → Bool) (q : KQ) (c : CV) → CR A df q c → UR A df q (c2m c)
ur-c A df q c h = inr (c , (h , (λ i → c2m c)))
ur-mr : (A : Word → Nat) (df : Word → Bool) (q : KQ) (c : CV) (m : MV) → CR A df q c → MR c m → UR A df q m
ur-mr A df q c m hc (inl p) = inl p
ur-mr A df q c m hc (inr p) = inr (c , (hc , p))
-- none is refined by anything
ur-bot : (A : Word → Nat) (df : Word → Bool) (u : MV) → UR A df kqbot u
ur-bot A df u = bool-split (haslim u) (UR A df kqbot u) (λ h → inl h) (λ h → inr (m2c u , (unit , sym (c2m-m2c u h))))
-- without a limit, the C value read back is related
ur-nl : (A : Word → Nat) (df : Word → Bool) (q : KQ) (u : MV) → haslim u ≡ false → UR A df q u → CR A df q (m2c u)
ur-nl A df q u h (inl p) = Empty-rec (true≢false (sym p ∙ h))
ur-nl A df q u h (inr p) = subst {lzero} {lzero} {CV} {λ v → CR A df q v} {fst p} {m2c u} (sym (cong m2c (snd (snd p)) ∙ m2c-c2m (fst p))) (fst (snd p))
-- the gate every operation on C's words passes: a limit in its operand answers a limit; otherwise the
-- operation on the operand's C value
ur-gate : (A : Word → Nat) (df : Word → Bool) (q : KQ) (u : MV) (y : KQ) (K : CV → MV) → UR A df q u → ((c : CV) → CR A df q c → UR A df y (K c))
        → UR A df y (if haslim u then mlim else K (m2c u))
ur-gate A df q u y K h hk =
  bool-split (haslim u) (UR A df y (if haslim u then mlim else K (m2c u)))
    (λ e → subst {lzero} {lzero} {Bool} {λ b → UR A df y (if b then mlim else K (m2c u))} {true} {haslim u} (sym e) (inl (λ i → true)))
    (λ e → subst {lzero} {lzero} {Bool} {λ b → UR A df y (if b then mlim else K (m2c u))} {false} {haslim u} (sym e) (hk (m2c u) (ur-nl A df q u e h)))
ur-lift : (A : Word → Nat) (df : Word → Bool) (g : CV → CV) (q y : KQ) (u : MV) → ((c : CV) → CR A df q c → CR A df y (g c)) → UR A df q u → UR A df y (mlift g u)
ur-lift A df g q y u hg h = ur-gate A df q u y (λ v → c2m (g v)) h (λ c hc → ur-c A df y (g c) (hg c hc))
ur-prim : (A : Word → Nat) (df : Word → Bool) (p : Word) (qs : KQ) (us : MV) → UR A df qs us → UR A df (q-prim p qs) (m-prim p us)
ur-prim A df p qs us h = ur-gate A df qs us (q-prim p qs) (mprim0 p) h (λ c hc → ur-mr A df (q-prim p qs) (c-prim p c) (mprim0 p c) (cr-prim A df p qs c hc) (mr-prim0 p c))
ur-con : (A : Word → Nat) (df : Word → Bool) (d c : Word) (qs : KQ) (us : MV) → UR A df qs us → UR A df (kqcon d c qs) (mcon c us)
ur-con A df d c qs us (inl p) = inl p
ur-con A df d c qs us (inr p) = inr (cvcon c (fst p) , (((λ i → c) , fst (snd p)) , (λ i → mcon c (snd (snd p) i))))
ur-clo : (A : Word → Nat) (df : Word → Bool) (g : Word) (qs : KQ) (us : MV) → cr-clo A df g qs ≡ true → UR A df qs us → UR A df (kqclos g qs) (mclo g us)
ur-clo A df g qs us hc (inl p) = inl p
ur-clo A df g qs us hc (inr p) = inr (cclo g (fst p) , ((((λ i → g) , hc) , fst (snd p)) , (λ i → mclo g (snd (snd p) i))))
ur-cons : (A : Word → Nat) (df : Word → Bool) (x : KQ) (y : MV) (r : KQ) (v : MV) → UR A df x y → UR A df r v → UR A df (kqcons x r) (mvcons y v)
ur-cons A df x y r v (inl p) hr = inl (cong (λ b → mor b (haslim v)) p)
ur-cons A df x y r v (inr p) (inl pr) = inl (cong (λ u → mor (haslim u) (haslim v)) (snd (snd p)) ∙ (cong (λ b → mor b (haslim v)) (c2m-nl (fst p)) ∙ pr))
ur-cons A df x y r v (inr p) (inr pr) = inr (cvcons (fst p) (fst pr) , ((fst (snd p) , fst (snd pr)) , (λ i → mvcons (snd (snd p) i) (snd (snd pr) i))))
ur-nil : (A : Word → Nat) (df : Word → Bool) → UR A df kqnil mvnil
ur-nil A df = ur-c A df kqnil cvnil (λ i → cvnil)
-- (x)->n of a value of kind kw: the identity on its word cell
cr-word : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (q : KQ) (c : CV) → Kv T kw q → CR A df q c → CR A df q (c-word c)
cr-word A df T kqbot c hk h = unit
cr-word A df T (kqw w) c hk h = subst {lzero} {lzero} {CV} {λ v → CR A df (kqw w) (c-word v)} {cw w} {c} (sym h) (λ i → cw w)
cr-word A df T (kqi b) c hk h = subst {lzero} {lzero} {CV} {λ v → CR A df (kqi b) (c-word v)} {cw b} {c} (sym h) (λ i → cw b)
cr-word A df T (kqf b) c hk h = subst {lzero} {lzero} {CV} {λ v → CR A df (kqf b) (c-word v)} {cw b} {c} (sym h) (λ i → cw b)
cr-word A df T q c hk h = Empty-rec hk
ur-word : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (q : KQ) (u : MV) → Kv T kw q → UR A df q u → UR A df q (mlift c-word u)
ur-word A df T q u hk h = ur-lift A df c-word q q u (λ c hc → cr-word A df T q c hk hc) h
-- ---------------------------------------------------------------- at a wanted C type
-- what a C type asks of the value: a uint64_t, kind kw; a V *, nothing
wkp : (Word → Word → Nat → Kd) → CTy → KQ → Type
wkp T ctw q = Kv T kw q
wkp T ctb q = Unit
-- a term wanted at C type t: related wherever its value meets t's condition
VR : (Word → Nat) → (Word → Bool) → (Word → Word → Nat → Kd) → CTy → KQ → MV → Type
VR A df T t q u = wkp T t q → UR A df q u
-- a list wanted at the types W (by position)
VRL : (Word → Nat) → (Word → Bool) → (Word → Word → Nat → Kd) → KQ → MV → (Nat → CTy) → Type
VRL A df T (kqcons x r) (mvcons y v) W = VR A df T (W zero) x y × VRL A df T r v (λ i → W (suc i))
VRL A df T kqnil mvnil W = Unit
VRL A df T q u W = Empty
vr-b : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (q : KQ) (u : MV) → VR A df T ctb q u → UR A df q u
vr-b A df T q u h = h unit
vr-u : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (q : KQ) (u : MV) → UR A df q u → VR A df T t q u
vr-u A df T t q u h = λ hk → h
vr-bot : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (u : MV) → VR A df T t kqbot u
vr-bot A df T t u = λ hk → ur-bot A df u
-- a value of kind k wanted at k's C type is related in full
vr-k : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (k : Kd) (q : KQ) (u : MV) → Kv T k q → VR A df T (ct-of k) q u → UR A df q u
vr-k A df T kw q u hk h = h hk
vr-k A df T kb q u hk h = h unit
vr-k A df T (kdc d) q u hk h = h unit
vr-k A df T ka q u hk h = h unit
vr-k A df T kdn q u hk h = h unit
vr-k A df T knil q u hk h = h unit
vr-k A df T (kcons k r) q u hk h = h unit
-- a list of values of the kinds ks wanted at their C types (a call's arguments), and a list wanted
-- boxed, related in full
vrl-k : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (q : KQ) (ks : Kd) (u : MV) → kvs T q ks → VRL A df T q u (λ i → ct-of (knth ks i)) → UR A df q u
vrl-k A df T (kqcons x xs) (kcons k r) (mvcons y v) hk h = ur-cons A df x y xs v (vr-k A df T k x y (fst hk) (fst h)) (vrl-k A df T xs r v (snd hk) (snd h))
vrl-k A df T (kqcons x xs) (kcons k r) u hk h = Empty-rec h
vrl-k A df T kqnil knil mvnil hk h = ur-nil A df
vrl-k A df T kqnil knil u hk h = Empty-rec h
vrl-k A df T q ks u hk h = Empty-rec hk
vrl-b : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (q : KQ) (u : MV) → VRL A df T q u (λ i → ctb) → UR A df q u
vrl-b A df T (kqcons x xs) (mvcons y v) h = ur-cons A df x y xs v (fst h unit) (vrl-b A df T xs v (snd h))
vrl-b A df T (kqcons x xs) u h = Empty-rec h
vrl-b A df T kqnil mvnil h = ur-nil A df
vrl-b A df T kqnil u h = Empty-rec h
vrl-b A df T q u h = Empty-rec h
-- a term produced at C type pt, related in full, converted to the wanted wt (mkw(x) the identity, (x)->n
-- sound where the value has kind kw, which VR at a uint64_t assumes)
ucv : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (GC : Word → CU) (CD : Word → Bool) (K : UE) (x : CU) (s : MSt) (pt wt : CTy) (q : KQ)
    → UR A df q (uevT GC A CD K x s) → VR A df T wt q (uevT GC A CD K (cu-conv pt wt x) s)
ucv A df T GC CD K x s ctw ctw q h = λ hk → h
ucv A df T GC CD K x s ctb ctb q h = λ hk → h
ucv A df T GC CD K x s ctw ctb q h = λ hk → h
ucv A df T GC CD K x s ctb ctw q h = λ hk → ur-word A df T q (uevT GC A CD K x s) hk h
-- a literal at its wanted type: mkw(w), or w as a uint64_t (cuunw of mkw(w)); a limit from 2^64 up
ur-litb : (A : Word → Nat) (df : Word → Bool) (w : Word) (b : Bool) → UR A df (kqw w) (if b then mw w else mlim)
ur-litb A df w true = ur-c A df (kqw w) (cw w) (λ i → cw w)
ur-litb A df w false = inl (λ i → true)
ur-lit : (A : Word → Nat) (df : Word → Bool) (w : Word) → UR A df (kqw w) (mwrap (cw w))
ur-lit A df w = ur-litb A df w (c-fits w)
vr-lit : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (GC : Word → CU) (CD : Word → Bool) (K : UE) (s : MSt) (w : Word) (t : CTy)
       → VR A df T t (kqw w) (uevT GC A CD K (cu-lit w t) s)
vr-lit A df T GC CD K s w ctw = λ hk → ur-word A df T (kqw w) (mwrap (cw w)) unit (ur-lit A df w)
vr-lit A df T GC CD K s w ctb = λ hk → ur-lit A df w
-- ---------------------------------------------------------------- the operations at a wanted type
vr-gate : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (q : KQ) (u : MV) (y : KQ) (K : CV → MV) → UR A df q u
        → ((c : CV) → CR A df q c → VR A df T t y (K c)) → VR A df T t y (if haslim u then mlim else K (m2c u))
vr-gate A df T t q u y K h hk =
  bool-split (haslim u) (VR A df T t y (if haslim u then mlim else K (m2c u)))
    (λ e → subst {lzero} {lzero} {Bool} {λ b → VR A df T t y (if b then mlim else K (m2c u))} {true} {haslim u} (sym e) (λ hw → inl (λ i → true)))
    (λ e → subst {lzero} {lzero} {Bool} {λ b → VR A df T t y (if b then mlim else K (m2c u))} {false} {haslim u} (sym e) (hk (m2c u) (ur-nl A df q u e h)))
-- ((c->n != 0) ? (a) : (b)): the branch the word picks
vr-sel : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (qc : KQ) (cc : CV) (qa : KQ) (ua : MV) (qb : KQ) (ub : MV) → CR A df qc cc
       → VR A df T t qa ua → VR A df T t qb ub → VR A df T t (q-if qc qa qb) (msel cc ua ub)
vr-sel A df T t (kqw w) cc qa ua qb ub hc ha hb =
  subst {lzero} {lzero} {CV} {λ v → VR A df T t (q-if (kqw w) qa qb) (msel v ua ub)} {cw w} {cc} (sym hc)
    (%welimP (λ x → VR A df T t (%welimP (λ x2 → KQ) x qb (λ m h → qa)) (%welimP (λ x2 → MV) x ub (λ m h → ua))) w hb (λ m h → ha))
vr-sel A df T t qc cc qa ua qb ub hc ha hb = vr-bot A df T t (msel cc ua ub)
vr-if : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (qc : KQ) (uc : MV) (qa : KQ) (ua : MV) (qb : KQ) (ub : MV) → UR A df qc uc
      → VR A df T t qa ua → VR A df T t qb ub → VR A df T t (q-if qc qa qb) (m-if uc ua ub)
vr-if A df T t qc uc qa ua qb ub hc ha hb = vr-gate A df T t qc uc (q-if qc qa qb) (λ v → msel v ua ub) hc (λ c h → vr-sel A df T t qc c qa ua qb ub h ha hb)
-- a case's alternative: the tag picked (b the test, its value given to the branch), the fields counted
vr-bsel : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (b : Bool) (X1 : KQ) (Y1 : MV) (X2 : KQ) (Y2 : MV)
        → (b ≡ true → VR A df T t X1 Y1) → VR A df T t X2 Y2 → VR A df T t (if b then X1 else X2) (if b then Y1 else Y2)
vr-bsel A df T t true X1 Y1 X2 Y2 h1 h2 = h1 (λ i → true)
vr-bsel A df T t false X1 Y1 X2 Y2 h1 h2 = h2
vr-cnt : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (bq bc : Bool) (X : KQ) (Y : MV) → (bq ≡ true → bc ≡ true) → (bq ≡ true → VR A df T t X Y)
       → VR A df T t (if bq then X else kqbot) (if bc then Y else mbot)
vr-cnt A df T t true bc X Y hb hx = subst {lzero} {lzero} {Bool} {λ v → VR A df T t X (if v then Y else mbot)} {true} {bc} (sym (hb (λ i → true))) (hx (λ i → true))
vr-cnt A df T t false bc X Y hb hx = vr-bot A df T t (if bc then Y else mbot)
-- the scrutinee x on top of the locals (msx), kx its kind; the branch gets the fields with their kinds
vr-alt0 : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (j : Word) (k d : Nat) (e : KQ) (s : MSt) (qx : KQ) (ux : MV) (kx : Kd) (cx : CV)
        (fb : KQ → KQ) (fbu : MSt → MV) (R : KQ) (Ru : MV) → Kv T kx qx → CR A df qx cx → VR A df T t R Ru
        → ((fs : KQ) (gs : CV) → q-isn k fs ≡ true → CR A df fs gs → kvs T fs (kfl T kx j k) → VR A df T t (fb (q-push fs e)) (fbu (ms-push (c2m gs) d (msx ux s))))
        → VR A df T t (q-altsel j k fb R (kqcons qx e)) (malt0 j k d fbu Ru (msx ux s) cx)
vr-alt0 A df T t j k d e s (kqcon dd i fs) ux kx (cvcon i2 gs) fb fbu R Ru hk h hr hb =
  subst {lzero} {lzero} {Word} {λ v → VR A df T t (if weq i j then (if q-isn k fs then fb (q-push fs e) else kqbot) else R) (if weq v j then (if c-isn k gs then fbu (ms-push (c2m gs) d (msx ux s)) else mbot) else Ru)} {i} {i2} (fst h)
    (vr-bsel A df T t (weq i j) (if q-isn k fs then fb (q-push fs e) else kqbot) (if c-isn k gs then fbu (ms-push (c2m gs) d (msx ux s)) else mbot) R Ru
       (λ ej → vr-cnt A df T t (q-isn k fs) (c-isn k gs) (fb (q-push fs e)) (fbu (ms-push (c2m gs) d (msx ux s))) (cr-isn A df k fs gs (snd h))
                 (λ en → hb fs gs en (snd h) (kfl-kv T kx j k dd i fs hk ej en))) hr)
vr-alt0 A df T t j k d e s (kqcon dd i fs) ux kx cx fb fbu R Ru hk h hr hb = Empty-rec h
vr-alt0 A df T t j k d e s qx ux kx cx fb fbu R Ru hk h hr hb = vr-bot A df T t (malt0 j k d fbu Ru (msx ux s) cx)
vr-alt : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (t : CTy) (j : Word) (k d : Nat) (e : KQ) (s : MSt) (qx : KQ) (ux : MV) (kx : Kd)
       (fb : KQ → KQ) (fbu : MSt → MV) (R : KQ) (Ru : MV) → Kv T kx qx → UR A df qx ux → VR A df T t R Ru
       → ((fs : KQ) (gs : CV) → q-isn k fs ≡ true → CR A df fs gs → kvs T fs (kfl T kx j k) → VR A df T t (fb (q-push fs e)) (fbu (ms-push (c2m gs) d (msx ux s))))
       → VR A df T t (q-altsel j k fb R (kqcons qx e)) (m-altsel j k d fbu Ru (msx ux s))
vr-alt A df T t j k d e s qx ux kx fb fbu R Ru hk h hr hb =
  vr-gate A df T t qx ux (q-altsel j k fb R (kqcons qx e)) (λ v → malt0 j k d fbu Ru (msx ux s) v) h (λ c hc → vr-alt0 A df T t j k d e s qx ux kx c fb fbu R Ru hk hc hr hb)
-- a loop's turn: a continuing state (tag 0, the state's k fields, of its kinds) goes on, a break gives
-- its field 0 (LB the body's kind facts as lib/foproofu.cub's Lr has them, by the test)
ur-lsb : (A : Word → Nat) (df : Word → Bool) (b q cb : Bool) (X : KQ) (Y : MV) (X2 : KQ) (Y2 : MV) (P P2 : Type) → (if b then q else true) ≡ true → (q ≡ true → cb ≡ true)
       → (if b then P else P2) → (q ≡ true → P → UR A df X Y) → UR A df X2 Y2 → UR A df (if b then X else X2) (if b then (if cb then Y else mbot) else Y2)
ur-lsb A df true q cb X Y X2 Y2 P P2 hl hq hp hx h2 = subst {lzero} {lzero} {Bool} {λ v → UR A df X (if v then Y else mbot)} {true} {cb} (sym (hq hl)) (hx hl hp)
ur-lsb A df false q cb X Y X2 Y2 P P2 hl hq hp hx h2 = h2
ur-ls0 : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (k : Nat) (st kr : Kd) (v : KQ) (c : CV) (cont : KQ → KQ) (cont2 : MV → MV) → CR A df v c → Lr T st kr v → lres k v ≡ true
       → ((x : KQ) (y : MV) → q-isn k x ≡ true → kvs T x st → UR A df x y → UR A df (cont x) (cont2 y)) → UR A df (q-lstep v cont) (mls0 k c cont2)
ur-ls0 A df T k st kr (kqcon d j fs) (cvcon i gs) cont cont2 h hl hr hc =
  subst {lzero} {lzero} {Word} {λ u → UR A df (if weq j #0 then cont fs else q-nth fs zero) (if weq u #0 then (if c-isn k gs then cont2 (c2m gs) else mbot) else c2m (c-nth gs zero))} {j} {i} (fst h)
    (ur-lsb A df (weq j #0) (q-isn k fs) (c-isn k gs) (cont fs) (cont2 (c2m gs)) (q-nth fs zero) (c2m (c-nth gs zero)) (kvs T fs st) (Kv T kr (q-nth fs zero)) hr (cr-isn A df k fs gs (snd h)) hl
       (λ hq hp → hc fs (c2m gs) hq hp (ur-c A df fs gs (snd h))) (ur-c A df (q-nth fs zero) (c-nth gs zero) (cr-nth A df fs gs (snd h) zero)))
ur-ls0 A df T k st kr (kqcon d j fs) c cont cont2 h hl hr hc = Empty-rec h
ur-ls0 A df T k st kr v c cont cont2 h hl hr hc = ur-bot A df (mls0 k c cont2)
ur-lstep : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (k : Nat) (st kr : Kd) (v : KQ) (u : MV) (cont : KQ → KQ) (cont2 : MV → MV) → UR A df v u → Lr T st kr v → lres k v ≡ true
         → ((x : KQ) (y : MV) → q-isn k x ≡ true → kvs T x st → UR A df x y → UR A df (cont x) (cont2 y)) → UR A df (q-lstep v cont) (m-lstep k u cont2)
ur-lstep A df T k st kr v u cont cont2 h hl hr hc = ur-gate A df v u (q-lstep v cont) (λ c → mls0 k c cont2) h (λ c h2 → ur-ls0 A df T k st kr v c cont cont2 h2 hl hr hc)
-- ---------------------------------------------------------------- a word primitive's operands
-- an operand wanted as a uint64_t, read back as a C cell: related where the value is a word (all a word
-- primitive reads)
WR : (Word → Nat) → (Word → Bool) → (Word → Word → Nat → Kd) → KQ → CV → Type
WR A df T q c = Kv T kw q → CR A df q c
WRL : (Word → Nat) → (Word → Bool) → (Word → Word → Nat → Kd) → KQ → CV → Type
WRL A df T (kqcons x r) (cvcons y v) = WR A df T x y × WRL A df T r v
WRL A df T kqnil c = c ≡ cvnil
WRL A df T q c = Empty
vrl-wr : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (qs : KQ) (us : MV) → haslim us ≡ false → VRL A df T qs us (λ i → ctw) → WRL A df T qs (m2c us)
vrl-wr A df T (kqcons x r) (mvcons y v) hl h = ((λ hk → ur-nl A df x y (mor-fl (haslim y) (haslim v) hl) (fst h hk)) , vrl-wr A df T r v (mor-fr (haslim y) (haslim v) hl) (snd h))
vrl-wr A df T (kqcons x r) us hl h = Empty-rec h
vrl-wr A df T kqnil mvnil hl h = λ i → cvnil
vrl-wr A df T kqnil us hl h = Empty-rec h
vrl-wr A df T qs us hl h = Empty-rec h
-- the word primitives' families: each refined on operands related where they are words (WRL), the
-- splits following the family's patterns; wrp-k the chain over cpq-k / cpc-k for a word primitive
wr-wwd : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → WRL A df T (kqcons (kqw p) (kqcons (kqw q) r)) cs → CR A df (q-ww f (kqcons (kqw p) (kqcons (kqw q) r))) (c-ww f cs)
wr-wwd A df T f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h unit t) (cvcons (fst (snd h) unit t) (snd (snd h) t)))
wr-wwd A df T f p q kqnil (cvcons x y) h = Empty-rec (snd h)
wr-wwd A df T f p q kqnil cs h = Empty-rec h
wr-wwd A df T f p q r cs h = unit
wr-wwc : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (b r : KQ) (cs : CV) → WRL A df T (kqcons (kqw p) (kqcons b r)) cs → CR A df (q-ww f (kqcons (kqw p) (kqcons b r))) (c-ww f cs)
wr-wwc A df T f p (kqw q) r cs h = wr-wwd A df T f p q r cs h
wr-wwc A df T f p b r cs h = unit
wr-wwb : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (r : KQ) (cs : CV) → WRL A df T (kqcons (kqw p) r) cs → CR A df (q-ww f (kqcons (kqw p) r)) (c-ww f cs)
wr-wwb A df T f p (kqcons b r) cs h = wr-wwc A df T f p b r cs h
wr-wwb A df T f p r cs h = unit
wr-wwa : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (a r : KQ) (cs : CV) → WRL A df T (kqcons a r) cs → CR A df (q-ww f (kqcons a r)) (c-ww f cs)
wr-wwa A df T f (kqw p) r cs h = wr-wwb A df T f p r cs h
wr-wwa A df T f a r cs h = unit
wr-ww : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (as : KQ) (cs : CV) → WRL A df T as cs → CR A df (q-ww f as) (c-ww f cs)
wr-ww A df T f (kqcons a r) cs h = wr-wwa A df T f a r cs h
wr-ww A df T f as cs h = unit
wr-iid : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) (cs : CV) → WRL A df T (kqcons (kqi p) (kqcons (kqi q) r)) cs → CR A df (q-ii f (kqcons (kqi p) (kqcons (kqi q) r))) (c-ww f cs)
wr-iid A df T f p q kqnil (cvcons x (cvcons y z)) h = λ t → c-ww f (cvcons (fst h unit t) (cvcons (fst (snd h) unit t) (snd (snd h) t)))
wr-iid A df T f p q kqnil (cvcons x y) h = Empty-rec (snd h)
wr-iid A df T f p q kqnil cs h = Empty-rec h
wr-iid A df T f p q r cs h = unit
