-- a word primitive on uint64_t operands: a limit in them answers a limit; otherwise its value refines
-- q-prim's (a word primitive on anything but words has none)
uw-prim : (A : Word → Nat) (df : Word → Bool) (T : Word → Word → Nat → Kd) (p : Word) (qs : KQ) (us : MV) → cu-wprim p ≡ true → VRL A df T qs us (λ i → ctw)
        → UR A df (q-prim p qs) (m-prim p us)
uw-prim A df T p qs us hw h =
  bool-split (haslim us) (UR A df (q-prim p qs) (m-prim p us))
    (λ e → subst {lzero} {lzero} {Bool} {λ b → UR A df (q-prim p qs) (if b then mlim else mprim0 p (m2c us))} {true} {haslim us} (sym e) (inl (λ i → true)))
    (λ e → subst {lzero} {lzero} {Bool} {λ b → UR A df (q-prim p qs) (if b then mlim else mprim0 p (m2c us))} {false} {haslim us} (sym e)
             (ur-mr A df (q-prim p qs) (c-prim p (m2c us)) (mprim0 p (m2c us)) (wrp-0 A df T p qs (m2c us) hw (vrl-wr A df T qs us e h)) (mr-prim0 p (m2c us))))
-- ---------------------------------------------------------------- the locals
-- the first-order environment e at depth d and the unboxed C's locals s: variable k below d refined by
-- its name v<d-1-k> (lib/foproofc.cub's Corr on C's words), nothing from d up
UCorr : (Word → Nat) → (Word → Bool) → Nat → KQ → MSt → Type
UCorr A df d e s = ((k : Nat) → q-le (suc k) d ≡ true → UR A df (q-nth e k) (ms-get s (ca-lvl d k))) × ((k : Nat) → q-le d k ≡ true → q-nth e k ≡ kqbot)
ucorr-nil : (A : Word → Nat) (df : Word → Bool) → UCorr A df zero kqnil msnil
ucorr-nil A df = ((λ k hk → Empty-rec (false≢true hk)) , (λ k hk → λ t → kqbot))
mget-hit : (m : Nat) (v : MV) (r : MSt) → ms-get (msb m v r) m ≡ v
mget-hit m v r = cong (λ b → if b then v else ms-get r m) (neqb-refl m)
mget-miss : (m l : Nat) (v : MV) (r : MSt) → neqb m l ≡ false → ms-get (msb m v r) l ≡ ms-get r l
mget-miss m l v r h = cong (λ b → if b then v else ms-get r l) h
bot-ext : (d : Nat) (e v : KQ) → ((k : Nat) → q-le d k ≡ true → q-nth e k ≡ kqbot) → (k : Nat) → q-le (suc d) k ≡ true → q-nth (kqcons v e) k ≡ kqbot
bot-ext d e v hb zero hk = Empty-rec (false≢true hk)
bot-ext d e v hb (suc k) hk = hb k hk
ucorr-e1 : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : MSt) (v : KQ) (u : MV) → UCorr A df d e s → UR A df v u → (k : Nat) → q-le (suc k) (suc d) ≡ true
         → UR A df (q-nth (kqcons v e) k) (ms-get (msb d u s) (ca-lvl (suc d) k))
ucorr-e1 A df d e s v u h hv zero hk = subst {lzero} {lzero} {MV} {λ x → UR A df v x} {u} {ms-get (msb d u s) d} (sym (mget-hit d u s)) hv
ucorr-e1 A df d e s v u h hv (suc k) hk =
  subst {lzero} {lzero} {Nat} {λ x → UR A df (q-nth e k) (ms-get (msb d u s) x)} {ca-lvl d k} {cn-sub d (suc k)} (sym (sub-suc d k))
    (subst {lzero} {lzero} {MV} {λ x → UR A df (q-nth e k) x} {ms-get s (ca-lvl d k)} {ms-get (msb d u s) (ca-lvl d k)}
       (sym (mget-miss d (ca-lvl d k) u s (neq-lt (ca-lvl d k) d (lt-lvl d k hk)))) (fst h k hk))
-- a declaration v<d> = u of a value refining v
ucorr-ext : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : MSt) (v : KQ) (u : MV) → UCorr A df d e s → UR A df v u → UCorr A df (suc d) (kqcons v e) (msb d u s)
ucorr-ext A df d e s v u h hv = (ucorr-e1 A df d e s v u h hv , bot-ext d e v (snd h))
-- a declaration of a name from d up hides none of the first d
ucorr-weaken : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : MSt) (m : Nat) (u : MV) → UCorr A df d e s → q-le d m ≡ true → UCorr A df d e (msb m u s)
ucorr-weaken A df d e s m u h hm =
  ((λ k hk → subst {lzero} {lzero} {MV} {λ x → UR A df (q-nth e k) x} {ms-get s (ca-lvl d k)} {ms-get (msb m u s) (ca-lvl d k)}
                (sym (mget-miss m (ca-lvl d k) u s (neq-lt (ca-lvl d k) m (q-le-trans (suc (ca-lvl d k)) d m (lt-lvl d k hk) hm)))) (fst h k hk)) ,
   snd h)
-- locals all limits refine any environment with nothing from d up
ucorr-lim : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) → ((k : Nat) → q-le d k ≡ true → q-nth e k ≡ kqbot) → UCorr A df d e mslim
ucorr-lim A df d e hb = ((λ k hk → inl (λ i → true)) , hb)
-- a chain of j values pushed: nothing from d + j up
push-bot : (j : Nat) (xs : KQ) (d : Nat) (e : KQ) → q-isn j xs ≡ true → ((k : Nat) → q-le d k ≡ true → q-nth e k ≡ kqbot) → (k : Nat) → q-le (qadd d j) k ≡ true → q-nth (q-push xs e) k ≡ kqbot
push-bot zero kqnil d e hj hb = hb
push-bot zero xs d e hj hb = Empty-rec (false≢true hj)
push-bot (suc j) (kqcons x r) d e hj hb =
  λ k hk → push-bot j r (suc d) (kqcons x e) hj (bot-ext d e x hb) k (subst {lzero} {lzero} {Nat} {λ u → q-le u k ≡ true} {suc (qadd d j)} {qadd (suc d) j} (sym (qadd-s d j)) hk)
push-bot (suc j) xs d e hj hb = Empty-rec (false≢true hj)
-- a chain of j values declared from v<d>, refining the chain pushed (without a limit: each declared)
push-ucorr0 : (A : Word → Nat) (df : Word → Bool) (j : Nat) (xs : KQ) (cs : CV) (d : Nat) (e : KQ) (s : MSt) → q-isn j xs ≡ true → CR A df xs cs → UCorr A df d e s
            → UCorr A df (qadd d j) (q-push xs e) (ms-push0 (c2m cs) d s)
push-ucorr0 A df zero kqnil cs d e s hj h he = subst {lzero} {lzero} {CV} {λ u → UCorr A df d e (ms-push0 (c2m u) d s)} {cvnil} {cs} (sym h) he
push-ucorr0 A df zero xs cs d e s hj h he = Empty-rec (false≢true hj)
push-ucorr0 A df (suc j) (kqcons x r) (cvcons y q) d e s hj h he =
  subst {lzero} {lzero} {Nat} {λ u → UCorr A df u (q-push r (kqcons x e)) (ms-push0 (c2m q) (suc d) (msb d (c2m y) s))} {qadd (suc d) j} {suc (qadd d j)} (qadd-s d j)
    (push-ucorr0 A df j r q (suc d) (kqcons x e) (msb d (c2m y) s) hj (snd h) (ucorr-ext A df d e s x (c2m y) he (ur-c A df x y (fst h))))
push-ucorr0 A df (suc j) (kqcons x r) cs d e s hj h he = Empty-rec h
push-ucorr0 A df (suc j) xs cs d e s hj h he = Empty-rec (false≢true hj)
push-ucorr : (A : Word → Nat) (df : Word → Bool) (j : Nat) (xs : KQ) (us : MV) (d : Nat) (e : KQ) (s : MSt) → q-isn j xs ≡ true → UR A df xs us → UCorr A df d e s
           → UCorr A df (qadd d j) (q-push xs e) (ms-push us d s)
push-ucorr A df j xs us d e s hj (inl p) he =
  subst {lzero} {lzero} {Bool} {λ b → UCorr A df (qadd d j) (q-push xs e) (if b then mslim else ms-push0 us d s)} {true} {haslim us} (sym p)
    (ucorr-lim A df (qadd d j) (q-push xs e) (push-bot j xs d e hj (snd he)))
push-ucorr A df j xs us d e s hj (inr p) he =
  subst {lzero} {lzero} {MV} {λ u → UCorr A df (qadd d j) (q-push xs e) (ms-push u d s)} {c2m (fst p)} {us} (sym (snd (snd p)))
    (subst {lzero} {lzero} {Bool} {λ b → UCorr A df (qadd d j) (q-push xs e) (if b then mslim else ms-push0 (c2m (fst p)) d s)} {false} {haslim (c2m (fst p))} (sym (c2m-nl (fst p)))
       (push-ucorr0 A df j xs (fst p) d e s hj (fst (snd p)) he))
-- a variable's value
uvar-ok : (A : Word → Nat) (df : Word → Bool) (d : Nat) (e : KQ) (s : MSt) (k : Nat) → UCorr A df d e s → UR A df (q-nth e k) (ms-get s (ca-lvl d k))
uvar-ok A df d e s k h =
  bool-split (q-le (suc k) d) (UR A df (q-nth e k) (ms-get s (ca-lvl d k)))
    (λ eb → fst h k eb)
    (λ eb → subst {lzero} {lzero} {KQ} {λ v → UR A df v (ms-get s (ca-lvl d k))} {kqbot} {q-nth e k} (sym (snd h k (le-flip k d eb))) (ur-bot A df (ms-get s (ca-lvl d k))))
-- apply's callee: f_g(f->f[0], ..., a)
uap-corr : (A : Word → Nat) (df : Word → Bool) (m : Nat) (env : KQ) (caps : CV) (a : KQ) (ua : MV) → q-isar m env ≡ true → CR A df env caps → UR A df a ua
         → UCorr A df m (kqcons a (q-push env kqnil)) (m-apenv m ua (c2m caps))
uap-corr A df zero env caps a ua hi h ha = Empty-rec (false≢true hi)
uap-corr A df (suc m) env caps a ua hi h ha =
  ucorr-ext A df m (q-push env kqnil) (ms-push (c2m caps) zero msnil) a ua
    (subst {lzero} {lzero} {Nat} {λ u → UCorr A df u (q-push env kqnil) (ms-push (c2m caps) zero msnil)} {qadd zero m} {m} (qadd-0l m)
       (push-ucorr A df m env (c2m caps) zero kqnil msnil hi (ur-c A df env caps h) (ucorr-nil A df))) ha
-- a closure's target: its parameters' kinds anything, so any arguments have them
allk-ext : (T : Word → Word → Nat → Kd) (Γ : Nat → Kd) → ((n : Nat) (v : KQ) → Kv T (Γ n) v) → (n : Nat) (v : KQ) → Kv T (kext Γ ka n) v
allk-ext T Γ h n v = (case n return (λ m → Kv T (kext Γ ka m) v) of zero → unit; suc m → h m v)
allk-anys : (T : Word → Word → Nat → Kd) (m : Nat) (Γ : Nat → Kd) → ((n : Nat) (v : KQ) → Kv T (Γ n) v) → (n : Nat) (v : KQ) → Kv T (kpush (kanys m) Γ n) v
allk-anys T zero Γ h = h
allk-anys T (suc m) Γ h = allk-anys T m (kext Γ ka) (allk-ext T Γ h)
envk-dc : (S : KS) (A : Word → Nat) (g : Word) (e : KQ) → ks-SK S g ≡ kanys (A g) → EnvK (ks-T S) (spk S g) e
envk-dc S A g e h =
  subst {lzero} {lzero} {Kd} {λ K → EnvK (ks-T S) (kpush K (λ n → ka)) e} {kanys (A g)} {ks-SK S g} (sym h)
    (λ n → allk-anys (ks-T S) (A g) (λ n2 → ka) (λ n2 v → unit) n (q-nth e n))
-- ---------------------------------------------------------------- what the translation needs
-- lib/foproofc.cub's ca-ok, a closure's key also a closure target (dc: its dispatcher case, its
-- parameters' kinds anything)
uok : (Word → Nat) → (Word → Bool) → (Word → Bool) → FQ → CK → Bool
uok A df dc (fql w) m = ck-t m
uok A df dc (fqv n) m = ck-t m
uok A df dc (fqprim p as) m = andbt (ck-t m) (uok A df dc as ckl)
uok A df dc (fqlet a b) m = andbt (ck-t m) (andbt (uok A df dc a ckt) (uok A df dc b ckt))
uok A df dc (fqcon dd c fs) m = andbt (ck-t m) (uok A df dc fs ckl)
uok A df dc (fqproj dd c k x) m = andbt (ck-t m) (uok A df dc x ckt)
uok A df dc (fqsw x alts) m = andbt (ck-t m) (andbt (uok A df dc x ckt) (uok A df dc alts cka))
uok A df dc (fqif c a b) m = andbt (ck-t m) (andbt (uok A df dc c ckt) (andbt (uok A df dc a ckt) (uok A df dc b ckt)))
uok A df dc (fqclos g env) m = andbt (ck-t m) (andbt (dc g) (andbt (wlt g #1000000) (andbt (fq-isar (A g) env) (uok A df dc env ckl))))
uok A df dc (fqlam b) m = false
uok A df dc (fqapp f as) m = andbt (ck-t m) (andbt (uok A df dc f ckt) (uok A df dc as ckl))
uok A df dc (fqcall g as) m = andbt (ck-t m) (andbt (df g) (andbt (fq-isn (A g) as) (uok A df dc as ckl)))
uok A df dc (fqloop init b) m = andbt (ck-t m) (andbt (uok A df dc init ckl) (andbt (lbok (fq-len init) b) (uok A df dc b ckt)))
uok A df dc fqnil m = ck-l m
uok A df dc (fqcons x r) m = andbt (ck-l m) (andbt (uok A df dc x ckt) (uok A df dc r ckl))
uok A df dc (fqalt j n b r) m = andbt (ck-a m) (andbt (uok A df dc b ckt) (uok A df dc r cka))
uok A df dc fqanone m = ck-ta m
uok A df dc fqnet m = ck-t m
uok-len : (A : Word → Nat) (df dc : Word → Bool) (t : FQ) → uok A df dc t ckl ≡ true → fq-isn (fq-len t) t ≡ true
uok-len A df dc fqnil h = λ i → true
uok-len A df dc (fqcons x r) h = uok-len A df dc r (andr (uok A df dc x ckt) (uok A df dc r ckl) h)
uok-len A df dc t h = Empty-rec (false≢true h)
-- ---------------------------------------------------------------- calls, closures applied, loops
-- the calls at fuel n refined: every defined key's body, in refining parameters of its kinds
UCallOK : KS → (Word → Nat) → (Word → Bool) → (Word → Bool) → (Word → Bool) → (Word → FQ) → (Word → CU) → Nat → Type
UCallOK S A df dc CD G GC n = (g : Word) (e2 : KQ) (s2 : MSt) → df g ≡ true → UCorr A dc (A g) e2 s2 → EnvK (ks-T S) (spk S g) e2
  → UR A dc (qe-ev (qeN G n) (G g) e2) (ue-ev (ueN GC A CD n) (GC g) s2)
ur-ap0 : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
       → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → UCallOK S A df dc CD G GC n
       → (f : KQ) (cf : CV) (a : KQ) (ua : MV) → CR A dc f cf → UR A dc a ua → UR A dc (q-ap1 G (qeN G n) f a) (uap0 GC A CD (ueN GC A CD n) cf ua)
ur-ap0 S A df dc CD G GC n hcd hdf hsk co (kqclos g env) (cclo g2 caps) a ua h ha =
  subst {lzero} {lzero} {Word} {λ x → UR A dc (qe-ev (qeN G n) (G g) (kqcons a (q-push env kqnil))) (if andbt (CD x) (andbt (wlt x #1000000) (c-isar (A x) caps)) then ue-ev (ueN GC A CD n) (GC x) (m-apenv (A x) ua (c2m caps)) else mbot)} {g} {g2} (fst (fst h))
    (subst {lzero} {lzero} {Bool} {λ b → UR A dc (qe-ev (qeN G n) (G g) (kqcons a (q-push env kqnil))) (if b then ue-ev (ueN GC A CD n) (GC g) (m-apenv (A g) ua (c2m caps)) else mbot)} {true} {andbt (CD g) (andbt (wlt g #1000000) (c-isar (A g) caps))}
       (sym (clo-c A dc CD hcd g env caps (snd (fst h)) (snd h)))
       (co g (kqcons a (q-push env kqnil)) (m-apenv (A g) ua (c2m caps)) (hdf g (clo-df A dc g env (snd (fst h)))) (uap-corr A dc (A g) env caps a ua (clo-ar A dc g env (snd (fst h))) (snd h) ha)
          (envk-dc S A g (kqcons a (q-push env kqnil)) (hsk g (clo-df A dc g env (snd (fst h)))))))
ur-ap0 S A df dc CD G GC n hcd hdf hsk co (kqclos g env) cf a ua h ha = Empty-rec h
ur-ap0 S A df dc CD G GC n hcd hdf hsk co (kqlam b env) cf a ua h ha = Empty-rec h
ur-ap0 S A df dc CD G GC n hcd hdf hsk co f cf a ua h ha = ur-bot A dc (uap0 GC A CD (ueN GC A CD n) cf ua)
ur-ap1 : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
       → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → UCallOK S A df dc CD G GC n
       → (f : KQ) (uf : MV) (a : KQ) (ua : MV) → UR A dc f uf → UR A dc a ua → UR A dc (q-ap1 G (qeN G n) f a) (u-ap1 GC A CD (ueN GC A CD n) uf ua)
ur-ap1 S A df dc CD G GC n hcd hdf hsk co f uf a ua hf ha =
  ur-gate A dc f uf (q-ap1 G (qeN G n) f a) (λ v → uap0 GC A CD (ueN GC A CD n) v ua) hf (λ c hc → ur-ap0 S A df dc CD G GC n hcd hdf hsk co f c a ua hc ha)
ur-app : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
       → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → UCallOK S A df dc CD G GC n
       → (m : Nat) (as : KQ) (cs : CV) (f : KQ) (uf : MV) → q-isn m as ≡ true → CR A dc as cs → UR A dc f uf → UR A dc (q-app G (qeN G n) as f) (uapl0 GC A CD (ueN GC A CD n) cs uf)
ur-app S A df dc CD G GC n hcd hdf hsk co (suc m) (kqcons a r) (cvcons a2 q) f uf hm h hf =
  ur-app S A df dc CD G GC n hcd hdf hsk co m r q (q-ap1 G (qeN G n) f a) (u-ap1 GC A CD (ueN GC A CD n) uf (c2m a2)) hm (snd h)
    (ur-ap1 S A df dc CD G GC n hcd hdf hsk co f uf a (c2m a2) hf (ur-c A dc a a2 (fst h)))
ur-app S A df dc CD G GC n hcd hdf hsk co zero kqnil cs f uf hm h hf = subst {lzero} {lzero} {CV} {λ u → UR A dc f (uapl0 GC A CD (ueN GC A CD n) u uf)} {cvnil} {cs} (sym h) hf
ur-app S A df dc CD G GC n hcd hdf hsk co (suc m) (kqcons a r) cs f uf hm h hf = Empty-rec h
ur-app S A df dc CD G GC n hcd hdf hsk co m as cs f uf hm h hf = Empty-rec (false≢true hm)
ur-appl : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
        → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → UCallOK S A df dc CD G GC n
        → (m : Nat) (as : KQ) (us : MV) (f : KQ) (uf : MV) → q-isn m as ≡ true → UR A dc as us → UR A dc f uf → UR A dc (q-app G (qeN G n) as f) (u-appl GC A CD (ueN GC A CD n) us uf)
ur-appl S A df dc CD G GC n hcd hdf hsk co m as us f uf hm h hf =
  ur-gate A dc as us (q-app G (qeN G n) as f) (λ v → uapl0 GC A CD (ueN GC A CD n) v uf) h (λ c hc → ur-app S A df dc CD G GC n hcd hdf hsk co m as c f uf hm hc hf)
-- the loops at fuel n refined: from a state of k values of the state's kinds stk refining one another,
-- a body answering its state's shape and meeting the conditions, in refining environments of their kinds
ULoopOK : KS → (Word → Nat) → (Word → Bool) → (Word → Bool) → (Word → Bool) → (Word → FQ) → (Word → CU) → Nat → Type
ULoopOK S A df dc CD G GC n = (k : Nat) (st : KQ) (ust : MV) (b : FQ) (d : Nat) (e : KQ) (s : MSt) (stk : Kd) (Γ : Nat → Kd) (C : Nat → CTy)
  → q-isn k st ≡ true → UR A dc st ust → uok A df dc b ckt ≡ true → lbok k b ≡ true → kok S df b (kmb stk) (kpush stk Γ) ≡ true → UCorr A dc d e s → kvs (ks-T S) st stk → EnvK (ks-T S) Γ e
  → UR A dc (qe-lp (qeN G n) st b e) (ue-lp (ueN GC A CD n) d k ust (fq-to-cu S b ckt (kpush stk Γ) (ct-push k d C) (qadd d k) (λ i → ctb)) s)
-- ---------------------------------------------------------------- the theorem
-- the modes: a term, a list, alternatives (the scrutinee on top), a loop's state declared from v<l>, a
-- loop's body (a term, its kinds' conditions those of a body of state kinds st)
data UM = umt | uml | uma | umd (l : Nat) | umb (st : Kd)
um-ok : UM → CK
um-ok umt = ckt
um-ok uml = ckl
um-ok uma = cka
um-ok (umd l) = ckl
um-ok (umb st) = ckt
um-km : UM → KM
um-km umt = kmt
um-km uml = kml
um-km uma = kmt
um-km (umd l) = kml
um-km (umb st) = kmb st
-- the extra premise of each mode: for alternatives the scrutinee refined, for declarations from v<l> l
-- from d up
UPre : (Word → Nat) → (Word → Bool) → UM → Nat → Type
UPre A dc umt d = Unit
UPre A dc uml d = Unit
UPre A dc uma d = (v : KQ) × ((u : MV) × UR A dc v u)
UPre A dc (umd l) d = q-le d l ≡ true
UPre A dc (umb st) d = Unit
-- the environment the kinds see (for alternatives, the scrutinee on top)
UEnv : KS → (A : Word → Nat) → (dc : Word → Bool) → (m : UM) → (d : Nat) → (Nat → Kd) → KQ → UPre A dc m d → Type
UEnv S A dc umt d Γ e x = EnvK (ks-T S) Γ e
UEnv S A dc uml d Γ e x = EnvK (ks-T S) Γ e
UEnv S A dc uma d Γ e x = EnvK (ks-T S) Γ (kqcons (fst x) e)
UEnv S A dc (umd l) d Γ e x = EnvK (ks-T S) Γ e
UEnv S A dc (umb st) d Γ e x = EnvK (ks-T S) Γ e
UGoal : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) (m : UM) (t : FQ) (Γ : Nat → Kd) (C : Nat → CTy) (d : Nat) (e : KQ) (s : MSt) (W : Nat → CTy) → UPre A dc m d → Type
UGoal S A df dc CD G GC n umt t Γ C d e s W x = VR A dc (ks-T S) (W zero) (evT G (qeN G n) t e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S t ckt Γ C d W) s)
UGoal S A df dc CD G GC n uml t Γ C d e s W x = VRL A dc (ks-T S) (evT G (qeN G n) t e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S t ckl Γ C d W) s) W
UGoal S A df dc CD G GC n uma t Γ C d e s W x = VR A dc (ks-T S) (W zero) (evT G (qeN G n) t (kqcons (fst x) e)) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S t cka Γ C d W) (msx (fst (snd x)) s))
UGoal S A df dc CD G GC n (umd l) t Γ C d e s W x = VRL A dc (ks-T S) (evT G (qeN G n) t e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S t (ckd l) Γ C d W) s) W
UGoal S A df dc CD G GC n (umb st) t Γ C d e s W x = VR A dc (ks-T S) (W zero) (evT G (qeN G n) t e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S t ckt Γ C d W) s)
-- every form at fuel n, given the kinds, the calls and the loops at fuel n
ustep : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
      → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → KThm S df G n → UCallOK S A df dc CD G GC n → ULoopOK S A df dc CD G GC n
      → (t : FQ) (m : UM) (Γ : Nat → Kd) (C : Nat → CTy) (d : Nat) (e : KQ) (s : MSt) (W : Nat → CTy) → uok A df dc t (um-ok m) ≡ true → kok S df t (um-km m) Γ ≡ true → UCorr A dc d e s
      → (x : UPre A dc m d) → UEnv S A dc m d Γ e x → UGoal S A df dc CD G GC n m t Γ C d e s W x
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fql w) umt Γ C d e s W hu hk h x he =
  vr-lit A dc (ks-T S) GC CD (ueN GC A CD n) s w (W zero)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqv k) umt Γ C d e s W hu hk h x he =
  ucv A dc (ks-T S) GC CD (ueN GC A CD n) (cuv (ca-lvl d k)) s (C (ca-lvl d k)) (W zero) (q-nth e k) (uvar-ok A dc d e s k h)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqprim p as) umt Γ C d e s W hu hk h x he =
  bif-el (λ X → VR A dc (ks-T S) (W zero) (q-prim p (evT G (qeN G n) as e)) (uevT GC A CD (ueN GC A CD n) X s)) (cu-wprim p) (cu-conv ctw (W zero) (cupw p (fq-to-cu S as ckl Γ C d (λ i → ctw)))) (cu-conv ctb (W zero) (cuprim p (fq-to-cu S as ckl Γ C d (λ i → ctb))))
    (λ hw → ucv A dc (ks-T S) GC CD (ueN GC A CD n) (cupw p (fq-to-cu S as ckl Γ C d (λ i → ctw))) s ctw (W zero) (q-prim p (evT G (qeN G n) as e)) (uw-prim A dc (ks-T S) p (evT G (qeN G n) as e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S as ckl Γ C d (λ i → ctw)) s) hw (ustep S A df dc CD G GC n hcd hdf hsk kt co lo as uml Γ C d e s (λ i → ctw) hu hk h unit he)))
    (λ hw → ucv A dc (ks-T S) GC CD (ueN GC A CD n) (cuprim p (fq-to-cu S as ckl Γ C d (λ i → ctb))) s ctb (W zero) (q-prim p (evT G (qeN G n) as e)) (ur-prim A dc p (evT G (qeN G n) as e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S as ckl Γ C d (λ i → ctb)) s) (vrl-b A dc (ks-T S) (evT G (qeN G n) as e) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S as ckl Γ C d (λ i → ctb)) s) (ustep S A df dc CD G GC n hcd hdf hsk kt co lo as uml Γ C d e s (λ i → ctb) hu hk h unit he))))
