-- the theorem at fuel n
UThm : KS → (Word → Nat) → (Word → Bool) → (Word → Bool) → (Word → Bool) → (Word → FQ) → (Word → CU) → Nat → Type
UThm S A df dc CD G GC n = (t : FQ) (m : UM) (Γ : Nat → Kd) (C : Nat → CTy) (d : Nat) (e : KQ) (s : MSt) (W : Nat → CTy) → uok A df dc t (um-ok m) ≡ true → kok S df t (um-km m) Γ ≡ true
  → UCorr A dc d e s → (x : UPre A dc m d) → UEnv S A dc m d Γ e x → UGoal S A df dc CD G GC n m t Γ C d e s W x
-- one unit of fuel up: a defined key's body, translated at its kinds (fq-to-cu-def), in refining
-- parameters of its parameters' kinds, refines its first-order meaning in full (its value has its
-- result's kind)
ucall-up : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat)
         → ((g : Word) → df g ≡ true → uok A df dc (G g) ckt ≡ true) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true)
         → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true) → ((g : Word) → df g ≡ true → GC g ≡ fq-to-cu-def S g (A g) (G g))
         → KThm S df G n → UThm S A df dc CD G GC n → UCallOK S A df dc CD G GC (suc n)
ucall-up S A df dc CD G GC n tu tk tle lk kt th g e2 s2 hd h he =
  subst {lzero} {lzero} {CU} {λ X → UR A dc (evT G (qeN G n) (G g) e2) (uevT GC A CD (ueN GC A CD n) X s2)} {fq-to-cu-def S g (A g) (G g)} {GC g} (sym (lk g hd))
    (vr-k A dc (ks-T S) (ks-SR S g) (evT G (qeN G n) (G g) e2) (uevT GC A CD (ueN GC A CD n) (fq-to-cu-def S g (A g) (G g)) s2)
       (kle-sound (ks-T S) (ksyn S (G g) kmt (spk S g)) (ks-SR S g) (evT G (qeN G n) (G g) e2) (tle g hd) (kt (G g) kmt (spk S g) e2 (tk g hd) he))
       (th (G g) umt (spk S g) (cu-pt S g) (A g) e2 s2 (λ i → cu-rt S g) (tu g hd) (tk g hd) h unit he))
-- one unit of fuel up: a loop's turn, its body at n (the continuing state's kinds from its body's, kind-sound
-- in a loop body's mode)
uloop-up : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) (n : Nat) → KThm S df G n → UThm S A df dc CD G GC n → ULoopOK S A df dc CD G GC n
         → ULoopOK S A df dc CD G GC (suc n)
uloop-up S A df dc CD G GC n kt th lo k st ust b d e s stk Γ C hq hst hu hl hk h hkv he =
  ur-lstep A dc (ks-T S) k stk (ksyn S b (kmb stk) (kpush stk Γ)) (evT G (qeN G n) b (q-push st e))
    (uevT GC A CD (ueN GC A CD n) (fq-to-cu S b ckt (kpush stk Γ) (ct-push k d C) (qadd d k) (λ i → ctb)) (ms-push ust d s))
    (λ st2 → qe-lp (qeN G n) st2 b e) (λ st2 → ue-lp (ueN GC A CD n) d k st2 (fq-to-cu S b ckt (kpush stk Γ) (ct-push k d C) (qadd d k) (λ i → ctb)) s)
    (vr-b A dc (ks-T S) (evT G (qeN G n) b (q-push st e)) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S b ckt (kpush stk Γ) (ct-push k d C) (qadd d k) (λ i → ctb)) (ms-push ust d s))
       (th b (umb stk) (kpush stk Γ) (ct-push k d C) (qadd d k) (q-push st e) (ms-push ust d s) (λ i → ctb) hu hk (push-ucorr A dc k st ust d e s hq hst h) unit (envk-push (ks-T S) st stk Γ e hkv he)))
    (kt b (kmb stk) (kpush stk Γ) (q-push st e) hk (envk-push (ks-T S) st stk Γ e hkv he))
    (lb-res G (qeN G n) k b (q-push st e) hl)
    (λ x y hx hkx hxy → lo k x y b d e s stk Γ C hx hxy hu hl hk h hkx he)
ucoks : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
      → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → ((g : Word) → df g ≡ true → uok A df dc (G g) ckt ≡ true) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true)
      → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true) → ((g : Word) → df g ≡ true → GC g ≡ fq-to-cu-def S g (A g) (G g))
      → (n : Nat) → UCallOK S A df dc CD G GC n × ULoopOK S A df dc CD G GC n
ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk zero = ((λ g e2 s2 hd h he → ur-bot A dc mbot) , (λ k st ust b d e s stk Γ C hq hst hu hl hk h hkv he → ur-bot A dc mbot))
ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk (suc n) =
  (ucall-up S A df dc CD G GC n tu tk tle lk (kind-sound S df G tk tle n)
     (ustep S A df dc CD G GC n hcd hdf hsk (kind-sound S df G tk tle n) (fst (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n)) (snd (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n))) ,
   uloop-up S A df dc CD G GC n (kind-sound S df G tk tle n)
     (ustep S A df dc CD G GC n hcd hdf hsk (kind-sound S df G tk tle n) (fst (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n)) (snd (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n)))
     (snd (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n)))
-- the theorem: at every fuel, every term meeting the conditions (uok, and U1's kok in an environment of its
-- kinds), in refining locals, its unboxed translation refines its first-order meaning wherever the
-- wanted C type's condition holds (G the first-order table, A its parameter counts, df its defined keys,
-- dc the closure targets, CD the dispatcher's keys, S U1's tables: every defined key's body meeting the
-- conditions in its parameters' kinds, of its result's kind; GC the unboxed functions: each defined
-- key's body translated at its kinds)
cu-sound : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
         → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → ((g : Word) → df g ≡ true → uok A df dc (G g) ckt ≡ true) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true)
         → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true) → ((g : Word) → df g ≡ true → GC g ≡ fq-to-cu-def S g (A g) (G g))
         → (n : Nat) → UThm S A df dc CD G GC n
cu-sound S A df dc CD G GC hcd hdf hsk tu tk tle lk n =
  ustep S A df dc CD G GC n hcd hdf hsk (kind-sound S df G tk tle n) (fst (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n)) (snd (ucoks S A df dc CD G GC hcd hdf hsk tu tk tle lk n))
-- for a term translated at its kind's C type (as fq-to-cu-def translates a body and U2 a main): at every
-- fuel, the unboxed C's value refines evq's in full, a limit hit or a C value CR relates
cu-sound-k : (S : KS) (A : Word → Nat) (df dc CD : Word → Bool) (G : Word → FQ) (GC : Word → CU) → ((g : Word) → dc g ≡ true → CD g ≡ true) → ((g : Word) → dc g ≡ true → df g ≡ true)
           → ((g : Word) → dc g ≡ true → ks-SK S g ≡ kanys (A g)) → ((g : Word) → df g ≡ true → uok A df dc (G g) ckt ≡ true) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true)
           → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true) → ((g : Word) → df g ≡ true → GC g ≡ fq-to-cu-def S g (A g) (G g))
           → (n : Nat) (t : FQ) (Γ : Nat → Kd) (C : Nat → CTy) (d : Nat) (e : KQ) (s : MSt) → uok A df dc t ckt ≡ true → kok S df t kmt Γ ≡ true → UCorr A dc d e s → EnvK (ks-T S) Γ e
           → UR A dc (evq G n t e) (evcu GC A CD n (fq-to-cu S t ckt Γ C d (λ i → ct-of (ksyn S t kmt Γ))) s)
cu-sound-k S A df dc CD G GC hcd hdf hsk tu tk tle lk n t Γ C d e s hu hk h he =
  vr-k A dc (ks-T S) (ksyn S t kmt Γ) (evq G n t e) (evcu GC A CD n (fq-to-cu S t ckt Γ C d (λ i → ct-of (ksyn S t kmt Γ))) s) (kind-sound S df G tk tle n t kmt Γ e hk he)
    (cu-sound S A df dc CD G GC hcd hdf hsk tu tk tle lk n t umt Γ C d e s (λ i → ct-of (ksyn S t kmt Γ)) hu hk h unit he)
-- ---------------------------------------------------------------- read at a word, against the boxed link
-- a word refined: the unboxed C's value is a limit hit or that word
cu-word : (A : Word → Nat) (df : Word → Bool) (w : Word) (u : MV) → UR A df (kqw w) u → Sum (haslim u ≡ true) (u ≡ mw w)
cu-word A df w u (inl p) = inl p
cu-word A df w u (inr p) = inr (snd (snd p) ∙ cong c2m (fst (snd p)))
-- when the first-order form answers a word, the boxed C (refined: lib/foproofm.cub's CRC) and the unboxed
-- C (refined: UR) each answer it or hit a limit
cu-agree : (A : Word → Nat) (df dc : Word → Bool) (w : Word) (m u : MV) → CRC A df (kqw w) m → UR A dc (kqw w) u → Sum (haslim m ≡ true) (m ≡ mw w) × Sum (haslim u ≡ true) (u ≡ mw w)
cu-agree A df dc w m u hm hu = (cm-word (fst hm) m w (fst (snd hm)) (snd (snd hm)) , cu-word A dc w u hu)
-- ---------------------------------------------------------------- a program's keys, by computation
-- a decision over the keys (lib/foproofu.cub's kmemu), per key
kallu : (Word → Bool) → List Word → Bool
kallu p nil = true
kallu p (cons k r) = andbt (p k) (kallu p r)
ukeys-ok : (p : Word → Bool) (ks0 : List Word) → kallu p ks0 ≡ true → (g : Word) → kmemu g ks0 ≡ true → p g ≡ true
ukeys-ok p nil ha g hm = Empty-rec (false≢true hm)
ukeys-ok p (cons k r) ha g hm =
  bool-split (weq g k) (p g ≡ true)
    (λ h → subst {lzero} {lzero} {Word} {λ x → p x ≡ true} {k} {g} (sym (weq-sound g k h)) (andl (p k) (kallu p r) ha))
    (λ h → ukeys-ok p r (andr (p k) (kallu p r) ha) g (kmemu-miss g k r h hm))
-- ---------------------------------------------------------------- the word route
-- no table (no key defined), the main of one word parameter v0, a uint64_t; S the main's kinds (its
-- constructors' field kinds: U1's kinfer from the main, no key)
cu-g1 : Nat → Kd
cu-g1 = kpush (kcons kw knil) (λ n → ka)
cu-c1 : Nat → CTy
cu-c1 l = ct-of (knth (kcons kw knil) l)
-- a value below a word, with a value, refined: that word or a limit
qw-u : (A : Word → Nat) (df : Word → Bool) (v : KQ) (u : MV) (w : Word) → qle-w v w → UR A df v u → kq-nb v → Sum (haslim u ≡ true) (u ≡ mw w)
qw-u A df (kqw x) u w hq h hn = cu-word A df w u (subst {lzero} {lzero} {Word} {λ y → UR A df (kqw y) u} {x} {w} (qw-inj x w hq) h)
qw-u A df kqbot u w hq h hn = Empty-rec hn
qw-u A df v u w hq h hn = Empty-rec hq
-- the word route, end to end, to the unboxed C: whenever the first-order form has a value at x, the
-- unboxed C's value at x is a limit hit or the word the source code computes at x
cu-fw-path : (S : KS) (r : VRule) (c : WC) (x : Word) (N : Nat) → uok (λ g → zero) (λ g → false) (λ g → false) (fw-to-fq (spec-w r c)) ckt ≡ true → kok S (λ g → false) (fw-to-fq (spec-w r c)) kmt cu-g1 ≡ true
           → kq-nb (evq (λ g → fqnet) N (fw-to-fq (spec-w r c)) (kqcons (kqw x) kqnil))
           → Sum (haslim (evcu (λ g → cuunsup) (λ g → zero) (λ g → false) N (fq-to-cu S (fw-to-fq (spec-w r c)) ckt cu-g1 cu-c1 (suc zero) (λ i → ct-of (ksyn S (fw-to-fq (spec-w r c)) kmt cu-g1))) (msb zero (mw x) msnil)) ≡ true)
                 (evcu (λ g → cuunsup) (λ g → zero) (λ g → false) N (fq-to-cu S (fw-to-fq (spec-w r c)) ckt cu-g1 cu-c1 (suc zero) (λ i → ct-of (ksyn S (fw-to-fq (spec-w r c)) kmt cu-g1))) (msb zero (mw x) msnil) ≡ mw (wc-ev c (envx x)))
cu-fw-path S r c x N hu hk hn =
  qw-u (λ g → zero) (λ g → false) (evq (λ g → fqnet) N (fw-to-fq (spec-w r c)) (kqcons (kqw x) kqnil))
    (evcu (λ g → cuunsup) (λ g → zero) (λ g → false) N (fq-to-cu S (fw-to-fq (spec-w r c)) ckt cu-g1 cu-c1 (suc zero) (λ i → ct-of (ksyn S (fw-to-fq (spec-w r c)) kmt cu-g1))) (msb zero (mw x) msnil))
    (wc-ev c (envx x)) (fw-path r c (λ g → fqnet) (envx x) (kqcons (kqw x) kqnil) N (fenv-x x))
    (cu-sound-k S (λ g → zero) (λ g → false) (λ g → false) (λ g → false) (λ g → fqnet) (λ g → cuunsup)
       (no-df (λ g → (λ u → false) g ≡ true)) (no-df (λ g → (λ u → false) g ≡ true)) (no-df (λ g → ks-SK S g ≡ kanys zero))
       (no-df (λ g → uok (λ u → zero) (λ u → false) (λ u → false) fqnet ckt ≡ true)) (no-df (λ g → kok S (λ u → false) fqnet kmt (spk S g) ≡ true))
       (no-df (λ g → kle (ksyn S fqnet kmt (spk S g)) (ks-SR S g) ≡ true)) (no-df (λ g → cuunsup ≡ fq-to-cu-def S g zero fqnet))
       N (fw-to-fq (spec-w r c)) cu-g1 cu-c1 (suc zero) (kqcons (kqw x) kqnil) (msb zero (mw x) msnil) hu hk
       (ucorr-ext (λ g → zero) (λ g → false) zero kqnil msnil (kqw x) (mw x) (ucorr-nil (λ g → zero) (λ g → false)) (ur-c (λ g → zero) (λ g → false) (kqw x) (cw x) (λ i → cw x)))
       (envk-ext (ks-T S) (λ n → ka) kw (kqw x) kqnil (λ n → unit) unit))
    hn
