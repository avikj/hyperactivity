       (klle-sound (ks-T S) (evT G (qeN G n) init e) (ksyn S init kmt Γ) (lst S Γ init b) (andl (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ)) (andr (kok S df init kml Γ) (andbt (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ))) hk)) (kt init kml Γ e (andl (kok S df init kml Γ) (andbt (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ))) hk) he)) he)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo fqanone umt Γ C d e s W hu hk h x he =
  vr-bot A dc (ks-T S) (W zero) mbot
ustep S A df dc CD G GC n hcd hdf hsk kt co lo fqnet umt Γ C d e s W hu hk h x he =
  vr-bot A dc (ks-T S) (W zero) (uevT GC A CD (ueN GC A CD n) (cu-conv ctb (W zero) cuunsup) s)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo fqnil uml Γ C d e s W hu hk h x he =
  unit
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqcons y r) uml Γ C d e s W hu hk h x he =
  (ustep S A df dc CD G GC n hcd hdf hsk kt co lo y umt Γ C d e s (λ i → W zero) (andl (uok A df dc y ckt) (uok A df dc r ckl) hu) (andl (kok S df y kmt Γ) (kok S df r kml Γ) hk) h unit he ,
   ustep S A df dc CD G GC n hcd hdf hsk kt co lo r uml Γ C d e s (λ i → W (suc i)) (andr (uok A df dc y ckt) (uok A df dc r ckl) hu) (andr (kok S df y kmt Γ) (kok S df r kml Γ) hk) h unit he)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqalt j k b r) uma Γ C d e s W hu hk h x he =
  vr-alt A dc (ks-T S) (W zero) j k d e s (fst x) (fst (snd x)) (Γ zero) (λ e2 → (evT G (qeN G n) b e2)) (λ s2 → (uevT GC A CD (ueN GC A CD n) (fq-to-cu S b ckt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ)) (ct-push k d C) (qadd d k) W) s2)) (evT G (qeN G n) r (kqcons (fst x) e)) (uevT GC A CD (ueN GC A CD n) (fq-to-cu S r cka Γ C d W) (msx (fst (snd x)) s)) (he zero) (snd (snd x))
    (ustep S A df dc CD G GC n hcd hdf hsk kt co lo r uma Γ C d e s W (andr (uok A df dc b ckt) (uok A df dc r cka) hu) (andr (kok S df b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ))) (kok S df r kmt Γ) hk) h x he)
    (λ fs gs hq hc hkf → ustep S A df dc CD G GC n hcd hdf hsk kt co lo b umt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ)) (ct-push k d C) (qadd d k) (q-push fs e) (ms-push (c2m gs) d (msx (fst (snd x)) s)) W (andl (uok A df dc b ckt) (uok A df dc r cka) hu) (andl (kok S df b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ))) (kok S df r kmt Γ) hk)
                          (push-ucorr A dc k fs (c2m gs) d e (msx (fst (snd x)) s) hq (ur-c A dc fs gs hc) h) unit (envk-push (ks-T S) fs (kfl (ks-T S) (Γ zero) j k) (kdrop Γ) e hkf (envk-drop (ks-T S) Γ (fst x) e he)))
ustep S A df dc CD G GC n hcd hdf hsk kt co lo fqanone uma Γ C d e s W hu hk h x he =
  vr-bot A dc (ks-T S) (W zero) mbot
ustep S A df dc CD G GC n hcd hdf hsk kt co lo fqnil (umd l) Γ C d e s W hu hk h x he =
  unit
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqcons y r) (umd l) Γ C d e s W hu hk h x he =
  (ustep S A df dc CD G GC n hcd hdf hsk kt co lo y umt Γ C d e s (λ i → W zero) (andl (uok A df dc y ckt) (uok A df dc r ckl) hu) (andl (kok S df y kmt Γ) (kok S df r kml Γ) hk) h unit he ,
   ustep S A df dc CD G GC n hcd hdf hsk kt co lo r (umd (suc l)) Γ C d e (msb l (uevT GC A CD (ueN GC A CD n) (fq-to-cu S y ckt Γ C d (λ i → W zero)) s) s) (λ i → W (suc i)) (andr (uok A df dc y ckt) (uok A df dc r ckl) hu) (andr (kok S df y kmt Γ) (kok S df r kml Γ) hk) (ucorr-weaken A dc d e s l (uevT GC A CD (ueN GC A CD n) (fq-to-cu S y ckt Γ C d (λ i → W zero)) s) h x) (q-le-step d l x) he)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fql w) (umb st) Γ C d e s W hu hk h x he = Empty-rec (false≢true hk)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqv k) (umb st) Γ C d e s W hu hk h x he = Empty-rec (false≢true hk)
ustep S A df dc CD G GC n hcd hdf hsk kt co lo (fqprim p as) (umb st) Γ C d e s W hu hk h x he = Empty-rec (false≢true hk)
