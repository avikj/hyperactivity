-- Layer: capacity demonstrated and mentioned in the paper: a metacircular extension on the unchanged core (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/compile/x86ok.cub — lemmas of runs of lib/isa/x86, for the template theorems: a run splits at
-- any step; a store to an address and to another commute. Uses lib/linproof.cub's eqw-sound, weq-sound.
-- Lemmas of runs are proved of a step function that is a variable (run-of): the model is never
-- unfolded but where a statement is about a particular run, and there by computation.
--
-- (2026-11-12, from tracks/E-lemmas.md, now removed) For x86 as a later target, the form the paper
-- fixes (docs/Hyperactive_Final_Paper.pdf, 11 Nov 2026, sha256 e8f358b4cd2c…, §9.3 “An exact decoded machine and a structural compiler theorem”): a block is bytes with, for every
-- frame state meeting its precondition, a finite trace of the model's transition to its exit
-- address meeting its postcondition (Block, eq. (9.12) of that section); blocks compose by seq
-- under prefix stability and relocation (seq, eq. (9.13)); the compiler is the fold of one block per
-- constructor (the compiler as a fold, eq. (9.15), with the relational congruence, eq. (9.16)). The facts about the imported model such proofs need: it
-- reaches memory a byte at a time (application_level_memory's rb_/wb loops, each with the
-- canonical check of the signed address plus offset, the address through sail_mask_signed 64→48,
-- sign-extension to 52, then x86-read-mem); fetch reads the instruction bytes through read_iptr,
-- get_prefixes and add_to_iptr. Under a frame precondition (each region's base a user address with
-- its length as margin, regions separated) these give: fetch returns the block's bytes, a read or
-- write in a region is the plain byte load or store, rip advances by the instruction length.
-- Proofs follow the model's own evaluation step by step, not what normalization happens to
-- compute.
import "../isa/x86/run.cub"

-- a run of m steps that ends in a value, then n more, is a run of n + m steps
oc-thrown : {E A : Type} → Outc E A → Type
oc-thrown (out-val a) = Empty
oc-thrown (out-throw e) = Unit
oc-thrown (out-abort w) = Unit
oc-val-not : {E A : Type} → (o : Outc E A) → (a : A) → oc-thrown o → o ≡ out-val a → Empty
oc-val-not {E} {A} o a t h = transport (λ i → oc-thrown {E} {A} (h i)) t
oc-throw-absurd : {E A : Type} → (T : Type) → (e : E) → (a : A) → the (Outc E A) (out-throw e) ≡ out-val a → T
oc-throw-absurd {E} {A} T e a h = Empty-rec (oc-val-not {E} {A} (out-throw e) a unit h)
oc-abort-absurd : {E A : Type} → (T : Type) → (w : Text) → (a : A) → the (Outc E A) (out-abort w) ≡ out-val a → T
oc-abort-absurd {E} {A} T w a h = Empty-rec (oc-val-not {E} {A} (out-abort w) a unit h)

run-split-step : (stp : X86 → Outc exception Unit × X86) → (m n : Word) → ((s : X86) → fst (run-of stp m s) ≡ out-val unit → run-of stp (%wadd n m) s ≡ run-of stp n (snd (run-of stp m s)))
  → (p : Outc exception Unit × X86) → fst (st-step {X86} {exception} {Unit} {Unit} (λ _ → run-of stp m) p) ≡ out-val unit
  → st-step {X86} {exception} {Unit} {Unit} (λ _ → run-of stp (%wadd n m)) p ≡ run-of stp n (snd (st-step {X86} {exception} {Unit} {Unit} (λ _ → run-of stp m) p))
run-split-step stp m n ih p =
  case fst p return (λ o → fst (st-on {X86} {exception} {Unit} {Unit} o (λ _ → run-of stp m) (snd p)) ≡ out-val unit
                         → st-on {X86} {exception} {Unit} {Unit} o (λ _ → run-of stp (%wadd n m)) (snd p) ≡ run-of stp n (snd (st-on {X86} {exception} {Unit} {Unit} o (λ _ → run-of stp m) (snd p)))) of
    out-val u → λ h → ih (snd p) h
    out-throw e → oc-throw-absurd {exception} {Unit} (the (Outc exception Unit × X86) (out-throw e , snd p) ≡ run-of stp n (snd p)) e unit
    out-abort w → oc-abort-absurd {exception} {Unit} (the (Outc exception Unit × X86) (out-abort w , snd p) ≡ run-of stp n (snd p)) w unit

run-split : (stp : X86 → Outc exception Unit × X86) → (m n : Word) → (s : X86) → fst (run-of stp m s) ≡ out-val unit → run-of stp (%wadd n m) s ≡ run-of stp n (snd (run-of stp m s))
run-split stp m n =
  %welimP (λ v → (s : X86) → fst (run-of stp v s) ≡ out-val unit → run-of stp (%wadd n v) s ≡ run-of stp n (snd (run-of stp v s))) m
    (λ s h → refl)
    (λ k ih s h → run-split-step stp k n ih (stp s) h)

x86-run-split : (m n : Word) → (s : X86) → fst (x86-run m s) ≡ out-val unit → x86-run (%wadd n m) s ≡ x86-run n (snd (x86-run m s))
x86-run-split = run-split x86-step

-- ---------------------------------------------------------------- equality of words, as paths
bool-ft : (T : Type) → false ≡ true → T
bool-ft T h = Empty-rec (transport (λ i → if h i then Empty else Unit) unit)
eqw-refl : (a : Word) → eqw a a ≡ true
eqw-refl a = %welimP (λ v → eqw v v ≡ true) a refl (λ n h → h)
weq-refl : (a : Word) → weq a a ≡ true
weq-refl a = sym (eqw≡weq a a) ∙ eqw-refl a

-- ---------------------------------------------------------------- one byte stored
-- storing what is there changes nothing
st-absorb : (m : ByteMap) → (a : Word) → (v : Word) → m a ≡ v → mem-store m a v ≡ m
st-absorb m a v h = funExt (λ t →
  case weq t a return (λ c → weq t a ≡ c → (if c then v else m t) ≡ m t) of
    true → λ e → sym h ∙ cong m (sym (weq-sound t a e))
    false → λ e → refl
  refl)
-- the later of two stores to one address
st-same : (m : ByteMap) → (a : Word) → (v : Word) → (u : Word) → mem-store (mem-store m a u) a v ≡ mem-store m a v
st-same m a v u = funExt (λ t →
  case weq t a return (λ c → weq t a ≡ c → (if c then v else mem-store m a u t) ≡ (if c then v else m t)) of
    true → λ e → refl
    false → λ e → cong (λ d → if d then u else m t) e
  refl)
-- stores to two addresses, in either order
st-comm : (m : ByteMap) → (a : Word) → (v : Word) → (b : Word) → (w : Word) → weq a b ≡ false →
          mem-store (mem-store m a v) b w ≡ mem-store (mem-store m b w) a v
st-comm m a v b w h = funExt (λ t →
  case weq t a return (λ c → weq t a ≡ c → (if weq t b then w else (if c then v else m t)) ≡ (if c then v else (if weq t b then w else m t))) of
    true → λ ea →
      case weq t b return (λ d → weq t b ≡ d → (if d then w else v) ≡ v) of
        true → λ eb → bool-ft (w ≡ v) (sym h ∙ cong (λ x → weq x b) (sym (weq-sound t a ea)) ∙ eb)
        false → λ eb → refl
      refl
    false → λ ea → refl
  refl)
