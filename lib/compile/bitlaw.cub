-- lib/compile/bitlaw.cub — single bits of the model's bitvectors (lib/bits.cub), from the word
-- operations' bit laws (lib/prim.cub): bv-update of bits j … j sets bit j and keeps the others,
-- bv-slice of bit j reads it, and the machine's comparison with 0 of a bit read as a word is the
-- negation of that bit. Loaded after lib/bits.cub and lib/compile/wordlaw.cub.

-- Booleans
bnot : Bool → Bool
bnot b = if b then false else true
-- x xor (x and false) or false is x; x xor (x and true) is false
bit-keep : (x : Bool) → bit-or (bit-xor x (bit-and x false)) false ≡ x
bit-keep true = refl
bit-keep false = refl
bit-clear : (x : Bool) → bit-xor x (bit-and x true) ≡ false
bit-clear true = refl
bit-clear false = refl
bit-and-true : (x : Bool) → bit-and x true ≡ x
bit-and-true true = refl
bit-and-true false = refl
cong2 : {A B C : Type} → (f : A → B → C) → {a a2 : A} → {b b2 : B} → a ≡ a2 → b ≡ b2 → f a b ≡ f a2 b2
cong2 {A} {B} {C} f p q = λ i → f (p i) (q i)
-- bit 0 after an update of bit j ≥ 1 (j literal where it is used: the hypotheses compute)
bu-bit0-other : (x v j : Word) → wbit (wshl #1 j) #0 ≡ false → wlt #0 j ≡ true → wbit (bv-update #32 x j j v) #0 ≡ wbit x #0
bu-bit0-other x v j h1 h2 =
  wbit-or (wxor x (wand x (wshl #1 j))) (wshl v j) #0
  ∙ cong2 (λ p q → bit-or p q) (wbit-xor x (wand x (wshl #1 j)) #0 ∙ cong (λ q → bit-xor (wbit x #0) q) (wbit-and x (wshl #1 j) #0 ∙ cong (λ q → bit-and (wbit x #0) q) h1))
                               (wbit-shl v j #0 ∙ cong (λ c → if c then false else wbit v (wsub #0 j)) h2)
  ∙ bit-keep (wbit x #0)
-- bit 0 after an update of bit 0: the value's bit 0
bu-bit0 : (x v : Word) → wbit (bv-update #32 x #0 #0 v) #0 ≡ wbit v #0
bu-bit0 x v =
  wbit-or (wxor x (wand x #1)) v #0
  ∙ cong (λ p → bit-or p (wbit v #0)) (wbit-xor x (wand x #1) #0 ∙ cong (λ q → bit-xor (wbit x #0) q) (wbit-and x #1 #0) ∙ bit-clear (wbit x #0))
-- bit 0 of a bit read (bv-slice of bits 0 … 0)
slice-bit0 : (x : Word) → wbit (wand x #1) #0 ≡ wbit x #0
slice-bit0 x = wbit-and x #1 #0 ∙ bit-and-true (wbit x #0)
-- a word below 2 compared with 0 is the negation of its comparison with 1
small2 : (r : Word) → wlt r #2 ≡ true → weq #0 r ≡ bnot (weq r #1)
small2 r =
  %welimP (λ v → wlt v #2 ≡ true → weq #0 v ≡ bnot (weq v #1)) r
    (λ h → refl)
    (λ n g → %welimP (λ w → wlt (%wsucc w) #2 ≡ true → weq #0 (%wsucc w) ≡ bnot (weq (%wsucc w) #1)) n
               (λ h → refl)
               (λ m g2 h → ft-absurd (weq #0 (%wsucc (%wsucc m)) ≡ bnot (weq (%wsucc (%wsucc m)) #1)) h))
-- a bit read as a word, compared with 0: the bit's negation
bit0-zero : (F : Word) → weq #0 (wand F #1) ≡ bnot (wbit F #0)
bit0-zero F =
  cong (λ z → weq #0 z) (wand-mask F #1)
  ∙ small2 (wrem F #2) (wrem-lt F #2 refl)
  ∙ cong (λ z → bnot (weq (wrem z #2) #1)) (symw (quot-one F))
