-- lib/compile/stack.cub — the first machine the typed compiler targets, and the compiler into it
-- with the statement that it is right. The machine is a stack of 64-bit words; each instruction is
-- one or two of lib/x86.cub's templates (push imm, push [rsp+d], pop rcx; pop rax; op; push rax,
-- ...). A value of a first-order type is its words on the stack, flattened (a pair its two parts, a
-- sum a tag and both payload areas): no heap. A run either ends, or leaves (jout): a result past
-- 2^64, or a construct this level does not compile, is computed on the net instead (run p f ≡ f),
-- never answered wrongly.

data JRes (A : Type) = jout | jgot (x : A)

-- ---------------------------------------------------------------- lists of words
jap : List Word → List Word → List Word
jap nil ys = ys
jap (cons x xs) ys = cons x (jap xs ys)

jlen : List Word → Nat
jlen nil = zero
jlen (cons x xs) = suc (jlen xs)

jtake : Nat → List Word → List Word
jtake zero l = nil
jtake (suc n) l = case l return (λ z → List Word) of
  nil → nil
  cons x xs → cons x (jtake n xs)

jdrop : Nat → List Word → List Word
jdrop zero l = l
jdrop (suc n) l = case l return (λ z → List Word) of
  nil → nil
  cons x xs → jdrop n xs

jzeros : Nat → List Word
jzeros zero = nil
jzeros (suc n) = cons #0 (jzeros n)

jnth : List Word → Nat → JRes Word
jnth nil n = jout
jnth (cons x xs) zero = jgot x
jnth (cons x xs) (suc n) = jnth xs n

jap-assoc : (xs ys zs : List Word) → jap (jap xs ys) zs ≡ jap xs (jap ys zs)
jap-assoc nil ys zs = refl
jap-assoc (cons x xs) ys zs = cong (cons x) (jap-assoc xs ys zs)

jlen-ap : (xs ys : List Word) → jlen (jap xs ys) ≡ plus (jlen xs) (jlen ys)
jlen-ap nil ys = refl
jlen-ap (cons x xs) ys = cong suc (jlen-ap xs ys)

jlen-zeros : (n : Nat) → jlen (jzeros n) ≡ n
jlen-zeros zero = refl
jlen-zeros (suc n) = cong suc (jlen-zeros n)

jtake-ap : (xs ys : List Word) → jtake (jlen xs) (jap xs ys) ≡ xs
jtake-ap nil ys = refl
jtake-ap (cons x xs) ys = cong (cons x) (jtake-ap xs ys)

jdrop-ap : (xs ys : List Word) → jdrop (jlen xs) (jap xs ys) ≡ ys
jdrop-ap nil ys = refl
jdrop-ap (cons x xs) ys = jdrop-ap xs ys

jdrop-ap-plus : (xs : List Word) → (d : Nat) → (s : List Word) → jdrop (plus (jlen xs) d) (jap xs s) ≡ jdrop d s
jdrop-ap-plus nil d s = refl
jdrop-ap-plus (cons x xs) d s = jdrop-ap-plus xs d s

-- ---------------------------------------------------------------- the machine
-- the code, each step followed by the rest (an if's branches rejoin before the rest). kget d n
-- pushes a copy of the n words at depth d (n pushes of the word at depth d + n − 1); kslide n m
-- keeps the top n words and drops the m below them
data JCode = kdone
           | kimm (w : Word) (k : JCode)
           | kget (d : Nat) (n : Nat) (k : JCode)
           | kop (o : JWop) (k : JCode)
           | kcmp (o : JWcmp) (k : JCode)
           | kinc (k : JCode)
           | kif (t : JCode) (e : JCode) (k : JCode)
           | kslide (n : Nat) (m : Nat) (k : JCode)
           | kloop (n : Nat) (b : JCode) (k : JCode)
           | kfail

-- the 64-bit bound
jw64 : Word
jw64 = #18446744073709551616

jthen : JRes (List Word) → (List Word → JRes (List Word)) → JRes (List Word)
jthen jout f = jout
jthen (jgot s) f = f s

-- keep the top n words, drop the m below them
jslide : Nat → Nat → List Word → List Word
jslide n m s = jap (jtake n s) (jdrop m (jdrop n s))

-- the word at depth d stepped (a loop's counter)
jincat : Nat → List Word → List Word
jincat zero s = case s return (λ z → List Word) of
  nil → nil
  cons x xs → cons (%wsucc x) xs
jincat (suc d) s = case s return (λ z → List Word) of
  nil → nil
  cons x xs → cons x (jincat d xs)

-- a loop: the state (n words) on top, the counter below it, the bound below that. While the
-- counter is below the bound the body runs on that stack (it pushes the next state), the old
-- state is dropped and the counter stepped; then counter and bound are dropped. The fuel is the
-- bound's count, taken when the loop starts (one more round than any loop from 0 needs). jlp-at is
-- one round, given the counter and bound read and what comes next
jlp-at : Nat → (List Word → JRes (List Word)) → (List Word → JRes (List Word)) → List Word → JRes Word → JRes Word → JRes (List Word)
jlp-at n f nx s jout rb = jout
jlp-at n f nx s (jgot i) jout = jout
jlp-at n f nx s (jgot i) (jgot b) =
  if %wlt i b then jthen (f s) (λ s2 → nx (jincat n (jslide n n s2))) else jgot (jslide n (suc (suc zero)) s)

jlp : Nat → (List Word → JRes (List Word)) → Nat → List Word → JRes (List Word)
jlp n f zero s = jout
jlp n f (suc fu) s = jlp-at n f (λ s3 → jlp n f fu s3) s (jnth s n) (jnth s (suc n))

jloop-go : Nat → (List Word → JRes (List Word)) → (List Word → JRes (List Word)) → List Word → JRes Word → JRes (List Word)
jloop-go n f kk s jout = jout
jloop-go n f kk s (jgot bb) = jthen (jlp n f (suc (toNat bb)) s) kk

jrun : JCode → List Word → JRes (List Word)
jrun kdone s = jgot s
jrun (kimm w k) s = if %wlt w jw64 then jrun k (cons w s) else jout
jrun (kget d n k) s = jrun k (jap (jtake n (jdrop d s)) s)
jrun (kop o k) s = case s return (λ z → JRes (List Word)) of
  nil → jout
  cons y r → case r return (λ z → JRes (List Word)) of
    nil → jout
    cons x r2 → if %wlt (jwop o x y) jw64 then jrun k (cons (jwop o x y) r2) else jout
jrun (kcmp o k) s = case s return (λ z → JRes (List Word)) of
  nil → jout
  cons y r → case r return (λ z → JRes (List Word)) of
    nil → jout
    cons x r2 → jrun k (cons (if jwcmp o x y then #0 else #1) r2)
jrun (kinc k) s = case s return (λ z → JRes (List Word)) of
  nil → jout
  cons x r → if %wlt (%wsucc x) jw64 then jrun k (cons (%wsucc x) r) else jout
jrun (kif t e k) s = case s return (λ z → JRes (List Word)) of
  nil → jout
  cons c r → jthen (if %weq c #0 then jrun t r else jrun e r) (λ s2 → jrun k s2)
jrun (kslide n m k) s = jrun k (jslide n m s)
jrun (kloop n b k) s = jloop-go n (λ s2 → jrun b s2) (λ s2 → jrun k s2) s (jnth s (suc n))
jrun kfail s = jout

-- ---------------------------------------------------------------- values as words
-- a value's words: a word itself, true 0 and false 1 (lib/x86.cub's Bool), a natural number its
-- count (lib/x86.cub's Nat by Word), a pair its parts' words, a sum its tag (0, 1) then both
-- payload areas (the other one zeros). A function is not compiled at this level (its terms are
-- kfail); one word stands for it
jsz : JTy → Nat
jsz jw = suc zero
jsz jb = suc zero
jsz jn = suc zero
jsz (jprod a b) = plus (jsz a) (jsz b)
jsz (jsum a b) = suc (plus (jsz a) (jsz b))
jsz (jarr a b) = suc zero

jencs : (a : JTy) → JEl a → List Word
jencs jw x = cons x nil
jencs jb x = cons (if x then #0 else #1) nil
jencs jn x = cons (fromNat x) nil
jencs (jprod a b) x = jap (jencs a (fst x)) (jencs b (snd x))
jencs (jsum a b) x = case x return (λ z → List Word) of
  inl y → cons #0 (jap (jencs a y) (jzeros (jsz b)))
  inr y → cons #1 (jap (jzeros (jsz a)) (jencs b y))
jencs (jarr a b) x = cons #0 nil

jlen-enc : (a : JTy) → (x : JEl a) → jlen (jencs a x) ≡ jsz a
jlen-enc jw x = refl
jlen-enc jb x = refl
jlen-enc jn x = refl
jlen-enc (jprod a b) x = jlen-ap (jencs a (fst x)) (jencs b (snd x)) ∙ (λ i → plus (jlen-enc a (fst x) i) (jlen-enc b (snd x) i))
jlen-enc (jsum a b) x = case x return (λ z → jlen (jencs (jsum a b) z) ≡ jsz (jsum a b)) of
  inl y → cong suc (jlen-ap (jencs a y) (jzeros (jsz b)) ∙ (λ i → plus (jlen-enc a y i) (jlen-zeros (jsz b) i)))
  inr y → cong suc (jlen-ap (jzeros (jsz a)) (jencs b y) ∙ (λ i → plus (jlen-zeros (jsz a) i) (jlen-enc b y i)))
jlen-enc (jarr a b) x = refl

-- ---------------------------------------------------------------- the same type
jband : Bool → Bool → Bool
jband true y = y
jband false y = false

jabsurd : (A : Type) → false ≡ true → A
jabsurd A h = transport (λ i → case h i return (λ z → Type) of true → A; false → Unit) unit

jband-l : (x : Bool) → (y : Bool) → jband x y ≡ true → x ≡ true
jband-l true y h = refl
jband-l false y h = jabsurd (false ≡ true) h

jband-r : (x : Bool) → (y : Bool) → jband x y ≡ true → y ≡ true
jband-r true y h = h
jband-r false y h = jabsurd (y ≡ true) h

jteq : JTy → JTy → Bool
jteq jw jw = true
jteq jw jb = false
jteq jw jn = false
jteq jw (jprod a1 a2) = false
jteq jw (jsum a1 a2) = false
jteq jw (jarr a1 a2) = false
jteq jb jw = false
jteq jb jb = true
jteq jb jn = false
jteq jb (jprod a1 a2) = false
jteq jb (jsum a1 a2) = false
jteq jb (jarr a1 a2) = false
jteq jn jw = false
jteq jn jb = false
jteq jn jn = true
jteq jn (jprod a1 a2) = false
jteq jn (jsum a1 a2) = false
jteq jn (jarr a1 a2) = false
jteq (jprod b1 b2) jw = false
jteq (jprod b1 b2) jb = false
jteq (jprod b1 b2) jn = false
jteq (jprod b1 b2) (jprod a1 a2) = jband (jteq b1 a1) (jteq b2 a2)
jteq (jprod b1 b2) (jsum a1 a2) = false
jteq (jprod b1 b2) (jarr a1 a2) = false
jteq (jsum b1 b2) jw = false
jteq (jsum b1 b2) jb = false
jteq (jsum b1 b2) jn = false
jteq (jsum b1 b2) (jprod a1 a2) = false
jteq (jsum b1 b2) (jsum a1 a2) = jband (jteq b1 a1) (jteq b2 a2)
jteq (jsum b1 b2) (jarr a1 a2) = false
jteq (jarr b1 b2) jw = false
jteq (jarr b1 b2) jb = false
jteq (jarr b1 b2) jn = false
jteq (jarr b1 b2) (jprod a1 a2) = false
jteq (jarr b1 b2) (jsum a1 a2) = false
jteq (jarr b1 b2) (jarr a1 a2) = jband (jteq b1 a1) (jteq b2 a2)

jteq-sound : (b : JTy) → (a : JTy) → jteq b a ≡ true → b ≡ a
jteq-sound jw jw h = refl
jteq-sound jw jb h = jabsurd (jw ≡ jb) h
jteq-sound jw jn h = jabsurd (jw ≡ jn) h
jteq-sound jw (jprod a1 a2) h = jabsurd (jw ≡ (jprod a1 a2)) h
jteq-sound jw (jsum a1 a2) h = jabsurd (jw ≡ (jsum a1 a2)) h
jteq-sound jw (jarr a1 a2) h = jabsurd (jw ≡ (jarr a1 a2)) h
jteq-sound jb jw h = jabsurd (jb ≡ jw) h
jteq-sound jb jb h = refl
jteq-sound jb jn h = jabsurd (jb ≡ jn) h
jteq-sound jb (jprod a1 a2) h = jabsurd (jb ≡ (jprod a1 a2)) h
jteq-sound jb (jsum a1 a2) h = jabsurd (jb ≡ (jsum a1 a2)) h
jteq-sound jb (jarr a1 a2) h = jabsurd (jb ≡ (jarr a1 a2)) h
jteq-sound jn jw h = jabsurd (jn ≡ jw) h
jteq-sound jn jb h = jabsurd (jn ≡ jb) h
jteq-sound jn jn h = refl
jteq-sound jn (jprod a1 a2) h = jabsurd (jn ≡ (jprod a1 a2)) h
jteq-sound jn (jsum a1 a2) h = jabsurd (jn ≡ (jsum a1 a2)) h
jteq-sound jn (jarr a1 a2) h = jabsurd (jn ≡ (jarr a1 a2)) h
jteq-sound (jprod b1 b2) jw h = jabsurd ((jprod b1 b2) ≡ jw) h
jteq-sound (jprod b1 b2) jb h = jabsurd ((jprod b1 b2) ≡ jb) h
jteq-sound (jprod b1 b2) jn h = jabsurd ((jprod b1 b2) ≡ jn) h
jteq-sound (jprod b1 b2) (jprod a1 a2) h = λ i → jprod (jteq-sound b1 a1 (jband-l (jteq b1 a1) (jteq b2 a2) h) i) (jteq-sound b2 a2 (jband-r (jteq b1 a1) (jteq b2 a2) h) i)
jteq-sound (jprod b1 b2) (jsum a1 a2) h = jabsurd ((jprod b1 b2) ≡ (jsum a1 a2)) h
jteq-sound (jprod b1 b2) (jarr a1 a2) h = jabsurd ((jprod b1 b2) ≡ (jarr a1 a2)) h
jteq-sound (jsum b1 b2) jw h = jabsurd ((jsum b1 b2) ≡ jw) h
jteq-sound (jsum b1 b2) jb h = jabsurd ((jsum b1 b2) ≡ jb) h
jteq-sound (jsum b1 b2) jn h = jabsurd ((jsum b1 b2) ≡ jn) h
jteq-sound (jsum b1 b2) (jprod a1 a2) h = jabsurd ((jsum b1 b2) ≡ (jprod a1 a2)) h
jteq-sound (jsum b1 b2) (jsum a1 a2) h = λ i → jsum (jteq-sound b1 a1 (jband-l (jteq b1 a1) (jteq b2 a2) h) i) (jteq-sound b2 a2 (jband-r (jteq b1 a1) (jteq b2 a2) h) i)
jteq-sound (jsum b1 b2) (jarr a1 a2) h = jabsurd ((jsum b1 b2) ≡ (jarr a1 a2)) h
jteq-sound (jarr b1 b2) jw h = jabsurd ((jarr b1 b2) ≡ jw) h
jteq-sound (jarr b1 b2) jb h = jabsurd ((jarr b1 b2) ≡ jb) h
jteq-sound (jarr b1 b2) jn h = jabsurd ((jarr b1 b2) ≡ jn) h
jteq-sound (jarr b1 b2) (jprod a1 a2) h = jabsurd ((jarr b1 b2) ≡ (jprod a1 a2)) h
jteq-sound (jarr b1 b2) (jsum a1 a2) h = jabsurd ((jarr b1 b2) ≡ (jsum a1 a2)) h
jteq-sound (jarr b1 b2) (jarr a1 a2) h = λ i → jarr (jteq-sound b1 a1 (jband-l (jteq b1 a1) (jteq b2 a2) h) i) (jteq-sound b2 a2 (jband-r (jteq b1 a1) (jteq b2 a2) h) i)

-- a value cast to its own type has the same words
jcast-id : (a : JTy) → (x : JEl a) → jencs a (jcast a a x) ≡ jencs a x
jcast-id jw x = refl
jcast-id jb x = refl
jcast-id jn x = refl
jcast-id (jprod a b) x = λ i → jap (jcast-id a (fst x) i) (jcast-id b (snd x) i)
jcast-id (jsum a b) x = case x return (λ z → jencs (jsum a b) (jcast (jsum a b) (jsum a b) z) ≡ jencs (jsum a b) z) of
  inl y → λ i → cons #0 (jap (jcast-id a y i) (jzeros (jsz b)))
  inr y → λ i → cons #1 (jap (jzeros (jsz a)) (jcast-id b y i))
jcast-id (jarr a b) x = refl

jcast-enc : (b : JTy) → (a : JTy) → jteq b a ≡ true → (x : JEl b) → jencs a (jcast b a x) ≡ jencs b x
jcast-enc b a h x = transport (λ i → jencs (jteq-sound b a h i) (jcast b (jteq-sound b a h i) x) ≡ jencs b x) (jcast-id b x)

-- ---------------------------------------------------------------- runs, compared
-- X goes at most as far as Y: it leaves, or it is Y
JLeq : JRes (List Word) → JRes (List Word) → Type
JLeq X Y = Sum (X ≡ jout) (X ≡ Y)

-- a run that ends as k run on the values' words pushed (or leaves)
JAfter : JRes (List Word) → JCode → List Word → List Word → Type
JAfter X k vs s = JLeq X (jrun k (jap vs s))

jleq-trans : (X : JRes (List Word)) → (Y : JRes (List Word)) → (Z : JRes (List Word)) → JLeq X Y → JLeq Y Z → JLeq X Z
jleq-trans X Y Z p q = case p of
  inl e → inl e
  inr e → case q of
    inl e2 → inl (e ∙ e2)
    inr e2 → inr (e ∙ e2)

jleq-if : (b : Bool) → (X : JRes (List Word)) → JLeq (if b then X else jout) X
jleq-if true X = inr refl
jleq-if false X = inl refl

jleq-then : (X : JRes (List Word)) → (Y : JRes (List Word)) → (f : List Word → JRes (List Word)) → JLeq X Y → JLeq (jthen X f) (jthen Y f)
jleq-then X Y f p = case p of
  inl e → inl (cong (λ z → jthen z f) e)
  inr e → inr (cong (λ z → jthen z f) e)

jleq-thengot : (X : JRes (List Word)) → (s : List Word) → (f : List Word → JRes (List Word)) → JLeq X (jgot s) → JLeq (jthen X f) (f s)
jleq-thengot X s f p = jleq-then X (jgot s) f p

jaft-vs : (X : JRes (List Word)) → (k : JCode) → (vs : List Word) → (vs2 : List Word) → (s : List Word) → vs ≡ vs2 → JAfter X k vs s → JAfter X k vs2 s
jaft-vs X k vs vs2 s e h = transport (λ i → JAfter X k (e i) s) h

-- ---------------------------------------------------------------- steps
jst-imm : (w : Word) → (k : JCode) → (s : List Word) → JLeq (jrun (kimm w k) s) (jrun k (cons w s))
jst-imm w k s = jleq-if (%wlt w jw64) (jrun k (cons w s))

jst-op : (o : JWop) → (k : JCode) → (x : Word) → (y : Word) → (s : List Word) → JLeq (jrun (kop o k) (cons y (cons x s))) (jrun k (cons (jwop o x y) s))
jst-op o k x y s = jleq-if (%wlt (jwop o x y) jw64) (jrun k (cons (jwop o x y) s))

jst-inc : (k : JCode) → (x : Word) → (s : List Word) → JLeq (jrun (kinc k) (cons x s)) (jrun k (cons (%wsucc x) s))
jst-inc k x s = jleq-if (%wlt (%wsucc x) jw64) (jrun k (cons (%wsucc x) s))

-- ---------------------------------------------------------------- where the variables are
-- each variable's depth on the stack (its first word)
JPl : List JTy → Type
JPl nil = Unit
JPl (cons a g) = Nat × JPl g

JPlaced : (g : List JTy) → JPl g → JEnv g → List Word → Type
JPlaced nil p r s = Unit
JPlaced (cons a g) p r s = (jtake (jsz a) (jdrop (fst p) s) ≡ jencs a (fst r)) × JPlaced g (snd p) (snd r) s

-- n more words pushed
jpshn : (g : List JTy) → Nat → JPl g → JPl g
jpshn nil n p = unit
jpshn (cons a g) n p = (plus n (fst p) , jpshn g n (snd p))

jplaced-push : (g : List JTy) → (p : JPl g) → (r : JEnv g) → (s : List Word) → (vs : List Word) →
               JPlaced g p r s → JPlaced g (jpshn g (jlen vs) p) r (jap vs s)
jplaced-push nil p r s vs h = unit
jplaced-push (cons a g) p r s vs h =
  (cong (jtake (jsz a)) (jdrop-ap-plus vs (fst p) s) ∙ fst h , jplaced-push g (snd p) (snd r) s vs (snd h))

jplaced-pushn : (g : List JTy) → (p : JPl g) → (r : JEnv g) → (s : List Word) → (vs : List Word) → (n : Nat) → jlen vs ≡ n →
                JPlaced g p r s → JPlaced g (jpshn g n p) r (jap vs s)
jplaced-pushn g p r s vs n e h = transport (λ i → JPlaced g (jpshn g (e i) p) r (jap vs s)) (jplaced-push g p r s vs h)

-- a value pushed: the new variable at depth 0, the rest further down
jplaced-bind : (g : List JTy) → (b : JTy) → (p : JPl g) → (r : JEnv g) → (s : List Word) → (x : JEl b) →
               JPlaced g p r s → JPlaced (cons b g) (zero , jpshn g (jsz b) p) (x , r) (jap (jencs b x) s)
jplaced-bind g b p r s x h =
  (transport (λ i → jtake (jlen-enc b x i) (jap (jencs b x) s) ≡ jencs b x) (jtake-ap (jencs b x) s) ,
   jplaced-pushn g p r s (jencs b x) (jsz b) (jlen-enc b x) h)

-- ---------------------------------------------------------------- the type expected
-- code for a value of type b where a is expected: the same code if they are the same, else none
jfitc : Bool → JCode → JCode
jfitc true c = c
jfitc false c = kfail

jfit-q : (q : Bool) → (b : JTy) → (a : JTy) → jteq b a ≡ q → (x : JEl b) → (c : JCode) → (k : JCode) → (s : List Word) →
         JAfter (jrun c s) k (jencs b x) s → JAfter (jrun (jfitc q c) s) k (jencs a (jcast b a x)) s
jfit-q true b a h x c k s p = jaft-vs (jrun c s) k (jencs b x) (jencs a (jcast b a x)) s (sym (jcast-enc b a h x)) p
jfit-q false b a h x c k s p = inl refl

jfit-ok : (b : JTy) → (a : JTy) → (x : JEl b) → (c : JCode) → (k : JCode) → (s : List Word) →
          JAfter (jrun c s) k (jencs b x) s → JAfter (jrun (jfitc (jteq b a) c) s) k (jencs a (jcast b a x)) s
jfit-ok b a x c k s p = jfit-q (jteq b a) b a refl x c k s p

-- a variable: its words copied to the top
jvcode : (g : List JTy) → JPl g → Nat → JTy → JCode → JCode
jvcode nil p n a k = kfail
jvcode (cons b g) p zero a k = jfitc (jteq b a) (kget (fst p) (jsz b) k)
jvcode (cons b g) p (suc n) a k = jvcode g (snd p) n a k

jvcode-ok : (g : List JTy) → (p : JPl g) → (n : Nat) → (a : JTy) → (k : JCode) → (r : JEnv g) → (s : List Word) → JPlaced g p r s →
            JAfter (jrun (jvcode g p n a k) s) k (jencs a (jcast (jat g n) a (jlook g n r))) s
jvcode-ok nil p n a k r s h = inl refl
jvcode-ok (cons b g) p zero a k r s h =
  jfit-ok b a (fst r) (kget (fst p) (jsz b) k) k s
    (inr (cong (λ z → jrun k (jap z s)) (fst h)))
jvcode-ok (cons b g) p (suc n) a k r s h = jvcode-ok g (snd p) n a k (snd r) s (snd h)

-- ---------------------------------------------------------------- more on lists of words
jleq-pre : (X : JRes (List Word)) → (Y : JRes (List Word)) → (Z : JRes (List Word)) → X ≡ Y → JLeq Y Z → JLeq X Z
jleq-pre X Y Z e q = case q of
  inl e2 → inl (e ∙ e2)
  inr e2 → inr (e ∙ e2)

jleq-post : (X : JRes (List Word)) → (Y : JRes (List Word)) → (Z : JRes (List Word)) → JLeq X Y → Y ≡ Z → JLeq X Z
jleq-post X Y Z q e = case q of
  inl e2 → inl e2
  inr e2 → inr (e2 ∙ e)

jif-true : (b : Bool) → b ≡ true → (T : JRes (List Word)) → (E : JRes (List Word)) → (if b then T else E) ≡ T
jif-true b e T E = λ i → if e i then T else E

jif-false : (b : Bool) → b ≡ false → (T : JRes (List Word)) → (E : JRes (List Word)) → (if b then T else E) ≡ E
jif-false b e T E = λ i → if e i then T else E

jnth-ap0 : (xs : List Word) → (x : Word) → (r : List Word) → jnth (jap xs (cons x r)) (jlen xs) ≡ jgot x
jnth-ap0 nil x r = refl
jnth-ap0 (cons z xs) x r = jnth-ap0 xs x r

jnth-ap1 : (xs : List Word) → (x : Word) → (y : Word) → (r : List Word) → jnth (jap xs (cons x (cons y r))) (suc (jlen xs)) ≡ jgot y
jnth-ap1 nil x y r = refl
jnth-ap1 (cons z xs) x y r = jnth-ap1 xs x y r

jnth-enc0 : (a : JTy) → (hx : JEl a) → (x : Word) → (r : List Word) → jnth (jap (jencs a hx) (cons x r)) (jsz a) ≡ jgot x
jnth-enc0 a hx x r = transport (λ i → jnth (jap (jencs a hx) (cons x r)) (jlen-enc a hx i) ≡ jgot x) (jnth-ap0 (jencs a hx) x r)

jnth-enc1 : (a : JTy) → (hx : JEl a) → (x : Word) → (y : Word) → (r : List Word) → jnth (jap (jencs a hx) (cons x (cons y r))) (suc (jsz a)) ≡ jgot y
jnth-enc1 a hx x y r = transport (λ i → jnth (jap (jencs a hx) (cons x (cons y r))) (suc (jlen-enc a hx i)) ≡ jgot y) (jnth-ap1 (jencs a hx) x y r)

jslide-ap : (xs : List Word) → (ys : List Word) → (s : List Word) → jslide (jlen xs) (jlen ys) (jap xs (jap ys s)) ≡ jap xs s
jslide-ap xs ys s = (λ i → jap (jtake-ap xs (jap ys s) i) (jdrop (jlen ys) (jdrop-ap xs (jap ys s) i))) ∙ cong (jap xs) (jdrop-ap ys s)

jslide-ok : (xs : List Word) → (ys : List Word) → (s : List Word) → (n : Nat) → (m : Nat) → jlen xs ≡ n → jlen ys ≡ m →
            jslide n m (jap xs (jap ys s)) ≡ jap xs s
jslide-ok xs ys s n m e1 e2 = transport (λ i → jslide (e1 i) (e2 i) (jap xs (jap ys s)) ≡ jap xs s) (jslide-ap xs ys s)

jincat-ap : (xs : List Word) → (x : Word) → (r : List Word) → jincat (jlen xs) (jap xs (cons x r)) ≡ jap xs (cons (%wsucc x) r)
jincat-ap nil x r = refl
jincat-ap (cons z xs) x r = cong (cons z) (jincat-ap xs x r)

jincat-enc : (a : JTy) → (hx : JEl a) → (x : Word) → (r : List Word) → jincat (jsz a) (jap (jencs a hx) (cons x r)) ≡ jap (jencs a hx) (cons (%wsucc x) r)
jincat-enc a hx x r = transport (λ i → jincat (jlen-enc a hx i) (jap (jencs a hx) (cons x r)) ≡ jap (jencs a hx) (cons (%wsucc x) r)) (jincat-ap (jencs a hx) x r)

jzeros-cons : (n : Nat) → (s : List Word) → jap (jzeros n) (cons #0 s) ≡ cons #0 (jap (jzeros n) s)
jzeros-cons zero s = refl
jzeros-cons (suc n) s = cong (cons #0) (jzeros-cons n s)

-- ---------------------------------------------------------------- loops
jup : {X : Type} → (Nat → X → X) → Nat → Nat → X → X
jup S zero c h = h
jup S (suc j) c h = jup S j (suc c) (S c h)

-- upward from the value at c is the recursion's value at c + j (the eliminators recurse downward)
jup-down : {X : Type} → (D : Nat → X) → (S : Nat → X → X) → ((c : Nat) → D (suc c) ≡ S c (D c)) →
           (j : Nat) → (c : Nat) → jup S j c (D c) ≡ D (plus c j)
jup-down D S hD zero c = sym (cong D (plus-zero c))
jup-down D S hD (suc j) c = cong (jup S j (suc c)) (sym (hD c)) ∙ (jup-down D S hD j (suc c) ∙ sym (cong D (plus-suc c j)))

-- the comparisons a loop from 0 makes
jlt-more : (c : Nat) → (j : Nat) → %wlt (fromNat c) (fromNat (plus c (suc j))) ≡ true
jlt-more zero j = sym (ltw≡wlt #0 (fromNat (suc j)))
jlt-more (suc c) j = sym (ltw≡wlt (fromNat (suc c)) (fromNat (plus (suc c) (suc j)))) ∙ (ltw≡wlt (fromNat c) (fromNat (plus c (suc j))) ∙ jlt-more c j)

jlt-end : (c : Nat) → %wlt (fromNat c) (fromNat (plus c zero)) ≡ false
jlt-end zero = sym (ltw≡wlt #0 #0)
jlt-end (suc c) = sym (ltw≡wlt (fromNat (suc c)) (fromNat (plus (suc c) zero))) ∙ (ltw≡wlt (fromNat c) (fromNat (plus c zero)) ∙ jlt-end c)

-- one round of a loop whose state is a value of a
jlp-unfold : (a : JTy) → (f : List Word → JRes (List Word)) → (fu : Nat) → (hx : JEl a) → (i : Word) → (b : Word) → (s0 : List Word) →
             jlp (jsz a) f (suc fu) (jap (jencs a hx) (cons i (cons b s0))) ≡
             (if %wlt i b
                then jthen (f (jap (jencs a hx) (cons i (cons b s0)))) (λ s2 → jlp (jsz a) f fu (jincat (jsz a) (jslide (jsz a) (jsz a) s2)))
                else jgot (jslide (jsz a) (suc (suc zero)) (jap (jencs a hx) (cons i (cons b s0)))))
jlp-unfold a f fu hx i b s0 = λ k → jlp-at (jsz a) f (λ s3 → jlp (jsz a) f fu s3) (jap (jencs a hx) (cons i (cons b s0)))
                                          (jnth-enc0 a hx i (cons b s0) k) (jnth-enc1 a hx i b s0 k)

-- the body pushes the next state
JBodyOk : (a : JTy) → (S : Nat → JEl a → JEl a) → (List Word → JRes (List Word)) → List Word → Type
JBodyOk a S f s0 = (c : Nat) → (hx : JEl a) → (bd : Word) →
  JLeq (f (jap (jencs a hx) (cons (fromNat c) (cons bd s0))))
       (jgot (jap (jencs a (S c hx)) (jap (jencs a hx) (cons (fromNat c) (cons bd s0)))))

-- the loop is right: j rounds left from counter c, the bound c + j, any fuel past j
jlp-ok : (a : JTy) → (S : Nat → JEl a → JEl a) → (f : List Word → JRes (List Word)) → (s0 : List Word) → JBodyOk a S f s0 →
         (j : Nat) → (c : Nat) → (e : Nat) → (hx : JEl a) →
         JLeq (jlp (jsz a) f (suc (plus j e)) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c j)) s0))))
              (jgot (jap (jencs a (jup S j c hx)) s0))
jlp-ok a S f s0 body zero c e hx =
  inr (jlp-unfold a f e hx (fromNat c) (fromNat (plus c zero)) s0
       ∙ (jif-false (%wlt (fromNat c) (fromNat (plus c zero))) (jlt-end c)
            (jthen (f (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c zero)) s0))))
                   (λ s2 → jlp (jsz a) f e (jincat (jsz a) (jslide (jsz a) (jsz a) s2))))
            (jgot (jslide (jsz a) (suc (suc zero)) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c zero)) s0)))))
          ∙ cong jgot (jslide-ok (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c zero)) nil)) s0 (jsz a) (suc (suc zero)) (jlen-enc a hx) refl)))
jlp-ok a S f s0 body (suc j) c e hx =
  jleq-pre (jlp (jsz a) f (suc (suc (plus j e))) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))
           (jthen (f (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))
                  (λ s2 → jlp (jsz a) f (suc (plus j e)) (jincat (jsz a) (jslide (jsz a) (jsz a) s2))))
           (jgot (jap (jencs a (jup S (suc j) c hx)) s0))
    (jlp-unfold a f (suc (plus j e)) hx (fromNat c) (fromNat (plus c (suc j))) s0
     ∙ jif-true (%wlt (fromNat c) (fromNat (plus c (suc j)))) (jlt-more c j)
         (jthen (f (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))
                (λ s2 → jlp (jsz a) f (suc (plus j e)) (jincat (jsz a) (jslide (jsz a) (jsz a) s2))))
         (jgot (jslide (jsz a) (suc (suc zero)) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))))
    (jleq-trans
       (jthen (f (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))
              (λ s2 → jlp (jsz a) f (suc (plus j e)) (jincat (jsz a) (jslide (jsz a) (jsz a) s2))))
       (jlp (jsz a) f (suc (plus j e)) (jincat (jsz a) (jslide (jsz a) (jsz a)
          (jap (jencs a (S c hx)) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0)))))))
       (jgot (jap (jencs a (jup S (suc j) c hx)) s0))
       (jleq-thengot (f (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))
                     (jap (jencs a (S c hx)) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))))
                     (λ s2 → jlp (jsz a) f (suc (plus j e)) (jincat (jsz a) (jslide (jsz a) (jsz a) s2)))
                     (body c hx (fromNat (plus c (suc j)))))
       (jleq-pre
          (jlp (jsz a) f (suc (plus j e)) (jincat (jsz a) (jslide (jsz a) (jsz a)
             (jap (jencs a (S c hx)) (jap (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0)))))))
          (jlp (jsz a) f (suc (plus j e)) (jap (jencs a (S c hx)) (cons (fromNat (suc c)) (cons (fromNat (plus c (suc j))) s0))))
          (jgot (jap (jencs a (jup S (suc j) c hx)) s0))
          (cong (λ z → jlp (jsz a) f (suc (plus j e)) z)
                (cong (jincat (jsz a)) (jslide-ok (jencs a (S c hx)) (jencs a hx) (cons (fromNat c) (cons (fromNat (plus c (suc j))) s0))
                                                  (jsz a) (jsz a) (jlen-enc a (S c hx)) (jlen-enc a hx))
                 ∙ jincat-enc a (S c hx) (fromNat c) (cons (fromNat (plus c (suc j))) s0)))
          (transport (λ i → JLeq (jlp (jsz a) f (suc (plus j e)) (jap (jencs a (S c hx)) (cons (fromNat (suc c)) (cons (fromNat (plus-suc c j (~ i))) s0))))
                                 (jgot (jap (jencs a (jup S j (suc c) (S c hx))) s0)))
                     (jlp-ok a S f s0 body j (suc c) e (S c hx)))))

-- any fuel that is the round count
jlp-fuel : (a : JTy) → (S : Nat → JEl a → JEl a) → (f : List Word → JRes (List Word)) → (s0 : List Word) → JBodyOk a S f s0 →
           (n : Nat) → (hx : JEl a) → (fu : Nat) → fu ≡ plus n zero →
           JLeq (jlp (jsz a) f (suc fu) (jap (jencs a hx) (cons #0 (cons (fromNat n) s0))))
                (jgot (jap (jencs a (jup S n zero hx)) s0))
jlp-fuel a S f s0 body n hx fu e =
  transport (λ i → JLeq (jlp (jsz a) f (suc (e (~ i))) (jap (jencs a hx) (cons #0 (cons (fromNat n) s0))))
                        (jgot (jap (jencs a (jup S n zero hx)) s0)))
            (jlp-ok a S f s0 body n zero zero hx)

-- the loop's entry: the bound fromNat n, the counter 0, the fuel the bound's count
jlp-entry : (a : JTy) → (S : Nat → JEl a → JEl a) → (f : List Word → JRes (List Word)) → (s0 : List Word) → JBodyOk a S f s0 →
            (n : Nat) → (hx : JEl a) →
            JLeq (jlp (jsz a) f (suc (toNat (fromNat n))) (jap (jencs a hx) (cons #0 (cons (fromNat n) s0))))
                 (jgot (jap (jencs a (jup S n zero hx)) s0))
jlp-entry a S f s0 body n hx = jlp-fuel a S f s0 body n hx (toNat (fromNat n)) (toNat-fromNat n ∙ sym (plus-zero n))

-- the loop instruction from its entry stack (the state, 0, the bound fromNat n)
jloop-gen : (a : JTy) → (Z : JEl a) → (S : Nat → JEl a → JEl a) → (body : JCode) → (k : JCode) → (s0 : List Word) →
            JBodyOk a S (λ s2 → jrun body s2) s0 → (n : Nat) → (V : JEl a) → jup S n zero Z ≡ V →
            JAfter (jrun (kloop (jsz a) body k) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0)))) k (jencs a V) s0
jloop-gen a Z S body k s0 bok n V eV =
  jleq-pre (jrun (kloop (jsz a) body k) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0))))
           (jthen (jlp (jsz a) (λ s2 → jrun body s2) (suc (toNat (fromNat n))) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0)))) (λ s2 → jrun k s2))
           (jrun k (jap (jencs a V) s0))
    (λ i → jloop-go (jsz a) (λ s2 → jrun body s2) (λ s2 → jrun k s2) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0)))
                    (jnth-enc1 a Z #0 (fromNat n) s0 i))
    (jleq-post (jthen (jlp (jsz a) (λ s2 → jrun body s2) (suc (toNat (fromNat n))) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0)))) (λ s2 → jrun k s2))
               (jrun k (jap (jencs a (jup S n zero Z)) s0))
               (jrun k (jap (jencs a V) s0))
       (jleq-thengot (jlp (jsz a) (λ s2 → jrun body s2) (suc (toNat (fromNat n))) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0))))
                     (jap (jencs a (jup S n zero Z)) s0) (λ s2 → jrun k s2)
                     (jlp-entry a S (λ s2 → jrun body s2) s0 bok n Z))
       (cong (λ v → jrun k (jap (jencs a v) s0)) eV))

jloop-nat : (a : JTy) → (Z : JEl a) → (S : Nat → JEl a → JEl a) → (body : JCode) → (k : JCode) → (s0 : List Word) →
            JBodyOk a S (λ s2 → jrun body s2) s0 → (n : Nat) →
            JAfter (jrun (kloop (jsz a) body k) (jap (jencs a Z) (cons #0 (cons (fromNat n) s0)))) k (jencs a (jnatrec-ev Z S n)) s0
jloop-nat a Z S body k s0 bok n = jloop-gen a Z S body k s0 bok n (jnatrec-ev Z S n) (jup-down (λ c → jnatrec-ev Z S c) S (λ c → refl) n zero)

jloop-word : (a : JTy) → (Z : JEl a) → (Sw : Word → JEl a → JEl a) → (body : JCode) → (k : JCode) → (s0 : List Word) →
             JBodyOk a (λ c hx → Sw (fromNat c) hx) (λ s2 → jrun body s2) s0 → (w : Word) →
             JAfter (jrun (kloop (jsz a) body k) (jap (jencs a Z) (cons #0 (cons w s0)))) k (jencs a (jloop-ev w Z Sw)) s0
jloop-word a Z Sw body k s0 bok w =
  transport (λ i → JAfter (jrun (kloop (jsz a) body k) (jap (jencs a Z) (cons #0 (cons (fromNat-toNat w i) s0)))) k (jencs a (jloop-ev (fromNat-toNat w i) Z Sw)) s0)
            (jloop-gen a Z (λ c hx → Sw (fromNat c) hx) body k s0 bok (toNat w) (jloop-ev (fromNat (toNat w)) Z Sw)
                       (jup-down (λ c → jloop-ev (fromNat c) Z Sw) (λ c hx → Sw (fromNat c) hx) (λ c → refl) (toNat w) zero))

-- ---------------------------------------------------------------- the compiler
kzeros : Nat → JCode → JCode
kzeros zero k = k
kzeros (suc n) k = kimm #0 (kzeros n k)

-- a loop body's placement: the state, the counter, the bound, then the context three deeper
jbodyp : (g : List JTy) → (b0 : JTy) → (a : JTy) → JPl g → JPl (cons a (cons b0 g))
jbodyp g b0 a p = (zero , jpshn (cons b0 g) (jsz a) (zero , jpshn g (jsz b0) (jpshn g (suc zero) p)))

-- the forms that read the type expected (a pair, an injection): the code for each type
jcx-pair : (g : List JTy) → (a : JTy) → JPl g → JCode → (JTy → JPl g → JCode → JCode) → (JTy → JPl g → JCode → JCode) → JCode
jcx-pair g jw p k cx cy = kfail
jcx-pair g jb p k cx cy = kfail
jcx-pair g jn p k cx cy = kfail
jcx-pair g (jprod a1 a2) p k cx cy = cy a2 p (cx a1 (jpshn g (jsz a2) p) k)
jcx-pair g (jsum a1 a2) p k cx cy = kfail
jcx-pair g (jarr a1 a2) p k cx cy = kfail

jcx-inl : (g : List JTy) → (a : JTy) → JPl g → JCode → (JTy → JPl g → JCode → JCode) → JCode
jcx-inl g jw p k cx = kfail
jcx-inl g jb p k cx = kfail
jcx-inl g jn p k cx = kfail
jcx-inl g (jprod a1 a2) p k cx = kfail
jcx-inl g (jsum a1 a2) p k cx = kzeros (jsz a2) (cx a1 (jpshn g (jsz a2) p) (kimm #0 k))
jcx-inl g (jarr a1 a2) p k cx = kfail

jcx-inr : (g : List JTy) → (a : JTy) → JPl g → JCode → (JTy → JPl g → JCode → JCode) → JCode
jcx-inr g jw p k cy = kfail
jcx-inr g jb p k cy = kfail
jcx-inr g jn p k cy = kfail
jcx-inr g (jprod a1 a2) p k cy = kfail
jcx-inr g (jsum a1 a2) p k cy = cy a2 p (kzeros (jsz a1) (kimm #1 k))
jcx-inr g (jarr a1 a2) p k cy = kfail

-- t at type a in context g, the variables at p, then k. A function (jlam, japp) is not compiled
-- at this level
jcx : JTm → (g : List JTy) → JTy → JPl g → JCode → JCode
jcx (jvar n) g a p k = jvcode g p n a k
jcx (jlit w) g a p k = jfitc (jteq jw a) (kimm w k)
jcx (jop o x y) g a p k = jfitc (jteq jw a) (jcx x g jw p (jcx y g jw (jpshn g (suc zero) p) (kop o k)))
jcx (jcmp o x y) g a p k = jfitc (jteq jb a) (jcx x g jw p (jcx y g jw (jpshn g (suc zero) p) (kcmp o k)))
jcx jtt g a p k = jfitc (jteq jb a) (kimm #0 k)
jcx jff g a p k = jfitc (jteq jb a) (kimm #1 k)
jcx (jif c t e) g a p k = jcx c g jb p (kif (jcx t g a p kdone) (jcx e g a p kdone) k)
jcx (jlet b t u) g a p k = jcx t g b p (jcx u (cons b g) a (zero , jpshn g (jsz b) p) (kslide (jsz a) (jsz b) k))
jcx (jlam u) g a p k = kfail
jcx (japp b f x) g a p k = kfail
jcx (jpair x y) g a p k = jcx-pair g a p k (λ b q k2 → jcx x g b q k2) (λ b q k2 → jcx y g b q k2)
jcx (jfst b q) g a p k = jcx q g (jprod a b) p (kslide (jsz a) (jsz b) k)
jcx (jsnd b q) g a p k = jcx q g (jprod b a) p (kslide zero (jsz b) k)
jcx (jinl x) g a p k = jcx-inl g a p k (λ b q k2 → jcx x g b q k2)
jcx (jinr y) g a p k = jcx-inr g a p k (λ b q k2 → jcx y g b q k2)
jcx (jcase b1 b2 q l m) g a p k =
  jcx q g (jsum b1 b2) p
    (kif (kslide (jsz b1) (jsz b2) (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)))
         (kslide zero (jsz b1) (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)))
         k)
jcx jzero g a p k = jfitc (jteq jn a) (kimm #0 k)
jcx (jsuc n) g a p k = jfitc (jteq jn a) (jcx n g jn p (kinc k))
jcx (jnatrec z st n) g a p k =
  jcx n g jn p (kimm #0 (jcx z g a (jpshn g (suc zero) (jpshn g (suc zero) p))
                           (kloop (jsz a) (jcx st (cons a (cons jn g)) a (jbodyp g jn a p) kdone) k)))
jcx (jloop bb z st) g a p k =
  jcx bb g jw p (kimm #0 (jcx z g a (jpshn g (suc zero) (jpshn g (suc zero) p))
                            (kloop (jsz a) (jcx st (cons a (cons jw g)) a (jbodyp g jw a p) kdone) k)))

-- ---------------------------------------------------------------- the compiler is right
-- what is proved of each term: from any placed stack, its code ends as k run on its value's words
JOk : JTm → (g : List JTy) → JEnv g → Type
JOk x g r = (b : JTy) → (q : JPl g) → (k1 : JCode) → (s1 : List Word) → JPlaced g q r s1 →
            JAfter (jrun (jcx x g b q k1) s1) k1 (jencs b (jev x g b r)) s1

jkz-ok : (n : Nat) → (k : JCode) → (s : List Word) → JLeq (jrun (kzeros n k) s) (jrun k (jap (jzeros n) s))
jkz-ok zero k s = inr refl
jkz-ok (suc n) k s =
  jleq-trans (jrun (kimm #0 (kzeros n k)) s) (jrun (kzeros n k) (cons #0 s)) (jrun k (cons #0 (jap (jzeros n) s)))
    (jst-imm #0 (kzeros n k) s)
    (jleq-post (jrun (kzeros n k) (cons #0 s)) (jrun k (jap (jzeros n) (cons #0 s))) (jrun k (cons #0 (jap (jzeros n) s)))
       (jkz-ok n k (cons #0 s)) (cong (jrun k) (jzeros-cons n s)))

-- (in three steps: the bound pushed, the counter bound, the state bound)
jpl-bd : (g : List JTy) → (p : JPl g) → (r : JEnv g) → (s0 : List Word) → JPlaced g p r s0 → (bd : Word) →
         JPlaced g (jpshn g (suc zero) p) r (cons bd s0)
jpl-bd g p r s0 h bd = jplaced-push g p r s0 (cons bd nil) h

jpl-ctr : (g : List JTy) → (p : JPl g) → (r : JEnv g) → (s0 : List Word) → JPlaced g p r s0 → (b0 : JTy) → (c : JEl b0) → (bd : Word) →
          JPlaced (cons b0 g) (zero , jpshn g (jsz b0) (jpshn g (suc zero) p)) (c , r) (jap (jencs b0 c) (cons bd s0))
jpl-ctr g p r s0 h b0 c bd = jplaced-bind g b0 (jpshn g (suc zero) p) r (cons bd s0) c (jpl-bd g p r s0 h bd)

jpl-body : (g : List JTy) → (p : JPl g) → (r : JEnv g) → (s0 : List Word) → JPlaced g p r s0 → (b0 : JTy) → (a : JTy) →
           (c : JEl b0) → (hx : JEl a) → (bd : Word) →
           JPlaced (cons a (cons b0 g)) (jbodyp g b0 a p) (hx , (c , r)) (jap (jencs a hx) (jap (jencs b0 c) (cons bd s0)))
jpl-body g p r s0 h b0 a c hx bd =
  jplaced-bind (cons b0 g) a (zero , jpshn g (jsz b0) (jpshn g (suc zero) p)) (c , r) (jap (jencs b0 c) (cons bd s0)) hx (jpl-ctr g p r s0 h b0 c bd)

-- two words computed, then an instruction on them
ok-bin : (cx : JCode → JCode) → (cy : JCode → JCode) → (K : JCode) → (k : JCode) → (vx : Word) → (vy : Word) → (w : Word) → (s : List Word) →
         ((k1 : JCode) → JLeq (jrun (cx k1) s) (jrun k1 (cons vx s))) →
         ((k1 : JCode) → JLeq (jrun (cy k1) (cons vx s)) (jrun k1 (cons vy (cons vx s)))) →
         JLeq (jrun K (cons vy (cons vx s))) (jrun k (cons w s)) →
         JLeq (jrun (cx (cy K)) s) (jrun k (cons w s))
ok-bin cx cy K k vx vy w s hx hy st =
  jleq-trans (jrun (cx (cy K)) s) (jrun (cy K) (cons vx s)) (jrun k (cons w s)) (hx (cy K))
    (jleq-trans (jrun (cy K) (cons vx s)) (jrun K (cons vy (cons vx s))) (jrun k (cons w s)) (hy K) st)

ok-if : (b : Bool) → (a : JTy) → (vt : JEl a) → (ve : JEl a) → (T : JCode) → (E : JCode) → (k : JCode) → (s : List Word) →
        JLeq (jrun T s) (jgot (jap (jencs a vt) s)) → JLeq (jrun E s) (jgot (jap (jencs a ve) s)) →
        JLeq (jrun (kif T E k) (cons (if b then #0 else #1) s)) (jrun k (jap (jencs a (if b then vt else ve)) s))
ok-if true a vt ve T E k s ht he = jleq-thengot (jrun T s) (jap (jencs a vt) s) (λ s2 → jrun k s2) ht
ok-if false a vt ve T E k s ht he = jleq-thengot (jrun E s) (jap (jencs a ve) s) (λ s2 → jrun k s2) he

ok-slide : (a : JTy) → (b : JTy) → (va : JEl a) → (vb : JEl b) → (k : JCode) → (s : List Word) →
           JLeq (jrun (kslide (jsz a) (jsz b) k) (jap (jencs a va) (jap (jencs b vb) s))) (jrun k (jap (jencs a va) s))
ok-slide a b va vb k s = inr (cong (jrun k) (jslide-ok (jencs a va) (jencs b vb) s (jsz a) (jsz b) (jlen-enc a va) (jlen-enc b vb)))

ok-fst : (a : JTy) → (b : JTy) → (vq : JEl (jprod a b)) → (k : JCode) → (s : List Word) →
         JLeq (jrun (kslide (jsz a) (jsz b) k) (jap (jencs (jprod a b) vq) s)) (jrun k (jap (jencs a (fst vq)) s))
ok-fst a b vq k s =
  jleq-pre (jrun (kslide (jsz a) (jsz b) k) (jap (jencs (jprod a b) vq) s))
           (jrun (kslide (jsz a) (jsz b) k) (jap (jencs a (fst vq)) (jap (jencs b (snd vq)) s)))
           (jrun k (jap (jencs a (fst vq)) s))
    (cong (λ z → jrun (kslide (jsz a) (jsz b) k) z) (jap-assoc (jencs a (fst vq)) (jencs b (snd vq)) s))
    (ok-slide a b (fst vq) (snd vq) k s)

-- the first part's words dropped (stated over lists, so that no value's words are unfolded)
jsnd-a : (xs : List Word) → (ys : List Word) → (s : List Word) → (m : Nat) → jlen xs ≡ m → (k : JCode) →
         JLeq (jrun (kslide zero m k) (jap xs (jap ys s))) (jrun k (jap ys s))
jsnd-a xs ys s m e k = inr (cong (jrun k) (jslide-ok nil xs (jap ys s) zero m refl e))

jslide-snd : (xs : List Word) → (ys : List Word) → (s : List Word) → (m : Nat) → jlen xs ≡ m → (k : JCode) →
             JLeq (jrun (kslide zero m k) (jap (jap xs ys) s)) (jrun k (jap ys s))
jslide-snd xs ys s m e k =
  jleq-pre (jrun (kslide zero m k) (jap (jap xs ys) s)) (jrun (kslide zero m k) (jap xs (jap ys s))) (jrun k (jap ys s))
    (cong (λ z → jrun (kslide zero m k) z) (jap-assoc xs ys s)) (jsnd-a xs ys s m e k)

ok-snd : (b : JTy) → (a : JTy) → (vq : JEl (jprod b a)) → (k : JCode) → (s : List Word) →
         JLeq (jrun (kslide zero (jsz b) k) (jap (jencs (jprod b a) vq) s)) (jrun k (jap (jencs a (snd vq)) s))
ok-snd b a vq k s = jslide-snd (jencs b (fst vq)) (jencs a (snd vq)) s (jsz b) (jlen-enc b (fst vq)) k

ok-pair : (a : JTy) → (x : JTm) → (y : JTm) → (g : List JTy) → (p : JPl g) → (k : JCode) → (r : JEnv g) → (s : List Word) →
          JPlaced g p r s → JOk x g r → JOk y g r →
          JAfter (jrun (jcx (jpair x y) g a p k) s) k (jencs a (jev (jpair x y) g a r)) s
ok-pair jw x y g p k r s h hx hy = inl refl
ok-pair jb x y g p k r s h hx hy = inl refl
ok-pair jn x y g p k r s h hx hy = inl refl
ok-pair (jprod a1 a2) x y g p k r s h hx hy =
  jleq-trans (jrun (jcx y g a2 p (jcx x g a1 (jpshn g (jsz a2) p) k)) s)
             (jrun (jcx x g a1 (jpshn g (jsz a2) p) k) (jap (jencs a2 (jev y g a2 r)) s))
             (jrun k (jap (jap (jencs a1 (jev x g a1 r)) (jencs a2 (jev y g a2 r))) s))
    (hy a2 p (jcx x g a1 (jpshn g (jsz a2) p) k) s h)
    (jleq-post (jrun (jcx x g a1 (jpshn g (jsz a2) p) k) (jap (jencs a2 (jev y g a2 r)) s))
               (jrun k (jap (jencs a1 (jev x g a1 r)) (jap (jencs a2 (jev y g a2 r)) s)))
               (jrun k (jap (jap (jencs a1 (jev x g a1 r)) (jencs a2 (jev y g a2 r))) s))
       (hx a1 (jpshn g (jsz a2) p) k (jap (jencs a2 (jev y g a2 r)) s)
           (jplaced-pushn g p r s (jencs a2 (jev y g a2 r)) (jsz a2) (jlen-enc a2 (jev y g a2 r)) h))
       (cong (jrun k) (sym (jap-assoc (jencs a1 (jev x g a1 r)) (jencs a2 (jev y g a2 r)) s))))
ok-pair (jsum a1 a2) x y g p k r s h hx hy = inl refl
ok-pair (jarr a1 a2) x y g p k r s h hx hy = inl refl

ok-inl : (a : JTy) → (x : JTm) → (g : List JTy) → (p : JPl g) → (k : JCode) → (r : JEnv g) → (s : List Word) →
         JPlaced g p r s → JOk x g r →
         JAfter (jrun (jcx (jinl x) g a p k) s) k (jencs a (jev (jinl x) g a r)) s
ok-inl jw x g p k r s h hx = inl refl
ok-inl jb x g p k r s h hx = inl refl
ok-inl jn x g p k r s h hx = inl refl
ok-inl (jprod a1 a2) x g p k r s h hx = inl refl
ok-inl (jsum a1 a2) x g p k r s h hx =
  jleq-trans (jrun (kzeros (jsz a2) (jcx x g a1 (jpshn g (jsz a2) p) (kimm #0 k))) s)
             (jrun (jcx x g a1 (jpshn g (jsz a2) p) (kimm #0 k)) (jap (jzeros (jsz a2)) s))
             (jrun k (cons #0 (jap (jap (jencs a1 (jev x g a1 r)) (jzeros (jsz a2))) s)))
    (jkz-ok (jsz a2) (jcx x g a1 (jpshn g (jsz a2) p) (kimm #0 k)) s)
    (jleq-trans (jrun (jcx x g a1 (jpshn g (jsz a2) p) (kimm #0 k)) (jap (jzeros (jsz a2)) s))
                (jrun (kimm #0 k) (jap (jencs a1 (jev x g a1 r)) (jap (jzeros (jsz a2)) s)))
                (jrun k (cons #0 (jap (jap (jencs a1 (jev x g a1 r)) (jzeros (jsz a2))) s)))
       (hx a1 (jpshn g (jsz a2) p) (kimm #0 k) (jap (jzeros (jsz a2)) s)
           (jplaced-pushn g p r s (jzeros (jsz a2)) (jsz a2) (jlen-zeros (jsz a2)) h))
       (jleq-post (jrun (kimm #0 k) (jap (jencs a1 (jev x g a1 r)) (jap (jzeros (jsz a2)) s)))
                  (jrun k (cons #0 (jap (jencs a1 (jev x g a1 r)) (jap (jzeros (jsz a2)) s))))
                  (jrun k (cons #0 (jap (jap (jencs a1 (jev x g a1 r)) (jzeros (jsz a2))) s)))
          (jst-imm #0 k (jap (jencs a1 (jev x g a1 r)) (jap (jzeros (jsz a2)) s)))
          (cong (λ z → jrun k (cons #0 z)) (sym (jap-assoc (jencs a1 (jev x g a1 r)) (jzeros (jsz a2)) s)))))
ok-inl (jarr a1 a2) x g p k r s h hx = inl refl

ok-inr : (a : JTy) → (y : JTm) → (g : List JTy) → (p : JPl g) → (k : JCode) → (r : JEnv g) → (s : List Word) →
         JPlaced g p r s → JOk y g r →
         JAfter (jrun (jcx (jinr y) g a p k) s) k (jencs a (jev (jinr y) g a r)) s
ok-inr jw y g p k r s h hy = inl refl
ok-inr jb y g p k r s h hy = inl refl
ok-inr jn y g p k r s h hy = inl refl
ok-inr (jprod a1 a2) y g p k r s h hy = inl refl
ok-inr (jsum a1 a2) y g p k r s h hy =
  jleq-trans (jrun (jcx y g a2 p (kzeros (jsz a1) (kimm #1 k))) s)
             (jrun (kzeros (jsz a1) (kimm #1 k)) (jap (jencs a2 (jev y g a2 r)) s))
             (jrun k (cons #1 (jap (jap (jzeros (jsz a1)) (jencs a2 (jev y g a2 r))) s)))
    (hy a2 p (kzeros (jsz a1) (kimm #1 k)) s h)
    (jleq-trans (jrun (kzeros (jsz a1) (kimm #1 k)) (jap (jencs a2 (jev y g a2 r)) s))
                (jrun (kimm #1 k) (jap (jzeros (jsz a1)) (jap (jencs a2 (jev y g a2 r)) s)))
                (jrun k (cons #1 (jap (jap (jzeros (jsz a1)) (jencs a2 (jev y g a2 r))) s)))
       (jkz-ok (jsz a1) (kimm #1 k) (jap (jencs a2 (jev y g a2 r)) s))
       (jleq-post (jrun (kimm #1 k) (jap (jzeros (jsz a1)) (jap (jencs a2 (jev y g a2 r)) s)))
                  (jrun k (cons #1 (jap (jzeros (jsz a1)) (jap (jencs a2 (jev y g a2 r)) s))))
                  (jrun k (cons #1 (jap (jap (jzeros (jsz a1)) (jencs a2 (jev y g a2 r))) s)))
          (jst-imm #1 k (jap (jzeros (jsz a1)) (jap (jencs a2 (jev y g a2 r)) s)))
          (cong (λ z → jrun k (cons #1 z)) (sym (jap-assoc (jzeros (jsz a1)) (jencs a2 (jev y g a2 r)) s)))))
ok-inr (jarr a1 a2) y g p k r s h hy = inl refl

-- a case: after the tag is read, the payload's words alone, the branch, its value over them dropped
ok-case : (b1 : JTy) → (b2 : JTy) → (a : JTy) → (l : JTm) → (m : JTm) → (g : List JTy) → (p : JPl g) → (k : JCode) → (r : JEnv g) → (s : List Word) →
          JPlaced g p r s → ((x : JEl b1) → JOk l (cons b1 g) (x , r)) → ((y : JEl b2) → JOk m (cons b2 g) (y , r)) → (v : JEl (jsum b1 b2)) →
          JLeq (jrun (kif (kslide (jsz b1) (jsz b2) (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)))
                          (kslide zero (jsz b1) (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)))
                          k)
                     (jap (jencs (jsum b1 b2) v) s))
               (jrun k (jap (jencs a (jsumel (JEl b1) (JEl b2) (JEl a) v (λ x → jev l (cons b1 g) a (x , r)) (λ y → jev m (cons b2 g) a (y , r)))) s))
ok-case b1 b2 a l m g p k r s h hl hm (inl x) =
  jleq-thengot (jrun (kslide (jsz b1) (jsz b2) (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)))
                     (jap (jap (jencs b1 x) (jzeros (jsz b2))) s))
               (jap (jencs a (jev l (cons b1 g) a (x , r))) s) (λ s2 → jrun k s2)
    (jleq-pre (jrun (kslide (jsz b1) (jsz b2) (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)))
                    (jap (jap (jencs b1 x) (jzeros (jsz b2))) s))
              (jrun (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)) (jap (jencs b1 x) s))
              (jgot (jap (jencs a (jev l (cons b1 g) a (x , r))) s))
       (cong (λ z → jrun (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)) z)
             (cong (jslide (jsz b1) (jsz b2)) (jap-assoc (jencs b1 x) (jzeros (jsz b2)) s)
              ∙ jslide-ok (jencs b1 x) (jzeros (jsz b2)) s (jsz b1) (jsz b2) (jlen-enc b1 x) (jlen-zeros (jsz b2))))
       (jleq-trans (jrun (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)) (jap (jencs b1 x) s))
                   (jrun (kslide (jsz a) (jsz b1) kdone) (jap (jencs a (jev l (cons b1 g) a (x , r))) (jap (jencs b1 x) s)))
                   (jgot (jap (jencs a (jev l (cons b1 g) a (x , r))) s))
          (hl x a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone) (jap (jencs b1 x) s) (jplaced-bind g b1 p r s x h))
          (ok-slide a b1 (jev l (cons b1 g) a (x , r)) x kdone s)))
ok-case b1 b2 a l m g p k r s h hl hm (inr y) =
  jleq-thengot (jrun (kslide zero (jsz b1) (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)))
                     (jap (jap (jzeros (jsz b1)) (jencs b2 y)) s))
               (jap (jencs a (jev m (cons b2 g) a (y , r))) s) (λ s2 → jrun k s2)
    (jleq-pre (jrun (kslide zero (jsz b1) (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)))
                    (jap (jap (jzeros (jsz b1)) (jencs b2 y)) s))
              (jrun (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)) (jap (jencs b2 y) s))
              (jgot (jap (jencs a (jev m (cons b2 g) a (y , r))) s))
       (cong (λ z → jrun (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)) z)
             (cong (jslide zero (jsz b1)) (jap-assoc (jzeros (jsz b1)) (jencs b2 y) s)
              ∙ jslide-ok nil (jzeros (jsz b1)) (jap (jencs b2 y) s) zero (jsz b1) refl (jlen-zeros (jsz b1))))
       (jleq-trans (jrun (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)) (jap (jencs b2 y) s))
                   (jrun (kslide (jsz a) (jsz b2) kdone) (jap (jencs a (jev m (cons b2 g) a (y , r))) (jap (jencs b2 y) s)))
                   (jgot (jap (jencs a (jev m (cons b2 g) a (y , r))) s))
          (hm y a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone) (jap (jencs b2 y) s) (jplaced-bind g b2 p r s y h))
          (ok-slide a b2 (jev m (cons b2 g) a (y , r)) y kdone s)))

-- a recursion: the bound, the counter 0, the initial state, then the loop
ok-rec : (a : JTy) → (cb : JCode → JCode) → (cz : JCode → JCode) → (KL : JCode) → (k : JCode) → (B : Word) → (vz : JEl a) →
         (s0 : List Word) → (V : List Word) →
         ((k1 : JCode) → JLeq (jrun (cb k1) s0) (jrun k1 (cons B s0))) →
         ((k1 : JCode) → JLeq (jrun (cz k1) (cons #0 (cons B s0))) (jrun k1 (jap (jencs a vz) (cons #0 (cons B s0))))) →
         JLeq (jrun KL (jap (jencs a vz) (cons #0 (cons B s0)))) (jrun k V) →
         JLeq (jrun (cb (kimm #0 (cz KL))) s0) (jrun k V)
ok-rec a cb cz KL k B vz s0 V hb hz hl =
  jleq-trans (jrun (cb (kimm #0 (cz KL))) s0) (jrun (kimm #0 (cz KL)) (cons B s0)) (jrun k V) (hb (kimm #0 (cz KL)))
    (jleq-trans (jrun (kimm #0 (cz KL)) (cons B s0)) (jrun (cz KL) (cons #0 (cons B s0))) (jrun k V) (jst-imm #0 (cz KL) (cons B s0))
       (jleq-trans (jrun (cz KL) (cons #0 (cons B s0))) (jrun KL (jap (jencs a vz) (cons #0 (cons B s0)))) (jrun k V) (hz KL) hl))

-- the compiler is right: from a stack where the context's values are placed, t's code ends as k run
-- on t's value's words pushed, or leaves
jcx-ok : (t : JTm) → (g : List JTy) → (a : JTy) → (p : JPl g) → (k : JCode) → (r : JEnv g) → (s : List Word) → JPlaced g p r s →
         JAfter (jrun (jcx t g a p k) s) k (jencs a (jev t g a r)) s
jcx-ok (jvar n) g a p k r s h = jvcode-ok g p n a k r s h
jcx-ok (jlit w) g a p k r s h = jfit-ok jw a w (kimm w k) k s (jst-imm w k s)
jcx-ok (jop o x y) g a p k r s h =
  jfit-ok jw a (jwop o (jev x g jw r) (jev y g jw r)) (jcx x g jw p (jcx y g jw (jpshn g (suc zero) p) (kop o k))) k s
    (ok-bin (λ k1 → jcx x g jw p k1) (λ k1 → jcx y g jw (jpshn g (suc zero) p) k1) (kop o k) k
            (jev x g jw r) (jev y g jw r) (jwop o (jev x g jw r) (jev y g jw r)) s
            (λ k1 → jcx-ok x g jw p k1 r s h)
            (λ k1 → jcx-ok y g jw (jpshn g (suc zero) p) k1 r (cons (jev x g jw r) s) (jplaced-push g p r s (cons (jev x g jw r) nil) h))
            (jst-op o k (jev x g jw r) (jev y g jw r) s))
jcx-ok (jcmp o x y) g a p k r s h =
  jfit-ok jb a (jwcmp o (jev x g jw r) (jev y g jw r)) (jcx x g jw p (jcx y g jw (jpshn g (suc zero) p) (kcmp o k))) k s
    (ok-bin (λ k1 → jcx x g jw p k1) (λ k1 → jcx y g jw (jpshn g (suc zero) p) k1) (kcmp o k) k
            (jev x g jw r) (jev y g jw r) (if jwcmp o (jev x g jw r) (jev y g jw r) then #0 else #1) s
            (λ k1 → jcx-ok x g jw p k1 r s h)
            (λ k1 → jcx-ok y g jw (jpshn g (suc zero) p) k1 r (cons (jev x g jw r) s) (jplaced-push g p r s (cons (jev x g jw r) nil) h))
            (inr refl))
jcx-ok jtt g a p k r s h = jfit-ok jb a true (kimm #0 k) k s (jst-imm #0 k s)
jcx-ok jff g a p k r s h = jfit-ok jb a false (kimm #1 k) k s (jst-imm #1 k s)
jcx-ok (jif c t e) g a p k r s h =
  jleq-trans (jrun (jcx c g jb p (kif (jcx t g a p kdone) (jcx e g a p kdone) k)) s)
             (jrun (kif (jcx t g a p kdone) (jcx e g a p kdone) k) (cons (if jev c g jb r then #0 else #1) s))
             (jrun k (jap (jencs a (if jev c g jb r then jev t g a r else jev e g a r)) s))
    (jcx-ok c g jb p (kif (jcx t g a p kdone) (jcx e g a p kdone) k) r s h)
    (ok-if (jev c g jb r) a (jev t g a r) (jev e g a r) (jcx t g a p kdone) (jcx e g a p kdone) k s
           (jcx-ok t g a p kdone r s h) (jcx-ok e g a p kdone r s h))
jcx-ok (jlet b t u) g a p k r s h =
  jleq-trans (jrun (jcx t g b p (jcx u (cons b g) a (zero , jpshn g (jsz b) p) (kslide (jsz a) (jsz b) k))) s)
             (jrun (jcx u (cons b g) a (zero , jpshn g (jsz b) p) (kslide (jsz a) (jsz b) k)) (jap (jencs b (jev t g b r)) s))
             (jrun k (jap (jencs a (jev u (cons b g) a (jev t g b r , r))) s))
    (jcx-ok t g b p (jcx u (cons b g) a (zero , jpshn g (jsz b) p) (kslide (jsz a) (jsz b) k)) r s h)
    (jleq-trans (jrun (jcx u (cons b g) a (zero , jpshn g (jsz b) p) (kslide (jsz a) (jsz b) k)) (jap (jencs b (jev t g b r)) s))
                (jrun (kslide (jsz a) (jsz b) k) (jap (jencs a (jev u (cons b g) a (jev t g b r , r))) (jap (jencs b (jev t g b r)) s)))
                (jrun k (jap (jencs a (jev u (cons b g) a (jev t g b r , r))) s))
       (jcx-ok u (cons b g) a (zero , jpshn g (jsz b) p) (kslide (jsz a) (jsz b) k) (jev t g b r , r) (jap (jencs b (jev t g b r)) s)
               (jplaced-bind g b p r s (jev t g b r) h))
       (ok-slide a b (jev u (cons b g) a (jev t g b r , r)) (jev t g b r) k s))
jcx-ok (jlam u) g a p k r s h = inl refl
jcx-ok (japp b f x) g a p k r s h = inl refl
jcx-ok (jpair x y) g a p k r s h =
  ok-pair a x y g p k r s h (λ b q k1 s1 h1 → jcx-ok x g b q k1 r s1 h1) (λ b q k1 s1 h1 → jcx-ok y g b q k1 r s1 h1)
jcx-ok (jfst b q) g a p k r s h =
  jleq-trans (jrun (jcx q g (jprod a b) p (kslide (jsz a) (jsz b) k)) s)
             (jrun (kslide (jsz a) (jsz b) k) (jap (jencs (jprod a b) (jev q g (jprod a b) r)) s))
             (jrun k (jap (jencs a (fst (jev q g (jprod a b) r))) s))
    (jcx-ok q g (jprod a b) p (kslide (jsz a) (jsz b) k) r s h)
    (ok-fst a b (jev q g (jprod a b) r) k s)
jcx-ok (jsnd b q) g a p k r s h =
  jleq-trans (jrun (jcx q g (jprod b a) p (kslide zero (jsz b) k)) s)
             (jrun (kslide zero (jsz b) k) (jap (jencs (jprod b a) (jev q g (jprod b a) r)) s))
             (jrun k (jap (jencs a (snd (jev q g (jprod b a) r))) s))
    (jcx-ok q g (jprod b a) p (kslide zero (jsz b) k) r s h)
    (ok-snd b a (jev q g (jprod b a) r) k s)
jcx-ok (jinl x) g a p k r s h = ok-inl a x g p k r s h (λ b q k1 s1 h1 → jcx-ok x g b q k1 r s1 h1)
jcx-ok (jinr y) g a p k r s h = ok-inr a y g p k r s h (λ b q k1 s1 h1 → jcx-ok y g b q k1 r s1 h1)
jcx-ok (jcase b1 b2 q l m) g a p k r s h =
  jleq-trans (jrun (jcx (jcase b1 b2 q l m) g a p k) s)
             (jrun (kif (kslide (jsz b1) (jsz b2) (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)))
                        (kslide zero (jsz b1) (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)))
                        k)
                   (jap (jencs (jsum b1 b2) (jev q g (jsum b1 b2) r)) s))
             (jrun k (jap (jencs a (jev (jcase b1 b2 q l m) g a r)) s))
    (jcx-ok q g (jsum b1 b2) p
       (kif (kslide (jsz b1) (jsz b2) (jcx l (cons b1 g) a (zero , jpshn g (jsz b1) p) (kslide (jsz a) (jsz b1) kdone)))
            (kslide zero (jsz b1) (jcx m (cons b2 g) a (zero , jpshn g (jsz b2) p) (kslide (jsz a) (jsz b2) kdone)))
            k) r s h)
    (ok-case b1 b2 a l m g p k r s h
       (λ x b q2 k1 s1 h1 → jcx-ok l (cons b1 g) b q2 k1 (x , r) s1 h1)
       (λ y b q2 k1 s1 h1 → jcx-ok m (cons b2 g) b q2 k1 (y , r) s1 h1)
       (jev q g (jsum b1 b2) r))
jcx-ok jzero g a p k r s h = jfit-ok jn a zero (kimm #0 k) k s (jst-imm #0 k s)
jcx-ok (jsuc n) g a p k r s h =
  jfit-ok jn a (suc (jev n g jn r)) (jcx n g jn p (kinc k)) k s
    (jleq-trans (jrun (jcx n g jn p (kinc k)) s) (jrun (kinc k) (cons (fromNat (jev n g jn r)) s)) (jrun k (cons (fromNat (suc (jev n g jn r))) s))
       (jcx-ok n g jn p (kinc k) r s h) (jst-inc k (fromNat (jev n g jn r)) s))
jcx-ok (jnatrec z st n) g a p k r s h =
  ok-rec a (λ k1 → jcx n g jn p k1) (λ k1 → jcx z g a (jpshn g (suc zero) (jpshn g (suc zero) p)) k1)
         (kloop (jsz a) (jcx st (cons a (cons jn g)) a (jbodyp g jn a p) kdone) k) k
         (fromNat (jev n g jn r)) (jev z g a r) s
         (jap (jencs a (jnatrec-ev (jev z g a r) (λ c hx → jev st (cons a (cons jn g)) a (hx , (c , r))) (jev n g jn r))) s)
    (λ k1 → jcx-ok n g jn p k1 r s h)
    (λ k1 → jcx-ok z g a (jpshn g (suc zero) (jpshn g (suc zero) p)) k1 r (cons #0 (cons (fromNat (jev n g jn r)) s))
                   (jpl-bd g (jpshn g (suc zero) p) r (cons (fromNat (jev n g jn r)) s) (jpl-bd g p r s h (fromNat (jev n g jn r))) #0))
    (jloop-nat a (jev z g a r) (λ c hx → jev st (cons a (cons jn g)) a (hx , (c , r)))
               (jcx st (cons a (cons jn g)) a (jbodyp g jn a p) kdone) k s
               (λ c hx bd → jcx-ok st (cons a (cons jn g)) a (jbodyp g jn a p) kdone (hx , (c , r))
                                   (jap (jencs a hx) (cons (fromNat c) (cons bd s))) (jpl-body g p r s h jn a c hx bd))
               (jev n g jn r))
jcx-ok (jloop bb z st) g a p k r s h =
  ok-rec a (λ k1 → jcx bb g jw p k1) (λ k1 → jcx z g a (jpshn g (suc zero) (jpshn g (suc zero) p)) k1)
         (kloop (jsz a) (jcx st (cons a (cons jw g)) a (jbodyp g jw a p) kdone) k) k
         (jev bb g jw r) (jev z g a r) s
         (jap (jencs a (jloop-ev (jev bb g jw r) (jev z g a r) (λ i x → jev st (cons a (cons jw g)) a (x , (i , r))))) s)
    (λ k1 → jcx-ok bb g jw p k1 r s h)
    (λ k1 → jcx-ok z g a (jpshn g (suc zero) (jpshn g (suc zero) p)) k1 r (cons #0 (cons (jev bb g jw r) s))
                   (jpl-bd g (jpshn g (suc zero) p) r (cons (jev bb g jw r) s) (jpl-bd g p r s h (jev bb g jw r)) #0))
    (jloop-word a (jev z g a r) (λ i x → jev st (cons a (cons jw g)) a (x , (i , r)))
                (jcx st (cons a (cons jw g)) a (jbodyp g jw a p) kdone) k s
                (λ c hx bd → jcx-ok st (cons a (cons jw g)) a (jbodyp g jw a p) kdone (hx , (fromNat c , r))
                                    (jap (jencs a hx) (cons (fromNat c) (cons bd s))) (jpl-body g p r s h jw a (fromNat c) hx bd))
                (jev bb g jw r))
