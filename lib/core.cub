-- Layer: our usage: a load list (lib/core.cub loads the library after the core) (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
-- lib/core.cub — the core, in load order: the fixed bootstrap files (the terms the checker is made
-- of, loaded without it), the checker (lib/check.cub) and the checked library over it (lib/std.cub).
-- A file loads after the core by importing this one; `make task-graph`, `make brunerie` and
-- tools/task-graph.py load it.
import "prelude.cub"
import "code.cub"
import "match.cub"
import "nav.cub"
import "cost.cub"
import "lin.cub"
import "check.cub"
import "std.cub"
