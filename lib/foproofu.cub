-- lib/foproofu.cub — the unboxed C link of the justifying path (plan 18.5 step 7, B16 milestone 2): from
-- the first-order form's checked meaning (lib/foproofq.cub's FQ and evq) to the unboxed C. Three parts:
-- U1 (this file), kinds for the first-order form, checked (ksyn, kok) and sound against evq (kind-sound);
-- U2 (lib/foproofcu.cub), CU, the unboxed C as checked syntax with its meaning evcu, the checked
-- translation fq-to-cu guided by U1's kinds, and cu-to-c, its printer; U3, cu-sound (whatever the
-- first-order form computes, the unboxed C computes, at every fuel). lib/emitu.cub's inference (infer-u,
-- use-ty: the first use decides) is not sound by construction — a wrong guess prints mkw(x->n) on a
-- constructor cell — so the proved route types by U1's kinds, checked per program, not by that inference.
-- Loaded after lib/foproofe.cub and lib/foproofc.cub; tested on its own line (tests/foproofu-progs.cub).
-- ---------------------------------------------------------------- U1: kinds
-- kw a word, an Int64 or a Float64 (a C uint64_t); kb a byte string; kdc d a constructor of data type
-- d (its fields' kinds from the program's table T d c i, each read as a flat kind: kw, kb, kdn or ka;
-- data type 0, the mirrors' tuple, only at constructor 0 with two fields); ka anything (boxed); kdn no
-- value; knil and kcons the kinds of a chain's values (an argument list, a loop's state). No value
-- (kqbot) has every value kind.
data Kd = kw | kb | kdc (d : Word) | ka | kdn | knil | kcons (k : Kd) (r : Kd)
-- a pair of data type 0: constructor 0, two fields
kc0 : Word → Word → KQ → Type
kc0 d c fs = if weq d #0 then (c ≡ #0) × (q-isn (suc (suc zero)) fs ≡ true) else Unit
-- a field's kind: the flat kinds read, any other anything
Kflat : (Word → Word → Nat → Kd) → Kd → KQ → Type
Kflat T ka x = Unit
Kflat T kdn kqbot = Unit
Kflat T kdn x = Empty
Kflat T kw kqbot = Unit
Kflat T kw (kqw w) = Unit
Kflat T kw (kqi b) = Unit
Kflat T kw (kqf b) = Unit
Kflat T kw x = Empty
Kflat T kb kqbot = Unit
Kflat T kb (kqb l) = Unit
Kflat T kb x = Empty
Kflat T k x = Unit
kflat-bot : (T : Word → Word → Nat → Kd) (k : Kd) → Kflat T k kqbot
kflat-bot T kw = unit
kflat-bot T kb = unit
kflat-bot T (kdc d) = unit
kflat-bot T ka = unit
kflat-bot T kdn = unit
kflat-bot T knil = unit
kflat-bot T (kcons k r) = unit
-- the fields of constructor c of d from field i on, each of its table's kind
kvf : (Word → Word → Nat → Kd) → KQ → Word → Word → Nat → Type
kvf T kqbot d c i = Unit
kvf T kqnil d c i = Unit
kvf T (kqcons x r) d c i = Kflat T (T d c i) x × kvf T r d c (suc i)
kvf T fs d c i = Empty
-- a value has a kind
Kv : (Word → Word → Nat → Kd) → Kd → KQ → Type
Kv T ka v = Unit
Kv T kdn kqbot = Unit
Kv T kdn v = Empty
Kv T kw kqbot = Unit
Kv T kw (kqw w) = Unit
Kv T kw (kqi b) = Unit
Kv T kw (kqf b) = Unit
Kv T kw v = Empty
Kv T kb kqbot = Unit
Kv T kb (kqb l) = Unit
Kv T kb v = Empty
Kv T (kdc d) kqbot = Unit
Kv T (kdc d) (kqcon d2 c fs) = ((d ≡ d2) × kc0 d c fs) × kvf T fs d c zero
Kv T (kdc d) v = Empty
Kv T knil v = Unit
Kv T (kcons k r) v = Unit
-- a chain's values have a chain's kinds
kvs : (Word → Word → Nat → Kd) → KQ → Kd → Type
kvs T kqnil knil = Unit
kvs T (kqcons x xs) (kcons k r) = Kv T k x × kvs T xs r
kvs T vs ks = Empty
kv-bot : (T : Word → Word → Nat → Kd) (k : Kd) → Kv T k kqbot
kv-bot T kw = unit
kv-bot T kb = unit
kv-bot T (kdc d) = unit
kv-bot T ka = unit
kv-bot T kdn = unit
kv-bot T knil = unit
kv-bot T (kcons k r) = unit
kv-bif : (T : Word → Word → Nat → Kd) (b : Bool) (k1 k2 : Kd) (v1 v2 : KQ) → Kv T k1 v1 → Kv T k2 v2 → Kv T (if b then k1 else k2) (if b then v1 else v2)
kv-bif T true k1 k2 v1 v2 h1 h2 = h1
kv-bif T false k1 k2 v1 v2 h1 h2 = h2
-- a field's flat kind as a value kind, and back
kflat-k : Kd → Kd
kflat-k kw = kw
kflat-k kb = kb
kflat-k kdn = kdn
kflat-k k = ka
kflat-kv : (T : Word → Word → Nat → Kd) (k : Kd) (x : KQ) → Kflat T k x → Kv T (kflat-k k) x
kflat-kv T kw kqbot h = unit
kflat-kv T kw (kqw w) h = unit
kflat-kv T kw (kqi b) h = unit
kflat-kv T kw (kqf b) h = unit
kflat-kv T kw x h = Empty-rec h
kflat-kv T kb kqbot h = unit
kflat-kv T kb (kqb l) h = unit
kflat-kv T kb x h = Empty-rec h
kflat-kv T kdn kqbot h = unit
kflat-kv T kdn x h = Empty-rec h
kflat-kv T k x h = unit
kv-flat : (T : Word → Word → Nat → Kd) (k : Kd) (x : KQ) → Kv T (kflat-k k) x → Kflat T k x
kv-flat T kw kqbot h = unit
kv-flat T kw (kqw w) h = unit
kv-flat T kw (kqi b) h = unit
kv-flat T kw (kqf b) h = unit
kv-flat T kw x h = Empty-rec h
kv-flat T kb kqbot h = unit
kv-flat T kb (kqb l) h = unit
kv-flat T kb x h = Empty-rec h
kv-flat T kdn kqbot h = unit
kv-flat T kdn x h = Empty-rec h
kv-flat T k x h = unit
-- ---------------------------------------------------------------- the order, the join
-- a value kind below another: anything below ka, kdn below anything
kle : Kd → Kd → Bool
kle a ka = true
kle kdn b = true
kle kw kw = true
kle kb kb = true
kle (kdc d) (kdc d2) = weq d d2
kle a b = false
-- chains, pointwise
klle : Kd → Kd → Bool
klle knil knil = true
klle (kcons a r) (kcons b s) = andbt (kle a b) (klle r s)
klle a b = false
-- each of kle-sound's targets, split on the source
klw : (T : Word → Word → Nat → Kd) (a : Kd) (v : KQ) → kle a kw ≡ true → Kv T a v → Kv T kw v
klw T kw v h hv = hv
klw T kdn kqbot h hv = unit
klw T kdn v h hv = Empty-rec hv
klw T a v h hv = Empty-rec (false≢true h)
klb : (T : Word → Word → Nat → Kd) (a : Kd) (v : KQ) → kle a kb ≡ true → Kv T a v → Kv T kb v
klb T kb v h hv = hv
klb T kdn kqbot h hv = unit
klb T kdn v h hv = Empty-rec hv
klb T a v h hv = Empty-rec (false≢true h)
klc : (T : Word → Word → Nat → Kd) (a : Kd) (d : Word) (v : KQ) → kle a (kdc d) ≡ true → Kv T a v → Kv T (kdc d) v
klc T (kdc d2) d v h hv = subst {lzero} {lzero} {Word} {λ u → Kv T (kdc u) v} {d2} {d} (weq-sound d2 d h) hv
klc T kdn d kqbot h hv = unit
klc T kdn d v h hv = Empty-rec hv
klc T a d v h hv = Empty-rec (false≢true h)
kln : (T : Word → Word → Nat → Kd) (a : Kd) (v : KQ) → kle a kdn ≡ true → Kv T a v → Kv T kdn v
kln T kdn v h hv = hv
kln T a v h hv = Empty-rec (false≢true h)
kle-sound : (T : Word → Word → Nat → Kd) (a b : Kd) (v : KQ) → kle a b ≡ true → Kv T a v → Kv T b v
kle-sound T a ka v h hv = unit
kle-sound T a kw v h hv = klw T a v h hv
kle-sound T a kb v h hv = klb T a v h hv
kle-sound T a (kdc d) v h hv = klc T a d v h hv
kle-sound T a kdn v h hv = kln T a v h hv
kle-sound T a knil v h hv = unit
kle-sound T a (kcons b s) v h hv = unit
klle-sound : (T : Word → Word → Nat → Kd) (vs : KQ) (a b : Kd) → klle a b ≡ true → kvs T vs a → kvs T vs b
klle-sound T kqnil knil knil h hv = unit
klle-sound T kqnil knil b h hv = Empty-rec (false≢true h)
klle-sound T kqnil a b h hv = Empty-rec hv
klle-sound T (kqcons x xs) (kcons a r) (kcons b s) h hv = (kle-sound T a b x (andl (kle a b) (klle r s) h) (fst hv) , klle-sound T xs r s (andr (kle a b) (klle r s) h) (snd hv))
klle-sound T (kqcons x xs) (kcons a r) b h hv = Empty-rec (false≢true h)
klle-sound T (kqcons x xs) a b h hv = Empty-rec hv
klle-sound T vs a b h hv = Empty-rec hv
-- the join: the larger of two comparable kinds, else ka
kjoin : Kd → Kd → Kd
kjoin a b = if kle a b then b else (if kle b a then a else ka)
kj-l : (T : Word → Word → Nat → Kd) (a b : Kd) (v : KQ) → Kv T a v → Kv T (kjoin a b) v
kj-l T a b v hv =
  (case kle a b return (λ x → kle a b ≡ x → Kv T (if x then b else (if kle b a then a else ka)) v) of
     true → λ e → kle-sound T a b v e hv
     false → λ e → (case kle b a return (λ y → Kv T (if y then a else ka) v) of true → hv; false → unit)) (λ t → kle a b)
kj-r : (T : Word → Word → Nat → Kd) (a b : Kd) (v : KQ) → Kv T b v → Kv T (kjoin a b) v
kj-r T a b v hv =
  (case kle a b return (λ x → Kv T (if x then b else (if kle b a then a else ka)) v) of
     true → hv
     false → (case kle b a return (λ y → kle b a ≡ y → Kv T (if y then a else ka) v) of
                true → λ e → kle-sound T b a v e hv
                false → λ e → unit) (λ t → kle b a))
-- ---------------------------------------------------------------- environments of kinds
-- a variable's kind (innermost first)
kext : (Nat → Kd) → Kd → Nat → Kd
kext Γ k n = case n of zero → k; suc m → Γ m
kdrop : (Nat → Kd) → Nat → Kd
kdrop Γ n = Γ (suc n)
EnvK : (Word → Word → Nat → Kd) → (Nat → Kd) → KQ → Type
EnvK T Γ e = (n : Nat) → Kv T (Γ n) (q-nth e n)
envk-ext : (T : Word → Word → Nat → Kd) (Γ : Nat → Kd) (k : Kd) (v e : KQ) → EnvK T Γ e → Kv T k v → EnvK T (kext Γ k) (kqcons v e)
envk-ext T Γ k v e h hv = λ n → (case n return (λ m → Kv T (kext Γ k m) (q-nth (kqcons v e) m)) of zero → hv; suc m → h m)
envk-drop : (T : Word → Word → Nat → Kd) (Γ : Nat → Kd) (v e : KQ) → EnvK T Γ (kqcons v e) → EnvK T (kdrop Γ) e
envk-drop T Γ v e h = λ n → h (suc n)
-- a chain's kinds pushed as its values are (q-push: the last innermost)
kpush : Kd → (Nat → Kd) → Nat → Kd
kpush (kcons k r) Γ = kpush r (kext Γ k)
kpush k Γ = Γ
envk-push : (T : Word → Word → Nat → Kd) (vs : KQ) (ks : Kd) (Γ : Nat → Kd) (e : KQ) → kvs T vs ks → EnvK T Γ e → EnvK T (kpush ks Γ) (q-push vs e)
envk-push T kqnil knil Γ e h he = he
envk-push T (kqcons x xs) (kcons k r) Γ e h he = envk-push T xs r (kext Γ k) (kqcons x e) (snd h) (envk-ext T Γ k x e he (fst h))
envk-push T vs ks Γ e h he = Empty-rec h
-- the flat kinds of constructor c of d's fields i .. i + n - 1, and n of anything
kft : (Word → Word → Nat → Kd) → Word → Word → Nat → Nat → Kd
kft T d c zero i = knil
kft T d c (suc m) i = kcons (kflat-k (T d c i)) (kft T d c m (suc i))
kanys : Nat → Kd
kanys zero = knil
kanys (suc m) = kcons ka (kanys m)
-- a constructor's fields from i: as a chain of n of their flat kinds, and back
kvf-kvs : (T : Word → Word → Nat → Kd) (fs : KQ) (d c : Word) (i n : Nat) → kvf T fs d c i → q-isn n fs ≡ true → kvs T fs (kft T d c n i)
kvf-kvs T kqnil d c i zero h hn = unit
kvf-kvs T kqnil d c i (suc m) h hn = Empty-rec (false≢true hn)
kvf-kvs T (kqcons x r) d c i (suc m) h hn = (kflat-kv T (T d c i) x (fst h) , kvf-kvs T r d c (suc i) m (snd h) hn)
kvf-kvs T (kqcons x r) d c i zero h hn = Empty-rec (false≢true hn)
kvf-kvs T fs d c i zero h hn = Empty-rec (false≢true hn)
kvf-kvs T fs d c i (suc m) h hn = Empty-rec (false≢true hn)
kvs-kvf : (T : Word → Word → Nat → Kd) (fs : KQ) (d c : Word) (i n : Nat) → kvs T fs (kft T d c n i) → kvf T fs d c i
kvs-kvf T kqnil d c i n h = unit
kvs-kvf T (kqcons x r) d c i (suc m) h = (kv-flat T (T d c i) x (fst h) , kvs-kvf T r d c (suc i) m (snd h))
kvs-kvf T (kqcons x r) d c i zero h = Empty-rec h
kvs-kvf T fs d c i n h = Empty-rec h
kanys-kv : (T : Word → Word → Nat → Kd) (fs : KQ) (n : Nat) → q-isn n fs ≡ true → kvs T fs (kanys n)
kanys-kv T kqnil zero hn = unit
kanys-kv T kqnil (suc m) hn = Empty-rec (false≢true hn)
kanys-kv T (kqcons x r) (suc m) hn = (unit , kanys-kv T r m hn)
kanys-kv T (kqcons x r) zero hn = Empty-rec (false≢true hn)
kanys-kv T fs zero hn = Empty-rec (false≢true hn)
kanys-kv T fs (suc m) hn = Empty-rec (false≢true hn)
-- field k of a constructor of d (from i)
kvf-nth : (T : Word → Word → Nat → Kd) (fs : KQ) (d c : Word) (i k : Nat) → kvf T fs d c i → Kflat T (T d c (qadd i k)) (q-nth fs k)
kvf-nth T (kqcons x r) d c i zero h = fst h
kvf-nth T (kqcons x r) d c i (suc k) h = subst {lzero} {lzero} {Nat} {λ u → Kflat T (T d c u) (q-nth r k)} {qadd (suc i) k} {suc (qadd i k)} (qadd-s i k) (kvf-nth T r d c (suc i) k (snd h))
kvf-nth T kqbot d c i k h = kflat-bot T (T d c (qadd i k))
kvf-nth T kqnil d c i k h = kflat-bot T (T d c (qadd i k))
kvf-nth T fs d c i k h = Empty-rec h
kfl : (Word → Word → Nat → Kd) → Kd → Word → Nat → Kd
kfl T (kdc d) j n = kft T d j n zero
kfl T k j n = kanys n
-- an alternative's fields, given the scrutinee's kind: from the table at its data type, else anything
kfl-kv : (T : Word → Word → Nat → Kd) (kx : Kd) (j : Word) (k : Nat) (d c : Word) (fs : KQ) → Kv T kx (kqcon d c fs) → weq c j ≡ true → q-isn k fs ≡ true → kvs T fs (kfl T kx j k)
kfl-kv T (kdc d0) j k d c fs hv ej en = kvf-kvs T fs d0 j zero k (subst {lzero} {lzero} {Word} {λ u → kvf T fs d0 u zero} {c} {j} (weq-sound c j ej) (snd hv)) en
kfl-kv T kx j k d c fs hv ej en = kanys-kv T fs k en
-- the primitives' kinds: each family of q-prim's branches has its result's kind, the splits following
-- the family's patterns (every leaf unit); kpk p the kind of primitive p's result, kv-prim that q-prim's
-- value has it, entry by entry along lib/foproofc.cub's cpq-k
kq-q-wwd : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) → Kv T kw (q-ww f (kqcons (kqw p) (kqcons (kqw q) r)))
kq-q-wwd T f p q kqnil = unit
kq-q-wwd T f p q r = unit
kq-q-wwc : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (b r : KQ) → Kv T kw (q-ww f (kqcons (kqw p) (kqcons b r)))
kq-q-wwc T f p (kqw q) r = kq-q-wwd T f p q r
kq-q-wwc T f p b r = unit
kq-q-wwb : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (r : KQ) → Kv T kw (q-ww f (kqcons (kqw p) r))
kq-q-wwb T f p (kqcons b r) = kq-q-wwc T f p b r
kq-q-wwb T f p r = unit
kq-q-wwa : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (a r : KQ) → Kv T kw (q-ww f (kqcons a r))
kq-q-wwa T f (kqw p) r = kq-q-wwb T f p r
kq-q-wwa T f a r = unit
kq-q-ww : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (as : KQ) → Kv T kw (q-ww f as)
kq-q-ww T f (kqcons a r) = kq-q-wwa T f a r
kq-q-ww T f as = unit
kq-q-iid : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) → Kv T kw (q-ii f (kqcons (kqi p) (kqcons (kqi q) r)))
kq-q-iid T f p q kqnil = unit
kq-q-iid T f p q r = unit
kq-q-iic : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (b r : KQ) → Kv T kw (q-ii f (kqcons (kqi p) (kqcons b r)))
kq-q-iic T f p (kqi q) r = kq-q-iid T f p q r
kq-q-iic T f p b r = unit
kq-q-iib : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (r : KQ) → Kv T kw (q-ii f (kqcons (kqi p) r))
kq-q-iib T f p (kqcons b r) = kq-q-iic T f p b r
kq-q-iib T f p r = unit
kq-q-iia : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (a r : KQ) → Kv T kw (q-ii f (kqcons a r))
kq-q-iia T f (kqi p) r = kq-q-iib T f p r
kq-q-iia T f a r = unit
kq-q-ii : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (as : KQ) → Kv T kw (q-ii f as)
kq-q-ii T f (kqcons a r) = kq-q-iia T f a r
kq-q-ii T f as = unit
kq-q-iwd : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) → Kv T kw (q-iw f (kqcons (kqi p) (kqcons (kqi q) r)))
kq-q-iwd T f p q kqnil = unit
kq-q-iwd T f p q r = unit
kq-q-iwc : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (b r : KQ) → Kv T kw (q-iw f (kqcons (kqi p) (kqcons b r)))
kq-q-iwc T f p (kqi q) r = kq-q-iwd T f p q r
kq-q-iwc T f p b r = unit
kq-q-iwb : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (r : KQ) → Kv T kw (q-iw f (kqcons (kqi p) r))
kq-q-iwb T f p (kqcons b r) = kq-q-iwc T f p b r
kq-q-iwb T f p r = unit
kq-q-iwa : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (a r : KQ) → Kv T kw (q-iw f (kqcons a r))
kq-q-iwa T f (kqi p) r = kq-q-iwb T f p r
kq-q-iwa T f a r = unit
kq-q-iw : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (as : KQ) → Kv T kw (q-iw f as)
kq-q-iw T f (kqcons a r) = kq-q-iwa T f a r
kq-q-iw T f as = unit
kq-q-ffd : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) → Kv T kw (q-ff f (kqcons (kqf p) (kqcons (kqf q) r)))
kq-q-ffd T f p q kqnil = unit
kq-q-ffd T f p q r = unit
kq-q-ffc : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (b r : KQ) → Kv T kw (q-ff f (kqcons (kqf p) (kqcons b r)))
kq-q-ffc T f p (kqf q) r = kq-q-ffd T f p q r
kq-q-ffc T f p b r = unit
kq-q-ffb : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (r : KQ) → Kv T kw (q-ff f (kqcons (kqf p) r))
kq-q-ffb T f p (kqcons b r) = kq-q-ffc T f p b r
kq-q-ffb T f p r = unit
kq-q-ffa : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (a r : KQ) → Kv T kw (q-ff f (kqcons a r))
kq-q-ffa T f (kqf p) r = kq-q-ffb T f p r
kq-q-ffa T f a r = unit
kq-q-ff : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (as : KQ) → Kv T kw (q-ff f as)
kq-q-ff T f (kqcons a r) = kq-q-ffa T f a r
kq-q-ff T f as = unit
kq-q-fwd : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p q : Word) (r : KQ) → Kv T kw (q-fw f (kqcons (kqf p) (kqcons (kqf q) r)))
kq-q-fwd T f p q kqnil = unit
kq-q-fwd T f p q r = unit
kq-q-fwc : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (b r : KQ) → Kv T kw (q-fw f (kqcons (kqf p) (kqcons b r)))
kq-q-fwc T f p (kqf q) r = kq-q-fwd T f p q r
kq-q-fwc T f p b r = unit
kq-q-fwb : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (p : Word) (r : KQ) → Kv T kw (q-fw f (kqcons (kqf p) r))
kq-q-fwb T f p (kqcons b r) = kq-q-fwc T f p b r
kq-q-fwb T f p r = unit
kq-q-fwa : (T : Word → Word → Nat → Kd) (f : Word → Word → Word) (a r : KQ) → Kv T kw (q-fw f (kqcons a r))
