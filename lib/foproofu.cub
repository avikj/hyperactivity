pkk-1 : Word → Kd
pkk-1 p = if weq p #1 then kw else pkk-2 p
kvp-1 : (T : Word → Word → Nat → Kd) (p : Word) (as : KQ) → Kv T (pkk-1 p) (cpq-1 p as)
kvp-1 T p as = kv-bif T (weq p #1) kw (pkk-2 p) (q-ww wsub as) (cpq-2 p as) (kq-q-ww T wsub as) (kvp-2 T p as)
pkk-0 : Word → Kd
pkk-0 p = if weq p #0 then kw else pkk-1 p
kvp-0 : (T : Word → Word → Nat → Kd) (p : Word) (as : KQ) → Kv T (pkk-0 p) (cpq-0 p as)
kvp-0 T p as = kv-bif T (weq p #0) kw (pkk-1 p) (q-ww wadd as) (cpq-1 p as) (kq-q-ww T wadd as) (kvp-1 T p as)
kpk : Word → Kd
kpk p = pkk-0 p
kv-prim : (T : Word → Word → Nat → Kd) (p : Word) (as : KQ) → Kv T (kpk p) (q-prim p as)
kv-prim T p as = kvp-0 T p as
-- ---------------------------------------------------------------- the kind of a term
-- the program's tables: field kinds T d c i, each definition's parameter kinds (a chain, in order)
-- and result kind
data KS = ks (T : Word → Word → Nat → Kd) (SK : Word → Kd) (SR : Word → Kd)
ks-T : KS → Word → Word → Nat → Kd
ks-T (ks T SK SR) = T
ks-SK : KS → Word → Kd
ks-SK (ks T SK SR) = SK
ks-SR : KS → Word → Kd
ks-SR (ks T SK SR) = SR
-- a callee's environment: its parameters pushed in order, anything beyond
spk : KS → Word → Nat → Kd
spk S g = kpush (ks-SK S g) (λ n → ka)
kis0 : Kd → Bool
kis0 (kdc d) = weq d #0
kis0 k = false
kisn : Kd → Bool
kisn kdn = true
kisn k = false
-- a constructor of kind kdc d: of data type 0 only constructor 0 with two fields
kcok : Word → Word → FQ → Bool
kcok d c fs = if weq d #0 then andbt (weq c #0) (fq-isn (suc (suc zero)) fs) else true
-- a loop's state kinds: its initial values' when every continuing state has them, else anything
lstk-sel : Kd → Kd → Nat → Kd
lstk-sel s0 f n = if kisn f then s0 else kanys n
-- the modes: a term or a list (kmt: a list's kind is the chain of its values' kinds); a loop body
-- (kmb st, st the state's kinds): the kind it breaks with; a list's head (kmh); a loop body's
-- continuing states (kmc st): kdn when each has st's kinds, else ka. kok's own: a list (kml)
data KM = kmt | kml | kmb (st : Kd) | kmh | kmc (st : Kd)
-- the kind of a term (Γ its variables' kinds, innermost first): a switch pushes its scrutinee's kind,
-- an alternative its fields' (from the table when the scrutinee's kind is a data type's)
ksyn : KS → FQ → KM → (Nat → Kd) → Kd
ksyn S (fql w) kmt Γ = kw
ksyn S (fqv n) kmt Γ = Γ n
ksyn S (fqprim p as) kmt Γ = kpk p
ksyn S (fqlet a b) kmt Γ = ksyn S b kmt (kext Γ (ksyn S a kmt Γ))
ksyn S (fqcon d c fs) kmt Γ = if kcok d c fs then kdc d else ka
ksyn S (fqproj d c j x) kmt Γ = if kis0 (ksyn S x kmt Γ) then kflat-k (ks-T S #0 #0 (dnat j)) else ka
ksyn S (fqsw x alts) kmt Γ = ksyn S alts kmt (kext Γ (ksyn S x kmt Γ))
ksyn S (fqif c a b) kmt Γ = kjoin (ksyn S a kmt Γ) (ksyn S b kmt Γ)
ksyn S (fqclos g env) kmt Γ = ka
ksyn S (fqlam b) kmt Γ = ka
ksyn S (fqapp f as) kmt Γ = ka
ksyn S (fqcall g as) kmt Γ = ks-SR S g
ksyn S (fqloop init b) kmt Γ = ksyn S b (kmb (lstk-sel (ksyn S init kmt Γ) (ksyn S b (kmc (ksyn S init kmt Γ)) (kpush (ksyn S init kmt Γ) Γ)) (fq-len init))) (kpush (lstk-sel (ksyn S init kmt Γ) (ksyn S b (kmc (ksyn S init kmt Γ)) (kpush (ksyn S init kmt Γ) Γ)) (fq-len init)) Γ)
ksyn S fqnil kmt Γ = knil
ksyn S (fqcons x r) kmt Γ = kcons (ksyn S x kmt Γ) (ksyn S r kmt Γ)
ksyn S (fqalt j n b r) kmt Γ = kjoin (ksyn S b kmt (kpush (kfl (ks-T S) (Γ zero) j n) (kdrop Γ))) (ksyn S r kmt Γ)
ksyn S fqanone kmt Γ = kdn
ksyn S fqnet kmt Γ = kdn
ksyn S (fqif c a b) (kmb st) Γ = kjoin (ksyn S a (kmb st) Γ) (ksyn S b (kmb st) Γ)
ksyn S (fqlet a b) (kmb st) Γ = ksyn S b (kmb st) (kext Γ (ksyn S a kmt Γ))
ksyn S (fqcon d c fs) (kmb st) Γ = if weq c #0 then kdn else ksyn S fs kmh Γ
ksyn S t (kmb st) Γ = ka
ksyn S (fqcons x r) kmh Γ = ksyn S x kmt Γ
ksyn S t kmh Γ = kdn
ksyn S (fqif c a b) (kmc st) Γ = kjoin (ksyn S a (kmc st) Γ) (ksyn S b (kmc st) Γ)
ksyn S (fqlet a b) (kmc st) Γ = ksyn S b (kmc st) (kext Γ (ksyn S a kmt Γ))
ksyn S (fqcon d c fs) (kmc st) Γ = if weq c #0 then (if klle (ksyn S fs kmt Γ) st then kdn else ka) else kdn
ksyn S t (kmc st) Γ = ka
ksyn S t kml Γ = ka
-- a loop's state kinds (as ksyn's loop clause has them)
lst : KS → (Nat → Kd) → FQ → FQ → Kd
lst S Γ init b = lstk-sel (ksyn S init kmt Γ) (ksyn S b (kmc (ksyn S init kmt Γ)) (kpush (ksyn S init kmt Γ) Γ)) (fq-len init)
-- the conditions, decided: a constructor's fields of its table's kinds; a call of a defined key (df)
-- with arguments of its parameters' kinds; a loop's state of its kinds and its body's continuing
-- states of them; a loop body of the shape if / let / constructor; lists where lists go
kok : KS → (Word → Bool) → FQ → KM → (Nat → Kd) → Bool
kok S df (fql w) kmt Γ = true
kok S df (fqv n) kmt Γ = true
kok S df (fqprim p as) kmt Γ = kok S df as kml Γ
kok S df (fqlet a b) kmt Γ = andbt (kok S df a kmt Γ) (kok S df b kmt (kext Γ (ksyn S a kmt Γ)))
kok S df (fqcon d c fs) kmt Γ = andbt (kok S df fs kml Γ) (if kcok d c fs then klle (ksyn S fs kmt Γ) (kft (ks-T S) d c (fq-len fs) zero) else true)
kok S df (fqproj d c j x) kmt Γ = kok S df x kmt Γ
kok S df (fqsw x alts) kmt Γ = andbt (kok S df x kmt Γ) (kok S df alts kmt (kext Γ (ksyn S x kmt Γ)))
kok S df (fqif c a b) kmt Γ = andbt (kok S df c kmt Γ) (andbt (kok S df a kmt Γ) (kok S df b kmt Γ))
kok S df (fqclos g env) kmt Γ = kok S df env kml Γ
kok S df (fqlam b) kmt Γ = true
kok S df (fqapp f as) kmt Γ = andbt (kok S df f kmt Γ) (kok S df as kml Γ)
kok S df (fqcall g as) kmt Γ = andbt (kok S df as kml Γ) (andbt (df g) (klle (ksyn S as kmt Γ) (ks-SK S g)))
kok S df (fqloop init b) kmt Γ = andbt (kok S df init kml Γ) (andbt (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ)))
kok S df (fqalt j n b r) kmt Γ = andbt (kok S df b kmt (kpush (kfl (ks-T S) (Γ zero) j n) (kdrop Γ))) (kok S df r kmt Γ)
kok S df fqanone kmt Γ = true
kok S df fqnet kmt Γ = true
kok S df t kmt Γ = false
kok S df fqnil kml Γ = true
kok S df (fqcons x r) kml Γ = andbt (kok S df x kmt Γ) (kok S df r kml Γ)
kok S df t kml Γ = false
kok S df (fqif c a b) (kmb st) Γ = andbt (kok S df c kmt Γ) (andbt (kok S df a (kmb st) Γ) (kok S df b (kmb st) Γ))
kok S df (fqlet a b) (kmb st) Γ = andbt (kok S df a kmt Γ) (kok S df b (kmb st) (kext Γ (ksyn S a kmt Γ)))
kok S df (fqcon d c fs) (kmb st) Γ = andbt (kok S df fs kml Γ) (if weq c #0 then klle (ksyn S fs kmt Γ) st else kok S df fs kmh Γ)
kok S df t (kmb st) Γ = false
kok S df (fqcons x r) kmh Γ = kok S df x kmt Γ
kok S df fqnil kmh Γ = true
kok S df t kmh Γ = false
kok S df t (kmc st) Γ = false
-- ---------------------------------------------------------------- kind-sound
-- a loop body's value: none; a continuing constructor (tag 0) whose fields have the state's kinds; a
-- breaking one whose field 0 has the result's kind
Lr : (Word → Word → Nat → Kd) → Kd → Kd → KQ → Type
Lr T st kr kqbot = Unit
Lr T st kr (kqcon d c fs) = if weq c #0 then kvs T fs st else Kv T kr (q-nth fs zero)
Lr T st kr v = Empty
lr-jl : (T : Word → Word → Nat → Kd) (st k1 k2 : Kd) (v : KQ) → Lr T st k1 v → Lr T st (kjoin k1 k2) v
lr-jl T st k1 k2 kqbot h = unit
lr-jl T st k1 k2 (kqcon d c fs) h =
  (case weq c #0 return (λ b → (if b then kvs T fs st else Kv T k1 (q-nth fs zero)) → if b then kvs T fs st else Kv T (kjoin k1 k2) (q-nth fs zero)) of
     true → λ x → x
     false → λ x → kj-l T k1 k2 (q-nth fs zero) x) h
lr-jl T st k1 k2 v h = Empty-rec h
lr-jr : (T : Word → Word → Nat → Kd) (st k1 k2 : Kd) (v : KQ) → Lr T st k2 v → Lr T st (kjoin k1 k2) v
lr-jr T st k1 k2 kqbot h = unit
lr-jr T st k1 k2 (kqcon d c fs) h =
  (case weq c #0 return (λ b → (if b then kvs T fs st else Kv T k2 (q-nth fs zero)) → if b then kvs T fs st else Kv T (kjoin k1 k2) (q-nth fs zero)) of
     true → λ x → x
     false → λ x → kj-r T k1 k2 (q-nth fs zero) x) h
lr-jr T st k1 k2 v h = Empty-rec h
-- an if's value: either branch's, or none
kif : (T : Word → Word → Nat → Kd) (vc va vb : KQ) (k1 k2 : Kd) → Kv T k1 va → Kv T k2 vb → Kv T (kjoin k1 k2) (q-if vc va vb)
kif T (kqw w) va vb k1 k2 ha hb = %welimP (λ u → Kv T (kjoin k1 k2) (%welimP (λ u2 → KQ) u vb (λ m h → va))) w (kj-r T k1 k2 vb hb) (λ m h → kj-l T k1 k2 va ha)
kif T vc va vb k1 k2 ha hb = kv-bot T (kjoin k1 k2)
klif : (T : Word → Word → Nat → Kd) (st : Kd) (vc va vb : KQ) (k1 k2 : Kd) → Lr T st k1 va → Lr T st k2 vb → Lr T st (kjoin k1 k2) (q-if vc va vb)
klif T st (kqw w) va vb k1 k2 ha hb = %welimP (λ u → Lr T st (kjoin k1 k2) (%welimP (λ u2 → KQ) u vb (λ m h → va))) w (lr-jr T st k1 k2 vb hb) (λ m h → lr-jl T st k1 k2 va ha)
klif T st vc va vb k1 k2 ha hb = unit
-- a constructor's value has its kind
-- a pair's constructor: tag 0, two fields, from the syntax's shape (kc0-h over any value list whose
-- count follows the syntax's)
kc0b : Bool → Word → KQ → Type
kc0b true c vs = (c ≡ #0) × (q-isn (suc (suc zero)) vs ≡ true)
kc0b false c vs = Unit
kcokb : Bool → Word → FQ → Bool
kcokb true c fs = andbt (weq c #0) (fq-isn (suc (suc zero)) fs)
kcokb false c fs = true
kc0-hb : (b : Bool) (c : Word) (fs : FQ) (vs : KQ) → (fq-isn (suc (suc zero)) fs ≡ true → q-isn (suc (suc zero)) vs ≡ true) → kcokb b c fs ≡ true → kc0b b c vs
kc0-hb true c fs vs hn h2 = (weq-sound c #0 (andl (weq c #0) (fq-isn (suc (suc zero)) fs) h2) , hn (andr (weq c #0) (fq-isn (suc (suc zero)) fs) h2))
kc0-hb false c fs vs hn h2 = unit
kc0-h : (d c : Word) (fs : FQ) (vs : KQ) → (fq-isn (suc (suc zero)) fs ≡ true → q-isn (suc (suc zero)) vs ≡ true) → kcok d c fs ≡ true → kc0 d c vs
kc0-h d c fs vs hn h =
  (case weq d #0 return (λ b → weq d #0 ≡ b → kc0 d c vs) of
     true → λ eb → subst {lzero} {lzero} {Bool} {λ u → kc0b u c vs} {true} {weq d #0} (sym eb)
                     (kc0-hb true c fs vs hn (subst {lzero} {lzero} {Bool} {λ u → kcokb u c fs ≡ true} {weq d #0} {true} eb h))
     false → λ eb → subst {lzero} {lzero} {Bool} {λ u → kc0b u c vs} {false} {weq d #0} (sym eb) unit) (λ t → weq d #0)
kc0-of : (G : Word → FQ) (K : QE) (d c : Word) (fs : FQ) (e : KQ) → kcok d c fs ≡ true → kc0 d c (evT G K fs e)
kc0-of G K d c fs e h = kc0-h d c fs (evT G K fs e) (ev-isn G K (suc (suc zero)) fs e) h
kcon-k : (T : Word → Word → Nat → Kd) (d c : Word) (fs : FQ) (vs : KQ) → (kcok d c fs ≡ true → kc0 d c vs) → (kcok d c fs ≡ true → kvf T vs d c zero) → Kv T (if kcok d c fs then kdc d else ka) (kqcon d c vs)
kcon-k T d c fs vs h1 h2 =
  (case kcok d c fs return (λ b → kcok d c fs ≡ b → Kv T (if b then kdc d else ka) (kqcon d c vs)) of
     true → λ e → (((λ t → d) , h1 e) , h2 e)
     false → λ e → unit) (λ t → kcok d c fs)
-- a projection of a pair (data type 0) has its table's component kind, read flat
kproj-00 : (T : Word → Word → Nat → Kd) (d2 c : Word) (fs : KQ) (j : Word) → Kv T (kdc #0) (kqcon d2 c fs) → Kv T (kflat-k (T #0 #0 (dnat j))) (q-nth fs (dnat j))
kproj-00 T d2 c fs j hv =
  kflat-kv T (T #0 #0 (dnat j)) (q-nth fs (dnat j))
    (subst {lzero} {lzero} {Word} {λ u → Kflat T (T #0 u (dnat j)) (q-nth fs (dnat j))} {c} {#0} (fst (snd (fst hv)))
       (subst {lzero} {lzero} {Nat} {λ u → Kflat T (T #0 c u) (q-nth fs (dnat j))} {qadd zero (dnat j)} {dnat j} (qadd-0l (dnat j)) (kvf-nth T fs #0 c zero (dnat j) (snd hv))))
kproj-0 : (T : Word → Word → Nat → Kd) (d j : Word) (v : KQ) → d ≡ #0 → Kv T (kdc d) v → Kv T (kflat-k (T #0 #0 (dnat j))) (q-proj j v)
kproj-0 T d j kqbot hd hv = kv-bot T (kflat-k (T #0 #0 (dnat j)))
kproj-0 T d j (kqcon d2 c fs) hd hv = subst {lzero} {lzero} {Word} {λ u → Kv T (kdc u) (kqcon d2 c fs) → Kv T (kflat-k (T #0 #0 (dnat j))) (q-nth fs (dnat j))} {#0} {d} (sym hd) (kproj-00 T d2 c fs j) hv
kproj-0 T d j v hd hv = Empty-rec hv
kproj-c : (T : Word → Word → Nat → Kd) (d j : Word) (v : KQ) → Kv T (kdc d) v → Kv T (if weq d #0 then kflat-k (T #0 #0 (dnat j)) else ka) (q-proj j v)
kproj-c T d j v hv =
  (case weq d #0 return (λ b → weq d #0 ≡ b → Kv T (if b then kflat-k (T #0 #0 (dnat j)) else ka) (q-proj j v)) of
     true → λ eb → kproj-0 T d j v (weq-sound d #0 eb) hv
     false → λ eb → unit) (λ t → weq d #0)
kproj : (T : Word → Word → Nat → Kd) (k : Kd) (j : Word) (v : KQ) → Kv T k v → Kv T (if kis0 k then kflat-k (T #0 #0 (dnat j)) else ka) (q-proj j v)
kproj T (kdc d) j v hv = kproj-c T d j v hv
kproj T k j v hv = unit
-- an alternative: the tag picked, the fields counted, pushed with their kinds
kalt-v : (T : Word → Word → Nat → Kd) (kx : Kd) (j : Word) (k : Nat) (v e2 : KQ) (KB KR : Kd) (fb : KQ → KQ) (R : KQ) → Kv T kx v → Kv T KR R
       → ((fs : KQ) → kvs T fs (kfl T kx j k) → Kv T KB (fb (q-push fs e2)))
       → Kv T (kjoin KB KR) (q-altsel j k fb R (kqcons v e2))
kalt-v T kx j k (kqcon d c fs) e2 KB KR fb R hv hr hb =
  (case weq c j return (λ x → weq c j ≡ x → Kv T (kjoin KB KR) (if x then (if q-isn k fs then fb (q-push fs e2) else kqbot) else R)) of
     true → λ ej → (case q-isn k fs return (λ y → q-isn k fs ≡ y → Kv T (kjoin KB KR) (if y then fb (q-push fs e2) else kqbot)) of
                      true → λ en → kj-l T KB KR (fb (q-push fs e2)) (hb fs (kfl-kv T kx j k d c fs hv ej en))
                      false → λ en → kv-bot T (kjoin KB KR)) (λ t → q-isn k fs)
     false → λ ej → kj-r T KB KR R hr) (λ t → weq c j)
kalt-v T kx j k v e2 KB KR fb R hv hr hb = kv-bot T (kjoin KB KR)
-- a loop's turn: a continuing state of the state's kinds goes on, a break gives the result's kind
klstep : (T : Word → Word → Nat → Kd) (st kr : Kd) (v : KQ) (cont : KQ → KQ) → Lr T st kr v → ((fs : KQ) → kvs T fs st → Kv T kr (cont fs)) → Kv T kr (q-lstep v cont)
klstep T st kr kqbot cont h hc = kv-bot T kr
klstep T st kr (kqcon d c fs) cont h hc =
  (case weq c #0 return (λ b → (if b then kvs T fs st else Kv T kr (q-nth fs zero)) → Kv T kr (if b then cont fs else q-nth fs zero)) of
     true → λ x → hc fs x
     false → λ x → x) h
klstep T st kr v cont h hc = Empty-rec h
-- what is shown in each mode
KGoal : KS → (Word → FQ) → Nat → KM → (Nat → Kd) → FQ → KQ → Type
KGoal S G n kmt Γ t e = Kv (ks-T S) (ksyn S t kmt Γ) (evT G (qeN G n) t e)
KGoal S G n kml Γ t e = kvs (ks-T S) (evT G (qeN G n) t e) (ksyn S t kmt Γ)
KGoal S G n (kmb st) Γ t e = Lr (ks-T S) st (ksyn S t (kmb st) Γ) (evT G (qeN G n) t e)
KGoal S G n kmh Γ t e = Kv (ks-T S) (ksyn S t kmh Γ) (q-nth (evT G (qeN G n) t e) zero)
KGoal S G n (kmc st) Γ t e = Unit
-- the calls at fuel n: a defined key's body, in an environment of its parameters' kinds, has its
-- result's kind; the loops at fuel n: from a state of the state's kinds
CallK : KS → (Word → Bool) → (Word → FQ) → Nat → Type
CallK S df G n = (g : Word) (e2 : KQ) → df g ≡ true → EnvK (ks-T S) (spk S g) e2 → Kv (ks-T S) (ks-SR S g) (qe-ev (qeN G n) (G g) e2)
LoopK : KS → (Word → Bool) → (Word → FQ) → Nat → Type
LoopK S df G n = (st : Kd) (vs : KQ) (b : FQ) (Γ : Nat → Kd) (e : KQ) → kvs (ks-T S) vs st → kok S df b (kmb st) (kpush st Γ) ≡ true → EnvK (ks-T S) Γ e
  → Kv (ks-T S) (ksyn S b (kmb st) (kpush st Γ)) (qe-lp (qeN G n) vs b e)
-- a loop body's constructor: continuing (tag 0) or breaking, the goal by the tag's test (kcb: the
-- test's two sides as functions of one Bool, so each is transported along the test's value)
kcb : Bool → Bool → Bool → Bool
kcb x y true = x
kcb x y false = y
kcb-t : (x y u : Bool) → u ≡ true → kcb x y u ≡ true → x ≡ true
kcb-t x y u eu h = subst {lzero} {lzero} {Bool} {λ w → kcb x y w ≡ true} {u} {true} eu h
kcb-f : (x y u : Bool) → u ≡ false → kcb x y u ≡ true → y ≡ true
kcb-f x y u eu h = subst {lzero} {lzero} {Bool} {λ w → kcb x y w ≡ true} {u} {false} eu h
-- (a case's branch on u is read with u's value inside it, so a goal stated with the test inside a
-- function of the test does not meet the goal the definitions give: LrB and KB are the goal's two
-- sides as functions of the test, each met by transport)
LrB : (Word → Word → Nat → Kd) → Kd → Kd → KQ → Bool → Type
LrB T st kr vs true = kvs T vs st
LrB T st kr vs false = Kv T kr (q-nth vs zero)
KB : Kd → Bool → Kd
KB kh true = kdn
KB kh false = kh
ks-conb : (T : Word → Word → Nat → Kd) (st kh : Kd) (d c : Word) (vs : KQ) → (weq c #0 ≡ true → kvs T vs st) → (weq c #0 ≡ false → Kv T kh (q-nth vs zero)) → Lr T st (if weq c #0 then kdn else kh) (kqcon d c vs)
ks-conb T st kh d c vs ht hf =
  (case weq c #0 return (λ b → weq c #0 ≡ b → LrB T st (if weq c #0 then kdn else kh) vs (weq c #0)) of
     true → λ eb → subst {lzero} {lzero} {Bool} {λ u → LrB T st (if weq c #0 then kdn else kh) vs u} {true} {weq c #0} (sym eb) (ht eb)
     false → λ eb → subst {lzero} {lzero} {Bool} {λ u → LrB T st (if weq c #0 then kdn else kh) vs u} {false} {weq c #0} (sym eb)
                      (subst {lzero} {lzero} {Bool} {λ u → Kv T (KB kh u) (q-nth vs zero)} {false} {weq c #0} (sym eb) (hf eb))) (λ t → weq c #0)
-- a list's head meets the conditions when the list does
kok-kmh : (S : KS) (df : Word → Bool) (fs : FQ) (Γ : Nat → Kd) → kok S df fs kml Γ ≡ true → kok S df fs kmh Γ ≡ true
kok-kmh S df fqnil Γ h = λ i → true
kok-kmh S df (fqcons x r) Γ h = andl (kok S df x kmt Γ) (kok S df r kml Γ) h
kok-kmh S df t Γ h = Empty-rec (false≢true h)
ks-con-kmb : (S : KS) (df : Word → Bool) (st : Kd) (Γ : Nat → Kd) (d c : Word) (fs : FQ) (vs : KQ) → kvs (ks-T S) vs (ksyn S fs kmt Γ) → Kv (ks-T S) (ksyn S fs kmh Γ) (q-nth vs zero)
           → kok S df (fqcon d c fs) (kmb st) Γ ≡ true → Lr (ks-T S) st (if weq c #0 then kdn else ksyn S fs kmh Γ) (kqcon d c vs)
ks-con-kmb S df st Γ d c fs vs hl hh hk =
  ks-conb (ks-T S) st (ksyn S fs kmh Γ) d c vs
    (λ eb → klle-sound (ks-T S) vs (ksyn S fs kmt Γ) st
              (kcb-t (klle (ksyn S fs kmt Γ) st) (kok S df fs kmh Γ) (weq c #0) eb (andr (kok S df fs kml Γ) (if weq c #0 then klle (ksyn S fs kmt Γ) st else kok S df fs kmh Γ) hk)) hl)
    (λ eb → hh)
-- every form at fuel n, given the calls and loops at fuel n
kstep : (S : KS) (df : Word → Bool) (G : Word → FQ) (n : Nat) → CallK S df G n → LoopK S df G n → (t : FQ) (m : KM) (Γ : Nat → Kd) (e : KQ) → kok S df t m Γ ≡ true → EnvK (ks-T S) Γ e → KGoal S G n m Γ t e
kstep S df G n co lo (fql w) kmt Γ e hk he = unit
kstep S df G n co lo (fql w) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqv k) kmt Γ e hk he = he k
kstep S df G n co lo (fqv k) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqprim p as) kmt Γ e hk he = kv-prim (ks-T S) p (evT G (qeN G n) as e)
kstep S df G n co lo (fqprim p as) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqlet a b) kmt Γ e hk he =
  kstep S df G n co lo b kmt (kext Γ (ksyn S a kmt Γ)) (kqcons (evT G (qeN G n) a e) e) (andr (kok S df a kmt Γ) (kok S df b kmt (kext Γ (ksyn S a kmt Γ))) hk)
    (envk-ext (ks-T S) Γ (ksyn S a kmt Γ) (evT G (qeN G n) a e) e he (kstep S df G n co lo a kmt Γ e (andl (kok S df a kmt Γ) (kok S df b kmt (kext Γ (ksyn S a kmt Γ))) hk) he))
kstep S df G n co lo (fqlet a b) (kmb st) Γ e hk he =
  kstep S df G n co lo b (kmb st) (kext Γ (ksyn S a kmt Γ)) (kqcons (evT G (qeN G n) a e) e) (andr (kok S df a kmt Γ) (kok S df b (kmb st) (kext Γ (ksyn S a kmt Γ))) hk)
    (envk-ext (ks-T S) Γ (ksyn S a kmt Γ) (evT G (qeN G n) a e) e he (kstep S df G n co lo a kmt Γ e (andl (kok S df a kmt Γ) (kok S df b (kmb st) (kext Γ (ksyn S a kmt Γ))) hk) he))
kstep S df G n co lo (fqlet a b) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqcon d c fs) kmt Γ e hk he =
  kcon-k (ks-T S) d c fs (evT G (qeN G n) fs e) (kc0-of G (qeN G n) d c fs e)
    (λ ek → kvs-kvf (ks-T S) (evT G (qeN G n) fs e) d c zero (fq-len fs)
              (klle-sound (ks-T S) (evT G (qeN G n) fs e) (ksyn S fs kmt Γ) (kft (ks-T S) d c (fq-len fs) zero)
                 (cong (λ b → if b then klle (ksyn S fs kmt Γ) (kft (ks-T S) d c (fq-len fs) zero) else true) (sym ek)
                    ∙ andr (kok S df fs kml Γ) (if kcok d c fs then klle (ksyn S fs kmt Γ) (kft (ks-T S) d c (fq-len fs) zero) else true) hk)
                 (kstep S df G n co lo fs kml Γ e (andl (kok S df fs kml Γ) (if kcok d c fs then klle (ksyn S fs kmt Γ) (kft (ks-T S) d c (fq-len fs) zero) else true) hk) he)))
kstep S df G n co lo (fqcon d c fs) (kmb st) Γ e hk he =
  ks-con-kmb S df st Γ d c fs (evT G (qeN G n) fs e)
    (kstep S df G n co lo fs kml Γ e (andl (kok S df fs kml Γ) (if weq c #0 then klle (ksyn S fs kmt Γ) st else kok S df fs kmh Γ) hk) he)
    (kstep S df G n co lo fs kmh Γ e (kok-kmh S df fs Γ (andl (kok S df fs kml Γ) (if weq c #0 then klle (ksyn S fs kmt Γ) st else kok S df fs kmh Γ) hk)) he)
    hk
kstep S df G n co lo (fqcon d c fs) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqproj d c j x) kmt Γ e hk he = kproj (ks-T S) (ksyn S x kmt Γ) j (evT G (qeN G n) x e) (kstep S df G n co lo x kmt Γ e hk he)
kstep S df G n co lo (fqproj d c j x) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqsw x alts) kmt Γ e hk he =
  kstep S df G n co lo alts kmt (kext Γ (ksyn S x kmt Γ)) (kqcons (evT G (qeN G n) x e) e) (andr (kok S df x kmt Γ) (kok S df alts kmt (kext Γ (ksyn S x kmt Γ))) hk)
    (envk-ext (ks-T S) Γ (ksyn S x kmt Γ) (evT G (qeN G n) x e) e he (kstep S df G n co lo x kmt Γ e (andl (kok S df x kmt Γ) (kok S df alts kmt (kext Γ (ksyn S x kmt Γ))) hk) he))
kstep S df G n co lo (fqsw x alts) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqalt j k b r) kmt Γ (kqcons v e2) hk he =
  kalt-v (ks-T S) (Γ zero) j k v e2 (ksyn S b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ))) (ksyn S r kmt Γ) (λ e3 → evT G (qeN G n) b e3) (evT G (qeN G n) r (kqcons v e2)) (he zero)
    (kstep S df G n co lo r kmt Γ (kqcons v e2) (andr (kok S df b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ))) (kok S df r kmt Γ) hk) he)
    (λ fs hfs → kstep S df G n co lo b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ)) (q-push fs e2) (andl (kok S df b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ))) (kok S df r kmt Γ) hk)
                  (envk-push (ks-T S) fs (kfl (ks-T S) (Γ zero) j k) (kdrop Γ) e2 hfs (envk-drop (ks-T S) Γ v e2 he)))
kstep S df G n co lo (fqalt j k b r) kmt Γ e hk he = kv-bot (ks-T S) (kjoin (ksyn S b kmt (kpush (kfl (ks-T S) (Γ zero) j k) (kdrop Γ))) (ksyn S r kmt Γ))
kstep S df G n co lo (fqalt j k b r) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo fqanone kmt Γ e hk he = unit
kstep S df G n co lo fqanone m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqif c a b) kmt Γ e hk he =
  kif (ks-T S) (evT G (qeN G n) c e) (evT G (qeN G n) a e) (evT G (qeN G n) b e) (ksyn S a kmt Γ) (ksyn S b kmt Γ)
    (kstep S df G n co lo a kmt Γ e (andl (kok S df a kmt Γ) (kok S df b kmt Γ) (andr (kok S df c kmt Γ) (andbt (kok S df a kmt Γ) (kok S df b kmt Γ)) hk)) he)
    (kstep S df G n co lo b kmt Γ e (andr (kok S df a kmt Γ) (kok S df b kmt Γ) (andr (kok S df c kmt Γ) (andbt (kok S df a kmt Γ) (kok S df b kmt Γ)) hk)) he)
kstep S df G n co lo (fqif c a b) (kmb st) Γ e hk he =
  klif (ks-T S) st (evT G (qeN G n) c e) (evT G (qeN G n) a e) (evT G (qeN G n) b e) (ksyn S a (kmb st) Γ) (ksyn S b (kmb st) Γ)
    (kstep S df G n co lo a (kmb st) Γ e (andl (kok S df a (kmb st) Γ) (kok S df b (kmb st) Γ) (andr (kok S df c kmt Γ) (andbt (kok S df a (kmb st) Γ) (kok S df b (kmb st) Γ)) hk)) he)
    (kstep S df G n co lo b (kmb st) Γ e (andr (kok S df a (kmb st) Γ) (kok S df b (kmb st) Γ) (andr (kok S df c kmt Γ) (andbt (kok S df a (kmb st) Γ) (kok S df b (kmb st) Γ)) hk)) he)
kstep S df G n co lo (fqif c a b) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqclos g env) kmt Γ e hk he = unit
kstep S df G n co lo (fqclos g env) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqlam b) kmt Γ e hk he = unit
kstep S df G n co lo (fqlam b) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqapp f as) kmt Γ e hk he = unit
kstep S df G n co lo (fqapp f as) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqcall g as) kmt Γ e hk he =
  co g (q-push (evT G (qeN G n) as e) kqnil) (andl (df g) (klle (ksyn S as kmt Γ) (ks-SK S g)) (andr (kok S df as kml Γ) (andbt (df g) (klle (ksyn S as kmt Γ) (ks-SK S g))) hk))
    (envk-push (ks-T S) (evT G (qeN G n) as e) (ks-SK S g) (λ m → ka) kqnil
       (klle-sound (ks-T S) (evT G (qeN G n) as e) (ksyn S as kmt Γ) (ks-SK S g)
          (andr (df g) (klle (ksyn S as kmt Γ) (ks-SK S g)) (andr (kok S df as kml Γ) (andbt (df g) (klle (ksyn S as kmt Γ) (ks-SK S g))) hk))
          (kstep S df G n co lo as kml Γ e (andl (kok S df as kml Γ) (andbt (df g) (klle (ksyn S as kmt Γ) (ks-SK S g))) hk) he))
       (λ m → unit))
kstep S df G n co lo (fqcall g as) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqloop init b) kmt Γ e hk he =
  lo (lst S Γ init b) (evT G (qeN G n) init e) b Γ e
    (klle-sound (ks-T S) (evT G (qeN G n) init e) (ksyn S init kmt Γ) (lst S Γ init b)
       (andl (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ)) (andr (kok S df init kml Γ) (andbt (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ))) hk))
       (kstep S df G n co lo init kml Γ e (andl (kok S df init kml Γ) (andbt (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ))) hk) he))
    (andr (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ)) (andr (kok S df init kml Γ) (andbt (klle (ksyn S init kmt Γ) (lst S Γ init b)) (kok S df b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ))) hk))
    he
kstep S df G n co lo (fqloop init b) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo fqnil kml Γ e hk he = unit
kstep S df G n co lo fqnil kmh Γ e hk he = unit
kstep S df G n co lo fqnil m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo (fqcons x r) kml Γ e hk he =
  (kstep S df G n co lo x kmt Γ e (andl (kok S df x kmt Γ) (kok S df r kml Γ) hk) he , kstep S df G n co lo r kml Γ e (andr (kok S df x kmt Γ) (kok S df r kml Γ) hk) he)
kstep S df G n co lo (fqcons x r) kmh Γ e hk he = kstep S df G n co lo x kmt Γ e hk he
kstep S df G n co lo (fqcons x r) m Γ e hk he = Empty-rec (false≢true hk)
kstep S df G n co lo fqnet kmt Γ e hk he = unit
kstep S df G n co lo fqnet m Γ e hk he = Empty-rec (false≢true hk)
-- the theorem one unit of fuel up
KThm : KS → (Word → Bool) → (Word → FQ) → Nat → Type
KThm S df G n = (t : FQ) (m : KM) (Γ : Nat → Kd) (e : KQ) → kok S df t m Γ ≡ true → EnvK (ks-T S) Γ e → KGoal S G n m Γ t e
kcall-up : (S : KS) (df : Word → Bool) (G : Word → FQ) (n : Nat) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true) → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true)
         → KThm S df G n → CallK S df G (suc n)
kcall-up S df G n tok tle th g e2 hd he = kle-sound (ks-T S) (ksyn S (G g) kmt (spk S g)) (ks-SR S g) (evT G (qeN G n) (G g) e2) (tle g hd) (th (G g) kmt (spk S g) e2 (tok g hd) he)
kloop-up : (S : KS) (df : Word → Bool) (G : Word → FQ) (n : Nat) → KThm S df G n → LoopK S df G n → LoopK S df G (suc n)
kloop-up S df G n th lo st vs b Γ e hv hok he =
  klstep (ks-T S) st (ksyn S b (kmb st) (kpush st Γ)) (evT G (qeN G n) b (q-push vs e)) (λ st2 → qe-lp (qeN G n) st2 b e)
    (th b (kmb st) (kpush st Γ) (q-push vs e) hok (envk-push (ks-T S) vs st Γ e hv he))
    (λ fs hfs → lo st fs b Γ e hfs hok he)
kcoks : (S : KS) (df : Word → Bool) (G : Word → FQ) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true) → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true)
      → (n : Nat) → CallK S df G n × LoopK S df G n
kcoks S df G tok tle zero = ((λ g e2 hd he → kv-bot (ks-T S) (ks-SR S g)) , (λ st vs b Γ e hv hok he → kv-bot (ks-T S) (ksyn S b (kmb st) (kpush st Γ))))
kcoks S df G tok tle (suc n) =
  (kcall-up S df G n tok tle (kstep S df G n (fst (kcoks S df G tok tle n)) (snd (kcoks S df G tok tle n))) ,
   kloop-up S df G n (kstep S df G n (fst (kcoks S df G tok tle n)) (snd (kcoks S df G tok tle n))) (snd (kcoks S df G tok tle n)))
-- the theorem: at every fuel, a term meeting the conditions, in an environment of its kinds, has its
-- kind (G the first-order table, df its defined keys, S the kinds: every defined key's body meeting
-- the conditions in its parameters' kinds, of its result's kind)
kind-sound : (S : KS) (df : Word → Bool) (G : Word → FQ) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true) → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true)
           → (n : Nat) → KThm S df G n
kind-sound S df G tok tle n = kstep S df G n (fst (kcoks S df G tok tle n)) (snd (kcoks S df G tok tle n))
-- for a term at evq: at every fuel, evq's value has the term's kind
kind-sound-t : (S : KS) (df : Word → Bool) (G : Word → FQ) → ((g : Word) → df g ≡ true → kok S df (G g) kmt (spk S g) ≡ true) → ((g : Word) → df g ≡ true → kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g) ≡ true)
             → (n : Nat) (t : FQ) (Γ : Nat → Kd) (e : KQ) → kok S df t kmt Γ ≡ true → EnvK (ks-T S) Γ e → Kv (ks-T S) (ksyn S t kmt Γ) (evq G n t e)
kind-sound-t S df G tok tle n t Γ e hk he = kind-sound S df G tok tle n t kmt Γ e hk he
-- ---------------------------------------------------------------- the kinds of a program, inferred
-- (outside the path: any tables kok accepts are sound by kind-sound; this finds them.) kcol collects,
-- in kok's own traversal and environments, what the tables must cover: each call's arguments' kinds,
-- each data constructor's fields' kinds, and the targets of closures (called through apply with boxed
-- values: anything throughout). kstep-tab joins them in; kinfer starts from no value everywhere and
-- takes eight rounds (the tables only grow, in a lattice of height three per slot; the programs nest
-- calls less deep than that). kprog-ok decides kok over the main and every key.
data KR = krnil | krcall (g : Word) (k : Kd) (r : KR) | krcon (d : Word) (c : Word) (k : Kd) (r : KR) | krclo (g : Word) (r : KR)
kr-app : KR → KR → KR
kr-app krnil s = s
kr-app (krcall g k r) s = krcall g k (kr-app r s)
kr-app (krcon d c k r) s = krcon d c k (kr-app r s)
kr-app (krclo g r) s = krclo g (kr-app r s)
kcol : KS → FQ → KM → (Nat → Kd) → KR
kcol S (fqprim p as) kmt Γ = kcol S as kml Γ
kcol S (fqlet a b) kmt Γ = kr-app (kcol S a kmt Γ) (kcol S b kmt (kext Γ (ksyn S a kmt Γ)))
kcol S (fqcon d c fs) kmt Γ = kr-app (kcol S fs kml Γ) (if kcok d c fs then krcon d c (ksyn S fs kmt Γ) krnil else krnil)
kcol S (fqproj d c j x) kmt Γ = kcol S x kmt Γ
kcol S (fqsw x alts) kmt Γ = kr-app (kcol S x kmt Γ) (kcol S alts kmt (kext Γ (ksyn S x kmt Γ)))
kcol S (fqif c a b) kmt Γ = kr-app (kcol S c kmt Γ) (kr-app (kcol S a kmt Γ) (kcol S b kmt Γ))
kcol S (fqclos g env) kmt Γ = krclo g (kcol S env kml Γ)
kcol S (fqapp f as) kmt Γ = kr-app (kcol S f kmt Γ) (kcol S as kml Γ)
kcol S (fqcall g as) kmt Γ = kr-app (kcol S as kml Γ) (krcall g (ksyn S as kmt Γ) krnil)
kcol S (fqloop init b) kmt Γ = kr-app (kcol S init kml Γ) (kcol S b (kmb (lst S Γ init b)) (kpush (lst S Γ init b) Γ))
kcol S (fqalt j n b r) kmt Γ = kr-app (kcol S b kmt (kpush (kfl (ks-T S) (Γ zero) j n) (kdrop Γ))) (kcol S r kmt Γ)
kcol S (fqcons x r) kml Γ = kr-app (kcol S x kmt Γ) (kcol S r kml Γ)
kcol S (fqif c a b) (kmb st) Γ = kr-app (kcol S c kmt Γ) (kr-app (kcol S a (kmb st) Γ) (kcol S b (kmb st) Γ))
kcol S (fqlet a b) (kmb st) Γ = kr-app (kcol S a kmt Γ) (kcol S b (kmb st) (kext Γ (ksyn S a kmt Γ)))
kcol S (fqcon d c fs) (kmb st) Γ = kcol S fs kml Γ
kcol S t m Γ = krnil
-- chains joined pointwise (a length mismatch: anything)
kljoin : Kd → Kd → Kd
kljoin knil knil = knil
kljoin (kcons a r) (kcons b s) = kcons (kjoin a b) (kljoin r s)
kljoin a b = ka
knth : Kd → Nat → Kd
knth (kcons k r) zero = k
knth (kcons k r) (suc i) = knth r i
knth k i = kdn
kdns : Nat → Kd
kdns zero = knil
kdns (suc m) = kcons kdn (kdns m)
-- a key the collection names as a closure's target
kr-clo : KR → Word → Bool
kr-clo krnil g = false
kr-clo (krcall h k r) g = kr-clo r g
kr-clo (krcon d c k r) g = kr-clo r g
kr-clo (krclo h r) g = if weq g h then true else kr-clo r g
kr-sk : KR → Word → Kd → Kd
kr-sk krnil g a = a
kr-sk (krcall h k r) g a = kr-sk r g (if weq g h then kljoin a k else a)
kr-sk (krcon d c k r) g a = kr-sk r g a
kr-sk (krclo h r) g a = kr-sk r g a
kr-t : KR → Word → Word → Nat → Kd → Kd
kr-t krnil d c i a = a
kr-t (krcall h k r) d c i a = kr-t r d c i a
kr-t (krcon d2 c2 k r) d c i a = kr-t r d c i (if andbt (weq d d2) (weq c c2) then kjoin a (knth k i) else a)
kr-t (krclo h r) d c i a = kr-t r d c i a
-- every key's body and the main collected under S (M the main, its parameters' kinds MK)
kcol-all : KS → (Word → FQ) → List Word → FQ → Kd → KR
kcol-all S G nil M MK = kcol S M kmt (kpush MK (λ n → ka))
kcol-all S G (cons g r) M MK = kr-app (kcol S (G g) kmt (spk S g)) (kcol-all S G r M MK)
-- one round: the tables joined with what S's collection asks for (AN the keys' parameter counts)
kstep-r : (Word → FQ) → (Word → Nat) → KS → KR → KS
kstep-r G AN S R =
  ks (λ d c i → kr-t R d c i (ks-T S d c i))
     (λ g → if kr-clo R g then kanys (AN g) else kr-sk R g (ks-SK S g))
     (λ g → if kr-clo R g then ka else kjoin (ks-SR S g) (ksyn S (G g) kmt (spk S g)))
kstep-tab : (Word → FQ) → List Word → (Word → Nat) → FQ → Kd → KS → KS
kstep-tab G ks0 AN M MK S = kstep-r G AN S (kcol-all S G ks0 M MK)
kiter : Nat → (Word → FQ) → List Word → (Word → Nat) → FQ → Kd → KS → KS
kiter zero G ks0 AN M MK S = S
kiter (suc n) G ks0 AN M MK S = kiter n G ks0 AN M MK (kstep-tab G ks0 AN M MK S)
kinfer : (Word → FQ) → List Word → (Word → Nat) → FQ → Kd → KS
kinfer G ks0 AN M MK = kiter (dnat #8) G ks0 AN M MK (ks (λ d c i → kdn) (λ g → kdns (AN g)) (λ g → kdn))
-- the conditions over the keys (each body in its parameters' kinds, of its result's kind) and the main
kkey-ok : KS → (Word → Bool) → (Word → FQ) → Word → Bool
kkey-ok S df G g = andbt (kok S df (G g) kmt (spk S g)) (kle (ksyn S (G g) kmt (spk S g)) (ks-SR S g))
kkeys-ok : KS → (Word → Bool) → (Word → FQ) → List Word → Bool
kkeys-ok S df G nil = true
kkeys-ok S df G (cons g r) = andbt (kkey-ok S df G g) (kkeys-ok S df G r)
-- the main's parameters' kinds from the arguments the harness passes: a word, a constructor of data
-- type d (with the fields' kinds the tables give), anything else
karg : KQ → Kd
karg (kqw w) = kw
karg (kqi b) = kw
karg (kqf b) = kw
karg (kqb l) = kb
karg (kqcon d c fs) = kdc d
karg v = ka
kargs : KQ → Kd
kargs kqnil = knil
kargs (kqcons x r) = kcons (karg x) (kargs r)
kargs v = knil
-- membership in the keys (lib/foproofcp.cub's kmem, here so this file loads without the composed paths)
kmemu : Word → List Word → Bool
kmemu g nil = false
kmemu g (cons k r) = if weq g k then true else kmemu g r
kmemu-miss : (g k : Word) (r : List Word) → weq g k ≡ false → kmemu g (cons k r) ≡ true → kmemu g r ≡ true
kmemu-miss g k r h hm = subst {lzero} {lzero} {Bool} {λ b → (if b then true else kmemu g r) ≡ true} {weq g k} {false} h hm
-- from the keys' decision to the per-key facts kind-sound takes
kkeys-ok-k : (S : KS) (df : Word → Bool) (G : Word → FQ) (ks0 : List Word) → kkeys-ok S df G ks0 ≡ true → (g : Word) → kmemu g ks0 ≡ true → kkey-ok S df G g ≡ true
kkeys-ok-k S df G nil h g hm = Empty-rec (false≢true hm)
kkeys-ok-k S df G (cons k r) h g hm =
  (case weq g k return (λ b → weq g k ≡ b → kkey-ok S df G g ≡ true) of
     true → λ e → subst {lzero} {lzero} {Word} {λ u → kkey-ok S df G u ≡ true} {k} {g} (sym (weq-sound g k e)) (andl (kkey-ok S df G k) (kkeys-ok S df G r) h)
     false → λ e → kkeys-ok-k S df G r (andr (kkey-ok S df G k) (kkeys-ok S df G r) h) g (kmemu-miss g k r e hm)) (λ t → weq g k)
