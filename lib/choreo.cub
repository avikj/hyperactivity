-- lib/choreo.cub — choreographies that run forever (plan 7.3, D24): the global protocol as a
-- guarded data type (each step's continuation one tick later), its endpoint projection to a role
-- a guarded process over the local signature of lib/proc.cub (send, receive, pick, tell, offer),
-- by guarded recursion; projectability decided to a depth (a predicate on the unfoldings, as the
-- finite form's is on the data). The finite choreographies of lib/proc.cub embed. Loaded after
-- lib/proc.cub.
-- ---------------------------------------------------------------- global protocols
data GChor (κ : Clock) =
    gcend
  | gxfer (from : Word) (to : Word) (v : Word) (k : ▸ κ (GChor κ))
  | gchoice (who : Word) (l : ▸ κ (GChor κ)) (r : ▸ κ (GChor κ))
-- the finite form embeds
chor-g : Chor → GChor κ
chor-g cend = gcend
chor-g (xfer a b v k) = gxfer a b v (next (chor-g k))
chor-g (choice a l r) = gchoice a (next (chor-g l)) (next (chor-g r))
-- a transfer from a to b of v, then again forever: a feed
feed : Word → Word → Word → GChor κ
feed a b v = gxfer a b v (λ α → feed a b v)
-- ---------------------------------------------------------------- projection
-- the endpoint projection to a role, by guarded recursion: a step the role is not part of is a
-- silent tick (so that the projection stays productive and the roles' tick counts agree)
gproject : Word → GChor κ → GProc κ LocS Unit
gproject me gcend = gret unit
gproject me (gxfer a b v k) =
  (case weq me a of
     true → gcmd (send b v) (λ u → λ α → gproject me (k α))
     false → (case weq me b of
                true → gcmd (recvf a) (λ w → λ α → gproject me (k α))
                false → gtau (λ α → gproject me (k α))))
gproject me (gchoice a l r) =
  (case weq me a of
     true → gcmd pick (λ lbl → λ β → gcmd (tell lbl) (λ u → λ α → case weq lbl #0 of true → gproject me (l α); false → gproject me (r α)))
     false → gcmd (offer a) (λ lbl → λ α → case weq lbl #0 of true → gproject me (l α); false → gproject me (r α)))
-- ---------------------------------------------------------------- projectability to a depth
-- the protocol unfolded n ticks as finite data (what lies deeper is cut to cend), on which
-- lib/proc.cub's projectable decides; a global is projectable to depth n when every unfolding to
-- n is. The unfolding forces the later continuations, so it is stated over a protocol at every
-- clock
GChorT : Type
GChorT = (κ : Clock) → GChor κ
gc-later : {κ : Clock} → GChor κ → Sum (Word × (Word × (Word × ▸ κ (GChor κ)))) (Sum (Word × (▸ κ (GChor κ) × ▸ κ (GChor κ))) Unit)
gc-later {κ} g =
  case g return (λ x → Sum (Word × (Word × (Word × ▸ κ (GChor κ)))) (Sum (Word × (▸ κ (GChor κ) × ▸ κ (GChor κ))) Unit)) of
    gcend → inr (inr unit)
    gxfer a b v k → inl (a , (b , (v , k)))
    gchoice a l r → inr (inl (a , (l , r)))
unfold-k : GChorT → GChorT
unfold-k g = forceκ {lzero} {λ κ → GChor κ} (λ κ → case gc-later {κ} (g κ) of inl t → snd (snd (snd t)); inr s → (case s of inl c → fst (snd c); inr u → next gcend))
unfold-r : GChorT → GChorT
unfold-r g = forceκ {lzero} {λ κ → GChor κ} (λ κ → case gc-later {κ} (g κ) of inl t → snd (snd (snd t)); inr s → (case s of inl c → snd (snd c); inr u → next gcend))
cut : Nat → GChorT → Chor
cut zero g = cend
cut (suc n) g =
  case gc-later {κ0} (g κ0) of
    inl t → xfer (fst t) (fst (snd t)) (fst (snd (snd t))) (cut n (unfold-k g))
    inr s → (case s of inl c → choice (fst c) (cut n (unfold-k g)) (cut n (unfold-r g)); inr u → cend)
projectable-to : Nat → GChorT → Bool
projectable-to n g = projectable (cut n g)