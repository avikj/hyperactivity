    fcclo y0 → λ e → Empty-rec (false≢true e)
    fcapp y0 y1 → λ e → Empty-rec (false≢true e)
    fccall y0 y1 → λ e → Empty-rec (false≢true e)
    fcby y0 → λ e → Empty-rec (false≢true e)
    fcld y0 y1 → λ e → Empty-rec (false≢true e)
    fcst y0 y1 y2 → λ e → Empty-rec (false≢true e)
fcs-fcclo : (x0 : Word) →  (y : FC) → fc-eq (fcclo x0) y ≡ true → (fcclo x0) ≡ y
fcs-fcclo x0  y = case y return (λ z → fc-eq (fcclo x0) z ≡ true → (fcclo x0) ≡ z) of
