    fcsw y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcclo y0 → λ e → Empty-rec (false≢true e)
    fcapp y0 y1 → λ e → Empty-rec (false≢true e)
    fccall y0 y1 → λ e i → fccall (weq-sound x0 y0 (andbt-l (weq x0 y0) (fc-eq x1 y1) e) i) (h1 y1 (andbt-r (weq x0 y0) (fc-eq x1 y1) e) i)
    fcby y0 → λ e → Empty-rec (false≢true e)
    fcld y0 y1 → λ e → Empty-rec (false≢true e)
    fcst y0 y1 y2 → λ e → Empty-rec (false≢true e)
fcs-fcby : (x0 : Word) →  (y : FC) → fc-eq (fcby x0) y ≡ true → (fcby x0) ≡ y
fcs-fcby x0  y = case y return (λ z → fc-eq (fcby x0) z ≡ true → (fcby x0) ≡ z) of
    fcl y0 → λ e → Empty-rec (false≢true e)
    fcv y0 → λ e → Empty-rec (false≢true e)
    fcp y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fclet y0 y1 → λ e → Empty-rec (false≢true e)
    fccon y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcsw y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcclo y0 → λ e → Empty-rec (false≢true e)
    fcapp y0 y1 → λ e → Empty-rec (false≢true e)
    fccall y0 y1 → λ e → Empty-rec (false≢true e)
    fcby y0 → λ e i → fcby (weq-sound x0 y0 e i)
    fcld y0 y1 → λ e → Empty-rec (false≢true e)
    fcst y0 y1 y2 → λ e → Empty-rec (false≢true e)
fcs-fcld : (x0 : FC) (x1 : FC) → ((y : FC) → fc-eq x0 y ≡ true → x0 ≡ y) → ((y : FC) → fc-eq x1 y ≡ true → x1 ≡ y) → (y : FC) → fc-eq (fcld x0 x1) y ≡ true → (fcld x0 x1) ≡ y
fcs-fcld x0 x1 h0 h1 y = case y return (λ z → fc-eq (fcld x0 x1) z ≡ true → (fcld x0 x1) ≡ z) of
    fcl y0 → λ e → Empty-rec (false≢true e)
    fcv y0 → λ e → Empty-rec (false≢true e)
    fcp y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fclet y0 y1 → λ e → Empty-rec (false≢true e)
    fccon y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcsw y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcclo y0 → λ e → Empty-rec (false≢true e)
    fcapp y0 y1 → λ e → Empty-rec (false≢true e)
    fccall y0 y1 → λ e → Empty-rec (false≢true e)
    fcby y0 → λ e → Empty-rec (false≢true e)
    fcld y0 y1 → λ e i → fcld (h0 y0 (andbt-l (fc-eq x0 y0) (fc-eq x1 y1) e) i) (h1 y1 (andbt-r (fc-eq x0 y0) (fc-eq x1 y1) e) i)
    fcst y0 y1 y2 → λ e → Empty-rec (false≢true e)
fcs-fcst : (x0 : FC) (x1 : FC) (x2 : FC) → ((y : FC) → fc-eq x0 y ≡ true → x0 ≡ y) → ((y : FC) → fc-eq x1 y ≡ true → x1 ≡ y) → ((y : FC) → fc-eq x2 y ≡ true → x2 ≡ y) → (y : FC) → fc-eq (fcst x0 x1 x2) y ≡ true → (fcst x0 x1 x2) ≡ y
fcs-fcst x0 x1 x2 h0 h1 h2 y = case y return (λ z → fc-eq (fcst x0 x1 x2) z ≡ true → (fcst x0 x1 x2) ≡ z) of
    fcl y0 → λ e → Empty-rec (false≢true e)
    fcv y0 → λ e → Empty-rec (false≢true e)
    fcp y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fclet y0 y1 → λ e → Empty-rec (false≢true e)
    fccon y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcsw y0 y1 y2 → λ e → Empty-rec (false≢true e)
    fcclo y0 → λ e → Empty-rec (false≢true e)
    fcapp y0 y1 → λ e → Empty-rec (false≢true e)
    fccall y0 y1 → λ e → Empty-rec (false≢true e)
    fcby y0 → λ e → Empty-rec (false≢true e)
    fcld y0 y1 → λ e → Empty-rec (false≢true e)
    fcst y0 y1 y2 → λ e i → fcst (h0 y0 (andbt-l (fc-eq x0 y0) (andbt (fc-eq x1 y1) (fc-eq x2 y2)) e) i) (h1 y1 (andbt-l (fc-eq x1 y1) (fc-eq x2 y2) (andbt-r (fc-eq x0 y0) (andbt (fc-eq x1 y1) (fc-eq x2 y2)) e)) i) (h2 y2 (andbt-r (fc-eq x1 y1) (fc-eq x2 y2) (andbt-r (fc-eq x0 y0) (andbt (fc-eq x1 y1) (fc-eq x2 y2)) e)) i)
fc-eq-sound : (x y : FC) → fc-eq x y ≡ true → x ≡ y
fc-eq-sound (fcl x0) = fcs-fcl x0 
fc-eq-sound (fcv x0) = fcs-fcv x0 
fc-eq-sound (fcp x0 x1 x2) = fcs-fcp x0 x1 x2 (fc-eq-sound x1) (fc-eq-sound x2)
fc-eq-sound (fclet x0 x1) = fcs-fclet x0 x1 (fc-eq-sound x0) (fc-eq-sound x1)
fc-eq-sound (fccon x0 x1 x2) = fcs-fccon x0 x1 x2 (fc-eq-sound x1) (fc-eq-sound x2)
fc-eq-sound (fcsw x0 x1 x2) = fcs-fcsw x0 x1 x2 (fc-eq-sound x0) (fc-eq-sound x1) (fc-eq-sound x2)
fc-eq-sound (fcclo x0) = fcs-fcclo x0 
fc-eq-sound (fcapp x0 x1) = fcs-fcapp x0 x1 (fc-eq-sound x0) (fc-eq-sound x1)
fc-eq-sound (fccall x0 x1) = fcs-fccall x0 x1 (fc-eq-sound x1)
fc-eq-sound (fcby x0) = fcs-fcby x0 
fc-eq-sound (fcld x0 x1) = fcs-fcld x0 x1 (fc-eq-sound x0) (fc-eq-sound x1)
fc-eq-sound (fcst x0 x1 x2) = fcs-fcst x0 x1 x2 (fc-eq-sound x0) (fc-eq-sound x1) (fc-eq-sound x2)
dtok-chk : (Word → FC) → DC → Bool
dtok-chk T (dcl w) = true
dtok-chk T (dcv n) = true
dtok-chk T (dcp p a b) = andbt (dtok-chk T a) (dtok-chk T b)
dtok-chk T (dclet a b) = andbt (dtok-chk T a) (dtok-chk T b)
dtok-chk T (dccon k a b) = andbt (dtok-chk T a) (dtok-chk T b)
dtok-chk T (dccase s b0 b1) = andbt (dtok-chk T s) (andbt (dtok-chk T b0) (dtok-chk T b1))
dtok-chk T (dclam i b) = andbt (fc-eq (T i) (dconv b)) (dtok-chk T b)
dtok-chk T (dcapp f a) = andbt (dtok-chk T f) (dtok-chk T a)
dtok-chk T (dccall g a) = dtok-chk T a
dtok-chk T (dcby k) = true
dtok-chk T (dcld b o) = andbt (dtok-chk T b) (dtok-chk T o)
dtok-chk T (dcst b o v) = andbt (dtok-chk T b) (andbt (dtok-chk T o) (dtok-chk T v))
dtok-auto : (T : Word → FC) (c : DC) → dtok-chk T c ≡ true → DTok T c
dtok-auto T (dcl w) e = unit
dtok-auto T (dcv n) e = unit
dtok-auto T (dcp p a b) e = (dtok-auto T a (andbt-l (dtok-chk T a) (dtok-chk T b) e) , dtok-auto T b (andbt-r (dtok-chk T a) (dtok-chk T b) e))
dtok-auto T (dclet a b) e = (dtok-auto T a (andbt-l (dtok-chk T a) (dtok-chk T b) e) , dtok-auto T b (andbt-r (dtok-chk T a) (dtok-chk T b) e))
dtok-auto T (dccon k a b) e = (dtok-auto T a (andbt-l (dtok-chk T a) (dtok-chk T b) e) , dtok-auto T b (andbt-r (dtok-chk T a) (dtok-chk T b) e))
dtok-auto T (dccase s b0 b1) e =
  (dtok-auto T s (andbt-l (dtok-chk T s) (andbt (dtok-chk T b0) (dtok-chk T b1)) e) ,
   (dtok-auto T b0 (andbt-l (dtok-chk T b0) (dtok-chk T b1) (andbt-r (dtok-chk T s) (andbt (dtok-chk T b0) (dtok-chk T b1)) e)) ,
    dtok-auto T b1 (andbt-r (dtok-chk T b0) (dtok-chk T b1) (andbt-r (dtok-chk T s) (andbt (dtok-chk T b0) (dtok-chk T b1)) e))))
dtok-auto T (dclam i b) e = (fc-eq-sound (T i) (dconv b) (andbt-l (fc-eq (T i) (dconv b)) (dtok-chk T b) e) , dtok-auto T b (andbt-r (fc-eq (T i) (dconv b)) (dtok-chk T b) e))
dtok-auto T (dcapp f a) e = (dtok-auto T f (andbt-l (dtok-chk T f) (dtok-chk T a) e) , dtok-auto T a (andbt-r (dtok-chk T f) (dtok-chk T a) e))
dtok-auto T (dccall g a) e = dtok-auto T a e
dtok-auto T (dcby k) e = unit
dtok-auto T (dcld b o) e = (dtok-auto T b (andbt-l (dtok-chk T b) (dtok-chk T o) e) , dtok-auto T o (andbt-r (dtok-chk T b) (dtok-chk T o) e))
dtok-auto T (dcst b o v) e =
  (dtok-auto T b (andbt-l (dtok-chk T b) (andbt (dtok-chk T o) (dtok-chk T v)) e) ,
   (dtok-auto T o (andbt-l (dtok-chk T o) (dtok-chk T v) (andbt-r (dtok-chk T b) (andbt (dtok-chk T o) (dtok-chk T v)) e)) ,
    dtok-auto T v (andbt-r (dtok-chk T o) (dtok-chk T v) (andbt-r (dtok-chk T b) (andbt (dtok-chk T o) (dtok-chk T v)) e))))
-- ---------------------------------------------------------------- an example with data, a closure and a call
-- def #1 x = let f = λ#0 y. y + x in case con 1 (f 3) (call #2 x) of 0 → 0 | 1 p q → p + q ;  def #2 x = x + x
dx-body1 : DC
dx-body1 = dclet (dclam #0 (dcp #0 (dcv 0) (dcv 1))) (dccase (dccon #1 (dcapp (dcv 0) (dcl #3)) (dccall #2 (dcv 1))) (dcl #0) (dcp #0 (dcv 1) (dcv 0)))
dx-body2 : DC
dx-body2 = dcp #0 (dcv 0) (dcv 0)
dx-main : DC
dx-main = dccall #1 (dcl #4)
dx-G : Word → DC
dx-G g = %welimP (λ v → DC) g (dcl #0) (λ m h → %welimP (λ v → DC) m dx-body1 (λ m2 h2 → %welimP (λ v → DC) m2 dx-body2 (λ m3 h3 → dcl #0)))
-- the lifted table: λ#0's body converted
dx-T : Word → FC
dx-T i = %welimP (λ v → FC) i (fcp #0 (fcv 0) (fcv 1)) (λ m h → fcl #0)
dx-GT : Word → FC
dx-GT g = dconv (dx-G g)
dx-gok : DGOK dx-G dx-T dx-GT
dx-gok g = ((λ i → dx-GT g) ,
  %welimP (λ v → DTok dx-T (dx-G v)) g unit
    (λ m h → %welimP (λ v → DTok dx-T (dx-G (%wsucc v))) m (dtok-auto dx-T dx-body1 (λ i → true))
      (λ m2 h2 → %welimP (λ v → DTok dx-T (dx-G (%wsucc (%wsucc v)))) m2 (dtok-auto dx-T dx-body2 (λ i → true)) (λ m3 h3 → unit))))
-- the justifying path: the converted program means what the source does, at every fuel
dx-path : (n : Nat) → derase (dsev dx-G n dx-main dvnone) ≡ dtev dx-T dx-GT n (dconv dx-main) tvnone
dx-path n = snd (dc-sound dx-G dx-T dx-GT dx-gok n dx-main dvnone unit (λ k → unit))
dnat : Word → Nat
dnat w = %welimP (λ v → Nat) w zero (λ m h → suc h)
-- readings: the source and its conversion run to the same value (4 + 3 = 7, 4 + 4 = 8, 7 + 8 = 15)
#same dsev dx-G (dnat #30) dx-main dvnone = dvw #15
#same dtev dx-T dx-GT (dnat #30) (dconv dx-main) tvnone = tvw #15
#same dconv dx-body1 = fclet (fcclo #0) (fcsw (fccon #1 (fcapp (fcv 0) (fcl #3)) (fccall #2 (fcv 1))) (fcl #0) (fcp #0 (fcv 1) (fcv 0)))
-- out of fuel both sides are ⊥, as the theorem says they must agree
#same dsev dx-G (dnat #3) dx-main dvnone = dvbot
#same dtev dx-T dx-GT (dnat #3) (dconv dx-main) tvnone = tvbot
-- ---------------------------------------------------------------- the bridge to the first-order form
-- (an untyped translation, like fw-to-fo; the readings below check it on the example). At depth d
-- (the number of variables in scope): a closure reference captures every variable, x_{d-1} first, so
-- that the lifted body (key #100 + i, arity d + 1) sees the argument then x_0 … x_{d-1}, as dext
-- does; a call passes its one argument; a case has alternatives for tags 0 and 1 with two fields
-- (fswitch pushes the second field innermost, as dccase does). dccase sends any nonzero tag to b1
-- and fswitch only tag 1 — the bridge is for programs whose constructors are tagged 0 or 1.
fc-caps d = case d of zero → lnil; suc k → lcons (fvar (fromNat k)) (fc-caps k)
-- ---------------------------------------------------------------- verified rewrites past the word fragment
-- Rewrites over the converted mirror (FC: closures by table index, so a value holds no code and the
-- order below is first order), applied bottom up to main, the closures' table and the globals'
-- table alike. Their soundness is refinement at every fuel and environment: where the program before
-- the rewrite has a value, the program after has the same one (it may have one at a fuel where the
-- one before had none: x + 0 → x needs a unit less). Then for a data program read into the mirror,
-- what the rewritten conversion computes refines what the source means (fr-dc-path).
-- the order: nothing (tvbot) below everything; a word, a constructor value or a string only below
-- itself; a closure below one of the same index whose environment is above its own, pointwise
fr-le : TV → TV → Type
fr-le tvbot v = Unit
fr-le (tvw a) v = tvw a ≡ v
fr-le (tvc k a b) v = tvc k a b ≡ v
fr-le (tvb m) v = tvb m ≡ v
fr-le (tvclo i ρ) (tvclo j σ) = (i ≡ j) × ((k : Nat) → fr-le (ρ k) (σ k))
fr-le (tvclo i ρ) _ = Empty
FrEnv : (Nat → TV) → (Nat → TV) → Type
FrEnv ρ σ = (k : Nat) → fr-le (ρ k) (σ k)
fr-refl : (v : TV) → fr-le v v
fr-refl tvbot = unit
fr-refl (tvw a) = λ j → tvw a
fr-refl (tvc k a b) = λ j → tvc k a b
fr-refl (tvb m) = λ j → tvb m
fr-refl (tvclo i ρ) = ((λ j → i) , (λ k → fr-refl (ρ k)))
fr-erefl : (ρ : Nat → TV) → FrEnv ρ ρ
fr-erefl ρ k = fr-refl (ρ k)
fr-trans : (x y z : TV) → fr-le x y → fr-le y z → fr-le x z
fr-trans tvbot y z p q = unit
fr-trans (tvw a) y z p q = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {tvw a} (sym p) q
fr-trans (tvc k a b) y z p q = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {tvc k a b} (sym p) q
fr-trans (tvb m) y z p q = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {tvb m} (sym p) q
fr-trans (tvclo i ρ) (tvclo j σ) (tvclo l τ) p q = (catw (fst p) (fst q) , (λ k → fr-trans (ρ k) (σ k) (τ k) (snd p k) (snd q k)))
fr-trans (tvclo i ρ) (tvclo j σ) _ p q = Empty-rec q
fr-trans (tvclo i ρ) _ z p q = Empty-rec p
-- a path on the left or on the right
fr-lpath : (x y z : TV) → x ≡ y → fr-le y z → fr-le x z
fr-lpath x y z e h = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {x} (sym e) h
fr-ext : (ρ σ : Nat → TV) (x x' : TV) → FrEnv ρ σ → fr-le x x' → FrEnv (text ρ x) (text σ x')
fr-ext ρ σ x x' he hx k = case k return (λ m → fr-le (text ρ x m) (text σ x' m)) of
  zero → hx
  suc m → he m
fr-none : FrEnv tvnone tvnone
fr-none k = unit
-- each operation keeps the order
fr-prim-le : (p : Word) (x x' y y' : TV) → fr-le x x' → fr-le y y' → fr-le (tv-prim p x y) (tv-prim p x' y')
fr-prim-le p (tvw a) x' (tvw b) y' hx hy = λ j → tv-prim p (hx j) (hy j)
fr-prim-le p _ x' _ y' hx hy = unit
fr-con-le : (k : Word) (x x' y y' : TV) → fr-le x x' → fr-le y y' → fr-le (tv-con k x y) (tv-con k x' y')
fr-con-le k (tvw a) x' (tvw b) y' hx hy = λ j → tv-con k (hx j) (hy j)
fr-con-le k _ x' _ y' hx hy = unit
fr-ld-le : (x x' y y' : TV) → fr-le x x' → fr-le y y' → fr-le (tv-ld x y) (tv-ld x' y')
fr-ld-le (tvb m) x' (tvw o) y' hx hy = λ j → tv-ld (hx j) (hy j)
fr-ld-le _ x' _ y' hx hy = unit
fr-st-le : (x x' y y' z z' : TV) → fr-le x x' → fr-le y y' → fr-le z z' → fr-le (tv-st x y z) (tv-st x' y' z')
fr-st-le (tvb m) x' (tvw o) y' (tvw v) z' hx hy hz = λ j → tv-st (hx j) (hy j) (hz j)
fr-st-le _ x' _ y' _ z' hx hy hz = unit
fr-sel-le : (ev ev' : FC → (Nat → TV) → TV) (ρ σ : Nat → TV) (s s' : TV) (b0 b1 b0' b1' : FC) → fr-le s s' → FrEnv ρ σ
          → ((r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev b0 r1) (ev' b0' s1))
          → ((r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev b1 r1) (ev' b1' s1))
          → fr-le (tv-sel ev ρ s b0 b1) (tv-sel ev' σ s' b0' b1')
fr-sel-le ev ev' ρ σ (tvc k p q) s' b0 b1 b0' b1' hs he h0 h1 =
  subst {lzero} {lzero} {TV} {λ v → fr-le (tv-sel ev ρ (tvc k p q) b0 b1) (tv-sel ev' σ v b0' b1')} {tvc k p q} {s'} hs
    (%welimP (λ v → fr-le (%welimP (λ u → TV) v (ev b0 (text (text ρ (tvw p)) (tvw q))) (λ m h → ev b1 (text (text ρ (tvw p)) (tvw q))))
                          (%welimP (λ u → TV) v (ev' b0' (text (text σ (tvw p)) (tvw q))) (λ m h → ev' b1' (text (text σ (tvw p)) (tvw q))))) k
       (h0 (text (text ρ (tvw p)) (tvw q)) (text (text σ (tvw p)) (tvw q)) (fr-ext (text ρ (tvw p)) (text σ (tvw p)) (tvw q) (tvw q) (fr-ext ρ σ (tvw p) (tvw p) he (λ j → tvw p)) (λ j → tvw q)))
       (λ m h → h1 (text (text ρ (tvw p)) (tvw q)) (text (text σ (tvw p)) (tvw q)) (fr-ext (text ρ (tvw p)) (text σ (tvw p)) (tvw q) (tvw q) (fr-ext ρ σ (tvw p) (tvw p) he (λ j → tvw p)) (λ j → tvw q))))
fr-sel-le ev ev' ρ σ _ s' b0 b1 b0' b1' hs he h0 h1 = unit
fr-app-le : (T T' : Word → FC) (ev ev' : FC → (Nat → TV) → TV) (f f' a a' : TV) → fr-le f f' → fr-le a a'
          → ((i : Word) (r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev (T i) r1) (ev' (T' i) s1))
          → fr-le (tv-app T ev f a) (tv-app T' ev' f' a')
fr-app-le T T' ev ev' (tvclo i ρ1) (tvclo j σ1) a a' hf ha hb =
  subst {lzero} {lzero} {Word} {λ w → fr-le (ev (T i) (text ρ1 a)) (ev' (T' w) (text σ1 a'))} {i} {j} (fst hf)
    (hb i (text ρ1 a) (text σ1 a') (fr-ext ρ1 σ1 a a' (snd hf) ha))
fr-app-le T T' ev ev' (tvclo i ρ1) _ a a' hf ha hb = Empty-rec hf
fr-app-le T T' ev ev' _ f' a a' hf ha hb = unit
-- more fuel and a larger environment give a larger value
fr-addn : Nat → Nat → Nat
fr-addn zero k = k
fr-addn (suc n) k = suc (fr-addn n k)
fr-addn-0 : (n : Nat) → fr-addn n zero ≡ n
fr-addn-0 zero = λ j → zero
fr-addn-0 (suc n) = λ j → suc (fr-addn-0 n j)
fr-addn-1 : (n : Nat) → fr-addn n (suc zero) ≡ suc n
fr-addn-1 zero = λ j → suc zero
fr-addn-1 (suc n) = λ j → suc (fr-addn-1 n j)
fr-mono : (T GT : Word → FC) (n k : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT (fr-addn n k) c σ)
fr-mono T GT zero k c ρ σ he = unit
fr-mono T GT (suc n) k (fcl w) ρ σ he = λ j → tvw w
fr-mono T GT (suc n) k (fcv m) ρ σ he = he m
fr-mono T GT (suc n) k (fcp p a b) ρ σ he =
  fr-prim-le p (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (fr-mono T GT n k a ρ σ he) (fr-mono T GT n k b ρ σ he)
fr-mono T GT (suc n) k (fclet a b) ρ σ he =
  fr-mono T GT n k b (text ρ (dtev T GT n a ρ)) (text σ (dtev T GT (fr-addn n k) a σ)) (fr-ext ρ σ (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) he (fr-mono T GT n k a ρ σ he))
fr-mono T GT (suc n) k (fccon kk a b) ρ σ he =
  fr-con-le kk (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (fr-mono T GT n k a ρ σ he) (fr-mono T GT n k b ρ σ he)
fr-mono T GT (suc n) k (fcsw s b0 b1) ρ σ he =
  fr-sel-le (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev T GT (fr-addn n k) c1 s1) ρ σ (dtev T GT n s ρ) (dtev T GT (fr-addn n k) s σ) b0 b1 b0 b1
    (fr-mono T GT n k s ρ σ he) he (λ r1 s1 h → fr-mono T GT n k b0 r1 s1 h) (λ r1 s1 h → fr-mono T GT n k b1 r1 s1 h)
fr-mono T GT (suc n) k (fcclo i) ρ σ he = ((λ j → i) , he)
fr-mono T GT (suc n) k (fcapp f a) ρ σ he =
  fr-app-le T T (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev T GT (fr-addn n k) c1 s1) (dtev T GT n f ρ) (dtev T GT (fr-addn n k) f σ) (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ)
    (fr-mono T GT n k f ρ σ he) (fr-mono T GT n k a ρ σ he) (λ i r1 s1 h → fr-mono T GT n k (T i) r1 s1 h)
fr-mono T GT (suc n) k (fccall g a) ρ σ he =
  fr-mono T GT n k (GT g) (text tvnone (dtev T GT n a ρ)) (text tvnone (dtev T GT (fr-addn n k) a σ)) (fr-ext tvnone tvnone (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) fr-none (fr-mono T GT n k a ρ σ he))
fr-mono T GT (suc n) k (fcby kk) ρ σ he = λ j → tvb bzero
fr-mono T GT (suc n) k (fcld b o) ρ σ he =
  fr-ld-le (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (dtev T GT n o ρ) (dtev T GT (fr-addn n k) o σ) (fr-mono T GT n k b ρ σ he) (fr-mono T GT n k o ρ σ he)
fr-mono T GT (suc n) k (fcst b o v) ρ σ he =
  fr-st-le (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (dtev T GT n o ρ) (dtev T GT (fr-addn n k) o σ) (dtev T GT n v ρ) (dtev T GT (fr-addn n k) v σ)
    (fr-mono T GT n k b ρ σ he) (fr-mono T GT n k o ρ σ he) (fr-mono T GT n k v ρ σ he)
-- at the same fuel, and at one or two units more
fr-same : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n c σ)
fr-same T GT n c ρ σ he = subst {lzero} {lzero} {Nat} {λ m → fr-le (dtev T GT n c ρ) (dtev T GT m c σ)} {fr-addn n zero} {n} (fr-addn-0 n) (fr-mono T GT n zero c ρ σ he)
fr-up1 : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT (suc n) c σ)
fr-up1 T GT n c ρ σ he = subst {lzero} {lzero} {Nat} {λ m → fr-le (dtev T GT n c ρ) (dtev T GT m c σ)} {fr-addn n (suc zero)} {suc n} (fr-addn-1 n) (fr-mono T GT n (suc zero) c ρ σ he)
fr-up2 : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT (suc (suc n)) c σ)
fr-up2 T GT n c ρ σ he = fr-trans (dtev T GT n c ρ) (dtev T GT (suc n) c σ) (dtev T GT (suc (suc n)) c σ) (fr-up1 T GT n c ρ σ he) (fr-up1 T GT (suc n) c σ σ (fr-erefl σ))
-- a rule: a function on forms, its result refining its argument for any tables
FRule : Type
FRule = (f : FC → FC) × ((T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (f c) σ))
fr-then : FRule → FRule → FRule
fr-then r1 r2 = ((λ c → fst r2 (fst r1 c)) ,
  (λ T GT n c ρ σ he → fr-trans (dtev T GT n c ρ) (dtev T GT n (fst r1 c) σ) (dtev T GT n (fst r2 (fst r1 c)) σ) (snd r1 T GT n c ρ σ he) (snd r2 T GT n (fst r1 c) σ σ (fr-erefl σ))))
-- constants folded: a primitive on two literals is its value (addition and subtraction)
fr-fp : Word → FC → FC → FC
fr-fp p (fcl a) (fcl b) = fcl (fw-prim p a b)
fr-fp p a b = fcp p a b
fr-f : FC → FC
fr-f (fcp p a b) = fr-fp p a b
fr-f c = c
fr-fp-ok : (T GT : Word → FC) (n : Nat) (p : Word) (a b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp p a b) ρ) (dtev T GT n (fr-fp p a b) σ)
fr-fp-ok T GT zero p a b ρ σ he = unit
fr-fp-ok T GT (suc zero) p (fcl a) (fcl b) ρ σ he = unit
fr-fp-ok T GT (suc (suc n)) p (fcl a) (fcl b) ρ σ he = λ j → tvw (fw-prim p a b)
fr-fp-ok T GT (suc n) p a b ρ σ he = fr-same T GT (suc n) (fcp p a b) ρ σ he
fr-f-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-f c) σ)
fr-f-ok T GT n (fcp p a b) ρ σ he = fr-fp-ok T GT n p a b ρ σ he
fr-f-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
fold-frule : FRule
fold-frule = (fr-f , fr-f-ok)
-- 0 + x = x and x + 0 = x (the store's plusw-zero-l, plusw-zero-r through wadd-zero-l, wadd-zero-r)
fr-zl-v : (y y' : TV) → fr-le y y' → fr-le (tv-prim #0 (tvw #0) y) y'
fr-zl-v (tvw b) y' h = dtr {tvw (wadd #0 b)} {tvw b} {y'} (λ j → tvw (wadd-zero-l b j)) h
fr-zl-v _ y' h = unit
fr-zr-v : (x x' : TV) → fr-le x x' → fr-le (tv-prim #0 x (tvw #0)) x'
fr-zr-v (tvw a) x' h = dtr {tvw (wadd a #0)} {tvw a} {x'} (λ j → tvw (wadd-zero-r a j)) h
fr-zr-v _ x' h = unit
fr-zr : FC → FC → FC
fr-zr a (fcl w) = %welimP (λ v → FC) w a (λ m h → fcp #0 a (fcl (%wsucc m)))
fr-zr a b = fcp #0 a b
fr-z0 : FC → FC → FC
fr-z0 (fcl w) b = %welimP (λ v → FC) w b (λ m h → fr-zr (fcl (%wsucc m)) b)
fr-z0 a b = fr-zr a b
fr-zp : Word → FC → FC → FC
fr-zp p a b = %welimP (λ v → FC) p (fr-z0 a b) (λ m h → fcp (%wsucc m) a b)
fr-z : FC → FC
fr-z (fcp p a b) = fr-zp p a b
fr-z c = c
-- x + 0 at fuel n refines x at fuel n (one unit of fuel spent on the addition)
fr-zr0-ok : (T GT : Word → FC) (n : Nat) (a : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 a (fcl #0)) ρ) (dtev T GT n a σ)
fr-zr0-ok T GT zero a ρ σ he = unit
fr-zr0-ok T GT (suc zero) a ρ σ he = unit
fr-zr0-ok T GT (suc (suc n)) a ρ σ he = fr-zr-v (dtev T GT (suc n) a ρ) (dtev T GT (suc (suc n)) a σ) (fr-up1 T GT (suc n) a ρ σ he)
fr-zl0-ok : (T GT : Word → FC) (n : Nat) (b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 (fcl #0) b) ρ) (dtev T GT n b σ)
fr-zl0-ok T GT zero b ρ σ he = unit
fr-zl0-ok T GT (suc zero) b ρ σ he = unit
fr-zl0-ok T GT (suc (suc n)) b ρ σ he = fr-zl-v (dtev T GT (suc n) b ρ) (dtev T GT (suc (suc n)) b σ) (fr-up1 T GT (suc n) b ρ σ he)
fr-zr-ok : (T GT : Word → FC) (n : Nat) (a b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 a b) ρ) (dtev T GT n (fr-zr a b) σ)
fr-zr-ok T GT n a (fcl w) ρ σ he =
  %welimP (λ v → fr-le (dtev T GT n (fcp #0 a (fcl v)) ρ) (dtev T GT n (fr-zr a (fcl v)) σ)) w
    (fr-zr0-ok T GT n a ρ σ he)
    (λ m h → fr-same T GT n (fcp #0 a (fcl (%wsucc m))) ρ σ he)
fr-zr-ok T GT n a b ρ σ he = fr-same T GT n (fcp #0 a b) ρ σ he
fr-z0-ok : (T GT : Word → FC) (n : Nat) (a b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 a b) ρ) (dtev T GT n (fr-z0 a b) σ)
fr-z0-ok T GT n (fcl w) b ρ σ he =
  %welimP (λ v → fr-le (dtev T GT n (fcp #0 (fcl v) b) ρ) (dtev T GT n (fr-z0 (fcl v) b) σ)) w
    (fr-zl0-ok T GT n b ρ σ he)
    (λ m h → fr-zr-ok T GT n (fcl (%wsucc m)) b ρ σ he)
fr-z0-ok T GT n a b ρ σ he = fr-zr-ok T GT n a b ρ σ he
fr-z-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-z c) σ)
fr-z-ok T GT n (fcp p a b) ρ σ he =
  %welimP (λ v → fr-le (dtev T GT n (fcp v a b) ρ) (dtev T GT n (fr-zp v a b) σ)) p
    (fr-z0-ok T GT n a b ρ σ he)
    (λ m h → fr-same T GT n (fcp (%wsucc m) a b) ρ σ he)
fr-z-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
zero-frule : FRule
zero-frule = (fr-z , fr-z-ok)
-- the byte layer: a load from a store at the same literal offset is the stored word; at another
-- literal offset, the load from the string before the store, itself forwarded the same way through
-- the stores below it (lib/region.cub's rd-wr, rd-wr-disj, in the cell model)
fr-pick : Bool → FC → FC → FC
fr-pick true x y = x
fr-pick false x y = y
fr-l1 : FC → FC → FC
fr-l1 (fcst b (fcl o) v) (fcl o2) = fr-pick (weq o2 o) v (fr-l1 b (fcl o2))
fr-l1 s o2 = fcld s o2
fr-l : FC → FC
fr-l (fcld s o2) = fr-l1 s o2
fr-l c = c
fr-fwd-t : (o o2 : Word) (B V V2 : TV) → weq o2 o ≡ true → fr-le V V2 → fr-le (tv-ld (tv-st B (tvw o) V) (tvw o2)) V2
fr-fwd-t o o2 (tvb m) (tvw x) V2 e h = dtr {tvw (bsel (weq o2 o) x (m o2))} {tvw x} {V2} (λ j → tvw (bsel (e j) x (m o2))) h
fr-fwd-t o o2 _ _ V2 e h = unit
fr-fwd-f : (o o2 : Word) (B V B2 : TV) → weq o2 o ≡ false → fr-le B B2 → fr-le (tv-ld (tv-st B (tvw o) V) (tvw o2)) (tv-ld B2 (tvw o2))
fr-fwd-f o o2 (tvb m) (tvw x) B2 e h = dtr {tvw (bsel (weq o2 o) x (m o2))} {tvw (m o2)} {tv-ld B2 (tvw o2)} (λ j → tvw (bsel (e j) x (m o2))) (λ j → tv-ld (h j) (tvw o2))
fr-fwd-f o o2 _ _ B2 e h = unit
fr-fwd-ok : (T GT : Word → FC) (bv : Bool) (o o2 : Word) (b v : FC) → weq o2 o ≡ bv
          → ((n1 : Nat) (r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (dtev T GT n1 (fcld b (fcl o2)) r1) (dtev T GT n1 (fr-l1 b (fcl o2)) s1))
          → (n : Nat) (ρ σ : Nat → TV) → FrEnv ρ σ
          → fr-le (dtev T GT n (fcld (fcst b (fcl o) v) (fcl o2)) ρ) (dtev T GT n (fr-pick bv v (fr-l1 b (fcl o2))) σ)
fr-fwd-ok T GT true o o2 b v e rec zero ρ σ he = unit
fr-fwd-ok T GT true o o2 b v e rec (suc zero) ρ σ he = unit
fr-fwd-ok T GT true o o2 b v e rec (suc (suc zero)) ρ σ he = unit
fr-fwd-ok T GT true o o2 b v e rec (suc (suc (suc n))) ρ σ he =
  fr-fwd-t o o2 (dtev T GT (suc n) b ρ) (dtev T GT (suc n) v ρ) (dtev T GT (suc (suc (suc n))) v σ) e (fr-up2 T GT (suc n) v ρ σ he)
fr-fwd-ok T GT false o o2 b v e rec zero ρ σ he = unit
fr-fwd-ok T GT false o o2 b v e rec (suc zero) ρ σ he = unit
fr-fwd-ok T GT false o o2 b v e rec (suc (suc zero)) ρ σ he = unit
fr-fwd-ok T GT false o o2 b v e rec (suc (suc (suc n))) ρ σ he =
  fr-trans (dtev T GT (suc (suc (suc n))) (fcld (fcst b (fcl o) v) (fcl o2)) ρ) (dtev T GT (suc (suc (suc n))) (fcld b (fcl o2)) σ) (dtev T GT (suc (suc (suc n))) (fr-l1 b (fcl o2)) σ)
    (fr-fwd-f o o2 (dtev T GT (suc n) b ρ) (dtev T GT (suc n) v ρ) (dtev T GT (suc (suc n)) b σ) e (fr-up1 T GT (suc n) b ρ σ he))
    (rec (suc (suc (suc n))) σ σ (fr-erefl σ))
fr-l1w-ok : (T GT : Word → FC) (s : FC) (o2 : Word) (n : Nat) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcld s (fcl o2)) ρ) (dtev T GT n (fr-l1 s (fcl o2)) σ)
fr-l1w-ok T GT (fcst b (fcl o) v) o2 n ρ σ he = fr-fwd-ok T GT (weq o2 o) o o2 b v (λ j → weq o2 o) (λ n1 r1 s1 h1 → fr-l1w-ok T GT b o2 n1 r1 s1 h1) n ρ σ he
fr-l1w-ok T GT s o2 n ρ σ he = fr-same T GT n (fcld s (fcl o2)) ρ σ he
fr-l1-ok : (T GT : Word → FC) (n : Nat) (s o2 : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcld s o2) ρ) (dtev T GT n (fr-l1 s o2) σ)
fr-l1-ok T GT n (fcst b (fcl o) v) (fcl o2) ρ σ he = fr-l1w-ok T GT (fcst b (fcl o) v) o2 n ρ σ he
fr-l1-ok T GT n s o2 ρ σ he = fr-same T GT n (fcld s o2) ρ σ he
fr-l-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-l c) σ)
fr-l-ok T GT n (fcld s o2) ρ σ he = fr-l1-ok T GT n s o2 ρ σ he
fr-l-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
load-frule : FRule
load-frule = (fr-l , fr-l-ok)
-- the rules of this file over the converted mirror: std-vrule's two (folding first, as there) and the
-- byte layer's forwarding
std-frule : FRule
std-frule = fr-then (fr-then fold-frule zero-frule) load-frule
-- applied bottom up: the children rewritten, then the rule at the node
fr-kids : (FC → FC) → FC → FC
fr-kids f (fcl w) = fcl w
fr-kids f (fcv k) = fcv k
fr-kids f (fcp p a b) = fcp p (f (fr-kids f a)) (f (fr-kids f b))
fr-kids f (fclet a b) = fclet (f (fr-kids f a)) (f (fr-kids f b))
fr-kids f (fccon k a b) = fccon k (f (fr-kids f a)) (f (fr-kids f b))
fr-kids f (fcsw s b0 b1) = fcsw (f (fr-kids f s)) (f (fr-kids f b0)) (f (fr-kids f b1))
fr-kids f (fcclo i) = fcclo i
fr-kids f (fcapp g a) = fcapp (f (fr-kids f g)) (f (fr-kids f a))
fr-kids f (fccall g a) = fccall g (f (fr-kids f a))
fr-kids f (fcby k) = fcby k
fr-kids f (fcld b o) = fcld (f (fr-kids f b)) (f (fr-kids f o))
fr-kids f (fcst b o v) = fcst (f (fr-kids f b)) (f (fr-kids f o)) (f (fr-kids f v))
fr-bu : (FC → FC) → FC → FC
fr-bu f c = f (fr-kids f c)
-- a table rewritten entry by entry
fr-tab : (FC → FC) → (Word → FC) → Word → FC
fr-tab f T i = fr-bu f (T i)
-- one step of congruence: the node with its children rewritten (the tables too) refines the node,
-- given that at one unit of fuel less every form's rewrite refines it
FrIH : (FC → FC) → (Word → FC) → (Word → FC) → Nat → Type
FrIH f T GT n = (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f c) σ)
fr-cong : (f : FC → FC) (T GT : Word → FC) (n : Nat) → FrIH f T GT n → (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ
        → fr-le (dtev T GT (suc n) c ρ) (dtev (fr-tab f T) (fr-tab f GT) (suc n) (fr-kids f c) σ)
fr-cong f T GT n ih (fcl w) ρ σ he = λ j → tvw w
fr-cong f T GT n ih (fcv k) ρ σ he = he k
fr-cong f T GT n ih (fcp p a b) ρ σ he =
  fr-prim-le p (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (ih a ρ σ he) (ih b ρ σ he)
fr-cong f T GT n ih (fclet a b) ρ σ he =
  ih b (text ρ (dtev T GT n a ρ)) (text σ (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ))
     (fr-ext ρ σ (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) he (ih a ρ σ he))
fr-cong f T GT n ih (fccon k a b) ρ σ he =
  fr-con-le k (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (ih a ρ σ he) (ih b ρ σ he)
fr-cong f T GT n ih (fcsw s b0 b1) ρ σ he =
  fr-sel-le (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev (fr-tab f T) (fr-tab f GT) n c1 s1) ρ σ (dtev T GT n s ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f s) σ)
    b0 b1 (fr-bu f b0) (fr-bu f b1) (ih s ρ σ he) he (λ r1 s1 h → ih b0 r1 s1 h) (λ r1 s1 h → ih b1 r1 s1 h)
fr-cong f T GT n ih (fcclo i) ρ σ he = ((λ j → i) , he)
fr-cong f T GT n ih (fcapp g a) ρ σ he =
  fr-app-le T (fr-tab f T) (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev (fr-tab f T) (fr-tab f GT) n c1 s1)
    (dtev T GT n g ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f g) σ) (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ)
    (ih g ρ σ he) (ih a ρ σ he) (λ i r1 s1 h → ih (T i) r1 s1 h)
fr-cong f T GT n ih (fccall g a) ρ σ he =
  ih (GT g) (text tvnone (dtev T GT n a ρ)) (text tvnone (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ))
     (fr-ext tvnone tvnone (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) fr-none (ih a ρ σ he))
fr-cong f T GT n ih (fcby k) ρ σ he = λ j → tvb bzero
fr-cong f T GT n ih (fcld b o) ρ σ he =
  fr-ld-le (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (dtev T GT n o ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f o) σ) (ih b ρ σ he) (ih o ρ σ he)
fr-cong f T GT n ih (fcst b o v) ρ σ he =
  fr-st-le (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (dtev T GT n o ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f o) σ)
    (dtev T GT n v ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f v) σ) (ih b ρ σ he) (ih o ρ σ he) (ih v ρ σ he)
-- sound by congruence: the bottom-up rewrite of any form, with both tables rewritten, refines it at
-- every fuel (the rule at each node through its own soundness, at the rewritten tables)
fr-bu-ok : (r : FRule) (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) n (fr-bu (fst r) c) σ)
fr-bu-ok r T GT zero c ρ σ he = unit
fr-bu-ok r T GT (suc n) c ρ σ he =
  fr-trans (dtev T GT (suc n) c ρ) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) (suc n) (fr-kids (fst r) c) σ) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) (suc n) (fr-bu (fst r) c) σ)
    (fr-cong (fst r) T GT n (λ c1 r1 s1 h1 → fr-bu-ok r T GT n c1 r1 s1 h1) c ρ σ he)
    (snd r (fr-tab (fst r) T) (fr-tab (fst r) GT) (suc n) (fr-kids (fst r) c) σ σ (fr-erefl σ))
-- the data route's path: for a program read into the mirror with right tables (DGOK, DTok, decided
-- per program by dtok-auto), the rewritten conversion refines the source at every fuel, for every
-- good argument
fr-dc-path : (r : FRule) (G : Word → DC) (T GT : Word → FC) → DGOK G T GT → (n : Nat) (c : DC) (x : DV) → DTok T c → dgood T x
           → fr-le (derase (dsev G n c (dext dvnone x))) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) n (fr-bu (fst r) (dconv c)) (denv (dext dvnone x)))
fr-dc-path r G T GT go n c x tk gx =
  fr-lpath (derase (dsev G n c (dext dvnone x))) (dtev T GT n (dconv c) (denv (dext dvnone x))) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) n (fr-bu (fst r) (dconv c)) (denv (dext dvnone x)))
    (snd (dc-sound G T GT go n c (dext dvnone x) tk (dge-ext T dvnone x (λ k → unit) gx)))
    (fr-bu-ok r T GT n (dconv c) (denv (dext dvnone x)) (denv (dext dvnone x)) (fr-erefl (denv (dext dvnone x))))
-- the lifted bodies' keys: dc-base + i (above any definition the bridge reads from the store, below the
-- printers' closure tags, which add 1000000 to a key)
dc-base = #500000
-- dd the data type's index and nk its number of constructors (1: a record, its case one alternative)
fc-to-fo-k dd nk d t =
  case t of
    fcl w → flit w
    fcv n → fvar (fromNat n)
    fcp p a b → fprim (if %weq p #0 then P-add else P-sub) (lcons (fc-to-fo-k dd nk d a) (lcons (fc-to-fo-k dd nk d b) lnil))
    fclet a b → flet (fc-to-fo-k dd nk d a) (fc-to-fo-k dd nk (suc d) b)
    fccon k a b → fcon dd k (lcons (fc-to-fo-k dd nk d a) (lcons (fc-to-fo-k dd nk d b) lnil))
    fcsw s b0 b1 → fswitch (fc-to-fo-k dd nk d s) (lcons (#0 , (#2 , fc-to-fo-k dd nk (suc (suc d)) b0)) (if %weq nk #1 then lnil else lcons (#1 , (#2 , fc-to-fo-k dd nk (suc (suc d)) b1)) lnil))
    fcclo i → fclos (%wadd dc-base i) (fc-caps d)
    fcapp f a → fapply (fc-to-fo-k dd nk d f) (lcons (fc-to-fo-k dd nk d a) lnil)
    fccall g a → fcall g (lcons (fc-to-fo-k dd nk d a) lnil)
    -- the cells are words in the mirror and Int64 in the form (the same bits): a load read back as a
    -- word, a stored word made an Int64
    fcby n → fprim P-bytes (lcons (flit n) lnil)
    fcld b o → fprim P-wofi64 (lcons (fprim P-load64 (lcons (fc-to-fo-k dd nk d b) (lcons (fc-to-fo-k dd nk d o) lnil))) lnil)
    fcst b o v → fprim P-store64 (lcons (fc-to-fo-k dd nk d b) (lcons (fc-to-fo-k dd nk d o) (lcons (fprim P-i64ofw (lcons (fc-to-fo-k dd nk d v) lnil)) lnil)))
fc-to-fo d t = fc-to-fo-k #7 #2 d t
-- the lifted table, read off the source: each λ i b at depth d gives entry dc-base + i
dc-lifts-k dd nk d c =
  case c of
    dcl w → lnil
    dcv n → lnil
    dcp p a b → lst-app (dc-lifts-k dd nk d a) (dc-lifts-k dd nk d b)
    dclet a b → lst-app (dc-lifts-k dd nk d a) (dc-lifts-k dd nk (suc d) b)
    dccon k a b → lst-app (dc-lifts-k dd nk d a) (dc-lifts-k dd nk d b)
    dccase s b0 b1 → lst-app (dc-lifts-k dd nk d s) (lst-app (dc-lifts-k dd nk (suc (suc d)) b0) (dc-lifts-k dd nk (suc (suc d)) b1))
    dclam i b → lcons (%wadd dc-base i , (fromNat (suc d) , fc-to-fo-k dd nk (suc d) (fr-bu (fst std-frule) (dconv b)))) (dc-lifts-k dd nk (suc d) b)
    dcapp f a → lst-app (dc-lifts-k dd nk d f) (dc-lifts-k dd nk d a)
    dccall g a → dc-lifts-k dd nk d a
    dcby n → lnil
    dcld b o → lst-app (dc-lifts-k dd nk d b) (dc-lifts-k dd nk d o)
    dcst b o v → lst-app (dc-lifts-k dd nk d b) (lst-app (dc-lifts-k dd nk d o) (dc-lifts-k dd nk d v))
dc-lifts d c = dc-lifts-k #7 #2 d c
-- a program, a Lst of (key , (arity , body)) with main #0 of arity 0, as first-order definitions
dc-defs-k dd nk ds = case ds of lnil → lnil; lcons e r → lcons (fst e , (fst (snd e) , fc-to-fo-k dd nk (dnat (fst (snd e))) (fr-bu (fst std-frule) (dconv (snd (snd e)))))) (lst-app (dc-lifts-k dd nk (dnat (fst (snd e))) (snd (snd e))) (dc-defs-k dd nk r))
dc-defs ds = dc-defs-k #7 #2 ds
dx-prog = lcons (#0 , (#0 , dx-main)) (lcons (#1 , (#1 , dx-body1)) (lcons (#2 , (#1 , dx-body2)) lnil))
#same eval-fo (table-of (dc-defs dx-prog)) lnil (fc-to-fo zero (dconv dx-main)) = vw #15
#same eval-fo (table-of (dc-defs dx-prog)) (lcons (vw #10) lnil) (fc-to-fo (suc zero) (dconv dx-body1)) = vw #33
#same dtev dx-T dx-GT (dnat #30) (dconv dx-body1) (text tvnone (tvw #10)) = tvw #33
-- ---------------------------------------------------------------- the bridge from codes into DC
-- dc-of reads a Code into the data mirror (untyped, like wc-of): word literals and variables, the
-- word addition and subtraction (and Int64's, by their bits: the same words), successor, let,
-- constructors and cases of one data type whose constructors (one or two) each have two word fields,
-- λ (numbered from i, threaded: the result is the code with the next free number), application, a
-- global applied to one argument (a call: dccall at the global's index + 1, so #0 is left for main),
-- and the byte layer at 8 bytes: a fresh string, a load and a store at an offset that is a literal
-- multiple of 8 (a word or a Nat numeral), where the cell model dvb is exact; the conversions between
-- words and Int64 are the identity on bits. Anything else: none.
dc-ctors d = snd (params-fresh (dtel (%dent d)) lnil)
dc-two-words ks = case ks of lcons a r → (case r of lcons b r2 → (case r2 of lnil → andb (%weq (fst a) #0) (%weq (fst b) #0); _ → false); _ → false); _ → false
dc-shape-ok d = let nk = lst-len (dc-ctors d) in andb (andb (%wlt #0 nk) (%wlt nk #3)) (andb (dc-two-words (cshape d #0)) (if %weq nk #2 then dc-two-words (cshape d #1) else true))
dc-nk d = lst-len (dc-ctors d)
-- the data type a code names (the first constructor or case met, Nat's numerals aside); #0 none
dc-dt c =
  case c of
    ccon d k fs ds → (if %weq d nat-d then #0 else d)
    ccase d B x → d
    celim d P B x → d
    clam b → dc-dt b
    capp f a → dc-dt2 f a
    clet t b → dc-dt2 t b
    cann t T → dc-dt t
    cwop k a b → dc-dt2 a b
    cwsucc a → dc-dt a
    cprim k as → dc-dt-l as
    _ → #0
-- looking into the globals a code calls (their quoted values), to a depth
dc-globs c acc =
  case c of
    cglob g → (if lmem g acc then acc else lcons g acc)
    clam b → dc-globs b acc
    capp f a → dc-globs a (dc-globs f acc)
    clet t b → dc-globs b (dc-globs t acc)
    cann t T → dc-globs t acc
    cwop k a b → dc-globs b (dc-globs a acc)
    cwsucc a → dc-globs a acc
    _ → acc
dc-dt-deep fuel c = let x = dc-dt c in if %weq x #0 then (if %weq fuel #0 then #0 else dc-dt-gl fuel (dc-globs c lnil)) else x
dc-dt-gl fuel gs = case gs of lnil → #0; lcons g r → (let x = (case unfold g of some cd → dc-dt-deep (%wsub fuel #1) cd; none → #0) in if %weq x #0 then dc-dt-gl fuel r else x)
dc-dt2 a b = let x = dc-dt a in if %weq x #0 then dc-dt b else x
dc-dt-l l = case l of lnil → #0; lcons x r → (let y = dc-dt x in if %weq y #0 then dc-dt-l r else y)
-- a literal offset: a word or a Nat numeral
dc-natlit c = case c of cwlit w → some w; ccon d k fs ds → (if %weq d nat-d then (if %weq k #0 then some #0 else (case fs of lcons x r → omap (λ w → %wsucc w) (dc-natlit x); lnil → none)) else none); _ → none
dc-mul8 w = if %wlt w #8 then %weq w #0 else dc-mul8 (%wsub w #8)
dc-off c = case dc-natlit c of some w → (if dc-mul8 w then some w else none); none → none
-- results are some (DC , next λ number)
dc-then r f = case r of some x → f (fst x) (snd x); none → none
dcr dd c i =
  case c of
    cwlit w → some (dcl w , i)
    cvar n → some (dcv (toNat n) , i)
    cann t T → dcr dd t i
    cwop k a b → (if %weq k #2 then dcr2 dd (dcp #0) a b i else if %weq k #4 then dcr2 dd (dcp #1) a b i else none)
    cwsucc a → dc-then (dcr dd a i) (λ a2 j → some (dcp #0 a2 (dcl #1) , j))
    clet t b → dcr2 dd dclet t b i
    ccon d k fs ds → (if andb (%weq d dd) (dc-nolist ds) then (case fs of lcons a r → (case r of lcons b r2 → (case r2 of lnil → dcr2 dd (dccon k) a b i; _ → none); lnil → none); lnil → none) else none)
    ccase d B x → (if %weq d dd then dc-alts dd x B i else none)
    celim d P B x → (if %weq d dd then dc-alts dd x B i else none)
    clam b → dc-then (dcr dd b (%wsucc i)) (λ b2 j → some (dclam i b2 , j))
    capp f a → (case f of cglob g → dc-then (dcr dd a i) (λ a2 j → some (dccall (%wsucc g) a2 , j)); _ → dcr2 dd dcapp f a i)
    cprim k as → dc-prim dd k as i
    _ → none
dc-nolist l = case l of lnil → true; _ → false
dcr2 dd f a b i = dc-then (dcr dd a i) (λ a2 j → dc-then (dcr dd b j) (λ b2 j2 → some (f a2 b2 , j2)))
dc-strip2 t = case t of clam t1 → (case t1 of clam b → some b; _ → none); _ → none
dc-alts dd x B i = dc-then (dcr dd x i) (λ x2 j → dc-alts1 dd x2 B j)
dc-alts1 dd x2 B j = case B of lcons a0 r → (case dc-strip2 a0 of some b0 → dc-alts2 dd x2 b0 r j; none → none); lnil → none
dc-alts2 dd x2 b0 r j = case r of lnil → (if %weq (dc-nk dd) #1 then dc-then (dcr dd b0 j) (λ c0 j2 → some (dccase x2 c0 (dcl #0) , j2)) else none); lcons a1 r2 → (case dc-strip2 a1 of some b1 → dc-then (dcr dd b0 j) (λ c0 j2 → dc-then (dcr dd b1 j2) (λ c1 j3 → some (dccase x2 c0 c1 , j3))); none → none)
dc-arg as n = lnth as n
dc-prim dd k as i =
  if %weq k #1536 then (case dc-arg as #0 of some n → omap (λ w → (dcby w , i)) (dc-natlit n); none → none)
  else if %weq k #776 then (case dc-arg as #0 of some b → (case dc-arg as #1 of some o → (case dc-off o of some w → dc-then (dcr dd b i) (λ b2 j → some (dcld b2 (dcl w) , j)); none → none); none → none); none → none)
  else if %weq k #1032 then (case dc-arg as #0 of some b → (case dc-arg as #1 of some o → (case dc-arg as #2 of some v → (case dc-off o of some w → dc-then (dcr dd b i) (λ b2 j → dc-then (dcr dd v j) (λ v2 j2 → some (dcst b2 (dcl w) v2 , j2))); none → none); none → none); none → none); none → none)
  else if orb (%weq k #272) (%weq k #273) then (case as of lcons a r → dcr dd a i; lnil → none)
  else if %weq k #512 then dc-prim2 dd #0 as i
  else if %weq k #513 then dc-prim2 dd #1 as i
  else none
dc-prim2 dd p as i = case as of lcons a r → (case r of lcons b r2 → dcr2 dd (dcp p) a b i; lnil → none); lnil → none
-- the globals a DC calls (their keys), and its λs (index , body)
dc-calls c acc =
  case c of
    dcp p a b → dc-calls b (dc-calls a acc)
    dclet a b → dc-calls b (dc-calls a acc)
    dccon k a b → dc-calls b (dc-calls a acc)
    dccase s b0 b1 → dc-calls b1 (dc-calls b0 (dc-calls s acc))
    dclam i b → dc-calls b acc
    dcapp f a → dc-calls a (dc-calls f acc)
    dccall g a → dc-calls a (if lmem g acc then acc else lcons g acc)
    dcld b o → dc-calls o (dc-calls b acc)
    dcst b o v → dc-calls v (dc-calls o (dc-calls b acc))
    _ → acc
dc-lams c acc =
  case c of
    dcp p a b → dc-lams b (dc-lams a acc)
    dclet a b → dc-lams b (dc-lams a acc)
    dccon k a b → dc-lams b (dc-lams a acc)
    dccase s b0 b1 → dc-lams b1 (dc-lams b0 (dc-lams s acc))
    dclam i b → dc-lams b (lcons (i , b) acc)
    dcapp f a → dc-lams a (dc-lams f acc)
    dccall g a → dc-lams a acc
    dcld b o → dc-lams o (dc-lams b acc)
    dcst b o v → dc-lams v (dc-lams o (dc-lams b acc))
    _ → acc
-- the definitions called, transitively: each global's value quoted (lib/specialize.cub's unfold),
-- one λ, its body read; (key , body) pairs, the λ numbers threaded; none if one is outside
dc-globals dd fuel todo seen i =
  if %weq fuel #0 then none else (case todo of lnil → some (lnil , i); lcons g rest → (if lmem g seen then dc-globals dd fuel rest seen i else dc-glob1 dd fuel g rest seen i (unfold (%wsub g #1))))
dc-glob1 dd fuel g rest seen i u = case u of some cd → (case cd of clam b → dc-glob2 dd fuel g rest seen (dcr dd b i); _ → none); none → none
dc-glob2 dd fuel g rest seen r = dc-then r (λ b2 j → dc-then (dc-globals dd (%wsub fuel #1) (lst-app rest (dc-calls b2 lnil)) (lcons g seen) j) (λ gs j2 → some (lcons (g , b2) gs , j2)))
dc-look l k dflt = case l of lnil → dflt; lcons e r → if %weq (fst e) k then snd e else dc-look r k dflt
-- a code read as a mirrored program: main (k leading λs, its body) and the globals it calls
dc-prog c =
  let k = lams-of c
      body = under-lams c
      dd = dc-dt-deep #8 body
      ok = if %weq dd #0 then true else dc-shape-ok dd
  in if ok
       then dc-then (dcr dd body #0) (λ m j → dc-then (dc-globals dd #64 (dc-calls m lnil) lnil j) (λ gs j2 → some (dd , (k , (m , gs)))))
       else none
dc-of c = case dcr (dc-dt c) c #0 of some r → some (fst r); none → none
-- the tables the theorem quantifies over, from the reading: T i the conversion of λ i's body, G the
-- globals' bodies, GT their conversions (DGOK's first half by definition)
dc-allams m gs = case gs of lnil → dc-lams m lnil; lcons e r → dc-lams (snd e) (dc-allams m r)
dc-T m gs i = dconv (dc-look (dc-allams m gs) i (dcl #0))
dc-G gs g = dc-look gs g (dcl #0)
dc-GT gs g = dconv (dc-G gs g)
-- DTok for main and every global, decided by dtok-chk: dtok-auto turns true into the proof, so the
-- tables are right and dc-sound applies (at every fuel, in every good environment)
dc-ok-all T m gs = case gs of lnil → dtok-chk T m; lcons e r → andb (dtok-chk T (snd e)) (dc-ok-all T m r)
-- the program in the first-order form: main #0 of arity k, each global at its key of arity 1
dc-prog-defs p =
  let dd = fst p
      k = fst (snd p)
      m = fst (snd (snd p))
      gs = snd (snd (snd p))
  in dc-defs-k dd (if %weq dd #0 then #2 else dc-nk dd) (lcons (#0 , (k , m)) (dc-gdefs gs))
dc-gdefs gs = case gs of lnil → lnil; lcons e r → lcons (fst e , (#1 , snd e)) (dc-gdefs r)
dc-prog-ok p = dc-ok-all (dc-T (fst (snd (snd p))) (snd (snd (snd p)))) (fst (snd (snd p))) (snd (snd (snd p)))
-- main moved to key m (a harness puts its own main at #0)
dc-rekey m ds = case ds of lnil → lnil; lcons e r → lcons ((if %weq (fst e) #0 then m else fst e) , snd e) (dc-rekey m r)
-- ---------------------------------------------------------------- the specializer, both routes
-- specialize-proved T rules c: the word route first ((#1 , f), spec-path), then the data route — the
-- normal form read by dc-prog, its tables decided (dtok-chk, so dc-sound holds of it through
-- dtok-auto), closure-converted by dconv and taken to first-order definitions: (#2 , defs), main #0
-- of the code's arity; otherwise the untyped pipeline (#0 , f)
specialize-proved T rules c =
  let n = normalize T c
  in (case wc-of (under-lams n) of
        some w → (#1 , wrap-flams (lams-of n) (fw-to-fo (spec-w std-vrule w)))
        none → (case dc-prog n of
                  some p → (if dc-prog-ok p then (#2 , dc-prog-defs p) else (#0 , specialize T rules c))
                  none → (#0 , specialize T rules c)))
data PQ = pqa (x : Word) (y : Word) | pqb (x : Word) (y : Word)
pq-sum : PQ → Word
pq-sum p = case p of
  pqa a b → %wadd a b
  pqb a b → %wsub a b
pq-app : PQ → Word
pq-app p = (case p return (λ q → Word → Word) of
  pqa a b → (λ y → %wadd y a)
  pqb a b → (λ y → %wsub y b)) #5
pq-mk : Word → PQ
pq-mk x = pqb (%wadd x #10) x
-- readings. A data type of two constructors with two word fields; a case adding or subtracting the
-- fields; a case choosing a closure, applied (the λs survive normalization); a constructor built
pq-d = didx (code PQ)
pq-run p args = eval-fo (table-of (snd p)) lnil (fcall #0 args)
pq-con k a b = fcon pq-d k (lcons (flit a) (lcons (flit b) lnil))
sp-d1 = code (λ (p : PQ) → pq-sum p)
#same fst (specialize-proved (PQ → Word) lnil sp-d1) = #2
#same pq-run (specialize-proved (PQ → Word) lnil sp-d1) (lcons (pq-con #0 #3 #4) lnil) = vw #7
#same pq-run (specialize-proved (PQ → Word) lnil sp-d1) (lcons (pq-con #1 #9 #4) lnil) = eval-fo no-defs lnil (fapply (specialize (PQ → Word) lnil sp-d1) (lcons (pq-con #1 #9 #4) lnil))
sp-d2 = code (λ (p : PQ) → pq-app p)
#same fst (specialize-proved (PQ → Word) lnil sp-d2) = #2
#same pq-run (specialize-proved (PQ → Word) lnil sp-d2) (lcons (pq-con #1 #9 #2) lnil) = vw #3
#same pq-run (specialize-proved (PQ → Word) lnil sp-d2) (lcons (pq-con #0 #9 #2) lnil) = vw #14
sp-d3 = code (λ (x : Word) → pq-mk x)
#same fst (specialize-proved (Word → PQ) lnil sp-d3) = #2
#same pq-run (specialize-proved (Word → PQ) lnil sp-d3) (lcons (flit #4) lnil) = eval-fo no-defs lnil (fapply (specialize (Word → PQ) lnil sp-d3) (lcons (flit #4) lnil))
-- the reading of sp-d2's normal form, written out: the closure λ#0 y. y + a in the first alternative,
-- λ#1 y. y − b in the second; the checked path below is about this DC
pq-dc : DC
pq-dc = dcapp (dccase (dcv 0) (dclam #0 (dcp #0 (dcv 0) (dcv 2))) (dclam #1 (dcp #1 (dcv 0) (dcv 1)))) (dcl #5)
#same dc-of (under-lams (normalize (PQ → Word) sp-d2)) = some pq-dc
pq-T : Word → FC
pq-T i = %welimP (λ v → FC) i (fcp #0 (fcv 0) (fcv 2)) (λ m h → fcp #1 (fcv 0) (fcv 1))
pq-G : Word → DC
pq-G g = dcl #0
pq-GT : Word → FC
pq-GT g = fcl #0
pq-gok : DGOK pq-G pq-T pq-GT
pq-gok g = ((λ i → fcl #0) , unit)
-- the justifying path: for every argument value and fuel, the converted program means the source
pq-path : (n : Nat) (x : DV) → dgood pq-T x → derase (dsev pq-G n pq-dc (dext dvnone x)) ≡ dtev pq-T pq-GT n (dconv pq-dc) (denv (dext dvnone x))
pq-path n x gx = snd (dc-sound pq-G pq-T pq-GT pq-gok n pq-dc (dext dvnone x) (dtok-auto pq-T pq-dc (λ i → true)) (dge-ext pq-T dvnone x (λ k → unit) gx))
#same dsev pq-G (dnat #10) pq-dc (dext dvnone (dvc #1 #9 #2)) = dvw #3
-- and with the verified rewrites: the rewritten conversion (both tables rewritten, as dc-defs prints
-- them) refines the source at every fuel, for every good argument (fr-dc-path at std-frule)
pq-rpath : (n : Nat) (x : DV) → dgood pq-T x
         → fr-le (derase (dsev pq-G n pq-dc (dext dvnone x))) (dtev (fr-tab (fst std-frule) pq-T) (fr-tab (fst std-frule) pq-GT) n (fr-bu (fst std-frule) (dconv pq-dc)) (denv (dext dvnone x)))
pq-rpath n x gx = fr-dc-path std-frule pq-G pq-T pq-GT pq-gok n pq-dc x (dtok-auto pq-T pq-dc (λ i → true)) gx
-- calls, read from a code as written (not normalized): main calls pq-sum on pq-mk x; the globals'
-- values are quoted and read, the tables decided; at 4: pqb 14 4, 14 − 4
dc-c4 = code (λ (x : Word) → pq-sum (pq-mk x))
#same dc-prog-ok (fromopt (dc-prog dc-c4) (#0 , (#0 , (dcl #0 , lnil)))) = true
#same eval-fo (table-of (dc-prog-defs (fromopt (dc-prog dc-c4) (#0 , (#0 , (dcl #0 , lnil)))))) lnil (fcall #0 (lcons (flit #4) lnil)) = vw #10
#same lst-len (snd (snd (snd (fromopt (dc-prog dc-c4) (#0 , (#0 , (dcl #0 , lnil))))))) = #2
-- the byte layer: two stores into a fresh 16-byte string and the sum of the two loads (lib/region.cub's
-- two, as its normal form has it); at 20: 20 + 21
by-f : Word → Word
by-f w = i64toWord (i64add (load64 16 (store64 16 (store64 16 (bytes 16) 0 (8 , λ i → 16) (i64 w)) 8 (0 , λ i → 16) (i64 (%wsucc w))) 0 (8 , λ i → 16))
                           (load64 16 (store64 16 (store64 16 (bytes 16) 0 (8 , λ i → 16) (i64 w)) 8 (0 , λ i → 16) (i64 (%wsucc w))) 8 (0 , λ i → 16)))
sp-b1 = code (λ (w : Word) → by-f w)
#same fst (specialize-proved (Word → Word) lnil sp-b1) = #2
#same pq-run (specialize-proved (Word → Word) lnil sp-b1) (lcons (flit #20) lnil) = vw #41
#same dsev pq-G (dnat #20) (fromopt (dc-of (under-lams (normalize (Word → Word) sp-b1))) (dcl #0)) (dext dvnone (dvw #20)) = dvw #41
-- a load at an offset not a multiple of 8 is outside the model: the untyped route
by-g : Word → Word
by-g w = i64toWord (load64 16 (store64 16 (bytes 16) 0 (8 , λ i → 16) (i64 w)) 4 (4 , λ i → 16))
#same fst (specialize-proved (Word → Word) lnil (code (λ (w : Word) → by-g w))) = #0
-- the word route is unchanged, and a case on Bool (lowered to an if, outside DC) stays untyped
#same fst (specialize-proved (Word → Word) lnil sp-f1) = #1
#same fst (specialize-proved (Bool → Word) lnil sp-f4) = #0
-- the verified rewrites on the converted mirror: x + 0, a fold, and a load forwarded through two stores
#same fr-bu (fst std-frule) (fcp #0 (fcv 0) (fcl #0)) = fcv 0
#same fr-bu (fst std-frule) (fcp #0 (fcl #0) (fcp #1 (fcl #9) (fcl #4))) = fcl #5
#same fr-bu (fst std-frule) (fcld (fcst (fcst (fcby #16) (fcl #0) (fcv 0)) (fcl #8) (fcv 1)) (fcl #0)) = fcv 0
#same fr-bu (fst std-frule) (fcld (fcst (fcst (fcby #16) (fcl #0) (fcv 0)) (fcl #8) (fcv 1)) (fcl #8)) = fcv 1
#same fr-bu (fst std-frule) (fcld (fcst (fcby #16) (fcl #0) (fcv 0)) (fcl #8)) = fcld (fcby #16) (fcl #8)
#same fr-bu (fst std-frule) (fcapp (fcclo #3) (fcp #0 (fcl #0) (fcv 2))) = fcapp (fcclo #3) (fcv 2)
-- a data program whose normal form adds 0 under a case: the rewrite removes it in main
pq-z : PQ → Word
pq-z p = case p of
  pqa a b → %wadd a #0
  pqb a b → %wadd #0 b
pq-id : PQ → Word
pq-id p = case p of
  pqa a b → a
  pqb a b → b
dc-dflt = (#0 , (#0 , (dcl #0 , lnil)))
#same fst (specialize-proved (PQ → Word) lnil (code (λ (p : PQ) → pq-z p))) = #2
#same dc-prog-defs (fromopt (dc-prog (normalize (PQ → Word) (code (λ (p : PQ) → pq-z p)))) dc-dflt) = dc-prog-defs (fromopt (dc-prog (normalize (PQ → Word) (code (λ (p : PQ) → pq-id p)))) dc-dflt)
-- the byte program's two loads forwarded through the stores: what is left is w + (w + 1), the
-- program without the region
#same fr-bu (fst std-frule) (dconv (fromopt (dc-of (under-lams (normalize (Word → Word) sp-b1))) (dcl #0))) = fcp #0 (fcv zero) (fcp #0 (fcv zero) (fcl #1))
