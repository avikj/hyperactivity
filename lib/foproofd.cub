-- lib/foproofd.cub — the justifying path past the word fragment (plan 18.5 step 7, B15): DC, the
-- first-order fragment of codes as checked data (words and every primitive lib/lower.cub lowers, by
-- their bits; Bool as the words 1 and 0 with if; pairs, unit and projections; constructors of any data
-- type with any number of fields and a case of any number of alternatives; λ, application, calls of
-- any arity through a tuple; the byte layer at widths 4 and 8 and any offset, its length), with
-- checked closure conversion dconv and dc-sound at every fuel; the table decided for concrete
-- programs (fc-eq-sound, dtok-auto); verified rewrites over the converted form (FRule, sound as
-- refinement, applied bottom up through both tables, fr-dc-path); dc-prog reads a Code into DC
-- (structural recursion on a data type and word recursion lifted to definitions of their own, called
-- through the table), and specialize-proved takes the word route (lib/foproof.cub's spec-path),
-- else the data route, else the untyped specializer, saying which. Loaded after lib/foproof.cub;
-- tested on its own line (tests/foproofd.cub).
-- ---------------------------------------------------------------- the fragment as checked data
-- Evaluation is by fuel: n steps of depth, every node one, a value dvbot when they run out, so
-- recursion through calls is total; the theorem holds at every fuel. A λ carries its table index (the
-- bridge numbers them). A constructor holds its fields as one value, a tuple (pairs ending in unit: the
-- first field outermost); a case's alternatives are a chain (dcalt k n b r: tag k, its n fields
-- pushed for b, the first deepest; otherwise r; dcnone ends it). A call passes one value: the
-- argument itself for a definition of one parameter, a tuple of them for more (m, the number of
-- parameters, is for the printer). d (a constructor's data type) likewise. The byte layer's width w
-- is 4 or 8.
data DC = dcl (w : Word) | dcv (n : Nat) | dcp (p : Word) (a : DC) (b : DC) | dcp1 (p : Word) (a : DC) | dclet (a : DC) (b : DC) | dcu | dcpr (a : DC) (b : DC) | dcfst (a : DC) | dcsnd (a : DC) | dccon (d : Word) (k : Word) (a : DC) | dccase (s : DC) (alts : DC) | dcalt (k : Word) (n : Nat) (b : DC) (r : DC) | dcnone | dcif (c : DC) (t : DC) (e : DC) | dclam (i : Word) (b : DC) | dcapp (f : DC) (a : DC) | dccall (g : Word) (m : Word) (a : DC) | dcby (a : DC) | dcld (w : Word) (b : DC) (o : DC) | dcst (w : Word) (b : DC) (o : DC) (v : DC) | dcblen (b : DC)
-- ---------------------------------------------------------------- the primitives, by their bits
-- the word operations and lib/fo.cub's numbering (P-add 0, P-sub 1, P-mul 2, P-eq 3, P-lt 4; Int64's
-- 14–18 and Float64's 19–24 on the words of their bits: each the machine's own operation between
-- the conversions, so its evaluator clause is the primitive itself); comparisons answer 1 or 0
dbw : Bool → Word
dbw true = #1
dbw false = #0
dmulw : Word → Word → Word
dmulw a b = %welimP (λ v → Word) b #0 (λ n h → wadd h a)
dbi : Word → Int64
dbi a = i64 a
dib : Int64 → Word
dib x = i64toWord x
dbf : Word → Float64
dbf a = f64ofbits (i64 a)
dfb : Float64 → Word
dfb x = i64toWord (f64bits x)
dprim2 : Word → Word → Word → Word
dprim2 p a b =
  if %weq p #0 then wadd a b else if %weq p #1 then wsub a b else if %weq p #2 then dmulw a b
  else if %weq p #3 then dbw (weq a b) else if %weq p #4 then dbw (wlt a b)
  else if %weq p #14 then dib (i64add (dbi a) (dbi b)) else if %weq p #15 then dib (i64sub (dbi a) (dbi b))
  else if %weq p #16 then dib (i64mul (dbi a) (dbi b)) else if %weq p #17 then dbw (i64eq (dbi a) (dbi b))
  else if %weq p #18 then dbw (i64lt (dbi a) (dbi b))
  else if %weq p #19 then dfb (f64add (dbf a) (dbf b)) else if %weq p #20 then dfb (f64sub (dbf a) (dbf b))
  else if %weq p #21 then dfb (f64mul (dbf a) (dbf b)) else if %weq p #22 then dfb (f64div (dbf a) (dbf b))
  else if %weq p #23 then dbw (f64eq (dbf a) (dbf b)) else if %weq p #24 then dbw (f64lt (dbf a) (dbf b))
  else #0
-- the conversions that change bits (P-f64ofi64 27, P-i64off64 28, P-f64ofw 29) and an unsigned
-- 32-bit truncation (40, the mirror's own: a 4-byte store keeps the low 32 bits); every other
-- conversion lower makes is the identity on bits and is not a node
dprim1 : Word → Word → Word
dprim1 p a =
  if %weq p #27 then dfb (f64ofi64 (dbi a)) else if %weq p #28 then dib (i64off64 (dbf a))
  else if %weq p #29 then dfb (f64 a) else if %weq p #40 then u32toWord (u32 a) else a
-- ---------------------------------------------------------------- the byte layer
-- a byte string as its stores over a base (its length and its bytes by offset: a fresh string's are
-- zero, a parameter's whatever they are). A load at the width and offset of the latest store is that
-- store's (truncated) value; one disjoint from it reads the string below; one overlapping it in part
-- reads byte by byte, little-endian, as the machine does (lib/prim.cub's load64-store64 and
-- load64-store64-disj are the first two, as laws)
data BL = blm (n : Word) (m : Word → Word) | bls (w : Word) (o : Word) (v : Word) (r : BL)
dpow2 : Word → Word
dpow2 b = %welimP (λ v → Word) b #1 (λ n h → wadd h h)
dshl : Word → Word → Word
dshl x s = %welimP (λ v → Word) s x (λ n h → wadd h h)
dmul8 : Word → Word
dmul8 x = dshl x #3
dandb : Bool → Bool → Bool
dandb true b = b
dandb false b = false
dorb : Bool → Bool → Bool
dorb true b = true
dorb false b = b
dnotb : Bool → Bool
dnotb true = false
dnotb false = true
bsel : Bool → Word → Word → Word
bsel true a b = a
bsel false a b = b
dbsel2 : Bool → P2W → P2W → P2W
dbsel2 true a b = a
dbsel2 false a b = b
-- the bits of v from lo (inclusive) to hi (exclusive), shifted down to bit 0: v's bits scanned from
-- the top (bit 63) down, the remainder and the result carried
dbits-step : Word → Word → Word → P2W → P2W
dbits-step lo hi b q =
  dbsel2 (wlt (p2a q) (dpow2 b)) q
    (p2w (wsub (p2a q) (dpow2 b)) (bsel (dandb (wlt b hi) (dnotb (wlt b lo))) (wadd (p2b q) (dpow2 (wsub b lo))) (p2b q)))
dbits : Word → Word → Word → Word
dbits lo hi v = p2b (%welimP (λ u → P2W) #64 (p2w v #0) (λ k q → dbits-step lo hi (wsub #63 k) q))
dbyte : Word → Word → Word
dbyte v j = dbits (dmul8 j) (wadd (dmul8 j) #8) v
-- the byte at offset x
bl-byte : Word → BL → Word
bl-byte x (blm n m) = m x
bl-byte x (bls w o v r) = bsel (dandb (dnotb (wlt x o)) (wlt x (wadd o w))) (dbyte v (wsub x o)) (bl-byte x r)
-- w bytes from offset o, little-endian
bl-bytes : Word → Word → BL → Word
bl-bytes w o l = %welimP (λ u → Word) w #0 (λ k acc → wadd acc (dshl (bl-byte (wadd o k) l) (dmul8 k)))
bl-disj : Word → Word → Word → Word → Bool
bl-disj w o w2 o2 = dorb (dnotb (wlt o2 (wadd o w))) (dnotb (wlt o (wadd o2 w2)))
bl-ld : Word → Word → BL → Word
bl-ld w2 o2 (blm n m) = bl-bytes w2 o2 (blm n m)
bl-ld w2 o2 (bls w o v r) = bsel (dandb (weq w2 w) (weq o2 o)) v (bsel (bl-disj w o w2 o2) (bl-ld w2 o2 r) (bl-bytes w2 o2 (bls w o v r)))
dtrunc : Word → Word → Word
dtrunc w v = bsel (weq w #8) v (dprim1 #40 v)
bl-st : Word → Word → Word → BL → BL
bl-st w o v l = bls w o (dtrunc w v) l
bl-len : BL → Word
bl-len (blm n m) = n
bl-len (bls w o v r) = bl-len r
bzero : Word → Word
bzero x = #0
-- ---------------------------------------------------------------- the source's values and meaning
data DV = dvw (w : Word) | dvc (k : Word) (x : DV) | dvclo (i : Word) (b : DC) (env : Nat → DV) | dvbot | dvb (l : BL) | dvu | dvpr (a : DV) (b : DV)
dext : (Nat → DV) → DV → Nat → DV
dext ρ a n = case n of zero → a; suc k → ρ k
dvnone : Nat → DV
dvnone n = dvbot
dv-prim : Word → DV → DV → DV
dv-prim p (dvw a) (dvw b) = dvw (dprim2 p a b)
dv-prim p _ _ = dvbot
dv-prim1 : Word → DV → DV
dv-prim1 p (dvw a) = dvw (dprim1 p a)
dv-prim1 p _ = dvbot
dv-fst : DV → DV
dv-fst (dvpr a b) = a
dv-fst _ = dvbot
dv-snd : DV → DV
dv-snd (dvpr a b) = b
dv-snd _ = dvbot
-- a constructor's n fields pushed, the first deepest (a field missing: dvbot)
dv-push : Nat → DV → (Nat → DV) → Nat → DV
dv-push zero x ρ = ρ
dv-push (suc m) (dvpr a r) ρ = dv-push m r (dext ρ a)
dv-push (suc m) _ ρ = dv-push m dvbot (dext ρ dvbot)
dv-pick : Bool → DV → DV → DV
dv-pick true a b = a
dv-pick false a b = b
-- a constructor's fields form a whole tuple of n: pairs ending in unit, n of them (anything else, a
-- field missing or one too many, is no value: the first-order form pushes every field it has, so a
-- count that disagreed would read other slots there)
dv-tup : Nat → DV → Bool
dv-tup zero dvu = true
dv-tup zero _ = false
dv-tup (suc m) (dvpr a r) = dv-tup m r
dv-tup (suc m) _ = false
-- a case: the first alternative whose tag is the constructor's, its fields a whole tuple of its count
dv-alt : (DC → (Nat → DV) → DV) → (Nat → DV) → DV → Word → Nat → DC → DV → DV
dv-alt ev ρ (dvc k x) j n b rest = dv-pick (weq k j) (dv-pick (dv-tup n x) (ev b (dv-push n x ρ)) dvbot) rest
dv-alt ev ρ v j n b rest = dvbot
dv-cases : (DC → (Nat → DV) → DV) → (Nat → DV) → DV → DC → DV
dv-cases ev ρ v (dcalt j n b r) = dv-alt ev ρ v j n b (dv-cases ev ρ v r)
dv-cases ev ρ v alts = dvbot
-- a word condition: nonzero is true
dv-if : (DC → (Nat → DV) → DV) → (Nat → DV) → DV → DC → DC → DV
dv-if ev ρ (dvw w) t e = %welimP (λ u → DV) w (ev e ρ) (λ m h → ev t ρ)
dv-if ev ρ _ t e = dvbot
dv-app : (DC → (Nat → DV) → DV) → DV → DV → DV
dv-app ev (dvclo i b ρ) x = ev b (dext ρ x)
dv-app ev _ x = dvbot
dv-bytes : DV → DV
dv-bytes (dvw n) = dvb (blm n bzero)
dv-bytes _ = dvbot
dv-ld : Word → DV → DV → DV
dv-ld w (dvb l) (dvw o) = dvw (bl-ld w o l)
dv-ld w _ _ = dvbot
dv-st : Word → DV → DV → DV → DV
dv-st w (dvb l) (dvw o) (dvw v) = dvb (bl-st w o v l)
dv-st w _ _ _ = dvbot
dv-blen : DV → DV
dv-blen (dvb l) = dvw (bl-len l)
dv-blen _ = dvbot
-- the source's meaning, at fuel n, the definitions G
dsev : (Word → DC) → Nat → DC → (Nat → DV) → DV
dsev G zero c ρ = dvbot
dsev G (suc n) (dcl w) ρ = dvw w
dsev G (suc n) (dcv k) ρ = ρ k
dsev G (suc n) (dcp p a b) ρ = dv-prim p (dsev G n a ρ) (dsev G n b ρ)
dsev G (suc n) (dcp1 p a) ρ = dv-prim1 p (dsev G n a ρ)
dsev G (suc n) (dclet a b) ρ = dsev G n b (dext ρ (dsev G n a ρ))
dsev G (suc n) dcu ρ = dvu
dsev G (suc n) (dcpr a b) ρ = dvpr (dsev G n a ρ) (dsev G n b ρ)
dsev G (suc n) (dcfst a) ρ = dv-fst (dsev G n a ρ)
dsev G (suc n) (dcsnd a) ρ = dv-snd (dsev G n a ρ)
dsev G (suc n) (dccon d k a) ρ = dvc k (dsev G n a ρ)
dsev G (suc n) (dccase s alts) ρ = dv-cases (λ c σ → dsev G n c σ) ρ (dsev G n s ρ) alts
dsev G (suc n) (dcalt k m b r) ρ = dvbot
dsev G (suc n) dcnone ρ = dvbot
dsev G (suc n) (dcif c t e) ρ = dv-if (λ c1 σ → dsev G n c1 σ) ρ (dsev G n c ρ) t e
dsev G (suc n) (dclam i b) ρ = dvclo i b ρ
dsev G (suc n) (dcapp f a) ρ = dv-app (λ c σ → dsev G n c σ) (dsev G n f ρ) (dsev G n a ρ)
dsev G (suc n) (dccall g m a) ρ = dsev G n (G g) (dext dvnone (dsev G n a ρ))
dsev G (suc n) (dcby a) ρ = dv-bytes (dsev G n a ρ)
dsev G (suc n) (dcld w b o) ρ = dv-ld w (dsev G n b ρ) (dsev G n o ρ)
dsev G (suc n) (dcst w b o v) ρ = dv-st w (dsev G n b ρ) (dsev G n o ρ) (dsev G n v ρ)
dsev G (suc n) (dcblen b) ρ = dv-blen (dsev G n b ρ)
-- ---------------------------------------------------------------- the target and its meaning
-- the target: closures by table index over their captured environment
data FC = fcl (w : Word) | fcv (n : Nat) | fcp (p : Word) (a : FC) (b : FC) | fcp1 (p : Word) (a : FC) | fclet (a : FC) (b : FC) | fcu | fcpr (a : FC) (b : FC) | fcfst (a : FC) | fcsnd (a : FC) | fccon (d : Word) (k : Word) (a : FC) | fccase (s : FC) (alts : FC) | fcalt (k : Word) (n : Nat) (b : FC) (r : FC) | fcnone | fcif (c : FC) (t : FC) (e : FC) | fcclo (i : Word) | fcapp (f : FC) (a : FC) | fccall (g : Word) (m : Word) (a : FC) | fcby (a : FC) | fcld (w : Word) (b : FC) (o : FC) | fcst (w : Word) (b : FC) (o : FC) (v : FC) | fcblen (b : FC)
data TV = tvw (w : Word) | tvc (k : Word) (x : TV) | tvclo (i : Word) (env : Nat → TV) | tvbot | tvb (l : BL) | tvu | tvpr (a : TV) (b : TV)
text : (Nat → TV) → TV → Nat → TV
text ρ a n = case n of zero → a; suc k → ρ k
tvnone : Nat → TV
tvnone n = tvbot
tv-prim : Word → TV → TV → TV
tv-prim p (tvw a) (tvw b) = tvw (dprim2 p a b)
tv-prim p _ _ = tvbot
tv-prim1 : Word → TV → TV
tv-prim1 p (tvw a) = tvw (dprim1 p a)
tv-prim1 p _ = tvbot
tv-fst : TV → TV
tv-fst (tvpr a b) = a
tv-fst _ = tvbot
tv-snd : TV → TV
tv-snd (tvpr a b) = b
tv-snd _ = tvbot
tv-push : Nat → TV → (Nat → TV) → Nat → TV
tv-push zero x ρ = ρ
tv-push (suc m) (tvpr a r) ρ = tv-push m r (text ρ a)
tv-push (suc m) _ ρ = tv-push m tvbot (text ρ tvbot)
tv-pick : Bool → TV → TV → TV
tv-pick true a b = a
tv-pick false a b = b
tv-tup : Nat → TV → Bool
tv-tup zero tvu = true
tv-tup zero _ = false
tv-tup (suc m) (tvpr a r) = tv-tup m r
tv-tup (suc m) _ = false
tv-alt : (FC → (Nat → TV) → TV) → (Nat → TV) → TV → Word → Nat → FC → TV → TV
tv-alt ev ρ (tvc k x) j n b rest = tv-pick (weq k j) (tv-pick (tv-tup n x) (ev b (tv-push n x ρ)) tvbot) rest
tv-alt ev ρ v j n b rest = tvbot
tv-cases : (FC → (Nat → TV) → TV) → (Nat → TV) → TV → FC → TV
tv-cases ev ρ v (fcalt j n b r) = tv-alt ev ρ v j n b (tv-cases ev ρ v r)
tv-cases ev ρ v alts = tvbot
tv-if : (FC → (Nat → TV) → TV) → (Nat → TV) → TV → FC → FC → TV
tv-if ev ρ (tvw w) t e = %welimP (λ u → TV) w (ev e ρ) (λ m h → ev t ρ)
tv-if ev ρ _ t e = tvbot
tv-app : (Word → FC) → (FC → (Nat → TV) → TV) → TV → TV → TV
tv-app T ev (tvclo i ρ) x = ev (T i) (text ρ x)
tv-app T ev _ x = tvbot
tv-bytes : TV → TV
tv-bytes (tvw n) = tvb (blm n bzero)
tv-bytes _ = tvbot
tv-ld : Word → TV → TV → TV
tv-ld w (tvb l) (tvw o) = tvw (bl-ld w o l)
tv-ld w _ _ = tvbot
tv-st : Word → TV → TV → TV → TV
tv-st w (tvb l) (tvw o) (tvw v) = tvb (bl-st w o v l)
tv-st w _ _ _ = tvbot
tv-blen : TV → TV
tv-blen (tvb l) = tvw (bl-len l)
tv-blen _ = tvbot
-- the target's meaning: T the closures' table, GT the definitions'
dtev : (Word → FC) → (Word → FC) → Nat → FC → (Nat → TV) → TV
dtev T GT zero c ρ = tvbot
dtev T GT (suc n) (fcl w) ρ = tvw w
dtev T GT (suc n) (fcv k) ρ = ρ k
dtev T GT (suc n) (fcp p a b) ρ = tv-prim p (dtev T GT n a ρ) (dtev T GT n b ρ)
dtev T GT (suc n) (fcp1 p a) ρ = tv-prim1 p (dtev T GT n a ρ)
dtev T GT (suc n) (fclet a b) ρ = dtev T GT n b (text ρ (dtev T GT n a ρ))
dtev T GT (suc n) fcu ρ = tvu
dtev T GT (suc n) (fcpr a b) ρ = tvpr (dtev T GT n a ρ) (dtev T GT n b ρ)
dtev T GT (suc n) (fcfst a) ρ = tv-fst (dtev T GT n a ρ)
dtev T GT (suc n) (fcsnd a) ρ = tv-snd (dtev T GT n a ρ)
dtev T GT (suc n) (fccon d k a) ρ = tvc k (dtev T GT n a ρ)
dtev T GT (suc n) (fccase s alts) ρ = tv-cases (λ c σ → dtev T GT n c σ) ρ (dtev T GT n s ρ) alts
dtev T GT (suc n) (fcalt k m b r) ρ = tvbot
dtev T GT (suc n) fcnone ρ = tvbot
dtev T GT (suc n) (fcif c t e) ρ = tv-if (λ c1 σ → dtev T GT n c1 σ) ρ (dtev T GT n c ρ) t e
dtev T GT (suc n) (fcclo i) ρ = tvclo i ρ
dtev T GT (suc n) (fcapp f a) ρ = tv-app T (λ c σ → dtev T GT n c σ) (dtev T GT n f ρ) (dtev T GT n a ρ)
dtev T GT (suc n) (fccall g m a) ρ = dtev T GT n (GT g) (text tvnone (dtev T GT n a ρ))
dtev T GT (suc n) (fcby a) ρ = tv-bytes (dtev T GT n a ρ)
dtev T GT (suc n) (fcld w b o) ρ = tv-ld w (dtev T GT n b ρ) (dtev T GT n o ρ)
dtev T GT (suc n) (fcst w b o v) ρ = tv-st w (dtev T GT n b ρ) (dtev T GT n o ρ) (dtev T GT n v ρ)
dtev T GT (suc n) (fcblen b) ρ = tv-blen (dtev T GT n b ρ)
-- closure conversion: a λ becomes a reference to its table entry
dconv : DC → FC
dconv (dcl w) = fcl w
dconv (dcv n) = fcv n
dconv (dcp p a b) = fcp p (dconv a) (dconv b)
dconv (dcp1 p a) = fcp1 p (dconv a)
dconv (dclet a b) = fclet (dconv a) (dconv b)
dconv dcu = fcu
dconv (dcpr a b) = fcpr (dconv a) (dconv b)
dconv (dcfst a) = fcfst (dconv a)
dconv (dcsnd a) = fcsnd (dconv a)
dconv (dccon d k a) = fccon d k (dconv a)
dconv (dccase s alts) = fccase (dconv s) (dconv alts)
dconv (dcalt k n b r) = fcalt k n (dconv b) (dconv r)
dconv dcnone = fcnone
dconv (dcif c t e) = fcif (dconv c) (dconv t) (dconv e)
dconv (dclam i b) = fcclo i
dconv (dcapp f a) = fcapp (dconv f) (dconv a)
dconv (dccall g m a) = fccall g m (dconv a)
dconv (dcby a) = fcby (dconv a)
dconv (dcld w b o) = fcld w (dconv b) (dconv o)
dconv (dcst w b o v) = fcst w (dconv b) (dconv o) (dconv v)
dconv (dcblen b) = fcblen (dconv b)
-- what a value is in the target: a closure's body dropped for its index
derase : DV → TV
derase (dvw w) = tvw w
derase (dvc k x) = tvc k (derase x)
derase (dvclo i b ρ) = tvclo i (λ n → derase (ρ n))
derase dvbot = tvbot
derase (dvb l) = tvb l
derase dvu = tvu
derase (dvpr a b) = tvpr (derase a) (derase b)
-- ---------------------------------------------------------------- the theorem
-- the table is right for a code: every λ i b in it has T i the conversion of b
DTok : (Word → FC) → DC → Type
DTok T (dcl x0) = Unit
DTok T (dcv x0) = Unit
DTok T (dcp x0 x1 x2) = DTok T x1 × DTok T x2
DTok T (dcp1 x0 x1) = DTok T x1
DTok T (dclet x0 x1) = DTok T x0 × DTok T x1
DTok T dcu = Unit
DTok T (dcpr x0 x1) = DTok T x0 × DTok T x1
DTok T (dcfst x0) = DTok T x0
DTok T (dcsnd x0) = DTok T x0
DTok T (dccon x0 x1 x2) = DTok T x2
DTok T (dccase x0 x1) = DTok T x0 × DTok T x1
DTok T (dcalt x0 x1 x2 x3) = DTok T x2 × DTok T x3
DTok T dcnone = Unit
DTok T (dcif x0 x1 x2) = DTok T x0 × (DTok T x1 × DTok T x2)
DTok T (dclam x0 x1) = (T x0 ≡ dconv x1) × DTok T x1
DTok T (dcapp x0 x1) = DTok T x0 × DTok T x1
DTok T (dccall x0 x1 x2) = DTok T x2
DTok T (dcby x0) = DTok T x0
DTok T (dcld x0 x1 x2) = DTok T x1 × DTok T x2
DTok T (dcst x0 x1 x2 x3) = DTok T x1 × (DTok T x2 × DTok T x3)
DTok T (dcblen x0) = DTok T x0
-- and for a value: a closure's index names its body's conversion, all the way into its environment
-- and into constructors and pairs
dgood : (Word → FC) → DV → Type
dgood T (dvw w) = Unit
dgood T (dvc k x) = dgood T x
dgood T (dvclo i b ρ) = ((T i ≡ dconv b) × DTok T b) × ((n : Nat) → dgood T (ρ n))
dgood T dvbot = Unit
dgood T (dvb l) = Unit
dgood T dvu = Unit
dgood T (dvpr a b) = dgood T a × dgood T b
DGEnv : (Word → FC) → (Nat → DV) → Type
DGEnv T ρ = (k : Nat) → dgood T (ρ k)
dge-ext : (T : Word → FC) (ρ : Nat → DV) (x : DV) → DGEnv T ρ → dgood T x → DGEnv T (dext ρ x)
dge-ext T ρ x ge gx k = case k return (λ m → dgood T (dext ρ x m)) of zero → gx; suc m → ge m
denv : (Nat → DV) → Nat → TV
denv ρ k = derase (ρ k)
denv-pt : (ρ : Nat → DV) (x : DV) (k : Nat) → denv (dext ρ x) k ≡ text (denv ρ) (derase x) k
denv-pt ρ x zero = λ i → derase x
denv-pt ρ x (suc m) = λ i → derase (ρ m)
denv-ext : (ρ : Nat → DV) (x : DV) → denv (dext ρ x) ≡ text (denv ρ) (derase x)
denv-ext ρ x = λ j k → denv-pt ρ x k j
dtr : {x y z : TV} → x ≡ y → y ≡ z → x ≡ z
dtr p q = λ i → comp (λ j → TV) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
-- the endpoints given (an elaboration that infers them reads the evaluators' stuck cases back, at a cost
-- that grows with the number of forms)
dtrx : (x y z : TV) → x ≡ y → y ≡ z → x ≡ z
dtrx x y z p q = dtr {x} {y} {z} p q
-- a source value is good and erases to the target value
DOK : (Word → FC) → DV → TV → Type
DOK T v t = dgood T v × (derase v ≡ t)
-- the lemmas, one per operation on values
dv-prim-ok : (T : Word → FC) (p : Word) (x y : DV) → DOK T (dv-prim p x y) (tv-prim p (derase x) (derase y))
dv-prim-ok T p (dvw a) (dvw b) = (unit , λ i → tvw (dprim2 p a b))
dv-prim-ok T p _ _ = (unit , λ i → tvbot)
dv-prim1-ok : (T : Word → FC) (p : Word) (x : DV) → DOK T (dv-prim1 p x) (tv-prim1 p (derase x))
dv-prim1-ok T p (dvw a) = (unit , λ i → tvw (dprim1 p a))
dv-prim1-ok T p _ = (unit , λ i → tvbot)
dv-fst-ok : (T : Word → FC) (x : DV) → dgood T x → DOK T (dv-fst x) (tv-fst (derase x))
dv-fst-ok T (dvpr a b) gx = (fst gx , λ i → derase a)
dv-fst-ok T _ gx = (unit , λ i → tvbot)
dv-snd-ok : (T : Word → FC) (x : DV) → dgood T x → DOK T (dv-snd x) (tv-snd (derase x))
dv-snd-ok T (dvpr a b) gx = (snd gx , λ i → derase b)
dv-snd-ok T _ gx = (unit , λ i → tvbot)
dv-bytes-ok : (T : Word → FC) (x : DV) → DOK T (dv-bytes x) (tv-bytes (derase x))
dv-bytes-ok T (dvw n) = (unit , λ i → tvb (blm n bzero))
dv-bytes-ok T _ = (unit , λ i → tvbot)
dv-ld-ok : (T : Word → FC) (w : Word) (x y : DV) → DOK T (dv-ld w x y) (tv-ld w (derase x) (derase y))
dv-ld-ok T w (dvb l) (dvw o) = (unit , λ i → tvw (bl-ld w o l))
dv-ld-ok T w _ _ = (unit , λ i → tvbot)
dv-st-ok : (T : Word → FC) (w : Word) (x y z : DV) → DOK T (dv-st w x y z) (tv-st w (derase x) (derase y) (derase z))
dv-st-ok T w (dvb l) (dvw o) (dvw v) = (unit , λ i → tvb (bl-st w o v l))
dv-st-ok T w _ _ _ = (unit , λ i → tvbot)
dv-blen-ok : (T : Word → FC) (x : DV) → DOK T (dv-blen x) (tv-blen (derase x))
dv-blen-ok T (dvb l) = (unit , λ i → tvw (bl-len l))
dv-blen-ok T _ = (unit , λ i → tvbot)
-- pushing a constructor's fields keeps the environment good and erases to the target's push
DPush : (Word → FC) → Nat → DV → (Nat → DV) → Type
DPush T n x ρ = DGEnv T (dv-push n x ρ) × ((k : Nat) → denv (dv-push n x ρ) k ≡ tv-push n (derase x) (denv ρ) k)
dv-push-ok : (T : Word → FC) (n : Nat) (x : DV) (ρ : Nat → DV) → dgood T x → DGEnv T ρ → DPush T n x ρ
dv-push-ok T zero x ρ gx ge = (ge , λ k i → derase (ρ k))
dv-push-ok T (suc m) (dvpr a r) ρ gx ge =
  (fst (dv-push-ok T m r (dext ρ a) (snd gx) (dge-ext T ρ a ge (fst gx))) ,
   λ k → dtrx (denv (dv-push m r (dext ρ a)) k) (tv-push m (derase r) (denv (dext ρ a)) k) (tv-push m (derase r) (text (denv ρ) (derase a)) k)
             (snd (dv-push-ok T m r (dext ρ a) (snd gx) (dge-ext T ρ a ge (fst gx))) k) (λ j → tv-push m (derase r) (denv-ext ρ a j) k))
dv-push-ok T (suc m) x ρ gx ge =
  (fst (dv-push-ok T m dvbot (dext ρ dvbot) unit (dge-ext T ρ dvbot ge unit)) ,
   λ k → dtrx (denv (dv-push m dvbot (dext ρ dvbot)) k) (tv-push m tvbot (denv (dext ρ dvbot)) k) (tv-push m tvbot (text (denv ρ) tvbot) k)
             (snd (dv-push-ok T m dvbot (dext ρ dvbot) unit (dge-ext T ρ dvbot ge unit)) k) (λ j → tv-push m tvbot (denv-ext ρ dvbot j) k))
dv-push-fn : (T : Word → FC) (n : Nat) (x : DV) (ρ : Nat → DV) → DPush T n x ρ → denv (dv-push n x ρ) ≡ tv-push n (derase x) (denv ρ)
dv-push-fn T n x ρ p = λ j k → snd p k j
dv-pick-ok : (T : Word → FC) (bv : Bool) (a b : DV) (ta tb : TV) → DOK T a ta → DOK T b tb → DOK T (dv-pick bv a b) (tv-pick bv ta tb)
dv-pick-ok T true a b ta tb ha hb = ha
dv-pick-ok T false a b ta tb ha hb = hb
-- whether the fields are a whole tuple of n is the same before and after erasure
dv-tup-er : (n : Nat) (x : DV) → dv-tup n x ≡ tv-tup n (derase x)
dv-tup-er zero dvu = λ i → true
dv-tup-er zero (dvw w) = λ i → false
dv-tup-er zero (dvc k x) = λ i → false
dv-tup-er zero (dvclo i b ρ) = λ j → false
dv-tup-er zero dvbot = λ i → false
dv-tup-er zero (dvb l) = λ i → false
dv-tup-er zero (dvpr a b) = λ i → false
dv-tup-er (suc m) (dvpr a r) = dv-tup-er m r
dv-tup-er (suc m) (dvw w) = λ i → false
dv-tup-er (suc m) (dvc k x) = λ i → false
dv-tup-er (suc m) (dvclo i b ρ) = λ j → false
dv-tup-er (suc m) dvbot = λ i → false
dv-tup-er (suc m) (dvb l) = λ i → false
dv-tup-er (suc m) dvu = λ i → false
dv-tpick-ok : (T : Word → FC) (n : Nat) (x : DV) (a : DV) (ta : TV) → DOK T a ta → DOK T (dv-pick (dv-tup n x) a dvbot) (tv-pick (tv-tup n (derase x)) ta tvbot)
dv-tpick-ok T n x a ta ha =
  subst {lzero} {lzero} {Bool} {λ c → DOK T (dv-pick (dv-tup n x) a dvbot) (tv-pick c ta tvbot)} {dv-tup n x} {tv-tup n (derase x)} (dv-tup-er n x)
    (dv-pick-ok T (dv-tup n x) a dvbot ta tvbot ha (unit , λ i → tvbot))
-- an evaluator pair related at every code whose table is right, in every good environment
DIH : (Word → FC) → (DC → (Nat → DV) → DV) → (FC → (Nat → TV) → TV) → Type
DIH T ev evt = (c : DC) (σ : Nat → DV) → DTok T c → DGEnv T σ → DOK T (ev c σ) (evt (dconv c) (denv σ))
dv-alt-ok : (T : Word → FC) (ev : DC → (Nat → DV) → DV) (evt : FC → (Nat → TV) → TV) → DIH T ev evt → (ρ : Nat → DV) (v : DV) → dgood T v → (j : Word) (n : Nat) (b : DC) → DTok T b → DGEnv T ρ
          → (rest : DV) (trest : TV) → DOK T rest trest → DOK T (dv-alt ev ρ v j n b rest) (tv-alt evt (denv ρ) (derase v) j n (dconv b) trest)
dv-alt-ok T ev evt ih ρ (dvc k x) gv j n b tb ge rest trest hr =
  dv-pick-ok T (weq k j) (dv-pick (dv-tup n x) (ev b (dv-push n x ρ)) dvbot) rest (tv-pick (tv-tup n (derase x)) (evt (dconv b) (tv-push n (derase x) (denv ρ))) tvbot) trest
    (dv-tpick-ok T n x (ev b (dv-push n x ρ)) (evt (dconv b) (tv-push n (derase x) (denv ρ)))
      (fst (ih b (dv-push n x ρ) tb (fst (dv-push-ok T n x ρ gv ge))) ,
       dtrx (derase (ev b (dv-push n x ρ))) (evt (dconv b) (denv (dv-push n x ρ))) (evt (dconv b) (tv-push n (derase x) (denv ρ)))
            (snd (ih b (dv-push n x ρ) tb (fst (dv-push-ok T n x ρ gv ge))))
            (λ i → evt (dconv b) (dv-push-fn T n x ρ (dv-push-ok T n x ρ gv ge) i))))
    hr
dv-alt-ok T ev evt ih ρ v gv j n b tb ge rest trest hr = (unit , λ i → tvbot)
dv-cases-ok : (T : Word → FC) (ev : DC → (Nat → DV) → DV) (evt : FC → (Nat → TV) → TV) → DIH T ev evt → (ρ : Nat → DV) (v : DV) → dgood T v → (alts : DC) → DTok T alts → DGEnv T ρ
            → DOK T (dv-cases ev ρ v alts) (tv-cases evt (denv ρ) (derase v) (dconv alts))
dv-cases-ok T ev evt ih ρ v gv (dcalt j n b r) tk ge =
  dv-alt-ok T ev evt ih ρ v gv j n b (fst tk) ge (dv-cases ev ρ v r) (tv-cases evt (denv ρ) (derase v) (dconv r)) (dv-cases-ok T ev evt ih ρ v gv r (snd tk) ge)
dv-cases-ok T ev evt ih ρ v gv alts tk ge = (unit , λ i → tvbot)
dv-if-ok : (T : Word → FC) (ev : DC → (Nat → DV) → DV) (evt : FC → (Nat → TV) → TV) → DIH T ev evt → (ρ : Nat → DV) (v : DV) → (t e : DC) → DTok T t → DTok T e → DGEnv T ρ
         → DOK T (dv-if ev ρ v t e) (tv-if evt (denv ρ) (derase v) (dconv t) (dconv e))
dv-if-ok T ev evt ih ρ (dvw w) t e tt te ge =
  %welimP (λ u → DOK T (%welimP (λ u2 → DV) u (ev e ρ) (λ m h → ev t ρ)) (%welimP (λ u2 → TV) u (evt (dconv e) (denv ρ)) (λ m h → evt (dconv t) (denv ρ)))) w
    (ih e ρ te ge) (λ m h → ih t ρ tt ge)
dv-if-ok T ev evt ih ρ _ t e tt te ge = (unit , λ i → tvbot)
dv-app-ok : (T : Word → FC) (ev : DC → (Nat → DV) → DV) (evt : FC → (Nat → TV) → TV) → DIH T ev evt → (v x : DV) → dgood T v → dgood T x →
  DOK T (dv-app ev v x) (tv-app T evt (derase v) (derase x))
dv-app-ok T ev evt ih (dvclo i b ρ) x gv gx =
  (fst (ih b (dext ρ x) (snd (fst gv)) (dge-ext T ρ x (snd gv) gx)) ,
   dtrx (derase (ev b (dext ρ x))) (evt (dconv b) (denv (dext ρ x))) (evt (T i) (text (denv ρ) (derase x)))
        (snd (ih b (dext ρ x) (snd (fst gv)) (dge-ext T ρ x (snd gv) gx)))
        (dtrx (evt (dconv b) (denv (dext ρ x))) (evt (T i) (denv (dext ρ x))) (evt (T i) (text (denv ρ) (derase x)))
              (λ j → evt (fst (fst gv) (~ j)) (denv (dext ρ x))) (λ j → evt (T i) (denv-ext ρ x j))))
dv-app-ok T ev evt ih _ x gv gx = (unit , λ i → tvbot)
-- the definitions' table is right: each a conversion, with its closures' table right
DGOK : (Word → DC) → (Word → FC) → (Word → FC) → Type
DGOK G T GT = (g : Word) → (GT g ≡ dconv (G g)) × DTok T (G g)
DRes : (Word → DC) → (Word → FC) → (Word → FC) → Nat → DC → (Nat → DV) → Type
DRes G T GT n c ρ = DOK T (dsev G n c ρ) (dtev T GT n (dconv c) (denv ρ))
-- one step: what evaluation does given what it does one unit of fuel smaller (ih)
DIHn : (Word → DC) → (Word → FC) → (Word → FC) → Nat → Type
DIHn G T GT n = (c : DC) (σ : Nat → DV) → DTok T c → DGEnv T σ → DRes G T GT n c σ
ds-prim : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (p : Word) (a b : DC) (ρ : Nat → DV) → DTok T (dcp p a b) → DGEnv T ρ → DRes G T GT (suc n) (dcp p a b) ρ
ds-prim G T GT n ih p a b ρ tk ge =
  (fst (dv-prim-ok T p (dsev G n a ρ) (dsev G n b ρ)) ,
   dtrx (derase (dv-prim p (dsev G n a ρ) (dsev G n b ρ))) (tv-prim p (derase (dsev G n a ρ)) (derase (dsev G n b ρ))) (tv-prim p (dtev T GT n (dconv a) (denv ρ)) (dtev T GT n (dconv b) (denv ρ)))
        (snd (dv-prim-ok T p (dsev G n a ρ) (dsev G n b ρ))) (λ j → tv-prim p (snd (ih a ρ (fst tk) ge) j) (snd (ih b ρ (snd tk) ge) j)))
ds-prim1 : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (p : Word) (a : DC) (ρ : Nat → DV) → DTok T (dcp1 p a) → DGEnv T ρ → DRes G T GT (suc n) (dcp1 p a) ρ
ds-prim1 G T GT n ih p a ρ tk ge =
  (fst (dv-prim1-ok T p (dsev G n a ρ)) , dtrx (derase (dv-prim1 p (dsev G n a ρ))) (tv-prim1 p (derase (dsev G n a ρ))) (tv-prim1 p (dtev T GT n (dconv a) (denv ρ))) (snd (dv-prim1-ok T p (dsev G n a ρ))) (λ j → tv-prim1 p (snd (ih a ρ tk ge) j)))
ds-let : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (a b : DC) (ρ : Nat → DV) → DTok T (dclet a b) → DGEnv T ρ → DRes G T GT (suc n) (dclet a b) ρ
ds-let G T GT n ih a b ρ tk ge =
  (fst (ih b (dext ρ (dsev G n a ρ)) (snd tk) (dge-ext T ρ (dsev G n a ρ) ge (fst (ih a ρ (fst tk) ge)))) ,
   dtrx (derase (dsev G n b (dext ρ (dsev G n a ρ)))) (dtev T GT n (dconv b) (denv (dext ρ (dsev G n a ρ)))) (dtev T GT n (dconv b) (text (denv ρ) (dtev T GT n (dconv a) (denv ρ))))
        (snd (ih b (dext ρ (dsev G n a ρ)) (snd tk) (dge-ext T ρ (dsev G n a ρ) ge (fst (ih a ρ (fst tk) ge)))))
        (dtrx (dtev T GT n (dconv b) (denv (dext ρ (dsev G n a ρ)))) (dtev T GT n (dconv b) (text (denv ρ) (derase (dsev G n a ρ)))) (dtev T GT n (dconv b) (text (denv ρ) (dtev T GT n (dconv a) (denv ρ))))
              (λ j → dtev T GT n (dconv b) (denv-ext ρ (dsev G n a ρ) j))
              (λ j → dtev T GT n (dconv b) (text (denv ρ) (snd (ih a ρ (fst tk) ge) j)))))
ds-pr : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (a b : DC) (ρ : Nat → DV) → DTok T (dcpr a b) → DGEnv T ρ → DRes G T GT (suc n) (dcpr a b) ρ
ds-pr G T GT n ih a b ρ tk ge =
  ((fst (ih a ρ (fst tk) ge) , fst (ih b ρ (snd tk) ge)) , λ j → tvpr (snd (ih a ρ (fst tk) ge) j) (snd (ih b ρ (snd tk) ge) j))
ds-fst : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (a : DC) (ρ : Nat → DV) → DTok T (dcfst a) → DGEnv T ρ → DRes G T GT (suc n) (dcfst a) ρ
ds-fst G T GT n ih a ρ tk ge =
  (fst (dv-fst-ok T (dsev G n a ρ) (fst (ih a ρ tk ge))) , dtrx (derase (dv-fst (dsev G n a ρ))) (tv-fst (derase (dsev G n a ρ))) (tv-fst (dtev T GT n (dconv a) (denv ρ))) (snd (dv-fst-ok T (dsev G n a ρ) (fst (ih a ρ tk ge)))) (λ j → tv-fst (snd (ih a ρ tk ge) j)))
ds-snd : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (a : DC) (ρ : Nat → DV) → DTok T (dcsnd a) → DGEnv T ρ → DRes G T GT (suc n) (dcsnd a) ρ
ds-snd G T GT n ih a ρ tk ge =
  (fst (dv-snd-ok T (dsev G n a ρ) (fst (ih a ρ tk ge))) , dtrx (derase (dv-snd (dsev G n a ρ))) (tv-snd (derase (dsev G n a ρ))) (tv-snd (dtev T GT n (dconv a) (denv ρ))) (snd (dv-snd-ok T (dsev G n a ρ) (fst (ih a ρ tk ge)))) (λ j → tv-snd (snd (ih a ρ tk ge) j)))
ds-con : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (d k : Word) (a : DC) (ρ : Nat → DV) → DTok T (dccon d k a) → DGEnv T ρ → DRes G T GT (suc n) (dccon d k a) ρ
ds-con G T GT n ih d k a ρ tk ge = (fst (ih a ρ tk ge) , λ j → tvc k (snd (ih a ρ tk ge) j))
ds-case : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (s alts : DC) (ρ : Nat → DV) → DTok T (dccase s alts) → DGEnv T ρ → DRes G T GT (suc n) (dccase s alts) ρ
ds-case G T GT n ih s alts ρ tk ge =
  (fst (dv-cases-ok T (λ c σ → dsev G n c σ) (λ c σ → dtev T GT n c σ) ih ρ (dsev G n s ρ) (fst (ih s ρ (fst tk) ge)) alts (snd tk) ge) ,
   dtrx (derase (dv-cases (λ c σ → dsev G n c σ) ρ (dsev G n s ρ) alts)) (tv-cases (λ c σ → dtev T GT n c σ) (denv ρ) (derase (dsev G n s ρ)) (dconv alts)) (tv-cases (λ c σ → dtev T GT n c σ) (denv ρ) (dtev T GT n (dconv s) (denv ρ)) (dconv alts))
        (snd (dv-cases-ok T (λ c σ → dsev G n c σ) (λ c σ → dtev T GT n c σ) ih ρ (dsev G n s ρ) (fst (ih s ρ (fst tk) ge)) alts (snd tk) ge))
        (λ j → tv-cases (λ c σ → dtev T GT n c σ) (denv ρ) (snd (ih s ρ (fst tk) ge) j) (dconv alts)))
ds-if : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (c t e : DC) (ρ : Nat → DV) → DTok T (dcif c t e) → DGEnv T ρ → DRes G T GT (suc n) (dcif c t e) ρ
ds-if G T GT n ih c t e ρ tk ge =
  (fst (dv-if-ok T (λ c1 σ → dsev G n c1 σ) (λ c1 σ → dtev T GT n c1 σ) ih ρ (dsev G n c ρ) t e (fst (snd tk)) (snd (snd tk)) ge) ,
   dtrx (derase (dv-if (λ c1 σ → dsev G n c1 σ) ρ (dsev G n c ρ) t e)) (tv-if (λ c1 σ → dtev T GT n c1 σ) (denv ρ) (derase (dsev G n c ρ)) (dconv t) (dconv e)) (tv-if (λ c1 σ → dtev T GT n c1 σ) (denv ρ) (dtev T GT n (dconv c) (denv ρ)) (dconv t) (dconv e))
        (snd (dv-if-ok T (λ c1 σ → dsev G n c1 σ) (λ c1 σ → dtev T GT n c1 σ) ih ρ (dsev G n c ρ) t e (fst (snd tk)) (snd (snd tk)) ge))
        (λ j → tv-if (λ c1 σ → dtev T GT n c1 σ) (denv ρ) (snd (ih c ρ (fst tk) ge) j) (dconv t) (dconv e)))
ds-app : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (f a : DC) (ρ : Nat → DV) → DTok T (dcapp f a) → DGEnv T ρ → DRes G T GT (suc n) (dcapp f a) ρ
ds-app G T GT n ih f a ρ tk ge =
  (fst (dv-app-ok T (λ c σ → dsev G n c σ) (λ c σ → dtev T GT n c σ) ih (dsev G n f ρ) (dsev G n a ρ) (fst (ih f ρ (fst tk) ge)) (fst (ih a ρ (snd tk) ge))) ,
   dtrx (derase (dv-app (λ c σ → dsev G n c σ) (dsev G n f ρ) (dsev G n a ρ))) (tv-app T (λ c σ → dtev T GT n c σ) (derase (dsev G n f ρ)) (derase (dsev G n a ρ))) (tv-app T (λ c σ → dtev T GT n c σ) (dtev T GT n (dconv f) (denv ρ)) (dtev T GT n (dconv a) (denv ρ)))
        (snd (dv-app-ok T (λ c σ → dsev G n c σ) (λ c σ → dtev T GT n c σ) ih (dsev G n f ρ) (dsev G n a ρ) (fst (ih f ρ (fst tk) ge)) (fst (ih a ρ (snd tk) ge))))
        (λ j → tv-app T (λ c σ → dtev T GT n c σ) (snd (ih f ρ (fst tk) ge) j) (snd (ih a ρ (snd tk) ge) j)))
ds-call : (G : Word → DC) (T GT : Word → FC) → DGOK G T GT → (n : Nat) → DIHn G T GT n → (g m : Word) (a : DC) (ρ : Nat → DV) → DTok T (dccall g m a) → DGEnv T ρ → DRes G T GT (suc n) (dccall g m a) ρ
ds-call G T GT go n ih g m a ρ tk ge =
  (fst (ih (G g) (dext dvnone (dsev G n a ρ)) (snd (go g)) (dge-ext T dvnone (dsev G n a ρ) (λ k → unit) (fst (ih a ρ tk ge)))) ,
   dtrx (derase (dsev G n (G g) (dext dvnone (dsev G n a ρ)))) (dtev T GT n (dconv (G g)) (denv (dext dvnone (dsev G n a ρ)))) (dtev T GT n (GT g) (text tvnone (dtev T GT n (dconv a) (denv ρ))))
        (snd (ih (G g) (dext dvnone (dsev G n a ρ)) (snd (go g)) (dge-ext T dvnone (dsev G n a ρ) (λ k → unit) (fst (ih a ρ tk ge)))))
        (dtrx (dtev T GT n (dconv (G g)) (denv (dext dvnone (dsev G n a ρ)))) (dtev T GT n (GT g) (denv (dext dvnone (dsev G n a ρ)))) (dtev T GT n (GT g) (text tvnone (dtev T GT n (dconv a) (denv ρ))))
              (λ j → dtev T GT n (fst (go g) (~ j)) (denv (dext dvnone (dsev G n a ρ))))
              (dtrx (dtev T GT n (GT g) (denv (dext dvnone (dsev G n a ρ)))) (dtev T GT n (GT g) (text tvnone (derase (dsev G n a ρ)))) (dtev T GT n (GT g) (text tvnone (dtev T GT n (dconv a) (denv ρ))))
                    (λ j → dtev T GT n (GT g) (denv-ext dvnone (dsev G n a ρ) j))
                    (λ j → dtev T GT n (GT g) (text tvnone (snd (ih a ρ tk ge) j))))))
ds-by : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (a : DC) (ρ : Nat → DV) → DTok T (dcby a) → DGEnv T ρ → DRes G T GT (suc n) (dcby a) ρ
ds-by G T GT n ih a ρ tk ge =
  (fst (dv-bytes-ok T (dsev G n a ρ)) , dtrx (derase (dv-bytes (dsev G n a ρ))) (tv-bytes (derase (dsev G n a ρ))) (tv-bytes (dtev T GT n (dconv a) (denv ρ))) (snd (dv-bytes-ok T (dsev G n a ρ))) (λ j → tv-bytes (snd (ih a ρ tk ge) j)))
ds-ld : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (w : Word) (b o : DC) (ρ : Nat → DV) → DTok T (dcld w b o) → DGEnv T ρ → DRes G T GT (suc n) (dcld w b o) ρ
ds-ld G T GT n ih w b o ρ tk ge =
  (fst (dv-ld-ok T w (dsev G n b ρ) (dsev G n o ρ)) ,
   dtrx (derase (dv-ld w (dsev G n b ρ) (dsev G n o ρ))) (tv-ld w (derase (dsev G n b ρ)) (derase (dsev G n o ρ))) (tv-ld w (dtev T GT n (dconv b) (denv ρ)) (dtev T GT n (dconv o) (denv ρ)))
        (snd (dv-ld-ok T w (dsev G n b ρ) (dsev G n o ρ))) (λ j → tv-ld w (snd (ih b ρ (fst tk) ge) j) (snd (ih o ρ (snd tk) ge) j)))
ds-st : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (w : Word) (b o v : DC) (ρ : Nat → DV) → DTok T (dcst w b o v) → DGEnv T ρ → DRes G T GT (suc n) (dcst w b o v) ρ
ds-st G T GT n ih w b o v ρ tk ge =
  (fst (dv-st-ok T w (dsev G n b ρ) (dsev G n o ρ) (dsev G n v ρ)) ,
   dtrx (derase (dv-st w (dsev G n b ρ) (dsev G n o ρ) (dsev G n v ρ))) (tv-st w (derase (dsev G n b ρ)) (derase (dsev G n o ρ)) (derase (dsev G n v ρ))) (tv-st w (dtev T GT n (dconv b) (denv ρ)) (dtev T GT n (dconv o) (denv ρ)) (dtev T GT n (dconv v) (denv ρ)))
        (snd (dv-st-ok T w (dsev G n b ρ) (dsev G n o ρ) (dsev G n v ρ))) (λ j → tv-st w (snd (ih b ρ (fst tk) ge) j) (snd (ih o ρ (fst (snd tk)) ge) j) (snd (ih v ρ (snd (snd tk)) ge) j)))
ds-blen : (G : Word → DC) (T GT : Word → FC) (n : Nat) → DIHn G T GT n → (b : DC) (ρ : Nat → DV) → DTok T (dcblen b) → DGEnv T ρ → DRes G T GT (suc n) (dcblen b) ρ
ds-blen G T GT n ih b ρ tk ge =
  (fst (dv-blen-ok T (dsev G n b ρ)) , dtrx (derase (dv-blen (dsev G n b ρ))) (tv-blen (derase (dsev G n b ρ))) (tv-blen (dtev T GT n (dconv b) (denv ρ))) (snd (dv-blen-ok T (dsev G n b ρ))) (λ j → tv-blen (snd (ih b ρ tk ge) j)))
-- closure conversion computes what the code means, at every fuel and in every good environment
dc-sound : (G : Word → DC) (T GT : Word → FC) → DGOK G T GT → (n : Nat) (c : DC) (ρ : Nat → DV) → DTok T c → DGEnv T ρ → DRes G T GT n c ρ
dc-sound G T GT go zero c ρ tk ge = (unit , λ i → tvbot)
dc-sound G T GT go (suc n) (dcl w) ρ tk ge = (unit , λ i → tvw w)
dc-sound G T GT go (suc n) (dcv k) ρ tk ge = (ge k , λ i → derase (ρ k))
dc-sound G T GT go (suc n) (dcp p a b) ρ tk ge = ds-prim G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) p a b ρ tk ge
dc-sound G T GT go (suc n) (dcp1 p a) ρ tk ge = ds-prim1 G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) p a ρ tk ge
dc-sound G T GT go (suc n) (dclet a b) ρ tk ge = ds-let G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) a b ρ tk ge
dc-sound G T GT go (suc n) dcu ρ tk ge = (unit , λ i → tvu)
dc-sound G T GT go (suc n) (dcpr a b) ρ tk ge = ds-pr G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) a b ρ tk ge
dc-sound G T GT go (suc n) (dcfst a) ρ tk ge = ds-fst G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) a ρ tk ge
dc-sound G T GT go (suc n) (dcsnd a) ρ tk ge = ds-snd G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) a ρ tk ge
dc-sound G T GT go (suc n) (dccon d k a) ρ tk ge = ds-con G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) d k a ρ tk ge
dc-sound G T GT go (suc n) (dccase s alts) ρ tk ge = ds-case G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) s alts ρ tk ge
dc-sound G T GT go (suc n) (dcalt k m b r) ρ tk ge = (unit , λ i → tvbot)
dc-sound G T GT go (suc n) dcnone ρ tk ge = (unit , λ i → tvbot)
dc-sound G T GT go (suc n) (dcif c t e) ρ tk ge = ds-if G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) c t e ρ tk ge
dc-sound G T GT go (suc n) (dclam i b) ρ tk ge = ((tk , ge) , λ j → tvclo i (denv ρ))
dc-sound G T GT go (suc n) (dcapp f a) ρ tk ge = ds-app G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) f a ρ tk ge
dc-sound G T GT go (suc n) (dccall g m a) ρ tk ge = ds-call G T GT go n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) g m a ρ tk ge
dc-sound G T GT go (suc n) (dcby a) ρ tk ge = ds-by G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) a ρ tk ge
dc-sound G T GT go (suc n) (dcld w b o) ρ tk ge = ds-ld G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) w b o ρ tk ge
dc-sound G T GT go (suc n) (dcst w b o v) ρ tk ge = ds-st G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) w b o v ρ tk ge
dc-sound G T GT go (suc n) (dcblen b) ρ tk ge = ds-blen G T GT n (λ c1 σ1 t1 g1 → dc-sound G T GT go n c1 σ1 t1 g1) b ρ tk ge
-- ---------------------------------------------------------------- deciding the table, for concrete programs
neqb : Nat → Nat → Bool
neqb zero zero = true
neqb (suc m) (suc n) = neqb m n
neqb _ _ = false
neqb-sound : (m n : Nat) → neqb m n ≡ true → m ≡ n
neqb-sound zero zero e = λ i → zero
neqb-sound (suc m) (suc n) e = λ i → suc (neqb-sound m n e i)
neqb-sound _ _ e = Empty-rec (false≢true e)
fc-eq : FC → FC → Bool
fc-eq (fcl x0) y = case y return (λ z → Bool) of
    fcl y0 → (weq x0 y0)
    fcv y0 → false
    fcp y0 y1 y2 → false
    fcp1 y0 y1 → false
    fclet y0 y1 → false
