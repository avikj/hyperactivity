fc-eq-sound (fccase x0 x1) = fcs-fccase x0 x1 (fc-eq-sound x0) (fc-eq-sound x1)
fc-eq-sound (fcalt x0 x1 x2 x3) = fcs-fcalt x0 x1 x2 x3 (fc-eq-sound x2) (fc-eq-sound x3)
fc-eq-sound fcnone = fcs-fcnone  
fc-eq-sound (fcif x0 x1 x2) = fcs-fcif x0 x1 x2 (fc-eq-sound x0) (fc-eq-sound x1) (fc-eq-sound x2)
fc-eq-sound (fcclo x0) = fcs-fcclo x0 
fc-eq-sound (fcapp x0 x1) = fcs-fcapp x0 x1 (fc-eq-sound x0) (fc-eq-sound x1)
fc-eq-sound (fccall x0 x1 x2) = fcs-fccall x0 x1 x2 (fc-eq-sound x2)
fc-eq-sound (fcby x0) = fcs-fcby x0 (fc-eq-sound x0)
fc-eq-sound (fcld x0 x1 x2) = fcs-fcld x0 x1 x2 (fc-eq-sound x1) (fc-eq-sound x2)
fc-eq-sound (fcst x0 x1 x2 x3) = fcs-fcst x0 x1 x2 x3 (fc-eq-sound x1) (fc-eq-sound x2) (fc-eq-sound x3)
fc-eq-sound (fcblen x0) = fcs-fcblen x0 (fc-eq-sound x0)
dtok-chk : (Word → FC) → DC → Bool
dtok-chk T (dcl x0) = true
dtok-chk T (dcv x0) = true
dtok-chk T (dcp x0 x1 x2) = andbt (dtok-chk T x1) (dtok-chk T x2)
dtok-chk T (dcp1 x0 x1) = (dtok-chk T x1)
dtok-chk T (dclet x0 x1) = andbt (dtok-chk T x0) (dtok-chk T x1)
dtok-chk T dcu = true
dtok-chk T (dcpr x0 x1) = andbt (dtok-chk T x0) (dtok-chk T x1)
dtok-chk T (dcfst x0) = (dtok-chk T x0)
dtok-chk T (dcsnd x0) = (dtok-chk T x0)
dtok-chk T (dccon x0 x1 x2) = (dtok-chk T x2)
dtok-chk T (dccase x0 x1) = andbt (dtok-chk T x0) (dtok-chk T x1)
dtok-chk T (dcalt x0 x1 x2 x3) = andbt (dtok-chk T x2) (dtok-chk T x3)
dtok-chk T dcnone = true
dtok-chk T (dcif x0 x1 x2) = andbt (dtok-chk T x0) (andbt (dtok-chk T x1) (dtok-chk T x2))
dtok-chk T (dclam x0 x1) = andbt (fc-eq (T x0) (dconv x1)) (dtok-chk T x1)
dtok-chk T (dcapp x0 x1) = andbt (dtok-chk T x0) (dtok-chk T x1)
dtok-chk T (dccall x0 x1 x2) = (dtok-chk T x2)
dtok-chk T (dcby x0) = (dtok-chk T x0)
dtok-chk T (dcld x0 x1 x2) = andbt (dtok-chk T x1) (dtok-chk T x2)
dtok-chk T (dcst x0 x1 x2 x3) = andbt (dtok-chk T x1) (andbt (dtok-chk T x2) (dtok-chk T x3))
dtok-chk T (dcblen x0) = (dtok-chk T x0)
dtok-auto : (T : Word → FC) (c : DC) → dtok-chk T c ≡ true → DTok T c
dtok-auto T (dcl x0) e = unit
dtok-auto T (dcv x0) e = unit
dtok-auto T (dcp x0 x1 x2) e = (dtok-auto T x1 (andbt-l (dtok-chk T x1) (dtok-chk T x2) e) , dtok-auto T x2 (andbt-r (dtok-chk T x1) (dtok-chk T x2) e))
dtok-auto T (dcp1 x0 x1) e = dtok-auto T x1 e
dtok-auto T (dclet x0 x1) e = (dtok-auto T x0 (andbt-l (dtok-chk T x0) (dtok-chk T x1) e) , dtok-auto T x1 (andbt-r (dtok-chk T x0) (dtok-chk T x1) e))
dtok-auto T dcu e = unit
dtok-auto T (dcpr x0 x1) e = (dtok-auto T x0 (andbt-l (dtok-chk T x0) (dtok-chk T x1) e) , dtok-auto T x1 (andbt-r (dtok-chk T x0) (dtok-chk T x1) e))
dtok-auto T (dcfst x0) e = dtok-auto T x0 e
dtok-auto T (dcsnd x0) e = dtok-auto T x0 e
dtok-auto T (dccon x0 x1 x2) e = dtok-auto T x2 e
dtok-auto T (dccase x0 x1) e = (dtok-auto T x0 (andbt-l (dtok-chk T x0) (dtok-chk T x1) e) , dtok-auto T x1 (andbt-r (dtok-chk T x0) (dtok-chk T x1) e))
dtok-auto T (dcalt x0 x1 x2 x3) e = (dtok-auto T x2 (andbt-l (dtok-chk T x2) (dtok-chk T x3) e) , dtok-auto T x3 (andbt-r (dtok-chk T x2) (dtok-chk T x3) e))
dtok-auto T dcnone e = unit
dtok-auto T (dcif x0 x1 x2) e = (dtok-auto T x0 (andbt-l (dtok-chk T x0) (andbt (dtok-chk T x1) (dtok-chk T x2)) e) , (dtok-auto T x1 (andbt-l (dtok-chk T x1) (dtok-chk T x2) (andbt-r (dtok-chk T x0) (andbt (dtok-chk T x1) (dtok-chk T x2)) e)) , dtok-auto T x2 (andbt-r (dtok-chk T x1) (dtok-chk T x2) (andbt-r (dtok-chk T x0) (andbt (dtok-chk T x1) (dtok-chk T x2)) e))))
dtok-auto T (dclam x0 x1) e = (fc-eq-sound (T x0) (dconv x1) (andbt-l (fc-eq (T x0) (dconv x1)) (dtok-chk T x1) e) , dtok-auto T x1 (andbt-r (fc-eq (T x0) (dconv x1)) (dtok-chk T x1) e))
dtok-auto T (dcapp x0 x1) e = (dtok-auto T x0 (andbt-l (dtok-chk T x0) (dtok-chk T x1) e) , dtok-auto T x1 (andbt-r (dtok-chk T x0) (dtok-chk T x1) e))
dtok-auto T (dccall x0 x1 x2) e = dtok-auto T x2 e
dtok-auto T (dcby x0) e = dtok-auto T x0 e
dtok-auto T (dcld x0 x1 x2) e = (dtok-auto T x1 (andbt-l (dtok-chk T x1) (dtok-chk T x2) e) , dtok-auto T x2 (andbt-r (dtok-chk T x1) (dtok-chk T x2) e))
dtok-auto T (dcst x0 x1 x2 x3) e = (dtok-auto T x1 (andbt-l (dtok-chk T x1) (andbt (dtok-chk T x2) (dtok-chk T x3)) e) , (dtok-auto T x2 (andbt-l (dtok-chk T x2) (dtok-chk T x3) (andbt-r (dtok-chk T x1) (andbt (dtok-chk T x2) (dtok-chk T x3)) e)) , dtok-auto T x3 (andbt-r (dtok-chk T x2) (dtok-chk T x3) (andbt-r (dtok-chk T x1) (andbt (dtok-chk T x2) (dtok-chk T x3)) e))))
dtok-auto T (dcblen x0) e = dtok-auto T x0 e

-- ---------------------------------------------------------------- verified rewrites past the word fragment
-- Rewrites over the converted mirror (FC: closures by table index, so a value holds no code and the
-- order below is first order), applied bottom up to main, the closures' table and the globals'
-- table alike. Their soundness is refinement at every fuel and environment: where the program before
-- the rewrite has a value, the program after has the same one (it may have one at a fuel where the
-- one before had none: x + 0 → x needs a unit less). Then for a data program read into the mirror,
-- what the rewritten conversion computes refines what the source means (fr-dc-path).
-- the order: nothing (tvbot) below everything; a word, a string or unit only below itself; a
-- constructor value below one of the same tag whose fields are above its own, a pair likewise; a
-- closure below one of the same index whose environment is above its own, pointwise
fr-le : TV → TV → Type
fr-le tvbot v = Unit
fr-le (tvw a) v = tvw a ≡ v
fr-le (tvb l) v = tvb l ≡ v
fr-le tvu v = tvu ≡ v
fr-le (tvc k x) (tvc j y) = (k ≡ j) × fr-le x y
fr-le (tvc k x) _ = Empty
fr-le (tvpr a b) (tvpr c d) = fr-le a c × fr-le b d
fr-le (tvpr a b) _ = Empty
fr-le (tvclo i ρ) (tvclo j σ) = (i ≡ j) × ((k : Nat) → fr-le (ρ k) (σ k))
fr-le (tvclo i ρ) _ = Empty
FrEnv : (Nat → TV) → (Nat → TV) → Type
FrEnv ρ σ = (k : Nat) → fr-le (ρ k) (σ k)
fr-refl : (v : TV) → fr-le v v
fr-refl tvbot = unit
fr-refl (tvw a) = λ j → tvw a
fr-refl (tvb l) = λ j → tvb l
fr-refl tvu = λ j → tvu
fr-refl (tvc k x) = ((λ j → k) , fr-refl x)
fr-refl (tvpr a b) = (fr-refl a , fr-refl b)
fr-refl (tvclo i ρ) = ((λ j → i) , (λ k → fr-refl (ρ k)))
fr-erefl : (ρ : Nat → TV) → FrEnv ρ ρ
fr-erefl ρ k = fr-refl (ρ k)
fr-trans : (x y z : TV) → fr-le x y → fr-le y z → fr-le x z
fr-trans tvbot y z p q = unit
fr-trans (tvw a) y z p q = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {tvw a} (sym p) q
fr-trans (tvb l) y z p q = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {tvb l} (sym p) q
fr-trans tvu y z p q = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {tvu} (sym p) q
fr-trans (tvc k x) (tvc j y) (tvc l z) p q = (catw (fst p) (fst q) , fr-trans x y z (snd p) (snd q))
fr-trans (tvc k x) (tvc j y) _ p q = Empty-rec q
fr-trans (tvc k x) _ z p q = Empty-rec p
fr-trans (tvpr a b) (tvpr c d) (tvpr e f) p q = (fr-trans a c e (fst p) (fst q) , fr-trans b d f (snd p) (snd q))
fr-trans (tvpr a b) (tvpr c d) _ p q = Empty-rec q
fr-trans (tvpr a b) _ z p q = Empty-rec p
fr-trans (tvclo i ρ) (tvclo j σ) (tvclo l τ) p q = (catw (fst p) (fst q) , (λ k → fr-trans (ρ k) (σ k) (τ k) (snd p k) (snd q k)))
fr-trans (tvclo i ρ) (tvclo j σ) _ p q = Empty-rec q
fr-trans (tvclo i ρ) _ z p q = Empty-rec p
-- a path on the left
fr-lpath : (x y z : TV) → x ≡ y → fr-le y z → fr-le x z
fr-lpath x y z e h = subst {lzero} {lzero} {TV} {λ v → fr-le v z} {y} {x} (sym e) h
fr-ext : (ρ σ : Nat → TV) (x x' : TV) → FrEnv ρ σ → fr-le x x' → FrEnv (text ρ x) (text σ x')
fr-ext ρ σ x x' he hx k = case k return (λ m → fr-le (text ρ x m) (text σ x' m)) of
  zero → hx
  suc m → he m
fr-none : FrEnv tvnone tvnone
fr-none k = unit
-- applied bottom up: the children rewritten, then the rule at the node; a case's alternatives keep
-- their chain (the rule at each body, not at the chain's nodes)
fr-kids : (FC → FC) → FC → FC
fr-kids f (fcl w) = fcl w
fr-kids f (fcv k) = fcv k
fr-kids f (fcp p a b) = fcp p (f (fr-kids f a)) (f (fr-kids f b))
fr-kids f (fcp1 p a) = fcp1 p (f (fr-kids f a))
fr-kids f (fclet a b) = fclet (f (fr-kids f a)) (f (fr-kids f b))
fr-kids f fcu = fcu
fr-kids f (fcpr a b) = fcpr (f (fr-kids f a)) (f (fr-kids f b))
fr-kids f (fcfst a) = fcfst (f (fr-kids f a))
fr-kids f (fcsnd a) = fcsnd (f (fr-kids f a))
fr-kids f (fccon d k a) = fccon d k (f (fr-kids f a))
fr-kids f (fccase s alts) = fccase (f (fr-kids f s)) (fr-kids f alts)
fr-kids f (fcalt k n b r) = fcalt k n (f (fr-kids f b)) (fr-kids f r)
fr-kids f fcnone = fcnone
fr-kids f (fcif c t e) = fcif (f (fr-kids f c)) (f (fr-kids f t)) (f (fr-kids f e))
fr-kids f (fcclo i) = fcclo i
fr-kids f (fcapp g a) = fcapp (f (fr-kids f g)) (f (fr-kids f a))
fr-kids f (fccall g m a) = fccall g m (f (fr-kids f a))
fr-kids f (fcby a) = fcby (f (fr-kids f a))
fr-kids f (fcld w b o) = fcld w (f (fr-kids f b)) (f (fr-kids f o))
fr-kids f (fcst w b o v) = fcst w (f (fr-kids f b)) (f (fr-kids f o)) (f (fr-kids f v))
fr-kids f (fcblen b) = fcblen (f (fr-kids f b))
fr-bu : (FC → FC) → FC → FC
fr-bu f c = f (fr-kids f c)
-- a table rewritten entry by entry
fr-tab : (FC → FC) → (Word → FC) → Word → FC
fr-tab f T i = fr-bu f (T i)
-- each operation keeps the order
fr-prim-le : (p : Word) (x x' y y' : TV) → fr-le x x' → fr-le y y' → fr-le (tv-prim p x y) (tv-prim p x' y')
fr-prim-le p (tvw a) x' (tvw b) y' hx hy = λ j → tv-prim p (hx j) (hy j)
fr-prim-le p _ x' _ y' hx hy = unit
fr-prim1-le : (p : Word) (x x' : TV) → fr-le x x' → fr-le (tv-prim1 p x) (tv-prim1 p x')
fr-prim1-le p (tvw a) x' hx = λ j → tv-prim1 p (hx j)
fr-prim1-le p _ x' hx = unit
fr-fst-le : (x x' : TV) → fr-le x x' → fr-le (tv-fst x) (tv-fst x')
fr-fst-le (tvpr a b) (tvpr c d) h = fst h
fr-fst-le (tvpr a b) _ h = Empty-rec h
fr-fst-le _ x' h = unit
fr-snd-le : (x x' : TV) → fr-le x x' → fr-le (tv-snd x) (tv-snd x')
fr-snd-le (tvpr a b) (tvpr c d) h = snd h
fr-snd-le (tvpr a b) _ h = Empty-rec h
fr-snd-le _ x' h = unit
fr-bytes-le : (x x' : TV) → fr-le x x' → fr-le (tv-bytes x) (tv-bytes x')
fr-bytes-le (tvw n) x' h = λ j → tv-bytes (h j)
fr-bytes-le _ x' h = unit
fr-ld-le : (w : Word) (x x' y y' : TV) → fr-le x x' → fr-le y y' → fr-le (tv-ld w x y) (tv-ld w x' y')
fr-ld-le w (tvb l) x' (tvw o) y' hx hy = λ j → tv-ld w (hx j) (hy j)
fr-ld-le w _ x' _ y' hx hy = unit
fr-st-le : (w : Word) (x x' y y' z z' : TV) → fr-le x x' → fr-le y y' → fr-le z z' → fr-le (tv-st w x y z) (tv-st w x' y' z')
fr-st-le w (tvb l) x' (tvw o) y' (tvw v) z' hx hy hz = λ j → tv-st w (hx j) (hy j) (hz j)
fr-st-le w _ x' _ y' _ z' hx hy hz = unit
fr-blen-le : (x x' : TV) → fr-le x x' → fr-le (tv-blen x) (tv-blen x')
fr-blen-le (tvb l) x' h = λ j → tv-blen (h j)
fr-blen-le _ x' h = unit
-- fields pushed: missing ones are ⊥ on both sides, so the order holds of the environments
fr-push-le : (n : Nat) (x x' : TV) (ρ σ : Nat → TV) → fr-le x x' → FrEnv ρ σ → FrEnv (tv-push n x ρ) (tv-push n x' σ)
fr-push-le zero x x' ρ σ hx he = he
fr-push-le (suc m) (tvpr a r) (tvpr c s) ρ σ hx he = fr-push-le m r s (text ρ a) (text σ c) (snd hx) (fr-ext ρ σ a c he (fst hx))
fr-push-le (suc m) (tvpr a r) _ ρ σ hx he = Empty-rec hx
fr-push-le (suc m) tvbot (tvpr c s) ρ σ hx he = fr-push-le m tvbot s (text ρ tvbot) (text σ c) unit (fr-ext ρ σ tvbot c he unit)
fr-push-le (suc m) tvbot x' ρ σ hx he = fr-push-le m tvbot tvbot (text ρ tvbot) (text σ tvbot) unit (fr-ext ρ σ tvbot tvbot he unit)
fr-push-le (suc m) (tvw a) x' ρ σ hx he =
  subst {lzero} {lzero} {TV} {λ v → FrEnv (tv-push (suc m) (tvw a) ρ) (tv-push (suc m) v σ)} {tvw a} {x'} hx
    (fr-push-le m tvbot tvbot (text ρ tvbot) (text σ tvbot) unit (fr-ext ρ σ tvbot tvbot he unit))
fr-push-le (suc m) (tvb l) x' ρ σ hx he =
  subst {lzero} {lzero} {TV} {λ v → FrEnv (tv-push (suc m) (tvb l) ρ) (tv-push (suc m) v σ)} {tvb l} {x'} hx
    (fr-push-le m tvbot tvbot (text ρ tvbot) (text σ tvbot) unit (fr-ext ρ σ tvbot tvbot he unit))
fr-push-le (suc m) tvu x' ρ σ hx he =
  subst {lzero} {lzero} {TV} {λ v → FrEnv (tv-push (suc m) tvu ρ) (tv-push (suc m) v σ)} {tvu} {x'} hx
    (fr-push-le m tvbot tvbot (text ρ tvbot) (text σ tvbot) unit (fr-ext ρ σ tvbot tvbot he unit))
fr-push-le (suc m) (tvc k y) (tvc j z) ρ σ hx he = fr-push-le m tvbot tvbot (text ρ tvbot) (text σ tvbot) unit (fr-ext ρ σ tvbot tvbot he unit)
fr-push-le (suc m) (tvc k y) _ ρ σ hx he = Empty-rec hx
fr-push-le (suc m) (tvclo i ρ1) (tvclo j σ1) ρ σ hx he = fr-push-le m tvbot tvbot (text ρ tvbot) (text σ tvbot) unit (fr-ext ρ σ tvbot tvbot he unit)
fr-push-le (suc m) (tvclo i ρ1) _ ρ σ hx he = Empty-rec hx
fr-pick-le : (bv : Bool) (a a' b b' : TV) → fr-le a a' → fr-le b b' → fr-le (tv-pick bv a b) (tv-pick bv a' b')
fr-pick-le true a a' b b' ha hb = ha
fr-pick-le false a a' b b' ha hb = hb
-- a case: the same alternatives on both sides, or each body rewritten (the chain kept: fr-kids)
-- a refinement keeps a whole tuple whole (its spine is pairs and unit, which refine only to themselves)
fr-tpick-le : (n : Nat) (x y A B : TV) → fr-le x y → fr-le A B → fr-le (tv-pick (tv-tup n x) A tvbot) (tv-pick (tv-tup n y) B tvbot)
fr-tpick-le zero tvu y A B hx hab = subst {lzero} {lzero} {TV} {λ v → fr-le (tv-pick (tv-tup zero tvu) A tvbot) (tv-pick (tv-tup zero v) B tvbot)} {tvu} {y} hx hab
fr-tpick-le zero (tvw a) y A B hx hab = unit
fr-tpick-le zero (tvc k z) y A B hx hab = unit
fr-tpick-le zero (tvclo i ρ) y A B hx hab = unit
fr-tpick-le zero tvbot y A B hx hab = unit
fr-tpick-le zero (tvb l) y A B hx hab = unit
fr-tpick-le zero (tvpr a r) y A B hx hab = unit
fr-tpick-le (suc m) (tvpr a r) (tvpr c d) A B hx hab = fr-tpick-le m r d A B (snd hx) hab
fr-tpick-le (suc m) (tvpr a r) (tvw w) A B hx hab = Empty-rec hx
fr-tpick-le (suc m) (tvpr a r) (tvc k z) A B hx hab = Empty-rec hx
fr-tpick-le (suc m) (tvpr a r) (tvclo i ρ) A B hx hab = Empty-rec hx
fr-tpick-le (suc m) (tvpr a r) tvbot A B hx hab = Empty-rec hx
fr-tpick-le (suc m) (tvpr a r) (tvb l) A B hx hab = Empty-rec hx
fr-tpick-le (suc m) (tvpr a r) tvu A B hx hab = Empty-rec hx
fr-tpick-le (suc m) (tvw a) y A B hx hab = unit
fr-tpick-le (suc m) (tvc k z) y A B hx hab = unit
fr-tpick-le (suc m) (tvclo i ρ) y A B hx hab = unit
fr-tpick-le (suc m) tvbot y A B hx hab = unit
fr-tpick-le (suc m) (tvb l) y A B hx hab = unit
fr-tpick-le (suc m) tvu y A B hx hab = unit
fr-alt-le : (ev ev' : FC → (Nat → TV) → TV) (ρ σ : Nat → TV) (v v' : TV) (l : Word) (n : Nat) (b b' : FC) (R R' : TV) → fr-le v v' → FrEnv ρ σ
          → ((r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev b r1) (ev' b' s1)) → fr-le R R'
          → fr-le (tv-alt ev ρ v l n b R) (tv-alt ev' σ v' l n b' R')
fr-alt-le ev ev' ρ σ (tvc k x) (tvc j y) l n b b' R R' hv he hb hr =
  subst {lzero} {lzero} {Word} {λ u → fr-le (tv-pick (weq k l) (tv-pick (tv-tup n x) (ev b (tv-push n x ρ)) tvbot) R) (tv-pick (weq u l) (tv-pick (tv-tup n y) (ev' b' (tv-push n y σ)) tvbot) R')} {k} {j} (fst hv)
    (fr-pick-le (weq k l) (tv-pick (tv-tup n x) (ev b (tv-push n x ρ)) tvbot) (tv-pick (tv-tup n y) (ev' b' (tv-push n y σ)) tvbot) R R'
      (fr-tpick-le n x y (ev b (tv-push n x ρ)) (ev' b' (tv-push n y σ)) (snd hv) (hb (tv-push n x ρ) (tv-push n y σ) (fr-push-le n x y ρ σ (snd hv) he))) hr)
fr-alt-le ev ev' ρ σ (tvc k x) _ l n b b' R R' hv he hb hr = Empty-rec hv
fr-alt-le ev ev' ρ σ v v' l n b b' R R' hv he hb hr = unit
fr-cases-le0 : (ev ev' : FC → (Nat → TV) → TV) (ρ σ : Nat → TV) (v v' : TV) (alts : FC) → fr-le v v' → FrEnv ρ σ
             → ((b : FC) (r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev b r1) (ev' b s1))
             → fr-le (tv-cases ev ρ v alts) (tv-cases ev' σ v' alts)
fr-cases-le0 ev ev' ρ σ v v' (fcalt l n b r) hv he hb =
  fr-alt-le ev ev' ρ σ v v' l n b b (tv-cases ev ρ v r) (tv-cases ev' σ v' r) hv he (λ r1 s1 h → hb b r1 s1 h) (fr-cases-le0 ev ev' ρ σ v v' r hv he hb)
fr-cases-le0 ev ev' ρ σ v v' alts hv he hb = unit
fr-cases-le : (f : FC → FC) (ev ev' : FC → (Nat → TV) → TV) (ρ σ : Nat → TV) (v v' : TV) (alts : FC) → fr-le v v' → FrEnv ρ σ
            → ((b : FC) (r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev b r1) (ev' (f (fr-kids f b)) s1))
            → fr-le (tv-cases ev ρ v alts) (tv-cases ev' σ v' (fr-kids f alts))
fr-cases-le f ev ev' ρ σ v v' (fcalt l n b r) hv he hb =
  fr-alt-le ev ev' ρ σ v v' l n b (f (fr-kids f b)) (tv-cases ev ρ v r) (tv-cases ev' σ v' (fr-kids f r)) hv he (λ r1 s1 h → hb b r1 s1 h) (fr-cases-le f ev ev' ρ σ v v' r hv he hb)
fr-cases-le f ev ev' ρ σ v v' alts hv he hb = unit
fr-if-le : (ev ev' : FC → (Nat → TV) → TV) (ρ σ : Nat → TV) (v v' : TV) (t e t' e' : FC) → fr-le v v' → FrEnv ρ σ
         → ((r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev t r1) (ev' t' s1))
         → ((r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev e r1) (ev' e' s1))
         → fr-le (tv-if ev ρ v t e) (tv-if ev' σ v' t' e')
fr-if-le ev ev' ρ σ (tvw w) v' t e t' e' hv he ht hf =
  subst {lzero} {lzero} {TV} {λ u → fr-le (tv-if ev ρ (tvw w) t e) (tv-if ev' σ u t' e')} {tvw w} {v'} hv
    (%welimP (λ u → fr-le (%welimP (λ u2 → TV) u (ev e ρ) (λ m h → ev t ρ)) (%welimP (λ u2 → TV) u (ev' e' σ) (λ m h → ev' t' σ))) w
       (hf ρ σ he) (λ m h → ht ρ σ he))
fr-if-le ev ev' ρ σ _ v' t e t' e' hv he ht hf = unit
fr-app-le : (T T' : Word → FC) (ev ev' : FC → (Nat → TV) → TV) (f f' a a' : TV) → fr-le f f' → fr-le a a'
          → ((i : Word) (r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (ev (T i) r1) (ev' (T' i) s1))
          → fr-le (tv-app T ev f a) (tv-app T' ev' f' a')
fr-app-le T T' ev ev' (tvclo i ρ1) (tvclo j σ1) a a' hf ha hb =
  subst {lzero} {lzero} {Word} {λ w → fr-le (ev (T i) (text ρ1 a)) (ev' (T' w) (text σ1 a'))} {i} {j} (fst hf)
    (hb i (text ρ1 a) (text σ1 a') (fr-ext ρ1 σ1 a a' (snd hf) ha))
fr-app-le T T' ev ev' (tvclo i ρ1) _ a a' hf ha hb = Empty-rec hf
fr-app-le T T' ev ev' _ f' a a' hf ha hb = unit
-- more fuel and a larger environment give a larger value
fr-addn : Nat → Nat → Nat
fr-addn zero k = k
fr-addn (suc n) k = suc (fr-addn n k)
fr-addn-0 : (n : Nat) → fr-addn n zero ≡ n
fr-addn-0 zero = λ j → zero
fr-addn-0 (suc n) = λ j → suc (fr-addn-0 n j)
fr-addn-1 : (n : Nat) → fr-addn n (suc zero) ≡ suc n
fr-addn-1 zero = λ j → suc zero
fr-addn-1 (suc n) = λ j → suc (fr-addn-1 n j)
fr-mono : (T GT : Word → FC) (n k : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT (fr-addn n k) c σ)
fr-mono T GT zero k c ρ σ he = unit
fr-mono T GT (suc n) k (fcl w) ρ σ he = λ j → tvw w
fr-mono T GT (suc n) k (fcv m) ρ σ he = he m
fr-mono T GT (suc n) k (fcp p a b) ρ σ he =
  fr-prim-le p (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (fr-mono T GT n k a ρ σ he) (fr-mono T GT n k b ρ σ he)
fr-mono T GT (suc n) k (fcp1 p a) ρ σ he = fr-prim1-le p (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (fr-mono T GT n k a ρ σ he)
fr-mono T GT (suc n) k (fclet a b) ρ σ he =
  fr-mono T GT n k b (text ρ (dtev T GT n a ρ)) (text σ (dtev T GT (fr-addn n k) a σ)) (fr-ext ρ σ (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) he (fr-mono T GT n k a ρ σ he))
fr-mono T GT (suc n) k fcu ρ σ he = λ j → tvu
fr-mono T GT (suc n) k (fcpr a b) ρ σ he = (fr-mono T GT n k a ρ σ he , fr-mono T GT n k b ρ σ he)
fr-mono T GT (suc n) k (fcfst a) ρ σ he = fr-fst-le (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (fr-mono T GT n k a ρ σ he)
fr-mono T GT (suc n) k (fcsnd a) ρ σ he = fr-snd-le (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (fr-mono T GT n k a ρ σ he)
fr-mono T GT (suc n) k (fccon d kk a) ρ σ he = ((λ j → kk) , fr-mono T GT n k a ρ σ he)
fr-mono T GT (suc n) k (fccase s alts) ρ σ he =
  fr-cases-le0 (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev T GT (fr-addn n k) c1 s1) ρ σ (dtev T GT n s ρ) (dtev T GT (fr-addn n k) s σ) alts
    (fr-mono T GT n k s ρ σ he) he (λ b r1 s1 h → fr-mono T GT n k b r1 s1 h)
fr-mono T GT (suc n) k (fcalt kk m b r) ρ σ he = unit
fr-mono T GT (suc n) k fcnone ρ σ he = unit
fr-mono T GT (suc n) k (fcif c t e) ρ σ he =
  fr-if-le (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev T GT (fr-addn n k) c1 s1) ρ σ (dtev T GT n c ρ) (dtev T GT (fr-addn n k) c σ) t e t e
    (fr-mono T GT n k c ρ σ he) he (λ r1 s1 h → fr-mono T GT n k t r1 s1 h) (λ r1 s1 h → fr-mono T GT n k e r1 s1 h)
fr-mono T GT (suc n) k (fcclo i) ρ σ he = ((λ j → i) , he)
fr-mono T GT (suc n) k (fcapp f a) ρ σ he =
  fr-app-le T T (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev T GT (fr-addn n k) c1 s1) (dtev T GT n f ρ) (dtev T GT (fr-addn n k) f σ) (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ)
    (fr-mono T GT n k f ρ σ he) (fr-mono T GT n k a ρ σ he) (λ i r1 s1 h → fr-mono T GT n k (T i) r1 s1 h)
fr-mono T GT (suc n) k (fccall g m a) ρ σ he =
  fr-mono T GT n k (GT g) (text tvnone (dtev T GT n a ρ)) (text tvnone (dtev T GT (fr-addn n k) a σ)) (fr-ext tvnone tvnone (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) fr-none (fr-mono T GT n k a ρ σ he))
fr-mono T GT (suc n) k (fcby a) ρ σ he = fr-bytes-le (dtev T GT n a ρ) (dtev T GT (fr-addn n k) a σ) (fr-mono T GT n k a ρ σ he)
fr-mono T GT (suc n) k (fcld w b o) ρ σ he =
  fr-ld-le w (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (dtev T GT n o ρ) (dtev T GT (fr-addn n k) o σ) (fr-mono T GT n k b ρ σ he) (fr-mono T GT n k o ρ σ he)
fr-mono T GT (suc n) k (fcst w b o v) ρ σ he =
  fr-st-le w (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (dtev T GT n o ρ) (dtev T GT (fr-addn n k) o σ) (dtev T GT n v ρ) (dtev T GT (fr-addn n k) v σ)
    (fr-mono T GT n k b ρ σ he) (fr-mono T GT n k o ρ σ he) (fr-mono T GT n k v ρ σ he)
fr-mono T GT (suc n) k (fcblen b) ρ σ he = fr-blen-le (dtev T GT n b ρ) (dtev T GT (fr-addn n k) b σ) (fr-mono T GT n k b ρ σ he)
-- at the same fuel, and at one or two units more
fr-same : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n c σ)
fr-same T GT n c ρ σ he = subst {lzero} {lzero} {Nat} {λ m → fr-le (dtev T GT n c ρ) (dtev T GT m c σ)} {fr-addn n zero} {n} (fr-addn-0 n) (fr-mono T GT n zero c ρ σ he)
fr-up1 : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT (suc n) c σ)
fr-up1 T GT n c ρ σ he = subst {lzero} {lzero} {Nat} {λ m → fr-le (dtev T GT n c ρ) (dtev T GT m c σ)} {fr-addn n (suc zero)} {suc n} (fr-addn-1 n) (fr-mono T GT n (suc zero) c ρ σ he)
fr-up2 : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT (suc (suc n)) c σ)
fr-up2 T GT n c ρ σ he = fr-trans (dtev T GT n c ρ) (dtev T GT (suc n) c σ) (dtev T GT (suc (suc n)) c σ) (fr-up1 T GT n c ρ σ he) (fr-up1 T GT (suc n) c σ σ (fr-erefl σ))
-- a rule: a function on forms, its result refining its argument for any tables
FRule : Type
FRule = (f : FC → FC) × ((T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (f c) σ))
fr-then : FRule → FRule → FRule
fr-then r1 r2 = ((λ c → fst r2 (fst r1 c)) ,
  (λ T GT n c ρ σ he → fr-trans (dtev T GT n c ρ) (dtev T GT n (fst r1 c) σ) (dtev T GT n (fst r2 (fst r1 c)) σ) (snd r1 T GT n c ρ σ he) (snd r2 T GT n (fst r1 c) σ σ (fr-erefl σ))))
-- constants folded: a primitive on literals is its value (every primitive, as dprim2 and dprim1 have them)
fr-fp : Word → FC → FC → FC
fr-fp p (fcl a) (fcl b) = fcl (dprim2 p a b)
fr-fp p a b = fcp p a b
fr-fp1 : Word → FC → FC
fr-fp1 p (fcl a) = fcl (dprim1 p a)
fr-fp1 p a = fcp1 p a
fr-f : FC → FC
fr-f (fcp p a b) = fr-fp p a b
fr-f (fcp1 p a) = fr-fp1 p a
fr-f c = c
fr-fp-ok : (T GT : Word → FC) (n : Nat) (p : Word) (a b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp p a b) ρ) (dtev T GT n (fr-fp p a b) σ)
fr-fp-ok T GT zero p a b ρ σ he = unit
fr-fp-ok T GT (suc zero) p (fcl a) (fcl b) ρ σ he = unit
fr-fp-ok T GT (suc (suc n)) p (fcl a) (fcl b) ρ σ he = λ j → tvw (dprim2 p a b)
fr-fp-ok T GT (suc n) p a b ρ σ he = fr-same T GT (suc n) (fcp p a b) ρ σ he
fr-fp1-ok : (T GT : Word → FC) (n : Nat) (p : Word) (a : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp1 p a) ρ) (dtev T GT n (fr-fp1 p a) σ)
fr-fp1-ok T GT zero p a ρ σ he = unit
fr-fp1-ok T GT (suc zero) p (fcl a) ρ σ he = unit
fr-fp1-ok T GT (suc (suc n)) p (fcl a) ρ σ he = λ j → tvw (dprim1 p a)
fr-fp1-ok T GT (suc n) p a ρ σ he = fr-same T GT (suc n) (fcp1 p a) ρ σ he
fr-f-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-f c) σ)
fr-f-ok T GT n (fcp p a b) ρ σ he = fr-fp-ok T GT n p a b ρ σ he
fr-f-ok T GT n (fcp1 p a) ρ σ he = fr-fp1-ok T GT n p a ρ σ he
fr-f-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
fold-frule : FRule
fold-frule = (fr-f , fr-f-ok)
-- 0 + x = x and x + 0 = x (the store's plusw-zero-l, plusw-zero-r through wadd-zero-l, wadd-zero-r)
fr-zl-v : (y y' : TV) → fr-le y y' → fr-le (tv-prim #0 (tvw #0) y) y'
fr-zl-v (tvw b) y' h = dtr {tvw (wadd #0 b)} {tvw b} {y'} (λ j → tvw (wadd-zero-l b j)) h
fr-zl-v _ y' h = unit
fr-zr-v : (x x' : TV) → fr-le x x' → fr-le (tv-prim #0 x (tvw #0)) x'
fr-zr-v (tvw a) x' h = dtr {tvw (wadd a #0)} {tvw a} {x'} (λ j → tvw (wadd-zero-r a j)) h
fr-zr-v _ x' h = unit
fr-zr : FC → FC → FC
fr-zr a (fcl w) = %welimP (λ v → FC) w a (λ m h → fcp #0 a (fcl (%wsucc m)))
fr-zr a b = fcp #0 a b
fr-z0 : FC → FC → FC
fr-z0 (fcl w) b = %welimP (λ v → FC) w b (λ m h → fr-zr (fcl (%wsucc m)) b)
fr-z0 a b = fr-zr a b
fr-zp : Word → FC → FC → FC
fr-zp p a b = %welimP (λ v → FC) p (fr-z0 a b) (λ m h → fcp (%wsucc m) a b)
fr-z : FC → FC
fr-z (fcp p a b) = fr-zp p a b
fr-z c = c
-- x + 0 at fuel n refines x at fuel n (one unit of fuel spent on the addition)
fr-zr0-ok : (T GT : Word → FC) (n : Nat) (a : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 a (fcl #0)) ρ) (dtev T GT n a σ)
fr-zr0-ok T GT zero a ρ σ he = unit
fr-zr0-ok T GT (suc zero) a ρ σ he = unit
fr-zr0-ok T GT (suc (suc n)) a ρ σ he = fr-zr-v (dtev T GT (suc n) a ρ) (dtev T GT (suc (suc n)) a σ) (fr-up1 T GT (suc n) a ρ σ he)
fr-zl0-ok : (T GT : Word → FC) (n : Nat) (b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 (fcl #0) b) ρ) (dtev T GT n b σ)
fr-zl0-ok T GT zero b ρ σ he = unit
fr-zl0-ok T GT (suc zero) b ρ σ he = unit
fr-zl0-ok T GT (suc (suc n)) b ρ σ he = fr-zl-v (dtev T GT (suc n) b ρ) (dtev T GT (suc (suc n)) b σ) (fr-up1 T GT (suc n) b ρ σ he)
fr-zr-ok : (T GT : Word → FC) (n : Nat) (a b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 a b) ρ) (dtev T GT n (fr-zr a b) σ)
fr-zr-ok T GT n a (fcl w) ρ σ he =
  %welimP (λ v → fr-le (dtev T GT n (fcp #0 a (fcl v)) ρ) (dtev T GT n (fr-zr a (fcl v)) σ)) w
    (fr-zr0-ok T GT n a ρ σ he)
    (λ m h → fr-same T GT n (fcp #0 a (fcl (%wsucc m))) ρ σ he)
fr-zr-ok T GT n a b ρ σ he = fr-same T GT n (fcp #0 a b) ρ σ he
fr-z0-ok : (T GT : Word → FC) (n : Nat) (a b : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcp #0 a b) ρ) (dtev T GT n (fr-z0 a b) σ)
fr-z0-ok T GT n (fcl w) b ρ σ he =
  %welimP (λ v → fr-le (dtev T GT n (fcp #0 (fcl v) b) ρ) (dtev T GT n (fr-z0 (fcl v) b) σ)) w
    (fr-zl0-ok T GT n b ρ σ he)
    (λ m h → fr-zr-ok T GT n (fcl (%wsucc m)) b ρ σ he)
fr-z0-ok T GT n a b ρ σ he = fr-zr-ok T GT n a b ρ σ he
fr-z-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-z c) σ)
fr-z-ok T GT n (fcp p a b) ρ σ he =
  %welimP (λ v → fr-le (dtev T GT n (fcp v a b) ρ) (dtev T GT n (fr-zp v a b) σ)) p
    (fr-z0-ok T GT n a b ρ σ he)
    (λ m h → fr-same T GT n (fcp (%wsucc m) a b) ρ σ he)
fr-z-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
zero-frule : FRule
zero-frule = (fr-z , fr-z-ok)
-- the byte layer: a load at the width and literal offset of the store below it is the stored value
-- (truncated to 32 bits at width 4); one disjoint from it the load from the string before the store,
-- itself forwarded the same way through the stores below it (lib/region.cub's rd-wr and rd-wr-disj;
-- lib/prim.cub's load64-store64 and load64-store64-disj, load32-store32 and its disj); a partial
-- overlap is left as it is
fr-pick : Bool → FC → FC → FC
fr-pick true x y = x
fr-pick false x y = y
fr-trunc : Word → FC → FC
fr-trunc w v = fr-pick (weq w #8) v (fcp1 #40 v)
fr-l1 : Word → FC → FC → FC
fr-l1 w2 (fcst w b (fcl o) v) (fcl o2) = fr-pick (dandb (weq w2 w) (weq o2 o)) (fr-trunc w v) (fr-pick (bl-disj w o w2 o2) (fr-l1 w2 b (fcl o2)) (fcld w2 (fcst w b (fcl o) v) (fcl o2)))
fr-l1 w2 s o2 = fcld w2 s o2
fr-l : FC → FC
fr-l (fcld w2 s o2) = fr-l1 w2 s o2
fr-l c = c
-- the stored value, truncated, refines the source's at one unit of fuel more
fr-tr-ok : (T GT : Word → FC) (b8 : Bool) (x : Word) (v : FC) (N : Nat) (σ : Nat → TV) → fr-le (tvw x) (dtev T GT N v σ)
         → fr-le (tvw (bsel b8 x (dprim1 #40 x))) (dtev T GT (suc N) (fr-pick b8 v (fcp1 #40 v)) σ)
fr-tr-ok T GT true x v N σ h = fr-trans (tvw x) (dtev T GT N v σ) (dtev T GT (suc N) v σ) h (fr-up1 T GT N v σ σ (fr-erefl σ))
fr-tr-ok T GT false x v N σ h = λ j → tv-prim1 #40 (h j)
fr-fwd-t : (w w2 o o2 : Word) (Bv Vv V2 R : TV) → dandb (weq w2 w) (weq o2 o) ≡ true → fr-le Vv V2
         → ((x : Word) → fr-le (tvw x) V2 → fr-le (tvw (dtrunc w x)) R) → fr-le (tv-ld w2 (tv-st w Bv (tvw o) Vv) (tvw o2)) R
fr-fwd-t w w2 o o2 (tvb l) (tvw x) V2 R e hv kk =
  dtr {tvw (bl-ld w2 o2 (bls w o (dtrunc w x) l))} {tvw (dtrunc w x)} {R}
    (λ j → tvw (bsel (e j) (dtrunc w x) (bsel (bl-disj w o w2 o2) (bl-ld w2 o2 l) (bl-bytes w2 o2 (bls w o (dtrunc w x) l))))) (kk x hv)
fr-fwd-t w w2 o o2 _ _ V2 R e hv kk = unit
fr-fwd-d : (w w2 o o2 : Word) (Bv Vv B2 : TV) → dandb (weq w2 w) (weq o2 o) ≡ false → bl-disj w o w2 o2 ≡ true → fr-le Bv B2
         → fr-le (tv-ld w2 (tv-st w Bv (tvw o) Vv) (tvw o2)) (tv-ld w2 B2 (tvw o2))
fr-fwd-d w w2 o o2 (tvb l) (tvw x) B2 es ed h =
  dtr {tvw (bl-ld w2 o2 (bls w o (dtrunc w x) l))} {tvw (bl-ld w2 o2 l)} {tv-ld w2 B2 (tvw o2)}
    (λ j → tvw (bsel (es j) (dtrunc w x) (bsel (ed j) (bl-ld w2 o2 l) (bl-bytes w2 o2 (bls w o (dtrunc w x) l))))) (λ j → tv-ld w2 (h j) (tvw o2))
fr-fwd-d w w2 o o2 _ _ B2 es ed h = unit
fr-fwd-ok : (T GT : Word → FC) (bs bd : Bool) (w w2 o o2 : Word) (b v : FC) → dandb (weq w2 w) (weq o2 o) ≡ bs → bl-disj w o w2 o2 ≡ bd
          → ((n1 : Nat) (r1 s1 : Nat → TV) → FrEnv r1 s1 → fr-le (dtev T GT n1 (fcld w2 b (fcl o2)) r1) (dtev T GT n1 (fr-l1 w2 b (fcl o2)) s1))
          → (n : Nat) (ρ σ : Nat → TV) → FrEnv ρ σ
          → fr-le (dtev T GT n (fcld w2 (fcst w b (fcl o) v) (fcl o2)) ρ) (dtev T GT n (fr-pick bs (fr-trunc w v) (fr-pick bd (fr-l1 w2 b (fcl o2)) (fcld w2 (fcst w b (fcl o) v) (fcl o2)))) σ)
fr-fwd-ok T GT true bd w w2 o o2 b v es ed rec zero ρ σ he = unit
fr-fwd-ok T GT true bd w w2 o o2 b v es ed rec (suc zero) ρ σ he = unit
fr-fwd-ok T GT true bd w w2 o o2 b v es ed rec (suc (suc zero)) ρ σ he = unit
fr-fwd-ok T GT true bd w w2 o o2 b v es ed rec (suc (suc (suc n))) ρ σ he =
  fr-fwd-t w w2 o o2 (dtev T GT (suc n) b ρ) (dtev T GT (suc n) v ρ) (dtev T GT (suc (suc n)) v σ) (dtev T GT (suc (suc (suc n))) (fr-trunc w v) σ) es
    (fr-up1 T GT (suc n) v ρ σ he) (λ x h → fr-tr-ok T GT (weq w #8) x v (suc (suc n)) σ h)
fr-fwd-ok T GT false true w w2 o o2 b v es ed rec zero ρ σ he = unit
fr-fwd-ok T GT false true w w2 o o2 b v es ed rec (suc zero) ρ σ he = unit
fr-fwd-ok T GT false true w w2 o o2 b v es ed rec (suc (suc zero)) ρ σ he = unit
fr-fwd-ok T GT false true w w2 o o2 b v es ed rec (suc (suc (suc n))) ρ σ he =
  fr-trans (dtev T GT (suc (suc (suc n))) (fcld w2 (fcst w b (fcl o) v) (fcl o2)) ρ) (dtev T GT (suc (suc (suc n))) (fcld w2 b (fcl o2)) σ) (dtev T GT (suc (suc (suc n))) (fr-l1 w2 b (fcl o2)) σ)
    (fr-fwd-d w w2 o o2 (dtev T GT (suc n) b ρ) (dtev T GT (suc n) v ρ) (dtev T GT (suc (suc n)) b σ) es ed (fr-up1 T GT (suc n) b ρ σ he))
    (rec (suc (suc (suc n))) σ σ (fr-erefl σ))
fr-fwd-ok T GT false false w w2 o o2 b v es ed rec n ρ σ he = fr-same T GT n (fcld w2 (fcst w b (fcl o) v) (fcl o2)) ρ σ he
fr-l1w-ok : (T GT : Word → FC) (s : FC) (w2 o2 : Word) (n : Nat) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcld w2 s (fcl o2)) ρ) (dtev T GT n (fr-l1 w2 s (fcl o2)) σ)
fr-l1w-ok T GT (fcst w b (fcl o) v) w2 o2 n ρ σ he =
  fr-fwd-ok T GT (dandb (weq w2 w) (weq o2 o)) (bl-disj w o w2 o2) w w2 o o2 b v (λ j → dandb (weq w2 w) (weq o2 o)) (λ j → bl-disj w o w2 o2)
    (λ n1 r1 s1 h1 → fr-l1w-ok T GT b w2 o2 n1 r1 s1 h1) n ρ σ he
fr-l1w-ok T GT s w2 o2 n ρ σ he = fr-same T GT n (fcld w2 s (fcl o2)) ρ σ he
fr-l1-ok : (T GT : Word → FC) (n : Nat) (w2 : Word) (s o2 : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n (fcld w2 s o2) ρ) (dtev T GT n (fr-l1 w2 s o2) σ)
fr-l1-ok T GT n w2 (fcst w b (fcl o) v) (fcl o2) ρ σ he = fr-l1w-ok T GT (fcst w b (fcl o) v) w2 o2 n ρ σ he
fr-l1-ok T GT n w2 s o2 ρ σ he = fr-same T GT n (fcld w2 s o2) ρ σ he
fr-l-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-l c) σ)
fr-l-ok T GT n (fcld w2 s o2) ρ σ he = fr-l1-ok T GT n w2 s o2 ρ σ he
fr-l-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
load-frule : FRule
load-frule = (fr-l , fr-l-ok)
-- a projection of a pair written out is its component; an if on a literal its branch
fr-pj : FC → FC
fr-pj (fcfst (fcpr a b)) = a
fr-pj (fcsnd (fcpr a b)) = b
fr-pj (fcif (fcl w) t e) = %welimP (λ v → FC) w e (λ m h → t)
fr-pj c = c
fr-pj-ok : (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev T GT n (fr-pj c) σ)
fr-pj-ok T GT zero (fcfst (fcpr a b)) ρ σ he = unit
fr-pj-ok T GT (suc zero) (fcfst (fcpr a b)) ρ σ he = unit
fr-pj-ok T GT (suc (suc n)) (fcfst (fcpr a b)) ρ σ he = fr-up2 T GT n a ρ σ he
fr-pj-ok T GT zero (fcsnd (fcpr a b)) ρ σ he = unit
fr-pj-ok T GT (suc zero) (fcsnd (fcpr a b)) ρ σ he = unit
fr-pj-ok T GT (suc (suc n)) (fcsnd (fcpr a b)) ρ σ he = fr-up2 T GT n b ρ σ he
fr-pj-ok T GT zero (fcif (fcl w) t e) ρ σ he = unit
fr-pj-ok T GT (suc zero) (fcif (fcl w) t e) ρ σ he = unit
fr-pj-ok T GT (suc (suc n)) (fcif (fcl w) t e) ρ σ he =
  %welimP (λ u → fr-le (%welimP (λ u2 → TV) u (dtev T GT (suc n) e ρ) (λ m h → dtev T GT (suc n) t ρ)) (dtev T GT (suc (suc n)) (%welimP (λ u2 → FC) u e (λ m h → t)) σ)) w
    (fr-up1 T GT (suc n) e ρ σ he) (λ m h → fr-up1 T GT (suc n) t ρ σ he)
fr-pj-ok T GT n c ρ σ he = fr-same T GT n c ρ σ he
proj-frule : FRule
proj-frule = (fr-pj , fr-pj-ok)
-- the rules of this file over the converted mirror: std-vrule's two (folding first, as there), the
-- byte layer's forwarding, and the projections and ifs it leaves known
std-frule : FRule
std-frule = fr-then (fr-then (fr-then fold-frule zero-frule) load-frule) proj-frule
-- one step of congruence: the node with its children rewritten (the tables too) refines the node,
-- given that at one unit of fuel less every form's rewrite refines it
FrIH : (FC → FC) → (Word → FC) → (Word → FC) → Nat → Type
FrIH f T GT n = (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f c) σ)
fr-cong : (f : FC → FC) (T GT : Word → FC) (n : Nat) → FrIH f T GT n → (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ
        → fr-le (dtev T GT (suc n) c ρ) (dtev (fr-tab f T) (fr-tab f GT) (suc n) (fr-kids f c) σ)
fr-cong f T GT n ih (fcl w) ρ σ he = λ j → tvw w
fr-cong f T GT n ih (fcv k) ρ σ he = he k
fr-cong f T GT n ih (fcp p a b) ρ σ he =
  fr-prim-le p (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (ih a ρ σ he) (ih b ρ σ he)
fr-cong f T GT n ih (fcp1 p a) ρ σ he = fr-prim1-le p (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (ih a ρ σ he)
fr-cong f T GT n ih (fclet a b) ρ σ he =
  ih b (text ρ (dtev T GT n a ρ)) (text σ (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ))
     (fr-ext ρ σ (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) he (ih a ρ σ he))
fr-cong f T GT n ih fcu ρ σ he = λ j → tvu
fr-cong f T GT n ih (fcpr a b) ρ σ he = (ih a ρ σ he , ih b ρ σ he)
fr-cong f T GT n ih (fcfst a) ρ σ he = fr-fst-le (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (ih a ρ σ he)
fr-cong f T GT n ih (fcsnd a) ρ σ he = fr-snd-le (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (ih a ρ σ he)
fr-cong f T GT n ih (fccon d k a) ρ σ he = ((λ j → k) , ih a ρ σ he)
fr-cong f T GT n ih (fccase s alts) ρ σ he =
  fr-cases-le f (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev (fr-tab f T) (fr-tab f GT) n c1 s1) ρ σ (dtev T GT n s ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f s) σ) alts
    (ih s ρ σ he) he (λ b r1 s1 h → ih b r1 s1 h)
fr-cong f T GT n ih (fcalt k m b r) ρ σ he = unit
fr-cong f T GT n ih fcnone ρ σ he = unit
fr-cong f T GT n ih (fcif c t e) ρ σ he =
  fr-if-le (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev (fr-tab f T) (fr-tab f GT) n c1 s1) ρ σ (dtev T GT n c ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f c) σ)
    t e (fr-bu f t) (fr-bu f e) (ih c ρ σ he) he (λ r1 s1 h → ih t r1 s1 h) (λ r1 s1 h → ih e r1 s1 h)
fr-cong f T GT n ih (fcclo i) ρ σ he = ((λ j → i) , he)
fr-cong f T GT n ih (fcapp g a) ρ σ he =
  fr-app-le T (fr-tab f T) (λ c1 s1 → dtev T GT n c1 s1) (λ c1 s1 → dtev (fr-tab f T) (fr-tab f GT) n c1 s1)
    (dtev T GT n g ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f g) σ) (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ)
    (ih g ρ σ he) (ih a ρ σ he) (λ i r1 s1 h → ih (T i) r1 s1 h)
fr-cong f T GT n ih (fccall g m a) ρ σ he =
  ih (GT g) (text tvnone (dtev T GT n a ρ)) (text tvnone (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ))
     (fr-ext tvnone tvnone (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) fr-none (ih a ρ σ he))
fr-cong f T GT n ih (fcby a) ρ σ he = fr-bytes-le (dtev T GT n a ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f a) σ) (ih a ρ σ he)
fr-cong f T GT n ih (fcld w b o) ρ σ he =
  fr-ld-le w (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (dtev T GT n o ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f o) σ) (ih b ρ σ he) (ih o ρ σ he)
fr-cong f T GT n ih (fcst w b o v) ρ σ he =
  fr-st-le w (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (dtev T GT n o ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f o) σ)
    (dtev T GT n v ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f v) σ) (ih b ρ σ he) (ih o ρ σ he) (ih v ρ σ he)
fr-cong f T GT n ih (fcblen b) ρ σ he = fr-blen-le (dtev T GT n b ρ) (dtev (fr-tab f T) (fr-tab f GT) n (fr-bu f b) σ) (ih b ρ σ he)
-- sound by congruence: the bottom-up rewrite of any form, with both tables rewritten, refines it at
-- every fuel (the rule at each node through its own soundness, at the rewritten tables)
fr-bu-ok : (r : FRule) (T GT : Word → FC) (n : Nat) (c : FC) (ρ σ : Nat → TV) → FrEnv ρ σ → fr-le (dtev T GT n c ρ) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) n (fr-bu (fst r) c) σ)
fr-bu-ok r T GT zero c ρ σ he = unit
fr-bu-ok r T GT (suc n) c ρ σ he =
  fr-trans (dtev T GT (suc n) c ρ) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) (suc n) (fr-kids (fst r) c) σ) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) (suc n) (fr-bu (fst r) c) σ)
    (fr-cong (fst r) T GT n (λ c1 r1 s1 h1 → fr-bu-ok r T GT n c1 r1 s1 h1) c ρ σ he)
    (snd r (fr-tab (fst r) T) (fr-tab (fst r) GT) (suc n) (fr-kids (fst r) c) σ σ (fr-erefl σ))
-- the data route's path: for a program read into the mirror with right tables (DGOK, DTok, decided
-- per program by dtok-auto), the rewritten conversion refines the source at every fuel, for every
-- good argument
fr-dc-path : (r : FRule) (G : Word → DC) (T GT : Word → FC) → DGOK G T GT → (n : Nat) (c : DC) (x : DV) → DTok T c → dgood T x
           → fr-le (derase (dsev G n c (dext dvnone x))) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) n (fr-bu (fst r) (dconv c)) (denv (dext dvnone x)))
fr-dc-path r G T GT go n c x tk gx =
  fr-lpath (derase (dsev G n c (dext dvnone x))) (dtev T GT n (dconv c) (denv (dext dvnone x))) (dtev (fr-tab (fst r) T) (fr-tab (fst r) GT) n (fr-bu (fst r) (dconv c)) (denv (dext dvnone x)))
    (snd (dc-sound G T GT go n c (dext dvnone x) tk (dge-ext T dvnone x (λ k → unit) gx)))
    (fr-bu-ok r T GT n (dconv c) (denv (dext dvnone x)) (denv (dext dvnone x)) (fr-erefl (denv (dext dvnone x))))
-- ---------------------------------------------------------------- an example with data, a closure and a call
-- def #1 x = let f = λ#0 y. y + x in case con 1 (f 3, call #2 x) of 0 → 0 | 1 p q → p + q ;  def #2 x = x + x
dx-body1 : DC
dx-body1 = dclet (dclam #0 (dcp #0 (dcv 0) (dcv 1))) (dccase (dccon #0 #1 (dcpr (dcapp (dcv 0) (dcl #3)) (dcpr (dccall #2 #1 (dcv 1)) dcu))) (dcalt #0 0 (dcl #0) (dcalt #1 2 (dcp #0 (dcv 1) (dcv 0)) dcnone)))
dx-body2 : DC
dx-body2 = dcp #0 (dcv 0) (dcv 0)
dx-main : DC
dx-main = dccall #1 #1 (dcl #4)
dx-G : Word → DC
dx-G g = %welimP (λ v → DC) g (dcl #0) (λ m h → %welimP (λ v → DC) m dx-body1 (λ m2 h2 → %welimP (λ v → DC) m2 dx-body2 (λ m3 h3 → dcl #0)))
-- the lifted table: λ#0's body converted
dx-T : Word → FC
dx-T i = %welimP (λ v → FC) i (fcp #0 (fcv 0) (fcv 1)) (λ m h → fcl #0)
dx-GT : Word → FC
dx-GT g = dconv (dx-G g)
dx-gok : DGOK dx-G dx-T dx-GT
dx-gok g = ((λ i → dx-GT g) ,
  %welimP (λ v → DTok dx-T (dx-G v)) g unit
    (λ m h → %welimP (λ v → DTok dx-T (dx-G (%wsucc v))) m (dtok-auto dx-T dx-body1 (λ i → true))
      (λ m2 h2 → %welimP (λ v → DTok dx-T (dx-G (%wsucc (%wsucc v)))) m2 (dtok-auto dx-T dx-body2 (λ i → true)) (λ m3 h3 → unit))))
-- the justifying path: the converted program means what the source does, at every fuel
dx-path : (n : Nat) → derase (dsev dx-G n dx-main dvnone) ≡ dtev dx-T dx-GT n (dconv dx-main) tvnone
dx-path n = snd (dc-sound dx-G dx-T dx-GT dx-gok n dx-main dvnone unit (λ k → unit))
dnat : Word → Nat
dnat w = %welimP (λ v → Nat) w zero (λ m h → suc h)
-- readings: the source and its conversion run to the same value (4 + 3 = 7, 4 + 4 = 8, 7 + 8 = 15)
#same dsev dx-G (dnat #30) dx-main dvnone = dvw #15
#same dtev dx-T dx-GT (dnat #30) (dconv dx-main) tvnone = tvw #15
#same dconv dx-body1 = fclet (fcclo #0) (fccase (fccon #0 #1 (fcpr (fcapp (fcv 0) (fcl #3)) (fcpr (fccall #2 #1 (fcv 1)) fcu))) (fcalt #0 0 (fcl #0) (fcalt #1 2 (fcp #0 (fcv 1) (fcv 0)) fcnone)))
-- out of fuel both sides are ⊥, as the theorem says they must agree
#same dsev dx-G (dnat #3) dx-main dvnone = dvbot
#same dtev dx-T dx-GT (dnat #3) (dconv dx-main) tvnone = tvbot
-- ---------------------------------------------------------------- the bridge to the first-order form
-- (a checked translation into FQ, lib/foproof.cub's checked mirror of the first-order form, which
-- fq-to-fo prints constructor for constructor; lib/foproofq.cub proves it right). At depth d (the number
-- of variables in scope): a closure reference captures every variable, x_{d-1} first, so that the
-- lifted body (key dc-base + i, arity d + 1) sees the argument then x_0 … x_{d-1}, as dext does; a
-- call passes its arguments (a tuple's components for more than one); a constructor its tuple's
-- components as fields; a case pushes them as fswitch does (the last field innermost, as dccase);
-- pairs are lib/fo.cub's (constructor 0 of data type 0, two fields); Int64 and Float64 operations
-- take and give words of bits, the machine's operation between the conversions
fc-caps d = case d of zero → lnil; suc k → lcons (fvar (fromNat k)) (fc-caps k)
-- the lifted bodies' keys: dc-base + i (above any definition the bridge reads from the store, below the
-- recursions it lifts (dc-lbase) and the printers' closure tags, which add 1000000 to a key)
dcbase : Word
dcbase = #500000
dc-base = dcbase
dc-lbase = #700000
fo-1 p a = fprim p (lcons a lnil)
fo-2 p a b = fprim p (lcons a (lcons b lnil))
fo-i64 x = fo-1 P-i64ofw x
fo-w64 x = fo-1 P-wofi64 x
fo-f64 x = fo-1 P-f64ofbits (fo-i64 x)
fo-wf x = fo-w64 (fo-1 P-f64bits x)
fc-prim2 p a b =
  if %wlt p #5 then fo-2 p a b
  else if %wlt p #17 then fo-w64 (fo-2 p (fo-i64 a) (fo-i64 b))
  else if %wlt p #19 then fo-2 p (fo-i64 a) (fo-i64 b)
  else if %wlt p #23 then fo-wf (fo-2 p (fo-f64 a) (fo-f64 b))
  else fo-2 p (fo-f64 a) (fo-f64 b)
-- (40, the low 32 bits: a 4-byte store into a scratch string and the load back)
fc-prim1 p a =
  if %weq p #27 then fo-wf (fo-1 P-f64ofi64 (fo-i64 a))
  else if %weq p #28 then fo-w64 (fo-1 P-i64off64 (fo-f64 a))
  else if %weq p #29 then fo-wf (fo-1 P-f64ofw a)
  else if %weq p #40 then fo-2 P-load32 (fprim P-store32 (lcons (fo-1 P-bytes (flit #4)) (lcons (flit #0) (lcons a lnil)))) (flit #0)
  else a
dadd d n = case n of zero → d; suc m → suc (dadd d m)
-- the printer, checked: in mode qmt a term, qmf a tuple's components as a chain (a constructor's
-- fields, a call's arguments), qma a case's alternatives
data QMd = qmt | qmf | qma
qadd : Nat → Nat → Nat
qadd d zero = d
qadd d (suc m) = suc (qadd d m)
fq-caps : Nat → FQ
fq-caps zero = fqnil
fq-caps (suc k) = fqcons (fqv k) (fq-caps k)
fq-i64 : FQ → FQ
fq-i64 x = fqprim #25 (fq1 x)
fq-w64 : FQ → FQ
fq-w64 x = fqprim #26 (fq1 x)
fq-f64 : FQ → FQ
fq-f64 x = fqprim #33 (fq1 (fq-i64 x))
fq-wf : FQ → FQ
fq-wf x = fq-w64 (fqprim #32 (fq1 x))
-- (each by the classes' booleans, so a proof about every primitive cases on four booleans)
fq-p2b : Bool → Bool → Bool → Bool → Word → FQ → FQ → FQ
fq-p2b true b2 b3 b4 p a b = fqprim p (fq2 a b)
fq-p2b false true b3 b4 p a b = fq-w64 (fqprim p (fq2 (fq-i64 a) (fq-i64 b)))
fq-p2b false false true b4 p a b = fqprim p (fq2 (fq-i64 a) (fq-i64 b))
fq-p2b false false false true p a b = fq-wf (fqprim p (fq2 (fq-f64 a) (fq-f64 b)))
fq-p2b false false false false p a b = fqprim p (fq2 (fq-f64 a) (fq-f64 b))
fq-p2 : Word → FQ → FQ → FQ
fq-p2 p a b = fq-p2b (wlt p #5) (wlt p #17) (wlt p #19) (wlt p #23) p a b
-- (40, the low 32 bits: a 4-byte store into a scratch string and the load back)
fq-p1b : Bool → Bool → Bool → Bool → FQ → FQ
fq-p1b true b2 b3 b4 a = fq-wf (fqprim #27 (fq1 (fq-i64 a)))
fq-p1b false true b3 b4 a = fq-w64 (fqprim #28 (fq1 (fq-f64 a)))
fq-p1b false false true b4 a = fq-wf (fqprim #29 (fq1 a))
fq-p1b false false false true a = fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #4))) (fql #0) a)) (fql #0))
fq-p1b false false false false a = a
fq-p1 : Word → FQ → FQ
fq-p1 p a = fq-p1b (weq p #27) (weq p #28) (weq p #29) (weq p #40) a
fcq : FC → QMd → Nat → FQ
fcq (fcl w) qmt d = fql w
fcq (fcv n) qmt d = fqv n
fcq (fcp p a b) qmt d = fq-p2 p (fcq a qmt d) (fcq b qmt d)
fcq (fcp1 p a) qmt d = fq-p1 p (fcq a qmt d)
fcq (fclet a b) qmt d = fqlet (fcq a qmt d) (fcq b qmt (suc d))
fcq fcu qmt d = fql #0
fcq (fcpr a b) qmt d = fqcon #0 #0 (fq2 (fcq a qmt d) (fcq b qmt d))
fcq (fcfst a) qmt d = fqproj #0 #0 #0 (fcq a qmt d)
fcq (fcsnd a) qmt d = fqproj #0 #0 #1 (fcq a qmt d)
fcq (fccon dd k a) qmt d = fqcon dd k (fcq a qmf d)
fcq (fccase x alts) qmt d = fqsw (fcq x qmt d) (fcq alts qma d)
fcq (fcalt k n b r) qmt d = fqnet
fcq fcnone qmt d = fqnet
fcq (fcif c a b) qmt d = fqif (fcq c qmt d) (fcq a qmt d) (fcq b qmt d)
fcq (fcclo i) qmt d = fqclos (wadd dcbase i) (fq-caps d)
fcq (fcapp f a) qmt d = fqapp (fcq f qmt d) (fq1 (fcq a qmt d))
fcq (fccall g m a) qmt d = fqcall g (if weq m #0 then fqnil else (if weq m #1 then fq1 (fcq a qmt d) else fcq a qmf d))
fcq (fcby a) qmt d = fqprim #12 (fq1 (fcq a qmt d))
fcq (fcld w b o) qmt d = if weq w #8 then fq-w64 (fqprim #8 (fq2 (fcq b qmt d) (fcq o qmt d))) else fqprim #10 (fq2 (fcq b qmt d) (fcq o qmt d))
fcq (fcst w b o v) qmt d = if weq w #8 then fqprim #9 (fq3 (fcq b qmt d) (fcq o qmt d) (fq-i64 (fcq v qmt d))) else fqprim #11 (fq3 (fcq b qmt d) (fcq o qmt d) (fcq v qmt d))
fcq (fcblen b) qmt d = fqprim #13 (fq1 (fcq b qmt d))
fcq (fcpr x r) qmf d = fqcons (fcq x qmt d) (fcq r qmf d)
fcq (fcl w) qmf d = fqnil
fcq (fcv n) qmf d = fqnil
fcq (fcp p a b) qmf d = fqnil
fcq (fcp1 p a) qmf d = fqnil
fcq (fclet a b) qmf d = fqnil
fcq fcu qmf d = fqnil
fcq (fcfst a) qmf d = fqnil
fcq (fcsnd a) qmf d = fqnil
fcq (fccon dd k a) qmf d = fqnil
fcq (fccase x alts) qmf d = fqnil
fcq (fcalt k n b r) qmf d = fqnil
fcq fcnone qmf d = fqnil
fcq (fcif c a b) qmf d = fqnil
fcq (fcclo i) qmf d = fqnil
fcq (fcapp f a) qmf d = fqnil
fcq (fccall g m a) qmf d = fqnil
fcq (fcby a) qmf d = fqnil
fcq (fcld w b o) qmf d = fqnil
fcq (fcst w b o v) qmf d = fqnil
fcq (fcblen b) qmf d = fqnil
fcq (fcalt k n b r) qma d = fqalt k n (fcq b qmt (qadd d n)) (fcq r qma d)
fcq (fcl w) qma d = fqanone
fcq (fcv n) qma d = fqanone
fcq (fcp p a b) qma d = fqanone
fcq (fcp1 p a) qma d = fqanone
fcq (fclet a b) qma d = fqanone
fcq fcu qma d = fqanone
fcq (fcpr x r) qma d = fqanone
fcq (fcfst a) qma d = fqanone
fcq (fcsnd a) qma d = fqanone
fcq (fccon dd k a) qma d = fqanone
fcq (fccase x alts) qma d = fqanone
fcq fcnone qma d = fqanone
fcq (fcif c a b) qma d = fqanone
fcq (fcclo i) qma d = fqanone
fcq (fcapp f a) qma d = fqanone
fcq (fccall g m a) qma d = fqanone
fcq (fcby a) qma d = fqanone
fcq (fcld w b o) qma d = fqanone
fcq (fcst w b o v) qma d = fqanone
fcq (fcblen b) qma d = fqanone
fc-to-fq : Nat → FC → FQ
fc-to-fq d t = fcq t qmt d
-- a definition of m parameters: the mirror's body sees one value (the argument for m = 1, the tuple
-- of them otherwise), rebuilt from the parameters (the first deepest)
fq-tupn : Nat → FQ
fq-tupn zero = fql #0
fq-tupn (suc j) = fqcon #0 #0 (fq2 (fqv j) (fq-tupn j))
fq-def-body : Word → FC → FQ
fq-def-body m b = if weq m #1 then fc-to-fq (suc zero) b else fqlet (fq-tupn (dnat m)) (fc-to-fq (suc zero) b)
fc-to-fo d t = fq-to-fo (fc-to-fq d t)
fc-def-body m b = fq-to-fo (fq-def-body m b)
-- the untyped printer this replaced, kept for the readings that show the checked one prints the same
fc-to-fo-ref d t =
  case t of
    fcl w → flit w
    fcv n → fvar (fromNat n)
    fcp p a b → fc-prim2 p (fc-to-fo-ref d a) (fc-to-fo-ref d b)
    fcp1 p a → fc-prim1 p (fc-to-fo-ref d a)
    fclet a b → flet (fc-to-fo-ref d a) (fc-to-fo-ref (suc d) b)
    fcu → flit #0
    fcpr a b → fcon #0 #0 (lcons (fc-to-fo-ref d a) (lcons (fc-to-fo-ref d b) lnil))
    fcfst a → fproj #0 #0 #0 (fc-to-fo-ref d a)
    fcsnd a → fproj #0 #0 #1 (fc-to-fo-ref d a)
    fccon dd k a → fcon dd k (fc-fields-ref d a)
    fccase s alts → fswitch (fc-to-fo-ref d s) (fc-alts-ref d alts)
    fcif c th el → fif (fc-to-fo-ref d c) (fc-to-fo-ref d th) (fc-to-fo-ref d el)
    fcclo i → fclos (%wadd dc-base i) (fc-caps d)
    fcapp f a → fapply (fc-to-fo-ref d f) (lcons (fc-to-fo-ref d a) lnil)
    fccall g m a → fcall g (fc-args-ref d m a)
    fcby a → fo-1 P-bytes (fc-to-fo-ref d a)
    fcld w b o → (if %weq w #8 then fo-w64 (fo-2 P-load64 (fc-to-fo-ref d b) (fc-to-fo-ref d o)) else fo-2 P-load32 (fc-to-fo-ref d b) (fc-to-fo-ref d o))
    fcst w b o v → (if %weq w #8 then fprim P-store64 (lcons (fc-to-fo-ref d b) (lcons (fc-to-fo-ref d o) (lcons (fo-i64 (fc-to-fo-ref d v)) lnil)))
                    else fprim P-store32 (lcons (fc-to-fo-ref d b) (lcons (fc-to-fo-ref d o) (lcons (fc-to-fo-ref d v) lnil))))
    fcblen b → fo-1 P-blen (fc-to-fo-ref d b)
    _ → fnet #0 lnil
fc-fields-ref d a = case a of fcpr x r → lcons (fc-to-fo-ref d x) (fc-fields-ref d r); _ → lnil
fc-args-ref d m a = if %weq m #0 then lnil else (if %weq m #1 then lcons (fc-to-fo-ref d a) lnil else fc-fields-ref d a)
fc-alts-ref d alts = case alts of fcalt k n b r → lcons (k , (fromNat n , fc-to-fo-ref (dadd d n) b)) (fc-alts-ref d r); _ → lnil
-- a definition of m parameters: the mirror's body sees one value (the argument for m = 1, the tuple
-- of them otherwise), rebuilt from the parameters (the first deepest)
fc-tup k = if %weq k #0 then flit #0 else fcon #0 #0 (lcons (fvar (%wsub k #1)) (lcons (fc-tup (%wsub k #1)) lnil))
fc-def-body-ref m b = if %weq m #1 then fc-to-fo-ref (suc zero) b else flet (fc-tup m) (fc-to-fo-ref (suc zero) b)
-- the lifted table, read off the source: each λ i b at depth d gives entry dc-base + i
dc-lifts-q d c =
  case c of
    dcp p a b → lst-app (dc-lifts-q d a) (dc-lifts-q d b)
    dcp1 p a → dc-lifts-q d a
    dclet a b → lst-app (dc-lifts-q d a) (dc-lifts-q (suc d) b)
    dcpr a b → lst-app (dc-lifts-q d a) (dc-lifts-q d b)
    dcfst a → dc-lifts-q d a
    dcsnd a → dc-lifts-q d a
    dccon dd k a → dc-lifts-q d a
    dccase s alts → lst-app (dc-lifts-q d s) (dc-lifts-q d alts)
    dcalt k n b r → lst-app (dc-lifts-q (dadd d n) b) (dc-lifts-q d r)
    dcif c t e → lst-app (dc-lifts-q d c) (lst-app (dc-lifts-q d t) (dc-lifts-q d e))
    dclam i b → lcons (%wadd dc-base i , (fromNat (suc d) , fc-to-fq (suc d) (fr-bu (fst std-frule) (dconv b)))) (dc-lifts-q (suc d) b)
    dcapp f a → lst-app (dc-lifts-q d f) (dc-lifts-q d a)
    dccall g m a → dc-lifts-q d a
    dcby a → dc-lifts-q d a
    dcld w b o → lst-app (dc-lifts-q d b) (dc-lifts-q d o)
    dcst w b o v → lst-app (dc-lifts-q d b) (lst-app (dc-lifts-q d o) (dc-lifts-q d v))
    dcblen b → dc-lifts-q d b
    _ → lnil
-- a table whose bodies are FQ, printed
dq-fo ds = case ds of lnil → lnil; lcons e r → lcons (fst e , (fst (snd e) , fq-to-fo (snd (snd e)))) (dq-fo r)
dc-lifts d c = dq-fo (dc-lifts-q d c)
-- a program, a Lst of (key , (arity , body)) with main #0 (its arity's parameters as variables) and
-- the definitions (one value each, as above), as first-order definitions, the rules applied
dc-rw c = fr-bu (fst std-frule) (dconv c)
dc-defs-q ds = case ds of lnil → lnil; lcons e r → lcons (dc-def1-q e) (lst-app (dc-lifts-q (dc-depth e) (snd (snd e))) (dc-defs-q r))
dc-def1-q e = if %weq (fst e) #0 then (#0 , (fst (snd e) , fc-to-fq (dnat (fst (snd e))) (dc-rw (snd (snd e))))) else (fst e , (fst (snd e) , fq-def-body (fst (snd e)) (dc-rw (snd (snd e)))))
dc-defs ds = dq-fo (dc-defs-q ds)
dc-depth e = if %weq (fst e) #0 then dnat (fst (snd e)) else suc zero
dx-prog = lcons (#0 , (#0 , dx-main)) (lcons (#1 , (#1 , dx-body1)) (lcons (#2 , (#1 , dx-body2)) lnil))
#same eval-fo (table-of (dc-defs dx-prog)) lnil (fc-to-fo zero (dconv dx-main)) = vw #15
#same eval-fo (table-of (dc-defs dx-prog)) (lcons (vw #10) lnil) (fc-to-fo (suc zero) (dconv dx-body1)) = vw #33
#same dtev dx-T dx-GT (dnat #30) (dconv dx-body1) (text tvnone (tvw #10)) = tvw #33
-- ---------------------------------------------------------------- the bridge from codes into DC
-- dc-of reads a Code into the data mirror (untyped, like wc-of), at a depth (the variables in scope),
-- threading a state (the next λ number, the next key for a lifted recursion, the lifted definitions):
-- words and their operations (max as a let and an if), successor, every primitive lib/lower.cub
-- lowers (Int64's, UInt32's as words, Float64's, by their bits; the conversions that keep bits are
-- not nodes), let, pairs and projections, Bool as 1 and 0 with if, constructors of any data type
-- (path constructors aside) and cases on them, λ, application, globals applied to any number of
-- arguments (their erased parameters passed unit, a partial application η-expanded), the byte layer
-- (a fresh string of a literal length, loads and stores of 4 and 8 bytes at literal offsets).
-- A case on a type with recursive fields, and a word recursion, become definitions of their own
-- (keys from dc-lbase), called with the scrutinee (or the loop's state) and every variable in scope
-- as a tuple, the hypotheses (the next iteration) calls of the same definition.
dc-then r f = case r of some x → f (fst x) (snd x); none → none
dc-nolist l = case l of lnil → true; _ → false
-- the state: (next λ , (next lifted key , lifted definitions))
dc-st0 = (#0 , (dc-lbase , lnil))
dc-lam-n st = fst st
dc-lam-next st = (%wsucc (fst st) , snd st)
dc-lk st = fst (snd st)
dc-lift st e = (fst st , (%wsucc (fst (snd st)) , lcons e (snd (snd st))))
-- shifting a code's variables at or above c by k (the bridge places a code under binders)
dc-sh c k t =
  case t of
    dcv n → (if %wlt (fromNat n) c then t else dcv (toNat (%wadd (fromNat n) k)))
    dcp p a b → dcp p (dc-sh c k a) (dc-sh c k b)
    dcp1 p a → dcp1 p (dc-sh c k a)
    dclet a b → dclet (dc-sh c k a) (dc-sh (%wsucc c) k b)
    dcpr a b → dcpr (dc-sh c k a) (dc-sh c k b)
    dcfst a → dcfst (dc-sh c k a)
    dcsnd a → dcsnd (dc-sh c k a)
    dccon d j a → dccon d j (dc-sh c k a)
    dccase s alts → dccase (dc-sh c k s) (dc-sh c k alts)
    dcalt j n b r → dcalt j n (dc-sh (%wadd c (fromNat n)) k b) (dc-sh c k r)
    dcif a b e → dcif (dc-sh c k a) (dc-sh c k b) (dc-sh c k e)
    dclam i b → dclam i (dc-sh (%wsucc c) k b)
    dcapp f a → dcapp (dc-sh c k f) (dc-sh c k a)
    dccall g m a → dccall g m (dc-sh c k a)
    dcby a → dcby (dc-sh c k a)
    dcld w b o → dcld w (dc-sh c k b) (dc-sh c k o)
    dcst w b o v → dcst w (dc-sh c k b) (dc-sh c k o) (dc-sh c k v)
    dcblen b → dcblen (dc-sh c k b)
    _ → t
-- tuples: (x1, (x2, … unit)); the j-th component of t; the variables d-1 … 0 as a tuple
dc-proj j t = if %weq j #0 then dcfst t else dc-proj (%wsub j #1) (dcsnd t)
dc-vars d = if %weq d #0 then dcu else dcpr (dcv (toNat (%wsub d #1))) (dc-vars (%wsub d #1))
dc-tuple xs = case xs of lnil → dcu; lcons x r → dcpr x (dc-tuple r)
-- d lets rebuilding the variables d-1 … 0 from the tuple at variable 0 (it moves up as they are pushed)
dc-unpack d j body = if %weq j d then body else dclet (dc-proj j (dcv (toNat j))) (dc-unpack d (%wsucc j) body)
-- the word operations' codes (code.cub cwop): 0 eq, 1 lt, 2 add, 4 sub (3 max: a let and an if)
dc-wop k = if %weq k #0 then #3 else if %weq k #1 then #4 else if %weq k #2 then #0 else #1
-- a literal: a word or a Nat numeral
dc-natlit c = case c of cwlit w → some w; ccon d k fs ds → (if %weq d nat-d then (if %weq k #0 then some #0 else (case fs of lcons x r → omap (λ w → %wsucc w) (dc-natlit x); lnil → none)) else none); _ → none
dc-arg as n = lnth as n
dcr c dep st =
  case c of
    cwlit w → some (dcl w , st)
    cvar n → some (dcv (toNat n) , st)
    cann t T → dcr t dep st
    cthunk t → dcr t dep st
    cforce t → dcr t dep st
    cplit k b → (if %wlt k #3 then some (dcl b , st) else none)
    cwop k a b → (if %weq k #3 then dcr-max a b dep st else dcr2 (dcp (dc-wop k)) a b dep st)
    cwsucc a → dc-then (dcr a dep st) (λ a2 st2 → some (dcp #0 a2 (dcl #1) , st2))
    clet t b → dc-then (dcr t dep st) (λ t2 st2 → dc-then (dcr b (%wsucc dep) st2) (λ b2 st3 → some (dclet t2 b2 , st3)))
    cpair a b → dcr2 dcpr a b dep st
    cfst p → dc-then (dcr p dep st) (λ p2 st2 → some (dcfst p2 , st2))
    csnd p → dc-then (dcr p dep st) (λ p2 st2 → some (dcsnd p2 , st2))
    ccon d k fs ds → (if dc-nolist ds then (if %weq d bool-idx then some (dcl (if %weq k #0 then #1 else #0) , st) else dc-then (dcr-list fs dep st) (λ xs st2 → some (dccon d k (dc-tuple xs) , st2))) else none)
    ccase d B x → dcr-case d B x dep st
    celim d P B x → dcr-case d B x dep st
    clam b → dc-then (dcr b (%wsucc dep) (dc-lam-next st)) (λ b2 st2 → some (dclam (dc-lam-n st) b2 , st2))
    capp f a → dcr-app c lnil dep st
    cglob g → dcr-app c lnil dep st
    cprim k as → dcr-prim k as dep st
    cwelim w z s → dcr-welim w z s dep st
    _ → none
dcr2 f a b dep st = dc-then (dcr a dep st) (λ a2 st2 → dc-then (dcr b dep st2) (λ b2 st3 → some (f a2 b2 , st3)))
dcr-list l dep st = case l of lnil → some (lnil , st); lcons x r → dc-then (dcr x dep st) (λ x2 st2 → dc-then (dcr-list r dep st2) (λ r2 st3 → some (lcons x2 r2 , st3)))
-- max a b = if a < b then b else a, a and b let-bound
dcr-max a b dep st = dc-then (dcr a dep st) (λ a2 st2 → dc-then (dcr b dep st2) (λ b2 st3 → some (dclet a2 (dclet (dc-sh #0 #1 b2) (dcif (dcp #4 (dcv 1) (dcv 0)) (dcv 0) (dcv 1))) , st3)))
-- a case: on Bool an if; on a type without recursive fields a dccase in place; otherwise a lifted
-- recursion
dc-ralts d B k = case B of lnil → lnil; lcons b r → lcons (k , (cshape d k , b)) (dc-ralts d r (%wsucc k))
dc-anyrec rs = case rs of lnil → false; lcons a r → (if dc-nolist (rec-fields (fst (snd a)) #0) then dc-anyrec r else true)
dcr-case d B x dep st =
  if %weq d bool-idx
    then (case B of lcons t r → (case r of lcons f r2 → dc-then (dcr x dep st) (λ x2 st2 → dc-then (dcr t dep st2) (λ t2 st3 → dc-then (dcr f dep st3) (λ f2 st4 → some (dcif x2 t2 f2 , st4)))); lnil → none); lnil → none)
    else (let rs = dc-ralts d B #0
          in if dc-anyrec rs
               then dcr-rec d rs x dep st
               else dc-then (dcr x dep st) (λ x2 st2 → dc-then (dcr-alts rs dep st2) (λ a2 st3 → some (dccase x2 a2 , st3))))
dcr-alts rs dep st =
  case rs of
    lnil → some (dcnone , st)
    lcons a r → (let n = lst-count (fst (snd a)) in
                 dc-then (dcr (strip-n n (snd (snd a))) (%wadd dep n) st) (λ b2 st2 → dc-then (dcr-alts r dep st2) (λ r2 st3 → some (dcalt (fst a) (toNat n) b2 r2 , st3))))
-- the lifted recursion r on (x , env): its body unpacks the scrutinee and the environment, cases on
-- the scrutinee, and in each alternative lets the hypotheses (r on each recursive field, the same
-- environment) before the branch
dcr-rec d rs x dep st =
  let r = dc-lk st
      st1 = dc-lift st (r , (#2 , dcl #0))
  in dc-then (dcr-ralts r rs dep st1) (λ alts st2 →
       dc-then (dcr x dep st2) (λ x2 st3 →
         some (dccall r #2 (dcpr x2 (dcpr (dc-vars dep) dcu)) ,
               dc-setlift st3 r (dclet (dcfst (dcv 0)) (dclet (dcfst (dcsnd (dcv 1))) (dc-unpack dep #0 (dccase (dcv (toNat (%wsucc dep))) alts)))))))
dcr-ralts r rs dep st =
  case rs of
    lnil → some (dcnone , st)
    lcons a rest →
      (let ks = fst (snd a)
           n = lst-count ks
           hs = rec-fields ks #0
           nh = lst-count hs
       in dc-then (dcr (strip-n (%wadd n nh) (snd (snd a))) (%wadd dep (%wadd n nh)) st) (λ b2 st2 →
            dc-then (dcr-ralts r rest dep st2) (λ r2 st3 → some (dcalt (fst a) (toNat n) (dc-hyps r n dep hs #0 b2) r2 , st3))))
-- the hypotheses: at the q-th, field j is variable (n − 1 − j) + q and the environment's tuple n + dep + q
dc-hyps r n dep hs q body =
  case hs of
    lnil → body
    lcons j rest → dclet (dccall r #2 (dcpr (dcv (toNat (%wadd (%wsub (%wsub n #1) j) q))) (dcpr (dcv (toNat (%wadd (%wadd n dep) q))) dcu))) (dc-hyps r n dep rest (%wsucc q) body)
-- the lifted definitions are recorded when read; a placeholder is replaced by the body
dc-setlift st r body = (fst st , (fst (snd st) , dc-repl (snd (snd st)) r body))
dc-repl ls r body = case ls of lnil → lnil; lcons e rest → (if %weq (fst e) r then lcons (r , (fst (snd e) , body)) rest else lcons e (dc-repl rest r body))
-- a word recursion: the loop L on (i , (acc , (w , env))): while i < w, L (i + 1 , (s i acc , …)),
-- else acc; s's body inlined when it is written as λ k acc, applied otherwise
dcr-welim w z s dep st =
  let r = dc-lk st
      st1 = dc-lift st (r , (#4 , dcl #0))
  in dc-then (dcr-step r s dep st1) (λ loop st2 →
       dc-then (dcr w dep st2) (λ w2 st3 →
         dc-then (dcr z dep st3) (λ z2 st4 →
           some (dccall r #4 (dcpr (dcl #0) (dcpr z2 (dcpr w2 (dcpr (dc-vars dep) dcu)))) ,
                 dc-setlift st4 r (dclet (dcfst (dcv 0)) (dclet (dcfst (dcsnd (dcv 1))) (dclet (dcfst (dcsnd (dcsnd (dcv 2)))) (dclet (dcfst (dcsnd (dcsnd (dcsnd (dcv 3))))) (dc-unpack dep #0 loop)))))))))
-- (after the unpacking: the environment 0 … dep − 1, its tuple dep, w dep + 1, acc dep + 2, i dep + 3)
dc-dv w = dcv (toNat w)
dcr-step r s dep st =
  case s of
    clam s1 → (case s1 of
                 clam sb → dc-then (dcr sb (%wadd dep #2) st) (λ sb2 st2 →
                             some (dclet (dc-dv (%wadd dep #3)) (dclet (dc-dv (%wadd dep #3))
                                     (dcif (dcp #4 (dcv 1) (dc-dv (%wadd dep #3)))
                                           (dccall r #4 (dcpr (dcp #0 (dcv 1) (dcl #1)) (dcpr sb2 (dcpr (dc-dv (%wadd dep #3)) (dcpr (dc-dv (%wadd dep #2)) dcu)))))
                                           (dcv 0))) , st2))
                 _ → dcr-step2 r s dep st)
    _ → dcr-step2 r s dep st
dcr-step2 r s dep st =
  dc-then (dcr s dep st) (λ s2 st2 →
    some (dcif (dcp #4 (dc-dv (%wadd dep #3)) (dc-dv (%wadd dep #1)))
               (dccall r #4 (dcpr (dcp #0 (dc-dv (%wadd dep #3)) (dcl #1)) (dcpr (dcapp (dcapp s2 (dc-dv (%wadd dep #3))) (dc-dv (%wadd dep #2))) (dcpr (dc-dv (%wadd dep #1)) (dcpr (dc-dv dep) dcu)))))
               (dc-dv (%wadd dep #2)) , st2))
-- an application spine: a global applied to its arguments is a call (its key + 1: #0 is main), the
-- erased ones unit, missing ones η-expanded, extra ones applied to the result; any other head applied
dcr-app c args dep st =
  case c of
    capp f a → dcr-app f (lcons a args) dep st
    cglob g → dcr-call g args dep st
    _ → dc-then (dcr c dep st) (λ f2 st2 → dcr-apps f2 args dep st2)
dcr-apps f args dep st = case args of lnil → some (f , st); lcons a r → dc-then (dcr a dep st) (λ a2 st2 → dcr-apps (dcapp f a2) r dep st2)
dc-arity g = case unfold g of some cd → some (count-lams cd); none → none
dcr-call g args dep st = dcr-call1 g args (dc-arity g) dep st
dcr-call1 g args ar dep st =
  case ar of
    none → none
    some m → dcr-call2 g m (g-erased g) args (lst-count args) dep st
dcr-call2 g m es args na dep st =
  if %wlt na m
    then dcr-eta g m es args (%wsub m na) dep st
    else dc-then (dcr-cargs es #0 (ltake-l m args) dep st) (λ xs st2 → dcr-apps (dc-mkcall g m xs) (dc-drop m args) dep st2)
dc-drop n l = if %weq n #0 then l else (case l of lnil → lnil; lcons x r → dc-drop (%wsub n #1) r)
dc-mkcall g m xs = dccall (%wsucc g) m (if %weq m #1 then (case xs of lcons x r → x; lnil → dcu) else dc-tuple xs)
dcr-cargs es i args dep st =
  case args of
    lnil → some (lnil , st)
    lcons a r → (if lmem-l i es
                   then dc-then (dcr-cargs es (%wsucc i) r dep st) (λ xs st2 → some (lcons dcu xs , st2))
                   else dc-then (dcr a dep st) (λ a2 st2 → dc-then (dcr-cargs es (%wsucc i) r dep st2) (λ xs st3 → some (lcons a2 xs , st3))))
-- k missing arguments: k λs, the given arguments read under them (shifted by k) and the new ones
-- their variables (the first missing the outermost)
dcr-eta g m es args k dep st =
  dc-then (dcr-cargs es #0 args dep st) (λ xs st2 → dc-lams-n k (dc-mkcall g m (lst-app (dc-shl k xs) (dc-newvars k))) st2)
dc-shl k xs = case xs of lnil → lnil; lcons x r → lcons (dc-sh #0 k x) (dc-shl k r)
dc-newvars k = if %weq k #0 then lnil else lcons (dcv (toNat (%wsub k #1))) (dc-newvars (%wsub k #1))
dc-lams-n k body st = if %weq k #0 then some (body , st) else dc-lams-n (%wsub k #1) (dclam (dc-lam-n st) body) (dc-lam-next st)
-- the primitives (lib/code.cub prim-apply's numbering, as lib/lower.cub lower-prim reads them)
dcr-prim k as dep st =
  if %wlt k #512
    then (let sb = %wsub k #256
          in if %weq sb #20 then dcr1 #29 as dep st else if %weq sb #21 then dcr1 #27 as dep st
             else if %weq sb #22 then dcr1 #28 as dep st
             else if orb (%wlt sb #20) (orb (%weq sb #23) (orb (%weq sb #24) (orb (%weq sb #25) (%weq sb #26)))) then (case as of lcons a r → dcr a dep st; lnil → none)
             else none)
  else if %wlt k #768
    then (let sb = %wsub k #512
          in if %wlt sb #5 then dcr-p2 (%wadd #14 sb) as dep st
             else if %wlt sb #10 then dcr-p2 (%wsub sb #5) as dep st
             else if %wlt sb #16 then dcr-p2 (%wadd #19 (%wsub sb #10)) as dep st else none)
  else if %wlt k #1280 then dcr-access k as dep st
  else if %wlt k #1536 then (case dc-arg as #0 of some b → dc-then (dcr b dep st) (λ b2 st2 → some (dcblen b2 , st2)); none → none)
  else (case dc-arg as #0 of some n → omap (λ w → (dcby (dcl w) , st)) (dc-natlit n); none → none)
dcr1 p as dep st = case as of lcons a r → dc-then (dcr a dep st) (λ a2 st2 → some (dcp1 p a2 , st2)); lnil → none
dcr-p2 p as dep st = case as of lcons a r → (case r of lcons b r2 → dcr2 (dcp p) a b dep st; lnil → none); lnil → none
dcr-access k as dep st =
  let stp = if %wlt k #1024 then false else true
      w = %wsub k (if stp then #1024 else #768)
  in if orb (%weq w #4) (%weq w #8)
       then (case dc-arg as #0 of
               some b → (case dc-arg as #1 of
                           some o → dc-then (dcr b dep st) (λ b2 st2 → dc-then (dcr-off o dep st2) (λ o2 st3 →
                                      if stp
                                        then (case dc-arg as #2 of some v → dc-then (dcr v dep st3) (λ v2 st4 → some (dcst w b2 o2 v2 , st4)); none → none)
                                        else some (dcld w b2 o2 , st3)))
                           none → none)
               none → none)
       else none
-- an access's offset: a numeral its word, any other Nat fromNat of it (as lib/lower.cub's lower-off)
dcr-off o dep st = case dc-natlit o of some ow → some (dcl ow , st); none → dcr (capp lower-fromnat o) dep st
-- the globals a DC calls (their keys) and its λs (index , body)
dc-calls c acc =
  case c of
    dcp p a b → dc-calls b (dc-calls a acc)
    dcp1 p a → dc-calls a acc
    dclet a b → dc-calls b (dc-calls a acc)
    dcpr a b → dc-calls b (dc-calls a acc)
    dcfst a → dc-calls a acc
    dcsnd a → dc-calls a acc
    dccon d k a → dc-calls a acc
    dccase s alts → dc-calls alts (dc-calls s acc)
    dcalt k n b r → dc-calls r (dc-calls b acc)
    dcif a b e → dc-calls e (dc-calls b (dc-calls a acc))
    dclam i b → dc-calls b acc
    dcapp f a → dc-calls a (dc-calls f acc)
    dccall g m a → dc-calls a (if lmem g acc then acc else lcons g acc)
    dcby a → dc-calls a acc
    dcld w b o → dc-calls o (dc-calls b acc)
    dcst w b o v → dc-calls v (dc-calls o (dc-calls b acc))
    dcblen b → dc-calls b acc
    _ → acc
dc-lams c acc =
  case c of
    dcp p a b → dc-lams b (dc-lams a acc)
    dcp1 p a → dc-lams a acc
    dclet a b → dc-lams b (dc-lams a acc)
    dcpr a b → dc-lams b (dc-lams a acc)
    dcfst a → dc-lams a acc
    dcsnd a → dc-lams a acc
    dccon d k a → dc-lams a acc
    dccase s alts → dc-lams alts (dc-lams s acc)
    dcalt k n b r → dc-lams r (dc-lams b acc)
    dcif a b e → dc-lams e (dc-lams b (dc-lams a acc))
    dclam i b → dc-lams b (lcons (i , b) acc)
    dcapp f a → dc-lams a (dc-lams f acc)
    dccall g m a → dc-lams a acc
    dcby a → dc-lams a acc
    dcld w b o → dc-lams o (dc-lams b acc)
    dcst w b o v → dc-lams v (dc-lams o (dc-lams b acc))
    dcblen b → dc-lams b acc
    _ → acc
-- the definitions called, transitively: each global's value quoted (lib/specialize.cub's unfold), its m
-- λs, its body read at depth m under the unpacking of its tuple; (key , (m , body)), the state
-- threaded; the lifted recursions are in the state already; none if one is outside
dc-globals fuel todo seen st =
  if %weq fuel #0 then none else
  (case todo of
     lnil → some (lnil , st)
     lcons g rest → (if orb (lmem g seen) (%wlt (%wsub dc-lbase #1) g) then dc-globals fuel rest seen st else dc-glob1 fuel g rest seen st (unfold (%wsub g #1))))
dc-glob1 fuel g rest seen st u =
  case u of
    some cd → (let m = count-lams cd in
               dc-then (dcr (strip-n m cd) m st) (λ b2 st2 →
                 dc-then (dc-globals (%wsub fuel #1) (lst-app rest (lst-app (dc-calls b2 lnil) (dc-lcalls (snd (snd st2))))) (lcons g seen) st2) (λ gs st3 →
                   some (lcons (g , (m , dc-gwrap m b2)) gs , st3))))
    none → none
dc-lcalls ls = case ls of lnil → lnil; lcons e r → dc-calls (snd (snd e)) (dc-lcalls r)
dc-gwrap m b = if orb (%weq m #0) (%weq m #1) then b else dc-unpack m #0 b
dc-look l k dflt = case l of lnil → dflt; lcons e r → if %weq (fst e) k then snd e else dc-look r k dflt
-- a code read as a mirrored program: main (k leading λs, its body at depth k), the globals it calls
-- and the recursions lifted: (k , (main , definitions)), each definition (key , (m , body))
dc-prog c =
  let k = lams-of c
      body = under-lams c
  in dc-then (dcr body k dc-st0) (λ m st →
       dc-then (dc-globals #64 (lst-app (dc-calls m lnil) (dc-lcalls (snd (snd st)))) lnil st) (λ gs st2 →
         some (k , (m , lst-app gs (snd (snd st2))))))
dc-of c = case dcr c #0 dc-st0 of some r → some (fst r); none → none
-- the tables the theorem quantifies over, from the reading: T i the conversion of λ i's body, G the
-- definitions' bodies, GT their conversions (DGOK's first half by definition)
dc-allams m gs = case gs of lnil → dc-lams m lnil; lcons e r → dc-lams (snd (snd e)) (dc-allams m r)
dc-T m gs i = dconv (dc-look (dc-allams m gs) i (dcl #0))
dc-G gs g = snd (dc-look gs g (#0 , dcl #0))
dc-GT gs g = dconv (dc-G gs g)
-- DTok for main and every definition, decided by dtok-chk: dtok-auto turns true into the proof, so the
-- tables are right and dc-sound applies (at every fuel, in every good environment)
dc-ok-all T m gs = case gs of lnil → dtok-chk T m; lcons e r → andb (dtok-chk T (snd (snd e))) (dc-ok-all T m r)
dc-prog-ok p = dc-ok-all (dc-T (fst (snd p)) (snd (snd p))) (fst (snd p)) (snd (snd p))
-- the program in the first-order form: main #0 of arity k, each definition at its key
dc-prog-defs-q p = dc-defs-q (lcons (#0 , (fst p , fst (snd p))) (snd (snd p)))
dc-prog-defs p = dq-fo (dc-prog-defs-q p)
-- main moved to key m (a harness puts its own main at #0)
dc-rekey m ds = case ds of lnil → lnil; lcons e r → lcons ((if %weq (fst e) #0 then m else fst e) , snd e) (dc-rekey m r)
-- main's Int64 and Float64 parameters and result by their bits: each parameter converted to its word
-- (k lets, each converting the parameter now k − 1 down), the result back
-- (checked, on FQ: a parameter or result's kind, word, Int64 or Float64, read off the signature)
data QK = qkw | qki | qkf
fq-pconv : QK → FQ → FQ
fq-pconv qkw x = x
fq-pconv qki x = fq-w64 x
fq-pconv qkf x = fq-wf x
fq-rconv : QK → FQ → FQ
fq-rconv qkw x = x
fq-rconv qki x = fq-i64 x
fq-rconv qkf x = fq-f64 x
fq-needs : List QK → Bool
fq-needs nil = false
fq-needs (cons qkw r) = fq-needs r
fq-needs (cons qki r) = true
fq-needs (cons qkf r) = true
fq-cvlets : Word → List QK → FQ → FQ
fq-cvlets k nil body = body
fq-cvlets k (cons f r) body = fqlet (fq-pconv f (fqv (dnat (wsub k #1)))) (fq-cvlets k r body)
qk-of f = case f of fti64 → qki; ftf64 → qkf; _ → qkw
qk-list fs = case fs of lnil → nil; lcons f r → cons (qk-of f) (qk-list r)
fq-wrap : Word → List QK → QK → FQ → FQ
fq-wrap k ps r body = fq-rconv r (if fq-needs ps then fq-cvlets k ps body else body)
dc-wrap-main-q sg ds =
  case ds of
    lnil → lnil
    lcons e r → (if %weq (fst e) #0
                   then lcons (#0 , (fst (snd e) , fq-wrap (fst (snd e)) (qk-list (fst sg)) (qk-of (snd sg)) (snd (snd e)))) r
                   else lcons e (dc-wrap-main-q sg r))
-- ---------------------------------------------------------------- the specializer, both routes
-- specialize-proved T rules c: the word route first ((#1 , f), spec-path), then the data route — the
-- normal form read by dc-prog, its tables decided (dtok-chk, so dc-sound holds of it through
-- dtok-auto), closure-converted by dconv, rewritten by std-frule (fr-dc-path) and taken to
-- first-order definitions: (#2 , defs), main #0 of the code's arity; otherwise the untyped pipeline
-- (#0 , f)
specialize-proved T rules c =
  let n = normalize T c
  in (case wc-of (under-lams n) of
        some w → (#1 , fq-to-fo (wrap-fq (lams-of n) (fw-to-fq (spec-w std-vrule w))))
        none → (case dc-prog n of
                  some p → (if dc-prog-ok p then (#2 , dq-fo (dc-wrap-main-q (sig-ft (fromopt (quote-ty T) cword)) (dc-prog-defs-q p))) else (#0 , specialize T rules c))
                  none → (#0 , specialize T rules c)))
-- ---------------------------------------------------------------- readings
data PQ = pqa (x : Word) (y : Word) | pqb (x : Word) (y : Word)
pq-sum : PQ → Word
pq-sum p = case p of
  pqa a b → %wadd a b
  pqb a b → %wsub a b
pq-app : PQ → Word
pq-app p = (case p return (λ q → Word → Word) of
  pqa a b → (λ y → %wadd y a)
  pqb a b → (λ y → %wsub y b)) #5
pq-mk : Word → PQ
pq-mk x = pqb (%wadd x #10) x
-- A data type of two constructors with two word fields; a case adding or subtracting the fields; a
-- case choosing a closure, applied (the λs survive normalization); a constructor built
pq-d = didx (code PQ)
pq-run p args = eval-fo (table-of (snd p)) lnil (fcall #0 args)
pq-con k a b = fcon pq-d k (lcons (flit a) (lcons (flit b) lnil))
-- the untyped route's answer, for comparison
dq-untyped T c args = eval-fo no-defs lnil (fapply (specialize T lnil c) args)
sp-d1 = code (λ (p : PQ) → pq-sum p)
#same fst (specialize-proved (PQ → Word) lnil sp-d1) = #2
#same pq-run (specialize-proved (PQ → Word) lnil sp-d1) (lcons (pq-con #0 #3 #4) lnil) = vw #7
#same pq-run (specialize-proved (PQ → Word) lnil sp-d1) (lcons (pq-con #1 #9 #4) lnil) = dq-untyped (PQ → Word) sp-d1 (lcons (pq-con #1 #9 #4) lnil)
sp-d2 = code (λ (p : PQ) → pq-app p)
#same fst (specialize-proved (PQ → Word) lnil sp-d2) = #2
#same pq-run (specialize-proved (PQ → Word) lnil sp-d2) (lcons (pq-con #1 #9 #2) lnil) = vw #3
#same pq-run (specialize-proved (PQ → Word) lnil sp-d2) (lcons (pq-con #0 #9 #2) lnil) = vw #14
sp-d3 = code (λ (x : Word) → pq-mk x)
#same fst (specialize-proved (Word → PQ) lnil sp-d3) = #2
#same pq-run (specialize-proved (Word → PQ) lnil sp-d3) (lcons (flit #4) lnil) = dq-untyped (Word → PQ) sp-d3 (lcons (flit #4) lnil)
-- the reading of sp-d2's normal form, written out: the closure λ#0 y. y + a in the first alternative,
-- λ#1 y. y − b in the second; the checked path below is about this DC
pq-dc : DC
pq-dc = dcapp (dccase (dcv 0) (dcalt #0 2 (dclam #0 (dcp #0 (dcv 0) (dcv 2))) (dcalt #1 2 (dclam #1 (dcp #1 (dcv 0) (dcv 1))) dcnone))) (dcl #5)
#same dc-of (under-lams (normalize (PQ → Word) sp-d2)) = some pq-dc
pq-T : Word → FC
pq-T i = %welimP (λ v → FC) i (fcp #0 (fcv 0) (fcv 2)) (λ m h → fcp #1 (fcv 0) (fcv 1))
pq-G : Word → DC
pq-G g = dcl #0
pq-GT : Word → FC
pq-GT g = fcl #0
pq-gok : DGOK pq-G pq-T pq-GT
pq-gok g = ((λ i → fcl #0) , unit)
-- the justifying path: for every argument value and fuel, the converted program means the source
pq-path : (n : Nat) (x : DV) → dgood pq-T x → derase (dsev pq-G n pq-dc (dext dvnone x)) ≡ dtev pq-T pq-GT n (dconv pq-dc) (denv (dext dvnone x))
pq-path n x gx = snd (dc-sound pq-G pq-T pq-GT pq-gok n pq-dc (dext dvnone x) (dtok-auto pq-T pq-dc (λ i → true)) (dge-ext pq-T dvnone x (λ k → unit) gx))
#same dsev pq-G (dnat #10) pq-dc (dext dvnone (dvc #1 (dvpr (dvw #9) (dvpr (dvw #2) dvu)))) = dvw #3
-- and with the verified rewrites: the rewritten conversion (both tables rewritten, as dc-defs prints
-- them) refines the source at every fuel, for every good argument (fr-dc-path at std-frule)
pq-rpath : (n : Nat) (x : DV) → dgood pq-T x
         → fr-le (derase (dsev pq-G n pq-dc (dext dvnone x))) (dtev (fr-tab (fst std-frule) pq-T) (fr-tab (fst std-frule) pq-GT) n (fr-bu (fst std-frule) (dconv pq-dc)) (denv (dext dvnone x)))
pq-rpath n x gx = fr-dc-path std-frule pq-G pq-T pq-GT pq-gok n pq-dc x (dtok-auto pq-T pq-dc (λ i → true)) gx
-- calls, read from a code as written (not normalized): main calls pq-sum on pq-mk x; the globals'
-- values are quoted and read, the tables decided; at 4: pqb 14 4, 14 − 4
dc-dflt = (#0 , (dcl #0 , lnil))
dc-c4 = code (λ (x : Word) → pq-sum (pq-mk x))
#same dc-prog-ok (fromopt (dc-prog dc-c4) dc-dflt) = true
#same eval-fo (table-of (dc-prog-defs (fromopt (dc-prog dc-c4) dc-dflt))) lnil (fcall #0 (lcons (flit #4) lnil)) = vw #10
#same lst-len (snd (snd (fromopt (dc-prog dc-c4) dc-dflt))) = #2
-- the byte layer: two stores into a fresh 16-byte string and the sum of the two loads (lib/region.cub's
-- two, as its normal form has it); at 20: 20 + 21
by-f : Word → Word
by-f w = i64toWord (i64add (load64 16 (store64 16 (store64 16 (bytes 16) 0 (8 , λ i → 16) (i64 w)) 8 (0 , λ i → 16) (i64 (%wsucc w))) 0 (8 , λ i → 16))
                           (load64 16 (store64 16 (store64 16 (bytes 16) 0 (8 , λ i → 16) (i64 w)) 8 (0 , λ i → 16) (i64 (%wsucc w))) 8 (0 , λ i → 16)))
sp-b1 = code (λ (w : Word) → by-f w)
#same fst (specialize-proved (Word → Word) lnil sp-b1) = #2
#same pq-run (specialize-proved (Word → Word) lnil sp-b1) (lcons (flit #20) lnil) = vw #41
#same dsev pq-G (dnat #20) (fromopt (dc-of (under-lams (normalize (Word → Word) sp-b1))) (dcl #0)) (dext dvnone (dvw #20)) = dvw #41
-- a load at an offset that is not a multiple of 8, overlapping the store in part: byte by byte (the
-- high half of the stored word, then four zero bytes). (The untyped route reads the offset, a Nat, as a
-- data value, which its loads take for 0: it answers the word stored at 0.)
by-g : Word → Word
by-g w = i64toWord (load64 16 (store64 16 (bytes 16) 0 (8 , λ i → 16) (i64 w)) 4 (4 , λ i → 16))
sp-b2 = code (λ (w : Word) → by-g w)
#same fst (specialize-proved (Word → Word) lnil sp-b2) = #2
#same pq-run (specialize-proved (Word → Word) lnil sp-b2) (lcons (flit #12884901890) lnil) = vw #3
-- four bytes: a store of the low 32 bits and the load back, at offset 4
by-h : Word → Word
by-h w = u32toWord (load32 16 (store32 16 (bytes 16) 4 (8 , λ i → 16) (u32 w)) 4 (8 , λ i → 16))
sp-b3 = code (λ (w : Word) → by-h w)
#same fst (specialize-proved (Word → Word) lnil sp-b3) = #2
#same pq-run (specialize-proved (Word → Word) lnil sp-b3) (lcons (flit #4294967301) lnil) = vw #5
-- an offset that is a variable (a Nat parameter): read through fromNat on both routes (lib/lower.cub's
-- lower-off, dcr-off). A store at n, a load at 8: 77 when n is 8, 0 when n is 0. The untyped route had
-- read the Nat as a constructor tree, which the store took for 0 (so 0 at n = 8, and 77 at n = 0)
by-v : (n : Nat) → le (plus n 8) 16 → Word → Word
by-v n p w = i64toWord (load64 16 (store64 16 (bytes 16) n p (i64 w)) 8 (0 , λ i → 16))
sp-bv = code (λ (n : Nat) (p : le (plus n 8) 16) (w : Word) → by-v n p w)
nat-fo w = %welimP (λ v → FO) w (fcon nat-d #0 lnil) (λ k h → fcon nat-d #1 (lcons h lnil))
#same fst (specialize-proved ((n : Nat) → le (plus n 8) 16 → Word → Word) lnil sp-bv) = #2
#same pq-run (specialize-proved ((n : Nat) → le (plus n 8) 16 → Word → Word) lnil sp-bv) (lcons (nat-fo #8) (lcons (flit #0) (lcons (flit #77) lnil))) = vw #77
#same pq-run (specialize-proved ((n : Nat) → le (plus n 8) 16 → Word → Word) lnil sp-bv) (lcons (nat-fo #0) (lcons (flit #0) (lcons (flit #77) lnil))) = vw #0
bv-prog = program-of #100 (normalize ((n : Nat) → le (plus n 8) 16 → Word → Word) sp-bv)
#same eval-fo (table-of bv-prog) lnil (fcall #0 (lcons (nat-fo #8) (lcons (flit #0) (lcons (flit #77) lnil)))) = vw #77
#same eval-fo (table-of bv-prog) lnil (fcall #0 (lcons (nat-fo #0) (lcons (flit #0) (lcons (flit #77) lnil)))) = vw #0
-- a byte string's length (%blen, from an untyped code; a checked blen n b is its index n): the mirror's
-- dcblen on the verified route, as the untyped one computes it
sp-bl3 = code (λ b → %blen b)
#same fst (specialize-proved (Bytes 16 → Word) lnil sp-bl3) = #2
#same pq-run (specialize-proved (Bytes 16 → Word) lnil sp-bl3) (lcons (fprim P-bytes (lcons (flit #16) lnil)) lnil) = vw #16
#same eval-fo (table-of (program-of #100 (normalize (Bytes 16 → Word) sp-bl3))) lnil (fcall #0 (lcons (fprim P-bytes (lcons (flit #16) lnil)) lnil)) = vw #16
-- max on the untyped route (lib/lower.cub's lower-max; it was lowered as addition: 12 here)
sp-mx = code (λ (a : Word) (b : Word) → %wmax a b)
#same dq-untyped (Word → Word → Word) sp-mx (lcons (flit #3) (lcons (flit #9) lnil)) = vw #9
#same dq-untyped (Word → Word → Word) sp-mx (lcons (flit #9) (lcons (flit #3) lnil)) = vw #9
-- the word route is unchanged; a case on Bool is an if in the mirror
#same fst (specialize-proved (Word → Word) lnil sp-f1) = #1
#same fst (specialize-proved (Bool → Word) lnil sp-f4) = #2
#same pq-run (specialize-proved (Bool → Word) lnil sp-f4) (lcons (flit #1) lnil) = vw #1
#same pq-run (specialize-proved (Bool → Word) lnil sp-f4) (lcons (flit #0) lnil) = vw #0
-- the verified rewrites on the converted mirror: x + 0, a fold, a load forwarded through two stores,
-- a 4-byte load forwarded (truncated), a partial overlap left alone, projections and an if
#same fr-bu (fst std-frule) (fcp #0 (fcv 0) (fcl #0)) = fcv 0
#same fr-bu (fst std-frule) (fcp #0 (fcl #0) (fcp #1 (fcl #9) (fcl #4))) = fcl #5
#same fr-bu (fst std-frule) (fcp #2 (fcl #6) (fcl #7)) = fcl #42
#same fr-bu (fst std-frule) (fcld #8 (fcst #8 (fcst #8 (fcby (fcl #16)) (fcl #0) (fcv 0)) (fcl #8) (fcv 1)) (fcl #0)) = fcv 0
#same fr-bu (fst std-frule) (fcld #8 (fcst #8 (fcst #8 (fcby (fcl #16)) (fcl #0) (fcv 0)) (fcl #8) (fcv 1)) (fcl #8)) = fcv 1
#same fr-bu (fst std-frule) (fcld #8 (fcst #8 (fcby (fcl #16)) (fcl #0) (fcv 0)) (fcl #8)) = fcld #8 (fcby (fcl #16)) (fcl #8)
#same fr-bu (fst std-frule) (fcld #4 (fcst #4 (fcby (fcl #16)) (fcl #4) (fcv 0)) (fcl #4)) = fcp1 #40 (fcv 0)
#same fr-bu (fst std-frule) (fcld #8 (fcst #8 (fcby (fcl #16)) (fcl #0) (fcv 0)) (fcl #4)) = fcld #8 (fcst #8 (fcby (fcl #16)) (fcl #0) (fcv 0)) (fcl #4)
#same fr-bu (fst std-frule) (fcld #4 (fcst #4 (fcby (fcl #16)) (fcl #0) (fcv 0)) (fcl #4)) = fcld #4 (fcby (fcl #16)) (fcl #4)
#same fr-bu (fst std-frule) (fcapp (fcclo #3) (fcp #0 (fcl #0) (fcv 2))) = fcapp (fcclo #3) (fcv 2)
#same fr-bu (fst std-frule) (fcfst (fcpr (fcv 1) (fcv 2))) = fcv 1
#same fr-bu (fst std-frule) (fcif (fcp #4 (fcl #2) (fcl #3)) (fcv 0) (fcv 1)) = fcv 0
-- a data program whose normal form adds 0 under a case: the rewrite removes it in main
pq-z : PQ → Word
pq-z p = case p of
  pqa a b → %wadd a #0
  pqb a b → %wadd #0 b
pq-id : PQ → Word
pq-id p = case p of
  pqa a b → a
  pqb a b → b
#same fst (specialize-proved (PQ → Word) lnil (code (λ (p : PQ) → pq-z p))) = #2
#same dc-prog-defs (fromopt (dc-prog (normalize (PQ → Word) (code (λ (p : PQ) → pq-z p)))) dc-dflt) = dc-prog-defs (fromopt (dc-prog (normalize (PQ → Word) (code (λ (p : PQ) → pq-id p)))) dc-dflt)
-- the byte program's two loads forwarded through the stores: what is left is w + (w + 1) (Int64's
-- addition on the bits), the program without the region
#same fr-bu (fst std-frule) (dconv (fromopt (dc-of (under-lams (normalize (Word → Word) sp-b1))) (dcl #0))) = fcp #14 (fcv zero) (fcp #0 (fcv zero) (fcl #1))
-- ---------------------------------------------------------------- the forms past the first mirror
-- comparisons, Bool (an if) and max (a let and an if): at (3, 9) max 3 10, at (9, 9) 7, at (9, 4) 5
dq-cmp : Word → Word → Word
dq-cmp x y = case wlt x y return (λ b → Word) of
  true → %wmax x (%wadd y #1)
  false → (case weq x y return (λ b → Word) of
    true → #7
    false → wsub x y)
dq-c1 = code (λ (x : Word) (y : Word) → dq-cmp x y)
#same fst (specialize-proved (Word → Word → Word) lnil dq-c1) = #2
#same pq-run (specialize-proved (Word → Word → Word) lnil dq-c1) (lcons (flit #3) (lcons (flit #9) lnil)) = vw #10
#same pq-run (specialize-proved (Word → Word → Word) lnil dq-c1) (lcons (flit #9) (lcons (flit #9) lnil)) = vw #7
#same pq-run (specialize-proved (Word → Word → Word) lnil dq-c1) (lcons (flit #9) (lcons (flit #4) lnil)) = vw #5
-- constructors of no, one and three fields, a second data type holding the first
data DqSh = dqz | dq1 (a : Word) | dq3 (a : Word) (b : Word) (c : Word)
data DqTg = dqta (s : DqSh) (w : Word) | dqtb
dq-area : DqTg → Word
dq-area t = case t of
  dqta s w → (case s of
    dqz → w
    dq1 a → %wadd a w
    dq3 a b c → %wadd (%wadd a b) (%wsub c w))
  dqtb → #1
dq-mk : Word → DqTg
dq-mk x = dqta (dq3 x #2 #30) #5
dq-c2 = code (λ (x : Word) → dq-area (dq-mk x))
-- (normalized, the constructors meet their case: what is left, x + 27, is in the word fragment)
#same fst (specialize-proved (Word → Word) lnil dq-c2) = #1
#same eval-fo no-defs lnil (fapply (snd (specialize-proved (Word → Word) lnil dq-c2)) (lcons (flit #4) lnil)) = vw #31
dq-sh-d = didx (code DqSh)
dq-tg-d = didx (code DqTg)
dq-c2b = code (λ (t : DqTg) → dq-area t)
#same fst (specialize-proved (DqTg → Word) lnil dq-c2b) = #2
#same pq-run (specialize-proved (DqTg → Word) lnil dq-c2b) (lcons (fcon dq-tg-d #0 (lcons (fcon dq-sh-d #1 (lcons (flit #8) lnil)) (lcons (flit #3) lnil))) lnil) = vw #11
#same pq-run (specialize-proved (DqTg → Word) lnil dq-c2b) (lcons (fcon dq-tg-d #1 lnil) lnil) = vw #1
-- a recursive type: a list's sum, the structural recursion lifted to a definition of its own
data DqL = dqn | dqc (x : Word) (r : DqL)
dq-sum : DqL → Word
dq-sum l = case l of
  dqn → #0
  dqc x r → %wadd x (rec r)
dq-l-d = didx (code DqL)
dq-lst = fcon dq-l-d #1 (lcons (flit #3) (lcons (fcon dq-l-d #1 (lcons (flit #4) (lcons (fcon dq-l-d #0 lnil) lnil))) lnil))
dq-c3 = code (λ (l : DqL) → dq-sum l)
#same fst (specialize-proved (DqL → Word) lnil dq-c3) = #2
#same pq-run (specialize-proved (DqL → Word) lnil dq-c3) (lcons dq-lst lnil) = vw #7
dq-c3b = code (λ (x : Word) (l : DqL) → dq-sum (dqc x (dqc #4 l)))
#same fst (specialize-proved (Word → DqL → Word) lnil dq-c3b) = #2
#same pq-run (specialize-proved (Word → DqL → Word) lnil dq-c3b) (lcons (flit #10) (lcons dq-lst lnil)) = vw #21
-- a word recursion whose step cases on data: the loop lifted
dq-wr : Word → DqTg → Word
dq-wr n t = %welimP (λ v → Word) n #0 (λ k acc → %wadd acc (%wadd k (dq-area t)))
dq-c4 = code (λ (n : Word) (t : DqTg) → dq-wr n t)
dq-tg1 = fcon dq-tg-d #0 (lcons (fcon dq-sh-d #1 (lcons (flit #8) lnil)) (lcons (flit #3) lnil))
#same fst (specialize-proved (Word → DqTg → Word) lnil dq-c4) = #2
#same pq-run (specialize-proved (Word → DqTg → Word) lnil dq-c4) (lcons (flit #3) (lcons dq-tg1 lnil)) = vw #36
#same pq-run (specialize-proved (Word → DqTg → Word) lnil dq-c4) (lcons (flit #3) (lcons dq-tg1 lnil)) = dq-untyped (Word → DqTg → Word) dq-c4 (lcons (flit #3) (lcons dq-tg1 lnil))
-- Int64 and Float64 operations, by their bits
dq-i64 : Word → Word
dq-i64 x = i64toWord (i64mul (i64sub (i64 x) (i64 #1)) (i64 #3))
dq-c5 = code (λ (x : Word) → dq-i64 x)
#same fst (specialize-proved (Word → Word) lnil dq-c5) = #2
#same pq-run (specialize-proved (Word → Word) lnil dq-c5) (lcons (flit #5) lnil) = vw #12
#same pq-run (specialize-proved (Word → Word) lnil dq-c5) (lcons (flit #0) lnil) = dq-untyped (Word → Word) dq-c5 (lcons (flit #0) lnil)
dq-f64 : Word → Word
dq-f64 x = i64toWord (f64bits (f64mul (f64add (f64 x) (f64 #1)) (f64 #2)))
dq-c6 = code (λ (x : Word) → dq-f64 x)
#same fst (specialize-proved (Word → Word) lnil dq-c6) = #2
#same pq-run (specialize-proved (Word → Word) lnil dq-c6) (lcons (flit #3) lnil) = dq-untyped (Word → Word) dq-c6 (lcons (flit #3) lnil)
dq-flt : Word → Word
dq-flt x = case f64lt (f64 x) (f64 #10) return (λ b → Word) of true → #1; false → #2
dq-c7 = code (λ (x : Word) → dq-flt x)
#same fst (specialize-proved (Word → Word) lnil dq-c7) = #2
#same pq-run (specialize-proved (Word → Word) lnil dq-c7) (lcons (flit #3) lnil) = vw #1
#same pq-run (specialize-proved (Word → Word) lnil dq-c7) (lcons (flit #30) lnil) = vw #2
-- calls of three arguments and of none, read as written; and a partial application η-expanded
dq-add3 : Word → Word → Word → Word
dq-add3 a b c = %wadd a (%wsub b c)
dq-k7 : Word
dq-k7 = #7
dq-c8 = code (λ (x : Word) → dq-add3 x dq-k7 #2)
#same dc-prog-ok (fromopt (dc-prog dq-c8) dc-dflt) = true
#same eval-fo (table-of (dc-prog-defs (fromopt (dc-prog dq-c8) dc-dflt))) lnil (fcall #0 (lcons (flit #4) lnil)) = vw #9
#same lst-len (snd (snd (fromopt (dc-prog dq-c8) dc-dflt))) = #2
dq-ap1 : (Word → Word) → Word
dq-ap1 f = f #1
dq-c9 = code (λ (x : Word) → dq-ap1 (dq-add3 x #9))
#same dc-prog-ok (fromopt (dc-prog dq-c9) dc-dflt) = true
#same eval-fo (table-of (dc-prog-defs (fromopt (dc-prog dq-c9) dc-dflt))) lnil (fcall #0 (lcons (flit #4) lnil)) = vw #12
-- pairs: a parameter used through its projections, a pair returned whole
dq-c10 = code (λ (p : Word × Word) → %wadd (fst p) (snd p))
#same fst (specialize-proved (Word × Word → Word) lnil dq-c10) = #2
#same pq-run (specialize-proved (Word × Word → Word) lnil dq-c10) (lcons (fcon #0 #0 (lcons (flit #3) (lcons (flit #4) lnil))) lnil) = vw #7
dq-c11 = code (λ (x : Word) → (x , %wadd x #1))
#same fst (specialize-proved (Word → Word × Word) lnil dq-c11) = #2
#same pq-run (specialize-proved (Word → Word × Word) lnil dq-c11) (lcons (flit #4) lnil) = dq-untyped (Word → Word × Word) dq-c11 (lcons (flit #4) lnil)
-- checked paths, one per form: for every fuel and argument, the conversion means the source
-- (a definition of three parameters: its tuple unpacked by three lets, as dc-unpack makes it)
dq-G : Word → DC
dq-G g = %welimP (λ v → DC) g (dcl #0) (λ m h → (dclet (dcfst (dcv 0)) (dclet (dcfst (dcsnd (dcv 1))) (dclet (dcfst (dcsnd (dcsnd (dcv 2)))) (dcp #0 (dcv 2) (dcp #1 (dcv 1) (dcv 0)))))))
dq-T : Word → FC
dq-T i = fcl #0
dq-GT : Word → FC
dq-GT g = dconv (dq-G g)
dq-gok : DGOK dq-G dq-T dq-GT
dq-gok g = ((λ i → dq-GT g) , %welimP (λ v → DTok dq-T (dq-G v)) g unit (λ m h → dtok-auto dq-T (dclet (dcfst (dcv 0)) (dclet (dcfst (dcsnd (dcv 1))) (dclet (dcfst (dcsnd (dcsnd (dcv 2)))) (dcp #0 (dcv 2) (dcp #1 (dcv 1) (dcv 0)))))) (λ i → true)))
dq-path : (c : DC) → dtok-chk dq-T c ≡ true → (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n c (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv c) (denv (dext dvnone x))
dq-path c e n x gx = snd (dc-sound dq-G dq-T dq-GT dq-gok n c (dext dvnone x) (dtok-auto dq-T c e) (dge-ext dq-T dvnone x (λ k → unit) gx))
-- an if on a comparison; max; a case of three alternatives over constructors of 0, 1 and 3 fields; a
-- pair through its projections; Int64 and Float64 operations and a conversion; a call of three
-- arguments through a tuple; the byte layer at width 4 and an unaligned offset
dq-p-if : DC
dq-p-if = dcif (dcp #4 (dcv 0) (dcl #5)) (dcp #0 (dcv 0) (dcl #1)) (dcl #0)
dq-p-max : DC
dq-p-max = dclet (dcv 0) (dclet (dcl #7) (dcif (dcp #4 (dcv 1) (dcv 0)) (dcv 0) (dcv 1)))
dq-p-case : DC
dq-p-case = dccase (dccon #9 #2 (dcpr (dcv 0) (dcpr (dcl #2) (dcpr (dcl #3) dcu)))) (dcalt #0 0 (dcl #1) (dcalt #1 1 (dcv 0) (dcalt #2 3 (dcp #0 (dcv 2) (dcv 0)) dcnone)))
dq-p-pair : DC
dq-p-pair = dclet (dcpr (dcv 0) (dcl #4)) (dcp #1 (dcsnd (dcv 0)) (dcfst (dcv 0)))
dq-p-num : DC
dq-p-num = dcp #16 (dcp1 #28 (dcp #19 (dcp1 #29 (dcv 0)) (dcp1 #29 (dcl #1)))) (dcl #3)
dq-p-call : DC
dq-p-call = dccall #1 #3 (dcpr (dcv 0) (dcpr (dcl #9) (dcpr (dcl #2) dcu)))
dq-p-bytes : DC
dq-p-bytes = dcld #8 (dcst #4 (dcst #8 (dcby (dcl #16)) (dcl #0) (dcv 0)) (dcl #4) (dcl #1)) (dcl #2)
dq-path-if : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-if (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-if) (denv (dext dvnone x))
dq-path-if = dq-path dq-p-if (λ i → true)
dq-path-max : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-max (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-max) (denv (dext dvnone x))
dq-path-max = dq-path dq-p-max (λ i → true)
dq-path-case : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-case (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-case) (denv (dext dvnone x))
dq-path-case = dq-path dq-p-case (λ i → true)
dq-path-pair : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-pair (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-pair) (denv (dext dvnone x))
dq-path-pair = dq-path dq-p-pair (λ i → true)
dq-path-num : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-num (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-num) (denv (dext dvnone x))
dq-path-num = dq-path dq-p-num (λ i → true)
dq-path-call : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-call (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-call) (denv (dext dvnone x))
dq-path-call = dq-path dq-p-call (λ i → true)
dq-path-bytes : (n : Nat) (x : DV) → dgood dq-T x → derase (dsev dq-G n dq-p-bytes (dext dvnone x)) ≡ dtev dq-T dq-GT n (dconv dq-p-bytes) (denv (dext dvnone x))
dq-path-bytes = dq-path dq-p-bytes (λ i → true)
-- and what they compute: (4 < 5: 5), max 4 7, the case's third alternative 4 + 3, 4 − 4, the call
-- 4 + (9 − 2); the bytes: 4 stored at 0, 1 at 4 (four bytes), the eight bytes at 2: 4·2^0 shifted
-- down two bytes plus 1 at byte 2
#same dsev dq-G (dnat #20) dq-p-if (dext dvnone (dvw #4)) = dvw #5
#same dsev dq-G (dnat #20) dq-p-max (dext dvnone (dvw #4)) = dvw #7
#same dsev dq-G (dnat #20) dq-p-case (dext dvnone (dvw #4)) = dvw #7
#same dsev dq-G (dnat #20) dq-p-pair (dext dvnone (dvw #4)) = dvw #0
#same dsev dq-G (dnat #20) dq-p-call (dext dvnone (dvw #4)) = dvw #11
#same dsev dq-G (dnat #20) dq-p-bytes (dext dvnone (dvw #262144)) = dvw #65540
#same dtev dq-T dq-GT (dnat #20) (dconv dq-p-bytes) (text tvnone (tvw #262144)) = tvw #65540
-- the checked printer prints what the untyped one did (fc-to-fo-ref), on every form: the examples above
#same fc-to-fo zero (dconv dx-main) = fc-to-fo-ref zero (dconv dx-main)
#same fc-to-fo (suc zero) (dconv dx-body1) = fc-to-fo-ref (suc zero) (dconv dx-body1)
#same fc-to-fo (suc zero) (dconv pq-dc) = fc-to-fo-ref (suc zero) (dconv pq-dc)
#same fc-to-fo (suc zero) (dconv dq-p-if) = fc-to-fo-ref (suc zero) (dconv dq-p-if)
#same fc-to-fo (suc zero) (dconv dq-p-max) = fc-to-fo-ref (suc zero) (dconv dq-p-max)
#same fc-to-fo (suc zero) (dconv dq-p-case) = fc-to-fo-ref (suc zero) (dconv dq-p-case)
#same fc-to-fo (suc zero) (dconv dq-p-pair) = fc-to-fo-ref (suc zero) (dconv dq-p-pair)
#same fc-to-fo (suc zero) (dconv dq-p-num) = fc-to-fo-ref (suc zero) (dconv dq-p-num)
#same fc-to-fo (suc zero) (dconv dq-p-call) = fc-to-fo-ref (suc zero) (dconv dq-p-call)
#same fc-to-fo (suc zero) (dconv dq-p-bytes) = fc-to-fo-ref (suc zero) (dconv dq-p-bytes)
#same fc-def-body #3 (dconv (dq-G #1)) = fc-def-body-ref #3 (dconv (dq-G #1))
#same fc-def-body #1 (dconv dx-body1) = fc-def-body-ref #1 (dconv dx-body1)
