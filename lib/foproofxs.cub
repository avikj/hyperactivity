-- lib/foproofxs.cub — the x86 link proved (plan 18.7's JIT path, B16, item 15's X2): xa-sound, for programs
-- lib/foproofx.cub's xq-defs-ok accepts, whenever evx runs the code fq-to-xa gives to its end without a
-- limit hit, the machine's answer refines evq's value.
-- Loaded after lib/foproofx.cub (so lib/foproofe.cub).
--
-- The proof is a simulation, by fuel per construct, as lib/foproofc.cub's pstep is: a relation between
-- evq's environment and values and the machine's state (registers, stack slots, arena cells), and the
-- invariants it rests on, each proved preserved by the generated code:
--   * the arena only grows: r15 never decreases (every post below: wlt f2 f ≡ false);
--   * cells sit below r15 and in [r15, ahi) nothing is read as a cell (XSV: a constructor's address and
--     its fields' are below the arena pointer the value is related at; a store into the arena is at or
--     above r15, xs-fr-wr);
--   * the stack and the arena are disjoint: every arena store is below ahi, every stack store and push
--     from slo up, and ahi <= slo (the theorem's premise), so a frame condition (XFr) holds of each step:
--     memory below r15 and memory from rsp up are unchanged;
--   * no address wraps: rbp is rsp plus eight times the slots pushed (XDp, exact), every slot read or
--     written is between rsp and rbp, rbp at most a top T below 2^64, r15 at most ahi (xs-nowrap);
--   * stack use balances: an expression's code leaves rsp and rbp as it found them, its value in rax; a
--     list's leaves its values in the slots from its depth; a loop body's, at its continuing jump, the new
--     state in the state's slots and rsp at the loop's base, at its end jump rsp at the base;
--   * callee-saved registers: a call returns with rsp and rbp as they were (emitx86's ABI: rax the
--     result; rcx and the argument registers clobbered, as the caller never reads them after a call).
-- Words are exact naturals here (lib/std.cub), so the address arithmetic is done on Nat through toNat.
-- ---------------------------------------------------------------- arithmetic on Nat
xn-sub : Nat → Nat → Nat
xn-sub zero b = zero
xn-sub (suc a) zero = suc a
xn-sub (suc a) (suc b) = xn-sub a b
xn-add-0l : (m : Nat) → qadd zero m ≡ m
xn-add-0l zero = λ t → zero
xn-add-0l (suc m) = λ t → suc (xn-add-0l m t)
xn-comm : (a b : Nat) → qadd a b ≡ qadd b a
xn-comm a zero = sym (xn-add-0l a)
xn-comm a (suc b) = cong suc (xn-comm a b) ∙ sym (qadd-s b a)
xn-assoc : (a b c : Nat) → qadd (qadd a b) c ≡ qadd a (qadd b c)
xn-assoc a b zero = λ t → qadd a b
xn-assoc a b (suc c) = cong suc (xn-assoc a b c)
-- (a + b) + (c + d) = (a + c) + (b + d)
xn-swap : (a b c d : Nat) → qadd (qadd a b) (qadd c d) ≡ qadd (qadd a c) (qadd b d)
xn-swap a b c d =
  xn-assoc a b (qadd c d) ∙ cong (λ u → qadd a u) (sym (xn-assoc b c d) ∙ cong (λ u → qadd u d) (xn-comm b c) ∙ xn-assoc c b d) ∙ sym (xn-assoc a c (qadd b d))
xn-dbl : Nat → Nat
xn-dbl a = qadd a a
xn-dbl-add : (a b : Nat) → xn-dbl (qadd a b) ≡ qadd (xn-dbl a) (xn-dbl b)
xn-dbl-add a b = xn-swap a b a b
-- eight times: three doublings
xn8 : Nat → Nat
xn8 a = xn-dbl (xn-dbl (xn-dbl a))
xn8-add : (a b : Nat) → xn8 (qadd a b) ≡ qadd (xn8 a) (xn8 b)
xn8-add a b =
  cong (λ u → xn-dbl (xn-dbl u)) (xn-dbl-add a b) ∙ cong (λ u → xn-dbl u) (xn-dbl-add (xn-dbl a) (xn-dbl b)) ∙ xn-dbl-add (xn-dbl (xn-dbl a)) (xn-dbl (xn-dbl b))
-- monus
xn-sub-add : (a b : Nat) → xn-sub (qadd a b) b ≡ a
xn-sub-add zero zero = λ t → zero
xn-sub-add (suc a) zero = λ t → suc a
xn-sub-add a (suc b) = xn-sub-add a b
xn-sub-cancel : (x y z : Nat) → xn-sub (qadd x y) (qadd y z) ≡ xn-sub x z
xn-sub-cancel x zero z = cong (λ u → xn-sub x u) (xn-add-0l z)
xn-sub-cancel x (suc y) z = cong (λ u → xn-sub (suc (qadd x y)) u) (qadd-s y z) ∙ xn-sub-cancel x y z
xn-sub-0r : (a : Nat) → xn-sub a zero ≡ a
xn-sub-0r zero = λ t → zero
xn-sub-0r (suc a) = λ t → suc a
-- order (q-le), and its facts
xn-le-refl : (a : Nat) → q-le a a ≡ true
xn-le-refl zero = λ t → true
xn-le-refl (suc a) = xn-le-refl a
xn-le-add : (a b : Nat) → q-le a (qadd a b) ≡ true
xn-le-add zero b = λ t → true
xn-le-add (suc a) b = cong (λ u → q-le (suc a) u) (qadd-s a b) ∙ xn-le-add a b
xn-le-trans : (x y z : Nat) → q-le x y ≡ true → q-le y z ≡ true → q-le x z ≡ true
xn-le-trans zero y z h1 h2 = λ t → true
xn-le-trans (suc x) (suc y) (suc z) h1 h2 = xn-le-trans x y z h1 h2
xn-le-trans (suc x) zero z h1 h2 = Empty-rec (false≢true h1)
xn-le-trans (suc x) (suc y) zero h1 h2 = Empty-rec (false≢true h2)
-- not (y < x) is x <= y... as q-le: q-le (suc y) x ≡ false gives q-le x y ≡ true
xn-nlt-le : (x y : Nat) → q-le (suc y) x ≡ false → q-le x y ≡ true
xn-nlt-le zero y h = λ t → true
xn-nlt-le (suc x) zero h = Empty-rec (true≢false h)
xn-nlt-le (suc x) (suc y) h = xn-nlt-le x y h
xn-le-nlt : (x y : Nat) → q-le x y ≡ true → q-le (suc y) x ≡ false
xn-le-nlt zero y h = λ t → false
xn-le-nlt (suc x) zero h = Empty-rec (false≢true h)
xn-le-nlt (suc x) (suc y) h = xn-le-nlt x y h
-- x <= y gives y = x + (y - x)
xn-le-split : (x y : Nat) → q-le x y ≡ true → y ≡ qadd x (xn-sub y x)
xn-le-split zero y h = sym (cong (λ u → qadd zero u) (xn-sub-0r y) ∙ xn-add-0l y)
xn-le-split (suc x) zero h = Empty-rec (false≢true h)
xn-le-split (suc x) (suc y) h = cong suc (xn-le-split x y h) ∙ sym (qadd-s x (xn-sub y x))
xn-le-addr : (a b c : Nat) → q-le a b ≡ true → q-le a (qadd b c) ≡ true
xn-le-addr a b c h = xn-le-trans a b (qadd b c) h (xn-le-add b c)
xn-le-mono : (a b c : Nat) → q-le a b ≡ true → q-le (qadd c a) (qadd c b) ≡ true
xn-le-mono a b c h =
  subst {lzero} {lzero} {Nat} {λ u → q-le (qadd c a) (qadd c u) ≡ true} {qadd a (xn-sub b a)} {b} (sym (xn-le-split a b h))
    (subst {lzero} {lzero} {Nat} {λ u → q-le (qadd c a) u ≡ true} {qadd (qadd c a) (xn-sub b a)} {qadd c (qadd a (xn-sub b a))} (xn-assoc c a (xn-sub b a)) (xn-le-add (qadd c a) (xn-sub b a)))
xn8-le : (a b : Nat) → q-le a b ≡ true → q-le (xn8 a) (xn8 b) ≡ true
xn8-le a b h =
  subst {lzero} {lzero} {Nat} {λ u → q-le (xn8 a) (xn8 u) ≡ true} {qadd a (xn-sub b a)} {b} (sym (xn-le-split a b h))
    (subst {lzero} {lzero} {Nat} {λ u → q-le (xn8 a) u ≡ true} {qadd (xn8 a) (xn8 (xn-sub b a))} {xn8 (qadd a (xn-sub b a))} (sym (xn8-add a (xn-sub b a))) (xn-le-add (xn8 a) (xn8 (xn-sub b a))))
-- ---------------------------------------------------------------- words through toNat
xs-tadd : (a b : Word) → toNat (wadd a b) ≡ qadd (toNat a) (toNat b)
xs-tadd a b = cong toNat (sym (plusw≡wadd a b)) ∙ %welimP (λ v → toNat (plusw a v) ≡ qadd (toNat a) (toNat v)) b (λ t → toNat a) (λ n h t → suc (h t))
xs-tsub : (a b : Word) → toNat (wsub a b) ≡ xn-sub (toNat a) (toNat b)
xs-tsub a b =
  cong toNat (sym (subw≡wsub a b)) ∙
  %welimP (λ v → (u : Word) → toNat (subw v u) ≡ xn-sub (toNat v) (toNat u)) a (λ u t → zero)
    (λ n h u → %welimP (λ v → toNat (subw (%wsucc n) v) ≡ xn-sub (suc (toNat n)) (toNat v)) u (λ t → suc (toNat n)) (λ m g → h m)) b
xs-tlt : (a b : Word) → wlt a b ≡ q-le (suc (toNat a)) (toNat b)
xs-tlt a b =
  sym (ltw≡wlt a b) ∙
  %welimP (λ v → (u : Word) → ltw v u ≡ q-le (suc (toNat v)) (toNat u)) a
    (λ u → %welimP (λ v → ltw #0 v ≡ q-le (suc zero) (toNat v)) u (λ t → false) (λ m g t → true))
    (λ n h u → %welimP (λ v → ltw (%wsucc n) v ≡ q-le (suc (suc (toNat n))) (toNat v)) u (λ t → false) (λ m g → h m)) b
xs-teq : (a b : Word) → weq a b ≡ neqb (toNat a) (toNat b)
xs-teq a b =
  sym (eqw≡weq a b) ∙
  %welimP (λ v → (u : Word) → eqw v u ≡ neqb (toNat v) (toNat u)) a
    (λ u → %welimP (λ v → eqw #0 v ≡ neqb zero (toNat v)) u (λ t → true) (λ m g t → false))
    (λ n h u → %welimP (λ v → eqw (%wsucc n) v ≡ neqb (suc (toNat n)) (toNat v)) u (λ t → false) (λ m g → h m)) b
xs-tinj : (a b : Word) → toNat a ≡ toNat b → a ≡ b
xs-tinj a b h = sym (fromNat-toNat a) ∙ cong fromNat h ∙ fromNat-toNat b
xn-cat : (x y z : Nat) → x ≡ y → y ≡ z → x ≡ z
xn-cat x y z p q = p ∙ q
xs-t8 : (w : Word) → toNat (w8 w) ≡ xn8 (toNat w)
xs-t8 w =
  xn-cat (toNat (w8 w)) (qadd (toNat (wadd (wadd w w) (wadd w w))) (toNat (wadd (wadd w w) (wadd w w)))) (xn8 (toNat w))
    (xs-tadd (wadd (wadd w w) (wadd w w)) (wadd (wadd w w) (wadd w w)))
    (xn-cat (qadd (toNat (wadd (wadd w w) (wadd w w))) (toNat (wadd (wadd w w) (wadd w w)))) (qadd (qadd (toNat (wadd w w)) (toNat (wadd w w))) (qadd (toNat (wadd w w)) (toNat (wadd w w)))) (xn8 (toNat w))
      (λ t → qadd (xs-tadd (wadd w w) (wadd w w) t) (xs-tadd (wadd w w) (wadd w w) t))
      (λ t → qadd (qadd (xs-tadd w w t) (xs-tadd w w t)) (qadd (xs-tadd w w t) (xs-tadd w w t))))
-- the order on words, as the order on their naturals
xs-nlt : (a b : Word) → wlt a b ≡ false → q-le (toNat b) (toNat a) ≡ true
xs-nlt a b h = xn-nlt-le (toNat b) (toNat a) (sym (xs-tlt a b) ∙ h)
xs-lt : (a b : Word) → wlt a b ≡ true → q-le (suc (toNat a)) (toNat b) ≡ true
xs-lt a b h = sym (xs-tlt a b) ∙ h
xs-mk-nlt : (a b : Word) → q-le (toNat b) (toNat a) ≡ true → wlt a b ≡ false
xs-mk-nlt a b h = xs-tlt a b ∙ xn-le-nlt (toNat b) (toNat a) h
xs-mk-lt : (a b : Word) → q-le (suc (toNat a)) (toNat b) ≡ true → wlt a b ≡ true
xs-mk-lt a b h = xs-tlt a b ∙ h
-- distinct naturals: a < b gives neqb a b ≡ false, and b < a too
xn-lt-neq : (a b : Nat) → q-le (suc a) b ≡ true → neqb a b ≡ false
xn-lt-neq zero zero h = Empty-rec (false≢true h)
xn-lt-neq zero (suc b) h = λ t → false
xn-lt-neq (suc a) zero h = Empty-rec (false≢true h)
xn-lt-neq (suc a) (suc b) h = xn-lt-neq a b h
xn-gt-neq : (a b : Nat) → q-le (suc b) a ≡ true → neqb a b ≡ false
xn-gt-neq zero b h = Empty-rec (false≢true h)
xn-gt-neq (suc a) zero h = λ t → false
xn-gt-neq (suc a) (suc b) h = xn-gt-neq a b h
xs-weq-lt : (a b : Word) → q-le (suc (toNat a)) (toNat b) ≡ true → weq a b ≡ false
xs-weq-lt a b h = xs-teq a b ∙ xn-lt-neq (toNat a) (toNat b) h
xs-weq-gt : (a b : Word) → q-le (suc (toNat b)) (toNat a) ≡ true → weq a b ≡ false
xs-weq-gt a b h = xs-teq a b ∙ xn-gt-neq (toNat a) (toNat b) h
neqb-refl0 : (d : Nat) → neqb d d ≡ true
neqb-refl0 zero = λ t → true
neqb-refl0 (suc d) = neqb-refl0 d
xs-weq-refl : (a : Word) → weq a a ≡ true
xs-weq-refl a = xs-teq a a ∙ neqb-refl0 (toNat a)
xs-lt-self : (x : Word) → wlt x x ≡ false
xs-lt-self x = xs-mk-nlt x x (xn-le-refl (toNat x))
-- ---------------------------------------------------------------- more arithmetic: the stack's
xn-le-eq : (a b a2 b2 : Nat) → a ≡ a2 → b ≡ b2 → q-le a b ≡ true → q-le a2 b2 ≡ true
xn-le-eq a b a2 b2 ha hb h = subst {lzero} {lzero} {Nat} {λ u → q-le u b2 ≡ true} {a} {a2} ha (subst {lzero} {lzero} {Nat} {λ u → q-le a u ≡ true} {b} {b2} hb h)
xn-sub-le : (a b : Nat) → q-le (xn-sub a b) a ≡ true
xn-sub-le zero b = λ t → true
xn-sub-le (suc a) zero = xn-le-refl a
xn-sub-le (suc a) (suc b) = xn-le-trans (xn-sub a b) a (suc a) (xn-sub-le a b) (xn-le-add a (suc zero))
xn-sub-lt : (p k : Nat) → q-le (suc k) p ≡ true → q-le (suc (xn-sub p (suc k))) p ≡ true
xn-sub-lt zero k h = Empty-rec (false≢true h)
xn-sub-lt (suc p) k h = xn-sub-le p k
-- (x + r) + y, as x + (y + r)
xn-rot : (x y r : Nat) → qadd x (qadd y r) ≡ qadd (qadd x r) y
xn-rot x y r = cong (λ u → qadd x u) (xn-comm y r) ∙ sym (xn-assoc x r y)
-- y <= z gives x <= (x + z) - y
xn-le-subadd : (x y z : Nat) → q-le y z ≡ true → q-le x (xn-sub (qadd x z) y) ≡ true
xn-le-subadd x y z h =
  xn-le-eq x (qadd x (xn-sub z y)) x (xn-sub (qadd x z) y) (λ t → x)
    (sym (xn-sub-add (qadd x (xn-sub z y)) y) ∙ cong (λ u → xn-sub u y) (sym (xn-rot x y (xn-sub z y)) ∙ cong (λ u → qadd x u) (sym (xn-le-split y z h))))
    (xn-le-add x (xn-sub z y))
-- s + k <= p gives s <= p - k
xn-le-sub : (s k p : Nat) → q-le (qadd s k) p ≡ true → q-le s (xn-sub p k) ≡ true
xn-le-sub s k p h =
  xn-le-eq s (qadd s (xn-sub p (qadd s k))) s (xn-sub p k) (λ t → s)
    (sym (xn-sub-add (qadd s (xn-sub p (qadd s k))) k) ∙ cong (λ u → xn-sub u k) (sym (xn-rot s k (xn-sub p (qadd s k))) ∙ sym (xn-assoc s k (xn-sub p (qadd s k))) ∙ sym (xn-le-split (qadd s k) p h)))
    (xn-le-add s (xn-sub p (qadd s k)))
xn-sub-back : (k p : Nat) → q-le k p ≡ true → qadd (xn-sub p k) k ≡ p
xn-sub-back k p h = xn-comm (xn-sub p k) k ∙ sym (xn-le-split k p h)
-- ---------------------------------------------------------------- order facts on words
xs-lt-le : (x f f2 : Word) → wlt x f ≡ true → wlt f2 f ≡ false → wlt x f2 ≡ true
xs-lt-le x f f2 h1 h2 = xs-mk-lt x f2 (xn-le-trans (suc (toNat x)) (toNat f) (toNat f2) (xs-lt x f h1) (xs-nlt f2 f h2))
xs-ge-trans : (x p p2 : Word) → wlt x p ≡ false → wlt p p2 ≡ false → wlt x p2 ≡ false
xs-ge-trans x p p2 h1 h2 = xs-mk-nlt x p2 (xn-le-trans (toNat p2) (toNat p) (toNat x) (xs-nlt p p2 h2) (xs-nlt x p h1))
xs-lt-ge : (x p : Word) → wlt x p ≡ true → wlt p x ≡ false
xs-lt-ge x p h = xs-mk-nlt p x (xn-le-trans (toNat x) (suc (toNat x)) (toNat p) (xn-le-add (toNat x) (suc zero)) (xs-lt x p h))
-- ---------------------------------------------------------------- the memory
xs-upd-miss : (m : Word → Word) (a v x : Word) → weq x a ≡ false → upd m a v x ≡ m x
xs-upd-miss m a v x h = subst {lzero} {lzero} {Bool} {λ bb → (if bb then v else m x) ≡ m x} {false} {weq x a} (sym h) (λ t → m x)
xs-upd-hit : (m : Word → Word) (a v : Word) → upd m a v a ≡ v
xs-upd-hit m a v = subst {lzero} {lzero} {Bool} {λ bb → (if bb then v else m a) ≡ v} {true} {weq a a} (sym (xs-weq-refl a)) (λ t → v)
-- the frame: memory below the arena pointer f, and from the stack pointer p up, unchanged
XFr : (Word → Word) → (Word → Word) → Word → Word → Type
XFr m m2 f p = ((x : Word) → wlt x f ≡ true → m2 x ≡ m x) × ((x : Word) → wlt x p ≡ false → m2 x ≡ m x)
xs-fr-refl : (m : Word → Word) (f p : Word) → XFr m m f p
xs-fr-refl m f p = ((λ x h t → m x) , (λ x h t → m x))
-- frames compose: the second from an arena pointer at least the first's and a stack pointer at most
xs-fr-trans : (m m2 m3 : Word → Word) (f p f2 p2 : Word) → XFr m m2 f p → XFr m2 m3 f2 p2 → wlt f2 f ≡ false → wlt p p2 ≡ false → XFr m m3 f p
xs-fr-trans m m2 m3 f p f2 p2 h1 h2 hf hp =
  ((λ x hx → fst h2 x (xs-lt-le x f f2 hx hf) ∙ fst h1 x hx) , (λ x hx → snd h2 x (xs-ge-trans x p p2 hx hp) ∙ snd h1 x hx))
-- a store at q, at or above f and below p
xs-fr-wr : (m : Word → Word) (q v f p : Word) → wlt q f ≡ false → wlt q p ≡ true → XFr m (upd m q v) f p
xs-fr-wr m q v f p hf hp =
  ((λ x hx → xs-upd-miss m q v x (xs-weq-lt x q (xn-le-trans (suc (toNat x)) (toNat f) (toNat q) (xs-lt x f hx) (xs-nlt q f hf)))) ,
   (λ x hx → xs-upd-miss m q v x (xs-weq-gt x q (xn-le-trans (suc (toNat q)) (toNat p) (toNat x) (xs-lt q p hp) (xs-nlt x p hx)))))
-- ---------------------------------------------------------------- outcomes, as posts
-- what is claimed of an outcome: Q of a state the code ends in, J at a loop's back jump, E at its end
-- jump, R returned; nothing of a limit hit or of no value
XSP : XO → (XM → Type) → (XM → Type) → (XM → Type) → (XM → Type) → Type
XSP (xon s) Q J E R = Q s
XSP (xjh s) Q J E R = J s
XSP (xje s) Q J E R = E s
XSP (xrt s) Q J E R = R s
XSP xlim Q J E R = Unit
XSP xbot Q J E R = Unit
XE0 : XM → Type
XE0 s = Empty
xs-then : (o : XO) (k : XM → XO) (Q Q2 J E R : XM → Type) → XSP o Q J E R → ((s : XM) → Q s → XSP (k s) Q2 J E R) → XSP (xthen o k) Q2 J E R
xs-then (xon s) k Q Q2 J E R h f = f s h
xs-then (xjh s) k Q Q2 J E R h f = h
xs-then (xje s) k Q Q2 J E R h f = h
xs-then (xrt s) k Q Q2 J E R h f = h
xs-then xlim k Q Q2 J E R h f = unit
xs-then xbot k Q Q2 J E R h f = unit
-- a step then code-then-code, as the step then code, then code
xs-ra-step : (G : Word → XA) (B : XB) (k : XE) (o : XO) (r b : XA) → ((s2 : XM) → xrun G B k (xapp r b) s2 ≡ xthen (xrun G B k r s2) (λ s3 → xrun G B k b s3))
           → xthen o (λ s2 → xrun G B k (xapp r b) s2) ≡ xthen (xthen o (λ s2 → xrun G B k r s2)) (λ s2 → xrun G B k b s2)
xs-ra-step G B k (xon s) r b ih = ih s
xs-ra-step G B k (xjh s) r b ih = λ t → xjh s
xs-ra-step G B k (xje s) r b ih = λ t → xje s
xs-ra-step G B k (xrt s) r b ih = λ t → xrt s
xs-ra-step G B k xlim r b ih = λ t → xlim
xs-ra-step G B k xbot r b ih = λ t → xbot
-- code then code: the second from where the first ends
xs-run-app : (G : Word → XA) (B : XB) (k : XE) (a b : XA) (s : XM) → xrun G B k (xapp a b) s ≡ xthen (xrun G B k a s) (λ s2 → xrun G B k b s2)
xs-run-app G B k xnil b s = λ t → xrun G B k b s
xs-run-app G B k (xseq (xif t1 e1) r) b s = xs-ra-step G B k (xif-of (x-rax s) (xrun G B k t1 s) (xrun G B k e1 s)) r b (λ s2 → xs-run-app G B k r b s2)
xs-run-app G B k (xseq (xloop t1) r) b s = xs-ra-step G B k (xe-lp k t1 s) r b (λ s2 → xs-run-app G B k r b s2)
xs-run-app G B k (xseq (xcall g) r) b s = xs-ra-step G B k (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev k (G g) s2))) r b (λ s2 → xs-run-app G B k r b s2)
xs-run-app G B k (xseq i r) b s = xs-ra-step G B k (xstep B i s) r b (λ s2 → xs-run-app G B k r b s2)
xs-run-app G B k t b s = λ t2 → xbot
xs-app : (G : Word → XA) (B : XB) (k : XE) (a b : XA) (s : XM) (Q R J E Rt : XM → Type) → XSP (xrun G B k a s) Q J E Rt
       → ((s2 : XM) → Q s2 → XSP (xrun G B k b s2) R J E Rt) → XSP (xrun G B k (xapp a b) s) R J E Rt
xs-app G B k a b s Q R J E Rt h f =
  subst {lzero} {lzero} {XO} {λ o → XSP o R J E Rt} {xthen (xrun G B k a s) (λ s2 → xrun G B k b s2)} {xrun G B k (xapp a b) s} (sym (xs-run-app G B k a b s))
    (xs-then (xrun G B k a s) (λ s2 → xrun G B k b s2) Q R J E Rt h f)
-- a checked step: no limit, the state it gives
xs-ifl : (bb : Bool) (s2 : XM) (Q J E R : XM → Type) → (bb ≡ false → Q s2) → XSP (if bb then xlim else xon s2) Q J E R
xs-ifl true s2 Q J E R h = unit
xs-ifl false s2 Q J E R h = h (λ t → false)
xs-ifr : (bb : Bool) (s2 : XM) (Q J E R : XM → Type) → (bb ≡ true → Q s2) → XSP (if bb then xon s2 else xlim) Q J E R
xs-ifr true s2 Q J E R h = h (λ t → true)
xs-ifr false s2 Q J E R h = unit
-- code that ends: its end state
xs-on : (o : XO) (Q J E R : XM → Type) → XSP o Q J E R → XSP (xthen o (λ s → xon s)) Q J E R
xs-on (xon s) Q J E R h = h
xs-on (xjh s) Q J E R h = h
xs-on (xje s) Q J E R h = h
xs-on (xrt s) Q J E R h = h
xs-on xlim Q J E R h = unit
xs-on xbot Q J E R h = unit
-- ---------------------------------------------------------------- values in the machine
-- a first-order value refined by a word, in memory m with the arena pointer at f: none by anything; a
-- word, an Int64, a Float64 by the word of its bits; a constructor by an address below f holding its tag,
-- its fields from the next word on (a chain: each address below f, its value refining, the rest 8
-- bytes on); closures, λs and byte strings by nothing (the x86 fragment makes none)
XSV : (Word → Word) → Word → KQ → Word → Type
XSV m f kqbot w = Unit
XSV m f (kqw x) w = w ≡ x
XSV m f (kqi x) w = w ≡ x
XSV m f (kqf x) w = w ≡ x
XSV m f (kqcon d c fs) w = (wlt w f ≡ true) × ((m w ≡ c) × XSV m f fs (wadd w #8))
XSV m f (kqclos g env) w = Empty
XSV m f (kqlam b env) w = Empty
XSV m f (kqb l) w = Empty
XSV m f kqnil w = Unit
XSV m f (kqcons x r) w = (wlt w f ≡ true) × (XSV m f x (m w) × XSV m f r (wadd w #8))
-- preserved as the arena grows, memory below the old pointer unchanged
xs-vmono : (m m2 : Word → Word) (f f2 : Word) → ((x : Word) → wlt x f ≡ true → m2 x ≡ m x) → wlt f2 f ≡ false → (v : KQ) (w : Word) → XSV m f v w → XSV m2 f2 v w
xs-vmono m m2 f f2 hm hf kqbot w h = unit
xs-vmono m m2 f f2 hm hf (kqw x) w h = h
xs-vmono m m2 f f2 hm hf (kqi x) w h = h
xs-vmono m m2 f f2 hm hf (kqf x) w h = h
xs-vmono m m2 f f2 hm hf (kqcon d c fs) w h = (xs-lt-le w f f2 (fst h) hf , (hm w (fst h) ∙ fst (snd h) , xs-vmono m m2 f f2 hm hf fs (wadd w #8) (snd (snd h))))
xs-vmono m m2 f f2 hm hf (kqclos g env) w h = h
xs-vmono m m2 f f2 hm hf (kqlam b env) w h = h
xs-vmono m m2 f f2 hm hf (kqb l) w h = h
xs-vmono m m2 f f2 hm hf kqnil w h = unit
xs-vmono m m2 f f2 hm hf (kqcons x r) w h =
  (xs-lt-le w f f2 (fst h) hf ,
   (subst {lzero} {lzero} {Word} {λ u → XSV m2 f2 x u} {m w} {m2 w} (sym (hm w (fst h))) (xs-vmono m m2 f f2 hm hf x (m w) (fst (snd h))) ,
    xs-vmono m m2 f f2 hm hf r (wadd w #8) (snd (snd h))))
-- ---------------------------------------------------------------- the stack
-- rbp is rsp plus eight bytes per slot pushed: d slots
XDp : Word → Word → Word → Type
XDp b p d = toNat b ≡ qadd (toNat p) (xn8 (toNat d))
xs-t1 : (j : Word) → toNat (wadd j #1) ≡ suc (toNat j)
xs-t1 j = xs-tadd j #1
xs-tslot : (b j : Word) → toNat (slot-a b j) ≡ xn-sub (toNat b) (xn8 (suc (toNat j)))
xs-tslot b j = xs-tsub b (w8 (wadd j #1)) ∙ cong (λ u → xn-sub (toNat b) u) (xs-t8 (wadd j #1) ∙ cong xn8 (xs-t1 j))
-- a slot below d is at rsp or above
xs-slot-ge : (b p d j : Word) → XDp b p d → wlt j d ≡ true → wlt (slot-a b j) p ≡ false
xs-slot-ge b p d j hd hj =
  xs-mk-nlt (slot-a b j) p
    (xn-le-eq (toNat p) (xn-sub (qadd (toNat p) (xn8 (toNat d))) (xn8 (suc (toNat j)))) (toNat p) (toNat (slot-a b j)) (λ t → toNat p)
       (sym (xs-tslot b j ∙ cong (λ u → xn-sub u (xn8 (suc (toNat j)))) hd))
       (xn-le-subadd (toNat p) (xn8 (suc (toNat j))) (xn8 (toNat d)) (xn8-le (suc (toNat j)) (toNat d) (xs-lt j d hj))))
-- slot d is where the next push writes
xs-slot-top : (b p d : Word) → XDp b p d → slot-a b d ≡ wsub p #8
xs-slot-top b p d hd =
  xs-tinj (slot-a b d) (wsub p #8)
    (xs-tslot b d ∙ cong (λ u → xn-sub u (xn8 (suc (toNat d)))) hd ∙ cong (λ u → xn-sub (qadd (toNat p) (xn8 (toNat d))) u) (xn8-add (toNat d) (suc zero))
       ∙ xn-sub-cancel (toNat p) (xn8 (toNat d)) (xn8 (suc zero)) ∙ sym (xs-tsub p #8))
-- the top slot is at rsp
xs-slot-pop : (b p d : Word) → XDp b p (wadd d #1) → slot-a b d ≡ p
xs-slot-pop b p d hd =
  xs-tinj (slot-a b d) p (xs-tslot b d ∙ cong (λ u → xn-sub u (xn8 (suc (toNat d)))) (hd ∙ cong (λ u → qadd (toNat p) (xn8 u)) (xs-t1 d)) ∙ xn-sub-add (toNat p) (xn8 (suc (toNat d))))
xs-dp-push : (b p d : Word) → XDp b p d → wlt p #8 ≡ false → XDp b (wsub p #8) (wadd d #1)
xs-dp-push b p d hd h8 =
  hd ∙ cong (λ u → qadd u (xn8 (toNat d))) (sym (xn-sub-back (toNat #8) (toNat p) (xs-nlt p #8 h8))) ∙ xn-assoc (xn-sub (toNat p) (toNat #8)) (toNat #8) (xn8 (toNat d))
     ∙ cong (λ u → qadd (xn-sub (toNat p) (toNat #8)) u) (xn-comm (toNat #8) (xn8 (toNat d)) ∙ sym (xn8-add (toNat d) (suc zero)))
     ∙ cong (λ u → qadd u (xn8 (suc (toNat d)))) (sym (xs-tsub p #8)) ∙ cong (λ u → qadd (toNat (wsub p #8)) (xn8 u)) (sym (xs-t1 d))
xs-dp-pop : (b p d k : Word) → XDp b p (wadd d k) → XDp b (wadd p (w8 k)) d
xs-dp-pop b p d k hd =
  hd ∙ cong (λ u → qadd (toNat p) (xn8 u)) (xs-tadd d k) ∙ cong (λ u → qadd (toNat p) u) (xn8-add (toNat d) (toNat k)) ∙ xn-rot (toNat p) (xn8 (toNat d)) (xn8 (toNat k))
     ∙ cong (λ u → qadd u (xn8 (toNat d))) (sym (xs-tadd p (w8 k) ∙ cong (λ u → qadd (toNat p) u) (xs-t8 k)))
xs-dp-pop1 : (b p d : Word) → XDp b p (wadd d #1) → XDp b (wadd p #8) d
xs-dp-pop1 b p d hd = xs-dp-pop b p d #1 hd
xs-lt-s : (d : Word) → wlt d (wadd d #1) ≡ true
xs-lt-s d = xs-mk-lt d (wadd d #1) (xn-le-eq (suc (toNat d)) (suc (toNat d)) (suc (toNat d)) (toNat (wadd d #1)) (λ t → suc (toNat d)) (sym (xs-t1 d)) (xn-le-refl (toNat d)))
xs-le-s : (d : Word) → wlt (wadd d #1) d ≡ false
xs-le-s d = xs-lt-ge d (wadd d #1) (xs-lt-s d)
-- a push: rsp from slo + 8 up gives the new rsp from slo up, below rsp, at or above every arena
-- address below ahi; rsp at least 8; the push undone by adding 8
xs-psl : (B : XB) (p : Word) → q-le (qadd (toNat (b-slo B)) (toNat #8)) (toNat p) ≡ true → wlt (wsub p #8) (b-slo B) ≡ false
xs-psl B p h = xs-mk-nlt (wsub p #8) (b-slo B) (xn-le-eq (toNat (b-slo B)) (xn-sub (toNat p) (toNat #8)) (toNat (b-slo B)) (toNat (wsub p #8)) (λ t → toNat (b-slo B)) (sym (xs-tsub p #8)) (xn-le-sub (toNat (b-slo B)) (toNat #8) (toNat p) h))
xs-push-ok3 : (B : XB) (p f : Word) → wlt (b-slo B) (b-ahi B) ≡ false → wlt (b-ahi B) f ≡ false → q-le (qadd (toNat (b-slo B)) (toNat #8)) (toNat p) ≡ true → q-le (toNat #8) (toNat p) ≡ true
            → (wlt (wsub p #8) (b-slo B) ≡ false) × ((wlt (wsub p #8) p ≡ true) × ((wlt (wsub p #8) f ≡ false) × ((wlt p #8 ≡ false) × (wadd (wsub p #8) #8 ≡ p))))
xs-push-ok3 B p f hAS hA h h8 =
  (xs-psl B p h ,
   (xs-mk-lt (wsub p #8) p (xn-le-eq (suc (xn-sub (toNat p) (toNat #8))) (toNat p) (suc (toNat (wsub p #8))) (toNat p) (cong suc (sym (xs-tsub p #8))) (λ t → toNat p) (xn-sub-lt (toNat p) (toNat #7) h8)) ,
    (xs-ge-trans (wsub p #8) (b-slo B) f (xs-psl B p h) (xs-ge-trans (b-slo B) (b-ahi B) f hAS hA) ,
     (xs-mk-nlt p #8 h8 ,
      xs-tinj (wadd (wsub p #8) #8) p (xs-tadd (wsub p #8) #8 ∙ cong (λ u → qadd u (toNat #8)) (xs-tsub p #8) ∙ xn-sub-back (toNat #8) (toNat p) h8)))))
xs-push-ok2 : (B : XB) (p f : Word) → wlt (b-slo B) (b-ahi B) ≡ false → wlt (b-ahi B) f ≡ false → q-le (qadd (toNat (b-slo B)) (toNat #8)) (toNat p) ≡ true
            → (wlt (wsub p #8) (b-slo B) ≡ false) × ((wlt (wsub p #8) p ≡ true) × ((wlt (wsub p #8) f ≡ false) × ((wlt p #8 ≡ false) × (wadd (wsub p #8) #8 ≡ p))))
xs-push-ok2 B p f hAS hA h =
  xs-push-ok3 B p f hAS hA h (xn-le-trans (toNat #8) (qadd (toNat (b-slo B)) (toNat #8)) (toNat p) (xn-le-eq (toNat #8) (qadd (toNat #8) (toNat (b-slo B))) (toNat #8) (qadd (toNat (b-slo B)) (toNat #8)) (λ t → toNat #8) (xn-comm (toNat #8) (toNat (b-slo B))) (xn-le-add (toNat #8) (toNat (b-slo B)))) h)
xs-push-ok : (B : XB) (p f : Word) → wlt (b-slo B) (b-ahi B) ≡ false → wlt (b-ahi B) f ≡ false → wlt p (wadd (b-slo B) #8) ≡ false
           → (wlt (wsub p #8) (b-slo B) ≡ false) × ((wlt (wsub p #8) p ≡ true) × ((wlt (wsub p #8) f ≡ false) × ((wlt p #8 ≡ false) × (wadd (wsub p #8) #8 ≡ p))))
xs-push-ok B p f hAS hA hn =
  xs-push-ok2 B p f hAS hA
    (xn-le-eq (toNat (wadd (b-slo B) #8)) (toNat p) (qadd (toNat (b-slo B)) (toNat #8)) (toNat p) (xs-tadd (b-slo B) #8) (λ t → toNat p) (xs-nlt p (wadd (b-slo B) #8) hn))
-- ---------------------------------------------------------------- the environment
-- variable k of e: no value, or refined by the word in its slot, a slot below d
XEnv : (Word → Word) → Word → Word → Word → XL → KQ → Type
XEnv m f b d env e = (k : Nat) → Sum (q-nth e k ≡ kqbot) ((wlt (xl-nth env k) d ≡ true) × XSV m f (q-nth e k) (m (slot-a b (xl-nth env k))))
xs-env-m1 : (m m2 : Word → Word) (f f2 b p d : Word) (env : XL) (e : KQ) → XDp b p d → XFr m m2 f p → wlt f2 f ≡ false → (k : Nat)
          → Sum (q-nth e k ≡ kqbot) ((wlt (xl-nth env k) d ≡ true) × XSV m f (q-nth e k) (m (slot-a b (xl-nth env k))))
          → Sum (q-nth e k ≡ kqbot) ((wlt (xl-nth env k) d ≡ true) × XSV m2 f2 (q-nth e k) (m2 (slot-a b (xl-nth env k))))
xs-env-m1 m m2 f f2 b p d env e hd hfr hf k (inl q) = inl q
xs-env-m1 m m2 f f2 b p d env e hd hfr hf k (inr q) =
  inr (fst q , subst {lzero} {lzero} {Word} {λ u → XSV m2 f2 (q-nth e k) u} {m (slot-a b (xl-nth env k))} {m2 (slot-a b (xl-nth env k))}
                 (sym (snd hfr (slot-a b (xl-nth env k)) (xs-slot-ge b p d (xl-nth env k) hd (fst q)))) (xs-vmono m m2 f f2 (fst hfr) hf (q-nth e k) (m (slot-a b (xl-nth env k))) (snd q)))
-- preserved by a frame from rsp at depth d
xs-env-mono : (m m2 : Word → Word) (f f2 b p d : Word) (env : XL) (e : KQ) → XDp b p d → XFr m m2 f p → wlt f2 f ≡ false → XEnv m f b d env e → XEnv m2 f2 b d env e
xs-env-mono m m2 f f2 b p d env e hd hfr hf h = λ k → xs-env-m1 m m2 f f2 b p d env e hd hfr hf k (h k)
xs-env-e1 : (m : Word → Word) (f b d : Word) (env : XL) (e : KQ) (k : Nat)
          → Sum (q-nth e k ≡ kqbot) ((wlt (xl-nth env k) d ≡ true) × XSV m f (q-nth e k) (m (slot-a b (xl-nth env k))))
          → Sum (q-nth e k ≡ kqbot) ((wlt (xl-nth env k) (wadd d #1) ≡ true) × XSV m f (q-nth e k) (m (slot-a b (xl-nth env k))))
xs-env-e1 m f b d env e k (inl q) = inl q
xs-env-e1 m f b d env e k (inr q) = inr (xs-lt-le (xl-nth env k) d (wadd d #1) (fst q) (xs-le-s d) , snd q)
-- a value pushed into slot d: the environment one deeper
xs-env-ek : (m : Word → Word) (f b d : Word) (env : XL) (e v : KQ) → XEnv m f b d env e → XSV m f v (m (slot-a b d)) → (k : Nat)
          → Sum (q-nth (kqcons v e) k ≡ kqbot) ((wlt (xl-nth (xlcons d env) k) (wadd d #1) ≡ true) × XSV m f (q-nth (kqcons v e) k) (m (slot-a b (xl-nth (xlcons d env) k))))
xs-env-ek m f b d env e v h hv zero = inr (xs-lt-s d , hv)
xs-env-ek m f b d env e v h hv (suc k) = xs-env-e1 m f b d env e k (h k)
xs-env-ext : (m : Word → Word) (f b d : Word) (env : XL) (e v : KQ) → XEnv m f b d env e → XSV m f v (m (slot-a b d)) → XEnv m f b (wadd d #1) (xlcons d env) (kqcons v e)
xs-env-ext m f b d env e v h hv = λ k → xs-env-ek m f b d env e v h hv k
-- slots j, j + 1, ... holding a chain of n values
XSl : (Word → Word) → Word → Word → Word → Nat → KQ → Type
XSl m f b j n vs = (i : Nat) → q-le (suc i) n ≡ true → XSV m f (q-nth vs i) (m (slot-a b (wadd j (fromNat i))))
-- ---------------------------------------------------------------- what an expression's code is run from and ends in
-- at depth d: rbp − rsp the d slots, r15 at most ahi, rsp from slo up, rbp at most T, the environment
-- in its slots
XPre : XB → Word → XL → KQ → Word → XM → Type
XPre B T env e d (xm a c b p f r m) = XDp b p d × ((wlt (b-ahi B) f ≡ false) × ((wlt p (b-slo B) ≡ false) × ((wlt T b ≡ false) × XEnv m f b d env e)))
-- rbp and rsp as they were, r15 grown and at most ahi, memory below the old r15 and from rsp up
-- unchanged, the value in rax
XPT : XB → XM → KQ → XM → Type
XPT B (xm a c b p f r m) v (xm a2 c2 b2 p2 f2 r2 m2) = (b2 ≡ b) × ((p2 ≡ p) × ((wlt f2 f ≡ false) × ((wlt (b-ahi B) f2 ≡ false) × (XFr m m2 f p × XSV m2 f2 v a2))))
-- a literal: mov rax, imm64 (a limit from 2^64 up)
xs-lit : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d w : Word) (s : XM) → XPre B T env e d s
       → XSP (xrun GX B K (x1 (xmovimm w)) s) (XPT B s (kqw w)) XE0 XE0 XE0
xs-lit GX B K T env e d w (xm a c b p f r m) h =
  xs-on (xstep B (xmovimm w) (xm a c b p f r m)) (XPT B (xm a c b p f r m) (kqw w)) XE0 XE0 XE0
    (xs-ifr (x-fits w) (xm w c b p f r m) (XPT B (xm a c b p f r m) (kqw w)) XE0 XE0 XE0
       (λ hw → ((λ t → b) , ((λ t → p) , (xs-lt-self f , (fst (snd h) , (xs-fr-refl m f p , (λ t → w))))))))
-- a variable: its slot loaded
xs-vk : (m : Word → Word) (f : Word) (v : KQ) (w : Word) (P : Type) → Sum (v ≡ kqbot) (P × XSV m f v w) → XSV m f v w
xs-vk m f v w P (inl q) = subst {lzero} {lzero} {KQ} {λ u → XSV m f u w} {kqbot} {v} (sym q) unit
xs-vk m f v w P (inr q) = snd q
xs-var : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (k : Nat) (s : XM) → XPre B T env e d s
       → XSP (xrun GX B K (x1 (xload (xl-nth env k))) s) (XPT B s (q-nth e k)) XE0 XE0 XE0
xs-var GX B K T env e d k (xm a c b p f r m) h =
  ((λ t → b) , ((λ t → p) , (xs-lt-self f , (fst (snd h) , (xs-fr-refl m f p ,
     xs-vk m f (q-nth e k) (m (slot-a b (xl-nth env k))) (wlt (xl-nth env k) d ≡ true) (snd (snd (snd (snd h))) k))))))
-- ---------------------------------------------------------------- the primitives
-- a case on a Bool, both branches given
xs-bif : (A : Type) (bb : Bool) (x y : A) (F : A → Type) → (bb ≡ true → F x) → (bb ≡ false → F y) → F (if bb then x else y)
xs-bif A true x y F h1 h2 = h1 (λ t → true)
xs-bif A false x y F h1 h2 = h2 (λ t → false)
xs-bif2 : (bb : Bool) (c1 c2 : XA) (v1 v2 : KQ) (F : XA → KQ → Type) → (bb ≡ true → F c1 v1) → (bb ≡ false → F c2 v2) → F (if bb then c1 else c2) (if bb then v1 else v2)
xs-bif2 true c1 c2 v1 v2 F h1 h2 = h1 (λ t → true)
xs-bif2 false c1 c2 v1 v2 F h1 h2 = h2 (λ t → false)
-- an operation on two words refined
xs-ww : (m : Word → Word) (f : Word) (fn : Word → Word → Word) (va vb : KQ) (ra rb w : Word) → XSV m f va ra → XSV m f vb rb → w ≡ fn ra rb → XSV m f (q-ww fn (kqcons va (kqcons vb kqnil))) w
xs-ww m f fn (kqw x) (kqw y) ra rb w ha hb hw = hw ∙ (λ t → fn (ha t) (hb t))
xs-ww m f fn va vb ra rb w ha hb hw = unit
-- ---------------------------------------------------------------- composing steps
-- a run from a state equal to the one given (rbp and rsp as paths)
xs-norm : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (Q J E R : XM → Type) (a1 c1 b1 p1 f1 : Word) (r1 m1 : Word → Word) (b p : Word) → b1 ≡ b → p1 ≡ p
        → XSP (xrun GX B K ko (xm a1 c1 b p f1 r1 m1)) Q J E R → XSP (xrun GX B K ko (xm a1 c1 b1 p1 f1 r1 m1)) Q J E R
xs-norm GX B K ko Q J E R a1 c1 b1 p1 f1 r1 m1 b p hb hp h =
  subst {lzero} {lzero} {XM} {λ s → XSP (xrun GX B K ko s) Q J E R} {xm a1 c1 b p f1 r1 m1} {xm a1 c1 b1 p1 f1 r1 m1} (λ t → xm a1 c1 (hb (~ t)) (hp (~ t)) f1 r1 m1) h
-- a checked step then code
xs-ifl-then : (bb : Bool) (S2 : XM) (k : XM → XO) (R J E Rt : XM → Type) → (bb ≡ false → XSP (k S2) R J E Rt) → XSP (xthen (if bb then xlim else xon S2) k) R J E Rt
xs-ifl-then true S2 k R J E Rt h = unit
xs-ifl-then false S2 k R J E Rt h = h (λ t → false)
xs-ifr-then : (bb : Bool) (S2 : XM) (k : XM → XO) (R J E Rt : XM → Type) → (bb ≡ true → XSP (k S2) R J E Rt) → XSP (xthen (if bb then xon S2 else xlim) k) R J E Rt
xs-ifr-then true S2 k R J E Rt h = h (λ t → true)
xs-ifr-then false S2 k R J E Rt h = unit
-- the environment one slot deeper (a value pushed that no variable names)
xs-env-deep : (m : Word → Word) (f b d : Word) (env : XL) (e : KQ) → XEnv m f b d env e → XEnv m f b (wadd d #1) env e
xs-env-deep m f b d env e h = λ k → xs-env-e1 m f b d env e k (h k)
-- a push of rax after an expression's code: the facts of the state it gives (memory m2 = upd m1 (p − 8) a1)
XPushF : XB → XL → KQ → Word → Word → Word → Word → (Word → Word) → Word → (Word → Word) → KQ → Type
XPushF B env e d b p f m f1 m2 v =
  XDp b (wsub p #8) (wadd d #1) × ((wlt (wsub p #8) (b-slo B) ≡ false) × ((wadd (wsub p #8) #8 ≡ p) × (XFr m m2 f p × (XEnv m2 f1 b d env e × XSV m2 f1 v (m2 (slot-a b d))))))
xs-pushed2 : (B : XB) (T : Word) (env : XL) (e : KQ) (d a c b p f : Word) (r m : Word → Word) (a1 f1 : Word) (m1 : Word → Word) (v : KQ)
           → XPre B T env e d (xm a c b p f r m) → wlt f1 f ≡ false → XFr m m1 f p → XSV m1 f1 v a1
           → (wlt (wsub p #8) (b-slo B) ≡ false) × ((wlt (wsub p #8) p ≡ true) × ((wlt (wsub p #8) f1 ≡ false) × ((wlt p #8 ≡ false) × (wadd (wsub p #8) #8 ≡ p))))
           → XPushF B env e d b p f m f1 (upd m1 (wsub p #8) a1) v
xs-pushed2 B T env e d a c b p f r m a1 f1 m1 v h0 hf1 fr1 hv po =
  (xs-dp-push b p d (fst h0) (fst (snd (snd (snd po)))) ,
   (fst po ,
    (snd (snd (snd (snd po))) ,
     (xs-fr-trans m m1 (upd m1 (wsub p #8) a1) f p f1 p fr1 (xs-fr-wr m1 (wsub p #8) a1 f1 p (fst (snd (snd po))) (fst (snd po))) hf1 (xs-lt-self p) ,
      (xs-env-mono m (upd m1 (wsub p #8) a1) f f1 b p d env e (fst h0)
         (xs-fr-trans m m1 (upd m1 (wsub p #8) a1) f p f1 p fr1 (xs-fr-wr m1 (wsub p #8) a1 f1 p (fst (snd (snd po))) (fst (snd po))) hf1 (xs-lt-self p)) hf1 (snd (snd (snd (snd h0))))) ,
       subst {lzero} {lzero} {Word} {λ u → XSV (upd m1 (wsub p #8) a1) f1 v u} {a1} {upd m1 (wsub p #8) a1 (slot-a b d)}
         (sym (cong (λ u → upd m1 (wsub p #8) a1 u) (xs-slot-top b p d (fst h0)) ∙ xs-upd-hit m1 (wsub p #8) a1))
         (xs-vmono m1 (upd m1 (wsub p #8) a1) f1 f1 (fst (xs-fr-wr m1 (wsub p #8) a1 f1 p (fst (snd (snd po))) (fst (snd po)))) (xs-lt-self f1) v a1 hv)))))
xs-pushed : (B : XB) (T : Word) (env : XL) (e : KQ) (d a c b p f : Word) (r m : Word → Word) (a1 f1 : Word) (m1 : Word → Word) (v : KQ) → wlt (b-slo B) (b-ahi B) ≡ false
          → XPre B T env e d (xm a c b p f r m) → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XFr m m1 f p → XSV m1 f1 v a1 → wlt p (wadd (b-slo B) #8) ≡ false
          → XPushF B env e d b p f m f1 (upd m1 (wsub p #8) a1) v
xs-pushed B T env e d a c b p f r m a1 f1 m1 v HB h0 hf1 ha1 fr1 hv hn =
  xs-pushed2 B T env e d a c b p f r m a1 f1 m1 v h0 hf1 fr1 hv (xs-push-ok B p f1 HB ha1 hn)
-- three frames, end to end
xs-le3 : (f f1 f2 : Word) → wlt f1 f ≡ false → wlt f2 f1 ≡ false → wlt f2 f ≡ false
xs-le3 f f1 f2 h1 h2 = xs-ge-trans f2 f1 f h2 h1
xs-fr3 : (m m1 m2 m3 : Word → Word) (f p f1 p1 f2 p2 : Word) → XFr m m1 f p → XFr m1 m2 f1 p1 → XFr m2 m3 f2 p2 → wlt f1 f ≡ false → wlt f2 f1 ≡ false → wlt p p1 ≡ false → wlt p1 p2 ≡ false → XFr m m3 f p
xs-fr3 m m1 m2 m3 f p f1 p1 f2 p2 h1 h2 h3 hf1 hf2 hp1 hp2 = xs-fr-trans m m2 m3 f p f2 p2 (xs-fr-trans m m1 m2 f p f1 p1 h1 h2 hf1 hp1) h3 (xs-le3 f f1 f2 hf1 hf2) (xs-ge-trans p p1 p2 hp1 hp2)
xs-psub : (p : Word) → wlt p (wsub p #8) ≡ false
xs-psub p = xs-mk-nlt p (wsub p #8) (xn-le-eq (xn-sub (toNat p) (toNat #8)) (toNat p) (toNat (wsub p #8)) (toNat p) (sym (xs-tsub p #8)) (λ t → toNat p) (xn-sub-le (toNat p) (toNat #8)))
-- ---------------------------------------------------------------- the addresses' arithmetic
xs-a3 : (d : Word) (k : Nat) → wadd (wadd d #1) (fromNat k) ≡ wadd d (fromNat (suc k))
xs-a3 d k =
  xs-tinj (wadd (wadd d #1) (fromNat k)) (wadd d (fromNat (suc k)))
    (xs-tadd (wadd d #1) (fromNat k) ∙ cong (λ u → qadd u (toNat (fromNat k))) (xs-t1 d) ∙ qadd-s (toNat d) (toNat (fromNat k)) ∙ sym (xs-tadd d (fromNat (suc k))))
xs-a1 : (w : Word) (j : Nat) → wadd (wadd w #8) (w8 (fromNat j)) ≡ wadd w (w8 (fromNat (suc j)))
xs-a1 w j =
  xs-tinj (wadd (wadd w #8) (w8 (fromNat j))) (wadd w (w8 (fromNat (suc j))))
    (xs-tadd (wadd w #8) (w8 (fromNat j)) ∙ cong (λ u → qadd u (toNat (w8 (fromNat j)))) (xs-tadd w #8) ∙ cong (λ u → qadd (qadd (toNat w) (toNat #8)) u) (xs-t8 (fromNat j))
       ∙ sym (xn-rot (toNat w) (xn8 (toNat (fromNat j))) (toNat #8)) ∙ cong (λ u → qadd (toNat w) u) (sym (xn8-add (toNat (fromNat j)) (suc zero)))
       ∙ sym (xs-tadd w (w8 (fromNat (suc j))) ∙ cong (λ u → qadd (toNat w) u) (xs-t8 (fromNat (suc j)))))
xs-a2 : (a k : Word) → fld-a a k ≡ wadd (wadd a #8) (w8 (fromNat (dnat k)))
xs-a2 a k =
  xs-tinj (fld-a a k) (wadd (wadd a #8) (w8 (fromNat (dnat k))))
    (xs-tadd a (w8 (wadd k #1)) ∙ cong (λ u → qadd (toNat a) u) (xs-t8 (wadd k #1) ∙ cong xn8 (xs-t1 k)) ∙ cong (λ u → qadd (toNat a) u) (xn8-add (toNat k) (suc zero))
       ∙ xn-rot (toNat a) (xn8 (toNat k)) (toNat #8) ∙ cong (λ u → qadd (qadd (toNat a) (toNat #8)) (xn8 u)) (sym (toNat-fromNat (dnat k)))
       ∙ sym (xs-tadd (wadd a #8) (w8 (fromNat (dnat k))) ∙ cong (λ u → qadd u (toNat (w8 (fromNat (dnat k))))) (xs-tadd a #8) ∙ cong (λ u → qadd (qadd (toNat a) (toNat #8)) u) (xs-t8 (fromNat (dnat k)))))
xs-a0 : (w : Word) → wadd w (w8 (fromNat zero)) ≡ w
xs-a0 w = wadd-zero-r w
xn-pred : Nat → Nat
xn-pred zero = zero
xn-pred (suc n) = n
xn-add-cancel : (a b x : Nat) → qadd a x ≡ qadd b x → a ≡ b
xn-add-cancel a b zero h = h
xn-add-cancel a b (suc x) h = xn-add-cancel a b x (cong xn-pred h)
-- two depths agreeing: the same rsp
xs-dp-inj : (b p p2 d : Word) → XDp b p d → XDp b p2 d → p2 ≡ p
xs-dp-inj b p p2 d h1 h2 = xs-tinj p2 p (xn-add-cancel (toNat p2) (toNat p) (xn8 (toNat d)) (sym h2 ∙ h1))
-- rsp at most rbp
xs-dp-le : (b p d : Word) → XDp b p d → wlt b p ≡ false
xs-dp-le b p d h = xs-mk-nlt b p (xn-le-eq (toNat p) (qadd (toNat p) (xn8 (toNat d))) (toNat p) (toNat b) (λ t → toNat p) (sym h) (xn-le-add (toNat p) (xn8 (toNat d))))
-- ---------------------------------------------------------------- posts, mapped
xs-map4 : (o : XO) (Q J E R Q2 J2 E2 R2 : XM → Type) → XSP o Q J E R → ((s : XM) → Q s → Q2 s) → ((s : XM) → J s → J2 s) → ((s : XM) → E s → E2 s) → ((s : XM) → R s → R2 s) → XSP o Q2 J2 E2 R2
xs-map4 (xon s) Q J E R Q2 J2 E2 R2 h fq fj fe fr = fq s h
xs-map4 (xjh s) Q J E R Q2 J2 E2 R2 h fq fj fe fr = fj s h
xs-map4 (xje s) Q J E R Q2 J2 E2 R2 h fq fj fe fr = fe s h
xs-map4 (xrt s) Q J E R Q2 J2 E2 R2 h fq fj fe fr = fr s h
xs-map4 xlim Q J E R Q2 J2 E2 R2 h fq fj fe fr = unit
xs-map4 xbot Q J E R Q2 J2 E2 R2 h fq fj fe fr = unit
xs-map : (o : XO) (Q Q2 : XM → Type) → XSP o Q XE0 XE0 XE0 → ((s : XM) → Q s → Q2 s) → XSP o Q2 XE0 XE0 XE0
xs-map o Q Q2 h fq = xs-map4 o Q XE0 XE0 XE0 Q2 XE0 XE0 XE0 h fq (λ s e → e) (λ s e → e) (λ s e → e)
-- a value in memory kept by a frame from p2, the arena grown
xs-keep : (M2 m3 : Word → Word) (f1 f3 p2 : Word) (v : KQ) → XFr M2 m3 f1 p2 → wlt f3 f1 ≡ false → (x : Word) → wlt x p2 ≡ false → XSV M2 f1 v (M2 x) → XSV m3 f3 v (m3 x)
xs-keep M2 m3 f1 f3 p2 v fr hf x hx h = subst {lzero} {lzero} {Word} {λ u → XSV m3 f3 v u} {M2 x} {m3 x} (sym (snd fr x hx)) (xs-vmono M2 m3 f1 f3 (fst fr) hf v (M2 x) h)
-- an expression's post, then one from where it ended: one post
xs-xpt2 : (B : XB) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word) (v : KQ) (s2 : XM) → wlt f1 f ≡ false → XFr m m1 f p → XPT B (xm a1 c1 b p f1 r1 m1) v s2 → XPT B (xm a c b p f r m) v s2
xs-xpt2 B a c b p f r m a1 c1 f1 r1 m1 v (xm a2 c2 b2 p2 f2 r2 m2) hf fr h2 =
  (fst h2 , (fst (snd h2) , (xs-le3 f f1 f2 hf (fst (snd (snd h2))) , (fst (snd (snd (snd h2))) , (xs-fr-trans m m1 m2 f p f1 p fr (fst (snd (snd (snd (snd h2))))) hf (xs-lt-self p) , snd (snd (snd (snd (snd h2)))))))))
-- the expression's precondition kept after an expression at the same depth
xs-pre-keep : (B : XB) (T : Word) (env : XL) (e : KQ) (d a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word) → XPre B T env e d (xm a c b p f r m)
            → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XFr m m1 f p → XPre B T env e d (xm a1 c1 b p f1 r1 m1)
xs-pre-keep B T env e d a c b p f r m a1 c1 f1 r1 m1 h0 hf ha fr =
  (fst h0 , (ha , (fst (snd (snd h0)) , (fst (snd (snd (snd h0))) , xs-env-mono m m1 f f1 b p d env e (fst h0) fr hf (snd (snd (snd (snd h0))))))))
-- ---------------------------------------------------------------- let: a; push rax; b; add rsp, 8
xs-let3 : (GX : Word → XA) (B : XB) (K : XE) (vb : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 M2 : Word → Word) → wlt f1 f ≡ false → XFr m M2 f p → wadd (wsub p #8) #8 ≡ p
        → (s3 : XM) → XPT B (xm a1 c1 b (wsub p #8) f1 r1 M2) vb s3 → XSP (xrun GX B K (x1 (xaddrsp #8)) s3) (XPT B (xm a c b p f r m) vb) XE0 XE0 XE0
xs-let3 GX B K vb a c b p f r m a1 c1 f1 r1 M2 hf1 fr hp (xm a3 c3 b3 p3 f3 r3 m3) h3 =
  xs-norm GX B K (x1 (xaddrsp #8)) (XPT B (xm a c b p f r m) vb) XE0 XE0 XE0 a3 c3 b3 p3 f3 r3 m3 b (wsub p #8) (fst h3) (fst (snd h3))
    ((λ t → b) , (hp , (xs-le3 f f1 f3 hf1 (fst (snd (snd h3))) , (fst (snd (snd (snd h3))) , (xs-fr-trans m M2 m3 f p f1 (wsub p #8) fr (fst (snd (snd (snd (snd h3))))) hf1 (xs-psub p) , snd (snd (snd (snd (snd h3)))))))))
xs-let2 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (cb : XA) (va vb : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word)
        → XPre B T env e d (xm a c b p f r m) → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XPushF B env e d b p f m f1 (upd m1 (wsub p #8) a1) va
        → ((s : XM) → XPre B T (xlcons d env) (kqcons va e) (wadd d #1) s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
        → XSP (xrun GX B K (xapp cb (x1 (xaddrsp #8))) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) (XPT B (xm a c b p f r m) vb) XE0 XE0 XE0
xs-let2 GX B K T env e d cb va vb a c b p f r m a1 c1 f1 r1 m1 h0 hf1 ha1 F ihb =
  xs-app GX B K cb (x1 (xaddrsp #8)) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (XPT B (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) vb) (XPT B (xm a c b p f r m) vb) XE0 XE0 XE0
    (ihb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))
       (fst F , (ha1 , (fst (snd F) , (fst (snd (snd (snd h0))) , xs-env-ext (upd m1 (wsub p #8) a1) f1 b d env e va (fst (snd (snd (snd (snd F))))) (snd (snd (snd (snd (snd F))))))))))
    (λ s3 h3 → xs-let3 GX B K vb a c b p f r m a1 c1 f1 r1 (upd m1 (wsub p #8) a1) hf1 (fst (snd (snd (snd F)))) (fst (snd (snd F))) s3 h3)
xs-let1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d : Word) (cb : XA) (va vb : KQ) (s0 s1 : XM) → XPre B T env e d s0 → XPT B s0 va s1
        → ((s : XM) → XPre B T (xlcons d env) (kqcons va e) (wadd d #1) s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
        → XSP (xrun GX B K (xseq xpushrax (xapp cb (x1 (xaddrsp #8)))) s1) (XPT B s0 vb) XE0 XE0 XE0
xs-let1 GX B K T HB env e d cb va vb (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 ihb =
  xs-norm GX B K (xseq xpushrax (xapp cb (x1 (xaddrsp #8)))) (XPT B (xm a c b p f r m) vb) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-ifl-then (wlt p (wadd (b-slo B) #8)) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (λ s2 → xrun GX B K (xapp cb (x1 (xaddrsp #8))) s2) (XPT B (xm a c b p f r m) vb) XE0 XE0 XE0
       (λ hn → xs-let2 GX B K T env e d cb va vb a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1))))
                 (xs-pushed B T env e d a c b p f r m a1 f1 m1 va HB h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd (snd h1))))) hn) ihb))
xs-let : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d : Word) (ca cb : XA) (va vb : KQ) (s0 : XM) → XPre B T env e d s0
       → XSP (xrun GX B K ca s0) (XPT B s0 va) XE0 XE0 XE0 → ((s : XM) → XPre B T (xlcons d env) (kqcons va e) (wadd d #1) s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
       → XSP (xrun GX B K (xapp ca (xseq xpushrax (xapp cb (x1 (xaddrsp #8))))) s0) (XPT B s0 vb) XE0 XE0 XE0
xs-let GX B K T HB env e d ca cb va vb s0 h0 iha ihb =
  xs-app GX B K ca (xseq xpushrax (xapp cb (x1 (xaddrsp #8)))) s0 (XPT B s0 va) (XPT B s0 vb) XE0 XE0 XE0 iha (λ s1 h1 → xs-let1 GX B K T HB env e d cb va vb s0 s1 h0 h1 ihb)
-- the operation's step: rax and rcx the operands, the result in rax (state xm ra rb b q f r m)
XOpG : (Word → XA) → XB → XE → (Word → Word) → Word → Word → Word → Word → Word → (Word → Word) → (XM → Type) → XA → KQ → Type
XOpG GX B K m f ra rb b q r Q i v = ((w : Word) → XSV m f v w → Q (xm w rb b q f r m)) → XSP (xrun GX B K (x1 i) (xm ra rb b q f r m)) Q XE0 XE0 XE0
-- the rest of q-prim's chain past the word operations
xs-qrest : Word → KQ → KQ
xs-qrest p as = if weq p #8 then q-ld8 as else if weq p #9 then q-st8 as else if weq p #10 then q-ld4 as else if weq p #11 then q-st4 as else if weq p #12 then q-1 qk-bytes as else if weq p #13 then q-1 q-blen as else if weq p #14 then q-ii (λ a b → dib (i64add (dbi a) (dbi b))) as else if weq p #15 then q-ii (λ a b → dib (i64sub (dbi a) (dbi b))) as else if weq p #16 then q-ii (λ a b → dib (i64mul (dbi a) (dbi b))) as else if weq p #17 then q-iw (λ a b → dbw (i64eq (dbi a) (dbi b))) as else if weq p #18 then q-iw (λ a b → dbw (i64lt (dbi a) (dbi b))) as else if weq p #19 then q-ff (λ a b → dfb (f64add (dbf a) (dbf b))) as else if weq p #20 then q-ff (λ a b → dfb (f64sub (dbf a) (dbf b))) as else if weq p #21 then q-ff (λ a b → dfb (f64mul (dbf a) (dbf b))) as else if weq p #22 then q-ff (λ a b → dfb (f64div (dbf a) (dbf b))) as else if weq p #23 then q-fw (λ a b → dbw (f64eq (dbf a) (dbf b))) as else if weq p #24 then q-fw (λ a b → dbw (f64lt (dbf a) (dbf b))) as else if weq p #25 then q-1 q-i-of-w as else if weq p #26 then q-1 q-w-of-i as else if weq p #27 then q-1 q-f-of-i as else if weq p #28 then q-1 q-i-of-f as else if weq p #29 then q-1 q-f-of-w as else if weq p #32 then q-1 q-bits as else if weq p #33 then q-1 q-ofbits as else kqbot
xs-op : (GX : Word → XA) (B : XB) (K : XE) (m : Word → Word) (f p : Word) (va vb : KQ) (ra rb b q : Word) (r : Word → Word) (Q : XM → Type) → XSV m f va ra → XSV m f vb rb
      → XOpG GX B K m f ra rb b q r Q (xop p) (q-prim p (kqcons va (kqcons vb kqnil)))
xs-op GX B K m f p va vb ra rb b q r Q ha hb =
  xs-bif2 (weq p #0) xadd (if weq p #1 then xsubt else (if weq p #2 then ximul else (if weq p #3 then xseteq else (if weq p #4 then xsetlt else xud2))))
    (q-ww wadd (kqcons va (kqcons vb kqnil))) (if weq p #1 then q-ww wsub (kqcons va (kqcons vb kqnil)) else (if weq p #2 then q-ww dmulw (kqcons va (kqcons vb kqnil)) else (if weq p #3 then q-ww (λ a b → dbw (weq a b)) (kqcons va (kqcons vb kqnil)) else (if weq p #4 then q-ww (λ a b → dbw (wlt a b)) (kqcons va (kqcons vb kqnil)) else xs-qrest p (kqcons va (kqcons vb kqnil))))))
    (XOpG GX B K m f ra rb b q r Q)
    (λ h0 hk → xs-ifr-then (x-fits (wadd ra rb)) (xm (wadd ra rb) rb b q f r m) (λ s → xrun GX B K xnil s) Q XE0 XE0 XE0 (λ hf → hk (wadd ra rb) (xs-ww m f wadd va vb ra rb (wadd ra rb) ha hb (λ t → wadd ra rb))))
    (λ h0 → xs-bif2 (weq p #1) xsubt (if weq p #2 then ximul else (if weq p #3 then xseteq else (if weq p #4 then xsetlt else xud2)))
       (q-ww wsub (kqcons va (kqcons vb kqnil))) (if weq p #2 then q-ww dmulw (kqcons va (kqcons vb kqnil)) else (if weq p #3 then q-ww (λ a b → dbw (weq a b)) (kqcons va (kqcons vb kqnil)) else (if weq p #4 then q-ww (λ a b → dbw (wlt a b)) (kqcons va (kqcons vb kqnil)) else xs-qrest p (kqcons va (kqcons vb kqnil)))))
       (XOpG GX B K m f ra rb b q r Q)
       (λ h1 hk → hk (wsub ra rb) (xs-ww m f wsub va vb ra rb (wsub ra rb) ha hb (λ t → wsub ra rb)))
       (λ h1 → xs-bif2 (weq p #2) ximul (if weq p #3 then xseteq else (if weq p #4 then xsetlt else xud2))
          (q-ww dmulw (kqcons va (kqcons vb kqnil))) (if weq p #3 then q-ww (λ a b → dbw (weq a b)) (kqcons va (kqcons vb kqnil)) else (if weq p #4 then q-ww (λ a b → dbw (wlt a b)) (kqcons va (kqcons vb kqnil)) else xs-qrest p (kqcons va (kqcons vb kqnil))))
          (XOpG GX B K m f ra rb b q r Q)
          (λ h2 hk → xs-ifr-then (x-fits (dmulw ra rb)) (xm (dmulw ra rb) rb b q f r m) (λ s → xrun GX B K xnil s) Q XE0 XE0 XE0 (λ hf → hk (dmulw ra rb) (xs-ww m f dmulw va vb ra rb (dmulw ra rb) ha hb (λ t → dmulw ra rb))))
          (λ h2 → xs-bif2 (weq p #3) xseteq (if weq p #4 then xsetlt else xud2)
             (q-ww (λ a b → dbw (weq a b)) (kqcons va (kqcons vb kqnil))) (if weq p #4 then q-ww (λ a b → dbw (wlt a b)) (kqcons va (kqcons vb kqnil)) else xs-qrest p (kqcons va (kqcons vb kqnil)))
             (XOpG GX B K m f ra rb b q r Q)
             (λ h3 hk → hk (dbw (weq ra rb)) (xs-ww m f (λ a b → dbw (weq a b)) va vb ra rb (dbw (weq ra rb)) ha hb (λ t → dbw (weq ra rb))))
             (λ h3 → xs-bif2 (weq p #4) xsetlt xud2
                (q-ww (λ a b → dbw (wlt a b)) (kqcons va (kqcons vb kqnil))) (xs-qrest p (kqcons va (kqcons vb kqnil)))
                (XOpG GX B K m f ra rb b q r Q)
                (λ h4 hk → hk (dbw (wlt ra rb)) (xs-ww m f (λ a b → dbw (wlt a b)) va vb ra rb (dbw (wlt ra rb)) ha hb (λ t → dbw (wlt ra rb))))
                (λ h4 hk → unit)))))
-- ---------------------------------------------------------------- a primitive: a; push rax; b; mov rcx, rax; pop rax; the operation
xs-prim4 : (GX : Word → XA) (B : XB) (K : XE) (o : Word) (va vb : KQ) (a c b p f : Word) (r m : Word → Word) (f1 : Word) (M2 : Word → Word) (a3 c3 f3 : Word) (r3 m3 : Word → Word)
         → wlt f1 f ≡ false → XFr m M2 f p → wadd (wsub p #8) #8 ≡ p → XSV M2 f1 va (M2 (wsub p #8))
         → wlt f3 f1 ≡ false → wlt (b-ahi B) f3 ≡ false → XFr M2 m3 f1 (wsub p #8) → XSV m3 f3 vb a3
         → XSP (xrun GX B K (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))) (xm a3 c3 b (wsub p #8) f3 r3 m3)) (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
xs-prim4 GX B K o va vb a c b p f r m f1 M2 a3 c3 f3 r3 m3 hf1 fr hp hva hf3 ha3 fr3 hvb =
  xs-op GX B K m3 f3 o va vb (m3 (wsub p #8)) a3 b (wadd (wsub p #8) #8) r3 (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil))))
    (xs-keep M2 m3 f1 f3 (wsub p #8) va fr3 hf3 (wsub p #8) (xs-lt-self (wsub p #8)) hva) hvb
    (λ w hw → ((λ t → b) , (hp , (xs-le3 f f1 f3 hf1 hf3 , (ha3 , (xs-fr-trans m M2 m3 f p f1 (wsub p #8) fr fr3 hf1 (xs-psub p) , hw))))))
xs-prim3 : (GX : Word → XA) (B : XB) (K : XE) (o : Word) (va vb : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 M2 : Word → Word)
         → wlt f1 f ≡ false → XFr m M2 f p → wadd (wsub p #8) #8 ≡ p → XSV M2 f1 va (M2 (wsub p #8))
         → (s3 : XM) → XPT B (xm a1 c1 b (wsub p #8) f1 r1 M2) vb s3
         → XSP (xrun GX B K (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))) s3) (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
xs-prim3 GX B K o va vb a c b p f r m a1 c1 f1 r1 M2 hf1 fr hp hva (xm a3 c3 b3 p3 f3 r3 m3) h3 =
  xs-norm GX B K (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))) (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0 a3 c3 b3 p3 f3 r3 m3 b (wsub p #8) (fst h3) (fst (snd h3))
    (xs-prim4 GX B K o va vb a c b p f r m f1 M2 a3 c3 f3 r3 m3 hf1 fr hp hva (fst (snd (snd h3))) (fst (snd (snd (snd h3)))) (fst (snd (snd (snd (snd h3))))) (snd (snd (snd (snd (snd h3))))))
xs-prim2 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d o : Word) (cb : XA) (va vb : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word)
         → XPre B T env e d (xm a c b p f r m) → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XPushF B env e d b p f m f1 (upd m1 (wsub p #8) a1) va
         → ((s : XM) → XPre B T env e (wadd d #1) s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
         → XSP (xrun GX B K (xapp cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o))))) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
xs-prim2 GX B K T env e d o cb va vb a c b p f r m a1 c1 f1 r1 m1 h0 hf1 ha1 F ihb =
  xs-app GX B K cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (XPT B (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) vb)
    (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
    (ihb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (fst F , (ha1 , (fst (snd F) , (fst (snd (snd (snd h0))) , xs-env-deep (upd m1 (wsub p #8) a1) f1 b d env e (fst (snd (snd (snd (snd F))))))))))
    (λ s3 h3 → xs-prim3 GX B K o va vb a c b p f r m a1 c1 f1 r1 (upd m1 (wsub p #8) a1) hf1 (fst (snd (snd (snd F)))) (fst (snd (snd F)))
                 (subst {lzero} {lzero} {Word} {λ u → XSV (upd m1 (wsub p #8) a1) f1 va (upd m1 (wsub p #8) a1 u)} {slot-a b d} {wsub p #8} (xs-slot-top b p d (fst h0)) (snd (snd (snd (snd (snd F)))))) s3 h3)
xs-prim1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d o : Word) (cb : XA) (va vb : KQ) (s0 s1 : XM) → XPre B T env e d s0 → XPT B s0 va s1
         → ((s : XM) → XPre B T env e (wadd d #1) s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
         → XSP (xrun GX B K (xseq xpushrax (xapp cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))))) s1) (XPT B s0 (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
xs-prim1 GX B K T HB env e d o cb va vb (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 ihb =
  xs-norm GX B K (xseq xpushrax (xapp cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))))) (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-ifl-then (wlt p (wadd (b-slo B) #8)) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (λ s2 → xrun GX B K (xapp cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o))))) s2) (XPT B (xm a c b p f r m) (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
       (λ hn → xs-prim2 GX B K T env e d o cb va vb a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1))))
                 (xs-pushed B T env e d a c b p f r m a1 f1 m1 va HB h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd (snd h1))))) hn) ihb))
xs-prim : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d o : Word) (ca cb : XA) (va vb : KQ) (s0 : XM) → XPre B T env e d s0
        → XSP (xrun GX B K ca s0) (XPT B s0 va) XE0 XE0 XE0 → ((s : XM) → XPre B T env e (wadd d #1) s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
        → XSP (xrun GX B K (xapp ca (xseq xpushrax (xapp cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o))))))) s0) (XPT B s0 (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0
xs-prim GX B K T HB env e d o ca cb va vb s0 h0 iha ihb =
  xs-app GX B K ca (xseq xpushrax (xapp cb (xseq xmovrcxrax (xseq xpoprax (x1 (xop o)))))) s0 (XPT B s0 va) (XPT B s0 (q-prim o (kqcons va (kqcons vb kqnil)))) XE0 XE0 XE0 iha
    (λ s1 h1 → xs-prim1 GX B K T HB env e d o cb va vb s0 s1 h0 h1 ihb)
-- ---------------------------------------------------------------- if: c; test rax, rax; je; a; jmp; b
xs-qif-t : (m : Word → Word) (f : Word) (vc : KQ) (w : Word) → XSV m f vc w → weq w #0 ≡ true → (va vb : KQ) (R : KQ → Type) → R kqbot → R vb → R (q-if vc va vb)
xs-qif-t m f (kqw u) w h hz va vb R r0 rb = subst {lzero} {lzero} {Word} {λ x → R (q-if (kqw x) va vb)} {#0} {u} (sym (sym h ∙ weq-sound w #0 hz)) rb
xs-qif-t m f vc w h hz va vb R r0 rb = r0
xs-qif-f : (m : Word → Word) (f : Word) (vc : KQ) (w : Word) → XSV m f vc w → weq w #0 ≡ false → (va vb : KQ) (R : KQ → Type) → R kqbot → R va → R (q-if vc va vb)
xs-qif-f m f (kqw u) w h hz va vb R r0 ra =
  %welimP (λ x → weq x #0 ≡ false → R (q-if (kqw x) va vb)) u (λ hh → Empty-rec (true≢false hh)) (λ k ih hh → ra) (subst {lzero} {lzero} {Word} {λ x → weq x #0 ≡ false} {w} {u} h hz)
xs-qif-f m f vc w h hz va vb R r0 ra = r0
-- a branch's post as the conditional's: the value through a refinement transfer
xs-if-pt : (B : XB) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word) (v vs : KQ) (s2 : XM) → wlt f1 f ≡ false → XFr m m1 f p
         → ((mm : Word → Word) (fz x : Word) → XSV mm fz vs x → XSV mm fz v x) → XPT B (xm a1 c1 b p f1 r1 m1) vs s2 → XPT B (xm a c b p f r m) v s2
xs-if-pt B a c b p f r m a1 c1 f1 r1 m1 v vs (xm a2 c2 b2 p2 f2 r2 m2) hf fr hsel h2 =
  (fst h2 , (fst (snd h2) , (xs-le3 f f1 f2 hf (fst (snd (snd h2))) , (fst (snd (snd (snd h2))) , (xs-fr-trans m m1 m2 f p f1 p fr (fst (snd (snd (snd (snd h2))))) hf (xs-lt-self p) , hsel m2 f2 a2 (snd (snd (snd (snd (snd h2))))))))))
xs-if1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (ca cb : XA) (vc va vb : KQ) (s0 s1 : XM) → XPre B T env e d s0 → XPT B s0 vc s1
       → ((s : XM) → XPre B T env e d s → XSP (xrun GX B K ca s) (XPT B s va) XE0 XE0 XE0) → ((s : XM) → XPre B T env e d s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
       → XSP (xrun GX B K (x1 (xif ca cb)) s1) (XPT B s0 (q-if vc va vb)) XE0 XE0 XE0
xs-if1 GX B K T env e d ca cb vc va vb (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 iha ihb =
  xs-norm GX B K (x1 (xif ca cb)) (XPT B (xm a c b p f r m) (q-if vc va vb)) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-on (xif-of a1 (xrun GX B K ca (xm a1 c1 b p f1 r1 m1)) (xrun GX B K cb (xm a1 c1 b p f1 r1 m1))) (XPT B (xm a c b p f r m) (q-if vc va vb)) XE0 XE0 XE0
       (xs-bif XO (weq a1 #0) (xrun GX B K cb (xm a1 c1 b p f1 r1 m1)) (xrun GX B K ca (xm a1 c1 b p f1 r1 m1)) (λ o → XSP o (XPT B (xm a c b p f r m) (q-if vc va vb)) XE0 XE0 XE0)
          (λ hz → xs-map (xrun GX B K cb (xm a1 c1 b p f1 r1 m1)) (XPT B (xm a1 c1 b p f1 r1 m1) vb) (XPT B (xm a c b p f r m) (q-if vc va vb))
                    (ihb (xm a1 c1 b p f1 r1 m1) (xs-pre-keep B T env e d a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1)))))))
                    (λ s2 h2 → xs-if-pt B a c b p f r m a1 c1 f1 r1 m1 (q-if vc va vb) vb s2 (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1)))))
                                 (λ mm fz x hx → xs-qif-t m1 f1 vc a1 (snd (snd (snd (snd (snd h1))))) hz va vb (λ v → XSV mm fz v x) unit hx) h2))
          (λ hz → xs-map (xrun GX B K ca (xm a1 c1 b p f1 r1 m1)) (XPT B (xm a1 c1 b p f1 r1 m1) va) (XPT B (xm a c b p f r m) (q-if vc va vb))
                    (iha (xm a1 c1 b p f1 r1 m1) (xs-pre-keep B T env e d a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1)))))))
                    (λ s2 h2 → xs-if-pt B a c b p f r m a1 c1 f1 r1 m1 (q-if vc va vb) va s2 (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1)))))
                                 (λ mm fz x hx → xs-qif-f m1 f1 vc a1 (snd (snd (snd (snd (snd h1))))) hz va vb (λ v → XSV mm fz v x) unit hx) h2))))
xs-if : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (cc ca cb : XA) (vc va vb : KQ) (s0 : XM) → XPre B T env e d s0
      → XSP (xrun GX B K cc s0) (XPT B s0 vc) XE0 XE0 XE0 → ((s : XM) → XPre B T env e d s → XSP (xrun GX B K ca s) (XPT B s va) XE0 XE0 XE0) → ((s : XM) → XPre B T env e d s → XSP (xrun GX B K cb s) (XPT B s vb) XE0 XE0 XE0)
      → XSP (xrun GX B K (xapp cc (x1 (xif ca cb))) s0) (XPT B s0 (q-if vc va vb)) XE0 XE0 XE0
xs-if GX B K T env e d cc ca cb vc va vb s0 h0 ihc iha ihb =
  xs-app GX B K cc (x1 (xif ca cb)) s0 (XPT B s0 vc) (XPT B s0 (q-if vc va vb)) XE0 XE0 XE0 ihc (λ s1 h1 → xs-if1 GX B K T env e d ca cb vc va vb s0 s1 h0 h1 iha ihb)
-- ---------------------------------------------------------------- a projection: x; mov rax, [rax + 8(k+1)]
xs-vnth : (m : Word → Word) (f : Word) (fs : KQ) (w : Word) (j : Nat) → XSV m f fs w → XSV m f (q-nth fs j) (m (wadd w (w8 (fromNat j))))
xs-vnth m f (kqcons x r) w zero h = subst {lzero} {lzero} {Word} {λ u → XSV m f x (m u)} {w} {wadd w (w8 (fromNat zero))} (sym (xs-a0 w)) (fst (snd h))
xs-vnth m f (kqcons x r) w (suc j) h = subst {lzero} {lzero} {Word} {λ u → XSV m f (q-nth r j) (m u)} {wadd (wadd w #8) (w8 (fromNat j))} {wadd w (w8 (fromNat (suc j)))} (xs-a1 w j) (xs-vnth m f r (wadd w #8) j (snd (snd h)))
xs-vnth m f fs w j h = unit
xs-vproj : (m : Word → Word) (f k : Word) (v : KQ) (w : Word) → XSV m f v w → XSV m f (q-proj k v) (m (fld-a w k))
xs-vproj m f k (kqcon d c fs) w h = subst {lzero} {lzero} {Word} {λ u → XSV m f (q-nth fs (dnat k)) (m u)} {wadd (wadd w #8) (w8 (fromNat (dnat k)))} {fld-a w k} (sym (xs-a2 w k)) (xs-vnth m f fs (wadd w #8) (dnat k) (snd (snd h)))
xs-vproj m f k v w h = unit
xs-proj1 : (GX : Word → XA) (B : XB) (K : XE) (k : Word) (vx : KQ) (s0 s1 : XM) → XPT B s0 vx s1 → XSP (xrun GX B K (x1 (xldf k)) s1) (XPT B s0 (q-proj k vx)) XE0 XE0 XE0
xs-proj1 GX B K k vx (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h1 =
  (fst h1 , (fst (snd h1) , (fst (snd (snd h1)) , (fst (snd (snd (snd h1))) , (fst (snd (snd (snd (snd h1)))) , xs-vproj m1 f1 k vx a1 (snd (snd (snd (snd (snd h1))))))))))
xs-proj : (GX : Word → XA) (B : XB) (K : XE) (k : Word) (cx : XA) (vx : KQ) (s0 : XM) → XSP (xrun GX B K cx s0) (XPT B s0 vx) XE0 XE0 XE0
        → XSP (xrun GX B K (xapp cx (x1 (xldf k))) s0) (XPT B s0 (q-proj k vx)) XE0 XE0 XE0
xs-proj GX B K k cx vx s0 ihx = xs-app GX B K cx (x1 (xldf k)) s0 (XPT B s0 vx) (XPT B s0 (q-proj k vx)) XE0 XE0 XE0 ihx (λ s1 h1 → xs-proj1 GX B K k vx s0 s1 h1)
-- ---------------------------------------------------------------- lists: each value pushed in turn
-- rbp as it was, rsp the n slots below, r15 grown and at most ahi, rsp from slo up, memory below the
-- old r15 and from the old rsp up unchanged, the values in the slots from depth d
XPL : XB → Word → Nat → XM → KQ → XM → Type
XPL B d n (xm a c b p f r m) vs (xm a2 c2 b2 p2 f2 r2 m2) = (b2 ≡ b) × (XDp b p2 (wadd d (fromNat n)) × ((wlt f2 f ≡ false) × ((wlt (b-ahi B) f2 ≡ false) × ((wlt p2 (b-slo B) ≡ false) × (XFr m m2 f p × XSl m2 f2 b d n vs)))))
xs-lnil : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (s : XM) → XPre B T env e d s → XSP (xrun GX B K xnil s) (XPL B d zero s kqnil) XE0 XE0 XE0
xs-lnil GX B K T env e d (xm a c b p f r m) h =
  ((λ t → b) , (subst {lzero} {lzero} {Word} {λ u → XDp b p u} {d} {wadd d (fromNat zero)} (sym (wadd-zero-r d)) (fst h) , (xs-lt-self f , (fst (snd h) , (fst (snd (snd h)) , (xs-fr-refl m f p , (λ i hi → Empty-rec (false≢true hi))))))))
xs-slc : (m3 : Word → Word) (f3 b d : Word) (vx vr : KQ) (n : Nat) → XSV m3 f3 vx (m3 (slot-a b d)) → XSl m3 f3 b (wadd d #1) n vr
       → (i : Nat) → q-le (suc i) (suc n) ≡ true → XSV m3 f3 (q-nth (kqcons vx vr) i) (m3 (slot-a b (wadd d (fromNat i))))
xs-slc m3 f3 b d vx vr n h0 hs zero hi = subst {lzero} {lzero} {Word} {λ u → XSV m3 f3 vx (m3 (slot-a b u))} {d} {wadd d (fromNat zero)} (sym (wadd-zero-r d)) h0
xs-slc m3 f3 b d vx vr n h0 hs (suc i) hi = subst {lzero} {lzero} {Word} {λ u → XSV m3 f3 (q-nth vr i) (m3 (slot-a b u))} {wadd (wadd d #1) (fromNat i)} {wadd d (fromNat (suc i))} (xs-a3 d i) (hs i hi)
xs-lc3 : (B : XB) (vx vr : KQ) (n : Nat) (d a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 M2 : Word → Word) → XDp b p d → wlt f1 f ≡ false → XFr m M2 f p → XSV M2 f1 vx (M2 (wsub p #8))
       → (s3 : XM) → XPL B (wadd d #1) n (xm a1 c1 b (wsub p #8) f1 r1 M2) vr s3 → XPL B d (suc n) (xm a c b p f r m) (kqcons vx vr) s3
xs-lc3 B vx vr n d a c b p f r m a1 c1 f1 r1 M2 hd hf1 fr hva (xm a3 c3 b3 p3 f3 r3 m3) h3 =
  (fst h3 , (subst {lzero} {lzero} {Word} {λ u → XDp b p3 u} {wadd (wadd d #1) (fromNat n)} {wadd d (fromNat (suc n))} (xs-a3 d n) (fst (snd h3)) ,
   (xs-le3 f f1 f3 hf1 (fst (snd (snd h3))) , (fst (snd (snd (snd h3))) , (fst (snd (snd (snd (snd h3)))) ,
    (xs-fr-trans m M2 m3 f p f1 (wsub p #8) fr (fst (snd (snd (snd (snd (snd h3)))))) hf1 (xs-psub p) ,
     (λ i hi → xs-slc m3 f3 b d vx vr n
                 (subst {lzero} {lzero} {Word} {λ u → XSV m3 f3 vx (m3 u)} {wsub p #8} {slot-a b d} (sym (xs-slot-top b p d hd))
                    (xs-keep M2 m3 f1 f3 (wsub p #8) vx (fst (snd (snd (snd (snd (snd h3)))))) (fst (snd (snd h3))) (wsub p #8) (xs-lt-self (wsub p #8)) hva))
                 (snd (snd (snd (snd (snd (snd h3)))))) i hi)))))))
xs-lc2 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (n : Nat) (cr : XA) (vx vr : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word)
       → XPre B T env e d (xm a c b p f r m) → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XPushF B env e d b p f m f1 (upd m1 (wsub p #8) a1) vx
       → ((s : XM) → XPre B T env e (wadd d #1) s → XSP (xrun GX B K cr s) (XPL B (wadd d #1) n s vr) XE0 XE0 XE0)
       → XSP (xrun GX B K cr (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) (XPL B d (suc n) (xm a c b p f r m) (kqcons vx vr)) XE0 XE0 XE0
xs-lc2 GX B K T env e d n cr vx vr a c b p f r m a1 c1 f1 r1 m1 h0 hf1 ha1 F ihr =
  xs-map (xrun GX B K cr (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) (XPL B (wadd d #1) n (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) vr) (XPL B d (suc n) (xm a c b p f r m) (kqcons vx vr))
    (ihr (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (fst F , (ha1 , (fst (snd F) , (fst (snd (snd (snd h0))) , xs-env-deep (upd m1 (wsub p #8) a1) f1 b d env e (fst (snd (snd (snd (snd F))))))))))
    (λ s3 h3 → xs-lc3 B vx vr n d a c b p f r m a1 c1 f1 r1 (upd m1 (wsub p #8) a1) (fst h0) hf1 (fst (snd (snd (snd F))))
                 (subst {lzero} {lzero} {Word} {λ u → XSV (upd m1 (wsub p #8) a1) f1 vx (upd m1 (wsub p #8) a1 u)} {slot-a b d} {wsub p #8} (xs-slot-top b p d (fst h0)) (snd (snd (snd (snd (snd F)))))) s3 h3)
xs-lc1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d : Word) (n : Nat) (cr : XA) (vx vr : KQ) (s0 s1 : XM) → XPre B T env e d s0 → XPT B s0 vx s1
       → ((s : XM) → XPre B T env e (wadd d #1) s → XSP (xrun GX B K cr s) (XPL B (wadd d #1) n s vr) XE0 XE0 XE0)
       → XSP (xrun GX B K (xseq xpushrax cr) s1) (XPL B d (suc n) s0 (kqcons vx vr)) XE0 XE0 XE0
xs-lc1 GX B K T HB env e d n cr vx vr (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 ihr =
  xs-norm GX B K (xseq xpushrax cr) (XPL B d (suc n) (xm a c b p f r m) (kqcons vx vr)) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-ifl-then (wlt p (wadd (b-slo B) #8)) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (λ s2 → xrun GX B K cr s2) (XPL B d (suc n) (xm a c b p f r m) (kqcons vx vr)) XE0 XE0 XE0
       (λ hn → xs-lc2 GX B K T env e d n cr vx vr a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1))))
                 (xs-pushed B T env e d a c b p f r m a1 f1 m1 vx HB h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd (snd h1))))) hn) ihr))
xs-lcons : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d : Word) (n : Nat) (cx cr : XA) (vx vr : KQ) (s0 : XM) → XPre B T env e d s0
         → XSP (xrun GX B K cx s0) (XPT B s0 vx) XE0 XE0 XE0 → ((s : XM) → XPre B T env e (wadd d #1) s → XSP (xrun GX B K cr s) (XPL B (wadd d #1) n s vr) XE0 XE0 XE0)
         → XSP (xrun GX B K (xapp cx (xseq xpushrax cr)) s0) (XPL B d (suc n) s0 (kqcons vx vr)) XE0 XE0 XE0
xs-lcons GX B K T HB env e d n cx cr vx vr s0 h0 ihx ihr =
  xs-app GX B K cx (xseq xpushrax cr) s0 (XPT B s0 vx) (XPL B d (suc n) s0 (kqcons vx vr)) XE0 XE0 XE0 ihx (λ s1 h1 → xs-lc1 GX B K T HB env e d n cr vx vr s0 s1 h0 h1 ihr)
-- ---------------------------------------------------------------- the arena's addresses
xs-tfld : (a k : Word) → toNat (fld-a a k) ≡ qadd (toNat a) (xn8 (suc (toNat k)))
xs-tfld a k = xs-tadd a (w8 (wadd k #1)) ∙ cong (λ u → qadd (toNat a) u) (xs-t8 (wadd k #1) ∙ cong xn8 (xs-t1 k))
-- a cell's fields are above it
xs-fld-gt : (f k : Word) → wlt f (fld-a f k) ≡ true
xs-fld-gt f k =
  xs-mk-lt f (fld-a f k)
    (xn-le-eq (suc (toNat f)) (qadd (toNat f) (xn8 (suc (toNat k)))) (suc (toNat f)) (toNat (fld-a f k)) (λ t → suc (toNat f)) (sym (xs-tfld f k))
       (xn-le-trans (suc (toNat f)) (qadd (toNat f) (suc zero)) (qadd (toNat f) (xn8 (suc (toNat k)))) (xn-le-refl (toNat f)) (xn-le-mono (suc zero) (xn8 (suc (toNat k))) (toNat f) (λ t → true))))
xn8-lt : (a b : Nat) → q-le (suc a) b ≡ true → q-le (suc (xn8 a)) (xn8 b) ≡ true
xn8-lt a b h =
  xn-le-trans (suc (xn8 a)) (xn8 (suc a)) (xn8 b)
    (xn-le-eq (suc (xn8 a)) (qadd (xn8 a) (toNat #8)) (suc (xn8 a)) (xn8 (suc a)) (λ t → suc (xn8 a)) (sym (xn8-add a (suc zero))) (xn-le-add (xn8 a) (toNat #7)))
    (xn8-le (suc a) b h)
-- field i below field k when i < k
xs-fld-lt : (f : Word) (i k : Nat) → q-le (suc i) k ≡ true → wlt (fld-a f (fromNat i)) (fld-a f (fromNat k)) ≡ true
xs-fld-lt f i k h =
  xs-mk-lt (fld-a f (fromNat i)) (fld-a f (fromNat k))
    (xn-le-eq (suc (qadd (toNat f) (xn8 (suc (toNat (fromNat i)))))) (qadd (toNat f) (xn8 (suc (toNat (fromNat k))))) (suc (toNat (fld-a f (fromNat i)))) (toNat (fld-a f (fromNat k)))
       (cong suc (sym (xs-tfld f (fromNat i)))) (sym (xs-tfld f (fromNat k)))
       (xn-le-mono (suc (xn8 (suc (toNat (fromNat i))))) (xn8 (suc (toNat (fromNat k)))) (toNat f)
          (xn8-lt (suc (toNat (fromNat i))) (suc (toNat (fromNat k))) (xn-le-eq (suc i) k (suc (toNat (fromNat i))) (toNat (fromNat k)) (cong suc (sym (toNat-fromNat i))) (sym (toNat-fromNat k)) h))))
-- field i's address, from the cell's first field on
xs-fldi : (f : Word) (i : Nat) → fld-a f (fromNat i) ≡ wadd (wadd f #8) (w8 (fromNat i))
xs-fldi f i = xs-a2 f (fromNat i) ∙ cong (λ u → wadd (wadd f #8) (w8 (fromNat u))) (toNat-fromNat i)
xs-a9 : (d : Word) (k : Nat) → wadd (wadd d (fromNat k)) #1 ≡ wadd d (fromNat (suc k))
xs-a9 d k = xs-tinj (wadd (wadd d (fromNat k)) #1) (wadd d (fromNat (suc k))) (xs-tadd (wadd d (fromNat k)) #1 ∙ cong (λ u → qadd u (suc zero)) (xs-tadd d (fromNat k)) ∙ sym (xs-tadd d (fromNat (suc k))))
xs-add-ge : (q k : Word) → wlt (wadd q k) q ≡ false
xs-add-ge q k = xs-mk-nlt (wadd q k) q (xn-le-eq (toNat q) (qadd (toNat q) (toNat k)) (toNat q) (toNat (wadd q k)) (λ t → toNat q) (sym (xs-tadd q k)) (xn-le-add (toNat q) (toNat k)))
xn-le-neq : (k i : Nat) → q-le k i ≡ true → neqb k i ≡ false → q-le (suc k) i ≡ true
xn-le-neq zero zero h1 h2 = Empty-rec (true≢false h2)
xn-le-neq zero (suc i) h1 h2 = λ t → true
xn-le-neq (suc k) zero h1 h2 = Empty-rec (false≢true h1)
xn-le-neq (suc k) (suc i) h1 h2 = xn-le-neq k i h1 h2
xn-lt-irr : (i : Nat) → q-le (suc i) i ≡ true → Empty
xn-lt-irr zero h = false≢true h
xn-lt-irr (suc i) h = xn-lt-irr i h
-- a chain at w..., given index by index
xs-chain : (mm : Word → Word) (fz : Word) (n : Nat) (vs : KQ) (w : Word) → q-isn n vs ≡ true
         → ((i : Nat) → q-le (suc i) n ≡ true → (wlt (wadd w (w8 (fromNat i))) fz ≡ true) × XSV mm fz (q-nth vs i) (mm (wadd w (w8 (fromNat i))))) → XSV mm fz vs w
xs-chain mm fz zero kqnil w hn h = unit
xs-chain mm fz (suc n) (kqcons x r) w hn h =
  (subst {lzero} {lzero} {Word} {λ u → wlt u fz ≡ true} {wadd w (w8 (fromNat zero))} {w} (xs-a0 w) (fst (h zero (λ t → true))) ,
   (subst {lzero} {lzero} {Word} {λ u → XSV mm fz x (mm u)} {wadd w (w8 (fromNat zero))} {w} (xs-a0 w) (snd (h zero (λ t → true))) ,
    xs-chain mm fz n r (wadd w #8) hn
      (λ i hi → (subst {lzero} {lzero} {Word} {λ u → wlt u fz ≡ true} {wadd w (w8 (fromNat (suc i)))} {wadd (wadd w #8) (w8 (fromNat i))} (sym (xs-a1 w i)) (fst (h (suc i) hi)) ,
                 subst {lzero} {lzero} {Word} {λ u → XSV mm fz (q-nth r i) (mm u)} {wadd w (w8 (fromNat (suc i)))} {wadd (wadd w #8) (w8 (fromNat i))} (sym (xs-a1 w i)) (snd (h (suc i) hi))))))
xs-chain mm fz n vs w hn h = Empty-rec (false≢true hn)
-- ---------------------------------------------------------------- a constructor: the fields pushed; mov rax, r15; the tag; the fields popped into the cell; add r15
-- a field stored: the fields from k up as before, field k the value popped
xs-popf-fld : (f1 : Word) (mA mm : Word → Word) (n k : Nat) (vs : KQ) (v : Word) → XSV mA f1 (q-nth vs k) v
            → ((i : Nat) → q-le (suc k) i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm (fld-a f1 (fromNat i))))
            → (i : Nat) → q-le k i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (upd mm (fld-a f1 (fromNat k)) v (fld-a f1 (fromNat i)))
xs-popf-fld f1 mA mm n k vs v hv hf i h1 h2 =
  bool-split (neqb k i) (XSV mA f1 (q-nth vs i) (upd mm (fld-a f1 (fromNat k)) v (fld-a f1 (fromNat i))))
    (λ he → subst {lzero} {lzero} {Nat} {λ j → XSV mA f1 (q-nth vs j) (upd mm (fld-a f1 (fromNat k)) v (fld-a f1 (fromNat j)))} {k} {i} (neqb-sound k i he)
              (subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs k) u} {v} {upd mm (fld-a f1 (fromNat k)) v (fld-a f1 (fromNat k))} (sym (xs-upd-hit mm (fld-a f1 (fromNat k)) v)) hv))
    (λ hne → subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs i) u} {mm (fld-a f1 (fromNat i))} {upd mm (fld-a f1 (fromNat k)) v (fld-a f1 (fromNat i))}
               (sym (xs-upd-miss mm (fld-a f1 (fromNat k)) v (fld-a f1 (fromNat i)) (xs-weq-gt (fld-a f1 (fromNat i)) (fld-a f1 (fromNat k)) (xs-lt (fld-a f1 (fromNat k)) (fld-a f1 (fromNat i)) (xs-fld-lt f1 k i (xn-le-neq k i h1 hne))))))
               (hf i (xn-le-neq k i h1 hne) h2))
-- one field popped and stored, the rest by ih
xs-popf2 : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (R : XM → Type) (b d f1 c : Word) (mA : Word → Word) (n : Nat) (vs : KQ) (rr : Word → Word) → XSl mA f1 b d n vs
         → (k : Nat) (q : Word) (mm : Word → Word) → XDp b q (wadd (wadd d (fromNat k)) #1) → q-le (suc k) n ≡ true → wlt q (b-slo B) ≡ false
         → ((x : Word) → wlt x f1 ≡ true → mm x ≡ mA x) → ((x : Word) → wlt x (b-slo B) ≡ false → mm x ≡ mA x) → mm f1 ≡ c
         → ((i : Nat) → q-le (suc k) i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm (fld-a f1 (fromNat i)))) → wlt (fld-a f1 (fromNat k)) (b-slo B) ≡ true
         → ((q2 cc2 : Word) (mm2 : Word → Word) → XDp b q2 (wadd d (fromNat k)) → q-le k n ≡ true → wlt q2 (b-slo B) ≡ false → ((x : Word) → wlt x f1 ≡ true → mm2 x ≡ mA x) → ((x : Word) → wlt x (b-slo B) ≡ false → mm2 x ≡ mA x) → mm2 f1 ≡ c
             → ((i : Nat) → q-le k i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm2 (fld-a f1 (fromNat i)))) → XSP (xrun GX B K (xapp (xpop-fields k) ko) (xm f1 cc2 b q2 f1 rr mm2)) R XE0 XE0 XE0)
         → XSP (xrun GX B K (xapp (xpop-fields k) ko) (xm f1 (mm q) b (wadd q #8) f1 rr (upd mm (fld-a f1 (fromNat k)) (mm q)))) R XE0 XE0 XE0
xs-popf2 GX B K ko R b d f1 c mA n vs rr hsl k q mm hd hk hs hlo hhi ht hf hW ih =
  ih (wadd q #8) (mm q) (upd mm (fld-a f1 (fromNat k)) (mm q)) (xs-dp-pop1 b q (wadd d (fromNat k)) hd) (xn-le-trans k (suc k) n (xn-le-add k (suc zero)) hk)
     (xs-ge-trans (wadd q #8) q (b-slo B) (xs-add-ge q #8) hs)
     (λ x hx → fst (xs-fr-wr mm (fld-a f1 (fromNat k)) (mm q) f1 (b-slo B) (xs-lt-ge f1 (fld-a f1 (fromNat k)) (xs-fld-gt f1 (fromNat k))) hW) x hx ∙ hlo x hx)
     (λ x hx → snd (xs-fr-wr mm (fld-a f1 (fromNat k)) (mm q) f1 (b-slo B) (xs-lt-ge f1 (fld-a f1 (fromNat k)) (xs-fld-gt f1 (fromNat k))) hW) x hx ∙ hhi x hx)
     (xs-upd-miss mm (fld-a f1 (fromNat k)) (mm q) f1 (xs-weq-lt f1 (fld-a f1 (fromNat k)) (xs-lt f1 (fld-a f1 (fromNat k)) (xs-fld-gt f1 (fromNat k)))) ∙ ht)
     (xs-popf-fld f1 mA mm n k vs (mm q)
        (subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs k) u} {mA (slot-a b (wadd d (fromNat k)))} {mm q} (cong mA (xs-slot-pop b q (wadd d (fromNat k)) hd) ∙ sym (hhi q hs)) (hsl k hk)) hf)
-- the fields popped, the last first, each stored at its offset from r15 (k still on the stack; fields
-- k and up stored; memory below r15 and from slo up as after the pushes; the tag kept)
xs-popf : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (R : XM → Type) → wlt (b-slo B) (b-ahi B) ≡ false → (b d f1 c : Word) (mA : Word → Word) (n : Nat) (vs : KQ) (rr : Word → Word) → XSl mA f1 b d n vs
        → (k : Nat) (q cc : Word) (mm : Word → Word) → XDp b q (wadd d (fromNat k)) → q-le k n ≡ true → wlt q (b-slo B) ≡ false
        → ((x : Word) → wlt x f1 ≡ true → mm x ≡ mA x) → ((x : Word) → wlt x (b-slo B) ≡ false → mm x ≡ mA x) → mm f1 ≡ c
        → ((i : Nat) → q-le k i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm (fld-a f1 (fromNat i))))
        → ((q2 cc2 : Word) (mm2 : Word → Word) → XDp b q2 d → wlt q2 (b-slo B) ≡ false → ((x : Word) → wlt x f1 ≡ true → mm2 x ≡ mA x) → ((x : Word) → wlt x (b-slo B) ≡ false → mm2 x ≡ mA x) → mm2 f1 ≡ c
            → ((i : Nat) → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm2 (fld-a f1 (fromNat i)))) → XSP (xrun GX B K ko (xm f1 cc2 b q2 f1 rr mm2)) R XE0 XE0 XE0)
        → XSP (xrun GX B K (xapp (xpop-fields k) ko) (xm f1 cc b q f1 rr mm)) R XE0 XE0 XE0
xs-popf GX B K ko R HB b d f1 c mA n vs rr hsl zero q cc mm hd hk hs hlo hhi ht hf kont =
  kont q cc mm (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat zero)} {d} (wadd-zero-r d) hd) hs hlo hhi ht (λ i hi → hf i (λ t → true) hi)
xs-popf GX B K ko R HB b d f1 c mA n vs rr hsl (suc k) q cc mm hd hk hs hlo hhi ht hf kont =
  xs-ifr-then (arena-ok B (fld-a f1 (fromNat k))) (xm f1 (mm q) b (wadd q #8) f1 rr (upd mm (fld-a f1 (fromNat k)) (mm q))) (λ s → xrun GX B K (xapp (xpop-fields k) ko) s) R XE0 XE0 XE0
    (λ ha → xs-popf2 GX B K ko R b d f1 c mA n vs rr hsl k q mm
               (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat (suc k))} {wadd (wadd d (fromNat k)) #1} (sym (xs-a9 d k)) hd) hk hs hlo hhi ht hf
               (xs-lt-le (fld-a f1 (fromNat k)) (b-ahi B) (b-slo B) (andbt-r (not (wlt (fld-a f1 (fromNat k)) (b-alo B))) (wlt (fld-a f1 (fromNat k)) (b-ahi B)) ha) HB)
               (λ q2 cc2 mm2 h1 h2 h3 h4 h5 h6 h7 → xs-popf GX B K ko R HB b d f1 c mA n vs rr hsl k q2 cc2 mm2 h1 h2 h3 h4 h5 h6 h7 kont))
-- the cell complete: r15 past it, its tag and fields
xs-con3 : (B : XB) (dd c : Word) (n : Nat) (vs : KQ) (a c0 b p f : Word) (r m : Word → Word) (f1 : Word) (m1 : Word → Word) (q2 cc2 : Word) (r1 mm2 : Word → Word) (d : Word)
        → XDp b p d → wlt p (b-slo B) ≡ false → wlt f1 f ≡ false → XFr m m1 f p → q-isn n vs ≡ true → XDp b q2 d
        → ((x : Word) → wlt x f1 ≡ true → mm2 x ≡ m1 x) → ((x : Word) → wlt x (b-slo B) ≡ false → mm2 x ≡ m1 x) → mm2 f1 ≡ c
        → ((i : Nat) → q-le (suc i) n ≡ true → XSV m1 f1 (q-nth vs i) (mm2 (fld-a f1 (fromNat i)))) → wlt (b-ahi B) (fld-a f1 (fromNat n)) ≡ false
        → XPT B (xm a c0 b p f r m) (kqcon dd c vs) (xm f1 cc2 b q2 (fld-a f1 (fromNat n)) r1 mm2)
xs-con3 B dd c n vs a c0 b p f r m f1 m1 q2 cc2 r1 mm2 d hd hs hf1 fr1 hn hd2 hlo hhi ht hfl hz =
  ((λ t → b) , (xs-dp-inj b p q2 d hd hd2 , (xs-le3 f f1 (fld-a f1 (fromNat n)) hf1 (xs-lt-ge f1 (fld-a f1 (fromNat n)) (xs-fld-gt f1 (fromNat n))) , (hz ,
   (((λ x hx → hlo x (xs-lt-le x f f1 hx hf1) ∙ fst fr1 x hx) , (λ x hx → hhi x (xs-ge-trans x p (b-slo B) hx hs) ∙ snd fr1 x hx)) ,
    (xs-fld-gt f1 (fromNat n) , (ht ,
     xs-chain mm2 (fld-a f1 (fromNat n)) n vs (wadd f1 #8) hn
       (λ i hi → (subst {lzero} {lzero} {Word} {λ u → wlt u (fld-a f1 (fromNat n)) ≡ true} {fld-a f1 (fromNat i)} {wadd (wadd f1 #8) (w8 (fromNat i))} (xs-fldi f1 i) (xs-fld-lt f1 i n hi) ,
                  subst {lzero} {lzero} {Word} {λ u → XSV mm2 (fld-a f1 (fromNat n)) (q-nth vs i) (mm2 u)} {fld-a f1 (fromNat i)} {wadd (wadd f1 #8) (w8 (fromNat i))} (xs-fldi f1 i)
                    (xs-vmono m1 mm2 f1 (fld-a f1 (fromNat n)) hlo (xs-lt-ge f1 (fld-a f1 (fromNat n)) (xs-fld-gt f1 (fromNat n))) (q-nth vs i) (mm2 (fld-a f1 (fromNat i))) (hfl i hi)))))))))))
xs-con2 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d dd c : Word) (n : Nat) (vs : KQ) (a c0 b p f : Word) (r m : Word → Word) (a1 c1 p1 f1 : Word) (r1 m1 : Word → Word)
        → XPre B T env e d (xm a c0 b p f r m) → q-isn n vs ≡ true → XDp b p1 (wadd d (fromNat n)) → wlt f1 f ≡ false → wlt p1 (b-slo B) ≡ false → XFr m m1 f p → XSl m1 f1 b d n vs
        → XSP (xrun GX B K (xseq xmovraxr15 (xseq (xtag c) (xapp (xpop-fields n) (x1 (xaddr15 (w8 (wadd (fromNat n) #1))))))) (xm a1 c1 b p1 f1 r1 m1)) (XPT B (xm a c0 b p f r m) (kqcon dd c vs)) XE0 XE0 XE0
xs-con2 GX B K T HB env e d dd c n vs a c0 b p f r m a1 c1 p1 f1 r1 m1 h0 hn hd1 hf1 hs1 fr1 hsl =
  xs-ifr-then (arena-ok B f1) (xm f1 c1 b p1 f1 r1 (upd m1 f1 c)) (λ s → xrun GX B K (xapp (xpop-fields n) (x1 (xaddr15 (w8 (wadd (fromNat n) #1))))) s) (XPT B (xm a c0 b p f r m) (kqcon dd c vs)) XE0 XE0 XE0
    (λ ht → xs-popf GX B K (x1 (xaddr15 (w8 (wadd (fromNat n) #1)))) (XPT B (xm a c0 b p f r m) (kqcon dd c vs)) HB b d f1 c m1 n vs r1 hsl n p1 c1 (upd m1 f1 c) hd1 (xn-le-refl n) hs1
              (λ x hx → xs-upd-miss m1 f1 c x (xs-weq-lt x f1 (xs-lt x f1 hx)))
              (λ x hx → xs-upd-miss m1 f1 c x (xs-weq-gt x f1 (xs-lt f1 x (xs-lt-le f1 (b-slo B) x (xs-lt-le f1 (b-ahi B) (b-slo B) (andbt-r (not (wlt f1 (b-alo B))) (wlt f1 (b-ahi B)) ht) HB) hx))))
              (xs-upd-hit m1 f1 c)
              (λ i h1 h2 → Empty-rec (xn-lt-irr i (xn-le-trans (suc i) n i h2 h1)))
              (λ q2 cc2 mm2 hd2 hs2 hlo hhi htg hfl →
                 xs-ifl-then (wlt (b-ahi B) (fld-a f1 (fromNat n))) (xm f1 cc2 b q2 (fld-a f1 (fromNat n)) r1 mm2) (λ s → xrun GX B K xnil s) (XPT B (xm a c0 b p f r m) (kqcon dd c vs)) XE0 XE0 XE0
                   (λ hz → xs-con3 B dd c n vs a c0 b p f r m f1 m1 q2 cc2 r1 mm2 d (fst h0) (fst (snd (snd h0))) hf1 fr1 hn hd2 hlo hhi htg hfl hz)))
xs-con1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d dd c : Word) (n : Nat) (vs : KQ) (s0 s1 : XM) → XPre B T env e d s0 → q-isn n vs ≡ true → XPL B d n s0 vs s1
        → XSP (xrun GX B K (xseq xmovraxr15 (xseq (xtag c) (xapp (xpop-fields n) (x1 (xaddr15 (w8 (wadd (fromNat n) #1))))))) s1) (XPT B s0 (kqcon dd c vs)) XE0 XE0 XE0
xs-con1 GX B K T HB env e d dd c n vs (xm a c0 b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 hn h1 =
  xs-norm GX B K (xseq xmovraxr15 (xseq (xtag c) (xapp (xpop-fields n) (x1 (xaddr15 (w8 (wadd (fromNat n) #1))))))) (XPT B (xm a c0 b p f r m) (kqcon dd c vs)) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p1 (fst h1) (λ t → p1)
    (xs-con2 GX B K T HB env e d dd c n vs a c0 b p f r m a1 c1 p1 f1 r1 m1 h0 hn (fst (snd h1)) (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1))))) (fst (snd (snd (snd (snd (snd h1)))))) (snd (snd (snd (snd (snd (snd h1)))))))
xs-con : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d dd c : Word) (n : Nat) (cfs : XA) (vs : KQ) (s0 : XM) → XPre B T env e d s0 → q-isn n vs ≡ true
       → XSP (xrun GX B K cfs s0) (XPL B d n s0 vs) XE0 XE0 XE0
       → XSP (xrun GX B K (xapp cfs (xseq xmovraxr15 (xseq (xtag c) (xapp (xpop-fields n) (x1 (xaddr15 (w8 (wadd (fromNat n) #1)))))))) s0) (XPT B s0 (kqcon dd c vs)) XE0 XE0 XE0
xs-con GX B K T HB env e d dd c n cfs vs s0 h0 hn ihf =
  xs-app GX B K cfs (xseq xmovraxr15 (xseq (xtag c) (xapp (xpop-fields n) (x1 (xaddr15 (w8 (wadd (fromNat n) #1))))))) s0 (XPL B d n s0 vs) (XPT B s0 (kqcon dd c vs)) XE0 XE0 XE0 ihf
    (λ s1 h1 → xs-con1 GX B K T HB env e d dd c n vs s0 s1 h0 hn h1)
-- ---------------------------------------------------------------- a call: the arguments pushed, popped into the argument registers, the call (aligned)
-- argument i in register i
XAr : (Word → Word) → Word → (Word → Word) → Nat → KQ → Type
XAr m f r n vs = (i : Nat) → q-le (suc i) n ≡ true → XSV m f (q-nth vs i) (r (fromNat i))
-- what a call is made from: r15 at most ahi, rsp from slo up and at most T, the arguments in their registers
XPreC : XB → Word → Nat → KQ → XM → Type
XPreC B T n vs (xm a c b p f r m) = (wlt (b-ahi B) f ≡ false) × ((wlt p (b-slo B) ≡ false) × ((wlt T p ≡ false) × XAr m f r n vs))
xs-weq-from : (i k : Nat) → q-le (suc k) i ≡ true → weq (fromNat i) (fromNat k) ≡ false
xs-weq-from i k h = xs-weq-gt (fromNat i) (fromNat k) (xn-le-eq (suc k) i (suc (toNat (fromNat k))) (toNat (fromNat i)) (cong suc (sym (toNat-fromNat k))) (sym (toNat-fromNat i)) h)
xs-popa-arg : (mm : Word → Word) (f : Word) (n k : Nat) (vs : KQ) (rr : Word → Word) (v : Word) → XSV mm f (q-nth vs k) v
            → ((i : Nat) → q-le (suc k) i ≡ true → q-le (suc i) n ≡ true → XSV mm f (q-nth vs i) (rr (fromNat i)))
            → (i : Nat) → q-le k i ≡ true → q-le (suc i) n ≡ true → XSV mm f (q-nth vs i) (upd rr (fromNat k) v (fromNat i))
xs-popa-arg mm f n k vs rr v hv hr i h1 h2 =
  bool-split (neqb k i) (XSV mm f (q-nth vs i) (upd rr (fromNat k) v (fromNat i)))
    (λ he → subst {lzero} {lzero} {Nat} {λ j → XSV mm f (q-nth vs j) (upd rr (fromNat k) v (fromNat j))} {k} {i} (neqb-sound k i he)
              (subst {lzero} {lzero} {Word} {λ u → XSV mm f (q-nth vs k) u} {v} {upd rr (fromNat k) v (fromNat k)} (sym (xs-upd-hit rr (fromNat k) v)) hv))
    (λ hne → subst {lzero} {lzero} {Word} {λ u → XSV mm f (q-nth vs i) u} {rr (fromNat i)} {upd rr (fromNat k) v (fromNat i)}
               (sym (xs-upd-miss rr (fromNat k) v (fromNat i) (xs-weq-from i k (xn-le-neq k i h1 hne)))) (hr i (xn-le-neq k i h1 hne) h2))
-- the arguments popped, the last first, into the argument registers
xs-popa : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (R : XM → Type) (a b d f : Word) (mm : Word → Word) (n : Nat) (vs : KQ) → XSl mm f b d n vs
        → (k : Nat) (q cc : Word) (rr : Word → Word) → XDp b q (wadd d (fromNat k)) → q-le k n ≡ true → ((i : Nat) → q-le k i ≡ true → q-le (suc i) n ≡ true → XSV mm f (q-nth vs i) (rr (fromNat i)))
        → ((q2 : Word) (rr2 : Word → Word) → XDp b q2 d → XAr mm f rr2 n vs → XSP (xrun GX B K ko (xm a cc b q2 f rr2 mm)) R XE0 XE0 XE0)
        → XSP (xrun GX B K (xapp (xpop-args k) ko) (xm a cc b q f rr mm)) R XE0 XE0 XE0
xs-popa GX B K ko R a b d f mm n vs hsl zero q cc rr hd hk hr kont = kont q rr (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat zero)} {d} (wadd-zero-r d) hd) (λ i hi → hr i (λ t → true) hi)
xs-popa GX B K ko R a b d f mm n vs hsl (suc k) q cc rr hd hk hr kont =
  xs-popa GX B K ko R a b d f mm n vs hsl k (wadd q #8) cc (upd rr (fromNat k) (mm q))
    (xs-dp-pop1 b q (wadd d (fromNat k)) (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat (suc k))} {wadd (wadd d (fromNat k)) #1} (sym (xs-a9 d k)) hd))
    (xn-le-trans k (suc k) n (xn-le-add k (suc zero)) hk)
    (xs-popa-arg mm f n k vs rr (mm q)
       (subst {lzero} {lzero} {Word} {λ u → XSV mm f (q-nth vs k) (mm u)} {slot-a b (wadd d (fromNat k))} {q}
          (xs-slot-pop b q (wadd d (fromNat k)) (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat (suc k))} {wadd (wadd d (fromNat k)) #1} (sym (xs-a9 d k)) hd)) (hsl k hk)) hr)
    kont
-- a callee's post as the caller's
xs-call-pt : (B : XB) (v : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 q2 f1 : Word) (rr2 m1 : Word → Word) (s4 : XM) → q2 ≡ p → wlt f1 f ≡ false → XFr m m1 f p
           → XPT B (xm a1 c1 b q2 f1 rr2 m1) v s4 → XPT B (xm a c b p f r m) v s4
xs-call-pt B v a c b p f r m a1 c1 q2 f1 rr2 m1 (xm a4 c4 b4 p4 f4 r4 m4) hq hf1 fr1 h4 =
  (fst h4 , (fst (snd h4) ∙ hq , (xs-le3 f f1 f4 hf1 (fst (snd (snd h4))) , (fst (snd (snd (snd h4))) ,
   (xs-fr-trans m m1 m4 f p f1 q2 fr1 (fst (snd (snd (snd (snd h4))))) hf1 (subst {lzero} {lzero} {Word} {λ u → wlt p u ≡ false} {p} {q2} (sym hq) (xs-lt-self p)) , snd (snd (snd (snd (snd h4)))))))))
xs-call-odd : (GX : Word → XA) (B : XB) (K : XE) (v : KQ) (a c b p f : Word) (r m : Word → Word) (q2 f1 : Word) (m1 : Word → Word) → wlt (b-slo B) (b-ahi B) ≡ false → wlt f1 f ≡ false → XFr m m1 f p → q2 ≡ p
            → wadd (wsub q2 #8) #8 ≡ q2 → (s4 : XM) → (a1 c1 : Word) (rr2 : Word → Word) → XPT B (xm a1 c1 b (wsub q2 #8) f1 rr2 m1) v s4
            → XSP (xrun GX B K (x1 (xaddrsp #8)) s4) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
xs-call-odd GX B K v a c b p f r m q2 f1 m1 HB hf1 fr1 hq hp8 (xm a4 c4 b4 p4 f4 r4 m4) a1 c1 rr2 h4 =
  xs-norm GX B K (x1 (xaddrsp #8)) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0 a4 c4 b4 p4 f4 r4 m4 b (wsub q2 #8) (fst h4) (fst (snd h4))
    ((λ t → b) , (hp8 ∙ hq , (xs-le3 f f1 f4 hf1 (fst (snd (snd h4))) , (fst (snd (snd (snd h4))) ,
     (xs-fr-trans m m1 m4 f p f1 (wsub q2 #8) fr1 (fst (snd (snd (snd (snd h4))))) hf1 (subst {lzero} {lzero} {Word} {λ u → wlt p (wsub u #8) ≡ false} {p} {q2} (sym hq) (xs-psub p)) , snd (snd (snd (snd (snd h4)))))))))
xs-call3 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (g : Word) (n : Nat) (vs v : KQ) (d a c b p f : Word) (r m : Word → Word) (a1 c1 q2 f1 : Word) (rr2 m1 : Word → Word)
         → wlt p (b-slo B) ≡ false → wlt T b ≡ false → XDp b q2 d → q2 ≡ p → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XFr m m1 f p → XAr m1 f1 rr2 n vs
         → ((s : XM) → XPreC B T n vs s → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev K (GX g) s2))) (XPT B s v) XE0 XE0 XE0)
         → XSP (xrun GX B K (if wodd d then xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8))) else x1 (xcall g)) (xm a1 c1 b q2 f1 rr2 m1)) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
xs-call3 GX B K T HB g n vs v d a c b p f r m a1 c1 q2 f1 rr2 m1 hs hT hd2 hq hf1 ha1 fr1 har hcall =
  xs-bif XA (wodd d) (xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8)))) (x1 (xcall g)) (λ ko → XSP (xrun GX B K ko (xm a1 c1 b q2 f1 rr2 m1)) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0)
    (λ ho → xs-ifl-then (wlt q2 (wadd (b-slo B) #8)) (xm a1 c1 b (wsub q2 #8) f1 rr2 m1) (λ s → xrun GX B K (xseq (xcall g) (x1 (xaddrsp #8))) s) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
               (λ hn → xs-then (xthen (x-push B #0 (xm a1 c1 b (wsub q2 #8) f1 rr2 m1)) (λ s2 → xret-of (xe-ev K (GX g) s2))) (λ s → xrun GX B K (x1 (xaddrsp #8)) s)
                         (XPT B (xm a1 c1 b (wsub q2 #8) f1 rr2 m1) v) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
                         (hcall (xm a1 c1 b (wsub q2 #8) f1 rr2 m1)
                            (ha1 , (fst (xs-push-ok B q2 f1 HB ha1 hn) , (xs-ge-trans T q2 (wsub q2 #8) (xs-ge-trans T b q2 hT (xs-dp-le b q2 d hd2)) (xs-psub q2) , har))))
                         (λ s4 h4 → xs-call-odd GX B K v a c b p f r m q2 f1 m1 HB hf1 fr1 hq (snd (snd (snd (snd (xs-push-ok B q2 f1 HB ha1 hn))))) s4 a1 c1 rr2 h4)))
    (λ he → xs-on (xthen (x-push B #0 (xm a1 c1 b q2 f1 rr2 m1)) (λ s2 → xret-of (xe-ev K (GX g) s2))) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
               (xs-map (xthen (x-push B #0 (xm a1 c1 b q2 f1 rr2 m1)) (λ s2 → xret-of (xe-ev K (GX g) s2))) (XPT B (xm a1 c1 b q2 f1 rr2 m1) v) (XPT B (xm a c b p f r m) v)
                  (hcall (xm a1 c1 b q2 f1 rr2 m1) (ha1 , (subst {lzero} {lzero} {Word} {λ u → wlt u (b-slo B) ≡ false} {p} {q2} (sym hq) hs , (xs-ge-trans T b q2 hT (xs-dp-le b q2 d hd2) , har))))
                  (λ s4 h4 → xs-call-pt B v a c b p f r m a1 c1 q2 f1 rr2 m1 s4 hq hf1 fr1 h4)))
xs-call1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d g : Word) (n : Nat) (vs v : KQ) (s0 s1 : XM) → XPre B T env e d s0 → XPL B d n s0 vs s1
         → ((s : XM) → XPreC B T n vs s → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev K (GX g) s2))) (XPT B s v) XE0 XE0 XE0)
         → XSP (xrun GX B K (xapp (xpop-args n) (if wodd d then xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8))) else x1 (xcall g))) s1) (XPT B s0 v) XE0 XE0 XE0
xs-call1 GX B K T HB env e d g n vs v (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 hcall =
  xs-norm GX B K (xapp (xpop-args n) (if wodd d then xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8))) else x1 (xcall g))) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p1 (fst h1) (λ t → p1)
    (xs-popa GX B K (if wodd d then xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8))) else x1 (xcall g)) (XPT B (xm a c b p f r m) v) a1 b d f1 m1 n vs (snd (snd (snd (snd (snd (snd h1)))))) n p1 c1 r1 (fst (snd h1)) (xn-le-refl n)
       (λ i h2 h3 → Empty-rec (xn-lt-irr i (xn-le-trans (suc i) n i h3 h2)))
       (λ q2 rr2 hd2 har → xs-call3 GX B K T HB g n vs v d a c b p f r m a1 c1 q2 f1 rr2 m1 (fst (snd (snd h0))) (fst (snd (snd (snd h0)))) hd2 (xs-dp-inj b p q2 d (fst h0) hd2)
                             (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd (snd h1)))))) har hcall))
xs-call : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (env : XL) (e : KQ) (d g : Word) (n : Nat) (cas : XA) (vs v : KQ) (s0 : XM) → XPre B T env e d s0
        → XSP (xrun GX B K cas s0) (XPL B d n s0 vs) XE0 XE0 XE0
        → ((s : XM) → XPreC B T n vs s → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev K (GX g) s2))) (XPT B s v) XE0 XE0 XE0)
        → XSP (xrun GX B K (xapp cas (xapp (xpop-args n) (if wodd d then xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8))) else x1 (xcall g)))) s0) (XPT B s0 v) XE0 XE0 XE0
xs-call GX B K T HB env e d g n cas vs v s0 h0 iha hcall =
  xs-app GX B K cas (xapp (xpop-args n) (if wodd d then xseq (xsubrsp #8) (xseq (xcall g) (x1 (xaddrsp #8))) else x1 (xcall g))) s0 (XPL B d n s0 vs) (XPT B s0 v) XE0 XE0 XE0 iha
    (λ s1 h1 → xs-call1 GX B K T HB env e d g n vs v s0 s1 h0 h1 hcall)
-- ---------------------------------------------------------------- a loop: the state pushed; the loop; add rsp, 8k
-- at a loop's head: rsp at depth d0 + k, the state in slots d0 .., the environment in slots below d0
XPreL : XB → Word → Nat → KQ → XL → KQ → Word → XM → Type
XPreL B T k st env e d0 (xm a c b p f r m) = XDp b p (wadd d0 (fromNat k)) × ((wlt (b-ahi B) f ≡ false) × ((wlt p (b-slo B) ≡ false) × ((wlt T b ≡ false) × (XEnv m f b d0 env e × XSl m f b d0 k st))))
-- past the loop: rsp and rbp as at its head, memory from above the state up unchanged, the value in rax
XPLp : XB → Nat → XM → KQ → XM → Type
XPLp B k (xm a c b p f r m) v (xm a2 c2 b2 p2 f2 r2 m2) = (b2 ≡ b) × ((p2 ≡ p) × ((wlt f2 f ≡ false) × ((wlt (b-ahi B) f2 ≡ false) × (XFr m m2 f (wadd p (w8 (fromNat k))) × XSV m2 f2 v a2))))
xs-loop2 : (GX : Word → XA) (B : XB) (K : XE) (n : Nat) (v : KQ) (d a c b p f : Word) (r m : Word → Word) (a1 c1 p1 f1 : Word) (r1 m1 : Word → Word) → XDp b p d → XDp b p1 (wadd d (fromNat n)) → wlt f1 f ≡ false → XFr m m1 f p
         → (s2 : XM) → XPLp B n (xm a1 c1 b p1 f1 r1 m1) v s2 → XSP (xrun GX B K (x1 (xaddrsp (w8 (fromNat n)))) s2) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
xs-loop2 GX B K n v d a c b p f r m a1 c1 p1 f1 r1 m1 hd hd1 hf1 fr1 (xm a2 c2 b2 p2 f2 r2 m2) h2 =
  (fst h2 , (cong (λ u → wadd u (w8 (fromNat n))) (fst (snd h2)) ∙ xs-dp-inj b p (wadd p1 (w8 (fromNat n))) d hd (xs-dp-pop b p1 d (fromNat n) hd1) ,
   (xs-le3 f f1 f2 hf1 (fst (snd (snd h2))) , (fst (snd (snd (snd h2))) ,
    (xs-fr-trans m m1 m2 f p f1 (wadd p1 (w8 (fromNat n))) fr1 (fst (snd (snd (snd (snd h2))))) hf1
       (subst {lzero} {lzero} {Word} {λ u → wlt p u ≡ false} {p} {wadd p1 (w8 (fromNat n))} (sym (xs-dp-inj b p (wadd p1 (w8 (fromNat n))) d hd (xs-dp-pop b p1 d (fromNat n) hd1))) (xs-lt-self p)) ,
     snd (snd (snd (snd (snd h2)))))))))
xs-loop1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (n : Nat) (cb : XA) (st v : KQ) (s0 s1 : XM) → XPre B T env e d s0 → XPL B d n s0 st s1
         → ((s : XM) → XPreL B T n st env e d s → XSP (xe-lp K cb s) (XPLp B n s v) XE0 XE0 XE0)
         → XSP (xrun GX B K (xseq (xloop cb) (x1 (xaddrsp (w8 (fromNat n))))) s1) (XPT B s0 v) XE0 XE0 XE0
xs-loop1 GX B K T env e d n cb st v (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 hlp =
  xs-norm GX B K (xseq (xloop cb) (x1 (xaddrsp (w8 (fromNat n))))) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0 a1 c1 b1 p1 f1 r1 m1 b p1 (fst h1) (λ t → p1)
    (xs-then (xe-lp K cb (xm a1 c1 b p1 f1 r1 m1)) (λ s2 → xrun GX B K (x1 (xaddrsp (w8 (fromNat n)))) s2) (XPLp B n (xm a1 c1 b p1 f1 r1 m1) v) (XPT B (xm a c b p f r m) v) XE0 XE0 XE0
       (hlp (xm a1 c1 b p1 f1 r1 m1)
          (fst (snd h1) , (fst (snd (snd (snd h1))) , (fst (snd (snd (snd (snd h1)))) , (fst (snd (snd (snd h0))) ,
           (xs-env-mono m m1 f f1 b p d env e (fst h0) (fst (snd (snd (snd (snd (snd h1)))))) (fst (snd (snd h1))) (snd (snd (snd (snd h0)))) , snd (snd (snd (snd (snd (snd h1)))))))))))
       (λ s2 h2 → xs-loop2 GX B K n v d a c b p f r m a1 c1 p1 f1 r1 m1 (fst h0) (fst (snd h1)) (fst (snd (snd h1))) (fst (snd (snd (snd (snd (snd h1)))))) s2 h2))
xs-loop : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (env : XL) (e : KQ) (d : Word) (n : Nat) (ci cb : XA) (st v : KQ) (s0 : XM) → XPre B T env e d s0
        → XSP (xrun GX B K ci s0) (XPL B d n s0 st) XE0 XE0 XE0 → ((s : XM) → XPreL B T n st env e d s → XSP (xe-lp K cb s) (XPLp B n s v) XE0 XE0 XE0)
        → XSP (xrun GX B K (xapp ci (xseq (xloop cb) (x1 (xaddrsp (w8 (fromNat n)))))) s0) (XPT B s0 v) XE0 XE0 XE0
xs-loop GX B K T env e d n ci cb st v s0 h0 ihi hlp =
  xs-app GX B K ci (xseq (xloop cb) (x1 (xaddrsp (w8 (fromNat n))))) s0 (XPL B d n s0 st) (XPT B s0 v) XE0 XE0 XE0 ihi (λ s1 h1 → xs-loop1 GX B K T env e d n cb st v s0 s1 h0 h1 hlp)
-- ---------------------------------------------------------------- a loop's body
-- a loop body's code, from depth d at or past the loop's base d0 + k, ends at one of its jumps with rsp
-- at the base: at the back jump the new state st2 in the state's slots (its value then refining the
-- loop's: the transfer), at the end jump the loop's value in rax; memory below r15 and from pd0 (above
-- the state) up unchanged
XPJ : XB → Nat → Word → Word → (KQ → KQ) → KQ → XM → XM → Type
XPJ B k d0 pd0 cont v (xm a c b p f r m) (xm a2 c2 b2 p2 f2 r2 m2) =
  (b2 ≡ b) × (XDp b p2 (wadd d0 (fromNat k)) × ((wlt f2 f ≡ false) × ((wlt (b-ahi B) f2 ≡ false) × ((wlt p2 (b-slo B) ≡ false) × (XFr m m2 f pd0 ×
  ((st2 : KQ) × ((q-isn k st2 ≡ true) × (XSl m2 f2 b d0 k st2 × ((mm : Word → Word) (fz x : Word) → XSV mm fz (cont st2) x → XSV mm fz (q-lstep v cont) x)))))))))
XPE : XB → Nat → Word → Word → (KQ → KQ) → KQ → XM → XM → Type
XPE B k d0 pd0 cont v (xm a c b p f r m) (xm a2 c2 b2 p2 f2 r2 m2) =
  (b2 ≡ b) × (XDp b p2 (wadd d0 (fromNat k)) × ((wlt f2 f ≡ false) × ((wlt (b-ahi B) f2 ≡ false) × ((wlt p2 (b-slo B) ≡ false) × (XFr m m2 f pd0 × XSV m2 f2 (q-lstep v cont) a2)))))
-- a body's code is run from: an expression's precondition, the depth at or past the base d0 + k, pd0
-- above the state's slots and at or above rsp
XPreB : XB → Word → Nat → Word → Word → Word → XL → KQ → Word → XM → Type
XPreB B T k d0 pd0 base env e d (xm a c b p f r m) = XPre B T env e d (xm a c b p f r m) × ((wlt d base ≡ false) × ((base ≡ wadd d0 (fromNat k)) × (XDp b pd0 d0 × (wlt pd0 p ≡ false))))
-- a frame from rsp p widened to one from pd0 at or above it, and two frames composed so
xs-fr-up : (m m2 : Word → Word) (f p P : Word) → XFr m m2 f p → wlt P p ≡ false → XFr m m2 f P
xs-fr-up m m2 f p P fr hP = (fst fr , (λ x hx → snd fr x (xs-ge-trans x P p hx hP)))
xs-fr-trans2 : (m m1 m2 : Word → Word) (f p f1 P : Word) → XFr m m1 f p → XFr m1 m2 f1 P → wlt f1 f ≡ false → wlt P p ≡ false → XFr m m2 f P
xs-fr-trans2 m m1 m2 f p f1 P fr1 fr2 hf hP = ((λ x hx → fst fr2 x (xs-lt-le x f f1 hx hf) ∙ fst fr1 x hx) , (λ x hx → snd fr2 x hx ∙ snd fr1 x (xs-ge-trans x P p hx hP)))
-- a loop step of no value
xs-ls-bot : (v : KQ) (cont : KQ → KQ) (mm : Word → Word) (fz x : Word) → v ≡ kqbot → XSV mm fz (q-lstep v cont) x
xs-ls-bot v cont mm fz x h = subst {lzero} {lzero} {KQ} {λ u → XSV mm fz (q-lstep u cont) x} {kqbot} {v} (sym h) unit
-- a jump's post from a later state as one from an earlier (rsp p ≤ pd0, the arena grown, the value
-- through a transfer)
xs-pj2 : (B : XB) (k : Nat) (d0 pd0 : Word) (cont : KQ → KQ) (v vs : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 p1 f1 : Word) (r1 m1 : Word → Word) (s2 : XM)
       → wlt f1 f ≡ false → XFr m m1 f p → wlt pd0 p ≡ false → ((mm : Word → Word) (fz x : Word) → XSV mm fz (q-lstep vs cont) x → XSV mm fz (q-lstep v cont) x)
       → XPJ B k d0 pd0 cont vs (xm a1 c1 b p1 f1 r1 m1) s2 → XPJ B k d0 pd0 cont v (xm a c b p f r m) s2
xs-pj2 B k d0 pd0 cont v vs a c b p f r m a1 c1 p1 f1 r1 m1 (xm a2 c2 b2 p2 f2 r2 m2) hf fr hP ht h2 =
  ((fst h2) , ((fst (snd h2)) , (xs-le3 f f1 f2 hf (fst (snd (snd h2))) , ((fst (snd (snd (snd h2)))) , ((fst (snd (snd (snd (snd h2))))) , (xs-fr-trans2 m m1 m2 f p f1 pd0 fr (fst (snd (snd (snd (snd (snd h2)))))) hf hP , ((fst (snd (snd (snd (snd (snd (snd h2))))))) , ((fst (snd (snd (snd (snd (snd (snd (snd h2)))))))) , ((fst (snd (snd (snd (snd (snd (snd (snd (snd h2))))))))) , (λ mm fz x hx → ht mm fz x ((snd (snd (snd (snd (snd (snd (snd (snd (snd h2))))))))) mm fz x hx)))))))))))
xs-pe2 : (B : XB) (k : Nat) (d0 pd0 : Word) (cont : KQ → KQ) (v vs : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 p1 f1 : Word) (r1 m1 : Word → Word) (s2 : XM)
       → wlt f1 f ≡ false → XFr m m1 f p → wlt pd0 p ≡ false → ((mm : Word → Word) (fz x : Word) → XSV mm fz (q-lstep vs cont) x → XSV mm fz (q-lstep v cont) x)
       → XPE B k d0 pd0 cont vs (xm a1 c1 b p1 f1 r1 m1) s2 → XPE B k d0 pd0 cont v (xm a c b p f r m) s2
xs-pe2 B k d0 pd0 cont v vs a c b p f r m a1 c1 p1 f1 r1 m1 (xm a2 c2 b2 p2 f2 r2 m2) hf fr hP ht h2 =
  ((fst h2) , ((fst (snd h2)) , (xs-le3 f f1 f2 hf (fst (snd (snd h2))) , ((fst (snd (snd (snd h2)))) , ((fst (snd (snd (snd (snd h2))))) , (xs-fr-trans2 m m1 m2 f p f1 pd0 fr (fst (snd (snd (snd (snd (snd h2)))))) hf hP , ht m2 f2 a2 (snd (snd (snd (snd (snd (snd h2))))))))))))
-- a selection of a branch, as a transfer of loop steps
xs-ls-t : (m1 : Word → Word) (f1 : Word) (vc : KQ) (w : Word) → XSV m1 f1 vc w → weq w #0 ≡ true → (va vb : KQ) (cont : KQ → KQ) (mm : Word → Word) (fz x : Word) → XSV mm fz (q-lstep vb cont) x → XSV mm fz (q-lstep (q-if vc va vb) cont) x
xs-ls-t m1 f1 vc w h hz va vb cont mm fz x hx = xs-qif-t m1 f1 vc w h hz va vb (λ u → XSV mm fz (q-lstep vb cont) x → XSV mm fz (q-lstep u cont) x) (λ y → unit) (λ y → y) hx
xs-ls-f : (m1 : Word → Word) (f1 : Word) (vc : KQ) (w : Word) → XSV m1 f1 vc w → weq w #0 ≡ false → (va vb : KQ) (cont : KQ → KQ) (mm : Word → Word) (fz x : Word) → XSV mm fz (q-lstep va cont) x → XSV mm fz (q-lstep (q-if vc va vb) cont) x
xs-ls-f m1 f1 vc w h hz va vb cont mm fz x hx = xs-qif-f m1 f1 vc w h hz va vb (λ u → XSV mm fz (q-lstep va cont) x → XSV mm fz (q-lstep u cont) x) (λ y → unit) (λ y → y) hx
-- an expression's outcome as any code's: no jump, no return
xs-lift : (o : XO) (Q J E R : XM → Type) → XSP o Q XE0 XE0 XE0 → XSP o Q J E R
xs-lift o Q J E R h = xs-map4 o Q XE0 XE0 XE0 Q J E R h (λ s x → x) (λ s x → Empty-rec x) (λ s x → Empty-rec x) (λ s x → Empty-rec x)
-- a body's precondition kept after an expression at the same depth
xs-preb-keep : (B : XB) (T : Word) (k : Nat) (d0 pd0 base : Word) (env : XL) (e : KQ) (d a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word)
             → XPreB B T k d0 pd0 base env e d (xm a c b p f r m) → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XFr m m1 f p → XPreB B T k d0 pd0 base env e d (xm a1 c1 b p f1 r1 m1)
xs-preb-keep B T k d0 pd0 base env e d a c b p f r m a1 c1 f1 r1 m1 h0 hf ha fr = (xs-pre-keep B T env e d a c b p f r m a1 c1 f1 r1 m1 (fst h0) hf ha fr , snd h0)
-- if in a body: c; then the branch's body code
xs-bdif1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d : Word) (ca cb : XA) (vc va vb : KQ) (s0 s1 : XM)
        → XPreB B T k d0 pd0 base env e d s0 → XPT B s0 vc s1
        → ((s : XM) → XPreB B T k d0 pd0 base env e d s → XSP (xrun GX B K ca s) XE0 (XPJ B k d0 pd0 cont va s) (XPE B k d0 pd0 cont va s) XE0)
        → ((s : XM) → XPreB B T k d0 pd0 base env e d s → XSP (xrun GX B K cb s) XE0 (XPJ B k d0 pd0 cont vb s) (XPE B k d0 pd0 cont vb s) XE0)
        → XSP (xrun GX B K (x1 (xif ca cb)) s1) XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) s0) (XPE B k d0 pd0 cont (q-if vc va vb) s0) XE0
xs-bdif1 GX B K T k d0 pd0 base cont env e d ca cb vc va vb (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 iha ihb =
  xs-norm GX B K (x1 (xif ca cb)) XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) (XPE B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-on (xif-of a1 (xrun GX B K ca (xm a1 c1 b p f1 r1 m1)) (xrun GX B K cb (xm a1 c1 b p f1 r1 m1))) XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) (XPE B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) XE0
       (xs-bif XO (weq a1 #0) (xrun GX B K cb (xm a1 c1 b p f1 r1 m1)) (xrun GX B K ca (xm a1 c1 b p f1 r1 m1))
          (λ o → XSP o XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) (XPE B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) XE0)
          (λ hz → xs-map4 (xrun GX B K cb (xm a1 c1 b p f1 r1 m1)) XE0 (XPJ B k d0 pd0 cont vb (xm a1 c1 b p f1 r1 m1)) (XPE B k d0 pd0 cont vb (xm a1 c1 b p f1 r1 m1)) XE0
                    XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) (XPE B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) XE0
                    (ihb (xm a1 c1 b p f1 r1 m1) (xs-preb-keep B T k d0 pd0 base env e d a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1)))))))
                    (λ s2 x → x)
                    (λ s2 h2 → xs-pj2 B k d0 pd0 cont (q-if vc va vb) vb a c b p f r m a1 c1 p f1 r1 m1 s2 (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd h0))))
                                 (xs-ls-t m1 f1 vc a1 (snd (snd (snd (snd (snd h1))))) hz va vb cont) h2)
                    (λ s2 h2 → xs-pe2 B k d0 pd0 cont (q-if vc va vb) vb a c b p f r m a1 c1 p f1 r1 m1 s2 (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd h0))))
                                 (xs-ls-t m1 f1 vc a1 (snd (snd (snd (snd (snd h1))))) hz va vb cont) h2)
                    (λ s2 x → x))
          (λ hz → xs-map4 (xrun GX B K ca (xm a1 c1 b p f1 r1 m1)) XE0 (XPJ B k d0 pd0 cont va (xm a1 c1 b p f1 r1 m1)) (XPE B k d0 pd0 cont va (xm a1 c1 b p f1 r1 m1)) XE0
                    XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) (XPE B k d0 pd0 cont (q-if vc va vb) (xm a c b p f r m)) XE0
                    (iha (xm a1 c1 b p f1 r1 m1) (xs-preb-keep B T k d0 pd0 base env e d a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1)))))))
                    (λ s2 x → x)
                    (λ s2 h2 → xs-pj2 B k d0 pd0 cont (q-if vc va vb) va a c b p f r m a1 c1 p f1 r1 m1 s2 (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd h0))))
                                 (xs-ls-f m1 f1 vc a1 (snd (snd (snd (snd (snd h1))))) hz va vb cont) h2)
                    (λ s2 h2 → xs-pe2 B k d0 pd0 cont (q-if vc va vb) va a c b p f r m a1 c1 p f1 r1 m1 s2 (fst (snd (snd h1))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd h0))))
                                 (xs-ls-f m1 f1 vc a1 (snd (snd (snd (snd (snd h1))))) hz va vb cont) h2)
                    (λ s2 x → x))))
xs-bdif : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d : Word) (cc ca cb : XA) (vc va vb : KQ) (s0 : XM)
       → XPreB B T k d0 pd0 base env e d s0 → XSP (xrun GX B K cc s0) (XPT B s0 vc) XE0 XE0 XE0
       → ((s : XM) → XPreB B T k d0 pd0 base env e d s → XSP (xrun GX B K ca s) XE0 (XPJ B k d0 pd0 cont va s) (XPE B k d0 pd0 cont va s) XE0)
       → ((s : XM) → XPreB B T k d0 pd0 base env e d s → XSP (xrun GX B K cb s) XE0 (XPJ B k d0 pd0 cont vb s) (XPE B k d0 pd0 cont vb s) XE0)
       → XSP (xrun GX B K (xapp cc (x1 (xif ca cb))) s0) XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) s0) (XPE B k d0 pd0 cont (q-if vc va vb) s0) XE0
xs-bdif GX B K T k d0 pd0 base cont env e d cc ca cb vc va vb s0 h0 ihc iha ihb =
  xs-app GX B K cc (x1 (xif ca cb)) s0 (XPT B s0 vc) XE0 (XPJ B k d0 pd0 cont (q-if vc va vb) s0) (XPE B k d0 pd0 cont (q-if vc va vb) s0) XE0
    (xs-lift (xrun GX B K cc s0) (XPT B s0 vc) (XPJ B k d0 pd0 cont (q-if vc va vb) s0) (XPE B k d0 pd0 cont (q-if vc va vb) s0) XE0 ihc) (λ s1 h1 → xs-bdif1 GX B K T k d0 pd0 base cont env e d ca cb vc va vb s0 s1 h0 h1 iha ihb)
-- ---------------------------------------------------------------- slots apart
xs-tdn : (d : Word) (i : Nat) → toNat (wadd d (fromNat i)) ≡ qadd (toNat d) i
xs-tdn d i = xs-tadd d (fromNat i) ∙ cong (λ u → qadd (toNat d) u) (toNat-fromNat i)
xn-sub-pos : (x y : Nat) → q-le (suc x) y ≡ true → q-le (suc zero) (xn-sub y x) ≡ true
xn-sub-pos x zero h = Empty-rec (false≢true h)
xn-sub-pos zero (suc y) h = λ t → true
xn-sub-pos (suc x) (suc y) h = xn-sub-pos x y h
-- x < y <= B gives B - y < B - x
xn-sub-lt2 : (B x y : Nat) → q-le (suc x) y ≡ true → q-le y B ≡ true → q-le (suc (xn-sub B y)) (xn-sub B x) ≡ true
xn-sub-lt2 B x y hxy hyB =
  xn-le-eq (suc (xn-sub B y)) (qadd (xn-sub B y) (xn-sub y x)) (suc (xn-sub B y)) (xn-sub B x) (λ t → suc (xn-sub B y))
    (xn-comm (xn-sub B y) (xn-sub y x) ∙ sym (xn-sub-add (qadd (xn-sub y x) (xn-sub B y)) x) ∙ cong (λ u → xn-sub u x) (xn-comm (qadd (xn-sub y x) (xn-sub B y)) x ∙ sym (xn-assoc x (xn-sub y x) (xn-sub B y)) ∙ cong (λ u → qadd u (xn-sub B y)) (sym (xn-le-split x y (xn-le-trans x (suc x) y (xn-le-add x (suc zero)) hxy))) ∙ sym (xn-le-split y B hyB)))
    (xn-le-mono (suc zero) (xn-sub y x) (xn-sub B y) (xn-sub-pos x y hxy))
-- B at least eight times the depth
xs-dp-big : (b q D : Word) (J : Nat) → XDp b q D → q-le J (toNat D) ≡ true → q-le (xn8 J) (toNat b) ≡ true
xs-dp-big b q D J hd h = xn-le-eq (xn8 J) (qadd (toNat q) (xn8 (toNat D))) (xn8 J) (toNat b) (λ t → xn8 J) (sym hd)
  (xn-le-trans (xn8 J) (xn8 (toNat D)) (qadd (toNat q) (xn8 (toNat D))) (xn8-le J (toNat D) h) (xn-le-eq (xn8 (toNat D)) (qadd (xn8 (toNat D)) (toNat q)) (xn8 (toNat D)) (qadd (toNat q) (xn8 (toNat D))) (λ t → xn8 (toNat D)) (xn-comm (xn8 (toNat D)) (toNat q)) (xn-le-add (xn8 (toNat D)) (toNat q))))
-- a deeper slot (both below the depth) is lower
xs-slot-ne : (b q D i j : Word) → XDp b q D → q-le (suc (toNat i)) (toNat j) ≡ true → q-le (suc (toNat j)) (toNat D) ≡ true → wlt (slot-a b j) (slot-a b i) ≡ true
xs-slot-ne b q D i j hd hij hjD =
  xs-mk-lt (slot-a b j) (slot-a b i)
    (xn-le-eq (suc (xn-sub (toNat b) (xn8 (suc (toNat j))))) (xn-sub (toNat b) (xn8 (suc (toNat i)))) (suc (toNat (slot-a b j))) (toNat (slot-a b i)) (cong suc (sym (xs-tslot b j))) (sym (xs-tslot b i))
       (xn-sub-lt2 (toNat b) (xn8 (suc (toNat i))) (xn8 (suc (toNat j))) (xn8-lt (suc (toNat i)) (suc (toNat j)) hij) (xs-dp-big b q D (suc (toNat j)) hd hjD)))
-- a slot from d0 up (below the depth) is below pd0
xs-slot-lt-p : (b q D pd0 d0 i : Word) → XDp b q D → XDp b pd0 d0 → q-le (toNat d0) (toNat i) ≡ true → q-le (suc (toNat i)) (toNat D) ≡ true → wlt (slot-a b i) pd0 ≡ true
xs-slot-lt-p b q D pd0 d0 i hd hp h0 hiD =
  xs-mk-lt (slot-a b i) pd0
    (xn-le-eq (suc (xn-sub (toNat b) (xn8 (suc (toNat i))))) (xn-sub (toNat b) (xn8 (toNat d0))) (suc (toNat (slot-a b i))) (toNat pd0) (cong suc (sym (xs-tslot b i)))
       (cong (λ u → xn-sub u (xn8 (toNat d0))) hp ∙ xn-sub-add (toNat pd0) (xn8 (toNat d0)))
       (xn-sub-lt2 (toNat b) (xn8 (toNat d0)) (xn8 (suc (toNat i))) (xn8-lt (toNat d0) (suc (toNat i)) h0) (xs-dp-big b q D (suc (toNat i)) hd hiD)))
xs-a4 : (d0 : Word) (j : Nat) → wsub (wadd d0 (fromNat (suc j))) #1 ≡ wadd d0 (fromNat j)
xs-a4 d0 j = xs-tinj (wsub (wadd d0 (fromNat (suc j))) #1) (wadd d0 (fromNat j)) (xs-tsub (wadd d0 (fromNat (suc j))) #1 ∙ cong (λ u → xn-sub u (suc zero)) (xs-tdn d0 (suc j)) ∙ xn-sub-0r (qadd (toNat d0) j) ∙ sym (xs-tdn d0 j))
xs-a5 : (d base : Word) → wlt d base ≡ false → d ≡ wadd base (wsub d base)
xs-a5 d base h = xs-tinj d (wadd base (wsub d base)) (xn-le-split (toNat base) (toNat d) (xs-nlt d base h) ∙ sym (xs-tadd base (wsub d base) ∙ cong (λ u → qadd (toNat base) u) (xs-tsub d base)))
xn-lt-w : (i j : Nat) → q-le (suc i) j ≡ true → q-le (suc i) (suc j) ≡ true
xn-lt-w i j h = xn-le-trans (suc i) j (suc j) h (xn-le-add j (suc zero))
-- a jump's drop: add rsp, eight bytes per slot past the base
xs-drop : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (R J E Rt : XM → Type) (a c b q f : Word) (r m : Word → Word) (d base : Word) → XDp b q d → wlt d base ≡ false
        → ((q2 : Word) → XDp b q2 base → wlt q2 q ≡ false → XSP (xrun GX B K ko (xm a c b q2 f r m)) R J E Rt) → XSP (xrun GX B K (xapp (xdrop d base) ko) (xm a c b q f r m)) R J E Rt
xs-drop GX B K ko R J E Rt a c b q f r m d base hd hdb kont =
  xs-bif XA (weq d base) xnil (x1 (xaddrsp (w8 (wsub d base)))) (λ dk → XSP (xrun GX B K (xapp dk ko) (xm a c b q f r m)) R J E Rt)
    (λ he → kont q (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {d} {base} (weq-sound d base he) hd) (xs-lt-self q))
    (λ hn → kont (wadd q (w8 (wsub d base))) (xs-dp-pop b q base (wsub d base) (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {d} {wadd base (wsub d base)} (xs-a5 d base hdb) hd)) (xs-add-ge q (w8 (wsub d base))))
-- ---------------------------------------------------------------- let in a body: a; push rax; the body one deeper
xs-blet2 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d : Word) (cb : XA) (va vb : KQ) (a c b p f : Word) (r m : Word → Word) (a1 c1 f1 : Word) (r1 m1 : Word → Word)
         → XPreB B T k d0 pd0 base env e d (xm a c b p f r m) → wlt f1 f ≡ false → wlt (b-ahi B) f1 ≡ false → XPushF B env e d b p f m f1 (upd m1 (wsub p #8) a1) va
         → ((s : XM) → XPreB B T k d0 pd0 base (xlcons d env) (kqcons va e) (wadd d #1) s → XSP (xrun GX B K cb s) XE0 (XPJ B k d0 pd0 cont vb s) (XPE B k d0 pd0 cont vb s) XE0)
         → XSP (xrun GX B K cb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) XE0 (XPJ B k d0 pd0 cont vb (xm a c b p f r m)) (XPE B k d0 pd0 cont vb (xm a c b p f r m)) XE0
xs-blet2 GX B K T k d0 pd0 base cont env e d cb va vb a c b p f r m a1 c1 f1 r1 m1 h0 hf1 ha1 F ihb =
  xs-map4 (xrun GX B K cb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) XE0 (XPJ B k d0 pd0 cont vb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) (XPE B k d0 pd0 cont vb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))) XE0
    XE0 (XPJ B k d0 pd0 cont vb (xm a c b p f r m)) (XPE B k d0 pd0 cont vb (xm a c b p f r m)) XE0
    (ihb (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1))
       ((fst F , (ha1 , (fst (snd F) , (fst (snd (snd (snd (fst h0)))) , xs-env-ext (upd m1 (wsub p #8) a1) f1 b d env e va (fst (snd (snd (snd (snd F))))) (snd (snd (snd (snd (snd F))))))))) ,
        (xs-ge-trans (wadd d #1) d base (xs-le-s d) (fst (snd h0)) , (fst (snd (snd h0)) , (fst (snd (snd (snd h0))) , xs-ge-trans pd0 p (wsub p #8) (snd (snd (snd (snd h0)))) (xs-psub p))))))
    (λ s2 x → x)
    (λ s2 h2 → xs-pj2 B k d0 pd0 cont vb vb a c b p f r m a1 c1 (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1) s2 hf1 (fst (snd (snd (snd F)))) (snd (snd (snd (snd h0)))) (λ mm fz x hx → hx) h2)
    (λ s2 h2 → xs-pe2 B k d0 pd0 cont vb vb a c b p f r m a1 c1 (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1) s2 hf1 (fst (snd (snd (snd F)))) (snd (snd (snd (snd h0)))) (λ mm fz x hx → hx) h2)
    (λ s2 x → x)
xs-blet1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d : Word) (cb : XA) (va vb : KQ) (s0 s1 : XM)
         → XPreB B T k d0 pd0 base env e d s0 → XPT B s0 va s1
         → ((s : XM) → XPreB B T k d0 pd0 base (xlcons d env) (kqcons va e) (wadd d #1) s → XSP (xrun GX B K cb s) XE0 (XPJ B k d0 pd0 cont vb s) (XPE B k d0 pd0 cont vb s) XE0)
         → XSP (xrun GX B K (xseq xpushrax cb) s1) XE0 (XPJ B k d0 pd0 cont vb s0) (XPE B k d0 pd0 cont vb s0) XE0
xs-blet1 GX B K T HB k d0 pd0 base cont env e d cb va vb (xm a c b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 h1 ihb =
  xs-norm GX B K (xseq xpushrax cb) XE0 (XPJ B k d0 pd0 cont vb (xm a c b p f r m)) (XPE B k d0 pd0 cont vb (xm a c b p f r m)) XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-ifl-then (wlt p (wadd (b-slo B) #8)) (xm a1 c1 b (wsub p #8) f1 r1 (upd m1 (wsub p #8) a1)) (λ s2 → xrun GX B K cb s2) XE0 (XPJ B k d0 pd0 cont vb (xm a c b p f r m)) (XPE B k d0 pd0 cont vb (xm a c b p f r m)) XE0
       (λ hn → xs-blet2 GX B K T k d0 pd0 base cont env e d cb va vb a c b p f r m a1 c1 f1 r1 m1 h0 (fst (snd (snd h1))) (fst (snd (snd (snd h1))))
                 (xs-pushed B T env e d a c b p f r m a1 f1 m1 va HB (fst h0) (fst (snd (snd h1))) (fst (snd (snd (snd h1)))) (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd (snd h1))))) hn) ihb))
xs-blet : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d : Word) (ca cb : XA) (va vb : KQ) (s0 : XM)
        → XPreB B T k d0 pd0 base env e d s0 → XSP (xrun GX B K ca s0) (XPT B s0 va) XE0 XE0 XE0
        → ((s : XM) → XPreB B T k d0 pd0 base (xlcons d env) (kqcons va e) (wadd d #1) s → XSP (xrun GX B K cb s) XE0 (XPJ B k d0 pd0 cont vb s) (XPE B k d0 pd0 cont vb s) XE0)
        → XSP (xrun GX B K (xapp ca (xseq xpushrax cb)) s0) XE0 (XPJ B k d0 pd0 cont vb s0) (XPE B k d0 pd0 cont vb s0) XE0
xs-blet GX B K T HB k d0 pd0 base cont env e d ca cb va vb s0 h0 iha ihb =
  xs-app GX B K ca (xseq xpushrax cb) s0 (XPT B s0 va) XE0 (XPJ B k d0 pd0 cont vb s0) (XPE B k d0 pd0 cont vb s0) XE0
    (xs-lift (xrun GX B K ca s0) (XPT B s0 va) (XPJ B k d0 pd0 cont vb s0) (XPE B k d0 pd0 cont vb s0) XE0 iha) (λ s1 h1 → xs-blet1 GX B K T HB k d0 pd0 base cont env e d cb va vb s0 s1 h0 h1 ihb)
-- ---------------------------------------------------------------- the end jump: x; the drop; jmp past the loop
xs-bbrk1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d dd c : Word) (vx vr : KQ) (s0 s1 : XM)
         → XPreB B T k d0 pd0 base env e d s0 → weq c #0 ≡ false → XPT B s0 vx s1
         → XSP (xrun GX B K (xapp (xdrop d base) (x1 xje0)) s1) XE0 (XPJ B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) (XPE B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) XE0
xs-bbrk1 GX B K T k d0 pd0 base cont env e d dd c vx vr (xm a c0 b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 hc h1 =
  xs-norm GX B K (xapp (xdrop d base) (x1 xje0)) XE0 (XPJ B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) (xm a c0 b p f r m)) (XPE B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) (xm a c0 b p f r m)) XE0 a1 c1 b1 p1 f1 r1 m1 b p (fst h1) (fst (snd h1))
    (xs-drop GX B K (x1 xje0) XE0 (XPJ B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) (xm a c0 b p f r m)) (XPE B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) (xm a c0 b p f r m)) XE0 a1 c1 b p f1 r1 m1 d base (fst (fst h0)) (fst (snd h0))
       (λ q2 hq2 hge → ((λ t → b) , (subst {lzero} {lzero} {Word} {λ u → XDp b q2 u} {base} {wadd d0 (fromNat k)} (fst (snd (snd h0))) hq2 ,
          (fst (snd (snd h1)) , (fst (snd (snd (snd h1))) , (xs-ge-trans q2 p (b-slo B) hge (fst (snd (snd (fst h0)))) ,
           (xs-fr-up m m1 f p pd0 (fst (snd (snd (snd (snd h1))))) (snd (snd (snd (snd h0)))) ,
            subst {lzero} {lzero} {Bool} {λ bb → XSV m1 f1 (if bb then cont (kqcons vx vr) else vx) a1} {false} {weq c #0} (sym hc) (snd (snd (snd (snd (snd h1)))))))))))))
xs-bbrk : (GX : Word → XA) (B : XB) (K : XE) (T : Word) (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d dd c : Word) (cx : XA) (vx vr : KQ) (s0 : XM)
        → XPreB B T k d0 pd0 base env e d s0 → weq c #0 ≡ false → XSP (xrun GX B K cx s0) (XPT B s0 vx) XE0 XE0 XE0
        → XSP (xrun GX B K (xapp cx (xapp (xdrop d base) (x1 xje0))) s0) XE0 (XPJ B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) (XPE B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) XE0
xs-bbrk GX B K T k d0 pd0 base cont env e d dd c cx vx vr s0 h0 hc ihx =
  xs-app GX B K cx (xapp (xdrop d base) (x1 xje0)) s0 (XPT B s0 vx) XE0 (XPJ B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) (XPE B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) XE0
    (xs-lift (xrun GX B K cx s0) (XPT B s0 vx) (XPJ B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) (XPE B k d0 pd0 cont (kqcon dd c (kqcons vx vr)) s0) XE0 ihx)
    (λ s1 h1 → xs-bbrk1 GX B K T k d0 pd0 base cont env e d dd c vx vr s0 s1 h0 hc h1)
-- ---------------------------------------------------------------- the back jump: the new state pushed, popped into the state's slots, the drop, jmp to the head
-- one value popped and stored into its state slot
xs-pops-st : (b d d0 f1 : Word) (mA mm : Word → Word) (n j : Nat) (vs : KQ) (q v : Word) → XDp b q (wadd d (fromNat (suc j))) → q-le (qadd (toNat d0) n) (toNat d) ≡ true → XSV mA f1 (q-nth vs j) v
           → ((i : Nat) → q-le (suc j) i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm (slot-a b (wadd d0 (fromNat i)))))
           → (i : Nat) → q-le j i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d0 (fromNat i))))
xs-pops-st b d d0 f1 mA mm n j vs q v hd hbase hv hst i h1 h2 =
  bool-split (neqb j i) (XSV mA f1 (q-nth vs i) (upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d0 (fromNat i)))))
    (λ he → subst {lzero} {lzero} {Nat} {λ x → XSV mA f1 (q-nth vs x) (upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d0 (fromNat x))))} {j} {i} (neqb-sound j i he)
              (subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs j) u} {v} {upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d0 (fromNat j)))} (sym (xs-upd-hit mm (slot-a b (wadd d0 (fromNat j))) v)) hv))
    (λ hne → subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs i) u} {mm (slot-a b (wadd d0 (fromNat i)))} {upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d0 (fromNat i)))}
               (sym (xs-upd-miss mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d0 (fromNat i)))
                  (xs-weq-lt (slot-a b (wadd d0 (fromNat i))) (slot-a b (wadd d0 (fromNat j)))
                     (xs-lt (slot-a b (wadd d0 (fromNat i))) (slot-a b (wadd d0 (fromNat j)))
                        (xs-slot-ne b q (wadd d (fromNat (suc j))) (wadd d0 (fromNat j)) (wadd d0 (fromNat i)) hd
                           (xn-le-eq (suc (qadd (toNat d0) j)) (qadd (toNat d0) i) (suc (toNat (wadd d0 (fromNat j)))) (toNat (wadd d0 (fromNat i))) (cong suc (sym (xs-tdn d0 j))) (sym (xs-tdn d0 i))
                              (xn-le-mono (suc j) i (toNat d0) (xn-le-neq j i h1 hne)))
                           (xn-le-eq (suc (qadd (toNat d0) i)) (qadd (toNat d) (suc j)) (suc (toNat (wadd d0 (fromNat i)))) (toNat (wadd d (fromNat (suc j)))) (cong suc (sym (xs-tdn d0 i))) (sym (xs-tdn d (suc j)))
                              (xn-le-trans (suc (qadd (toNat d0) i)) (qadd (toNat d0) n) (qadd (toNat d) (suc j)) (xn-le-mono (suc i) n (toNat d0) h2)
                                 (xn-le-trans (qadd (toNat d0) n) (toNat d) (qadd (toNat d) (suc j)) hbase (xn-le-add (toNat d) (suc j))))))))))
               (hst i (xn-le-neq j i h1 hne) h2))
-- the stack's slots still to pop, past the stored one
xs-pops-sk : (b d d0 f1 : Word) (mA mm : Word → Word) (n j : Nat) (vs : KQ) (q v : Word) → XDp b q (wadd d (fromNat (suc j))) → q-le (qadd (toNat d0) n) (toNat d) ≡ true → q-le (suc j) n ≡ true
           → ((i : Nat) → q-le (suc i) (suc j) ≡ true → XSV mA f1 (q-nth vs i) (mm (slot-a b (wadd d (fromNat i)))))
           → (i : Nat) → q-le (suc i) j ≡ true → XSV mA f1 (q-nth vs i) (upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d (fromNat i))))
xs-pops-sk b d d0 f1 mA mm n j vs q v hd hbase hjn hsk i hi =
  subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs i) u} {mm (slot-a b (wadd d (fromNat i)))} {upd mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d (fromNat i)))}
    (sym (xs-upd-miss mm (slot-a b (wadd d0 (fromNat j))) v (slot-a b (wadd d (fromNat i)))
       (xs-weq-lt (slot-a b (wadd d (fromNat i))) (slot-a b (wadd d0 (fromNat j)))
          (xs-lt (slot-a b (wadd d (fromNat i))) (slot-a b (wadd d0 (fromNat j)))
             (xs-slot-ne b q (wadd d (fromNat (suc j))) (wadd d0 (fromNat j)) (wadd d (fromNat i)) hd
                (xn-le-eq (suc (qadd (toNat d0) j)) (qadd (toNat d) i) (suc (toNat (wadd d0 (fromNat j)))) (toNat (wadd d (fromNat i))) (cong suc (sym (xs-tdn d0 j))) (sym (xs-tdn d i))
                   (xn-le-trans (suc (qadd (toNat d0) j)) (qadd (toNat d0) n) (qadd (toNat d) i) (xn-le-mono (suc j) n (toNat d0) hjn)
                      (xn-le-trans (qadd (toNat d0) n) (toNat d) (qadd (toNat d) i) hbase (xn-le-add (toNat d) i))))
                (xn-le-eq (suc (qadd (toNat d) i)) (qadd (toNat d) (suc j)) (suc (toNat (wadd d (fromNat i)))) (toNat (wadd d (fromNat (suc j)))) (cong suc (sym (xs-tdn d i))) (sym (xs-tdn d (suc j)))
                   (xn-le-mono (suc i) (suc j) (toNat d) (xn-lt-w i j hi))))))))
    (hsk i (xn-lt-w i j hi))
-- the state slot written is between the arena and pd0
xs-pops-w : (B : XB) (b d d0 pd0 f1 q : Word) (n j : Nat) → wlt (b-slo B) (b-ahi B) ≡ false → wlt (b-ahi B) f1 ≡ false → XDp b q (wadd d (fromNat (suc j))) → XDp b pd0 d0
          → q-le (qadd (toNat d0) n) (toNat d) ≡ true → q-le (suc j) n ≡ true → wlt (slot-a b (wadd d0 (fromNat j))) (b-slo B) ≡ false
          → (wlt (slot-a b (wadd d0 (fromNat j))) f1 ≡ false) × (wlt (slot-a b (wadd d0 (fromNat j))) pd0 ≡ true)
xs-pops-w B b d d0 pd0 f1 q n j HB ha1 hd hp hbase hjn hn =
  (xs-ge-trans (slot-a b (wadd d0 (fromNat j))) (b-slo B) f1 hn (xs-ge-trans (b-slo B) (b-ahi B) f1 HB ha1) ,
   xs-slot-lt-p b q (wadd d (fromNat (suc j))) pd0 d0 (wadd d0 (fromNat j)) hd hp
     (xn-le-eq (toNat d0) (qadd (toNat d0) j) (toNat d0) (toNat (wadd d0 (fromNat j))) (λ t → toNat d0) (sym (xs-tdn d0 j)) (xn-le-add (toNat d0) j))
     (xn-le-eq (suc (qadd (toNat d0) j)) (qadd (toNat d) (suc j)) (suc (toNat (wadd d0 (fromNat j)))) (toNat (wadd d (fromNat (suc j)))) (cong suc (sym (xs-tdn d0 j))) (sym (xs-tdn d (suc j)))
        (xn-le-trans (suc (qadd (toNat d0) j)) (qadd (toNat d0) n) (qadd (toNat d) (suc j)) (xn-le-mono (suc j) n (toNat d0) hjn)
           (xn-le-trans (qadd (toNat d0) n) (toNat d) (qadd (toNat d) (suc j)) hbase (xn-le-add (toNat d) (suc j))))))
-- the state popped, the last first, each stored into its slot
xs-pops : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (R J E Rt : XM → Type) → wlt (b-slo B) (b-ahi B) ≡ false → (aa b d d0 f1 pd0 : Word) (mA rr : Word → Word) (n : Nat) (vs : KQ)
        → q-le (qadd (toNat d0) n) (toNat d) ≡ true → XDp b pd0 d0 → wlt (b-ahi B) f1 ≡ false
        → (j : Nat) (q cc : Word) (mm : Word → Word) → XDp b q (wadd d (fromNat j)) → q-le j n ≡ true
        → ((i : Nat) → q-le (suc i) j ≡ true → XSV mA f1 (q-nth vs i) (mm (slot-a b (wadd d (fromNat i)))))
        → ((i : Nat) → q-le j i ≡ true → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm (slot-a b (wadd d0 (fromNat i)))))
        → ((x : Word) → wlt x f1 ≡ true → mm x ≡ mA x) → ((x : Word) → wlt x pd0 ≡ false → mm x ≡ mA x)
        → ((q2 cc2 : Word) (mm2 : Word → Word) → XDp b q2 d → ((i : Nat) → q-le (suc i) n ≡ true → XSV mA f1 (q-nth vs i) (mm2 (slot-a b (wadd d0 (fromNat i)))))
            → ((x : Word) → wlt x f1 ≡ true → mm2 x ≡ mA x) → ((x : Word) → wlt x pd0 ≡ false → mm2 x ≡ mA x) → XSP (xrun GX B K ko (xm aa cc2 b q2 f1 rr mm2)) R J E Rt)
        → XSP (xrun GX B K (xapp (xpop-state j (wadd d0 (fromNat j))) ko) (xm aa cc b q f1 rr mm)) R J E Rt
xs-pops GX B K ko R J E Rt HB aa b d d0 f1 pd0 mA rr n vs hbase hp ha1 zero q cc mm hd hjn hsk hst lo hi kont =
  kont q cc mm (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat zero)} {d} (wadd-zero-r d) hd) (λ i hi2 → hst i (λ t → true) hi2) lo hi
xs-pops GX B K ko R J E Rt HB aa b d d0 f1 pd0 mA rr n vs hbase hp ha1 (suc j) q cc mm hd hjn hsk hst lo hi kont =
  subst {lzero} {lzero} {Word} {λ u → XSP (xrun GX B K (xseq xpoprcx (xseq (xstore u) (xapp (xpop-state j u) ko))) (xm aa cc b q f1 rr mm)) R J E Rt} {wadd d0 (fromNat j)} {wsub (wadd d0 (fromNat (suc j))) #1} (sym (xs-a4 d0 j))
    (xs-ifl-then (wlt (slot-a b (wadd d0 (fromNat j))) (b-slo B)) (xm aa (mm q) b (wadd q #8) f1 rr (upd mm (slot-a b (wadd d0 (fromNat j))) (mm q))) (λ s → xrun GX B K (xapp (xpop-state j (wadd d0 (fromNat j))) ko) s) R J E Rt
       (λ hn → xs-pops GX B K ko R J E Rt HB aa b d d0 f1 pd0 mA rr n vs hbase hp ha1 j (wadd q #8) (mm q) (upd mm (slot-a b (wadd d0 (fromNat j))) (mm q))
                 (xs-dp-pop1 b q (wadd d (fromNat j)) (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat (suc j))} {wadd (wadd d (fromNat j)) #1} (sym (xs-a9 d j)) hd))
                 (xn-le-trans j (suc j) n (xn-le-add j (suc zero)) hjn)
                 (xs-pops-sk b d d0 f1 mA mm n j vs q (mm q) hd hbase hjn hsk)
                 (xs-pops-st b d d0 f1 mA mm n j vs q (mm q) hd hbase
                    (subst {lzero} {lzero} {Word} {λ u → XSV mA f1 (q-nth vs j) (mm u)} {slot-a b (wadd d (fromNat j))} {q}
                       (xs-slot-pop b q (wadd d (fromNat j)) (subst {lzero} {lzero} {Word} {λ u → XDp b q u} {wadd d (fromNat (suc j))} {wadd (wadd d (fromNat j)) #1} (sym (xs-a9 d j)) hd)) (hsk j (xn-le-refl j))) hst)
                 (λ x hx → fst (xs-fr-wr mm (slot-a b (wadd d0 (fromNat j))) (mm q) f1 pd0 (fst (xs-pops-w B b d d0 pd0 f1 q n j HB ha1 hd hp hbase hjn hn)) (snd (xs-pops-w B b d d0 pd0 f1 q n j HB ha1 hd hp hbase hjn hn))) x hx ∙ lo x hx)
                 (λ x hx → snd (xs-fr-wr mm (slot-a b (wadd d0 (fromNat j))) (mm q) f1 pd0 (fst (xs-pops-w B b d d0 pd0 f1 q n j HB ha1 hd hp hbase hjn hn)) (snd (xs-pops-w B b d d0 pd0 f1 q n j HB ha1 hd hp hbase hjn hn))) x hx ∙ hi x hx)
                 kont))
-- the back jump's code after the new state's values were pushed
xs-bcont1 : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d dd c : Word) (n : Nat) (vs : KQ) (s0 s1 : XM)
          → XPreB B T k d0 pd0 base env e d s0 → weq c #0 ≡ true → n ≡ k → q-isn n vs ≡ true → XPL B d n s0 vs s1
          → XSP (xrun GX B K (xapp (xpop-state n base) (xapp (xdrop d base) (x1 xjh0))) s1) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) s0) (XPE B k d0 pd0 cont (kqcon dd c vs) s0) XE0
xs-bcont1 GX B K T HB k d0 pd0 base cont env e d dd c n vs (xm a c0 b p f r m) (xm a1 c1 b1 p1 f1 r1 m1) h0 hc hnk hn h1 =
  xs-norm GX B K (xapp (xpop-state n base) (xapp (xdrop d base) (x1 xjh0))) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) (XPE B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) XE0 a1 c1 b1 p1 f1 r1 m1 b p1 (fst h1) (λ t → p1)
    (subst {lzero} {lzero} {Word} {λ u → XSP (xrun GX B K (xapp (xpop-state n u) (xapp (xdrop d base) (x1 xjh0))) (xm a1 c1 b p1 f1 r1 m1)) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) (XPE B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) XE0}
       {wadd d0 (fromNat n)} {base} (sym (fst (snd (snd h0)) ∙ cong (λ j → wadd d0 (fromNat j)) (sym hnk)))
       (xs-pops GX B K (xapp (xdrop d base) (x1 xjh0)) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) (XPE B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) XE0 HB a1 b d d0 f1 pd0 m1 r1 n vs
          (xn-le-eq (toNat (wadd d0 (fromNat n))) (toNat d) (qadd (toNat d0) n) (toNat d) (xs-tdn d0 n) (λ t → toNat d)
             (xs-nlt d (wadd d0 (fromNat n)) (subst {lzero} {lzero} {Word} {λ u → wlt d u ≡ false} {base} {wadd d0 (fromNat n)} (fst (snd (snd h0)) ∙ cong (λ j → wadd d0 (fromNat j)) (sym hnk)) (fst (snd h0)))))
          (fst (snd (snd (snd h0)))) (fst (snd (snd (snd h1)))) n p1 c1 m1 (fst (snd h1)) (xn-le-refl n) (snd (snd (snd (snd (snd (snd h1))))))
          (λ i h2 h3 → Empty-rec (xn-lt-irr i (xn-le-trans (suc i) n i h3 h2))) (λ x hx t → m1 x) (λ x hx t → m1 x)
          (λ q2 cc2 mm2 hd2 hst lo hi →
             xs-drop GX B K (x1 xjh0) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) (XPE B k d0 pd0 cont (kqcon dd c vs) (xm a c0 b p f r m)) XE0 a1 cc2 b q2 f1 r1 mm2 d base hd2 (fst (snd h0))
               (λ q3 hq3 hge →
                  ((λ t → b) , (subst {lzero} {lzero} {Word} {λ u → XDp b q3 u} {base} {wadd d0 (fromNat k)} (fst (snd (snd h0))) hq3 ,
                   (fst (snd (snd h1)) , (fst (snd (snd (snd h1))) ,
                    (xs-ge-trans q3 q2 (b-slo B) hge (subst {lzero} {lzero} {Word} {λ u → wlt u (b-slo B) ≡ false} {p} {q2} (sym (xs-dp-inj b p q2 d (fst (fst h0)) hd2)) (fst (snd (snd (fst h0))))) ,
                     (((λ x hx → lo x (xs-lt-le x f f1 hx (fst (snd (snd h1)))) ∙ fst (fst (snd (snd (snd (snd (snd h1)))))) x hx) ,
                       (λ x hx → hi x hx ∙ snd (fst (snd (snd (snd (snd (snd h1)))))) x (xs-ge-trans x pd0 p hx (snd (snd (snd (snd h0))))))) ,
                      (vs , (subst {lzero} {lzero} {Nat} {λ j → q-isn j vs ≡ true} {n} {k} hnk hn ,
                       (subst {lzero} {lzero} {Nat} {λ j → XSl mm2 f1 b d0 j vs} {n} {k} hnk (λ i hi2 → xs-vmono m1 mm2 f1 f1 lo (xs-lt-self f1) (q-nth vs i) (mm2 (slot-a b (wadd d0 (fromNat i)))) (hst i hi2))) ,
                        (λ mm fz x hx → subst {lzero} {lzero} {Bool} {λ bb → XSV mm fz (if bb then cont vs else q-nth vs zero) x} {true} {weq c #0} (sym hc) hx)))))))))))))
xs-bcont : (GX : Word → XA) (B : XB) (K : XE) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (k : Nat) (d0 pd0 base : Word) (cont : KQ → KQ) (env : XL) (e : KQ) (d dd c : Word) (n : Nat) (cfs : XA) (vs : KQ) (s0 : XM)
         → XPreB B T k d0 pd0 base env e d s0 → weq c #0 ≡ true → n ≡ k → q-isn n vs ≡ true → XSP (xrun GX B K cfs s0) (XPL B d n s0 vs) XE0 XE0 XE0
         → XSP (xrun GX B K (xapp cfs (xapp (xpop-state n base) (xapp (xdrop d base) (x1 xjh0)))) s0) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) s0) (XPE B k d0 pd0 cont (kqcon dd c vs) s0) XE0
xs-bcont GX B K T HB k d0 pd0 base cont env e d dd c n cfs vs s0 h0 hc hnk hn ihf =
  xs-app GX B K cfs (xapp (xpop-state n base) (xapp (xdrop d base) (x1 xjh0))) s0 (XPL B d n s0 vs) XE0 (XPJ B k d0 pd0 cont (kqcon dd c vs) s0) (XPE B k d0 pd0 cont (kqcon dd c vs) s0) XE0
    (xs-lift (xrun GX B K cfs s0) (XPL B d n s0 vs) (XPJ B k d0 pd0 cont (kqcon dd c vs) s0) (XPE B k d0 pd0 cont (kqcon dd c vs) s0) XE0 ihf)
    (λ s1 h1 → xs-bcont1 GX B K T HB k d0 pd0 base cont env e d dd c n vs s0 s1 h0 hc hnk hn h1)
xs-preb-pre : (B : XB) (T : Word) (k : Nat) (d0 pd0 base : Word) (env : XL) (e : KQ) (d : Word) (s : XM) → XPreB B T k d0 pd0 base env e d s → XPre B T env e d s
xs-preb-pre B T k d0 pd0 base env e d (xm a c b p f r m) h = fst h
xs-hk-t : (c : Word) (X Y : Bool) → weq c #0 ≡ true → (if weq c #0 then X else Y) ≡ true → X ≡ true
xs-hk-t c X Y hc h = subst {lzero} {lzero} {Bool} {λ bb → (if bb then X else Y) ≡ true} {weq c #0} {true} hc h
xs-hk-f : (c : Word) (X Y : Bool) → weq c #0 ≡ false → (if weq c #0 then X else Y) ≡ true → Y ≡ true
xs-hk-f c X Y hc h = subst {lzero} {lzero} {Bool} {λ bb → (if bb then X else Y) ≡ true} {weq c #0} {false} hc h
-- ---------------------------------------------------------------- lists' lengths
xs-ev-len : (A : Word → Nat) (df : Word → Bool) (G : Word → FQ) (Kq : QE) (t : FQ) (e : KQ) → xq-ok A df t xkl ≡ true → q-isn (xq-len t) (evT G Kq t e) ≡ true
xs-ev-len A df G Kq fqnil e h = λ i → true
xs-ev-len A df G Kq (fqcons x r) e h = xs-ev-len A df G Kq r e (andr (xq-ok A df x xkt) (xq-ok A df r xkl) h)
xs-ev-len A df G Kq t e h = Empty-rec (false≢true h)
xs-isn-len : (n : Nat) (t : FQ) → xq-isn n t ≡ true → xq-len t ≡ n
xs-isn-len zero fqnil h = λ i → zero
xs-isn-len (suc m) (fqcons x r) h = cong suc (xs-isn-len m r h)
xs-isn-len n t h = Empty-rec (false≢true h)
-- ---------------------------------------------------------------- the calls and loops at fuel n
-- a call of a defined key, its arguments in their registers: what the callee computes, refined, the
-- callee-saved registers rsp and rbp restored
XCallOK : (Word → FQ) → (Word → Nat) → (Word → Bool) → (Word → XA) → XB → Word → Nat → Type
XCallOK G A df GX B T n = (g : Word) (vs : KQ) (s : XM) → df g ≡ true → q-isn (A g) vs ≡ true → XPreC B T (A g) vs s
  → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev (xeN GX B n) (GX g) s2))) (XPT B s (qe-ev (qeN G n) (G g) (q-push vs kqnil))) XE0 XE0 XE0
-- a loop from its head, its state in its slots: what it computes, refined
XLoopOK : (Word → FQ) → (Word → Nat) → (Word → Bool) → (Word → XA) → XB → Word → Nat → Type
XLoopOK G A df GX B T n = (k : Nat) (st : KQ) (body : FQ) (env : XL) (e : KQ) (d0 : Word) (s : XM) → q-isn k st ≡ true → xq-ok A df body (xkb (fromNat k)) ≡ true → XPreL B T k st env e d0 s
  → XSP (xe-lp (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) s) (XPLp B k s (qe-lp (qeN G n) st body e)) XE0 XE0 XE0
-- ---------------------------------------------------------------- the theorem's step
-- each mode's context, precondition and goal: an expression, a list, a loop body (its state's size, the
-- depth below the state, pd0, the loop's continuation)
XCtx : XK → Type
XCtx xkt = Unit
XCtx xkl = Unit
XCtx (xkb base) = (k : Nat) × ((d0 : Word) × ((pd0 : Word) × (KQ → KQ)))
xs-okm : (m : XK) → XCtx m → XK
xs-okm xkt x = xkt
xs-okm xkl x = xkl
xs-okm (xkb base) x = xkb (fromNat (fst x))
XPreM : XB → Word → (m : XK) → XL → KQ → Word → XCtx m → XM → Type
XPreM B T xkt env e d x s = XPre B T env e d s
XPreM B T xkl env e d x s = XPre B T env e d s
XPreM B T (xkb base) env e d x s = XPreB B T (fst x) (fst (snd x)) (fst (snd (snd x))) base env e d s
-- what the induction gives for a subterm: an expression's, a list's, a loop body's goal from every
-- precondition at its context
XIt : (Word → FQ) → (Word → XA) → XB → Word → Nat → FQ → XL → Word → KQ → Type
XIt G GX B T n u env d e = (s : XM) → XPre B T env e d s → XSP (xrun GX B (xeN GX B n) (xc u env d xkt) s) (XPT B s (evT G (qeN G n) u e)) XE0 XE0 XE0
XIl : (Word → FQ) → (Word → XA) → XB → Word → Nat → FQ → XL → Word → KQ → Type
XIl G GX B T n u env d e = (s : XM) → XPre B T env e d s → XSP (xrun GX B (xeN GX B n) (xc u env d xkl) s) (XPL B d (xq-len u) s (evT G (qeN G n) u e)) XE0 XE0 XE0
XIb : (Word → FQ) → (Word → XA) → XB → Word → Nat → Nat → Word → Word → (KQ → KQ) → Word → FQ → XL → Word → KQ → Type
XIb G GX B T n k d0 pd0 cont base u env d e = (s : XM) → XPreB B T k d0 pd0 base env e d s
  → XSP (xrun GX B (xeN GX B n) (xc u env d (xkb base)) s) XE0 (XPJ B k d0 pd0 cont (evT G (qeN G n) u e) s) (XPE B k d0 pd0 cont (evT G (qeN G n) u e) s) XE0
-- a list's elements' goals, each at its depth (the step proves them with the list's, so a construct
-- whose code takes a list's elements one by one recurses on the list, its own field, not deeper)
XHd : (Word → FQ) → (Word → Nat) → (Word → Bool) → (Word → XA) → XB → Word → Nat → FQ → XL → Word → KQ → Type
XHd G A df GX B T n (fqcons y r) env d e = (xq-ok A df y xkt ≡ true → XIt G GX B T n y env d e) × (xq-ok A df r xkl ≡ true → (s : XM) → XPre B T env e (wadd d #1) s → XHd G A df GX B T n r env (wadd d #1) e)
XHd G A df GX B T n t env d e = Unit
XGoal : (Word → FQ) → (Word → Nat) → (Word → Bool) → (Word → XA) → XB → Word → Nat → (m : XK) → FQ → XL → Word → KQ → XCtx m → XM → Type
XGoal G A df GX B T n xkt t env d e x s = XSP (xrun GX B (xeN GX B n) (xc t env d xkt) s) (XPT B s (evT G (qeN G n) t e)) XE0 XE0 XE0
XGoal G A df GX B T n xkl t env d e x s = XSP (xrun GX B (xeN GX B n) (xc t env d xkl) s) (XPL B d (xq-len t) s (evT G (qeN G n) t e)) XE0 XE0 XE0 × XHd G A df GX B T n t env d e
XGoal G A df GX B T n (xkb base) t env d e x s =
  XSP (xrun GX B (xeN GX B n) (xc t env d (xkb base)) s) XE0 (XPJ B (fst x) (fst (snd x)) (fst (snd (snd x))) (snd (snd (snd x))) (evT G (qeN G n) t e) s) (XPE B (fst x) (fst (snd x)) (fst (snd (snd x))) (snd (snd (snd x))) (evT G (qeN G n) t e) s) XE0
-- each construct's case of the step, its subterms' goals given (one top-level lemma per construct, so the
-- step itself only routes)
xs-st-prim : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat)
           → (o : Word) (a b : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df (fqprim o (fqcons a (fqcons b fqnil))) xkt ≡ true → XPre B T env e d s
           → (xq-ok A df a xkt ≡ true → XIt G GX B T n a env d e) → (xq-ok A df b xkt ≡ true → XIt G GX B T n b env (wadd d #1) e)
           → XSP (xrun GX B (xeN GX B n) (xc (fqprim o (fqcons a (fqcons b fqnil))) env d xkt) s) (XPT B s (evT G (qeN G n) (fqprim o (fqcons a (fqcons b fqnil))) e)) XE0 XE0 XE0
xs-st-prim G A df GX B T HB n o a b env d e s hk h iha ihb =
  xs-prim GX B (xeN GX B n) T HB env e d o (xc a env d xkt) (xc b env (wadd d #1) xkt) (evT G (qeN G n) a e) (evT G (qeN G n) b e) s h
    (iha (andl (xq-ok A df a xkt) (andbt (xq-ok A df b xkt) true) (andr (xq-isn (suc (suc zero)) (fqcons a (fqcons b fqnil))) (xq-ok A df (fqcons a (fqcons b fqnil)) xkl) (andr (wlt o #5) (andbt (xq-isn (suc (suc zero)) (fqcons a (fqcons b fqnil))) (xq-ok A df (fqcons a (fqcons b fqnil)) xkl)) hk))) s h)
    (ihb (andl (xq-ok A df b xkt) true (andr (xq-ok A df a xkt) (andbt (xq-ok A df b xkt) true) (andr (xq-isn (suc (suc zero)) (fqcons a (fqcons b fqnil))) (xq-ok A df (fqcons a (fqcons b fqnil)) xkl) (andr (wlt o #5) (andbt (xq-isn (suc (suc zero)) (fqcons a (fqcons b fqnil))) (xq-ok A df (fqcons a (fqcons b fqnil)) xkl)) hk)))))
xs-st-let : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat)
          → (a b : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df (fqlet a b) xkt ≡ true → XPre B T env e d s
          → (xq-ok A df a xkt ≡ true → XIt G GX B T n a env d e) → (xq-ok A df b xkt ≡ true → XIt G GX B T n b (xlcons d env) (wadd d #1) (kqcons (evT G (qeN G n) a e) e))
          → XSP (xrun GX B (xeN GX B n) (xc (fqlet a b) env d xkt) s) (XPT B s (evT G (qeN G n) (fqlet a b) e)) XE0 XE0 XE0
xs-st-let G A df GX B T HB n a b env d e s hk h iha ihb =
  xs-let GX B (xeN GX B n) T HB env e d (xc a env d xkt) (xc b (xlcons d env) (wadd d #1) xkt) (evT G (qeN G n) a e) (evT G (qeN G n) b (kqcons (evT G (qeN G n) a e) e)) s h
    (iha (andl (xq-ok A df a xkt) (xq-ok A df b xkt) hk) s h) (ihb (andr (xq-ok A df a xkt) (xq-ok A df b xkt) hk))
xs-st-if : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) (n : Nat)
         → (c a b : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df (fqif c a b) xkt ≡ true → XPre B T env e d s
         → (xq-ok A df c xkt ≡ true → XIt G GX B T n c env d e) → (xq-ok A df a xkt ≡ true → XIt G GX B T n a env d e) → (xq-ok A df b xkt ≡ true → XIt G GX B T n b env d e)
         → XSP (xrun GX B (xeN GX B n) (xc (fqif c a b) env d xkt) s) (XPT B s (evT G (qeN G n) (fqif c a b) e)) XE0 XE0 XE0
xs-st-if G A df GX B T n c a b env d e s hk h ihc iha ihb =
