-- ---------------------------------------------------------------- a state, or a callee's parameters, as an environment
xs-xl-nil : (l : XL) → xlapp l xlnil ≡ l
xs-xl-nil xlnil = λ t → xlnil
xs-xl-nil (xlcons s r) = λ t → xlcons s (xs-xl-nil r t)
xn-sub-sub : (a b c : Nat) → xn-sub (xn-sub a b) c ≡ xn-sub a (qadd c b)
xn-sub-sub zero b c = λ t → zero
xn-sub-sub (suc a) zero c = λ t → xn-sub (suc a) c
xn-sub-sub (suc a) (suc b) c = xn-sub-sub a b c
xs-a8 : (w : Word) (j : Nat) → wsub (wsub w #1) (fromNat (suc j)) ≡ wsub w (fromNat (suc (suc j)))
xs-a8 w j = xs-tinj (wsub (wsub w #1) (fromNat (suc j))) (wsub w (fromNat (suc (suc j))))
  (xs-tsub (wsub w #1) (fromNat (suc j)) ∙ cong (λ u → xn-sub u (toNat (fromNat (suc j)))) (xs-tsub w #1) ∙ xn-sub-sub (toNat w) (suc zero) (toNat (fromNat (suc j))) ∙ sym (xs-tsub w (fromNat (suc (suc j)))))
xl-cat : (x y z : XL) → x ≡ y → y ≡ z → x ≡ z
xl-cat x y z p q = p ∙ q
-- base − 1, …, base − (j+1), then env: base − 1, …, base − j, then base − (j+1) consed onto env
xs-snoc : (j : Nat) (w : Word) (env : XL) → xlapp (xslots (suc j) w) env ≡ xlapp (xslots j w) (xlcons (wsub w (fromNat (suc j))) env)
xs-snoc zero w env = λ t → xlcons (wsub w (xs-tinj #1 (fromNat (suc zero)) (λ s → suc zero) t)) env
xs-snoc (suc j) w env =
  xl-cat (xlcons (wsub w #1) (xlapp (xslots (suc j) (wsub w #1)) env)) (xlcons (wsub w #1) (xlapp (xslots j (wsub w #1)) (xlcons (wsub (wsub w #1) (fromNat (suc j))) env)))
         (xlcons (wsub w #1) (xlapp (xslots j (wsub w #1)) (xlcons (wsub w (fromNat (suc (suc j)))) env)))
    (λ t → xlcons (wsub w #1) (xs-snoc j (wsub w #1) env t))
    (λ t → xlcons (wsub w #1) (xlapp (xslots j (wsub w #1)) (xlcons (xs-a8 w j t) env)))
xs-a7 : (d0 : Word) (k : Nat) → wsub (wadd d0 (fromNat k)) (fromNat k) ≡ d0
xs-a7 d0 k = xs-tinj (wsub (wadd d0 (fromNat k)) (fromNat k)) d0 (xs-tsub (wadd d0 (fromNat k)) (fromNat k) ∙ cong (λ u → xn-sub u (toNat (fromNat k))) (xs-tadd d0 (fromNat k)) ∙ xn-sub-add (toNat d0) (toNat (fromNat k)))
-- k values in the slots from d0, over an environment in the slots below: the environment the values
-- pushed give (the last innermost), at depth d0 + k
xs-env-push : (m : Word → Word) (f b : Word) (k : Nat) (st : KQ) (d0 : Word) (env : XL) (e : KQ) → q-isn k st ≡ true → XSl m f b d0 k st → XEnv m f b d0 env e
            → XEnv m f b (wadd d0 (fromNat k)) (xlapp (xslots k (wadd d0 (fromNat k))) env) (q-push st e)
xs-env-push m f b zero kqnil d0 env e hk hsl he = subst {lzero} {lzero} {Word} {λ u → XEnv m f b u env e} {d0} {wadd d0 (fromNat zero)} (sym (wadd-zero-r d0)) he
xs-env-push m f b (suc k) (kqcons x r) d0 env e hk hsl he =
  subst {lzero} {lzero} {XL} {λ l → XEnv m f b (wadd d0 (fromNat (suc k))) l (q-push r (kqcons x e))}
    {xlapp (xslots k (wadd d0 (fromNat (suc k)))) (xlcons d0 env)} {xlapp (xslots (suc k) (wadd d0 (fromNat (suc k)))) env}
    (cong (λ u → xlapp (xslots k (wadd d0 (fromNat (suc k)))) (xlcons u env)) (sym (xs-a7 d0 (suc k))) ∙ sym (xs-snoc k (wadd d0 (fromNat (suc k))) env))
    (subst {lzero} {lzero} {Word} {λ u → XEnv m f b u (xlapp (xslots k u) (xlcons d0 env)) (q-push r (kqcons x e))} {wadd (wadd d0 #1) (fromNat k)} {wadd d0 (fromNat (suc k))} (xs-a3 d0 k)
       (xs-env-push m f b k r (wadd d0 #1) (xlcons d0 env) (kqcons x e) hk
          (λ i hi → subst {lzero} {lzero} {Word} {λ u → XSV m f (q-nth r i) (m (slot-a b u))} {wadd d0 (fromNat (suc i))} {wadd (wadd d0 #1) (fromNat i)} (sym (xs-a3 d0 i)) (hsl (suc i) hi))
          (xs-env-ext m f b d0 env e x he (subst {lzero} {lzero} {Word} {λ u → XSV m f x (m (slot-a b u))} {wadd d0 (fromNat zero)} {d0} (wadd-zero-r d0) (hsl zero (λ t → true))))))
xs-env-push m f b k st d0 env e hk hsl he = Empty-rec (false≢true hk)
-- ---------------------------------------------------------------- calls: the callee's frame
-- a return: a callee's ret is the caller's next state
xs-ret : (o : XO) (Q J E R : XM → Type) → XSP o Q J E R → XSP (xret-of o) R XE0 XE0 XE0
xs-ret (xon s) Q J E R h = unit
xs-ret (xjh s) Q J E R h = unit
xs-ret (xje s) Q J E R h = unit
xs-ret (xrt s) Q J E R h = h
xs-ret xlim Q J E R h = unit
xs-ret xbot Q J E R h = unit
xs-wlt-from : (j i : Nat) → q-le (suc j) i ≡ true → wlt (fromNat j) (fromNat i) ≡ true
xs-wlt-from j i h = xs-mk-lt (fromNat j) (fromNat i) (xn-le-eq (suc j) i (suc (toNat (fromNat j))) (toNat (fromNat i)) (cong suc (sym (toNat-fromNat j))) (sym (toNat-fromNat i)) h)
-- a parameter pushed into slot i
xs-pp-sl : (b q f : Word) (mA mm : Word → Word) (vs : KQ) (i : Nat) (v : Word) → XDp b q (fromNat i) → XSV mA f (q-nth vs i) v → wlt (wsub q #8) q ≡ true → wlt (wsub q #8) f ≡ false
         → ((j : Nat) → q-le (suc j) i ≡ true → XSV mA f (q-nth vs j) (mm (slot-a b (fromNat j))))
         → (j : Nat) → q-le (suc j) (suc i) ≡ true → XSV mA f (q-nth vs j) (upd mm (wsub q #8) v (slot-a b (fromNat j)))
xs-pp-sl b q f mA mm vs i v hd hv hq hqf hsl j hj =
  bool-split (neqb j i) (XSV mA f (q-nth vs j) (upd mm (wsub q #8) v (slot-a b (fromNat j))))
    (λ he → subst {lzero} {lzero} {Nat} {λ x → XSV mA f (q-nth vs x) (upd mm (wsub q #8) v (slot-a b (fromNat x)))} {i} {j} (sym (neqb-sound j i he))
              (subst {lzero} {lzero} {Word} {λ u → XSV mA f (q-nth vs i) u} {v} {upd mm (wsub q #8) v (slot-a b (fromNat i))} (sym (cong (λ u → upd mm (wsub q #8) v u) (xs-slot-top b q (fromNat i) hd) ∙ xs-upd-hit mm (wsub q #8) v)) hv))
    (λ hne → subst {lzero} {lzero} {Word} {λ u → XSV mA f (q-nth vs j) u} {mm (slot-a b (fromNat j))} {upd mm (wsub q #8) v (slot-a b (fromNat j))}
               (sym (snd (xs-fr-wr mm (wsub q #8) v f q hqf hq) (slot-a b (fromNat j)) (xs-slot-ge b q (fromNat i) (fromNat j) hd (xs-wlt-from j i (xn-le-neq j i hj hne)))))
               (hsl j (xn-le-neq j i hj hne)))
-- the parameters' registers pushed in order, slots 0 ..
xs-pp : (GX : Word → XA) (B : XB) (K : XE) (ko : XA) (R J E Rt : XM → Type) → wlt (b-slo B) (b-ahi B) ≡ false → (a c b f : Word) (r mA : Word → Word) (na : Nat) (vs : KQ) → XAr mA f r na vs → wlt (b-ahi B) f ≡ false
      → (k i : Nat) (q : Word) (mm : Word → Word) → qadd i k ≡ na → XDp b q (fromNat i) → wlt q (b-slo B) ≡ false
      → ((j : Nat) → q-le (suc j) i ≡ true → XSV mA f (q-nth vs j) (mm (slot-a b (fromNat j))))
      → ((x : Word) → wlt x f ≡ true → mm x ≡ mA x) → ((x : Word) → wlt x b ≡ false → mm x ≡ mA x)
      → ((q2 : Word) (mm2 : Word → Word) → XDp b q2 (fromNat na) → wlt q2 (b-slo B) ≡ false → ((j : Nat) → q-le (suc j) na ≡ true → XSV mA f (q-nth vs j) (mm2 (slot-a b (fromNat j))))
          → ((x : Word) → wlt x f ≡ true → mm2 x ≡ mA x) → ((x : Word) → wlt x b ≡ false → mm2 x ≡ mA x) → XSP (xrun GX B K ko (xm a c b q2 f r mm2)) R J E Rt)
      → XSP (xrun GX B K (xapp (xpp k i) ko) (xm a c b q f r mm)) R J E Rt
xs-pp GX B K ko R J E Rt HB a c b f r mA na vs har ha zero i q mm hik hd hs hsl lo hi kont =
  kont q mm (subst {lzero} {lzero} {Nat} {λ j → XDp b q (fromNat j)} {i} {na} hik hd) hs
    (subst {lzero} {lzero} {Nat} {λ x → (j : Nat) → q-le (suc j) x ≡ true → XSV mA f (q-nth vs j) (mm (slot-a b (fromNat j)))} {i} {na} hik hsl) lo hi
xs-pp GX B K ko R J E Rt HB a c b f r mA na vs har ha (suc k) i q mm hik hd hs hsl lo hi kont =
  xs-ifl-then (wlt q (wadd (b-slo B) #8)) (xm a c b (wsub q #8) f r (upd mm (wsub q #8) (r (fromNat i)))) (λ s → xrun GX B K (xapp (xpp k (suc i)) ko) s) R J E Rt
    (λ hn → xs-pp GX B K ko R J E Rt HB a c b f r mA na vs har ha k (suc i) (wsub q #8) (upd mm (wsub q #8) (r (fromNat i)))
              (qadd-s i k ∙ hik)
              (subst {lzero} {lzero} {Word} {λ u → XDp b (wsub q #8) u} {wadd (fromNat i) #1} {fromNat (suc i)} (wadd-one (fromNat i)) (xs-dp-push b q (fromNat i) hd (fst (snd (snd (snd (xs-push-ok B q f HB ha hn)))))))
              (fst (xs-push-ok B q f HB ha hn))
              (xs-pp-sl b q f mA mm vs i (r (fromNat i)) hd
                 (har i (subst {lzero} {lzero} {Nat} {λ x → q-le (suc i) x ≡ true} {qadd i (suc k)} {na} hik (xn-le-add i k)))
                 (fst (snd (xs-push-ok B q f HB ha hn))) (fst (snd (snd (xs-push-ok B q f HB ha hn)))) hsl)
              (λ x hx → fst (xs-fr-wr mm (wsub q #8) (r (fromNat i)) f q (fst (snd (snd (xs-push-ok B q f HB ha hn)))) (fst (snd (xs-push-ok B q f HB ha hn)))) x hx ∙ lo x hx)
              (λ x hx → snd (xs-fr-wr mm (wsub q #8) (r (fromNat i)) f q (fst (snd (snd (xs-push-ok B q f HB ha hn)))) (fst (snd (xs-push-ok B q f HB ha hn)))) x (xs-ge-trans x b q hx (xs-dp-le b q (fromNat i) hd)) ∙ hi x hx)
              kont)
-- the epilogue: mov rsp, rbp; pop rbp; ret — rbp and rsp as the caller had them
xs-epi : (GX : Word → XA) (B : XB) (K : XE) (v : KQ) (a c b p f : Word) (r m : Word → Word) (P2 q2 : Word) (M2 mm2 : Word → Word) (na : Nat) (a3 c3 : Word) (r3 : Word → Word)
       → wadd (wadd P2 #8) #8 ≡ p → XFr m M2 f p → M2 P2 ≡ b → XDp P2 q2 (fromNat na) → ((x : Word) → wlt x f ≡ true → mm2 x ≡ M2 x) → ((x : Word) → wlt x P2 ≡ false → mm2 x ≡ M2 x)
       → wlt p P2 ≡ false → (s4 : XM) → XPT B (xm a3 c3 P2 q2 f r3 mm2) v s4
       → XSP (xrun GX B K (xseq xmovrsprbp (xseq xpoprbp (x1 xret))) s4) XE0 XE0 XE0 (XPT B (xm a c b p f r m) v)
xs-epi GX B K v a c b p f r m P2 q2 M2 mm2 na a3 c3 r3 hp fr2 hb hd2 lo hi hpP (xm a4 c4 b4 p4 f4 r4 m4) h4 =
  xs-norm GX B K (xseq xmovrsprbp (xseq xpoprbp (x1 xret))) XE0 XE0 XE0 (XPT B (xm a c b p f r m) v) a4 c4 b4 p4 f4 r4 m4 P2 q2 (fst h4) (fst (snd h4))
    (snd (fst (snd (snd (snd (snd h4))))) P2 (xs-dp-le P2 q2 (fromNat na) hd2) ∙ hi P2 (xs-lt-self P2) ∙ hb ,
     (hp , (fst (snd (snd h4)) , (fst (snd (snd (snd h4))) ,
      (((λ x hx → fst (fst (snd (snd (snd (snd h4))))) x hx ∙ lo x hx ∙ fst fr2 x hx) ,
        (λ x hx → snd (fst (snd (snd (snd (snd h4))))) x (xs-ge-trans x P2 q2 (xs-ge-trans x p P2 hx hpP) (xs-dp-le P2 q2 (fromNat na) hd2)) ∙ hi x (xs-ge-trans x p P2 hx hpP) ∙ snd fr2 x hx)) ,
       snd (snd (snd (snd (snd h4)))))))))
-- the callee's code from its entry (the return address pushed): push rbp; mov rbp, rsp; the parameters; the body; the epilogue
xs-callf2 : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat)
          → ((t : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df t xkt ≡ true → XPre B T env e d s → XSP (xrun GX B (xeN GX B n) (xc t env d xkt) s) (XPT B s (evT G (qeN G n) t e)) XE0 XE0 XE0)
          → (na : Nat) (body : FQ) (vs : KQ) (a c b p f : Word) (r m : Word → Word) → xq-ok A df body xkt ≡ true → q-isn na vs ≡ true → wlt (b-ahi B) f ≡ false → wlt T p ≡ false → XAr m f r na vs
          → (wlt (wsub p #8) (b-slo B) ≡ false) × ((wlt (wsub p #8) p ≡ true) × ((wlt (wsub p #8) f ≡ false) × ((wlt p #8 ≡ false) × (wadd (wsub p #8) #8 ≡ p))))
          → (wlt (wsub (wsub p #8) #8) (b-slo B) ≡ false) × ((wlt (wsub (wsub p #8) #8) (wsub p #8) ≡ true) × ((wlt (wsub (wsub p #8) #8) f ≡ false) × ((wlt (wsub p #8) #8 ≡ false) × (wadd (wsub (wsub p #8) #8) #8 ≡ wsub p #8))))
          → XSP (xrun GX B (xeN GX B n) (xseq xmovrbprsp (xapp (xpp na zero) (xapp (xc body (xslots na (fromNat na)) (fromNat na) xkt) (xseq xmovrsprbp (xseq xpoprbp (x1 xret))))))
                  (xm a c b (wsub (wsub p #8) #8) f r (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b))) XE0 XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil)))
xs-callf2 G A df GX B T HB n th na body vs a c b p f r m hok hisn ha hT har po1 po2 =
  xs-pp GX B (xeN GX B n) (xapp (xc body (xslots na (fromNat na)) (fromNat na) xkt) (xseq xmovrsprbp (xseq xpoprbp (x1 xret)))) XE0 XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil))) HB
    a c (wsub (wsub p #8) #8) f r (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) na vs
    (λ i hi → xs-vmono m (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) f f
                (fst (xs-fr-trans m (upd m (wsub p #8) #0) (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) f p f (wsub p #8) (xs-fr-wr m (wsub p #8) #0 f p (fst (snd (snd po1))) (fst (snd po1))) (xs-fr-wr (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b f (wsub p #8) (fst (snd (snd po2))) (fst (snd po2))) (xs-lt-self f) (xs-psub p)))
                (xs-lt-self f) (q-nth vs i) (r (fromNat i)) (har i hi))
    ha na zero (wsub (wsub p #8) #8) (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) (xn-add-0l na) (λ t → toNat (wsub (wsub p #8) #8)) (fst po2) (λ j hj → Empty-rec (false≢true hj))
    (λ x hx t → upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b x) (λ x hx t → upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b x)
    (λ q2 mm2 hd2 hs2 hsl2 lo2 hi2 →
       xs-app GX B (xeN GX B n) (xc body (xslots na (fromNat na)) (fromNat na) xkt) (xseq xmovrsprbp (xseq xpoprbp (x1 xret))) (xm a c (wsub (wsub p #8) #8) q2 f r mm2)
         (XPT B (xm a c (wsub (wsub p #8) #8) q2 f r mm2) (evT G (qeN G n) body (q-push vs kqnil))) XE0 XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil)))
         (xs-lift (xrun GX B (xeN GX B n) (xc body (xslots na (fromNat na)) (fromNat na) xkt) (xm a c (wsub (wsub p #8) #8) q2 f r mm2)) (XPT B (xm a c (wsub (wsub p #8) #8) q2 f r mm2) (evT G (qeN G n) body (q-push vs kqnil))) XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil)))
            (th body (xslots na (fromNat na)) (fromNat na) (q-push vs kqnil) (xm a c (wsub (wsub p #8) #8) q2 f r mm2) hok
               (hd2 , (ha , (hs2 , (xs-ge-trans T p (wsub (wsub p #8) #8) hT (xs-ge-trans p (wsub p #8) (wsub (wsub p #8) #8) (xs-psub p) (xs-psub (wsub p #8))) ,
                subst {lzero} {lzero} {XL} {λ l → XEnv mm2 f (wsub (wsub p #8) #8) (fromNat na) l (q-push vs kqnil)} {xlapp (xslots na (fromNat na)) xlnil} {xslots na (fromNat na)} (xs-xl-nil (xslots na (fromNat na)))
                  (subst {lzero} {lzero} {Word} {λ u → XEnv mm2 f (wsub (wsub p #8) #8) u (xlapp (xslots na u) xlnil) (q-push vs kqnil)} {wadd #0 (fromNat na)} {fromNat na} (wadd-zero-l (fromNat na))
                     (xs-env-push mm2 f (wsub (wsub p #8) #8) na vs #0 xlnil kqnil hisn
                        (λ j hj → subst {lzero} {lzero} {Word} {λ u → XSV mm2 f (q-nth vs j) (mm2 (slot-a (wsub (wsub p #8) #8) u))} {fromNat j} {wadd #0 (fromNat j)} (sym (wadd-zero-l (fromNat j)))
                                    (xs-vmono (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) mm2 f f lo2 (xs-lt-self f) (q-nth vs j) (mm2 (slot-a (wsub (wsub p #8) #8) (fromNat j))) (hsl2 j hj)))
                        (λ k → inl (λ t → kqbot))))))))))
         (λ s4 h4 → xs-epi GX B (xeN GX B n) (evT G (qeN G n) body (q-push vs kqnil)) a c b p f r m (wsub (wsub p #8) #8) q2 (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) mm2 na a c r
                      (cong (λ u → wadd u #8) (snd (snd (snd (snd po2)))) ∙ snd (snd (snd (snd po1))))
                      (xs-fr-trans m (upd m (wsub p #8) #0) (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) f p f (wsub p #8) (xs-fr-wr m (wsub p #8) #0 f p (fst (snd (snd po1))) (fst (snd po1))) (xs-fr-wr (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b f (wsub p #8) (fst (snd (snd po2))) (fst (snd po2))) (xs-lt-self f) (xs-psub p))
                      (xs-upd-hit (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b) hd2 lo2 hi2 (xs-ge-trans p (wsub p #8) (wsub (wsub p #8) #8) (xs-psub p) (xs-psub (wsub p #8))) s4 h4))
xs-callf : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat)
         → ((t : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df t xkt ≡ true → XPre B T env e d s → XSP (xrun GX B (xeN GX B n) (xc t env d xkt) s) (XPT B s (evT G (qeN G n) t e)) XE0 XE0 XE0)
         → (na : Nat) (body : FQ) (vs : KQ) (a c b p f : Word) (r m : Word → Word) → xq-ok A df body xkt ≡ true → q-isn na vs ≡ true → wlt (b-ahi B) f ≡ false → wlt T p ≡ false → XAr m f r na vs
         → wlt p (wadd (b-slo B) #8) ≡ false
         → XSP (xrun GX B (xeN GX B n) (xfn na body) (xm a c b (wsub p #8) f r (upd m (wsub p #8) #0))) XE0 XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil)))
xs-callf G A df GX B T HB n th na body vs a c b p f r m hok hisn ha hT har hn1 =
  xs-ifl-then (wlt (wsub p #8) (wadd (b-slo B) #8)) (xm a c b (wsub (wsub p #8) #8) f r (upd (upd m (wsub p #8) #0) (wsub (wsub p #8) #8) b))
    (λ s2 → xrun GX B (xeN GX B n) (xseq xmovrbprsp (xapp (xpp na zero) (xapp (xc body (xslots na (fromNat na)) (fromNat na) xkt) (xseq xmovrsprbp (xseq xpoprbp (x1 xret)))))) s2)
    XE0 XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil)))
    (λ hn2 → xs-callf2 G A df GX B T HB n th na body vs a c b p f r m hok hisn ha hT har (xs-push-ok B p f HB ha hn1) (xs-push-ok B (wsub p #8) f HB ha hn2))
-- a call at fuel n + 1: the return address pushed, the callee run
xs-callup1 : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat)
           → ((t : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df t xkt ≡ true → XPre B T env e d s → XSP (xrun GX B (xeN GX B n) (xc t env d xkt) s) (XPT B s (evT G (qeN G n) t e)) XE0 XE0 XE0)
           → (na : Nat) (body : FQ) (vs : KQ) (s : XM) → xq-ok A df body xkt ≡ true → q-isn na vs ≡ true → XPreC B T na vs s
           → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xrun GX B (xeN GX B n) (xfn na body) s2))) (XPT B s (evT G (qeN G n) body (q-push vs kqnil))) XE0 XE0 XE0
xs-callup1 G A df GX B T HB n th na body vs (xm a c b p f r m) hok hisn hpre =
  xs-ifl-then (wlt p (wadd (b-slo B) #8)) (xm a c b (wsub p #8) f r (upd m (wsub p #8) #0)) (λ s2 → xret-of (xrun GX B (xeN GX B n) (xfn na body) s2)) (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil))) XE0 XE0 XE0
    (λ hn1 → xs-ret (xrun GX B (xeN GX B n) (xfn na body) (xm a c b (wsub p #8) f r (upd m (wsub p #8) #0))) XE0 XE0 XE0 (XPT B (xm a c b p f r m) (evT G (qeN G n) body (q-push vs kqnil)))
               (xs-callf G A df GX B T HB n th na body vs a c b p f r m hok hisn (fst hpre) (fst (snd (snd hpre))) (snd (snd (snd hpre))) hn1))
xs-callup : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false
          → ((g : Word) → df g ≡ true → xq-ok A df (G g) xkt ≡ true) → ((g : Word) → df g ≡ true → GX g ≡ xfn (A g) (G g)) → (n : Nat)
          → ((t : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df t xkt ≡ true → XPre B T env e d s → XSP (xrun GX B (xeN GX B n) (xc t env d xkt) s) (XPT B s (evT G (qeN G n) t e)) XE0 XE0 XE0)
          → XCallOK G A df GX B T (suc n)
xs-callup G A df GX B T HB tok lk n th g vs s hdf hisn hpre =
  subst {lzero} {lzero} {XA} {λ cc → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xrun GX B (xeN GX B n) cc s2))) (XPT B s (evT G (qeN G n) (G g) (q-push vs kqnil))) XE0 XE0 XE0} {xfn (A g) (G g)} {GX g} (sym (lk g hdf))
    (xs-callup1 G A df GX B T HB n th (A g) (G g) vs s (tok g hdf) hisn hpre)
-- at fuel 0 a call has no value
xs-call0a : (GX : Word → XA) (B : XB) (g : Word) (Q : XM → Type) (s : XM) → XSP (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev (xeN GX B zero) (GX g) s2))) Q XE0 XE0 XE0
xs-call0a GX B g Q (xm a c b p f r m) = xs-ifl-then (wlt p (wadd (b-slo B) #8)) (xm a c b (wsub p #8) f r (upd m (wsub p #8) #0)) (λ s2 → xret-of (xe-ev (xeN GX B zero) (GX g) s2)) Q XE0 XE0 XE0 (λ h → unit)
-- ---------------------------------------------------------------- loops: a turn
xs-lstep : (o : XO) (k : XM → XO) (R J E : XM → Type) → XSP o XE0 J E XE0 → ((s : XM) → J s → XSP (k s) R XE0 XE0 XE0) → ((s : XM) → E s → R s) → XSP (xlstep o k) R XE0 XE0 XE0
xs-lstep (xon s) k R J E h fj fe = unit
xs-lstep (xjh s) k R J E h fj fe = fj s h
xs-lstep (xje s) k R J E h fj fe = fe s h
xs-lstep (xrt s) k R J E h fj fe = unit
xs-lstep xlim k R J E h fj fe = unit
xs-lstep xbot k R J E h fj fe = unit
-- a run from a state equal to the one given (rbp as a path), for any claim about the state
xs-normx : (F : XM → Type) (a1 c1 b1 p1 f1 : Word) (r1 m1 : Word → Word) (b : Word) → b1 ≡ b → F (xm a1 c1 b p1 f1 r1 m1) → F (xm a1 c1 b1 p1 f1 r1 m1)
xs-normx F a1 c1 b1 p1 f1 r1 m1 b hb h = subst {lzero} {lzero} {XM} {F} {xm a1 c1 b p1 f1 r1 m1} {xm a1 c1 b1 p1 f1 r1 m1} (λ t → xm a1 c1 (hb (~ t)) p1 f1 r1 m1) h
-- the back jump: the next turn from the new state
xs-lu-j3 : (B : XB) (k : Nat) (v v2 : KQ) (cont : KQ → KQ) (a c b p f : Word) (r m : Word → Word) (a2 c2 p2 f2 : Word) (r2 m2 : Word → Word) (base : Word) → XDp b p base → XDp b p2 base → wlt f2 f ≡ false → XFr m m2 f (wadd p (w8 (fromNat k)))
         → ((mm : Word → Word) (fz x : Word) → XSV mm fz v2 x → XSV mm fz (q-lstep v cont) x) → (s3 : XM) → XPLp B k (xm a2 c2 b p2 f2 r2 m2) v2 s3 → XPLp B k (xm a c b p f r m) (q-lstep v cont) s3
xs-lu-j3 B k v v2 cont a c b p f r m a2 c2 p2 f2 r2 m2 base hd hd2 hf2 fr htr (xm a3 c3 b3 p3 f3 r3 m3) h3 =
  (fst h3 , (fst (snd h3) ∙ xs-dp-inj b p p2 base hd hd2 , (xs-le3 f f2 f3 hf2 (fst (snd (snd h3))) , (fst (snd (snd (snd h3))) ,
   (xs-fr-trans m m2 m3 f (wadd p (w8 (fromNat k))) f2 (wadd p2 (w8 (fromNat k))) fr (fst (snd (snd (snd (snd h3))))) hf2
      (subst {lzero} {lzero} {Word} {λ u → wlt (wadd p (w8 (fromNat k))) (wadd u (w8 (fromNat k))) ≡ false} {p} {p2} (sym (xs-dp-inj b p p2 base hd hd2)) (xs-lt-self (wadd p (w8 (fromNat k))))) ,
    htr m3 f3 a3 (snd (snd (snd (snd (snd h3))))))))))
xs-lu-j2 : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) (n : Nat) → XLoopOK G A df GX B T n
         → (k : Nat) (body : FQ) (env : XL) (e : KQ) (d0 : Word) (v : KQ) (a c b p f : Word) (r m : Word → Word) → XDp b p (wadd d0 (fromNat k)) → wlt T b ≡ false → XEnv m f b d0 env e → xq-ok A df body (xkb (fromNat k)) ≡ true
         → (a2 c2 p2 f2 : Word) (r2 m2 : Word → Word) → XDp b p2 (wadd d0 (fromNat k)) → wlt f2 f ≡ false → wlt (b-ahi B) f2 ≡ false → wlt p2 (b-slo B) ≡ false → XFr m m2 f (wadd p (w8 (fromNat k)))
         → (st2 : KQ) → q-isn k st2 ≡ true → XSl m2 f2 b d0 k st2 → ((mm : Word → Word) (fz x : Word) → XSV mm fz (qe-lp (qeN G n) st2 body e) x → XSV mm fz (q-lstep v (λ st3 → qe-lp (qeN G n) st3 body e)) x)
         → XSP (xe-lp (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) (xm a2 c2 b p2 f2 r2 m2))
               (XPLp B k (xm a c b p f r m) (q-lstep v (λ st3 → qe-lp (qeN G n) st3 body e))) XE0 XE0 XE0
xs-lu-j2 G A df GX B T n lo k body env e d0 v a c b p f r m hd hT henv hok a2 c2 p2 f2 r2 m2 hd2 hf2 ha2 hs2 fr st2 hi2 hsl2 htr =
  xs-map (xe-lp (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) (xm a2 c2 b p2 f2 r2 m2))
    (XPLp B k (xm a2 c2 b p2 f2 r2 m2) (qe-lp (qeN G n) st2 body e)) (XPLp B k (xm a c b p f r m) (q-lstep v (λ st3 → qe-lp (qeN G n) st3 body e)))
    (lo k st2 body env e d0 (xm a2 c2 b p2 f2 r2 m2) hi2 hok (hd2 , (ha2 , (hs2 , (hT , (xs-env-mono m m2 f f2 b (wadd p (w8 (fromNat k))) d0 env e (xs-dp-pop b p d0 (fromNat k) hd) fr hf2 henv , hsl2))))))
    (λ s3 h3 → xs-lu-j3 B k v (qe-lp (qeN G n) st2 body e) (λ st3 → qe-lp (qeN G n) st3 body e) a c b p f r m a2 c2 p2 f2 r2 m2 (wadd d0 (fromNat k)) hd hd2 hf2 fr htr s3 h3)
xs-lu-j : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) (n : Nat) → XLoopOK G A df GX B T n
        → (k : Nat) (body : FQ) (env : XL) (e : KQ) (d0 : Word) (v : KQ) (a c b p f : Word) (r m : Word → Word) → XDp b p (wadd d0 (fromNat k)) → wlt T b ≡ false → XEnv m f b d0 env e → xq-ok A df body (xkb (fromNat k)) ≡ true
        → (s2 : XM) → XPJ B k d0 (wadd p (w8 (fromNat k))) (λ st3 → qe-lp (qeN G n) st3 body e) v (xm a c b p f r m) s2
        → XSP (xe-lp (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) s2) (XPLp B k (xm a c b p f r m) (q-lstep v (λ st3 → qe-lp (qeN G n) st3 body e))) XE0 XE0 XE0
xs-lu-j G A df GX B T n lo k body env e d0 v a c b p f r m hd hT henv hok (xm a2 c2 b2 p2 f2 r2 m2) h2 =
  xs-normx (λ s → XSP (xe-lp (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) s) (XPLp B k (xm a c b p f r m) (q-lstep v (λ st3 → qe-lp (qeN G n) st3 body e))) XE0 XE0 XE0)
    a2 c2 b2 p2 f2 r2 m2 b (fst h2)
    (xs-lu-j2 G A df GX B T n lo k body env e d0 v a c b p f r m hd hT henv hok a2 c2 p2 f2 r2 m2 (fst (snd h2)) (fst (snd (snd h2))) (fst (snd (snd (snd h2)))) (fst (snd (snd (snd (snd h2))))) (fst (snd (snd (snd (snd (snd h2))))))
       (fst (snd (snd (snd (snd (snd (snd h2))))))) (fst (snd (snd (snd (snd (snd (snd (snd h2)))))))) (fst (snd (snd (snd (snd (snd (snd (snd (snd h2))))))))) (snd (snd (snd (snd (snd (snd (snd (snd (snd h2))))))))))
xs-lu-e : (B : XB) (k : Nat) (d0 : Word) (cont : KQ → KQ) (v : KQ) (a c b p f : Word) (r m : Word → Word) → XDp b p (wadd d0 (fromNat k))
        → (s2 : XM) → XPE B k d0 (wadd p (w8 (fromNat k))) cont v (xm a c b p f r m) s2 → XPLp B k (xm a c b p f r m) (q-lstep v cont) s2
xs-lu-e B k d0 cont v a c b p f r m hd (xm a2 c2 b2 p2 f2 r2 m2) h2 =
  (fst h2 , (xs-dp-inj b p p2 (wadd d0 (fromNat k)) hd (fst (snd h2)) , (fst (snd (snd h2)) , (fst (snd (snd (snd h2))) , (fst (snd (snd (snd (snd (snd h2))))) , snd (snd (snd (snd (snd (snd h2))))))))))
-- a loop at fuel n + 1: its body at n, then the next turn at n or past the loop
xs-loopup1 : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat) → XCallOK G A df GX B T n → XLoopOK G A df GX B T n
           → (k : Nat) (st : KQ) (body : FQ) (env : XL) (e : KQ) (d0 : Word) (s : XM) → q-isn k st ≡ true → xq-ok A df body (xkb (fromNat k)) ≡ true → XPreL B T k st env e d0 s
           → XSP (xe-lp (xeN GX B (suc n)) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) s) (XPLp B k s (qe-lp (qeN G (suc n)) st body e)) XE0 XE0 XE0
xs-loopup1 G A df GX B T HB n co lo k st body env e d0 (xm a c b p f r m) hisn hok hpre =
  xs-lstep (xrun GX B (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) (xm a c b p f r m))
    (λ s2 → xe-lp (xeN GX B n) (xc body (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (xkb (wadd d0 (fromNat k)))) s2)
    (XPLp B k (xm a c b p f r m) (q-lstep (evT G (qeN G n) body (q-push st e)) (λ st3 → qe-lp (qeN G n) st3 body e)))
    (XPJ B k d0 (wadd p (w8 (fromNat k))) (λ st3 → qe-lp (qeN G n) st3 body e) (evT G (qeN G n) body (q-push st e)) (xm a c b p f r m))
    (XPE B k d0 (wadd p (w8 (fromNat k))) (λ st3 → qe-lp (qeN G n) st3 body e) (evT G (qeN G n) body (q-push st e)) (xm a c b p f r m))
    (xs-step G A df GX B T HB n co lo body (xkb (wadd d0 (fromNat k))) (xlapp (xslots k (wadd d0 (fromNat k))) env) (wadd d0 (fromNat k)) (q-push st e) (k , (d0 , (wadd p (w8 (fromNat k)) , (λ st3 → qe-lp (qeN G n) st3 body e)))) (xm a c b p f r m) hok
       ((fst hpre , (fst (snd hpre) , (fst (snd (snd hpre)) , (fst (snd (snd (snd hpre))) , xs-env-push m f b k st d0 env e hisn (snd (snd (snd (snd (snd hpre))))) (fst (snd (snd (snd (snd hpre))))))))) ,
        (xs-lt-self (wadd d0 (fromNat k)) , ((λ t → wadd d0 (fromNat k)) , (xs-dp-pop b p d0 (fromNat k) (fst hpre) , xs-add-ge p (w8 (fromNat k)))))))
    (λ s2 h2 → xs-lu-j G A df GX B T n lo k body env e d0 (evT G (qeN G n) body (q-push st e)) a c b p f r m (fst hpre) (fst (snd (snd (snd hpre)))) (fst (snd (snd (snd (snd hpre))))) hok s2 h2)
    (λ s2 h2 → xs-lu-e B k d0 (λ st3 → qe-lp (qeN G n) st3 body e) (evT G (qeN G n) body (q-push st e)) a c b p f r m (fst hpre) s2 h2)
xs-loopup : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat) → XCallOK G A df GX B T n → XLoopOK G A df GX B T n → XLoopOK G A df GX B T (suc n)
xs-loopup G A df GX B T HB n co lo k st body env e d0 s hisn hok hpre = xs-loopup1 G A df GX B T HB n co lo k st body env e d0 s hisn hok hpre
-- ---------------------------------------------------------------- the theorem
-- the calls and loops at every fuel, by induction on it
xs-coks : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false
        → ((g : Word) → df g ≡ true → xq-ok A df (G g) xkt ≡ true) → ((g : Word) → df g ≡ true → GX g ≡ xfn (A g) (G g)) → (n : Nat) → XCallOK G A df GX B T n × XLoopOK G A df GX B T n
xs-coks G A df GX B T HB tok lk zero = ((λ g vs s hd hi hp → xs-call0a GX B g (XPT B s (qe-ev (qeN G zero) (G g) (q-push vs kqnil))) s) , (λ k st body env e d0 s hi hok hp → unit))
xs-coks G A df GX B T HB tok lk (suc n) =
  (xs-callup G A df GX B T HB tok lk n (λ t env d e s hk h → xs-step G A df GX B T HB n (fst (xs-coks G A df GX B T HB tok lk n)) (snd (xs-coks G A df GX B T HB tok lk n)) t xkt env d e unit s hk h) ,
   xs-loopup G A df GX B T HB n (fst (xs-coks G A df GX B T HB tok lk n)) (snd (xs-coks G A df GX B T HB tok lk n)))
-- xa-sound: for a table every defined key of which is in the x86 fragment and translated by fq-to-xa's
-- xfn, regions with the arena below the stack: at every fuel, every expression in the fragment, run by
-- evx from a state at depth d whose slots refine the environment, ends (if it ends without a limit hit)
-- with rbp and rsp as they were, r15 grown and at most ahi, memory below the old r15 and from rsp up
-- unchanged, and in rax a word refining evq's value
xa-sound : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false
         → ((g : Word) → df g ≡ true → xq-ok A df (G g) xkt ≡ true) → ((g : Word) → df g ≡ true → GX g ≡ xfn (A g) (G g))
         → (n : Nat) (t : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df t xkt ≡ true → XPre B T env e d s
         → XSP (evx GX B n (xc t env d xkt) s) (XPT B s (evq G n t e)) XE0 XE0 XE0
xa-sound G A df GX B T HB tok lk n t env d e s hk h = xs-step G A df GX B T HB n (fst (xs-coks G A df GX B T HB tok lk n)) (snd (xs-coks G A df GX B T HB tok lk n)) t xkt env d e unit s hk h
-- a program's entry: call g with its arguments in their registers; the callee's value, refined, rsp and
-- rbp restored
xa-sound-call : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false
              → ((g : Word) → df g ≡ true → xq-ok A df (G g) xkt ≡ true) → ((g : Word) → df g ≡ true → GX g ≡ xfn (A g) (G g))
              → (n : Nat) (g : Word) (vs : KQ) (s : XM) → df g ≡ true → q-isn (A g) vs ≡ true → XPreC B T (A g) vs s
              → XSP (evx GX B n (x1 (xcall g)) s) (XPT B s (qe-ev (qeN G n) (G g) (q-push vs kqnil))) XE0 XE0 XE0
xa-sound-call G A df GX B T HB tok lk n g vs s hd hi hp =
  xs-on (xthen (x-push B #0 s) (λ s2 → xret-of (xe-ev (xeN GX B n) (GX g) s2))) (XPT B s (qe-ev (qeN G n) (G g) (q-push vs kqnil))) XE0 XE0 XE0 (fst (xs-coks G A df GX B T HB tok lk n) g vs s hd hi hp)
-- the outcome of a normal end, as a claim about its state
xs-on-eq : (o : XO) (s : XM) (Q J E R : XM → Type) → XSP o Q J E R → o ≡ xon s → Q s
xs-on-eq o s Q J E R h ho = subst {lzero} {lzero} {XO} {λ u → XSP u Q J E R} {o} {xon s} ho h
-- no address wraps: rbp, rsp and r15 below 2^64 when T is
xs-le-lt : (x y z : Word) → wlt y x ≡ false → wlt y z ≡ true → wlt x z ≡ true
xs-le-lt x y z h1 h2 = xs-mk-lt x z (xn-le-trans (suc (toNat x)) (suc (toNat y)) (toNat z) (xs-nlt y x h1) (xs-lt y z h2))
xs-nowrap : (B : XB) (T : Word) (env : XL) (e : KQ) (d : Word) (s : XM) → wlt (b-slo B) (b-ahi B) ≡ false → x-fits T ≡ true → XPre B T env e d s
          → (x-fits (x-rbp s) ≡ true) × ((x-fits (x-rsp s) ≡ true) × (x-fits (x-r15 s) ≡ true))
xs-nowrap B T env e d (xm a c b p f r m) HB hT h =
  (xs-le-lt b T #18446744073709551616 (fst (snd (snd (snd h)))) hT ,
   (xs-le-lt p T #18446744073709551616 (xs-ge-trans T b p (fst (snd (snd (snd h)))) (xs-dp-le b p d (fst h))) hT ,
    xs-le-lt f T #18446744073709551616 (xs-ge-trans T p f (xs-ge-trans T b p (fst (snd (snd (snd h)))) (xs-dp-le b p d (fst h))) (xs-ge-trans p (b-slo B) f (fst (snd (snd h))) (xs-ge-trans (b-slo B) (b-ahi B) f HB (fst (snd h))))) hT))
