    (λ hc → xs-st-bc-c G A df GX B T HB n k d0 pd0 cont base dd c (fqcons y r) env d e s hc
               (xs-hk-t c (andbt (xq-isn (dnat (fromNat k)) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)) (andbt (xq-isn (suc zero) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)) hc hk) h ihl)
    (λ hc → xs-bbrk GX B (xeN GX B n) T k d0 pd0 base cont env e d dd c (xc y env d xkt) (evT G (qeN G n) y e) (evT G (qeN G n) r e) s h hc
               (ihy (andr (xq-isn (suc zero) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)
                       (xs-hk-f c (andbt (xq-isn (dnat (fromNat k)) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)) (andbt (xq-isn (suc zero) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)) hc hk))
                    (andl (xq-ok A df y xkt) (xq-ok A df r xkl) (andr (xq-isn (suc zero) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)
                       (xs-hk-f c (andbt (xq-isn (dnat (fromNat k)) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)) (andbt (xq-isn (suc zero) (fqcons y r)) (xq-ok A df (fqcons y r) xkl)) hc hk)))
                  s (xs-preb-pre B T k d0 pd0 base env e d s h)))
xs-st-bcon : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat) (k : Nat) (d0 pd0 : Word) (cont : KQ → KQ) (base : Word)
           → (dd c : Word) (fs : FQ) (env : XL) (d : Word) (e : KQ) (s : XM)
           → (if weq c #0 then andbt (xq-isn (dnat (fromNat k)) fs) (xq-ok A df fs xkl) else andbt (xq-isn (suc zero) fs) (xq-ok A df fs xkl)) ≡ true
           → XPreB B T k d0 pd0 base env e d s
           → (xq-ok A df fs xkl ≡ true → XIl G GX B T n fs env d e)
           → XSP (xrun GX B (xeN GX B n) (if weq c #0 then xapp (xc fs env d xkl) (xapp (xpop-state (xq-len fs) base) (xapp (xdrop d base) (x1 xjh0))) else xapp (x1 xud2) (xapp (xdrop d base) (x1 xje0))) s)
                 XE0 (XPJ B k d0 pd0 cont (kqcon dd c (evT G (qeN G n) fs e)) s) (XPE B k d0 pd0 cont (kqcon dd c (evT G (qeN G n) fs e)) s) XE0
xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c fs env d e s hk h ihl =
  xs-bif XA (weq c #0)
    (xapp (xc fs env d xkl) (xapp (xpop-state (xq-len fs) base) (xapp (xdrop d base) (x1 xjh0))))
    (xapp (x1 xud2) (xapp (xdrop d base) (x1 xje0)))
    (λ ko → XSP (xrun GX B (xeN GX B n) ko s) XE0 (XPJ B k d0 pd0 cont (kqcon dd c (evT G (qeN G n) fs e)) s) (XPE B k d0 pd0 cont (kqcon dd c (evT G (qeN G n) fs e)) s) XE0)
    (λ hc → xs-st-bc-c G A df GX B T HB n k d0 pd0 cont base dd c fs env d e s hc
               (xs-hk-t c (andbt (xq-isn (dnat (fromNat k)) fs) (xq-ok A df fs xkl)) (andbt (xq-isn (suc zero) fs) (xq-ok A df fs xkl)) hc hk) h ihl)
    (λ hc → unit)
-- a primitive by its arguments' shape: two, each by the list's element goals; any other shape's code is ud2
xs-hk-prim : (A : Word → Nat) (df : Word → Bool) (o : Word) (as : FQ) → xq-ok A df (fqprim o as) xkt ≡ true → xq-ok A df as xkl ≡ true
xs-hk-prim A df o as hk = andr (xq-isn (suc (suc zero)) as) (xq-ok A df as xkl) (andr (wlt o #5) (andbt (xq-isn (suc (suc zero)) as) (xq-ok A df as xkl)) hk)
xs-st-prim-sh : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat)
              → (o : Word) (as : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df (fqprim o as) xkt ≡ true → XPre B T env e d s → XHd G A df GX B T n as env d e
              → XSP (xrun GX B (xeN GX B n) (xc (fqprim o as) env d xkt) s) (XPT B s (evT G (qeN G n) (fqprim o as) e)) XE0 XE0 XE0
xs-st-prim-sh G A df GX B T HB n o (fqcons a (fqcons b fqnil)) env d e s hk h ih =
  xs-st-prim G A df GX B T HB n o a b env d e s hk h (fst ih)
    (λ hkb s2 h2 → fst (snd ih (andr (xq-ok A df a xkt) (xq-ok A df (fqcons b fqnil) xkl) (xs-hk-prim A df o (fqcons a (fqcons b fqnil)) hk)) s2 h2) hkb s2 h2)
xs-st-prim-sh G A df GX B T HB n o (fql z0) env d e s hk h ih = unit
xs-st-prim-sh G A df GX B T HB n o (fqv z0) env d e s hk h ih = unit
xs-st-prim-sh G A df GX B T HB n o (fqprim z0 z1) env d e s hk h ih = unit
xs-st-prim-sh G A df GX B T HB n o (fqlet z0 z1) env d e s hk h ih = unit
xs-st-prim-sh G A df GX B T HB n o (fqcon z0 z1 z2) env d e s hk h ih = unit
xs-st-prim-sh G A df GX B T HB n o (fqproj z0 z1 z2 z3) env d e s hk h ih = unit
xs-st-prim-sh G A df GX B T HB n o (fqsw z0 z1) env d e s hk h ih = unit
