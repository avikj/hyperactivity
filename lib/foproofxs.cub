-- a loop body's constructor by its field list's shape
xs-st-bc : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat) (k : Nat) (d0 pd0 : Word) (cont : KQ → KQ) (base : Word)
         → (dd c : Word) (fs : FQ) (env : XL) (d : Word) (e : KQ) (s : XM) → xq-ok A df (fqcon dd c fs) (xkb (fromNat k)) ≡ true → XPreB B T k d0 pd0 base env e d s
         → (xq-ok A df fs xkl ≡ true → XIl G GX B T n fs env d e) → (xq-ok A df fs xkl ≡ true → XHd G A df GX B T n fs env d e)
         → XSP (xrun GX B (xeN GX B n) (xc (fqcon dd c fs) env d (xkb base)) s) XE0 (XPJ B k d0 pd0 cont (evT G (qeN G n) (fqcon dd c fs) e) s) (XPE B k d0 pd0 cont (evT G (qeN G n) (fqcon dd c fs) e) s) XE0
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqcons y r) env d e s hk h ihl ihh = xs-st-bcon1 G A df GX B T HB n k d0 pd0 cont base dd c y r env d e s hk h ihl (λ hkl → fst (ihh hkl))
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fql z0) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fql z0) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqv z0) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqv z0) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqprim z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqprim z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqlet z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqlet z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqcon z0 z1 z2) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqcon z0 z1 z2) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqproj z0 z1 z2 z3) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqproj z0 z1 z2 z3) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqsw z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqsw z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqif z0 z1 z2) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqif z0 z1 z2) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqclos z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqclos z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqlam z0) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqlam z0) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqapp z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqapp z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqcall z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqcall z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqloop z0 z1) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqloop z0 z1) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c fqnil env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c fqnil env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c (fqalt z0 z1 z2 z3) env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c (fqalt z0 z1 z2 z3) env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c fqanone env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c fqanone env d e s hk h ihl
xs-st-bc G A df GX B T HB n k d0 pd0 cont base dd c fqnet env d e s hk h ihl ihh = xs-st-bcon G A df GX B T HB n k d0 pd0 cont base dd c fqnet env d e s hk h ihl
-- every construct at fuel n, given the calls and loops at fuel n (one induction over the term, each call on
-- a field of the construct matched)
xs-step : (G : Word → FQ) (A : Word → Nat) (df : Word → Bool) (GX : Word → XA) (B : XB) (T : Word) → wlt (b-slo B) (b-ahi B) ≡ false → (n : Nat) → XCallOK G A df GX B T n → XLoopOK G A df GX B T n
        → (t : FQ) (m : XK) (env : XL) (d : Word) (e : KQ) (x : XCtx m) (s : XM) → xq-ok A df t (xs-okm m x) ≡ true → XPreM B T m env e d x s → XGoal G A df GX B T n m t env d e x s
xs-step G A df GX B T HB n co lo (fql w) xkt env d e x s hk h = xs-lit GX B (xeN GX B n) T env e d w s h
xs-step G A df GX B T HB n co lo (fqv k) xkt env d e x s hk h = xs-var GX B (xeN GX B n) T env e d k s h
xs-step G A df GX B T HB n co lo (fqprim o as) xkt env d e x s hk h = xs-st-prim-sh G A df GX B T HB n o as env d e s hk h (snd (xs-step G A df GX B T HB n co lo as xkl env d e unit s (xs-hk-prim A df o as hk) h))
xs-step G A df GX B T HB n co lo (fqlet a b) xkt env d e x s hk h =
  xs-st-let G A df GX B T HB n a b env d e s hk h (λ hka s2 h2 → xs-step G A df GX B T HB n co lo a xkt env d e unit s2 hka h2)
    (λ hkb s2 h2 → xs-step G A df GX B T HB n co lo b xkt (xlcons d env) (wadd d #1) (kqcons (evT G (qeN G n) a e) e) unit s2 hkb h2)
xs-step G A df GX B T HB n co lo (fqif c a b) xkt env d e x s hk h =
  xs-st-if G A df GX B T n c a b env d e s hk h (λ hkc s2 h2 → xs-step G A df GX B T HB n co lo c xkt env d e unit s2 hkc h2)
    (λ hka s2 h2 → xs-step G A df GX B T HB n co lo a xkt env d e unit s2 hka h2) (λ hkb s2 h2 → xs-step G A df GX B T HB n co lo b xkt env d e unit s2 hkb h2)
xs-step G A df GX B T HB n co lo (fqcall g as) xkt env d e x s hk h =
  xs-st-call G A df GX B T HB n co g as env d e s hk h (λ hka s2 h2 → fst (xs-step G A df GX B T HB n co lo as xkl env d e unit s2 hka h2))
xs-step G A df GX B T HB n co lo (fqcon dd c fs) xkt env d e x s hk h =
  xs-st-con G A df GX B T HB n dd c fs env d e s hk h (λ hkf s2 h2 → fst (xs-step G A df GX B T HB n co lo fs xkl env d e unit s2 hkf h2))
xs-step G A df GX B T HB n co lo (fqproj dd c k y) xkt env d e x s hk h =
  xs-st-proj G A df GX B T n dd c k y env d e s hk h (λ hky s2 h2 → xs-step G A df GX B T HB n co lo y xkt env d e unit s2 hky h2)
xs-step G A df GX B T HB n co lo (fqloop init b) xkt env d e x s hk h =
  xs-st-loop G A df GX B T n lo init b env d e s hk h (λ hki s2 h2 → fst (xs-step G A df GX B T HB n co lo init xkl env d e unit s2 hki h2))
xs-step G A df GX B T HB n co lo fqnil xkl env d e x s hk h = (xs-lnil GX B (xeN GX B n) T env e d s h , unit)
xs-step G A df GX B T HB n co lo (fqcons y r) xkl env d e x s hk h =
  (xs-st-cons G A df GX B T HB n y r env d e s hk h (λ hky s2 h2 → xs-step G A df GX B T HB n co lo y xkt env d e unit s2 hky h2) (λ hkr s2 h2 → fst (xs-step G A df GX B T HB n co lo r xkl env (wadd d #1) e unit s2 hkr h2)) ,
   ((λ hky s2 h2 → xs-step G A df GX B T HB n co lo y xkt env d e unit s2 hky h2) , (λ hkr s2 h2 → snd (xs-step G A df GX B T HB n co lo r xkl env (wadd d #1) e unit s2 hkr h2))))
xs-step G A df GX B T HB n co lo (fqif c a b) (xkb base) env d e x s hk h =
  xs-st-bif G A df GX B T n (fst x) (fst (snd x)) (fst (snd (snd x))) (snd (snd (snd x))) base c a b env d e s hk h
    (λ hkc s2 h2 → xs-step G A df GX B T HB n co lo c xkt env d e unit s2 hkc h2)
    (λ hka s2 h2 → xs-step G A df GX B T HB n co lo a (xkb base) env d e x s2 hka h2) (λ hkb s2 h2 → xs-step G A df GX B T HB n co lo b (xkb base) env d e x s2 hkb h2)
xs-step G A df GX B T HB n co lo (fqlet a b) (xkb base) env d e x s hk h =
  xs-st-blet G A df GX B T HB n (fst x) (fst (snd x)) (fst (snd (snd x))) (snd (snd (snd x))) base a b env d e s hk h
    (λ hka s2 h2 → xs-step G A df GX B T HB n co lo a xkt env d e unit s2 hka h2)
    (λ hkb s2 h2 → xs-step G A df GX B T HB n co lo b (xkb base) (xlcons d env) (wadd d #1) (kqcons (evT G (qeN G n) a e) e) x s2 hkb h2)
xs-step G A df GX B T HB n co lo (fqcon dd c fs) (xkb base) env d e x s hk h =
  xs-st-bc G A df GX B T HB n (fst x) (fst (snd x)) (fst (snd (snd x))) (snd (snd (snd x))) base dd c fs env d e s hk h
    (λ hkl s2 h2 → fst (xs-step G A df GX B T HB n co lo fs xkl env d e unit s2 hkl h2))
    (λ hkl → snd (xs-step G A df GX B T HB n co lo fs xkl env d e unit s hkl (xs-preb-pre B T (fst x) (fst (snd x)) (fst (snd (snd x))) base env e d s h)))
xs-step G A df GX B T HB n co lo (fqsw z0 z1) xkt env d e x s hk h = Empty-rec (false≢true hk)
xs-step G A df GX B T HB n co lo (fqclos z0 z1) xkt env d e x s hk h = Empty-rec (false≢true hk)
