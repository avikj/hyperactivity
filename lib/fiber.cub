-- fiber.cub — a map factors through its fibers (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §12 “The build list”, “C. Memory and state”, item 23, C23: state programs through the fibers of a map): for f : A → B, A is equivalent to the
-- total space of the fibers of f, (b : B) × fiber f b; to a is (f a , (a , refl)), from (b , (a , q))
-- is a. The equivalence is the factoring A → Σ B (fiber f) → B of f through the first projection,
-- the shape a world's state takes when it is keyed by what a map computes from it (a registry
-- keyed by the handle it computes, an array keyed by the index it stores at). Over lib/std.cub

total : {A B : Type} → (f : A → B) → A → (b : B) × fiber f b
total f a = (f a , (a , λ i → f a))
untotal : {A B : Type} → (f : A → B) → ((b : B) × fiber f b) → A
untotal f p = fst (snd p)
-- the first projection after total is f: the factoring
total-fst : {A B : Type} → (f : A → B) → (a : A) → fst (total f a) ≡ f a
total-fst f a = λ i → f a
total-untotal : {A B : Type} → (f : A → B) → (p : (b : B) × fiber f b) → total f (untotal f p) ≡ p
total-untotal f p = λ i → (snd (snd p) i , (fst (snd p) , λ j → snd (snd p) (i /\ j)))
untotal-total : {A B : Type} → (f : A → B) → (a : A) → untotal f (total f a) ≡ a
untotal-total f a = λ i → a
fiberEquiv : {A B : Type} → (f : A → B) → Equiv A ((b : B) × fiber f b)
fiberEquiv {A} {B} f = isoToEquiv {lzero} {A} {(b : B) × fiber f b} (total f) (untotal f) (total-untotal f) (untotal-total f)

-- ---------------------------------------------------------------- the example: parity. Nat is the
-- evens together with the odds, each the fiber of parity over its boolean
parity : Nat → Bool
parity n = case n return (λ x → Bool) of zero → true; suc k → not (rec k)
Nat≃Parity : Equiv Nat ((b : Bool) × fiber parity b)
Nat≃Parity = fiberEquiv parity
-- ---------------------------------------------------------------- state programs through the factoring (PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §12 “The build list”, “C. Memory and state”, item 23, C23: state programs through the fibers of a map)
-- a state of type A keyed by f : A → B is a point of the total space; a program that moves within
-- a fiber (a function on the fiber over each key) is a function on A through the equivalence,
-- and it leaves the key fixed: the projection after it is f. This is the shape of a world whose
-- state is keyed by what a map computes (a registry by its handle, an array by its index): an
-- update at a key is a program on that key's fiber, and the key's invariance is this theorem
in-fiber : {A B : Type} → (f : A → B) → ((b : B) → fiber f b → fiber f b) → A → A
in-fiber f g a = untotal f (f a , g (f a) (snd (total f a)))
in-fiber-key : {A B : Type} → (f : A → B) → (g : (b : B) → fiber f b → fiber f b) → (a : A) → f (in-fiber f g a) ≡ f a
in-fiber-key f g a = snd (g (f a) (snd (total f a)))
-- the parity example: adding two moves within a parity fiber (the proof of parity is carried:
-- parity (suc (suc n)) is not (not (parity n)) by computation, and not (not b) ≡ b by cases)
not-not : (b : Bool) → not (not b) ≡ b
not-not b = case b return (λ x → not (not x) ≡ x) of true → λ i → true; false → λ i → false
plus2-fib : (b : Bool) → fiber parity b → fiber parity b
plus2-fib b p = (suc (suc (fst p)) , concat (not-not (parity (fst p))) (snd p))
