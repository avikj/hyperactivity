      t'2 =
        if (weq m'1 #197) then
          (bv-zext #4 #5 (vex2_byte1-vvvv (vex_prefixes-byte1 vex_prefixes')))
        else if (weq m'1 #196) then
          (bv-zext #4 #5 (vex3_byte2-vvvv (vex_prefixes-byte2 vex_prefixes')))
        else
          #31
  in t'2
