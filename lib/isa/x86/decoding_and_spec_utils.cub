                   in wme_size proc_mode' addr_size operand_size addr base_reg seg_reg operand check_alignment? false)
         in λ σ →
              if inst_ac? then
                the (MS Unit)
                  (bindS {Bool} {Unit} alignment_checking_enabled_p (λ t'3 →
                     k'8 t'3)) σ
              else
                the (MS Unit)
                  (k'8 false) σ) σ
-- (part of language-support)
select_operand_size : (proc_mode' : proc_mode) → (byte_operand? : Bool) → (rex_byte : Bits #8) → (imm? : Bool) → (prefixes' : prefixes) → (default64? : Bool) → (ignore_rex? : Bool) → (ignore_p3_64? : Bool) → MS ZI
select_operand_size proc_mode' byte_operand? rex_byte imm? prefixes' default64? ignore_rex? ignore_p3_64? =
  λ σ →
    if byte_operand? then
      the (MS ZI)
        (retS {ZI} (zpos #1)) σ
    else if (in_64bit_mode proc_mode') then
      the (MS ZI)
        (let t'2 : ZI
             t'2 =
               if (b-and (logbitp_bits #8 (zpos #3) rex_byte) (b-not ignore_rex?)) then
                 (if imm? then (zpos #4) else (zpos #8))
               else
                 (let t'1 : ZI
                      t'1 =
                        if (b-and (weq #102 (prefixes-opr prefixes')) (b-not ignore_p3_64?)) then
                          (zpos #2)
                        else
                          (if default64? then (zpos #8) else (zpos #4))
                  in t'1)
         in retS {ZI} t'2) σ
    else
      the (MS ZI)
        (bindS {List (Bits #16)} {ZI} (getS {List (Bits #16)} x86-seg_hidden_attrs) (λ seg_hidden_attrs'3 →
           let cs_attr : Bits #16
               cs_attr = (vec-get {Bits #16} #0 seg_hidden_attrs'3 #1)
               cs_d : Bits #1
               cs_d = (code_segment_descriptor_attributesbits-d cs_attr)
               p3? : Bool
               p3? = (weq #102 (prefixes-opr prefixes'))
           in retS {ZI} (if (weq cs_d #1) then (if p3? then (zpos #2) else (zpos #4)) else (if p3? then (zpos #4) else (zpos #2))))) σ
-- (part of language-support)
check_instruction_length : (start_rip : Bits #48) → (temp_rip : Bits #48) → (delta_rip : Bits #3) → Option ZI
check_instruction_length start_rip temp_rip delta_rip =
  let start_rip : ZI
      start_rip = (bv-signed #48 start_rip)
      temp_rip : ZI
      temp_rip = (bv-signed #48 temp_rip)
      delta_rip : ZI
      delta_rip = (bv-unsigned #3 delta_rip)
      end_rip : Bits #49
      end_rip = (bits_of_int (z-add (bv-signed #48 (bits_of_int temp_rip (zpos #48))) (bv-unsigned #3 (bits_of_int delta_rip (zpos #3)))) (zpos #49))
      length' : Bits #50
      length' = (bits_of_int (z-sub (bv-signed #49 end_rip) (bv-signed #48 (bits_of_int start_rip (zpos #48)))) (zpos #50))
  in (if (z-lt (zpos #15) (bv-signed #50 length')) then (Some (bv-signed #50 length')) else None)
