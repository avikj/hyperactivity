                                   if sib? then
                                     (bindS {ZI} {sib} (select_address_size proc_mode' (Some prefixes')) (λ t'11 →
                                        rme08 proc_mode' t'11 (bv-sext #48 #64 temp_rip) None (zpos #1) #14936))
                                   else
                                     (retS {sib} #0)
                             in bindS {sib} {Unit} sib''m (λ sib' →
                                  let temp_rip'm : MS (Bits #48)
                                      temp_rip'm =
                                        if sib? then
                                          (add_to_iptr proc_mode' temp_rip #1)
                                        else
                                          (retS {Bits #48} temp_rip)
                                  in bindS {Bits #48} {Unit} temp_rip'm (λ temp_rip →
                                       two_byte_opcode_execute proc_mode' start_rip temp_rip prefixes' mandatory_prefix rex_byte opcode modr_m' sib'))))))))
