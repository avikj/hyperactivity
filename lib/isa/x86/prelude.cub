        xl : Bits (z-nat low_num)
        xl = (bv-of-int (z-nat low_num) x' #0)
        xh : Bits (z-nat placesMod)
        xh = (bv-of-int (z-nat placesMod) x' (z-nat low_num))
    in retF {ZI} (bv-unsigned (wadd (z-nat low_num) (z-nat placesMod)) (bv-append (z-nat low_num) (z-nat placesMod) xl xh)))
-- (part of isa-x86)
rotate_right_bits : (w_n : Word) → (x' : Bits w_n) → (width : ZI) → (places : ZI) → Bits w_n
rotate_right_bits w_n x' width places =
  let low : Bits w_n
      low = (bv-shr w_n x' (z-nat places))
      high : Bits w_n
      high = (bv-shl w_n x' (z-nat (z-sub width places)))
  in (bv-or w_n high low)
-- (part of isa-x86)
rotate_right_int : (x' : ZI) → (width : ZI) → (places : ZI) → MF ZI
rotate_right_int x' width places =
  bindF {Unit} {ZI} (fl-assert {exception} (z-le (zpos #0) places) #149467514486126185021078021591788761910) (λ _ →
    let placesMod : ZI
        placesMod = (mod places width)
        xl : Bits (z-nat placesMod)
        xl = (bv-of-int (z-nat placesMod) x' #0)
        xh : Bits (z-nat (z-sub width placesMod))
        xh = (bv-of-int (z-nat (z-sub width placesMod)) x' (z-nat placesMod))
    in retF {ZI} (bv-unsigned (wadd (z-nat placesMod) (z-nat (z-sub width placesMod))) (bv-append (z-nat placesMod) (z-nat (z-sub width placesMod)) xl xh)))
-- (part of isa-x86)
merge_2_u64s : (a1' : Bits #64) → (a0' : Bits #64) → Bits #128
merge_2_u64s a1' a0' =
  (bv-append #64 #64 a1' a0')
-- (part of isa-x86)
merge_2_u32s : (a1' : Bits #32) → (a0' : Bits #32) → Bits #64
merge_2_u32s a1' a0' =
  (bv-append #32 #32 a1' a0')
-- (part of isa-x86)
merge_4_u32s : (a3' : Bits #32) → (a2' : Bits #32) → (a1' : Bits #32) → (a0' : Bits #32) → Bits #128
merge_4_u32s a3' a2' a1' a0' =
  (bv-append #32 #96 a3' (bv-append #32 #64 a2' (bv-append #32 #32 a1' a0')))
-- (part of isa-x86)
changeSlice_int : (x' : ZI) → (low : ZI) → (width : ZI) → (v' : ZI) → ZI
changeSlice_int x' low width v' =
  (z-set-slice (z-nat width) x' (z-nat low) (bv-of-int (z-nat width) v' #0))
-- (part of isa-x86)
changeSlice_bits : (w_n : Word) → (x' : Bits w_n) → (low : ZI) → (width : ZI) → (v' : Bits (z-nat width)) → Bits w_n
changeSlice_bits w_n x' low width v' =
  (bv-update w_n x' (z-nat (z-sub (z-add low width) (zpos #1))) (z-nat low) v')
-- (part of isa-x86)
genericBitstructAccessor : (w_n : Word) → (width : ZI) → (inputBits : Bits w_n) → (low : ZI) → Bits (z-nat width)
genericBitstructAccessor w_n width inputBits low =
  (bv-slice w_n inputBits (z-nat (z-sub (z-add low width) (zpos #1))) (z-nat low))
-- (part of isa-x86)
genericBitstructUpdater : (w_n : Word) → (width : ZI) → (spliceBits : Bits (z-nat width)) → (low : ZI) → (inputBits : Bits w_n) → Bits w_n
genericBitstructUpdater w_n width spliceBits low inputBits =
  (bv-update w_n inputBits (z-nat (z-sub (z-add low width) (zpos #1))) (z-nat low) spliceBits)
-- (part of isa-x86)
ms_ : MS Bool
ms_ =
  getS {Bool} x86-ms_reg
-- (part of isa-x86)
fault_ : MS Bool
fault_ =
  getS {Bool} x86-fault_reg
