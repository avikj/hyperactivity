-- write_canonical_address_to_memory: from linear_memory.sail (it calls what is defined after it there)
write_canonical_address_to_memory : (lin_addr : Bits #48) → (canonical_address : Bits #48) → MS Unit
write_canonical_address_to_memory lin_addr canonical_address =
  let seven__plus_lin_addr : Bits #50
      seven__plus_lin_addr = (bits_of_int (z-add (zpos #7) (bv-signed #48 lin_addr)) (zpos #50))
  in onS {Bool} {Unit} (canonical_address_p (bv-signed #50 seven__plus_lin_addr)) (λ t'1 →
       if t'1 then
         (bindS {Bool} {Unit} (getS {Bool} x86-app_view) (λ app_view'2 →
            if app_view'2 then
              (wb #48 (zpos #8) lin_addr #14935 (loghead_bits #48 (zpos #64) canonical_address))
            else
              (let canonical_address_unsigned_val : Bits #64
                   canonical_address_unsigned_val = (loghead_bits #48 (zpos #64) canonical_address)
               in wml64 lin_addr canonical_address_unsigned_val)))
       else
         (liftS {Unit} (x86_model_error {Unit} #3893082825329448266142030917680592375096772677027779301794281916473054010626051375143853387634)))
-- ea_to_la: from segmentation.sail (it calls what is defined after it there)
ea_to_la : (proc_mode' : proc_mode) → (eff_addr : Bits #64) → (seg_reg : ZI) → (nbytes : ZI) → MS (Bits #64)
ea_to_la proc_mode' eff_addr seg_reg nbytes =
  if (in_64bit_mode proc_mode') then
    (let lin_addr'm : MS (Bits #64)
         lin_addr'm =
           if (b-or (z-eq seg_reg (zpos #4)) (z-eq seg_reg (zpos #5))) then
             (bindS {((Bits #64) × ZI × (Bits #32))} {Bits #64} (segment_base_and_bounds Mode_64bit seg_reg) (λ t'1 →
                let base' : Bits #64
                    base' = (fst t'1)
                    lin_addr : Bits #64
                    lin_addr = (bits_of_int (z-add (bv-unsigned #64 base') (bv-unsigned #64 eff_addr)) (zpos #64))
                in retS {Bits #64} lin_addr))
           else
             (retS {Bits #64} eff_addr)
     in bindS {Bits #64} {Bits #64} lin_addr'm (λ lin_addr →
          onS {Bool} {Bits #64} (canonical_address_p (bv-signed #64 lin_addr)) (λ t'3 →
            let t'5'm : MF Unit
                t'5'm =
                  if (b-not t'3) then
                    (x86_model_error {Unit} #21814826192473016117759527061750727496662368899126099)
                  else
                    (retF {Unit} unit)
            in onS {Unit} {Bits #64} t'5'm (λ t'5 →
                 retS {Bits #64} lin_addr))))
  else if (in_compatibility_mode proc_mode') then
    (let t'8'm : MS Bool
         t'8'm =
           if (b-not (z-eq seg_reg (zpos #1))) then
             (if (b-not (z-eq seg_reg (zpos #2))) then
                (bindS {List (Bits #16)} {Bool} (getS {List (Bits #16)} x86-seg_visibles) (λ seg_visibles'6 →
                   retS {Bool} (z-lt (bv-unsigned #16 (vec-get {Bits #16} #0 seg_visibles'6 (z-nat seg_reg))) (zpos #4))))
              else
                (retS {Bool} false))
           else
             (retS {Bool} false)
     in bindS {Bool} {Bits #64} t'8'm (λ t'8 →
          let t'10'm : MF Unit
              t'10'm =
                if t'8 then
                  (x86_model_error {Unit} #21814860404509169194758645849519540950299536998551378)
                else
                  (retF {Unit} unit)
          in onS {Unit} {Bits #64} t'10'm (λ t'10 →
               bindS {((Bits #64) × ZI × (Bits #32))} {Bits #64} (segment_base_and_bounds proc_mode' seg_reg) (λ t'11 →
                 let base' : Bits #64
                     base' = (fst t'11)
                     lower_bound : ZI
                     lower_bound = (fst (snd t'11))
                     upper_bound : Bits #32
                     upper_bound = (snd (snd t'11))
                     base' : Bits #32
                     base' = (bv-trunc #64 #32 base')
                     lower_bound : Bits #33
                     lower_bound = (bits_of_int lower_bound (zpos #33))
                     first_addr : Bits #64
                     first_addr = eff_addr
                     last_addr : ZI
                     last_addr = (z-add (bv-signed #64 eff_addr) (z-add nbytes (zneg #1)))
                 in let t'13'm : MF Unit
                        t'13'm =
                          if (b-not (b-and (z-le (bv-unsigned #33 lower_bound) (bv-signed #64 first_addr)) (z-le last_addr (bv-unsigned #32 upper_bound)))) then
                            (x86_model_error {Unit} #1300697115506830038381759936674696651557914956)
                          else
                            (retF {Unit} unit)
                    in onS {Unit} {Bits #64} t'13'm (λ t'13 →
                         let lin_addr : Bits #32
                             lin_addr = (bits_of_int (z-add (bv-unsigned #32 base') (bv-unsigned #32 (bv-trunc #64 #32 eff_addr))) (zpos #32))
                         in retS {Bits #64} (bv-zext #32 #64 lin_addr))))))
  else
    (liftS {Bits #64} (x86_model_error {Bits #64} #1430326534880091636827201117228958513375655924002173436997))
rvm08 : (addr : Bits #48) → MS (Bits #8)
rvm08 addr =
  onS {Bool} {Bits #8} (canonical_address_p (bv-signed #48 addr)) (λ t'1 →
    if t'1 then
      (memi #64 (bv-zext #48 #64 addr))
    else
      (liftS {Bits #8} (x86_model_error {Bits #8} #491613139000)))
wvm08 : (addr : Bits #48) → (sailval : Bits #8) → MS Unit
wvm08 addr sailval =
  onS {Bool} {Unit} (canonical_address_p (bv-signed #48 addr)) (λ t'1 →
    if t'1 then
      (bang_memi #64 (bv-zext #48 #64 addr) sailval)
    else
      (liftS {Unit} (x86_model_error {Unit} #513087975480)))
