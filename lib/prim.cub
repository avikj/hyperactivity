-- prim.cub — primitive types and operations (plan B12): the machine's fixed-width numbers and byte
-- strings, as constants of the type theory. Each is a `primitive`: its type is checked, its
-- computation is the machine's (trusted), and `#trusted` lists it. Loaded after lib/std.cub.
--
-- A primitive value prints as #i64:n, #u32:n, #f64:x, #bytes:n:..., and is made only by these
-- operations (there are no literals): i64 #5 is the Int64 5.

-- ---------------------------------------------------------------- the types
primitive Int64 : Type = %pty #0
primitive UInt32 : Type = %pty #1
primitive Float64 : Type = %pty #2
primitive Float32 : Type = %pty #3
primitive Bytes : Nat → Type = λ n → %bytesty n
-- a handle to a C object a native library made (B18: a `void *` result of an entry entered by
-- #native … from): passed to that library's entries, read by nothing else, finalized by the
-- library's cubical_release when its last copy is erased
primitive Native : Type = %pty #5

-- ---------------------------------------------------------------- integers, modular (two's complement)
primitive i64 : Word → Int64 = λ w → %i64ofw w
primitive i64toWord : Int64 → Word = λ a → %wofi64 a
primitive i64add : Int64 → Int64 → Int64 = λ a b → %i64add a b
primitive i64sub : Int64 → Int64 → Int64 = λ a b → %i64sub a b
primitive i64mul : Int64 → Int64 → Int64 = λ a b → %i64mul a b
primitive i64eq : Int64 → Int64 → Bool = λ a b → %i64eq a b
primitive i64lt : Int64 → Int64 → Bool = λ a b → %i64lt a b
primitive u32 : Word → UInt32 = λ w → %u32ofw w
primitive u32toWord : UInt32 → Word = λ a → %wofu32 a
primitive u32add : UInt32 → UInt32 → UInt32 = λ a b → %u32add a b
primitive u32sub : UInt32 → UInt32 → UInt32 = λ a b → %u32sub a b
primitive u32mul : UInt32 → UInt32 → UInt32 = λ a b → %u32mul a b
primitive u32eq : UInt32 → UInt32 → Bool = λ a b → %u32eq a b
primitive u32lt : UInt32 → UInt32 → Bool = λ a b → %u32lt a b

-- ---------------------------------------------------------------- floating point (IEEE 754 binary64; no
-- specification in the language yet: wholly trusted, listed by #trusted)
primitive f64 : Word → Float64 = λ w → %f64ofw w
primitive f64ofi64 : Int64 → Float64 = λ a → %f64ofi64 a
primitive i64off64 : Float64 → Int64 = λ a → %i64off64 a
primitive f64add : Float64 → Float64 → Float64 = λ a b → %f64add a b
primitive f64sub : Float64 → Float64 → Float64 = λ a b → %f64sub a b
primitive f64mul : Float64 → Float64 → Float64 = λ a b → %f64mul a b
primitive f64div : Float64 → Float64 → Float64 = λ a b → %f64div a b
primitive f64eq : Float64 → Float64 → Bool = λ a b → %f64eq a b
primitive f64lt : Float64 → Float64 → Bool = λ a b → %f64lt a b

-- ---------------------------------------------------------------- the byte layer: a string of n bytes,
-- loads and stores at an offset with the proof that they fit (le (plus off w) n, from lib/std.cub);
-- a store is a copy with the value written
primitive bytes : (n : Nat) → Bytes n = λ n → %bytes n
primitive load32 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 4) n → UInt32 = λ n b off pf → %load32 b off
primitive store32 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 4) n → UInt32 → Bytes n = λ n b off pf v → %store32 b off v
primitive load64 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 8) n → Int64 = λ n b off pf → %load64 b off
primitive store64 : (n : Nat) → (b : Bytes n) → (off : Nat) → le (plus off 8) n → Int64 → Bytes n = λ n b off pf v → %store64 b off v

primitive blen : (n : Nat) → Bytes n → Nat = λ n b → n

-- ---------------------------------------------------------------- memory the program does not own (plan C20):
-- the address of a byte string (the string is then pinned, so the address stays valid), and the
-- bytes at an address (copied in). Trusted: the program vouches for the address; #safe f lists
-- them when f reaches them
primitive ptr-of : (n : Nat) → Bytes n → Word = λ n b → %ptr-of b
primitive region-at : Word → (n : Nat) → Bytes n = λ a n → %region-at n a


-- ---------------------------------------------------------------- the byte layer's laws, trusted: a load after a
-- store at the same offset is the value stored. A primitive operation on a variable is a neutral
-- (%view: wprim), so the laws of what is built over the byte layer follow by unfolding
primitive load32-store32 : (n : Nat) → (b : Bytes n) → (off : Nat) → (h : le (plus off 4) n) → (v : UInt32) → PathP (λ (i : I) → UInt32) (load32 n (store32 n b off h v) off h) v = λ n b off h v i → v
primitive load64-store64 : (n : Nat) → (b : Bytes n) → (off : Nat) → (h : le (plus off 8) n) → (v : Int64) → PathP (λ (i : I) → Int64) (load64 n (store64 n b off h v) off h) v = λ n b off h v i → v

-- ---------------------------------------------------------------- arrays of Int64 over the byte layer (plan C22):
-- Array n is Bytes (times n 8); an index with its proof of fitting (le (suc i) n) is a load or
-- store at offset times i 8 with the proof that the access fits, by arithmetic; tabulate n f
-- writes f at every index; index-update, the law of arrays, is the byte layer's law unfolded
Array : Nat → Type
Array n = Bytes (times n 8)
anew : (n : Nat) → Array n
anew n = bytes (times n 8)
-- times (suc i) 8 = plus 8 (times i 8) by the definition of times, so an index below n fits
fits-eq : (k i : Nat) → plus (times k 8) (plus (times i 8) 8) ≡ times (plus k (suc i)) 8
fits-eq k i =
  calc plus (times k 8) (plus (times i 8) 8) ≡ plus (times k 8) (times (suc i) 8) by (λ j → plus (times k 8) (plus-comm (times i 8) 8 j))
                                             ≡ times (plus k (suc i)) 8 by sym (times-distr k (suc i) 8)
index-fits : (n i : Nat) → le (suc i) n → le (plus (times i 8) 8) (times n 8)
index-fits n i h = (times (fst h) 8 , concat (fits-eq (fst h) i) (cong (λ m → times m 8) (snd h)))
index : (n : Nat) → Array n → (i : Nat) → le (suc i) n → Int64
index n a i h = load64 (times n 8) a (times i 8) (index-fits n i h)
update : (n : Nat) → Array n → (i : Nat) → le (suc i) n → Int64 → Array n
update n a i h v = store64 (times n 8) a (times i 8) (index-fits n i h) v
-- below n: zero is, and the predecessor of what is
le-pred : (m n : Nat) → le (suc m) n → le m n
le-pred m n h = (suc (fst h) , concat (sym (plus-suc (fst h) m)) (snd h))
le-zero : (n : Nat) → le zero n
le-zero n = (n , plus-zero n)
-- the array of f at every index: a loop from the last index down
tab-go : (n : Nat) → (Nat → Int64) → (m : Nat) → le m n → Array n → Array n
tab-go n f zero h a = a
tab-go n f (suc m) h a = tab-go n f m (le-pred m n h) (update n a m h (f m))
tabulate : (n : Nat) → (Nat → Int64) → Array n
tabulate n f = tab-go n f n (le-refl n) (anew n)
index-update : (n : Nat) → (a : Array n) → (i : Nat) → (h : le (suc i) n) → (v : Int64) → index n (update n a i h v) i h ≡ v
index-update n a i h v = load64-store64 (times n 8) a (times i 8) (index-fits n i h) v

-- ---------------------------------------------------------------- the laws of arrays (plan C22): two more
-- trusted laws of the byte layer (a load elsewhere than a store is the old value, when the two
-- 8-byte spans are disjoint; two arrays equal at every index are equal), then the arithmetic
-- (le is a proposition; below suc m is below m or equal; trichotomy), then Fin n, tabulate over
-- Fin n (atab) and index over Fin n (aindex) with the laws index-tabulate, tabulate-index, and
-- index-update-eq/ne/if; so Fin n → Int64 ≃ Array n (Fin→Array), the representation of
-- functions out of Fin n by arrays, stated as an equivalence (represent takes a data type on
-- the left). Then two dimensions, row-major (mdspan's layout_right)
-- the byte layer's second law, trusted: a load at an offset disjoint from a store reads what was
-- there (the stored 8 bytes end before the load begins, or the loaded ones before the store)
primitive load64-store64-disj : (n : Nat) → (b : Bytes n) → (o1 o2 : Nat) → (h1 : le (plus o1 8) n) → (h2 : le (plus o2 8) n) → (v : Int64) → Sum (le (plus o1 8) o2) (le (plus o2 8) o1) → PathP (λ (i : I) → Int64) (load64 n (store64 n b o1 h1 v) o2 h2) (load64 n b o2 h2) = λ n b o1 o2 h1 h2 v d i → %load64 b o2
-- arrays are determined by their elements, trusted: two arrays equal at every index are equal
primitive array-ext : (n : Nat) → (a b : Array n) → ((i : Nat) → (h : le (suc i) n) → PathP (λ (j : I) → Int64) (index n a i h) (index n b i h)) → PathP (λ (i : I) → Array n) a b = λ n a b f i → a
-- ---------------------------------------------------------------- arithmetic on the order
-- le is a proposition: its witness is determined (addition cancels) and Nat is a set
isSetNat : isSet Nat
isSetNat = Discrete→isSet {Nat} discreteNat
le-prop : (m n : Nat) → isProp (le m n)
le-prop m n u v =
  let p = plus-cancel {m} {fst u} {fst v} (concat (plus-comm m (fst u)) (concat (snd u) (concat (sym (snd v)) (plus-comm (fst v) m))))
  in λ i → (p i , isProp→PathP {lzero} {plus (fst u) m ≡ n} {plus (fst v) m ≡ n} (λ j → plus (p j) m ≡ n) (isSetNat (plus (fst v) m) n) (snd u) (snd v) i)
-- below suc m: below m, or m itself
le-split : (i m : Nat) → le (suc i) (suc m) → Sum (le (suc i) m) (i ≡ m)
le-split i m h = case fst h return (λ k → plus k (suc i) ≡ suc m → Sum (le (suc i) m) (i ≡ m)) of
    zero → λ e → inr (suc-inj e)
    suc k → λ e → inl (k , suc-inj e)
  (snd h)
-- three cases for two numbers
trich : (i j : Nat) → Sum (le (suc i) j) (Sum (i ≡ j) (le (suc j) i))
trich zero zero = inr (inl (λ t → zero))
trich zero (suc k) = inl (k , concat (plus-suc k zero) (cong suc (plus-zero k)))
trich (suc a) zero = inr (inr (a , concat (plus-suc a zero) (cong suc (plus-zero a))))
trich (suc a) (suc k) =
  case trich a k of
    inl l → inl (fst l , concat (plus-suc (fst l) (suc a)) (cong suc (snd l)))
    inr m → (case m of
               inl e → inr (inl (cong suc e))
               inr l → inr (inr (fst l , concat (plus-suc (fst l) (suc k)) (cong suc (snd l)))))

Fin : Nat → Type
Fin n = (i : Nat) × le (suc i) n
aindex : (n : Nat) → Array n → Fin n → Int64
aindex n a p = index n a (fst p) (snd p)
tabF-go : (n : Nat) → (Fin n → Int64) → (m : Nat) → le m n → Array n → Array n
tabF-go n f zero h a = a
tabF-go n f (suc m) h a = tabF-go n f m (le-pred m n h) (update n a m h (f (m , h)))
atab : (n : Nat) → (Fin n → Int64) → Array n
atab n f = tabF-go n f n (le-refl n) (anew n)
le-suc-zero : (j : Nat) → le (suc j) zero → Empty
le-suc-zero j h = case fst h return (λ k → plus k (suc j) ≡ zero → Empty) of
    zero → λ e → snotz {j} e
    suc k → λ e → snotz {plus k (suc j)} e
  (snd h)
fin-eq : (n j m : Nat) → (hj : le (suc j) n) → (h : le (suc m) n) → j ≡ m → Path (Fin n) (j , hj) (m , h)
fin-eq n j m hj h e = λ i → (e i , isProp→PathP {lzero} {le (suc j) n} {le (suc m) n} (λ k → le (suc (e k)) n) (le-prop (suc m) n) hj h i)
index-update-ne : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → Sum (le (suc i) j) (le (suc j) i) → index n (update n a i hi v) j hj ≡ index n a j hj
index-update-ne n a i j hi hj v d = load64-store64-disj (times n 8) a (times i 8) (times j 8) (index-fits n i hi) (index-fits n j hj) v (case d of inl l → inl (index-fits j i l); inr l → inr (index-fits i j l))
go-above : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array n) → le m j → index n (tabF-go n f m h a) j hj ≡ index n a j hj
go-above n f zero j h hj a l = λ i → index n a j hj
go-above n f (suc m) j h hj a l = concat (go-above n f m j (le-pred m n h) hj (update n a m h (f (m , h))) (le-pred m j l)) (index-update-ne n a m j h hj (f (m , h)) (inl l))
go-below-last : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le (suc m) n) → (hj : le (suc j) n) → (a : Array n) → j ≡ m → index n (update n a m h (f (m , h))) j hj ≡ f (j , hj)
go-below-last n f m j h hj a e =
  let q = fin-eq n j m hj h e
  in concat (cong {lzero} {lzero} {Fin n} {Int64} (λ p → index n (update n a m h (f (m , h))) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)
            (concat (index-update n a m h (f (m , h))) (cong {lzero} {lzero} {Fin n} {Int64} f {(m , h)} {(j , hj)} (sym {lzero} {Fin n} {the (Fin n) (j , hj)} {the (Fin n) (m , h)} q)))
go-below : (n : Nat) → (f : Fin n → Int64) → (m j : Nat) → (h : le m n) → (hj : le (suc j) n) → (a : Array n) → le (suc j) m → index n (tabF-go n f m h a) j hj ≡ f (j , hj)
go-below n f zero j h hj a l = Empty-rec (le-suc-zero j l)
go-below n f (suc m) j h hj a l =
  case le-split j m l of
    inl l2 → go-below n f m j (le-pred m n h) hj (update n a m h (f (m , h))) l2
    inr e → concat (go-above n f m j (le-pred m n h) hj (update n a m h (f (m , h))) (subst {lzero} {lzero} {Nat} {λ x → le m x} {m} {j} (sym {lzero} {Nat} {j} {m} e) (le-refl m)))
                   (go-below-last n f m j h hj a e)
index-tabulate : (n : Nat) → (f : Fin n → Int64) → (p : Fin n) → aindex n (atab n f) p ≡ f p
index-tabulate n f p = go-below n f n (fst p) (le-refl n) (snd p) (anew n) (snd p)
tabulate-index : (n : Nat) → (a : Array n) → atab n (aindex n a) ≡ a
tabulate-index n a = array-ext n (atab n (aindex n a)) a (λ i h → index-tabulate n (aindex n a) (i , h))
index-update-eq : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → i ≡ j → index n (update n a i hi v) j hj ≡ v
index-update-eq n a i j hi hj v e =
  concat (cong {lzero} {lzero} {Fin n} {Int64} (λ p → index n (update n a i hi v) (fst p) (snd p)) {the (Fin n) (j , hj)} {the (Fin n) (i , hi)} (fin-eq n j i hj hi (sym {lzero} {Nat} {i} {j} e)))
         (index-update n a i hi v)
-- the three laws as one: a read after a write is the value at the written index, the old value elsewhere
index-update-if : (n : Nat) → (a : Array n) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) n) → (v : Int64) → index n (update n a i hi v) j hj ≡ (if eqb i j then v else index n a j hj)
index-update-if n a i j hi hj v =
  ifP {λ b → index n (update n a i hi v) j hj ≡ (if b then v else index n a j hj)} {eqb i j}
    (λ e → index-update-eq n a i j hi hj v (eqb-sound {i} {j} (eq→isTrue {eqb i j} e)))
    (λ e → index-update-ne n a i j hi hj v
             (case trich i j of
                inl l → inl l
                inr m → (case m of
                           inl q → Empty-rec (subst {lzero} {lzero} {Bool} {isTrue} {eqb i j} {false} e (eqb-complete {i} {j} q))
                           inr l → inr l)))
-- arrays as functions out of Fin n: the equivalence the representation states (represent takes a data
-- type on the left, so a function type's representation is stated as a library equivalence)
Fin→Array : (n : Nat) → Equiv (Fin n → Int64) (Array n)
Fin→Array n = isoToEquiv {lzero} {Fin n → Int64} {Array n} (atab n) (aindex n) (tabulate-index n) (λ f → funExt {lzero} {lzero} {Fin n} {Int64} {aindex n (atab n f)} {f} (index-tabulate n f))
-- the interface carried across the equivalence (item 22): a program written against Fin n → Int64
-- uses application and the functional update fin-set; under atab they are index and update, so a
-- program on functions is the program on arrays (the paths below are the representation's `by`
-- laws), and the array program's update stores in place when the buffer is unique (C21, lib/fo.cub)
fin-set : (n : Nat) → (Fin n → Int64) → Fin n → Int64 → Fin n → Int64
fin-set n f p v = λ q → if eqb (fst p) (fst q) then v else f q
-- application is index
apply-by : (n : Nat) → (f : Fin n → Int64) → (p : Fin n) → aindex n (atab n f) p ≡ f p
apply-by n f p = index-tabulate n f p
-- the functional update is update
fin-set-by : (n : Nat) → (f : Fin n → Int64) → (i : Nat) → (h : le (suc i) n) → (v : Int64) →
  atab n (fin-set n f (i , h) v) ≡ update n (atab n f) i h v
fin-set-by n f i h v = array-ext n (atab n (fin-set n f (i , h) v)) (update n (atab n f) i h v)
  (λ j hj → concat {lzero} {Int64} {index n (atab n (fin-set n f (i , h) v)) j hj} {if eqb i j then v else f (j , hj)} {index n (update n (atab n f) i h v) j hj}
     (index-tabulate n (fin-set n f (i , h) v) (j , hj))
     (sym {lzero} {Int64} {index n (update n (atab n f) i h v) j hj} {if eqb i j then v else f (j , hj)}
        (concat {lzero} {Int64} {index n (update n (atab n f) i h v) j hj} {if eqb i j then v else index n (atab n f) j hj} {if eqb i j then v else f (j , hj)}
           (index-update-if n (atab n f) i j h hj v)
           (λ k → if eqb i j then v else index-tabulate n f (j , hj) k))))
-- tabulate is the identity on functions
tabulate-by : (n : Nat) → (a : Array n) → atab n (aindex n a) ≡ a
tabulate-by n a = tabulate-index n a
-- two dimensions, row-major (mdspan's layout_right): row i column j at i*m + j
Array2 : Nat → Nat → Type
Array2 n m = Array (times n m)
idx2-fits : (n m i j : Nat) → le (suc i) n → le (suc j) m → le (suc (plus (times i m) j)) (times n m)
idx2-fits n m i j hi hj =
  let K = fst hi
      J = fst hj
      im = times i m
      inner : plus J (suc (plus im j)) ≡ plus im m
      inner = concat (plus-suc J (plus im j))
              (concat (cong suc (plus-comm-mid J im j))
              (concat (sym (plus-suc im (plus J j)))
              (concat (cong (plus im) (sym (plus-suc J j))) (cong (plus im) (snd hj)))))
      outer : plus (times K m) (plus im m) ≡ times n m
      outer = concat (sym (plus-assoc (times K m) im m))
              (concat (cong (λ x → plus x m) (sym (times-distr K i m)))
              (concat (plus-comm (times (plus K i) m) m)
              (concat (cong (λ x → times x m) (sym (plus-suc K i))) (cong (λ x → times x m) (snd hi)))))
  in (plus (times K m) J , concat (plus-assoc (times K m) J (suc (plus im j))) (concat (cong (plus (times K m)) inner) outer))
index2 : (n m : Nat) → Array2 n m → (i j : Nat) → le (suc i) n → le (suc j) m → Int64
index2 n m a i j hi hj = index (times n m) a (plus (times i m) j) (idx2-fits n m i j hi hj)
update2 : (n m : Nat) → Array2 n m → (i j : Nat) → le (suc i) n → le (suc j) m → Int64 → Array2 n m
update2 n m a i j hi hj v = update (times n m) a (plus (times i m) j) (idx2-fits n m i j hi hj) v
index2-update2 : (n m : Nat) → (a : Array2 n m) → (i j : Nat) → (hi : le (suc i) n) → (hj : le (suc j) m) → (v : Int64) → index2 n m (update2 n m a i j hi hj v) i j hi hj ≡ v
index2-update2 n m a i j hi hj v = index-update (times n m) a (plus (times i m) j) (idx2-fits n m i j hi hj) v

-- Layouts (data Layout, lib/code.cub) are computed by the checker: #layout T, or #layout T as R.

-- ---------------------------------------------------------------- Nat by Word: the numerals' mechanism as a
-- representation (plan B12 2.2): addition on words is addition on numbers across the equivalence
toNat-plusw : (a b : Nat) → toNat (plusw (fromNat a) (fromNat b)) ≡ plus a b
toNat-plusw a b = case b return (λ y → toNat (plusw (fromNat a) (fromNat y)) ≡ plus a y) of
    zero → concat (toNat-fromNat a) (sym (plus-zero a))
    suc k → concat (λ i → suc (rec k i)) (sym (plus-suc a k))
represent Nat by Word where
  to : Nat → Word = fromNat
  from : Word → Nat = toNat
  to-from : (w : Word) → to (from w) ≡ w = fromNat-toNat
  from-to : (n : Nat) → from (to n) ≡ n = toNat-fromNat
  op plus : Word → Word → Word = plusw by (a b : Nat) → from (plusw (to a) (to b)) ≡ plus a b = toNat-plusw
