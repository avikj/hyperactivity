-- lib/reimport.cub — the C++ image read back as codes (plan 10.1, 18.9: the fragment's semantics
-- is a parser into our own codes, and the check of the image is #same of the re-imported code
-- against the source up to erasure). Loaded after lib/image.cub. The parser accepts exactly the
-- fragment lib/image.cub emits — not C++ — and a consumer's code written in that fragment
-- imports the same way (plan 9).
--
-- reimport-def names bs: the code of one definition `[template<…>] T name(params) { return e; }`:
-- its parameters become λs (type parameters too: the source abstracts them), erased parameters
-- are not there (that is the "up to erasure"), the body's forms the codes they came from:
-- (a + b) → cwop, UINT64_C(n) → cwlit, std::pair{a, b} → cpair, (p).first → cfst, [&](auto v) →
-- clam, [&]() { auto v = t; return b; }() → clet, (c ? a : b) → ccase on Bool, cub::welim →
-- cwelim, D{D_c{…}} → ccon, cub::fix(…)(x) with std::visit → celim, self(*k.fj) → cforce of
-- the hypothesis, g<T>(a) → capp of cglob, static_cast and cub::load… → cprim.
-- reimport-header names bs: every definition of a header (the preamble, the data declarations
-- and the namespace cub skipped), as a Lst of (name bytes , code).

-- ---------------------------------------------------------------- tokens
-- a token is (kind , text): 0 an identifier (letters, digits, _, with :: joined), 1 a number
-- (text the word), 2 punctuation (one character, or ->, ==)
is-alpha c = orb (andb (%wlt #64 c) (%wlt c #91)) (orb (andb (%wlt #96 c) (%wlt c #123)) (%weq c #95))
is-digit c = andb (%wlt #47 c) (%wlt c #58)
is-space c = orb (%weq c #32) (orb (%weq c #10) (orb (%weq c #9) (%weq c #13)))
tokens bs =
  case bs of
    lnil → lnil
    lcons c r →
      if is-space c then tokens r
      else if %weq c #35 then tokens (skip-line r)
      else if is-alpha c then (let w = ident-span bs lnil in lcons (#0 , fst w) (tokens (snd w)))
      else if is-digit c then (let w = num-span bs #0 in lcons (#1 , fst w) (tokens (snd w)))
      else if andb (%weq c #45) (starts r #62) then lcons (#2 , (lcons #45 (lcons #62 lnil))) (tokens (ltail-r r))
      else if andb (%weq c #61) (starts r #61) then lcons (#2 , (lcons #61 (lcons #61 lnil))) (tokens (ltail-r r))
      else if andb (%weq c #58) (starts r #58) then (let w = ident-span (ltail-r r) (lcons #58 (lcons #58 lnil)) in lcons (#0 , fst w) (tokens (snd w)))
      else lcons (#2 , lcons c lnil) (tokens r)
skip-line bs = case bs of lnil → lnil; lcons c r → if %weq c #10 then r else skip-line r
starts bs c = case bs of lcons d r → %weq d c; lnil → false
ltail-r bs = case bs of lnil → lnil; lcons c r → r
-- an identifier: letters, digits, _, and :: between parts (std::pair, cub::welim)
ident-span bs acc =
  case bs of
    lnil → (acc , lnil)
    lcons c r →
      if orb (is-alpha c) (is-digit c) then ident-span r (lapp acc (lcons c lnil))
      else if andb (%weq c #58) (starts r #58) then ident-span (ltail-r r) (lapp acc (lcons #58 (lcons #58 lnil)))
      else (acc , bs)
num-span bs n = case bs of lnil → (n , lnil); lcons c r → if is-digit c then num-span r (%wadd (wmul10 n) (%wsub c #48)) else (n , bs)
wmul10 n = let n2 = %wadd n n in let n4 = %wadd n2 n2 in let n8 = %wadd n4 n4 in %wadd n8 n2
-- ---------------------------------------------------------------- the parser
-- a parse is some (value , rest) or none; p-tok ts kind text: the token expected
tok-kind t = fst t
tok-text t = snd t
is-tok ts k txt = case ts of lcons t r → andb (%weq (tok-kind t) k) (lst-eq (tok-text t) txt); lnil → false
p-tok ts k txt = if is-tok ts k txt then some (ltail-r ts) else none
p-punct ts txt = p-tok ts #2 txt
p-ident ts = case ts of lcons t r → (if %weq (tok-kind t) #0 then some (tok-text t , r) else none); lnil → none
p-num ts = case ts of lcons t r → (if %weq (tok-kind t) #1 then some (tok-text t , r) else none); lnil → none
-- the environment of binders, innermost first: (text , code-or-kind): a variable binds its name to
-- its index; a type parameter likewise; a field of a case its member text; a hypothesis "h.fj"
env-index env nm i = case env of lnil → none; lcons e r → if lst-eq (fst e) nm then some i else env-index r nm (%wsucc i)
-- the data types by name: D<d> → d (the names are positional), constructors D<d>_c<c>
dname-of nm = case nm of lcons c r → (if %weq c #68 then num-of r else none); lnil → none
num-of ds = num-of-at ds #0
num-of-at ds n = case ds of lnil → some n; lcons c r → if is-digit c then num-of-at r (%wadd (wmul10 n) (%wsub c #48)) else none
-- D<d>_c<c> → (d , c)
cname-of nm = case nm of lcons c r → (if %weq c #68 then (let dn = split-at-c r #0 in (case dn of some p → some p; none → none)) else none); lnil → none
split-at-c ds n = case ds of lnil → none; lcons c r → if is-digit c then split-at-c r (%wadd (wmul10 n) (%wsub c #48)) else if %weq c #95 then (case r of lcons c2 r2 → (if %weq c2 #99 then omap (λ k → (n , k)) (num-of r2) else none); lnil → none) else none
gname-of names nm = case names of lnil → (case nm of lcons c r → (if %weq c #103 then num-of r else none); lnil → none); lcons e r → if lst-eq (snd e) nm then some (fst e) else gname-of r nm
-- ---- types
p-type env ts =
  case p-ident ts of
    none → none
    some nr →
      let nm = fst nr
          r = snd nr
      in if lst-eq nm (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 lnil)))))))) then some (cword , r)
         else if lst-eq nm (lcons #105 (lcons #110 (lcons #116 (lcons #54 (lcons #52 (lcons #95 (lcons #116 lnil))))))) then some (cpty #0 (cwlit #0) , r)
         else if lst-eq nm (lcons #117 (lcons #105 (lcons #110 (lcons #116 (lcons #51 (lcons #50 (lcons #95 (lcons #116 lnil)))))))) then some (cpty #1 (cwlit #0) , r)
         else if lst-eq nm (lcons #100 (lcons #111 (lcons #117 (lcons #98 (lcons #108 (lcons #101 lnil)))))) then some (cpty #2 (cwlit #0) , r)
         else if lst-eq nm (lcons #98 (lcons #111 (lcons #111 (lcons #108 lnil)))) then some (cdata bool-idx lnil , r)
         else if lst-eq nm (lcons #97 (lcons #117 (lcons #116 (lcons #111 lnil)))) then some (cpi #2 (cvar #0) (cvar #0) , r)
         else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #98 (lcons #121 (lcons #116 (lcons #101 (lcons #115 lnil)))))))))) then obind (p-punct r (lcons #60 lnil)) (λ r2 → obind (p-num r2) (λ nr2 → omap (λ r3 → (cpty #4 (cwlit (fst nr2)) , r3)) (p-punct (snd nr2) (lcons #62 lnil))))
         else if lst-eq nm (lcons #115 (lcons #116 (lcons #100 (lcons #58 (lcons #58 (lcons #112 (lcons #97 (lcons #105 (lcons #114 lnil))))))))) then obind (p-punct r (lcons #60 lnil)) (λ r2 → obind (p-type env r2) (λ ar → obind (p-punct (snd ar) (lcons #44 lnil)) (λ r3 → obind (p-type env r3) (λ br → omap (λ r4 → (csigma (fst ar) (fst br) , r4)) (p-punct (snd br) (lcons #62 lnil))))))
         else (case dname-of nm of
                 some d → some (cdata d lnil , r)
                 none → (case env-index env nm #0 of some i → some (cvar i , r); none → none))
-- ---- expressions
p-expr names env ts = obind (p-primary names env ts) (λ er → p-postfix names env (fst er) (snd er))
-- postfix: calls one argument list at a time (each a capp chain), .first, .second
p-postfix names env e ts =
  if is-tok ts #2 (lcons #40 lnil) then
    (case p-args names env (ltail-r ts) of
       some ar → p-postfix names env (app-all-c e (fst ar)) (snd ar)
       none → none)
  else if is-tok ts #2 (lcons #46 lnil) then
    (case p-ident (ltail-r ts) of
       some nr → if lst-eq (fst nr) (lcons #102 (lcons #105 (lcons #114 (lcons #115 (lcons #116 lnil))))) then p-postfix names env (cfst e) (snd nr) else if lst-eq (fst nr) (lcons #115 (lcons #101 (lcons #99 (lcons #111 (lcons #110 (lcons #100 lnil)))))) then p-postfix names env (csnd e) (snd nr) else none
       none → none)
  else some (e , ts)
app-all-c f as = case as of lnil → f; lcons a r → app-all-c (capp f a) r
-- "(" already consumed: a possibly empty list of expressions to ")"
p-args names env ts =
  if is-tok ts #2 (lcons #41 lnil) then some (lnil , ltail-r ts)
  else obind (p-expr names env ts) (λ er → p-args-rest names env (lcons (fst er) lnil) (snd er))
p-args-rest names env acc ts =
  if is-tok ts #2 (lcons #41 lnil) then some (acc , ltail-r ts)
  else obind (p-punct ts (lcons #44 lnil)) (λ r → obind (p-expr names env r) (λ er → p-args-rest names env (lapp acc (lcons (fst er) lnil)) (snd er)))
-- a parenthesized form: (e), (a op b), (a + 1) as cwsucc, (c ? a : b), (p).first by postfix
p-paren names env ts =
  obind (p-expr names env ts) (λ ar →
    let a = fst ar
        r = snd ar
    in if is-tok r #2 (lcons #41 lnil) then some (a , ltail-r r)
       else if is-tok r #2 (lcons #63 lnil) then obind (p-expr names env (ltail-r r)) (λ tr → obind (p-punct (snd tr) (lcons #58 lnil)) (λ r2 → obind (p-expr names env r2) (λ fr → omap (λ r3 → (ccase bool-idx (lcons (fst tr) (lcons (fst fr) lnil)) a , r3)) (p-punct (snd fr) (lcons #41 lnil)))))
       else (case r of
               lcons t r2 →
                 (if %weq (tok-kind t) #2 then
                    (case op-code (tok-text t) of
                       some k →
                         if andb (%weq k #2) (is-tok r2 #1 (lcons #1 lnil)) then (if is-tok (ltail-r r2) #2 (lcons #41 lnil) then some (cwsucc a , ltail-r (ltail-r r2)) else bin-rest names env k a r2)
                         else bin-rest names env k a r2
                       none → none)
                  else none)
               lnil → none))
bin-rest names env k a ts = obind (p-expr names env ts) (λ br → omap (λ r → (cwop k a (fst br) , r)) (p-punct (snd br) (lcons #41 lnil)))
-- the word operators: == 0, < 1, + 2, - 4 (code.cub's cwop)
op-code txt = if lst-eq txt (lcons #61 (lcons #61 lnil)) then some #0 else if lst-eq txt (lcons #60 lnil) then some #1 else if lst-eq txt (lcons #43 lnil) then some #2 else if lst-eq txt (lcons #45 lnil) then some #4 else none
-- the primaries
p-primary names env ts =
  case ts of
    lnil → none
    lcons t r →
      if %weq (tok-kind t) #1 then some (cwlit (tok-text t) , r)
      else if is-tok ts #2 (lcons #40 lnil) then p-paren names env r
      else if is-tok ts #2 (lcons #91 lnil) then p-lambda names env ts
      else if is-tok ts #2 (lcons #42 lnil) then p-expr names env r
      else if %weq (tok-kind t) #0 then p-named names env (tok-text t) r
      else none
p-named names env nm r =
  if lst-eq nm (lcons #107 lnil) then obind (p-punct r (lcons #46 lnil)) (λ r2 → obind (p-ident r2) (λ fr → omap (λ i → (cvar i , snd fr)) (env-index env (lapp (lcons #107 (lcons #46 lnil)) (fst fr)) #0)))
  else if lst-eq nm (lcons #85 (lcons #73 (lcons #78 (lcons #84 (lcons #54 (lcons #52 (lcons #95 (lcons #67 lnil)))))))) then obind (p-punct r (lcons #40 lnil)) (λ r2 → obind (p-num r2) (λ nr → omap (λ r3 → (cwlit (fst nr) , r3)) (p-punct (snd nr) (lcons #41 lnil))))
  else if lst-eq nm (lcons #116 (lcons #114 (lcons #117 (lcons #101 lnil)))) then some (ccon bool-idx #0 lnil lnil , r)
  else if lst-eq nm (lcons #102 (lcons #97 (lcons #108 (lcons #115 (lcons #101 lnil))))) then some (ccon bool-idx #1 lnil lnil , r)
  else if lst-eq nm (lcons #115 (lcons #116 (lcons #100 (lcons #58 (lcons #58 (lcons #112 (lcons #97 (lcons #105 (lcons #114 lnil))))))))) then obind (p-punct r (lcons #123 lnil)) (λ r2 → obind (p-expr names env r2) (λ ar → obind (p-punct (snd ar) (lcons #44 lnil)) (λ r3 → obind (p-expr names env r3) (λ br → omap (λ r4 → (cpair (fst ar) (fst br) , r4)) (p-punct (snd br) (lcons #125 lnil))))))
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #119 (lcons #101 (lcons #108 (lcons #105 (lcons #109 lnil)))))))))) then obind (p-punct r (lcons #40 lnil)) (λ r2 → obind (p-args names env r2) (λ ar → (case fst ar of lcons w rest → (case rest of lcons z rest2 → (case rest2 of lcons s rest3 → some (cwelim w z s , snd ar); _ → none); _ → none); _ → none)))
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #109 (lcons #97 (lcons #120 lnil)))))))) then obind (p-punct r (lcons #40 lnil)) (λ r2 → obind (p-args names env r2) (λ ar → (case fst ar of lcons a rest → (case rest of lcons b r3 → some (cwop #3 a b , snd ar); _ → none); _ → none)))
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #102 (lcons #105 (lcons #120 lnil)))))))) then p-fix names env r
  else if lst-eq nm (lcons #115 (lcons #101 (lcons #108 (lcons #102 lnil)))) then p-self env r
  else if lst-eq nm (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #95 (lcons #99 (lcons #97 (lcons #115 (lcons #116 lnil))))))))))) then obind (p-punct r (lcons #60 lnil)) (λ r2 → obind (p-type env r2) (λ tr → obind (p-punct (snd tr) (lcons #62 lnil)) (λ r3 → obind (p-punct r3 (lcons #40 lnil)) (λ r4 → obind (p-expr names env r4) (λ er → omap (λ r5 → (cast-code (fst tr) (fst er) , r5)) (p-punct (snd er) (lcons #41 lnil)))))))
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #102 (lcons #54 (lcons #52 (lcons #98 (lcons #105 (lcons #116 (lcons #115 lnil)))))))))))) then obind (p-punct r (lcons #40 lnil)) (λ r2 → obind (p-expr names env r2) (λ er → omap (λ r3 → (case fst er of cwlit w → (cplit #2 w , r3); _ → (cprim #276 (lcons (fst er) lnil) , r3))) (p-punct (snd er) (lcons #41 lnil))))
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #108 (lcons #111 (lcons #97 (lcons #100 (lcons #54 (lcons #52 lnil))))))))))) then p-access names env #776 r
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #108 (lcons #111 (lcons #97 (lcons #100 (lcons #51 (lcons #50 lnil))))))))))) then p-access names env #772 r
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #115 (lcons #116 (lcons #111 (lcons #114 (lcons #101 (lcons #54 (lcons #52 lnil)))))))))))) then p-access names env #1032 r
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #115 (lcons #116 (lcons #111 (lcons #114 (lcons #101 (lcons #51 (lcons #50 lnil)))))))))))) then p-access names env #1028 r
  else if lst-eq nm (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #98 (lcons #108 (lcons #101 (lcons #110 lnil))))))))) then p-access names env #1280 r
  else if lst-eq nm (lcons #115 (lcons #116 (lcons #100 (lcons #58 (lcons #58 (lcons #109 (lcons #97 (lcons #107 (lcons #101 (lcons #95 (lcons #115 (lcons #104 (lcons #97 (lcons #114 (lcons #101 (lcons #100 lnil)))))))))))))))) then obind (p-punct r (lcons #60 lnil)) (λ r2 → obind (p-ident r2) (λ dr → obind (p-punct (snd dr) (lcons #62 lnil)) (λ r3 → obind (p-punct r3 (lcons #40 lnil)) (λ r4 → obind (p-expr names env r4) (λ er → omap (λ r5 → (fst er , r5)) (p-punct (snd er) (lcons #41 lnil)))))))
  else (case cname-of nm of
          some dc → p-con names env (fst dc) (snd dc) r
          none →
            (case dname-of nm of
               some d → (case p-punct r (lcons #123 lnil) of some r2 → (case p-ident r2 of some cr → (case cname-of (fst cr) of some dc → obind (p-con names env (fst dc) (snd dc) (snd cr)) (λ er → omap (λ r3 → (fst er , r3)) (p-punct (snd er) (lcons #125 lnil))); none → none); none → none); none → none)
               none →
                 (case env-index env nm #0 of
                    some i → some (cvar i , r)
                    none → (case gname-of names nm of
                              some g → p-global names env g r
                              none → none))))
-- a global, its template arguments as applied type codes
p-global names env g r =
  if is-tok r #2 (lcons #60 lnil) then
    obind (p-targs env (ltail-r r) lnil) (λ tr → some (app-all-c (cglob g) (fst tr) , snd tr))
  else some (cglob g , r)
p-targs env ts acc = obind (p-type env ts) (λ tr → if is-tok (snd tr) #2 (lcons #62 lnil) then some (lapp acc (lcons (fst tr) lnil) , ltail-r (snd tr)) else obind (p-punct (snd tr) (lcons #44 lnil)) (λ r → p-targs env r (lapp acc (lcons (fst tr) lnil))))
-- a cast: to int64_t from a word is the conversion (class 1, sub 16), to uint64_t from an Int64
-- sub 17 (the fragment casts only along these), to double sub 20 or 21, to uint32_t sub 18
cast-code T e =
  case T of
    cpty k n → if %weq k #0 then (case e of cwlit w → cplit #0 w; _ → cprim #272 (lcons e lnil)) else if %weq k #2 then cprim #276 (lcons e lnil) else if %weq k #1 then (case e of cwlit w → cplit #1 w; _ → cprim #274 (lcons e lnil)) else e
    cword → cprim #273 (lcons e lnil)
    _ → e
p-access names env k r = obind (p-punct r (lcons #40 lnil)) (λ r2 → obind (p-args names env r2) (λ ar → some (cprim k (fst ar) , snd ar)))
-- a constructor: D_c{ fields }; a recursive field's make_shared is read through
p-con names env d c r = obind (p-punct r (lcons #123 lnil)) (λ r2 → obind (p-fields names env r2) (λ fr → some (ccon d c (fst fr) lnil , snd fr)))
p-fields names env ts =
  if is-tok ts #2 (lcons #125 lnil) then some (lnil , ltail-r ts)
  else obind (p-expr names env ts) (λ er → p-fields-rest names env (lcons (fst er) lnil) (snd er))
p-fields-rest names env acc ts =
  if is-tok ts #2 (lcons #125 lnil) then some (acc , ltail-r ts)
  else obind (p-punct ts (lcons #44 lnil)) (λ r → obind (p-expr names env r) (λ er → p-fields-rest names env (lapp acc (lcons (fst er) lnil)) (snd er)))
-- self(*k.fj): the hypothesis on field j
p-self env r = obind (p-punct r (lcons #40 lnil)) (λ r2 → obind (p-punct r2 (lcons #42 lnil)) (λ r3 → obind (p-ident r3) (λ kr → obind (p-punct (snd kr) (lcons #46 lnil)) (λ r4 → obind (p-ident r4) (λ fr → obind (p-punct (snd fr) (lcons #41 lnil)) (λ r5 → omap (λ i → (cforce (cvar i) , r5)) (env-index env (lapp (lcons #104 (lcons #46 lnil)) (fst fr)) #0)))))))
-- λ: [&](auto v) { return e; }  |  let: [&]() { auto v = t; return b; }()
p-lambda names env ts =
  obind (p-punct ts (lcons #91 lnil)) (λ r1 → obind (p-punct r1 (lcons #38 lnil)) (λ r2 → obind (p-punct r2 (lcons #93 lnil)) (λ r3 → obind (p-punct r3 (lcons #40 lnil)) (λ r4 →
    if is-tok r4 #2 (lcons #41 lnil) then
      obind (p-punct (ltail-r r4) (lcons #123 lnil)) (λ r5 → obind (p-tok r5 #0 (lcons #97 (lcons #117 (lcons #116 (lcons #111 lnil))))) (λ r6 → obind (p-ident r6) (λ vr → obind (p-punct (snd vr) (lcons #61 lnil)) (λ r7 → obind (p-expr names env r7) (λ tr → obind (p-punct (snd tr) (lcons #59 lnil)) (λ r8 → obind (p-tok r8 #0 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 lnil))))))) (λ r9 → obind (p-expr names (lcons (fst vr , #0) env) r9) (λ br → obind (p-punct (snd br) (lcons #59 lnil)) (λ r10 → obind (p-punct r10 (lcons #125 lnil)) (λ r11 → obind (p-punct r11 (lcons #40 lnil)) (λ r12 → omap (λ r13 → (clet (fst tr) (fst br) , r13)) (p-punct r12 (lcons #41 lnil)))))))))))))
    else
      obind (p-tok r4 #0 (lcons #97 (lcons #117 (lcons #116 (lcons #111 lnil))))) (λ r5 → obind (p-ident r5) (λ vr → obind (p-punct (snd vr) (lcons #41 lnil)) (λ r6 → obind (p-punct r6 (lcons #123 lnil)) (λ r7 → obind (p-tok r7 #0 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 lnil))))))) (λ r8 → obind (p-expr names (lcons (fst vr , #0) env) r8) (λ br → obind (p-punct (snd br) (lcons #59 lnil)) (λ r9 → omap (λ r10 → (clam (fst br) , r10)) (p-punct r9 (lcons #125 lnil)))))))))))))
-- a structural recursion: cub::fix([&](auto &self, const D &x) -> T { return std::visit(cub::overloaded{ alts }, x.v); })(x)
p-fix names env r =
  obind (p-punct r (lcons #40 lnil)) (λ r1 → obind (p-punct r1 (lcons #91 lnil)) (λ r2 → obind (p-punct r2 (lcons #38 lnil)) (λ r3 → obind (p-punct r3 (lcons #93 lnil)) (λ r4 → obind (p-punct r4 (lcons #40 lnil)) (λ r5 →
  obind (p-tok r5 #0 (lcons #97 (lcons #117 (lcons #116 (lcons #111 lnil))))) (λ r6 → obind (p-punct r6 (lcons #38 lnil)) (λ r7 → obind (p-tok r7 #0 (lcons #115 (lcons #101 (lcons #108 (lcons #102 lnil))))) (λ r8 → obind (p-punct r8 (lcons #44 lnil)) (λ r9 → obind (p-tok r9 #0 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 lnil)))))) (λ r10 →
  obind (p-ident r10) (λ dr → obind (p-punct (snd dr) (lcons #38 lnil)) (λ r11 → obind (p-tok r11 #0 (lcons #120 lnil)) (λ r12 → obind (p-punct r12 (lcons #41 lnil)) (λ r13 → obind (p-punct r13 (lcons #45 (lcons #62 lnil))) (λ r14 →
  obind (p-type env r14) (λ tr → obind (p-punct (snd tr) (lcons #123 lnil)) (λ r15 → obind (p-tok r15 #0 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 lnil))))))) (λ r16 → obind (p-tok r16 #0 (lcons #115 (lcons #116 (lcons #100 (lcons #58 (lcons #58 (lcons #118 (lcons #105 (lcons #115 (lcons #105 (lcons #116 lnil))))))))))) (λ r17 → obind (p-punct r17 (lcons #40 lnil)) (λ r18 →
  obind (p-tok r18 #0 (lcons #99 (lcons #117 (lcons #98 (lcons #58 (lcons #58 (lcons #111 (lcons #118 (lcons #101 (lcons #114 (lcons #108 (lcons #111 (lcons #97 (lcons #100 (lcons #101 (lcons #100 lnil)))))))))))))))) (λ r19 → obind (p-punct r19 (lcons #123 lnil)) (λ r20 → obind (dname-of (fst dr)) (λ d →
  obind (p-alts names env d #0 r20) (λ ar → obind (p-punct (snd ar) (lcons #44 lnil)) (λ r21 → obind (p-tok r21 #0 (lcons #120 lnil)) (λ r22 → obind (p-punct r22 (lcons #46 lnil)) (λ r23 → obind (p-tok r23 #0 (lcons #118 lnil)) (λ r24 →
  obind (p-punct r24 (lcons #41 lnil)) (λ r25 → obind (p-punct r25 (lcons #59 lnil)) (λ r26 → obind (p-punct r26 (lcons #125 lnil)) (λ r27 → obind (p-punct r27 (lcons #41 lnil)) (λ r28 → obind (p-punct r28 (lcons #40 lnil)) (λ r29 →
  obind (p-expr names env r29) (λ xr → omap (λ r30 → (celim d (clam (fst tr)) (fst ar) (fst xr) , r30)) (p-punct (snd xr) (lcons #41 lnil))))))))))))))))))))))))))))))))))))
-- the alternatives, in constructor order: [&](const D_c &k) { return [static_cast<T>(] e [)]; }
-- each a λ over the fields then the hypotheses, as the source's branch
p-alts names env d c ts =
  if is-tok ts #2 (lcons #125 lnil) then some (lnil , ltail-r ts)
  else
    obind (p-punct ts (lcons #91 lnil)) (λ r1 → obind (p-punct r1 (lcons #38 lnil)) (λ r2 → obind (p-punct r2 (lcons #93 lnil)) (λ r3 → obind (p-punct r3 (lcons #40 lnil)) (λ r4 → obind (p-tok r4 #0 (lcons #99 (lcons #111 (lcons #110 (lcons #115 (lcons #116 lnil)))))) (λ r5 →
    obind (p-ident r5) (λ cr → obind (p-punct (snd cr) (lcons #38 lnil)) (λ r6 → obind (p-tok r6 #0 (lcons #107 lnil)) (λ r7 → obind (p-punct r7 (lcons #41 lnil)) (λ r8 → obind (p-punct r8 (lcons #123 lnil)) (λ r9 → obind (p-tok r9 #0 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 lnil))))))) (λ r10 →
    let ks = cshape d c
        hs = rec-fields ks #0
        env2 = push-hyp-names hs (push-field-names ks #0 env)
        n = %wadd (lst-count ks) (lst-count hs)
    in obind (p-alt-body names env2 r10) (λ er → obind (p-punct (snd er) (lcons #59 lnil)) (λ r11 → obind (p-punct r11 (lcons #125 lnil)) (λ r12 →
       let body = clams-n n (fst er)
       in if is-tok r12 #2 (lcons #44 lnil) then omap (λ rr → (lcons body (fst rr) , snd rr)) (p-alts names env d (%wsucc c) (ltail-r r12))
          else omap (λ rr → (lcons body (fst rr) , snd rr)) (p-alts names env d (%wsucc c) r12)))))))))))))))
-- the static_cast an alternative's result carries is the result type's, not a conversion
p-alt-body names env ts =
  if is-tok ts #0 (lcons #115 (lcons #116 (lcons #97 (lcons #116 (lcons #105 (lcons #99 (lcons #95 (lcons #99 (lcons #97 (lcons #115 (lcons #116 lnil))))))))))) then obind (p-punct (ltail-r ts) (lcons #60 lnil)) (λ r1 → obind (p-type env r1) (λ tr → obind (p-punct (snd tr) (lcons #62 lnil)) (λ r2 → obind (p-punct r2 (lcons #40 lnil)) (λ r3 → obind (p-expr names env r3) (λ er → omap (λ r4 → (fst er , r4)) (p-punct (snd er) (lcons #41 lnil)))))))
  else p-expr names env ts
push-field-names ks j env = case ks of lnil → env; lcons k r → push-field-names r (%wsucc j) (lcons (lapp (lcons #107 (lcons #46 (lcons #102 lnil))) (dec j) , #0) env)
push-hyp-names hs env = case hs of lnil → env; lcons j r → push-hyp-names r (lcons (lapp (lcons #104 (lcons #46 (lcons #102 lnil))) (dec j) , #0) env)
clams-n n b = if %weq n #0 then b else clam (clams-n (%wsub n #1) b)
-- ---------------------------------------------------------------- definitions
-- [template<class P0, uint64_t P1>] T name(T v0, …) { return e; }: the parameters as λs
p-def names ts =
  let tp = (if is-tok ts #0 (lcons #116 (lcons #101 (lcons #109 (lcons #112 (lcons #108 (lcons #97 (lcons #116 (lcons #101 lnil)))))))) then p-tparams (ltail-r ts) lnil else some (lnil , ts))
  in obind tp (λ tr →
       let env0 = fst tr
       in obind (p-type env0 (snd tr)) (λ rt → obind (p-ident (snd rt)) (λ nr → obind (p-punct (snd nr) (lcons #40 lnil)) (λ r1 → obind (p-params env0 r1) (λ pr →
          let env = fst pr
          in obind (p-punct (snd pr) (lcons #123 lnil)) (λ r2 → obind (p-tok r2 #0 (lcons #114 (lcons #101 (lcons #116 (lcons #117 (lcons #114 (lcons #110 lnil))))))) (λ r3 → obind (p-expr names env r3) (λ er → obind (p-punct (snd er) (lcons #59 lnil)) (λ r4 → omap (λ r5 → ((fst nr , clams-n (lst-len env) (fst er)) , r5)) (p-punct r4 (lcons #125 lnil)))))))))))
-- template<…>: each parameter a binder (a type parameter: its name; a constant: its name)
p-tparams ts env = obind (p-punct ts (lcons #60 lnil)) (λ r → p-tparams-rest r env)
p-tparams-rest ts env =
  obind (if is-tok ts #0 (lcons #99 (lcons #108 (lcons #97 (lcons #115 (lcons #115 lnil))))) then p-ident (ltail-r ts) else obind (p-type env ts) (λ tr → p-ident (snd tr))) (λ nr →
    let env2 = lcons (fst nr , #0) env
    in if is-tok (snd nr) #2 (lcons #62 lnil) then some (env2 , ltail-r (snd nr)) else obind (p-punct (snd nr) (lcons #44 lnil)) (λ r → p-tparams-rest r env2))
p-params env ts =
  if is-tok ts #2 (lcons #41 lnil) then some (env , ltail-r ts)
  else obind (p-type env ts) (λ tr → obind (p-ident (snd tr)) (λ nr →
         let env2 = lcons (fst nr , #0) env
         in if is-tok (snd nr) #2 (lcons #41 lnil) then some (env2 , ltail-r (snd nr)) else obind (p-punct (snd nr) (lcons #44 lnil)) (λ r → p-params env2 r)))
reimport-def names bs = omap (λ dr → snd (fst dr)) (p-def names (tokens bs))
-- a header: the namespace block and the struct declarations are skipped, each definition read
reimport-header names bs = header-defs names (tokens bs)
header-defs names ts =
  case ts of
    lnil → lnil
    lcons t r →
      if is-tok ts #0 (lcons #110 (lcons #97 (lcons #109 (lcons #101 (lcons #115 (lcons #112 (lcons #97 (lcons #99 (lcons #101 lnil))))))))) then header-defs names (skip-block (skip-to-brace r))
      else if is-tok ts #0 (lcons #115 (lcons #116 (lcons #114 (lcons #117 (lcons #99 (lcons #116 lnil)))))) then header-defs names (skip-struct r)
      else (case p-def names ts of
              some dr → lcons (fst dr) (header-defs names (snd dr))
              none → lnil)
skip-to-brace ts = case ts of lnil → lnil; lcons t r → if is-tok ts #2 (lcons #123 lnil) then r else skip-to-brace r
-- after the opening brace: to the matching closing one
skip-block ts = skip-depth ts #1
skip-depth ts n = if %weq n #0 then ts else (case ts of lnil → lnil; lcons t r → if is-tok ts #2 (lcons #123 lnil) then skip-depth r (%wsucc n) else if is-tok ts #2 (lcons #125 lnil) then skip-depth r (%wsub n #1) else skip-depth r n)
-- a struct declaration ends at the ; after its braces (or the forward declaration's ;)
skip-struct ts = case ts of lnil → lnil; lcons t r → if is-tok ts #2 (lcons #123 lnil) then skip-semi (skip-block r) else if is-tok ts #2 (lcons #59 lnil) then r else skip-struct r
skip-semi ts = case ts of lnil → lnil; lcons t r → if is-tok ts #2 (lcons #59 lnil) then r else skip-semi r
-- ---------------------------------------------------------------- up to erasure
-- what the image erases and the fragment cannot give back: the motive of a case on Bool (a
-- ternary's type is deduced; a data type's case keeps its result type in the fix's `-> T`), and
-- a parameter at usage 0 (absent on both sides). erase-code c is the source code with those
-- gone, the term #same compares the re-import against
erase-code c =
  case c of
    celim d P B x → if %weq d bool-idx then ccase d (erase-list B) (erase-code x) else celim d (erase-code P) (erase-list B) (erase-code x)
    ccase d B x → ccase d (erase-list B) (erase-code x)
    clam b → clam (erase-code b)
    capp f a → capp (erase-code f) (erase-code a)
    cpair a b → cpair (erase-code a) (erase-code b)
    cfst p → cfst (erase-code p)
    csnd p → csnd (erase-code p)
    clet t b → clet (erase-code t) (erase-code b)
    cann t T → erase-code t
    ccon d k fs ds → ccon d k (erase-list fs) ds
    cwsucc a → cwsucc (erase-code a)
    cwop k a b → cwop k (erase-code a) (erase-code b)
    cwelim w z s → cwelim (erase-code w) (erase-code z) (erase-code s)
    cprim k as → cprim k (erase-list as)
    cforce t → cforce (erase-code t)
    _ → c
erase-list l = case l of lnil → lnil; lcons x r → lcons (erase-code x) (erase-list r)
-- a case on Bool: the re-import is the source up to its motive
maxq : Word → Word → Word
maxq a b = if %wlt a b then b else a
#same reimport-def lnil (fst (image-def lnil lnil (gidx (code maxq)))) = omap erase-code (unfold (gidx (code maxq)))
-- ---------------------------------------------------------------- readings: the image read back is the source
-- a word function: the re-imported code is the definition's own
#same reimport-def lnil (fst (image-def lnil lnil (gidx (code add3x)))) = unfold (gidx (code add3x))
-- a function uniform in a type: the template parameter is the λ it came from
#same reimport-def lnil (fst (image-def lnil lnil (gidx (code twicex)))) = unfold (gidx (code twicex))
-- a structural recursion through fix and visit: the celim with its motive, branches and
-- hypotheses
#same reimport-def lnil (fst (image-def lnil lnil (gidx (code tsumx)))) = unfold (gidx (code tsumx))
-- a loop over a pair through cub::welim, let and λ
fibq : Word → Word
fibq n = fst (%welimP (λ v → Word × Word) n (#0 , #1) (λ k p → (snd p , %wadd (fst p) (snd p))))
#same reimport-def lnil (fst (image-def lnil lnil (gidx (code fibq)))) = unfold (gidx (code fibq))
-- a whole header read back: every definition by its name
hdr-x = cxx-image lnil lnil (lcons (gidx (code add3x)) (lcons (gidx (code tsumx)) lnil))
#same lst-len (reimport-header lnil (fst hdr-x)) = #2
#same omap (λ p → snd p) (lnth (reimport-header lnil (fst hdr-x)) #1) = unfold (gidx (code tsumx))
-- up to erasure: a proof parameter is gone in the image and stays gone when read back (the λ
-- count is the run-time parameters')
lam-count c = case c of clam b → %wsucc (lam-count b); _ → #0
#same omap lam-count (reimport-def lnil (fst (image-def lnil lnil (gidx (code ld8x))))) = some #1
