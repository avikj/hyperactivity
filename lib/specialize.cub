-- lib/specialize.cub — the specializer's pipeline on codes (plan 18.6), the steps that exist today.
-- Loaded after lib/check.cub, lib/match.cub, lib/fo.cub and lib/lower.cub.
-- specialize T rules c: the code c (closed, at type T) is normalized by the machine (eval, then
-- quote at T: step 2), rewritten along the rules until none applies (step 3, bounded), and
-- lowered to the first-order form (step 6). Steps 4 (usage), 5 (the criterion) and 7 (the
-- proof) follow B11, B13 and the proof lemmas of 18.5; today the result is checked by
-- evaluating the first-order form and comparing with the normal form (the readings below).
-- The rewrite bound is the terminating discipline's crude form (a count); the ordered form
-- (18.6) replaces it.
normalize T c = fromopt (quote-top T (eval-g lnil c)) c
rewrite-all n rules c =
  if %weq n #0 then c
  else (case first-applicable rules c of
          none → c
          some c2 → rewrite-all (%wsub n #1) rules c2)
first-applicable rules c =
  case rules of
    lnil → none
    lcons r rest → (case rewrite-first r c of some c2 → some c2; none → first-applicable rest c)
specialize T rules c = inplace (lower (rewrite-all #64 rules (normalize T c)))
-- the specialized form evaluated, as a word (for readings over word-valued programs)
run-fo f = wof (eval-fo (λ g → flit #0) lnil f)
-- ---------------------------------------------------------------- readings
-- a closed word computation: normalization does the whole job; the form is a literal
c1 = cwop #2 (cwlit #3) (cwlit #4)
#same specialize Word lnil c1 = flit #7
-- a function applied to a known argument, specialized to the result
c2 = capp (clam (cwop #2 (cvar #0) (cwlit #10))) (cwlit #5)
#same specialize Word lnil c2 = flit #15
-- an open function: its body survives as a λ over a primitive; the environment supplies the
-- argument at run time (stage "run")
c3 = clam (cwop #2 (cvar #0) (cwlit #1))
#same specialize (Word → Word) lnil c3 = flam (fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)))
#same run-fo (fapply (specialize (Word → Word) lnil c3) (lcons (flit #41) lnil)) = #42
-- word elimination with a known bound normalizes away entirely: 2^5 is a literal
c4 = cwelim (cwlit #5) (cwlit #1) (clam (clam (cwop #2 (cvar #0) (cvar #0))))
#same specialize Word lnil c4 = flit #32
-- with an unknown bound it stays a loop, and the loop computes
c5 = clam (cwelim (cvar #0) (cwlit #1) (clam (clam (cwop #2 (cvar #0) (cvar #0)))))
#same run-fo (fapply (specialize (Word → Word) lnil c5) (lcons (flit #6) lnil)) = #64
-- ---------------------------------------------------------------- whole programs
-- program-of fuel c: the first-order definitions a code needs, by lowering the code and then every
-- checked definition it calls, transitively, from the quote of the definition's value (its code
-- without its name; definitions whose values do not quote — those over stuck primitives, 18.6's
-- finding — are left as calls for lib/repr.cub or the harness to supply). A definition's arity is
-- its leading λs; its body takes the arguments pushed in order. Then lift converts the closures
-- and recursions of every body into definitions numbered from k
unfold g = quote-top (%gty g) (%gval g)
lam-arity t = case t of flam b → %wsucc (lam-arity b); _ → #0
strip-flams t = case t of flam b → strip-flams b; _ → t
fcalls t acc =
  case t of
    fcall g args → fcalls-list args (if lmem g acc then acc else lcons g acc)
    fcon d c fs → fcalls-list fs acc
    fswitch x alts → fcalls-alts alts (fcalls x acc)
    frec d x alts → fcalls-ralts alts (fcalls x acc)
    fproj d c k x → fcalls x acc
    fprim p args → fcalls-list args acc
    flet a b → fcalls b (fcalls a acc)
    fif c a b → fcalls b (fcalls a (fcalls c acc))
    floop init body → fcalls body (fcalls-list init acc)
    fclos g env → fcalls-list env acc
    flam b → fcalls b acc
    fapply f args → fcalls-list args (fcalls f acc)
    fthunk a → fcalls a acc
    fforce x → fcalls x acc
    fassume f b → fcalls b acc
    fupd u x c k v → fcalls v (fcalls x acc)
    _ → acc
fcalls-list l acc = case l of lnil → acc; lcons x xs → fcalls-list xs (fcalls x acc)
fcalls-alts alts acc = case alts of lnil → acc; lcons a r → fcalls-alts r (fcalls (snd (snd a)) acc)
fcalls-ralts alts acc = case alts of lnil → acc; lcons a r → fcalls-ralts r (fcalls (snd (snd (snd a))) acc)
lmem g l = case l of lnil → false; lcons x xs → if %weq x g then true else lmem g xs
-- the definitions, as (g , (arity , body)), for the globals pending, those done listed
program-defs fuel pending done =
  if %weq fuel #0 then lnil else
  (case pending of
     lnil → lnil
     lcons g rest →
       if lmem g done then program-defs fuel rest done
       else (case unfold g of
               none → program-defs (%wsub fuel #1) rest (lcons g done)
               some cd →
                 let t = inplace (erase-lams (g-erased g) #0 (lower cd))
                 in lcons (g , (lam-arity t , strip-flams t)) (program-defs (%wsub fuel #1) (lapp2 rest (fcalls t lnil)) (lcons g done))))
-- the program of a code: definition m is the code itself (its λs its arity), then what it calls;
-- a global g is definition g + 1 in the program (0 is left for a main)
program-at m fuel c =
  let t = inplace (lower c)
  in lcons (m , (lam-arity t , offset-calls (strip-flams t))) (offset-defs (program-defs fuel (fcalls t lnil) lnil))
program-of fuel c = program-at #0 fuel c
offset-defs defs = case defs of lnil → lnil; lcons d r → lcons (%wsucc (fst d) , (fst (snd d) , offset-calls (snd (snd d)))) (offset-defs r)
offset-calls t =
  case t of
    fcall g args → fcall (%wsucc g) (offset-list args)
    fcon d c fs → fcon d c (offset-list fs)
    fswitch x alts → fswitch (offset-calls x) (offset-alts alts)
    frec d x alts → frec d (offset-calls x) (offset-ralts alts)
    fproj d c k x → fproj d c k (offset-calls x)
    fprim p args → fprim p (offset-list args)
    flet a b → flet (offset-calls a) (offset-calls b)
    fif c a b → fif (offset-calls c) (offset-calls a) (offset-calls b)
    floop init body → floop (offset-list init) (offset-calls body)
    flam b → flam (offset-calls b)
    fapply f args → fapply (offset-calls f) (offset-list args)
    fthunk a → fthunk (offset-calls a)
    fforce x → fforce (offset-calls x)
    fassume f b → fassume f (offset-calls b)
    fupd u x c k v → fupd u (offset-calls x) c k (offset-calls v)
    _ → t
offset-list l = case l of lnil → lnil; lcons x xs → lcons (offset-calls x) (offset-list xs)
offset-alts alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , offset-calls (snd (snd a)))) (offset-alts r)
offset-ralts alts = case alts of lnil → lnil; lcons a r → lcons (fst a , (fst (snd a) , (fst (snd (snd a)) , offset-calls (snd (snd (snd a)))))) (offset-ralts r)
-- every body lifted, the new definitions numbered from k
lift-program k defs =
  case defs of
    lnil → lnil
    lcons d rest → (case lift k (snd (snd d)) of lifted b2 ds k2 → lcons (fst d , (fst (snd d) , b2)) (lapp2 ds (lift-program k2 rest)))
-- readings: a function calling a recursive definition of the store (lenw of lib/lower.cub, on the
-- list type LW): the program has lenw lowered from its value (sw and zw inlined by the quote)
#same lst-len (program-of #10 (code (λ (l : LW) → lenw l))) = #2
prog-len = lift-program #100000 (program-of #10 (code (λ (l : LW) → lenw l)))
#same eval-fo (table-of prog-len) lnil (fcall #0 (lcons lw3 lnil)) = vw #2
-- ---------------------------------------------------------------- the criterion's report (B13, the code side)
-- fo-report c: the forms of c outside the first-order fragment, each as its code (a dimension
-- binder or application, a path type or composition, Glue, a transport, a universe, a Π or Σ type
-- as a value, a code with dimensions in a constructor, a call into the net); empty when the code is
-- first-order. The checker's own decision (strictness, the codata rule, 18.3) is the machine's;
-- this is what lower would turn into fnet
fo-report c =
  case c of
    clam b → fo-report b
    capp f a → lapp2 (fo-report f) (fo-report a)
    cpair a b → lapp2 (fo-report a) (fo-report b)
    cfst p → fo-report p
    csnd p → fo-report p
    clet t b → lapp2 (fo-report t) (fo-report b)
    cann t T → fo-report t
    ccon d k fs ds → (case ds of lnil → fo-report-list fs; _ → lcons c lnil)
    ccase d B x → lapp2 (fo-report-list B) (fo-report x)
    celim d P B x → lapp2 (fo-report-list B) (fo-report x)
    cforce t → fo-report t
    cwsucc a → fo-report a
    cwop k a b → lapp2 (fo-report a) (fo-report b)
    cwelim w z s → lapp2 (fo-report w) (lapp2 (fo-report z) (fo-report s))
    cprim k as → fo-report-list as
    cplit k b → lnil
    cvar n → lnil
    cglob n → lnil
    cwlit n → lnil
    cdata d ps → lnil
    _ → lcons c lnil
fo-report-list l = case l of lnil → lnil; lcons x xs → lapp2 (fo-report x) (fo-report-list xs)
is-fo c = case fo-report c of lnil → true; _ → false
-- readings: the loop is first-order; a path abstraction and a transport are reported
#same is-fo (cwelim (cwlit #5) (cwlit #1) (clam (clam (cwop #2 (cvar #0) (cvar #0))))) = true
#same is-fo (code (λ (l : LW) → lenw l)) = true
#same fo-report (cplam (cvar #0)) = lcons (cplam (cvar #0)) lnil
#same lst-len (fo-report (capp (cplam (cvar #0)) (ctrans #1 cftt lnil (cvar #0)))) = #2
-- ---------------------------------------------------------------- schedules as values (5.2, 18.3 §6)
-- what the specializer may do is a value: how many rewrites; the binding-time assignment
-- (stages: a Lst of (binder index , Stage), read by the C++ image for its template parameters
-- and by the criterion); the representations chosen (reps: a Lst of data type indices whose
-- declared representation is consumed, lib/repr.cub; every declared one when empty). The inline
-- depth is the machine's (normalization unfolds every definition it reaches: quote renders a
-- definition applied to a neutral by its body); fusion and strictness follow.
sched-rewrites s = case s of sched r st rp → r
sched-stages s = case s of sched r st rp → st
sched-reps s = case s of sched r st rp → rp
sched-default = sched #64 lnil lnil
-- the specializer with the criterion (B13, lib/stage.cub): the code normalized and rewritten is
-- judged by first-order at its type; the verdict comes back with the form (a not-fo region is
-- lowered all the same: its forms outside the fragment are calls into the net, fnet, and the
-- verdict names the first of them and why)
specialize-v sch T rules c =
  let c2 = rewrite-all (sched-rewrites sch) rules (normalize T c)
  in (first-order T c2 , inplace (lower c2))
specialize-s sch T rules c = snd (specialize-v sch T rules c)
-- readings: a word function is fo; a path is not (dim), and the form is a call into the net
#same fst (specialize-v sched-default (Word → Word) lnil c3) = fo
#same fst (specialize-v sched-default (Word ≡ Word) lnil (cplam cword)) = not-fo dim (cplam (cvar #0))
#same snd (specialize-v sched-default (Word ≡ Word) lnil (cplam cword)) = fnet #0 lnil
-- the call of lenw under an unknown list normalizes to the recursion itself
#same specialize-s sched-default (LW → Word) lnil (code (λ (l : LW) → lenw l)) = inplace (lower (fromopt (unfold (gidx (code lenw))) cword))
