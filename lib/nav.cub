-- lib/nav.cub — navigation over established identities (plan 18.14). Loaded after lib/match.cub.
-- A view is a list of rules, each an identity read left to right (its left side a pattern). From
-- a view and a term, the available steps are every (rule, position) where the rule applies; a
-- step is taken by rewriting there. Validity never enters the choice: every available step is a
-- transport along an identity in view. Choice is by a score; the first score is the size of the
-- result (the cost model's estimate, 18.14), and a purpose is a goal pattern: a step that makes
-- the goal match is taken first.
-- (code-size, the size of a code, is lib/match.cub's: the discipline there and the choice here measure alike)
-- ---------------------------------------------------------------- available steps
-- the rules of the view that apply somewhere in t, each with its first rewrite (the position
-- enumeration is rewrite-first's; a full enumeration by position lists every rewrite-at)
data Stepv = stepv (r : Rule) (result : Code)
available view t =
  case view of
    lnil → lnil
    lcons r rest →
      (case rewrite-first r t of
         some t2 → lcons (stepv r t2) (available rest t)
         none → available rest t)
-- ---------------------------------------------------------------- choice
-- the step whose result is smallest; among equals the first in view
best steps =
  case steps of
    lnil → none
    lcons s rest → some (best-from s rest)
best-from s rest =
  case rest of
    lnil → s
    lcons s2 r2 →
      (case s of
         stepv r t →
           (case s2 of
              stepv r2 t2 → if %wlt (code-size t2) (code-size t) then best-from s2 r2 else best-from s r2))
-- a purpose: a goal pattern; a step whose result the goal matches at the root is taken over any
-- other
reaches goal t = case match #0 #0 goal t mnil of some s → true; none → false
choose goal steps =
  case first-reaching goal steps of
    some s → some s
    none → best steps
first-reaching goal steps =
  case steps of
    lnil → none
    lcons s rest → (case s of stepv r t → if reaches goal t then some s else first-reaching goal rest)
-- ---------------------------------------------------------------- navigation
-- navigate n goal view t: up to n steps, stopping when the goal matches or nothing applies; the
-- result and the number of steps taken. Every intermediate term equals t by the composite of the
-- rules' identities (each a path in the store); the composite is the trace
data Navr = navr (result : Code) (steps : Word)
navigate n goal view t =
  if %weq n #0 then navr t #0
  else if reaches goal t then navr t #0
  else (case choose goal (available view t) of
          none → navr t #0
          some s → (case s of stepv r t2 → (case navigate (%wsub n #1) goal view t2 of navr t3 k → navr t3 (%wsucc k))))
-- ---------------------------------------------------------------- tests
-- the view: plus 0 ?x → ?x ; plus ?x 0 → ?x ; map fusion ; double
v-plus0 = rule #0 (capp (capp (cglob #7) (cwlit #0)) (cvar #0)) (cvar #0)
v-plus0r = rule #0 (capp (capp (cglob #7) (cvar #0)) (cwlit #0)) (cvar #0)
v-fuse = rule #0 (capp (capp (cglob #3) (cvar #0)) (capp (capp (cglob #3) (cvar #1)) (cvar #2)))
                 (capp (capp (cglob #3) (clam (capp (cvar #1) (capp (cvar #2) (cvar #0))))) (cvar #2))
view1 = lcons v-plus0 (lcons v-plus0r (lcons v-fuse lnil))
-- plus (plus 0 a) 0, with the goal "a bare global": two steps reach it
t1 = capp (capp (cglob #7) (capp (capp (cglob #7) (cwlit #0)) (cglob #20))) (cwlit #0)
#same navigate #5 (cglob #20) view1 t1 = navr (cglob #20) #2
-- three nested maps: fusion applies twice, each step smaller; no goal reached (the goal is an
-- unrelated pattern), so navigation runs until nothing applies
t2 = capp (capp (cglob #3) (cglob #10)) (capp (capp (cglob #3) (cglob #11)) (capp (capp (cglob #3) (cglob #12)) (cglob #13)))
#same (case navigate #5 (cwlit #99) view1 t2 of navr r k → k) = #2
-- nothing applies: zero steps, the term unchanged
#same navigate #5 (cwlit #99) view1 (cglob #4) = navr (cglob #4) #0
