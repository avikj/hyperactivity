-- To check against v31 (hyperactivity_v31.pdf, 14 November 2026): what v31 already contains leaves the delta.
-- geodesic
-- docs/paper-delta.cub — the paper delta (Avik, 2026-11-15): the set of pointers to the pieces of work
-- not yet incorporated into the paper, each written at a different time; when the paper absorbs a
-- piece, its pointer leaves.
import "../lib/document.cub"
paper-delta : List Document
paper-delta =
  cons (document "to-be-incorporated-into-paper.md")
  (cons (document "hyperactive-interaction-in-the-words-of-the-human-superorganism.md")
  (cons (document "knowledge-is-a-lack-of-ignorance.md")
  (cons (document "controversy-and-consensus.md")
  (cons (document "no-filesystem.md")
  (cons (document "eye-contact-co-processing-at-the-speed-of-light.md")
  (cons (document "information-acts-and-common-ground.md")
  nil))))))
