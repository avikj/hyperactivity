-- docs/onboarding.cub — what an agent reads on arrival, in order (Avik, 2026-11-15): `hyperactive`
-- serves these documents, one chunk at a time, with next and prev only; the task graph follows. The
-- paper is read from docs/Hyperactivity_Current_Draft.md whenever it is present (AGENTS.md).
import "paper-delta.cub"
onboarding : List Document
onboarding =
  cons (document "../AGENTS.md")
  (cons (document "../AI-AGENTS-WELCOME-TO-HYPERACTIVITY.md")
  (cons (document "hyperactivity_v31.pdf")
  (cons (document "Hyperactive_Labs.md")
  (list-append paper-delta
  (cons (document "word-list.md")
  (cons (document "etymologies.md")
  nil))))))
