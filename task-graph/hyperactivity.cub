-- documents that are essential context for working on a node and everything below it (lib/task-graph.cub;
-- docs/task-graph-design.md §7), each a file of the repository whose absence fails this file's check
-- (part of product-implementation)
hyperactive-paper : Document
hyperactive-paper = document "../docs/Hyperactive_Final_Paper.pdf"
task-graph-design : Document
task-graph-design = document "../docs/task-graph-design.md"
state-change-collaboration-design : Document
state-change-collaboration-design = document "../docs/state-change-collaboration-design.md"
what-hyperactive-is-for-in-avik-words : Document
what-hyperactive-is-for-in-avik-words = document "../docs/what-hyperactive-is-for-in-avik-words.md"
essential-context : List (Node × List Document)
essential-context = cons (the-product , cons what-hyperactive-is-for-in-avik-words (cons hyperactive-paper (cons task-graph-design nil))) (cons (product-implementation , cons state-change-collaboration-design nil) nil)
-- the roots: the nodes that are part of nothing, declared (lib/task-graph.cub); read by tools/task-graph.py
-- (part of product-implementation)
roots : List Node
roots = cons the-product nil
-- after: a node's work cannot start until every node listed is resolved (lib/task-graph.cub; docs/task-graph-design.md
-- §5); the order of work is computed from this and the parts (tools/task-graph.py priority) (part of
-- product-implementation)
after : List (Node × List Node)
after = cons (language-support , cons language-implementation (cons product-implementation nil)) (cons (t29 , cons t7 nil) (cons (t39 , cons t16 nil) (cons (t42 , cons t61 nil) (cons (t44 , cons t61 nil) (cons (t64 , cons t61 (cons t62 nil)) nil)))))
