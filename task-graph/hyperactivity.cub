file-src-lang-c = document "../src/lang.c"
file-src-net-c : Document
file-src-net-c = document "../src/net.c"
file-src-store-c : Document
file-src-store-c = document "../src/store.c"
essential-context : List (Node × List Document)
essential-context = cons (the-product , onboarding) (cons (product-implementation , cons file-src-lang-c (cons file-src-net-c (cons file-src-store-c (cons file-makefile (cons file-lib-task-graph-cub nil))))) (cons (typed-codes-and-normalization , cons file-lib-check-cub (cons file-lib-nbe-cub (cons file-experiments-nbe-examples-cub nil))) (cons (language-implementation-remainder , cons file-src-lang-c (cons file-src-net-c (cons file-lib-prelude-cub (cons file-lib-deploy-cub (cons file-lib-elf-cub (cons file-lib-compile-meaning-cub (cons file-lib-std-cub (cons file-lib-derive-cub (cons file-lib-prim-cub (cons file-lib-specialize-cub nil)))))))))) (cons (language-support , cons file-experiments-isa-build-run-cub (cons file-lib-isa-tso-cub (cons file-lib-cxx-machine-cub (cons file-lib-cxx-read-expr-cub (cons file-lib-lang-rust-machine-cub nil))))) nil))))
-- the root: what Avik wants
roots : List Node
roots = cons the-product nil
-- the leaves being worked on now, and the leaves whose work is done; every other leaf is pending
-- (“The Hyperactive Workflow” (docs/to-be-incorporated-into-paper.md))
in-progress : List Node
in-progress = cons the-paper-is-one-value (cons onboarding-from-the-paper-delta (cons substitution-commutes-with-path-application (cons path-application-under-substitution-at-forms nil)))
resolved : List Node
resolved = cons interval-normal-forms-mean-their-expressions (cons normal-forms-are-canonical nil)
-- language support starts only when the language implementation and the product implementation are
-- done (Avik, 2026-11-13)
after : List (Node × List Node)
-- the paper's implementation details are updated once the implementation is done (Avik, 2026-11-14)
after = cons (language-support , cons language-implementation (cons product-implementation nil)) (cons (paper-matches-implementation , cons language-implementation (cons product-implementation nil)) nil)

