essential-context : List (Node × List Document)
essential-context = cons (the-product , cons hyperactive-design (cons hyperactive-paper nil)) (cons (product-implementation , cons file-src-lang-c (cons file-src-net-c (cons file-src-store-c (cons file-makefile (cons file-lib-task-graph-cub nil))))) (cons (typed-codes-and-normalization , cons file-lib-check-cub (cons file-experiments-nbe-p26-wip-cub (cons file-lib-nbe-cub nil))) (cons (language-implementation-remainder , cons file-src-lang-c (cons file-src-net-c (cons file-lib-prelude-cub (cons file-lib-deploy-cub (cons file-lib-elf-cub (cons file-lib-compile-meaning-cub (cons file-lib-std-cub (cons file-lib-derive-cub (cons file-lib-prim-cub (cons file-lib-specialize-cub nil)))))))))) (cons (language-support , cons file-experiments-isa-build-run-cub (cons file-lib-isa-tso-cub (cons file-lib-cxx-machine-cub (cons file-lib-cxx-read-expr-cub (cons file-lib-lang-rust-machine-cub nil))))) nil))))
-- the root: what Avik wants
roots : List Node
roots = cons the-product nil
-- the leaves being worked on now, and the leaves whose work is done; every other leaf is pending
-- (HYPERACTIVE.md §2.4 “The organization of the work”)
in-progress : List Node
in-progress = cons substitution-commutes-with-path-application nil
resolved : List Node
resolved = cons interval-normal-forms-mean-their-expressions (cons normal-forms-are-canonical nil)
-- language support starts only when the language implementation and the product implementation are
-- done (Avik, 2026-11-13)
after : List (Node × List Node)
after = cons (language-support , cons language-implementation (cons product-implementation nil)) nil
