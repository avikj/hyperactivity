-- the one rule: the table's entry for the two tags, performed
hv2-do : List Hv2Def → Word → Hv2Net → Word → Word → Hv2Net
hv2-do book r net a b =
  if %weq r hv2-LINK then hv2-ln net a b
  else if %weq r hv2-CALL then hv2-call book net a b
  else if %weq r hv2-VOID then net
  else if %weq r hv2-ERAS then hv2-eras net a b
  else if %weq r hv2-ANNI then hv2-anni net a b
  else if %weq r hv2-COMM then hv2-comm net a b
  else if %weq r hv2-OPER then hv2-oper net a b
  else hv2-swit net a b
