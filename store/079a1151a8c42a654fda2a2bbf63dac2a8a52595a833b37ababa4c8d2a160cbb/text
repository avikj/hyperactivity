h4-wrs : Word → Nat → Word → List Word → (Word → Step W Word) → Step W Word
h4-wrs mm_ zero at xs kq_ =
  kq_ (h4-depl mm_ (at))
h4-wrs mm_ (suc f) at xs kq_ =
  if (%weq (cli-len xs) #0) then (kq_ (h4-depl mm_ (at))) else (scmd (w-store ((h4-ha mm_ at)) ((hv2-nth #0 xs))) (λ uu_29 → let mm_30 = hv2-u mm_ uu_29 in h4-wrs mm_30 f (%wsucc at) (hv2-drop1 xs) kq_))
