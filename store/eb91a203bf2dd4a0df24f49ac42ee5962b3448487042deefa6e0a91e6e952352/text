sf-eprl-fold4 : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → BQ → BQ
sf-eprl-fold4 Jp Jm ip1 im1 ip2 im2 ip3 im3 wt3 opts4 opts5 acc = case opts4 of
  nil → acc
  cons o4 rest4 →
    sf-eprl-fold4 Jp Jm ip1 im1 ip2 im2 ip3 im3 wt3 rest4 opts5
      (sf-eprl-fold5 Jp Jm ip1 im1 ip2 im2 ip3 im3 (fst o4) (fst (snd o4)) (bq-mul wt3 (snd (snd o4))) opts5 acc)
