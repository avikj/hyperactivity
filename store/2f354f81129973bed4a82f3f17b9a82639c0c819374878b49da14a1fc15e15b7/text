b2-acopyf : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-acopyf mm_ zero src dst off n kq_ =
  kq_ (h4-depl mm_ (dst))
b2-acopyf mm_ (suc f) src dst off n kq_ =
  if (%weq n #0) then (kq_ (h4-depl mm_ (dst))) else (let a_830 = src in let j_831 = (%wadd off (%wsub n #1)) in scmd (w-load ((b2-a mm_ (%wadd a_830 (%wsucc j_831))))) (λ x_829 → let mm_832 = b2-dep mm_ x_829 in let x = x_829 in let a_833 = dst in let j_834 = (%wsub n #1) in let v_835 = x in scmd (w-store ((b2-a mm_832 (%wadd a_833 (%wsucc j_834)))) (v_835)) (λ uu_836 → let mm_837 = hv2-u mm_832 uu_836 in b2-acopyf mm_837 f src dst off (%wsub n #1) kq_)))
