ge-lem-mk-and : (env : Nat → Bool) → (a b : GuardExpr) → ge-eval env (ge-mk-and a b) ≡ bfm-andB (ge-eval env a) (ge-eval env b)
ge-lem-mk-and env (ge-k false) b            = refl
ge-lem-mk-and env (ge-k true)  b            = refl
ge-lem-mk-and env (ge-v i)     (ge-k false) = bfm-sym (bfm-lem-and-false-r (env i))
ge-lem-mk-and env (ge-v i)     (ge-k true)  = bfm-sym (bfm-lem-and-true-r (env i))
ge-lem-mk-and env (ge-v i)     (ge-v j)     = ge-lem-and-guard env (ge-v i) (ge-v j)
ge-lem-mk-and env (ge-v i)     (ge-not b)   = ge-lem-and-guard env (ge-v i) (ge-not b)
ge-lem-mk-and env (ge-v i)     (ge-and b1 b2) = ge-lem-and-guard env (ge-v i) (ge-and b1 b2)
ge-lem-mk-and env (ge-v i)     (ge-ite c t f) = ge-lem-and-guard env (ge-v i) (ge-ite c t f)
ge-lem-mk-and env (ge-not a)   (ge-k false) = bfm-sym (bfm-lem-and-false-r (ge-eval env (ge-not a)))
ge-lem-mk-and env (ge-not a)   (ge-k true)  = bfm-sym (bfm-lem-and-true-r (ge-eval env (ge-not a)))
ge-lem-mk-and env (ge-not a)   (ge-v j)     = ge-lem-and-guard env (ge-not a) (ge-v j)
ge-lem-mk-and env (ge-not a)   (ge-not b)   = ge-lem-and-guard env (ge-not a) (ge-not b)
ge-lem-mk-and env (ge-not a)   (ge-and b1 b2) = ge-lem-and-guard env (ge-not a) (ge-and b1 b2)
ge-lem-mk-and env (ge-not a)   (ge-ite c t f) = ge-lem-and-guard env (ge-not a) (ge-ite c t f)
ge-lem-mk-and env (ge-and a1 a2) (ge-k false) = bfm-sym (bfm-lem-and-false-r (ge-eval env (ge-and a1 a2)))
ge-lem-mk-and env (ge-and a1 a2) (ge-k true)  = bfm-sym (bfm-lem-and-true-r (ge-eval env (ge-and a1 a2)))
ge-lem-mk-and env (ge-and a1 a2) (ge-v j)     = ge-lem-and-guard env (ge-and a1 a2) (ge-v j)
ge-lem-mk-and env (ge-and a1 a2) (ge-not b)   = ge-lem-and-guard env (ge-and a1 a2) (ge-not b)
ge-lem-mk-and env (ge-and a1 a2) (ge-and b1 b2) = ge-lem-and-guard env (ge-and a1 a2) (ge-and b1 b2)
ge-lem-mk-and env (ge-and a1 a2) (ge-ite c t f) = ge-lem-and-guard env (ge-and a1 a2) (ge-ite c t f)
ge-lem-mk-and env (ge-ite c1 t1 f1) (ge-k false) = bfm-sym (bfm-lem-and-false-r (ge-eval env (ge-ite c1 t1 f1)))
ge-lem-mk-and env (ge-ite c1 t1 f1) (ge-k true)  = bfm-sym (bfm-lem-and-true-r (ge-eval env (ge-ite c1 t1 f1)))
ge-lem-mk-and env (ge-ite c1 t1 f1) (ge-v j)     = ge-lem-and-guard env (ge-ite c1 t1 f1) (ge-v j)
ge-lem-mk-and env (ge-ite c1 t1 f1) (ge-not b)   = ge-lem-and-guard env (ge-ite c1 t1 f1) (ge-not b)
ge-lem-mk-and env (ge-ite c1 t1 f1) (ge-and b1 b2) = ge-lem-and-guard env (ge-ite c1 t1 f1) (ge-and b1 b2)
ge-lem-mk-and env (ge-ite c1 t1 f1) (ge-ite c t f) = ge-lem-and-guard env (ge-ite c1 t1 f1) (ge-ite c t f)
