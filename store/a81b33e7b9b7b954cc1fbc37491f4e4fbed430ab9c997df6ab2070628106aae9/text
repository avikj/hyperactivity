-- Language term (transliteration) “gloss”
e-show : Nat → Bool → List (List Word) → Proc W (List Word)
e-show width sense m = bind (if andB (h-null (e-m (toNat #6) m)) sense then e-sense (e-m (toNat #1) m) (e-m (toNat #4) m) else ret {lzero} {W} (e-m (toNat #6) m)) (λ gl →
  bind (e-name m) (λ nm → ret (e-shown nm (e-m (toNat #3) m) (e-m (toNat #5) m) (if e-nat-le (e-chars gl) width then gl else e-cut width gl))))
