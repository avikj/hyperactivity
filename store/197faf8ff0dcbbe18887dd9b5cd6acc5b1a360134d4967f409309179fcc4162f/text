-- 5. Pythagorean Constant-Power Binaural Spatial Audio Panning (`gL^2 + gR^2 == 1,000,000`):
--    Exact Pythagorean triples scaled to hypotenuse 1,000:
--      Azimuth 0 (hard left)   : (1000,    0) -> 1,000,000
--      Azimuth 1 (front-left)  : ( 960,  280) -> 921,600 + 78,400  = 1,000,000! (24-7-25 triple!)
--      Azimuth 2 (mild-left)   : ( 800,  600) -> 640,000 + 360,000 = 1,000,000! (4-3-5 triple!)
--      Azimuth 3 (mild-right)  : ( 600,  800) -> 360,000 + 640,000 = 1,000,000!
--      Azimuth 4 (front-right) : ( 280,  960) ->  78,400 + 921,600 = 1,000,000!
--      Azimuth 5 (hard right)  : (   0, 1000) -> 1,000,000!
vph-pan-l : Word → Word
vph-pan-l az =
  if %weq az #0 then #1000
  else if %weq az #1 then #960
  else if %weq az #2 then #800
  else if %weq az #3 then #600
  else if %weq az #4 then #280
  else #0
