emg-so-inner : EmgVec3 BZ → EmgVec3 BZ → EmgVec3 BZ → List (EmgVec3 BZ) → EmgVec3 BZ
emg-so-inner ea k g vs = case vs of
  nil → (bz-zero , (bz-zero , bz-zero))
  cons eb er →
    emg-v3-add BZ bz-add
      (emg-v3-bz-scale (bz-mul (emg-v3-dot BZ bz-add bz-mul k ea) (emg-v3-dot BZ bz-add bz-mul g eb))
                       (emg-v3-cross BZ bz-add bz-mul bz-neg ea eb))
      (emg-so-inner ea k g er)
