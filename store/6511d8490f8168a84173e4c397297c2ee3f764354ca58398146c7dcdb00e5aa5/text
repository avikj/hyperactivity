hv2-ilit : List Word → Word × List Word
hv2-ilit nil = (hv2-new hv2-TY-U24 #0 , nil)
hv2-ilit (cons c r) =
  if %weq c #43 then (let d = hv2-digits #0 r in (hv2-new hv2-TY-I24 (fst d) , snd d))
  else if %weq c #45 then (let d = hv2-digits #0 r in (hv2-new hv2-TY-I24 (hv2-neg (fst d)) , snd d))
  else (let d = hv2-digits #0 (cons c r) in (hv2-new hv2-TY-U24 (fst d) , snd d))
