            '<div class="hx-kg-imeta"><a href="' + escHtml(h.route) + (h.sectionId ? '#' + escHtml(h.sectionId) : '') + '">' + escHtml(h.route) + (h.sectionId ? '#' + escHtml(h.sectionId) : '') + '</a>' +
