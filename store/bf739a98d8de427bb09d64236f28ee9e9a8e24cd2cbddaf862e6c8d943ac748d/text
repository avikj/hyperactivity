  // Deterministic S-expression parser for canonical cubical normal forms printed by `#show`
  function parseCubicalNormalForm(str) {
    var s = String(str || '').replace(/\[[0-9]+ steps[^\]]*\]/g, '').trim();
    var eq = s.indexOf('=');
    if (eq !== -1) s = s.slice(eq + 1).trim();
    var tokens = s.match(/\(|\)|[^\s()]+/g) || [];
    var pos = 0;
    function parseAtom() {
      if (pos >= tokens.length) return null;
      var t = tokens[pos++];
      if (t === '(') {
        var list = [];
        while (pos < tokens.length && tokens[pos] !== ')') {
          list.push(parseAtom());
        }
        if (tokens[pos] === ')') pos++;
        return list;
      }
      return t;
    }
    var root = [];
    while (pos < tokens.length) root.push(parseAtom());
    return root.length === 1 && Array.isArray(root[0]) ? root[0] : root;
  }

  function decodeWordList(ast) {
    var codes = [];
