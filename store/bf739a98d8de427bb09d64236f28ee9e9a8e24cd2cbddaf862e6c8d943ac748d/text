            body: JSON.stringify({ payload: payload, auth: auth }),
          });
          refreshForum();
        });
      });
    } catch (err) {
      list.innerHTML = '<div class="hx-fm-empty">Could not load forum: ' + escHtml(err.message) + '</div>';
    }
  }

  async function refreshKGView() {
