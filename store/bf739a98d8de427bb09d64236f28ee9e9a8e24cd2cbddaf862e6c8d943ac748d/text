    contents.push({ role: 'user', parts: [{ text: ctxPrefix + question }] });

    var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(byokModel) + ':streamGenerateContent?alt=sse';
    var res = await fetch(url, {
