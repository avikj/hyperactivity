  function wireWindowDragAndResize(d) {
    var head = d.querySelector('.hx-hub-head');
    var resizer = d.querySelector('.hx-win-resize');
    if (head) {
      head.addEventListener('pointerdown', function (e) {
        if (e.target.closest('button')) return;
        e.preventDefault();
        var r = d.getBoundingClientRect();
        var sx = e.clientX, sy = e.clientY, sl = r.left, st = r.top;
        d.style.left = sl + 'px';
        d.style.top = st + 'px';
        d.style.right = 'auto';
        d.style.bottom = 'auto';
        d.style.width = r.width + 'px';
        d.style.height = r.height + 'px';
        d.classList.add('dragging');
        function onMove(ev) {
          var nl = Math.min(window.innerWidth - 120, Math.max(8, sl + (ev.clientX - sx)));
          var nt = Math.min(window.innerHeight - 80, Math.max(50, st + (ev.clientY - sy)));
          d.style.left = nl + 'px';
          d.style.top = nt + 'px';
        }
        function onUp() {
          d.classList.remove('dragging');
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onUp);
          saveGeom(d);
        }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
      });
      head.addEventListener('dblclick', function (e) {
        if (e.target.closest('button')) return;
        d.style.left = ''; d.style.top = ''; d.style.right = ''; d.style.bottom = ''; d.style.width = ''; d.style.height = '';
        try { localStorage.removeItem(GEOM_KEY); } catch (_) {}
      });
    }
    if (resizer) {
      resizer.addEventListener('pointerdown', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var r = d.getBoundingClientRect();
        var sx = e.clientX, sy = e.clientY, sw = r.width, sh = r.height;
        d.style.left = r.left + 'px';
        d.style.top = r.top + 'px';
        d.style.right = 'auto';
        d.style.bottom = 'auto';
        d.classList.add('dragging');
        function onMove(ev) {
          var nw = Math.min(window.innerWidth - r.left - 8, Math.max(340, sw + (ev.clientX - sx)));
          var nh = Math.min(window.innerHeight - r.top - 8, Math.max(340, sh + (ev.clientY - sy)));
          d.style.width = nw + 'px';
          d.style.height = nh + 'px';
        }
        function onUp() {
          d.classList.remove('dragging');
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onUp);
          saveGeom(d);
        }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
      });
    }
  }

