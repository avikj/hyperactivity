        '<div style="font-size:11px;opacity:.78;margin-bottom:6px">Key stays strictly in your browser (never sent to hyperactivity.ai). Gated to <code>gemini-4-neon</code> &amp; <code>gemini-4-carbon</code> only.</div>' +
        '<div class="hx-kg-row">' +
          '<input id="hx-byok-key" type="password" autocomplete="off" placeholder="AIza… Gemini API key" value="' + escHtml(byokKeyMem) + '">' +
          '<select id="hx-byok-model" style="background:inherit;color:inherit;border:1px solid currentColor;padding:3px 6px;font:11px ui-monospace,monospace">' +
            '<option value="gemini-4-neon"' + (byokModel === 'gemini-4-neon' ? ' selected' : '') + '>gemini-4-neon</option>' +
            '<option value="gemini-4-carbon"' + (byokModel === 'gemini-4-carbon' ? ' selected' : '') + '>gemini-4-carbon</option>' +
          '</select>' +
          '<button type="button" class="hx-wasm-btn" id="hx-byok-verify">verify &amp; connect</button>' +
          (byokVerified ? '<button type="button" class="hx-put-btn danger" id="hx-byok-clear">clear</button>' : '') +
        '</div>' +
        '<label class="hx-root-toggle" style="margin-top:6px"><input type="checkbox" id="hx-byok-sess"> remember for this browser tab session only</label>' +
        '<div id="hx-byok-stat" style="font:11px ui-monospace,monospace;margin-top:4px;color:' + (byokVerified ? '#26d07c' : 'inherit') + '">' + escHtml(byokStatusMsg || 'Not connected (uses server oracle if online)') + '</div>' +
      '</div>' +
      '<div class="hx-kg-card">' +
        '<div class="hx-kg-h">01 · Sovereign Identity (WebCrypto ECDSA P-256)</div>' +
        '<div class="hx-kg-did"><code>' + escHtml(id.did) + '</code>' + (id.isRootLocal ? ' <span class="hx-root-badge">root@hyperactivity.ai ✓</span>' : '') + '</div>' +
        '<div class="hx-kg-row">' +
          '<input id="hx-id-handle" type="text" placeholder="Display handle (optional)" value="' + escHtml(id.handle || '') + '">' +
          '<button type="button" class="hx-wasm-btn" id="hx-id-save">save</button>' +
          '<button type="button" class="hx-wasm-btn" id="hx-id-export">export key</button>' +
        '</div>' +
        '<label class="hx-root-toggle"><input type="checkbox" id="hx-root-chk"' + (id.isRootLocal ? ' checked' : '') + '> preview local <b>root@hyperactivity.ai</b> signing mode</label>' +
      '</div>' +
      '<div class="hx-kg-card">' +
        '<div class="hx-kg-h">02 · Sovereign hx-cas-v1 Overlay (root_you · ' + overlayMods.length + ')</div>' +
        ovHtml +
        (overlayMods.length ? '<div class="hx-kg-row" style="margin-top:8px"><button type="button" class="hx-wasm-btn" id="hx-ov-rewind-all">rewind all → root_public</button></div>' : '') +
