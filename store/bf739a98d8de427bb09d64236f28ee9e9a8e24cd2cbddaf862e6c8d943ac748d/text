  function renderCanvasOps(canvas, opsAst) {
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var ops = decodeListAst(opsAst);
    ops.forEach(function (op) {
      if (!Array.isArray(op) || !op.length) return;
      var k = op[0];
      if (k === 'cv-clear') {
        ctx.fillStyle = safeHex(decodeWordList(op[1]), '#0a0a0e');
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      } else if (k === 'cv-rect') {
        ctx.fillStyle = safeHex(decodeWordList(op[5]), '#ff0a94');
        ctx.fillRect(decodeWord(op[1]), decodeWord(op[2]), decodeWord(op[3]), decodeWord(op[4]));
      } else if (k === 'cv-circle') {
        ctx.fillStyle = safeHex(decodeWordList(op[4]), '#ff0a94');
        ctx.beginPath();
        ctx.arc(decodeWord(op[1]), decodeWord(op[2]), Math.max(1, decodeWord(op[3])), 0, Math.PI * 2);
        ctx.fill();
      } else if (k === 'cv-line') {
        ctx.strokeStyle = safeHex(decodeWordList(op[5]), '#4da3ff');
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(decodeWord(op[1]), decodeWord(op[2]));
        ctx.lineTo(decodeWord(op[3]), decodeWord(op[4]));
        ctx.stroke();
      } else if (k === 'cv-text') {
        ctx.fillStyle = safeHex(decodeWordList(op[4]), '#ffffff');
        ctx.font = '600 11px ui-monospace,monospace';
        ctx.fillText(decodeWordList(op[3]), decodeWord(op[1]), decodeWord(op[2]));
      }
    });
  }

