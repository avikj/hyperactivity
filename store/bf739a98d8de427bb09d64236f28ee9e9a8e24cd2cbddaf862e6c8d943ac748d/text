      updateIdentityMeta({ handle: body.querySelector('#hx-id-handle').value }).then(function () { refreshKGView(); });
    });
    body.querySelector('#hx-root-chk').addEventListener('change', function (e) {
      updateIdentityMeta({ isRootLocal: !!e.target.checked }).then(function () { refreshKGView(); });
    });
    body.querySelector('#hx-id-export').addEventListener('click', function () {
      var raw = localStorage.getItem(ID_KEY) || '{}';
      if (navigator.clipboard) navigator.clipboard.writeText(raw).catch(function () {});
      window.alert('Your sovereign keypair JWK has been copied to clipboard. Store it safely to sign from any device.');
    });
    body.querySelectorAll('[data-ov-insp]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (window.hxView && window.hxView.inspect) window.hxView.inspect(b.getAttribute('data-ov-insp'), null, null);
      });
    });
    body.querySelectorAll('[data-ov-del]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (window.hxView && window.hxView.casDelete) {
          var delP = b.getAttribute('data-ov-del');
          window.hxView.casDelete(delP).then(function () { notifyCasSync('cas-del', delP); refreshKGView(); });
        }
      });
    });
    var rewAll = body.querySelector('#hx-ov-rewind-all');
    if (rewAll) {
      rewAll.addEventListener('click', function () {
        Promise.all(overlayMods.map(function (m) { return window.hxView.casDelete(m.path); })).then(function () { refreshKGView(); });
      });
    }
    body.querySelector('#hx-pkg-export').addEventListener('click', function () {
      var blob = new Blob([JSON.stringify({ did: id.did, exportedAt: new Date().toISOString(), graph: pkg, overlay: overlayMods }, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'hyperactivity-personal-kg.json';
      a.click();
    });
    body.querySelectorAll('[data-del]').forEach(function (b) {
      b.addEventListener('click', function () { deleteHighlight(b.getAttribute('data-del')); refreshKGView(); });
    });
    body.querySelectorAll('[data-note]').forEach(function (ta) {
      ta.addEventListener('change', function () { updateHighlightNote(ta.getAttribute('data-note'), ta.value); });
    });
  }

  // ==================== 5. MOUNT NAV TRIGGERS & HOOK VERIFY TRACKING ====================
  function mount() {
    recordVisit();
    applySavedHighlightsOnPage();
    wireSelectionPopover();

    // Wrap window.hxView.verifyModule to record engagement mastery automatically
    if (window.hxView && typeof window.hxView.verifyModule === 'function') {
      var origVerify = window.hxView.verifyModule;
      window.hxView.verifyModule = function (modPath, onProg) {
        return origVerify(modPath, onProg).then(function (r) {
          if (r && r.ok) recordVerifiedModule(modPath);
          return r;
        });
      };
    }

    var navLinks = document.querySelector('nav .links');
    if (navLinks && !document.getElementById('hx-oracle-btn')) {
      var orBtn = document.createElement('button');
      orBtn.id = 'hx-oracle-btn';
      orBtn.type = 'button';
      orBtn.innerHTML = '<span class="hx-pulse-orb"></span>Supergenius';
      orBtn.title = 'Ask Supergenius & Signed Forum (o)';
      orBtn.addEventListener('click', function (e) { e.stopPropagation(); openHub('oracle'); });

      var kgBtn = document.createElement('button');
      kgBtn.id = 'hx-kg-btn';
      kgBtn.type = 'button';
      kgBtn.textContent = 'My KG';
      kgBtn.title = 'Your Sovereign Identity, Highlights & Notes (k)';
      kgBtn.addEventListener('click', function (e) { e.stopPropagation(); openHub('kg'); });

      var anchor = navLinks.querySelector('#hx-cmd-trigger') || navLinks.querySelector('.tbtn');
      if (anchor) {
        navLinks.insertBefore(orBtn, anchor);
        navLinks.insertBefore(kgBtn, anchor);
      } else {
        navLinks.appendChild(orBtn);
        navLinks.appendChild(kgBtn);
      }
    }

    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      var tag = (e.target && e.target.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (e.target && e.target.isContentEditable)) return;
      if (e.key === 'Escape') { closeHub(); return; }
      var p = window.location.pathname || '';
      if (p === '/daw' || p === '/sound') return; // preserve QWERTY piano keys on /daw
      if (e.key === 'o' || e.key === 'O') { e.preventDefault(); openHub('oracle'); return; }
      if (e.key === 'k' || e.key === 'K') { e.preventDefault(); openHub('kg'); return; }
    });

    window.hxKG = {
      openOracle: function (q) { openHub('oracle'); if (q) askOracle(q); },
      openForum: function () { openHub('forum'); },
      openMyKG: function () { openHub('kg'); },
      projectEffect: function (ast) { var log = []; projectCheckedEffect(ast, log); return log; },
      parseCubical: parseCubicalNormalForm,
      identity: ensureIdentity,
      graph: loadPKG,
    };
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mount);
  else mount();
})();
