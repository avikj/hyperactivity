        var st = body.querySelector('#hx-byok-stat');
        st.style.color = ''; st.textContent = 'verifying model access (gemini-4-neon / carbon only)…';
        try {
          var res = await verifyAndEnableByok(
            body.querySelector('#hx-byok-key').value,
            body.querySelector('#hx-byok-model').value,
            !!body.querySelector('#hx-byok-sess').checked
