      if (w.charAt(0) === '#') codes.push(parseInt(w.slice(1), 10) || 32);
      cur = cur[2];
    }
    try { return new TextDecoder().decode(new Uint8Array(codes)); }
    catch (_) { return String.fromCharCode.apply(null, codes); }
  }

