      var et = await res.text().catch(function () { return ''; });
      throw new Error('Gemini ' + byokModel + ' HTTP ' + res.status + ': ' + et.slice(0, 180));
    }
    var full = '';
    if (res.body && res.body.getReader) {
      var reader = res.body.getReader(), dec = new TextDecoder(), buf = '';
      while (true) {
        var rd = await reader.read();
        if (rd.done) break;
        buf += dec.decode(rd.value, { stream: true });
        var lines = buf.split('\n');
        buf = lines.pop() || '';
        for (var i = 0; i < lines.length; i++) {
          var ln = lines[i].trim();
          if (ln.indexOf('data:') === 0) {
            var payload = ln.slice(5).trim();
            if (!payload || payload === '[DONE]') continue;
            try {
              var obj = JSON.parse(payload);
              var parts = obj.candidates && obj.candidates[0] && obj.candidates[0].content && obj.candidates[0].content.parts;
              if (parts) {
                parts.forEach(function (p) { if (p.text) { full += p.text; onDelta(full); } });
              }
            } catch (_) {}
          }
        }
      }
    } else {
      var raw = await res.json();
      var ps = raw.candidates && raw.candidates[0] && raw.candidates[0].content && raw.candidates[0].content.parts;
      if (ps) full = ps.map(function (p) { return p.text || ''; }).join('');
