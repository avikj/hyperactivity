            '<div class="hx-kg-quote">“' + escHtml(h.quote) + '”</div>' +
            '<textarea class="hx-kg-note" data-note="' + escHtml(h.id) + '" rows="2" placeholder="Add personal note…">' + escHtml(h.note || '') + '</textarea>' +
