h3d-one-hop-k4 : Nat → Nat → List BZ → Nat → Nat → List BZ → BZ
h3d-one-hop-k4 u1 u2 fa w1 w2 fb =
  bz-add
    (bz-add
      (sc-one-hop-edge 0 0 1 u1 u2 fa w1 w2 fb)
      (bz-add (sc-one-hop-edge 1 0 2 u1 u2 fa w1 w2 fb)
              (sc-one-hop-edge 2 0 3 u1 u2 fa w1 w2 fb)))
    (bz-add
      (sc-one-hop-edge 3 1 2 u1 u2 fa w1 w2 fb)
      (bz-add (sc-one-hop-edge 4 2 3 u1 u2 fa w1 w2 fb)
              (sc-one-hop-edge 5 3 1 u1 u2 fa w1 w2 fb)))
