b2-tmpsof : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tmpsof mm_ tmps k kq_ =
  b2-mget mm_ tmps k (λ is0 → let mm_10299 = b2-dep mm_ is0 in if (not (%weq is0 hv2-none)) then (kq_ (h4-depl mm_10299 (is0))) else (b2-map mm_10299 #0 (λ mp → let mm_10300 = b2-dep mm_10299 mp in let n_10302 = #2 in scmd (w-load (mm_10300)) (λ at_10301 → let mm_10303 = b2-dep mm_10300 at_10301 in scmd (w-store (mm_10303) ((%wadd at_10301 n_10302))) (λ uu_10304 → let mm_10305 = hv2-u mm_10303 uu_10304 in let at = at_10301 in let i_10306 = at in let v_10307 = mp in scmd (w-store ((b2-a mm_10305 i_10306)) (v_10307)) (λ uu_10308 → let mm_10309 = hv2-u mm_10305 uu_10308 in let i_10310 = (%wadd at #1) in let v_10311 = #0 in scmd (w-store ((b2-a mm_10309 i_10310)) (v_10311)) (λ uu_10312 → let mm_10313 = hv2-u mm_10309 uu_10312 in b2-mset mm_10313 tmps k at (λ dd_10314 → let mm_10315 = b2-dep mm_10313 dd_10314 in kq_ (h4-depl mm_10315 (at))))))))))
