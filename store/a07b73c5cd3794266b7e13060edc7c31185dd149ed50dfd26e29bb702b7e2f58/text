  (sl-ln "void hx_vp_render_binaural_48k(uint32_t triad, uint32_t az, uint32_t* phase_io, float* out_l, float* out_r, uint32_t nframes) {"
  (sl-ln "  uint32_t root = (triad >> 1u) % 12u, minor = triad & 1u;"
  (sl-ln "  uint32_t third = (root + (minor ? 3u : 4u)) % 12u, fifth = (root + 7u) % 12u;"
