b2-forceg : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-forceg mm_ zero t kq_ =
  kq_ (h4-depl mm_ (t))
b2-forceg mm_ (suc f) t kq_ =
  let t_661 = t in scmd (w-load ((b2-a mm_ t_661))) (λ x_660 → let mm_662 = b2-dep mm_ x_660 in let tg = (%wand x_660 #255) in if (%weq tg b2-VAR) then (let t_664 = t in let j_665 = #2 in scmd (w-load ((b2-a mm_662 (%wadd t_664 (%wadd #2 j_665))))) (λ x_663 → let mm_666 = b2-dep mm_662 x_663 in let v = x_663 in if (%weq v #0) then (kq_ (h4-depl mm_666 (t))) else (b2-forceg mm_666 f v kq_))) else (kq_ (h4-depl mm_662 (t))))
