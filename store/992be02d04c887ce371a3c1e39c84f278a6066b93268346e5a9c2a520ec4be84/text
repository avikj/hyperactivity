vx-thm-sim-sound : {S1 S2 I O : Type} →
  (s10 : S1) → (stp1 : S1 → I → O × S1) → (c1 : Word) →
  (s20 : S2) → (stp2 : S2 → I → O × S2) → (c2 : Word) →
  (R : S1 → S2 → Type) →
  R s10 s20 →
  ((s1 : S1) → (s2 : S2) → (x : I) → R s1 s2 →
    (fst (stp1 s1 x) ≡ fst (stp2 s2 x)) × R (snd (stp1 s1 x)) (snd (stp2 s2 x))) →
  (tr : List I) →
  vx-run (mk-vxsys s10 stp1 c1) tr ≡ vx-run (mk-vxsys s20 stp2 c2) tr
vx-thm-sim-sound s10 stp1 c1 s20 stp2 c2 R h0 hstep tr =
  vx-thm-sim-exec stp1 stp2 R hstep s10 s20 h0 tr
