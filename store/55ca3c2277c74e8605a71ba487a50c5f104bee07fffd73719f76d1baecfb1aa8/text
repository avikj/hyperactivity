r4d-grid3x3-fubini : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → R4dAb A z add neg →
  (r0 r1 r2 : A × (A × A)) →
  add (r4d-sum3 A add r0) (add (r4d-sum3 A add r1) (r4d-sum3 A add r2)) ≡
  r4d-sum3 A add (r4d-v3add A add r0 (r4d-v3add A add r1 r2))
r4d-grid3x3-fubini A z add neg ab r0 r1 r2 =
  concat
    (cong (λ t → add (r4d-sum3 A add r0) t) (r4d-sum3-hom A z add neg ab r1 r2))
    (r4d-sum3-hom A z add neg ab r0 (r4d-v3add A add r1 r2))
