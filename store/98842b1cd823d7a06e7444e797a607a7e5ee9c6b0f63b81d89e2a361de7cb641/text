-- Exact modular 1-cocycle M_{01} * M_{12} = M_{02} (= 2 * 2 = 4) and time reversal M_{02} * M_{20} = 1.
qt-boltz-cocycle : both
  (qt-bq-eq (bq-mul (qt-mod-ratio qt-w4 qt-w2) (qt-mod-ratio qt-w2 qt-w1)) (qt-mod-ratio qt-w4 qt-w1))
  (qt-bq-eq (bq-mul (qt-mod-ratio qt-w4 qt-w1) (qt-mod-ratio qt-w1 qt-w4)) (bq-make true bin-one bin-one)) ≡ true
qt-boltz-cocycle = refl
