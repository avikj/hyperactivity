b2-lget : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-lget mm_ zero l k kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-lget mm_ (suc f) l k kq_ =
  if (%weq l #0) then (kq_ (h4-depl mm_ (hv2-none))) else (let i_523 = l in scmd (w-load ((b2-a mm_ i_523))) (λ x_522 → let mm_524 = b2-dep mm_ x_522 in let x = x_522 in if (%weq x k) then (let i_526 = (%wadd l #1) in scmd (w-load ((b2-a mm_524 i_526))) (λ x_525 → let mm_527 = b2-dep mm_524 x_525 in let v = x_525 in kq_ (h4-depl mm_527 (v)))) else (let i_529 = (%wadd l #2) in scmd (w-load ((b2-a mm_524 i_529))) (λ x_528 → let mm_530 = b2-dep mm_524 x_528 in let nx = x_528 in b2-lget mm_530 f nx k kq_))))
