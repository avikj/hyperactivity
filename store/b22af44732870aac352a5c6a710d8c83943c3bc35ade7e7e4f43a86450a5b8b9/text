-- One lossless step of the continuous remixing loop:
-- synthesizes the prime-music wave at `cursor`, permanently appends it to `trace`, advances cursor!
rmx-step : List Word → RemixState → RemixState
rmx-step actor (rstate n log) =
  case pw-encode n of
    pwave _ _ _ hz →
      rstate (%wsucc n) (tr-record (tevent tk-wave actor "prime-music-knot" hz) log)
