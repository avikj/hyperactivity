b2-ftab : Word → (Word → Step W Word) → Step W Word
b2-ftab mm_ kq_ =
  scmd (w-load ((b2-HR mm_ #23))) (λ t → let mm_16805 = b2-dep mm_ t in if (not (%weq t #0)) then (kq_ (h4-depl mm_16805 (t))) else (b2-vec mm_16805  (λ v → let mm_16806 = b2-dep mm_16805 v in scmd (w-store ((b2-HR mm_16806 #23)) (v)) (λ uu_16807 → let mm_16808 = hv2-u mm_16806 uu_16807 in kq_ (h4-depl mm_16808 (v))))))
