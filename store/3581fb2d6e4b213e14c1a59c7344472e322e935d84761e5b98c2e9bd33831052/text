b2-tfillg : Word → Nat → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tfillg mm_ zero bk tel xs ctx def s j kq_ =
  kq_ (h4-depl mm_ (tel))
b2-tfillg mm_ (suc f) bk tel xs ctx def s j kq_ =
  let a_10701 = xs in scmd (w-load ((b2-a mm_ a_10701))) (λ x_10700 → let mm_10702 = b2-dep mm_ x_10700 in let n = x_10700 in if (%weq j n) then (kq_ (h4-depl mm_10702 (tel))) else (b2-thead mm_10702 bk tel ctx def s (λ h → let mm_10703 = b2-dep mm_10702 h in if (%weq h b2-ERR) then (kq_ (h4-depl mm_10703 b2-ERR)) else (let t_10705 = h in let j_10706 = #4 in scmd (w-load ((b2-a mm_10703 (%wadd t_10705 (%wadd #2 j_10706))))) (λ x_10704 → let mm_10707 = b2-dep mm_10703 x_10704 in let vB = x_10704 in let a_10709 = xs in let j_10710 = j in scmd (w-load ((b2-a mm_10707 (%wadd a_10709 (%wsucc j_10710))))) (λ x_10708 → let mm_10711 = b2-dep mm_10707 x_10708 in let x = x_10708 in b2-body mm_10711 bk vB x (λ t2 → let mm_10712 = b2-dep mm_10711 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_10712 b2-ERR)) else (b2-tfillg mm_10712 f bk t2 xs ctx def s (%wsucc j) kq_))))))))
