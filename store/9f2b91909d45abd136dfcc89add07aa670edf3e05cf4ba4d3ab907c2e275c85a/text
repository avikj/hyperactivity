b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_2774 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_2774 #7))) (λ kd → let mm_2775 = b2-dep mm_2774 kd in scmd (w-load ((b2-HR mm_2775 #8))) (λ v → let mm_2776 = b2-dep mm_2775 v in if (%weq kd #0) then (kq_ (h4-depl mm_2776 (v))) else (scmd (w-load ((b2-HR mm_2776 #11))) (λ md2 → let mm_2777 = b2-dep mm_2776 md2 in scmd (w-load ((b2-HR mm_2777 #12))) (λ a2 → let mm_2778 = b2-dep mm_2777 a2 in scmd (w-load ((b2-HR mm_2778 #13))) (λ b2 → let mm_2779 = b2-dep mm_2778 b2 in scmd (w-load ((b2-HR mm_2779 #14))) (λ c2 → let mm_2780 = b2-dep mm_2779 c2 in b2-wnfrun mm_2780 f rx bk md2 a2 b2 c2 kq_))))))))
