hx-main : List (List Word) → Step W Word
hx-main args =
  let c = hx-cmd args
      r = hx-rest args
  in if cli-eq c "hxp" then hxp-main r
     else if cli-eq c "treasury" then tr-main r
     else if cli-eq c "lux" then lux-main r
     else if cli-eq c "verify" then vx-main r
     else if cli-eq c "geodesic" then geo-main r
     else if cli-eq c "sovereign" then sov-main r
     else if cli-eq c "genesis" then gn-main r
     else if cli-eq c "tui" then tui-main r
     else if cli-eq c "agent" then ag-main r
     else if cli-eq c "swarm" then sw-main r
     else if cli-eq c "poly" then poly-main r
     else if cli-eq c "endgame" then eg-main r
     else if cli-eq c "beast" then bst-main r
     else if cli-eq c "kexpr" then kexpr-main r
     else if cli-eq c "strike" then str-main r
     else if cli-eq c "tower" then tw-main r
     else if cli-eq c "cosmos" then cos-main r
     else if cli-eq c "omni" then omni-main r
     else if cli-eq c "wetlab" then wl-main r
     else if cli-eq c "supercomp" then sc-main r
     else if cli-eq c "meta" then ms-main r
     else if cli-eq c "inet" then io-main r
     else if cli-eq c "psc" then psc-main r
     else if cli-eq c "ir" then kir-main r
     else if cli-eq c "matter" then hmat-main r
     else if cli-eq c "solve" then hs-solve-main r
     else if cli-eq c "audit" then ha-main r
     else if cli-eq c "web" then hx-web-main r
     else if cli-eq c "space" then s256-main r
     else if cli-eq c "discover" then hd-main r
     else if cli-eq c "loop" then hxl-main r
     else if cli-eq c "hf" then hhf-main r
     else if cli-eq c "zip" then hxz-main (cons "c" r)
     else if cli-eq c "unzip" then hxz-main (cons "d" r)
     else if cli-eq c "cm" then hcm-main r
     else if cli-eq c "tensor" then hxt-main r
     else if cli-eq c "gpu" then hg-main r
     else if cli-eq c "llmzip" then hlz-main r
     else if cli-eq c "book" then hxb-main r
     else if cli-eq c "node" then hxn-main r
     else if cli-eq c "tapeout" then hxtp-main r
     else if cli-eq c "alu" then cir-main r
     else if cli-eq c "merge" then hm-main r
     else if cli-eq c "httpd" then hh-main r
     else if cli-eq c "synth" then hs-main r
     else hx-usage
