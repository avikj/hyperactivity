-- THEOREM 3: UNBOUNDED COINDUCTIVE OPTIMAL-WITNESS COST MONOTONICITY OVER ALL WAVES t : Nat!
-- Every time a shorter witness for any semantic function f is discovered, the atlas strictly compresses!
bst-thm-opt-cost-monotone : (traj : Nat → AtlasState) →
  ((t : Nat) → hm-le (bst-cost (traj (suc t))) (bst-cost (traj t)) ≡ true) →
  (t : Nat) → hm-le (bst-cost (traj t)) (bst-cost (traj zero)) ≡ true
bst-thm-opt-cost-monotone traj step = sc-thm-dc-gen-monotone (λ t → bst-cost (traj t)) step
