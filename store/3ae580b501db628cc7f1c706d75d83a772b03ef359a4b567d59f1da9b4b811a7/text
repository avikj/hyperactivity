-- the base's events marked b
b2-markbase : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13290 = bk in let j_13291 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13290 (%wadd #2 j_13291))))) (λ x_13289 → let mm_13292 = b2-dep mm_ x_13289 in let ov = x_13289 in let v_13295 = ov in let j_13296 = j in scmd (w-load ((b2-a mm_13292 (%wadd v_13295 #2)))) (λ d_13294 → let mm_13297 = b2-dep mm_13292 d_13294 in scmd (w-load ((b2-a mm_13297 (%wadd d_13294 (%wsucc j_13296))))) (λ x_13293 → let mm_13298 = b2-dep mm_13297 x_13293 in let k = x_13293 in b2-tld mm_13298 bk k (λ t → let mm_13299 = b2-dep mm_13298 t in let t_13301 = t in scmd (w-load ((b2-a mm_13299 t_13301))) (λ x_13300 → let mm_13302 = b2-dep mm_13299 x_13300 in let tg = (%wand x_13300 #255) in let t_13303 = t in let j_13304 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13305 = #1 in scmd (w-store ((b2-a mm_13302 (%wadd t_13303 (%wadd #2 j_13304)))) (v_13305)) (λ uu_13306 → let mm_13307 = hv2-u mm_13302 uu_13306 in b2-markbase mm_13307 f bk (%wsucc j) n kq_)))))))
