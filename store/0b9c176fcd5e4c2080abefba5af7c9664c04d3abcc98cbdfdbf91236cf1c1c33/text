b2-rshow : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-rshow mm_ zero file rs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-rshow mm_ (suc f) file rs j acc kq_ =
  let a_1311 = rs in scmd (w-load ((b2-a mm_ a_1311))) (λ x_1310 → let mm_1312 = b2-dep mm_ x_1310 in let n = x_1310 in if (%weq j n) then (kq_ (h4-depl mm_1312 (acc))) else (let a_1314 = rs in let j_1315 = j in scmd (w-load ((b2-a mm_1312 (%wadd a_1314 (%wsucc j_1315))))) (λ x_1313 → let mm_1316 = b2-dep mm_1312 x_1313 in let k = x_1313 in b2-nameshow mm_1316 file k (λ s → let mm_1317 = b2-dpl mm_1316 s in b2-rshow mm_1317 f file rs (%wsucc j) (list-append acc (list-append " - " (list-append s "{}"))) kq_))))
