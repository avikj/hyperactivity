b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_7714 → let mm_7715 = b2-dep mm_ dd_7714 in b2-take mm_7715 p "-" (λ m → let mm_7716 = b2-dep mm_7715 m in if (%weq m #1) then (kq_ (h4-depl mm_7716 (b2-NONE))) else (b2-take mm_7716 p "+" (λ pl → let mm_7717 = b2-dep mm_7716 pl in if (%weq pl #1) then (kq_ (h4-depl mm_7717 (b2-MANY))) else (kq_ (h4-depl mm_7717 (b2-LONE))))))))
