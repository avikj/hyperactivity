  if (%weq j e) then (let a_13391 = cnt in let b_13392 = ls in let c_13393 = #0 in let n_13395 = #3 in scmd (w-load (mm_)) (λ at_13394 → let mm_13396 = b2-dep mm_ at_13394 in scmd (w-store (mm_13396) ((%wadd at_13394 n_13395))) (λ uu_13397 → let mm_13398 = hv2-u mm_13396 uu_13397 in let at_13390 = at_13394 in let i_13399 = at_13390 in let v_13400 = a_13391 in scmd (w-store ((b2-a mm_13398 i_13399)) (v_13400)) (λ uu_13401 → let mm_13402 = hv2-u mm_13398 uu_13401 in let i_13403 = (%wadd at_13390 #1) in let v_13404 = b_13392 in scmd (w-store ((b2-a mm_13402 i_13403)) (v_13404)) (λ uu_13405 → let mm_13406 = hv2-u mm_13402 uu_13405 in let i_13407 = (%wadd at_13390 #2) in let v_13408 = c_13393 in scmd (w-store ((b2-a mm_13406 i_13407)) (v_13408)) (λ uu_13409 → let mm_13410 = hv2-u mm_13406 uu_13409 in let r = at_13390 in kq_ (h4-depl mm_13410 (r)))))))) else (let a_13412 = s in let j_13413 = j in scmd (w-load ((b2-a mm_ (%wadd a_13412 (%wsucc j_13413))))) (λ x_13411 → let mm_13414 = b2-dep mm_ x_13411 in let c = x_13411 in if (%weq c #10) then (b2-nlcount mm_13414 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_13414 f s (%wsucc j) e cnt ls kq_)))
