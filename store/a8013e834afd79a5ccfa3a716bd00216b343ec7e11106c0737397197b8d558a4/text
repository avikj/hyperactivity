  b2-at mm_ p w (λ r → let mm_7771 = b2-dep mm_ r in if (%weq r #0) then (kq_ (h4-depl mm_7771 (#0))) else (let p_7773 = p in let i_7775 = (%wadd p_7773 #1) in scmd (w-load ((b2-a mm_7771 i_7775))) (λ x_7774 → let mm_7776 = b2-dep mm_7771 x_7774 in let x_7772 = x_7774 in let i = x_7772 in let p_7777 = p in let v_7778 = (%wadd i (cli-len w)) in let i_7779 = (%wadd p_7777 #1) in let v_7780 = v_7778 in scmd (w-store ((b2-a mm_7776 i_7779)) (v_7780)) (λ uu_7781 → let mm_7782 = hv2-u mm_7776 uu_7781 in kq_ (h4-depl mm_7782 (#1))))))
