  scmd ((w-sys #900 #0 #0 #0 #0 #0 #0)) (λ mk → let mm_2981 = b2-dep mm_ mk in scmd (w-store ((b2-HR mm_2981 #10)) (#0)) (λ uu_2982 → let mm_2983 = hv2-u mm_2981 uu_2982 in rx mm_2983 md bk a b c #0 (λ r → let mm_2984 = b2-dep mm_2983 r in scmd (w-store ((b2-HR mm_2984 #7)) ((the Word (if %weq r b2-SUSP then #1 else #0)))) (λ uu_2985 → let mm_2986 = hv2-u mm_2984 uu_2985 in scmd (w-store ((b2-HR mm_2986 #8)) (r)) (λ uu_2987 → let mm_2988 = hv2-u mm_2986 uu_2987 in (scmd (w-sys #901 #0 #0 #0 #0 #0 #0) kq_))))))
