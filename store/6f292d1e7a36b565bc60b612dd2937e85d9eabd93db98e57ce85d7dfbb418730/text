b2-streqg : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-streqg mm_ zero a b j n kq_ =
  kq_ (h4-depl mm_ (#1))
b2-streqg mm_ (suc f) a b j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#1))) else (let a_214 = a in let j_215 = j in scmd (w-load ((b2-a mm_ (%wadd a_214 (%wsucc j_215))))) (λ x_213 → let mm_216 = b2-dep mm_ x_213 in let x = x_213 in let a_218 = b in let j_219 = j in scmd (w-load ((b2-a mm_216 (%wadd a_218 (%wsucc j_219))))) (λ x_217 → let mm_220 = b2-dep mm_216 x_217 in let y = x_217 in if (not (%weq x y)) then (kq_ (h4-depl mm_220 (#0))) else (b2-streqg mm_220 f a b (%wsucc j) n kq_))))
