  let a_7049 = s in scmd (w-load ((b2-a mm_ a_7049))) (λ x_7048 → let mm_7050 = b2-dep mm_ x_7048 in let n = x_7048 in if (not (%wlt i n)) then (kq_ (h4-depl mm_7050 (hv2-none))) else (let a_7052 = s in let j_7053 = i in scmd (w-load ((b2-a mm_7050 (%wadd a_7052 (%wsucc j_7053))))) (λ x_7051 → let mm_7054 = b2-dep mm_7050 x_7051 in let c = x_7051 in kq_ (h4-depl mm_7054 (c)))))
