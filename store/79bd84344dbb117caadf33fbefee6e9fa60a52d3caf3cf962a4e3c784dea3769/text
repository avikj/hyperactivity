-- Closed-form 2x2 implicit-midpoint determinant identity:
--   det(I - (dt/2)(J - R)) = (1 + ae)*(1 + am) + b^2 == 1 + ae + am + ae*am + b^2 > 0!
-- Proves unconditional non-singularity for all ae, am >= 0 and all b!
-- Variables (0..2): ae, am, b.
uf-ts-det-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
uf-ts-det-poly A ad mu q vs =
  (λ g _ sq →
    let ae = g 0; am = g 1; b = g 2
        one = q (fn-q 1 1)
        lhs = ad (mu (ad one ae) (ad one am)) (sq b)
        rhs = ad (ad (ad (ad one ae) am) (mu ae am)) (sq b)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
