-- for s, s + 1, … over k more values, d the remainder of s by 6: 6 Σ n² = s² + d (6 − d)
cv-well-from : Nat → Nat → Nat → Bool
cv-well-from k s d = if eqb (times 6 (cv-energy (snd (cv-walk ring6 (cv-fwd s 0) (cv-start ring6))))) (plus (times s s) (times d (monus 6 d)))
  then (case k of
    zero → true
    suc g → cv-well-from g (suc s) (if eqb d 5 then zero else suc d))
  else false
