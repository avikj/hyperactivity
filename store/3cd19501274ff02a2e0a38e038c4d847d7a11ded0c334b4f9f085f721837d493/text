b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_7601 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_7601 (#1))) else (b2-pstr mm_7601 p (λ s → let mm_7602 = b2-dep mm_7601 s in let p_7604 = p in let i_7606 = (%wadd p_7604 #1) in scmd (w-load ((b2-a mm_7602 i_7606))) (λ x_7605 → let mm_7607 = b2-dep mm_7602 x_7605 in let x_7603 = x_7605 in let i = x_7603 in let a_7609 = s in scmd (w-load ((b2-a mm_7607 a_7609))) (λ x_7608 → let mm_7610 = b2-dep mm_7607 x_7608 in let n = x_7608 in b2-col mm_7610 s i (λ c → let mm_7611 = b2-dep mm_7610 c in kq_ (h4-depl mm_7611 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
