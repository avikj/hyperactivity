-- the hop along link p of a vertex with links l0 l1 l2 l3 (doubled), inner labels k and kt, to x2 on the link, into
-- a vertex ((x w2) m) that becomes ((x2 w2) m2, ½) m
vh-sq : Nat → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → List Bool → Amp
vh-sq p l0 l1 l2 l3 k kt x2 w2 m m2 = case p of
  zero → hop-amp l0 x2 l1 k kt w2 m m2
  suc p1 → (case p1 of
    zero → hop-amp l1 x2 l0 k kt w2 m m2
    suc p2 → (case p2 of
      zero → hop-amp l2 x2 l3 kt k w2 m m2
      suc p3 → hop-amp l3 x2 l2 kt k w2 m m2))
