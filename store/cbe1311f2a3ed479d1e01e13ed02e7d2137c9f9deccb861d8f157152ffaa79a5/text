b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_2698 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_2698 #7))) (λ kd → let mm_2699 = b2-dep mm_2698 kd in scmd (w-load ((b2-HR mm_2699 #8))) (λ v → let mm_2700 = b2-dep mm_2699 v in if (%weq kd #0) then (kq_ (h4-depl mm_2700 (v))) else (scmd (w-load ((b2-HR mm_2700 #11))) (λ md2 → let mm_2701 = b2-dep mm_2700 md2 in scmd (w-load ((b2-HR mm_2701 #12))) (λ a2 → let mm_2702 = b2-dep mm_2701 a2 in scmd (w-load ((b2-HR mm_2702 #13))) (λ b2 → let mm_2703 = b2-dep mm_2702 b2 in scmd (w-load ((b2-HR mm_2703 #14))) (λ c2 → let mm_2704 = b2-dep mm_2703 c2 in b2-wnfrun mm_2704 f rx bk md2 a2 b2 c2 kq_))))))))
