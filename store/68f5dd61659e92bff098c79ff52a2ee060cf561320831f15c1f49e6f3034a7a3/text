b2-doend : Word → Word → (Word → Step W Word) → Step W Word
b2-doend mm_ p kq_ =
  b2-skip mm_ p (λ dd_8599 → let mm_8600 = b2-dep mm_ dd_8599 in b2-at mm_8600 p "=" (λ e → let mm_8601 = b2-dep mm_8600 e in b2-at mm_8601 p "==" (λ e2 → let mm_8602 = b2-dep mm_8601 e2 in b2-at mm_8602 p "=>" (λ e3 → let mm_8603 = b2-dep mm_8602 e3 in if (andB (%weq e #1) (andB (%weq e2 #0) (%weq e3 #0))) then (b2-pfailh mm_8603 p (list-append "a do-block let with its type (write " (cons #34 (list-append "x : T = ..." (cons #34 ")")))) (λ r → let mm_8604 = b2-dep mm_8603 r in kq_ (h4-depl mm_8604 (r)))) else (kq_ (h4-depl mm_8603 (#0)))))))
