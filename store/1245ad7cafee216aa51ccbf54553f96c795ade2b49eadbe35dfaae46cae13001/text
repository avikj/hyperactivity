b2-peek : Word → Word → (Word → Step W Word) → Step W Word
b2-peek mm_ p kq_ =
  b2-pstr mm_ p (λ s → let mm_7055 = b2-dep mm_ s in let p_7057 = p in let i_7059 = (%wadd p_7057 #1) in scmd (w-load ((b2-a mm_7055 i_7059))) (λ x_7058 → let mm_7060 = b2-dep mm_7055 x_7058 in let x_7056 = x_7058 in let i = x_7056 in b2-uat mm_7060 s i (λ c → let mm_7061 = b2-dep mm_7060 c in kq_ (h4-depl mm_7061 (c)))))
