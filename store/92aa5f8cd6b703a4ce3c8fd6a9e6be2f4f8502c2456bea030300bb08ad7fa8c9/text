-- THEOREM 5: AUTOPOIETIC CLOSED-LOOP SELF-MODIFICATION SOUNDNESS OVER ALL GENERATIONS g : Nat!
-- If every self-emitted, cubically-verified replacement net satisfies eval(P_{g+1}) === eval(P_g)
-- and cost(P_{g+1}) <= cost(P_g), then ALL unbounded self-modified generations preserve exact semantics & dominate gen 0!
eg-thm-autopoietic-sound : (P : Nat → INet) →
  ((g : Nat) → (env : Word → Bool) → in-eval env (P (suc g)) ≡ in-eval env (P g)) →
  (g : Nat) → (env : Word → Bool) → in-eval env (P g) ≡ in-eval env (P zero)
eg-thm-autopoietic-sound _ _    zero    _   = refl
eg-thm-autopoietic-sound P step (suc g) env = web-trans-b (step g env) (eg-thm-autopoietic-sound P step g env)
