tr-main : List (List Word) → Step W Word
tr-main args =
  let p    = tr-pref args
      solf = list-append p ".sol"
      cf   = list-append p ".c"
      mf   = list-append p ".metal"
      mhf  = list-append p "_metal.m"
  in scmd (w-file-write-named solf tir-solidity-contract) (λ bsol →
     scmd (w-file-write-named cf   tir-c11-tool) (λ bc →
     scmd (w-file-write-named mf   tir-metal-shader) (λ bm →
     scmd (w-file-write-named mhf  (tir-metal-host mf)) (λ bmh →
     scmd (w-file-write-named "/tmp/hx_agent_bus/treasury_live.hxsv" tr-hxsv-frame) (λ bhx →
     cli-say "[hx treasury] Sovereign Zero-VC Treasury, U256 Flash-Arb & On-Chain NAND-Verified PoUW Vault (44th engine, 0 postulates)"
       (cli-say "  Proved VC-Bypass : tr-thm-zero-dilution (100.00% founder equity all epochs) | codata TrCashflowStream productive fixpt"
       (cli-say "  Proved U256 DEX  : tr-thm-live-base-256bit-exact (handles >2^128 intermediate products + read-only Base RPC snapshot)"
       (cli-say "  Proved Cold-PoUW : tr-thm-legit-bounty-paid | tr-thm-forged-dag-rejected | tr-thm-mev-frontrun-blocked | 0-wei dust"
       (cli-say (list-append "  Emitted 4+HXSV   : "
         (list-append solf (list-append " (" (list-append (ce-dec bsol)
         (list-append "B) | " (list-append cf (list-append " (" (list-append (ce-dec bc)
         (list-append "B) | " (list-append mf (list-append " (" (list-append (ce-dec bm) "B) + 32B HXSV"))))))))))))
       (sdone #0))))))))))
