b2-ftab : Word → (Word → Step W Word) → Step W Word
b2-ftab mm_ kq_ =
  scmd (w-load ((b2-HR mm_ #23))) (λ t → let mm_16261 = b2-dep mm_ t in if (not (%weq t #0)) then (kq_ (h4-depl mm_16261 (t))) else (b2-vec mm_16261  (λ v → let mm_16262 = b2-dep mm_16261 v in scmd (w-store ((b2-HR mm_16262 #23)) (v)) (λ uu_16263 → let mm_16264 = hv2-u mm_16262 uu_16263 in kq_ (h4-depl mm_16264 (v))))))
