-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_11094 = s in let j_11095 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_11094 (%wadd #2 j_11095))))) (λ x_11093 → let mm_11096 = b2-dep mm_ x_11093 in let fl = x_11093 in kq_ (h4-depl mm_11096 (fl))))
