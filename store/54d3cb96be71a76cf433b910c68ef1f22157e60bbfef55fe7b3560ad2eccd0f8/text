-- Exact pure-rational inner factor R_gen of the general anisotropic Euclidean EPRL 4-simplex amplitude:
-- A_v^EPRL(f_ab, i_a) = sqrt(prod_a (i_a + 1) * Delta^2(e1,e2,i_a) * Delta^2(e3,e4,i_a)) * R_gen.
sf2-eprl-gen-R : Sf2Face → Sf2Face → Sf2Face → Sf2Face → Sf2Face → Sf2Face → Sf2Face → Sf2Face → Sf2Face → Sf2Face →
  Nat → Nat → Nat → Nat → Nat → BQ
sf2-eprl-gen-R f12 f13 f14 f15 f23 f24 f25 f34 f35 f45 i1 i2 i3 i4 i5 =
  bq-mul
    (bq-mul
      (bq-mul (bq-mul (sf2-face-pref f12) (sf2-face-pref f13))
              (bq-mul (sf2-face-pref f14) (bq-mul (sf2-face-pref f15) (sf2-face-pref f23))))
      (bq-mul (bq-mul (sf2-face-pref f24) (sf2-face-pref f25))
              (bq-mul (sf2-face-pref f34) (bq-mul (sf2-face-pref f35) (sf2-face-pref f45)))))
    (sf2-fold1 f12 f13 f14 f15 f23 f24 f25 f34 f35 f45
      (sf2-opts-gen f12 f13 f14 f15 i1)
      (sf2-opts-gen f12 f25 f23 f24 i2)
      (sf2-opts-gen f13 f23 f34 f35 i3)
      (sf2-opts-gen f24 f34 f14 f45 i4)
      (sf2-opts-gen f35 f45 f15 f25 i5)
      bq-zero)
