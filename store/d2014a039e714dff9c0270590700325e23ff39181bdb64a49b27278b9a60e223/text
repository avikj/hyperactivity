ag-slice-payload : AgentSlice → List Word → List Word → List Word
ag-slice-payload (mk-slice aid kgs role ow cmt nxt) status msg =
  list-append "{"
  (list-append (ag-kv "id" aid)
  (list-append "," (list-append (ag-kv "kind" "agent_coord")
  (list-append "," (list-append (ag-kv "kg_slice" kgs)
  (list-append "," (list-append (ag-kv "role" role)
  (list-append "," (list-append (ag-q "owns") (list-append ":" (list-append (ag-jarr ow)
  (list-append "," (list-append (ag-kv "latest_commit" cmt)
  (list-append "," (list-append (ag-kv "next_task" nxt)
  (list-append "," (list-append (ag-kv "status" status)
  (list-append "," (list-append (ag-kv "msg" msg)
  (list-append "}" (cons #10 nil)))))))))))))))))))))
