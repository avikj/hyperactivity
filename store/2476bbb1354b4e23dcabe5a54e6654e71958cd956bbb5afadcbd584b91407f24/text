  kq_ (h4-depl mm_ (w))
b2-annwid mm_ (suc f) anns j n w kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (w))) else (let a_13027 = anns in let j_13028 = j in scmd (w-load ((b2-a mm_ (%wadd a_13027 (%wsucc j_13028))))) (λ x_13026 → let mm_13029 = b2-dep mm_ x_13026 in let a = x_13026 in if (%weq a #0) then (b2-annwid mm_13029 f anns (%wsucc j) n w kq_) else (let i_13031 = (%wadd a #1) in scmd (w-load ((b2-a mm_13029 i_13031))) (λ x_13030 → let mm_13032 = b2-dep mm_13029 x_13030 in let k = x_13030 in b2-nstr mm_13032 k (λ s → let mm_13033 = b2-dep mm_13032 s in let a_13035 = s in scmd (w-load ((b2-a mm_13033 a_13035))) (λ x_13034 → let mm_13036 = b2-dep mm_13033 x_13034 in let l = x_13034 in b2-annwid mm_13036 f anns (%wsucc j) n (the Word (if %wlt w l then l else w)) kq_))))))
