-- what may follow an etyl span: a mention's opening tag
e-mention-next-in : List (List Word) → List Word → Bool
e-mention-next-in nil t = false
e-mention-next-in (cons g r) t = orB (andB (h-prefix (list-append "<" (list-append g (e-dq " class=`"))) t)
  (h-infix "mention" (e-upto-c #34 (h-drop (list-append "<" (list-append g (e-dq " class=`"))) t)))) (e-mention-next-in r t)
