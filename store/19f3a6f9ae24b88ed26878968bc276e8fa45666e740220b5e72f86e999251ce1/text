-- Exact 3x3 and 4x4 determinants in BQ (cofactor expansion, zero division!):
lor-det3 : BQ → BQ → BQ → BQ → BQ → BQ → BQ → BQ → BQ → BQ
lor-det3 a b c d e f g h k =
  bq-add
    (bq-mul a (lor-bq-sub (bq-mul e k) (bq-mul f h)))
    (bq-add
      (sf-bq-neg (bq-mul b (lor-bq-sub (bq-mul d k) (bq-mul f g))))
      (bq-mul c (lor-bq-sub (bq-mul d h) (bq-mul e g))))
