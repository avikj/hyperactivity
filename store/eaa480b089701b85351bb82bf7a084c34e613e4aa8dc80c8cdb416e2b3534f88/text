-- Exact cubic Lagrange grid verification of (2n - 1)^3 - (8n + 4)*(n - 1)^2 = 6n - 5 >= 1 > 0 on n = 1, 2, 3, 4:
bst-tail-poly-at : Nat → Bool
bst-tail-poly-at n =
  (λ t1 nm1 →
    eqb (times t1 (times t1 t1))
        (plus (times (plus (times 8 n) 4) (times nm1 nm1)) (monus (times 6 n) 5)))
  (monus (times 2 n) 1)
  (monus n 1)
