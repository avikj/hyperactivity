ossc-emit-chapters : List TreatiseChapter → List Word
ossc-emit-chapters nil = nil
ossc-emit-chapters (cons ch rest) =
  list-append
    (h-concat (cons "<section class='chapter'><div class='ch-num'>" (cons (tc-num ch)
              (cons "</div><h2>" (cons (tc-title ch)
              (cons "</h2><div class='thm-box'>" (cons (tc-thm ch)
              (cons "</div><p>" (cons (tc-body ch) (cons "</p></section>" nil))))))))))
    (ossc-emit-chapters rest)
