-- Section (4): Concrete 1-qubit complementarity check via lqg/rqm.cub over BZ.
-- After a complete 1-bit Z-measurement yields |0>, asking the complementary X-question (|+> vs |->) gives
-- amplitudes (+1) for |+> and (-1) for |-> (up to 1/sqrt(2)): equal probabilities (1, 1) -> 1 bit of new
-- information, erasing Z.
rp-qubit-x-plus : rqm-prob BZ Unit bz-zero bz-add bz-mul (λ x → x) (λ _ _ → bz-one) (cons (bz-one , unit) nil) ≡ bz-one
rp-qubit-x-plus = refl
