-- Exact integer CHSH value S(a0, a1, b0, b1) = a0*b0 + a0*b1 + a1*b0 - a1*b1 in BZ.
qe-chsh-val : Bool → Bool → Bool → Bool → BZ
qe-chsh-val a0 a1 b0 b1 =
  bz-add
    (bz-add (qe-sgn (qe-pm-mul a0 b0)) (qe-sgn (qe-pm-mul a0 b1)))
    (bz-add (qe-sgn (qe-pm-mul a1 b0)) (bz-neg (qe-sgn (qe-pm-mul a1 b1))))
