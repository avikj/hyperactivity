  if (%weq j e) then (let a_12710 = cnt in let b_12711 = ls in let c_12712 = #0 in let n_12714 = #3 in scmd (w-load (mm_)) (λ at_12713 → let mm_12715 = b2-dep mm_ at_12713 in scmd (w-store (mm_12715) ((%wadd at_12713 n_12714))) (λ uu_12716 → let mm_12717 = hv2-u mm_12715 uu_12716 in let at_12709 = at_12713 in let i_12718 = at_12709 in let v_12719 = a_12710 in scmd (w-store ((b2-a mm_12717 i_12718)) (v_12719)) (λ uu_12720 → let mm_12721 = hv2-u mm_12717 uu_12720 in let i_12722 = (%wadd at_12709 #1) in let v_12723 = b_12711 in scmd (w-store ((b2-a mm_12721 i_12722)) (v_12723)) (λ uu_12724 → let mm_12725 = hv2-u mm_12721 uu_12724 in let i_12726 = (%wadd at_12709 #2) in let v_12727 = c_12712 in scmd (w-store ((b2-a mm_12725 i_12726)) (v_12727)) (λ uu_12728 → let mm_12729 = hv2-u mm_12725 uu_12728 in let r = at_12709 in kq_ (h4-depl mm_12729 (r)))))))) else (let a_12731 = s in let j_12732 = j in scmd (w-load ((b2-a mm_ (%wadd a_12731 (%wsucc j_12732))))) (λ x_12730 → let mm_12733 = b2-dep mm_ x_12730 in let c = x_12730 in if (%weq c #10) then (b2-nlcount mm_12733 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_12733 f s (%wsucc j) e cnt ls kq_)))
