b2-dropg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-dropg mm_ zero a ob n j len kq_ =
  kq_ (h4-depl mm_ (ob))
b2-dropg mm_ (suc f) a ob n j len kq_ =
  if (%weq (%wadd n j) len) then (kq_ (h4-depl mm_ (ob))) else (let a_5199 = a in let j_5200 = (%wadd n j) in scmd (w-load ((b2-a mm_ (%wadd a_5199 (%wsucc j_5200))))) (λ x_5198 → let mm_5201 = b2-dep mm_ x_5198 in let x = x_5198 in let a_5202 = ob in let j_5203 = j in let v_5204 = x in scmd (w-store ((b2-a mm_5201 (%wadd a_5202 (%wsucc j_5203)))) (v_5204)) (λ uu_5205 → let mm_5206 = hv2-u mm_5201 uu_5205 in b2-dropg mm_5206 f a ob n (%wsucc j) len kq_)))
