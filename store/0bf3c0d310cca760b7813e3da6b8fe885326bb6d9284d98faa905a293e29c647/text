b2-intrcode : Word → Word → (Word → Step W Word) → Step W Word
b2-intrcode mm_ k kq_ =
  scmd (w-load ((b2-HR mm_ #21))) (λ mp → let mm_2524 = b2-dep mm_ mp in if (%weq mp #0) then (kq_ (h4-depl mm_2524 (#0))) else (b2-mget mm_2524 mp k (λ c → let mm_2525 = b2-dep mm_2524 c in scmd (w-load ((b2-HR mm_2525 #20))) (λ run → let mm_2526 = b2-dep mm_2525 run in if (andB (%wlt #39 c) (not (%weq c hv2-none))) then (kq_ (h4-depl mm_2526 ((the Word (if %weq run #1 then c else #0))))) else (kq_ (h4-depl mm_2526 ((the Word (if %weq c hv2-none then #0 else c)))))))))
