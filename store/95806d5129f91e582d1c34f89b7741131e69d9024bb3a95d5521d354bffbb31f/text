b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6770 = b2-dep mm_ c in let p_6772 = p in let i_6774 = (%wadd p_6772 #1) in scmd (w-load ((b2-a mm_6770 i_6774))) (λ x_6773 → let mm_6775 = b2-dep mm_6770 x_6773 in let x_6771 = x_6773 in let i = x_6771 in let p_6776 = p in let v_6777 = (%wsucc i) in let i_6778 = (%wadd p_6776 #1) in let v_6779 = v_6777 in scmd (w-store ((b2-a mm_6775 i_6778)) (v_6779)) (λ uu_6780 → let mm_6781 = hv2-u mm_6775 uu_6780 in kq_ (h4-depl mm_6781 (c)))))
