b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_8012 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_8012 (k))) else (b2-nbytes mm_8012 ns (λ nb → let mm_8013 = b2-dpl mm_8012 nb in b2-nbytes mm_8013 k (λ kb → let mm_8014 = b2-dpl mm_8013 kb in b2-nm mm_8014 (list-append nb (cons #58 kb)) (λ r → let mm_8015 = b2-dep mm_8014 r in kq_ (h4-depl mm_8015 (r)))))))
