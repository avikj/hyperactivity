usf-drop-empty-r : UsfNode → UsfNode → UsfNode
usf-drop-empty-r a usf-empty           = a
usf-drop-empty-r a (usf-seq x y)       = usf-drop-empty-l a (usf-seq x y)
usf-drop-empty-r a (usf-nav p)         = usf-drop-empty-l a (usf-nav p)
usf-drop-empty-r a (usf-splash t s w)  = usf-drop-empty-l a (usf-splash t s w)
usf-drop-empty-r a usf-portal          = usf-drop-empty-l a usf-portal
usf-drop-empty-r a (usf-section i l p) = usf-drop-empty-l a (usf-section i l p)
usf-drop-empty-r a (usf-benches i l r) = usf-drop-empty-l a (usf-benches i l r)
usf-drop-empty-r a usf-footer          = usf-drop-empty-l a usf-footer
