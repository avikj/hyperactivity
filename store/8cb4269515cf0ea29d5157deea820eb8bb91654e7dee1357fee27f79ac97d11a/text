b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10470 = xs in scmd (w-load ((b2-a mm_ a_10470))) (λ x_10469 → let mm_10471 = b2-dep mm_ x_10469 in let n = x_10469 in if (%weq j n) then (kq_ (h4-depl mm_10471 (h))) else (let a_10473 = xs in let j_10474 = j in scmd (w-load ((b2-a mm_10471 (%wadd a_10473 (%wsucc j_10474))))) (λ x_10472 → let mm_10475 = b2-dep mm_10471 x_10472 in let x = x_10472 in b2-tapp mm_10475 bk h x #0 (λ h2 → let mm_10476 = b2-dep mm_10475 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10476 b2-ERR)) else (b2-applyall mm_10476 f bk h2 xs (%wsucc j) kq_)))))
