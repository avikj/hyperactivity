b2-nlcount mm_ zero s j e cnt ls kq_ =
  kq_ (h4-depl mm_ (cnt))
b2-nlcount mm_ (suc f) s j e cnt ls kq_ =
  if (%weq j e) then (let a_12747 = cnt in let b_12748 = ls in let c_12749 = #0 in let n_12751 = #3 in scmd (w-load (mm_)) (λ at_12750 → let mm_12752 = b2-dep mm_ at_12750 in scmd (w-store (mm_12752) ((%wadd at_12750 n_12751))) (λ uu_12753 → let mm_12754 = hv2-u mm_12752 uu_12753 in let at_12746 = at_12750 in let i_12755 = at_12746 in let v_12756 = a_12747 in scmd (w-store ((b2-a mm_12754 i_12755)) (v_12756)) (λ uu_12757 → let mm_12758 = hv2-u mm_12754 uu_12757 in let i_12759 = (%wadd at_12746 #1) in let v_12760 = b_12748 in scmd (w-store ((b2-a mm_12758 i_12759)) (v_12760)) (λ uu_12761 → let mm_12762 = hv2-u mm_12758 uu_12761 in let i_12763 = (%wadd at_12746 #2) in let v_12764 = c_12749 in scmd (w-store ((b2-a mm_12762 i_12763)) (v_12764)) (λ uu_12765 → let mm_12766 = hv2-u mm_12762 uu_12765 in let r = at_12746 in kq_ (h4-depl mm_12766 (r)))))))) else (let a_12768 = s in let j_12769 = j in scmd (w-load ((b2-a mm_ (%wadd a_12768 (%wsucc j_12769))))) (λ x_12767 → let mm_12770 = b2-dep mm_ x_12767 in let c = x_12767 in if (%weq c #10) then (b2-nlcount mm_12770 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_12770 f s (%wsucc j) e cnt ls kq_)))
