sf-eprl-node-ip : Nat → Nat → Nat → Nat → Nat → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ))
sf-eprl-node-ip fuel J Jp Jm k acc = case fuel of
  zero → acc
  suc ip → sf-eprl-node-ip ip J Jp Jm k
    (if tri-ok Jp Jp ip
     then sf-eprl-node-im (suc (plus Jm Jm)) J Jp Jm k ip acc
     else acc)
