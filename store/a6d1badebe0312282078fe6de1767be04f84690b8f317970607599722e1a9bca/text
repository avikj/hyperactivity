b2-uptoq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-uptoq mm_ zero s i n kq_ =
  kq_ (h4-depl mm_ (i))
b2-uptoq mm_ (suc f) s i n kq_ =
  if (not (%wlt i n)) then (kq_ (h4-depl mm_ (i))) else (let a_7998 = s in let j_7999 = i in scmd (w-load ((b2-a mm_ (%wadd a_7998 (%wsucc j_7999))))) (λ x_7997 → let mm_8000 = b2-dep mm_ x_7997 in let c = x_7997 in if (%weq c #34) then (kq_ (h4-depl mm_8000 (i))) else (b2-uptoq mm_8000 f s (%wsucc i) n kq_)))
