b2-appvarsg : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-appvarsg mm_ zero t d j n kq_ =
  kq_ (h4-depl mm_ (t))
b2-appvarsg mm_ (suc f) t d j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (t))) else (b2-Var mm_ b2-N_ (%wadd d j) #0 #0 (λ x → let mm_2410 = b2-dep mm_ x in b2-App mm_2410 t x #0 (λ g → let mm_2411 = b2-dep mm_2410 g in b2-appvarsg mm_2411 f g d (%wsucc j) n kq_)))
