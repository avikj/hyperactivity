-- an array sugar: ALeaf{x} or ANode{l, r} of such; the leaves into v (1 when it is one)
b2-arrsug : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-arrsug mm_ zero t v kq_ =
  kq_ (h4-depl mm_ (#0))
b2-arrsug mm_ (suc f) t v kq_ =
  let t_1256 = t in scmd (w-load ((b2-a mm_ t_1256))) (λ x_1255 → let mm_1257 = b2-dep mm_ x_1255 in let tg = (%wand x_1255 #255) in if (not (%weq tg b2-CTR)) then (kq_ (h4-depl mm_1257 (#0))) else (let t_1259 = t in let j_1260 = #0 in scmd (w-load ((b2-a mm_1257 (%wadd t_1259 (%wadd #2 j_1260))))) (λ x_1258 → let mm_1261 = b2-dep mm_1257 x_1258 in let k = x_1258 in let t_1263 = t in let j_1264 = #1 in scmd (w-load ((b2-a mm_1261 (%wadd t_1263 (%wadd #2 j_1264))))) (λ x_1262 → let mm_1265 = b2-dep mm_1261 x_1262 in let xs = x_1262 in let a_1267 = xs in scmd (w-load ((b2-a mm_1265 a_1267))) (λ x_1266 → let mm_1268 = b2-dep mm_1265 x_1266 in let l = x_1266 in if (andB (%weq k b2-NALeaf) (%weq l #1)) then (let a_1270 = xs in let j_1271 = #0 in scmd (w-load ((b2-a mm_1268 (%wadd a_1270 (%wsucc j_1271))))) (λ x_1269 → let mm_1272 = b2-dep mm_1268 x_1269 in let x = x_1269 in b2-vpush mm_1272 v x (λ dd_1273 → let mm_1274 = b2-dep mm_1272 dd_1273 in kq_ (h4-depl mm_1274 (#1))))) else (if (not (andB (%weq k b2-NANode) (%weq l #2))) then (kq_ (h4-depl mm_1268 (#0))) else (let a_1276 = xs in let j_1277 = #0 in scmd (w-load ((b2-a mm_1268 (%wadd a_1276 (%wsucc j_1277))))) (λ x_1275 → let mm_1278 = b2-dep mm_1268 x_1275 in let a = x_1275 in let a_1280 = xs in let j_1281 = #1 in scmd (w-load ((b2-a mm_1278 (%wadd a_1280 (%wsucc j_1281))))) (λ x_1279 → let mm_1282 = b2-dep mm_1278 x_1279 in let b = x_1279 in b2-arrsug mm_1282 f a v (λ ok → let mm_1283 = b2-dep mm_1282 ok in if (%weq ok #0) then (kq_ (h4-depl mm_1283 (#0))) else (b2-arrsug mm_1283 f b v (λ r → let mm_1284 = b2-dep mm_1283 r in kq_ (h4-depl mm_1284 (r))))))))))))))
