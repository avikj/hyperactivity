sf-eprl-fold5 : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ → List (Nat × (Nat × BQ)) → BQ → BQ
sf-eprl-fold5 Jp Jm ip1 im1 ip2 im2 ip3 im3 ip4 im4 wt4 opts5 acc = case opts5 of
  nil → acc
  cons o5 rest5 →
    sf-eprl-fold5 Jp Jm ip1 im1 ip2 im2 ip3 im3 ip4 im4 wt4 rest5
      (bq-add acc
        (bq-mul (bq-mul wt4 (snd (snd o5)))
          (bq-mul (sf-15j-W Jp Jp Jp Jp Jp Jp Jp Jp Jp Jp ip1 ip2 ip3 ip4 (fst o5))
                  (sf-15j-W Jm Jm Jm Jm Jm Jm Jm Jm Jm Jm im1 im2 im3 im4 (fst (snd o5))))))
