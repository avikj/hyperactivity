b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_11645 = xs in scmd (w-load ((b2-a mm_ a_11645))) (λ x_11644 → let mm_11646 = b2-dep mm_ x_11644 in let n = x_11644 in if (%weq j n) then (kq_ (h4-depl mm_11646 (h))) else (let a_11648 = xs in let j_11649 = j in scmd (w-load ((b2-a mm_11646 (%wadd a_11648 (%wsucc j_11649))))) (λ x_11647 → let mm_11650 = b2-dep mm_11646 x_11647 in let x = x_11647 in b2-tapp mm_11650 bk h x #0 (λ h2 → let mm_11651 = b2-dep mm_11650 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_11651 b2-ERR)) else (b2-applyall mm_11651 f bk h2 xs (%wsucc j) kq_)))))
