b2-dropg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-dropg mm_ zero a ob n j len kq_ =
  kq_ (h4-depl mm_ (ob))
b2-dropg mm_ (suc f) a ob n j len kq_ =
  if (%weq (%wadd n j) len) then (kq_ (h4-depl mm_ (ob))) else (let a_5162 = a in let j_5163 = (%wadd n j) in scmd (w-load ((b2-a mm_ (%wadd a_5162 (%wsucc j_5163))))) (λ x_5161 → let mm_5164 = b2-dep mm_ x_5161 in let x = x_5161 in let a_5165 = ob in let j_5166 = j in let v_5167 = x in scmd (w-store ((b2-a mm_5164 (%wadd a_5165 (%wsucc j_5166)))) (v_5167)) (λ uu_5168 → let mm_5169 = hv2-u mm_5164 uu_5168 in b2-dropg mm_5169 f a ob n (%wsucc j) len kq_)))
