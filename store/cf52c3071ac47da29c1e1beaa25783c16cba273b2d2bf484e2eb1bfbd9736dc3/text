
h4-cons : H4S → List Word → Bool × H4S
h4-cons s0 p = let s1 = h4-skip s0 in let m = h4-match s1 p in (fst m , h4-skip (snd m))

h4-perr-exp : List Word → Step W Word
h4-perr-exp p = h4-perr (list-append "expected: " p)

h4-perr-var : Word → H4S → Word → Step W Word
h4-perr-var code s nam = h4-perr (list-append "undefined variable '" (list-append (h4-tget-go nam (h4s-tab s)) "'"))

h4-lamext : Word → Word → Word
h4-lamext lvl uses = if %weq uses #0 then %wor lvl h4-ERAMASK else lvl

fn h4-supdsu (dyn : Word) (lt : Word) (lab : Word) (a : Word) (b : Word) : Word
  if %weq dyn #1
    jump h4-mk3 h4-DSU #0 lt a b
  jump h4-mk2 h4-SUP lab a b

fnrec h4p (f : Nat) (w : Word) (s0 : H4S) (d : Word) (a1 : Word) (a2 : Word) (a3 : Word) : H4S × Word
  zero: halt (h4-perr "term too deep")
  -- 0 term
  if %weq w #0
    r <-[h4-dpw] h4p f #1 s0 d #0 #0 #0
    jump h4p f #8 (fst r) d (snd r) #0 #0
  -- 1 atom
  if %weq w #1
    let s = h4-skip s0
    let ml = h4-match s "λ"
    if fst ml
      jump h4p f #2 (snd ml) d #0 #0 #0
    let mb = h4-match s "!"
    if fst mb
      jump h4p f #3 (snd mb) d #0 #0 #0
    let ma = h4-match s "&"
    if fst ma
      jump h4p f #4 (snd ma) d #0 #0 #0
    let mh = h4-match s "#"
    if fst mh
      let n = h4-name (snd mh)
      if not (fst n)
        halt (h4-perr-exp "name")
      let s1 = fst (snd n)
      let mc = h4-match (h4-skip s1) "{"
      if fst mc
        ch <-[h4-dpw] h4p f #13 (h4-skip (snd mc)) d #0 #0 #0
        xs <-[h4-dpl] h4-chain (toNat #17) (snd ch) nil
        t <- h4-ctr (snd (snd n)) xs
        ret (fst ch , t)
      t <- h4-ctr (snd (snd n)) nil
      ret (s1 , t)
    let mr = h4-match s "@"
    if fst mr
      let n = h4-name (snd mr)
      if not (fst n)
        halt (h4-perr-exp "name")
      ret (fst (snd n) , h4-new h4-REF (snd (snd n)) #0)
    let mc = h4-match s "^"
    if fst mc
      let s1 = h4-skip (snd mc)
      if %weq (h4-peek s1) #40
        let c1 = h4-cons s1 "("
        fx <-[h4-dpw] h4p f #0 (snd c1) d #0 #0 #0
        xx <-[h4-dpw] h4p f #0 (fst fx) d #0 #0 #0
        let c2 = h4-cons (fst xx) ")"
        if not (fst c2)
          halt (h4-perr-exp ")")
        t <- h4-mk2 h4-DRY #0 (snd fx) (snd xx)
        ret (snd c2 , t)
      let n = h4-namenum s1
      if not (fst n)
        halt (h4-perr-exp "name")
      ret (fst (snd n) , h4-new h4-NAM (snd (snd n)) #0)
    let mu = h4-match s "↑"
    if fst mu
      x <-[h4-dpw] h4p f #1 (snd mu) d #0 #0 #0
      t <- h4-mk1 h4-INC #0 (snd x)
      ret (fst x , t)
    let ms = h4-match s "*"
    if fst ms
      ret (snd ms , h4-new h4-ANY #0 #0)
    let mp = h4-match s "("
    if fst mp
      x <-[h4-dpw] h4p f #0 (snd mp) d #0 #0 #0
      let c = h4-cons (fst x) ")"
      if not (fst c)
        halt (h4-perr-exp ")")
      ret (snd c , snd x)
    let c = h4-peek s
    if %weq c #91
      let s1 = h4-skip (h4-adv s)
      if %weq (h4-peek s1) #93
        ret (h4-adv s1 , h4-new h4-C00 h4-NIL #0)
      jump h4p f #12 s1 d #0 #0 #0
    if %weq c #39
      let e = h4-chesc (hv2-drop1 (h4s-src s))
      if not (andB (fst e) (%weq (hv2-nth #0 (snd (snd e))) #39))
        halt (h4-perr-exp "'")
      t <- h4-ctr h4-CHR (cons (h4-num (fst (snd e))) nil)
      ret (h4s-wsrc s (hv2-drop1 (snd (snd e))) , t)
    if orB (%weq c #34) (%weq c #96)
      let cs = h4-strchars (toNat (cli-len (h4s-src s))) c (hv2-drop1 (h4s-src s))
      if not (fst cs)
        halt (h4-perr-exp "character")
      t <- h4-strterm (fst (snd cs))
      ret (h4s-wsrc s (snd (snd cs)) , t)
    if h4-isdig c
      let dg = h4-digits (h4s-src s) #0
      if %weq (hv2-nth #0 (snd dg)) #110
        let s1 = h4s-wsrc s (hv2-drop1 (snd dg))
        let mp1 = h4-match s1 "+"
        if fst mp1
          x <-[h4-dpw] h4p f #0 (snd mp1) d #0 #0 #0
          t <- h4-sucs (toNat (fst dg)) (snd x)
          ret (fst x , t)
        t <- h4-sucs (toNat (fst dg)) (h4-new h4-C00 h4-ZER #0)
        ret (s1 , t)
      ret (h4-skip (h4s-wsrc s (snd dg)) , h4-num (fst dg))
    -- a variable
    let n = h4-name s
    if not (fst n)
      halt (h4-perr-exp "name")
    let s1 = fst (snd n)
    let nam = snd (snd n)
    let m0 = h4-match s1 "₀"
    let m1 = h4-match s1 "₁"
    let side = if fst m0 then #0 else if fst m1 then #1 else #2
    let s2 = h4-skip (if fst m0 then snd m0 else snd m1)
    let lk = h4-look s2 nam side
    if not (%weq (fst lk) #0)
      halt (h4-perr-var (fst lk) s2 nam)
    let b = snd lk
    let sd = if %weq side #2 then (if %wlt (h4b-sd b) #2 then h4b-sd b else if %weq (h4b-fk b) #1 then h4s-fside s2 else #2) else side
    if %weq (h4b-lab b) h4-DYN
      ret (s2 , h4-new h4-BJV #0 (%wadd (h4b-lvl b) (if %weq sd #1 then #1 else #0)))
    ret (s2 , h4-new (if %weq sd #0 then h4-BJ0 else if %weq sd #1 then h4-BJ1 else h4-BJV) (h4b-lab b) (h4b-lvl b))
  -- 2 λ
  if %weq w #2
    let s = h4-skip s0
    if %weq (h4-peek s) #123
      let c1 = h4-cons s "{"
      if %weq (h4-peek (snd c1)) #125
        let c2 = h4-cons (snd c1) "}"
        ret (snd c2 , h4-era)
      hl <- h4-alloc #1
      do h4-wr hl h4-NUM0
      jump h4p f #11 (snd c1) d hl hl #0
    if %weq (h4-peek s) #36
      let n = h4-name (h4-adv s)
      if not (fst n)
        halt (h4-perr-exp "name")
      let s1 = h4-push (h4-skip (fst (snd n))) (snd (snd n)) (%wadd d #2) #0 #0 #0 #2
      let sp = h4-sep s1
      bx <-[h4-dpw] h4p f (if %weq (h4-peek s1) #44 then #2 else if %weq (h4-peek s1) #59 then #2 else #0) (if orB (%weq (h4-peek s1) #44) (%weq (h4-peek s1) #59) then sp else snd (h4-cons s1 ".")) (%wadd d #2) #0 #0 #0
      let s2 = h4-pop (fst bx)
      u <- h4-uses s2 (snd bx) (%wadd d #2) h4-BJV #0
      if %wlt #1 u
        halt (h4-perr-affine s2 (snd (snd n)) u)
      ap <- h4-mk2 h4-APP #0 (h4-new h4-BJV #0 (%wadd d #1)) (snd bx)
      lx <- h4-mk1 h4-LAM (h4-lamext (%wadd d #2) u) ap
      lf <- h4-mk1 h4-LAM (%wadd d #1) lx
      t <- h4-mk1 h4-UNS #0 lf
      ret (s2 , t)
    let mc = h4-match s "&"
    let cl = if fst mc then #1 else #0
    let n = h4-name (snd mc)
    if not (fst n)
      halt (h4-perr-exp "name")
    let nam = snd (snd n)
    let s1 = h4-skip (fst (snd n))
    if %weq (h4-peek s1) #38
      let s2 = h4-skip (h4-adv s1)
      let dyn = if %weq (h4-peek s2) #40 then #1 else #0
      if %weq dyn #1
        lt <-[h4-dpw] h4p f #0 (snd (h4-cons s2 "(")) (%wadd d #1) #0 #0 #0
        let c3 = h4-cons (fst lt) ")"
        jump h4p f #15 (h4-skip (snd c3)) d nam cl (snd lt)
      let pc = h4-peek s2
      if orB (%weq pc #44) (orB (%weq pc #59) (%weq pc #46))
        jump h4p f #16 (h4-skip (h4s-wflab s2 (%wsucc (h4s-flab s2)))) d nam cl (h4s-flab s2)
      let ln = h4-namenum s2
      if not (fst ln)
        halt (h4-perr-exp "label")
      jump h4p f #16 (h4-skip (fst (snd ln))) d nam cl (snd (snd ln))
    let s2 = h4-push s1 nam (%wadd d #1) #0 #0 cl #2
    let issep = orB (%weq (h4-peek s2) #44) (%weq (h4-peek s2) #59)
    let c4 = h4-cons s2 "."
    if andB (not issep) (not (fst c4))
      halt (h4-perr-exp ".")
    bx <-[h4-dpw] h4p f (if issep then #2 else #0) (if issep then h4-sep s2 else snd c4) (%wadd d #1) #0 #0 #0
    let s3 = h4-pop (fst bx)
    u <- h4-uses s3 (snd bx) (%wadd d #1) h4-BJV #0
    if andB (%weq cl #0) (%wlt #1 u)
      halt (h4-perr-affine s3 nam u)
    ad <-[h4-dpw] h4-autodup s3 (snd bx) (%wadd d #1) (%wadd d #1) h4-BJV #0 (if %weq cl #1 then u else #0)
    t <- h4-mk1 h4-LAM (h4-lamext (%wadd d #1) u) (snd ad)
    ret (fst ad , t)
  -- 15 λx&(L): a1 the name, a2 cloned, a3 the label term
  if %weq w #15
    let s1 = h4-push s0 a1 (%wadd d #2) h4-DYN #0 a2 #2
    let issep = orB (%weq (h4-peek s1) #44) (%weq (h4-peek s1) #59)
    let c4 = h4-cons s1 "."
    if andB (not issep) (not (fst c4))
      halt (h4-perr-exp ".")
    bx <-[h4-dpw] h4p f (if issep then #2 else #0) (if issep then h4-sep s1 else snd c4) (%wadd d #3) #0 #0 #0
    let s2 = h4-pop (fst bx)
    u0 <- h4-uses s2 (snd bx) (%wadd d #2) h4-BJV #0
    u1 <- h4-uses s2 (snd bx) (%wadd d #3) h4-BJV #0
    if andB (%weq a2 #0) (%wlt #1 u0)
      halt (h4-perr-affine s2 a1 u0)
    if andB (%weq a2 #0) (%wlt #1 u1)
      halt (h4-perr-affine s2 a1 u1)
    b1 <-[h4-dpw] h4-autodup s2 (snd bx) (%wadd d #2) (%wadd d #3) h4-BJV #0 (if %weq a2 #1 then u0 else #0)
    b2 <-[h4-dpw] h4-autodup (fst b1) (snd b1) (%wadd d #3) (%wadd d #3) h4-BJV #0 (if %weq a2 #1 then u1 else #0)
    l1 <- h4-mk1 h4-LAM (%wadd d #3) (snd b2)
    l0 <- h4-mk1 h4-LAM (%wadd d #2) l1
    dd <- h4-mk3 h4-DDU #0 a3 (h4-new h4-BJV #0 (%wadd d #1)) l0
    t <- h4-mk1 h4-LAM (h4-lamext (%wadd d #1) (%wadd u0 u1)) dd
    ret (fst b2 , t)
  -- 16 λx&L: a1 the name, a2 cloned, a3 the label
  if %weq w #16
    let s1 = h4-push s0 a1 (%wadd d #2) a3 #0 a2 #2
    let issep = orB (%weq (h4-peek s1) #44) (%weq (h4-peek s1) #59)
    let c4 = h4-cons s1 "."
    if andB (not issep) (not (fst c4))
      halt (h4-perr-exp ".")
    bx <-[h4-dpw] h4p f (if issep then #2 else #0) (if issep then h4-sep s1 else snd c4) (%wadd d #2) #0 #0 #0
    let s2 = h4-pop (fst bx)
    u0 <- h4-uses s2 (snd bx) (%wadd d #2) h4-BJ0 a3
    u1 <- h4-uses s2 (snd bx) (%wadd d #2) h4-BJ1 a3
    if andB (%weq a2 #0) (%wlt #1 u0)
      halt (h4-perr-affine s2 a1 u0)
    if andB (%weq a2 #0) (%wlt #1 u1)
      halt (h4-perr-affine s2 a1 u1)
    b1 <-[h4-dpw] h4-autodup s2 (snd bx) (%wadd d #2) (%wadd d #2) h4-BJ1 a3 (if %weq a2 #1 then u1 else #0)
    b2 <-[h4-dpw] h4-autodup (fst b1) (snd b1) (%wadd d #2) (%wadd d #2) h4-BJ0 a3 (if %weq a2 #1 then u0 else #0)
    du <- h4-mk2 h4-DUP a3 (h4-new h4-BJV #0 (%wadd d #1)) (snd b2)
    t <- h4-mk1 h4-LAM (h4-lamext (%wadd d #1) (%wadd u0 u1)) du
    ret (fst b2 , t)
  -- 11 match cases: a1 the holder, a2 the tip
  if %weq w #11
    let s = h4-skip s0
    let c = h4-peek s
    let dg = h4-digits (h4s-src s) #0
    let sdg = h4-skip (h4s-wsrc s (snd dg))
    let ce = h4-chesc (hv2-drop1 (h4s-src s))
    let nh = h4-name (h4-adv s)
    let kind = if %weq c #39 then #1 else if h4-isdig c then (if %weq (h4-peek sdg) #58 then #2 else if %weq (h4-peek sdg) #110 then (if andB (%weq (fst dg) #0) (not (%weq (h4-peek1 sdg) #43)) then #3 else if andB (%weq (fst dg) #1) (%weq (h4-peek1 sdg) #43) then #4 else #0) else #0) else if andB (%weq c #35) (fst nh) then #5 else if andB (%weq c #91) (%weq (h4-peek1 s) #93) then #6 else if andB (%weq c #60) (%weq (h4-peek1 s) #62) then #7 else #0
    if not (%weq kind #0)
      let tg = if orB (%weq kind #1) (%weq kind #2) then h4-SWI else h4-MAT
      let ex = if %weq kind #1 then fst (snd ce) else if %weq kind #2 then fst dg else if %weq kind #3 then h4-ZER else if %weq kind #4 then h4-SUC else if %weq kind #5 then snd (snd nh) else if %weq kind #6 then h4-NIL else h4-CON
      let sa = if %weq kind #1 then h4s-wsrc s (hv2-drop1 (snd (snd ce))) else if %weq kind #2 then sdg else if %weq kind #3 then h4-adv sdg else if %weq kind #4 then h4-adv (h4-adv sdg) else if %weq kind #5 then fst (snd nh) else h4-adv (h4-adv s)
      let c1 = h4-cons sa ":"
      if not (fst c1)
        halt (h4-perr-exp ":")
      vx <-[h4-dpw] h4p f #0 (snd c1) d #0 #0 #0
      let s2 = h4-sep (h4-skip (fst vx))
      loc <- h4-alloc #2
      do h4-wr loc (snd vx)
      do h4-wr (%wsucc loc) h4-NUM0
      do h4-wr a2 (h4-new tg ex loc)
      jump h4p f #11 s2 d a1 (%wsucc loc) #0
    cur <- h4-rd a1
    if %weq cur h4-NUM0
      fx <-[h4-dpw] h4p f #0 s d #0 #0 #0
      let c2 = h4-cons (h4-sep (h4-skip (fst fx))) "}"
      if not (fst c2)
        halt (h4-perr-exp "}")
      t <- h4-mk1 h4-USE #0 (snd fx)
      ret (snd c2 , t)
    if %weq c #125
      let c2 = h4-cons s "}"
      ret (snd c2 , cur)
    let su = if %weq c #95 then snd (h4-cons (h4-adv s) ":") else s
    dx <-[h4-dpw] h4p f #0 su d #0 #0 #0
    do h4-wr a2 (snd dx)
    let c3 = h4-cons (h4-sep (h4-skip (fst dx))) "}"
    if not (fst c3)
      halt (h4-perr-exp "}")
    t <- h4-rd a1
    ret (snd c3 , t)
  -- 12 list elements
  if %weq w #12
    ex <-[h4-dpw] h4p f #0 s0 d #0 #0 #0
    let s1 = h4-skip (h4-sep (h4-skip (fst ex)))
    if %weq (h4-peek s1) #93
      let c = h4-cons s1 "]"
      t <- h4-ctr h4-CON (cons (snd ex) (cons (h4-new h4-C00 h4-NIL #0) nil))
      ret (snd c , t)
    rx <-[h4-dpw] h4p f #12 s1 d #0 #0 #0
    t <- h4-ctr h4-CON (cons (snd ex) (cons (snd rx) nil))
    ret (fst rx , t)
  -- 13 constructor fields
  if %weq w #13
    if %weq (h4-peek s0) #125
      let c = h4-cons s0 "}"
      ret (snd c , #0)
    ax <-[h4-dpw] h4p f #0 s0 d #0 #0 #0
    rx <-[h4-dpw] h4p f #13 (h4-skip (h4-sep (h4-skip (fst ax)))) d #0 #0 #0
    cell <- h4-alloc #2
    do h4-wr cell (snd ax)
    do h4-wr (%wsucc cell) (snd rx)
    ret (fst rx , cell)
  -- 8 operators and calls after the term a1, at least precedence a2
  if %weq w #8
    let s = h4-skip s0
    let mcn = h4-match s "<>"
    if fst mcn
      tx <-[h4-dpw] h4p f #0 (snd mcn) d #0 #0 #0
      t <- h4-ctr h4-CON (cons a1 (cons (snd tx) nil))
      jump h4p f #8 (fst tx) d t a2 #0
    let meq = h4-match s "==="
    if fst meq
      rx <-[h4-dpw] h4p f #1 (snd meq) d #0 #0 #0
      ry <-[h4-dpw] h4p f #8 (fst rx) d (snd rx) #4 #0
      t <- h4-mk2 h4-EQL #0 a1 (snd ry)
      jump h4p f #8 (fst ry) d t a2 #0
    let mand = h4-match s ".&."
    if fst mand
      rx <-[h4-dpw] h4p f #1 (snd mand) d #0 #0 #0
      ry <-[h4-dpw] h4p f #8 (fst rx) d (snd rx) #2 #0
      t <- h4-mk2 h4-AND #0 a1 (snd ry)
      jump h4p f #8 (fst ry) d t a2 #0
    let mor = h4-match s ".|."
    if fst mor
      rx <-[h4-dpw] h4p f #1 (snd mor) d #0 #0 #0
      ry <-[h4-dpw] h4p f #8 (fst rx) d (snd rx) #1 #0
      t <- h4-mk2 h4-OR #0 a1 (snd ry)
      jump h4p f #8 (fst ry) d t a2 #0
    let op = h4-opr (h4s-src s)
    if andB (%wlt (fst op) #99) (not (%wlt (h4-prec (fst op)) a2))
      let so = if %weq (snd op) #2 then h4-adv (h4-adv s) else h4-adv s
      rx <-[h4-dpw] h4p f #1 so d #0 #0 #0
      ry <-[h4-dpw] h4p f #8 (fst rx) d (snd rx) (%wsucc (h4-prec (fst op))) #0
      t <- h4-mk2 h4-OP2 (fst op) a1 (snd ry)
      jump h4p f #8 (fst ry) d t a2 #0
    if not (%weq (h4-peek s) #40)
      ret (s , a1)
    let c = h4-cons s "("
    if %weq (h4-peek (snd c)) #41
      let c2 = h4-cons (snd c) ")"
      jump h4p f #8 (snd c2) d a1 a2 #0
    jump h4p f #14 (snd c) d a1 a2 #0
  -- 14 call arguments
  if %weq w #14
    ax <-[h4-dpw] h4p f #0 s0 d #0 #0 #0
    t <- h4-mk2 h4-APP #0 a1 (snd ax)
    let s1 = h4-skip (h4-sep (h4-skip (fst ax)))
    if %weq (h4-peek s1) #41
      let c = h4-cons s1 ")"
      jump h4p f #8 (snd c) d t a2 #0
    jump h4p f #14 s1 d t a2 #0
  -- 3 ! (after !)
  if %weq w #3
    let ss = h4-match (h4-skip s0) "!"
    let strict = fst ss
    let s = h4-skip (snd ss)
    px <-[h4-dpw] h4p f #9 s d #0 #0 #0
    if not (%weq (snd px) #0)
      ret px
    let mc = h4-match s "&"
    let cl = if fst mc then #1 else #0
    let n = h4-name (if fst mc then h4-skip (snd mc) else s)
    if not (fst n)
      halt (h4-perr-exp "name")
    let nam = snd (snd n)
    let s1 = h4-skip (fst (snd n))
    if %weq (h4-peek s1) #61
      let s2 = h4-skip (h4-adv s1)
      let ml = h4-match s2 "λ"
      let nv = h4-name (snd ml)
      let msc = h4-match (h4-skip (fst (snd nv))) ";"
      if andB (fst ml) (andB (fst nv) (fst msc))
        let s3 = h4-push (h4-push (h4-skip (snd msc)) nam (%wadd d #1) #0 #0 #0 #2) (snd (snd nv)) (%wadd d #2) #0 #0 #0 #2
        lf <- h4-alloc #1
        lv <- h4-alloc #1
        bx <-[h4-dpw] h4p f #0 s3 (%wadd d #2) #0 #0 #0
        let s4 = h4-pop (h4-pop (fst bx))
        uf <- h4-uses s4 (snd bx) (%wadd d #1) h4-BJV #0
        uv <- h4-uses s4 (snd bx) (%wadd d #2) h4-BJV #0
        if %wlt #1 uf
          halt (h4-perr-affine s4 nam uf)
        if %wlt #1 uv
