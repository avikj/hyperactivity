le-phi : (t : List (List Word)) → (f : List (List Word) → Word) → FinRank t f → (e e' : El entry-ord) →
         MemKey {suffix-ord} (fst e) (sufs t) → MemKey {suffix-ord} (fst e') (sufs t) → isTrue (leq {entry-ord} e e') → isTrue (leq {PO} (phi f e) (phi f e'))
le-phi t f fin e e' m m' h =
  subst {_} {_} {Bool} {isTrue}
    (le-phi-path t f fin e e' m m')
    (step-twice {leq {suffix-ord} (fst e) (fst e')} {leq {suffix-ord} (fst e') (fst e)} {word-le (snd e) (snd e')} h)
