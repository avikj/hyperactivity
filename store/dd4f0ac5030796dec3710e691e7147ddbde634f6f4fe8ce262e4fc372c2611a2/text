b2-varidx : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-varidx mm_ zero vs i j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-varidx mm_ (suc f) vs i j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_5766 = vs in let j_5767 = j in scmd (w-load ((b2-a mm_ (%wadd a_5766 (%wsucc j_5767))))) (λ x_5765 → let mm_5768 = b2-dep mm_ x_5765 in let w = x_5765 in let t_5770 = w in let j_5771 = #1 in scmd (w-load ((b2-a mm_5768 (%wadd t_5770 (%wadd #2 j_5771))))) (λ x_5769 → let mm_5772 = b2-dep mm_5768 x_5769 in let wi = x_5769 in if (%weq wi i) then (kq_ (h4-depl mm_5772 (j))) else (b2-varidx mm_5772 f vs i (%wsucc j) n kq_))))
