hy-factor-probe : List (List Word) → List Word
hy-factor-probe ns =
  h-concat (list-map h-line (
    cons (list-append "import " (h-quote "../lib/host.hypercubical")) (
    cons (list-append "import " (h-quote "../lib/rules.hypercubical")) (
    cons "hf-probe-in : List Code" (
    cons (list-append "hf-probe-in = " (hy-def-sources ns)) (
    cons "hf-probe-out : List (Nat × Code) × List Code" (
    cons "hf-probe-out = pool-hyperfactor (toNat #8) hf-probe-in" (
    cons "hf-probe-msg : List Word" (
    cons (h-concat (cons "hf-probe-msg = h-line (list-append " (cons (h-quote "pool-hyperfactor (") (cons " (list-append (h-decimal (fromNat (list-length hf-probe-in))) (list-append " (cons (h-quote " defs): ") (cons " (list-append (h-decimal (fromNat (pool-code-size hf-probe-in))) (list-append " (cons (h-quote " Code nodes -> ") (cons " (list-append (h-decimal (fromNat (pool-dag-size hf-probe-out))) (list-append " (cons (h-quote " DAG nodes, ") (cons " (list-append (h-decimal (fromNat (list-length (fst hf-probe-out)))) " (cons (h-quote " nameless lemmas extracted") (cons ")))))))))))" nil)))))))))))) (
    cons (hy-program "h-out hf-probe-msg") nil))))))))))
