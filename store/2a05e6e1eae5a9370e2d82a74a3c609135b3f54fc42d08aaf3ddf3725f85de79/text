-- Exact signed-integer cancellation helper on RZ (zero postulates!)
-- Prove universally: for ALL a, b : Nat, if plus a b == a then b == zero!
ms-plus-cancel-l : (a b : Nat) → plus a b ≡ a → b ≡ zero
ms-plus-cancel-l zero b h = h
ms-plus-cancel-l (suc a) b h = ms-plus-cancel-l a b (λ i → predN (h i))
