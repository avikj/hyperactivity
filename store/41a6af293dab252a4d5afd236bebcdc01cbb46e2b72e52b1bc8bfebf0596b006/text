anc-secpath-step : Word → Word → AncSecState → AncSecState
anc-secpath-step pExt s1 (anc-sec-st d1 uPrev _) =
  let pDel  = d1
      sTerm = rp-mul16 s1 uPrev
      uNow  = rp-sub32 (rp-neg32 pDel) sTerm
      ySec  = rp-add32 uNow sTerm
      res   = rp-add32 pDel ySec
  in anc-sec-st pExt uNow res
