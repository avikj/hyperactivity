-- Check that three 2D lattice points (x1,y1), (x2,y2), (x3,y3) on the same circle R=25
-- cannot form a nontrivial 3-term arithmetic progression!
-- Circle x^2 + y^2 = 25 points in Z^2: (5,0), (4,3), (3,4), (0,5), (-3,4), (-4,3), (-5,0)
uc-behrend-no-3ap-3pts : Word → Word → Word → Word → Word → Word → Bool
uc-behrend-no-3ap-3pts x1 y1 x2 y2 x3 y3 =
  let same13 = andB (%weq x1 x3) (%weq y1 y3)
      is-ap  = andB (%weq (%wadd x1 x3) (%wmul #2 x2))
                    (%weq (%wadd y1 y3) (%wmul #2 y2))
  in if same13 then true else not is-ap
