-- THEOREM 1A (Exact Variational Ritz Upper-Half of Gapped-Scaffold Sandwich):
taut-ritz-zero-tail : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → ScRing A z add mul neg →
  (c fval : A) → (bs : List A) → (n : Nat) →
  add fval (taut-tail-form A z add mul c bs (taut-zeros A z n)) ≡ fval
taut-ritz-zero-tail A z add mul neg r c fval bs n =
  lor-tr A (add fval (taut-tail-form A z add mul c bs (taut-zeros A z n))) (add fval z) fval
    (cong (λ t → add fval t) (taut-tail-zero A z add mul neg r c bs n))
    (taut-zr A z add mul neg r fval)
