b2-take : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-take mm_ p w kq_ =
  b2-at mm_ p w (λ r → let mm_6790 = b2-dep mm_ r in if (%weq r #0) then (kq_ (h4-depl mm_6790 (#0))) else (let p_6792 = p in let i_6794 = (%wadd p_6792 #1) in scmd (w-load ((b2-a mm_6790 i_6794))) (λ x_6793 → let mm_6795 = b2-dep mm_6790 x_6793 in let x_6791 = x_6793 in let i = x_6791 in let p_6796 = p in let v_6797 = (%wadd i (cli-len w)) in let i_6798 = (%wadd p_6796 #1) in let v_6799 = v_6797 in scmd (w-store ((b2-a mm_6795 i_6798)) (v_6799)) (λ uu_6800 → let mm_6801 = hv2-u mm_6795 uu_6800 in kq_ (h4-depl mm_6801 (#1))))))
