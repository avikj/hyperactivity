-- the row of v over columns u, u + 1, … (k of them), then the current at v
np-row : Nat → Nat → Nat → List FaradayLine → Nat → Nat → List SQ
np-row v u k ls a b = case k of
  zero → cons (if eqb v a then sq-one else (if eqb v b then sq-neg sq-one else sq-zero)) nil
  suc g → cons (np-entry v u ls) (np-row v (suc u) g ls a b)
