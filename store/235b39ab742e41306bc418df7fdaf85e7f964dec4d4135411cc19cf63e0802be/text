-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7255 = tel in let j_7256 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7255 (%wsucc j_7256))))) (λ x_7254 → let mm_7257 = b2-dep mm_ x_7254 in let c = x_7254 in let i_7259 = c in scmd (w-load ((b2-a mm_7257 i_7259))) (λ x_7258 → let mm_7260 = b2-dep mm_7257 x_7258 in let q = x_7258 in let i_7262 = (%wadd c #1) in scmd (w-load ((b2-a mm_7260 i_7262))) (λ x_7261 → let mm_7263 = b2-dep mm_7260 x_7261 in let k = x_7261 in let i_7265 = (%wadd c #2) in scmd (w-load ((b2-a mm_7263 i_7265))) (λ x_7264 → let mm_7266 = b2-dep mm_7263 x_7264 in let i = x_7264 in let i_7268 = (%wadd c #3) in scmd (w-load ((b2-a mm_7266 i_7268))) (λ x_7267 → let mm_7269 = b2-dep mm_7266 x_7267 in let vT = x_7267 in let i_7271 = (%wadd c #4) in scmd (w-load ((b2-a mm_7269 i_7271))) (λ x_7270 → let mm_7272 = b2-dep mm_7269 x_7270 in let s = x_7270 in b2-All mm_7272 q k i vT e s (λ a → let mm_7273 = b2-dep mm_7272 a in b2-telebindg mm_7273 f tel (%wsub j #1) a kq_))))))))
