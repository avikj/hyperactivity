ga-lem-mk-not : (env : Nat → Bool) → (a : GaGuard) → ga-eval env (ga-mk-not a) ≡ ga-notB (ga-eval env a)
ga-lem-mk-not env (ga-k b)       = refl
ga-lem-mk-not env (ga-v i)       = refl
ga-lem-mk-not env (ga-not a)     = ga-sym (ga-lem-not-not (ga-eval env a))
ga-lem-mk-not env (ga-and a1 a2) = refl
ga-lem-mk-not env (ga-ite c t f) = refl
