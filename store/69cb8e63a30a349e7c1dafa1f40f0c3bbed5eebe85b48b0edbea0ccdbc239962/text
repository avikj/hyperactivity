sc-build-even : Nat → List (Nat × Bool) → List ScKet
sc-build-even i ts = case ts of
  nil → nil
  cons p rest →
    if eqb i (fst p)
    then (if snd p then cons (inl i) (sc-build-even (suc i) rest) else sc-build-even (suc i) rest)
    else (if leb i (fst p)
          then cons (inr (i , (fst p , snd p))) (sc-build-even (suc i) rest)
          else sc-build-even (suc i) rest)
