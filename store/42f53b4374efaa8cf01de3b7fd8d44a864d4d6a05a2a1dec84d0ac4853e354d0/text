-- Helper: a + b = c => (a + a) + (b + b) = c + c.
qe-dup-eq : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → QeRing A z add mul neg →
  (a b c : A) → add a b ≡ c → add (add a a) (add b b) ≡ add c c
qe-dup-eq A z add mul neg r a b c h =
  concat (qe-swap4 A z add mul neg r a a b b) (λ i → add (h i) (h i))
