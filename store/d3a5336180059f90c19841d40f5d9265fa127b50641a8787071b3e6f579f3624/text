b2-acopy : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-acopy mm_ zero src dst j off n kq_ =
  kq_ (h4-depl mm_ (dst))
b2-acopy mm_ (suc f) src dst j off n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (dst))) else (let a_2783 = src in let j_2784 = j in scmd (w-load ((b2-a mm_ (%wadd a_2783 (%wsucc j_2784))))) (λ x_2782 → let mm_2785 = b2-dep mm_ x_2782 in let x = x_2782 in let a_2786 = dst in let j_2787 = (%wadd off j) in let v_2788 = x in scmd (w-store ((b2-a mm_2785 (%wadd a_2786 (%wsucc j_2787)))) (v_2788)) (λ uu_2789 → let mm_2790 = hv2-u mm_2785 uu_2789 in b2-acopy mm_2790 f src dst (%wsucc j) off n kq_)))
