-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10985 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10985))) (λ x_10984 → let mm_10986 = b2-dep mm_ x_10984 in let lb = x_10984 in if (%weq lb #0) then (let i_10988 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10986 i_10988))) (λ x_10987 → let mm_10989 = b2-dep mm_10986 x_10987 in let t = x_10987 in kq_ (h4-depl mm_10989 (t)))) else (let i_10991 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10986 i_10991))) (λ x_10990 → let mm_10992 = b2-dep mm_10986 x_10990 in let lx = x_10990 in b2-body mm_10992 bk lb lx (λ r → let mm_10993 = b2-dep mm_10992 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10993 b2-ERR)) else (kq_ (h4-depl mm_10993 (r)))))))
