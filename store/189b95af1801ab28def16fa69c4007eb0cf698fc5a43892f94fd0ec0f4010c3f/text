r4d-bf-rhs-k2 : (C : Type) → (Nat → Nat → Nat → Nat) → (Nat → Nat → Nat → Nat → Nat) →
  Nat → Nat → BstUF → BstUF → List Nat → R4dFrac → (R4dFrac → C) → C
r4d-bf-rhs-k2 C tf bndK k0 k1 n0 n1 ks2 acc cont = case ks2 of
  nil → cont acc
  cons k2 rest2 →
    (λ tk →
      r4d-simp-bf C 1 2 3 4 5 tf tk true (λ r0 →
      if r4d-fr-is-zero r0 then r4d-bf-rhs-k2 C tf bndK k0 k1 n0 n1 rest2 acc cont else
      r4d-simp-bf C 0 2 3 4 5 tf tk false (λ r1 →
      if r4d-fr-is-zero r1 then r4d-bf-rhs-k2 C tf bndK k0 k1 n0 n1 rest2 acc cont else
      r4d-simp-bf C 0 1 3 4 5 tf tk true (λ r2 →
      if r4d-fr-is-zero r2 then r4d-bf-rhs-k2 C tf bndK k0 k1 n0 n1 rest2 acc cont else
      r4d-tet-nsq C 2 3 4 5 tf k2 (λ n2 →
      r4d-force-fr C
        (r4d-fr-add acc
          (r4d-fr-mul (r4d-fr-mul r0 (r4d-fr-mul r1 r2))
                      ((bst-bmul (fst n0) (bst-bmul (fst n1) (fst n2)) , nil) ,
                       bst-bmul (snd n0) (bst-bmul (snd n1) (snd n2)))))
        (λ acc2 → r4d-bf-rhs-k2 C tf bndK k0 k1 n0 n1 rest2 acc2 cont))))))
    (r4d-rhs-tetK bndK k0 k1 k2)
