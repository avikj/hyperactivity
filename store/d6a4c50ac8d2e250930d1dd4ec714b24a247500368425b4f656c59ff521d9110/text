sc-certify-ta2 : List QmolState → Bool
sc-certify-ta2 bta =
  (λ m24 ts →
    if sc-z2-check-rows zero m24 m24 ts
    then both (sc-rump-pd ((sc-o (sc-o (sc-o bin-one)))) (sc-proj-mat m24 (sc-build-even zero ts)) sc-L-tae)
              (sc-rump-pd ((sc-o (sc-o (sc-o bin-one)))) (sc-proj-mat m24 (sc-build-odd  zero ts)) sc-L-tao)
    else false)
  (sc-shift-mat true bz-one bz-one bta)
  (sc-build-ts-adj bta bta)
