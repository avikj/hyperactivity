-- a Nat term's number through up to 64 Succ: a literal or Zero at the end, its cells followed
b2-natnum : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-natnum mm_ zero t acc kq_ =
  kq_ (h4-depl mm_ (b2-NNONE))
b2-natnum mm_ (suc f) t acc kq_ =
  b2-strip mm_ t (λ w → let mm_2473 = b2-dep mm_ w in let t_2475 = w in scmd (w-load ((b2-a mm_2473 t_2475))) (λ x_2474 → let mm_2476 = b2-dep mm_2473 x_2474 in let tg = (%wand x_2474 #255) in let t_2478 = w in let j_2479 = #0 in scmd (w-load ((b2-a mm_2476 (%wadd t_2478 (%wadd #2 j_2479))))) (λ x_2477 → let mm_2480 = b2-dep mm_2476 x_2477 in let lk = x_2477 in let t_2482 = w in let j_2483 = #1 in scmd (w-load ((b2-a mm_2480 (%wadd t_2482 (%wadd #2 j_2483))))) (λ x_2481 → let mm_2484 = b2-dep mm_2480 x_2481 in let v = x_2481 in if (andB (%weq tg b2-LIT) (%weq lk b2-LNAT)) then (kq_ (h4-depl mm_2484 ((%wadd acc v)))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NZero)) then (kq_ (h4-depl mm_2484 (acc))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NSucc)) then (let a_2486 = v in let j_2487 = #0 in scmd (w-load ((b2-a mm_2484 (%wadd a_2486 (%wsucc j_2487))))) (λ x_2485 → let mm_2488 = b2-dep mm_2484 x_2485 in let x = x_2485 in b2-natnum mm_2488 f x (%wsucc acc) kq_)) else (kq_ (h4-depl mm_2484 (b2-NNONE)))))))))
