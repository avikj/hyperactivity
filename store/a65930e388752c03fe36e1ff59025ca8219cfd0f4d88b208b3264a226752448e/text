b2-slicel : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-slicel mm_ zero a j beg acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-slicel mm_ (suc f) a j beg acc kq_ =
  if (%wlt j (%wsucc beg)) then (kq_ (h4-depl mm_ (acc))) else (let a_260 = a in let j_261 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_260 (%wsucc j_261))))) (λ x_259 → let mm_262 = b2-dep mm_ x_259 in let x = x_259 in b2-slicel mm_262 f a (%wsub j #1) beg (cons x acc) kq_))
