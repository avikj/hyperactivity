-- realized evaluation preserves inner parens inside strings and extracts realized code names (part of memory-is-local)
p-realized-example : p-eval-rhs (suc (suc zero)) (h-concat (cons "realized (prose (cons " (cons (h-quote "a(b)") (cons " nil)) (cons " (cons (h-quote "eq-1") (cons " nil)" nil)))))) ≡ ("a(b)" , cons "eq-1" nil)
p-realized-example = refl
