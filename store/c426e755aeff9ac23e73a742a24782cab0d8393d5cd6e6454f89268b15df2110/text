-- Dihedral cosine checks on the spin-1/2 quantum tetrahedron:
-- Singlet channel (K = 0): cos^2(theta_12) = 1 (anti-parallel); Triplet channel (K = 2): cos^2(theta_12) = 1/9.
qg-tet-cos2-k0 : bq-make true (fst (snd (qg-cos2-dihedral bin-one bin-one nil))) (snd (snd (qg-cos2-dihedral bin-one bin-one nil))) ≡ bq-make true bin-one bin-one
qg-tet-cos2-k0 = refl
