-- Checked UI Tree AST (safe, zero-script-injection declarative UI projected to DOM + Canvas)
data UiTree
  = ui-text (txt : List Word)
  | ui-heading (txt : List Word)
  | ui-box (cls : List Word) (children : List UiTree)
  | ui-row (children : List UiTree)
  | ui-canvas (w : Word) (h : Word) (ops : List CanvasOp)
  | ui-daw-btn (label : List Word) (eff : DawEffect)
