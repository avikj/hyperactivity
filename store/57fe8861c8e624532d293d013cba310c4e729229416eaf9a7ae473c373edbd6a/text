qmol-is-c4-loop : QmolState → QmolState → Bool
qmol-is-c4-loop a b =
  both (both (eqb (fst (fst a)) (fst (fst b))) (eqb (snd (fst a)) (snd (fst b))))
       (if qgm-vec-eq (qgm-vec-add BZ bz-add (snd a) qmol-c4-loop-p) (snd b) then true
        else qgm-vec-eq (qgm-vec-add BZ bz-add (snd a) qmol-c4-loop-m) (snd b))
