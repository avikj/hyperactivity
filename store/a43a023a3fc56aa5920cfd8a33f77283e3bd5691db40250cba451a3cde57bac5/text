b2-name : Word → Word → (Word → Step W Word) → Step W Word
b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_6753 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6753 b2-ERR)) else (b2-iskw mm_6753 k (λ kw → let mm_6754 = b2-dpb mm_6753 kw in if (kw) then (b2-nbytes mm_6754 k (λ kb → let mm_6755 = b2-dpl mm_6754 kb in let p_6757 = p in let i_6759 = (%wadd p_6757 #1) in scmd (w-load ((b2-a mm_6755 i_6759))) (λ x_6758 → let mm_6760 = b2-dep mm_6755 x_6758 in let x_6756 = x_6758 in let i = x_6756 in let p_6762 = p in let i_6764 = (%wadd p_6762 #1) in scmd (w-load ((b2-a mm_6760 i_6764))) (λ x_6763 → let mm_6765 = b2-dep mm_6760 x_6763 in let x_6761 = x_6763 in let ixq = x_6761 in b2-pfail mm_6765 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6766 = b2-dep mm_6765 r in kq_ (h4-depl mm_6766 (r))))))) else (kq_ (h4-depl mm_6754 (k))))))
