  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13631 = bk in let j_13632 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13631 (%wadd #2 j_13632))))) (λ x_13630 → let mm_13633 = b2-dep mm_ x_13630 in let ov = x_13630 in let v_13636 = ov in let j_13637 = j in scmd (w-load ((b2-a mm_13633 (%wadd v_13636 #2)))) (λ d_13634 → let mm_13638 = b2-dep mm_13633 d_13634 in scmd (w-load ((b2-a mm_13638 (%wadd d_13634 (%wsucc j_13637))))) (λ x_13635 → let mm_13639 = b2-dep mm_13638 x_13635 in let k = x_13635 in b2-tld mm_13639 bk k (λ t → let mm_13640 = b2-dep mm_13639 t in let t_13642 = t in scmd (w-load ((b2-a mm_13640 t_13642))) (λ x_13641 → let mm_13643 = b2-dep mm_13640 x_13641 in let tg = (%wand x_13641 #255) in let t_13644 = t in let j_13645 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13646 = #1 in scmd (w-store ((b2-a mm_13643 (%wadd t_13644 (%wadd #2 j_13645)))) (v_13646)) (λ uu_13647 → let mm_13648 = hv2-u mm_13643 uu_13647 in b2-markbase mm_13648 f bk (%wsucc j) n kq_)))))))
