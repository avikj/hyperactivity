b2-pushall : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pushall mm_ zero v ks j kq_ =
  kq_ (h4-depl mm_ (#0))
b2-pushall mm_ (suc f) v ks j kq_ =
  let a_1668 = ks in scmd (w-load ((b2-a mm_ a_1668))) (λ x_1667 → let mm_1669 = b2-dep mm_ x_1667 in let n = x_1667 in if (%weq j n) then (kq_ (h4-depl mm_1669 (#0))) else (let a_1671 = ks in let j_1672 = j in scmd (w-load ((b2-a mm_1669 (%wadd a_1671 (%wsucc j_1672))))) (λ x_1670 → let mm_1673 = b2-dep mm_1669 x_1670 in let k = x_1670 in b2-vpush mm_1673 v k (λ dd_1674 → let mm_1675 = b2-dep mm_1673 dd_1674 in b2-pushall mm_1675 f v ks (%wsucc j) kq_))))
