b2-wnfbatch : Word → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfbatch mm_ rx bk md a b c kq_ =
  scmd ((w-sys #900 #0 #0 #0 #0 #0 #0)) (λ mk → let mm_2856 = b2-dep mm_ mk in scmd (w-store ((b2-HR mm_2856 #10)) (#0)) (λ uu_2857 → let mm_2858 = hv2-u mm_2856 uu_2857 in rx mm_2858 md bk a b c #0 (λ r → let mm_2859 = b2-dep mm_2858 r in scmd (w-store ((b2-HR mm_2859 #7)) ((the Word (if %weq r b2-SUSP then #1 else #0)))) (λ uu_2860 → let mm_2861 = hv2-u mm_2859 uu_2860 in scmd (w-store ((b2-HR mm_2861 #8)) (r)) (λ uu_2862 → let mm_2863 = hv2-u mm_2861 uu_2862 in (scmd (w-sys #901 #0 #0 #0 #0 #0 #0) kq_))))))
