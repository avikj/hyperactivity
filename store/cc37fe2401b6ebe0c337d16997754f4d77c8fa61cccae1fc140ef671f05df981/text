-- 4. Unfactored Degree-3 Polynomial Pipeline Spec (6 muls) vs Horner Recurrence Impl (3 muls, -50%!)
--    v0 + v1*v4 + v2*v4^2 + v3*v4^3  ===  v0 + v4*(v1 + v4*(v2 + v4*v3))
vx-horner-spec : RProg
vx-horner-spec =
  rprog #5 nil
    (cons (re-add
            (re-add (re-v #0) (re-mul (re-v #1) (re-v #4)))
            (re-add (re-mul (re-v #2) (re-mul (re-v #4) (re-v #4)))
                    (re-mul (re-v #3) (re-mul (re-v #4) (re-mul (re-v #4) (re-v #4)))))) nil)
