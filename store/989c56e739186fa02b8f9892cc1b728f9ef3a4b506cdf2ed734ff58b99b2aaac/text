h4-strfold : Word → Nat → List Word → Word → (Word → Step W Word) → Step W Word
h4-strfold mm_ zero rcs t kq_ =
  kq_ (h4-depl mm_ (t))
h4-strfold mm_ (suc f) rcs t kq_ =
  if (%weq (cli-len rcs) #0) then (kq_ (h4-depl mm_ (t))) else (h4-ctr mm_ h4-CHR (cons (h4-num (hv2-nth #0 rcs)) nil) (λ h → let mm_58 = h4-dep mm_ h in h4-ctr mm_58 h4-CON (cons h (cons t nil)) (λ c → let mm_59 = h4-dep mm_58 c in h4-strfold mm_59 f (hv2-drop1 rcs) c kq_)))
