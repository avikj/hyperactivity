vx-rel-closed :
  Word → Word → Word →
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  VxMealyVerdict → Bool
vx-rel-closed s10 s20 nI stp1 stp2 (vx-refuted c) = false
vx-rel-closed s10 s20 nI stp1 stp2 (vx-proved rel) =
  web-andB (vx-pair-mem s10 s20 rel)
           (vx-rel-all-ok stp1 stp2 (toNat nI) rel rel)
