-- Exact squared matrix element |<K | J_1 . (J_2 x J_3) | Kp>|^2 = (1/16) * (k(k+1) - kp(kp+1))^2 * |<K | J_23^2 | Kp>|^2
-- computed DIRECTLY from the 6j recoupling commutator (i/4)[J_12^2, J_23^2] (for K >= Kp):
qv-q2-from-6j : Nat → Nat → Nat → Nat → Nat → Nat → BQ
qv-q2-from-6j J1 J2 J3 J4 K Kp =
  (λ diff → bq-mul (bq-make true (bin-of-nat (times diff diff)) (bin-of-nat 256))
                   (qv-j23-sq J1 J2 J3 J4 K Kp))
    (monus (times K (plus K 2)) (times Kp (plus Kp 2)))
