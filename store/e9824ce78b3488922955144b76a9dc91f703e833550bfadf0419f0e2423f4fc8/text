  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_5719 = vs in let j_5720 = j in scmd (w-load ((b2-a mm_ (%wadd a_5719 (%wsucc j_5720))))) (λ x_5718 → let mm_5721 = b2-dep mm_ x_5718 in let w = x_5718 in let t_5723 = w in let j_5724 = #1 in scmd (w-load ((b2-a mm_5721 (%wadd t_5723 (%wadd #2 j_5724))))) (λ x_5722 → let mm_5725 = b2-dep mm_5721 x_5722 in let wi = x_5722 in if (%weq wi i) then (kq_ (h4-depl mm_5725 (j))) else (b2-varidx mm_5725 f vs i (%wsucc j) n kq_))))
