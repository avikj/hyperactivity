b2-markbase : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13777 = bk in let j_13778 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13777 (%wadd #2 j_13778))))) (λ x_13776 → let mm_13779 = b2-dep mm_ x_13776 in let ov = x_13776 in let v_13782 = ov in let j_13783 = j in scmd (w-load ((b2-a mm_13779 (%wadd v_13782 #2)))) (λ d_13781 → let mm_13784 = b2-dep mm_13779 d_13781 in scmd (w-load ((b2-a mm_13784 (%wadd d_13781 (%wsucc j_13783))))) (λ x_13780 → let mm_13785 = b2-dep mm_13784 x_13780 in let k = x_13780 in b2-tld mm_13785 bk k (λ t → let mm_13786 = b2-dep mm_13785 t in let t_13788 = t in scmd (w-load ((b2-a mm_13786 t_13788))) (λ x_13787 → let mm_13789 = b2-dep mm_13786 x_13787 in let tg = (%wand x_13787 #255) in let t_13790 = t in let j_13791 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13792 = #1 in scmd (w-store ((b2-a mm_13789 (%wadd t_13790 (%wadd #2 j_13791)))) (v_13792)) (λ uu_13793 → let mm_13794 = hv2-u mm_13789 uu_13793 in b2-markbase mm_13794 f bk (%wsucc j) n kq_)))))))
