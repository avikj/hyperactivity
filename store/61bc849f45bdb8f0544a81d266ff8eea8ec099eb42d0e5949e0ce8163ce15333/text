-- Corollary (Information Capacity Bound Across Any Channel): 2^k <= |xs|.
qi-data-processing : (A B : Type) → (ch : A → B) → (k : Nat) → (qs : rp-Qs B k) → (xs : List A) →
  rp-Indep B k qs (qi-map A B ch xs) → le (rp-pow2 k) (rp-len A xs)
qi-data-processing A B ch k qs xs ind =
  rp-postulate1 A k (qi-pullback-qs A B ch k qs) xs (qi-data-processing-indep A B ch k qs xs ind)
