rqm-row-zero A E z ad mu cj ip a0r m0r w e bs = case bs return λ l → RqmAllOrth A E z ip e l → rqm-row A E z ad mu cj ip w e l ≡ z of
  nil → λ h → refl
  cons b rest → λ h → rqm-tr3 A
    (ad (mu (mu (cj w) (fst b)) (ip e (snd b))) (rqm-row A E z ad mu cj ip w e rest))
    (ad (mu (mu (cj w) (fst b)) z) z)
