-- from inside a parenthesis: up to the ) that closes it (kept)
e-cut-paren : Word → List Word → List Word
e-cut-paren d nil = nil
e-cut-paren d (cons c r) =
  if weq c #40 then e-cut-paren (wadd d #1) r
  else if weq c #41 then (if weq d #1 then cons c r else e-cut-paren (wsub d #1) r)
  else e-cut-paren d r
