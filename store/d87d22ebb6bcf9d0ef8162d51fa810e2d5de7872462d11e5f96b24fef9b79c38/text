qgm-edge-div-zero : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → QgmAb A z add neg →
  (x u w : Nat) → qgm-edge-div A z add neg x u w z ≡ z
qgm-edge-div-zero A z add neg ab x u w = concat
  (λ i → add
    ((case eqb x u return λ b → (if b then z else z) ≡ z of true → refl; false → refl) i)
    ((case eqb x w return λ b → (if b then neg z else z) ≡ z of true → qgm-negz A z add neg ab; false → refl) i))
  (qgm-zl A z add neg ab z)
