b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_7163 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_7163 (#1))) else (b2-pstr mm_7163 p (λ s → let mm_7164 = b2-dep mm_7163 s in let p_7166 = p in let i_7168 = (%wadd p_7166 #1) in scmd (w-load ((b2-a mm_7164 i_7168))) (λ x_7167 → let mm_7169 = b2-dep mm_7164 x_7167 in let x_7165 = x_7167 in let i = x_7165 in let a_7171 = s in scmd (w-load ((b2-a mm_7169 a_7171))) (λ x_7170 → let mm_7172 = b2-dep mm_7169 x_7170 in let n = x_7170 in b2-col mm_7172 s i (λ c → let mm_7173 = b2-dep mm_7172 c in kq_ (h4-depl mm_7173 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
