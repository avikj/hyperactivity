taut-tail-form : (A : Type) → A → (A → A → A) → (A → A → A) → A → List A → List A → A
taut-tail-form A z add mul c bs qs = case bs of
  nil → z
  cons bk br → case qs of
    nil → z
    cons qk qr →
      add (add (mul c (mul qk qk)) (add (mul bk qk) (mul qk bk)))
          (taut-tail-form A z add mul c br qr)
