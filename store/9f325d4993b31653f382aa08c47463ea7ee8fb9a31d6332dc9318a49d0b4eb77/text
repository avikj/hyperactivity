-- the argument cells an array native reads (their values), by index: the type and depth of a
-- new array; otherwise the array, its index, and an atomic's operands
b2-arrneed : Word → Word → Bool
b2-arrneed ic j = if %weq ic #100 then orB (%weq j #0) (%weq j #1) else if orB (%weq ic #105) (%weq ic #106) then %weq j #1 else if orB (%weq ic #103) (%weq ic #104) then orB (%weq j #1) (%weq j #2) else if orB (%weq ic #101) (%weq ic #102) then orB (%weq j #1) (%weq j #2) else %wlt #0 j
