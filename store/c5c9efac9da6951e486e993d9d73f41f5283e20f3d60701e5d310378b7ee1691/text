e-open-d : List Word → List Word → Bool × ((List Word × List Word) × List Word)
e-open-d tag r = if andB (h-not (h-null (e-upto-c #34 r))) (andB (h-infix e-q r) (h-infix ">" (e-or (e-after-c #34 r))))
  then (true , ((tag , e-upto-c #34 r) , e-or (e-after ">" (e-or (e-after-c #34 r))))) else e-open-fail
