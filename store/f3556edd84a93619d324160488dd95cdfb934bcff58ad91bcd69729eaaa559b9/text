b2-name : Word → Word → (Word → Step W Word) → Step W Word
b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_6680 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6680 b2-ERR)) else (b2-iskw mm_6680 k (λ kw → let mm_6681 = b2-dpb mm_6680 kw in if (kw) then (b2-nbytes mm_6681 k (λ kb → let mm_6682 = b2-dpl mm_6681 kb in let p_6684 = p in let i_6686 = (%wadd p_6684 #1) in scmd (w-load ((b2-a mm_6682 i_6686))) (λ x_6685 → let mm_6687 = b2-dep mm_6682 x_6685 in let x_6683 = x_6685 in let i = x_6683 in let p_6689 = p in let i_6691 = (%wadd p_6689 #1) in scmd (w-load ((b2-a mm_6687 i_6691))) (λ x_6690 → let mm_6692 = b2-dep mm_6687 x_6690 in let x_6688 = x_6690 in let ixq = x_6688 in b2-pfail mm_6692 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6693 = b2-dep mm_6692 r in kq_ (h4-depl mm_6693 (r))))))) else (kq_ (h4-depl mm_6681 (k))))))
