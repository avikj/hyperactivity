-- MSUB Xd, Xn, Xm, Xa = Xa - Xn * Xm : 0x9b008000 (#2600501248) | (Rm<<16) | (Ra<<10) | (Rn<<5) | Rd
a64-msub : Word → Word → Word → Word → Lst Word
a64-msub rd rn rm ra =
  a64-insn (a64-or #2600501248 (a64-or (a64-shl (a64-and rm #31) #16)
           (a64-or (a64-shl (a64-and ra #31) #10) (a64-or (a64-shl (a64-and rn #31) #5) (a64-and rd #31)))))
