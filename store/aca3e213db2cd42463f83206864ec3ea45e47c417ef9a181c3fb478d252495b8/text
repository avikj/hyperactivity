vpi-target-arg : List (List Word) → List Word
vpi-target-arg nil = nil
vpi-target-arg (cons a rest) =
  if h-eq a "--with" then
    case rest of
      nil → nil
      cons _ rest2 →
        case rest2 of
          nil → nil
          cons _ rest3 → vpi-target-arg rest3
  else if h-prefix "--" a then vpi-target-arg rest
  else if vpi-infix "hx-visionpro-founder" a then a
  else vpi-target-arg rest
