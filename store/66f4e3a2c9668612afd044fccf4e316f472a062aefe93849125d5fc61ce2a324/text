-- read until n bytes or the end: (got, error)
hio-readn : Nat → Word → Word → Word → Word → (Word → Word → Step W Word) → Step W Word
hio-readn zero fd buf n got k = k got #0
hio-readn (suc f) fd buf n got k =
  if %weq got n then k got #0
  else scmd (w-sys #0 fd (%wadd buf got) (%wsub n got) #0 #0 #0) (λ r →
       if hio-neg r then k got #1
       else if %weq r #0 then k got #0
       else hio-readn f fd buf n (%wadd got r) k)
