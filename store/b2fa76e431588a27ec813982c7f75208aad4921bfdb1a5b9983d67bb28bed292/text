grv-bhat-m2 : (C : Type) → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
  GrvBuckets → (GrvBuckets → C) → C
grv-bhat-m2 C dj1 dj2 dj3 dj4 di dk halfS m1 fuel2 b cont = case fuel2 of
  zero → cont b
  suc m2 →
    grv-bhat-m3 C dj1 dj2 dj3 dj4 di dk halfS m1 m2 (suc dj3) b (λ b2 →
      grv-bhat-m2 C dj1 dj2 dj3 dj4 di dk halfS m1 m2 b2 cont)
