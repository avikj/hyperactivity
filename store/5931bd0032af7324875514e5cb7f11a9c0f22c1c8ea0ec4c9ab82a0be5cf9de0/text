b2-sat : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-sat mm_ zero a p at j m kq_ =
  kq_ (h4-depl mm_ (#0))
b2-sat mm_ (suc f) a p at j m kq_ =
  if (%weq j m) then (kq_ (h4-depl mm_ (#1))) else (let a_2741 = a in let j_2742 = (%wadd at j) in scmd (w-load ((b2-a mm_ (%wadd a_2741 (%wsucc j_2742))))) (λ x_2740 → let mm_2743 = b2-dep mm_ x_2740 in let x = x_2740 in let a_2745 = p in let j_2746 = j in scmd (w-load ((b2-a mm_2743 (%wadd a_2745 (%wsucc j_2746))))) (λ x_2744 → let mm_2747 = b2-dep mm_2743 x_2744 in let y = x_2744 in if (not (%weq x y)) then (kq_ (h4-depl mm_2747 (#0))) else (b2-sat mm_2747 f a p at (%wsucc j) m kq_))))
