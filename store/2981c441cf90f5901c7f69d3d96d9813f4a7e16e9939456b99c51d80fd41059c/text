emg-sos-vec-nonneg : (A : Type) → (z : A) → (add mul : A → A → A) → (Pos Nonneg : A → Type) →
  ScOrd A z add mul Pos Nonneg → (c : A) → (bs qs : List A) →
  Nonneg (emg-sos-vec A z add mul c bs qs)
emg-sos-vec-nonneg A z add mul Pos Nonneg ord c bs =
  case bs return λ blist → (qs : List A) → Nonneg (emg-sos-vec A z add mul c blist qs) of
    nil → λ qs → fst ord
    cons bk br → emg-sos-vec-cons A z add mul Pos Nonneg ord c bk br (rec br)
