-- Exact singlet correlator E(a, b) = p(+,+) - p(+,-) - p(-,+) + p(-,-) directly from the 4 joint probabilities!
qe-singlet-E : (BQ × BQ) → (BQ × BQ) → BQ
qe-singlet-E a b =
  bq-add
    (bq-add (qe-singlet-prob a b true true) (qe-singlet-prob a b false false))
    (qe-bq-neg (bq-add (qe-singlet-prob a b true false) (qe-singlet-prob a b false true)))
