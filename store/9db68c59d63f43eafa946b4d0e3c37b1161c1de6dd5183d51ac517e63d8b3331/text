hyperos-deploy-sh-p3 : List Word
hyperos-deploy-sh-p3 =
  os-lines-q
    (cons "    <key>CUBICAL_METAL</key><string>1</string>"
    (cons "    <key>CUBICAL_WORKERS</key><string>auto</string>"
    (cons "  </dict>"
    (cons "  <key>ProcessType</key><string>Interactive</string>"
    (cons "  <key>RunAtLoad</key><true/>"
    (cons "  <key>KeepAlive</key><true/>"
    (cons "  <key>StandardOutPath</key><string>/tmp/hx_hypernet_mesh.log</string>"
    (cons "  <key>StandardErrorPath</key><string>/tmp/hx_hypernet_mesh.err</string>"
    (cons "</dict></plist>"
    (cons "PLIST"
    (cons "    launchctl bootout `gui/$(id -u)/ai.hyperactivity.hypernet` >/dev/null 2>&1 || true"
    (cons "    launchctl bootstrap `gui/$(id -u)` `$LA/ai.hyperactivity.hypernet.plist` >/dev/null 2>&1 || true"
    (cons "    echo `[LAUNCHD MESH] Active: ai.hyperactivity.hypernet (UDP :47700 Thunderbolt + LAN + Bonjour + CUBICAL_METAL=1)`"
    (cons "  fi"
    (cons "  if [ `$MODE` = `all` ] || [ `$MODE` = `visionpro` ]; then"
    (cons "    if [ -x `$REPO/build/cubical` ]; then"
    (cons "      `$REPO/build/cubical` `$REPO/lib/hx-visionpro-founder.hypercubical` || true"
    (cons "    fi"
    (cons "  fi"
    (cons "fi"
    (cons "chmod +x `$OUT/boot_m1n1_apple_silicon.sh`"
    (cons "echo `[READY] Hypernet + Bare-Metal HyperOS materialization complete in $OUT`"
    nil))))))))))))))))))))))
