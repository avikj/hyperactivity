-- Universal Impossibility over Arbitrary-Length Benchmark Suites (including all 2^13 = 8,192 static tables!):
taut-no-static-when-diff : (c w1 w2 : List Bool) →
  rxn-bvec-eq w1 w2 ≡ false →
  rxn-bvec-eq c w1 ≡ true → rxn-bvec-eq c w2 ≡ true → Empty
taut-no-static-when-diff c w1 w2 hdiff hc1 hc2 =
  taut-bool-false-neq-true (lor-tr Bool false (rxn-bvec-eq w1 w2) true (sym hdiff) (taut-bvec-trans c w1 w2 hc1 hc2))
