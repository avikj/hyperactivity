qv-q2-elem : Nat → Nat → Nat → Nat → Nat → BQ
qv-q2-elem J1 J2 J3 J4 K =
  bq-make true
    (bin-mul
      (bin-mul (qv-sub-bin (qv-sq (plus (plus J1 J2) 2)) (qv-sq K))
               (qv-sub-bin (qv-sq K) (qv-sq (qv-abs-diff J1 J2))))
      (bin-mul (qv-sub-bin (qv-sq (plus (plus J3 J4) 2)) (qv-sq K))
               (qv-sub-bin (qv-sq K) (qv-sq (qv-abs-diff J3 J4)))))
    (bin-mul (bin-pow2 12) (bin-of-nat (times (suc K) (monus K 1))))
