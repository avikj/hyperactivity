b2-take : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-take mm_ p w kq_ =
  b2-at mm_ p w (λ r → let mm_6656 = b2-dep mm_ r in if (%weq r #0) then (kq_ (h4-depl mm_6656 (#0))) else (let p_6658 = p in let i_6660 = (%wadd p_6658 #1) in scmd (w-load ((b2-a mm_6656 i_6660))) (λ x_6659 → let mm_6661 = b2-dep mm_6656 x_6659 in let x_6657 = x_6659 in let i = x_6657 in let p_6662 = p in let v_6663 = (%wadd i (cli-len w)) in let i_6664 = (%wadd p_6662 #1) in let v_6665 = v_6663 in scmd (w-store ((b2-a mm_6661 i_6664)) (v_6665)) (λ uu_6666 → let mm_6667 = hv2-u mm_6661 uu_6666 in kq_ (h4-depl mm_6667 (#1))))))
