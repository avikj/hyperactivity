-- H v, with t, k, l the three numbers and nt, nk their negatives
ra-h : (A : Type) → (A → A → A) → (A → A → A) → A → A → A → List A → List A → List A
ra-h A ad mu z nt nk pot v = ra-add A ad (ra-mul A mu pot v)
  (ra-add A ad (ra-scale A mu nt (ra-add A ad (ra-up A z 1 v) (ra-down A z 1 v)))
    (ra-scale A mu nk (ra-add A ad (ra-up A z 6 v) (ra-down A z 6 v))))
