emg-li-q : Nat → Nat → Nat → Nat → BZ
emg-li-q v u1 u2 d =
  qmol-bz-sub
    (qmol-bz-sub
      (qmol-bz-sub (if eqb v 0 then sc-p (sc-i bin-one) else bz-zero)
                   (if eqb v u1 then bz-one else bz-zero))
      (if eqb v u2 then bz-one else bz-zero))
    (if eqb v d then bz-one else bz-zero)
