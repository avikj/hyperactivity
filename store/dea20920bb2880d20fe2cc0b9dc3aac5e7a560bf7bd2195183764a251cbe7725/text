b2-classg : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-classg mm_ zero t kq_ =
  kq_ (h4-depl mm_ (t))
b2-classg mm_ (suc f) t kq_ =
  let t_1980 = t in let j_1981 = #3 in scmd (w-load ((b2-a mm_ (%wadd t_1980 (%wadd #2 j_1981))))) (λ x_1979 → let mm_1982 = b2-dep mm_ x_1979 in let c = x_1979 in if (%weq c #0) then (kq_ (h4-depl mm_1982 (t))) else (let t_1984 = c in let j_1985 = #3 in scmd (w-load ((b2-a mm_1982 (%wadd t_1984 (%wadd #2 j_1985))))) (λ x_1983 → let mm_1986 = b2-dep mm_1982 x_1983 in let cc = x_1983 in let c2 = the Word (if %weq cc #0 then c else cc) in let t_1987 = t in let j_1988 = #3 in let v_1989 = c2 in scmd (w-store ((b2-a mm_1986 (%wadd t_1987 (%wadd #2 j_1988)))) (v_1989)) (λ uu_1990 → let mm_1991 = hv2-u mm_1986 uu_1990 in b2-classg mm_1991 f c2 kq_))))
