-- Hyperdimensional Clebsch Graph `srg(16, 5, 0, 2)` (5-cube folded by antipodal `v ^ 15`):
-- Generators = {1, 2, 4, 8, 15}. Every pair (u, v) in 0..15 connects in <= 2 hops!
hxp-pop4 : Word → Word
hxp-pop4 d =
  %wadd (%wand d #1)
  (%wadd (%wand (%wshr d #1) #1)
  (%wadd (%wand (%wshr d #2) #1)
         (%wand (%wshr d #3) #1)))
