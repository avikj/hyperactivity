sf-eprl-fold3 : Nat → Nat → Nat → Nat → Nat → Nat → BQ → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → BQ → BQ
sf-eprl-fold3 Jp Jm ip1 im1 ip2 im2 wt2 opts3 opts4 opts5 acc = case opts3 of
  nil → acc
  cons o3 rest3 →
    sf-eprl-fold3 Jp Jm ip1 im1 ip2 im2 wt2 rest3 opts4 opts5
      (sf-eprl-fold4 Jp Jm ip1 im1 ip2 im2 (fst o3) (fst (snd o3)) (bq-mul wt2 (snd (snd o3))) opts4 opts5 acc)
