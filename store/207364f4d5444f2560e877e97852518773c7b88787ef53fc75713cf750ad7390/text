b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_2864 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_2864 #7))) (λ kd → let mm_2865 = b2-dep mm_2864 kd in scmd (w-load ((b2-HR mm_2865 #8))) (λ v → let mm_2866 = b2-dep mm_2865 v in if (%weq kd #0) then (kq_ (h4-depl mm_2866 (v))) else (scmd (w-load ((b2-HR mm_2866 #11))) (λ md2 → let mm_2867 = b2-dep mm_2866 md2 in scmd (w-load ((b2-HR mm_2867 #12))) (λ a2 → let mm_2868 = b2-dep mm_2867 a2 in scmd (w-load ((b2-HR mm_2868 #13))) (λ b2 → let mm_2869 = b2-dep mm_2868 b2 in scmd (w-load ((b2-HR mm_2869 #14))) (λ c2 → let mm_2870 = b2-dep mm_2869 c2 in b2-wnfrun mm_2870 f rx bk md2 a2 b2 c2 kq_))))))))
