e-era : List Word → Bool
e-era w = orB (h-has w e-eras)
  (orB (andB (h-prefix "Proto-" w) (andB (h-not (h-null (h-drop "Proto-" w))) (h-null (e-filter-w (λ c → h-not (orB (e-wordc c) (weq c #45))) (h-drop "Proto-" w)))))
       (andB (h-prefix "Anglo-" w) (andB (h-not (h-null (h-drop "Anglo-" w))) (h-null (e-filter-w (λ c → h-not (e-wordc c)) (h-drop "Anglo-" w))))))
