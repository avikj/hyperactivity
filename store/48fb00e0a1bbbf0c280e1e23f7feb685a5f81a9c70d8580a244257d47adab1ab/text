e-here : List (List (List Word)) → Sum Unit (List Word) → Bool × (List Word × List Word) → List Word → Bool → Bool → Word → Bool × List (List (List Word))
e-here found (inr name) bare plain seen active n = e-here-with found (e-active seen active plain) plain name n
e-here found (inl u) bare plain seen active n =
  if andB (fst bare) (h-not (e-not-name (snd (snd bare))))
  then e-here-with found (e-active seen active (fst (snd bare))) (fst (snd bare)) (snd (snd bare)) n
  else e-here-with found (e-active seen active plain) plain nil n
