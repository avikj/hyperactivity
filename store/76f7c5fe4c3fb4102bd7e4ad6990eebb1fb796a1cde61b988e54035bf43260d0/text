-- 1. `star_inequality` + Level-Excess + Crude-Share + Masullo Ring Trace Subtraction (19 muls -> 2 muls)
--    Inputs: 0=d (rowDim), 1=m, 2=k (or w_bar), 3=U (dirCost / G / b^2),
--            4=rem (remainder / b15), 5=L (tr_spec), 6=x99 (tr_ext), 7=B_idx (tr_geom)
ga-star-spec : RProg
ga-star-spec =
  rprog #8
    (cons (#8  , re-mul (re-mul (re-v #1) (re-v #2)) (re-v #3))
    (cons (#9  , re-add (re-sub (re-v #8) (re-mul (re-v #1) (re-v #4))) (re-v #5))
    (cons (#10 , re-add (re-mul (re-v #0) (re-v #9))
                        (re-add (re-mul (re-k zi-four) (re-mul (re-v #0) (re-v #6)))
                                (re-mul (re-k ga-zi-10) (re-mul (re-v #0) (re-v #7)))))
    (cons (#11 , re-mul (re-v #0) (re-sub (re-v #8) (re-mul (re-k ga-zi-3) (re-v #5)))) nil))))
    (cons (re-sub (re-v #10) (re-v #11))
    (cons (re-sub (re-mul (re-mul (re-k zi-four) (re-v #0)) (re-mul (re-v #3) (re-v #6)))
                  (re-mul (re-v #3) (re-mul (re-mul (re-k zi-four) (re-v #0)) (re-v #6))))
    (cons (re-sub (re-sub (re-sub (re-mul (re-v #1) (re-add (re-v #2) (re-v #3))) (re-v #3)) (re-v #4))
                  (re-add (re-mul (re-v #1) (re-v #2)) (re-mul (re-sub (re-v #1) (re-k zi-one)) (re-v #3))))
    (cons (re-sub (re-sub (re-add (re-v #5) (re-v #6)) (re-v #7))
                  (re-sub (re-v #5) (re-v #7))) nil))))
