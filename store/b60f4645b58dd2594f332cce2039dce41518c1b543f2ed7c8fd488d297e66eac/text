e-stems : List Word → List (List Word)
e-stems stem = e-filter (λ b → h-not (h-null b)) (cons stem (cons (list-append stem "e")
  (cons (if andB (e-nat-le (toNat #2) (list-length stem)) (weq (e-last-byte stem) (e-last-byte (e-cut-end "x" stem))) then e-cut-end "x" stem else nil)
  (cons (list-append stem "y") (cons (if h-ends "i" stem then list-append (e-cut-end "i" stem) "y" else nil) nil)))))
