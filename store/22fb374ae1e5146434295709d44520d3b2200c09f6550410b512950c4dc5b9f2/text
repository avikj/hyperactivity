  b2-lexeme mm_ p (λ k → let mm_7927 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_7927 b2-ERR)) else (b2-iskw mm_7927 k (λ kw → let mm_7928 = b2-dpb mm_7927 kw in if (kw) then (b2-nbytes mm_7928 k (λ kb → let mm_7929 = b2-dpl mm_7928 kb in let p_7931 = p in let i_7933 = (%wadd p_7931 #1) in scmd (w-load ((b2-a mm_7929 i_7933))) (λ x_7932 → let mm_7934 = b2-dep mm_7929 x_7932 in let x_7930 = x_7932 in let i = x_7930 in let p_7936 = p in let i_7938 = (%wadd p_7936 #1) in scmd (w-load ((b2-a mm_7934 i_7938))) (λ x_7937 → let mm_7939 = b2-dep mm_7934 x_7937 in let x_7935 = x_7937 in let ixq = x_7935 in b2-pfail mm_7939 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_7940 = b2-dep mm_7939 r in kq_ (h4-depl mm_7940 (r))))))) else (kq_ (h4-depl mm_7928 (k))))))
