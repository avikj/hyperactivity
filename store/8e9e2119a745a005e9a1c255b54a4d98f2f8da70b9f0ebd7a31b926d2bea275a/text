h4-adwrap : Word → Nat → Word → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-adwrap mm_ zero i kk lab lvl base tgt ext res kq_ =
  kq_ (h4-depl mm_ (res))
h4-adwrap mm_ (suc f) i kk lab lvl base tgt ext res kq_ =
  if (%weq i #0) then (kq_ (h4-depl mm_ (res))) else (let j = %wsub i #1 in let v = if %weq j #0 then h4-new tgt ext lvl else h4-new h4-BJ1 (%wsub (%wadd lab j) #1) (%wadd base j) in h4-mk2 mm_ h4-DUP (%wadd lab j) v res (λ r → let mm_51 = h4-dep mm_ r in h4-adwrap mm_51 f j kk lab lvl base tgt ext r kq_))
