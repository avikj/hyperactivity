b2-nlg : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-nlg mm_ zero s j kq_ =
  kq_ (h4-depl mm_ (#1))
b2-nlg mm_ (suc f) s j kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (#1))) else (let a_6407 = s in let j_6408 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_6407 (%wsucc j_6408))))) (λ x_6406 → let mm_6409 = b2-dep mm_ x_6406 in let c = x_6406 in if (%weq c #10) then (kq_ (h4-depl mm_6409 (#1))) else (if (orB (%weq c #32) (orB (%weq c #13) (%weq c #9))) then (b2-nlg mm_6409 f s (%wsub j #1) kq_) else (kq_ (h4-depl mm_6409 (#0))))))
