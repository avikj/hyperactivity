cl-exec : Proc W Unit
cl-exec =
  bind h-args (λ av →
    let clean  = cl-drop-with (cl-tail av)
        rest   = cl-tail clean
        mode   = cl-arg-at zero "write-www" rest
        handle = cl-arg-at (suc zero) "founder_avik" rest
        cPath  = the (List Word) "/tmp/hy_out/hx_collablink_bridge.c"
        binP   = the (List Word) "/tmp/hy_out/hx_collablink_bridge"
    in bind (h-capture (cons "/bin/mkdir" (cons "-p" (cons "/tmp/hy_out/hyperos_8080/www" (cons "/tmp/hx_agent_bus" nil))))) (λ m0 →
       bind (h-write "/tmp/hy_out/hyperos_8080/www/collab.html" cl-collablink-html) (λ w1 →
       bind (h-write "/tmp/hy_out/hx_collablink.html" cl-collablink-html) (λ w2 →
       bind (h-write cPath cl-bridge-c-full) (λ w3 →
       bind (h-capture (cons "/usr/bin/cc" (cons "-std=c11" (cons "-O2" (cons "-fsanitize=undefined" (cons "-fno-sanitize-recover=all" (cons cPath (cons "-o" (cons binP nil))))))))) (λ rCc →
         if %weq (fst rCc) #0 then
           if h-eq mode "write-www" then
             h-out (list-append "[HX-COLLABLINK] Wrote collab.html + compiled UBSan-clean bridge binary: " (list-append binP cl-nl))
           else
             bind (h-run (cons binP (cons mode (cons handle nil)))) (λ rc → ret {lzero} {W} unit)
         else h-out (list-append "[HX-COLLABLINK] C11 compile failed: " (snd rCc))))))))
