-- the one rule, in memory
hr-do : List Hv2Def → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
hr-do book r m a b k =
  if %weq r hv2-LINK then hr-ln m a b k
  else if %weq r hv2-CALL then hr-call book m a b k
  else if %weq r hv2-VOID then k m
  else if %weq r hv2-ERAS then hr-eras m a b k
  else if %weq r hv2-ANNI then hr-anni m a b k
  else if %weq r hv2-COMM then hr-comm m a b k
  else if %weq r hv2-OPER then hr-oper m a b k
  else hr-swit m a b k
