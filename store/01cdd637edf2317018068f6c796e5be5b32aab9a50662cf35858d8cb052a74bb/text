-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_11674 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_11674))) (λ x_11673 → let mm_11675 = b2-dep mm_ x_11673 in let lb = x_11673 in if (%weq lb #0) then (let i_11677 = (%wadd tc #4) in scmd (w-load ((b2-a mm_11675 i_11677))) (λ x_11676 → let mm_11678 = b2-dep mm_11675 x_11676 in let t = x_11676 in kq_ (h4-depl mm_11678 (t)))) else (let i_11680 = (%wadd tc #3) in scmd (w-load ((b2-a mm_11675 i_11680))) (λ x_11679 → let mm_11681 = b2-dep mm_11675 x_11679 in let lx = x_11679 in b2-body mm_11681 bk lb lx (λ r → let mm_11682 = b2-dep mm_11681 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_11682 b2-ERR)) else (kq_ (h4-depl mm_11682 (r)))))))
