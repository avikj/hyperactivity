b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_7062 = b2-dep mm_ c in let p_7064 = p in let i_7066 = (%wadd p_7064 #1) in scmd (w-load ((b2-a mm_7062 i_7066))) (λ x_7065 → let mm_7067 = b2-dep mm_7062 x_7065 in let x_7063 = x_7065 in let i = x_7063 in let p_7068 = p in let v_7069 = (%wsucc i) in let i_7070 = (%wadd p_7068 #1) in let v_7071 = v_7069 in scmd (w-store ((b2-a mm_7067 i_7070)) (v_7071)) (λ uu_7072 → let mm_7073 = hv2-u mm_7067 uu_7072 in kq_ (h4-depl mm_7073 (c)))))
