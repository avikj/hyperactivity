-- Exact 3D Discrete Bianchi Identity on K_4: f0 + f1 + f2 + f3 = (0,0,0,0,0,0) (boundary of boundary = 0)!
tc-k4-bianchi :
  qgm-vec-eq
    (qgm-vec-add BZ bz-add (qgm-vec-add BZ bz-add tc-face0 tc-face1)
                           (qgm-vec-add BZ bz-add tc-face2 tc-face3))
    (tc-vec6 bz-zero bz-zero bz-zero bz-zero bz-zero bz-zero) ≡ true
tc-k4-bianchi = refl
