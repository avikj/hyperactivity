hv2-safe-round : List (List Word) → List (List Word) → List (List Word × Hv2Ast) → List Bool → List Bool
hv2-safe-round all nil defs safes = nil
hv2-safe-round all (cons n r) defs safes =
  cons (andB (hv2-bool-at (hv2-index n all) safes) (hv2-all-safe (hv2-refs-ast (hv2-ast-of n defs)) all safes)) (hv2-safe-round all r defs safes)
