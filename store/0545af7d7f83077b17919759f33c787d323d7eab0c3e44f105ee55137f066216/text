sf-ninej-loop : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ → BQ
sf-ninej-loop fuel j1 j2 j3 j4 j5 j6 j7 j8 j9 acc = case fuel of
  zero → acc
  suc x → sf-ninej-loop x j1 j2 j3 j4 j5 j6 j7 j8 j9
    (if both (both (tri-ok j1 j9 x) (tri-ok j4 j8 x)) (tri-ok j2 j6 x)
     then bq-add acc (sf-ninej-term j1 j2 j3 j4 j5 j6 j7 j8 j9 x)
     else acc)
