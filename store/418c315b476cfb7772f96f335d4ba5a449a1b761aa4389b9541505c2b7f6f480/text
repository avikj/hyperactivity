hr-cd-nfill : Nat → Word → Word → Word → Nat → Word → Word → List (Word × Word) → Word → Word → List Word → Word → Word → (Word → Step W Word) → Step W Word
hr-cd-nfill zero m a v nv va vv ns nb vb rb root b k = hr-cd-vfill nv m va vv ns nb vb rb root b k
hr-cd-nfill (suc n) m a v nv va vv ns nb vb rb root b k =
  scmd (w-store a v) (λ u → hr-cd-nfill n (hv2-u m u) (%wadd a #8) (%wsucc v) nv va vv ns nb vb rb root b k)
