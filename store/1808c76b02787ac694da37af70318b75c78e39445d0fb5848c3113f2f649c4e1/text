ts-step : Word → Word → Word → Word → Word → TsState → TsState
ts-step re rm bl dt vIn (ts-st ic vel) =
  let di = uf-add (uf-sub (uf-neg (uf-mul16 re ic)) (uf-mul16 bl vel)) vIn
      dv = uf-sub (uf-mul16 bl ic) (uf-mul16 rm vel)
  in ts-st (uf-add ic (uf-mul16 dt di)) (uf-add vel (uf-mul16 dt dv))
