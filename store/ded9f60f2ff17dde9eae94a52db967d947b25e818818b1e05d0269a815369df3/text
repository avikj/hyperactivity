-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13120 = seen in let j_13121 = j in scmd (w-load ((b2-a mm_ (%wadd v_13120 #2)))) (λ d_13119 → let mm_13122 = b2-dep mm_ d_13119 in scmd (w-load ((b2-a mm_13122 (%wadd d_13119 (%wsucc j_13121))))) (λ x_13118 → let mm_13123 = b2-dep mm_13122 x_13118 in let e = x_13118 in let i_13125 = e in scmd (w-load ((b2-a mm_13123 i_13125))) (λ x_13124 → let mm_13126 = b2-dep mm_13123 x_13124 in let x = x_13124 in if (%weq x p) then (kq_ (h4-depl mm_13126 (e))) else (b2-seenat mm_13126 f seen p (%wsucc j) n kq_)))))
