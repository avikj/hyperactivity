-- lightweight custom event hooks (outbound link clicks, synesthesia toggle, site search) fired only when window.umami is loaded
um-events-js : List Word
um-events-js = "<script>(function(){document.addEventListener('click',function(e){if(!window.umami)return;var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;if(a&&a.hostname&&a.hostname!==location.hostname){window.umami.track('outbound',{url:a.href});return}var b=e.target&&e.target.closest?e.target.closest('#syn,#sfind'):null;if(b)window.umami.track(b.id==='syn'?'synesthesia':'search')})})()</script>"
