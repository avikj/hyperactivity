d-find-ctor : (Word → Word → Bool) → Lst (Word × Word) → Lst (Lst (Word × Word)) → Lst Word → Word → Opt Word
d-find-ctor sub ks1 lnil used c2 = none
d-find-ctor sub ks1 (lcons ks2 r2) used c2 =
  if d-wmem c2 used then d-find-ctor sub ks1 r2 used (%wsucc c2)
  else if d-fields-iso sub ks1 ks2 then some c2
  else d-find-ctor sub ks1 r2 used (%wsucc c2)
