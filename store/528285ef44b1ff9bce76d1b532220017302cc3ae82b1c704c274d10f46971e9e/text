b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_7826 → let mm_7827 = b2-dep mm_ dd_7826 in b2-take mm_7827 p "-" (λ m → let mm_7828 = b2-dep mm_7827 m in if (%weq m #1) then (kq_ (h4-depl mm_7828 (b2-NONE))) else (b2-take mm_7828 p "+" (λ pl → let mm_7829 = b2-dep mm_7828 pl in if (%weq pl #1) then (kq_ (h4-depl mm_7829 (b2-MANY))) else (kq_ (h4-depl mm_7829 (b2-LONE))))))))
