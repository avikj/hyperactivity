-- Canonical vertex-ordered Ooguri BF 4-simplex rational inner factor (factored 6j * 9j * 6j form):
r4d-canon-ok : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
  Nat → Nat → Nat → Nat → Nat → Bool
r4d-canon-ok j01 j02 j03 j04 j12 j13 j14 j23 j24 j34 k0 k1 k2 k3 k4 =
  both
    (both (both (tri-ok j01 j02 k0) (tri-ok j03 j04 k0))
          (both (tri-ok j01 j12 k1) (tri-ok j13 j14 k1)))
    (both (both (both (tri-ok j02 j12 k2) (tri-ok j23 j24 k2))
                (both (tri-ok j03 j13 k3) (tri-ok j23 j34 k3)))
          (both (both (tri-ok j04 j14 k4) (tri-ok j24 j34 k4))
                (both (tri-ok k0 k1 k2) (tri-ok k2 k3 k4))))
