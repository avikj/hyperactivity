-- 2. Universal 11-Space Co-Rank-1 Seesaw & Rallis m^2-Turn Square Invariants over Z[k, rho, j]
--    Inputs: 0=k, 1=rho, 2=j; m = 2*rho + 2, r = k + m - 1, t = 5*r,
--            rank(X_m) = k + m*(t + 1), rank(Y_m) = r + m*t, rank(W_j) = r, rank(V_j) = r + t
--    Proves rank(X_m) - rank(Y_m) == 1 AND (rank(Y_j) - rank(Y_{j-1})) == (rank(V_j) - rank(W_j))!
ga-corank-spec : RProg
ga-corank-spec =
  rprog #3
    (cons (#3 , re-add (gn-dbl (re-v #1)) (re-k zi-two))
    (cons (#4 , re-sub (re-add (re-v #0) (re-v #3)) (re-k zi-one))
    (cons (#5 , re-mul (re-k ga-zi-5) (re-v #4))
    (cons (#6 , re-add (re-v #0) (re-mul (re-v #3) (re-add (re-v #5) (re-k zi-one))))
    (cons (#7 , re-add (re-v #4) (re-mul (re-v #3) (re-v #5)))
    (cons (#8 , re-add (re-v #4) (re-mul (re-v #2) (re-v #5)))
    (cons (#9 , re-add (re-v #4) (re-mul (re-sub (re-v #2) (re-k zi-one)) (re-v #5))) nil)))))))
    (cons (re-sub (re-sub (re-v #6) (re-v #7)) (re-k zi-one))
    (cons (re-sub (re-sub (re-v #8) (re-v #9)) (re-sub (re-add (re-v #4) (re-v #5)) (re-v #4))) nil))
