rxn-orbits : RxnGraph → RxnGraph → RxnGraph → Nat × (Nat × Nat)
rxn-orbits patL patR hostG =
  (λ n →
    rxn-force-nmat (Nat × (Nat × Nat)) (rxn-perms n) (λ ps →
    rxn-force-nvec (Nat × (Nat × Nat)) (rxn-range 0 n) (λ rng →
      rxn-orbit-loop patL patR hostG ps ps rng zero nil nil)))
  (rxn-len Nat (fst hostG))
