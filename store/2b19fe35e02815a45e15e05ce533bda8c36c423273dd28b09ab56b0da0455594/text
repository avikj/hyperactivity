-- fresh nodes and variables, when the free stacks hold too few: their indices written above the
-- stack's top, so that every placement is read from a stack
hr-cd-vfill : Nat → Word → Word → Word → List (Word × Word) → Word → Word → List Word → Word → Word → (Word → Step W Word) → Step W Word
hr-cd-vfill zero m a v ns nb vb rb root b k = hr-cd-nodes ns m nb vb rb root b k
hr-cd-vfill (suc n) m a v ns nb vb rb root b k =
  scmd (w-store a v) (λ u → hr-cd-vfill n (hv2-u m u) (%wadd a #8) (%wsucc v) ns nb vb rb root b k)
