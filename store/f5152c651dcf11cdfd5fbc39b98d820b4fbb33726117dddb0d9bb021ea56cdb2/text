e-pieces : List Word → List Word → Proc W (List (List Word))
e-pieces file prefix = bind (e-cmd (cons "split" (cons "-b" (cons "262144" (cons "-a" (cons "5" (cons "-d" (cons file (cons (list-append "build/etym/tmp/" prefix) nil))))))))) (λ s →
  bind (h-list "build/etym/tmp") (λ fs → ret (list-map (λ f → list-append "build/etym/tmp/" f) (h-msort (e-filter (λ f → h-prefix prefix f) fs)))))
