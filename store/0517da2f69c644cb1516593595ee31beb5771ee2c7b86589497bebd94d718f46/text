qgm-if-neg-add : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → QgmAb A z add neg →
  (b : Bool) → (f g : A) → (if b then neg (add f g) else z) ≡ add (if b then neg f else z) (if b then neg g else z)
qgm-if-neg-add A z add neg ab b f g = case b return λ u → (if u then neg (add f g) else z) ≡ add (if u then neg f else z) (if u then neg g else z) of
  true → qgm-neghom A z add neg ab f g
  false → sym (qgm-zl A z add neg ab z)
