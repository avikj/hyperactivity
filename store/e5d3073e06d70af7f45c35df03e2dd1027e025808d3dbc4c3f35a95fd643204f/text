-- the argument cell j of a call whose frames end at sp
b2-argat : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-argat mm_ sp j kq_ =
  scmd (w-load ((b2-sa mm_ (%wsub sp (%wsucc j))))) (λ fr → let mm_2908 = b2-dep mm_ fr in let i_2910 = (%wadd fr #1) in scmd (w-load ((b2-a mm_2908 i_2910))) (λ x_2909 → let mm_2911 = b2-dep mm_2908 x_2909 in let x = x_2909 in kq_ (h4-depl mm_2911 (x))))
