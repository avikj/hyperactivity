grv-s3j-216 : Nat → Nat → Nat → Nat → Nat → Nat → Nat × Nat
grv-s3j-216 dj1 m1 dj2 m2 di im3 =
  if not (eqb (plus m1 (plus m2 im3)) (nat-half (plus dj1 (plus dj2 di)))) then (0 , 0)
  else
    ((λ a1 a2 a3 c1 →
       (λ kmin kmax →
         if not (leb kmin kmax) then (0 , 0)
         else
           ((λ raw →
              if odd (plus (nat-half (monus (plus dj1 di) dj2)) im3)
              then (snd raw , fst raw) else raw)
            (grv-s3j-loop (suc (monus kmax kmin)) a1 a2 a3 m1 c1 m2 kmin (0 , 0))))
       (nat-max (monus a1 m1) (monus m2 c1))
       (nat-min a1 (nat-min a2 a3)))
     (nat-half (monus (plus dj1 dj2) di))
     (monus dj1 m1)
     m2
     (nat-half (monus (plus di dj2) dj1)))
