  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7036 = tel in let j_7037 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7036 (%wsucc j_7037))))) (λ x_7035 → let mm_7038 = b2-dep mm_ x_7035 in let c = x_7035 in let i_7040 = c in scmd (w-load ((b2-a mm_7038 i_7040))) (λ x_7039 → let mm_7041 = b2-dep mm_7038 x_7039 in let q = x_7039 in let i_7043 = (%wadd c #1) in scmd (w-load ((b2-a mm_7041 i_7043))) (λ x_7042 → let mm_7044 = b2-dep mm_7041 x_7042 in let k = x_7042 in let i_7046 = (%wadd c #2) in scmd (w-load ((b2-a mm_7044 i_7046))) (λ x_7045 → let mm_7047 = b2-dep mm_7044 x_7045 in let i = x_7045 in let i_7049 = (%wadd c #3) in scmd (w-load ((b2-a mm_7047 i_7049))) (λ x_7048 → let mm_7050 = b2-dep mm_7047 x_7048 in let vT = x_7048 in let i_7052 = (%wadd c #4) in scmd (w-load ((b2-a mm_7050 i_7052))) (λ x_7051 → let mm_7053 = b2-dep mm_7050 x_7051 in let s = x_7051 in b2-All mm_7053 q k i vT e s (λ a → let mm_7054 = b2-dep mm_7053 a in b2-telebindg mm_7054 f tel (%wsub j #1) a kq_))))))))
