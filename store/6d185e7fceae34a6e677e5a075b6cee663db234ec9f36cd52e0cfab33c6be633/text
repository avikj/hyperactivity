-- Helper: for any S and m, plus (suc (plus m m)) (suc S) = plus S (plus (suc m) (suc m)).
qt-cg-step : (S m : Nat) → plus (suc (plus m m)) (suc S) ≡ plus S (plus (suc m) (suc m))
qt-cg-step S m =
  concat (plus-comm (suc (plus m m)) (suc S))
    (concat (sym (plus-suc S (suc (plus m m))))
            (cong (λ t → plus S t) (cong suc (sym (plus-suc m m)))))
