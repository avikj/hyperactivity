-- ── 1. Zero-Block Provably Passive Broadband Active Noise Cancellation (ANC) ─
-- Universal SOS passivity over Q:
--   2 * (KE_drop + PE_drop) = dt * (gamma + beta) * sv^2 >= 0
-- Proves ZERO howling, ZERO feedback blowup, ZERO NaN instability in a human ear.
-- Variables (0..5): dt, k, gamma, beta, sv, sq.
anc-passivity-sos-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
anc-passivity-sos-poly A ad mu q vs =
  (λ g sub sq →
    let dt = g 0; k = g 1; gam = g 2; bet = g 3; sv = g 4; sqv = g 5
        dTot   = ad gam bet
        keDrop = mu (mu dt (ad (mu k sqv) (mu dTot sv))) sv
        peDrop = mu k (mu (sub (q (fn-q 0 1)) (mu dt sv)) sqv)
        lhs    = ad keDrop peDrop
        rhs    = mu (mu dt dTot) (sq sv)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
