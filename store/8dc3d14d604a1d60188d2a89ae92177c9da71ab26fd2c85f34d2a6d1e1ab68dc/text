-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10372 = tld in scmd (w-load ((b2-a mm_ t_10372))) (λ x_10371 → let mm_10373 = b2-dep mm_ x_10371 in let tg = (%wand x_10371 #255) in if (%weq tg b2-TADT) then (let t_10375 = tld in let j_10376 = #4 in scmd (w-load ((b2-a mm_10373 (%wadd t_10375 (%wadd #2 j_10376))))) (λ x_10374 → let mm_10377 = b2-dep mm_10373 x_10374 in let b = x_10374 in kq_ (h4-depl mm_10377 (b)))) else (let t_10379 = tld in let j_10380 = #5 in scmd (w-load ((b2-a mm_10373 (%wadd t_10379 (%wadd #2 j_10380))))) (λ x_10378 → let mm_10381 = b2-dep mm_10373 x_10378 in let b = x_10378 in kq_ (h4-depl mm_10381 (b))))))
