-- (D) Exact SL(2,C) Plancherel weights for spin-1/2 (J=1) and spin-1 (J=2) at gamma = 0, 1, 1/3:
lor-plancherel-verdict : both
  (both (sf-bq-eq (lor-plancherel bq-zero 2) sf-bq-one)
        (sf-bq-eq (lor-plancherel sf-bq-one 1) (lor-q 1 2)))
  (sf-bq-eq (lor-plancherel (lor-q 1 3) 3) (lor-q 5 2)) ≡ true
lor-plancherel-verdict = refl
