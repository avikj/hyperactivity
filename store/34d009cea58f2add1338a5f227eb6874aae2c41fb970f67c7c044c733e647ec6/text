  if (%weq j e) then (let a_14255 = cnt in let b_14256 = ls in let c_14257 = #0 in let n_14259 = #3 in scmd (w-load (mm_)) (λ at_14258 → let mm_14260 = b2-dep mm_ at_14258 in scmd (w-store (mm_14260) ((%wadd at_14258 n_14259))) (λ uu_14261 → let mm_14262 = hv2-u mm_14260 uu_14261 in let at_14254 = at_14258 in let i_14263 = at_14254 in let v_14264 = a_14255 in scmd (w-store ((b2-a mm_14262 i_14263)) (v_14264)) (λ uu_14265 → let mm_14266 = hv2-u mm_14262 uu_14265 in let i_14267 = (%wadd at_14254 #1) in let v_14268 = b_14256 in scmd (w-store ((b2-a mm_14266 i_14267)) (v_14268)) (λ uu_14269 → let mm_14270 = hv2-u mm_14266 uu_14269 in let i_14271 = (%wadd at_14254 #2) in let v_14272 = c_14257 in scmd (w-store ((b2-a mm_14270 i_14271)) (v_14272)) (λ uu_14273 → let mm_14274 = hv2-u mm_14270 uu_14273 in let r = at_14254 in kq_ (h4-depl mm_14274 (r)))))))) else (let a_14276 = s in let j_14277 = j in scmd (w-load ((b2-a mm_ (%wadd a_14276 (%wsucc j_14277))))) (λ x_14275 → let mm_14278 = b2-dep mm_ x_14275 in let c = x_14275 in if (%weq c #10) then (b2-nlcount mm_14278 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_14278 f s (%wsucc j) e cnt ls kq_)))
