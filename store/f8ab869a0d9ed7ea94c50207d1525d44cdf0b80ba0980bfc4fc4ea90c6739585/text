    const levelY = 104, unitX = 96;
    function placePlanar(id, depth, xMin, xMax) {
      const c = net.cells.get(id);
      c.tx = (xMin + xMax) / 2;
      c.ty = -210 + depth * levelY;
      const kids = children.get(id) || [];
      const totalW = weight.get(id) || 1;
      let cur = xMin;
      for (const k of kids) {
        const w = weight.get(k) || 1;
        const span = (xMax - xMin) * (w / totalW);
        placePlanar(k, depth + 1, cur, cur + span);
        cur += span;
      }
    }
    const totalSpan = Math.max(240, (weight.get(root.id) || 1) * unitX);
    placePlanar(root.id, 0, -totalSpan / 2, totalSpan / 2);

    // 2. POINCARÉ DISK (ℍ²) HYPERBOLIC LAYOUT — ZERO CROSSINGS FOR EXPONENTIAL TREES!
    // Root sits at origin (0,0); depth d maps to hyperbolic radius r_h = d * 0.85 -> r_poincare = tanh(r_h / 2)
    function placeHyperbolic(id, depth, aMin, aMax) {
      const c = net.cells.get(id);
      if (depth === 0) {
        c.thx = 0; c.thy = 0;
      } else {
        const ang = (aMin + aMax) / 2;
        const r = Math.tanh(depth * 0.56);
        c.thx = r * Math.cos(ang);
        c.thy = r * Math.sin(ang);
