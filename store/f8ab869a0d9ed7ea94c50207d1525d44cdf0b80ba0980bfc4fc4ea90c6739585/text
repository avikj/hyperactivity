<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Interaction Net Lab · Hyperactivity</title>
<meta name="description" content="Live cubical interaction net compiler, Poincaré disk hyperbolic geometry, Wolfram causal graph, and Pythagorean Music of the Spheres.">
<style>
:root {
  --bg: #000000;
  --panel: #070707;
  --ink: #ffffff;
  --muted: #8a8a8a;
  --border: #262626;
  --border-hi: #ffffff;
  --pink: #ff0a94;
  --cyan: #00e5ff;
  --gold: #ffd400;
  --green: #00f900;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
html.light {
  --bg: #ffffff;
  --panel: #fafafa;
  --ink: #000000;
  --muted: #666666;
  --border: #d4d4d4;
  --border-hi: #000000;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }

nav {
  height: 46px; display: flex; justify-content: space-between; align-items: center;
  padding: 0 22px; background: var(--bg); border-bottom: 2px solid var(--border-hi);
  font: 600 13px/1 var(--mono); letter-spacing: .04em; z-index: 10; position: relative;
}
nav a { color: var(--ink); text-decoration: none; }
nav a:hover, nav a.active { color: var(--pink); }
nav .mark { font-weight: 700; }
nav .links { display: flex; align-items: center; gap: 20px; }
nav .badge {
  border: 1.5px solid var(--pink); color: var(--pink); padding: 2px 7px;
  font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
}

.workspace {
  display: grid;
  grid-template-columns: 288px 1fr;
  grid-template-rows: 1fr 64px;
  height: calc(100vh - 46px);
}

.sidebar {
  grid-row: 1 / 3;
  background: var(--panel);
  border-right: 2px solid var(--border-hi);
  display: flex; flex-direction: column;
  overflow: hidden;
}
.sec-head {
  padding: 9px 14px;
  font: 700 10.5px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase;
  color: var(--pink); border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
}
.presets {
  overflow-y: auto; border-bottom: 2px solid var(--border-hi);
  flex: 0 0 auto; max-height: 47%;
}
.preset-btn {
  display: block; width: 100%; text-align: left;
  background: transparent; color: var(--ink); border: 0;
  border-bottom: 1px solid var(--border);
  padding: 8px 14px; cursor: pointer;
  transition: background .1s, padding-left .1s;
}
.preset-btn:hover { background: rgba(255,10,148,.09); padding-left: 18px; }
.preset-btn.active { background: var(--pink); color: #fff; }
.preset-btn .pt { font: 700 12px/1.2 var(--mono); display: flex; justify-content: space-between; align-items: center; }
.preset-btn .pt .tag { font-size: 9px; padding: 1px 5px; border: 1px solid currentColor; opacity: .85; }
.preset-btn .pe {
  font: 400 10.5px/1.3 var(--mono); opacity: .76; margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.preset-btn.active .pe { opacity: .95; }

.legend {
  padding: 8px 14px; border-bottom: 1px solid var(--border);
  font: 500 10.5px/1.45 var(--mono); color: var(--muted);
  display: grid; grid-template-columns: 1fr 1fr; gap: 5px 8px;
}
.leg-item { display: flex; align-items: center; gap: 6px; color: var(--ink); }
.leg-swatch { width: 12px; height: 10px; display: inline-block; flex-shrink: 0; }
.sw-val { border: 2px solid var(--pink); border-radius: 99px; }
.sw-op { border: 2px solid var(--cyan); }
.sw-act { background: var(--pink); height: 3px; box-shadow: 0 0 8px var(--pink); }
.sw-cub { border: 2px solid var(--gold); transform: rotate(45deg); width: 9px; height: 9px; margin: 0 2px; }

.causal-wrap { border-bottom: 1px solid var(--border); background: var(--bg); }
#causalCanvas { display: block; width: 100%; height: 90px; }

.trace-wrap { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.trace { flex: 1; overflow-y: auto; padding: 6px 14px; font: 500 10.5px/1.5 var(--mono); }
.trace-row {
  padding: 4px 0; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; gap: 8px;
}
.trace-row .rule { color: var(--ink); }
.trace-row .ratio { color: var(--pink); font-weight: 700; white-space: nowrap; }

.stage { position: relative; overflow: hidden; background: var(--bg); cursor: grab; }
.stage:active { cursor: grabbing; }
#netCanvas { display: block; width: 100%; height: 100%; }

.stage-hud {
  position: absolute; top: 12px; left: 14px; right: 14px;
  pointer-events: none;
  display: flex; justify-content: space-between; align-items: flex-start; gap: 14px;
}
.compiler-card {
  pointer-events: auto;
  background: var(--bg); border: 2px solid var(--border-hi);
  padding: 9px 12px; width: min(580px, 55vw);
}
.compiler-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.compiler-card .kicker {
  font: 700 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--pink);
}
.compiler-row { display: flex; gap: 8px; align-items: stretch; }
.expr-input {
  flex: 1; background: var(--panel); color: var(--ink);
  border: 1.5px solid var(--border); padding: 7px 10px;
  font: 700 13px/1.25 var(--mono); outline: none;
}
.expr-input:focus { border-color: var(--pink); }
.compile-btn {
  font: 700 11px/1 var(--mono); text-transform: uppercase; letter-spacing: .06em;
  background: var(--pink); color: #fff; border: 0; padding: 0 12px; cursor: pointer;
}
.compile-btn:hover { background: var(--ink); color: var(--bg); }
.compiler-card .desc { font: 400 11.5px/1.4 var(--sans); color: var(--muted); margin-top: 6px; }
.compiler-err { font: 600 11px/1.3 var(--mono); color: #ff4545; margin-top: 4px; display: none; }

.metrics-card {
  pointer-events: auto;
  background: var(--bg); border: 2px solid var(--border-hi);
  padding: 8px 12px; display: flex; gap: 14px; align-items: center;
  font: 600 11px/1.2 var(--mono);
}
.metric { display: flex; flex-direction: column; gap: 2px; }
.metric .ml { font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.metric .mv { font-size: 15px; font-weight: 800; color: var(--ink); }
.metric .mv.pink { color: var(--pink); }
.metric .mv.ok { color: var(--green); }

.hover-tip {
  position: absolute; bottom: 14px; left: 14px;
  pointer-events: none;
  background: var(--bg); border: 2px solid var(--pink);
  padding: 8px 12px; font: 600 11.5px/1.4 var(--mono);
  display: none; max-width: 480px;
}
.hover-tip .ht-sub { color: var(--muted); font-weight: 400; font-size: 10.5px; margin-top: 2px; }

.right-dock {
  position: absolute; bottom: 14px; right: 14px;
  display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
  pointer-events: none;
}
.dock-card {
  pointer-events: auto;
  background: var(--bg); border: 2px solid var(--border-hi);
  padding: 8px 10px; width: 206px;
}
.dock-head {
  font: 700 9.5px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase;
  color: var(--pink); margin-bottom: 6px; display: flex; justify-content: space-between;
}
.dock-head.gold { color: var(--gold); }
#sphereCanvas { display: block; width: 182px; height: 146px; }
#kanCanvas { display: block; width: 182px; height: 126px; }
.kan-box { display: none; }
.kan-box.show { display: block; }

.controls {
  grid-column: 2;
  background: var(--panel);
  border-top: 2px solid var(--border-hi);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 14px; gap: 8px; overflow-x: auto;
}
.ctrl-group { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.btn {
  font: 700 11px/1 var(--mono); letter-spacing: .04em; text-transform: uppercase;
  background: var(--bg); color: var(--ink);
  border: 2px solid var(--border-hi); padding: 8px 10px; cursor: pointer;
  white-space: nowrap;
}
.btn:hover { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.primary { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.primary:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.btn.on { background: var(--ink); color: var(--bg); }
.btn.hyp { border-color: var(--gold); color: var(--gold); }
.btn.hyp.on { background: var(--gold); color: #000; border-color: var(--gold); }

.speed-wrap {
  display: flex; align-items: center; gap: 5px;
  font: 600 10px var(--mono); color: var(--muted);
}
.speed-wrap input[type=range] { width: 62px; accent-color: var(--pink); cursor: pointer; }

.scope-wrap {
  display: flex; align-items: center; gap: 8px;
  border: 1.5px solid var(--border); padding: 4px 8px; background: var(--bg);
}
#scopeCanvas { width: 88px; height: 24px; display: block; }
.ratio-readout { font: 700 10.5px/1.2 var(--mono); color: var(--pink); min-width: 108px; }
.ratio-readout span { display: block; font-size: 9px; color: var(--muted); font-weight: 500; }

select.tuning {
  font: 600 10.5px var(--mono); background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--border); padding: 6px 6px; cursor: pointer;
}

@media (max-width: 880px) {
  .workspace { grid-template-columns: 1fr; grid-template-rows: auto 1fr 64px; }
  .sidebar { grid-row: 1; max-height: 170px; border-right: 0; border-bottom: 2px solid var(--border-hi); }
  .legend, .causal-wrap, .trace-wrap, .right-dock, .metrics-card { display: none; }
  .controls { grid-column: 1; }
  .compiler-card { width: calc(100vw - 28px); }
  nav .mark span { display: none; }
}
</style>
</head>
<body>
<nav>
  <a class="mark" href="/">Avik Jain<span> · Hyperactive Labs</span></a>
  <div class="links">
    <a href="/paper">Paper</a>
