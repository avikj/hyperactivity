  document.getElementById('mActive').textContent = active.length;
  document.getElementById('causalInfo').textContent = `${net.events.length} event${net.events.length === 1 ? '' : 's'}`;
  const st = document.getElementById('mState');
  if (active.length === 0) { st.textContent = 'NORMAL ≡'; st.className = 'mv ok'; }
  else { st.textContent = playing ? 'RUNNING' : 'ACTIVE'; st.className = 'mv pink'; }
  document.getElementById('traceCount').textContent = `${net.work} step${net.work === 1 ? '' : 's'}`;
  document.getElementById('traceLog').innerHTML = net.trace.map(t =>
    `<div class="trace-row"><span class="rule">#${t.step} ${t.rule}</span><span class="ratio">${t.ratio.split('·')[0]}</span></div>`
  ).join('');
}

// Spacious rounded-chamfer / pill-hexagon cell drawing (ZERO cramped triangles!)
function drawSpaciousCell(ctx, c, sx, sy, sc, isLight, ink, accent, isHover) {
  const birth = Math.min(1, 0.35 + c.age * 1.9);
  const s = sc * birth;
  const isCubical = ['V_PLAM','V_IV','V_SYS','V_GLUE','V_GLUEV','O_PAPPP','O_SUBST','O_COMP','O_UNGLUE'].includes(c.kind);
  const w = Math.max(66, c.label.length * 9 + 26);
  const h = c.sub ? 42 : 34;

  ctx.save();
  ctx.translate(sx, sy);
  ctx.scale(s, s);

  if (c.polarity === 'root') {
    ctx.fillStyle = isLight ? '#000' : '#fff';
    ctx.fillRect(-36, -15, 72, 30);
    ctx.fillStyle = isLight ? '#fff' : '#000';
    ctx.font = '800 11.5px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('OUT', 0, 1);
    ctx.restore(); return;
  }

  ctx.beginPath();
  if (c.polarity === 'val') {
    // Positive Value (V_*): Spacious stadium / chamfered dome-pill (never cramps text!)
    const ch = isCubical ? 11 : 16;
    ctx.moveTo(-w/2 + ch, -h/2);
    ctx.lineTo(w/2 - ch, -h/2);
    ctx.lineTo(w/2, -h/2 + ch);
    ctx.lineTo(w/2, h/2 - ch);
    ctx.lineTo(w/2 - ch, h/2);
    ctx.lineTo(-w/2 + ch, h/2);
    ctx.lineTo(-w/2, h/2 - ch);
    ctx.lineTo(-w/2, -h/2 + ch);
    ctx.closePath();
    ctx.fillStyle = isLight ? '#fff2f9' : '#13050e';
  } else {
    // Negative Operation (O_*): Crisp architectural square-chamfered frame
    const ch = 6;
    ctx.moveTo(-w/2 + ch, -h/2);
    ctx.lineTo(w/2 - ch, -h/2);
    ctx.lineTo(w/2, -h/2 + ch);
    ctx.lineTo(w/2, h/2 - ch);
    ctx.lineTo(w/2 - ch, h/2);
    ctx.lineTo(-w/2 + ch, h/2);
    ctx.lineTo(-w/2, h/2 - ch);
    ctx.lineTo(-w/2, -h/2 + ch);
    ctx.closePath();
    ctx.fillStyle = isLight ? '#f3f7fa' : '#060c10';
  }
  ctx.fill();
  ctx.lineWidth = isHover ? 3.2 : 2;
  ctx.strokeStyle = accent;
  ctx.stroke();

  // Principal port indicator dot on edge facing principal partner
  const ep0 = c.ports[0];
  if (ep0 && net.cells.has(ep0.cell)) {
    const o = net.cells.get(ep0.cell);
    const pSelf = cellScreenPos(c), pOther = cellScreenPos(o);
    const ang = Math.atan2(pOther.y - pSelf.y, pOther.x - pSelf.x);
    const bx = Math.cos(ang) * (w/2), by = Math.sin(ang) * (h/2);
    ctx.fillStyle = c.polarity === 'val' ? accent : (isLight ? '#fff' : '#000');
    ctx.strokeStyle = accent; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(bx, by, 4.2, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  }

  // Crisp, upright, generously spaced typography
  ctx.fillStyle = ink;
  ctx.font = '800 13px ui-monospace, Menlo, monospace';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText(c.label, 0, c.sub ? -6 : 0);
  if (c.sub) {
    ctx.fillStyle = accent;
    ctx.font = '600 9.5px ui-monospace, Menlo, monospace';
    ctx.fillText(c.sub, 0, 10);
  }
  ctx.restore();
}

function draw() {
  animTime += 0.03;
  net.computeLayouts();

  // Smooth spring interpolation toward crossing-free targets
  for (const c of net.cells.values()) {
    c.age += 0.04;
    if (c !== dragCell) {
      c.x += (c.tx - c.x) * 0.14;
      c.y += (c.ty - c.y) * 0.14;
      c.hx += (c.thx - c.hx) * 0.14;
      c.hy += (c.thy - c.hy) * 0.14;
    }
  }

  const r = canvas.getBoundingClientRect(), W = r.width, H = r.height;
  const isLight = document.documentElement.classList.contains('light');
  const ink = isLight ? '#000' : '#fff';
  ctx.clearRect(0, 0, W, H);

  if (hypMode) {
    // Draw Poincaré Disk ℍ² boundary & Escher hyperbolic tessellation geodesics!
    const { cx, cy, R } = getDiskParams();
    ctx.save();
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.fillStyle = isLight ? 'rgba(255,10,148,0.025)' : 'rgba(255,10,148,0.035)';
    ctx.fill();
    ctx.clip();

    // Concentric hyperbolic horocycles (constant hyperbolic radius rings)
    ctx.strokeStyle = isLight ? 'rgba(0,0,0,0.07)' : 'rgba(255,255,255,0.07)';
    ctx.lineWidth = 1;
    [0.56, 1.12, 1.68, 2.24, 2.8].forEach(rh => {
      const rp = Math.tanh(rh / 2) * R;
      ctx.beginPath(); ctx.arc(cx, cy, rp, 0, Math.PI * 2); ctx.stroke();
    });
    // Escher Circle Limit background geodesic arcs
    for (let k = 0; k < 12; k++) {
      const a1 = (k / 12) * Math.PI * 2, a2 = ((k + 4) / 12) * Math.PI * 2;
      const p1 = mobius(Math.cos(a1)*0.99, Math.sin(a1)*0.99, hypPan.x, hypPan.y);
      const p2 = mobius(Math.cos(a2)*0.99, Math.sin(a2)*0.99, hypPan.x, hypPan.y);
      strokeHyperbolicGeodesic(ctx, cx, cy, R, p1.x, p1.y, p2.x, p2.y, false, animTime);
    }
    ctx.restore();

    // Crisp Poincaré Disk boundary |z| = 1
    ctx.strokeStyle = isLight ? '#000' : '#fff';
    ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
    ctx.fillStyle = '#ffd400';
    ctx.font = '700 10.5px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('∂ℍ² · POINCARÉ BOUNDARY AT INFINITY (DRAG FOR MÖBIUS TRANSFORM)', cx, cy + R + 18);
  } else {
    // Crisp architectural Euclidean grid
    const gs = 40 * cam.zoom;
    ctx.strokeStyle = isLight ? 'rgba(0,0,0,0.045)' : 'rgba(255,255,255,0.045)';
    ctx.lineWidth = 1;
    const ox = ((W/2 + cam.x*cam.zoom) % gs + gs) % gs, oy = ((H/2 + cam.y*cam.zoom) % gs + gs) % gs;
    ctx.beginPath();
    for (let x = ox; x < W; x += gs) { ctx.moveTo(x, 0); ctx.lineTo(x, H); }
    for (let y = oy; y < H; y += gs) { ctx.moveTo(0, y); ctx.lineTo(W, y); }
    ctx.stroke();
  }

  // Draw wires (exact Poincaré geodesics in ℍ² mode, smooth cubic Béziers in Planar mode!)
  const activeSet = new Set(net.activePairs().map(p => `${Math.min(p.op.id, p.val.id)}-${Math.max(p.op.id, p.val.id)}`));
  const disk = hypMode ? getDiskParams() : null;

  for (const c of net.cells.values()) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p]; if (!ep) continue;
      if (ep.cell === c.id && p < ep.port) {
        const sp = cellScreenPos(c);
        ctx.strokeStyle = isLight ? '#888' : '#666'; ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(sp.x, sp.y + 24 * sp.scale, 18 * sp.scale, 0, Math.PI);
        ctx.stroke(); continue;
      }
      if (ep.cell <= c.id) continue;
      const o = net.cells.get(ep.cell); if (!o) continue;
      const sp1 = cellScreenPos(c), sp2 = cellScreenPos(o);
      const key = `${Math.min(c.id, o.id)}-${Math.max(c.id, o.id)}`;
      const isActive = (p === 0 && ep.port === 0 && activeSet.has(key));
      const isHover = hoveredPair && ((hoveredPair.op.id === c.id && hoveredPair.val.id === o.id) || (hoveredPair.op.id === o.id && hoveredPair.val.id === c.id));

      ctx.save();
      if (isActive) {
        ctx.strokeStyle = '#ff0a94'; ctx.lineWidth = isHover ? 5 : 3.2;
        ctx.shadowColor = '#ff0a94'; ctx.shadowBlur = isHover ? 18 : 10;
      } else {
        ctx.strokeStyle = isLight ? '#222' : '#777'; ctx.lineWidth = 1.9;
      }

      if (hypMode) {
        strokeHyperbolicGeodesic(ctx, disk.cx, disk.cy, disk.R, sp1.z.x, sp1.z.y, sp2.z.x, sp2.z.y, isActive, animTime);
      } else if (isActive) {
        ctx.beginPath();
        const steps = 20, dx = sp2.x - sp1.x, dy = sp2.y - sp1.y, len = Math.hypot(dx, dy) || 1;
        const nx = -dy/len, ny = dx/len;
        for (let s = 0; s <= steps; s++) {
          const t = s/steps, w = Math.sin(t*Math.PI*3 + animTime*5) * 4.5 * Math.sin(t*Math.PI);
          const px = sp1.x + dx*t + nx*w, py = sp1.y + dy*t + ny*w;
          if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();
      } else {
        // Smooth vertical-tangent cubic Bézier (clean, zero clutter!)
        const midY = (sp1.y + sp2.y) / 2;
        ctx.beginPath();
        ctx.moveTo(sp1.x, sp1.y);
        ctx.bezierCurveTo(sp1.x, midY, sp2.x, midY, sp2.x, sp2.y);
        ctx.stroke();
      }
      ctx.restore();
    }
  }

  // Shockwaves
  for (let i = net.sparks.length - 1; i >= 0; i--) {
    const sp = net.sparks[i]; sp.r += 4.2; sp.alpha -= 0.045;
    if (sp.alpha <= 0) { net.sparks.splice(i, 1); continue; }
    let sx, sy;
    if (hypMode) {
      const m = mobius(sp.hx, sp.hy, hypPan.x, hypPan.y);
      sx = disk.cx + m.x * disk.R; sy = disk.cy + m.y * disk.R;
    } else {
      sx = W/2 + (sp.x + cam.x) * cam.zoom; sy = H/2 + (sp.y + cam.y) * cam.zoom;
    }
    ctx.save(); ctx.strokeStyle = sp.color; ctx.globalAlpha = sp.alpha; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.arc(sx, sy, sp.r, 0, Math.PI*2); ctx.stroke(); ctx.restore();
  }

  // Cells
  for (const c of net.cells.values()) {
    const sp = cellScreenPos(c);
    const isCubical = ['V_PLAM','V_IV','V_SYS','V_GLUE','V_GLUEV','O_PAPPP','O_SUBST','O_COMP','O_UNGLUE'].includes(c.kind);
    const accent = synMode ? synColorFor(c.label) : (isCubical ? '#ffd400' : (c.polarity === 'val' ? '#ff0a94' : '#00e5ff'));
    drawSpaciousCell(ctx, c, sp.x, sp.y, sp.scale, isLight, ink, accent, hoveredCell === c);
  }

  drawSphere();
  drawCausalDag();
  drawKanBox();
  drawScope();
  requestAnimationFrame(draw);
}

