PRESETS.forEach(p => {
  const btn = document.createElement('button');
  btn.className = 'preset-btn'; btn.dataset.id = p.id;
  btn.innerHTML = `<div class="pt"><span>${p.title}</span>${p.tag ? `<span class="tag">${p.tag}</span>` : ''}</div><div class="pe">${p.expr}</div>`;
  btn.onclick = () => loadPreset(p);
  presetList.appendChild(btn);
});

document.getElementById('btnCompile').onclick = () => compileExpression(document.getElementById('exprInput').value);
document.getElementById('exprInput').addEventListener('keydown', e => { if (e.key === 'Enter') compileExpression(e.target.value); });

function stopPlay() {
  playing = false; if (playTimer) clearInterval(playTimer); playTimer = null;
  document.getElementById('btnPlay').textContent = '▶ Play'; updateHUD();
}
function startPlayLoop() {
  const ms = 1320 - parseInt(document.getElementById('speedSlider').value, 10);
  if (playTimer) clearInterval(playTimer);
  playTimer = setInterval(() => {
    const fired = net.stepParallel(); updateHUD();
    if (!fired || net.activePairs().length === 0) stopPlay();
  }, Math.max(110, ms));
}
document.getElementById('btnPlay').onclick = () => {
  if (playing) { stopPlay(); return; }
  if (net.activePairs().length === 0) compileExpression(document.getElementById('exprInput').value, currentPreset);
  playing = true; document.getElementById('btnPlay').textContent = '❚❚ Pause'; updateHUD();
  const fired = net.stepParallel(); updateHUD();
  if (!fired || net.activePairs().length === 0) { stopPlay(); return; }
  startPlayLoop();
};
document.getElementById('speedSlider').oninput = () => { if (playing) startPlayLoop(); };
document.getElementById('btnStep').onclick = () => { stopPlay(); net.stepParallel(); updateHUD(); };
document.getElementById('btnReset').onclick = () => compileExpression(document.getElementById('exprInput').value, currentPreset);
document.getElementById('btnHyp').onclick = () => setHypMode(!hypMode);
document.getElementById('btnFit').onclick = () => { cam = { x: 0, y: 40, zoom: 1 }; hypPan = { x: 0, y: 0 }; };

document.getElementById('btnSound').onclick = function() {
  audio.enabled = !audio.enabled; this.textContent = audio.enabled ? '♫ Sound' : '♫ Muted'; this.classList.toggle('on', audio.enabled);
};
document.getElementById('btnDrone').onclick = function() { this.classList.toggle('on', audio.toggleDrone()); };
document.getElementById('tuningSel').onchange = function() { audio.setBase(parseFloat(this.value)); };
document.getElementById('btnSyn').onclick = function() { synMode = !synMode; this.classList.toggle('on', synMode); };
document.getElementById('btnTheme').onclick = () => document.documentElement.classList.toggle('light');
document.addEventListener('keydown', e => {
  if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
  if (e.key === 's' || e.key === 'S') { synMode = !synMode; document.getElementById('btnSyn').classList.toggle('on', synMode); }
  else if (e.key === 'h' || e.key === 'H') setHypMode(!hypMode);
  else if (e.key === ' ') { e.preventDefault(); document.getElementById('btnStep').click(); }
});

const qPreset = new URLSearchParams(location.search).get('preset');
loadPreset(PRESETS.find(p => p.id === qPreset) || PRESETS[0]);
requestAnimationFrame(draw);
</script>
</body>
</html>
