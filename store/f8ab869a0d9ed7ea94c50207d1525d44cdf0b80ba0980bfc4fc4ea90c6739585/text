function getDiskParams() {
  const r = canvas.getBoundingClientRect();
  const cx = r.width * 0.48, cy = r.height * 0.54;
  const R = Math.min(r.width * 0.40, r.height * 0.42) * cam.zoom;
  return { cx, cy, R };
}

function cellScreenPos(c) {
  const r = canvas.getBoundingClientRect();
  if (hypMode) {
    const { cx, cy, R } = getDiskParams();
    const m = mobius(c.hx, c.hy, hypPan.x, hypPan.y);
    const r2 = m.x * m.x + m.y * m.y;
    const conformal = Math.max(0.42, (1 - r2 * 0.72));
    return { x: cx + m.x * R, y: cy + m.y * R, z: m, scale: conformal * Math.min(1.15, cam.zoom) };
  }
  return {
    x: r.width / 2 + (c.x + cam.x) * cam.zoom,
    y: r.height / 2 + (c.y + cam.y) * cam.zoom,
    scale: cam.zoom
  };
}

function compileExpression(src, metaPreset = null) {
  stopPlay();
  const errEl = document.getElementById('compileErr'); errEl.style.display = 'none';
  nextId = 1;
  const fresh = new Net();
  try {
    if (metaPreset && metaPreset.customBuild && src.trim() === metaPreset.expr.trim()) metaPreset.customBuild(fresh);
    else compileAstToNet(parseExpr(src), fresh);
    net = fresh;
    net.computeLayouts();
    // Snap initial positions cleanly to crossing-free layout
    for (const c of net.cells.values()) { c.x = c.tx; c.y = c.ty; c.hx = c.thx; c.hy = c.thy; }
    cam = { x: 0, y: 40, zoom: 1 };
    hypPan = { x: 0, y: 0 };
    document.getElementById('kanBox').classList.toggle('show', !!net.kanMode);
    if (!metaPreset) {
      document.getElementById('presetKicker').textContent = 'COMPILED LIVE EXPRESSION';
      document.getElementById('presetDesc').textContent = 'Compiled directly from your expression with automatic O_DUP sharing and O_ERA erasure.';
      document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    }
    updateHUD();
  } catch (err) {
    errEl.textContent = 'Parse error: ' + err.message; errEl.style.display = 'block';
  }
}

