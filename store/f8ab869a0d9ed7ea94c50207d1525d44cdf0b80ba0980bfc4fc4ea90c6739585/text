<script>
// ============================================================================
// 1. AVIK'S EXACT SYNESTHESIA TABLE (docs/synesthesia.cub)
// ============================================================================
const SYN_COLORS = {
  a:'#ff2600', b:'#fffb00', c:'#00f900', d:'#945200', e:'#00f900', f:'#008f00',
  g:'#008f00', h:'#ffb6dc', i:'#0433ff', j:'#0433ff', k:'#942193', l:'#ffffff',
  m:'#ff2600', n:'#fffb00', o:'#87cefa', p:'#ffb6dc', q:'#d880c8', r:'#945200',
  s:'#fffb00', t:'#00f900', u:'#ffb6dc', v:'#fffb00', w:'#942193', x:'#942193',
  y:'#fffb00', z:'#ffffff',
  '0':'#ffffff', '1':'#ffffff', '2':'#87cefa', '3':'#ff9300', '4':'#fffb00',
  '5':'#0433ff', '6':'#ff2600', '7':'#00f900', '8':'#fffb00', '9':'#942193'
};
function synColorFor(label) {
  const ch = (label || 'h').toLowerCase().replace(/[^a-z0-9]/g, '')[0] || 'h';
  return SYN_COLORS[ch] || '#ff0a94';
}

// ============================================================================
// 2. PYTHAGOREAN "MUSIC OF THE SPHERES" HARMONIC ENGINE
// ============================================================================
const SPHERE_NODES = [
  { key:'normal', label:'1:1',     num:1,   den:1,   ang: -Math.PI/2 },
  { key:'subst',  label:'9:8',     num:9,   den:8,   ang: -Math.PI/2 + Math.PI*2*(1/8) },
  { key:'papp',   label:'81:64',   num:81,  den:64,  ang: -Math.PI/2 + Math.PI*2*(2/8) },
  { key:'proj',   label:'4:3',     num:4,   den:3,   ang: -Math.PI/2 + Math.PI*2*(3/8) },
  { key:'beta',   label:'3:2',     num:3,   den:2,   ang: -Math.PI/2 + Math.PI*2*(4/8) },
  { key:'comp',   label:'27:16',   num:27,  den:16,  ang: -Math.PI/2 + Math.PI*2*(5/8) },
  { key:'unglue', label:'243:128', num:243, den:128, ang: -Math.PI/2 + Math.PI*2*(6/8) },
  { key:'dup',    label:'2:1',     num:2,   den:1,   ang: -Math.PI/2 + Math.PI*2*(7/8) }
];
const PYTH = {
  beta:   { num: 3,   den: 2,   name: '3:2 · diapente',    wave: 'triangle' },
  proj:   { num: 4,   den: 3,   name: '4:3 · diatessaron', wave: 'sine' },
  dup:    { num: 2,   den: 1,   name: '2:1 · diapason',    wave: 'triangle' },
  era:    { num: 1,   den: 2,   name: '1:2 · sub-octave',  wave: 'sine' },
  papp:   { num: 81,  den: 64,  name: '81:64 · ditone',    wave: 'sine' },
  subst:  { num: 9,   den: 8,   name: '9:8 · epogdoon',    wave: 'sine' },
  comp:   { num: 27,  den: 16,  name: '27:16 · Kan fill',  wave: 'triangle' },
  unglue: { num: 243, den: 128, name: '243:128 · ua',      wave: 'sine' },
  normal: { num: 1,   den: 1,   name: '1:1 · identity',    wave: 'sine' }
};
const activeChords = [];

class PythagoreanAudio {
  constructor() {
    this.ctx = null; this.analyser = null; this.master = null;
    this.enabled = true; this.baseHz = 256;
    this.droneOn = false; this.droneNodes = null;
  }
  init() {
    if (this.ctx) { if (this.ctx.state === 'suspended') this.ctx.resume(); return; }
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    this.ctx = new AC();
    this.master = this.ctx.createGain();
    this.master.gain.value = 0.22;
    this.analyser = this.ctx.createAnalyser();
    this.analyser.fftSize = 256;
    this.master.connect(this.analyser);
    this.analyser.connect(this.ctx.destination);
  }
  toggleDrone() {
    this.droneOn = !this.droneOn;
    if (!this.droneOn) {
      if (this.droneNodes) {
        const now = this.ctx.currentTime;
        this.droneNodes.gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.4);
        setTimeout(() => {
          if (this.droneNodes) { this.droneNodes.oscs.forEach(o => { try { o.stop(); } catch(e){} }); this.droneNodes = null; }
        }, 450);
      }
      return false;
    }
    this.init();
    if (!this.ctx) return false;
    const g = this.ctx.createGain();
    g.gain.setValueAtTime(0.0001, this.ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.11, this.ctx.currentTime + 0.8);
    g.connect(this.master);
    const oscs = [0.5, 1, 1.5].map(r => {
      const o = this.ctx.createOscillator(); o.type = 'sine';
      o.frequency.setValueAtTime(this.baseHz * r, this.ctx.currentTime);
      o.connect(g); o.start(); return o;
    });
    this.droneNodes = { gain: g, oscs };
    return true;
  }
  setBase(hz) {
    this.baseHz = hz;
    if (this.droneNodes && this.ctx) {
      [0.5, 1, 1.5].forEach((r, i) => this.droneNodes.oscs[i].frequency.setTargetAtTime(hz * r, this.ctx.currentTime, 0.08));
    }
  }
  playRule(ruleKey, voiceOffset = 0, totalVoices = 1) {
    const info = PYTH[ruleKey] || PYTH.beta;
    const ratio = info.num / info.den;
    const freq = this.baseHz * ratio * (totalVoices > 1 ? Math.pow(9/8, voiceOffset % 3) : 1);
    document.getElementById('ratioReadout').innerHTML =
      `${info.name}<span>${freq.toFixed(1)} Hz · ${totalVoices > 1 ? totalVoices + '-voice chord' : 'local step'}</span>`;
    document.getElementById('sphereRatio').textContent = `${info.num}:${info.den}`;
    activeChords.push({
      key: ruleKey === 'era' ? 'normal' : ruleKey,
      alpha: 1.0,
      color: (ruleKey === 'comp' || ruleKey === 'papp' || ruleKey === 'unglue') ? '#ffd400' : '#ff0a94'
    });
    if (!this.enabled) return;
    this.init();
    if (!this.ctx) return;
    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator(), over = this.ctx.createOscillator();
    const g = this.ctx.createGain(), g2 = this.ctx.createGain();
    osc.type = info.wave; over.type = 'sine';
    osc.frequency.setValueAtTime(freq, now);
    over.frequency.setValueAtTime(freq * 1.5, now);
    if (ruleKey === 'era') osc.frequency.exponentialRampToValueAtTime(Math.max(55, freq * 0.5), now + 0.28);
    else if (ruleKey === 'papp' || ruleKey === 'comp') osc.frequency.exponentialRampToValueAtTime(this.baseHz * 2, now + 0.36);

    const peak = Math.min(0.42, 0.55 / Math.sqrt(Math.max(1, totalVoices)));
    g.gain.setValueAtTime(0.0001, now);
    g.gain.exponentialRampToValueAtTime(peak, now + 0.015);
    g.gain.exponentialRampToValueAtTime(0.0001, now + (ruleKey === 'normal' ? 1.15 : 0.44));
    g2.gain.setValueAtTime(0.0001, now);
    g2.gain.exponentialRampToValueAtTime(peak * 0.24, now + 0.02);
    g2.gain.exponentialRampToValueAtTime(0.0001, now + 0.24);

    osc.connect(g); over.connect(g2); g.connect(this.master); g2.connect(this.master);
    osc.start(now); over.start(now);
    osc.stop(now + (ruleKey === 'normal' ? 1.2 : 0.48));
