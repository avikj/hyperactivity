  <main class="stage" id="stage">
    <canvas id="netCanvas"></canvas>

    <div class="stage-hud">
      <div class="compiler-card">
        <div class="compiler-top">
          <span class="kicker" id="presetKicker">LIVE HYPERACTIVITY → NET COMPILER</span>
          <span style="font:600 10px var(--mono);color:var(--muted)">λ / \ · (a,b) · fst · snd · @ · ~ · Enter</span>
        </div>
        <div class="compiler-row">
