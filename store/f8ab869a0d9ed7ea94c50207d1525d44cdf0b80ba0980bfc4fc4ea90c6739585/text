    if (!cells.length) return;
    const root = cells.find(c => c.polarity === 'root') || cells[0];

    // Build ordered spanning tree from root (preserving port order so wires never cross!)
    const visited = new Set([root.id]);
    const children = new Map();
    const queue = [root.id];
    while (queue.length) {
      const id = queue.shift();
      const c = this.cells.get(id);
      const kids = [];
      for (let p = 0; p < c.ports.length; p++) {
        const ep = c.ports[p];
        if (ep && this.cells.has(ep.cell) && !visited.has(ep.cell)) {
          visited.add(ep.cell);
          kids.push(ep.cell);
          queue.push(ep.cell);
        }
      }
      children.set(id, kids);
    }
    // Attach any disconnected components cleanly
    for (const c of cells) {
      if (!visited.has(c.id)) {
        visited.add(c.id);
        children.get(root.id).push(c.id);
        children.set(c.id, []);
      }
    }

    // Subtree leaf weights for proportional planar & hyperbolic angular allocation
    const weight = new Map();
    function calcW(id) {
      const kids = children.get(id) || [];
      if (!kids.length) { weight.set(id, 1); return 1; }
      let s = 0; for (const k of kids) s += calcW(k);
      weight.set(id, s); return s;
