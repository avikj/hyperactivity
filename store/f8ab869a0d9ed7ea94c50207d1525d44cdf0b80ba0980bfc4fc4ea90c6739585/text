function tokenize(src) {
  const toks = []; let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (/\s/.test(c)) { i++; continue; }
    if (c === '-' && src[i+1] === '>') { toks.push({ t:'ARR', v:'→' }); i += 2; continue; }
    if (c === '→') { toks.push({ t:'ARR', v:'→' }); i++; continue; }
    if (c === 'λ' || c === '\\') { toks.push({ t:'LAM', v:'λ' }); i++; continue; }
    if ('(),@~:.'.includes(c)) { toks.push({ t:c, v:c }); i++; continue; }
    if (c === '#') {
      let j = i + 1; while (j < src.length && /[0-9]/.test(src[j])) j++;
      toks.push({ t:'WORD', v: src.slice(i, j), n: parseInt(src.slice(i+1, j) || '0', 10) });
      i = j; continue;
    }
    if (/[A-Za-z0-9_']/.test(c)) {
      let j = i; while (j < src.length && /[A-Za-z0-9_']/.test(src[j])) j++;
      toks.push({ t:'ID', v: src.slice(i, j) }); i = j; continue;
    }
    throw new Error(`Unexpected '${c}'`);
  }
  return toks;
}

function parseExpr(src) {
  const toks = tokenize(src); let pos = 0;
  const peek = () => toks[pos];
  const eat = (t) => { const k = toks[pos]; if (!k || (t && k.t !== t)) throw new Error(`Expected ${t || 'token'}`); pos++; return k; };
  function pExpr() {
    let left = pLam();
    if (peek() && peek().t === ',') { eat(','); return { k:'pair', a:left, b:pExpr() }; }
    return left;
  }
  function pLam() {
    if (peek() && peek().t === 'LAM') {
      eat('LAM'); const binders = [];
      while (peek() && peek().t !== 'ARR' && peek().t !== '.') {
        if (peek().t === '(') {
          eat('('); const name = eat('ID').v; let isDim = false;
          if (peek() && peek().t === ':') { eat(':'); if (eat('ID').v === 'I') isDim = true; }
          eat(')'); binders.push({ name, isDim });
        } else {
          const name = eat('ID').v;
          binders.push({ name, isDim: (name === 'i' || name === 'j' || name === 'k') });
        }
      }
      if (!binders.length) throw new Error('Expected binder after λ');
      if (peek() && (peek().t === 'ARR' || peek().t === '.')) eat();
      let body = pExpr();
      for (let b = binders.length - 1; b >= 0; b--)
        body = binders[b].isDim ? { k:'plam', dim:binders[b].name, body } : { k:'lam', param:binders[b].name, body };
      return body;
    }
    return pApp();
  }
  function pApp() {
    let node = pAtom();
    while (peek()) {
      if (peek().t === '@') { eat('@'); node = { k:'papp', fn:node, r:pAtom() }; }
      else if (['ID','WORD','(','LAM','~'].includes(peek().t)) {
        const arg = pAtom();
        if (node.k === 'var' && node.name === 'fst') node = { k:'fst', e:arg };
        else if (node.k === 'var' && node.name === 'snd') node = { k:'snd', e:arg };
        else if (node.k === 'var' && node.name === 'unfold') node = { k:'unfold', e:arg };
        else node = { k:'app', fn:node, arg };
      } else break;
    }
    return node;
  }
  function pAtom() {
    const k = peek(); if (!k) throw new Error('Unexpected end');
    if (k.t === '(') { eat('('); const e = pExpr(); eat(')'); return e; }
    if (k.t === 'LAM') return pLam();
    if (k.t === '~') { eat('~'); return { k:'neg', e:pAtom() }; }
    if (k.t === 'WORD') { eat('WORD'); return { k:'word', n:k.n, v:k.v }; }
    if (k.t === 'ID') { eat('ID'); return { k:'var', name:k.v }; }
    throw new Error(`Unexpected '${k.v}'`);
  }
  const ast = pExpr();
  if (pos < toks.length) throw new Error(`Trailing '${toks[pos].v}'`);
  return ast;
}

function compileAstToNet(ast, net) {
  const root = net.add('ROOT', 'OUT', 'observer', 1, 0, -200);
  function emit(node, env, dims) {
    if (node.k === 'var') {
      if (env.has(node.name)) { const proxy = { cell:null, port:null }; env.get(node.name).push(proxy); return { kind:'pending', proxy }; }
      if (dims.has(node.name)) return { cell: net.add('V_IV', node.name, 'dim ∈ I', 1, 0, 0, { expr: node.name }), port: 0 };
      return { cell: net.add('V_CON', node.name, 'atom', 1), port: 0 };
    }
    if (node.k === 'word') return { cell: net.add('V_WORD', node.v, 'Word', 1, 0, 0, { n: node.n }), port: 0 };
    if (node.k === 'neg') {
      const inner = node.e.k === 'var' ? node.e.name : 'i';
      return { cell: net.add('V_IV', `~${inner}`, 'De Morgan', 1, 0, 0, { expr: `~${inner}` }), port: 0 };
    }
    if (node.k === 'pair') {
      const p = net.add('V_PAIR', 'pair', 'Σ', 3);
      connect(p, 1, emit(node.a, env, dims)); connect(p, 2, emit(node.b, env, dims));
      return { cell: p, port: 0 };
    }
    if (node.k === 'fst' || node.k === 'snd') {
      const op = net.add(node.k === 'fst' ? 'O_FST' : 'O_SND', node.k, node.k === 'fst' ? 'O_FST' : 'O_SND', 2);
      connect(op, 0, emit(node.e, env, dims)); return { cell: op, port: 1 };
    }
    if (node.k === 'unfold') {
      const op = net.add('O_UNFOLD', 'unfold', 'O_UNFOLD', 2);
      connect(op, 0, emit(node.e, env, dims)); return { cell: op, port: 1 };
    }
    if (node.k === 'app') {
      const app = net.add('O_APP', 'app', 'O_APP', 3);
      connect(app, 0, emit(node.fn, env, dims)); connect(app, 1, emit(node.arg, env, dims));
      return { cell: app, port: 2 };
    }
    if (node.k === 'lam') {
      const lam = net.add('V_LAM', 'λ', node.param, 3);
      const prev = env.get(node.param), uses = []; env.set(node.param, uses);
      const body = emit(node.body, env, dims);
      if (prev !== undefined) env.set(node.param, prev); else env.delete(node.param);
      connect(lam, 2, body);
      if (uses.length === 0) { const era = net.add('O_ERA', 'ε', `unused`, 1); net.wire(lam, 1, era, 0); }
      else if (uses.length === 1) { if (uses[0].cell) net.wire(lam, 1, uses[0].cell, uses[0].port); }
      else {
        let curC = lam, curP = 1;
        for (let k = 0; k < uses.length - 1; k++) {
          const dup = net.add('O_DUP', 'δ', 'O_DUP', 3);
          net.wire(curC, curP, dup, 0);
          if (uses[k].cell) net.wire(dup, 1, uses[k].cell, uses[k].port);
          curC = dup; curP = 2;
        }
        const last = uses[uses.length - 1];
        if (last.cell) net.wire(curC, curP, last.cell, last.port);
      }
      return { cell: lam, port: 0 };
    }
    if (node.k === 'plam') {
      net.kanMode = 'path';
      const plam = net.add('V_PLAM', 'path-λ', node.dim, 2);
      const nd = new Set(dims); nd.add(node.dim);
      connect(plam, 1, emit(node.body, env, nd)); return { cell: plam, port: 0 };
    }
    if (node.k === 'papp') {
      const rStr = node.r.k === 'neg' ? `~${node.r.e.name || 'i'}` : (node.r.name || node.r.v || '0');
      if (node.fn.k === 'var' && !env.has(node.fn.name)) {
        const lbl = `${node.fn.name} @ ${rStr}`;
        return { cell: net.add('V_IV', lbl, 'path fiber', 1, 0, 0, { expr: lbl }), port: 0 };
      }
      net.kanMode = 'path';
      const papp = net.add('O_PAPPP', `@ ${rStr}`, rStr, 2);
      connect(papp, 0, emit(node.fn, env, dims)); return { cell: papp, port: 1 };
    }
    throw new Error('Unsupported node');
  }
  function connect(cid, pidx, target) {
    if (target.kind === 'pending') { target.proxy.cell = cid; target.proxy.port = pidx; }
    else net.wire(cid, pidx, target.cell, target.port);
  }
  connect(root, 0, emit(ast, new Map(), new Set()));
}

