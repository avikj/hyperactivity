const canvas = document.getElementById('netCanvas'), ctx = canvas.getContext('2d');
const kanCanvas = document.getElementById('kanCanvas'), kctx = kanCanvas.getContext('2d');
const sphereCanvas = document.getElementById('sphereCanvas'), spctx = sphereCanvas.getContext('2d');
const causalCanvas = document.getElementById('causalCanvas'), cctx = causalCanvas.getContext('2d');
const scopeCanvas = document.getElementById('scopeCanvas'), sctx = scopeCanvas.getContext('2d');

let net = new Net();
let currentPreset = PRESETS[0];
let playing = false, playTimer = null, synMode = false;
let cam = { x: 0, y: 0, zoom: 1 };
let dragCell = null, panStart = null, hoveredPair = null, hoveredCell = null;
let animTime = 0;

function resize() {
  const r = canvas.parentElement.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  canvas.width = r.width * dpr; canvas.height = r.height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
window.addEventListener('resize', resize);
resize();

function screenToWorld(sx, sy) {
  const r = canvas.getBoundingClientRect();
  return { x: (sx - r.width / 2) / cam.zoom - cam.x, y: (sy - r.height / 2) / cam.zoom - cam.y };
}

function compileExpression(src, metaPreset = null) {
  stopPlay();
  const errEl = document.getElementById('compileErr');
  errEl.style.display = 'none';
  nextId = 1;
  const fresh = new Net();
  try {
    if (metaPreset && metaPreset.customBuild && src.trim() === metaPreset.expr.trim()) {
      metaPreset.customBuild(fresh);
    } else {
      const ast = parseExpr(src);
      compileAstToNet(ast, fresh);
    }
    net = fresh;
    cam = { x: 0, y: 0, zoom: 1 };
    document.getElementById('kanBox').classList.toggle('show', !!net.kanMode);
    if (!metaPreset) {
      document.getElementById('presetKicker').textContent = 'COMPILED LIVE EXPRESSION';
      document.getElementById('presetDesc').textContent = 'Compiled directly from your expression into cubical interaction net cells with automatic O_DUP sharing and O_ERA erasure.';
      document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    }
    updateHUD();
  } catch (err) {
    errEl.textContent = 'Parse error: ' + err.message;
    errEl.style.display = 'block';
  }
}

function loadPreset(preset) {
  currentPreset = preset;
  document.getElementById('exprInput').value = preset.expr;
  document.getElementById('presetKicker').textContent = preset.kicker;
  document.getElementById('presetDesc').textContent = preset.desc;
  document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b.dataset.id === preset.id));
  compileExpression(preset.expr, preset);
}

function updateHUD() {
  const active = net.activePairs();
  document.getElementById('mWork').textContent = net.work;
  document.getElementById('mDepth').textContent = net.depth;
  document.getElementById('mPar').textContent = net.depth > 0 ? (net.work / net.depth).toFixed(2) : '—';
  document.getElementById('mActive').textContent = active.length;
  document.getElementById('causalInfo').textContent = `${net.events.length} event${net.events.length === 1 ? '' : 's'}`;
  const st = document.getElementById('mState');
  if (active.length === 0) { st.textContent = 'NORMAL ≡'; st.className = 'mv ok'; }
  else { st.textContent = playing ? 'RUNNING' : 'ACTIVE'; st.className = 'mv pink'; }
  document.getElementById('traceCount').textContent = `${net.work} step${net.work === 1 ? '' : 's'}`;
  document.getElementById('traceLog').innerHTML = net.trace.map(t =>
    `<div class="trace-row"><span class="rule">#${t.step} ${t.rule}</span><span class="ratio">${t.ratio.split('·')[0]}</span></div>`
  ).join('');
}

function stepPhysics() {
  const cells = [...net.cells.values()];
  for (let i = 0; i < cells.length; i++) {
    const a = cells[i]; a.age += 0.04;
    for (let j = i + 1; j < cells.length; j++) {
      const b = cells[j];
      const dx = b.x - a.x, dy = b.y - a.y, d2 = dx*dx + dy*dy + 0.01, d = Math.sqrt(d2);
      if (d < 210) {
        const f = 3100 / d2, fx = (dx/d)*f, fy = (dy/d)*f;
        if (!a.fixed && a !== dragCell) { a.vx -= fx; a.vy -= fy; }
        if (!b.fixed && b !== dragCell) { b.vx += fx; b.vy += fy; }
      }
    }
  }
  for (const c of cells) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p];
      if (!ep || ep.cell <= c.id) continue;
      const o = net.cells.get(ep.cell); if (!o) continue;
      const dx = o.x - c.x, dy = o.y - c.y, d = Math.sqrt(dx*dx + dy*dy) + 0.01;
      const target = (p === 0 && ep.port === 0) ? 88 : 104;
      const f = (d - target) * 0.046, fx = (dx/d)*f, fy = (dy/d)*f;
      if (!c.fixed && c !== dragCell) { c.vx += fx; c.vy += fy; }
      if (!o.fixed && o !== dragCell) { o.vx -= fx; o.vy -= fy; }
    }
  }
  for (const c of cells) {
    if (c.fixed || c === dragCell) { c.vx = 0; c.vy = 0; continue; }
    c.vx *= 0.82; c.vy *= 0.82;
    c.x += Math.max(-14, Math.min(14, c.vx));
    c.y += Math.max(-14, Math.min(14, c.vy));
  }
}

function portPos(c, pIdx) {
  const n = c.ports.length;
  if (pIdx === 0) {
    const ep = c.ports[0];
    if (ep && net.cells.has(ep.cell)) {
      const o = net.cells.get(ep.cell);
      const ang = Math.atan2(o.y - c.y, o.x - c.x);
      return { x: c.x + Math.cos(ang) * 26, y: c.y + Math.sin(ang) * 26, ang };
    }
    return { x: c.x, y: c.y - 26, ang: -Math.PI / 2 };
  }
  const p0 = portPos(c, 0), baseAng = p0.ang + Math.PI, aux = n - 1;
  const offset = aux === 1 ? 0 : ((pIdx - 1) / (aux - 1) - 0.5) * 1.44;
  const ang = baseAng + offset;
  return { x: c.x + Math.cos(ang) * 24, y: c.y + Math.sin(ang) * 24, ang };
}

function draw() {
  animTime += 0.03;
  stepPhysics();
  const r = canvas.getBoundingClientRect(), W = r.width, H = r.height;
  const isLight = document.documentElement.classList.contains('light');
  const ink = isLight ? '#000' : '#fff', muted = isLight ? '#888' : '#555';
  ctx.clearRect(0, 0, W, H);

  const gs = 40 * cam.zoom;
  ctx.strokeStyle = isLight ? 'rgba(0,0,0,0.045)' : 'rgba(255,255,255,0.045)';
  ctx.lineWidth = 1;
  const ox = ((W/2 + cam.x*cam.zoom) % gs + gs) % gs, oy = ((H/2 + cam.y*cam.zoom) % gs + gs) % gs;
  ctx.beginPath();
  for (let x = ox; x < W; x += gs) { ctx.moveTo(x, 0); ctx.lineTo(x, H); }
  for (let y = oy; y < H; y += gs) { ctx.moveTo(0, y); ctx.lineTo(W, y); }
  ctx.stroke();

  ctx.save();
  ctx.translate(W/2, H/2); ctx.scale(cam.zoom, cam.zoom); ctx.translate(cam.x, cam.y);

  const activeSet = new Set(net.activePairs().map(p => `${Math.min(p.op.id, p.val.id)}-${Math.max(p.op.id, p.val.id)}`));
  for (const c of net.cells.values()) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p]; if (!ep) continue;
      if (ep.cell === c.id && p < ep.port) {
        const a = portPos(c, p), b = portPos(c, ep.port);
        ctx.strokeStyle = muted; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(a.x, a.y);
        ctx.quadraticCurveTo((a.x+b.x)/2 + (a.x-c.x)*1.1, (a.y+b.y)/2 + (a.y-c.y)*1.1, b.x, b.y);
        ctx.stroke(); continue;
      }
      if (ep.cell <= c.id) continue;
      const o = net.cells.get(ep.cell); if (!o) continue;
      const a = portPos(c, p), b = portPos(o, ep.port);
      const key = `${Math.min(c.id, o.id)}-${Math.max(c.id, o.id)}`;
      const isActive = (p === 0 && ep.port === 0 && activeSet.has(key));
      const isHover = hoveredPair && ((hoveredPair.op.id === c.id && hoveredPair.val.id === o.id) || (hoveredPair.op.id === o.id && hoveredPair.val.id === c.id));
      if (isActive) {
        ctx.save();
        ctx.strokeStyle = '#ff0a94'; ctx.lineWidth = isHover ? 5 : 3.2;
        ctx.shadowColor = '#ff0a94'; ctx.shadowBlur = isHover ? 18 : 10;
        ctx.beginPath();
        const steps = 18, dx = b.x - a.x, dy = b.y - a.y, len = Math.hypot(dx, dy) || 1;
        const nx = -dy/len, ny = dx/len;
        for (let s = 0; s <= steps; s++) {
          const t = s/steps, wave = Math.sin(t*Math.PI*3 + animTime*5) * 4.5 * Math.sin(t*Math.PI);
          const px = a.x + dx*t + nx*wave, py = a.y + dy*t + ny*wave;
          if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();
        ctx.fillStyle = '#ff0a94';
        ctx.beginPath(); ctx.arc(a.x, a.y, 4.5, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(b.x, b.y, 4.5, 0, Math.PI*2); ctx.fill();
        ctx.restore();
      } else {
        ctx.strokeStyle = isLight ? '#222' : '#7a7a7a'; ctx.lineWidth = 1.8;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
    }
  }

  for (let i = net.sparks.length - 1; i >= 0; i--) {
    const sp = net.sparks[i]; sp.r += 4.2; sp.alpha -= 0.045;
    if (sp.alpha <= 0) { net.sparks.splice(i, 1); continue; }
    ctx.save(); ctx.strokeStyle = sp.color; ctx.globalAlpha = sp.alpha; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.arc(sp.x, sp.y, sp.r, 0, Math.PI*2); ctx.stroke(); ctx.restore();
  }

  for (const c of net.cells.values()) {
    const scale = Math.min(1, 0.3 + c.age * 1.8), p0 = portPos(c, 0);
    const isCubical = ['V_PLAM','V_IV','V_SYS','V_GLUE','V_GLUEV','O_PAPPP','O_SUBST','O_COMP','O_UNGLUE'].includes(c.kind);
    const accent = synMode ? synColorFor(c.label) : (isCubical ? '#ffd400' : (c.polarity === 'val' ? '#ff0a94' : '#00e5ff'));
    ctx.save(); ctx.translate(c.x, c.y); ctx.scale(scale, scale);
    if (c.polarity === 'root') {
      ctx.fillStyle = isLight ? '#000' : '#fff'; ctx.fillRect(-34, -15, 68, 30);
      ctx.fillStyle = isLight ? '#fff' : '#000'; ctx.font = '800 11px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('OUT', 0, 1);
    } else if (c.polarity === 'val') {
      ctx.save(); ctx.rotate(p0.ang + Math.PI/2); ctx.beginPath();
      if (isCubical) { ctx.moveTo(0,-28); ctx.lineTo(26,0); ctx.lineTo(0,26); ctx.lineTo(-26,0); }
      else { ctx.moveTo(0,-28); ctx.lineTo(27,20); ctx.lineTo(-27,20); }
      ctx.closePath(); ctx.fillStyle = isLight ? '#fff0f8' : '#140410'; ctx.fill();
      ctx.lineWidth = hoveredCell === c ? 3.5 : 2.2; ctx.strokeStyle = accent; ctx.stroke(); ctx.restore();
      ctx.fillStyle = ink; ctx.font = '800 13px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(c.label, 0, -2);
      if (c.sub) { ctx.fillStyle = accent; ctx.font = '600 9.5px ui-monospace, Menlo, monospace'; ctx.fillText(c.sub, 0, 12); }
    } else {
      ctx.save(); ctx.rotate(p0.ang + Math.PI/2); ctx.beginPath();
      ctx.moveTo(-25,-22); ctx.lineTo(-8,-22); ctx.lineTo(0,-12); ctx.lineTo(8,-22);
      ctx.lineTo(25,-22); ctx.lineTo(25,22); ctx.lineTo(-25,22); ctx.closePath();
      ctx.fillStyle = isLight ? '#f4f4f4' : '#0a0a0c'; ctx.fill();
      ctx.lineWidth = hoveredCell === c ? 3.5 : 2.2; ctx.strokeStyle = accent; ctx.stroke(); ctx.restore();
      ctx.fillStyle = ink; ctx.font = '800 12px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(c.label, 0, -1);
      if (c.sub) { ctx.fillStyle = accent; ctx.font = '600 9px ui-monospace, Menlo, monospace'; ctx.fillText(c.sub, 0, 12); }
    }
    ctx.restore();
  }
  ctx.restore();

  drawSphere();
  drawCausalDag();
  drawKanBox();
  drawScope();
  requestAnimationFrame(draw);
}

// Pythagorean Music of the Spheres Constellation
function drawSphere() {
  const W = sphereCanvas.width, H = sphereCanvas.height, cx = W/2, cy = H/2, R = 104;
  const isLight = document.documentElement.classList.contains('light');
  spctx.clearRect(0, 0, W, H);

  // Outer harmonic ring & subtle inner identity ring
  spctx.strokeStyle = isLight ? 'rgba(0,0,0,0.2)' : 'rgba(255,255,255,0.2)';
  spctx.lineWidth = 2;
  spctx.beginPath(); spctx.arc(cx, cy, R, 0, Math.PI*2); spctx.stroke();
  spctx.beginPath(); spctx.arc(cx, cy, R*0.42, 0, Math.PI*2); spctx.stroke();

  // Active geometric chords connecting firing ratios across the sphere!
  for (let i = activeChords.length - 1; i >= 0; i--) {
    const ch = activeChords[i];
    ch.alpha -= 0.014;
    if (ch.alpha <= 0) { activeChords.splice(i, 1); continue; }
    const n1 = SPHERE_NODES.find(n => n.key === ch.key) || SPHERE_NODES[0];
    const n0 = SPHERE_NODES[0]; // 1:1 identity tonic
    const x1 = cx + Math.cos(n1.ang)*R, y1 = cy + Math.sin(n1.ang)*R;
    const x0 = cx + Math.cos(n0.ang)*R, y0 = cy + Math.sin(n0.ang)*R;
    spctx.save();
    spctx.strokeStyle = ch.color; spctx.globalAlpha = ch.alpha; spctx.lineWidth = 3.5;
    spctx.beginPath(); spctx.moveTo(cx, cy); spctx.lineTo(x1, y1); spctx.lineTo(x0, y0); spctx.stroke();
    // Glowing harmonic node
    spctx.fillStyle = ch.color;
    spctx.beginPath(); spctx.arc(x1, y1, 8, 0, Math.PI*2); spctx.fill();
    spctx.restore();
  }

  // Center 1:1 identity singularity
  spctx.fillStyle = '#ff0a94';
  spctx.beginPath(); spctx.arc(cx, cy, 5, 0, Math.PI*2); spctx.fill();

  // Ratio vertices around the circle
  spctx.font = '700 17px ui-monospace, Menlo, monospace';
  spctx.textAlign = 'center'; spctx.textBaseline = 'middle';
  SPHERE_NODES.forEach(n => {
    const x = cx + Math.cos(n.ang)*R, y = cy + Math.sin(n.ang)*R;
    const lx = cx + Math.cos(n.ang)*(R + 26), ly = cy + Math.sin(n.ang)*(R + 22);
    spctx.fillStyle = isLight ? '#000' : '#fff';
    spctx.beginPath(); spctx.arc(x, y, 4, 0, Math.PI*2); spctx.fill();
    spctx.fillStyle = n.key === 'normal' ? '#ff0a94' : (isLight ? '#444' : '#aaa');
    spctx.fillText(n.label, lx, ly);
  });
}

// Wolfram-style Causal Event DAG in sidebar
function drawCausalDag() {
  const W = causalCanvas.width, H = causalCanvas.height;
  const isLight = document.documentElement.classList.contains('light');
  cctx.clearRect(0, 0, W, H);
  if (!net.events.length) {
    cctx.fillStyle = isLight ? '#999' : '#444';
    cctx.font = '600 19px ui-monospace, Menlo, monospace';
    cctx.textAlign = 'center'; cctx.fillText('AWAITING INTERACTION EVENTS', W/2, H/2 + 6);
    return;
  }
  const byDepth = new Map();
  net.events.forEach(ev => {
    if (!byDepth.has(ev.depth)) byDepth.set(ev.depth, []);
    byDepth.get(ev.depth).push(ev);
  });
  const depths = [...byDepth.keys()].sort((a,b) => a - b);
  const pos = new Map();
  depths.forEach((d, di) => {
    const row = byDepth.get(d);
    const x = 36 + (depths.length === 1 ? (W - 72)/2 : (di / (depths.length - 1)) * (W - 72));
    row.forEach((ev, ri) => {
      const y = 30 + (row.length === 1 ? (H - 60)/2 : (ri / (row.length - 1)) * (H - 60));
      pos.set(ev.id, { x, y });
    });
  });
  // Causal edges
  cctx.strokeStyle = isLight ? 'rgba(0,0,0,0.35)' : 'rgba(255,255,255,0.35)';
  cctx.lineWidth = 2;
  net.events.forEach(ev => {
    const p2 = pos.get(ev.id);
    ev.parents.forEach(pid => {
      const p1 = pos.get(pid);
      if (p1 && p2) {
        cctx.beginPath(); cctx.moveTo(p1.x, p1.y); cctx.lineTo(p2.x, p2.y); cctx.stroke();
      }
    });
  });
  // Event nodes
  net.events.forEach(ev => {
    const p = pos.get(ev.id);
    cctx.fillStyle = (ev.key === 'comp' || ev.key === 'papp' || ev.key === 'unglue') ? '#ffd400' : '#ff0a94';
    cctx.beginPath(); cctx.arc(p.x, p.y, 7, 0, Math.PI*2); cctx.fill();
  });
}

function drawKanBox() {
  if (!net.kanMode) return;
  const W = kanCanvas.width, H = kanCanvas.height;
  const isLight = document.documentElement.classList.contains('light');
  kctx.clearRect(0, 0, W, H);
  const p = net.kanProgress;
  document.getElementById('kanPhase').textContent = `j = ${p.toFixed(2)}`;
  document.getElementById('kanTitle').textContent =
    net.kanMode === 'univalence' ? 'GLUE / UA FIBER' :
    net.kanMode === 'path' ? 'INTERVAL I = [0,1]' : 'KAN OPEN BOX';
  const x0 = 62, x1 = W - 62, y0 = H - 42, y1 = 42;
  if (p > 0) {
    const curY = y0 - (y0 - y1) * p;
    kctx.fillStyle = 'rgba(255, 10, 148, 0.16)';
    kctx.fillRect(x0, curY, x1 - x0, y0 - curY);
  }
  kctx.strokeStyle = '#00e5ff'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x0, y1); kctx.stroke();
  kctx.strokeStyle = '#ffd400'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x1, y0); kctx.lineTo(x1, y1); kctx.stroke();
  kctx.strokeStyle = isLight ? '#000' : '#fff'; kctx.lineWidth = 4; kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x1, y0); kctx.stroke();
  const lidY = y0 - (y0 - y1) * p;
  kctx.strokeStyle = '#ff0a94'; kctx.lineWidth = p >= 1 ? 5 : 3;
  kctx.setLineDash(p >= 1 ? [] : [8, 6]);
  kctx.beginPath(); kctx.moveTo(x0, lidY); kctx.lineTo(x1, lidY); kctx.stroke();
  kctx.setLineDash([]);
  kctx.font = '700 18px ui-monospace, Menlo, monospace'; kctx.textAlign = 'center';
  kctx.fillStyle = isLight ? '#000' : '#fff'; kctx.fillText(net.kanMode === 'univalence' ? 'true : Bool' : 'p(i)', W/2, y0 + 24);
  kctx.fillStyle = '#00e5ff'; kctx.fillText('i=0', x0 - 30, (y0 + y1)/2);
  kctx.fillStyle = '#ffd400'; kctx.fillText('i=1', x1 + 30, (y0 + y1)/2);
  if (p >= 1) { kctx.fillStyle = '#ff0a94'; kctx.fillText(net.kanMode === 'univalence' ? 'false : Bool' : 'p ∙ q', W/2, y1 - 12); }
}

function drawScope() {
  const W = scopeCanvas.width, H = scopeCanvas.height;
  sctx.clearRect(0, 0, W, H);
  sctx.strokeStyle = '#ff0a94'; sctx.lineWidth = 2.5; sctx.beginPath();
  if (audio.analyser && (audio.enabled || audio.droneOn)) {
    const buf = new Uint8Array(audio.analyser.frequencyBinCount);
    audio.analyser.getByteTimeDomainData(buf);
    for (let i = 0; i < buf.length; i++) {
      const x = (i / (buf.length - 1)) * W, y = (buf[i] / 255) * H;
      if (i === 0) sctx.moveTo(x, y); else sctx.lineTo(x, y);
    }
  } else { sctx.moveTo(0, H/2); sctx.lineTo(W, H/2); }
  sctx.stroke();
}

// ============================================================================
// 7. POINTER & KEYBOARD INTERACTION
// ============================================================================
function findHit(wx, wy) {
  for (const pair of net.activePairs()) {
    const a = portPos(pair.op, 0), b = portPos(pair.val, 0);
    const dx = b.x - a.x, dy = b.y - a.y, len2 = dx*dx + dy*dy + 0.01;
    const t = Math.max(0, Math.min(1, ((wx - a.x)*dx + (wy - a.y)*dy) / len2));
    if (Math.hypot(wx - (a.x + t*dx), wy - (a.y + t*dy)) < 16) return { type: 'pair', pair };
  }
  for (const c of net.cells.values()) {
    if (Math.hypot(wx - c.x, wy - c.y) < 28) return { type: 'cell', cell: c };
  }
  return null;
}

canvas.addEventListener('pointermove', e => {
  const rect = canvas.getBoundingClientRect();
  const w = screenToWorld(e.clientX - rect.left, e.clientY - rect.top);
  if (dragCell) { dragCell.x = w.x; dragCell.y = w.y; return; }
  if (panStart) {
    cam.x = panStart.cx + (e.clientX - panStart.x) / cam.zoom;
    cam.y = panStart.cy + (e.clientY - panStart.y) / cam.zoom;
    return;
  }
  const hit = findHit(w.x, w.y), tip = document.getElementById('hoverTip');
  hoveredPair = hit && hit.type === 'pair' ? hit.pair : null;
  hoveredCell = hit && hit.type === 'cell' ? hit.cell : null;
  if (hoveredPair) {
    const info = net.describeRule(hoveredPair.op, hoveredPair.val), pyth = PYTH[info.key] || PYTH.beta;
    canvas.style.cursor = 'pointer'; tip.style.display = 'block';
    tip.innerHTML = `<div>ACTIVE PAIR: ${info.text}</div><div class="ht-sub">Click to fire local step · ${pyth.name}</div>`;
  } else if (hoveredCell) {
    canvas.style.cursor = 'grab'; tip.style.display = 'block';
    tip.innerHTML = `<div>${hoveredCell.kind} (${hoveredCell.label})</div><div class="ht-sub">polarity: ${hoveredCell.polarity} · ports: ${hoveredCell.ports.length} · drag to move</div>`;
  } else { canvas.style.cursor = 'grab'; tip.style.display = 'none'; }
});

canvas.addEventListener('pointerdown', e => {
  const rect = canvas.getBoundingClientRect();
  const w = screenToWorld(e.clientX - rect.left, e.clientY - rect.top);
  const hit = findHit(w.x, w.y);
  if (hit && hit.type === 'pair') {
    net.depth++;
    const info = net.firePair(hit.pair.op.id, hit.pair.val.id);
    if (info) audio.playRule(info.key, 0, 1);
    if (net.activePairs().length === 0) setTimeout(() => audio.playNormalForm(), 160);
    updateHUD(); return;
  }
  if (hit && hit.type === 'cell') { dragCell = hit.cell; canvas.setPointerCapture(e.pointerId); return; }
  panStart = { x: e.clientX, y: e.clientY, cx: cam.x, cy: cam.y };
  canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointerup', () => { dragCell = null; panStart = null; });
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  cam.zoom = Math.max(0.3, Math.min(2.6, cam.zoom * (e.deltaY < 0 ? 1.1 : 0.91)));
}, { passive: false });

// ============================================================================
// 8. UI CONTROLS
// ============================================================================
const presetList = document.getElementById('presetList');
PRESETS.forEach(p => {
  const btn = document.createElement('button');
  btn.className = 'preset-btn'; btn.dataset.id = p.id;
  btn.innerHTML = `<div class="pt"><span>${p.title}</span></div><div class="pe">${p.expr}</div>`;
  btn.onclick = () => loadPreset(p);
  presetList.appendChild(btn);
});

document.getElementById('btnCompile').onclick = () => compileExpression(document.getElementById('exprInput').value);
document.getElementById('exprInput').addEventListener('keydown', e => {
  if (e.key === 'Enter') compileExpression(e.target.value);
});

function stopPlay() {
  playing = false;
  if (playTimer) clearInterval(playTimer);
  playTimer = null;
  document.getElementById('btnPlay').textContent = '▶ Play';
  updateHUD();
}
function startPlayLoop() {
  const ms = 1320 - parseInt(document.getElementById('speedSlider').value, 10);
  if (playTimer) clearInterval(playTimer);
  playTimer = setInterval(() => {
    const fired = net.stepParallel(); updateHUD();
    if (!fired || net.activePairs().length === 0) stopPlay();
  }, Math.max(110, ms));
}
document.getElementById('btnPlay').onclick = () => {
  if (playing) { stopPlay(); return; }
  if (net.activePairs().length === 0) compileExpression(document.getElementById('exprInput').value, currentPreset);
  playing = true; document.getElementById('btnPlay').textContent = '❚❚ Pause'; updateHUD();
  const fired = net.stepParallel(); updateHUD();
  if (!fired || net.activePairs().length === 0) { stopPlay(); return; }
  startPlayLoop();
};
document.getElementById('speedSlider').oninput = () => { if (playing) startPlayLoop(); };
document.getElementById('btnStep').onclick = () => { stopPlay(); net.stepParallel(); updateHUD(); };
document.getElementById('btnReset').onclick = () => compileExpression(document.getElementById('exprInput').value, currentPreset);
document.getElementById('btnFit').onclick = () => { cam = { x: 0, y: 0, zoom: 1 }; };

document.getElementById('btnSound').onclick = function() {
  audio.enabled = !audio.enabled;
  this.textContent = audio.enabled ? '♫ Sound' : '♫ Muted';
  this.classList.toggle('on', audio.enabled);
};
document.getElementById('btnDrone').onclick = function() {
  const on = audio.toggleDrone();
  this.classList.toggle('on', on);
};
document.getElementById('tuningSel').onchange = function() { audio.setBase(parseFloat(this.value)); };
document.getElementById('btnSyn').onclick = function() { synMode = !synMode; this.classList.toggle('on', synMode); };
document.getElementById('btnTheme').onclick = () => document.documentElement.classList.toggle('light');
document.addEventListener('keydown', e => {
  if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
  if (e.key === 's' || e.key === 'S') { synMode = !synMode; document.getElementById('btnSyn').classList.toggle('on', synMode); }
  else if (e.key === ' ') { e.preventDefault(); document.getElementById('btnStep').click(); }
});

const qPreset = new URLSearchParams(location.search).get('preset');
loadPreset(PRESETS.find(p => p.id === qPreset) || PRESETS[2]); // default to Church 2^2 or query preset
requestAnimationFrame(draw);
</script>
