// 4. LIVE HYPERACTIVITY EXPRESSION → INTERACTION NET COMPILER
// ============================================================================
// Supports: λ x y → body, \x -> body, λ (i : I) → body, (a , b), fst e, snd e,
//           e @ r, ~i, unfold #N, application f x, variables & atoms!
function tokenize(src) {
  const toks = [];
  let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (/\s/.test(c)) { i++; continue; }
    if (c === '-' && src[i+1] === '>') { toks.push({ t:'ARR', v:'→' }); i += 2; continue; }
    if (c === '→') { toks.push({ t:'ARR', v:'→' }); i++; continue; }
    if (c === 'λ' || c === '\\') { toks.push({ t:'LAM', v:'λ' }); i++; continue; }
    if ('(),@~:.'.includes(c)) { toks.push({ t:c, v:c }); i++; continue; }
    if (c === '#') {
      let j = i + 1; while (j < src.length && /[0-9]/.test(src[j])) j++;
      toks.push({ t:'WORD', v: src.slice(i, j), n: parseInt(src.slice(i+1, j) || '0', 10) });
      i = j; continue;
    }
    if (/[A-Za-z0-9_']/.test(c)) {
      let j = i; while (j < src.length && /[A-Za-z0-9_']/.test(src[j])) j++;
      toks.push({ t:'ID', v: src.slice(i, j) });
      i = j; continue;
    }
    throw new Error(`Unexpected character '${c}'`);
  }
  return toks;
}

function parseExpr(src) {
  const toks = tokenize(src);
  let pos = 0;
  const peek = () => toks[pos];
  const eat = (t) => {
    const k = toks[pos];
    if (!k || (t && k.t !== t)) throw new Error(`Expected ${t || 'token'}, got ${k ? k.v : 'EOF'}`);
    pos++; return k;
  };
  function pExpr() {
    let left = pLam();
    if (peek() && peek().t === ',') {
      eat(',');
      const right = pExpr();
      return { k: 'pair', a: left, b: right };
    }
    return left;
  }
  function pLam() {
    if (peek() && peek().t === 'LAM') {
      eat('LAM');
      const binders = [];
      while (peek() && peek().t !== 'ARR' && peek().t !== '.') {
        if (peek().t === '(') {
          eat('(');
          const name = eat('ID').v;
          let isDim = false;
          if (peek() && peek().t === ':') { eat(':'); const ty = eat('ID').v; if (ty === 'I') isDim = true; }
          eat(')');
          binders.push({ name, isDim });
        } else {
          const name = eat('ID').v;
          binders.push({ name, isDim: (name === 'i' || name === 'j' || name === 'k') });
        }
      }
      if (!binders.length) throw new Error('Expected binder after λ');
      if (peek() && (peek().t === 'ARR' || peek().t === '.')) eat();
      let body = pExpr();
      for (let b = binders.length - 1; b >= 0; b--) {
        body = binders[b].isDim
          ? { k: 'plam', dim: binders[b].name, body }
          : { k: 'lam', param: binders[b].name, body };
      }
      return body;
    }
    return pApp();
  }
  function pApp() {
    let node = pAtom();
    while (peek()) {
      if (peek().t === '@') {
        eat('@');
        const iv = pAtom();
        node = { k: 'papp', fn: node, r: iv };
      } else if (['ID', 'WORD', '(', 'LAM', '~'].includes(peek().t)) {
        const arg = pAtom();
        if (node.k === 'var' && node.name === 'fst') node = { k: 'fst', e: arg };
        else if (node.k === 'var' && node.name === 'snd') node = { k: 'snd', e: arg };
        else if (node.k === 'var' && node.name === 'unfold') node = { k: 'unfold', e: arg };
        else node = { k: 'app', fn: node, arg };
      } else break;
    }
    return node;
  }
  function pAtom() {
    const k = peek();
    if (!k) throw new Error('Unexpected end of expression');
    if (k.t === '(') { eat('('); const e = pExpr(); eat(')'); return e; }
    if (k.t === 'LAM') return pLam();
    if (k.t === '~') { eat('~'); const e = pAtom(); return { k: 'neg', e }; }
    if (k.t === 'WORD') { eat('WORD'); return { k: 'word', n: k.n, v: k.v }; }
    if (k.t === 'ID') { eat('ID'); return { k: 'var', name: k.v }; }
    throw new Error(`Unexpected token '${k.v}'`);
  }
  const ast = pExpr();
  if (pos < toks.length) throw new Error(`Unexpected trailing '${toks[pos].v}'`);
  return ast;
}

function compileAstToNet(ast, net) {
  const root = net.add('ROOT', 'OUT', 'observer', 1, 0, -180);
  // env maps var name -> array of consumer endpoints { cell, port }
  function emit(node, env, dims, x, y, spread) {
    if (node.k === 'var') {
      if (env.has(node.name)) {
        const proxy = { cell: null, port: null };
        env.get(node.name).push(proxy);
        return { kind: 'pending', proxy };
      }
      if (dims.has(node.name)) {
        const id = net.add('V_IV', node.name, 'dim ∈ I', 1, x, y, { expr: node.name });
        return { cell: id, port: 0 };
      }
      const id = net.add('V_CON', node.name, 'atom', 1, x, y);
      return { cell: id, port: 0 };
    }
    if (node.k === 'word') {
      const id = net.add('V_WORD', node.v, 'Word', 1, x, y, { n: node.n });
      return { cell: id, port: 0 };
    }
    if (node.k === 'neg') {
      const inner = node.e.k === 'var' ? node.e.name : 'i';
      const id = net.add('V_IV', `~${inner}`, 'De Morgan', 1, x, y, { expr: `~${inner}` });
      return { cell: id, port: 0 };
    }
    if (node.k === 'pair') {
      const p = net.add('V_PAIR', 'pair', 'Σ', 3, x, y);
      const a = emit(node.a, env, dims, x - spread * 0.55, y + 88, spread * 0.6);
      const b = emit(node.b, env, dims, x + spread * 0.55, y + 88, spread * 0.6);
      connect(p, 1, a); connect(p, 2, b);
      return { cell: p, port: 0 };
    }
    if (node.k === 'fst' || node.k === 'snd') {
      const op = net.add(node.k === 'fst' ? 'O_FST' : 'O_SND', node.k, node.k === 'fst' ? 'O_FST' : 'O_SND', 2, x, y);
      const e = emit(node.e, env, dims, x, y + 88, spread * 0.85);
      connect(op, 0, e);
      return { cell: op, port: 1 };
    }
    if (node.k === 'unfold') {
      const op = net.add('O_UNFOLD', 'unfold', 'O_UNFOLD', 2, x, y);
      const e = emit(node.e, env, dims, x, y + 88, spread * 0.85);
      connect(op, 0, e);
      return { cell: op, port: 1 };
    }
    if (node.k === 'app') {
      const app = net.add('O_APP', 'app', 'O_APP', 3, x, y);
      const fn = emit(node.fn, env, dims, x + spread * 0.5, y + 70, spread * 0.65);
      const arg = emit(node.arg, env, dims, x - spread * 0.5, y + 88, spread * 0.65);
      connect(app, 0, fn);
      connect(app, 1, arg);
      return { cell: app, port: 2 };
    }
    if (node.k === 'lam') {
      const lam = net.add('V_LAM', 'λ', node.param, 3, x, y);
      const prev = env.get(node.param);
      const uses = [];
      env.set(node.param, uses);
      const body = emit(node.body, env, dims, x + spread * 0.4, y + 82, spread * 0.72);
      if (prev !== undefined) env.set(node.param, prev); else env.delete(node.param);
      connect(lam, 2, body);
      // Automatic linearity / sharing / erasure wiring!
      if (uses.length === 0) {
        const era = net.add('O_ERA', 'ε', `unused ${node.param}`, 1, x - 48, y + 58);
        net.wire(lam, 1, era, 0);
      } else if (uses.length === 1) {
        if (uses[0].cell) net.wire(lam, 1, uses[0].cell, uses[0].port);
      } else {
        // Binary tree of O_DUP fan-out cells!
        let curCell = lam, curPort = 1;
        for (let k = 0; k < uses.length - 1; k++) {
          const dup = net.add('O_DUP', 'δ', 'O_DUP', 3, x - 42 + k * 24, y + 58 + k * 24);
          net.wire(curCell, curPort, dup, 0);
          if (uses[k].cell) net.wire(dup, 1, uses[k].cell, uses[k].port);
          curCell = dup; curPort = 2;
        }
        const last = uses[uses.length - 1];
        if (last.cell) net.wire(curCell, curPort, last.cell, last.port);
      }
      return { cell: lam, port: 0 };
    }
    if (node.k === 'plam') {
      net.kanMode = 'path';
      const plam = net.add('V_PLAM', 'path-λ', node.dim, 2, x, y);
      const nextDims = new Set(dims); nextDims.add(node.dim);
      const body = emit(node.body, env, nextDims, x, y + 86, spread * 0.8);
      connect(plam, 1, body);
      return { cell: plam, port: 0 };
    }
    if (node.k === 'papp') {
      const rStr = node.r.k === 'neg' ? `~${node.r.e.name || 'i'}` : (node.r.name || node.r.v || '0');
      if (node.fn.k === 'var' && !env.has(node.fn.name)) {
        // Path variable applied to an interval: atomic V_IV expression!
        const lbl = `${node.fn.name} @ ${rStr}`;
        const id = net.add('V_IV', lbl, 'path fiber', 1, x, y, { expr: lbl });
        return { cell: id, port: 0 };
      }
      net.kanMode = 'path';
      const papp = net.add('O_PAPPP', `@ ${rStr}`, rStr, 2, x, y);
      const fn = emit(node.fn, env, dims, x, y + 86, spread * 0.85);
      connect(papp, 0, fn);
      return { cell: papp, port: 1 };
    }
    throw new Error('Unsupported syntax node');
  }
  function connect(cellId, portIdx, target) {
    if (target.kind === 'pending') {
      target.proxy.cell = cellId;
      target.proxy.port = portIdx;
    } else {
      net.wire(cellId, portIdx, target.cell, target.port);
    }
  }
  const top = emit(ast, new Map(), new Set(), 0, -75, 220);
  connect(root, 0, top);
}

