-- THEOREM 2C (Universal DPO Church-Rosser Confluence / Parallel Independence):
rxn-add-delta : (A : Type) → (A → A → A) → List A → List A → List A
rxn-add-delta A add g d = case g of
  nil → nil
  cons gx gr → case d of
    nil → cons gx gr
    cons dx dr → cons (add gx dx) (rxn-add-delta A add gr dr)
