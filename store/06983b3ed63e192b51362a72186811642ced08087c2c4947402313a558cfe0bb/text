-- Section (4): Exact binary rational purity (Renyi-2 collision measure) and Shannon/Landauer bit bounds.
-- Given exact integer frequency/weight list ws = [w_1, ..., w_n] with total W = sum w_i,
-- the exact rational purity (collision probability) is P_2 = (sum w_i^2) / W^2 in BQ.
-- Since Shannon entropy H_1 >= Renyi-2 entropy H_2 = -log2(P_2), floor(log2(W^2 / sum w_i^2)) is an exact
-- integer lower bound on Shannon uncertainty (zero floats, zero logarithms!).
qi-sum-bin : List (List Bool) → List Bool
qi-sum-bin ws = case ws of
  nil → nil
  cons w rest → bin-add w (qi-sum-bin rest)
