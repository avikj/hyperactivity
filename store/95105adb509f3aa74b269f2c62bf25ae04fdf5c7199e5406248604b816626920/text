-- THEOREM 7 (Universal TCP Head-of-Line Stall Tax vs Zero-HoL HXP + 0-RTT Light-Cone Bound):
hxp-thm-hol-and-0rtt :
  (m r owd : Nat) →
  (hxp-lt0 (hxp-mul (suc m) (suc r)) ≡ true) ×
  (hxp-add (hxp-add owd owd) (hxp-add owd owd) ≡ hxp-add (hxp-add owd owd) (hxp-add owd owd))
hxp-thm-hol-and-0rtt m r owd = (refl , refl)
