b2-foreigntip : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-foreigntip mm_ zero bk tel d kq_ =
  kq_ (h4-depl mm_ (tel))
b2-foreigntip mm_ (suc f) bk tel d kq_ =
  b2-strip mm_ tel (λ t → let mm_12702 = b2-dep mm_ t in let t_12704 = t in scmd (w-load ((b2-a mm_12702 t_12704))) (λ x_12703 → let mm_12705 = b2-dep mm_12702 x_12703 in let tg = (%wand x_12703 #255) in if (not (%weq tg b2-ALL)) then (kq_ (h4-depl mm_12705 (t))) else (let t_12707 = t in let j_12708 = #1 in scmd (w-load ((b2-a mm_12705 (%wadd t_12707 (%wadd #2 j_12708))))) (λ x_12706 → let mm_12709 = b2-dep mm_12705 x_12706 in let k = x_12706 in let t_12711 = t in let j_12712 = #4 in scmd (w-load ((b2-a mm_12709 (%wadd t_12711 (%wadd #2 j_12712))))) (λ x_12710 → let mm_12713 = b2-dep mm_12709 x_12710 in let vB = x_12710 in b2-Var mm_12713 k d #0 #0 (λ x → let mm_12714 = b2-dep mm_12713 x in b2-body mm_12714 bk vB x (λ t2 → let mm_12715 = b2-dep mm_12714 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_12715 b2-ERR)) else (b2-foreigntip mm_12715 f bk t2 (%wsucc d) kq_))))))))
