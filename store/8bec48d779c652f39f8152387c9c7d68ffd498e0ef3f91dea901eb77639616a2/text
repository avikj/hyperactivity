-- the number of fields (src/hvm.c TERM_ARITY)
h4-arity-tag : Word → Word
h4-arity-tag tg =
  if h4-isctr tg then %wsub tg #13
  else if orB (%weq tg #0) (orB (%weq tg #5) (orB (%weq tg #6) (orB (%weq tg #10) (orB (%weq tg #12) (%weq tg #31))))) then #2
  else if orB (%weq tg #2) (orB (%weq tg #32) (orB (%weq tg #39) (%weq tg #41))) then #1
  else if orB (%weq tg #33) (orB (%weq tg #36) (orB (%weq tg #37) (%weq tg #38))) then #2
  else if orB (%weq tg #34) (%weq tg #35) then #3
  else #0
