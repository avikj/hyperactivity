b2-pushall : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pushall mm_ zero v ks j kq_ =
  kq_ (h4-depl mm_ (#0))
b2-pushall mm_ (suc f) v ks j kq_ =
  let a_1681 = ks in scmd (w-load ((b2-a mm_ a_1681))) (λ x_1680 → let mm_1682 = b2-dep mm_ x_1680 in let n = x_1680 in if (%weq j n) then (kq_ (h4-depl mm_1682 (#0))) else (let a_1684 = ks in let j_1685 = j in scmd (w-load ((b2-a mm_1682 (%wadd a_1684 (%wsucc j_1685))))) (λ x_1683 → let mm_1686 = b2-dep mm_1682 x_1683 in let k = x_1683 in b2-vpush mm_1686 v k (λ dd_1687 → let mm_1688 = b2-dep mm_1686 dd_1687 in b2-pushall mm_1688 f v ks (%wsucc j) kq_))))
