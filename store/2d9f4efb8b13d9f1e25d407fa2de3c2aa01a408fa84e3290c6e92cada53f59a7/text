-- Self-contained zero-import cubical kernel bundled directly inside HyperactivityVisionPro.app:
vph-embedded-kernel : List Word
vph-embedded-kernel =
  sl-ln "-- Embedded in-process cubical kernel for Apple Vision Pro (zero filesystem/store dependency)"
  (sl-ln "data Bool = true | false"
  (sl-ln "vp-tonnetz-P : Word -> Word"
  (sl-ln "vp-tonnetz-P t = %wxor t #1"
  (sl-ln (list-append "vp-thm-p-inv : PathP (" (cons #92 " (i : I) -> Bool) (%weq (vp-tonnetz-P (vp-tonnetz-P #11)) #11) true"))
  (sl-ln (list-append "vp-thm-p-inv = " (cons #92 " i -> true")) nil)))))
