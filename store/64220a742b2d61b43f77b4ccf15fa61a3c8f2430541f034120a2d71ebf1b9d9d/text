-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_8236 = tel in let j_8237 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_8236 (%wsucc j_8237))))) (λ x_8235 → let mm_8238 = b2-dep mm_ x_8235 in let c = x_8235 in let i_8240 = c in scmd (w-load ((b2-a mm_8238 i_8240))) (λ x_8239 → let mm_8241 = b2-dep mm_8238 x_8239 in let q = x_8239 in let i_8243 = (%wadd c #1) in scmd (w-load ((b2-a mm_8241 i_8243))) (λ x_8242 → let mm_8244 = b2-dep mm_8241 x_8242 in let k = x_8242 in let i_8246 = (%wadd c #2) in scmd (w-load ((b2-a mm_8244 i_8246))) (λ x_8245 → let mm_8247 = b2-dep mm_8244 x_8245 in let i = x_8245 in let i_8249 = (%wadd c #3) in scmd (w-load ((b2-a mm_8247 i_8249))) (λ x_8248 → let mm_8250 = b2-dep mm_8247 x_8248 in let vT = x_8248 in let i_8252 = (%wadd c #4) in scmd (w-load ((b2-a mm_8250 i_8252))) (λ x_8251 → let mm_8253 = b2-dep mm_8250 x_8251 in let s = x_8251 in b2-All mm_8253 q k i vT e s (λ a → let mm_8254 = b2-dep mm_8253 a in b2-telebindg mm_8254 f tel (%wsub j #1) a kq_))))))))
