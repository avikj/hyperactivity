qgc-transport-sound : (m1 m2 : List (List BZ)) → m1 ≡ m2 →
  ((vs : List (sy-vn ZrC 7)) → snd (qgc-check 7 m2 (bz-neg bz-one) (bz-of (bin-of-nat 4)) vs) ≡ true →
   1 ≡ fst (qgc-check 7 m2 (bz-neg bz-one) (bz-of (bin-of-nat 4)) vs)) →
  (vs : List (sy-vn ZrC 7)) → snd (qgc-check 7 m1 (bz-neg bz-one) (bz-of (bin-of-nat 4)) vs) ≡ true →
  1 ≡ fst (qgc-check 7 m1 (bz-neg bz-one) (bz-of (bin-of-nat 4)) vs)
qgc-transport-sound m1 m2 eq h = transport (λ i → (vs : List (sy-vn ZrC 7)) →
  snd (qgc-check 7 (eq (~ i)) (bz-neg bz-one) (bz-of (bin-of-nat 4)) vs) ≡ true →
  1 ≡ fst (qgc-check 7 (eq (~ i)) (bz-neg bz-one) (bz-of (bin-of-nat 4)) vs)) h
