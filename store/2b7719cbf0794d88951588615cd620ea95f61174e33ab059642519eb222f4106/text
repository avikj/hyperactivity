emg-diamond-weyl-so-verdict :
  (λ z3 ex ey ez →
    both
      (emg-v3-bz-eq (emg-v3-sum emg-tet-vecs) z3)
      (both
        (emg-all-bz h3d-range1 (λ k1 →
         emg-all-bz h3d-range1 (λ k2 →
         emg-all-bz h3d-range1 (λ k3 →
           emg-v3-bz-eq (emg-weyl-lin (k1 , (k2 , k3)) emg-tet-vecs)
                        (emg-v3-bz-scale (sc-p (bin-pow2 2)) (k1 , (k2 , k3)))))))
        (both
          (emg-v3-bz-eq (emg-so-double ex ey emg-tet-vecs emg-tet-vecs)
                        (emg-v3-bz-scale (sc-p (bin-pow2 4)) (emg-v3-cross BZ bz-add bz-mul bz-neg ex ey)))
          (both
            (emg-v3-bz-eq (emg-so-double ey ez emg-tet-vecs emg-tet-vecs)
                          (emg-v3-bz-scale (sc-p (bin-pow2 4)) (emg-v3-cross BZ bz-add bz-mul bz-neg ey ez)))
            (emg-v3-bz-eq (emg-so-double ez ex emg-tet-vecs emg-tet-vecs)
                          (emg-v3-bz-scale (sc-p (bin-pow2 4)) (emg-v3-cross BZ bz-add bz-mul bz-neg ez ex)))))))
  (bz-zero , (bz-zero , bz-zero))
  (bz-one , (bz-zero , bz-zero))
  (bz-zero , (bz-one , bz-zero))
  (bz-zero , (bz-zero , bz-one)) ≡ true
emg-diamond-weyl-so-verdict = refl
