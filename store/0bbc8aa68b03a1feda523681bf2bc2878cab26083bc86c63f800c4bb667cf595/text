hv2-build-rbag : List (List Word) → List (Hv2Tree × Hv2Tree) → Hv2B → List Word × Hv2B
hv2-build-rbag names nil st = (nil , st)
hv2-build-rbag names (cons rx r) st =
  let x = hv2-build names (fst rx) st
      y = hv2-build names (snd rx) (snd x)
      z = hv2-build-rbag names r (snd y)
  in (cons (hv2-pair (fst x) (fst y)) (fst z) , snd z)
