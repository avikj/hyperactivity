-- Exact U(1) Gauss check on K_3 at all three vertices {0, 1, 2}.
-- When has-matter = true: proton (+1) at v0=0, electron (-1) at v.
-- When has-matter = false: pure gauge vacuum (zero charge at every vertex).
qgm-k3-gauss-at : Bool → Nat → Nat → List BZ → Bool
qgm-k3-gauss-at has-matter x v fs =
  qgm-bz-eq
    (qgm-div BZ bz-zero bz-add bz-neg x qgm-k3-edges fs)
    (if has-matter then qgm-charge BZ bz-zero bz-one bz-add bz-neg x zero v else bz-zero)
