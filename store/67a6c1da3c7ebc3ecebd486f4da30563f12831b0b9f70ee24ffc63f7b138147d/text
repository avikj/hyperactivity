-- THEOREM 2 (UNIVERSAL EXTERIOR-ZERO CANCELLATION ==> GRH FOR ALL ZERO LISTS, 0 POSTULATES!):
-- Mirrors `Ch01/Sec4.lean:12520`: if `exterior-count 1 zeros == 0`, then EVERY zero in `zeros`
-- lies strictly on the critical line Re(rho) = 1/2 (`ms-all-on-line zeros == true`)!
ms-thm-exterior-zero-implies-grh : (zs : List Nat) →
  ms-exterior-count (suc zero) zs ≡ zero →
  ms-all-on-line zs ≡ true
ms-thm-exterior-zero-implies-grh nil _ = refl
ms-thm-exterior-zero-implies-grh (cons zero ds) h =
  ms-thm-exterior-zero-implies-grh ds h
ms-thm-exterior-zero-implies-grh (cons (suc d) ds) h =
  ms-suc-ne-zero h
