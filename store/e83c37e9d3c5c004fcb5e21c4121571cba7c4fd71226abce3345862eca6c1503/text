b2-firstctr : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstctr mm_ zero rs j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-firstctr mm_ (suc f) rs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_5751 = rs in let j_5752 = j in scmd (w-load ((b2-a mm_ (%wadd a_5751 (%wsucc j_5752))))) (λ x_5750 → let mm_5753 = b2-dep mm_ x_5750 in let row = x_5750 in let t_5755 = row in let j_5756 = #0 in scmd (w-load ((b2-a mm_5753 (%wadd t_5755 (%wadd #2 j_5756))))) (λ x_5754 → let mm_5757 = b2-dep mm_5753 x_5754 in let ps = x_5754 in let a_5759 = ps in let j_5760 = #0 in scmd (w-load ((b2-a mm_5757 (%wadd a_5759 (%wsucc j_5760))))) (λ x_5758 → let mm_5761 = b2-dep mm_5757 x_5758 in let p0 = x_5758 in let t_5763 = p0 in scmd (w-load ((b2-a mm_5761 t_5763))) (λ x_5762 → let mm_5764 = b2-dep mm_5761 x_5762 in let tg = (%wand x_5762 #255) in if (%weq tg b2-PCTR) then (kq_ (h4-depl mm_5764 (p0))) else (b2-firstctr mm_5764 f rs (%wsucc j) n kq_))))))
