r4d-bf-rhs-jB : (C : Type) → (Nat → Nat → Nat → Nat) → (Nat → Nat → Nat → Nat → Nat) →
  Nat → R4dFrac → (R4dFrac → C) → C
r4d-bf-rhs-jB C base bndK fuel acc cont = case fuel of
  zero → cont acc
  suc jB →
    (λ tf →
      r4d-bf-rhs-k0 C tf bndK (r4d-tet-ks 0 3 4 5 tf) (r4d-tet-ks 1 3 4 5 tf) (r4d-tet-ks 2 3 4 5 tf)
        r4d-fr-zero (λ sub →
          if r4d-fr-is-zero sub then r4d-bf-rhs-jB C base bndK jB acc cont
          else r4d-force-fr C (r4d-fr-add acc (r4d-fr-mul ((bin-of-nat (suc jB) , nil) , bin-one) sub))
                 (λ acc2 → r4d-bf-rhs-jB C base bndK jB acc2 cont)))
    (r4d-with-fB base jB)
