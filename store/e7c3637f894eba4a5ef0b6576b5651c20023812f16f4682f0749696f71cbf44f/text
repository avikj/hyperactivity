-- read at most m tokens starting at token record offset o directly from the byte index
si-toks-at : (n : Nat) → Bytes n → Nat → Word → List (List Word)
si-toks-at n B zero o = nil
si-toks-at n B (suc m) o =
  if weq (cstr-get n B o) #1 then cons (si-tok n B o) (si-toks-at n B m (si-next n B o)) else nil
