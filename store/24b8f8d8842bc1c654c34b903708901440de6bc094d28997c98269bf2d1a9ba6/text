  in andB (%weq ok5 #5000000)
     (andB (%weq (x4-u6-to-step-quota ok5) #12500000000)
     (andB (%weq repBad #0)
     (andB (%weq revBad #0)
     (andB (%weq tokBad #0)
     (andB (%weq toBad  #0)
           (%weq lowBad #0)))))) ≡ true
