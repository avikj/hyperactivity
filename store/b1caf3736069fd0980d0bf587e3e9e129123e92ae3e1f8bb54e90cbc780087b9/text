b2-name : Word → Word → (Word → Step W Word) → Step W Word
b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_7065 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_7065 b2-ERR)) else (b2-iskw mm_7065 k (λ kw → let mm_7066 = b2-dpb mm_7065 kw in if (kw) then (b2-nbytes mm_7066 k (λ kb → let mm_7067 = b2-dpl mm_7066 kb in let p_7069 = p in let i_7071 = (%wadd p_7069 #1) in scmd (w-load ((b2-a mm_7067 i_7071))) (λ x_7070 → let mm_7072 = b2-dep mm_7067 x_7070 in let x_7068 = x_7070 in let i = x_7068 in let p_7074 = p in let i_7076 = (%wadd p_7074 #1) in scmd (w-load ((b2-a mm_7072 i_7076))) (λ x_7075 → let mm_7077 = b2-dep mm_7072 x_7075 in let x_7073 = x_7075 in let ixq = x_7073 in b2-pfail mm_7077 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_7078 = b2-dep mm_7077 r in kq_ (h4-depl mm_7078 (r))))))) else (kq_ (h4-depl mm_7066 (k))))))
