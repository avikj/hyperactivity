-- Section (1): Universal Zero-Division Rump-Gershgorin Cholesky Positive-Definiteness Theorem.
ScRing : (A : Type) → A → (A → A → A) → (A → A → A) → (A → A) → Type
ScRing A z add mul neg =
  ((x : A) → add z x ≡ x) ×
  (((x : A) → add x z ≡ x) ×
  (((x y w : A) → add (add x y) w ≡ add x (add y w)) ×
  (((x y : A) → add x y ≡ add y x) ×
  (((x : A) → add x (neg x) ≡ z) ×
  (((x y w : A) → mul (mul x y) w ≡ mul x (mul y w)) ×
  (((x y : A) → mul x y ≡ mul y x) ×
  (((x y w : A) → mul x (add y w) ≡ add (mul x y) (mul x w)) ×
  (((x y w : A) → mul (add x y) w ≡ add (mul x w) (mul y w)) ×
  (((x y : A) → mul (neg x) y ≡ neg (mul x y)) ×
  (((x y : A) → mul x (neg y) ≡ neg (mul x y)) ×
  ((x : A) → neg (neg x) ≡ x)))))))))))
