  if (%weq i #0) then (kq_ (h4-depl mm_ (#0))) else (let a_7351 = s in let j_7352 = (%wsub i #1) in scmd (w-load ((b2-a mm_ (%wadd a_7351 (%wsucc j_7352))))) (λ x_7350 → let mm_7353 = b2-dep mm_ x_7350 in let c = x_7350 in if (%weq c #10) then (kq_ (h4-depl mm_7353 (i))) else (b2-linestart mm_7353 f s (%wsub i #1) kq_)))
