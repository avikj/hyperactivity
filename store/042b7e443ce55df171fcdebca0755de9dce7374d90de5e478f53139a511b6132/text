-- mode 0: the uses in the term t; mode 1: in the fields at loc, from i to n
h4-cu : Word → Nat → Word → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-cu mm_ zero md t loc i n lvl tgt ext kq_ =
  kq_ (h4-depl mm_ (#0))
h4-cu mm_ (suc f) md t loc i n lvl tgt ext kq_ =
  if (%weq md #0) then (if (h4-istgt t lvl tgt ext) then (kq_ (h4-depl mm_ (#1))) else (h4-cu mm_ f #1 #0 (h4-val t) #0 (h4-arity t) lvl tgt ext kq_)) else (if (not (%wlt i n)) then (kq_ (h4-depl mm_ (#0))) else (h4-rd mm_ (%wadd loc i) (λ c → let mm_40 = h4-dep mm_ c in h4-cu mm_40 f #0 c #0 #0 #0 lvl tgt ext (λ a → let mm_41 = h4-dep mm_40 a in h4-cu mm_41 f #1 #0 loc (%wsucc i) n lvl tgt ext (λ b → let mm_42 = h4-dep mm_41 b in kq_ (h4-depl mm_42 ((%wadd a b))))))))
