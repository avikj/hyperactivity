boc-minterm64 : Word → Word → Word → Word → Word → Word
boc-minterm64 imm m a b c =
  if %weq (%wand (%wshr imm m) #1) #0 then #0
  else
    let ma = if %weq (%wand (%wshr m #2) #1) #1 then a else boc-not64 a
        mb = if %weq (%wand (%wshr m #1) #1) #1 then b else boc-not64 b
        mc = if %weq (%wand m #1) #1            then c else boc-not64 c
    in %wand ma (%wand mb mc)
