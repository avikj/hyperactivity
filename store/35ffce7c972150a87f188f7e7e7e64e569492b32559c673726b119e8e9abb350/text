-- the base's events marked b
b2-markbase : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13711 = bk in let j_13712 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13711 (%wadd #2 j_13712))))) (λ x_13710 → let mm_13713 = b2-dep mm_ x_13710 in let ov = x_13710 in let v_13716 = ov in let j_13717 = j in scmd (w-load ((b2-a mm_13713 (%wadd v_13716 #2)))) (λ d_13715 → let mm_13718 = b2-dep mm_13713 d_13715 in scmd (w-load ((b2-a mm_13718 (%wadd d_13715 (%wsucc j_13717))))) (λ x_13714 → let mm_13719 = b2-dep mm_13718 x_13714 in let k = x_13714 in b2-tld mm_13719 bk k (λ t → let mm_13720 = b2-dep mm_13719 t in let t_13722 = t in scmd (w-load ((b2-a mm_13720 t_13722))) (λ x_13721 → let mm_13723 = b2-dep mm_13720 x_13721 in let tg = (%wand x_13721 #255) in let t_13724 = t in let j_13725 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13726 = #1 in scmd (w-store ((b2-a mm_13723 (%wadd t_13724 (%wadd #2 j_13725)))) (v_13726)) (λ uu_13727 → let mm_13728 = hv2-u mm_13723 uu_13727 in b2-markbase mm_13728 f bk (%wsucc j) n kq_)))))))
