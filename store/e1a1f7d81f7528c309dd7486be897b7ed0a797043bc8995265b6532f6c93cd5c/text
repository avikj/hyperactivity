sfc-bf-bwt : (Nat × (Nat × (Nat × Nat))) → BQ
sfc-bf-bwt st =
  bq-mul (sf-bq-of-nat (times (times (suc (fst st)) (suc (fst (snd st))))
                              (times (suc (fst (snd (snd st)))) (suc (snd (snd (snd st)))))))
    (bq-mul (bq-mul (bq-mul (sf-delta2 1 1 (fst st)) (sf-delta2 1 1 (fst st)))
                    (bq-mul (sf-delta2 1 1 (fst (snd st))) (sf-delta2 1 1 (fst (snd st)))))
            (bq-mul (bq-mul (sf-delta2 1 1 (fst (snd (snd st)))) (sf-delta2 1 1 (fst (snd (snd st)))))
                    (bq-mul (sf-delta2 1 1 (snd (snd (snd st)))) (sf-delta2 1 1 (snd (snd (snd st)))))))
