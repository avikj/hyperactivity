  function drawChipCanvas(tt, gates, prog, ok, label) {
    var c = document.getElementById('chip-canvas');
    if (!c) return;
    var w = c.clientWidth || 720, h = 210;
    c.width = w * 2; c.height = h * 2;
    var ctx = c.getContext('2d');
    ctx.setTransform(2, 0, 0, 2, 0, 0);
    ctx.fillStyle = '#000'; ctx.fillRect(0, 0, w, h);

    var list = unpackGates(prog, gates);
    var pos = {
      0: { x: 48, y: 44, lbl: 'w0 (a)' },
      1: { x: 48, y: 102, lbl: 'w1 (b)' },
      2: { x: 48, y: 160, lbl: 'w2 (c)' }
    };
    var usableW = Math.max(240, w - 210);
    list.forEach(function(gt, idx) {
      var x = 148 + (list.length === 1 ? usableW * 0.45 : (idx * (usableW / Math.max(1, list.length - 1)) * 0.85));
      var y = 48 + ((idx % 3) * 52);
      pos[gt.out] = { x: x, y: y, lbl: 'w' + gt.out };
    });

    // Draw CMOS7 FinFET substrate grid subtly
    ctx.strokeStyle = 'rgba(255,255,255,0.06)'; ctx.lineWidth = 1;
    for (var gx = 0; gx < w; gx += 24) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke(); }
    for (var gy = 0; gy < h; gy += 24) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke(); }

    // Draw wires
    list.forEach(function(gt) {
      var dst = pos[gt.out];
      [gt.i, gt.j].forEach(function(srcId, slot) {
        var src = pos[srcId] || pos[0];
        ctx.strokeStyle = ok ? '#ff0a94' : '#d93025';
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(src.x + 18, src.y);
        var mx = (src.x + dst.x) * 0.5;
        ctx.bezierCurveTo(mx, src.y, mx, dst.y + (slot ? 6 : -6), dst.x - 22, dst.y + (slot ? 6 : -6));
        ctx.stroke();
      });
    });

    // Draw input pins
    [0, 1, 2].forEach(function(id) {
      var p = pos[id];
      ctx.fillStyle = '#fff';
      ctx.beginPath(); ctx.arc(p.x + 14, p.y, 4, 0, Math.PI * 2); ctx.fill();
      ctx.font = '600 10.5px ui-monospace, monospace';
      ctx.fillText(p.lbl, 10, p.y + 4);
    });

    // Draw NAND2 gates + FinFET cells (4 transistors per NAND2)
    list.forEach(function(gt, idx) {
      var p = pos[gt.out];
      var isOut = idx === list.length - 1;
      ctx.fillStyle = isOut ? (ok ? '#ff0a94' : '#d93025') : '#121216';
      ctx.strokeStyle = ok ? '#ff0a94' : '#d93025';
      ctx.lineWidth = 1.5;
      ctx.fillRect(p.x - 22, p.y - 14, 44, 28);
      ctx.strokeRect(p.x - 22, p.y - 14, 44, 28);
      ctx.fillStyle = '#fff';
      ctx.font = '700 9.5px ui-monospace, monospace';
      ctx.fillText('NAND2', p.x - 16, p.y - 1);
      ctx.font = '500 9px ui-monospace, monospace';
      ctx.fillStyle = isOut ? '#fff' : 'rgba(255,255,255,0.7)';
      ctx.fillText('w' + gt.out + (isOut ? ' OUT' : ''), p.x - 15, p.y + 10);
    });

    // Footer metadata bar
    ctx.fillStyle = ok ? '#ff0a94' : '#d93025';
    ctx.font = '700 10.5px ui-monospace, monospace';
