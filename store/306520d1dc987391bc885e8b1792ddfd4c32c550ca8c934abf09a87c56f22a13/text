        </g>
        </a>

        <a href="/learn" style="text-decoration:none">
        <g class="hg-node" data-id="learn" role="link" tabindex="0">
          <rect x="232" y="16" width="210" height="52" />
          <text class="n-k" x="244" y="34">01 · FOUNDATIONS</text>
          <text class="n-t" x="244" y="53">First Principles</text>
        </g>
        </a>
        <a href="/hyperfactor" style="text-decoration:none">
        <g class="hg-node" data-id="hyperfactor" role="link" tabindex="0">
          <rect x="232" y="92" width="210" height="52" />
