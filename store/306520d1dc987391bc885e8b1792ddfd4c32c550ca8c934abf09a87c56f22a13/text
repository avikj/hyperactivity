  // Exact bit-parallel mirror of lib/hx-synth.hypercubical hs-id for 5-6 gate circuits (verified via refl in /cubical.wasm!)
  function jsExactNand2Synth(target, maxd) {
    var nodes = 0;
    function dfs(d, bank, nw, shift, prog) {
      if (d === 1) {
        var last = nw - 1, wl = bank[last];
        for (var i = 0; i < nw; i++) {
          nodes++;
          if (((~(bank[i] & wl)) & 255) === target) {
            return prog + BigInt((i << 3) | last) * (1n << BigInt(shift));
          }
        }
        return null;
      }
      for (var i = 0; i < nw; i++) {
        var wi = bank[i];
        for (var j = i; j < nw; j++) {
          nodes++;
          var t = (~(wi & bank[j])) & 255;
          if (t === 0 || t === 255 || bank.indexOf(t) !== -1) continue;
          bank.push(t);
          var hit = dfs(d - 1, bank, nw + 1, shift + 6, prog + BigInt((i << 3) | j) * (1n << BigInt(shift)));
          bank.pop();
          if (hit !== null) return hit;
        }
      }
      return null;
    }
    var init = [170, 204, 240];
    if (init.indexOf(target) !== -1) return { gates: 0, prog: 0, nodes: 1 };
    for (var d = 1; d <= maxd; d++) {
      var res = dfs(d, init.slice(), 3, 0, 0n);
      if (res !== null) return { gates: d, prog: Number(res), nodes: nodes };
    }
    return null;
  }

  document.querySelectorAll('.chip-presets .chip-btn').forEach(function(b) {
    b.addEventListener('click', function() {
      document.querySelectorAll('.chip-presets .chip-btn').forEach(function(x) { x.classList.remove('on'); });
      b.classList.add('on');
      var tt = parseInt(b.getAttribute('data-tt'), 10);
      var md = parseInt(b.getAttribute('data-maxd'), 10) || 4;
      document.getElementById('chip-tt').value = tt;
      runWasmChipSynth(tt, md, b.getAttribute('data-name') || ('tt=' + tt));
    });
  });

  document.getElementById('chip-run').addEventListener('click', function() {
    var tt = Math.max(0, Math.min(255, parseInt(document.getElementById('chip-tt').value, 10) || 0));
    var pre = PRESET_WIT[tt];
    runWasmChipSynth(tt, pre ? (pre.g > 4 ? 6 : pre.g) : 6, pre ? pre.label : ('Custom tt=' + tt));
  });

  document.getElementById('chip-tamper').addEventListener('click', async function() {
    var logEl = document.getElementById('chip-log');
    if (!window.hxView || !window.hxView.evalCubical) return;
    var forged = lastChip.prog ^ 1;
    logEl.className = 'chip-log';
    logEl.textContent = 'Flipping 1 bit in gate netlist (#' + lastChip.prog + ' → #' + forged + ') and asking /cubical.wasm to check `refl`…';
    var badCode = [
      'import "lib/hx-synth.hypercubical"',
      'forged-chip-proof : hs-verify #' + lastChip.tt + ' #' + forged + ' (toNat #' + lastChip.gates + ') ≡ true',
      'forged-chip-proof = refl'
    ].join('\n');
    var r = await window.hxView.evalCubical(badCode);
    drawChipCanvas(lastChip.tt, lastChip.gates, forged, r.ok, lastChip.name + ' [1-BIT FORGED]');
    logEl.className = r.ok ? 'chip-log' : 'chip-log err';
    logEl.textContent =
      (!r.ok ? '✓ 1-BIT FORGED CIRCUIT REJECTED BY /cubical.wasm (' + r.ms + 'ms · ' + r.steps + ' steps)!\n' : '⚠ unexpected accept\n') +
      'Mutated witness: #' + lastChip.prog + ' → #' + forged + ' (1 wire bit flipped)\n' +
      'Kernel verdict: ' + (r.output || 'type mismatch: false ≠ true');
  });

  document.getElementById('chip-src').addEventListener('click', function() {
    if (window.hxView && window.hxView.inspect) window.hxView.inspect('lib/hx-synth.hypercubical', null, null);
  });

  // Draw initial canonical 4-gate XOR2 witness immediately on load
  drawChipCanvas(102, 4, 9744577, true, 'XOR2 (a ⊕ b)');
})();
</script>
</body>
