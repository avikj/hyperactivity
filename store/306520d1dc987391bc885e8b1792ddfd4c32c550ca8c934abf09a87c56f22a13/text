    if (r.ok && parsed && parsed.gates > 0) {
      lastChip = { tt: tt, gates: parsed.gates, prog: parsed.prog, name: name };
      drawChipCanvas(tt, parsed.gates, parsed.prog, true, name);
      var netStr2 = unpackGates(parsed.prog, parsed.gates).map(function(g) { return 'w' + g.out + '=NAND(w' + g.i + ',w' + g.j + ')'; }).join('  ');
      logEl.textContent =
        '✓ EXACT OPTIMAL ' + parsed.gates + '-NAND2 CIRCUIT SYNTHESIZED DIRECTLY INSIDE /cubical.wasm (' + r.ms + 'ms · ' + r.steps + ' steps · ' + parsed.nodes + ' states)\n' +
        'Netlist (' + (parsed.gates * 4) + ' CMOS7 FinFETs): ' + netStr2 + '\n' +
        'Packed PoUW witness: #' + parsed.prog + ' (click "Flip 1 Gate Bit" to watch /cubical.wasm reject a 1-bit forgery!)';
