      drawChipCanvas(tt, found.gates, found.prog, vr.ok, name);
      var netStr = unpackGates(found.prog, found.gates).map(function(g) { return 'w' + g.out + '=NAND(w' + g.i + ',w' + g.j + ')'; }).join('  ');
      logEl.className = vr.ok ? 'chip-log' : 'chip-log err';
      logEl.textContent =
        (vr.ok ? '✓ OPTIMAL ' + found.gates + '-NAND2 CIRCUIT SYNTHESIZED & PROVED (`refl`) IN /cubical.wasm' : '✗ KERNEL REJECTED') +
        ' (' + vr.ms + 'ms · ' + vr.steps + ' kernel steps · ' + found.nodes.toLocaleString() + ' search states)\n' +
        'Netlist (' + (found.gates * 4) + ' CMOS7 FinFETs): ' + netStr + '\n' +
        'Witness: hs-verify #' + tt + ' #' + found.prog + ' (toNat #' + found.gates + ') ≡ true';
      return;
    }

    var r = await window.hxView.evalCubical(code);
