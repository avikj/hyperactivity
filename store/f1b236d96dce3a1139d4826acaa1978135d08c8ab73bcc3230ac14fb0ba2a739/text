emg-k4-hop-1e : Nat → List BZ → Nat → List BZ → BZ
emg-k4-hop-1e u fa w fb =
  if eqb u w then bz-zero
  else
    bz-add
      (bz-add (emg-edge-hop-1e 0 0 1 u fa w fb)
              (bz-add (emg-edge-hop-1e 1 0 2 u fa w fb) (emg-edge-hop-1e 2 0 3 u fa w fb)))
      (bz-add (emg-edge-hop-1e 3 1 2 u fa w fb)
              (bz-add (emg-edge-hop-1e 4 2 3 u fa w fb) (emg-edge-hop-1e 5 3 1 u fa w fb)))
