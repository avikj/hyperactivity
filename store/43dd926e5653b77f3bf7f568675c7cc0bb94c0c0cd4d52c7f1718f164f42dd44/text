-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10558 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10558))) (λ x_10557 → let mm_10559 = b2-dep mm_ x_10557 in let lb = x_10557 in if (%weq lb #0) then (let i_10561 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10559 i_10561))) (λ x_10560 → let mm_10562 = b2-dep mm_10559 x_10560 in let t = x_10560 in kq_ (h4-depl mm_10562 (t)))) else (let i_10564 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10559 i_10564))) (λ x_10563 → let mm_10565 = b2-dep mm_10559 x_10563 in let lx = x_10563 in b2-body mm_10565 bk lb lx (λ r → let mm_10566 = b2-dep mm_10565 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10566 b2-ERR)) else (kq_ (h4-depl mm_10566 (r)))))))
