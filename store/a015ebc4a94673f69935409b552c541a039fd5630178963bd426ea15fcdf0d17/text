b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6897 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6897 (k))) else (b2-nbytes mm_6897 ns (λ nb → let mm_6898 = b2-dpl mm_6897 nb in b2-nbytes mm_6898 k (λ kb → let mm_6899 = b2-dpl mm_6898 kb in b2-nm mm_6899 (list-append nb (cons #58 kb)) (λ r → let mm_6900 = b2-dep mm_6899 r in kq_ (h4-depl mm_6900 (r)))))))
