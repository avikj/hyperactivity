-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_11130 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_11130))) (λ x_11129 → let mm_11131 = b2-dep mm_ x_11129 in let lb = x_11129 in if (%weq lb #0) then (let i_11133 = (%wadd tc #4) in scmd (w-load ((b2-a mm_11131 i_11133))) (λ x_11132 → let mm_11134 = b2-dep mm_11131 x_11132 in let t = x_11132 in kq_ (h4-depl mm_11134 (t)))) else (let i_11136 = (%wadd tc #3) in scmd (w-load ((b2-a mm_11131 i_11136))) (λ x_11135 → let mm_11137 = b2-dep mm_11131 x_11135 in let lx = x_11135 in b2-body mm_11137 bk lb lx (λ r → let mm_11138 = b2-dep mm_11137 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_11138 b2-ERR)) else (kq_ (h4-depl mm_11138 (r)))))))
