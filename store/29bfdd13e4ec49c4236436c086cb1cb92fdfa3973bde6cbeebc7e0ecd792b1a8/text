b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_7207 = b2-dep mm_ c in let p_7209 = p in let i_7211 = (%wadd p_7209 #1) in scmd (w-load ((b2-a mm_7207 i_7211))) (λ x_7210 → let mm_7212 = b2-dep mm_7207 x_7210 in let x_7208 = x_7210 in let i = x_7208 in let p_7213 = p in let v_7214 = (%wsucc i) in let i_7215 = (%wadd p_7213 #1) in let v_7216 = v_7214 in scmd (w-store ((b2-a mm_7212 i_7215)) (v_7216)) (λ uu_7217 → let mm_7218 = hv2-u mm_7212 uu_7217 in kq_ (h4-depl mm_7218 (c)))))
