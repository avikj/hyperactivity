-- Exact binary integer square root: largest x with x^2 <= n, by bit-by-bit bisection from MSB.
qg-isqrt-bits : Nat → Nat → List Bool → List Bool → List Bool
qg-isqrt-bits f b n x = case f of
  zero → x
  suc g → qg-isqrt-bits g (monus b (suc zero)) n
    (if bin-leb (bin-mul (bin-add x (bin-pow2 b)) (bin-add x (bin-pow2 b))) n
     then bin-add x (bin-pow2 b) else x)
