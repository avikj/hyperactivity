h4-natc : Word → Nat → Word → Word → (Word × Word → Step W Word) → Step W Word
h4-natc m zero t n k =
  k (h4-depl m ((n , t)))
h4-natc m (suc f) t n k =
  if (andB (%weq (h4-tag t) h4-C01) (%weq (h4-ext t) h4-SUC)) then (scmd (w-load ((h4-ha m (h4-val t)))) (λ x → let m2796 = h4-dep m x in h4-natc m2796 f x (%wsucc n) k)) else (k (h4-depl m ((n , t))))
