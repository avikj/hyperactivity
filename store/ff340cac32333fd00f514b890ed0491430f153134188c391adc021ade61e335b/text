-- THEOREM 2A (Universal Constant-Booster 3-3 Invariance):
grv-const-booster-33 : (A : Type) → (z one : A) → (add mul : A → A → A) → (neg : A → A) →
  LorRing A z one add mul neg →
  (g w1 w3 u1 u3 : A) → add w1 w3 ≡ add u1 u3 →
  add (mul g w1) (mul g w3) ≡ add (mul g u1) (mul g u3)
grv-const-booster-33 A z one add mul neg r g w1 w3 u1 u3 hbf =
  lor-tr A
    (add (mul g w1) (mul g w3))
    (mul g (add w1 w3))
    (add (mul g u1) (mul g u3))
    (sym (r4d-ldist A z one add mul neg r g w1 w3))
    (concat (cong (λ t → mul g t) hbf) (r4d-ldist A z one add mul neg r g u1 u3))
