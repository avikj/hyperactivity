-- there and back is the start; once round, the electron is at the nucleus again with one unit on every line
cv-round : (if cv-same (snd (cv-walk ring6 (cons (0 , true) (cons (0 , false) nil)) (cv-start ring6))) (cv-zero ring6)
  then (if eqb (fst (cv-walk ring6 (cv-fwd 6 0) (cv-start ring6))) 0 then eqb (cv-energy (snd (cv-walk ring6 (cv-fwd 6 0) (cv-start ring6)))) 6 else false)
  else false) ≡ true
cv-round = λ i → true
