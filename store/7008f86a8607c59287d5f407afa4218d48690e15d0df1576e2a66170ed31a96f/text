b2-rshow : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-rshow mm_ zero file rs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-rshow mm_ (suc f) file rs j acc kq_ =
  let a_1298 = rs in scmd (w-load ((b2-a mm_ a_1298))) (λ x_1297 → let mm_1299 = b2-dep mm_ x_1297 in let n = x_1297 in if (%weq j n) then (kq_ (h4-depl mm_1299 (acc))) else (let a_1301 = rs in let j_1302 = j in scmd (w-load ((b2-a mm_1299 (%wadd a_1301 (%wsucc j_1302))))) (λ x_1300 → let mm_1303 = b2-dep mm_1299 x_1300 in let k = x_1300 in b2-nameshow mm_1303 file k (λ s → let mm_1304 = b2-dpl mm_1303 s in b2-rshow mm_1304 f file rs (%wsucc j) (list-append acc (list-append " - " (list-append s "{}"))) kq_))))
