b2-stklen : Word → Word → (Word → Step W Word) → Step W Word
b2-stklen mm_ p kq_ =
  let i_6800 = (%wadd p #4) in scmd (w-load ((b2-a mm_ i_6800))) (λ x_6799 → let mm_6801 = b2-dep mm_ x_6799 in let stk = x_6799 in let v_6803 = stk in scmd (w-load ((b2-a mm_6801 v_6803))) (λ x_6802 → let mm_6804 = b2-dep mm_6801 x_6802 in let l = x_6802 in kq_ (h4-depl mm_6804 (l))))
