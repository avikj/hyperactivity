-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10113 = s in let j_10114 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_10113 (%wadd #2 j_10114))))) (λ x_10112 → let mm_10115 = b2-dep mm_ x_10112 in let fl = x_10112 in kq_ (h4-depl mm_10115 (fl))))
