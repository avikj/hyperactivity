  b2-lexeme mm_ p (λ k → let mm_7191 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_7191 b2-ERR)) else (b2-iskw mm_7191 k (λ kw → let mm_7192 = b2-dpb mm_7191 kw in if (kw) then (b2-nbytes mm_7192 k (λ kb → let mm_7193 = b2-dpl mm_7192 kb in let p_7195 = p in let i_7197 = (%wadd p_7195 #1) in scmd (w-load ((b2-a mm_7193 i_7197))) (λ x_7196 → let mm_7198 = b2-dep mm_7193 x_7196 in let x_7194 = x_7196 in let i = x_7194 in let p_7200 = p in let i_7202 = (%wadd p_7200 #1) in scmd (w-load ((b2-a mm_7198 i_7202))) (λ x_7201 → let mm_7203 = b2-dep mm_7198 x_7201 in let x_7199 = x_7201 in let ixq = x_7199 in b2-pfail mm_7203 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_7204 = b2-dep mm_7203 r in kq_ (h4-depl mm_7204 (r))))))) else (kq_ (h4-depl mm_7192 (k))))))
