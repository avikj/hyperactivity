b2-pterms : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pterms mm_ zero xs ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-pterms mm_ (suc f) xs ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_5780 = xs in let j_5781 = j in scmd (w-load ((b2-a mm_ (%wadd a_5780 (%wsucc j_5781))))) (λ x_5779 → let mm_5782 = b2-dep mm_ x_5779 in let x = x_5779 in b2-pterm mm_5782 x #0 (λ t → let mm_5783 = b2-dep mm_5782 t in let a_5784 = ob in let j_5785 = j in let v_5786 = t in scmd (w-store ((b2-a mm_5783 (%wadd a_5784 (%wsucc j_5785)))) (v_5786)) (λ uu_5787 → let mm_5788 = hv2-u mm_5783 uu_5787 in b2-pterms mm_5788 f xs ob (%wsucc j) n kq_))))
