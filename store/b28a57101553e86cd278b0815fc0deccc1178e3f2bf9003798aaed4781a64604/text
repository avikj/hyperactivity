geo-main : List (List Word) → Step W Word
geo-main args =
  let p   = geo-pref args
      cf  = list-append p "_beast.c"
      mf  = list-append p "_gpu.metal"
      mhf = list-append p "_gpu_host.m"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf  gir-beast-c11)        (λ bc →
     scmd (w-file-write-named mf  gir-metal-shader)     (λ bm →
     scmd (w-file-write-named mhf gir-beast-metal-host) (λ bh →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-GEODESIC (41st Engine — Zero-Bias Geodesic Inference + Homeomorphic Cryptic Gauge + Swarm Beast) | ExclZero=Proved | TelescopingGauge=Proved | LUT4_512=Proved | ZeroInternalWarrant=Proved | C11="
       (list-append (ce-dec bc)
       (list-append "B Metal="
       (list-append (ce-dec bm)
       (list-append "B Host="
       (list-append (ce-dec bh)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))))))
       (sdone #0))))))
