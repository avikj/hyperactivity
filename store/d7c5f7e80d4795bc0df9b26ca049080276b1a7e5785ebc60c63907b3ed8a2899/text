b2-pushk : Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pushk mm_ bk k x kq_ =
  b2-tapp mm_ bk k x #0 (λ t → let mm_15608 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_15608 b2-ERR)) else (b2-push mm_15608 t #0 (λ dd_15609 → let mm_15610 = b2-dep mm_15608 dd_15609 in kq_ (h4-depl mm_15610 (#0)))))
