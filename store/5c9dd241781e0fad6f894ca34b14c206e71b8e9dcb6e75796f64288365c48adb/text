  bind (h-mkdir "/tmp/hy_out") (λ _ →
  bind (h-mkdir dir) (λ _ →
  bind (h-write (list-append dir "/hyperos_boot.S") hyperos-boot-asm) (λ _ →
  bind (h-write (list-append dir "/hyperos.ld") hyperos-ld-script) (λ _ →
  bind (h-write (list-append dir "/hyperos_kernel.c") hyperos-kernel-c) (λ _ →
  bind (h-write (list-append dir "/hyperfactor_bench.c") hyperfactor-bench-c) (λ _ →
  bind (h-write (list-append dir "/hyperos_boot_arm64.S") hyperos-arm64-boot-asm) (λ _ →
  bind (h-write (list-append dir "/hyperos_arm64.ld") hyperos-arm64-ld) (λ _ →
  bind (h-write (list-append dir "/hyperos_kernel_arm64.c") hyperos-arm64-kernel-c) (λ _ →
  bind (h-write (list-append dir "/hx_arm64_mkimg.c") hyperos-arm64-mkimg-c) (λ _ →
  bind (h-write (list-append dir "/hx_hypernet_mesh.c") hypernet-mesh-c) (λ _ →
  bind (h-write (list-append dir "/hyperos_vz_macos.swift") hyperos-vz-swift) (λ _ →
  bind (h-write (list-append dir "/hyperos_vz.entitlements") hyperos-vz-entitlements) (λ _ →
  bind (h-write (list-append dir "/boot_m1n1_apple_silicon.sh") hyperos-m1n1-sh) (λ _ →
  bind (h-write (list-append dir "/hx_oneclick_deploy.sh") hyperos-deploy-sh) (λ _ →
