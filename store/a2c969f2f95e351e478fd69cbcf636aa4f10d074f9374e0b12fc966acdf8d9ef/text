h4-normouter : Word → Nat → Nat → Nat → Word → (Word → Step W Word) → Step W Word
h4-normouter mm_ zero fu fb sl kq_ =
  h4-rterr mm_ "normalize: out of steps" kq_
h4-normouter mm_ (suc n) fu fb sl kq_ =
  h4-normloop mm_ fu fu fb sl (λ r → let mm_2753 = h4-dep mm_ r in if (%wlt r #1099511627776) then (kq_ (h4-depl mm_2753 (r))) else (h4-normouter mm_2753 n fu fb (%wsub r #1099511627776) kq_))
