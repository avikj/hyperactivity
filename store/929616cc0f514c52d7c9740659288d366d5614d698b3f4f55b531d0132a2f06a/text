b2-namelen : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-namelen mm_ zero s i n kq_ =
  kq_ (h4-depl mm_ (i))
b2-namelen mm_ (suc f) s i n kq_ =
  if (not (%wlt i n)) then (kq_ (h4-depl mm_ (i))) else (let a_6601 = s in let j_6602 = i in scmd (w-load ((b2-a mm_ (%wadd a_6601 (%wsucc j_6602))))) (λ x_6600 → let mm_6603 = b2-dep mm_ x_6600 in let c = x_6600 in if (b2-ischar c) then (b2-namelen mm_6603 f s (%wsucc i) n kq_) else (kq_ (h4-depl mm_6603 (i)))))
