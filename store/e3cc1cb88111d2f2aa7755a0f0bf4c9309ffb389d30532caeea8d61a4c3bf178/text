sf-be-loop : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ → BQ
sf-be-loop fuel a b c d e f p q r acc = case fuel of
  zero → acc
  suc x → sf-be-loop x a b c d e f p q r
    (if both (both (tri-ok a b x) (tri-ok c d x)) (tri-ok e f x)
     then bq-add acc (sf-be-term a b c d e f p q r x)
     else acc)
