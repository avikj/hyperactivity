-- an argument an intrinsic may read: a literal or a constructor (anything else is stuck, and
-- the definition's own match decides, as it would without the intrinsic)
-- an intrinsic's argument as it stands: a computed cell's value, 0 for a cell not yet
-- evaluated, anything else itself
b2-ipeek : Word → Word → (Word → Step W Word) → Step W Word
b2-ipeek mm_ x kq_ =
  let t_2620 = x in scmd (w-load ((b2-a mm_ t_2620))) (λ x_2619 → let mm_2621 = b2-dep mm_ x_2619 in let tg = (%wand x_2619 #255) in let t_2623 = x in let j_2624 = #1 in scmd (w-load ((b2-a mm_2621 (%wadd t_2623 (%wadd #2 j_2624))))) (λ x_2622 → let mm_2625 = b2-dep mm_2621 x_2622 in let i = x_2622 in if (andB (%weq tg b2-VAR) (%weq i b2-M1)) then (kq_ (h4-depl mm_2625 (#0))) else (b2-strip mm_2625 x (λ r → let mm_2626 = b2-dep mm_2625 r in kq_ (h4-depl mm_2626 (r))))))
