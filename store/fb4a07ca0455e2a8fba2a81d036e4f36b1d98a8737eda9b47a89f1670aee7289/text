b2-foreigntip : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-foreigntip mm_ zero bk tel d kq_ =
  kq_ (h4-depl mm_ (tel))
b2-foreigntip mm_ (suc f) bk tel d kq_ =
  b2-strip mm_ tel (λ t → let mm_12456 = b2-dep mm_ t in let t_12458 = t in scmd (w-load ((b2-a mm_12456 t_12458))) (λ x_12457 → let mm_12459 = b2-dep mm_12456 x_12457 in let tg = (%wand x_12457 #255) in if (not (%weq tg b2-ALL)) then (kq_ (h4-depl mm_12459 (t))) else (let t_12461 = t in let j_12462 = #1 in scmd (w-load ((b2-a mm_12459 (%wadd t_12461 (%wadd #2 j_12462))))) (λ x_12460 → let mm_12463 = b2-dep mm_12459 x_12460 in let k = x_12460 in let t_12465 = t in let j_12466 = #4 in scmd (w-load ((b2-a mm_12463 (%wadd t_12465 (%wadd #2 j_12466))))) (λ x_12464 → let mm_12467 = b2-dep mm_12463 x_12464 in let vB = x_12464 in b2-Var mm_12467 k d #0 #0 (λ x → let mm_12468 = b2-dep mm_12467 x in b2-body mm_12468 bk vB x (λ t2 → let mm_12469 = b2-dep mm_12468 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_12469 b2-ERR)) else (b2-foreigntip mm_12469 f bk t2 (%wsucc d) kq_))))))))
