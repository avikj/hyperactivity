-- a code point as UTF-8
e-utf8 : Word → List Word
e-utf8 n = if wlt n #128 then cons n nil
  else if wlt n #2048 then cons (wor #192 (wshr n #6)) (cons (wor #128 (wand n #63)) nil)
  else if wlt n #65536 then cons (wor #224 (wshr n #12)) (cons (wor #128 (wand (wshr n #6) #63)) (cons (wor #128 (wand n #63)) nil))
  else cons (wor #240 (wshr n #18)) (cons (wor #128 (wand (wshr n #12) #63)) (cons (wor #128 (wand (wshr n #6) #63)) (cons (wor #128 (wand n #63)) nil)))
