hd-gpu-host-src : List Word → List Word
hd-gpu-host-src mpath =
  hd-ln "#import <Foundation/Foundation.h>"
  (hd-ln "#import <Metal/Metal.h>"
  (hd-ln "#include <stdio.h>"
  (hd-ln "#include <stdint.h>"
  (hd-ln "#include <time.h>"
  (hd-ln "typedef struct { uint32_t n_targets, base_seed, iters_per_thread; } DiscParams;"
  (hd-ln "static double now_ms(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec * 1e3 + ts.tv_nsec * 1e-6; }"
  (hd-ln "static int verify_4in(uint32_t ng, uint64_t prog, uint16_t tgt) {"
  (hd-ln "  uint16_t w[14]; w[0]=0xAAAA; w[1]=0xCCCC; w[2]=0xF0F0; w[3]=0xFF00;"
  (hd-ln "  for (uint32_t g = 0; g < ng; g++) { uint32_t code = (uint32_t)((prog >> (g*7)) & 127); uint32_t a = (code >> 4) & 15, b = code & 15; w[4+g] = (uint16_t)~(w[a] & w[b]); }"
  (hd-ln "  return w[3+ng] == tgt;"
  (hd-ln "}"
  (hd-ln "int main(void) { @autoreleasepool {"
  (hd-ln "  id<MTLDevice> dev = MTLCreateSystemDefaultDevice();"
  (hd-ln "  if (!dev) { printf("
  (list-append (ce-qstr "NO_METAL_DEVICE")
  (hd-ln "); putchar(10); return 1; }"
  (hd-ln "  NSError *err = nil;"
  (list-append "  NSString *src = [NSString stringWithContentsOfFile:[NSString stringWithUTF8String:"
  (list-append (ce-qstr mpath)
  (hd-ln "] encoding:NSUTF8StringEncoding error:&err];"
  (hd-ln "  id<MTLLibrary> lib = [dev newLibraryWithSource:src options:nil error:&err];"
  (hd-ln "  if (!lib) { fprintf(stderr, "
  (list-append (ce-qstr "METAL_ERR: %s")
  (hd-ln ", err.localizedDescription.UTF8String); fputc(10, stderr); return 2; }"
  (hd-ln "  id<MTLCommandQueue> q = [dev newCommandQueue];"
  (list-append "  id<MTLComputePipelineState> pso = [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:[NSString stringWithUTF8String:"
  (list-append (ce-qstr "hx_discover_nand2")
  (hd-ln "]] error:&err];"
  (hd-ln "  // 4-input targets: PARITY3_EXACT(0x9696), MAJ3(0xE8E8), MUX2(0xCACA), AND3(0x8080), XNOR2_AND_C(0x9090)"
  (hd-ln "  // Plus real 4-input functions: AND4(0x8000), OR4(0xFFFE), EQ2(0x9009), PRESENT_S3_BIT(0x6996/0xD2B4)"
  (hd-ln "  uint16_t tgts[5] = { 0x8000, 0xFFFE, 0x9009, 0xCACA, 0xE8E8 };"
  (list-append "  const char *names[5] = { " (list-append (ce-qstr "AND4") (list-append ", " (list-append (ce-qstr "OR4") (list-append ", " (list-append (ce-qstr "EQ2_2BIT") (list-append ", " (list-append (ce-qstr "MUX2") (list-append ", " (list-append (ce-qstr "MAJ3") (hd-ln " };"
  (hd-ln "  uint32_t init_best[5] = { 99, 99, 99, 99, 99 };"
  (hd-ln "  id<MTLBuffer> bT = [dev newBufferWithBytes:tgts length:sizeof(tgts) options:MTLResourceStorageModeShared];"
  (hd-ln "  id<MTLBuffer> bB = [dev newBufferWithBytes:init_best length:sizeof(init_best) options:MTLResourceStorageModeShared];"
  (hd-ln "  id<MTLBuffer> bP = [dev newBufferWithLength:5*sizeof(uint64_t) options:MTLResourceStorageModeShared];"
  (hd-ln "  const uint32_t THREADS = 65536, ITERS = 4096;"
  (hd-ln "  DiscParams dp = { 5, 1337, ITERS };"
  (hd-ln "  double t0 = now_ms();"
  (hd-ln "  id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
  (hd-ln "  [enc setComputePipelineState:pso]; [enc setBuffer:bT offset:0 atIndex:0]; [enc setBuffer:bB offset:0 atIndex:1]; [enc setBuffer:bP offset:0 atIndex:2]; [enc setBytes:&dp length:sizeof(dp) atIndex:3];"
  (hd-ln "  [enc dispatchThreads:MTLSizeMake(THREADS, 1, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];"
  (hd-ln "  [enc endEncoding]; [cb commit]; [cb waitUntilCompleted];"
  (hd-ln "  double ms = now_ms() - t0;"
  (hd-ln "  double total_dags = (double)THREADS * ITERS; double total_gates = total_dags * 9.0;"
  (hd-ln "  uint32_t *bg = bB.contents; uint64_t *bp = bP.contents;"
  (list-append "  printf("
  (list-append (ce-qstr "GPU=%s | Symbolic Discovery: %.2fM DAGs (%.2fB gate-evals) in %.2f ms (%.2f G-gate-evals/s)")
  (hd-ln ", dev.name.UTF8String, total_dags/1e6, total_gates/1e9, ms, total_gates/(ms*1e6)); putchar(10);"
  (hd-ln "  int all_ok = 1;"
  (hd-ln "  for (int i = 0; i < 5; i++) {"
  (hd-ln "    int ok = (bg[i] < 99) ? verify_4in(bg[i], bp[i], tgts[i]) : 0;"
  (hd-ln "    if (!ok) all_ok = 0;"
  (list-append "    printf("
  (list-append (ce-qstr "  DISCOVERED %-8s tt=0x%04X gates=%u verified=%d prog=0x%llx")
  (hd-ln ", names[i], tgts[i], bg[i], ok, (unsigned long long)bp[i]); putchar(10);"
  (hd-ln "  }"
  (hd-ln "  return all_ok ? 0 : 3;"
  (hd-ln "} }" nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
