h4-esc : Word → Word → List Word
h4-esc c md =
  if %weq c #10 then (cons #92 (cons #110 nil))
  else if %weq c #9 then (cons #92 (cons #116 nil))
  else if %weq c #13 then (cons #92 (cons #114 nil))
  else if %weq c #0 then (cons #92 (cons #48 nil))
  else if %weq c #92 then (cons #92 (cons #92 nil))
  else if andB (%weq c #39) (%weq md #0) then (cons #92 (cons #39 nil))
  else if andB (%weq c #34) (%weq md #1) then (cons #92 (cons #34 nil))
  else h4-utf8enc c
