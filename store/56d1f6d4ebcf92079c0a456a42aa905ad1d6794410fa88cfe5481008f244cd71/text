h4-lsget : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
h4-lsget m zero ls idx k =
  k (h4-depl m (ls))
h4-lsget m (suc f) ls idx k =
  if (orB (%weq idx #0) (%weq ls #0)) then (k (h4-depl m (ls))) else (scmd (w-load ((h4-ha m (%wadd ls #1)))) (λ x → let m2794 = h4-dep m x in h4-lsget m2794 f (h4-val x) (%wsub idx #1) k))
