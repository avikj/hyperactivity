-- the heap chain of fields, as a list
h4-chain : Word → Nat → Word → List Word → (List Word → Step W Word) → Step W Word
h4-chain mm_ zero c acc kq_ =
  kq_ (h4-depl mm_ ((hv2-rev acc)))
h4-chain mm_ (suc f) c acc kq_ =
  if (%weq c #0) then (kq_ (h4-depl mm_ ((hv2-rev acc)))) else (h4-rd mm_ c (λ x → let mm_55 = h4-dep mm_ x in h4-rd mm_55 (%wsucc c) (λ n → let mm_56 = h4-dep mm_55 n in h4-chain mm_56 f n (cons x acc) kq_)))
