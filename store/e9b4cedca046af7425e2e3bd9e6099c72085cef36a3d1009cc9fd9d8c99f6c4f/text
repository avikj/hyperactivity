b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_7880 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_7880 b2-ERR)) else (b2-iskw mm_7880 k (λ kw → let mm_7881 = b2-dpb mm_7880 kw in if (kw) then (b2-nbytes mm_7881 k (λ kb → let mm_7882 = b2-dpl mm_7881 kb in let p_7884 = p in let i_7886 = (%wadd p_7884 #1) in scmd (w-load ((b2-a mm_7882 i_7886))) (λ x_7885 → let mm_7887 = b2-dep mm_7882 x_7885 in let x_7883 = x_7885 in let i = x_7883 in let p_7889 = p in let i_7891 = (%wadd p_7889 #1) in scmd (w-load ((b2-a mm_7887 i_7891))) (λ x_7890 → let mm_7892 = b2-dep mm_7887 x_7890 in let x_7888 = x_7890 in let ixq = x_7888 in b2-pfail mm_7892 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_7893 = b2-dep mm_7892 r in kq_ (h4-depl mm_7893 (r))))))) else (kq_ (h4-depl mm_7881 (k))))))
