b2-lget : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-lget mm_ zero l k kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-lget mm_ (suc f) l k kq_ =
  if (%weq l #0) then (kq_ (h4-depl mm_ (hv2-none))) else (let i_467 = l in scmd (w-load ((b2-a mm_ i_467))) (λ x_466 → let mm_468 = b2-dep mm_ x_466 in let x = x_466 in if (%weq x k) then (let i_470 = (%wadd l #1) in scmd (w-load ((b2-a mm_468 i_470))) (λ x_469 → let mm_471 = b2-dep mm_468 x_469 in let v = x_469 in kq_ (h4-depl mm_471 (v)))) else (let i_473 = (%wadd l #2) in scmd (w-load ((b2-a mm_468 i_473))) (λ x_472 → let mm_474 = b2-dep mm_468 x_472 in let nx = x_472 in b2-lget mm_474 f nx k kq_))))
