b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6551 = b2-dep mm_ c in let p_6553 = p in let i_6555 = (%wadd p_6553 #1) in scmd (w-load ((b2-a mm_6551 i_6555))) (λ x_6554 → let mm_6556 = b2-dep mm_6551 x_6554 in let x_6552 = x_6554 in let i = x_6552 in let p_6557 = p in let v_6558 = (%wsucc i) in let i_6559 = (%wadd p_6557 #1) in let v_6560 = v_6558 in scmd (w-store ((b2-a mm_6556 i_6559)) (v_6560)) (λ uu_6561 → let mm_6562 = hv2-u mm_6556 uu_6561 in kq_ (h4-depl mm_6562 (c)))))
