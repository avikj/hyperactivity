-- the index lines of a chunk's whole records, and what is left after them (a record the chunk ends
-- inside, given back whole for the next chunk)
e-st : Nat → Bool → List Word → List Word
e-st zero syn t = nil
e-st (suc f) syn t = if e-whole syn t then e-cw (list-length t) t (λ r → list-append (e-nums syn r) (e-st f syn (e-drop-n (e-width syn) r))) else nil
