b2-namelist : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-namelist mm_ zero v j n acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-namelist mm_ (suc f) v j n acc kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (acc))) else (let v_13993 = v in let j_13994 = j in scmd (w-load ((b2-a mm_ (%wadd v_13993 #2)))) (λ d_13992 → let mm_13995 = b2-dep mm_ d_13992 in scmd (w-load ((b2-a mm_13995 (%wadd d_13992 (%wsucc j_13994))))) (λ x_13991 → let mm_13996 = b2-dep mm_13995 x_13991 in let k = x_13991 in b2-namekey mm_13996 k (λ kb → let mm_13997 = b2-dpl mm_13996 kb in b2-namelist mm_13997 f v (%wsucc j) n (the (List Word) (if %weq j #0 then kb else list-append acc (list-append ", " kb))) kq_))))
