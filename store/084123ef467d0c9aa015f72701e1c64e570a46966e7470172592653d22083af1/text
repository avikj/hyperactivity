-- Ooguri 4D SU(2) BF 4-simplex vertex amplitude A_v^BF(j_ab, i_a) = (prod_a sqrt(2 i_a + 1)) {15j}_I as exact Amp.
sf-bf-vertex : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Amp
sf-bf-vertex j12 j13 j14 j15 j23 j24 j25 j34 j35 j45 i1 i2 i3 i4 i5 =
  sf-amp-of-bq-d2 (sf-15j-W j12 j13 j14 j15 j23 j24 j25 j34 j35 j45 i1 i2 i3 i4 i5)
    (bq-mul
      (sf-bq-of-nat (times (times (suc i1) (suc i2)) (times (suc i3) (times (suc i4) (suc i5)))))
      (bq-mul
        (bq-mul (bq-mul (sf-delta2 j12 j13 i1) (sf-delta2 j14 j15 i1))
                (bq-mul (sf-delta2 j12 j25 i2) (sf-delta2 j23 j24 i2)))
        (bq-mul (bq-mul (sf-delta2 j13 j23 i3) (sf-delta2 j34 j35 i3))
                (bq-mul (bq-mul (sf-delta2 j24 j34 i4) (sf-delta2 j14 j45 i4))
                        (bq-mul (sf-delta2 j35 j45 i5) (sf-delta2 j15 j25 i5))))))
