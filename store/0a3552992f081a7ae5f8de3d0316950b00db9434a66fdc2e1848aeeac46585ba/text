-- Pure checked 2D vector canvas IR (no raw JS/HTML smuggling)
data CanvasOp
  = cv-nil
  | cv-clear (hex : List Word)
  | cv-line (x1 : Word) (y1 : Word) (x2 : Word) (y2 : Word) (hex : List Word)
  | cv-circle (cx : Word) (cy : Word) (r : Word) (hex : List Word)
  | cv-rect (x : Word) (y : Word) (w : Word) (h : Word) (hex : List Word)
  | cv-label (x : Word) (y : Word) (txt : List Word) (hex : List Word)
  | cv-seq (a : CanvasOp) (b : CanvasOp)
