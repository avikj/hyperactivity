b2-bvloop : Word → Nat → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-bvloop mm_ zero bk tlds last done i n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-bvloop mm_ (suc f) bk tlds last done i n kq_ =
  if (%weq i n) then (kq_ (h4-depl mm_ (#0))) else (b2-bvstep mm_ bk tlds last done i (λ x → let mm_12507 = b2-dep mm_ x in if (%weq x b2-ERR) then (kq_ (h4-depl mm_12507 b2-ERR)) else (b2-bvloop mm_12507 f bk tlds last done (%wsucc i) n kq_)))
