-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10492 = tld in scmd (w-load ((b2-a mm_ t_10492))) (λ x_10491 → let mm_10493 = b2-dep mm_ x_10491 in let tg = (%wand x_10491 #255) in if (%weq tg b2-TADT) then (let t_10495 = tld in let j_10496 = #4 in scmd (w-load ((b2-a mm_10493 (%wadd t_10495 (%wadd #2 j_10496))))) (λ x_10494 → let mm_10497 = b2-dep mm_10493 x_10494 in let b = x_10494 in kq_ (h4-depl mm_10497 (b)))) else (let t_10499 = tld in let j_10500 = #5 in scmd (w-load ((b2-a mm_10493 (%wadd t_10499 (%wadd #2 j_10500))))) (λ x_10498 → let mm_10501 = b2-dep mm_10493 x_10498 in let b = x_10498 in kq_ (h4-depl mm_10501 (b))))))
