-- Weighted sum-of-squares over any finite list of (weight, linear_functional).
sc-wsos : (W A : Type) → A → (A → A → A) → (A → A → A) → List (A × (W → A)) → W → A
sc-wsos W A z add mul terms u = case terms of
  nil → z
  cons p rest → add (mul (fst p) (mul (snd p u) (snd p u))) (sc-wsos W A z add mul rest u)
