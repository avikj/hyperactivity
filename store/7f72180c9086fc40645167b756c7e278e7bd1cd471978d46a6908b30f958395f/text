b2-markbase : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13253 = bk in let j_13254 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13253 (%wadd #2 j_13254))))) (λ x_13252 → let mm_13255 = b2-dep mm_ x_13252 in let ov = x_13252 in let v_13258 = ov in let j_13259 = j in scmd (w-load ((b2-a mm_13255 (%wadd v_13258 #2)))) (λ d_13257 → let mm_13260 = b2-dep mm_13255 d_13257 in scmd (w-load ((b2-a mm_13260 (%wadd d_13257 (%wsucc j_13259))))) (λ x_13256 → let mm_13261 = b2-dep mm_13260 x_13256 in let k = x_13256 in b2-tld mm_13261 bk k (λ t → let mm_13262 = b2-dep mm_13261 t in let t_13264 = t in scmd (w-load ((b2-a mm_13262 t_13264))) (λ x_13263 → let mm_13265 = b2-dep mm_13262 x_13263 in let tg = (%wand x_13263 #255) in let t_13266 = t in let j_13267 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13268 = #1 in scmd (w-store ((b2-a mm_13265 (%wadd t_13266 (%wadd #2 j_13267)))) (v_13268)) (λ uu_13269 → let mm_13270 = hv2-u mm_13265 uu_13269 in b2-markbase mm_13270 f bk (%wsucc j) n kq_)))))))
