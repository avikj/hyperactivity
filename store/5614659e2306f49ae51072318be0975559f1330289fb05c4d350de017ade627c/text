-- src/hvm.c heap_subst_cop: the other side's value left for its twin, this side's returned
h4-subcop : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-subcop mm_ side loc r0 r1 kq_ =
  scmd (w-store ((h4-ha mm_ loc)) ((h4-setsub (if %weq side #0 then r1 else r0)))) (λ uu_36 → let mm_37 = hv2-u mm_ uu_36 in kq_ (h4-depl mm_37 ((if %weq side #0 then r0 else r1))))
