        cell.classList.add('hx-expandable');
        cell.setAttribute('role', 'button');
        cell.setAttribute('tabindex', '0');
        cell.setAttribute('aria-expanded', 'false');

        var cue = document.createElement('em');
        cue.className = 'hx-cell-cue';
        cue.textContent = '+';
        cell.appendChild(cue);

        function activate() {
          if (activeCell === cell) {
            cell.setAttribute('aria-expanded', 'false');
            closeDrawer();
            return;
          }
          cells.forEach(function (c) { c.classList.remove('hx-open'); c.setAttribute('aria-expanded', 'false'); });
          activeCell = cell;
          cell.classList.add('hx-open');
          cell.setAttribute('aria-expanded', 'true');
          drawer.innerHTML = renderExpositionHTML(ex);
          drawer.classList.add('open');

          if (typeof window.renderMathInElement === 'function') {
            try {
              window.renderMathInElement(drawer, {
                delimiters: [{ left: '$$', right: '$$', display: true }, { left: '$', right: '$', display: false }],
                throwOnError: false,
              });
            } catch (_) {}
          }

          var closeBtn = drawer.querySelector('.hx-ex-close');
          if (closeBtn) closeBtn.addEventListener('click', function () {
            cell.setAttribute('aria-expanded', 'false');
            closeDrawer();
          });

          drawer.querySelectorAll('[data-open-mod]').forEach(function (btn) {
            btn.addEventListener('click', function () { openSourceDrawer(btn.getAttribute('data-open-mod'), null, null); });
