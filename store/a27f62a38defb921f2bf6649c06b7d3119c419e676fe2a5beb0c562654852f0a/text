  var PORTALS = [
    { name: 'Hyperactivity Home', meta: '/ · splash & derivation spine', href: '/' },
    { name: 'Learn Hyperactivity from First Principles', meta: '/learn · cubical kernel & nets', href: '/learn' },
    { name: 'Universal Hyperfactoring', meta: '/hyperfactor · proof to bare metal', href: '/hyperfactor' },
    { name: 'Computing Without a Center (PoUW & Web)', meta: '/decentralized · confluence & clearing', href: '/decentralized' },
