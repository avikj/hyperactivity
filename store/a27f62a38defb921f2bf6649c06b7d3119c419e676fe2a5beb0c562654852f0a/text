    var m = (txt || '').match(/((?:lib|fold|chem|neuro|experiments|physics)\/[a-zA-Z0-9_\/-]+\.hypercubical)/);
    if (m) return m[1];
    var b = (txt || '').match(/\b([a-zA-Z0-9_-]+\.hypercubical)\b/);
    if (b && baseMap[b[1]]) return baseMap[b[1]];
    return null;
  }

