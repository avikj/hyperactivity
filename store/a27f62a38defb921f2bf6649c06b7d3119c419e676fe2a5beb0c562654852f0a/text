    { name: 'Artificial Intelligence & Machine Learning', meta: '/ai · statistical foundations to alignment', href: '/ai' },
    { name: 'Spacetime, Atoms & Morphogenesis', meta: '/physics · exact interaction networks', href: '/physics' },
    { name: 'Brain as Interaction Network & Neural Co-Processors', meta: '/neuro · Lyapunov & barrier certs', href: '/neuro' },
    { name: 'Live Cubical IDE & Studio', meta: '/ide · full WASM editor', href: '/ide' },
    { name: 'Full Monograph PDF', meta: '/pdf · typeset paper', href: '/pdf' },
  ];

  var cmdSel = 0;
  var cmdResults = [];

  function ensureCmdPalette() {
    var bd = document.getElementById('hx-cmd-backdrop');
    if (bd) return bd;
    bd = document.createElement('div');
    bd.id = 'hx-cmd-backdrop';
    bd.innerHTML =
      '<div id="hx-cmd-box" role="dialog" aria-label="Search store & portals">' +
        '<input id="hx-cmd-input" type="text" placeholder="Jump to any module, verified definition, or portal…">' +
        '<ul id="hx-cmd-list"></ul>' +
        '<div id="hx-cmd-foot"><span>↑↓ navigate · ↵ open in split-pane · esc close</span><span id="hx-cmd-count"></span></div>' +
      '</div>';
    document.body.appendChild(bd);

    var inp = bd.querySelector('#hx-cmd-input');
    var list = bd.querySelector('#hx-cmd-list');
    var countEl = bd.querySelector('#hx-cmd-count');

    function renderList(q) {
      q = (q || '').trim().toLowerCase();
      var out = [];
      PORTALS.forEach(function (p) {
        if (!q || p.name.toLowerCase().indexOf(q) !== -1 || p.meta.toLowerCase().indexOf(q) !== -1) {
          out.push({ kind: 'portal', name: p.name, meta: p.meta, href: p.href });
        }
      });
      if (kgData && kgData.mods) {
        for (var i = 0; i < kgData.mods.length && out.length < 40; i++) {
          var m = kgData.mods[i];
          if (!q || m[0].toLowerCase().indexOf(q) !== -1 || (m[3] && m[3].toLowerCase().indexOf(q) !== -1)) {
            out.push({ kind: 'mod', name: m[0], meta: 'module · ' + m[6] + ' defs · sha:' + m[1].slice(0, 8), mod: m[0], line: null, term: null });
          }
        }
        if (q.length >= 2 && kgData.terms) {
          var tKeys = Object.keys(kgData.terms);
          for (var j = 0; j < tKeys.length && out.length < 60; j++) {
            var tk = tKeys[j];
            if (tk.toLowerCase().indexOf(q) !== -1) {
              var hit = kgData.terms[tk];
              var mi = Array.isArray(hit) ? hit[0] : hit;
              var ln = Array.isArray(hit) ? hit[1] : null;
              var mm = kgData.mods[mi];
              if (mm) out.push({ kind: 'term', name: tk, meta: mm[0] + (ln ? ':' + ln : ''), mod: mm[0], line: ln, term: tk });
            }
          }
        }
      }
      cmdResults = out.slice(0, 45);
      cmdSel = 0;
      countEl.textContent = cmdResults.length + ' matches';
      list.innerHTML = cmdResults.map(function (it, idx) {
        return '<li data-idx="' + idx + '"' + (idx === 0 ? ' class="sel"' : '') + '>' +
          '<span class="cm-name">' + escHtml(it.name) + '</span>' +
          '<span class="cm-meta">' + escHtml(it.meta) + '</span></li>';
      }).join('');
    }

    function activateItem(idx) {
      var it = cmdResults[idx];
      if (!it) return;
      bd.classList.remove('open');
      if (it.kind === 'portal') window.location.href = it.href;
      else openSourceDrawer(it.mod, it.line, it.term);
    }

    inp.addEventListener('input', function () { renderList(inp.value); });
    inp.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); cmdSel = Math.min(cmdResults.length - 1, cmdSel + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); cmdSel = Math.max(0, cmdSel - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); activateItem(cmdSel); return; }
      else if (e.key === 'Escape') { bd.classList.remove('open'); return; }
      else return;
      list.querySelectorAll('li').forEach(function (li, i) { li.classList.toggle('sel', i === cmdSel); });
      var activeLi = list.querySelector('li.sel');
      if (activeLi) activeLi.scrollIntoView({ block: 'nearest' });
    });

    list.addEventListener('click', function (e) {
      var li = e.target.closest('li[data-idx]');
      if (li) activateItem(parseInt(li.getAttribute('data-idx'), 10));
    });
    bd.addEventListener('click', function (e) { if (e.target === bd) bd.classList.remove('open'); });
    bd._render = renderList;
    return bd;
  }

  function openCmdPalette() {
    var bd = ensureCmdPalette();
    bd.classList.add('open');
    var inp = bd.querySelector('#hx-cmd-input');
