  function wireInlineSymbolsAndTables() {
    loadKg().then(function (kg) {
      if (kg && kg.mods) {
        var nMods = kg.mods.length;
        var nTerms = Object.keys(kg.terms || {}).length;
        var sl = document.getElementById('hx-store-live');
        if (sl) sl.textContent = 'store root ' + kg.root.slice(0, 12) + ' · ' + nMods + ' modules · ' + nTerms.toLocaleString() + ' defs';

        // Homepage live root strip
        var splash = document.querySelector('.splash');
        var mainWrap = document.querySelector('main.wrap');
        if (splash && mainWrap && !document.getElementById('hx-home-root')) {
          var strip = document.createElement('div');
          strip.id = 'hx-home-root';
          strip.className = 'hx-home-root';
          strip.innerHTML =
            '<span>live store root <b>sha256:' + escHtml(kg.root.slice(0, 12)) + '</b></span>' +
            '<span><b>' + nMods + '</b> checked .hypercubical modules · <b>' + nTerms.toLocaleString() + '</b> verified defs · <b>⌘K</b> to inspect</span>';
          mainWrap.insertBefore(strip, mainWrap.firstChild);
        }

        // Honest live hydration on /learn's 607 tile
        document.querySelectorAll('.stat-cell').forEach(function (c) {
          if (c.textContent.indexOf('Content-addressed modules') !== -1 && !c.querySelector('.hx-live-sub')) {
            var sub = document.createElement('small');
            sub.className = 'hx-live-sub';
            sub.textContent = 'live index: ' + nMods + ' .hypercubical · ' + nTerms.toLocaleString() + ' defs';
            c.appendChild(sub);
          }
        });
      }

      // Wire every inline <code> across main/article/tables (store symbols + basenames + glossary)
      document.querySelectorAll('main code, article code, table code, .thm-head code').forEach(function (el) {
        if (el.closest('pre') || el.closest('a') || el.closest('.stat-cell') || el.closest('#hx-src-drawer') || el.classList.contains('hx-sym-link')) return;
        var hit = resolveToken(el.textContent);
        if (hit) bindSymbolEl(el, hit);
      });

      // Also link bare module paths (full or basename) inside table cells, .thm-head, .meta-line
      var modRe = /\b((?:(?:lib|fold|chem|neuro|experiments|physics)\/)?[a-zA-Z0-9_\/-]+\.hypercubical)\b/g;
      document.querySelectorAll('table td, .thm-head, .meta-line').forEach(function (container) {
        if (container.closest('#hx-src-drawer')) return;
        var walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, null, false);
        var nodes = [];
        var n;
        while ((n = walker.nextNode())) {
          if (n.parentElement && (n.parentElement.closest('code') || n.parentElement.closest('a') || n.parentElement.closest('button'))) continue;
          if (modRe.test(n.nodeValue)) nodes.push(n);
          modRe.lastIndex = 0;
        }
        nodes.forEach(function (tn) {
          var frag = document.createDocumentFragment();
          var text = tn.nodeValue;
          var last = 0;
          var m;
          modRe.lastIndex = 0;
          while ((m = modRe.exec(text))) {
            if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
            var hit = resolveToken(m[1]);
            if (hit && hit.kind !== 'glossary') {
              var sp = document.createElement('span');
              sp.textContent = m[1];
              bindSymbolEl(sp, hit);
              frag.appendChild(sp);
            } else {
              frag.appendChild(document.createTextNode(m[1]));
            }
            last = m.index + m[0].length;
          }
          if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
          tn.parentNode.replaceChild(frag, tn);
        });
      });
    });
  }

