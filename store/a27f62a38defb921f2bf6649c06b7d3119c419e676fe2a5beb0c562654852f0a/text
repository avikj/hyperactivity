  // ==================== 13. GEODESIC PROSE FOLDS (STRICTLY PURE <p>) ====================
  function isPureProseParagraph(el) {
    if (!el || el.tagName !== 'P') return false;
    var skip = ['lede', 'kicker', 'meta-line', 'ch-num', 'hg-intro', 'hg-ins-desc', 'foot'];
    for (var i = 0; i < skip.length; i++) if (el.classList.contains(skip[i])) return false;
    var txt = (el.textContent || '').trim();
    if (!txt) return false;
    var links = el.querySelectorAll('a');
    if (links.length) {
      var lc = 0;
      links.forEach(function (a) { lc += (a.textContent || '').trim().length; });
      if (lc / txt.length > 0.4) return false;
    }
    return true;
  }

  function buildGeodesicFolds() {
    if (foldsBuilt) return;
    foldsBuilt = true;
    if (document.querySelector('.splash')) return;
    var containers = document.querySelectorAll('.chapter, article');
    if (!containers.length) {
      var mainEl = document.querySelector('main');
      if (mainEl && mainEl.querySelectorAll(':scope > p').length >= 3) containers = [mainEl];
    }
    containers.forEach(function (box) {
      var children = Array.prototype.slice.call(box.children);
      var run = [];
      function flushRun() {
        if (!run.length) return;
        var group = run.slice();
        run = [];
        var words = 0;
        group.forEach(function (el) { words += (el.textContent || '').trim().split(/\s+/).filter(Boolean).length; });
        if (words < 22 && group.length === 1) return;
        var chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'hx-fold-chip';
        var noun = group.length === 1 ? 'paragraph' : 'paragraphs';
        var labelClosed = '··· unfold ' + group.length + ' ' + noun + ' (' + words + 'w)';
        var labelOpen = '× contract ' + group.length + ' ' + noun;
        chip.textContent = labelClosed;
        group.forEach(function (el) { el.classList.add('hx-prose-folded'); });
        group[0].parentNode.insertBefore(chip, group[0]);
        chip.addEventListener('click', function () {
          var expanded = chip.classList.toggle('expanded');
          chip.textContent = expanded ? labelOpen : labelClosed;
          group.forEach(function (el) { el.classList.toggle('hx-prose-folded', !expanded); });
        });
      }
      children.forEach(function (el) { if (isPureProseParagraph(el)) run.push(el); else flushRun(); });
      flushRun();
    });
  }

  // ==================== 14. VIEW PANEL & UI SYNC ====================
  function syncUI() {
    var edObj = EDITIONS.find(function (e) { return e.id === state.edition; }) || EDITIONS[0];
    var dpObj = DEPTHS.find(function (d) { return d.id === state.depth; }) || DEPTHS[0];
    var label = edObj.name.toLowerCase() + (state.depth !== 'full' ? ' · ' + dpObj.name.toLowerCase() : '');

    var trig = document.getElementById('hx-view-trigger');
    if (trig) trig.innerHTML = '<span class="dot"></span><span>' + label + '</span>';
    var fp = document.getElementById('hx-float-pill');
    if (fp) fp.innerHTML = '<span style="color:#ff0a94">●</span> ' + label + ' <span class="k">[v · ⌘K]</span>';
    var pinBtn = document.getElementById('hx-sd-pin');
    if (pinBtn) pinBtn.classList.toggle('on', !!state.split);

    document.querySelectorAll('#hx-view-panel [data-set-edition]').forEach(function (b) {
      b.classList.toggle('on', b.getAttribute('data-set-edition') === state.edition);
    });
    document.querySelectorAll('#hx-view-panel [data-set-depth]').forEach(function (b) {
      b.classList.toggle('on', b.getAttribute('data-set-depth') === state.depth);
    });
    document.querySelectorAll('#hx-view-panel [data-set-field]').forEach(function (b) {
      b.classList.toggle('on', b.getAttribute('data-set-field') === state.field);
    });
    var apiEl = document.getElementById('hx-api-readout');
    if (apiEl) {
      apiEl.textContent = "hxView.set({edition:'" + state.edition + "',depth:'" + state.depth + "',field:'" + state.field + "',split:" + state.split + '})';
    }
  }

  function findScrollAnchor() {
    if (window.scrollY < 40) return null;
    var nodes = document.querySelectorAll('main h1, main h2, main h3, main .thm-box, main .eq-box, main .lab-card, main .stat-strip, main .title-block');
    var bestInView = null;
    var bestAbove = null;
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      if (!el.offsetParent) continue;
      var r = el.getBoundingClientRect();
      if (r.height === 0) continue;
      if (r.top >= 46 && r.top <= window.innerHeight * 0.65) {
        if (!bestInView || r.top < bestInView.top) bestInView = { el: el, top: r.top };
      } else if (r.top < 46) {
        if (!bestAbove || r.top > bestAbove.top) bestAbove = { el: el, top: r.top };
      }
    }
    return bestInView || bestAbove;
  }

  function setState(patch, announce) {
    if (!patch || typeof patch !== 'object') return state;
    var anchor = findScrollAnchor();
    if (patch.edition && VALID_ED[patch.edition]) state.edition = patch.edition;
    if (patch.depth && VALID_DP[patch.depth]) state.depth = patch.depth;
    if (patch.field === 'void' || patch.field === 'dark') state.field = 'void';
    if (patch.field === 'light') state.field = 'light';
    if (typeof patch.split === 'boolean') state.split = patch.split;
    if (state.depth === 'geodesic') buildGeodesicFolds();
    applyAttributes();
    if (anchor && anchor.el && anchor.el.offsetParent) {
      var delta = anchor.el.getBoundingClientRect().top - anchor.top;
      if (Math.abs(delta) > 1) window.scrollBy(0, delta);
    }
    syncUI();
    if (announce) {
      var edObj = EDITIONS.find(function (e) { return e.id === state.edition; });
      var dpObj = DEPTHS.find(function (d) { return d.id === state.depth; });
      showToast('<b>' + edObj.name.toLowerCase() + '</b> · ' + dpObj.name.toLowerCase() + ' · ' + state.field);
    }
    return Object.assign({}, state);
  }

  function mountAll() {
    buildGeodesicFolds();
    wireStatStrips();
    wireTheoremBoxes();
    wireEquationLayers();
    wirePreBlocks();
    wireInlineSymbolsAndTables();
    mountSpineFooterAndProgress();

    var panel = document.createElement('div');
    panel.id = 'hx-view-panel';
    panel.setAttribute('role', 'dialog');
    panel.setAttribute('aria-label', 'Reader Modes');

    panel.innerHTML =
      '<div class="hx-p-head">' +
        '<span class="hx-p-title">HX-LENS · Compositional View</span>' +
        '<button type="button" class="hx-p-close" id="hx-p-close">esc ×</button>' +
      '</div>' +
      '<div class="hx-row">' +
        '<div class="hx-row-lbl"><span>01 · Reader Mode</span><span>keys 1–4</span></div>' +
        '<div class="hx-ed-grid">' + EDITIONS.map(function (e) {
          return '<button type="button" class="hx-opt" data-set-edition="' + e.id + '">' +
            '<div class="hx-opt-top"><span class="hx-opt-name">' + e.name + '</span><span class="hx-opt-key">' + e.key + '</span></div>' +
            '<div class="hx-opt-desc">' + e.desc + '</div></button>';
        }).join('') + '</div>' +
      '</div>' +
      '<div class="hx-row">' +
        '<div class="hx-row-lbl"><span>02 · Depth</span><span>f · g · p</span></div>' +
        '<div class="hx-seg">' + DEPTHS.map(function (d) {
          return '<button type="button" class="hx-opt" data-set-depth="' + d.id + '">' +
            '<div class="hx-opt-top"><span class="hx-opt-name">' + d.name + '</span><span class="hx-opt-key">' + d.key + '</span></div>' +
            '<div class="hx-opt-desc">' + d.desc + '</div></button>';
        }).join('') + '</div>' +
      '</div>' +
      '<div class="hx-row">' +
        '<div class="hx-row-lbl"><span>03 · Field Polarity</span><span>key d</span></div>' +
        '<div class="hx-seg two">' + FIELDS.map(function (f) {
          return '<button type="button" class="hx-opt" data-set-field="' + f.id + '">' +
            '<div class="hx-opt-top"><span class="hx-opt-name">' + f.name + '</span></div></button>';
        }).join('') + '</div>' +
      '</div>' +
      '<div class="hx-api-foot">' +
        '<span class="hx-store-live" id="hx-store-live">loading live store index…</span>' +
        '<span class="hx-api-code" id="hx-api-readout"></span>' +
      '</div>';
    document.body.appendChild(panel);

    var toast = document.createElement('div');
    toast.id = 'hx-view-toast';
    document.body.appendChild(toast);

    var navLinks = document.querySelector('nav .links');
    var trig = null;
    if (navLinks) {
      var cmdBtn = document.createElement('button');
      cmdBtn.id = 'hx-cmd-trigger';
      cmdBtn.type = 'button';
      cmdBtn.textContent = '⌘K';
      cmdBtn.title = 'Search modules & verified defs (⌘K or /)';
      cmdBtn.addEventListener('click', function (e) { e.stopPropagation(); openCmdPalette(); });

      trig = document.createElement('button');
      trig.id = 'hx-view-trigger';
      trig.type = 'button';
      trig.setAttribute('aria-expanded', 'false');
      trig.title = 'Reader Lens (v or 1-6)';

      var tbtn = navLinks.querySelector('.tbtn');
      if (tbtn) {
        navLinks.insertBefore(cmdBtn, tbtn);
        navLinks.insertBefore(trig, tbtn);
        tbtn.onclick = function () { setState({ field: state.field === 'void' ? 'light' : 'void' }, true); };
      } else {
        navLinks.appendChild(cmdBtn);
        navLinks.appendChild(trig);
      }
    } else {
      var fp = document.createElement('button');
      fp.id = 'hx-float-pill';
      fp.type = 'button';
      document.body.appendChild(fp);
      trig = fp;
    }

    function togglePanel(force) {
      var open = typeof force === 'boolean' ? force : !panel.classList.contains('open');
      panel.classList.toggle('open', open);
      if (trig) trig.setAttribute('aria-expanded', String(open));
    }

    if (trig) trig.addEventListener('click', function (e) { e.stopPropagation(); togglePanel(); });
    panel.querySelector('#hx-p-close').addEventListener('click', function () { togglePanel(false); });
    panel.addEventListener('click', function (e) {
      e.stopPropagation();
      var bEd = e.target.closest('[data-set-edition]');
      if (bEd) return setState({ edition: bEd.getAttribute('data-set-edition') }, true);
      var bDp = e.target.closest('[data-set-depth]');
      if (bDp) return setState({ depth: bDp.getAttribute('data-set-depth') }, true);
      var bFl = e.target.closest('[data-set-field]');
      if (bFl) return setState({ field: bFl.getAttribute('data-set-field') }, true);
    });
    document.addEventListener('click', function () { togglePanel(false); });

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        openCmdPalette();
        return;
      }
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      var tag = (e.target && e.target.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (e.target && e.target.isContentEditable)) return;

      if (e.key === 'Escape') {
        togglePanel(false);
        hidePeek();
        closeSourceDrawer();
        var bd = document.getElementById('hx-cmd-backdrop');
        if (bd) bd.classList.remove('open');
        document.querySelectorAll('.hx-ex-drawer.open').forEach(function (dr) { dr.classList.remove('open'); dr.innerHTML = ''; });
        document.querySelectorAll('.stat-cell.hx-open').forEach(function (c) { c.classList.remove('hx-open'); c.setAttribute('aria-expanded', 'false'); });
        return;
      }
      if (e.key === '/') { e.preventDefault(); openCmdPalette(); return; }
      if (e.key === 'v' || e.key === 'V') { e.preventDefault(); togglePanel(); return; }
      if (e.key === 'd' || e.key === 'D') { e.preventDefault(); setState({ field: state.field === 'void' ? 'light' : 'void' }, true); return; }
      if (e.key === 's' || e.key === 'S') {
        var dr = document.getElementById('hx-src-drawer');
        if (dr && dr.classList.contains('open')) {
          e.preventDefault();
          setState({ split: !state.split }, false);
          showToast(state.split ? '<b>split-pane</b> pinned' : '<b>split-pane</b> overlay');
        }
        return;
      }
      if (e.key === 'f') { setState({ depth: 'full' }, true); return; }
      if (e.key === 'g') { setState({ depth: 'geodesic' }, true); return; }
      if (e.key === 'p') { setState({ depth: 'formal' }, true); return; }
      var ed = EDITIONS.find(function (x) { return x.key === e.key; });
      if (ed) setState({ edition: ed.id }, true);
    });

    syncUI();
  }

  // ==================== 15. CROSS-TREATISE SPINE FOOTER & READING PROGRESS ====================
  var SPINE = [
    { path: '/learn',         title: '01 · First Principles' },
    { path: '/hyperfactor',   title: '02 · Universal Hyperfactoring' },
    { path: '/decentralized', title: '03 · PoUW & Decentralized Web' },
    { path: '/silicon',       title: '04 · Interaction-Net Silicon' },
    { path: '/ai',            title: '05 · AI & Alignment' },
    { path: '/physics',       title: '06 · Physics & Morphogenesis' },
    { path: '/neuro',         title: '07 · Neural Co-Processors' },
  ];

  function mountSpineFooterAndProgress() {
    var p = window.location.pathname.replace(/\/+$/, '') || '/';
    var idx = SPINE.findIndex(function (s) { return s.path === p; });
    if (idx === -1) return;

    // 1.5px photon reading progress hairline
    var bar = document.createElement('div');
    bar.id = 'hx-read-prog';
    document.body.appendChild(bar);
    function updateProg() {
      var h = document.documentElement.scrollHeight - window.innerHeight;
      var pct = h > 0 ? Math.min(100, Math.max(0, (window.scrollY / h) * 100)) : 0;
      bar.style.width = pct.toFixed(2) + '%';
    }
    window.addEventListener('scroll', updateProg, { passive: true });
    updateProg();

    // Cross-treatise continuation footer
    var main = document.querySelector('main');
    if (main && !document.getElementById('hx-spine-foot')) {
      var prev = idx > 0 ? SPINE[idx - 1] : null;
      var next = idx < SPINE.length - 1 ? SPINE[idx + 1] : null;
      var foot = document.createElement('footer');
      foot.id = 'hx-spine-foot';
      foot.innerHTML =
        (prev ? '<a class="sf-link" href="' + prev.path + '">← ' + escHtml(prev.title) + '</a>' : '<a class="sf-link" href="/">← Derivation Spine</a>') +
        '<a class="sf-mid" href="/">hyperactivity · spine</a>' +
        (next ? '<a class="sf-link" href="' + next.path + '">' + escHtml(next.title) + ' →</a>' : '<a class="sf-link" href="/ide">Live Cubical IDE →</a>');
      main.appendChild(foot);
    }
  }

  window.hxView = {
    get: function () { return Object.assign({}, state); },
    set: function (patch) { return setState(patch, false); },
    inspect: openSourceDrawer,
    verifyModule: verifyModule,
    tamperModule: tamperModule,
    evalCubical: evalCubical,
    casPut: casPutOverlay,
    casList: casGetAllOverlay,
    casDelete: casDeleteOverlay,
    search: openCmdPalette,
    editions: EDITIONS.map(function (e) { return e.id; }),
    depths: DEPTHS.map(function (d) { return d.id; }),
    fields: FIELDS.map(function (f) { return f.id; }),
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountAll);
  else mountAll();
})();
