                ? ('mutating 1 bit inside real ' + mp + ' & checking in /cubical.wasm…')
                : ('fetching import tree & type-checking real ' + mp + ' in /cubical.wasm…');
              (isBad ? tamperModule(mp) : verifyModule(mp)).then(function (r) {
                if (isBad) {
                  out.className = 'hx-ex-wasm-out show' + (r.rejected ? ' err' : '');
                  out.textContent = formatTamperReport(r);
                } else {
                  out.className = 'hx-ex-wasm-out show' + (r.ok ? '' : ' err');
                  out.textContent = formatVerifyReport(r);
                }
              }).catch(function (err) {
                out.className = 'hx-ex-wasm-out show err';
                out.textContent = 'WASM error: ' + (err.message || err);
              });
            });
          });
        }

        cell.addEventListener('click', activate);
        cell.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
        });
      });

      var hint = document.createElement('div');
      hint.className = 'hx-strip-hint';
      hint.textContent = 'select to unfold ↘';
      strip.parentNode.insertBefore(hint, strip);
    });
