  function showPeekFor(el, hit) {
    clearTimeout(peekHideTimer);
    clearTimeout(peekTimer);
    peekTimer = setTimeout(function () {
      var pk = ensurePeekCard();
      var rect = el.getBoundingClientRect();
      var left = Math.min(Math.max(12, rect.left), window.innerWidth - 472);
      var top = rect.bottom + 8;
      if (top + 220 > window.innerHeight) top = Math.max(54, rect.top - 220);
      pk.style.left = left + 'px';
      pk.style.top = top + 'px';

      if (hit.kind === 'glossary') {
        pk.querySelector('#pk-path').textContent = hit.term;
        pk.querySelector('#pk-sha').textContent = 'definition';
        pk.querySelector('#pk-code').textContent = hit.def;
        pk.querySelector('#pk-meta').textContent = 'domain glossary';
        pk.querySelector('#pk-hint').textContent = '';
        pk.classList.add('show');
        return;
      }

      var m = modMap[hit.mod];
      pk.querySelector('#pk-path').textContent = hit.mod + (hit.line ? ':' + hit.line : '');
      pk.querySelector('#pk-sha').textContent = m ? ('sha256:' + m[1].slice(0, 10)) : '';
      pk.querySelector('#pk-meta').textContent = m ? (m[6] + ' defs · ' + (m[2] || 'module')) : '';
      pk.querySelector('#pk-hint').textContent = 'click to open source & verify';
      pk.querySelector('#pk-code').textContent = 'loading…';
      pk.classList.add('show');

      fetchSource(hit.mod).then(function (txt) {
        var lines = txt.split('\n');
        var start = hit.line ? Math.max(0, hit.line - 1) : 0;
        pk.querySelector('#pk-code').textContent = lines.slice(start, start + 7).join('\n') || '(empty)';
      }).catch(function () {
        pk.querySelector('#pk-code').textContent = 'source unavailable';
      });
    }, 200);
  }

