  function findExposition(cellText) {
    var t = (cellText || '').replace(/\s+/g, ' ').trim();
    for (var i = 0; i < EXPOSITIONS.length; i++) {
      var ex = EXPOSITIONS[i];
      if (t.indexOf(ex.match) !== -1 && (!ex.match2 || t.indexOf(ex.match2) !== -1)) return ex;
    }
    return null;
  }

