  function openSourceDrawer(modPath, targetLine, termName) {
    hidePeek();
    currentDrawerMod = modPath;
    var d = ensureSourceDrawer();
    var isCub = modPath.endsWith('.hypercubical');
    d.querySelector('#hx-sd-wasm').style.display = isCub ? 'flex' : 'none';
    d.querySelector('#hx-sd-path').textContent = modPath + (targetLine ? ':' + targetLine : '');
    d.querySelector('#hx-sd-meta').textContent = (termName ? termName + ' · ' : '') + 'loading from store/…';
    d.querySelector('#hx-sd-wlog').className = 'hx-sd-wasm-log';
    d.querySelector('#hx-sd-wstat').textContent = 'real module check';
    d.querySelector('#hx-sd-body').innerHTML = '<div class="hx-sd-loading">fetching verified source…</div>';
    d.classList.add('open');
    applyAttributes();
    syncUI();

    Promise.all([fetchSource(modPath), loadKg()]).then(function (res) {
      var text = res[0];
      var lines = text.split('\n');
      // If termName was provided without an exact line number, locate its declaration line in the file
      if (!targetLine && termName) {
        var pat = new RegExp('^\\s*(?:data\\s+|record\\s+)?' + termName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '(?:\\s*:|\\s*=|\\s|$)');
        for (var k = 0; k < lines.length; k++) {
          if (pat.test(lines[k])) { targetLine = k + 1; break; }
        }
        if (targetLine) d.querySelector('#hx-sd-path').textContent = modPath + ':' + targetLine;
      }
      var m = modMap[modPath];
      var sha = m ? ('sha256:' + m[1].slice(0, 12)) : 'verified in store/';
      var defInfo = m ? (m[6] + ' defs · ' + lines.length + ' lines') : (lines.length + ' lines');
      d.querySelector('#hx-sd-meta').textContent = (termName ? termName + ' · ' : '') + sha + ' · ' + defInfo;

      // Render hypergraph dependency ribbon (imports ← current → importedBy)
      var depsEl = d.querySelector('#hx-sd-deps');
      if (m && kgData && kgData.mods) {
        var imps = (m[4] || []).map(function (idx) { return kgData.mods[idx] && kgData.mods[idx][0]; }).filter(Boolean);
        var usedBy = (m[5] || []).map(function (idx) { return kgData.mods[idx] && kgData.mods[idx][0]; }).filter(Boolean);
        var depHtml = '';
        if (imps.length) {
          depHtml += '<div class="hx-dep-row"><span class="hx-dep-lbl">← imports (' + imps.length + ')</span>' +
            imps.slice(0, 8).map(function (p) { return '<button type="button" class="hx-dep-chip" data-jump-mod="' + escHtml(p) + '">' + escHtml(p.split('/').pop()) + '</button>'; }).join('') +
            (imps.length > 8 ? '<span class="hx-dep-more">+' + (imps.length - 8) + '</span>' : '') + '</div>';
        }
        if (usedBy.length) {
          depHtml += '<div class="hx-dep-row"><span class="hx-dep-lbl">→ used by (' + usedBy.length + ')</span>' +
            usedBy.slice(0, 8).map(function (p) { return '<button type="button" class="hx-dep-chip" data-jump-mod="' + escHtml(p) + '">' + escHtml(p.split('/').pop()) + '</button>'; }).join('') +
            (usedBy.length > 8 ? '<span class="hx-dep-more">+' + (usedBy.length - 8) + '</span>' : '') + '</div>';
        }
        depsEl.innerHTML = depHtml;
        depsEl.style.display = depHtml ? 'block' : 'none';
        depsEl.querySelectorAll('[data-jump-mod]').forEach(function (b) {
          b.addEventListener('click', function () { openSourceDrawer(b.getAttribute('data-jump-mod'), null, null); });
        });
      } else {
        depsEl.innerHTML = '';
        depsEl.style.display = 'none';
      }

      var html = '<ol class="hx-sd-code">';
      for (var i = 0; i < lines.length; i++) {
        var ln = i + 1;
        var hl = targetLine && ln === targetLine ? ' class="hl" id="hx-sd-hl"' : '';
        html += '<li' + hl + '><span class="ln">' + ln + '</span><span class="tx">' + (escHtml(lines[i]) || ' ') + '</span></li>';
      }
      html += '</ol>';
      var bodyEl = d.querySelector('#hx-sd-body');
      bodyEl.innerHTML = html;

      var hlEl = document.getElementById('hx-sd-hl');
      if (hlEl) setTimeout(function () { hlEl.scrollIntoView({ block: 'center', behavior: 'smooth' }); }, 40);
      else bodyEl.scrollTop = 0;
    }).catch(function (err) {
      d.querySelector('#hx-sd-meta').textContent = 'could not load module';
      d.querySelector('#hx-sd-body').innerHTML = '<div class="hx-sd-loading">Error loading ' + escHtml(modPath) + ': ' + escHtml(err.message) + '</div>';
    });
  }

