  function bindSymbolEl(el, hit) {
    el.classList.add('hx-sym-link');
    if (hit.kind === 'glossary') el.classList.add('hx-gloss');
    el.setAttribute('role', 'button');
    el.setAttribute('tabindex', '0');
    el.addEventListener('mouseenter', function () { showPeekFor(el, hit); });
    el.addEventListener('mouseleave', scheduleHidePeek);
    if (hit.kind !== 'glossary') {
      function openIt(e) {
        e.preventDefault();
        e.stopPropagation();
        openSourceDrawer(hit.mod, hit.line, hit.term);
      }
      el.addEventListener('click', openIt);
      el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') openIt(e); });
