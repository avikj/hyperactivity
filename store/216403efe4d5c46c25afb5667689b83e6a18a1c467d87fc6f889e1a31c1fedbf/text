  b2-strval mm_ bk host (λ hs → let mm_15856 = b2-dpl mm_ hs in b2-u32val mm_15856 bk port (λ pt → let mm_15857 = b2-dep mm_15856 pt in let q = b2-ipq #0 #0 #0 #0 hs in if (orB (%weq q hv2-none) (%wlt #65535 pt)) then (kq_ (h4-depl mm_15857 (#0))) else (let n_15859 = #2 in scmd (w-load (mm_15857)) (λ at_15858 → let mm_15860 = b2-dep mm_15857 at_15858 in scmd (w-store (mm_15860) ((%wadd at_15858 n_15859))) (λ uu_15861 → let mm_15862 = hv2-u mm_15860 uu_15861 in let i = at_15858 in let i_15863 = i in let v_15864 = (%wor #2 (%wor (%wshl (%wshr pt #8) #16) (%wor (%wshl (%wand pt #255) #24) (%wshl q #32)))) in scmd (w-store ((b2-a mm_15862 i_15863)) (v_15864)) (λ uu_15865 → let mm_15866 = hv2-u mm_15862 uu_15865 in let i_15867 = (%wadd i #1) in let v_15868 = #0 in scmd (w-store ((b2-a mm_15866 i_15867)) (v_15868)) (λ uu_15869 → let mm_15870 = hv2-u mm_15866 uu_15869 in kq_ (h4-depl mm_15870 ((b2-a mm_15870 i))))))))))
