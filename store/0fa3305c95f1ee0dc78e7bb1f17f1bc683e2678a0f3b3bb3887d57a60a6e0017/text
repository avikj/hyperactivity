ief-short-go : Nat → List Word → List Word → List Word → Bool → Word → Word → Word → Word × Word
ief-short-go zero v l h incl a k n = (#0 , #4096)
ief-short-go (suc f) v l h incl a k n =
  let r = ief-try v l h incl a (%wsub k n)
  in if fst r then (snd r , %wsub k n) else ief-short-go f v l h incl a k (%wsucc n)
