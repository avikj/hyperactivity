-- context window of at most w tokens around token position pos (from max(0, pos - before))
si-snippet : (n : Nat) → Bytes n → Word → Word → Nat → List (List Word)
si-snippet n B pos before win =
  let start = if wlt pos before then #0 else wsub pos before
  in si-toks-at n B win (si-rd4 n B (si-slot #8 start))
