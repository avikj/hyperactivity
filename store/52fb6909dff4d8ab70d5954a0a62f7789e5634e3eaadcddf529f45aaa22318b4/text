b2-firstnq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstnq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-firstnq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_7382 = tel in let j_7383 = j in scmd (w-load ((b2-a mm_ (%wadd a_7382 (%wsucc j_7383))))) (λ x_7381 → let mm_7384 = b2-dep mm_ x_7381 in let c = x_7381 in let i_7386 = (%wadd c #3) in scmd (w-load ((b2-a mm_7384 i_7386))) (λ x_7385 → let mm_7387 = b2-dep mm_7384 x_7385 in let vT = x_7385 in let t_7389 = vT in scmd (w-load ((b2-a mm_7387 t_7389))) (λ x_7388 → let mm_7390 = b2-dep mm_7387 x_7388 in let tg = (%wand x_7388 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_7390 (j))) else (b2-firstnq mm_7390 f tel (%wsucc j) n kq_)))))
