-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7547 = tel in let j_7548 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7547 (%wsucc j_7548))))) (λ x_7546 → let mm_7549 = b2-dep mm_ x_7546 in let c = x_7546 in let i_7551 = c in scmd (w-load ((b2-a mm_7549 i_7551))) (λ x_7550 → let mm_7552 = b2-dep mm_7549 x_7550 in let q = x_7550 in let i_7554 = (%wadd c #1) in scmd (w-load ((b2-a mm_7552 i_7554))) (λ x_7553 → let mm_7555 = b2-dep mm_7552 x_7553 in let k = x_7553 in let i_7557 = (%wadd c #2) in scmd (w-load ((b2-a mm_7555 i_7557))) (λ x_7556 → let mm_7558 = b2-dep mm_7555 x_7556 in let i = x_7556 in let i_7560 = (%wadd c #3) in scmd (w-load ((b2-a mm_7558 i_7560))) (λ x_7559 → let mm_7561 = b2-dep mm_7558 x_7559 in let vT = x_7559 in let i_7563 = (%wadd c #4) in scmd (w-load ((b2-a mm_7561 i_7563))) (λ x_7562 → let mm_7564 = b2-dep mm_7561 x_7562 in let s = x_7562 in b2-All mm_7564 q k i vT e s (λ a → let mm_7565 = b2-dep mm_7564 a in b2-telebindg mm_7565 f tel (%wsub j #1) a kq_))))))))
