
-- ===========================================================================================
-- The parser (src/hvm.c parse_*), one function: w names the production
--   0 term   1 atom   2 λ (after λ)   3 ! (after !)   4 & (after &)   5 fork (a1 dyn, a2 label
--   term, a3 label)   6 sup-fork (after [)   7 auto-fork (after !)   8 the operators and calls
--   after a term (a1 the term, a2 the least precedence)   9 dup pattern (0 when none)
--   10 sup-fork core (captures in the state)   11 match cases (a1 the holder, a2 the tip)
--   12 list elements   13 constructor fields (a heap chain)   14 call arguments (a1, a2 as 8)
-- ===========================================================================================

h4-NUM0 : Word
h4-NUM0 = h4-new h4-NUM #0 #0

-- a name read (src/hvm.c parse_name): (state, ok, id)
h4-name : H4S → Bool × (H4S × Word)
h4-name s0 =
  let s = h4-skip s0
  in if not (h4-isinit (h4-peek s)) then (false , (s , #0))
     else (let t = h4-namechars (h4s-src s)
               r = h4-tfind (h4s-tab s) (fst t)
           in (true , (h4-skip (h4s-wtab (h4s-wsrc s (snd t)) (fst r)) , snd r)))

h4-namenum : H4S → Bool × (H4S × Word)
h4-namenum s0 =
  let s = h4-skip s0
  in if not (h4-isinit (h4-peek s)) then (false , (s , #0))
     else (let t = h4-namechars (h4s-src s)
               k = h4-b64num (fst t) #0
           in (not (%weq k hv2-none) , (h4-skip (h4s-wsrc s (snd t)) , k)))

-- an UTF-8 codepoint (src/hvm.c parse_utf8)
h4-utf8 : List Word → Word × List Word
h4-utf8 nil = (#0 , nil)
h4-utf8 (cons b0 r) =
  if %wlt b0 #128 then (b0 , r)
  else if %weq (%wand b0 #224) #192 then (%wor (%wshl (%wand b0 #31) #6) (%wand (hv2-nth #0 r) #63) , hv2-drop1 r)
  else if %weq (%wand b0 #240) #224 then (%wor (%wshl (%wand b0 #15) #12) (%wor (%wshl (%wand (hv2-nth #0 r) #63) #6) (%wand (hv2-nth #1 r) #63)) , hv2-drop1 (hv2-drop1 r))
  else if %weq (%wand b0 #248) #240 then (%wor (%wshl (%wand b0 #7) #18) (%wor (%wshl (%wand (hv2-nth #0 r) #63) #12) (%wor (%wshl (%wand (hv2-nth #1 r) #63) #6) (%wand (hv2-nth #2 r) #63))) , hv2-drop1 (hv2-drop1 (hv2-drop1 r)))
  else (b0 , r)

-- a character of a literal (src/hvm.c parse_char_esc): (ok, code, rest)
h4-chesc : List Word → Bool × (Word × List Word)
h4-chesc nil = (false , (#0 , nil))
h4-chesc (cons c r) =
  if %weq c #92
  then (if %weq (cli-len r) #0 then (false , (#0 , nil))
        else (let e = hv2-nth #0 r
              in (true , (if %weq e #110 then #10 else if %weq e #116 then #9 else if %weq e #114 then #13
                          else if %weq e #48 then #0 else e , hv2-drop1 r))))
  else (let u = h4-utf8 (cons c r) in (true , (fst u , snd u)))

-- the codepoints of a string up to its fence
h4-strchars : Nat → Word → List Word → Bool × (List Word × List Word)
h4-strchars zero fence s = (false , (nil , s))
h4-strchars (suc f) fence s =
  if %weq (cli-len s) #0 then (false , (nil , s))
  else if %weq (hv2-nth #0 s) fence then (true , (nil , hv2-drop1 s))
  else (let e = h4-chesc s
        in if not (fst e) then (false , (nil , s))
           else (let r = h4-strchars f fence (snd (snd e)) in (fst r , (cons (fst (snd e)) (fst (snd r)) , snd (snd r)))))

-- digits as a u32
h4-digits : List Word → Word → Word × List Word
h4-digits nil n = (n , nil)
h4-digits (cons c r) n = if h4-isdig c then h4-digits r (h4-u32 (%wadd (%wmul (h4-u32 n) #10) (%wsub c #48))) else (n , cons c r)

-- the operator at the text (src/hvm.c parse_term_opr_peek): (code or 99, length)
h4-opr : List Word → Word × Word
h4-opr s =
  let c = hv2-nth #0 s
      d = hv2-nth #1 s
  in if andB (%weq c #61) (%weq d #61) then (#11 , #2)
     else if andB (%weq c #33) (%weq d #61) then (#12 , #2)
     else if andB (%weq c #60) (%weq d #61) then (#14 , #2)
     else if andB (%weq c #62) (%weq d #61) then (#16 , #2)
     else if andB (%weq c #60) (%weq d #60) then (#8 , #2)
     else if andB (%weq c #62) (%weq d #62) then (#9 , #2)
     else if andB (%weq c #38) (%weq d #38) then (#5 , #2)
     else if andB (%weq c #124) (%weq d #124) then (#6 , #2)
     else if %weq c #43 then (#0 , #1) else if %weq c #45 then (#1 , #1) else if %weq c #42 then (#2 , #1)
     else if %weq c #47 then (#3 , #1) else if %weq c #37 then (#4 , #1) else if %weq c #94 then (#7 , #1)
     else if %weq c #126 then (#10 , #1) else if %weq c #60 then (#13 , #1) else if %weq c #62 then (#15 , #1)
     else (#99 , #0)

h4-prec : Word → Word
h4-prec o =
  if %weq o #6 then #1 else if %weq o #5 then #2 else if orB (%weq o #11) (%weq o #12) then #3
  else if orB (%weq o #13) (orB (%weq o #14) (orB (%weq o #15) (%weq o #16))) then #4
  else if orB (%weq o #8) (%weq o #9) then #5 else if orB (%weq o #0) (%weq o #1) then #6
  else if orB (%weq o #2) (orB (%weq o #3) (%weq o #4)) then #7 else if %weq o #7 then #8 else #0

hv2-rev : List Word → List Word
hv2-rev xs = bg-rev xs

-- the fork binders' names: (ok, state, names)
h4-forknames : Nat → H4S → List Word → Bool × (H4S × List Word)
h4-forknames zero s acc = (true , (s , hv2-rev acc))
h4-forknames (suc f) s0 acc =
  if %weq (h4-peek s0) #123 then (true , (s0 , hv2-rev acc))
  else (let s1 = h4-skip (h4-sep s0)
        in if %weq (h4-peek s1) #123 then (true , (s1 , hv2-rev acc))
           else (let n = h4-name s1 in if not (fst n) then (false , (s1 , nil)) else h4-forknames f (h4-skip (fst (snd n))) (cons (snd (snd n)) acc)))


-- a captured variable's term (src/hvm.c parse_term_sup_fork): from its binder and the fork side
h4-capof : H4B → Word → Word → Word → H4B
h4-capof b nm cl saved =
  if %wlt (h4b-sd b) #2
  then (if %weq (h4b-lab b) h4-DYN then h4b nm (%wadd (h4b-lvl b) (h4b-sd b)) #0 h4-BJV cl #0
        else h4b nm (h4b-lvl b) (h4b-lab b) (if %weq (h4b-sd b) #0 then h4-BJ0 else h4-BJ1) cl #0)
  else if andB (not (%weq (h4b-fk b) #0)) (%wlt saved #2)
  then h4b nm (h4b-lvl b) (h4b-lab b) (if %weq saved #0 then h4-BJ0 else h4-BJ1) cl #0
  else h4b nm (h4b-lvl b) #0 h4-BJV cl #0

-- [x, &y, ...]: (ok, state, captures as (name, depth, label, tag, cloned))
h4-supnames : Nat → H4S → Word → List H4B → Bool × (H4S × List H4B)
h4-supnames zero s saved acc = (false , (s , nil))
h4-supnames (suc f) s0 saved acc =
  let s = h4-skip s0
  in if %weq (h4-peek s) #93 then (true , (s , h4-revb acc nil))
     else (let cm = h4-match s "&"
               s1 = if fst cm then h4-skip (snd cm) else snd cm
               n = h4-name s1
           in if not (fst n) then (false , (s1 , nil))
              else (let lk = h4-look (fst (snd n)) (snd (snd n)) #2
                    in if not (%weq (fst lk) #0) then (false , (fst (snd n) , nil))
                       else h4-supnames f (h4-sep (h4-skip (fst (snd n)))) saved
                              (cons (h4-capof (snd lk) (snd (snd n)) (if fst cm then #1 else #0) saved) acc)))

h4-revb : List H4B → List H4B → List H4B
h4-revb nil acc = acc
h4-revb (cons x r) acc = h4-revb r (cons x acc)

-- the auto-fork's captures: every binder in scope but raw dup binders, the innermost of each
-- name kept at the place of its first
h4-setcap : List H4B → H4B → List H4B
h4-setcap nil c = nil
h4-setcap (cons x r) c = if %weq (h4b-nm x) (h4b-nm c) then cons c r else cons x (h4-setcap r c)

h4-hascap : List H4B → Word → Bool
h4-hascap nil n = false
h4-hascap (cons x r) n = if %weq (h4b-nm x) n then true else h4-hascap r n

h4-autocaps : List H4B → Word → List H4B → List H4B
h4-autocaps nil saved acc = acc
h4-autocaps (cons b r) saved acc =
  if andB (not (%weq (h4b-lab b) #0)) (andB (%weq (h4b-fk b) #0) (not (%wlt (h4b-sd b) #2)))
  then h4-autocaps r saved acc
  else (let c = h4-capof b (h4b-nm b) #1 saved
        in h4-autocaps r saved (if h4-hascap acc (h4b-nm b) then h4-setcap acc c else list-append acc (cons c nil)))

-- the heap chain of fields, as a list
fnrec h4-chain (f : Nat) (c : Word) (acc : List Word) : List Word
  zero: ret (hv2-rev acc)
  if %weq c #0
    ret (hv2-rev acc)
  x <- h4-rd c
  n <- h4-rd (%wsucc c)
  jump h4-chain f n (cons x acc)

-- n successors around t
fnrec h4-sucs (f : Nat) (t : Word) : Word
  zero: ret t
  r <- h4-ctr h4-SUC (cons t nil)
  jump h4-sucs f r

-- the list of a string's codepoints, as #Con{#Chr{c}, ...}
fn h4-strterm (cs : List Word) : Word
  jump h4-strfold (toNat (%wadd (cli-len cs) #1)) (hv2-rev cs) (h4-new h4-C00 h4-NIL #0)

fnrec h4-strfold (f : Nat) (rcs : List Word) (t : Word) : Word
  zero: ret t
  if %weq (cli-len rcs) #0
    ret t
  h <- h4-ctr h4-CHR (cons (h4-num (hv2-nth #0 rcs)) nil)
  c <- h4-ctr h4-CON (cons h (cons t nil))
  jump h4-strfold f (hv2-drop1 rcs) c

cli-len-b : List H4B → Word
cli-len-b nil = #0
cli-len-b (cons x r) = %wsucc (cli-len-b r)

-- affine checks and auto-dups of a fork's binders (mode 0 fork, 1 sup-fork core)
fnrec h4-forkfix (f : Nat) (s : H4S) (caps : List H4B) (i : Word) (d : Word) (dd : Word) (dyn : Word) (lab : Word) (bd : Word) (lt : Word) (rt : Word) : H4S × (Word × Word)
  zero: ret (s , (lt , rt))
  if %weq (cli-len-b caps) #0
    ret (s , (lt , rt))
  let c = h4-headb caps
  let lvl = %wadd (%wadd d (%wmul i dd)) #1
  u0 <- h4-uses s lt lvl (if %weq dyn #1 then h4-BJV else h4-BJ0) (if %weq dyn #1 then #0 else lab)
  u1 <- h4-uses s rt (if %weq dyn #1 then %wsucc lvl else lvl) (if %weq dyn #1 then h4-BJV else h4-BJ1) (if %weq dyn #1 then #0 else lab)
  if %weq (h4b-cl c) #1
    r0 <-[h4-dpw] h4-autodup s lt lvl bd (if %weq dyn #1 then h4-BJV else h4-BJ0) (if %weq dyn #1 then #0 else lab) u0
    r1 <-[h4-dpw] h4-autodup (fst r0) rt (if %weq dyn #1 then %wsucc lvl else lvl) bd (if %weq dyn #1 then h4-BJV else h4-BJ1) (if %weq dyn #1 then #0 else lab) u1
    jump h4-forkfix f (fst r1) (h4-tailb caps) (%wsucc i) d dd dyn lab bd (snd r0) (snd r1)
  if %wlt #1 u0
    halt (h4-perr-affine s (h4b-nm c) u0)
  if %wlt #1 u1
    halt (h4-perr-affine s (h4b-nm c) u1)
  jump h4-forkfix f s (h4-tailb caps) (%wsucc i) d dd dyn lab bd lt rt

h4-headb : List H4B → H4B
h4-headb nil = h4-none-b
h4-headb (cons b r) = b

-- a fork's binders wrapped around the body, innermost first (src/hvm.c parse_term_fork's wrap)
fnrec h4-forkwrap (f : Nat) (i : Word) (d : Word) (dd : Word) (dyn : Word) (lab : Word) (lt : Word) (body : Word) : Word
  zero: ret body
  if %weq i #0
    ret body
  let j = %wsub i #1
  let x = %wadd d (%wmul j dd)
  if %weq dyn #1
    l1 <- h4-mk1 h4-LAM (%wadd x #3) body
    l0 <- h4-mk1 h4-LAM (%wadd x #2) l1
    ddu <- h4-mk3 h4-DDU #0 lt (h4-new h4-BJV #0 (%wadd x #1)) l0
    lm <- h4-mk1 h4-LAM (%wadd x #1) ddu
    jump h4-forkwrap f j d dd dyn lab lt lm
  dup <- h4-mk2 h4-DUP lab (h4-new h4-BJV #0 (%wadd x #1)) body
  lm <- h4-mk1 h4-LAM (%wadd x #1) dup
  jump h4-forkwrap f j d dd dyn lab lt lm

-- the sup-fork core's dups around the body (src/hvm.c parse_term_sup_fork_core's wrap)
fnrec h4-capwrap (f : Nat) (rcaps : List H4B) (i : Word) (d : Word) (dd : Word) (dyn : Word) (lab : Word) (lt : Word) (body : Word) : Word
  zero: ret body
  if %weq (cli-len-b rcaps) #0
    ret body
  let c = h4-headb rcaps
  let j = %wsub i #1
  let vr = h4-new (h4b-fk c) (h4b-lab c) (h4b-lvl c)
  if %weq dyn #1
    l1 <- h4-mk1 h4-LAM (%wadd (%wadd d (%wmul j dd)) #2) body
    l0 <- h4-mk1 h4-LAM (%wadd (%wadd d (%wmul j dd)) #1) l1
    r <- h4-mk3 h4-DDU #0 lt vr l0
    jump h4-capwrap f (h4-tailb rcaps) j d dd dyn lab lt r
  r <- h4-mk2 h4-DUP lab vr body
  jump h4-capwrap f (h4-tailb rcaps) j d dd dyn lab lt r


h4-pushcaps : H4S → List H4B → Word → Word → Word → Word → H4S
h4-pushcaps s nil i d dd lab = s
h4-pushcaps s (cons c r) i d dd lab = h4-pushcaps (h4-push s (h4b-nm c) (%wadd (%wadd d (%wmul i dd)) #1) lab #1 (h4b-cl c) #2) r (%wsucc i) d dd lab

h4-pushfork : H4S → List Word → Word → Word → Word → Word → H4S
h4-pushfork s nil i d dd lab = s
h4-pushfork s (cons n r) i d dd lab = h4-pushfork (h4-push s n (%wadd (%wadd d (%wmul i dd)) #2) lab #1 #0 #2) r (%wsucc i) d dd lab

h4-popn : H4S → Nat → H4S
h4-popn s zero = s
h4-popn s (suc n) = h4-popn (h4-pop s) n

h4-mkcaps : List Word → List H4B
h4-mkcaps nil = nil
h4-mkcaps (cons n r) = cons (h4b n #0 #0 #0 #0 #0) (h4-mkcaps r)
