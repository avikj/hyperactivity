b2-pvfg : Word → Nat → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pvfg mm_ zero ws fl ob j n q kq_ =
  kq_ (h4-depl mm_ (ob))
b2-pvfg mm_ (suc f) ws fl ob j n q kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_7051 = ws in let j_7052 = j in scmd (w-load ((b2-a mm_ (%wadd a_7051 (%wsucc j_7052))))) (λ x_7050 → let mm_7053 = b2-dep mm_ x_7050 in let w = x_7050 in let t_7055 = w in let j_7056 = fl in scmd (w-load ((b2-a mm_7053 (%wadd t_7055 (%wadd #2 j_7056))))) (λ x_7054 → let mm_7057 = b2-dep mm_7053 x_7054 in let x = x_7054 in let a_7058 = ob in let j_7059 = j in let v_7060 = (the Word (if %weq fl #2 then b2-qdem q x else x)) in scmd (w-store ((b2-a mm_7057 (%wadd a_7058 (%wsucc j_7059)))) (v_7060)) (λ uu_7061 → let mm_7062 = hv2-u mm_7057 uu_7061 in b2-pvfg mm_7062 f ws fl ob (%wsucc j) n q kq_))))
