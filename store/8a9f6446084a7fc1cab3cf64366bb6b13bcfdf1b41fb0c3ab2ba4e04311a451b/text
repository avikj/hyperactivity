b2-pterms : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pterms mm_ zero xs ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-pterms mm_ (suc f) xs ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_5743 = xs in let j_5744 = j in scmd (w-load ((b2-a mm_ (%wadd a_5743 (%wsucc j_5744))))) (λ x_5742 → let mm_5745 = b2-dep mm_ x_5742 in let x = x_5742 in b2-pterm mm_5745 x #0 (λ t → let mm_5746 = b2-dep mm_5745 t in let a_5747 = ob in let j_5748 = j in let v_5749 = t in scmd (w-store ((b2-a mm_5746 (%wadd a_5747 (%wsucc j_5748)))) (v_5749)) (λ uu_5750 → let mm_5751 = hv2-u mm_5746 uu_5750 in b2-pterms mm_5751 f xs ob (%wsucc j) n kq_))))
