sf-racah-from : Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-racah-from a1 a2 a3 a4 b1 b2 b3 =
  (λ tmin tmax → if leb tmin tmax
    then sf-racah-loop (suc (monus tmax tmin)) a1 a2 a3 a4 b1 b2 b3 tmin bq-zero
    else bq-zero)
    (nat-max (nat-max a1 a2) (nat-max a3 a4))
    (nat-min b1 (nat-min b2 b3))
