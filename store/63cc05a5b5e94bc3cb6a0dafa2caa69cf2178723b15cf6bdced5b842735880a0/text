ief-do : List Word → List Word → List Word → List Word
ief-do op ta tb =
  let a = ief-hex ta #0
      b = ief-hex tb #0
  in if cli-eq op "a" then ief-hexs (ief-add a b)
     else if cli-eq op "s" then ief-hexs (ief-sub a b)
     else if cli-eq op "m" then ief-hexs (ief-mul a b)
     else if cli-eq op "d" then ief-hexs (ief-div a b)
     else if cli-eq op "r" then ief-hexs (ief-rem a b)
     else if cli-eq op "e" then ief-hexs (ief-bw (ief-eq a b))
     else if cli-eq op "l" then ief-hexs (ief-bw (ief-lt a b))
     else if cli-eq op "S" then ief-hexs (ief-sin a)
     else if cli-eq op "T" then ief-hexs (ief-tan a)
     else if cli-eq op "L" then ief-hexs (ief-lnv a)
     else if cli-eq op "A" then ief-hexs (ief-atan2 a b)
     else if cli-eq op "P" then ief-hexs (ief-pow a b)
     else if cli-eq op "p" then ief-hexs (ief-parse ta)
     else if cli-eq op "w" then ief-show a
     else if cli-eq op "u" then ief-hexs (ief-to-u24 a)
     else if cli-eq op "i" then ief-hexs (ief-to-i24 a)
     else if cli-eq op "U" then ief-hexs (ief-of-u24 a)
     else if cli-eq op "I" then ief-hexs (ief-of-i24 a)
     else if cli-eq op "f" then ief-hexs (ief-f24 a)
     else "?"
