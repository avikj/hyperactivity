  kq_ (h4-depl mm_ (#0))
b2-linestart mm_ (suc f) s i kq_ =
  if (%weq i #0) then (kq_ (h4-depl mm_ (#0))) else (let a_6402 = s in let j_6403 = (%wsub i #1) in scmd (w-load ((b2-a mm_ (%wadd a_6402 (%wsucc j_6403))))) (λ x_6401 → let mm_6404 = b2-dep mm_ x_6401 in let c = x_6401 in if (%weq c #10) then (kq_ (h4-depl mm_6404 (i))) else (b2-linestart mm_6404 f s (%wsub i #1) kq_)))
