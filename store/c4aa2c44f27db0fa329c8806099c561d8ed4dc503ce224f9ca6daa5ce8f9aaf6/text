rh-le-add-mono : (a1 b1 a2 b2 : Nat) →
  rh-le a1 b1 ≡ true → rh-le a2 b2 ≡ true →
  rh-le (plus a1 a2) (plus b1 b2) ≡ true
rh-le-add-mono zero b1 a2 b2 h1 h2 =
  rh-le-trans a2 (plus b1 a2) (plus b1 b2)
    (rh-le-add-zero-l b1 a2)
    (rh-le-add-l b1 a2 b2 h2)
rh-le-add-mono (suc a1) zero a2 b2 h1 h2 = rh-absurd-f h1
rh-le-add-mono (suc a1) (suc b1) a2 b2 h1 h2 = rh-le-add-mono a1 b1 a2 b2 h1 h2
