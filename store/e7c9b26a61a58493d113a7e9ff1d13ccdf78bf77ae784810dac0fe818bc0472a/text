-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_6743 = tel in let j_6744 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_6743 (%wsucc j_6744))))) (λ x_6742 → let mm_6745 = b2-dep mm_ x_6742 in let c = x_6742 in let i_6747 = c in scmd (w-load ((b2-a mm_6745 i_6747))) (λ x_6746 → let mm_6748 = b2-dep mm_6745 x_6746 in let q = x_6746 in let i_6750 = (%wadd c #1) in scmd (w-load ((b2-a mm_6748 i_6750))) (λ x_6749 → let mm_6751 = b2-dep mm_6748 x_6749 in let k = x_6749 in let i_6753 = (%wadd c #2) in scmd (w-load ((b2-a mm_6751 i_6753))) (λ x_6752 → let mm_6754 = b2-dep mm_6751 x_6752 in let i = x_6752 in let i_6756 = (%wadd c #3) in scmd (w-load ((b2-a mm_6754 i_6756))) (λ x_6755 → let mm_6757 = b2-dep mm_6754 x_6755 in let vT = x_6755 in let i_6759 = (%wadd c #4) in scmd (w-load ((b2-a mm_6757 i_6759))) (λ x_6758 → let mm_6760 = b2-dep mm_6757 x_6758 in let s = x_6758 in b2-All mm_6760 q k i vT e s (λ a → let mm_6761 = b2-dep mm_6760 a in b2-telebindg mm_6761 f tel (%wsub j #1) a kq_))))))))
