-- (B) Exact 2-simplex 4D Euclidean EPRL self-dual BF limit (gamma = 1, J = 1, Jp = 1, Jm = 0):
-- agrees identically with 2-simplex Ooguri BF on both (0,0,0,0) and (2,2,2,2)!
sf2-eprl-bf-limit : both
  (sf-bq-eq (sf2-eprl-two-diag 1 1 0 0 0 0 0) (sf2-bf-two-diag 1 0 0 0 0))
  (sf-bq-eq (sf2-eprl-two-diag 1 1 0 2 2 2 2) (sf2-bf-two-diag 1 2 2 2 2)) ≡ true
sf2-eprl-bf-limit = refl
