bst-thm-dovetail-ge-a : (a b : Nat) → hm-le a (bst-pair a b) ≡ true
bst-thm-dovetail-ge-a a b =
  hm-le-trans a (hm-add a b) (bst-pair a b)
    (bst-le-add-r a b)
    (hm-le-trans (hm-add a b) (bst-tri (hm-add a b)) (bst-pair a b)
      (bst-thm-tri-ge (hm-add a b))
      (bst-le-add-r (bst-tri (hm-add a b)) b))
