ief-words : List Word → List Word → List (List Word)
ief-words nil cur = if %weq (cli-len cur) #0 then nil else cons (bg-rev cur) nil
ief-words (cons c r) cur =
  if %weq c #32 then (if %weq (cli-len cur) #0 then ief-words r nil else cons (bg-rev cur) (ief-words r nil))
  else ief-words r (cons c cur)
