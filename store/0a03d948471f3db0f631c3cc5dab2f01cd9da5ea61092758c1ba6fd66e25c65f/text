            const x = n.step * cw + 1, y = (rows - 1 - n.row) * rh + 1.5, nw = Math.max(4, n.dur * cw - 2);
            g.fillStyle = otr.color + '26'; g.beginPath(); g.roundRect(x, y, nw, rh - 3, 2); g.fill();
