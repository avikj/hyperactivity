        g.fillStyle = 'rgba(255,10,148,0.12)';
        g.beginPath();
        g.moveTo(0, ty + TRACK_H);
        g.lineTo(0, ty + pad + (1 - pts[0].val) * usableH);
        pts.forEach(p => g.lineTo(barToX(p.bar, W), ty + pad + (1 - p.val) * usableH));
        g.lineTo(W, ty + pad + (1 - pts[pts.length - 1].val) * usableH);
        g.lineTo(W, ty + TRACK_H);
        g.closePath(); g.fill();
        g.strokeStyle = '#ff0a94'; g.lineWidth = 1.8;
        g.beginPath();
        g.moveTo(0, ty + pad + (1 - pts[0].val) * usableH);
        pts.forEach(p => g.lineTo(barToX(p.bar, W), ty + pad + (1 - p.val) * usableH));
        g.lineTo(W, ty + pad + (1 - pts[pts.length - 1].val) * usableH);
        g.stroke();
        pts.forEach(p => {
          const px = barToX(p.bar, W), py = ty + pad + (1 - p.val) * usableH;
          g.fillStyle = '#fff'; g.strokeStyle = '#ff0a94'; g.lineWidth = 1.8;
          g.beginPath(); g.arc(px, py, 4, 0, Math.PI * 2); g.fill(); g.stroke();
        });
        g.restore();
      });
    }

    // Marquee selection box
    if (arrMarquee) {
      const rx = Math.min(arrMarquee.x0, arrMarquee.x1), ry = Math.min(arrMarquee.y0, arrMarquee.y1);
      const rw = Math.abs(arrMarquee.x1 - arrMarquee.x0), rh = Math.abs(arrMarquee.y1 - arrMarquee.y0);
      g.fillStyle = 'rgba(255,10,148,0.15)'; g.strokeStyle = '#ff0a94'; g.lineWidth = 1.2;
      g.fillRect(rx, ry, rw, rh); g.strokeRect(rx, ry, rw, rh);
    }

    // Continuous playhead spanning all tracks
    const px = barToX(currentPlayStep() / 16, W);
    g.strokeStyle = '#ff0a94'; g.lineWidth = 1.6;
    g.beginPath(); g.moveTo(px, 0); g.lineTo(px, H); g.stroke();
  }
  function drawAllLanes() { drawArrangement(); }

  function hitArr(mx, my, W) {
    const ti = Math.floor(my / TRACK_H);
    if (ti < 0 || ti >= state.tracks.length) return { kind:'empty', ti: Math.max(0, state.tracks.length - 1), trk: state.tracks[state.tracks.length - 1] };
    const trk = state.tracks[ti], inY = my - ti * TRACK_H, bw = W / state.viewBars;
    if (state.autoMode && trk.auto) {
      const pad = 6, usableH = TRACK_H - pad * 2;
      for (let i = 0; i < trk.auto.length; i++) {
        const px = barToX(trk.auto[i].bar, W), py = ti * TRACK_H + pad + (1 - trk.auto[i].val) * usableH;
        if (Math.hypot(mx - px, my - py) <= 9) return { kind:'autoNode', trk, ti, idx: i };
      }
      return { kind:'autoAdd', trk, ti };
    }
    for (let i = state.clips.length - 1; i >= 0; i--) {
      const cl = state.clips[i]; if (cl.trackId !== trk.id) continue;
      const x0 = barToX(cl.startBar, W), x1 = barToX(cl.startBar + cl.lenBars, W), w = x1 - x0;
      if (mx >= x0 && mx <= x1 && inY >= 2 && inY <= TRACK_H - 2) {
        const fiX = x0 + Math.min(w * 0.45, (cl.fadeIn || 0) * bw);
        const foX = x1 - Math.min(w * 0.45, (cl.fadeOut || 0) * bw);
        if (inY <= 12 && w >= 24 && Math.abs(mx - fiX) <= 7) return { kind:'clip', cl, mode:'fadeIn', ti };
        if (inY <= 12 && w >= 24 && Math.abs(mx - foX) <= 7) return { kind:'clip', cl, mode:'fadeOut', ti };
        if (mx <= x0 + Math.min(8, w * 0.25)) return { kind:'clip', cl, mode:'resizeL', ti };
        if (mx >= x1 - Math.min(8, w * 0.25)) return { kind:'clip', cl, mode:'resizeR', ti };
        return { kind:'clip', cl, mode:'move', ti };
      }
    }
    return { kind:'empty', ti, trk };
  }

  ac.addEventListener('pointermove', (e) => {
    const r = ac.getBoundingClientRect(), W = r.width, mx = e.clientX - r.left, my = e.clientY - r.top;
    if (arrDrag) {
      const free = e.metaKey || e.ctrlKey;
      if (arrDrag.kind === 'autoNode') {
        const pt = arrDrag.trk.auto[arrDrag.idx];
        const pad = 6, usableH = TRACK_H - pad * 2;
        pt.bar = Math.max(0, Math.min(TOTAL_BARS, snapBar(xToBar(mx, W), free)));
        pt.val = Math.max(0, Math.min(1, 1 - (my - arrDrag.ti * TRACK_H - pad) / usableH));
        arrDrag.trk.auto.sort((a, b) => a.bar - b.bar);
        arrDrag.idx = arrDrag.trk.auto.indexOf(pt);
        arrDrag.moved = true; drawArrangement(); return;
      }
      if (arrDrag.kind === 'marquee') {
        arrMarquee.x1 = mx; arrMarquee.y1 = my;
        const rx0 = Math.min(arrMarquee.x0, arrMarquee.x1), rx1 = Math.max(arrMarquee.x0, arrMarquee.x1);
        const ry0 = Math.min(arrMarquee.y0, arrMarquee.y1), ry1 = Math.max(arrMarquee.y0, arrMarquee.y1);
        if (Math.hypot(rx1 - rx0, ry1 - ry0) > 4) {
          arrDrag.moved = true;
          if (!arrDrag.shift) state.selClips.clear();
          state.clips.forEach(cl => {
            const ti = state.tracks.findIndex(t => t.id === cl.trackId); if (ti < 0) return;
            const cx0 = barToX(cl.startBar, W), cx1 = barToX(cl.startBar + cl.lenBars, W);
            const cy0 = ti * TRACK_H + 3, cy1 = (ti + 1) * TRACK_H - 3;
            if (cx1 >= rx0 && cx0 <= rx1 && cy1 >= ry0 && cy0 <= ry1) state.selClips.add(cl.id);
          });
          if (state.selClips.size) {
            const firstId = Array.from(state.selClips)[0], fc = state.clips.find(c => c.id === firstId);
            if (fc) { state.selClipId = fc.id; state.selTrk = fc.trackId; }
          }
        }
        drawArrangement(); return;
      }
      if (arrDrag.kind === 'clip') {
        const curBar = xToBar(mx, W), dBarRaw = curBar - arrDrag.startBar;
        const dBar = snapBar(dBarRaw, free);
        if (arrDrag.mode === 'move') {
          const curTi = Math.max(0, Math.min(state.tracks.length - 1, Math.floor(my / TRACK_H)));
