  }, { passive: false });

  // ── Persistent Zero-DOM-Churn Single-Canvas Arrangement Engine ──
  const ac = $('arrCanvas');
  let arrDrag = null, arrMarquee = null, arrHover = null;

  function renderTrackHeaders() {
    $('libCount').textContent = `${state.tracks.length} tracks`;
    const box = $('arrHeaders'); box.innerHTML = '';
    state.tracks.forEach((tr, ti) => {
      const head = document.createElement('div');
      head.className = 'trk-head' + (state.selTrk === tr.id ? ' sel-trk' : '');
      head.dataset.tid = String(tr.id);
      head.style.borderLeftColor = tr.color;
      head.innerHTML = `<div class="trk-top"><span class="trk-name" title="Double-click to rename">${tr.name}</span><div class="trk-btns"><button class="t-mini m ${tr.mute?'on':''}" title="Mute (M)">M</button><button class="t-mini s ${tr.solo?'on':''}" title="Solo (Shift+S)">S</button><button class="t-mini r ${tr.arm?'on':''}" title="Arm">●</button></div></div><div class="trk-bot"><input class="trk-vol" type="range" min="0" max="1" step="0.01" value="${tr.gain}" title="Volume (dbl-click resets)"><div class="trk-meter"><i data-tm="${ti}"></i></div></div>`;
      head.onclick = (e) => {
        if (e.target.tagName === 'BUTTON' || e.target.tagName === 'INPUT') return;
        state.focusZone = 'arr'; selectTrack(tr.id);
      };
      const nameEl = head.querySelector('.trk-name');
      nameEl.ondblclick = (e) => {
        e.stopPropagation();
        const inp = document.createElement('input');
        inp.value = tr.name;
        inp.style.cssText = 'width:86px;background:var(--bg0);color:var(--ink);border:1px solid var(--pink);border-radius:2px;font-size:11px;padding:0 3px';
        nameEl.replaceWith(inp); inp.focus(); inp.select();
        const commit = () => {
          const nv = inp.value.trim(); if (nv) tr.name = nv;
          renderTrackHeaders(); renderMixer(); renderStemDeck(); syncSelectionUI(); snapCas('rename-track');
        };
        inp.onblur = commit;
        inp.onkeydown = (ev) => { if (ev.key === 'Enter') inp.blur(); if (ev.key === 'Escape') { inp.value = tr.name; inp.blur(); } };
      };
      head.querySelector('.m').onclick = () => { tr.mute=!tr.mute; updateHeaderSelection(); renderMixer(); pushMix(); };
      head.querySelector('.s').onclick = () => { tr.solo=!tr.solo; updateHeaderSelection(); renderMixer(); pushMix(); };
      head.querySelector('.r').onclick = () => { tr.arm=!tr.arm; updateHeaderSelection(); renderMixer(); };
      const vol = head.querySelector('.trk-vol');
      vol.oninput = (e) => { tr.gain=parseFloat(e.target.value); pushMix(); renderStemDeck(); renderMixer(); };
      vol.ondblclick = () => { tr.gain = 0.85; vol.value = 0.85; pushMix(); renderStemDeck(); renderMixer(); };
      box.appendChild(head);
    });
    const totalH = Math.max(state.tracks.length * TRACK_H, 224);
    ac.style.height = totalH + 'px';
    drawRuler(); drawAllLanes();
  }
  function updateHeaderSelection() {
    const box = $('arrHeaders');
    if (box.children.length !== state.tracks.length) { renderTrackHeaders(); return; }
    state.tracks.forEach((tr, ti) => {
      const h = box.children[ti]; if (!h) return;
      h.classList.toggle('sel-trk', state.selTrk === tr.id);
      h.querySelector('.m').classList.toggle('on', tr.mute);
      h.querySelector('.s').classList.toggle('on', tr.solo);
      h.querySelector('.r').classList.toggle('on', tr.arm);
      const v = h.querySelector('.trk-vol');
      if (document.activeElement !== v) v.value = tr.gain;
    });
  }
  function renderArrangement() { renderTrackHeaders(); }

  function drawArrangement() {
    if (!ac || !ac.clientWidth) return;
    const totalH = Math.max(TRACK_H, state.tracks.length * TRACK_H);
    if (ac.style.height !== totalH + 'px') ac.style.height = totalH + 'px';
    ac.width = ac.clientWidth; ac.height = totalH;
    const g = ac.getContext('2d'), W = ac.width, H = ac.height;
    const bw = W / state.viewBars;
    const dark = document.documentElement.classList.contains('dark');
    g.clearRect(0, 0, W, H);

    // Track row backgrounds & dividers
    state.tracks.forEach((tr, ti) => {
      const ty = ti * TRACK_H;
      if (state.selTrk === tr.id) {
        g.fillStyle = dark ? 'rgba(255,10,148,0.038)' : 'rgba(214,0,122,0.04)';
        g.fillRect(0, ty, W, TRACK_H);
      } else if (ti % 2 === 1) {
        g.fillStyle = dark ? 'rgba(255,255,255,0.012)' : 'rgba(0,0,0,0.012)';
        g.fillRect(0, ty, W, TRACK_H);
      }
      g.strokeStyle = dark ? 'rgba(255,255,255,0.075)' : 'rgba(0,0,0,0.09)';
      g.beginPath(); g.moveTo(0, ty + TRACK_H - 0.5); g.lineTo(W, ty + TRACK_H - 0.5); g.stroke();
    });

    // Bar & beat grid lines
    const firstB = Math.max(0, Math.floor(state.scrollBar));
    const lastB = Math.min(TOTAL_BARS, Math.ceil(state.scrollBar + state.viewBars));
    for (let b = firstB; b <= lastB; b++) {
      const x = barToX(b, W);
      if (b < TOTAL_BARS && Math.floor(b / 4) % 2 === 1) {
        g.fillStyle = dark ? 'rgba(255,255,255,0.016)' : 'rgba(0,0,0,0.018)';
        g.fillRect(x, 0, bw, H);
      }
      g.strokeStyle = (b % 4 === 0) ? (dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.12)') : (dark ? 'rgba(255,255,255,0.045)' : 'rgba(0,0,0,0.05)');
      g.beginPath(); g.moveTo(x, 0); g.lineTo(x, H); g.stroke();
      if (b < TOTAL_BARS && state.viewBars <= 12) {
        for (let bt = 1; bt < 4; bt++) {
          const bx = barToX(b + bt * 0.25, W);
          g.strokeStyle = dark ? 'rgba(255,255,255,0.024)' : 'rgba(0,0,0,0.03)';
          g.beginPath(); g.moveTo(bx, 0); g.lineTo(bx, H); g.stroke();
        }
      }
    }

    // Draw all clips across all tracks
    state.clips.forEach(cl => {
      const ti = state.tracks.findIndex(t => t.id === cl.trackId); if (ti < 0) return;
      const trk = state.tracks[ti], ty = ti * TRACK_H;
      const x = barToX(cl.startBar, W) + 1, w = Math.max(6, cl.lenBars * bw - 2);
      if (x + w < 0 || x > W) return;
      const isSel = state.selClips.has(cl.id), isPrimary = (cl.id === state.selClipId);
      const y = ty + 3, ch = TRACK_H - 6;

      g.save();
      g.beginPath(); g.roundRect(x, y, w, ch, 3); g.clip();
      g.fillStyle = cl.muted ? (dark ? '#2b2b34' : '#c6c6ce') : (trk.color + (isSel ? 'dd' : 'a0'));
      g.fillRect(x, y, w, ch);
      g.fillStyle = cl.muted ? 'rgba(0,0,0,0.22)' : 'rgba(0,0,0,0.34)';
      g.fillRect(x, y, w, 14);
      g.fillStyle = cl.muted ? '#aaa' : '#fff'; g.font = '700 9.5px monospace';
      g.fillText((cl.muted ? '[M] ' : '') + cl.name, x + 5, y + 10.5);

      // Audio peaks OR miniature MIDI preview
      if (cl.audioPeaks && cl.audioPeaks.length) {
        const midY = y + 14 + (ch - 14) / 2, ampH = (ch - 18) / 2;
        g.fillStyle = cl.muted ? 'rgba(255,255,255,0.25)' : 'rgba(255,255,255,0.82)';
        const nP = cl.audioPeaks.length, stepW = w / nP;
        for (let i = 0; i < nP; i++) {
          const ph = Math.max(1.5, cl.audioPeaks[i] * ampH);
          g.fillRect(x + i * stepW, midY - ph, Math.max(1, stepW - 0.8), ph * 2);
        }
      } else {
        const maxR = trk.kind === 'drums' ? DRUM_ROWS.length : 24;
        const reps = Math.ceil(cl.lenBars);
        g.fillStyle = cl.muted ? 'rgba(255,255,255,0.28)' : 'rgba(255,255,255,0.88)';
        for (let rep = 0; rep < reps; rep++) {
          cl.notes.forEach(n => {
            const nx = x + rep * bw + (n.step / 16) * bw;
            if (nx >= x + w) return;
            const nw = Math.max(2, Math.min((n.dur / 16) * bw - 1, x + w - nx - 1));
            const ny = y + ch - 4 - (n.row / maxR) * (ch - 20);
            g.fillRect(nx, ny, nw, 2.4);
          });
        }
      }

      // Fade-in & fade-out overlays
      if (cl.fadeIn > 0.01) {
        const fiW = Math.min(w * 0.5, cl.fadeIn * bw);
        g.fillStyle = 'rgba(0,0,0,0.42)';
        g.beginPath(); g.moveTo(x, y + 14); g.lineTo(x + fiW, y + 14); g.lineTo(x, y + ch); g.closePath(); g.fill();
        g.strokeStyle = 'rgba(255,255,255,0.75)'; g.lineWidth = 1.2;
        g.beginPath(); g.moveTo(x, y + ch); g.lineTo(x + fiW, y + 14); g.stroke();
      }
      if (cl.fadeOut > 0.01) {
        const foW = Math.min(w * 0.5, cl.fadeOut * bw);
        g.fillStyle = 'rgba(0,0,0,0.42)';
        g.beginPath(); g.moveTo(x + w, y + 14); g.lineTo(x + w - foW, y + 14); g.lineTo(x + w, y + ch); g.closePath(); g.fill();
        g.strokeStyle = 'rgba(255,255,255,0.75)'; g.lineWidth = 1.2;
        g.beginPath(); g.moveTo(x + w - foW, y + 14); g.lineTo(x + w, y + ch); g.stroke();
      }
      g.restore();

      // Selection border & fade corner handles
      if (isSel) {
        g.strokeStyle = isPrimary ? '#ffffff' : 'rgba(255,255,255,0.72)';
        g.lineWidth = isPrimary ? 1.8 : 1.2;
        g.beginPath(); g.roundRect(x + 0.5, y + 0.5, w - 1, ch - 1, 3); g.stroke();
        const fiX = x + Math.min(w * 0.45, (cl.fadeIn || 0) * bw);
        const foX = x + w - Math.min(w * 0.45, (cl.fadeOut || 0) * bw);
        g.fillStyle = '#fff';
        g.fillRect(fiX - 2.5, y + 1.5, 5, 5);
        g.fillRect(foX - 2.5, y + 1.5, 5, 5);
      }
    });

    // Automation Curves Overlay (when Auto mode is active)
    if (state.autoMode) {
      state.tracks.forEach((tr, ti) => {
        if (!tr.auto || !tr.auto.length) return;
        const ty = ti * TRACK_H, pad = 6, usableH = TRACK_H - pad * 2;
