  // ── Pro Piano Roll (Hover Cursors, Select/Move Multi-Notes, Edge Resize, Marquee Box, Dbl-Click Draw, Velocity Paint) ──
  let marquee = null;
  function renderPianoKeys() {
    const box = $('prKeys'); box.innerHTML = '';
    const dm = isDrumMode(), rows = rowCount(), sc = SCALES[state.scale];
    for (let r = rows - 1; r >= 0; r--) {
