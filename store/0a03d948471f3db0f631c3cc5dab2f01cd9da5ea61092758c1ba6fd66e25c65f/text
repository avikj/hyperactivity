  function makeKnob(parent, label, min, max, val, fmt, onChange) {
    const wrap = document.createElement('div'); wrap.className = 'knob-wrap';
    wrap.innerHTML = `<svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="15" fill="none" stroke="var(--bg4)" stroke-width="3.2"/><path class="k-arc" fill="none" stroke="var(--pink)" stroke-width="3.2" stroke-linecap="round"/><circle cx="20" cy="20" r="10.5" fill="var(--bg3)" stroke="var(--line-s)" stroke-width="1"/><line class="k-ptr" x1="20" y1="20" x2="20" y2="11" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/></svg><span class="knob-lbl">${label}</span><span class="knob-val"></span>`;
    const arc = wrap.querySelector('.k-arc'), ptr = wrap.querySelector('.k-ptr'), vEl = wrap.querySelector('.knob-val');
    let cur = val, defV = val;
    const draw = () => {
      const t = Math.max(0, Math.min(1, (cur - min) / (max - min)));
      const a0 = 135*Math.PI/180, a1 = (135 + t*270)*Math.PI/180;
      arc.setAttribute('d', `M ${(20+15*Math.cos(a0)).toFixed(1)} ${(20+15*Math.sin(a0)).toFixed(1)} A 15 15 0 ${t>0.5?1:0} 1 ${(20+15*Math.cos(a1)).toFixed(1)} ${(20+15*Math.sin(a1)).toFixed(1)}`);
      ptr.setAttribute('transform', `rotate(${(-135+t*270).toFixed(1)} 20 20)`);
      vEl.textContent = fmt(cur);
    };
    draw();
    wrap.onmousedown = (e) => {
      e.preventDefault(); const y0 = e.clientY, v0 = cur;
      const mv = (ev) => { const scale = ev.shiftKey ? 550 : 110; cur = Math.max(min, Math.min(max, v0 + ((y0 - ev.clientY) / scale) * (max - min))); draw(); onChange(cur); };
