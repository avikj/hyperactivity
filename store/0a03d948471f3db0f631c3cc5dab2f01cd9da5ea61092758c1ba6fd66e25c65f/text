  const xToBar = (x, W) => state.scrollBar + (x / W) * state.viewBars;
  const snapBar = (b, free) => free ? Math.round(b * 16) / 16 : Math.round(b * 4) / 4;

  function zoomTimeline(factor, anchorFrac = 0.25) {
    const anchorBar = state.scrollBar + anchorFrac * state.viewBars;
    state.viewBars = Math.max(4, Math.min(TOTAL_BARS, state.viewBars * factor));
    state.scrollBar = anchorBar - anchorFrac * state.viewBars;
    clampScroll(); drawRuler(); drawAllLanes();
  }
  $('btnZoomIn').onclick = () => zoomTimeline(0.75);
  $('btnZoomOut').onclick = () => zoomTimeline(1.3333);
  $('btnAutoMode').onclick = () => {
    state.autoMode = !state.autoMode;
    $('btnAutoMode').classList.toggle('on', state.autoMode);
    drawAllLanes();
    toast(state.autoMode ? 'Automation edit ON (click curve to add, dbl-click to remove)' : 'Automation edit OFF');
  };

  function drawRuler() {
    const c = $('rulerCanvas'); if (!c || !c.clientWidth) return;
    c.width = c.clientWidth; c.height = c.clientHeight;
    const g = c.getContext('2d'), W = c.width, H = c.height;
    const dark = document.documentElement.classList.contains('dark');
    g.clearRect(0, 0, W, H);
    // Loop brace
    const lx0 = barToX(state.loopStart, W), lx1 = barToX(state.loopEnd, W);
    g.fillStyle = state.loopOn ? 'rgba(255,10,148,0.26)' : 'rgba(128,128,128,0.14)';
    g.fillRect(lx0, 0, Math.max(2, lx1 - lx0), 10);
    g.fillStyle = state.loopOn ? '#ff0a94' : '#777';
    g.fillRect(lx0, 0, 5, 10); g.fillRect(lx1 - 5, 0, 5, 10);
    const firstB = Math.max(0, Math.floor(state.scrollBar));
    const lastB = Math.min(TOTAL_BARS, Math.ceil(state.scrollBar + state.viewBars));
    for (let b = firstB; b <= lastB; b++) {
      const x = barToX(b, W);
      g.strokeStyle = dark ? 'rgba(255,255,255,0.16)' : 'rgba(0,0,0,0.16)';
      g.beginPath(); g.moveTo(x, 10); g.lineTo(x, H); g.stroke();
      if (b < TOTAL_BARS) {
        g.fillStyle = dark ? '#8b8b9a' : '#646470'; g.font = '600 9.5px monospace';
        g.fillText(String(b + 1), x + 4, 21);
        if (state.viewBars <= 12) {
          for (let bt = 1; bt < 4; bt++) {
            const bx = barToX(b + bt * 0.25, W);
            g.strokeStyle = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.07)';
            g.beginPath(); g.moveTo(bx, 16); g.lineTo(bx, H); g.stroke();
          }
        }
      }
    }
    const px = barToX(currentPlayStep() / 16, W);
    g.fillStyle = '#ff0a94'; g.beginPath(); g.moveTo(px - 4.5, 10); g.lineTo(px + 4.5, 10); g.lineTo(px, 19); g.fill();
  }
  const rc = $('rulerCanvas');
  let rcDrag = null;
  rc.addEventListener('pointermove', (e) => {
    const r = rc.getBoundingClientRect(), W = r.width, x = e.clientX - r.left, y = e.clientY - r.top;
    if (rcDrag) {
      const b = xToBar(x, W);
      if (rcDrag.mode === 'loopL') state.loopStart = Math.max(0, Math.min(state.loopEnd - 1, Math.round(b)));
      else if (rcDrag.mode === 'loopR') state.loopEnd = Math.max(state.loopStart + 1, Math.min(TOTAL_BARS, Math.round(b)));
      else if (rcDrag.mode === 'loopMove') {
        const dB = Math.round(b - rcDrag.startB), len = rcDrag.origE - rcDrag.origS;
        const ns = Math.max(0, Math.min(TOTAL_BARS - len, rcDrag.origS + dB));
        state.loopStart = ns; state.loopEnd = ns + len;
      } else {
        jumpPlayhead(Math.max(0, Math.min(TOTAL_BARS * 16 - 0.5, b * 16)));
      }
      drawRuler(); drawAllLanes(); return;
    }
    const lx0 = barToX(state.loopStart, W), lx1 = barToX(state.loopEnd, W);
    if (y <= 11 && (Math.abs(x - lx0) < 8 || Math.abs(x - lx1) < 8)) rc.style.cursor = 'ew-resize';
    else if (y <= 11 && x > lx0 + 7 && x < lx1 - 7) rc.style.cursor = 'grab';
    else rc.style.cursor = 'pointer';
  });
  rc.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    rc.setPointerCapture(e.pointerId);
    const r = rc.getBoundingClientRect(), W = r.width, x = e.clientX - r.left, y = e.clientY - r.top;
    const lx0 = barToX(state.loopStart, W), lx1 = barToX(state.loopEnd, W);
    if (y <= 11 && Math.abs(x - lx0) < 8) rcDrag = { mode:'loopL' };
    else if (y <= 11 && Math.abs(x - lx1) < 8) rcDrag = { mode:'loopR' };
    else if (y <= 11 && x > lx0 + 7 && x < lx1 - 7) rcDrag = { mode:'loopMove', startB: xToBar(x, W), origS: state.loopStart, origE: state.loopEnd };
    else { rcDrag = { mode:'scrub' }; jumpPlayhead(Math.max(0, Math.min(TOTAL_BARS * 16 - 0.5, xToBar(x, W) * 16))); }
  });
  rc.addEventListener('pointerup', (e) => { if (rcDrag) { rcDrag = null; try { rc.releasePointerCapture(e.pointerId); } catch (_) {} } });
  rc.addEventListener('wheel', (e) => {
    const r = rc.getBoundingClientRect();
    if (e.metaKey || e.ctrlKey) { e.preventDefault(); zoomTimeline(e.deltaY > 0 ? 1.15 : 0.87, (e.clientX - r.left) / r.width); }
    else if (e.shiftKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
      e.preventDefault();
