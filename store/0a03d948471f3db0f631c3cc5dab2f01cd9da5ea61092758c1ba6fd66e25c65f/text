  const EQ_COLS = ['#ff0a94','#4da3ff','#26d07c','#f59e0b'];
  function drawEq() {
    const c = $('eqCanvas'); if (!c) return;
    const g = c.getContext('2d'), W = c.width, H = c.height; g.clearRect(0,0,W,H);
    if (analyser) {
      const bins = new Uint8Array(analyser.frequencyBinCount); analyser.getByteFrequencyData(bins);
      g.fillStyle = 'rgba(77,163,255,0.22)'; g.beginPath(); g.moveTo(0, H);
      for (let i=1;i<120;i++) {
        const f = i * 48000 / 512; if (f < 30 || f > 18000) continue;
        g.lineTo(freqToX(f, W), H - (bins[i]/255)*(H-8));
      }
      g.lineTo(W, H); g.fill();
    }
    g.strokeStyle = 'rgba(255,255,255,0.08)'; g.beginPath(); g.moveTo(0, H/2); g.lineTo(W, H/2); g.stroke();
    g.strokeStyle = '#ff0a94'; g.lineWidth = 2; g.beginPath();
    for (let x=0;x<W;x+=2) {
      const f = xToFreq(x, W); let db = 0;
      state.eq.forEach(b => {
        const lr = Math.log2(f / b.f);
        if (b.type === 'lowshelf') db += b.g / (1 + Math.exp(lr * 3.2));
        else if (b.type === 'highshelf') db += b.g / (1 + Math.exp(-lr * 3.2));
        else db += b.g * Math.exp(-(lr*lr) * (b.q * 1.4));
      });
      const y = gainToY(db, H); if (x===0) g.moveTo(x,y); else g.lineTo(x,y);
    }
    g.stroke();
    state.eq.forEach((b, i) => {
      const x = freqToX(b.f, W), y = gainToY(b.g, H);
      g.fillStyle = EQ_COLS[i]; g.beginPath(); g.arc(x, y, 5.5, 0, Math.PI*2); g.fill();
