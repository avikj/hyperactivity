  // ── Clip Operations (Duplicate / Split / Mute / Rename / Delete) ──
  function dupSelectedClips() {
    const sel = state.clips.filter(c => state.selClips.has(c.id)); if (!sel.length) return;
    const minS = Math.min(...sel.map(c => c.startBar)), maxE = Math.max(...sel.map(c => c.startBar + c.lenBars));
    const shift = Math.max(0.25, maxE - minS);
    const created = [];
    sel.forEach(c => {
      if (c.startBar + shift < TOTAL_BARS) {
        const cp = {
          id: nextClipId++, trackId: c.trackId, startBar: c.startBar + shift,
          lenBars: Math.min(c.lenBars, TOTAL_BARS - (c.startBar + shift)),
          name: c.name + '*', fadeIn: c.fadeIn || 0, fadeOut: c.fadeOut || 0, muted: !!c.muted,
          audioPeaks: c.audioPeaks ? c.audioPeaks.slice() : undefined,
          notes: c.notes.map(n => ({ ...n, id: nextNoteId++ }))
        };
        state.clips.push(cp); created.push(cp);
      }
    });
    if (created.length) {
      state.selClips = new Set(created.map(c => c.id)); state.selClipId = created[0].id;
      syncSelectionUI(); snapCas('dup-clips');
    }
  }
  function splitSelectedClips() {
    const sel = state.clips.filter(c => state.selClips.has(c.id)); if (!sel.length) return;
    const playBar = currentPlayStep() / 16;
    const nextSel = new Set(); let count = 0;
    sel.forEach(c => {
      const cut = (playBar > c.startBar + 0.12 && playBar < c.startBar + c.lenBars - 0.12) ? playBar : (c.startBar + c.lenBars / 2);
      const leftLen = Math.round((cut - c.startBar) * 16) / 16;
      const rightLen = Math.round((c.startBar + c.lenBars - cut) * 16) / 16;
      if (leftLen < 0.125 || rightLen < 0.125) return;
      const cutStep = (leftLen * 16) % 16;
      const rightNotes = c.notes.map(n => ({ ...n, id: nextNoteId++ }));
      const rightClip = {
        id: nextClipId++, trackId: c.trackId, startBar: cut, lenBars: rightLen,
        name: c.name + ' B', fadeIn: 0, fadeOut: c.fadeOut || 0, muted: !!c.muted,
        audioPeaks: c.audioPeaks ? c.audioPeaks.slice(Math.floor(c.audioPeaks.length * (leftLen / c.lenBars))) : undefined,
        notes: rightNotes
      };
      if (c.audioPeaks) c.audioPeaks = c.audioPeaks.slice(0, Math.max(4, Math.floor(c.audioPeaks.length * (leftLen / c.lenBars))));
      c.lenBars = leftLen; c.fadeOut = 0;
      state.clips.push(rightClip);
      nextSel.add(rightClip.id); count++;
    });
