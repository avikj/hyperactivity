  function drawPiano() {
    const c = $('pianoCanvas'); if (!c || !c.clientWidth) return;
    c.width = c.clientWidth; c.height = c.clientHeight;
    const g = c.getContext('2d'), W = c.width, H = c.height;
    const rows = rowCount(), cw = W / 16, rh = H / rows;
    const dark = document.documentElement.classList.contains('dark');
    const dm = isDrumMode(), sc = SCALES[state.scale];
    for (let r = 0; r < rows; r++) {
      const y = (rows - 1 - r) * rh;
      const isBlk = dm ? (r % 2 === 1) : sc[r % sc.length].blk;
      g.fillStyle = isBlk ? (dark ? '#0f0f14' : '#ececf1') : (dark ? '#14141b' : '#f7f7fa');
      g.fillRect(0, y, W, rh);
      g.strokeStyle = dark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.06)';
      g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke();
    }
    for (let s = 0; s < 16; s++) {
      if (Math.floor(s / 4) % 2 === 1) { g.fillStyle = dark ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.02)'; g.fillRect(s*cw, 0, cw, H); }
      g.strokeStyle = (s % 4 === 0) ? (dark ? 'rgba(255,255,255,0.14)' : 'rgba(0,0,0,0.15)') : (dark ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.05)');
      g.beginPath(); g.moveTo(s*cw, 0); g.lineTo(s*cw, H); g.stroke();
    }
    const cl = getSelClip();
    if (cl) {
      const tr = getTrack(cl.trackId);
      // Ghost notes from other clips at the same bar
      if (!dm) {
        state.clips.filter(o => o.id !== cl.id && o.trackId !== cl.trackId && getTrack(o.trackId).kind !== 'drums' && o.startBar <= cl.startBar && o.startBar + o.lenBars > cl.startBar).forEach(o => {
          const otr = getTrack(o.trackId);
