<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hyperactivity DAW</title>
<meta name="description" content="First-principles digital audio workstation on the hyperactivity kernel.">
<script>
(function(){
  try {
    var t = localStorage.getItem('hxTheme');
    if (t !== 'light') document.documentElement.classList.add('dark');
  } catch (e) { document.documentElement.classList.add('dark'); }
})();
</script>
<style>
:root {
  --bg: #f4f4f6;
  --bg2: #ffffff;
  --bg3: #ebebf0;
  --bg4: #e0e0e7;
  --ink: #0a0a0d;
  --muted: #646470;
  --dim: #9494a0;
  --line: rgba(0, 0, 0, 0.085);
  --line-s: rgba(0, 0, 0, 0.18);
  --pink: #ff0a94;
  --blue: #1a73e8;
  --green: #0a8a43;
  --amber: #d97706;
  --red: #e11d48;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
}
html.dark {
  --bg: #0c0c0f;
  --bg2: #121217;
  --bg3: #18181f;
  --bg4: #22222c;
  --ink: #f3f3f7;
  --muted: #8b8b9a;
  --dim: #545463;
  --line: rgba(255, 255, 255, 0.075);
  --line-s: rgba(255, 255, 255, 0.16);
  --pink: #ff0a94;
  --blue: #4da3ff;
  --green: #26d07c;
  --amber: #f59e0b;
  --red: #ff4d6d;
}
* { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
input, textarea, select { user-select: text; -webkit-user-select: text; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--ink);
  font-family: var(--sans); font-size: 12px;
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }

.daw {
  display: grid; grid-template-rows: 44px minmax(0, 1fr);
  height: calc(100vh - 48px); width: 100vw; overflow: hidden;
}

/* ── TOP TRANSPORT ── */
.transport {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 0 12px; background: var(--bg2); border-bottom: 1px solid var(--line-s); min-width: 0;
}
.t-grp { display: flex; align-items: center; gap: 5px; min-width: 0; }
.t-sep { width: 1px; height: 20px; background: var(--line-s); margin: 0 2px; flex-shrink: 0; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 4px;
  height: 28px; padding: 0 9px; background: var(--bg3); color: var(--ink);
  border: 1px solid var(--line-s); border-radius: 3px;
  font: 600 11px/1 var(--sans); cursor: pointer; white-space: nowrap;
  transition: background 0.08s, border-color 0.08s, color 0.08s;
}
.btn:hover { background: var(--bg4); border-color: var(--ink); }
.btn.ico { width: 28px; padding: 0; font-size: 12px; }
.btn.on { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.ok { border-color: var(--green); color: var(--green); }
.btn.ok.on { background: var(--green); color: #000; }
.btn.rec.on { background: var(--red); border-color: var(--red); color: #fff; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
.btn.ghost:hover { color: var(--ink); background: var(--bg3); }
.btn.ghost.on { background: var(--bg4); color: var(--pink); border-color: var(--pink); }

.lcd {
  display: inline-flex; align-items: center; gap: 8px; height: 28px; padding: 0 9px;
  background: var(--bg); border: 1px solid var(--line-s); border-radius: 3px;
  font: 600 11.5px/1 var(--mono); color: var(--ink);
}
.lcd .pos { min-width: 56px; text-align: center; color: var(--pink); letter-spacing: 0.04em; }
.lcd .bpm-drag { cursor: ns-resize; display: inline-flex; align-items: center; gap: 4px; }
.lcd input.bpm-in {
  width: 42px; background: transparent; border: 0; color: var(--ink);
  font: 700 12px/1 var(--mono); text-align: right; outline: none; padding: 0;
}
.lcd .sub { font-size: 9px; color: var(--muted); }

.sel {
  height: 28px; padding: 0 7px; background: var(--bg3); color: var(--ink);
  border: 1px solid var(--line-s); border-radius: 3px; font: 600 11px/1 var(--sans);
  outline: none; cursor: pointer;
}
.sel:focus { border-color: var(--pink); }

.master-mini {
  display: flex; align-items: center; gap: 7px; height: 28px; padding: 0 8px;
  background: var(--bg); border: 1px solid var(--line-s); border-radius: 3px;
}
.meter-v-mini { width: 64px; height: 9px; background: var(--bg3); border-radius: 2px; overflow: hidden; display: flex; flex-direction: column; gap: 1px; }
.meter-bar-h { height: 4px; width: 0%; background: linear-gradient(90deg, var(--green) 0%, var(--amber) 78%, var(--red) 98%); transition: width 0.03s linear; }
.lufs-txt { font: 600 10px/1 var(--mono); color: var(--muted); min-width: 58px; text-align: right; }

/* ── MAIN WORKSPACE ── */
.main-area {
  display: grid; grid-template-columns: 206px minmax(0, 1fr) 0px;
  min-height: 0; overflow: hidden; transition: grid-template-columns 0.15s ease;
}
.main-area.no-lib { grid-template-columns: 0px minmax(0, 1fr) 0px; }
.main-area.drawer-open { grid-template-columns: 206px minmax(0, 1fr) 400px; }
.main-area.no-lib.drawer-open { grid-template-columns: 0px minmax(0, 1fr) 400px; }

/* ── LIBRARY BROWSER ── */
.library {
  background: var(--bg2); border-right: 1px solid var(--line-s);
  display: flex; flex-direction: column; min-height: 0; overflow: hidden;
}
.main-area.no-lib .library { border-right: 0; opacity: 0; pointer-events: none; }
.lib-head {
  padding: 8px 10px; border-bottom: 1px solid var(--line);
  display: flex; align-items: center; justify-content: space-between;
  font: 700 10px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.09em; color: var(--muted);
}
.lib-scroll { flex: 1; overflow-y: auto; padding: 6px 8px 14px; display: flex; flex-direction: column; gap: 10px; }
.lib-sec-t { font: 700 9.5px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--dim); padding: 4px 4px 2px; }
.lib-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 5px 8px; border-radius: 3px; cursor: pointer;
  font: 500 11.5px/1.2 var(--sans); color: var(--ink); border: 1px solid transparent;
}
.lib-item:hover { background: var(--bg3); border-color: var(--line); }
.lib-item .tag { font: 600 9px/1 var(--mono); color: var(--muted); }
.lib-drop {
  display: block; padding: 9px 8px; text-align: center;
  border: 1px dashed var(--line-s); border-radius: 3px;
  font: 600 10.5px/1.35 var(--sans); color: var(--muted); cursor: pointer;
}
.lib-drop:hover { border-color: var(--pink); color: var(--pink); }

/* ── CENTER STAGE (RESIZABLE SPLIT) ── */
.center-stage {
  display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; background: var(--bg);
}
.arr-wrap {
  display: flex; flex-direction: column; flex: 0 0 44%; min-height: 140px; max-height: 75%;
  background: var(--bg); overflow: hidden;
}
.split-h {
  height: 5px; background: var(--bg3); border-top: 1px solid var(--line-s); border-bottom: 1px solid var(--line-s);
  cursor: ns-resize; flex-shrink: 0;
}
.split-h:hover { background: var(--pink); }

/* ── ARRANGEMENT TIMELINE (SINGLE PERSISTENT CANVAS — ZERO DOM CHURN) ── */
.arr-ruler-row {
  display: grid; grid-template-columns: 204px minmax(0, 1fr);
  height: 26px; background: var(--bg2); border-bottom: 1px solid var(--line-s); flex-shrink: 0;
}
.arr-corner {
  display: flex; align-items: center; justify-content: space-between; gap: 3px;
  padding: 0 6px; border-right: 1px solid var(--line-s);
  font: 700 9.5px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
}
#rulerCanvas { width: 100%; height: 26px; display: block; cursor: pointer; touch-action: none; }
.arr-body {
  flex: 1; overflow-y: auto; display: grid; grid-template-columns: 204px minmax(0, 1fr);
  align-items: start; min-height: 0;
}
.arr-headers { display: flex; flex-direction: column; }
.trk-head {
  height: 56px; display: flex; flex-direction: column; justify-content: space-between;
  padding: 5px 8px 5px 10px; background: var(--bg2);
  border-right: 1px solid var(--line-s); border-bottom: 1px solid var(--line);
  border-left: 3px solid var(--pink); cursor: pointer; flex-shrink: 0;
}
.trk-head.sel-trk { background: var(--bg3); }
.trk-top { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
.trk-name { font: 600 11.5px/1 var(--sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.trk-btns { display: flex; gap: 3px; }
.t-mini {
  width: 18px; height: 18px; border-radius: 2px; border: 1px solid var(--line-s);
  background: var(--bg); color: var(--muted); font: 700 9px/1 var(--mono);
  cursor: pointer; padding: 0; display: inline-flex; align-items: center; justify-content: center;
}
.t-mini:hover { border-color: var(--ink); color: var(--ink); }
.t-mini.m.on { background: var(--amber); color: #000; border-color: var(--amber); }
.t-mini.s.on { background: var(--blue); color: #fff; border-color: var(--blue); }
.t-mini.r.on { background: var(--red); color: #fff; border-color: var(--red); }
.t-mini.on { background: var(--pink); color: #fff; border-color: var(--pink); }
.trk-bot { display: flex; align-items: center; gap: 6px; }
.trk-vol {
  flex: 1; height: 4px; -webkit-appearance: none; appearance: none;
  background: var(--bg4); border-radius: 2px; outline: none; cursor: pointer;
}
.trk-vol::-webkit-slider-thumb {
  -webkit-appearance: none; width: 10px; height: 10px; border-radius: 50%;
  background: var(--ink); border: 1px solid var(--bg); cursor: pointer;
}
.trk-meter { width: 34px; height: 5px; background: var(--bg); border-radius: 1px; overflow: hidden; }
.trk-meter > i { display: block; height: 100%; width: 0%; background: var(--green); transition: width 0.04s linear; }
.arr-stage { position: relative; min-width: 0; }
#arrCanvas { width: 100%; display: block; touch-action: none; }

/* ── BOTTOM DETAIL DOCK ── */
.dock { flex: 1; display: flex; flex-direction: column; min-height: 180px; background: var(--bg2); overflow: hidden; }
.dock-bar {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  height: 34px; padding: 0 10px; border-bottom: 1px solid var(--line-s);
  background: var(--bg2); flex-shrink: 0;
}
.dock-tabs { display: flex; gap: 2px; }
.d-tab {
  height: 24px; padding: 0 11px; border-radius: 3px; border: 1px solid transparent;
  background: transparent; color: var(--muted); font: 600 11px/1 var(--sans); cursor: pointer;
}
.d-tab:hover { color: var(--ink); background: var(--bg3); }
.d-tab.on { background: var(--bg4); color: var(--ink); border-color: var(--line-s); }
.dock-pane { display: none; flex: 1; min-height: 0; overflow: hidden; }
.dock-pane.on { display: flex; }

/* ── PIANO ROLL ── */
.pr-wrap { display: grid; grid-template-columns: 64px minmax(0, 1fr); flex: 1; min-height: 0; overflow: hidden; }
.pr-keys {
  background: var(--bg2); border-right: 1px solid var(--line-s);
  display: flex; flex-direction: column; overflow: hidden;
}
.pr-key {
  flex: 1; display: flex; align-items: center; justify-content: flex-end; padding-right: 6px;
  border-bottom: 1px solid var(--line); font: 600 8.5px/1 var(--mono); color: var(--muted); cursor: pointer;
}
.pr-key.blk { background: var(--bg); color: var(--dim); }
.pr-key.root { color: var(--pink); font-weight: 800; }
.pr-key:hover, .pr-key.lit { background: var(--pink); color: #fff; }
.pr-grid-col { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }
#pianoCanvas { width: 100%; flex: 1; min-height: 0; display: block; }
#velCanvas { width: 100%; height: 44px; display: block; border-top: 1px solid var(--line-s); background: var(--bg); cursor: ns-resize; }

/* ── HORIZONTAL DEVICE RACK ── */
.rack { flex: 1; display: flex; gap: 8px; padding: 10px; overflow-x: auto; align-items: stretch; background: var(--bg); }
.dev {
  flex: 0 0 auto; min-width: 210px; background: var(--bg2);
  border: 1px solid var(--line-s); border-radius: 4px; display: flex; flex-direction: column; overflow: hidden;
}
.dev-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 6px 9px; background: var(--bg3); border-bottom: 1px solid var(--line); font: 700 10.5px/1 var(--sans);
}
.dev-led { width: 7px; height: 7px; border-radius: 50%; background: var(--green); display: inline-block; margin-right: 5px; }
.dev-body { flex: 1; padding: 8px 10px; display: flex; flex-direction: column; gap: 8px; justify-content: center; }
.knob-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 6px; }
.knob-wrap { display: flex; flex-direction: column; align-items: center; gap: 3px; cursor: ns-resize; }
.knob-wrap svg { width: 38px; height: 38px; overflow: visible; }
.knob-lbl { font: 600 9.5px/1 var(--sans); color: var(--muted); }
.knob-val { font: 600 9px/1 var(--mono); color: var(--ink); }
.xy-mini { width: 108px; height: 94px; border: 1px solid var(--line-s); border-radius: 3px; background: var(--bg); cursor: crosshair; display: block; }
#eqCanvas { width: 300px; height: 118px; background: var(--bg); border: 1px solid var(--line); border-radius: 3px; display: block; cursor: crosshair; }

/* ── MIXER CONSOLE ── */
.mixer { flex: 1; display: flex; gap: 6px; padding: 10px; overflow-x: auto; background: var(--bg); align-items: stretch; }
.strip {
  width: 116px; flex-shrink: 0; background: var(--bg2); border: 1px solid var(--line-s); border-radius: 4px;
  display: flex; flex-direction: column; align-items: center; padding: 8px 6px; gap: 6px;
}
.strip.master { margin-left: auto; border-color: var(--pink); width: 130px; }
.strip-name { font: 700 11px/1 var(--sans); width: 100%; text-align: center; padding-bottom: 5px; border-bottom: 2px solid var(--pink); }
.fader-box { flex: 1; display: flex; align-items: center; gap: 8px; width: 100%; justify-content: center; min-height: 92px; }
.v-fader { writing-mode: vertical-lr; direction: rtl; height: 100%; width: 18px; accent-color: var(--pink); cursor: pointer; }
.v-meter { width: 8px; height: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 2px; display: flex; flex-direction: column-reverse; overflow: hidden; }
.v-meter > i { display: block; width: 100%; height: 0%; background: linear-gradient(0deg, var(--green), var(--amber) 75%, var(--red) 95%); transition: height 0.04s; }
.strip-db { font: 600 9.5px/1 var(--mono); color: var(--muted); }

/* ── 4-STEM DECK ── */
.stem-view { flex: 1; display: grid; grid-template-columns: 350px minmax(0, 1fr); gap: 14px; padding: 12px 16px; background: var(--bg); min-height: 0; overflow-y: auto; }
.stem-sliders { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: stretch; }
.s-col { background: var(--bg2); border: 1px solid var(--line-s); border-radius: 4px; padding: 8px 6px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.s-track { position: relative; width: 22px; flex: 1; min-height: 100px; background: var(--bg); border: 1px solid var(--line-s); border-radius: 11px; overflow: hidden; cursor: ns-resize; }
.s-fill { position: absolute; bottom: 0; left: 0; right: 0; transition: height 0.03s; }
.s-lbl { font: 700 9.5px/1 var(--mono); letter-spacing: 0.06em; color: var(--muted); }
.chop-pads { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; }
.pad-btn {
  height: 44px; background: var(--bg2); border: 1px solid var(--line-s); border-radius: 3px;
  color: var(--ink); font: 600 10.5px/1.2 var(--mono); cursor: pointer;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.pad-btn:hover { border-color: var(--pink); }
.pad-btn.lit { background: var(--pink); color: #fff; border-color: var(--pink); }

/* ── RIGHT PROGRESSIVE INSPECTOR DRAWER ── */
.drawer { background: var(--bg2); border-left: 1.5px solid var(--line-s); display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.main-area:not(.drawer-open) .drawer { border-left: 0; opacity: 0; pointer-events: none; }
.dr-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; border-bottom: 1px solid var(--line-s); background: var(--bg3); }
.dr-tabs { display: flex; gap: 2px; }
.dr-tab { padding: 4px 8px; border-radius: 3px; border: 1px solid transparent; background: transparent; color: var(--muted); font: 700 10px/1 var(--mono); cursor: pointer; }
.dr-tab.on { background: var(--ink); color: var(--bg); }
.dr-body { display: none; flex: 1; overflow-y: auto; padding: 12px; flex-direction: column; gap: 10px; }
.dr-body.on { display: flex; }
.dr-sec { background: var(--bg); border: 1px solid var(--line-s); border-radius: 4px; padding: 10px; display: flex; flex-direction: column; gap: 7px; }
.dr-sec h3 { margin: 0; font: 700 10px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
textarea.code-ed { width: 100%; height: 132px; padding: 8px; border-radius: 3px; background: var(--bg2); color: var(--ink); border: 1px solid var(--line-s); font: 500 11px/1.45 var(--mono); resize: vertical; outline: none; }
textarea.code-ed:focus { border-color: var(--pink); }
.log-out { font: 500 10.5px/1.45 var(--mono); color: var(--muted); background: var(--bg2); border: 1px solid var(--line); border-radius: 3px; padding: 7px 8px; white-space: pre-wrap; max-height: 88px; overflow-y: auto; }
.row-f { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }

.pop-wrap { position: relative; }
.pop-menu {
  display: none; position: absolute; right: 0; top: 34px; z-index: 40; min-width: 190px;
  background: var(--bg2); border: 1px solid var(--line-s); border-radius: 4px; padding: 4px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.45); flex-direction: column; gap: 2px;
}
.pop-menu.open { display: flex; }
.pop-item { text-align: left; padding: 7px 9px; background: transparent; border: 0; color: var(--ink); font: 500 11.5px/1 var(--sans); border-radius: 3px; cursor: pointer; }
.pop-item:hover { background: var(--bg4); color: var(--pink); }

.modal-bg {
  display: none; position: fixed; inset: 0; z-index: 80; background: rgba(0,0,0,0.55);
  align-items: center; justify-content: center;
}
.modal-bg.open { display: flex; }
.modal-card {
  width: 440px; max-width: 92vw; background: var(--bg2); border: 1px solid var(--line-s);
  border-radius: 6px; padding: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.6);
}
.modal-card h3 { margin: 0 0 10px; font: 700 13px var(--sans); display: flex; justify-content: space-between; }
.sc-grid { display: grid; grid-template-columns: 120px 1fr; gap: 6px 10px; font: 500 11px/1.4 var(--sans); color: var(--muted); }
.sc-grid b { font: 700 10.5px var(--mono); color: var(--ink); }

.toast {
  position: fixed; bottom: 14px; right: 16px; z-index: 60; padding: 8px 13px; border-radius: 4px;
  background: var(--ink); color: var(--bg); font: 600 11px/1.2 var(--mono);
  opacity: 0; pointer-events: none; transition: opacity 0.16s;
}
.toast.show { opacity: 1; }
</style>
</head>
<body>
<!--HX:NAV-->

<div class="daw">
  <!-- TOP TRANSPORT BAR -->
  <header class="transport">
    <div class="t-grp">
      <button id="btnLib" class="btn ghost on" title="Toggle Library">Library</button>
      <div class="t-sep"></div>
      <button id="btnPlay" class="btn ico" title="Play / Pause (Space)">▶</button>
      <button id="btnStop" class="btn ico" title="Stop & Return to Bar 1 (Enter)">■</button>
      <button id="btnRec" class="btn ico rec" title="Record Mic / MIDI">●</button>
      <button id="btnLoop" class="btn ico on" title="Loop Brace (L)">⟳</button>
      <button id="btnMetro" class="btn ico" title="Metronome Click">♩</button>
      <div class="lcd">
        <span class="pos" id="lcdPos">001.1.1</span>
        <span class="bpm-drag" id="bpmDrag" title="Drag vertically or type BPM">
          <input id="bpmIn" class="bpm-in" type="number" value="91" min="40" max="240">
          <span class="sub">BPM</span>
        </span>
      </div>
      <select id="scaleSel" class="sel" title="Scale & Tuning">
        <option value="12tet">12-TET · A Minor</option>
        <option value="just">Just Intonation</option>
        <option value="19edo">19-EDO</option>
        <option value="22shruti">22-Shruti</option>
        <option value="bohlen">Bohlen-Pierce</option>
        <option value="maqam">Maqam Rast</option>
        <option value="harmonic">Harmonic Series</option>
      </select>
    </div>

    <div class="t-grp">
      <div class="master-mini">
        <div class="meter-v-mini">
          <div id="mOutL" class="meter-bar-h"></div>
          <div id="mOutR" class="meter-bar-h"></div>
        </div>
        <span id="statLufs" class="lufs-txt">-∞ LUFS</span>
      </div>
    </div>

    <div class="t-grp">
      <button id="btnUndo" class="btn ico" title="Undo (Cmd+Z)">↩</button>
