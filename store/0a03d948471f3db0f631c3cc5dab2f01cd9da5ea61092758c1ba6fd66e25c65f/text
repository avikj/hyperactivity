    });
  }

  const pc = $('pianoCanvas');
  const snapVal = (v, free) => free ? Math.round(v * 16) / 16 : Math.round(v / state.snap) * state.snap;
  function hitNote(mx, my, W, H) {
    const cl = getSelClip(); if (!cl) return null;
    const rows = rowCount(), cw = W / 16, rh = H / rows;
    for (let i = cl.notes.length - 1; i >= 0; i--) {
      const n = cl.notes[i];
