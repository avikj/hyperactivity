      });
      drawPiano(); drawAllLanes(); snapCas('nudge'); return;
    }
    if (k === 'z') { keyOctShift = Math.max(-12, keyOctShift - 12); toast(`Octave ${keyOctShift>=0?'+':''}${keyOctShift/12}`); return; }
    if (k === 'x') { keyOctShift = Math.min(12, keyOctShift + 12); toast(`Octave ${keyOctShift>=0?'+':''}${keyOctShift/12}`); return; }
    if (KEY_ROW[k] !== undefined && !heldKeys.has(k)) {
      heldKeys.add(k);
      const row = Math.max(0, Math.min(rowCount() - 1, KEY_ROW[k] + keyOctShift));
      liveNoteOn(row, 0.85, state.selTrk, 7000 + KEY_ROW[k]);
    }
    if (k >= '1' && k <= '8') { const b = $('chopPads').children[parseInt(k)-1]; if (b) b.onmousedown(); }
  });
  window.addEventListener('keyup', (e) => {
    const k = e.key.toLowerCase();
    if (KEY_ROW[k] !== undefined && heldKeys.has(k)) { heldKeys.delete(k); liveNoteOff(state.selTrk, 7000 + KEY_ROW[k]); }
  });

  // ── 60fps Continuous Animation Loop ──
  function anim() {
    if (playing) { updateLcd(); drawRuler(); drawAllLanes(); if ($('dp-roll').classList.contains('on')) drawPiano(); }
    if ($('dp-dev').classList.contains('on')) drawEq();
    if ($('dr-phys').classList.contains('on')) drawWebGL();
    if (pitchTrackOn) trackMicPitch();
    requestAnimationFrame(anim);
  }
  window.addEventListener('resize', () => { drawRuler(); drawAllLanes(); drawPiano(); });

  // Boot
  renderLibrary(); renderTrackHeaders(); renderMixer(); renderStemDeck(); renderChops(); syncSelectionUI();
  initWebGL(); syncCode(); drawMorph(); drawNet(); drawChain(); drawGravity();
  if (location.hash.startsWith('#hx=')) {
    try { hydrateSong(decodeURIComponent(escape(atob(location.hash.slice(4).replace(/-/g,'+').replace(/_/g,'/'))))); } catch (_) {}
  }
  snapCas('init'); joinRoom('studio-01'); anim();
})();
</script>
