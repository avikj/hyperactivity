      window.addEventListener('mousemove', mv); window.addEventListener('mouseup', up);
    };
    wrap.ondblclick = () => { cur = defV; draw(); onChange(cur); };
    parent.appendChild(wrap);
    return { set: (nv) => { cur = nv; draw(); } };
  }

