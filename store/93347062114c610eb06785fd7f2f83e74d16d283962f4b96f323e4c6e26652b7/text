hio-res : Word → Word → Word → (Word → Step W Word) → Step W Word
hio-res m tag val k =
  hio-new-var m (λ v →
  hio-node (hv2-kp m v) val (hv2-port hv2-VAR v) (λ n1 →
  hio-node (hv2-kp m n1) (hio-num tag) (hio-con n1) (λ n2 →
  hio-node (hv2-kp m n2) (hio-con n2) (hv2-port hv2-VAR v) (λ n3 → k (hio-con n3)))))
