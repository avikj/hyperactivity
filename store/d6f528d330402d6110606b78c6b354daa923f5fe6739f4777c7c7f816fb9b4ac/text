sc-neg-pull2 : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → ScRing A z add mul neg →
  (w u v : A) → mul (neg w) (mul v u) ≡ mul w (mul (neg v) u)
sc-neg-pull2 A z add mul neg r w u v =
  concat (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd r))))))))) w (mul v u))
    (concat (sym (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd (snd r)))))))))) w (mul v u)))
            (cong (λ t → mul w t) (sym (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd r))))))))) v u))))
