-- digits into a natural: (value, count, rest)
ief-digs : List Word → List Word → Word → List Word × (Word × List Word)
ief-digs nil n k = (n , (k , nil))
ief-digs (cons c r) n k =
  if ief-isdig c then ief-digs r (bg-add (bg-mulw n #10) (bg-of (%wsub c #48))) (%wsucc k)
  else (n , (k , cons c r))
