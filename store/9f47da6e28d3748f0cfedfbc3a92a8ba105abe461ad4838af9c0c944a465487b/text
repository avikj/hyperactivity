tir-c2 : List Word → List Word
tir-c2 tl =
  tir-ln "// Exact 128x128 -> 256-bit product (zero overflow up to (2^128 - 1)^2 < 2^256):"
  (tir-ln "static U256 u256_mul128(u128 a, u128 b){"
  (tir-ln "  uint64_t a0 = (uint64_t)a, a1 = (uint64_t)(a >> 64);"
  (tir-ln "  uint64_t b0 = (uint64_t)b, b1 = (uint64_t)(b >> 64);"
  (tir-ln "  u128 p00 = (u128)a0 * b0, p01 = (u128)a0 * b1, p10 = (u128)a1 * b0, p11 = (u128)a1 * b1;"
  (tir-ln "  u128 mid = (p00 >> 64) + (uint64_t)p01 + (uint64_t)p10;"
  (tir-ln "  u128 hi  = p11 + (p01 >> 64) + (p10 >> 64) + (mid >> 64);"
  (tir-ln "  U256 r; r.w[0] = (uint64_t)p00; r.w[1] = (uint64_t)mid; r.w[2] = (uint64_t)hi; r.w[3] = (uint64_t)(hi >> 64);"
  (tir-ln "  return r;"
  (tir-ln "}"
  (tir-ln "// Exact 256-bit / 128-bit shift-subtract division (for quotients < 2^128, e.g. AMM dy < ry < 2^112):"
  (tir-ln "static u128 u256_div128(U256 num, u128 den){"
  (tir-ln "  if(den == 0) return 0;"
  (tir-ln "  if(num.w[3] == 0ull && num.w[2] == 0ull){ u128 lo = ((u128)num.w[1] << 64) | (u128)num.w[0]; return lo / den; }"
  (tir-ln "  u128 rem = 0, q = 0;"
  (tir-ln "  for(int i = 255; i >= 0; i--){"
  (tir-ln "    uint32_t carry = (uint32_t)(rem >> 127);"
  (tir-ln "    uint64_t bit = (num.w[i >> 6] >> (i & 63)) & 1ull;"
  (tir-ln "    rem = (rem << 1) | (u128)bit;"
  (tir-ln "    if(carry || rem >= den){ rem -= den; if(i < 128) q |= ((u128)1u << i); }"
  (tir-ln "  }"
  (tir-ln "  return q;"
  (tir-ln "}"
  (tir-ln "// Exact 256-bit EVM-faithful constant-product swap (ZERO overflow across full uint112 reserve range!):"
  (tir-ln "static u128 amm_out_256(u128 rx, u128 ry, u128 dx, uint32_t fee_keep){"
  (tir-ln "  if(dx == 0 || rx == 0 || ry == 0) return 0;"
  (tir-ln "  u128 dxf = dx * (u128)fee_keep;"
  (tir-ln "  u128 den = rx * (u128)10000u + dxf;"
  (tir-ln "  return u256_div128(u256_mul128(ry, dxf), den);"
  (tir-ln "}" tl)))))))))))))))))))))))))))))
