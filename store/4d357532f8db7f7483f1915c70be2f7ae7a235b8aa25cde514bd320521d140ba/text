h4-normouter : Word → Nat → Nat → Nat → Word → (Word → Step W Word) → Step W Word
h4-normouter m zero fu fb sl k =
  h4-rterr m "normalize: out of steps" k
h4-normouter m (suc n) fu fb sl k =
  h4-normloop m fu fu fb sl (λ r → let m2751 = h4-dep m r in if (%wlt r #1099511627776) then (k (h4-depl m2751 (r))) else (h4-normouter m2751 n fu fb (%wsub r #1099511627776) k))
