b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10066 = cs in let j_10067 = j in scmd (w-load ((b2-a mm_ (%wadd v_10066 #2)))) (λ d_10065 → let mm_10068 = b2-dep mm_ d_10065 in scmd (w-load ((b2-a mm_10068 (%wadd d_10065 (%wsucc j_10067))))) (λ x_10064 → let mm_10069 = b2-dep mm_10068 x_10064 in let c = x_10064 in let t_10071 = c in let j_10072 = #0 in scmd (w-load ((b2-a mm_10069 (%wadd t_10071 (%wadd #2 j_10072))))) (λ x_10070 → let mm_10073 = b2-dep mm_10069 x_10070 in let ck = x_10070 in if (%weq ck k) then (kq_ (h4-depl mm_10073 (c))) else (b2-ctrfind mm_10073 f cs k (%wsucc j) n kq_)))))
