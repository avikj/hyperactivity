b2-dropg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-dropg mm_ zero a ob n j len kq_ =
  kq_ (h4-depl mm_ (ob))
b2-dropg mm_ (suc f) a ob n j len kq_ =
  if (%weq (%wadd n j) len) then (kq_ (h4-depl mm_ (ob))) else (let a_5540 = a in let j_5541 = (%wadd n j) in scmd (w-load ((b2-a mm_ (%wadd a_5540 (%wsucc j_5541))))) (λ x_5539 → let mm_5542 = b2-dep mm_ x_5539 in let x = x_5539 in let a_5543 = ob in let j_5544 = j in let v_5545 = x in scmd (w-store ((b2-a mm_5542 (%wadd a_5543 (%wsucc j_5544)))) (v_5545)) (λ uu_5546 → let mm_5547 = hv2-u mm_5542 uu_5546 in b2-dropg mm_5547 f a ob n (%wsucc j) len kq_)))
