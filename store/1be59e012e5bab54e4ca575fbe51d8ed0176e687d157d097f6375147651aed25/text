-- ---------------------------------------------------------------- 64-bit Apple Silicon Mach-O executable image
-- Zero-dyld static Darwin ARM64 Mach-O (`MH_MAGIC_64 = 0xfeedfacf`, `CPU_TYPE_ARM64 = 0x0100000c`,
-- `MH_EXECUTE = 2`, `MH_NOUNDEFS = 1`, 16 KiB page-aligned `__TEXT`/`__text` at VM base `0x100000000` = `#4294967296`,
-- `LC_UNIXTHREAD` (`cmd = 5`, `ARM_THREAD_STATE64 = 6`, `count = 68`, `pc = 0x100000240` = `#4294967872`),
-- `LC_BUILD_VERSION` macOS 15.0; header (32B) + 4 load commands (536B) + 8B pad = 576B (`0x240`, 64B-aligned)):
macho-zeros : Word → Lst Word
macho-zeros n = %welimP (λ _ → Lst Word) n lnil (λ _ h → lcons #0 h)
