b2-firstexs : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstexs mm_ zero cls j n kq_ =
  kq_ (h4-depl mm_ (n))
b2-firstexs mm_ (suc f) cls j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (n))) else (let v_8084 = cls in let j_8085 = j in scmd (w-load ((b2-a mm_ (%wadd v_8084 #2)))) (λ d_8082 → let mm_8086 = b2-dep mm_ d_8082 in scmd (w-load ((b2-a mm_8086 (%wadd d_8082 (%wsucc j_8085))))) (λ x_8083 → let mm_8087 = b2-dep mm_8086 x_8083 in let c = x_8083 in let i_8089 = c in scmd (w-load ((b2-a mm_8087 i_8089))) (λ x_8088 → let mm_8090 = b2-dep mm_8087 x_8088 in let all = x_8088 in if (%weq all #0) then (kq_ (h4-depl mm_8090 (j))) else (b2-firstexs mm_8090 f cls (%wsucc j) n kq_)))))
