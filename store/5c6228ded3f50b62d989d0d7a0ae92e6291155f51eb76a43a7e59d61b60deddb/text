-- Strict CPS spine evaluators for BZ vectors and matrices (eliminating call-by-name thunk re-evaluation):
h3d-force-bz : (C : Type) → BZ → (BZ → C) → C
h3d-force-bz C z k =
  case fst z of
    false → bst-force-bin C (snd z) (λ m → k (false , m))
    true  → bst-force-bin C (snd z) (λ m → k (true  , m))
