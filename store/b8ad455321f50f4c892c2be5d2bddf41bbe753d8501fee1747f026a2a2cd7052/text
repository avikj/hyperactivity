b2-ftab : Word → (Word → Step W Word) → Step W Word
b2-ftab mm_ kq_ =
  scmd (w-load ((b2-HR mm_ #23))) (λ t → let mm_15253 = b2-dep mm_ t in if (not (%weq t #0)) then (kq_ (h4-depl mm_15253 (t))) else (b2-vec mm_15253  (λ v → let mm_15254 = b2-dep mm_15253 v in scmd (w-store ((b2-HR mm_15254 #23)) (v)) (λ uu_15255 → let mm_15256 = hv2-u mm_15254 uu_15255 in kq_ (h4-depl mm_15256 (v))))))
