grv-bhat-m1 : (C : Type) → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
  GrvBuckets → (GrvBuckets → C) → C
grv-bhat-m1 C dj1 dj2 dj3 dj4 di dk halfS fuel1 b cont = case fuel1 of
  zero → cont b
  suc m1 →
    grv-bhat-m2 C dj1 dj2 dj3 dj4 di dk halfS m1 (suc dj2) b (λ b2 →
      grv-bhat-m1 C dj1 dj2 dj3 dj4 di dk halfS m1 b2 cont)
