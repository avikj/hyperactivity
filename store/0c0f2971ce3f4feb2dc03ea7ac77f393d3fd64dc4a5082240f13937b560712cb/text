um-send-args : List Word → List Word → List Word → List Word → List (List Word)
um-send-args ua ip cache body =
  cons "/usr/bin/env" (cons "curl" (cons "-s" (cons "--max-time" (cons "5" (cons "-X" (cons "POST" (cons "-H" (cons "Content-Type: application/json"
    (um-opt-hdr "User-Agent" ua (um-opt-hdr "X-Forwarded-For" ip (um-opt-hdr "x-umami-cache" cache
      (cons "--data-raw" (cons body (cons "https://gateway.umami.is/api/send" nil))))))))))))))
