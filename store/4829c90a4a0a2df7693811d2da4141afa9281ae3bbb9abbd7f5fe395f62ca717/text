boc-thm-zero-internal-warrant :
  (y target : Bool) →
  Warrants boc-wire-obs y (λ ks → snd ks ≡ target) →
  Empty
boc-thm-zero-internal-warrant y target w =
  let wt = w ((bxor y true  , true)  , boc-bxor-cancel y true)
      wf = w ((bxor y false , false) , boc-bxor-cancel y false)
  in true≢false (boc-trans wt (boc-sym wf))
