tc-is-k4-plaq : QgmState → QgmState → Bool
tc-is-k4-plaq a b =
  if eqb (fst a) (fst b)
  then (if tc-pm-face (snd a) (snd b) tc-face0 then true
        else (if tc-pm-face (snd a) (snd b) tc-face1 then true
              else (if tc-pm-face (snd a) (snd b) tc-face2 then true
                    else tc-pm-face (snd a) (snd b) tc-face3)))
  else false
