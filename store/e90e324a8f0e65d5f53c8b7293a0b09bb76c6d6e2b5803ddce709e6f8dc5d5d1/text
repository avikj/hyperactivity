hd-gpu-metal-src : List Word
hd-gpu-metal-src =
  hd-ln "// Pure Symbolic GPU Circuit Discovery Engine (lib/hx-discover.hypercubical)"
  (hd-ln "// Searches 4-input (16-bit truth table) & joint multi-output NAND2 circuits on Apple Silicon GPU!"
  (hd-ln "#include <metal_stdlib>"
  (hd-ln "using namespace metal;"
  (hd-ln "struct DiscParams { uint n_targets; uint base_seed; uint iters_per_thread; };"
  (hd-ln "// Each thread evaluates a deterministic batch of 6-to-9-gate NAND2 DAGs over 4 inputs (w0..w3)"
  (hd-ln "// Targets: 0=PARITY4(0x6996), 1=MUX4_SEL(0xCAC0), 2=EQ2_PAIR(0x9009), 3=PRESENT_S0(0x365C), 4=PRESENT_S1(0x5A36), 5=FA_SUM_AND_CARRY"
  (hd-ln "kernel void hx_discover_nand2("
  (hd-ln "    device const ushort* targets [[buffer(0)]],"
  (hd-ln "    device atomic_uint* best_gates [[buffer(1)]],"
  (hd-ln "    device ulong* best_prog [[buffer(2)]],"
  (hd-ln "    constant DiscParams& dp [[buffer(3)]],"
  (hd-ln "    uint tid [[thread_position_in_grid]]) {"
  (hd-ln "  ushort w[14];"
  (hd-ln "  w[0] = 0xAAAA; w[1] = 0xCCCC; w[2] = 0xF0F0; w[3] = 0xFF00;"
  (hd-ln "  // Deterministic structured + randomized DAG exploration from tid + seed"
  (hd-ln "  ulong rng = (ulong(tid + 1) * 0x9E3779B97F4A7C15ul) ^ (ulong(dp.base_seed) * 0xBF58476D1CE4E5B9ul);"
  (hd-ln "  for (uint it = 0; it < dp.iters_per_thread; it++) {"
  (hd-ln "    ulong prog = 0;"
  (hd-ln "    for (uint g = 0; g < 9; g++) {"
  (hd-ln "      uint nw = 4 + g;"
  (hd-ln "      rng ^= rng >> 12; rng ^= rng << 25; rng ^= rng >> 27;"
  (hd-ln "      ulong r = rng * 0x2545F4914F6CDD1Dul;"
  (hd-ln "      uint a = uint((r >> 32) % nw);"
  (hd-ln "      uint b = uint((r >> 48) % nw);"
  (hd-ln "      w[nw] = ~(w[a] & w[b]);"
  (hd-ln "      prog |= ulong((a << 4) | b) << (g * 7);"
  (hd-ln "      uint ng = g + 1;"
  (hd-ln "      for (uint t = 0; t < 5; t++) {"
  (hd-ln "        if (w[nw] == targets[t]) {"
  (hd-ln "          uint cur = atomic_load_explicit(&best_gates[t], memory_order_relaxed);"
  (hd-ln "          if (ng < cur) {"
  (hd-ln "            if (atomic_compare_exchange_weak_explicit(&best_gates[t], &cur, ng, memory_order_relaxed, memory_order_relaxed)) {"
  (hd-ln "              best_prog[t] = prog;"
  (hd-ln "            }"
  (hd-ln "          }"
  (hd-ln "        }"
  (hd-ln "      }"
  (hd-ln "    }"
  (hd-ln "  }"
  (hd-ln "}" nil))))))))))))))))))))))))))))))))))))))))
