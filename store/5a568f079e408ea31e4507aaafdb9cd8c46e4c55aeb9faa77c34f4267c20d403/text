b2-sat : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-sat mm_ zero a p at j m kq_ =
  kq_ (h4-depl mm_ (#0))
b2-sat mm_ (suc f) a p at j m kq_ =
  if (%weq j m) then (kq_ (h4-depl mm_ (#1))) else (let a_2800 = a in let j_2801 = (%wadd at j) in scmd (w-load ((b2-a mm_ (%wadd a_2800 (%wsucc j_2801))))) (λ x_2799 → let mm_2802 = b2-dep mm_ x_2799 in let x = x_2799 in let a_2804 = p in let j_2805 = j in scmd (w-load ((b2-a mm_2802 (%wadd a_2804 (%wsucc j_2805))))) (λ x_2803 → let mm_2806 = b2-dep mm_2802 x_2803 in let y = x_2803 in if (not (%weq x y)) then (kq_ (h4-depl mm_2806 (#0))) else (b2-sat mm_2806 f a p at (%wsucc j) m kq_))))
