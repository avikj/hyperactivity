tc-tau12-st : QgmState → QgmState
tc-tau12-st s =
  ((if eqb (fst s) 1 then 2 else (if eqb (fst s) 2 then 1 else fst s)) ,
   tc-vec6 (sc-nth-bz (snd s) 1) (sc-nth-bz (snd s) 0) (sc-nth-bz (snd s) 2)
           (bz-neg (sc-nth-bz (snd s) 3)) (bz-neg (sc-nth-bz (snd s) 5)) (bz-neg (sc-nth-bz (snd s) 4)))
