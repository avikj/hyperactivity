-- Section (2): Zero-Erasure Univalent Equivalence Theorem (Landauer cost = 0 for bijections / ua).
-- An explicit representation equivalence between A and B: (f, g, gf, fg).
QiEquiv : Type → Type → Type
QiEquiv A B = (f : A → B) × ((g : B → A) × (((a : A) → g (f a) ≡ a) × ((b : B) → f (g b) ≡ b)))
