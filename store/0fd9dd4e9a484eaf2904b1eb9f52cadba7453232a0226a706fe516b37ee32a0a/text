e-scan : Nat → List Word → Word → List Word × List (List (List Word))
e-scan zero t n = (t , nil)
e-scan (suc f) nil n = (nil , nil)
e-scan (suc f) (cons c r) n =
  if weq c #60 then e-scan-lt (e-scan f) (cons c r) n (e-etyl-at (cons c r)) (e-mention-at (cons c r))
  else e-pre (cons c nil) (e-scan f r n)
