-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13252 = seen in let j_13253 = j in scmd (w-load ((b2-a mm_ (%wadd v_13252 #2)))) (λ d_13250 → let mm_13254 = b2-dep mm_ d_13250 in scmd (w-load ((b2-a mm_13254 (%wadd d_13250 (%wsucc j_13253))))) (λ x_13251 → let mm_13255 = b2-dep mm_13254 x_13251 in let e = x_13251 in let i_13257 = e in scmd (w-load ((b2-a mm_13255 i_13257))) (λ x_13256 → let mm_13258 = b2-dep mm_13255 x_13256 in let x = x_13256 in if (%weq x p) then (kq_ (h4-depl mm_13258 (e))) else (b2-seenat mm_13258 f seen p (%wsucc j) n kq_)))))
