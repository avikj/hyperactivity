hio-cons : Word → Word → Word → (Word → Step W Word) → Step W Word
hio-cons m head tail k =
  hio-new-var m (λ v →
  hio-node (hv2-kp m v) tail (hv2-port hv2-VAR v) (λ n1 →
  hio-node (hv2-kp m n1) head (hio-con n1) (λ n2 →
  hio-node (hv2-kp m n2) (hio-num #1) (hio-con n2) (λ n3 →
  hio-node (hv2-kp m n3) (hio-con n3) (hv2-port hv2-VAR v) (λ n4 → k (hio-con n4))))))
