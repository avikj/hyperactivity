b2-cmpv : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-cmpv mm_ a b kq_ =
  b2-nm mm_ (the (List Word) (if %wlt a b then "LT" else if %weq a b then "EQ" else "GT")) (λ k → let mm_2489 = b2-dep mm_ k in b2-arr mm_2489 #0 (λ e → let mm_2490 = b2-dep mm_2489 e in b2-Ctr mm_2490 k e #0 (λ r → let mm_2491 = b2-dep mm_2490 r in kq_ (h4-depl mm_2491 (r)))))
