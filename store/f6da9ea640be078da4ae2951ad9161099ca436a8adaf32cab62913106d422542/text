-- THEOREM 3: P2P ATLAS SEMILATTICE COMMUTATIVITY (min(a, b) === min(b, a) for ALL a, b : Nat)
eg-thm-min-comm : (a b : Nat) → eg-min a b ≡ eg-min b a
eg-thm-min-comm zero    zero    = refl
eg-thm-min-comm zero    (suc _) = refl
eg-thm-min-comm (suc _) zero    = refl
eg-thm-min-comm (suc a) (suc b) = λ i → suc (eg-thm-min-comm a b i)
