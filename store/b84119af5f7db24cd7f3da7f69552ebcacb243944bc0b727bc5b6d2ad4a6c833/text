gir-fmt-telem : List Word
gir-fmt-telem =
  gir-jobj
    (list-append
      (gir-l8
        (gir-jfs "event" "wave_telemetry")
        (gir-jf  "wave" "%u")
        (gir-jf  "shard" "%u")
        (gir-jf  "elapsed_s" "%.3f")
        (gir-jf  "evals" "%llu")
        (gir-jf  "mevals_s" "%.2f")
        (gir-jf  "qt_live" "%u")
        (gir-jf  "pool_sz" "%u"))
      (gir-l6
        (gir-jf "pruned" "%llu")
        (gir-jf "gc_reclaimed" "%llu")
        (gir-jf "contractible_steps" "%llu")
        (gir-jf "cryptic_verified" "%llu")
        (gir-jf "rss_kib" "%llu")
        (gir-jf "best" gir-fmt-best-sub)))
