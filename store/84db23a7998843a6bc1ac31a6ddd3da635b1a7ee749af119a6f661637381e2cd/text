b2-anynq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-anynq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-anynq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_7255 = tel in let j_7256 = j in scmd (w-load ((b2-a mm_ (%wadd a_7255 (%wsucc j_7256))))) (λ x_7254 → let mm_7257 = b2-dep mm_ x_7254 in let c = x_7254 in let i_7259 = (%wadd c #3) in scmd (w-load ((b2-a mm_7257 i_7259))) (λ x_7258 → let mm_7260 = b2-dep mm_7257 x_7258 in let vT = x_7258 in let t_7262 = vT in scmd (w-load ((b2-a mm_7260 t_7262))) (λ x_7261 → let mm_7263 = b2-dep mm_7260 x_7261 in let tg = (%wand x_7261 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_7263 (#1))) else (b2-anynq mm_7263 f tel (%wsucc j) n kq_)))))
