b2-copyf : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-copyf mm_ zero src dst j n kq_ =
  kq_ (h4-depl mm_ (dst))
b2-copyf mm_ (suc f) src dst j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (dst))) else (let i_2 = (%wadd src j) in scmd (w-load ((b2-a mm_ i_2))) (λ x_1 → let mm_3 = b2-dep mm_ x_1 in let x = x_1 in let i_4 = (%wadd dst j) in let v_5 = x in scmd (w-store ((b2-a mm_3 i_4)) (v_5)) (λ uu_6 → let mm_7 = hv2-u mm_3 uu_6 in b2-copyf mm_7 f src dst (%wsucc j) n kq_)))
