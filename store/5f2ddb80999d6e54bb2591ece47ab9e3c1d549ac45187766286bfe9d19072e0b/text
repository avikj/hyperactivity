b2-letenv : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-letenv mm_ zero is xs j n env kq_ =
  kq_ (h4-depl mm_ (env))
b2-letenv mm_ (suc f) is xs j n env kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (env))) else (let a_2352 = is in let j_2353 = j in scmd (w-load ((b2-a mm_ (%wadd a_2352 (%wsucc j_2353))))) (λ x_2351 → let mm_2354 = b2-dep mm_ x_2351 in let i = x_2351 in let a_2356 = xs in let j_2357 = j in scmd (w-load ((b2-a mm_2354 (%wadd a_2356 (%wsucc j_2357))))) (λ x_2355 → let mm_2358 = b2-dep mm_2354 x_2355 in let x = x_2355 in b2-lset mm_2358 env i x (λ e2 → let mm_2359 = b2-dep mm_2358 e2 in b2-letenv mm_2359 f is xs (%wsucc j) n e2 kq_))))
