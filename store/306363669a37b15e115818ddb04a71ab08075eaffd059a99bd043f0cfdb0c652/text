-- Prebuilt JSON format templates for C11 telemetry
gir-fmt-wave1 : List Word
gir-fmt-wave1 =
  gir-jobj
    (gir-l8
      (gir-jfs "event" "wave1_atlas_complete")
      (gir-jf  "npn3_classes" "%u")
      (gir-jf  "npn4_classes" "%u")
      (gir-jf  "u4_covered" "%u")
      (gir-jfs "gauge_commit" "0x%016llx")
      (gir-jf  "fib0_xor" "%u")
      (gir-jf  "fib0_and" "%u")
      (gir-jf  "fib0_nand2" "%u"))
