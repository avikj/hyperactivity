ScBilin : (W A : Type) → (W → W → W) → (W → W) → (A → A → A) → (A → A) → (W → W → A) → Type
ScBilin W A addW negW add neg B =
  ((x y : W) → B x y ≡ B y x) ×
  (((x y w : W) → B (addW x y) w ≡ add (B x w) (B y w)) ×
  (((x y w : W) → B x (addW y w) ≡ add (B x y) (B x w)) ×
  ((x y : W) → B x (negW y) ≡ neg (B x y))))
