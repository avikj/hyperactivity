b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_6899 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6899 b2-ERR)) else (b2-iskw mm_6899 k (λ kw → let mm_6900 = b2-dpb mm_6899 kw in if (kw) then (b2-nbytes mm_6900 k (λ kb → let mm_6901 = b2-dpl mm_6900 kb in let p_6903 = p in let i_6905 = (%wadd p_6903 #1) in scmd (w-load ((b2-a mm_6901 i_6905))) (λ x_6904 → let mm_6906 = b2-dep mm_6901 x_6904 in let x_6902 = x_6904 in let i = x_6902 in let p_6908 = p in let i_6910 = (%wadd p_6908 #1) in scmd (w-load ((b2-a mm_6906 i_6910))) (λ x_6909 → let mm_6911 = b2-dep mm_6906 x_6909 in let x_6907 = x_6909 in let ixq = x_6907 in b2-pfail mm_6911 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6912 = b2-dep mm_6911 r in kq_ (h4-depl mm_6912 (r))))))) else (kq_ (h4-depl mm_6900 (k))))))
