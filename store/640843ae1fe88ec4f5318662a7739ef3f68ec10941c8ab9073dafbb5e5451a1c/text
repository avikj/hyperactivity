cl-js-1 : List Word
cl-js-1 =
  cl-cat
    (cons (cl-ql "<script>(function(){" nil)
    (cons (cl-ql "var qs=function(s){return document.querySelector(s);};" nil)
    (cons (cl-ql "var up=new URLSearchParams(location.search),initPeer=up.get('peer')||localStorage.getItem('hx_collab_handle')||'rad2520';" nil)
    (cons (cl-ql "var hInp=qs('#cl-handle');hInp.value=initPeer;" nil)
    (cons (cl-ql "function myHandle(){var v=(hInp.value||'rad2520').trim().replace(/[^a-zA-Z0-9_-]/g,'').slice(0,24)||'peer';localStorage.setItem('hx_collab_handle',v);return v;}" nil)
    (cons (cl-ql "var tabId=myHandle()+'_'+Math.random().toString(36).slice(2,6),mySeq=Math.floor(Date.now()/1000);" nil)
    (cons (cl-ql "var seenSeq={},feedItems=[],nodeMap={},rtcPeers={},wasmBytes=0,curMod='lib/hx-univalent-diamond-trace.hypercubical';" nil)
    (cons (cl-ql "function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}" nil)
    (cons (cl-ql "function logOut(s){var el=qs('#cl-out');if(el)el.textContent=s;}" nil)
    (cons (cl-ql "qs('#cl-copy-link').onclick=function(){var u=location.origin+'/collab?peer='+encodeURIComponent(myHandle())+'&mod='+encodeURIComponent(curMod);navigator.clipboard.writeText(u);logOut('Copied invite URL: '+u);};" nil)
    (cons (cl-ql "qs('#cl-copy-cli').onclick=function(){navigator.clipboard.writeText(qs('#cl-cli').textContent);logOut('Copied 1-command terminal launch snippet.');};" nil)
    nil)))))))))))
