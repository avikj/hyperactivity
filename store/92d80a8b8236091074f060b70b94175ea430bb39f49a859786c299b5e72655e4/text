-- THEOREM 3 (THEOREM Le18 VERIFIED ON EXACT LEMNISCATE DERIVATIVES A_5 = -12, A_9 = 3024!):
-- Verifies v_p(|A_n|) >= floor(n*p / (p^2 - 1)) at inert primes p = 3 and p = 7!
cm-thm-le18-exact-derivatives :
  andB (not (%wlt (cm-vp cm-lemniscate-A5 #3) (rh-cm-lemniscate-vp #5 #3)))
  (andB (not (%wlt (cm-vp cm-lemniscate-A9 #3) (rh-cm-lemniscate-vp #9 #3)))
  (andB (%weq (cm-vp cm-lemniscate-A9 #3) #3)
        (not (%wlt (cm-vp cm-lemniscate-A9 #7) (rh-cm-lemniscate-vp #9 #7))))) ≡ true
cm-thm-le18-exact-derivatives = refl
