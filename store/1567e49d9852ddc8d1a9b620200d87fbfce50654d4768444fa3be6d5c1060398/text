b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6885 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6885 (k))) else (b2-nbytes mm_6885 ns (λ nb → let mm_6886 = b2-dpl mm_6885 nb in b2-nbytes mm_6886 k (λ kb → let mm_6887 = b2-dpl mm_6886 kb in b2-nm mm_6887 (list-append nb (cons #58 kb)) (λ r → let mm_6888 = b2-dep mm_6887 r in kq_ (h4-depl mm_6888 (r)))))))
