-- a reduction out of steps: its registers kept for the next batch, and the mark of a suspension
h4-wsusp : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-wsusp mm_ st cur sp ra rb kq_ =
  scmd (w-store ((%wadd mm_ #64)) (st)) (λ uu_236 → let mm_237 = hv2-u mm_ uu_236 in scmd (w-store ((%wadd mm_237 #72)) (cur)) (λ uu_238 → let mm_239 = hv2-u mm_237 uu_238 in scmd (w-store ((%wadd mm_239 #80)) (sp)) (λ uu_240 → let mm_241 = hv2-u mm_239 uu_240 in scmd (w-store ((%wadd mm_241 #88)) (ra)) (λ uu_242 → let mm_243 = hv2-u mm_241 uu_242 in scmd (w-store ((%wadd mm_243 #96)) (rb)) (λ uu_244 → let mm_245 = hv2-u mm_243 uu_244 in kq_ (h4-depl mm_245 (hv2-none)))))))
