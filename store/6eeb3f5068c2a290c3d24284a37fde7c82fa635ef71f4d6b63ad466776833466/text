rp-mul16 : Word → Word → Word
rp-mul16 a b =
  let ua  = rp-w32 a
      ub  = rp-w32 b
      na  = %wlt #2147483647 ua
      nb  = %wlt #2147483647 ub
      ma  = if na then rp-neg32 ua else ua
      mb  = if nb then rp-neg32 ub else ub
      pr  = %wshr (%wmul ma mb) #16
      neg = if na then not nb else nb
  in if neg then rp-neg32 pr else rp-w32 pr
