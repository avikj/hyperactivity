-- Exact 3-state irreducible KMS detailed-balance Markov matrix T for w = [4, 2, 1]:
--   T = [[3/4, 1/4, 0], [1/2, 1/4, 1/4], [0, 1/2, 1/2]].
-- Row sums = 1, detailed balance w_i T_{ij} = w_j T_{ji}, and w * T = w identically in BQ!
qt-q : Nat → Nat → BQ
qt-q a b = bq-make true (bin-of-nat a) (bin-of-nat b)
