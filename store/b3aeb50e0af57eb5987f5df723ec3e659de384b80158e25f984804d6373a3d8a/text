b2-opfail : Word → Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-opfail mm_ t s kb kq_ =
  b2-booknil mm_  (λ bk → let mm_2591 = b2-dep mm_ bk in b2-spantext mm_2591 s kb (λ op → let mm_2592 = b2-dpl mm_2591 op in b2-failn mm_2592 bk #0 (list-append "a type for this operator (write (a " (list-append op " b : Nat))")) #0 s #0 (list-append "Note: we broke this after launch, sorry. Until 2.0.16 a bare operator meant Nat." (cons #10 "That was a bug: operators demand annotation. Wrap the expression and it'll work again.")) (λ r → let mm_2593 = b2-dep mm_2592 r in kq_ (h4-depl mm_2593 (r)))))
