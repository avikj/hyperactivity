-- a Nat term's number through up to 64 Succ: a literal or Zero at the end, its cells followed
b2-natnum : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-natnum mm_ zero t acc kq_ =
  kq_ (h4-depl mm_ (b2-NNONE))
b2-natnum mm_ (suc f) t acc kq_ =
  b2-strip mm_ t (λ w → let mm_2460 = b2-dep mm_ w in let t_2462 = w in scmd (w-load ((b2-a mm_2460 t_2462))) (λ x_2461 → let mm_2463 = b2-dep mm_2460 x_2461 in let tg = (%wand x_2461 #255) in let t_2465 = w in let j_2466 = #0 in scmd (w-load ((b2-a mm_2463 (%wadd t_2465 (%wadd #2 j_2466))))) (λ x_2464 → let mm_2467 = b2-dep mm_2463 x_2464 in let lk = x_2464 in let t_2469 = w in let j_2470 = #1 in scmd (w-load ((b2-a mm_2467 (%wadd t_2469 (%wadd #2 j_2470))))) (λ x_2468 → let mm_2471 = b2-dep mm_2467 x_2468 in let v = x_2468 in if (andB (%weq tg b2-LIT) (%weq lk b2-LNAT)) then (kq_ (h4-depl mm_2471 ((%wadd acc v)))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NZero)) then (kq_ (h4-depl mm_2471 (acc))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NSucc)) then (let a_2473 = v in let j_2474 = #0 in scmd (w-load ((b2-a mm_2471 (%wadd a_2473 (%wsucc j_2474))))) (λ x_2472 → let mm_2475 = b2-dep mm_2471 x_2472 in let x = x_2472 in b2-natnum mm_2475 f x (%wsucc acc) kq_)) else (kq_ (h4-depl mm_2471 (b2-NNONE)))))))))
