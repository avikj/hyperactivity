b2-wnfbatch : Word → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfbatch mm_ rx bk md a b c kq_ =
  scmd ((w-sys #900 #0 #0 #0 #0 #0 #0)) (λ mk → let mm_2643 = b2-dep mm_ mk in scmd (w-store ((b2-HR mm_2643 #10)) (#0)) (λ uu_2644 → let mm_2645 = hv2-u mm_2643 uu_2644 in rx mm_2645 md bk a b c #0 (λ r → let mm_2646 = b2-dep mm_2645 r in scmd (w-store ((b2-HR mm_2646 #7)) ((the Word (if %weq r b2-SUSP then #1 else #0)))) (λ uu_2647 → let mm_2648 = hv2-u mm_2646 uu_2647 in scmd (w-store ((b2-HR mm_2648 #8)) (r)) (λ uu_2649 → let mm_2650 = hv2-u mm_2648 uu_2649 in (scmd (w-sys #901 #0 #0 #0 #0 #0 #0) kq_))))))
