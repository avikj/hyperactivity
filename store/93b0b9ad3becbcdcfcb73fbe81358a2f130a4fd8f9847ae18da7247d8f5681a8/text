
-- ===========================================================================================
-- Lexing (bend.ts parse_skip, parse_at, parse_take, ...): p is the parser's state
-- ===========================================================================================

macro b2m-pos (p : Word) : Word
  x <- b2m-rd (%wadd p #1)
  ret x

macro b2m-setpos (p : Word) (v : Word) : Word
  do b2m-wr (%wadd p #1) v
  ret v

fn b2-pstr (p : Word) : Word
  file <- b2m-rd p
  s <- b2m-f file #0
  ret s

-- the unit at i (hv2-none past the end)
fn b2-uat (s : Word) (i : Word) : Word
  n <- b2m-len s
  if not (%wlt i n)
    ret hv2-none
  c <- b2m-at s i
  ret c

fn b2-peek (p : Word) : Word
  s <- b2-pstr p
  i <- b2m-pos p
  c <- b2-uat s i
  ret c

fn b2-bump (p : Word) : Word
  c <- b2-peek p
  i <- b2m-pos p
  do b2m-setpos p (%wsucc i)
  ret c

-- the text w (ASCII) is at i
fnrec b2-atg (f : Nat) (s : Word) (i : Word) (w : List Word) : Word
  zero: ret #1
  if h4-isnil w
    ret #1
  c <- b2-uat s i
  if not (%weq c (hv2-nth #0 w))
    ret #0
  jump b2-atg f s (%wsucc i) (hv2-drop1 w)

fn b2-at (p : Word) (w : List Word) : Word
  s <- b2-pstr p
  i <- b2m-pos p
  r <- b2-atg (toNat #4294967295) s i w
  ret r

fn b2-take (p : Word) (w : List Word) : Word
  r <- b2-at p w
  if %weq r #0
    ret #0
  i <- b2m-pos p
  do b2m-setpos p (%wadd i (cli-len w))
  ret #1

fnrec b2-skipg (f : Nat) (s : Word) (i : Word) (n : Word) (cmt : Word) : Word
  zero: ret i
  if not (%wlt i n)
    ret i
  c <- b2m-at s i
  if %weq cmt #1
    if %weq c #10
      jump b2-skipg f s i n #0
    jump b2-skipg f s (%wsucc i) n #1
  if orB (%weq c #32) (orB (%weq c #10) (orB (%weq c #13) (%weq c #9)))
    jump b2-skipg f s (%wsucc i) n #0
  if %weq c #35
    jump b2-skipg f s i n #1
  ret i

fn b2-skip (p : Word) : Word
  s <- b2-pstr p
  i <- b2m-pos p
  n <- b2m-len s
  j <- b2-skipg (toNat #4294967295) s i n #0
  do b2m-setpos p j
  ret #0

-- parse_fail(p, exp, beg, end)
fn b2-pfail (p : Word) (exp : List Word) (beg : Word) (end : Word) : Word
  s <- b2-pstr p
  i <- b2m-pos p
  n <- b2m-len s
  bk <- b2m-rd (%wadd p #2)
  file <- b2m-rd p
  sl <-[b2-dpl] b2-slice s beg end
  c <- b2-uat s i
  let obs = the (List Word) (if %wlt beg end then cons #39 (list-append (b2-utf8 sl) (cons #39 nil)) else if %wlt i n then cons #39 (list-append (b2-utf8 (cons c nil)) (cons #39 nil)) else "end of input")
  o <- b2-msg obs
  sp <- b2-span file beg end
  e <- b2-msg exp
  r <- b2-raise bk #0 e o sp #0 #0
  ret r

fn b2-pfailh (p : Word) (exp : List Word) : Word
  i <- b2m-pos p
  r <- b2-pfail p exp i i
  ret r

fn b2-eat (p : Word) (w : List Word) : Word
  do b2-skip p
  t <- b2-take p w
  if %weq t #1
    ret #0
  r <- b2-pfailh p (cons #39 (list-append w (cons #39 nil)))
  ret r

fn b2-atword (p : Word) (w : List Word) : Word
  do b2-skip p
  a <- b2-at p w
  if %weq a #0
    ret #0
  s <- b2-pstr p
  i <- b2m-pos p
  c <- b2-uat s (%wadd i (cli-len w))
  ret (hv2-b (not (andB (not (%weq c hv2-none)) (b2-ischar c))))

fn b2-word (p : Word) (w : List Word) : Word
  a <- b2-atword p w
  if %weq a #0
    ret #0
  do b2-take p w
  ret #1

fnrec b2-namelen (f : Nat) (s : Word) (i : Word) (n : Word) : Word
  zero: ret i
  if not (%wlt i n)
    ret i
  c <- b2m-at s i
  if b2-ischar c
    jump b2-namelen f s (%wsucc i) n
  ret i

-- a dot followed by no name-head (/\.(?![A-Za-z_])/)
b2-baddot : List Word → Bool
b2-baddot nil = false
b2-baddot (cons c r) = if %weq c #46 then (if h4-isnil r then true else orB (not (b2-ishead (hv2-nth #0 r))) (b2-baddot r)) else b2-baddot r

-- parse_lexeme: a name (its id)
fn b2-lexeme (p : Word) : Word
  do b2-skip p
  c <- b2-peek p
  if not (andB (not (%weq c hv2-none)) (b2-ishead c))
    r <- b2-pfailh p "a name"
    ret r
  s <- b2-pstr p
  beg <- b2m-pos p
  n <- b2m-len s
  e <- b2-namelen (toNat #4294967295) s beg n
  do b2m-setpos p e
  ks <-[b2-dpl] b2-slice s beg e
  if andB (b2-has #46 ks) (b2-baddot ks)
    ixq <- b2m-pos p
    r <- b2-pfail p (list-append "a name (words joined by dots, got '" (list-append ks "')")) beg ixq
    ret r
  id <- b2-nm ks
  ret id

b2-keywords : List (List Word)
b2-keywords = cons "def" (cons "type" (cons "law" (cons "match" (cons "case" (cons "do" (cons "return" (cons "for" (cons "exs" (cons "where" (cons "is" (cons "import" (cons "Type" (cons "Data" (cons "Kind" (cons "Quant" nil)))))))))))))))

fn b2-iskw (k : Word) : Bool
  kb <-[b2-dpl] b2-nbytes k
  ret (h4-seenp b2-keywords kb)

fn b2-name (p : Word) : Word
  k <-! b2-lexeme p
  kw <-[b2-dpb] b2-iskw k
  if kw
    kb <-[b2-dpl] b2-nbytes k
    i <- b2m-pos p
    ixq <- b2m-pos p
    r <- b2-pfail p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq
    ret r
  ret k

-- parse_col: the column of pos (1-based, in units)
fnrec b2-linestart (f : Nat) (s : Word) (i : Word) : Word
  zero: ret #0
  if %weq i #0
    ret #0
  c <- b2m-at s (%wsub i #1)
  if %weq c #10
    ret i
  jump b2-linestart f s (%wsub i #1)

fn b2-col (s : Word) (pos : Word) : Word
  l <- b2-linestart (toNat #4294967295) s pos
  ret (%wadd (%wsub pos l) #1)

-- parse_nl: only spaces back to a newline (or the start)
fnrec b2-nlg (f : Nat) (s : Word) (j : Word) : Word
  zero: ret #1
  if %weq j #0
    ret #1
  c <- b2m-at s (%wsub j #1)
  if %weq c #10
    ret #1
  if orB (%weq c #32) (orB (%weq c #13) (%weq c #9))
    jump b2-nlg f s (%wsub j #1)
  ret #0

fn b2-nl (p : Word) : Word
  s <- b2-pstr p
  i <- b2m-pos p
  r <- b2-nlg (toNat #4294967295) s i
  ret r

fn b2-pspan (p : Word) (beg : Word) : Word
  file <- b2m-rd p
  i <- b2m-pos p
  s <- b2-span file beg i
  ret s

-- parse_char: one character (an escape, or a code point)
fnrec b2-hexv (f : Nat) (s : Word) (i : Word) (n : Word) (v : Word) (cnt : Word) : Word
  zero: ret v
  if not (%wlt i n)
    ret (%wor v (%wshl cnt #40))
  c <- b2m-at s i
  let d = the Word (if andB (%wlt #47 c) (%wlt c #58) then %wsub c #48 else if andB (%wlt #96 c) (%wlt c #103) then %wsub c #87 else if andB (%wlt #64 c) (%wlt c #71) then %wsub c #55 else hv2-none)
  if %weq d hv2-none
    ret (%wor v (%wshl cnt #40))
  jump b2-hexv f s (%wsucc i) n (%wand (%wadd (%wmul v #16) d) #1099511627775) (%wsucc cnt)

fn b2-pchar (p : Word) : Word
  bs <- b2-take p (cons #92 nil)
  s <- b2-pstr p
  i <- b2m-pos p
  n <- b2m-len s
  if %weq bs #1
    -- \u{hex}: within the next 11 units
    u <- b2-at p "u{"
    lim <- b2-min (%wadd i #11) n
    hv <- b2-hexv (toNat #16) s (%wadd i #2) lim #0 #0
    let cnt = %wshr hv #40
    let v = %wand hv #1099511627775
    cb <- b2-uat s (%wadd (%wadd i #2) cnt)
    if andB (%weq u #1) (andB (%wlt #0 cnt) (andB (%weq cb #125) (not (%wlt lim (%wadd (%wadd i #3) cnt)))))
      do b2m-setpos p (%wadd (%wadd i #3) cnt)
      ret v
    c <- b2-bump p
    let e = the Word (if %weq c #110 then #10 else if %weq c #116 then #9 else if %weq c #114 then #13 else if %weq c #48 then #0 else if %weq c #92 then #92 else if %weq c #39 then #39 else if %weq c #34 then #34 else hv2-none)
    if %weq e hv2-none
      r <- b2-pfailh p (cons #97 (cons #110 (list-append " escape (" (list-append (cons #92 "n ") (list-append (cons #92 "t ") (list-append (cons #92 "r ") (list-append (cons #92 "0 ") (list-append (cons #92 (cons #92 " ")) (list-append (cons #92 "' ") (list-append (cons #92 (cons #34 " ")) (list-append (cons #92 "u{1F600}") ")")))))))))))
      ret r
    ret e
  if not (%wlt i n)
    r <- b2-pfailh p "a character"
    ret r
  c <- b2-cpat s i
  do b2m-setpos p (%wadd i (the Word (if %wlt #65535 c then #2 else #1)))
  ret c

fn b2-min (a : Word) (b : Word) : Word
  ret (the Word (if %wlt a b then a else b))

-- ===========================================================================================
-- Binders and names (parse_open, parse_push, parse_close, parse_var, parse_qual, parse_reso,
-- parse_own, parse_call)
-- ===========================================================================================

fn b2-ppush (p : Word) (k : Word) (i : Word) : Word
  idx <- b2m-rd (%wadd p #5)
  stk <- b2m-rd (%wadd p #4)
  is0 <- b2-mget idx k
  if %weq is0 hv2-none
    v <- b2-vec
    do b2-mset idx k v
    do b2-vpush v i
    do b2-vpush stk v
    ret #0
  do b2-vpush is0 i
  do b2-vpush stk is0
  ret #0

fn b2-popen (p : Word) (k : Word) : Word
  i <- b2-fresh p
  if not (%weq k b2-N_)
    do b2-ppush p k i
  ret i

fnrec b2-pcloseg (f : Nat) (stk : Word) (n : Word) : Word
  zero: ret #0
  l <- b2m-vlen stk
  if not (%wlt n l)
    ret #0
  is <- b2m-vat stk (%wsub l #1)
  do b2m-wr stk (%wsub l #1)
  il <- b2m-vlen is
  do b2m-wr is (%wsub il #1)
  jump b2-pcloseg f stk n

fn b2-pclose (p : Word) (n : Word) : Word
  stk <- b2m-rd (%wadd p #4)
  do b2-pcloseg (toNat #4294967295) stk n
  ret #0

fn b2-stklen (p : Word) : Word
  stk <- b2m-rd (%wadd p #4)
  l <- b2m-vlen stk
  ret l

fn b2-pns (p : Word) : Word
  file <- b2m-rd p
  ns <- b2m-f file #1
  ret ns

-- parse_qual: ns:k (k itself in the empty namespace)
fn b2-qual (p : Word) (k : Word) : Word
  ns <- b2-pns p
  if %weq ns b2-NEMPTYSTR
    ret k
  nb <-[b2-dpl] b2-nbytes ns
  kb <-[b2-dpl] b2-nbytes k
  r <- b2-nm (list-append nb (cons #58 kb))
  ret r

-- a table of the book: 0 tlds, 1 ctrs
fn b2-btab (p : Word) (t : Word) : Word
  bk <- b2m-rd (%wadd p #2)
  tab <- b2m-f bk t
  ret tab

fn b2-inmap (mp : Word) (k : Word) : Word
  v <- b2-mget mp k
  ret (hv2-b (not (%weq v hv2-none)))

-- parse_reso(p, k, t)
fn b2-reso (p : Word) (k : Word) (t : Word) : Word
  tab <- b2-btab p t
  q0 <- b2-qual p k
  kb <-[b2-dpl] b2-nbytes k
  al <- b2m-rd (%wadd p #8)
  let hasdot = b2-has #46 kb
  a <- b2-nm (b2-upto #46 kb)
  tgt <- b2-mget al a
  if andB hasdot (not (%weq tgt hv2-none))
    tb <-[b2-dpl] b2-nbytes tgt
    q <- b2-nm (list-append tb (cons #58 (b2-afterdot kb)))
    qin <- b2-inmap tab q
    kin <- b2-inmap tab k
    if andB (not (%weq q k)) (andB (%weq qin #1) (%weq kin #1))
      ab <-[b2-dpl] b2-nbytes a
      r <- b2-pfailh p (list-append "an unambiguous name (the alias " (list-append ab (list-append " shadows " (list-append kb ")"))))
      ret r
    ret (the Word (if orB (%weq qin #1) (%weq kin #0) then q else k))
  qin <- b2-inmap tab q0
  kin <- b2-inmap tab k
  ret (the Word (if orB (%weq qin #1) (%weq kin #0) then q0 else k))

b2-afterdot : List Word → List Word
b2-afterdot nil = nil
b2-afterdot (cons c r) = if %weq c #46 then r else b2-afterdot r

fn b2-own (p : Word) (k : Word) (t : Word) : Word
  tab <- b2-btab p t
  q <- b2-qual p k
  qin <- b2-inmap tab q
  kin <- b2-inmap tab k
  ret (the Word (if orB (%weq qin #1) (%weq kin #0) then q else k))

fn b2-pvar (p : Word) (k : Word) (s : Word) : Word
  idx <- b2m-rd (%wadd p #5)
  is <- b2-mget idx k
  if not (%weq is hv2-none)
    n <- b2m-vlen is
    if %wlt #0 n
      i <- b2m-vat is (%wsub n #1)
      r <- b2-Var k i s #0
      ret r
  q <-! b2-reso p k #0
  kb <-[b2-dpl] b2-nbytes k
  rf <- b2-Ref q s #0
  if b2-has #46 kb
    ret rf
  i <- b2-fresh p
  r <- b2-Var k i s rf
  ret r

-- parse_call(p, k, xs, s): Ref(reso k) applied to xs
fnrec b2-appsg (f : Nat) (t : Word) (xs : Word) (j : Word) (n : Word) (s : Word) : Word
  zero: ret t
  if %weq j n
    ret t
  x <- b2m-at xs j
  g <- b2-App t x s
  jump b2-appsg f g xs (%wsucc j) n s

fn b2-apps (t : Word) (xs : Word) (s : Word) : Word
  n <- b2m-len xs
  r <- b2-appsg (toNat #4294967295) t xs #0 n s
  ret r

fn b2-pcall (p : Word) (k : Word) (xs : Word) (s : Word) : Word
  q <-! b2-reso p k #0
  rf <- b2-Ref q s #0
  r <- b2-apps rf xs s
  ret r

-- parse_fill(p, k, xs, s): a datatype's leading quantities as &1 when omitted
fnrec b2-quasg (f : Nat) (ob : Word) (j : Word) (n : Word) (q : Word) (s : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  t <- b2m-n1 b2-QUA s q
  do b2m-put ob j t
  jump b2-quasg f ob (%wsucc j) n q s

fn b2-quas (n : Word) (q : Word) (s : Word) : Word
  ob <- b2-arr n
  r <- b2-quasg (toNat #4294967295) ob #0 n q s
  ret r

fn b2-pfill (p : Word) (k : Word) (xs : Word) (s : Word) : Word
  bk <- b2m-rd (%wadd p #2)
  tld <- b2-tld bk k
  if %weq tld #0
    ret xs
  tg <- b2m-tag tld
  n <- b2m-f tld #0
  g <- b2m-f tld #1
  l <- b2m-len xs
  if orB (not (%weq tg b2-TADT)) (not (%weq (%wadd l g) n))
    ret xs
  qs <- b2-quas g b2-LONE s
  r <- b2-cat qs xs
  ret r

-- parse_bind: a lambda binder from a term
fn b2-pbind (p : Word) (t : Word) : Word
  tg <- b2m-tag t
  if not (%weq tg b2-VAR)
    r <- b2-pfailh p "a lambda binder (one name: k => body)"
    ret r
  k <- b2m-f t #0
  ti <- b2m-f t #1
  s <- b2m-span t
  i <- b2-popen p k
  r <- b2m-pv k i (the Word (if b2-neg ti then b2-MANY else b2-LONE)) s
  ret r

-- parse_term_ns(p, tm, h): an operator's namespace from the type after ":" (md 1: the terms of
-- array tm from j)
fnrec b2-termnsg (f : Nat) (md : Word) (p : Word) (tm : Word) (h : Word) (j : Word) : Word
  zero: ret #0
  if %weq md #1
    n <- b2m-len tm
    if %weq j n
      ret #0
    x <- b2m-at tm j
    do! b2-termnsg f #0 p x h #0
    jump b2-termnsg f #1 p tm h (%wsucc j)
  tg <- b2m-tag tm
  if %weq tg b2-LET
    g <- b2m-f tm #4
    jump b2-termnsg f #0 p g h #0
  ua <- b2-unapply tm
  g <- b2m-rd ua
  xs <- b2m-rd (%wadd ua #1)
  gt <- b2m-tag g
  if not (%weq gt b2-REF)
    ret #0
  gk <- b2m-f g #0
  gb <-[b2-dpl] b2-nbytes gk
  if b2-isop gb
    ht <- b2m-tag h
    if not (orB (%weq ht b2-VAR) (orB (%weq ht b2-REF) (%weq ht b2-ADT)))
      bk <- b2m-rd (%wadd p #2)
      hs <- b2m-span h
      r <- b2-fail bk #0 "a type name after : (the operators' namespace)" #0 hs #0
      ret r
    hk <- b2m-f h #0
    hb <-[b2-dpl] b2-nbytes hk
    nk <- b2-nm (list-append hb gb)
    q <-! b2-reso p nk #0
    do b2m-setf g #0 q
    jump b2-termnsg f #1 p xs h #0
  ba <- b2-own p b2-NBooland #0
  bo <- b2-own p b2-NBoolor #0
  sa <- b2-own p b2-NStrapp #0
  if orB (%weq gk ba) (orB (%weq gk bo) (%weq gk sa))
    jump b2-termnsg f #1 p xs h #0
  ret #0

fn b2-termns (p : Word) (tm : Word) (h : Word) : Word
  r <- b2-termnsg (toNat #4294967295) #0 p tm h #0
  ret r

-- the infix operators: (text, precedence + 1, right associative, name); by first unit
b2-infix : Word → List (List Word)
b2-infix c =
  if %weq c #60 then cons "<&>" (cons "<-" (cons "<=" (cons "<>" (cons "<<" (cons "<" nil)))))
  else if %weq c #45 then cons "->" (cons "-" nil)
  else if %weq c #38 then cons "&&" (cons "&" nil)
  else if %weq c #124 then cons "||" (cons "|" nil)
  else if %weq c #62 then cons ">=" (cons ">>" (cons ">" nil))
  else if %weq c #46 then cons ".|." (cons ".^." (cons ".&." nil))
  else if %weq c #43 then cons "++" (cons "+" nil)
  else if %weq c #42 then cons "*" nil
  else if %weq c #47 then cons "/" nil
  else if %weq c #37 then cons "%" nil
  else nil

-- precedence + 1 of an operator
b2-oprc : List Word → Word
b2-oprc o =
  if cli-eq o "<-" then #0 else if cli-eq o "->" then #1
  else if orB (cli-eq o "&") (cli-eq o "|") then #2 else if cli-eq o "||" then #3 else if cli-eq o "&&" then #4
  else if orB (cli-eq o "<") (orB (cli-eq o "<=") (orB (cli-eq o ">") (cli-eq o ">="))) then #5
  else if orB (cli-eq o "<>") (orB (cli-eq o "++") (cli-eq o "<&>")) then #6
  else if cli-eq o ".|." then #7 else if cli-eq o ".^." then #8 else if cli-eq o ".&." then #9
  else if orB (cli-eq o "<<") (cli-eq o ">>") then #10 else if orB (cli-eq o "+") (cli-eq o "-") then #11
  else #12

b2-oright : List Word → Bool
b2-oright o = orB (cli-eq o "->") (orB (cli-eq o "&") (orB (cli-eq o "|") (orB (cli-eq o "<>") (orB (cli-eq o "++") (cli-eq o "<&>")))))

b2-oname : List Word → List Word
b2-oname o =
  if cli-eq o "&" then "Pair" else if cli-eq o "|" then "Or" else if cli-eq o "||" then "Bool.or"
  else if cli-eq o "&&" then "Bool.and" else if cli-eq o "<" then ".is_lt" else if cli-eq o "<=" then ".is_le"
  else if cli-eq o ">" then ".is_gt" else if cli-eq o ">=" then ".is_ge" else if cli-eq o "<>" then "Con"
  else if cli-eq o "++" then "String.append" else if cli-eq o ".|." then ".or" else if cli-eq o ".^." then ".xor"
  else if cli-eq o ".&." then ".and" else if cli-eq o "<<" then ".shln" else if cli-eq o ">>" then ".shrn"
  else if cli-eq o "+" then ".add" else if cli-eq o "-" then ".sub" else if cli-eq o "*" then ".mul"
  else if cli-eq o "/" then ".div" else ".mod"

-- the first operator of the list at p (nil when none)
fnrec b2-findop (f : Nat) (p : Word) (os : List (List Word)) : List Word
  zero: ret nil
  if h4-stknil0 os
    ret nil
  let o = h4-tget-go #0 os
  a <- b2-at p o
  if %weq a #1
    ret o
  jump b2-findop f p (h4-tl0 os)

-- a white space unit (JavaScript's \s)
b2-isws : Word → Bool
b2-isws c = orB (%weq c #32) (orB (andB (%wlt #8 c) (%wlt c #14)) (orB (%weq c #160) (orB (%weq c #5760) (orB (andB (%wlt #8191 c) (%wlt c #8203)) (orB (%weq c #8232) (orB (%weq c #8233) (orB (%weq c #8239) (orB (%weq c #8287) (orB (%weq c #12288) (%weq c #65279))))))))))

-- a unit that glues: a word unit, a closing bracket, or a quote
b2-isgl : Word → Bool
b2-isgl c = orB (andB (b2-ischar c) (not (%weq c #46))) (orB (%weq c #41) (orB (%weq c #93) (orB (%weq c #125) (orB (%weq c #34) (%weq c #39)))))

-- a tele cell: [q, k, i, T, s]
macro b2m-cell5 (q : Word) (k : Word) (i : Word) (vT : Word) (s : Word) : Word
  r <- b2m-rec4 q k i vT s
  ret r

-- tele_bind(tele, end): All(q, k, i, T, .., s) around end, the last innermost
fnrec b2-telebindg (f : Nat) (tel : Word) (j : Word) (e : Word) : Word
  zero: ret e
  if %weq j #0
    ret e
  c <- b2m-at tel (%wsub j #1)
  q <- b2m-rd c
  k <- b2m-rd (%wadd c #1)
  i <- b2m-rd (%wadd c #2)
  vT <- b2m-rd (%wadd c #3)
  s <- b2m-rd (%wadd c #4)
  a <- b2-All q k i vT e s
  jump b2-telebindg f tel (%wsub j #1) a

fn b2-telebind (tel : Word) (e : Word) : Word
  n <- b2m-len tel
  r <- b2-telebindg (toNat #4294967295) tel n e
  ret r

-- term_write: a write a[i] <- v at beg names its array a
fn b2-termwrite (p : Word) (t : Word) (beg : Word) : Word
  v <- b2-vec
  h <- b2-unappg (toNat #5) t v
  n <- b2m-vlen v
  if not (%weq n #4)
    ret #0
  do b2-vrev v
  ht <- b2m-tag h
  hk <- b2m-f h #0
  as <- b2-own p b2-NArrset #0
  x1 <- b2m-vat v #1
  x1t <- b2m-tag x1
  x1s <- b2m-span x1
  x1b <- b2m-f x1s #1
  if andB (%weq ht b2-REF) (andB (%weq hk as) (andB (%weq x1t b2-VAR) (andB (not (%weq x1s #0)) (%weq x1b beg))))
    ret x1
  ret #0

fn b2-more (p : Word) (col : Word) : Word
  a <- b2-at p ";"
  if %weq a #1
    ret #1
  s <- b2-pstr p
  i <- b2m-pos p
  n <- b2m-len s
  c <- b2-col s i
  ret (hv2-b (andB (%wlt i n) (%weq c col)))

fn b2-vecor (v : Word) : Word
  if %weq v #0
    r <- b2-vec
    ret r
  ret v

fn b2-takeif (c : Bool) (p : Word) (w : List Word) : Word
  if c
    r <- b2-take p w
    ret r
  ret #0

-- the arguments of +D: D's own or &1 each, the leading g as &2
fnrec b2-plusg (f : Nat) (src : Word) (ob : Word) (j : Word) (n : Word) (g : Word) (s : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  if %wlt j g
    t <- b2m-n1 b2-QUA s b2-MANY
    do b2m-put ob j t
    jump b2-plusg f src ob (%wsucc j) n g s
  if %weq src #0
    t <- b2m-n1 b2-QUA s b2-LONE
    do b2m-put ob j t
    jump b2-plusg f src ob (%wsucc j) n g s
  x <- b2m-at src j
  do b2m-put ob j x
  jump b2-plusg f src ob (%wsucc j) n g s

fn b2-plusxs (tg : Word) (txs : Word) (tn : Word) (g : Word) (s : Word) : Word
  let isadt = %weq tg b2-ADT
  n <- b2-lenor isadt txs tn
  ob <- b2-arr n
  r <- b2-plusg (toNat #4294967295) (the Word (if isadt then txs else #0)) ob #0 n g s
  ret r

fn b2-lenor (c : Bool) (a : Word) (n : Word) : Word
  if c
    l <- b2m-len a
    ret l
  ret n

fn b2-quant (exi : Bool) (p : Word) : Word
  if exi
    ret b2-LONE
  do b2-skip p
  m <- b2-take p "-"
  if %weq m #1
    ret b2-NONE
  pl <- b2-take p "+"
  if %weq pl #1
    ret b2-MANY
  ret b2-LONE

-- the arms [k, h, ..] of \{..} around the tail (0: \{}), each a Mat at the span from beg
fnrec b2-armsg (f : Nat) (v : Word) (j : Word) (t : Word) (s : Word) : Word
  zero: ret t
  if %weq j #0
    ret t
  k <- b2m-vat v (%wsub j #2)
  h <- b2m-vat v (%wsub j #1)
  m <- b2m-n3 b2-MAT s k h t
  jump b2-armsg f v (%wsub j #2) m s

fn b2-armsend (p : Word) (v : Word) (beg : Word) (tail : Word) : Word
  s <- b2-pspan p beg
  tl <- b2-efqor tail
  ts <- b2m-span tl
  if %weq ts #0
    do b2m-wr (%wadd tl #1) s
  n <- b2m-vlen v
  r <- b2-armsg (toNat #4294967295) v n tl s
  ret r

fn b2-efqor (t : Word) : Word
  if %weq t #0
    r <- b2m-n0 b2-EFQ #0
    ret r
  ret t

-- the number at p: [kind (0 U32, 1 Nat, 2 F32), value (capped past 2^34), end, digits end]
fnrec b2-digs (f : Nat) (s : Word) (i : Word) (v : Word) : Word
  zero: ret (%wor i (%wshl v #24))
  c <- b2-uat s i
  if andB (not (%weq c hv2-none)) (andB (%wlt #47 c) (%wlt c #58))
    let v2 = the Word (if %wlt v #17179869184 then %wadd (%wmul v #10) (%wsub c #48) else v)
    jump b2-digs f s (%wsucc i) v2
  ret (%wor i (%wshl v #24))

fn b2-isdig (s : Word) (i : Word) : Bool
  c <- b2-uat s i
  ret (andB (not (%weq c hv2-none)) (andB (%wlt #47 c) (%wlt c #58)))

fn b2-numlex (p : Word) : Word
  s <- b2-pstr p
  beg <- b2m-pos p
  r1 <- b2-digs (toNat #4294967295) s beg #0
  let de = %wand r1 #16777215
  let v = %wshr r1 #24
  c <- b2-uat s de
  rcd <- b2m-alloc #4
  do b2m-wr (%wadd rcd #1) v
  do b2m-wr (%wadd rcd #3) de
  if %weq c #110
    do b2m-wr rcd #1
    do b2m-wr (%wadd rcd #2) (%wsucc de)
    ret rcd
  fd <-[b2-dpb] b2-isdig s (%wsucc de)
  if andB (%weq c #46) fd
    r2 <- b2-digs (toNat #4294967295) s (%wsucc de) #0
    let fe = %wand r2 #16777215
    e <- b2-uat s fe
    sg <- b2-uat s (%wsucc fe)
    let off = the Word (if orB (%weq sg #43) (%weq sg #45) then #2 else #1)
    ed <-[b2-dpb] b2-isdig s (%wadd fe off)
    r3 <- b2-digs (toNat #4294967295) s (%wadd fe off) #0
    let ee = %wand r3 #16777215
    do b2m-wr rcd #2
    do b2m-wr (%wadd rcd #2) (the Word (if andB (orB (%weq e #101) (%weq e #69)) ed then ee else fe))
    ret rcd
  do b2m-wr rcd #0
  do b2m-wr (%wadd rcd #2) de
  ret rcd

-- n Succs around t
fnrec b2-succs (f : Nat) (t : Word) (n : Word) (s : Word) : Word
  zero: ret t
  if %weq n #0
    ret t
  xs <- b2-arr1 t
  c <- b2-Ctr b2-NSucc xs s
  jump b2-succs f c (%wsub n #1) s

-- lit_of(cs, s): a String literal, or its chain when a code point is no scalar value
fnrec b2-litchain (f : Nat) (cs : Word) (j : Word) (t : Word) (s : Word) : Word
  zero: ret t
  if %weq j #0
    ret t
  c <- b2m-vat cs (%wsub j #1)
  u <- b2m-n2 b2-LIT s b2-LU32 c
  ua <- b2-arr1 u
  ch <- b2-Ctr b2-NChr ua s
  xs <- b2-arrl (cons ch (cons t nil))
  sc <- b2-Ctr b2-NSCon xs s
  jump b2-litchain f cs (%wsub j #1) sc s

fnrec b2-allscalar (f : Nat) (cs : Word) (j : Word) (n : Word) : Word
  zero: ret #1
  if %weq j n
    ret #1
  c <- b2m-vat cs j
  if orB (%wlt #1114111 c) (andB (%wlt #55295 c) (%wlt c #57344))
    ret #0
  jump b2-allscalar f cs (%wsucc j) n

fn b2-litof (cs : Word) (s : Word) : Word
  n <- b2m-vlen cs
  ok <- b2-allscalar (toNat #4294967295) cs #0 n
  if %weq ok #1
    a <- b2-vfreeze cs
    l <-[b2-dpl] b2-list a
    us <- b2-arrl (b2-u16 l)
    r <- b2m-n2 b2-LIT s b2-LSTR us
    ret r
  e0 <- b2-arr #0
  nl <- b2-Ctr b2-NSNil e0 s
  r <- b2-litchain (toNat #4294967295) cs n nl s
  ret r

-- the nat of a term (nat_from_term), from an LTerm: Succ chains over Zero or a Nat literal
fn b2-natof (t : Word) : Word
  r <- b2-natft (toNat #4294967295) t #0
  ret r

-- log2 when n is a power of two (hv2-none otherwise)
fnrec b2-log2g (f : Nat) (n : Word) (k : Word) : Word
  zero: ret hv2-none
  if %weq n #1
    ret k
  if orB (%weq n #0) (%weq (%wand n #1) #1)
    ret hv2-none
  jump b2-log2g f (%wshr n #1) (%wsucc k)

b2-f32round : List Word → Word
b2-f32round s = ief-parse s

fnrec b2-consall (f : Nat) (ys : Word) (j : Word) (ck : Word) (t : Word) (s : Word) : Word
  zero: ret t
  if %weq j #0
    ret t
  x <- b2m-at ys (%wsub j #1)
  xs <- b2-arrl (cons x (cons t nil))
  c <- b2-Ctr ck xs s
  jump b2-consall f ys (%wsub j #1) ck c s

-- the word at p: /^[A-Za-z0-9_.]*/
fn b2-wordat (p : Word) : List Word
  s <- b2-pstr p
  i <- b2m-pos p
  n <- b2m-len s
  e <- b2-namelen (toNat #4294967295) s i n
  r <-[b2-dpl] b2-slice s i e
  ret r

-- parse_do_end
fn b2-doend (p : Word) : Word
  do b2-skip p
  e <- b2-at p "="
  e2 <- b2-at p "=="
  e3 <- b2-at p "=>"
  if andB (%weq e #1) (andB (%weq e2 #0) (%weq e3 #0))
    r <- b2-pfailh p (list-append "a do-block let with its type (write " (cons #34 (list-append "x : T = ..." (cons #34 ")"))))
    ret r
  ret #0

-- a name with a suffix
fn b2-nsuf (k : Word) (s : List Word) : Word
  kb <-[b2-dpl] b2-nbytes k
  r <- b2-nm (list-append kb s)
  ret r

-- parse_fresh(p, nm, t, what)
fn b2-pfresh (p : Word) (nm : Word) (t : Word) (what : List Word) : Word
  tab <- b2-btab p t
  k <- b2-qual p nm
  nb <-[b2-dpl] b2-nbytes nm
  let hasdot = b2-has #46 nb
  a <- b2-nm (b2-upto #46 nb)
  al <- b2m-rd (%wadd p #8)
  ain0 <- b2-inmap al a
  let ain = andB hasdot (%weq ain0 #1)
  kin <- b2-inmap tab k
  nin <- b2-inmap tab nm
  if orB (%weq kin #1) (orB (%weq nin #1) ain)
    ab <-[b2-dpl] b2-nbytes a
    i <- b2m-pos p
    nst <- b2-nstr nm
    nl <- b2m-len nst
    r <- b2-pfail p (list-append what (list-append " (" (list-append (the (List Word) (if ain then list-append ab " is an import's alias" else list-append "duplicate declaration: " nb)) ")"))) (%wsub i nl) i
    ret r
  ret k

-- the cells of a tele whose T is not Qnt: the index of the first (hv2-none: none)
fnrec b2-firstnq (f : Nat) (tel : Word) (j : Word) (n : Word) : Word
  zero: ret hv2-none
  if %weq j n
    ret hv2-none
  c <- b2m-at tel j
  vT <- b2m-rd (%wadd c #3)
  tg <- b2m-tag vT
  if not (%weq tg b2-QNT)
    ret j
  jump b2-firstnq f tel (%wsucc j) n

-- the tip of a datatype: ADT(k, params as Vars)
fnrec b2-tipvars (f : Nat) (tel : Word) (ob : Word) (j : Word) (n : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  c <- b2m-at tel j
  k <- b2m-rd (%wadd c #1)
  i <- b2m-rd (%wadd c #2)
  v <- b2-Var k i #0 #0
  do b2m-put ob j v
  jump b2-tipvars f tel ob (%wsucc j) n

-- the def's params as PVars [k, i, Lone, s]
fnrec b2-telepvs (f : Nat) (tel : Word) (ob : Word) (j : Word) (n : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  c <- b2m-at tel j
  k <- b2m-rd (%wadd c #1)
  i <- b2m-rd (%wadd c #2)
  s <- b2m-rd (%wadd c #4)
  v <- b2m-pv k i b2-LONE s
  do b2m-put ob j v
  jump b2-telepvs f tel ob (%wsucc j) n

-- the law's type: All for a for, Exists for an exs, from the last clause in
fnrec b2-lawtype (f : Nat) (p : Word) (cls : Word) (j : Word) (vT : Word) : Word
  zero: ret vT
  if %weq j #0
    ret vT
  c <- b2m-vat cls (%wsub j #1)
  all <- b2m-rd c
  q <- b2m-rd (%wadd c #1)
  k <- b2m-rd (%wadd c #2)
  i <- b2m-rd (%wadd c #3)
  vA <- b2m-rd (%wadd c #4)
  s <- b2m-rd (%wadd c #5)
  if %weq all #1
    a <- b2-All q k i vA vT s
    jump b2-lawtype f p cls (%wsub j #1) a
  ek <- b2-own p b2-NExists #0
  rf <- b2-Ref ek s #0
  l <- b2-Lam k i vT s b2-NOQ
  a1 <- b2-App rf vA s
  a2 <- b2-App a1 l s
  jump b2-lawtype f p cls (%wsub j #1) a2

fnrec b2-firstexs (f : Nat) (cls : Word) (j : Word) (n : Word) : Word
  zero: ret n
  if %weq j n
    ret n
  c <- b2m-vat cls j
  all <- b2m-rd c
  if %weq all #0
    ret j
  jump b2-firstexs f cls (%wsucc j) n

-- the tele cells with T not Qnt: any (for a law's fill)
fnrec b2-anynq (f : Nat) (tel : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if %weq j n
    ret #0
  c <- b2m-at tel j
  vT <- b2m-rd (%wadd c #3)
  tg <- b2m-tag vT
  if not (%weq tg b2-QNT)
    ret #1
  jump b2-anynq f tel (%wsucc j) n

-- the first of ts[1..] whose span starts with "+" (0 when none)
fnrec b2-plusargg (f : Nat) (str : Word) (ts : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if %weq j n
    ret #0
  x <- b2m-vat ts j
  xs <- b2m-span x
  xb <- b2m-f xs #1
  c <- b2-uat str xb
  if %weq c #43
    ret x
  jump b2-plusargg f str ts (%wsucc j) n

fn b2-plusarg (p : Word) (ts : Word) : Word
  str <- b2-pstr p
  n <- b2m-vlen ts
  r <- b2-plusargg (toNat #4294967295) str ts #1 n
  ret r

-- a case's hint: a Nat literal followed by a pattern that starts with "+"
fnrec b2-succhg (f : Nat) (str : Word) (qs : Word) (j : Word) (n : Word) : List Word
  zero: ret nil
  if not (%wlt (%wsucc j) n)
    ret nil
  q <- b2m-at qs j
  tg <- b2m-tag q
  k <- b2m-f q #0
  v <- b2m-f q #1
  nx <- b2m-at qs (%wsucc j)
  ns <- b2m-span nx
  nb <- b2m-f ns #1
  c <- b2-uat str nb
  if andB (%weq tg b2-LIT) (andB (%weq k b2-LNAT) (%weq c #43))
    ret (list-append "; a successor takes no spaces: " (list-append (ce-dec v) "n+p"))
  jump b2-succhg f str qs (%wsucc j) n

fn b2-succhint (str : Word) (qs : Word) : List Word
  n <- b2m-len qs
  r <-[b2-dpl] b2-succhg (toNat #4294967295) str qs #0 n
  ret r

fn b2-mapor (m0 : Word) : Word
  if %weq m0 #0
    r <- b2-map #0
    ret r
  ret m0

fn b2-vlenor (v : Word) : Word
  if %weq v #0
    ret #0
  n <- b2m-vlen v
  ret n

fn b2-pfreshif (c : Bool) (p : Word) (nm : Word) : Word
  if c
    r <-! b2-pfresh p nm #0 "a fresh name"
    ret r
  ret #0

-- the units up to a quote (or the end)
fnrec b2-uptoq (f : Nat) (s : Word) (i : Word) (n : Word) : Word
  zero: ret i
  if not (%wlt i n)
    ret i
  c <- b2m-at s i
  if %weq c #34
    ret i
  jump b2-uptoq f s (%wsucc i) n

b2-endswith : List Word → List Word → Bool
b2-endswith s e = andB (not (%wlt (cli-len s) (cli-len e))) (cli-eq (ief-dropn (toNat (%wsub (cli-len s) (cli-len e))) s) e)

-- a def's imports: import "x.c" ... each the parser's dir followed by the path
fnrec b2-imports (f : Nat) (p : Word) (iv : Word) : Word
  zero: ret #0
  w <- b2-word p "import"
  if %weq w #0
    ret #0
  do! b2-eat p (cons #34 nil)
  s <- b2-pstr p
  i <- b2m-pos p
  n <- b2m-len s
  e <- b2-uptoq (toNat #4294967295) s i n
  us <-[b2-dpl] b2-slice s i e
  do b2m-setpos p e
  do! b2-eat p (cons #34 nil)
  let eff = b2-utf8 us
  if not (orB (b2-endswith eff ".c") (b2-endswith eff ".js"))
    r <- b2-pfailh p "a .c or .js path"
    ret r
  dir <- b2m-rd (%wadd p #3)
  db <-[b2-dpl] b2-bytes dir
  ps <- b2-str (list-append db eff)
  do b2-vpush iv ps
  jump b2-imports f p iv

-- the parser, one function; md:
--   0 term(lvl a)   1 term_base(beg a)   2 term_ops(tm a, beg b, lvl c)   3 args(close a, vec b)
--   4 term_all(exi a)   5 term_tup(beg a)   6 num   7 do_stmt(m a, ts b, col c)   8 body(col a)
--   9 block   10 terms(vec a)   11 tele(close a, tk b, cells c, seen d)   12 def(u a)
--   13 the book   14 patt(t a)   15 \{ arms (vec a, beg b)   16 cases (match record a)
--   17 law clauses (vec a, tc b)   18 a type's constructors (record a)   19 a let's names (vec a,
--   q b)   20 patts of the array a into vec b from c   21 the template args (out a, x b, vec c)
@split b2p 1 2 3 6 7 8 12 14 16 18 22 27 34
fnrec b2p (f : Nat) (md : Word) (p : Word) (a : Word) (b : Word) (c : Word) (d : Word) : Word
  zero: jump b2-fuelout
  -- ------------------------------------------------------------------------ term
  if %weq md #0
    -- a command returns to the trampoline: the C stack a parse builds is let go here (CPS
    -- steps are calls, so an item of many terms otherwise runs as one deep recursion)
    tw <- cmd w-now
    do b2-skip p
    beg <- b2m-pos p
    base <-! b2p f #1 p beg #0 #0 #0
    bs <- b2m-span base
    if %weq bs #0
      s <- b2-pspan p beg
      do b2m-wr (%wadd base #1) s
      jump b2p f #2 p base beg a #0
    bb <- b2m-f bs #1
    jump b2p f #2 p base bb a #0
  -- ------------------------------------------------------------------------ args
  if %weq md #3
    v <- b2-vecor b
    do b2-skip p
    t <- b2-take p (cons a nil)
    if %weq t #1
      r <- b2-vfreeze v
      ret r
    x <-! b2p f #0 p #0 #0 #0 #0
    do b2-vpush v x
    do b2-skip p
    do b2-take p ","
    jump b2p f #3 p a v #0 #0
  -- ------------------------------------------------------------------------ terms
  if %weq md #10
    v <- b2-vecor a
    x <-! b2p f #0 p #0 #0 #0 #0
    do b2-vpush v x
    do b2-skip p
    t <- b2-take p ":"
    if %weq t #1
      r <- b2-vfreeze v
      ret r
    do b2-take p ","
    jump b2p f #10 p v #0 #0 #0
  -- ------------------------------------------------------------------------ term_base
  if %weq md #1
    c0 <- b2-peek p
    if andB (not (%weq c0 hv2-none)) (b2-ishead c0)
      k <-! b2-lexeme p
      kb <-[b2-dpl] b2-nbytes k
      if cli-eq kb "Type"
        r <- b2-TypQ b2-LONE #0
        ret r
      if cli-eq kb "Data"
        r <- b2-TypQ b2-MANY #0
        ret r
      if cli-eq kb "Quant"
        r <- b2m-n0 b2-QNT #0
        ret r
      if cli-eq kb "Kind"
        do! b2-eat p "("
        g <-! b2p f #0 p #0 #0 #0 #0
        do! b2-eat p ")"
        r <- b2m-n1 b2-TYP #0 g
        ret r
      if cli-eq kb "do"
        m <-! b2-name p
        do b2-skip p
        lt <- b2-take p "<"
        if %weq lt #0
          mb <-[b2-dpl] b2-nbytes m
          r <- b2-pfailh p (list-append "'<' (a do block is written do " (list-append mb "<...>:)"))
