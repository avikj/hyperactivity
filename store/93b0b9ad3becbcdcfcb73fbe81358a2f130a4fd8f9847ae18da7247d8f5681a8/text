    cs <- b2m-rd (%wadd a #2)
    bk <- b2m-rd (%wadd p #2)
    do b2-skip p
    pk <- b2-peek p
    dw <- b2-atword p "def"
    tw <- b2-atword p "type"
    lw <- b2-atword p "law"
    if orB (orB (%weq pk hv2-none) (not (b2-ishead pk))) (orB (%weq dw #1) (orB (%weq tw #1) (%weq lw #1)))
      ord <- b2m-f bk #2
      do b2-vpush ord k
      ret #1
    cn <-! b2-name p
    c <-! b2-pfresh p cn #1 "a fresh constructor name"
    do! b2-eat p "{"
    n1 <- b2-stklen p
    fs <-! b2p f #11 p #125 #0 #0 #0
    np <- b2m-len params
    to <- b2-arr np
    tv <- b2-tipvars (toNat #4294967295) params to #0 np
    e0 <- b2-arr #0
    tip <- b2-Adt k tv #0 e0
    pf <- b2-cat params fs
    tb <- b2-telebind pf tip
    vT <-! b2x (toNat #4294967295) #0 #0 tb #0 #0 #0
    nf <- b2m-len fs
    ctr <- b2m-n4 b2-TCTR #0 c nf vT k
    do b2-pclose p n1
    do b2-vpush cs ctr
    ctrs <- b2m-f bk #1
    do b2-mset ctrs c ctr
    jump b2p f #18 p a #0 #0 #0
  -- law clauses: cls a (a vector of [all, q, c, i, A, s]), tc b, k c
  if %weq md #17
    bk <- b2m-rd (%wadd p #2)
    fw <- b2-atword p "for"
    ew <- b2-atword p "exs"
    if orB (%weq fw #1) (%weq ew #1)
      all <- b2-word p "for"
      if %weq all #0
        do b2-word p "exs"
      do b2-skip p
      tl <- b2-at p "~"
      cn <- b2m-vlen a
      if andB (%weq all #1) (andB (%weq tl #1) (%wlt b cn))
        r <- b2-pfailh p "a plain clause (only leading clauses take ~)"
        ret r
      ct <- b2-takeif (%weq all #1) p "~"
      q0 <- b2-quant (not (%weq all #1)) p
      let q = the Word (if %weq ct #1 then b2-NONE else q0)
      beg <- b2m-pos p
      cnm <-! b2-name p
      s <- b2-pspan p beg
      do! b2-eat p ":"
      vA0 <-! b2p f #0 p #0 #0 #0 #0
      ww <- b2-atword p "where"
      vA <-! b2p f #36 p (hv2-b (%weq ww #1)) cnm vA0 s
      i <- b2-popen p cnm
      cl <- b2m-alloc #6
      do b2m-wr cl all
      do b2m-wr (%wadd cl #1) q
      do b2m-wr (%wadd cl #2) cnm
      do b2m-wr (%wadd cl #3) i
      do b2m-wr (%wadd cl #4) vA
      do b2m-wr (%wadd cl #5) s
      do b2-vpush a cl
      jump b2p f #17 p a (%wadd b ct) c #0
    body <-! b2p f #9 p #0 #0 #0 #0
    n <- b2m-vlen a
    vT0 <- b2-lawtype (toNat #4294967295) p a n body
    vT <-! b2x (toNat #4294967295) #0 #0 vT0 #0 #0 #0
    fe <- b2-firstexs (toNat #4294967295) a #0 n
    def <- b2-mkdef fe b vT #0
    ns <- b2-pns p
    do b2m-setf def #8 ns
    do b2m-setf def #9 #1
    tlds <- b2m-f bk #0
    do b2-mset tlds c def
    ord <- b2m-f bk #2
    do b2-vpush ord c
    ret #1
  -- a where clause: (a 1) A d's Exists(A, c => w), at the clause span s (here in register)
  if %weq md #36
    if %weq a #0
      ret c
    beg <- b2m-pos p
    do b2-word p "where"
    ws <- b2-pspan p beg
    n1 <- b2-stklen p
    i <- b2-popen p b
    w <-! b2p f #0 p #0 #0 #0 #0
    do b2-pclose p n1
    ek <- b2-own p b2-NExists #0
    rf <- b2-Ref ek ws #0
    l <- b2-Lam b i w d b2-NOQ
    a1 <- b2-App rf c d
    r <- b2-App a1 l d
    ret r
  ret #0
