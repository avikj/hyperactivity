hv2-op-f : Word → Word → Word → Word
hv2-op-f op a b =
  if %weq op #4 then hv2-fnew (ief-add a b)
  else if %weq op #5 then hv2-fnew (ief-sub a b)
  else if %weq op #6 then hv2-fnew (ief-sub b a)
  else if %weq op #7 then hv2-fnew (ief-mul a b)
  else if %weq op #8 then hv2-fnew (ief-div a b)
  else if %weq op #9 then hv2-fnew (ief-div b a)
  else if %weq op #10 then hv2-fnew (ief-rem a b)
  else if %weq op #11 then hv2-fnew (ief-rem b a)
  else if %weq op #12 then hv2-new hv2-TY-U24 (hv2-b (ief-eq a b))
  else if %weq op #13 then hv2-new hv2-TY-U24 (hv2-b (not (ief-eq a b)))
  else if %weq op #14 then hv2-new hv2-TY-U24 (hv2-b (ief-lt a b))
  else if %weq op #15 then hv2-new hv2-TY-U24 (hv2-b (ief-lt b a))
  else if %weq op #16 then hv2-fnew (ief-atan2 a b)
  else if %weq op #17 then hv2-fnew (ief-div (ief-lnv b) (ief-lnv a))
  else if %weq op #18 then hv2-fnew (ief-pow a b)
  else if %weq op #19 then hv2-fnew (ief-sin (ief-add a b))
  else if %weq op #21 then hv2-fnew (ief-tan (ief-add a b))
  else hv2-fnew #0
