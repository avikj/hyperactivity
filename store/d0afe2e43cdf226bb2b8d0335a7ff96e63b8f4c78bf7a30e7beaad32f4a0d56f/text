-- (C) Window-Relative Entity Resolution (4/4 at W_crystal AND 4/4 at W_bench) vs. Exhaustive Failure
--     of ALL 2^4 = 16 Static Canonicalizer Assignments:
rxn-entity-resolution-verdict :
  (λ gaps wCrys wBench →
    both (both (rxn-bvec-eq (rxn-resolve-at 4 gaps) wCrys)
               (rxn-bvec-eq (rxn-resolve-at 2 gaps) wBench))
         (not (rxn-any-static-ok rxn-all-bool4 wCrys wBench)))
  (rxn-l4 Nat 3 3 0 0)
  (rxn-l4 Bool false false false false)
  (rxn-l4 Bool true true false false) ≡ true
rxn-entity-resolution-verdict = refl
