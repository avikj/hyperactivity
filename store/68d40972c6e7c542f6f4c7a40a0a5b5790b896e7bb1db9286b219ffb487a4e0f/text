-- p_f(−m) and p_f′(−m) at s, as (value if positive, value if negative) via two Nats read first − second
-- p_f(−m) = −(m³ + 258m² + (16520 − 6s)m) + 280s
bs-pf : Nat → Nat → Nat × Nat
bs-pf s m = (times 280 s , plus (times m (times m m)) (plus (times 258 (times m m)) (times (monus 16520 (times 6 s)) m)))
