b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10397 = xs in scmd (w-load ((b2-a mm_ a_10397))) (λ x_10396 → let mm_10398 = b2-dep mm_ x_10396 in let n = x_10396 in if (%weq j n) then (kq_ (h4-depl mm_10398 (h))) else (let a_10400 = xs in let j_10401 = j in scmd (w-load ((b2-a mm_10398 (%wadd a_10400 (%wsucc j_10401))))) (λ x_10399 → let mm_10402 = b2-dep mm_10398 x_10399 in let x = x_10399 in b2-tapp mm_10402 bk h x #0 (λ h2 → let mm_10403 = b2-dep mm_10402 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10403 b2-ERR)) else (b2-applyall mm_10403 f bk h2 xs (%wsucc j) kq_)))))
