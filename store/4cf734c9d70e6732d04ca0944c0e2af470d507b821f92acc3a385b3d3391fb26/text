si-search-hits-b : (n : Nat) → Bytes n → List (List Word) → Nat → Word → Nat → List (Word × List (List Word))
si-search-hits-b n B q lim before win =
  let root = si-rd4 n B #0
      f = toNat (si-rd4 n B #4)
      lo = si-cnt n B #8 q f root
      hi = si-cnt n B #8 (sq-up #256 q) f root
  in si-hits-at n B f root lo hi lim before win
