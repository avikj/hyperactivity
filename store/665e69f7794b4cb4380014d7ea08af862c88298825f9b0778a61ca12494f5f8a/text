b2-unsub mm_ zero e kq_ =
  kq_ (h4-depl mm_ (e))
b2-unsub mm_ (suc f) e kq_ =
  let t_5773 = e in scmd (w-load ((b2-a mm_ t_5773))) (λ x_5772 → let mm_5774 = b2-dep mm_ x_5772 in let tg = (%wand x_5772 #255) in if (%weq tg b2-SUB) then (let t_5776 = e in let j_5777 = #2 in scmd (w-load ((b2-a mm_5774 (%wadd t_5776 (%wadd #2 j_5777))))) (λ x_5775 → let mm_5778 = b2-dep mm_5774 x_5775 in let g = x_5775 in b2-unsub mm_5778 f g kq_)) else (kq_ (h4-depl mm_5774 (e))))
