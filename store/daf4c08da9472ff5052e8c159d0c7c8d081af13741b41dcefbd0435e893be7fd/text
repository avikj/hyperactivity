-- the link preview every page carries: the front page's splash as a 1200×630 image (docs/og.png.hex, served at
-- /og.png), the page's title and the site's line. Avik, 2026-11-18: "on LinkedIn no og image on post links ... it
-- should look exactly like the website front page hyperactive white monospace on the same background, same subtitle".
s-og : List Word → List Word
s-og t = h-concat (cons "<meta property='og:title' content='" (cons t (cons "'><meta property='og:description' content='A decentralized operating system language for collective superintelligence.'><meta property='og:type' content='website'><meta property='og:image' content='https://hyperactivity.ai/og.png'><meta property='og:image:width' content='1200'><meta property='og:image:height' content='630'><meta name='twitter:card' content='summary_large_image'>" nil)))
