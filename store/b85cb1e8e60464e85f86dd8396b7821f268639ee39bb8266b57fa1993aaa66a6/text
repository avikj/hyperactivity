  cli-chmod (list-append dir "/boot_m1n1_apple_silicon.sh") #493 (λ _ →
  cli-chmod (list-append dir "/hx_oneclick_deploy.sh") #493 (λ _ →
    k (%wadd b5 (%wadd b7 (%wadd b7m (%wadd b8 b9))))))))))))))))))))

ho-mode-of : List Word → List Word
ho-mode-of a1 =
  if cli-eq a1 nil then "all"
  else if cli-eq a1 "emit" then "emit"
  else if cli-eq a1 "baremetal" then "baremetal"
  else if cli-eq a1 "mesh" then "mesh"
  else if cli-eq a1 "daemon" then "daemon"
  else if cli-eq a1 "visionpro" then "visionpro"
  else if cli-eq a1 "all" then "all"
  else "emit"

ho-dir-of : List Word → List Word → List Word → List Word
ho-dir-of a1 a2 mode =
  if cli-eq a1 nil then "/tmp/hy_out/hyperos"
  else if cli-eq a2 nil then
    (if cli-eq mode "emit" then
       (if cli-eq a1 "emit" then "/tmp/hy_out/hyperos" else a1)
     else "/tmp/hy_out/hyperos")
  else a2

hyperos-cli-main : List (List Word) → Step W Word
hyperos-cli-main args =
  let a1   = ho-arg1 args
      a2   = ho-arg2 args
      mode = ho-mode-of a1
      dir  = ho-dir-of a1 a2 mode
  in ho-materialize-all dir (λ totB →
       if cli-eq mode "emit" then
         cli-say (list-append "[HX-HYPEROS] Materialized Dual-Arch ARM64+x86-64 Bare-Metal Hyperkernel + VZ + m1n1 + HXSV Mesh ("
           (list-append (ce-dec totB) (list-append "B) -> " dir)))
           (sdone #0)
       else
         cli-system (list-append "/bin/sh " (list-append dir (list-append "/hx_oneclick_deploy.sh " (list-append mode (list-append " " (list-append dir " ."))))))
           (λ rc → sdone rc))

ho-infix : List Word → List Word → Bool
ho-infix pat nil = h-null pat
ho-infix pat (cons c cs) = if h-prefix pat (cons c cs) then true else ho-infix pat cs

ho-after-self : List (List Word) → Sum Unit (List (List Word))
ho-after-self nil = inl unit
ho-after-self (cons a rest) =
  if h-eq a "--with" then
    case rest of
      nil → inl unit
      cons _ rest2 →
        case rest2 of
          nil → inl unit
          cons _ rest3 → ho-after-self rest3
  else if h-prefix "--" a then ho-after-self rest
  else if ho-infix "hyperos.hypercubical" a then inr rest
  else ho-after-self rest

ho-step-exit : Step W Word → Step W Unit
ho-step-exit (sdone rc) = scmd (w-exit rc) (λ _ → sdone unit)
ho-step-exit (scmd c k) = scmd c (λ r → ho-step-exit (k r))

ho-step-bind-args : Step W (List (List Word)) → (List (List Word) → Step W Unit) → Step W Unit
ho-step-bind-args (sdone av) f = f av
ho-step-bind-args (scmd c k) f = scmd c (λ r → ho-step-bind-args (k r) f)

ho-run : Step W Unit
ho-run =
  ho-step-bind-args (to-step h-args) (λ av →
    case ho-after-self av of
      inl _ → sdone unit
      inr trailing → ho-step-exit (hyperos-cli-main trailing))

#run ho-run
