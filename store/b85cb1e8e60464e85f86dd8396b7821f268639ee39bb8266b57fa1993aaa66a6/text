ho-materialize-all dir k =
  cli-mkdir "/tmp/hy_out" (λ _ →
  cli-mkdir dir (λ _ →
  scmd (w-file-write-named (list-append dir "/hyperos_boot.S") hyperos-boot-asm) (λ b1 →
  scmd (w-file-write-named (list-append dir "/hyperos.ld") hyperos-ld-script) (λ b2 →
  scmd (w-file-write-named (list-append dir "/hyperos_kernel.c") hyperos-kernel-c) (λ b3 →
  scmd (w-file-write-named (list-append dir "/hyperfactor_bench.c") hyperfactor-bench-c) (λ b4 →
  scmd (w-file-write-named (list-append dir "/hyperos_boot_arm64.S") hyperos-arm64-boot-asm) (λ b5 →
  scmd (w-file-write-named (list-append dir "/hyperos_arm64.ld") hyperos-arm64-ld) (λ b6 →
  scmd (w-file-write-named (list-append dir "/hyperos_kernel_arm64.c") hyperos-arm64-kernel-c) (λ b7 →
  scmd (w-file-write-named (list-append dir "/hx_arm64_mkimg.c") hyperos-arm64-mkimg-c) (λ b7m →
