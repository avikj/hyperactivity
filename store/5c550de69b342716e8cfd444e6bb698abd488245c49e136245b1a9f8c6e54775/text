-- Diagonal physical booster 4*pi*B_4^0(dj1..dj4; di, di) = tet_nsq(di) * Bhat_4^0(di, di):
grv-b4-diag : (C : Type) → Nat → Nat → Nat → Nat → Nat → (R4dFrac → C) → C
grv-b4-diag C dj1 dj2 dj3 dj4 di cont =
  r4d-tet-nsq-4 C dj1 dj2 dj3 dj4 di (λ nsq →
  grv-bhat0 C dj1 dj2 dj3 dj4 di di (λ bh →
  grv-force-fr C (r4d-fr-mul ((fst nsq , nil) , snd nsq) bh) cont))
