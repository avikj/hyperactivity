-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13716 = seen in let j_13717 = j in scmd (w-load ((b2-a mm_ (%wadd v_13716 #2)))) (λ d_13714 → let mm_13718 = b2-dep mm_ d_13714 in scmd (w-load ((b2-a mm_13718 (%wadd d_13714 (%wsucc j_13717))))) (λ x_13715 → let mm_13719 = b2-dep mm_13718 x_13715 in let e = x_13715 in let i_13721 = e in scmd (w-load ((b2-a mm_13719 i_13721))) (λ x_13720 → let mm_13722 = b2-dep mm_13719 x_13720 in let x = x_13720 in if (%weq x p) then (kq_ (h4-depl mm_13722 (e))) else (b2-seenat mm_13722 f seen p (%wsucc j) n kq_)))))
