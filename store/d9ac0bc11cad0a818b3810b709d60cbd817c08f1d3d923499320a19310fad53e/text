rp-haar-unlift : List Word → List Word → List Word → List Word
rp-haar-unlift nil _ acc = rp-rev acc nil
rp-haar-unlift (cons s sr) nil acc = rp-haar-unlift sr nil (cons (rp-w32 s) acc)
rp-haar-unlift (cons s sr) (cons d dr) acc =
  let p = rp-haar-unlift-pair (s , d)
  in rp-haar-unlift sr dr (cons (snd p) (cons (fst p) acc))
