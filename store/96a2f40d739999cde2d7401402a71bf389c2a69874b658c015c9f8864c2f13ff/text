      calcCtx = list-append (pw-bin #113 (pw-bin #115 (pw-bin #116 (pw-get #7) (pw-c #5)) (pw-get #6)) (pw-c #4095)) (pw-set #8)
      loadB   = list-append (tir-ld8 (pw-bin #106 (pw-get #0) (pw-get #4))) (pw-set #9)
      calcRes = list-append (pw-bin #115 (pw-get #9) (tir-ld8 (pw-get #8))) (pw-set #10)
      updCtx  = tir-st8 (pw-get #8) (pw-get #9)
      advState = pw-cat
                   (cons (list-append (pw-get #6) (pw-set #7))
                   (cons (list-append (pw-get #9) (pw-set #6))
                   (cons (list-append (pw-bin #106 (pw-get #4) (pw-c #1)) (pw-set #4)) nil)))
      incOut  = list-append (pw-bin #106 (pw-get #5) (pw-c #1)) (pw-set #5)
