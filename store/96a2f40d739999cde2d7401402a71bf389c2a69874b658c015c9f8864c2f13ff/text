tir-wf-hzip : List Word
tir-wf-hzip =
  let locHdr  = the (List Word) (cons #1 (cons #8 (cons #127 nil)))
      inits   = pw-cat
                  (cons tir-clear-ctx4k
                  (cons (list-append (pw-c #0) (pw-set #4))
