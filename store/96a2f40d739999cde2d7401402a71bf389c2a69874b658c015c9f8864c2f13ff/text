                  (tir-st8 (pw-bin #106 (pw-get #2) (pw-get #5)) (pw-bin #115 (pw-get #10) (tir-mask-at #5)))
                  incOut
      runLp   = tir-blk-loop
                  (pw-cat
                    (cons (tir-brif-exit (pw-bin #79 (pw-get #4) (pw-get #1)))
                    (cons (tir-brif-exit (pw-bin #79 (pw-get #11) (pw-c #255)))
                    (cons calcCtx
                    (cons loadB
                    (cons (tir-brif-exit (pw-bin #71 (pw-get #9) (tir-ld8 (pw-get #8))))
                    (cons advState
                    (cons (list-append (pw-bin #106 (pw-get #11) (pw-c #1)) (pw-set #11))
                    (cons tir-br-cont nil)))))))))
      zBr     = pw-cat
                  (cons (list-append (pw-c #1) (pw-set #11))
                  (cons runLp
                  (cons (tir-st8 (pw-bin #106 (pw-get #2) (pw-get #5)) (tir-mask-at #5))
