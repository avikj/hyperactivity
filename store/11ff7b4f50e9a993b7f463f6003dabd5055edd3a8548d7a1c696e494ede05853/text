hxz-dec-blocks : List Word → Word → Word → Word → Step W Word
hxz-dec-blocks out t0 inb n =
  hxz-scan (toNat (%wdiv n #9)) inb n #4 #0 #0 (λ nb tot →
  scmd (w-alloc (%wadd tot #16)) (λ outb →
  let fin = hxz-fin "HXZ dec " out t0 n inb outb
  in scmd (w-sys #900 #0 #0 #0 #0 #0 #0) (λ _ →
     hxz-dec-loop (toNat nb) inb outb #4 #0 fin)))
