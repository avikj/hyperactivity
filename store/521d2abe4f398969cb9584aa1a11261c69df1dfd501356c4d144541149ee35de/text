-- Shared 9-tetrahedron boundary norm^2 product on the asymmetric config:
r4d-asym-bnd-nsq : (C : Type) → (BstUF → C) → C
r4d-asym-bnd-nsq C cont =
  r4d-tet-nsq C 1 2 4 5 r4d-asym-tri (r4d-asym-bndK 1 2 4 5) (λ u00 →
  r4d-tet-nsq C 1 2 3 5 r4d-asym-tri (r4d-asym-bndK 1 2 3 5) (λ u01 →
  r4d-tet-nsq C 1 2 3 4 r4d-asym-tri (r4d-asym-bndK 1 2 3 4) (λ u02 →
  r4d-tet-nsq C 0 2 4 5 r4d-asym-tri (r4d-asym-bndK 0 2 4 5) (λ u10 →
  r4d-tet-nsq C 0 2 3 5 r4d-asym-tri (r4d-asym-bndK 0 2 3 5) (λ u11 →
  r4d-tet-nsq C 0 2 3 4 r4d-asym-tri (r4d-asym-bndK 0 2 3 4) (λ u12 →
  r4d-tet-nsq C 0 1 4 5 r4d-asym-tri (r4d-asym-bndK 0 1 4 5) (λ u20 →
  r4d-tet-nsq C 0 1 3 5 r4d-asym-tri (r4d-asym-bndK 0 1 3 5) (λ u21 →
  r4d-tet-nsq C 0 1 3 4 r4d-asym-tri (r4d-asym-bndK 0 1 3 4) (λ u22 →
    bst-force-uf C (r4d-uf-mul (r4d-uf-mul u00 (r4d-uf-mul u01 u02))
                               (r4d-uf-mul (r4d-uf-mul u10 (r4d-uf-mul u11 u12))
                                           (r4d-uf-mul u20 (r4d-uf-mul u21 u22))))
      (λ n d → cont (n , d)))))))))))
