b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6624 = b2-dep mm_ c in let p_6626 = p in let i_6628 = (%wadd p_6626 #1) in scmd (w-load ((b2-a mm_6624 i_6628))) (λ x_6627 → let mm_6629 = b2-dep mm_6624 x_6627 in let x_6625 = x_6627 in let i = x_6625 in let p_6630 = p in let v_6631 = (%wsucc i) in let i_6632 = (%wadd p_6630 #1) in let v_6633 = v_6631 in scmd (w-store ((b2-a mm_6629 i_6632)) (v_6633)) (λ uu_6634 → let mm_6635 = hv2-u mm_6629 uu_6634 in kq_ (h4-depl mm_6635 (c)))))
