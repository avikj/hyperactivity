h4-spine : Word → Nat → Word → Word → (Word × Word → Step W Word) → Step W Word
h4-spine m zero t n k =
  k (h4-depl m ((n , t)))
h4-spine m (suc f) t n k =
  if (andB (%wlt n #256) (orB (%weq (h4-tag t) h4-APP) (%weq (h4-tag t) h4-DRY))) then (scmd (w-load ((h4-ha m (h4-val t)))) (λ x → let m2795 = h4-dep m x in h4-spine m2795 f x (%wsucc n) k)) else (k (h4-depl m ((n , t))))
