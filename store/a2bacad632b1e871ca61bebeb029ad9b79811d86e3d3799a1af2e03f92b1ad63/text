gn-keccak-cand : F2Prog
gn-keccak-cand =
  f2prog #5 nil
    (cons (f2-xor (f2-v #0) (f2-and (f2-not (f2-v #1)) (f2-v #2)))
    (cons (f2-xor (f2-v #1) (f2-and (f2-not (f2-v #2)) (f2-v #3)))
    (cons (f2-xor (f2-v #2) (f2-and (f2-not (f2-v #3)) (f2-v #4)))
    (cons (f2-xor (f2-v #3) (f2-and (f2-not (f2-v #4)) (f2-v #0)))
    (cons (f2-xor (f2-v #4) (f2-and (f2-not (f2-v #0)) (f2-v #1))) nil)))))
