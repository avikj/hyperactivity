tr-thm-half-exact : (p : Nat) → plus (tr-half p) (tr-rem-half p) ≡ p
tr-thm-half-exact zero          = refl
tr-thm-half-exact (suc zero)    = refl
tr-thm-half-exact (suc (suc n)) =
  fio-trans (fio-cong suc (tr-plus-suc-r (tr-half n) (tr-rem-half n)))
            (fio-cong (λ x → suc (suc x)) (tr-thm-half-exact n))
