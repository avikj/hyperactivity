dg-dep-chip : List (List Word × List Word) → List Word → List Word
dg-dep-chip nmap d =
  let dnm  = dg-lookup-kv d nmap
      lbl  = if h-null dnm then h-take (toNat #10) d else dnm
      href = list-append "/dag?target=" (if h-null dnm then d else s-esc dnm)
  in h-concat (cons "<a class='dg-chip' href='" (cons href (cons "'>&rarr; " (cons (s-esc lbl) (cons "</a>" nil)))))
