rqm-interf : (A E : Type) → A → (A → A → A) → (A → A → A) → (A → A) → (E → E → A) → List (A × E) → A
rqm-interf A E z ad mu cj ip bs = case bs of
  nil → z
  cons b rest → ad (ad (rqm-row A E z ad mu cj ip (fst b) (snd b) rest) (rqm-col A E z ad mu cj ip (fst b) (snd b) rest)) (rqm-interf A E z ad mu cj ip rest)
