-- THEOREM 2: STARLINK OPTICAL FEISTEL FRAMING IS A LOSSLESS BIJECTION ON 64 TEST PAYLOADS
-- AND STRICTLY ENFORCES CONSENSUAL OPT-IN DELIVERY BY `refl`!
sl-thm-optical-link-exact :
  andB (sl-check-feistel-64 (toNat #64) #0)
  (andB (%weq (sl-link-deliver false #111 #999) #111)
        (%weq (sl-link-deliver true  #111 #999) #999)) ≡ true
sl-thm-optical-link-exact = refl
