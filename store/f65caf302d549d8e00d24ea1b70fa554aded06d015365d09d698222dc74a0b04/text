b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_8290 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_8290 (#1))) else (b2-pstr mm_8290 p (λ s → let mm_8291 = b2-dep mm_8290 s in let p_8293 = p in let i_8295 = (%wadd p_8293 #1) in scmd (w-load ((b2-a mm_8291 i_8295))) (λ x_8294 → let mm_8296 = b2-dep mm_8291 x_8294 in let x_8292 = x_8294 in let i = x_8292 in let a_8298 = s in scmd (w-load ((b2-a mm_8296 a_8298))) (λ x_8297 → let mm_8299 = b2-dep mm_8296 x_8297 in let n = x_8297 in b2-col mm_8299 s i (λ c → let mm_8300 = b2-dep mm_8299 c in kq_ (h4-depl mm_8300 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
