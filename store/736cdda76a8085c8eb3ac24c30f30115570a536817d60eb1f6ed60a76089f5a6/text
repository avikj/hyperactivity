-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13332 = seen in let j_13333 = j in scmd (w-load ((b2-a mm_ (%wadd v_13332 #2)))) (λ d_13331 → let mm_13334 = b2-dep mm_ d_13331 in scmd (w-load ((b2-a mm_13334 (%wadd d_13331 (%wsucc j_13333))))) (λ x_13330 → let mm_13335 = b2-dep mm_13334 x_13330 in let e = x_13330 in let i_13337 = e in scmd (w-load ((b2-a mm_13335 i_13337))) (λ x_13336 → let mm_13338 = b2-dep mm_13335 x_13336 in let x = x_13336 in if (%weq x p) then (kq_ (h4-depl mm_13338 (e))) else (b2-seenat mm_13338 f seen p (%wsucc j) n kq_)))))
