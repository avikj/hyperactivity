taut-schur-vec-id : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → ScRing A z add mul neg →
  (c : A) → (bs qs : List A) → rxn-len A bs ≡ rxn-len A qs →
  add (mul c (taut-tail-form A z add mul c bs qs)) (taut-norm2 A z add mul bs) ≡
  taut-sos-vec A z add mul c bs qs
taut-schur-vec-id A z add mul neg r c bs =
  case bs return λ blist → (qs : List A) → rxn-len A blist ≡ rxn-len A qs →
    add (mul c (taut-tail-form A z add mul c blist qs)) (taut-norm2 A z add mul blist) ≡
    taut-sos-vec A z add mul c blist qs of
    nil → λ qs hlen →
      (case qs return λ qlist → zero ≡ rxn-len A qlist → add (mul c z) z ≡ z of
         nil → λ _ → lor-tr A (add (mul c z) z) (mul c z) z
                       (taut-zr A z add mul neg r (mul c z))
                       (taut-mul-zr A z add mul neg r c)
         cons qk qr → λ p → Empty-rec (rxn-zero-neq-suc (rxn-len A qr) p)) hlen
    cons bk br → taut-schur-cons A z add mul neg r c bk br (rec br)
