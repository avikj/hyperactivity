b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10104 = xs in scmd (w-load ((b2-a mm_ a_10104))) (λ x_10103 → let mm_10105 = b2-dep mm_ x_10103 in let n = x_10103 in if (%weq j n) then (kq_ (h4-depl mm_10105 (h))) else (let a_10107 = xs in let j_10108 = j in scmd (w-load ((b2-a mm_10105 (%wadd a_10107 (%wsucc j_10108))))) (λ x_10106 → let mm_10109 = b2-dep mm_10105 x_10106 in let x = x_10106 in b2-tapp mm_10109 bk h x #0 (λ h2 → let mm_10110 = b2-dep mm_10109 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10110 b2-ERR)) else (b2-applyall mm_10110 f bk h2 xs (%wsucc j) kq_)))))
