-- src/run.c readback_ctr: λt ((((t TAG) arg0) arg1) ...): (tag, arguments); the tag hv2-none when
-- the port is not one
hio-args : Nat → HioE → Word → Word → List Word → (Word → List Word → Step W Word) → Step W Word
hio-args zero e m aw acc k = k m (hio-rev acc nil)
hio-args (suc f) e m aw acc k =
  hio-expand e m (hv2-snd aw) (λ m1 ap →
  if not (hio-iscon ap) then k m1 (hio-rev acc nil)
  else scmd (w-load (hr-na m1 (hv2-val ap))) (λ w →
       hio-expand e m1 (hv2-fst w) (λ m2 arg → hio-args f e m2 w (cons arg acc) k)))
