b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6504 = b2-dep mm_ c in let p_6506 = p in let i_6508 = (%wadd p_6506 #1) in scmd (w-load ((b2-a mm_6504 i_6508))) (λ x_6507 → let mm_6509 = b2-dep mm_6504 x_6507 in let x_6505 = x_6507 in let i = x_6505 in let p_6510 = p in let v_6511 = (%wsucc i) in let i_6512 = (%wadd p_6510 #1) in let v_6513 = v_6511 in scmd (w-store ((b2-a mm_6509 i_6512)) (v_6513)) (λ uu_6514 → let mm_6515 = hv2-u mm_6509 uu_6514 in kq_ (h4-depl mm_6515 (c)))))
