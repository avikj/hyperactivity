b2-replg : Word → Nat → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-replg mm_ zero vs v w ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-replg mm_ (suc f) vs v w ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_6006 = vs in let j_6007 = j in scmd (w-load ((b2-a mm_ (%wadd a_6006 (%wsucc j_6007))))) (λ x_6005 → let mm_6008 = b2-dep mm_ x_6005 in let u = x_6005 in let a_6009 = ob in let j_6010 = j in let v_6011 = (the Word (if %weq u v then w else u)) in scmd (w-store ((b2-a mm_6008 (%wadd a_6009 (%wsucc j_6010)))) (v_6011)) (λ uu_6012 → let mm_6013 = hv2-u mm_6008 uu_6012 in b2-replg mm_6013 f vs v w ob (%wsucc j) n kq_)))
