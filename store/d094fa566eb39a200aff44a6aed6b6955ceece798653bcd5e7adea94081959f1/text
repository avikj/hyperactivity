--     giving exact V^4 = 4/27!
qv-spectrum-one : both
  (sf-bq-eq (bq-add (qv-q2-elem 2 2 2 2 2) (qv-q2-elem 2 2 2 2 4)) (sf-bq-of-nat 3))
  (sf-bq-eq (qv-vol4 (bq-add (qv-q2-elem 2 2 2 2 2) (qv-q2-elem 2 2 2 2 4)))
            (bq-make true (bin-of-nat 4) (bin-of-nat 27))) ≡ true
