usf-emit-benches : List UsfBench → List Word
usf-emit-benches nil = nil
usf-emit-benches (cons (usf-bench pidx dom res ver) rest) =
  usf-ln (list-append "      <tr data-verify='" (list-append pidx "'>")) (
  usf-ln (list-append "        <td class='d'>" (list-append dom "</td>")) (
  usf-ln (list-append "        <td class='r'>" (list-append res "</td>")) (
  usf-ln (list-append "        <td class='m'>" (list-append ver "</td>")) (
  usf-ln "      </tr>" (usf-emit-benches rest)))))
