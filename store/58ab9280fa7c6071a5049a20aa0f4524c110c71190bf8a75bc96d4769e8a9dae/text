-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_9893 = s in let j_9894 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_9893 (%wadd #2 j_9894))))) (λ x_9892 → let mm_9895 = b2-dep mm_ x_9892 in let fl = x_9892 in kq_ (h4-depl mm_9895 (fl))))
