-- Pure checked UI algebra (provably total, XSS-impossible by construction)
data UiNode
  = ui-nil
  | ui-heading (txt : List Word)
  | ui-text (txt : List Word)
  | ui-code (src : List Word)
  | ui-metric (label : List Word) (val : List Word)
  | ui-row (a : UiNode) (b : UiNode)
  | ui-col (a : UiNode) (b : UiNode)
  | ui-canvas (w : Word) (h : Word) (ops : CanvasOp)
