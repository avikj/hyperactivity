-- THEOREM 2: COMPOSITIONAL TRANSITIVITY OF SYSTEM EQUIVALENCE (Spec ≈ Mid ≈ Impl => Spec ≈ Impl)
vx-thm-sim-compose : {S1 S2 S3 I O : Type} →
  (sys1 : VxSys S1 I O) → (sys2 : VxSys S2 I O) → (sys3 : VxSys S3 I O) →
  ((tr : List I) → vx-run sys1 tr ≡ vx-run sys2 tr) →
  ((tr : List I) → vx-run sys2 tr ≡ vx-run sys3 tr) →
  (tr : List I) → vx-run sys1 tr ≡ vx-run sys3 tr
vx-thm-sim-compose sys1 sys2 sys3 e12 e23 tr = vx-trans (e12 tr) (e23 tr)
