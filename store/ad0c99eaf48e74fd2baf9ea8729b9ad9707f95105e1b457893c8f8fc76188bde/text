-- Master formula evaluated at rational gamma^2 = p2 / q2 (0 <= p2 <= q2 <= 16) and Euler sum E = en / ed:
--   4*pi*B_4^gamma(1/2) = 16*q2^2 * [ (q2^2 + 30*p2*q2 - 19*p2^2)*ed - 4*(q2^2 - p2^2)*en ] / (15*(q2 + p2)^4 * ed)
bst-bpow4 : List Bool → List Bool
bst-bpow4 x =
  bst-force-bin (List Bool) (bst-bmul x x) (λ x2 → bst-bmul x2 x2)
