b2-foreigntip : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-foreigntip mm_ zero bk tel d kq_ =
  kq_ (h4-depl mm_ (tel))
b2-foreigntip mm_ (suc f) bk tel d kq_ =
  b2-strip mm_ tel (λ t → let mm_12749 = b2-dep mm_ t in let t_12751 = t in scmd (w-load ((b2-a mm_12749 t_12751))) (λ x_12750 → let mm_12752 = b2-dep mm_12749 x_12750 in let tg = (%wand x_12750 #255) in if (not (%weq tg b2-ALL)) then (kq_ (h4-depl mm_12752 (t))) else (let t_12754 = t in let j_12755 = #1 in scmd (w-load ((b2-a mm_12752 (%wadd t_12754 (%wadd #2 j_12755))))) (λ x_12753 → let mm_12756 = b2-dep mm_12752 x_12753 in let k = x_12753 in let t_12758 = t in let j_12759 = #4 in scmd (w-load ((b2-a mm_12756 (%wadd t_12758 (%wadd #2 j_12759))))) (λ x_12757 → let mm_12760 = b2-dep mm_12756 x_12757 in let vB = x_12757 in b2-Var mm_12760 k d #0 #0 (λ x → let mm_12761 = b2-dep mm_12760 x in b2-body mm_12761 bk vB x (λ t2 → let mm_12762 = b2-dep mm_12761 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_12762 b2-ERR)) else (b2-foreigntip mm_12762 f bk t2 (%wsucc d) kq_))))))))
