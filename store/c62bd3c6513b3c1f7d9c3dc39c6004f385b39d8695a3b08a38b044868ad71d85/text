-- an argument an intrinsic may read: a literal or a constructor (anything else is stuck, and
-- the definition's own match decides, as it would without the intrinsic)
-- an intrinsic's argument as it stands: a computed cell's value, 0 for a cell not yet
-- evaluated, anything else itself
b2-ipeek : Word → Word → (Word → Step W Word) → Step W Word
b2-ipeek mm_ x kq_ =
  let t_2677 = x in scmd (w-load ((b2-a mm_ t_2677))) (λ x_2676 → let mm_2678 = b2-dep mm_ x_2676 in let tg = (%wand x_2676 #255) in let t_2680 = x in let j_2681 = #1 in scmd (w-load ((b2-a mm_2678 (%wadd t_2680 (%wadd #2 j_2681))))) (λ x_2679 → let mm_2682 = b2-dep mm_2678 x_2679 in let i = x_2679 in if (andB (%weq tg b2-VAR) (%weq i b2-M1)) then (kq_ (h4-depl mm_2682 (#0))) else (b2-strip mm_2682 x (λ r → let mm_2683 = b2-dep mm_2682 r in kq_ (h4-depl mm_2683 (r))))))
