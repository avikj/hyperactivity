  let t_1326 = t in scmd (w-load ((b2-a mm_ t_1326))) (λ x_1325 → let mm_1327 = b2-dep mm_ x_1325 in let tg = (%wand x_1325 #255) in if (not (%weq tg b2-CTR)) then (kq_ (h4-depl mm_1327 (#0))) else (let t_1329 = t in let j_1330 = #0 in scmd (w-load ((b2-a mm_1327 (%wadd t_1329 (%wadd #2 j_1330))))) (λ x_1328 → let mm_1331 = b2-dep mm_1327 x_1328 in let k = x_1328 in let t_1333 = t in let j_1334 = #1 in scmd (w-load ((b2-a mm_1331 (%wadd t_1333 (%wadd #2 j_1334))))) (λ x_1332 → let mm_1335 = b2-dep mm_1331 x_1332 in let xs = x_1332 in let a_1337 = xs in scmd (w-load ((b2-a mm_1335 a_1337))) (λ x_1336 → let mm_1338 = b2-dep mm_1335 x_1336 in let l = x_1336 in if (andB (%weq k b2-NALeaf) (%weq l #1)) then (let a_1340 = xs in let j_1341 = #0 in scmd (w-load ((b2-a mm_1338 (%wadd a_1340 (%wsucc j_1341))))) (λ x_1339 → let mm_1342 = b2-dep mm_1338 x_1339 in let x = x_1339 in b2-vpush mm_1342 v x (λ dd_1343 → let mm_1344 = b2-dep mm_1342 dd_1343 in kq_ (h4-depl mm_1344 (#1))))) else (if (not (andB (%weq k b2-NANode) (%weq l #2))) then (kq_ (h4-depl mm_1338 (#0))) else (let a_1346 = xs in let j_1347 = #0 in scmd (w-load ((b2-a mm_1338 (%wadd a_1346 (%wsucc j_1347))))) (λ x_1345 → let mm_1348 = b2-dep mm_1338 x_1345 in let a = x_1345 in let a_1350 = xs in let j_1351 = #1 in scmd (w-load ((b2-a mm_1348 (%wadd a_1350 (%wsucc j_1351))))) (λ x_1349 → let mm_1352 = b2-dep mm_1348 x_1349 in let b = x_1349 in b2-arrsug mm_1352 f a v (λ ok → let mm_1353 = b2-dep mm_1352 ok in if (%weq ok #0) then (kq_ (h4-depl mm_1353 (#0))) else (b2-arrsug mm_1353 f b v (λ r → let mm_1354 = b2-dep mm_1353 r in kq_ (h4-depl mm_1354 (r))))))))))))))
