qmol-c4-gauss-ok : Nat → Nat → QmolState → Bool
qmol-c4-gauss-ok p1 p2 st =
  both (both (qmol-c4-gauss-at p1 p2 0 (fst (fst st)) (snd (fst st)) (snd st))
             (qmol-c4-gauss-at p1 p2 1 (fst (fst st)) (snd (fst st)) (snd st)))
       (both (qmol-c4-gauss-at p1 p2 2 (fst (fst st)) (snd (fst st)) (snd st))
             (qmol-c4-gauss-at p1 p2 3 (fst (fst st)) (snd (fst st)) (snd st)))
