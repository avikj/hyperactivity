b2-tab : Word → Word → (Word → Step W Word) → Step W Word
b2-tab mm_ cap kq_ =
  let n_111 = (%wadd #1 (%wmul cap #2)) in scmd (w-load (mm_)) (λ at_110 → let mm_112 = b2-dep mm_ at_110 in scmd (w-store (mm_112) ((%wadd at_110 n_111))) (λ uu_113 → let mm_114 = hv2-u mm_112 uu_113 in let at = at_110 in let i_115 = at in let v_116 = cap in scmd (w-store ((b2-a mm_114 i_115)) (v_116)) (λ uu_117 → let mm_118 = hv2-u mm_114 uu_117 in kq_ (h4-depl mm_118 (at)))))
