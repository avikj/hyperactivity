s-trace-post : List Word → List Word → Proc W (List Word)
s-trace-post st body =
  let clean = h-take (toNat #8192) (um-body-clean body)
      tf    = list-append st "/trace.jsonl"
  in if h-null clean then ret {lzero} {W} (s-response "application/json" "{}")
     else
       bind (h-read tf) (λ prev →
       let old = the (List Word) (case prev of inl _ → nil ; inr b → b)
           nxt = list-append old (list-append clean (cons #10 nil))
       in bind (h-write tf nxt) (λ w1 →
          ret {lzero} {W} (s-response "application/json" (h-concat (cons "{" (cons (s-cj-str "ok") (cons ":true}" nil)))))))
