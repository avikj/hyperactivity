ue-channel-params : List Word → Word × (Word × List Word)
ue-channel-params m =
  if h-eq m "cournot" then (#1 , (#1 , "cournot (gamma=1, alpha*=50% midpoint)"))
  else if h-eq m "spot" then (#1 , (#2 , "spot (gamma=1/2, alpha*=67%)"))
  else if h-eq m "stream" then (#19 , (#1 , "stream_pass (P_marg=Y_eff+5%, +F* epoch pass)"))
  else (#1 , (#9 , "agent_x402 (gamma=1/9, alpha*=90% router optimum)"))
