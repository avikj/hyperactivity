-- ── 4. Layer 1: Raw Digital Navbar Chrome (Proven 0px Zero-Pill + Yellow Key) ─
raw-nav-sheet : CssSheet
raw-nav-sheet =
  cons (css-rule "#hx-oracle-btn,#hx-kg-btn,#hx-view-trigger,#hx-cmd-trigger"
    (list-append
      (d6 "font" "700 11.5px/1 ui-monospace,'SF Mono',Menlo,monospace"
          "background" "none" "color" "inherit" "border" "2px solid currentColor"
          "border-radius" "0" "height" "24px")
      (d5 "padding" "0 9px" "margin-left" "10px" "cursor" "pointer"
          "white-space" "nowrap" "display" "inline-flex")))
  (cons (css-rule "#hx-oracle-btn,#hx-kg-btn,#hx-view-trigger,#hx-cmd-trigger"
    (d3 "align-items" "center" "flex-shrink" "0" "letter-spacing" "0.06em"))
  (cons (css-rule "#hx-oracle-btn"
    (d6 "margin-left" "20px" "background" "#ffd400" "border-color" "#ffd400"
        "color" "#000000" "padding" "0 11px" "letter-spacing" "0.1em"))
  (cons (css-rule "#hx-oracle-btn:hover"
    (d3 "background" "#000000" "border-color" "#ffd400" "color" "#ffd400"))
  (cons (css-rule "html.dark #hx-oracle-btn:hover"
    (d3 "background" "#ffffff" "border-color" "#ffffff" "color" "#000000"))
  (cons (css-rule "#hx-kg-btn:hover,#hx-view-trigger:hover,#hx-cmd-trigger:hover"
    (d3 "background" "#ff0a94" "border-color" "#ff0a94" "color" "#ffffff"))
  (cons (css-rule ".hx-pulse-orb" (d1 "display" "none"))
  nil))))))
