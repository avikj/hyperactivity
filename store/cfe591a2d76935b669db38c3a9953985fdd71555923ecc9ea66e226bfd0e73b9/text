-- Canonical ordered electron-pair lists on C_4:
-- Singlet (symmetric spatial, e1 <= e2): 10 pairs; Triplet (Pauli-antisymmetric, e1 < e2): 6 pairs.
qmol-pairs-singlet : List (Nat × Nat)
qmol-pairs-singlet =
  cons (0 , 0) (cons (0 , 1) (cons (0 , 2) (cons (0 , 3)
  (cons (1 , 1) (cons (1 , 2) (cons (1 , 3)
  (cons (2 , 2) (cons (2 , 3) (cons (3 , 3) nil)))))))))
