  if (not c) then (kq_ (h4-depl mm_ (nil))) else (b2-snf mm_ bk t (λ y → let mm_15603 = b2-dep mm_ y in b2-unlist mm_15603 (toNat #4294967295) y nil (λ r → let mm_15604 = b2-dpl mm_15603 r in kq_ (h4-depl mm_15604 (r)))))
