ue-nat-eq-sound : (a b : Nat) → ue-nat-eq a b ≡ true → a ≡ b
ue-nat-eq-sound zero    zero    h = refl
ue-nat-eq-sound zero    (suc m) h = Empty-rec (ue-true-ne-false (ue-sym h))
ue-nat-eq-sound (suc n) zero    h = Empty-rec (ue-true-ne-false (ue-sym h))
ue-nat-eq-sound (suc n) (suc m) h = cong suc (ue-nat-eq-sound n m h)
