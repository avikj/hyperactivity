-- Helper: (p*p + p*r) + (r*p + r*r) = (p + r) * (p + r).
qmol-foil-back : (A : Type) → (add mul : A → A → A) → QmolSR A add mul → (p r : A) →
  add (add (mul p p) (mul p r)) (add (mul r p) (mul r r)) ≡ mul (add p r) (add p r)
qmol-foil-back A add mul sr p r = concat
  (λ i → add (sym (qmol-sr-ld A add mul sr p p r) i) (sym (qmol-sr-ld A add mul sr r p r) i))
  (sym (qmol-sr-rd A add mul sr p r (add p r)))
