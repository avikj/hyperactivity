-- Action of Q = i * [[0, a], [-a, 0]] squared (Q^2 = [[a^2, 0], [0, a^2]]) on a 2D intertwiner vector (x, y):
-- Using Q_real = [[0, a], [-a, 0]], note Q^2 = -Q_real^2, i.e., (Q^2 v)_0 = a * (a * x), (Q^2 v)_1 = a * (a * y).
-- THEOREM 1A (Universal 2D Intertwiner Double-Degenerate Volume Gap):
-- On any 2D intertwiner space, Q^2 = a^2 * I_2 identically!
qv-2x2-gap : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → QvRing A z add mul neg →
  (a x y : A) → (mul a (mul a x) ≡ mul (mul a a) x) × (mul a (mul a y) ≡ mul (mul a a) y)
qv-2x2-gap A z add mul neg r a x y =
  (sym (fst (snd (snd (snd (snd (snd (snd (snd r))))))) a a x) ,
   sym (fst (snd (snd (snd (snd (snd (snd (snd r))))))) a a y))
