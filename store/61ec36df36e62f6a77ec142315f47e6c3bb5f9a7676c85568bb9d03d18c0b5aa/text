e-scan-lt : (List Word → Word → List Word × List (List (List Word))) → List Word → Word → Bool × (List Word × List Word) → Bool × (List (List Word) × List Word) → List Word × List (List (List Word))
e-scan-lt k t n ety men =
  if fst ety then e-pre (fst (snd ety)) (k (snd (snd ety)) n)
  else if fst men then e-pre-m (e-marker n) (fst (snd men)) (k (snd (snd men)) (wadd n #1))
  else e-pre (h-take (toNat #1) t) (k (h-tail t) n)
