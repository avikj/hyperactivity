b2-cwait : Word → Word → (Word → Step W Word) → Step W Word
b2-cwait mm_ item kq_ =
  if (%weq item hv2-none) then (b2-unitv mm_  (λ u → let mm_15871 = b2-dep mm_ u in b2-c1 mm_15871 "Wait" u (λ r → let mm_15872 = b2-dep mm_15871 r in kq_ (h4-depl mm_15872 (r))))) else (b2-c1 mm_ "Wait" item (λ r → let mm_15873 = b2-dep mm_ r in kq_ (h4-depl mm_15873 (r))))
