-- ---------------------------------------------------------------- what every entry is
k-Pred : List (List Word) → List (List Word) → List (List Word) → Type
k-Pred t s p = MemKey {suffix-ord} p (sufs t) × isTrue (not (leq {suffix-ord} s p)) ×
               ((z : List (List Word)) → MemKey {suffix-ord} z (sufs t) → isTrue (not (leq {suffix-ord} s z)) → isTrue (leq {suffix-ord} z p))
