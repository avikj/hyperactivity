-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_6780 = tel in let j_6781 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_6780 (%wsucc j_6781))))) (λ x_6779 → let mm_6782 = b2-dep mm_ x_6779 in let c = x_6779 in let i_6784 = c in scmd (w-load ((b2-a mm_6782 i_6784))) (λ x_6783 → let mm_6785 = b2-dep mm_6782 x_6783 in let q = x_6783 in let i_6787 = (%wadd c #1) in scmd (w-load ((b2-a mm_6785 i_6787))) (λ x_6786 → let mm_6788 = b2-dep mm_6785 x_6786 in let k = x_6786 in let i_6790 = (%wadd c #2) in scmd (w-load ((b2-a mm_6788 i_6790))) (λ x_6789 → let mm_6791 = b2-dep mm_6788 x_6789 in let i = x_6789 in let i_6793 = (%wadd c #3) in scmd (w-load ((b2-a mm_6791 i_6793))) (λ x_6792 → let mm_6794 = b2-dep mm_6791 x_6792 in let vT = x_6792 in let i_6796 = (%wadd c #4) in scmd (w-load ((b2-a mm_6794 i_6796))) (λ x_6795 → let mm_6797 = b2-dep mm_6794 x_6795 in let s = x_6795 in b2-All mm_6797 q k i vT e s (λ a → let mm_6798 = b2-dep mm_6797 a in b2-telebindg mm_6798 f tel (%wsub j #1) a kq_))))))))
