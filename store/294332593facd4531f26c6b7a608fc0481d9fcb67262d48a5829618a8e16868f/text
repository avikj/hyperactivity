e-active : Bool → Bool → List Word → Bool
e-active seen active plain =
  if andB seen (e-has-stop plain) then e-goes-on (e-strip (e-after-stop plain plain))
  else if h-not seen then true
  else if e-ends-deriv (e-strip plain) then true
  else if h-not (e-ends-list (e-strip plain)) then false
  else active
