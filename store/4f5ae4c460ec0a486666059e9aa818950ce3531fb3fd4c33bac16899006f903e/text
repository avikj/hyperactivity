-- Section (1): Universal Cubical Spectral Theorems for Tridiagonal Antisymmetric Volume Operators.
-- Commutative ring bundle (z, add, mul, neg):
--   (add-zl, add-zr, add-assoc, add-comm, add-inv, mul-zr, mul-comm, mul-assoc, ldist, neg-mul-r)
QvRing : (A : Type) → A → (A → A → A) → (A → A → A) → (A → A) → Type
QvRing A z add mul neg =
  ((x : A) → add z x ≡ x) ×
  (((x : A) → add x z ≡ x) ×
  (((x y w : A) → add (add x y) w ≡ add x (add y w)) ×
  (((x y : A) → add x y ≡ add y x) ×
  (((x : A) → add x (neg x) ≡ z) ×
  (((x : A) → mul x z ≡ z) ×
  (((x y : A) → mul x y ≡ mul y x) ×
  (((x y w : A) → mul (mul x y) w ≡ mul x (mul y w)) ×
  (((x y w : A) → mul x (add y w) ≡ add (mul x y) (mul x w)) ×
  ((x y : A) → mul x (neg y) ≡ neg (mul x y))))))))))
