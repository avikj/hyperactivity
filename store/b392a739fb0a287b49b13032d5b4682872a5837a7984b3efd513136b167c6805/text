being-ui-sheet : CssSheet
being-ui-sheet =
  -- Navbar OS controls: stark architectural spacing, zero pills, 2px solid border
  cons (css-rule "#hx-oracle-btn,#hx-kg-btn,#hx-view-trigger,#hx-cmd-trigger"
    (list-append
      (d6 "font" "700 11.5px/1 ui-monospace,'SF Mono',Menlo,monospace"
          "background" "none" "color" "inherit" "border" "2px solid currentColor"
          "border-radius" "0" "height" "24px")
      (d5 "padding" "0 9px" "margin-left" "10px" "cursor" "pointer"
          "white-space" "nowrap" "display" "inline-flex")))
  (cons (css-rule "#hx-oracle-btn,#hx-kg-btn,#hx-view-trigger,#hx-cmd-trigger"
    (d3 "align-items" "center" "flex-shrink" "0" "letter-spacing" "0.06em"))
  (cons (css-rule "#hx-oracle-btn"
    (d6 "margin-left" "20px" "background" "#ff0a94" "border-color" "#ff0a94"
        "color" "#ffffff" "padding" "0 11px" "letter-spacing" "0.1em"))
  (cons (css-rule "#hx-oracle-btn:hover"
    (d3 "background" "#000000" "border-color" "#000000" "color" "#ffffff"))
  (cons (css-rule "html.dark #hx-oracle-btn:hover"
    (d3 "background" "#ffffff" "border-color" "#ffffff" "color" "#000000"))
  (cons (css-rule "#hx-kg-btn:hover,#hx-view-trigger:hover,#hx-cmd-trigger:hover"
    (d3 "background" "#ff0a94" "border-color" "#ff0a94" "color" "#ffffff"))
  (cons (css-rule ".hx-pulse-orb" (d1 "display" "none"))
  -- Living Topological Flow-Network Being Canvas & Core
  (cons (css-rule "#hx-being-canvas"
    (d6 "position" "fixed" "inset" "0" "width" "100vw" "height" "100vh"
        "z-index" "9990" "pointer-events" "none"))
  (cons (css-rule "#hx-being-core"
    (list-append
      (d5 "position" "fixed" "left" "0" "top" "0" "width" "66px" "height" "66px")
      (d5 "margin" "-33px 0 0 -33px" "z-index" "9993" "background" "transparent"
          "border" "0" "cursor" "pointer")))
  (cons (css-rule "#hx-being-core .hx-core-tag"
    (list-append
      (d5 "position" "absolute" "top" "calc(100% + 2px)" "left" "50%"
          "transform" "translateX(-50%)" "font" "800 9.5px/1 ui-monospace,Menlo,monospace")
      (d6 "letter-spacing" "0.14em" "text-transform" "uppercase" "padding" "3px 6px"
          "background" "#000000" "color" "#ffffff" "border" "1px solid #ff0a94")))
  (cons (css-rule "#hx-being-core .hx-core-tag"
    (d3 "white-space" "nowrap" "opacity" "0" "pointer-events" "none"))
  (cons (css-rule "#hx-being-core:hover .hx-core-tag,#hx-being-core.speaking .hx-core-tag"
    (d1 "opacity" "1"))
  (cons (css-rule "#hx-being-sleep"
    (list-append
      (d5 "position" "fixed" "right" "12px" "bottom" "12px" "z-index" "9994"
          "font" "700 9.5px/1 ui-monospace,Menlo,monospace")
      (d6 "letter-spacing" "0.08em" "text-transform" "uppercase" "padding" "5px 8px"
          "background" "rgba(255,255,255,0.88)" "color" "#000000" "border" "1px solid rgba(0,0,0,0.28)")))
  (cons (css-rule "#hx-being-sleep"
    (d3 "border-radius" "0" "cursor" "pointer" "opacity" "0.45"))
  (cons (css-rule "html.dark #hx-being-sleep"
    (d3 "background" "rgba(0,0,0,0.88)" "color" "#ffffff" "border-color" "rgba(255,255,255,0.24)"))
  (cons (css-rule "#hx-being-sleep:hover"
    (d3 "opacity" "1" "border-color" "#ff0a94" "color" "#ff0a94"))
  -- Floating Tap-able Thought Filaments
  (cons (css-rule "#hx-thought-layer"
    (d4 "position" "fixed" "inset" "0" "z-index" "9992" "pointer-events" "none"))
  (cons (css-rule ".hx-thought"
    (list-append
      (d6 "position" "fixed" "left" "0" "top" "0" "max-width" "248px"
          "pointer-events" "auto" "background" "rgba(255,255,255,0.95)")
      (d6 "color" "#000000" "border" "1px solid rgba(0,0,0,0.24)" "border-left" "2.5px solid #ff0a94"
          "border-radius" "0" "padding" "7px 10px" "font" "500 10.5px/1.4 ui-monospace,Menlo,monospace")))
  (cons (css-rule ".hx-thought"
    (d4 "text-align" "left" "cursor" "pointer" "opacity" "0" "transition" "opacity 0.25s ease,background 0.12s,color 0.12s"))
  (cons (css-rule "html.dark .hx-thought"
    (d4 "background" "rgba(5,5,7,0.94)" "color" "#f4f4f6" "border-color" "rgba(255,255,255,0.22)" "border-left-color" "#ff0a94"))
  (cons (css-rule ".hx-thought.vis" (d1 "opacity" "1"))
  (cons (css-rule ".hx-thought:hover"
    (d3 "background" "#ff0a94" "color" "#ffffff" "border-color" "#ff0a94"))
  (cons (css-rule ".hx-thought .hx-tk"
    (d5 "display" "block" "font" "800 8.5px/1 ui-monospace,Menlo,monospace"
        "letter-spacing" "0.12em" "text-transform" "uppercase" "color" "#ff0a94"))
  (cons (css-rule ".hx-thought .hx-tk" (d1 "margin-bottom" "3px"))
  (cons (css-rule ".hx-thought:hover .hx-tk" (d1 "color" "#ffffff"))
  -- Hyperspeed Architectural Flow Surface (#hx-hub-drawer)
  (cons (css-rule "#hx-hub-drawer"
    (list-append
      (d6 "border-radius" "0" "border" "1.5px solid #000000" "border-top" "3px solid #ff0a94"
          "background" "rgba(255,255,255,0.98)" "color" "#000000" "top" "54px")
      (d4 "right" "12px" "bottom" "12px" "width" "min(468px,calc(100vw - 24px))" "box-shadow" "0 24px 72px rgba(0,0,0,0.22)")))
  (cons (css-rule "html.dark #hx-hub-drawer"
    (d4 "background" "rgba(4,4,6,0.98)" "color" "#f4f4f6" "border-color" "rgba(255,255,255,0.24)" "border-top-color" "#ff0a94"))
  (cons (css-rule ".hx-htab,.hx-hub-x,.hx-os-reset,.hx-byok-pill,.hx-send-pill,.hx-chip,.hx-lens-badge,.hx-put-btn,.hx-composer,.hx-or-msg,.hx-or-welcome"
    (d1 "border-radius" "0"))
  (cons (css-rule ".hx-scope-strip"
    (d6 "padding" "6px 12px" "border-bottom" "1px solid rgba(128,128,128,0.2)"
        "background" "rgba(255,10,148,0.045)" "display" "flex"
        "justify-content" "space-between" "align-items" "center"))
  (cons (css-rule ".hx-scope-strip"
    (d2 "gap" "8px" "font" "600 10px/1.2 ui-monospace,Menlo,monospace"))
  (cons (css-rule ".hx-scope-txt"
    (d3 "overflow" "hidden" "text-overflow" "ellipsis" "white-space" "nowrap"))
  (cons (css-rule ".hx-scope-txt b" (d1 "color" "#ff0a94"))
  (cons (css-rule ".hx-lens-badge"
    (d6 "font" "700 9px/1 ui-monospace,Menlo,monospace" "letter-spacing" "0.08em"
        "text-transform" "uppercase" "padding" "3px 6px" "border" "1px solid #ff0a94" "color" "#ff0a94"))
  (cons (css-rule ".hx-lens-badge"
    (d3 "background" "transparent" "cursor" "pointer" "flex-shrink" "0"))
  (cons (css-rule ".hx-lens-badge:hover,.hx-chip:hover,.hx-chip.on"
    (d3 "background" "#ff0a94" "color" "#ffffff" "border-color" "#ff0a94"))
  (cons (css-rule ".hx-chip-grid"
    (d3 "display" "flex" "flex-wrap" "wrap" "gap" "5px"))
  (cons (css-rule ".hx-chip"
    (d6 "font" "700 10px/1 ui-monospace,Menlo,monospace" "letter-spacing" "0.04em"
        "background" "transparent" "color" "inherit" "border" "1px solid rgba(128,128,128,0.38)" "padding" "6px 8px"))
  (cons (css-rule ".hx-chip" (d1 "cursor" "pointer"))
  (cons (css-rule ".hx-chip.route" (d1 "border-style" "dashed"))
  (cons (css-rule ".hx-curiosity-sec"
    (d3 "margin-top" "10px" "padding-top" "9px" "border-top" "1px solid rgba(128,128,128,0.2)"))
  (cons (css-rule ".hx-curiosity-lbl"
    (d5 "font" "700 9px/1 ui-monospace,Menlo,monospace" "letter-spacing" "0.12em"
        "text-transform" "uppercase" "opacity" "0.58" "margin-bottom" "6px"))
  (cons (css-rule ".hx-send-pill"
    (d6 "font" "800 10.5px/1 ui-monospace,Menlo,monospace" "text-transform" "uppercase"
        "letter-spacing" "0.1em" "background" "#ff0a94" "color" "#ffffff" "border" "1.5px solid #ff0a94"))
  (cons (css-rule ".hx-send-pill" (d2 "padding" "6px 13px" "cursor" "pointer"))
  (cons (css-rule "#hx-head-flow"
    (d6 "position" "absolute" "inset" "0" "width" "100%" "height" "100%"
        "pointer-events" "none" "opacity" "0.32"))
  nil)))))))))))))))))))))))))))))))))))))))))))
