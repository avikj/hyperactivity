-- Section (1): Universal Cubical Reflection-Positivity Theorem for Symmetric 2-Simplex Gluing.
-- Order bundle for reflection positivity: (z-nn, sq-nn, nn-mul, nn-add, nn-add-pos, pos-add-nn).
Sf2PosOrd : (A : Type) → A → (A → A → A) → (A → A → A) → (A → Type) → (A → Type) → Type
Sf2PosOrd A z add mul Pos Nonneg =
  Nonneg z ×
  (((x : A) → Nonneg (mul x x)) ×
  (((x y : A) → Nonneg x → Nonneg y → Nonneg (mul x y)) ×
  (((x y : A) → Nonneg x → Nonneg y → Nonneg (add x y)) ×
  (((x y : A) → Nonneg x → Pos y → Pos (add x y)) ×
  ((x y : A) → Pos x → Nonneg y → Pos (add x y))))))
