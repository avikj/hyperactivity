b2-nlcount : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-nlcount mm_ zero s j e cnt ls kq_ =
  kq_ (h4-depl mm_ (cnt))
b2-nlcount mm_ (suc f) s j e cnt ls kq_ =
  if (%weq j e) then (let a_13088 = cnt in let b_13089 = ls in let c_13090 = #0 in let n_13092 = #3 in scmd (w-load (mm_)) (λ at_13091 → let mm_13093 = b2-dep mm_ at_13091 in scmd (w-store (mm_13093) ((%wadd at_13091 n_13092))) (λ uu_13094 → let mm_13095 = hv2-u mm_13093 uu_13094 in let at_13087 = at_13091 in let i_13096 = at_13087 in let v_13097 = a_13088 in scmd (w-store ((b2-a mm_13095 i_13096)) (v_13097)) (λ uu_13098 → let mm_13099 = hv2-u mm_13095 uu_13098 in let i_13100 = (%wadd at_13087 #1) in let v_13101 = b_13089 in scmd (w-store ((b2-a mm_13099 i_13100)) (v_13101)) (λ uu_13102 → let mm_13103 = hv2-u mm_13099 uu_13102 in let i_13104 = (%wadd at_13087 #2) in let v_13105 = c_13090 in scmd (w-store ((b2-a mm_13103 i_13104)) (v_13105)) (λ uu_13106 → let mm_13107 = hv2-u mm_13103 uu_13106 in let r = at_13087 in kq_ (h4-depl mm_13107 (r)))))))) else (let a_13109 = s in let j_13110 = j in scmd (w-load ((b2-a mm_ (%wadd a_13109 (%wsucc j_13110))))) (λ x_13108 → let mm_13111 = b2-dep mm_ x_13108 in let c = x_13108 in if (%weq c #10) then (b2-nlcount mm_13111 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_13111 f s (%wsucc j) e cnt ls kq_)))
