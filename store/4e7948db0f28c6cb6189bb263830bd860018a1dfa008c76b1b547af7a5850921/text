-- a fork's binders wrapped around the body, innermost first (src/hvm.c parse_term_fork's wrap)
h4-forkwrap : Word → Nat → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-forkwrap m zero i d dd dyn lab lt body k =
  k (h4-depl m (body))
h4-forkwrap m (suc f) i d dd dyn lab lt body k =
  if (%weq i #0) then (k (h4-depl m (body))) else (let j = %wsub i #1 in let x = %wadd d (%wmul j dd) in if (%weq dyn #1) then (h4-mk1 m h4-LAM (%wadd x #3) body (λ l1 → let m64 = h4-dep m l1 in h4-mk1 m64 h4-LAM (%wadd x #2) l1 (λ l0 → let m65 = h4-dep m64 l0 in h4-mk3 m65 h4-DDU #0 lt (h4-new h4-BJV #0 (%wadd x #1)) l0 (λ ddu → let m66 = h4-dep m65 ddu in h4-mk1 m66 h4-LAM (%wadd x #1) ddu (λ lm → let m67 = h4-dep m66 lm in h4-forkwrap m67 f j d dd dyn lab lt lm k))))) else (h4-mk2 m h4-DUP lab (h4-new h4-BJV #0 (%wadd x #1)) body (λ dup → let m68 = h4-dep m dup in h4-mk1 m68 h4-LAM (%wadd x #1) dup (λ lm → let m69 = h4-dep m68 lm in h4-forkwrap m69 f j d dd dyn lab lt lm k))))
