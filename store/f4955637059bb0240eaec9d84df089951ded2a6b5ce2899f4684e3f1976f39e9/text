-- Diagonal orthogonality: (k+1) * Delta^2(a d k) * Delta^2(c b k) * inner-sum = 1 when triangles close.
sf-orth-diag : Nat → Nat → Nat → Nat → Nat → BQ
sf-orth-diag a b c d k =
  bq-mul (bq-mul (sf-bq-of-nat (suc k)) (bq-mul (sf-delta2 a d k) (sf-delta2 c b k)))
         (sf-orth-loop (suc (nat-min (plus a b) (plus c d))) a b c d k k bq-zero)
