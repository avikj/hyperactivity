-- the alias whose target is ns, in the order the aliases were made: a file's aliases are a
-- vector of [alias, target] pairs (names)
b2-alias : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-alias mm_ zero als j n ns kq_ =
  kq_ (h4-depl mm_ (#0))
b2-alias mm_ (suc f) als j n ns kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_660 = als in let j_661 = j in scmd (w-load ((b2-a mm_ (%wadd v_660 #2)))) (λ d_659 → let mm_662 = b2-dep mm_ d_659 in scmd (w-load ((b2-a mm_662 (%wadd d_659 (%wsucc j_661))))) (λ x_658 → let mm_663 = b2-dep mm_662 x_658 in let pr = x_658 in let i_665 = (%wadd pr #1) in scmd (w-load ((b2-a mm_663 i_665))) (λ x_664 → let mm_666 = b2-dep mm_663 x_664 in let t = x_664 in if (%weq t ns) then (let i_668 = pr in scmd (w-load ((b2-a mm_666 i_668))) (λ x_667 → let mm_669 = b2-dep mm_666 x_667 in let a = x_667 in kq_ (h4-depl mm_669 (a)))) else (b2-alias mm_666 f als (%wsucc j) n ns kq_)))))
