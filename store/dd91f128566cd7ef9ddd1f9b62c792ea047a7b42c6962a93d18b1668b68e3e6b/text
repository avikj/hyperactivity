b2-ploop : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-ploop mm_ zero p kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ploop mm_ (suc f) p kq_ =
  b2-pitem mm_ p (λ dd_14456 → let mm_14457 = b2-dep mm_ dd_14456 in scmd (w-load ((b2-HR mm_14457 #28))) (λ r → let mm_14458 = b2-dep mm_14457 r in if (%weq r #1) then (b2-ploop mm_14458 f p kq_) else (kq_ (h4-depl mm_14458 (r)))))
