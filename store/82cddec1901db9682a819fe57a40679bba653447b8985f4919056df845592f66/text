s-site-kept : List Word → List Word → Proc W (List Word) → Proc W (List Word)
s-site-kept st key mk = bind (h-read (list-append h-index "/meta/root")) (λ s →
  bind (h-read (list-append st (list-append "/site-" (list-append (h-hex (h-before " " (s-or nil s))) (list-append "-" key))))) (s-site-or (list-append st (list-append "/site-" (list-append (h-hex (h-before " " (s-or nil s))) (list-append "-" key)))) mk))
