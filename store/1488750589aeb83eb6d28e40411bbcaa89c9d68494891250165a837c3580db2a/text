sc-z2-sum : (W : Type) → (zW : W) → (addW : W → W → W) → (negW : W → W) → QgmAb W zW addW negW →
  (tau : W → W) → (x : W) → addW (sc-xp W addW tau x) (sc-xm W addW negW tau x) ≡ addW x x
sc-z2-sum W zW addW negW ab tau x =
  concat (qgm-swap4 W zW addW negW ab x (tau x) x (negW (tau x)))
    (concat (cong (λ t → addW (addW x x) t) (qgm-inv W zW addW negW ab (tau x)))
            (qgm-zr W zW addW negW ab (addW x x)))
