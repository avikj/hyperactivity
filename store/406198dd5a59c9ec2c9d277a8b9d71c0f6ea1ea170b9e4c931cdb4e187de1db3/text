b2-rshow : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-rshow mm_ zero file rs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-rshow mm_ (suc f) file rs j acc kq_ =
  let a_1368 = rs in scmd (w-load ((b2-a mm_ a_1368))) (λ x_1367 → let mm_1369 = b2-dep mm_ x_1367 in let n = x_1367 in if (%weq j n) then (kq_ (h4-depl mm_1369 (acc))) else (let a_1371 = rs in let j_1372 = j in scmd (w-load ((b2-a mm_1369 (%wadd a_1371 (%wsucc j_1372))))) (λ x_1370 → let mm_1373 = b2-dep mm_1369 x_1370 in let k = x_1370 in b2-nameshow mm_1373 file k (λ s → let mm_1374 = b2-dpl mm_1373 s in b2-rshow mm_1374 f file rs (%wsucc j) (list-append acc (list-append " - " (list-append s "{}"))) kq_))))
