-- Exact Euclidean EPRL 4-simplex vertex amplitude for equilateral boundary spin J with SO(4) = SU(2)_+ x SU(2)_-
-- splits (Jp, Jm) (e.g., Jp = J, Jm = 0 for self-dual BF gamma=1; Jp = Jm = J/2 for Barrett-Crane gamma=0;
-- Jp = 2, Jm = 1, J = 3 for Immirzi gamma = 1/3).
-- Every internal square root cancels identically: sqrt((ip+1)(im+1)) from f_a multiplies sqrt(ip+1) from A_v^+ and
-- sqrt(im+1) from A_v^- to give integer (ip+1)(im+1), and every internal Delta appears an even number of times.
sf-eprl-opt-wt : Nat → Nat → Nat → Nat → Nat → BQ → BQ
sf-eprl-opt-wt Jp Jm k ip im w9 =
  (λ dp dm → bq-mul (bq-mul (sf-bq-of-nat (times (suc ip) (suc im))) (sf-delta2 ip im k))
                    (bq-mul (bq-mul (bq-mul dp dp) (bq-mul dm dm)) (bq-mul w9 w9)))
    (sf-delta2 Jp Jp ip) (sf-delta2 Jm Jm im)
