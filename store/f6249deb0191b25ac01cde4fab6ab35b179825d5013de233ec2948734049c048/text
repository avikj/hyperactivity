h4-lend : Word → Nat → Word → (Word → Step W Word) → Step W Word
h4-lend m zero x k =
  k (h4-depl m (x))
h4-lend m (suc f) x k =
  if (andB (%weq (h4-tag x) h4-C02) (%weq (h4-ext x) h4-CON)) then (scmd (w-load ((h4-ha m (%wadd (h4-val x) #1)))) (λ nx → let m2800 = h4-dep m nx in h4-lend m2800 f nx k)) else (k (h4-depl m (x)))
