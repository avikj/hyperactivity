-- THEOREM 5 (Constructive Co-Optimizing Co-Evolving Consciousness Composition):
hxp-thm-coevolve-consciousness :
  {Prog Sem : Type} → (eval : Prog → Sem) → (cost : Prog → Nat) →
  (c0 c1 c2 : Prog) →
  (eval c1 ≡ eval c0) × (hxp-le (cost c1) (cost c0) ≡ true) →
  (eval c2 ≡ eval c1) × (hxp-le (cost c2) (cost c1) ≡ true) →
  (eval c2 ≡ eval c0) × (hxp-le (cost c2) (cost c0) ≡ true)
hxp-thm-coevolve-consciousness eval cost c0 c1 c2 s01 s12 =
  (hxp-trans (fst s12) (fst s01) , hxp-le-trans (cost c2) (cost c1) (cost c0) (snd s12) (snd s01))
