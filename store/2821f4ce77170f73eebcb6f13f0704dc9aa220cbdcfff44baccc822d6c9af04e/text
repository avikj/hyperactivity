  kq_ (h4-depl mm_ (#1))
b2-tipown mm_ (suc f) bk xs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#1))) else (let a_12406 = xs in let j_12407 = j in scmd (w-load ((b2-a mm_ (%wadd a_12406 (%wsucc j_12407))))) (λ x_12405 → let mm_12408 = b2-dep mm_ x_12405 in let x = x_12405 in b2-wnf mm_12408 bk x (λ w → let mm_12409 = b2-dep mm_12408 w in if (%weq w b2-ERR) then (kq_ (h4-depl mm_12409 b2-ERR)) else (let t_12411 = w in scmd (w-load ((b2-a mm_12409 t_12411))) (λ x_12410 → let mm_12412 = b2-dep mm_12409 x_12410 in let wt = (%wand x_12410 #255) in let t_12414 = w in let j_12415 = #1 in scmd (w-load ((b2-a mm_12412 (%wadd t_12414 (%wadd #2 j_12415))))) (λ x_12413 → let mm_12416 = b2-dep mm_12412 x_12413 in let wi = x_12413 in if (orB (not (%weq wt b2-VAR)) (not (%weq wi j))) then (kq_ (h4-depl mm_12416 (#0))) else (b2-tipown mm_12416 f bk xs (%wsucc j) n kq_)))))))
