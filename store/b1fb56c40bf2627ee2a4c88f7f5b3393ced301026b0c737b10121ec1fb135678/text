hr-call : List Hv2Def → Word → Word → Word → (Word → Step W Word) → Step W Word
hr-call book m a b k =
  let d = hv2-def-at (%wand (hv2-val a) #268435455) book
  in if %weq (hv2-tag b) hv2-DUP
     then (if hv2d-safe d then hr-eras m a b k
           else cli-say "ERROR: attempt to clone a non-affine global reference." (sdone #1))
     else hr-call-def d m b k
