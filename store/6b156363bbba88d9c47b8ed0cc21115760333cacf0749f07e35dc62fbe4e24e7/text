-- Primitive binary operations (PO_* sub-numbered 0..34: Int64 0..4, UInt32 5..9, Float64 10..15, UInt64 16..27, Int64 28..34)
a64-op2 : Word → Lst Word
a64-op2 sb =
  if %weq sb #0 then a64-add #0 #0 #1
  else if %weq sb #1 then a64-sub #0 #0 #1
  else if %weq sb #2 then a64-mul #0 #0 #1
  else if %weq sb #3 then l-app (a64-cmp #0 #1) (a64-bool-cc #0 a64-cc-eq)
  else if %weq sb #4 then l-app (a64-cmp #0 #1) (a64-bool-cc #0 a64-cc-lt)
  else if %weq sb #5 then a64-add32 #0 #0 #1
  else if %weq sb #6 then a64-sub32 #0 #0 #1
  else if %weq sb #7 then a64-mul32 #0 #0 #1
  else if %weq sb #8 then l-app (a64-cmp32 #0 #1) (a64-bool-cc #0 a64-cc-eq)
  else if %weq sb #9 then l-app (a64-cmp32 #0 #1) (a64-bool-cc #0 a64-cc-lo)
  else if %weq sb #10 then a64-fop a64-fadd-d0
  else if %weq sb #11 then a64-fop a64-fsub-d0
  else if %weq sb #12 then a64-fop a64-fmul-d0
  else if %weq sb #13 then a64-fop a64-fdiv-d0
  else if %weq sb #14 then a64-fcmp a64-cc-eq
  else if %weq sb #15 then a64-fcmp a64-cc-lo
  else if %weq sb #16 then a64-add #0 #0 #1
  else if %weq sb #17 then a64-sub #0 #0 #1
  else if %weq sb #18 then a64-mul #0 #0 #1
  else if %weq sb #19 then l-app (a64-cmp #0 #1) (a64-bool-cc #0 a64-cc-eq)
  else if %weq sb #20 then l-app (a64-cmp #0 #1) (a64-bool-cc #0 a64-cc-lo)
  else if %weq sb #21 then a64-udiv #0 #0 #1
  else if %weq sb #22 then a64-umod
  else if %weq sb #23 then a64-and-r #0 #0 #1
  else if %weq sb #24 then a64-orr-r #0 #0 #1
  else if %weq sb #25 then a64-eor-r #0 #0 #1
  else if %weq sb #26 then a64-lslv #0 #0 #1
  else if %weq sb #27 then a64-lsrv #0 #0 #1
  else if %weq sb #28 then a64-sdiv #0 #0 #1
  else if %weq sb #29 then a64-smod
  else if %weq sb #30 then a64-and-r #0 #0 #1
  else if %weq sb #31 then a64-orr-r #0 #0 #1
  else if %weq sb #32 then a64-eor-r #0 #0 #1
  else if %weq sb #33 then a64-lslv #0 #0 #1
  else a64-asrv #0 #0 #1
