-- THEOREM 11 (Superconducting Kirchhoff Conservation Across Multi-Hop Channels):
hxp-thm-supercond-kirchhoff :
  (held transfer inflight : Nat) →
  hxp-add (hxp-add held transfer) inflight ≡ hxp-add held (hxp-add transfer inflight)
hxp-thm-supercond-kirchhoff held transfer inflight = hxp-add-assoc held transfer inflight
