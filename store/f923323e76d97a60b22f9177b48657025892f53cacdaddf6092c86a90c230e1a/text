b2-tipvars : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tipvars mm_ zero tel ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-tipvars mm_ (suc f) tel ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_8095 = tel in let j_8096 = j in scmd (w-load ((b2-a mm_ (%wadd a_8095 (%wsucc j_8096))))) (λ x_8094 → let mm_8097 = b2-dep mm_ x_8094 in let c = x_8094 in let i_8099 = (%wadd c #1) in scmd (w-load ((b2-a mm_8097 i_8099))) (λ x_8098 → let mm_8100 = b2-dep mm_8097 x_8098 in let k = x_8098 in let i_8102 = (%wadd c #2) in scmd (w-load ((b2-a mm_8100 i_8102))) (λ x_8101 → let mm_8103 = b2-dep mm_8100 x_8101 in let i = x_8101 in b2-Var mm_8103 k i #0 #0 (λ v → let mm_8104 = b2-dep mm_8103 v in let a_8105 = ob in let j_8106 = j in let v_8107 = v in scmd (w-store ((b2-a mm_8104 (%wadd a_8105 (%wsucc j_8106)))) (v_8107)) (λ uu_8108 → let mm_8109 = hv2-u mm_8104 uu_8108 in b2-tipvars mm_8109 f tel ob (%wsucc j) n kq_))))))
