-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10550 = s in let j_10551 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_10550 (%wadd #2 j_10551))))) (λ x_10549 → let mm_10552 = b2-dep mm_ x_10549 in let fl = x_10549 in kq_ (h4-depl mm_10552 (fl))))
