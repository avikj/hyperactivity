pt-zeff-x100 : Word → Word
pt-zeff-x100 z =
  let cfg  = pt-config z
      last = pt-last-shell cfg
      nval = sf-n last
      ve   = pt-same-sp-e nval cfg
      same = if %weq nval #1 then %wmul #30 (%wsub ve #1) else %wmul #35 (%wsub ve #1)
      sig  = %wadd same (pt-slater-sigma-other nval cfg)
  in %wsub (%wmul #100 z) sig
