-- Eternal Interaction Trace (work-flow = work-product): permanently appends every event/steer to store/trace.jsonl
-- Supports ?since=N incremental cursor for <350ms near-realtime closed-loop delta streaming!
s-trace-count : List (List Word) → Word
s-trace-count nil = #0
s-trace-count (cons l ls) = if h-null l then s-trace-count ls else %wadd #1 (s-trace-count ls)
