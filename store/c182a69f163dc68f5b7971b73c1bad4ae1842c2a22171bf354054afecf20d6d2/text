emg-v3-cross : (A : Type) → (A → A → A) → (A → A → A) → (A → A) → EmgVec3 A → EmgVec3 A → EmgVec3 A
emg-v3-cross A add mul neg u v =
  (add (mul (fst (snd u)) (snd (snd v))) (neg (mul (snd (snd u)) (fst (snd v)))) ,
   (add (mul (snd (snd u)) (fst v)) (neg (mul (fst u) (snd (snd v)))) ,
    add (mul (fst u) (fst (snd v))) (neg (mul (fst (snd u)) (fst v)))))
