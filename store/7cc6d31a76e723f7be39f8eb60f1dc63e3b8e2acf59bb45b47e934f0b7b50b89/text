-- 2. Euler's 4-Square Quaternion Norm Multiplicativity ||q*r||^2 == ||q||^2 * ||r||^2: 20 muls -> 9 muls (-55%!)
gn-euler4-spec : RProg
gn-euler4-spec =
  rprog #8
    (cons (#8  , re-sub (re-sub (re-sub (re-mul (re-v #0) (re-v #4)) (re-mul (re-v #1) (re-v #5)))
                                (re-mul (re-v #2) (re-v #6))) (re-mul (re-v #3) (re-v #7)))
    (cons (#9  , re-sub (re-add (re-add (re-mul (re-v #0) (re-v #5)) (re-mul (re-v #1) (re-v #4)))
                                (re-mul (re-v #2) (re-v #7))) (re-mul (re-v #3) (re-v #6)))
    (cons (#10 , re-add (re-add (re-sub (re-mul (re-v #0) (re-v #6)) (re-mul (re-v #1) (re-v #7)))
                                (re-mul (re-v #2) (re-v #4))) (re-mul (re-v #3) (re-v #5)))
    (cons (#11 , re-add (re-sub (re-add (re-mul (re-v #0) (re-v #7)) (re-mul (re-v #1) (re-v #6)))
                                (re-mul (re-v #2) (re-v #5))) (re-mul (re-v #3) (re-v #4))) nil))))
    (cons (re-add (re-add (re-mul (re-v #8) (re-v #8)) (re-mul (re-v #9) (re-v #9)))
                  (re-add (re-mul (re-v #10) (re-v #10)) (re-mul (re-v #11) (re-v #11)))) nil)
