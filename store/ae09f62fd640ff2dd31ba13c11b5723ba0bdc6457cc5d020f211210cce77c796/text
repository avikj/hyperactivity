#!/bin/bash
# ports/test-bend.sh BEND BIN: every test of a HigherOrderCO/bend checkout (BEND/tests/<ns>/*.bend)
# run by BIN and by `bun BEND/bend2/main.ts`; a test passes when stdout, stderr and the exit code
# are the same bytes. Prints the failures, then the count.
BEND=$(cd "$1" && pwd); BIN=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); export BEND_DIR=$BEND/bend2
cd "$BEND/tests"; pass=0; fail=0
for f in */*.bend; do
  a=$( (timeout 60 "$BIN" "$PWD/$f" 2>&1; echo "exit $?") < /dev/null)
  b=$( (timeout 60 bun ../bend2/main.ts "$PWD/$f" 2>&1; echo "exit $?") < /dev/null)
  if [ "$a" = "$b" ]; then pass=$((pass+1)); else fail=$((fail+1)); echo "FAIL $f"; fi
done
echo "pass $pass fail $fail"
