syntax py
  def py_square(x: Word) -> Word:
    return x * x

  def py_linear_comb(a: Word, b: Word) -> Word:
    s = a + b
    return s * 2 + 1

  def py_clamp(x: Word, lim: Word) -> Word:
    return x if x < lim else lim

  def py_mix_hash(a: Word, b: Word) -> Word:
    t = a ^ b
    return (t + a) * 3
