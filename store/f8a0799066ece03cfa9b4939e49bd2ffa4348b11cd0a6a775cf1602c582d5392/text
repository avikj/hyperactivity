-- ---------------------------------------------------------------- deriving equiv & ua
-- Explicit-parameter wrappers around isoToEquiv and ua so reflected Code applications
-- evaluate directly via eval-g and read back via cn with zero implicit holes.
d-mk-equiv : (A B : Type) → (f : A → B) → (g : B → A) → ((b : B) → f (g b) ≡ b) → ((a : A) → g (f a) ≡ a) → Equiv A B
d-mk-equiv A B f g s r = isoToEquiv {lzero} {A} {B} f g s r
