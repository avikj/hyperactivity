      inst <- b2-mkdef (%wsub dn dx) #0 vT v
      do b2m-setf inst #6 du
      cp <- b2-copy inst
      do b2m-setf cp #3 #0
      tl <- b2m-f bk #0
      do b2-mset tl o2 cp
      e <-! b2c f #4 bk lhs o2 inst z #0 #0
      do b2m-setf inst #4 e
      do b2-mset tl o2 inst
      ret o2
    ot <- b2-tld bk o
    ov <- b2m-f ot #3
    if andB (%weq ov #0) (not (%weq o def0))
      r <- b2-fail bk ctx "a decreasing self-call (arguments are read left to right: each passed unchanged until one shrinks)" a s def0
      ret r
    ret o
  ret #0

-- ===========================================================================================
-- book_valid(book, done): each order event checked in place; a raised Err is the failure
-- ===========================================================================================

-- every entry of the map's own table into dst: a def named in last copied bodiless
fnrec b2-bvcopy (f : Nat) (t : Word) (cap : Word) (last : Word) (dst : Word) (j : Word) : Word
  zero: ret dst
  if %weq j cap
    ret dst
  k <- b2m-rd (%wadd t (%wsucc j))
  if %weq k #0
    jump b2-bvcopy f t cap last dst (%wsucc j)
  v <- b2m-rd (%wadd t (%wadd (%wsucc j) cap))
  tg <- b2m-tag v
  li <- b2-mget last k
  if andB (not (%weq li hv2-none)) (%weq tg b2-TDEF)
    c <- b2-copy v
    do b2m-setf c #3 #0
    do b2-mset dst k c
    jump b2-bvcopy f t cap last dst (%wsucc j)
  do b2-mset dst k v
  jump b2-bvcopy f t cap last dst (%wsucc j)

-- the last index of each name in the order vector
fnrec b2-bvlast (f : Nat) (ord : Word) (last : Word) (j : Word) (n : Word) : Word
  zero: ret last
  if %weq j n
    ret last
  k <- b2m-vat ord j
  do b2-mset last k j
  jump b2-bvlast f ord last (%wsucc j) n

-- a context binding the doms vector's [q, k, A] at 0, 1, ..
fnrec b2-domsctx (f : Nat) (doms : Word) (ctx : Word) (j : Word) (n : Word) : Word
  zero: ret ctx
  if %weq j n
    ret ctx
  dm <- b2m-vat doms j
  q <- b2m-rd dm
  k <- b2m-rd (%wadd dm #1)
  vA <- b2m-rd (%wadd dm #2)
  c2 <- b2-ctxbind ctx j q k vA
  jump b2-domsctx f doms c2 (%wsucc j) n

-- the tip's parameters are the variables 0, 1, .. (a array, from j)
fnrec b2-tipown (f : Nat) (bk : Word) (xs : Word) (j : Word) (n : Word) : Word
  zero: ret #1
  if %weq j n
    ret #1
  x <- b2m-at xs j
  w <-! b2-wnf bk x
  wt <- b2m-tag w
  wi <- b2m-f w #1
  if orB (not (%weq wt b2-VAR)) (not (%weq wi j))
    ret #0
  jump b2-tipown f bk xs (%wsucc j) n

-- a constructor's telescope (md 1: ctr a, tel b, ctx c, d, kind e, adt g): each domain at its goal
fnrec b2-bvctr (f : Nat) (bk : Word) (k : Word) (ad : Word) (kind : Word) (ctr : Word) (tel : Word) (ctx : Word) (d : Word) : Word
  zero: ret #0
  n <- b2m-f ad #0
  ck <- b2m-f ctr #0
  cn <- b2m-f ctr #1
  if %weq d (%wadd n cn)
    kb <-[b2-dpl] b2-namekey k
    let exp = list-append "a telescope tipped at " (list-append kb " applied to its own parameters")
    tip <-! b2-wnf bk tel
    tq0 <- b2m-tag tip
    tk <- b2m-f tip #0
    tx <- b2m-f tip #1
    tr <- b2m-f tip #2
    txn <- b2m-len tx
    trn <- b2m-len tr
    if orB (not (%weq tq0 b2-ADT)) (orB (not (%weq tk k)) (orB (not (%weq txn n)) (not (%weq trn #0))))
      r <- b2-fail bk ctx exp tip #0 ck
      ret r
    ok <-! b2-tipown (toNat #4294967295) bk tx #0 n
    if %weq ok #0
      r <- b2-fail bk ctx exp tip #0 ck
      ret r
    ret #0
  h <-! b2-thead bk tel ctx ck #0
  q <- b2m-f h #0
  hk <- b2m-f h #1
  hA <- b2m-f h #3
  hB <- b2m-f h #4
  g0 <- b2-TypQ q #0
  let goal = the Word (if andB (not (%wlt d n)) (%weq q b2-LONE) then kind else g0)
  rf <- b2-Ref ck #0 #0
  e0 <- b2-arr #0
  lhs <- b2-mklhs rf #0 ck e0 #0 #0
  do! b2c (toNat #4294967295) #1 bk lhs hA b2-NONE goal ctx d
  c2 <- b2-ctxbind ctx d q hk hA
  x <- b2-Var hk d #0 #0
  t2 <-! b2-body bk hB x
  jump b2-bvctr f bk k ad kind ctr t2 c2 (%wsucc d)

fnrec b2-bvctrs (f : Nat) (bk : Word) (k : Word) (ad : Word) (kind : Word) (cs : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if %weq j n
    ret #0
  ctr <- b2m-vat cs j
  cT <- b2m-f ctr #2
  do! b2-bvctr (toNat #4294967295) bk k ad kind ctr cT #0 #0
  jump b2-bvctrs f bk k ad kind cs (%wsucc j) n

-- the head under a foreign def's binders
fnrec b2-foreigntip (f : Nat) (bk : Word) (tel : Word) (d : Word) : Word
  zero: ret tel
  t <- b2-strip tel
  tg <- b2m-tag t
  if not (%weq tg b2-ALL)
    ret t
  k <- b2m-f t #1
  vB <- b2m-f t #4
  x <- b2-Var k d #0 #0
  t2 <-! b2-body bk vB x
  jump b2-foreigntip f bk t2 (%wsucc d)

fnrec b2-bvloop (f : Nat) (bk : Word) (tlds : Word) (last : Word) (done : Word) (i : Word) (n : Word) : Word
  zero: ret #0
  if %weq i n
    ret #0
  x <-! b2-bvstep bk tlds last done i
  jump b2-bvloop f bk tlds last done (%wsucc i) n

-- one event checked, its closures reclaimed (see b2-iostep)
fn b2-bvstep (bk : Word) (tlds : Word) (last : Word) (done : Word) (i : Word) : Word
  mk <- cmd (w-sys #900 #0 #0 #0 #0 #0 #0)
  wr (b2-HR M #31) #0
  ord <- b2m-f bk #2
  k <- b2m-vat ord i
  tld <- b2-mget tlds k
  li <- b2-mget last k
  let fin = %weq li i
  tg <- b2m-tag tld
  ntl <- b2m-f bk #0
  if %weq tg b2-TADT
    if not (%wlt i done)
      vT <- b2m-f tld #2
      rf <- b2-Ref k #0 #0
      e0 <- b2-arr #0
      lhs <- b2-mklhs rf #0 k e0 #0 #0
      ty <- b2-TypQ b2-LONE #0
      do! b2c (toNat #4294967295) #1 bk lhs vT b2-NONE ty #0 #0
      un <-! b2-tunbind bk vT
      doms <- b2m-rd un
      kind <- b2m-rd (%wadd un #1)
      kt <- b2m-tag kind
      if not (%weq kt b2-TYP)
        nd <- b2m-vlen doms
        ctx <- b2-domsctx (toNat #4294967295) doms #0 #0 nd
        kb <-[b2-dpl] b2-namekey k
        ks <- b2m-span kind
        ts <- b2m-span vT
        r <- b2-fail bk ctx (list-append "a kind (type " (list-append kb "<..> is Kind(g))")) kind (the Word (if %weq ks #0 then ts else ks)) k
        ret r
      cs <- b2m-f tld #3
      cn <- b2m-vlen cs
      do! b2-bvctrs (toNat #4294967295) bk k tld kind cs #0 cn
    jump b2-bvans #0
  if not (%wlt i done)
    tv <- b2m-f tld #3
    tb <- b2m-f tld #5
    ti <- b2m-f tld #7
    tu <- b2m-f tld #6
    if andB fin (andB (%weq tv #0) (andB (not (%weq tb #1)) (%weq ti #0)))
      h <- b2m-f bk #3
      do b2m-setf bk #3 (%wsucc h)
    vT <- b2m-f tld #2
    rf <- b2-Ref k #0 #0
    e0 <- b2-arr #0
    lhs <- b2-mklhs rf #0 k e0 tu #0
    ty <- b2-TypQ b2-LONE #0
    do! b2c (toNat #4294967295) #1 bk lhs vT b2-NONE ty #0 #0
    if not (%weq ti #0)
      tel <-! b2-foreigntip (toNat #4294967295) bk vT #0
      ua <- b2-unapply tel
      hd <- b2m-rd ua
      ht <- b2m-tag hd
      hk <- b2m-f hd #0
      io <- b2-tld bk b2-NIO
      iot <- b2m-tag io
      iob <- b2m-f io #5
      if orB (not (%weq ht b2-REF)) (orB (not (%weq hk b2-NIO)) (orB (%weq io #0) (orB (not (%weq iot b2-TDEF)) (not (%weq iob #1)))))
        kb <-[b2-dpl] b2-nbytes k
        ob <- b2-msg kb
        tls <- b2m-span tel
        r <- b2-fail bk #0 "a foreign definition returning base IO(...) directly (return type aliases are not unfolded)" ob tls k
        ret r
    if andB fin (not (%weq tv #0))
      e <-! b2c (toNat #4294967295) #4 bk lhs k tld #0 #0 #0
      do b2m-setf tld #4 e
  if fin
    do b2-mset ntl k tld
  jump b2-bvans #0


fn b2-bvans (v : Word) : Word
  halt (scmd (w-sys #901 #0 #0 #0 #0 #0 #0) kq_)

fn b2-bvalid (bk : Word) (done : Word) : Word
  tlds <- b2m-f bk #0
  ord <- b2m-f bk #2
  n <- b2m-vlen ord
  last <- b2-map #0
  do b2-bvlast (toNat #4294967295) ord last #0 n
  t <- b2m-rd tlds
  cap <- b2m-rd t
  dst <- b2-map #0
  do b2-bvcopy (toNat #4294967295) t cap last dst #0
  do b2m-setf bk #0 dst
  r <-! b2-bvloop (toNat #4294967295) bk tlds last done #0 n
  ret r
