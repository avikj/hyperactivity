-- ===========================================================================================
-- The checker (bend.ts term_descend, term_infer, tele_check, term_check_kind, uses_close,
-- term_check, def_check, def_inst, book_adt, ctx_dead, tele_*, book_valid)
-- an lhs is [t, n, def, qs (an array of quantities), u, z]; a context is a PMap of [q, k, T];
-- uses a PMap of quantities; an Infer or a Check is [tm, ty, us, x]
-- ===========================================================================================

b2-ltake : Word → List Word → List Word
b2-ltake n nil = nil
b2-ltake n (cons x r) = if %weq n #0 then nil else cons x (b2-ltake (%wsub n #1) r)

b2-allws : List Word → Bool
b2-allws nil = true
b2-allws (cons c r) = if orB (%weq c #32) (%weq c #9) then b2-allws r else false

-- the file of a span (0 when there is none)
fn b2-sfile (s : Word) : Word
  if %weq s #0
    ret #0
  fl <- b2m-f s #0
  ret fl

macro b2m-r3 (a : Word) (b : Word) (c : Word) : Word
  at <- b2m-alloc #3
  do b2m-wr at a
  do b2m-wr (%wadd at #1) b
  do b2m-wr (%wadd at #2) c
  ret at

macro b2m-r4 (a : Word) (b : Word) (c : Word) (e : Word) : Word
  at <- b2m-alloc #4
  do b2m-wr at a
  do b2m-wr (%wadd at #1) b
  do b2m-wr (%wadd at #2) c
  do b2m-wr (%wadd at #3) e
  ret at

-- Infer(tm, ty, us, x): tm annotated with a cell holding ty
fn b2-inf (tm : Word) (ty : Word) (us : Word) (x : Word) : Word
  c <- b2-Var b2-N_ b2-M1 #0 ty
  a <- b2-Ann tm c #0
  r <- b2m-r4 a ty us x
  ret r

fn b2-mklhs (t : Word) (n : Word) (def : Word) (qs : Word) (u : Word) (z : Word) : Word
  at <- b2m-alloc #6
  do b2m-wr at t
  do b2m-wr (%wadd at #1) n
  do b2m-wr (%wadd at #2) def
  do b2m-wr (%wadd at #3) qs
  do b2m-wr (%wadd at #4) u
  do b2m-wr (%wadd at #5) z
  ret at

-- {...lhs, t, n}
fn b2-lhsstep (lhs : Word) (t : Word) (n : Word) : Word
  def <- b2m-rd (%wadd lhs #2)
  qs <- b2m-rd (%wadd lhs #3)
  u <- b2m-rd (%wadd lhs #4)
  z <- b2m-rd (%wadd lhs #5)
  r <- b2-mklhs t n def qs u z
  ret r

-- lhs_kind(lhs, q)
fn b2-lhskind (lhs : Word) (q : Word) : Word
  u <- b2m-rd (%wadd lhs #4)
  ret (the Word (if andB (%weq u #1) (%weq q b2-MANY) then b2-LONE else q))

fn b2-ctxbind (ctx : Word) (i : Word) (q : Word) (k : Word) (vT : Word) : Word
  a <- b2m-r3 q k vT
  r <- b2-pset (toNat #64) ctx i a
  ret r

fn b2-uadd (a : Word) (b : Word) : Word
  r <- b2-punion (toNat #64) a b #0
  ret r

fn b2-wnf (bk : Word) (t : Word) : Word
  r <-! b2x (toNat #4294967295) #3 bk t #0 #0 #0
  ret r

fn b2-snf (bk : Word) (t : Word) : Word
  r <-! b2x (toNat #4294967295) #4 bk t #0 #0 #0
  ret r

-- term_compare(mode (0 EQ, 1 LE), book, a, b, d): 1 or 0
fn b2-cmp (md : Word) (bk : Word) (a : Word) (b : Word) (d : Word) : Word
  r <-! b2x (toNat #4294967295) #5 bk a b md d
  ret r

-- term_apply(f, x, s)
fn b2-tapp (bk : Word) (g : Word) (x : Word) (s : Word) : Word
  r <-! b2x (toNat #4294967295) #1 bk g x s #0
  ret r

-- a body applied: B(x)
fn b2-body (bk : Word) (cl : Word) (x : Word) : Word
  r <-! b2x (toNat #4294967295) #2 bk cl x #0 #0
  ret r

fn b2-lower (t : Word) (d : Word) : Word
  r <-! b2x (toNat #4294967295) #6 #0 t d #0 #0
  ret r

-- book_ctr(book, k): the ctr record or 0
fn b2-bctr (bk : Word) (k : Word) : Word
  cs <- b2m-f bk #1
  r <- b2-mget cs k
  ret (the Word (if %weq r hv2-none then #0 else r))

-- the names of the constructors in the vector cs, by name_key, joined by , 
fnrec b2-ctrnames (f : Nat) (cs : Word) (j : Word) (n : Word) (acc : List Word) : List Word
  zero: ret acc
  if %weq j n
    ret acc
  c <- b2m-vat cs j
  k <- b2m-f c #0
  kb <-[b2-dpl] b2-namekey k
  jump b2-ctrnames f cs (%wsucc j) n (the (List Word) (if %weq j #0 then kb else list-append acc (list-append ", " kb)))

-- the constructors of cs whose names are not in the array r
fnrec b2-ctrkeep (f : Nat) (cs : Word) (r : Word) (j : Word) (n : Word) (ob : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  c <- b2m-vat cs j
  k <- b2m-f c #0
  nr <- b2m-len r
  hit <- b2-inarr (toNat #4294967295) r k #0 nr
  if %weq hit #0
    do b2-vpush ob c
  jump b2-ctrkeep f cs r (%wsucc j) n ob

-- book_adt(book, tm, ctx, def): the ADT record, its removed constructors filtered out
fn b2-badt (bk : Word) (tm : Word) (ctx : Word) (def : Word) : Word
  k <- b2m-f tm #0
  s <- b2m-span tm
  fl <- b2-sfile s
  tld <- b2-tld bk k
  tq0 <- b2m-tag tld
  if orB (%weq tld #0) (not (%weq tq0 b2-TADT))
    kb <-[b2-dpl] b2-nameshow fl k
    if %weq tld #0
      r <- b2-fail bk ctx (list-append "a declared datatype (unknown: " (list-append kb ")")) #0 s def
      ret r
    n <- b2m-f tld #0
    let nte = the (List Word) (if %weq n #0 then list-append " with no arguments: write it as " kb else ": write its arguments as ()")
    r <- b2-failn bk ctx "a declared datatype" #0 s def (list-append "Note: " (list-append kb (list-append " is a def" nte)))
    ret r
  rr <- b2m-f tm #2
  rn <- b2m-len rr
  if %weq rn #0
    ret tld
  cs <- b2m-f tld #3
  cn <- b2m-vlen cs
  ob <- b2-vec
  do b2-ctrkeep (toNat #4294967295) cs rr #0 cn ob
  n <- b2m-f tld #0
  g <- b2m-f tld #1
  vT <- b2m-f tld #2
  at <- b2m-alloc #7
  do b2m-wr at (%wor b2-TADT #1280)
  do b2m-wr (%wadd at #1) #0
  do b2m-wr (%wadd at #2) n
  do b2m-wr (%wadd at #3) g
  do b2m-wr (%wadd at #4) vT
  do b2m-wr (%wadd at #5) ob
  do b2m-wr (%wadd at #6) #0
  ret at

-- the constructor named k in the vector cs, or 0
fnrec b2-ctrfind (f : Nat) (cs : Word) (k : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if %weq j n
    ret #0
  c <- b2m-vat cs j
  ck <- b2m-f c #0
  if %weq ck k
    ret c
  jump b2-ctrfind f cs k (%wsucc j) n

-- ctx_dead(book, ctx): a live binder at an ADT with no constructor left
fnrec b2-deadg (f : Nat) (bk : Word) (ctx : Word) (prs : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if not (%wlt j n)
    ret #0
  a <- b2m-vat prs (%wsucc j)
  q <- b2m-rd a
  if %weq q b2-NONE
    jump b2-deadg f bk ctx prs (%wadd j #2) n
  vT <- b2m-rd (%wadd a #2)
  t <-! b2-wnf bk vT
  tg <- b2m-tag t
  if %weq tg b2-ADT
    ad <-! b2-badt bk t ctx #0
    cs <- b2m-f ad #3
    cn <- b2m-vlen cs
    if %weq cn #0
      ret #1
  jump b2-deadg f bk ctx prs (%wadd j #2) n

fn b2-ctxdead (bk : Word) (ctx : Word) : Word
  prs <- b2-pairs ctx
  n <- b2m-vlen prs
  r <-! b2-deadg (toNat #4294967295) bk ctx prs #0 n
  ret r

-- tele_head(book, tel, ctx, def, s): the All, or an error
fn b2-thead (bk : Word) (tel : Word) (ctx : Word) (def : Word) (s : Word) : Word
  t <-! b2-wnf bk tel
  tg <- b2m-tag t
  if %weq tg b2-ALL
    ret t
  r <- b2-fail bk ctx "unreachable (a telescope binds its parameters and fields)" #0 s def
  ret r

-- tele_fill(book, tel, xs, ctx, def, s)
fnrec b2-tfillg (f : Nat) (bk : Word) (tel : Word) (xs : Word) (ctx : Word) (def : Word) (s : Word) (j : Word) : Word
  zero: ret tel
  n <- b2m-len xs
  if %weq j n
    ret tel
  h <-! b2-thead bk tel ctx def s
  vB <- b2m-f h #4
  x <- b2m-at xs j
  t2 <-! b2-body bk vB x
  jump b2-tfillg f bk t2 xs ctx def s (%wsucc j)

fn b2-tfill (bk : Word) (tel : Word) (xs : Word) (ctx : Word) (def : Word) (s : Word) : Word
  r <-! b2-tfillg (toNat #4294967295) bk tel xs ctx def s #0
  ret r

-- tele_unbind(book, T): [doms (a vector of [q, k, A]), ret]
fnrec b2-tunbg (f : Nat) (bk : Word) (tel : Word) (doms : Word) : Word
  zero: ret tel
  t <-! b2-wnf bk tel
  tg <- b2m-tag t
  if not (%weq tg b2-ALL)
    r <- b2m-r3 doms t #0
    ret r
  q <- b2m-f t #0
  k <- b2m-f t #1
  vA <- b2m-f t #3
  vB <- b2m-f t #4
  dm <- b2m-r3 q k vA
  do b2-vpush doms dm
  n <- b2m-vlen doms
  x <- b2-Var k (%wsub n #1) #0 #0
  t2 <-! b2-body bk vB x
  jump b2-tunbg f bk t2 doms

fn b2-tunbind (bk : Word) (vT : Word) : Word
  doms <- b2-vec
  r <-! b2-tunbg (toNat #4294967295) bk vT doms
  ret r

-- the quantities of the doms vector, an array
fnrec b2-domqs (f : Nat) (doms : Word) (ob : Word) (j : Word) (n : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  dm <- b2m-vat doms j
  q <- b2m-rd dm
  do b2m-put ob j q
  jump b2-domqs f doms ob (%wsucc j) n

-- uses_close(book, ctx, us, i, k, q, s, def)
fn b2-uclose (bk : Word) (ctx : Word) (us : Word) (i : Word) (k : Word) (q : Word) (s : Word) (def : Word) : Word
  o <- b2-pget (toNat #64) us i
  let u = the Word (if %weq o hv2-none then b2-NONE else o)
  if not (%weq (b2-qjoin u q) q)
    kb <-[b2-dpl] b2-nbytes k
    let obs = the (List Word) (if %weq u b2-MANY then list-append kb " (consumed more than once)" else list-append (b2-qshow u) kb)
    ob <- b2-msg obs
    r <- b2-fail bk ctx (list-append (b2-qshow q) kb) ob s def
    ret r
  if %weq o hv2-none
    ret us
  r <- b2-pset (toNat #64) us i b2-NONE
  ret r

-- term_descend(q, arg, col): 0 LT, 1 EQ, 2 GT; md 0 descend(q x, arg y, col j); md 1 the fields
-- of two same constructors (a x, p y, from j, ord aux): (first GT field + 1) << 2 | ord; md 2 a
-- field of p (but bad aux) the argument a does not exceed (a x, p y, from j)
fnrec b2-desc (f : Nat) (md : Word) (x : Word) (y : Word) (j : Word) (aux : Word) : Word
  zero: ret #2
  if %weq md #1
    ax <- b2m-f x #1
    px <- b2m-f y #1
    n <- b2m-len px
    if %weq j n
      ret aux
    u <- b2m-at ax j
    v <- b2m-at px j
    fld <- b2-desc f #0 b2-LONE u v #0
    if %weq fld #2
      ret (%wor (%wshl (%wsucc j) #2) aux)
    jump b2-desc f #1 x y (%wsucc j) (the Word (if %weq fld #1 then aux else fld))
  if %weq md #2
    px <- b2m-f y #1
    n <- b2m-len px
    if %weq j n
      ret #2
    if %weq (%wsucc j) aux
      jump b2-desc f #2 x y (%wsucc j) aux
    v <- b2m-at px j
    r <- b2-desc f #0 b2-LONE x v #0
    if not (%weq r #2)
      ret #0
    jump b2-desc f #2 x y (%wsucc j) aux
  if %weq x b2-NONE
    ret #1
  s <- b2-strip y
  p <- b2-strip j
  pt <- b2m-tag p
  a <- b2-litifctr s pt
  at <- b2m-tag a
  if %weq pt b2-VAR
    pi <- b2m-f p #1
    ai <- b2m-f a #1
    ret (the Word (if andB (%weq at b2-VAR) (%weq ai pi) then #1 else #2))
  if not (%weq pt b2-CTR)
    ret #2
  pk <- b2m-f p #0
  px <- b2m-f p #1
  pn <- b2m-len px
  ak <- b2m-f a #0
  ax <- b2m-f a #1
  an <- b2m-len ax
  if andB (%weq at b2-CTR) (andB (%weq ak pk) (%weq an pn))
    fr <- b2-desc f #1 a p #0 #1
    let bad = %wshr fr #2
    if %weq bad #0
      ret (%wand fr #3)
    jump b2-desc f #2 a p #0 bad
  jump b2-desc f #2 a p #0 #0

-- the descent over the columns: ord of the first non-EQ column (cols and xs arrays)
fnrec b2-descols (f : Nat) (qs : Word) (xs : Word) (cols : Word) (j : Word) : Word
  zero: ret #1
  n <- b2m-len cols
  m2 <- b2m-len xs
  if orB (not (%wlt j n)) (not (%wlt j m2))
    ret #1
  q <- b2m-at qs j
  x <- b2m-at xs j
  c <- b2m-at cols j
  o <- b2-desc (toNat #4294967295) #0 q x c #0
  if not (%weq o #1)
    ret o
  jump b2-descols f qs xs cols (%wsucc j)

-- ctx_scope(ctx): a vector of names, bnd[i] = k and _ where nothing is bound
fnrec b2-scopefill (f : Nat) (v : Word) (prs : Word) (j : Word) (n : Word) : Word
  zero: ret v
  if not (%wlt j n)
    ret v
  i <- b2m-vat prs j
  a <- b2m-vat prs (%wsucc j)
  k <- b2m-rd (%wadd a #1)
  d <- b2m-rd (%wadd v #2)
  do b2m-put d i k
  jump b2-scopefill f v prs (%wadd j #2) n

fnrec b2-maxkey (f : Nat) (prs : Word) (j : Word) (n : Word) (mx : Word) : Word
  zero: ret mx
  if not (%wlt j n)
    ret mx
  i <- b2m-vat prs j
  jump b2-maxkey f prs (%wadd j #2) n (the Word (if %wlt mx (%wsucc i) then %wsucc i else mx))

fnrec b2-vfill (f : Nat) (v : Word) (x : Word) (j : Word) (n : Word) : Word
  zero: ret v
  if %weq j n
    ret v
  do b2-vpush v x
  jump b2-vfill f v x (%wsucc j) n

fn b2-scope (ctx : Word) : Word
  prs <- b2-pairs ctx
  n <- b2m-vlen prs
  mx <- b2-maxkey (toNat #4294967295) prs #0 n #0
  v <- b2-vec
  do b2-vfill (toNat #4294967295) v b2-N_ #0 mx
  do b2-scopefill (toNat #4294967295) v prs #0 n
  ret v

-- term_show(term_lower(x, bnd.length), -1, bnd, file)
fn b2-lshow (x : Word) (bnd : Word) (fl : Word) : List Word
  n <- b2m-vlen bnd
  l <- b2-lower x n
  if %weq l b2-ERR
    ret nil
  s <-[b2-dpl] b2-show l #0 bnd fl
  ret s

-- xs folded by term_apply onto h (no span)
fnrec b2-applyall (f : Nat) (bk : Word) (h : Word) (xs : Word) (j : Word) : Word
  zero: ret h
  n <- b2m-len xs
  if %weq j n
    ret h
  x <- b2m-at xs j
  h2 <-! b2-tapp bk h x #0
  jump b2-applyall f bk h2 xs (%wsucc j)

-- the elaborated terms of an array of Checks
fnrec b2-tms (f : Nat) (cs : Word) (j : Word) (n : Word) (ob : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  c <- b2m-vat cs j
  t <- b2m-rd c
  do b2m-put ob j t
  jump b2-tms f cs (%wsucc j) n ob

-- the literal kind's datatype name
b2-litname : Word → Word
b2-litname k = if %weq k b2-LNAT then b2-NNat else if %weq k b2-LU32 then b2-NU32 else if %weq k b2-LF32 then b2-NF32 else b2-NString

-- a TLD's b flag (an ADT's or a Def's)
fn b2-tldb (tld : Word) : Word
  if %weq tld #0
    ret #0
  tg <- b2m-tag tld
  if %weq tg b2-TADT
    b <- b2m-f tld #4
    ret b
  b <- b2m-f tld #5
  ret b

-- a vector with x pushed after the items of the array a, frozen
fn b2-snoc (a : Word) (x : Word) : Word
  x1 <- b2-arr1 x
  r <- b2-cat a x1
  ret r

-- k ++ ~ ++ the decimal of n, interned
fn b2-tilde (k : Word) (tail : List Word) : Word
  kb <-[b2-dpl] b2-nbytes k
  r <- b2-nm (list-append kb (cons #126 tail))
  ret r

-- f_lhs = {...lhs, t: term_apply(lhs.t, x), n: lhs.n - 1} while a parameter remains
fn b2-lhsapp (bk : Word) (lhs : Word) (x : Word) : Word
  n <- b2m-rd (%wadd lhs #1)
  if %weq n #0
    ret lhs
  lt <- b2m-rd lhs
  t2 <-! b2-tapp bk lt x #0
  r <- b2-lhsstep lhs t2 (%wsub n #1)
  ret r

-- h_lhs = {...lhs, t: lhs_ext(lhs.t, k, cn), n: lhs.n - 1 + cn} while a parameter remains
fn b2-lhsext (bk : Word) (lhs : Word) (k : Word) (cn : Word) : Word
  n <- b2m-rd (%wadd lhs #1)
  if %weq n #0
    ret lhs
  lt <- b2m-rd lhs
  t2 <-! b2x (toNat #4294967295) #7 bk lt k cn #0
  r <- b2-lhsstep lhs t2 (%wadd (%wsub n #1) cn)
  ret r

-- a let's variables: Var(k_j, d + j, v_j) into xs
fnrec b2-letvars (f : Nat) (ks : Word) (vs : Word) (d : Word) (xs : Word) (j : Word) (n : Word) : Word
  zero: ret xs
  if %weq j n
    ret xs
  k <- b2m-at ks j
  v <- b2m-at vs j
  x <- b2-Var k (%wadd d j) #0 v
  do b2m-put xs j x
  jump b2-letvars f ks vs d xs (%wsucc j) n

-- each let binder closed in turn
fnrec b2-letclose (f : Nat) (bk : Word) (ctx : Word) (us : Word) (ks : Word) (qs : Word) (d : Word) (s : Word) (def : Word) (j : Word) (n : Word) : Word
  zero: ret us
  if %weq j n
    ret us
  k <- b2m-at ks j
  q <- b2m-at qs j
  u2 <-! b2-uclose bk ctx us (%wadd d j) k q s def
  jump b2-letclose f bk ctx u2 ks qs d s def (%wsucc j) n

-- the text after the last c (the whole when there is none)
b2-afterlast : Word → List Word → List Word
b2-afterlast c l = hv2-rev (b2-upto c (hv2-rev l))

-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
fn b2-tret (bk : Word) (tc : Word) : Word
  lb <- b2m-rd (%wadd tc #2)
  if %weq lb #0
    t <- b2m-rd (%wadd tc #4)
    ret t
  lx <- b2m-rd (%wadd tc #3)
  r <-! b2-body bk lb lx
  ret r

-- a BOOK record copied, its tlds a new layer over the old (Object.create(book.tlds))
fn b2-bookover (bk : Word) : Word
  b2 <- b2-copy bk
  tl <- b2m-f bk #0
  t2 <- b2-map tl
  do b2m-setf b2 #0 t2
  ret b2

-- def_check's ~ parameters: t, v, T stepped by Ref(k~h.k) each, into r = [t, v, T]
fnrec b2-dcloop (f : Nat) (bk : Word) (gen : Word) (k : Word) (r : Word) (j : Word) (x : Word) : Word
  zero: ret r
  if %weq j x
    ret r
  vT <- b2m-rd (%wadd r #2)
  h <-! b2-thead gen vT #0 k #0
  hk <- b2m-f h #1
  hkb <-[b2-dpl] b2-nbytes hk
  o <- b2-tilde k hkb
  ot <- b2-tld gen o
  if not (%weq ot #0)
    hs <- b2m-span h
    ob <- b2-msg hkb
    e <- b2-fail bk #0 "a fresh ~ binder name" ob hs #0
    ret e
  hA <- b2m-f h #3
  hB <- b2m-f h #4
  dd <- b2-mkdef #0 #0 hA #0
  do b2m-setf dd #5 #1
  tl <- b2m-f gen #0
  do b2-mset tl o dd
  t <- b2m-rd r
  v <- b2m-rd (%wadd r #1)
  r1 <- b2-Ref o #0 #0
  t2 <- b2-App t r1 #0
  r2 <- b2-Ref o #0 #0
  v2 <-! b2-tapp gen v r2 #0
  r3 <- b2-Ref o #0 #0
  vT2 <-! b2-body gen hB r3
  do b2m-wr r t2
  do b2m-wr (%wadd r #1) v2
  do b2m-wr (%wadd r #2) vT2
  jump b2-dcloop f bk gen k r (%wsucc j) x

-- B(x) when there is a B, else t
fn b2-bodyor (bk : Word) (lb : Word) (lx : Word) (t : Word) : Word
  if %weq lb #0
    ret t
  r <-! b2-body bk lb lx
  ret r

fn b2-bookoverif (dx : Word) (bk : Word) : Word
  if %weq dx #0
    ret bk
  r <- b2-bookover bk
  ret r

-- book.tmps[k] ??= new Map: a record [map, size]
fn b2-tmpsof (tmps : Word) (k : Word) : Word
  is0 <- b2-mget tmps k
  if not (%weq is0 hv2-none)
    ret is0
  mp <- b2-map #0
  at <- b2m-alloc #2
  do b2m-wr at mp
  do b2m-wr (%wadd at #1) #0
  do b2-mset tmps k at
  ret at

-- term_key: JSON.stringify of a lowered term, spans left out
b2-jsq : List Word → List Word
b2-jsq s = cons #34 (list-append (b2-jsesc s) (cons #34 nil))

b2-jsesc : List Word → List Word
b2-jsesc nil = nil
b2-jsesc (cons c r) =
  if %weq c #34 then cons #92 (cons #34 (b2-jsesc r))
  else if %weq c #92 then cons #92 (cons #92 (b2-jsesc r))
  else if %weq c #10 then cons #92 (cons #110 (b2-jsesc r))
  else if %weq c #9 then cons #92 (cons #116 (b2-jsesc r))
  else if %weq c #13 then cons #92 (cons #114 (b2-jsesc r))
  else if %weq c #8 then cons #92 (cons #98 (b2-jsesc r))
  else if %weq c #12 then cons #92 (cons #102 (b2-jsesc r))
  else if %wlt c #32 then cons #92 (cons #117 (cons #48 (cons #48 (cons (b2-hexd (%wshr c #4)) (cons (b2-hexd (%wand c #15)) (b2-jsesc r))))))
  else cons c (b2-jsesc r)

-- the JSON key k:
b2-jk : List Word → List Word
b2-jk k = list-append (b2-jsq k) (cons #58 nil)

-- {$:T (no closing brace)
b2-jtag : List Word → List Word
b2-jtag t = cons #123 (list-append (b2-jk "$") (b2-jsq t))

-- ,k:v
b2-jf : List Word → List Word → List Word
b2-jf k v = cons #44 (list-append (b2-jk k) v)

b2-jsquant : Word → List Word
b2-jsquant q = list-append (b2-jtag (the (List Word) (if %weq q b2-NONE then "None" else if %weq q b2-MANY then "Many" else "Lone"))) (cons #125 nil)

b2-jint : Word → List Word
b2-jint i = if b2-neg i then cons #45 (ce-dec (%wsub #0 i)) else ce-dec i

b2-jclose : List Word → List Word
b2-jclose x = list-append x (cons #125 nil)

b2-jarr : List Word → List Word
b2-jarr x = cons #91 (list-append x (cons #93 nil))

fn b2-jname (k : Word) : List Word
  kb <-[b2-dpl] b2-nbytes k
  ret (b2-jsq kb)

-- md 0 the term t; 1 the terms of array t from aux, joined by ,; 2 the names of array t; 3 its
-- quantities; 4 its numbers
fnrec b2-json (f : Nat) (md : Word) (t : Word) (aux : Word) : List Word
  zero: ret nil
  if %weq md #1
    n <- b2m-len t
    if %weq aux n
      ret nil
    x <- b2m-at t aux
    a <-[b2-dpl] b2-json f #0 x #0
    r <-[b2-dpl] b2-json f #1 t (%wsucc aux)
    ret (the (List Word) (if %weq aux #0 then list-append a r else cons #44 (list-append a r)))
  if %wlt #1 md
    n <- b2m-len t
    if %weq aux n
      ret nil
    x <- b2m-at t aux
    a <-[b2-dpl] b2-jitem md x
    r <-[b2-dpl] b2-json f md t (%wsucc aux)
    ret (the (List Word) (if %weq aux #0 then list-append a r else cons #44 (list-append a r)))
  if %weq t #0
    ret nil
  tg <- b2m-tag t
  if %weq tg b2-VAR
    k0 <- b2m-f t #0
    k <-[b2-dpl] b2-jname k0
    i <- b2m-f t #1
    ret (b2-jclose (list-append (b2-jtag "Var") (list-append (b2-jf "k" k) (b2-jf "i" (b2-jint i)))))
  if %weq tg b2-REF
    k0 <- b2m-f t #0
    k <-[b2-dpl] b2-jname k0
    b <- b2m-f t #1
    ret (b2-jclose (list-append (b2-jtag "Ref") (list-append (b2-jf "k" k) (the (List Word) (if %weq b #1 then b2-jf "b" "true" else nil)))))
  if %weq tg b2-LET
    ks <- b2m-f t #0
    is <- b2m-f t #1
    qs <- b2m-f t #2
    vs <- b2m-f t #3
    g <- b2m-f t #4
    a1 <-[b2-dpl] b2-json f #2 ks #0
    a2 <-[b2-dpl] b2-json f #4 is #0
    a3 <-[b2-dpl] b2-json f #3 qs #0
    a4 <-[b2-dpl] b2-json f #1 vs #0
    a5 <-[b2-dpl] b2-json f #0 g #0
    ret (b2-jclose (list-append (b2-jtag "Let") (list-append (b2-jf "k" (b2-jarr a1)) (list-append (b2-jf "i" (b2-jarr a2)) (list-append (b2-jf "q" (b2-jarr a3)) (list-append (b2-jf "v" (b2-jarr a4)) (b2-jf "f" a5)))))))
  if %weq tg b2-TYP
    g <- b2m-f t #0
    a1 <-[b2-dpl] b2-json f #0 g #0
    ret (b2-jclose (list-append (b2-jtag "Typ") (b2-jf "g" a1)))
  if %weq tg b2-QNT
    ret (b2-jclose (b2-jtag "Qnt"))
  if %weq tg b2-QUA
    q <- b2m-f t #0
    ret (b2-jclose (list-append (b2-jtag "Qua") (b2-jf "q" (b2-jsquant q))))
  if %weq tg b2-ALL
    q <- b2m-f t #0
    k0 <- b2m-f t #1
    k <-[b2-dpl] b2-jname k0
    i <- b2m-f t #2
    x <- b2m-f t #3
    y <- b2m-f t #4
    a1 <-[b2-dpl] b2-json f #0 x #0
    a2 <-[b2-dpl] b2-json f #0 y #0
    ret (b2-jclose (list-append (b2-jtag "All") (list-append (b2-jf "q" (b2-jsquant q)) (list-append (b2-jf "k" k) (list-append (b2-jf "i" (b2-jint i)) (list-append (b2-jf "A" a1) (b2-jf "B" a2)))))))
  if %weq tg b2-LAM
    k0 <- b2m-f t #0
    k <-[b2-dpl] b2-jname k0
    i <- b2m-f t #1
    g <- b2m-f t #2
    q <- b2m-f t #3
    a1 <-[b2-dpl] b2-json f #0 g #0
    ret (b2-jclose (list-append (b2-jtag "Lam") (list-append (b2-jf "k" k) (list-append (b2-jf "i" (b2-jint i)) (list-append (b2-jf "f" a1) (the (List Word) (if %weq q b2-NOQ then nil else b2-jf "q" (b2-jsquant q))))))))
  if %weq tg b2-ADT
    k0 <- b2m-f t #0
    k <-[b2-dpl] b2-jname k0
    xs <- b2m-f t #1
    rs <- b2m-f t #2
    a1 <-[b2-dpl] b2-json f #1 xs #0
    a2 <-[b2-dpl] b2-json f #2 rs #0
    ret (b2-jclose (list-append (b2-jtag "ADT") (list-append (b2-jf "k" k) (list-append (b2-jf "x" (b2-jarr a1)) (b2-jf "r" (b2-jarr a2))))))
  if %weq tg b2-CTR
    k0 <- b2m-f t #0
    k <-[b2-dpl] b2-jname k0
    xs <- b2m-f t #1
    a1 <-[b2-dpl] b2-json f #1 xs #0
    ret (b2-jclose (list-append (b2-jtag "Ctr") (list-append (b2-jf "k" k) (b2-jf "x" (b2-jarr a1)))))
  if %weq tg b2-LIT
    lk <- b2m-f t #0
    v <- b2m-f t #1
    let kn = the (List Word) (if %weq lk b2-LNAT then "Nat" else if %weq lk b2-LU32 then "U32" else if %weq lk b2-LF32 then "F32" else "String")
    if %weq lk b2-LSTR
      us <-[b2-dpl] b2-units v
      ret (b2-jclose (list-append (b2-jtag "Lit") (list-append (b2-jf "k" (b2-jsq kn)) (b2-jf "v" (b2-jsq (b2-utf8 us))))))
    ret (b2-jclose (list-append (b2-jtag "Lit") (list-append (b2-jf "k" (b2-jsq kn)) (b2-jf "v" (ce-dec v)))))
  if orB (%weq tg b2-MIN) (orB (%weq tg b2-APP) (orB (%weq tg b2-MAT) (orB (%weq tg b2-EQL) (orB (%weq tg b2-RWT) (%weq tg b2-ANN)))))
    x <- b2m-f t #0
    y <- b2m-f t #1
    z <- b2m-f t #2
    let three = orB (%weq tg b2-EQL) (%weq tg b2-RWT)
    a1 <-[b2-dpl] b2-json f #0 (the Word (if %weq tg b2-MAT then y else x)) #0
    a2 <-[b2-dpl] b2-json f #0 (the Word (if %weq tg b2-MAT then z else y)) #0
    a3 <-[b2-dpl] b2-json f #0 (the Word (if three then z else #0)) #0
    km <-[b2-dpl] b2-jname x
    if %weq tg b2-MIN
      ret (b2-jclose (list-append (b2-jtag "Min") (list-append (b2-jf "a" a1) (b2-jf "b" a2))))
    if %weq tg b2-APP
      ret (b2-jclose (list-append (b2-jtag "App") (list-append (b2-jf "f" a1) (b2-jf "x" a2))))
    if %weq tg b2-MAT
      ret (b2-jclose (list-append (b2-jtag "Mat") (list-append (b2-jf "k" km) (list-append (b2-jf "h" a1) (b2-jf "m" a2)))))
    if %weq tg b2-EQL
      ret (b2-jclose (list-append (b2-jtag "Eql") (list-append (b2-jf "a" a1) (list-append (b2-jf "b" a2) (b2-jf "T" a3)))))
    if %weq tg b2-RWT
      ret (b2-jclose (list-append (b2-jtag "Rwt") (list-append (b2-jf "e" a1) (list-append (b2-jf "p" a2) (b2-jf "f" a3)))))
    ret (b2-jclose (list-append (b2-jtag "Ann") (list-append (b2-jf "x" a1) (b2-jf "T" a2))))
  if %weq tg b2-EFQ
    ret (b2-jclose (b2-jtag "Efq"))
  if %weq tg b2-RFL
    ret (b2-jclose (b2-jtag "Rfl"))
  if %weq tg b2-HOL
    k0 <- b2m-f t #0
    k <-[b2-dpl] b2-jname k0
    ret (b2-jclose (list-append (b2-jtag "Hol") (b2-jf "k" k)))
  ret nil

-- an item of a names (2), quantities (3) or numbers (4) array
fn b2-jitem (md : Word) (x : Word) : List Word
  if %weq md #2
    r <-[b2-dpl] b2-jname x
    ret r
  if %weq md #3
    ret (b2-jsquant x)
  ret (b2-jint x)

fn b2-fk (t : Word) : Word
  k <- b2m-f t #0
  ret k

-- the ~ arguments' keys joined by newlines
fnrec b2-tkeysg (f : Nat) (xs : Word) (j : Word) (acc : List Word) : List Word
  zero: ret acc
  n <- b2m-len xs
  if %weq j n
    ret acc
  x <- b2m-at xs j
  l <- b2-lower x #0
  kj <-[b2-dpl] b2-json (toNat #4294967295) #0 l #0
  jump b2-tkeysg f xs (%wsucc j) (the (List Word) (if %weq j #0 then kj else list-append acc (cons #10 kj)))

fn b2-tkeys (xs : Word) : List Word
  r <-[b2-dpl] b2-tkeysg (toNat #4294967295) xs #0 nil
  ret r

@split b2c 1 2 5 6
-- the checker, one function; md:
--   0 infer(tm a, qt b, sp c)   1 check(tm a, qt b, ty c)   2 tele_check(tel a, xs b, [qt, s] c)
--   3 check_kind(T a, q b, [k, s] c)   4 def_check(k a, def b, z c)   5 def_inst(tm a, def b, sp c)
fnrec b2c (f : Nat) (md : Word) (bk : Word) (lhs : Word) (a : Word) (b : Word) (c : Word) (ctx : Word) (d : Word) : Word
  zero: jump b2-fuelout
  -- ------------------------------------------------------------------------ infer
  if %weq md #0
    tw <- cmd w-now
    def <- b2m-rd (%wadd lhs #2)
    tg <- b2m-tag a
    s <- b2m-span a
    fl <- b2-sfile s
    let qt = b
    if %weq tg b2-VAR
      k <- b2m-f a #0
      i <- b2m-f a #1
      v <- b2m-f a #2
      if andB (b2-neg i) (not (%weq v #0))
        t2 <- b2-force a
        jump b2c f #0 bk lhs t2 qt c ctx d
      ann <- b2-pget (toNat #64) ctx i
      if %weq ann hv2-none
        r <- b2-fail bk ctx "a bound variable" a s def
        ret r
      vr <- b2-Var k i s #0
      vT <- b2m-rd (%wadd ann #2)
      us <- b2-pset (toNat #64) #0 i qt
      r <- b2-inf vr vT us #0
      ret r
    if %weq tg b2-REF
      k0 <- b2m-f a #0
      rb <- b2m-f a #1
      tld <- b2-tld bk k0
      if %weq tld #0
        kb <-[b2-dpl] b2-nbytes k0
        let isp = andB (b2-endswith kb ".pure") (%wlt #5 (cli-len kb))
        let isb = andB (b2-endswith kb ".bind") (%wlt #5 (cli-len kb))
        if orB isp isb
          pk <- b2-nm (b2-ltake (%wsub (cli-len kb) #5) kb)
          e <-[b2-dpl] b2-nameshow fl pk
          r <- b2-failn bk ctx "a defined name" a s def (list-append "Note: a do block on " (list-append e (list-append " calls " (list-append e (list-append ".bind and " (list-append e ".pure"))))))
          ret r
        r <- b2-fail bk ctx "a defined name" a s def
        ret r
      tq0 <- b2m-tag tld
      let isdef = %weq tq0 b2-TDEF
      dtld <- b2-tld bk def
      dtg <- b2m-tag dtld
      dx0 <- b2m-f dtld #1
      let dx = the Word (if andB (not (%weq dtld #0)) (%weq dtg b2-TDEF) then dx0 else #0)
      tx0 <- b2m-f tld #1
      let tx = the Word (if isdef then tx0 else #0)
      let gen = andB isdef (andB (%wlt #0 tx) (%weq dx #0))
      xs0 <- b2-ltoarr c
      if not (%weq qt b2-NONE)
        tv <- b2m-f tld #3
        tb <- b2m-f tld #5
        ti <- b2m-f tld #7
        lu <- b2m-rd (%wadd lhs #4)
        if andB isdef (andB (%weq tv #0) (andB (%weq ti #0) (andB (orB (andB (not (%weq tb #1)) (not (%weq lu #1))) gen) (not (%weq k0 def)))))
          r <- b2-fail bk ctx "a def whose body is implemented before the def is used (defs are checked in file order, and an unfilled law has none)" a s def
          ret r
        if gen
          k1 <-! b2c f #5 bk lhs a tld xs0 ctx d
          xs <- b2-drop xs0 tx
          jump b2c f #10 bk lhs a k1 xs ctx d
        jump b2c f #10 bk lhs a k0 xs0 ctx d
      jump b2c f #6 bk lhs a k0 #0 ctx d
    if %weq tg b2-TYP
      g <- b2m-f a #0
      q0 <- b2m-n0 b2-QNT s
      gc <-! b2c f #1 bk lhs g b2-NONE q0 ctx d
      gt <- b2m-rd gc
      ty <- b2m-n1 b2-TYP s gt
      ty2 <- b2-TypQ b2-LONE s
      r <- b2-inf ty ty2 #0 #0
      ret r
    if %weq tg b2-QNT
      ty2 <- b2-TypQ b2-LONE s
      r <- b2-inf a ty2 #0 #0
      ret r
    if %weq tg b2-QUA
      q0 <- b2m-n0 b2-QNT s
      r <- b2-inf a q0 #0 #0
      ret r
    if %weq tg b2-MIN
      x <- b2m-f a #0
      y <- b2m-f a #1
      q0 <- b2m-n0 b2-QNT s
      ac <-! b2c f #1 bk lhs x qt q0 ctx d
      q1 <- b2m-n0 b2-QNT s
      bc <-! b2c f #1 bk lhs y qt q1 ctx d
      at <- b2m-rd ac
      bt <- b2m-rd bc
      au <- b2m-rd (%wadd ac #2)
      bu <- b2m-rd (%wadd bc #2)
      mn <- b2m-n2 b2-MIN s at bt
      q2 <- b2m-n0 b2-QNT s
      us <- b2-uadd au bu
      r <- b2-inf mn q2 us #0
      ret r
    if %weq tg b2-ALL
      q <- b2m-f a #0
      k <- b2m-f a #1
      vA <- b2m-f a #3
      vB <- b2m-f a #4
      bctx <- b2-ctxbind ctx d q k vA
      as <- b2m-span vA
      ks <- b2m-r3 k (the Word (if %weq as #0 then s else as)) #0
      ac <-! b2c f #3 bk lhs vA q ks ctx d
      x <- b2-Var k d #0 #0
      bb <-! b2-body bk vB x
      ty1 <- b2-TypQ b2-LONE s
      bc <-! b2c f #1 bk lhs bb b2-NONE ty1 bctx (%wsucc d)
      at <- b2m-rd ac
      bt <- b2m-rd bc
      al <- b2-All q k d at bt s
      ty2 <- b2-TypQ b2-LONE s
      r <- b2-inf al ty2 #0 #0
      ret r
    if %weq tg b2-APP
      g <- b2m-f a #0
      x <- b2m-f a #1
      sp2 <- b2-lset c #0 x
      fi <-! b2c f #0 bk lhs g qt sp2 ctx d
      fx <- b2m-rd (%wadd fi #3)
      if not (%weq fx #0)
        t0 <- b2m-rd fi
        t1 <- b2m-rd (%wadd fi #1)
        t2 <- b2m-rd (%wadd fi #2)
        r <- b2m-r4 t0 t1 t2 (%wsub fx #1)
        ret r
      fty <- b2m-rd (%wadd fi #1)
      w <-! b2-wnf bk fty
      wt <- b2m-tag w
      if not (%weq wt b2-ALL)
        r <- b2-fail bk ctx "a function type" fty s def
        ret r
      wq <- b2m-f w #0
      wA <- b2m-f w #3
      wB <- b2m-f w #4
      xc <-! b2c f #1 bk lhs x (b2-qdem wq qt) wA ctx d
      ft <- b2m-rd fi
      xt <- b2m-rd xc
      fu <- b2m-rd (%wadd fi #2)
      xu <- b2m-rd (%wadd xc #2)
      ap <- b2-App ft xt s
      bt <-! b2-body bk wB x
      us <- b2-uadd fu xu
      r <- b2-inf ap bt us #0
      ret r
    if %weq tg b2-ADT
      k <- b2m-f a #0
      xs <- b2m-f a #1
      rr <- b2m-f a #2
      ad <-! b2-badt bk a ctx def
      n <- b2m-f ad #0
      xn <- b2m-len xs
      if not (%weq xn n)
        kb <-[b2-dpl] b2-namekey k
        r <- b2-fail bk ctx (list-append kb (list-append " with " (list-append (ce-dec n) (the (List Word) (if %weq n #1 then " parameter" else " parameters"))))) a s def
        ret r
      vT <- b2m-f ad #2
      qs <- b2m-r3 qt s #0
      tc <-! b2c f #2 bk lhs vT xs qs ctx d
      xs2 <- b2m-rd tc
      us <- b2m-rd (%wadd tc #1)
      rt <-! b2-tret bk tc
      ad2 <- b2-Adt k xs2 s rr
      r <- b2-inf ad2 rt us #0
      ret r
    if %weq tg b2-EQL
      x <- b2m-f a #0
      y <- b2m-f a #1
      vT <- b2m-f a #2
      ty1 <- b2-TypQ b2-LONE s
      tc <-! b2c f #1 bk lhs vT b2-NONE ty1 ctx d
      ac <-! b2c f #1 bk lhs x b2-NONE vT ctx d
      bc <-! b2c f #1 bk lhs y b2-NONE vT ctx d
      at <- b2m-rd ac
      bt <- b2m-rd bc
      tq0 <- b2m-rd tc
      eq <- b2m-n3 b2-EQL s at bt tq0
      ty2 <- b2-TypQ b2-MANY s
      r <- b2-inf eq ty2 #0 #0
      ret r
    if %weq tg b2-ANN
      x <- b2m-f a #0
      vT <- b2m-f a #1
      ty1 <- b2-TypQ b2-LONE s
      do! b2c f #1 bk lhs vT b2-NONE ty1 ctx d
      xc <-! b2c f #1 bk lhs x qt vT ctx d
      xt <- b2m-rd xc
      xu <- b2m-rd (%wadd xc #2)
      r <- b2m-r4 xt vT xu #0
      ret r
    t1 <- b2-litifctr a b2-CTR
    t1g <- b2m-tag t1
    if %weq t1g b2-CTR
      ck <- b2m-f t1 #0
      ct <- b2-bctr bk ck
      if %weq ct #0
        r <- b2-fail bk ctx "a declared constructor" a s def
        ret r
    r <- b2-fail bk ctx "an annotated term (cannot infer)" a s def
    ret r
  -- a live Ref's descent (tm a, k b, xs c), then its Infer
  if %weq md #10
    def <- b2m-rd (%wadd lhs #2)
    s <- b2m-span a
    fl <- b2-sfile s
    k0 <- b2m-f a #0
    tld0 <- b2-tld bk k0
    tx <- b2m-f tld0 #1
    let x = the Word (if %weq b k0 then #0 else tx)
    lu <- b2m-rd (%wadd lhs #4)
    if andB (%weq b def) (not (%weq lu #1))
      lt <- b2m-rd lhs
      ua <- b2-unapply lt
      cols <- b2m-rd (%wadd ua #1)
      qs <- b2m-rd (%wadd lhs #3)
      ord <- b2-descols (toNat #4294967295) qs c cols #0
      if not (%weq ord #0)
        bnd <- b2-scope ctx
        ls <-[b2-dpl] b2-lshow lt bnd fl
        rf <- b2-Ref b s #0
        ap <-! b2-applyall (toNat #4294967295) bk rf c #0
