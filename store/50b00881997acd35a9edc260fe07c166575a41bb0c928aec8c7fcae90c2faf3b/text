hr-copy-nodes : Word → List (Word × Word) → (Word → Step W Word) → Step W Word
hr-copy-nodes m nil k = k m
hr-copy-nodes m (cons iw r) k =
  hr-adj m (hv2-fst (snd iw)) (λ q1 →
  hr-adj m (hv2-snd (snd iw)) (λ q2 →
  scmd (w-load (hr-nta m (fst iw))) (λ g →
  hr-st m (hr-na m g) (hv2-pair q1 q2) (λ m1 → hr-copy-nodes m1 r k))))
