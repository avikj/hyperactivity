b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6812 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6812 (k))) else (b2-nbytes mm_6812 ns (λ nb → let mm_6813 = b2-dpl mm_6812 nb in b2-nbytes mm_6813 k (λ kb → let mm_6814 = b2-dpl mm_6813 kb in b2-nm mm_6814 (list-append nb (cons #58 kb)) (λ r → let mm_6815 = b2-dep mm_6814 r in kq_ (h4-depl mm_6815 (r)))))))
