-- fopen's modes: the record's mode bits, how the file is first read (0 read, 1 truncated, 2 read
-- or made), or hv2-none
hio-mode : List Word → Word × Word
hio-mode md =
  let plus = hv2-has "+" md
  in if fst (hv2-pre "r" md) then (if plus then #3 else #1 , #0)
     else if fst (hv2-pre "w" md) then (if plus then #3 else #2 , #1)
     else if fst (hv2-pre "a" md) then (if plus then #7 else #6 , #2)
     else (hv2-none , #0)
