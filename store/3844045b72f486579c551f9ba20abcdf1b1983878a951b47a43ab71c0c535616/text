hopf-step : Word → Word → Word → HopfState → HopfState
hopf-step w0 dt fIn (hopf-st q p) =
  let r2 = uf-add (uf-mul16 q q) (uf-mul16 p p)
      dq = uf-add (uf-sub (uf-neg (uf-mul16 w0 p)) (uf-mul16 r2 q)) fIn
      dp = uf-sub (uf-mul16 w0 q) (uf-mul16 r2 p)
  in hopf-st (uf-add q (uf-mul16 dt dq)) (uf-add p (uf-mul16 dt dp))
