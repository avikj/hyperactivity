gn-hadamard-cand : RProg
gn-hadamard-cand =
  rprog #4
    (cons (#4 , re-add (re-v #0) (re-v #2))
    (cons (#5 , re-sub (re-v #0) (re-v #2))
    (cons (#6 , re-add (re-v #1) (re-v #3))
    (cons (#7 , re-sub (re-v #1) (re-v #3)) nil))))
    (cons (re-add (re-v #4) (re-v #6))
    (cons (re-sub (re-v #4) (re-v #6))
    (cons (re-add (re-v #5) (re-v #7))
    (cons (re-sub (re-v #5) (re-v #7)) nil))))
