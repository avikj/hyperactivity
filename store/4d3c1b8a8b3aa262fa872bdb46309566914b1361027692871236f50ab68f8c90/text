boc-lut3-w64 : Word → Word → Word → Word → Word
boc-lut3-w64 imm a0 b0 c0 =
  let a = boc-w64 a0
      b = boc-w64 b0
      c = boc-w64 c0
  in %wor (boc-minterm64 imm #0 a b c)
     (%wor (boc-minterm64 imm #1 a b c)
     (%wor (boc-minterm64 imm #2 a b c)
     (%wor (boc-minterm64 imm #3 a b c)
     (%wor (boc-minterm64 imm #4 a b c)
     (%wor (boc-minterm64 imm #5 a b c)
     (%wor (boc-minterm64 imm #6 a b c)
           (boc-minterm64 imm #7 a b c)))))))
