h4-natc : Word → Nat → Word → Word → (Word × Word → Step W Word) → Step W Word
h4-natc mm_ zero t n kq_ =
  kq_ (h4-depl mm_ ((n , t)))
h4-natc mm_ (suc f) t n kq_ =
  if (andB (%weq (h4-tag t) h4-C01) (%weq (h4-ext t) h4-SUC)) then (scmd (w-load ((h4-ha mm_ (h4-val t)))) (λ x → let mm_2798 = h4-dep mm_ x in h4-natc mm_2798 f x (%wsucc n) kq_)) else (kq_ (h4-depl mm_ ((n , t))))
