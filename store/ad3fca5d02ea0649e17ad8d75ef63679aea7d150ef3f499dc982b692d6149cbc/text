bst-bsubc : Bool → List Bool → List Bool → List Bool
bst-bsubc br a b = case a of
  nil → nil
  cons x xs → case b of
    nil → if br then bst-bpred (cons x xs) else cons x xs
    cons y ys →
      cons (bit-eq (bit-eq x y) br)
           (bst-bsubc (if x then (if y then br else false) else (if y then true else br)) xs ys)
