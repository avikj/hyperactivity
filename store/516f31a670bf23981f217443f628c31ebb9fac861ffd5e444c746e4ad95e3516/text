b2-appsg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-appsg mm_ zero t xs j n s kq_ =
  kq_ (h4-depl mm_ (t))
b2-appsg mm_ (suc f) t xs j n s kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (t))) else (let a_8113 = xs in let j_8114 = j in scmd (w-load ((b2-a mm_ (%wadd a_8113 (%wsucc j_8114))))) (λ x_8112 → let mm_8115 = b2-dep mm_ x_8112 in let x = x_8112 in b2-App mm_8115 t x s (λ g → let mm_8116 = b2-dep mm_8115 g in b2-appsg mm_8116 f g xs (%wsucc j) n s kq_)))
