-- and the balanced labelling is one of them: the bound is attained, at sums 0..24
attained : Nat → Bool
attained m = if leb (sq4 (if leb 1 (mod4 m) then suc (div4 m) else div4 m) (if leb 2 (mod4 m) then suc (div4 m) else div4 m) (if leb 3 (mod4 m) then suc (div4 m) else div4 m) (div4 m)) (bal-sq m) then (case m of zero → true; suc j → attained j) else false
