e-sq : Nat → Bool → List Word → List Word
e-sq zero p t = nil
e-sq (suc f) p nil = nil
e-sq (suc f) p (cons c r) =
  if h-not (weq (e-wsn (cons c r)) #0) then e-sq f true (e-drop-n (toNat (e-wsn (cons c r))) (cons c r))
  else if p then cons #32 (cons c (e-sq f false r)) else cons c (e-sq f false r)
