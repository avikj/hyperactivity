-- Certifies SrTiO3, BaTiO3, LaFeO3, YBa2Cu3O7 (cuprate 93K), La3Ni2O7 (bilayer nickelate 80K), & rejects MgTiO3 ilmenite!
boc-thm-periodic-suite-exact :
  andB (boc-periodic-phase-ok #6  #6  #144 #60 #140 #280 #38) -- SrTiO3
  (andB (boc-periodic-phase-ok #6  #6  #161 #60 #140 #310 #56) -- BaTiO3
  (andB (boc-periodic-phase-ok #6  #6  #136 #65 #140 #240 #57) -- LaFeO3
  (andB (boc-periodic-phase-ok #14 #14 #142 #65 #140 #190 #56) -- YBa2Cu3O7 sublattice
  (andB (boc-periodic-phase-ok #14 #14 #136 #60 #140 #165 #57) -- La3Ni2O7 bilayer rung
        (if boc-periodic-phase-ok #6 #6 #72 #60 #140 #120 #22 then false else true))))) ≡ true
boc-thm-periodic-suite-exact = refl
