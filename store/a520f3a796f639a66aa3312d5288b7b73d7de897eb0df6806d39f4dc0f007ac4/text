-- THEOREM 3: UNIVERSAL ASSOCIATIVITY OF BIDIRECTIONAL LENS COMPOSITION (EXTENSIBILITY)
fl-comp-get-assoc : {A B C D : Type} → (l1 : FluxLens A B) → (l2 : FluxLens B C) → (l3 : FluxLens C D) → (a : A) →
  fl-get (fl-comp (fl-comp l1 l2) l3) a ≡ fl-get (fl-comp l1 (fl-comp l2 l3)) a
fl-comp-get-assoc l1 l2 l3 a = refl
