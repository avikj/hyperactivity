b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10783 = xs in scmd (w-load ((b2-a mm_ a_10783))) (λ x_10782 → let mm_10784 = b2-dep mm_ x_10782 in let n = x_10782 in if (%weq j n) then (kq_ (h4-depl mm_10784 (h))) else (let a_10786 = xs in let j_10787 = j in scmd (w-load ((b2-a mm_10784 (%wadd a_10786 (%wsucc j_10787))))) (λ x_10785 → let mm_10788 = b2-dep mm_10784 x_10785 in let x = x_10785 in b2-tapp mm_10788 bk h x #0 (λ h2 → let mm_10789 = b2-dep mm_10788 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10789 b2-ERR)) else (b2-applyall mm_10789 f bk h2 xs (%wsucc j) kq_)))))
