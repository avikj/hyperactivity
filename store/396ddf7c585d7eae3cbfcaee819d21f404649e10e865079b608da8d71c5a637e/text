hxp-hex6-xor : Hex6 → Hex6 → Hex6
hxp-hex6-xor a b =
  ( hxp-bxor (fst a) (fst b)
  , ( hxp-bxor (fst (snd a)) (fst (snd b))
    , ( hxp-bxor (fst (snd (snd a))) (fst (snd (snd b)))
      , ( hxp-bxor (fst (snd (snd (snd a)))) (fst (snd (snd (snd b))))
        , ( hxp-bxor (fst (snd (snd (snd (snd a))))) (fst (snd (snd (snd (snd b)))))
          , hxp-bxor (snd (snd (snd (snd (snd a))))) (snd (snd (snd (snd (snd b))))) )))))
