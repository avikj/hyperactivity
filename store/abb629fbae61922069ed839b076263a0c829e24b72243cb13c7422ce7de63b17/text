-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_11018 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_11018))) (λ x_11017 → let mm_11019 = b2-dep mm_ x_11017 in let lb = x_11017 in if (%weq lb #0) then (let i_11021 = (%wadd tc #4) in scmd (w-load ((b2-a mm_11019 i_11021))) (λ x_11020 → let mm_11022 = b2-dep mm_11019 x_11020 in let t = x_11020 in kq_ (h4-depl mm_11022 (t)))) else (let i_11024 = (%wadd tc #3) in scmd (w-load ((b2-a mm_11019 i_11024))) (λ x_11023 → let mm_11025 = b2-dep mm_11019 x_11023 in let lx = x_11023 in b2-body mm_11025 bk lb lx (λ r → let mm_11026 = b2-dep mm_11025 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_11026 b2-ERR)) else (kq_ (h4-depl mm_11026 (r)))))))
