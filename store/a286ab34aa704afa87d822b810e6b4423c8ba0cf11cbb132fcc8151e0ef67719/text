-- src/ast.rs Numb::show (f24 is not carried)
hv2-numshow : Word → List Word
hv2-numshow n =
  let t = hv2-typ n
      v = hv2-u24 n
  in if %weq t #0 then list-append "[" (list-append (hv2-opstr v) "]")
     else if %weq t #1 then ce-dec v
     else if %weq t #2 then (if hv2-sgn v then list-append "-" (ce-dec (hv2-neg v)) else list-append "+" (ce-dec v))
     else if %weq t #3 then "[f24]"
     else list-append "[" (list-append (hv2-opstr t) (list-append "0x" (list-append (hv2-hex7 (toNat #7) v nil) "]")))
