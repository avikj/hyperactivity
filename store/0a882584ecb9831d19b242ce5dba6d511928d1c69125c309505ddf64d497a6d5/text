ue-eval-nat : (Nat → Nat) → UeExpr → Nat
ue-eval-nat env (ue-lit v)   = v
ue-eval-nat env (ue-var k)   = env k
ue-eval-nat env (ue-pls a b) = ue-add (ue-eval-nat env a) (ue-eval-nat env b)
ue-eval-nat env (ue-tim a b) = ue-mul (ue-eval-nat env a) (ue-eval-nat env b)
ue-eval-nat env (ue-d01 x)   = zero
