e-ligature : List Word → List Word
e-ligature n = if h-eq n "ae" then e-utf8 #230 else if h-eq n "AE" then e-utf8 #198 else if h-eq n "oe" then e-utf8 #339 else if h-eq n "OE" then e-utf8 #338
  else if h-eq n "eth" then e-utf8 #240 else if h-eq n "thorn" then e-utf8 #254 else if h-eq n "THORN" then e-utf8 #222 else if h-eq n "ETH" then e-utf8 #208
  else if h-eq n "aring" then e-utf8 #229 else if h-eq n "oslash" then e-utf8 #248 else if h-eq n "Oslash" then e-utf8 #216 else if h-eq n "szlig" then e-utf8 #223 else nil
