sc-c4-ring-n0 : Nat → Nat → Nat → Nat → BZ → BZ → BZ → List BZ → List QmolState
sc-c4-ring-n0 p1 p2 e1 e2 q0 q1 q2 ns = case ns of
  nil → nil
  cons n0 rest →
    (λ n1 → (λ n2 n3 →
      if both (sc-le2 n1) (both (sc-le2 n2) (sc-le2 n3))
      then cons ((e1 , e2) , cons n0 (cons n1 (cons n2 (cons n3 nil))))
                (sc-c4-ring-n0 p1 p2 e1 e2 q0 q1 q2 rest)
      else sc-c4-ring-n0 p1 p2 e1 e2 q0 q1 q2 rest)
      (bz-add n1 q2) (qmol-bz-sub n0 q0))
    (bz-add n0 q1)
