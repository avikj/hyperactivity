b2-pget : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-pget mm_ zero mp k kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-pget mm_ (suc f) mp k kq_ =
  if (%weq mp #0) then (kq_ (h4-depl mm_ (hv2-none))) else (if (%weq k #0) then (let i_291 = mp in scmd (w-load ((b2-a mm_ i_291))) (λ x_290 → let mm_292 = b2-dep mm_ x_290 in let h = x_290 in if (%weq h #0) then (kq_ (h4-depl mm_292 (hv2-none))) else (let i_294 = (%wadd mp #1) in scmd (w-load ((b2-a mm_292 i_294))) (λ x_293 → let mm_295 = b2-dep mm_292 x_293 in let v = x_293 in kq_ (h4-depl mm_295 (v)))))) else (let odd = %weq (%wmod k #2) #1 in let i_297 = (%wadd mp (the Word (if odd then #2 else #3))) in scmd (w-load ((b2-a mm_ i_297))) (λ x_296 → let mm_298 = b2-dep mm_ x_296 in let nx = x_296 in b2-pget mm_298 f nx (the Word (if odd then %wdiv (%wsub k #1) #2 else %wdiv (%wsub k #2) #2)) kq_)))
