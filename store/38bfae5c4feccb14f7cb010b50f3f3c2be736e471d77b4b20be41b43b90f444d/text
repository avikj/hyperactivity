-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10473 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10473))) (λ x_10472 → let mm_10474 = b2-dep mm_ x_10472 in let lb = x_10472 in if (%weq lb #0) then (let i_10476 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10474 i_10476))) (λ x_10475 → let mm_10477 = b2-dep mm_10474 x_10475 in let t = x_10475 in kq_ (h4-depl mm_10477 (t)))) else (let i_10479 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10474 i_10479))) (λ x_10478 → let mm_10480 = b2-dep mm_10474 x_10478 in let lx = x_10478 in b2-body mm_10480 bk lb lx (λ r → let mm_10481 = b2-dep mm_10480 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10481 b2-ERR)) else (kq_ (h4-depl mm_10481 (r)))))))
