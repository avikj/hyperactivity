b2-tipown : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tipown mm_ zero bk xs j n kq_ =
  kq_ (h4-depl mm_ (#1))
b2-tipown mm_ (suc f) bk xs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#1))) else (let a_12884 = xs in let j_12885 = j in scmd (w-load ((b2-a mm_ (%wadd a_12884 (%wsucc j_12885))))) (λ x_12883 → let mm_12886 = b2-dep mm_ x_12883 in let x = x_12883 in b2-wnf mm_12886 bk x (λ w → let mm_12887 = b2-dep mm_12886 w in if (%weq w b2-ERR) then (kq_ (h4-depl mm_12887 b2-ERR)) else (let t_12889 = w in scmd (w-load ((b2-a mm_12887 t_12889))) (λ x_12888 → let mm_12890 = b2-dep mm_12887 x_12888 in let wt = (%wand x_12888 #255) in let t_12892 = w in let j_12893 = #1 in scmd (w-load ((b2-a mm_12890 (%wadd t_12892 (%wadd #2 j_12893))))) (λ x_12891 → let mm_12894 = b2-dep mm_12890 x_12891 in let wi = x_12891 in if (orB (not (%weq wt b2-VAR)) (not (%weq wi j))) then (kq_ (h4-depl mm_12894 (#0))) else (b2-tipown mm_12894 f bk xs (%wsucc j) n kq_)))))))
