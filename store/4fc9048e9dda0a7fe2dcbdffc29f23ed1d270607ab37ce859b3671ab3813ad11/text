ue-peep-pls : UeExpr → UeExpr → UeExpr
ue-peep-pls (ue-lit zero) b = b
ue-peep-pls a (ue-lit zero) = a
ue-peep-pls (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-var k2)) =
  if ue-nat-eq k1 k2
  then ue-tim (ue-pls a1 a2) (ue-var k1)
  else ue-pls (ue-tim a1 (ue-var k1)) (ue-tim a2 (ue-var k2))
ue-peep-pls a b = ue-pls a b
