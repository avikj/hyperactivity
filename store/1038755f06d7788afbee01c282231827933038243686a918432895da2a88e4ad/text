-- Code of (x : D1) → outer (inner x) ≡ x
d-roundtrip-code : (Word → Word → Code) → Word → Lst (Lst (Word × Word)) → Lst (Lst (Word × Word)) → Lst Word → Code → Code → Code
d-roundtrip-code pf d1 sh1 sh2 perm outer inner =
  let mot = clam (cpathp (cplam (cdata d1 lnil)) (capp outer (capp inner (cvar #0))) (cvar #0))
  in clam (celim d1 mot (d-roundtrip-branches pf d1 sh1 sh2 perm #0) (cvar #0))
