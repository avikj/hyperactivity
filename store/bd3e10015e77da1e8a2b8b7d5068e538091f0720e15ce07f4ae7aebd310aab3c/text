hv2-skip : Nat → List Word → List Word
hv2-skip zero s = s
hv2-skip (suc n) nil = nil
hv2-skip (suc n) (cons c r) =
  if hv2-space c then hv2-skip n r
  else if %weq c #47 then (case r of
      nil → cons c r
      cons d r2 → if %weq d #47 then hv2-skip n (hv2-skip-line r2) else cons c r)
  else cons c r
