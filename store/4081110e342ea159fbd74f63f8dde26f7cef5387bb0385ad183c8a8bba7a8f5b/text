gn-poisson-spec : RProg
gn-poisson-spec =
  rprog #4
    (cons (#4  , re-add (re-add (re-v #0) (re-v #1)) (re-add (re-v #2) (re-v #3)))
    (cons (#5  , re-add (re-sub (re-v #0) (re-v #1)) (re-sub (re-v #2) (re-v #3)))
    (cons (#6  , re-sub (re-add (re-v #0) (re-v #1)) (re-add (re-v #2) (re-v #3)))
    (cons (#7  , re-sub (re-sub (re-v #0) (re-v #1)) (re-sub (re-v #2) (re-v #3)))
    (cons (#8  , re-add (re-add (re-v #4) (re-v #5)) (re-add (re-v #6) (re-v #7)))
    (cons (#9  , re-add (re-sub (re-v #4) (re-v #5)) (re-sub (re-v #6) (re-v #7)))
    (cons (#10 , re-sub (re-add (re-v #4) (re-v #5)) (re-add (re-v #6) (re-v #7)))
    (cons (#11 , re-sub (re-sub (re-v #4) (re-v #5)) (re-sub (re-v #6) (re-v #7)))
    (cons (#12 , re-add (re-add (re-mul (re-v #0) (re-v #0)) (re-mul (re-v #1) (re-v #1)))
                        (re-add (re-mul (re-v #2) (re-v #2)) (re-mul (re-v #3) (re-v #3))))
    (cons (#13 , re-add (re-add (re-mul (re-v #4) (re-v #4)) (re-mul (re-v #5) (re-v #5)))
                        (re-add (re-mul (re-v #6) (re-v #6)) (re-mul (re-v #7) (re-v #7)))) nil))))))))))
    (cons (re-sub (gn-dbl (re-add (re-v #0) (re-v #2))) (re-add (re-v #4) (re-v #5)))
    (cons (re-sub (re-v #13) (gn-dbl (gn-dbl (re-v #12))))
    (cons (re-sub (re-v #8)  (gn-dbl (gn-dbl (re-v #0))))
    (cons (re-sub (re-v #9)  (gn-dbl (gn-dbl (re-v #1))))
    (cons (re-sub (re-v #10) (gn-dbl (gn-dbl (re-v #2))))
    (cons (re-sub (re-v #11) (gn-dbl (gn-dbl (re-v #3)))) nil))))))
