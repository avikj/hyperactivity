b2-vpushl : Word → Nat → Word → List Word → (Word → Step W Word) → Step W Word
b2-vpushl mm_ zero v bs kq_ =
  kq_ (h4-depl mm_ (v))
b2-vpushl mm_ (suc f) v bs kq_ =
  if (h4-isnil bs) then (kq_ (h4-depl mm_ (v))) else (b2-vpush mm_ v (hv2-nth #0 bs) (λ dd_15244 → let mm_15245 = b2-dep mm_ dd_15244 in b2-vpushl mm_15245 f v (hv2-drop1 bs) kq_))
