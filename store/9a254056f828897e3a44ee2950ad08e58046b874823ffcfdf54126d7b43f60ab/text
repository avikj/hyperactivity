b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6295 = b2-dep mm_ c in let p_6297 = p in let i_6299 = (%wadd p_6297 #1) in scmd (w-load ((b2-a mm_6295 i_6299))) (λ x_6298 → let mm_6300 = b2-dep mm_6295 x_6298 in let x_6296 = x_6298 in let i = x_6296 in let p_6301 = p in let v_6302 = (%wsucc i) in let i_6303 = (%wadd p_6301 #1) in let v_6304 = v_6302 in scmd (w-store ((b2-a mm_6300 i_6303)) (v_6304)) (λ uu_6305 → let mm_6306 = hv2-u mm_6300 uu_6305 in kq_ (h4-depl mm_6306 (c)))))
