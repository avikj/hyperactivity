-- so it is 0 exactly when b (t − c G₀ Y₀) = c G₀ P₀ − t Y₀. Variables t, c, G₀, Y₀, P₀, b.
dz-b : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
dz-b A ad mu q vs = (λ g sub → (sub (ad (mu (g 0) (g 3)) (mu (g 0) (g 5))) (mu (mu (g 1) (g 2)) (ad (g 4) (mu (g 5) (g 3)))) , sub (mu (g 5) (sub (g 0) (mu (mu (g 1) (g 2)) (g 3)))) (sub (mu (mu (g 1) (g 2)) (g 4)) (mu (g 0) (g 3))))) (λ i → al-nth A (q (fn-q 0 1)) i vs) (al-gsub A ad mu q)
