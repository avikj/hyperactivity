hx-main : List (List Word) → Step W Word
hx-main args =
  let c = hx-cmd args
      r = hx-rest args
  in if cli-eq c "discover" then hd-main r
     else if cli-eq c "loop" then hxl-main r
     else if cli-eq c "hf" then hhf-main r
     else if cli-eq c "zip" then hxz-main (cons "c" r)
     else if cli-eq c "unzip" then hxz-main (cons "d" r)
     else if cli-eq c "cm" then hcm-main r
     else if cli-eq c "tensor" then hxt-main r
     else if cli-eq c "gpu" then hg-main r
     else if cli-eq c "llmzip" then hlz-main r
     else if cli-eq c "book" then hxb-main r
     else if cli-eq c "node" then hxn-main r
     else if cli-eq c "tapeout" then hxtp-main r
     else if cli-eq c "alu" then cir-main r
     else if cli-eq c "merge" then hm-main r
     else if cli-eq c "httpd" then hh-main r
     else if cli-eq c "synth" then hs-main r
     else hx-usage
