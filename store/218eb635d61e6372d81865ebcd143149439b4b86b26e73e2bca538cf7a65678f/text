hxp-tonnetz-step : Word → Word → Word
hxp-tonnetz-step t op =
  let r = %wdiv t #2
      m = %wand t #1
  in if %weq op #0 then %wadd (%wmul (hxp-mod12 r) #2) (%wxor m #1)
     else if %weq op #1 then
       let r2 = if %weq m #0 then %wadd r #4 else %wadd r #8
       in %wadd (%wmul (hxp-mod12 r2) #2) (%wxor m #1)
     else
       let r3 = if %weq m #0 then %wadd r #9 else %wadd r #3
       in %wadd (%wmul (hxp-mod12 r3) #2) (%wxor m #1)
