emg-tau12-li : EmgLiState → EmgLiState × Bool
emg-tau12-li s =
  (λ v1 v2 vd nf →
    if leb v1 v2 then (((v1 , (v2 , vd)) , nf) , true)
    else (((v2 , (v1 , vd)) , nf) , false))
  (emg-tau12-v (fst (fst s)))
  (emg-tau12-v (fst (snd (fst s))))
  (emg-tau12-v (snd (snd (fst s))))
  (emg-tau12-flux (snd s))
