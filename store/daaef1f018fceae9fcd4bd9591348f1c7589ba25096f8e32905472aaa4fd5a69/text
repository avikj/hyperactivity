ga-eval : (Nat → Bool) → GaGuard → Bool
ga-eval env (ga-k b)       = b
ga-eval env (ga-v x)       = env x
ga-eval env (ga-not a)     = ga-notB (ga-eval env a)
ga-eval env (ga-and a b)   = ga-andB (ga-eval env a) (ga-eval env b)
ga-eval env (ga-ite c t f) = ga-iteB (ga-eval env c) (ga-eval env t) (ga-eval env f)
