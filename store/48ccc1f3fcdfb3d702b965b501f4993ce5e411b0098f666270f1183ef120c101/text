hr-anni : Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
hr-anni fu m a b k =
  scmd (w-load (hr-na m (hv2-val a))) (λ wa →
  scmd (w-load (hr-na m (hv2-val b))) (λ wb →
  hr-free-node m (hv2-val a) (λ m0 →
  hr-free-node m0 (hv2-val b) (λ m1 →
  hr-ln fu m1 (hv2-fst wa) (hv2-fst wb) (λ m2 → hr-ln fu m2 (hv2-snd wa) (hv2-snd wb) k)))))
