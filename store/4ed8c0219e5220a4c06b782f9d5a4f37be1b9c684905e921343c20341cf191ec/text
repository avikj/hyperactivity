-- strip: a forced Var steps into its value, an Ann into its term
b2-stripg : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-stripg mm_ zero t kq_ =
  kq_ (h4-depl mm_ (t))
b2-stripg mm_ (suc f) t kq_ =
  if (%weq t #0) then (kq_ (h4-depl mm_ (t))) else (let t_649 = t in scmd (w-load ((b2-a mm_ t_649))) (λ x_648 → let mm_650 = b2-dep mm_ x_648 in let tg = (%wand x_648 #255) in if (%weq tg b2-VAR) then (let t_652 = t in let j_653 = #2 in scmd (w-load ((b2-a mm_650 (%wadd t_652 (%wadd #2 j_653))))) (λ x_651 → let mm_654 = b2-dep mm_650 x_651 in let v = x_651 in if (%weq v #0) then (kq_ (h4-depl mm_654 (t))) else (b2-stripg mm_654 f v kq_))) else (if (%weq tg b2-ANN) then (let t_656 = t in let j_657 = #0 in scmd (w-load ((b2-a mm_650 (%wadd t_656 (%wadd #2 j_657))))) (λ x_655 → let mm_658 = b2-dep mm_650 x_655 in let x = x_655 in b2-stripg mm_658 f x kq_)) else (kq_ (h4-depl mm_650 (t))))))
