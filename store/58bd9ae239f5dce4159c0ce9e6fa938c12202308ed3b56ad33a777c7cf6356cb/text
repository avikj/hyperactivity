qgm-edge-div-add : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → QgmAb A z add neg →
  (x u w : Nat) → (f g : A) →
  qgm-edge-div A z add neg x u w (add f g) ≡ add (qgm-edge-div A z add neg x u w f) (qgm-edge-div A z add neg x u w g)
qgm-edge-div-add A z add neg ab x u w f g = concat
  (λ i → add (qgm-if-add A z add neg ab (eqb x u) f g i) (qgm-if-neg-add A z add neg ab (eqb x w) f g i))
  (qgm-swap4 A z add neg ab (if eqb x u then f else z) (if eqb x u then g else z)
                             (if eqb x w then neg f else z) (if eqb x w then neg g else z))
