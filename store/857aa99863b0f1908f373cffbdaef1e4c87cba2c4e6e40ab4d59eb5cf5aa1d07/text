ge-lem-mk-ite : (env : Nat → Bool) → (c t f : GuardExpr) → ge-eval env (ge-mk-ite c t f) ≡ bfm-iteB (ge-eval env c) (ge-eval env t) (ge-eval env f)
ge-lem-mk-ite env (ge-k true)  t f = refl
ge-lem-mk-ite env (ge-k false) t f = refl
ge-lem-mk-ite env (ge-v i)     t f = ge-lem-ite-guard env (ge-v i) t f
ge-lem-mk-ite env (ge-not a)   t f = ge-lem-ite-guard env (ge-not a) t f
ge-lem-mk-ite env (ge-and a b) t f = ge-lem-ite-guard env (ge-and a b) t f
ge-lem-mk-ite env (ge-ite c1 t1 f1) t f = ge-lem-ite-guard env (ge-ite c1 t1 f1) t f
