hxp-hex6-xor-zero : (h : Hex6) → hxp-hex6-xor h hxp-hex6-zero ≡ h
hxp-hex6-xor-zero h =
  λ i →
    ( hxp-bxor-zero (fst h) i
    , ( hxp-bxor-zero (fst (snd h)) i
      , ( hxp-bxor-zero (fst (snd (snd h))) i
        , ( hxp-bxor-zero (fst (snd (snd (snd h)))) i
          , ( hxp-bxor-zero (fst (snd (snd (snd (snd h))))) i
            , hxp-bxor-zero (snd (snd (snd (snd (snd h))))) i )))))
