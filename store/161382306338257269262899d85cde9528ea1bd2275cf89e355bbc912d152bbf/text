-- Section (4): Exact 4-simplex (K_5) 15j symbol of the first kind and Euclidean EPRL 4-simplex vertex amplitude.
-- A 4-simplex boundary K_5 has 10 faces (j12,j13,j14,j15, j23,j24,j25, j34,j35, j45) and 5 tetrahedra (i1..i5):
--   N1: (j12, j13 | i1 | j14, j15)   N2: (j12, j25 | i2 | j23, j24)   N3: (j13, j23 | i3 | j34, j35)
--   N4: (j24, j34 | i4 | j14, j45)   N5: (j35, j45 | i5 | j15, j25)
-- Cyclic 5-cycle parameters: (a0,b0,c0)=(i1,j25,j12), (a1,b1,c1)=(j13,i2,j23), (a2,b2,c2)=(i3,j24,j34),
--                            (a3,b3,c3)=(j35,i4,j45), (a4,b4,c4)=(i5,j14,j15).
-- Yutsis phase (-1)^(1 + (i1 + i3 + i5)/2) matches direct SU(2) tensor contraction across all 32 intertwiner states.
sf-15j-term : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-15j-term a0 b0 c0 a1 b1 c1 a2 b2 c2 a3 b3 c3 a4 b4 c4 x =
  bq-mul
    (bq-mul (sf-bq-of-nat (suc x))
            (bq-mul (bq-mul (sf-delta2 a0 b0 x) (sf-delta2 a1 b1 x))
                    (bq-mul (sf-delta2 a2 b2 x) (bq-mul (sf-delta2 a3 b3 x) (sf-delta2 a4 b4 x)))))
    (bq-mul (bq-mul (sf-racah-W a0 b0 x b1 a1 c0) (sf-racah-W a1 b1 x b2 a2 c1))
            (bq-mul (sf-racah-W a2 b2 x b3 a3 c2)
                    (bq-mul (sf-racah-W a3 b3 x b4 a4 c3) (sf-racah-W a4 b4 x a0 b0 c4))))
