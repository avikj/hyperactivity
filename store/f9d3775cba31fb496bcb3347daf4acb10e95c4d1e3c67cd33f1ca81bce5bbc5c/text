b2-mgetp : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-mgetp mm_ zero mp k kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-mgetp mm_ (suc f) mp k kq_ =
  if (%weq mp #0) then (kq_ (h4-depl mm_ (hv2-none))) else (b2-mget1 mm_ mp k (λ v → let mm_153 = b2-dep mm_ v in if (not (%weq v hv2-none)) then (kq_ (h4-depl mm_153 (v))) else (let i_155 = (%wadd mp #2) in scmd (w-load ((b2-a mm_153 i_155))) (λ x_154 → let mm_156 = b2-dep mm_153 x_154 in let p = x_154 in b2-mgetp mm_156 f p k kq_))))
