-- Kirchhoff's law at u, u − 1, … , 0 for 280 units of current in at a: lines × φ_u = Σ φ over the other ends + 280 at a
hp-law : Nat → Nat → List Nat → Bool
hp-law u a phi = if eqb (times (fst (hp-at u cage-walled phi)) (np-nth u phi)) (plus (snd (hp-at u cage-walled phi)) (if eqb u a then 280 else zero))
  then (case u of
    zero → true
    suc g → hp-law g a phi)
  else false
