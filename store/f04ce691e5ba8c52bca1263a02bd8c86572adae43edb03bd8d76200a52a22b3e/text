-- Canonical nameless constructor-permutation-invariant signature of `(decl data NAME (params ...) (c C0 ...) ...)`
hy-decl-sig : List Word → List Word
hy-decl-sig dtxt =
  let body = h-after " " (h-drop "(decl data " (h-before (cons #10 nil) dtxt))
      pars = hy-strip-bname (h-before " (c " body)
      raws = if h-infix " (c " body then hy-split-ctors-at nil (list-append " (c " (h-after " (c " body)) else nil
      ctrs = h-msort (list-map hy-anon-ctor raws)
  in list-append pars (cons #124 (hy-sep "|" ctrs))
