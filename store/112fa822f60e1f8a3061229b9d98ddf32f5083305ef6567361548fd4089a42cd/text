b2-runapp : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-runapp mm_ zero sp base n run kq_ =
  kq_ (h4-depl mm_ (run))
b2-runapp mm_ (suc f) sp base n run kq_ =
  if (orB (not (%wlt run n)) (not (%wlt (%wadd base run) sp))) then (kq_ (h4-depl mm_ (run))) else (scmd (w-load ((b2-sa mm_ (%wsub (%wsub sp #1) run)))) (λ fr → let mm_2380 = b2-dep mm_ fr in let i_2382 = fr in scmd (w-load ((b2-a mm_2380 i_2382))) (λ x_2381 → let mm_2383 = b2-dep mm_2380 x_2381 in let kd = x_2381 in if (not (%weq kd #1)) then (kq_ (h4-depl mm_2383 (run))) else (b2-runapp mm_2383 f sp base n (%wsucc run) kq_))))
