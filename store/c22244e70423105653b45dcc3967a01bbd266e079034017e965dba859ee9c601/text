-- a name read (src/hvm.c parse_name): (state, ok, id)
h4-name : H4S → Bool × (H4S × Word)
h4-name s0 =
  let s = h4-skip s0
  in if not (h4-isinit (h4-peek s)) then (false , (s , #0))
     else (let t = h4-namechars (h4s-src s)
               r = h4-tfind (h4s-tab s) (fst t)
           in (true , (h4-skip (h4s-wtab (h4s-wsrc s (snd t)) (fst r)) , snd r)))
