-- Exhaustive check over all 2^4 = 16 static boolean assignments [b0, b1, b2, b3]:
rxn-bvec-eq : List Bool → List Bool → Bool
rxn-bvec-eq a b = case a of
  nil → (case b of nil → true; cons _ _ → false)
  cons xa ar → case b of
    nil → false
    cons xb br → both (bit-eq xa xb) (rxn-bvec-eq ar br)
