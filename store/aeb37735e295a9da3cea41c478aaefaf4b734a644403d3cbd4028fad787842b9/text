-- A at r to B at r, and at r with each one of its three bits turned
np-lines : Nat → Nat → List FaradayLine
np-lines k r = case k of
  zero → nil
  suc g → cons (r , plus 8 r)
    (cons (r , plus 8 (np-nth r (cons 1 (cons 0 (cons 3 (cons 2 (cons 5 (cons 4 (cons 7 (cons 6 nil))))))))))
    (cons (r , plus 8 (np-nth r (cons 2 (cons 3 (cons 0 (cons 1 (cons 6 (cons 7 (cons 4 (cons 5 nil))))))))))
    (cons (r , plus 8 (np-nth r (cons 4 (cons 5 (cons 6 (cons 7 (cons 0 (cons 1 (cons 2 (cons 3 nil))))))))))
    (np-lines g (suc r)))))
