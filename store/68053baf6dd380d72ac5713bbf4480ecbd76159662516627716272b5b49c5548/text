-- Pointwise congruence of finite sums.
qt-sum-cong : (S A : Type) → (z : A) → (add : A → A → A) → (f g : S → A) →
  ((s : S) → f s ≡ g s) → (xs : List S) → qt-sum S A z add f xs ≡ qt-sum S A z add g xs
qt-sum-cong S A z add f g h xs = case xs return λ l → qt-sum S A z add f l ≡ qt-sum S A z add g l of
  nil → refl
  cons x rest → λ i → add (h x i) (rec rest i)
