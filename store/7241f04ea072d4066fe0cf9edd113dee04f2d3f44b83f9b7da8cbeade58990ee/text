b2-log2g : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-log2g mm_ zero n k kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-log2g mm_ (suc f) n k kq_ =
  if (%weq n #1) then (kq_ (h4-depl mm_ (k))) else (if (orB (%weq n #0) (%weq (%wand n #1) #1)) then (kq_ (h4-depl mm_ (hv2-none))) else (b2-log2g mm_ f (%wshr n #1) (%wsucc k) kq_))
