-- Universal O(N) Pigeonhole Theorem on Boolean Assignment Vectors:
-- If w1 and w2 disagree (rxn-bvec-eq w1 w2 == false), NO vector c : List Bool satisfies both c == w1 and c == w2!
taut-bool-false-neq-true : false ≡ true → Empty
taut-bool-false-neq-true p = transport (λ i → if p i then Empty else Unit) unit
