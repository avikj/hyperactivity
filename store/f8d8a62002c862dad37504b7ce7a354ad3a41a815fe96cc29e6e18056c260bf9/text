-- Kernel-checked refl certificate: even at HUGE step dt = 1.0 (#65536) where explicit Euler
-- blows up, implicit-midpoint Thiele-Small strictly dissipates energy bit-for-bit!
ts-midpoint-large-dt-cert :
  let s0 = ts-st #10000 #4000
      s1 = ts-midpoint-step #16384 #16384 #32768 #65536 s0
  in %wlt (ts-energy s1) (ts-energy s0) ≡ true
ts-midpoint-large-dt-cert = refl
