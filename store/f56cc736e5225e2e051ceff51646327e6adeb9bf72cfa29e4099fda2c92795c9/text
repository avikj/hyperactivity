gir-fmt-swarm-state : List Word
gir-fmt-swarm-state =
  gir-jobj
    (list-append
      (gir-l8
        (gir-jfs "id" "agent_cryptic_geodesic_000fe7ce")
        (gir-jfs "kind" "agent_coord")
        (gir-jfs "kg_slice" "cryptic_geodesic_inference_beast")
        (gir-jfs "status" "unleashed_cryptic_gauge_active")
        (gir-jf  "wave" "%u")
        (gir-jf  "shard" "%u")
        (gir-jf  "num_shards" "%u")
        (gir-jfs "gauge_commit" "0x%016llx"))
      (gir-l6
        (gir-jf "cryptic_verified" "%llu")
        (gir-jf "cryptic_errors" "%llu")
        (gir-jf "rss_kib" "%llu")
        (gir-jf "min_gates_PAR6" "%u")
        (gir-jf "min_gates_SHA_CM" "%u")
        (gir-jf "min_gates_CHI6" "%u")))
