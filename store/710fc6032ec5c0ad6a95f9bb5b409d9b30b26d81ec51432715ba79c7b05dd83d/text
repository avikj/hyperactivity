ief-dec-form : List Word → Word → List Word
ief-dec-form ds kp =
  let n = cli-len ds
  in if %wlt kp #4097 then list-append "0." (list-append (ief-zeros (toNat (%wsub #4096 kp))) ds)
     else if %wlt (%wsub kp #4096) n
     then list-append (ief-take (toNat (%wsub kp #4096)) ds) (cons #46 (ief-dropn (toNat (%wsub kp #4096)) ds))
     else list-append ds (list-append (ief-zeros (toNat (%wsub (%wsub kp #4096) n))) ".0")
