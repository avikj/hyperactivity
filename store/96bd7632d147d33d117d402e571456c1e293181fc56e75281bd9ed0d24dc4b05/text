b2-atg : Word → Nat → Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-atg mm_ zero s i w kq_ =
  kq_ (h4-depl mm_ (#1))
b2-atg mm_ (suc f) s i w kq_ =
  if (h4-isnil w) then (kq_ (h4-depl mm_ (#1))) else (b2-uat mm_ s i (λ c → let mm_6636 = b2-dep mm_ c in if (not (%weq c (hv2-nth #0 w))) then (kq_ (h4-depl mm_6636 (#0))) else (b2-atg mm_6636 f s (%wsucc i) (hv2-drop1 w) kq_)))
