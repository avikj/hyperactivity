e-web-lines : List (List (List Word)) → List (List Word)
e-web-lines nil = nil
e-web-lines (cons s r) = cons (list-append "    (" (list-append (e-nth zero s) (list-append ") " (e-take-chars (toNat #240) (e-nth (toNat #2) s)))))
  (cons (list-append "    [" (list-append (e-nth (toNat #1) s) "]  (Webster 1913)")) (e-web-lines r))
