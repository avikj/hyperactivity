b2-classg : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-classg mm_ zero t kq_ =
  kq_ (h4-depl mm_ (t))
b2-classg mm_ (suc f) t kq_ =
  let t_1993 = t in let j_1994 = #3 in scmd (w-load ((b2-a mm_ (%wadd t_1993 (%wadd #2 j_1994))))) (λ x_1992 → let mm_1995 = b2-dep mm_ x_1992 in let c = x_1992 in if (%weq c #0) then (kq_ (h4-depl mm_1995 (t))) else (let t_1997 = c in let j_1998 = #3 in scmd (w-load ((b2-a mm_1995 (%wadd t_1997 (%wadd #2 j_1998))))) (λ x_1996 → let mm_1999 = b2-dep mm_1995 x_1996 in let cc = x_1996 in let c2 = the Word (if %weq cc #0 then c else cc) in let t_2000 = t in let j_2001 = #3 in let v_2002 = c2 in scmd (w-store ((b2-a mm_1999 (%wadd t_2000 (%wadd #2 j_2001)))) (v_2002)) (λ uu_2003 → let mm_2004 = hv2-u mm_1999 uu_2003 in b2-classg mm_2004 f c2 kq_))))
