hxp-chk-tonnetz-24 : Nat → Word → Bool
hxp-chk-tonnetz-24 zero t    = true
hxp-chk-tonnetz-24 (suc k) t =
  hxp-and (%weq (hxp-tonnetz-step (hxp-tonnetz-step t #0) #0) t)
  (hxp-and (%weq (hxp-tonnetz-step (hxp-tonnetz-step t #1) #1) t)
  (hxp-and (%weq (hxp-tonnetz-step (hxp-tonnetz-step t #2) #2) t)
           (hxp-chk-tonnetz-24 k (%wadd t #1))))
