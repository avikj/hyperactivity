-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10058 = s in let j_10059 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_10058 (%wadd #2 j_10059))))) (λ x_10057 → let mm_10060 = b2-dep mm_ x_10057 in let fl = x_10057 in kq_ (h4-depl mm_10060 (fl))))
