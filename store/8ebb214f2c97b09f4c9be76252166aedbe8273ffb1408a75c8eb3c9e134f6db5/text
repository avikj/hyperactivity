b2-appsg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-appsg mm_ zero t xs j n s kq_ =
  kq_ (h4-depl mm_ (t))
b2-appsg mm_ (suc f) t xs j n s kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (t))) else (let a_7251 = xs in let j_7252 = j in scmd (w-load ((b2-a mm_ (%wadd a_7251 (%wsucc j_7252))))) (λ x_7250 → let mm_7253 = b2-dep mm_ x_7250 in let x = x_7250 in b2-App mm_7253 t x s (λ g → let mm_7254 = b2-dep mm_7253 g in b2-appsg mm_7254 f g xs (%wsucc j) n s kq_)))
