h4-ctr : Word → Word → List Word → (Word → Step W Word) → Step W Word
h4-ctr m nam xs k =
  let n = cli-len xs in if (%weq n #0) then (k (h4-depl m ((h4-new h4-C00 nam #0)))) else (h4-alloc m n (λ at → let m31 = h4-dep m at in h4-wrs m31 (toNat #17) at xs (λ e → let m32 = h4-dep m31 e in k (h4-depl m32 ((h4-new (%wadd h4-C00 n) nam (h4-depl e at)))))))
