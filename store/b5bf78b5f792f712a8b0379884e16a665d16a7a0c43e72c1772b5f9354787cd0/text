-- the shown names k1 .. kn of a Let, each after its quantity
b2-letks : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-letks mm_ zero ks qs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-letks mm_ (suc f) ks qs j acc kq_ =
  let a_1356 = ks in scmd (w-load ((b2-a mm_ a_1356))) (λ x_1355 → let mm_1357 = b2-dep mm_ x_1355 in let n = x_1355 in if (%weq j n) then (kq_ (h4-depl mm_1357 (acc))) else (let a_1359 = ks in let j_1360 = j in scmd (w-load ((b2-a mm_1357 (%wadd a_1359 (%wsucc j_1360))))) (λ x_1358 → let mm_1361 = b2-dep mm_1357 x_1358 in let k = x_1358 in let a_1363 = qs in let j_1364 = j in scmd (w-load ((b2-a mm_1361 (%wadd a_1363 (%wsucc j_1364))))) (λ x_1362 → let mm_1365 = b2-dep mm_1361 x_1362 in let q = x_1362 in b2-nbytes mm_1365 k (λ kb → let mm_1366 = b2-dpl mm_1365 kb in let one = list-append (b2-qshow q) kb in b2-letks mm_1366 f ks qs (%wsucc j) (the (List Word) (if %weq j #0 then one else list-append acc (cons #32 one))) kq_)))))
