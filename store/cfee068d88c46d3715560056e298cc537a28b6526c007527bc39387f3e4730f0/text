-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_11076 = tld in scmd (w-load ((b2-a mm_ t_11076))) (λ x_11075 → let mm_11077 = b2-dep mm_ x_11075 in let tg = (%wand x_11075 #255) in if (%weq tg b2-TADT) then (let t_11079 = tld in let j_11080 = #4 in scmd (w-load ((b2-a mm_11077 (%wadd t_11079 (%wadd #2 j_11080))))) (λ x_11078 → let mm_11081 = b2-dep mm_11077 x_11078 in let b = x_11078 in kq_ (h4-depl mm_11081 (b)))) else (let t_11083 = tld in let j_11084 = #5 in scmd (w-load ((b2-a mm_11077 (%wadd t_11083 (%wadd #2 j_11084))))) (λ x_11082 → let mm_11085 = b2-dep mm_11077 x_11082 in let b = x_11082 in kq_ (h4-depl mm_11085 (b))))))
