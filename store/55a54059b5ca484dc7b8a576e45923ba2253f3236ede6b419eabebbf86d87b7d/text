b2-iorun : Word → Nat → Word → Word → List (List Word) → (Word → Step W Word) → Step W Word
b2-iorun mm_ zero bk t argv kq_ =
  kq_ (h4-depl mm_ (#1))
b2-iorun mm_ (suc f) bk t argv kq_ =
  b2-iostep mm_ bk t argv (λ x → let mm_14299 = b2-dep mm_ x in if (%weq x b2-ERR) then (kq_ (h4-depl mm_14299 b2-ERR)) else (scmd (w-load ((b2-HR mm_14299 #7))) (λ kd → let mm_14300 = b2-dep mm_14299 kd in scmd (w-load ((b2-HR mm_14300 #8))) (λ v → let mm_14301 = b2-dep mm_14300 v in if (%weq kd #1) then (kq_ (h4-depl mm_14301 (v))) else (b2-iorun mm_14301 f bk v argv kq_)))))
