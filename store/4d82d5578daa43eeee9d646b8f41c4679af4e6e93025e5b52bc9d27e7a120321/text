gir-c8 : List Word → List Word
gir-c8 tl =
  gir-lines
    (list-append
      (gir-l8
        "int main(int argc, char** argv) {"
        "  signal(SIGINT, on_sig); signal(SIGTERM, on_sig);"
        "  int max_waves = 0; uint32_t shard_id = 0u, num_shards = 1u;"
        (gir-s3 "  const char* log_path = " (gir-qq "/tmp/hy_out/beast_geodesic_live.jsonl") ";")
        (gir-s3 "  const char* bus_path = " (gir-qq "/tmp/hx_agent_bus/sovereign_wire.jsonl") ";")
        "  for (int i = 1; i < argc; i++) {"
        (gir-s3 "    if (!strcmp(argv[i], " (gir-qq "--max-waves") ") && i + 1 < argc) max_waves = atoi(argv[++i]);")
        (gir-s3 "    else if (!strcmp(argv[i], " (gir-qq "--log") ") && i + 1 < argc) log_path = argv[++i];"))
      (gir-l8
        (gir-s3 "    else if (!strcmp(argv[i], " (gir-qq "--shard") ") && i + 1 < argc) shard_id = (uint32_t)atoi(argv[++i]);")
        (gir-s3 "    else if (!strcmp(argv[i], " (gir-qq "--shards") ") && i + 1 < argc) num_shards = (uint32_t)atoi(argv[++i]);")
        "  }"
        "  init_cryptic_gauge();"
        (gir-s3 "  FILE* jlog = fopen(log_path, " (gir-qq "a") "); if (!jlog) jlog = stdout;")
        (gir-s3 "  FILE* busf = fopen(bus_path, " (gir-qq "a") ");")
        "  build_exact_npn_quotient();"
        "  if (g_npn3_classes != 14u || g_npn4_classes != 222u) return 2;"))
    (gir-lines
      (gir-l4
        "  run_wave01_and_extract_fibers(jlog);"
        "  run_geodesic_unleashed(jlog, busf, max_waves, shard_id, num_shards);"
        "  if (busf) fclose(busf); if (jlog != stdout) fclose(jlog);"
        "  return (g_cryptic_errors == 0ull) ? 0 : 3; }")
      tl)
