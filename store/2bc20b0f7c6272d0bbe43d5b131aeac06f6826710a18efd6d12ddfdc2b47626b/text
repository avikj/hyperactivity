-- THEOREM 1B (`gamma = 1/9 -> alpha* = 90%` MAXIMIZES ROUTER CASHFLOW + ZERO-DUST CONSERVATION):
ue-thm-agent-x402-90pct-dominates-50pct :
  let s90  = ue-settle-split #1 #9 #1000000 #50000 #0
      s50  = ue-settle-split #1 #1 #1000000 #50000 #0
      cf90 = %wdiv (%wmul (fst (snd s90)) #95) #100
      cf50 = %wdiv (%wmul (fst (snd s50)) #99) #100
  in andB (%wlt cf50 cf90)
     (andB (%weq (%wadd (fst s90) (%wadd (fst (snd s90)) (snd (snd s90)))) #1000000)
           (%wlt #0 (snd (snd s90)))) ≡ true
ue-thm-agent-x402-90pct-dominates-50pct = refl
