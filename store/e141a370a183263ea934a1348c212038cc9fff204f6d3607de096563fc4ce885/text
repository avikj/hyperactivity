b2-arr : Word → Word → (Word → Step W Word) → Step W Word
b2-arr mm_ n kq_ =
  let n_18 = (%wsucc n) in scmd (w-load (mm_)) (λ at_17 → let mm_19 = b2-dep mm_ at_17 in scmd (w-store (mm_19) ((%wadd at_17 n_18))) (λ uu_20 → let mm_21 = hv2-u mm_19 uu_20 in let at = at_17 in let i_22 = at in let v_23 = n in scmd (w-store ((b2-a mm_21 i_22)) (v_23)) (λ uu_24 → let mm_25 = hv2-u mm_21 uu_24 in kq_ (h4-depl mm_25 (at)))))
