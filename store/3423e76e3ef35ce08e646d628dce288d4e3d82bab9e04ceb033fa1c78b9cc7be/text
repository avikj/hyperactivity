-- (C) Mutual information ratio:
--   * Perfectly correlated 2-bit observers (Adlam-Rovelli cross-perspective link: P_XY = [1,0,0,1], P_X = P_Y = [1,1]):
--     R_MI = (1/2) / (1/4) = 2 (1 full bit of mutual information!).
--   * Independent 2-bit observers (P_XY = [1,1,1,1], P_X = P_Y = [2,2]):
--     R_MI = (1/4) / (1/4) = 1 (0 bits of mutual information!).
qi-mi-correlated : qi-mi-ratio
  (cons bin-one (cons nil (cons nil (cons bin-one nil))))
  (cons bin-one (cons bin-one nil))
  (cons bin-one (cons bin-one nil)) ≡ bq-make true bin-two bin-one
qi-mi-correlated = refl
