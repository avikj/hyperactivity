  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_2989 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_2989 #7))) (λ kd → let mm_2990 = b2-dep mm_2989 kd in scmd (w-load ((b2-HR mm_2990 #8))) (λ v → let mm_2991 = b2-dep mm_2990 v in if (%weq kd #0) then (kq_ (h4-depl mm_2991 (v))) else (scmd (w-load ((b2-HR mm_2991 #11))) (λ md2 → let mm_2992 = b2-dep mm_2991 md2 in scmd (w-load ((b2-HR mm_2992 #12))) (λ a2 → let mm_2993 = b2-dep mm_2992 a2 in scmd (w-load ((b2-HR mm_2993 #13))) (λ b2 → let mm_2994 = b2-dep mm_2993 b2 in scmd (w-load ((b2-HR mm_2994 #14))) (λ c2 → let mm_2995 = b2-dep mm_2994 c2 in b2-wnfrun mm_2995 f rx bk md2 a2 b2 c2 kq_))))))))
