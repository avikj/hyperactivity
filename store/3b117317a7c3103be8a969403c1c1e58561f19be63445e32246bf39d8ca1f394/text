b2-tipown : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tipown mm_ zero bk xs j n kq_ =
  kq_ (h4-depl mm_ (#1))
b2-tipown mm_ (suc f) bk xs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#1))) else (let a_13050 = xs in let j_13051 = j in scmd (w-load ((b2-a mm_ (%wadd a_13050 (%wsucc j_13051))))) (λ x_13049 → let mm_13052 = b2-dep mm_ x_13049 in let x = x_13049 in b2-wnf mm_13052 bk x (λ w → let mm_13053 = b2-dep mm_13052 w in if (%weq w b2-ERR) then (kq_ (h4-depl mm_13053 b2-ERR)) else (let t_13055 = w in scmd (w-load ((b2-a mm_13053 t_13055))) (λ x_13054 → let mm_13056 = b2-dep mm_13053 x_13054 in let wt = (%wand x_13054 #255) in let t_13058 = w in let j_13059 = #1 in scmd (w-load ((b2-a mm_13056 (%wadd t_13058 (%wadd #2 j_13059))))) (λ x_13057 → let mm_13060 = b2-dep mm_13056 x_13057 in let wi = x_13057 in if (orB (not (%weq wt b2-VAR)) (not (%weq wi j))) then (kq_ (h4-depl mm_13060 (#0))) else (b2-tipown mm_13060 f bk xs (%wsucc j) n kq_)))))))
