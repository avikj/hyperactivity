qv-j23-sq : Nat → Nat → Nat → Nat → Nat → Nat → BQ
qv-j23-sq J1 J2 J3 J4 K Kp =
  (λ s → bq-mul
    (bq-mul (sf-bq-of-nat (times (suc K) (suc Kp)))
            (bq-mul (bq-mul (sf-delta2 J1 J2 K) (sf-delta2 J3 J4 K))
                    (bq-mul (sf-delta2 J1 J2 Kp) (sf-delta2 J3 J4 Kp))))
    (bq-mul s s))
    (qv-j23-loop (suc (nat-min (plus J2 J3) (plus J1 J4))) J1 J2 J3 J4 K Kp bq-zero)
