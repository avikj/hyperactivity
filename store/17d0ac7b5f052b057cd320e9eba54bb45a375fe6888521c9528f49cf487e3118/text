-- [\w\s-]{0,40}\b(form|…) of: up to 40 such characters, then a kind at a word's start
e-formof-n : Nat → Bool → List Word → Bool
e-formof-n zero pw t = andB (h-not pw) (e-kind-of e-kinds t)
e-formof-n (suc n) pw nil = false
e-formof-n (suc n) pw (cons c r) = orB (andB (h-not pw) (e-kind-of e-kinds (cons c r))) (andB (e-fclass c) (e-formof-n n (e-wordc c) r))
