  ue-ln ".kc{padding:9px 10px;border-right:1px solid var(--rule)}.kc:last-child{border-right:0}.kl{font-size:9.5px;color:var(--muted);text-transform:uppercase;display:block;margin-bottom:3px}.kv{font-size:13px;color:var(--hi);font-weight:600}.kv.pk{color:var(--pink)}" (
  ue-ln ".cli{margin-top:16px;padding:10px 12px;border:1px solid var(--rule2);background:var(--bg2);font-size:11.5px;color:var(--hi);overflow-x:auto;white-space:pre}" (
  ue-ln "</style></head><body><div class='wrap'>" (
  ue-ln "<header class='top'><div><span class='mark'></span><b style='color:var(--hi)'>HYPERACTIVE LABS // CUBICAL SUPERCOMPILER (/eval)</b> &middot; PURE .HYPERCUBICAL IN &rarr; PURE .HYPERCUBICAL OUT</div><div><a href='/'>[2D PORTAL OS /]</a> &middot; <a href='/net'>[LAFONT INET /net]</a> &middot; <a href='/kernel'>[WASM IDE /kernel]</a></div></header>" (
  ue-ln "<h1>Universal Cubical Type Theory Evaluator &amp; Max-Cashflow Hyperreactor</h1>" (
  ue-ln "<p class='sub'>The public expression language is pure Cubical Type Theory (<code>.hypercubical</code>: dependent <code>&Pi;/&Sigma;</code>, <code>Path</code>, <code>comp</code>, <code>Glue</code>, computational univalence <code>ua</code>, <code>al-id</code> rings, <code>TensorIR/CircuitIR</code>). Hyperactive Labs holds the self-optimizing supercompiler + 795-module SHA-256 equivalence store + Lafont hyperreactor. Pricing follows the exact closed-form Lagrangian optimum <code>P* = Y_eff + (q/(p+q))&middot;(X &minus; Y_eff)</code> with zero JSON anywhere on the wire.</p>" (
  ue-ln "<div class='bar'><div style='display:flex;flex-wrap:wrap;gap:4px' id='presets'>" (
  ue-ln "  <button class='btn on' data-k='0'>01 // ua-univalence</button>" (
  ue-ln "  <button class='btn' data-k='1'>02 // al-id-ring-cube</button>" (
  ue-ln "  <button class='btn' data-k='2'>03 // video-dit-rot1</button>" (
  ue-ln "  <button class='btn' data-k='3'>04 // diamond-superopt</button>" (
  ue-ln "  <button class='btn' data-k='4'>05 // kkt-cashflow-proof</button>" (
  ue-ln "</div><div style='display:flex;flex-wrap:wrap;gap:4px;align-items:center'>" (
  ue-ln "  <button class='btn on' data-m='agent'>[x402 agent &alpha;*=90%]</button>" (
  ue-ln "  <button class='btn' data-m='spot'>[spot &alpha;*=67%]</button>" (
  ue-ln "  <button class='btn' data-m='cournot'>[cournot &alpha;*=50%]</button>" (
  ue-ln "  <button class='btn' data-m='stream'>[2-part stream]</button>" (
  ue-ln "  <span style='font-size:10.5px;color:var(--muted);margin-left:4px'>LOAD:</span><input id='ld' type='range' min='10' max='98' value='35' style='width:68px;accent-color:#ff0a94'><span id='ld-v' style='font-size:10.5px;color:var(--hi);width:28px'>35%</span>" (
  ue-ln "  <button class='btn fire' id='run'>[HYPERCOMPILE &amp; REDUCE]</button>" (
  ue-ln "</div></div>" (
  ue-ln "<div class='kpis'>" (
  ue-ln "  <div class='kc'><span class='kl'>BASELINE STEPS (X)</span><span class='kv' id='k-x'>--</span></div>" (
  ue-ln "  <div class='kc'><span class='kl'>HYPERREACTOR STEPS (Y)</span><span class='kv pk' id='k-y'>--</span></div>" (
  ue-ln "  <div class='kc'><span class='kl'>CONTRACTION / STORE HIT</span><span class='kv' id='k-hit'>--</span></div>" (
  ue-ln "  <div class='kc'><span class='kl'>OPTIMAL PRICE (P*)</span><span class='kv' id='k-p'>--</span></div>" (
  ue-ln "  <div class='kc'><span class='kl'>BUYER INSTANT SAVINGS</span><span class='kv' id='k-sav'>--</span></div>" (
  ue-ln "  <div class='kc'><span class='kl'>HYPERACTIVE SURPLUS</span><span class='kv pk' id='k-prf'>--</span></div>" (
  ue-ln "</div>" (
  ue-ln "<div class='grid'>" (
  ue-ln "  <div class='pane'><div class='phd'><span>INPUT // PURE .HYPERCUBICAL MODULE</span><span>--read (0 OS side-effects)</span></div><textarea id='src' spellcheck='false'></textarea></div>" (
  ue-ln "  <div class='pane'><div class='phd'><span>OUTPUT // SELF-CHECKING .HYPERCUBICAL NORMAL FORM &amp; refl KKT RECEIPT</span><span id='lat'>ready</span></div><pre id='out'>Running initial .hypercubical reduction on hyperreactor...</pre></div>" (
  ue-ln "</div>" (
  ue-ln "<div class='cli' id='cli'>curl -s --data-binary @task.hypercubical 'https://hyperactivity.ai/eval?mode=agent'</div>" (
  ue-ln "<script>(function(){var nl=String.fromCharCode(10),q=String.fromCharCode(34),EQ=String.fromCharCode(8801),AR=String.fromCharCode(8594),LM=String.fromCharCode(955),mode='agent';" (
  ue-ln "var P=[" (
  ue-ln "  ['import '+q+'lib/core.hypercubical'+q,'-- Computational univalence (ua) transport on Bool + step reduction:','hx-not-inv : (b : Bool) '+AR+' not (not b) '+EQ+' b','hx-not-inv false = refl','hx-not-inv true  = refl','hx-not-eq : Equiv Bool Bool','hx-not-eq = isoToEquiv not not hx-not-inv hx-not-inv','#show (transport ('+LM+' i '+AR+' ua hx-not-eq i) true)','#show (plus (toNat #314) (toNat #686))'].join(nl)," (
  ue-ln "  ['import '+q+'chem/algebra.hypercubical'+q,'-- Universal commutative-ring prover (al-id) over ALL rings >= Q:','ring-cube-factor : (R : Type) '+AR+' {{c : CommRing R}} '+AR+' (a b : R) '+AR+' (a + b) * (a + b) * (a + b) - a * a * a - b * b * b '+EQ+' (#3 : R) * a * b * (a + b)','ring-cube-factor = al-id','#show #1729'].join(nl)," (
  ue-ln "  ['import '+q+'lib/ir/video-dit-ir.hypercubical'+q,'-- Lossless Wan 2.1 14B / LTX-13B Modal-7 + branchless rot1 BF16 codec:','#show (vdit-rot1-dec (vdit-rot1-enc #48461))','#show (vdit-modal7-bytes #100663296 #2657511)'].join(nl)," (
  ue-ln "  ['import '+q+'lib/ir/hx-universal-eval.hypercubical'+q,'-- Metacircular distributive + Stokes boundary contraction (CanonStep):','my-e : UeExpr','my-e = ue-pls (ue-pls (ue-tim (ue-lit (toNat #12)) (ue-var zero)) (ue-tim (ue-lit (toNat #30)) (ue-var zero))) (ue-d01 (ue-var (suc zero)))','#show (ue-cost-nat my-e)','#show (ue-cost-nat (ue-contract-iter (toNat #3) my-e))','#show (ue-eval-nat ('+LM+' k '+AR+' toNat #10) (ue-contract-iter (toNat #3) my-e))'].join(nl)," (
  ue-ln "  ['import '+q+'lib/ir/hx-universal-eval.hypercubical'+q,'-- Closed-form Cournot-KKT Max-Cashflow split (X=1,000,000, Y=25,000, muTau=5,000):','#show (ue-settle-split #1 #9 #1000000 #25000 #5000)','#show (ue-twopart-fee #100 #10000 #1000 #85)'].join(nl)" (
  ue-ln "];" (
  ue-ln "var srcEl=document.getElementById('src'),outEl=document.getElementById('out'),ldEl=document.getElementById('ld');" (
  ue-ln "srcEl.value=P[0];" (
  ue-ln "function pick(tag,s){var i=s.indexOf(tag);return i<0?0:(parseInt(s.slice(i+tag.length),10)||0)}" (
  ue-ln "function runEval(){var t0=performance.now(),ld=ldEl.value;document.getElementById('lat').textContent='reducing on hyperreactor...';" (
  ue-ln "  fetch('/eval?mode='+mode+'&load='+ld,{method:'POST',body:srcEl.value}).then(function(r){return r.text()}).then(function(txt){" (
  ue-ln "    outEl.textContent=txt;var dt=Math.round(performance.now()-t0);" (
  ue-ln "    var x=pick('hx-baseline-steps-X = #',txt),y=pick('hx-hyperreactor-steps-Y = #',txt),p=pick('hx-optimal-price-P = #',txt),sv=pick('hx-buyer-instant-savings = #',txt),pr=pick('hx-founder-profit = #',txt);" (
  ue-ln "    var hit=txt.indexOf('store_fiber_hit : true')>=0;" (
  ue-ln "    document.getElementById('k-x').textContent=x.toLocaleString();document.getElementById('k-y').textContent=y.toLocaleString();" (
  ue-ln "    document.getElementById('k-hit').textContent=(y>0?(x/y).toFixed(1)+'x':'--')+(hit?' [STORE HIT]':' [FRESH]');" (
  ue-ln "    document.getElementById('k-p').textContent=p.toLocaleString();document.getElementById('k-sav').textContent=sv.toLocaleString();document.getElementById('k-prf').textContent=pr.toLocaleString();" (
  ue-ln "    document.getElementById('lat').textContent=dt+' ms · refl verified';" (
  ue-ln "    document.getElementById('cli').textContent='curl -s --data-binary @program.hypercubical '+q+location.origin+'/eval?mode='+mode+'&load='+ld+q;" (
  ue-ln "  }).catch(function(e){outEl.textContent='-- network error: '+e});}" (
  ue-ln "document.querySelectorAll('[data-k]').forEach(function(b){b.onclick=function(){document.querySelectorAll('[data-k]').forEach(function(x){x.classList.toggle('on',x===b)});srcEl.value=P[+b.getAttribute('data-k')];runEval()};});" (
  ue-ln "document.querySelectorAll('[data-m]').forEach(function(b){b.onclick=function(){document.querySelectorAll('[data-m]').forEach(function(x){x.classList.toggle('on',x===b)});mode=b.getAttribute('data-m');runEval()};});" (
  ue-ln "ldEl.oninput=function(){document.getElementById('ld-v').textContent=ldEl.value+'%'};ldEl.onchange=runEval;" (
  ue-ln "document.getElementById('run').onclick=runEval;runEval();" (
  ue-ln "})();</script></div></body></html>" nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
