  ue-ln ".btn:hover,.btn.on{border-color:var(--pink);color:var(--hi)}.btn.fire{background:var(--pink);border-color:var(--pink);color:#ffffff;font-weight:600}" (
  ue-ln ".grid{display:grid;grid-template-columns:1fr 1fr;border-left:1px solid var(--rule2);border-right:1px solid var(--rule2);border-bottom:1px solid var(--rule2)}@media(max-width:900px){.grid{grid-template-columns:1fr}}" (
  ue-ln ".pane{display:flex;flex-direction:column;min-height:430px}.pane:first-child{border-right:1px solid var(--rule2)}" (
  ue-ln ".phd{padding:7px 10px;border-bottom:1px solid var(--rule);background:var(--bg2);font-size:10.5px;color:var(--muted);display:flex;justify-content:space-between}" (
  ue-ln "textarea,pre{flex:1;margin:0;padding:12px;background:var(--bg);color:var(--hi);border:0;font-size:12px;line-height:1.55;outline:none;resize:vertical;overflow:auto;white-space:pre}" (
