vp-host-p2 : List Word
vp-host-p2 =
  sl-ln "    const uint32_t EYE_W = 1920u, EYE_H = 1824u; // stereo 3840x1824 = 7,004,160 pixels/frame!"
  (sl-ln "    const uint32_t PIXELS = EYE_W * 2u * EYE_H;"
  (sl-ln "    id<MTLBuffer> bImg = [dev newBufferWithLength:PIXELS * 4u options:MTLResourceStorageModeShared];"
  (sl-ln "    id<MTLBuffer> bAct = [dev newBufferWithLength:16u options:MTLResourceStorageModeShared];"
  (sl-ln "    VpPose pose = { {0,0,0}, {-0.2f,-0.1f,-0.4f}, {-0.1f,-0.1f,-0.4f}, {0.15f,0.0f,-0.45f}, {0.155f,0.005f,-0.45f}, 7u, 1u };"
  (sl-ln "    simd_uint2 edim = { EYE_W, EYE_H };"
  (sl-ln "    double best_dt = 1e9;"
  (sl-ln "    for (int it = 0; it < 15; it++) {"
  (sl-ln "      id<MTLCommandBuffer> cb = [q commandBuffer];"
  (sl-ln "      id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
  (sl-ln "      [enc setComputePipelineState:pso];"
  (sl-ln "      [enc setBuffer:bImg offset:0 atIndex:0];"
  (sl-ln "      [enc setBuffer:bAct offset:0 atIndex:1];"
  (sl-ln "      [enc setBytes:&pose length:sizeof(VpPose) atIndex:2];"
  (sl-ln "      [enc setBytes:&edim length:sizeof(simd_uint2) atIndex:3];"
  (sl-ln "      [enc dispatchThreads:MTLSizeMake(EYE_W*2u, EYE_H, 1) threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];"
  (sl-ln "      [enc endEncoding];"
  (sl-ln "      double t0 = now_s();"
  (sl-ln "      [cb commit]; [cb waitUntilCompleted];"
  (sl-ln "      double dt = now_s() - t0;"
  (sl-ln "      if (it > 0 && dt < best_dt) best_dt = dt;"
  (sl-ln "    }"
  (sl-ln "    uint32_t* act = (uint32_t*)[bAct contents];"
  (sl-ln "    int meets_90hz = (best_dt * 1e6 < 11111.0);"
  (sl-ln "    int ok = (act[0] == 1u && act[1] == 7u && meets_90hz);"
  (sl-ln (list-append "    printf(" (list-append sl-q (list-append "[HX-VISIONPRO-METAL] device=%s | stereo=%ux%u (%u px) | r_pinch=%u | frame=%.3f ms (%.0f FPS, <11.11ms_90Hz=%d) | %.2f G-px/s | ok=%d" (list-append sl-esc-n (list-append sl-q ", [[dev name] UTF8String], EYE_W*2u, EYE_H, PIXELS, act[0], best_dt*1e3, 1.0/best_dt, meets_90hz, (double)PIXELS/(best_dt*1e9), ok);")))))
  (sl-ln "    return ok ? 0 : 1;"
  (sl-ln "  }"
  (sl-ln "}" nil))))))))))))))))))))))))))))
