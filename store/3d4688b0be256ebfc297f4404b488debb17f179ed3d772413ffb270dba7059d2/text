um-replace-go : Nat → List Word → List Word → List Word → List Word
um-replace-go zero pat rep s = s
um-replace-go (suc k) pat rep nil = nil
um-replace-go (suc k) pat rep (cons x r) =
  if h-prefix pat (cons x r)
  then list-append rep (um-replace-go k pat rep (h-drop pat (cons x r)))
  else cons x (um-replace-go k pat rep r)
