-- Section (1): Universal Enantiotopic Indistinguishability & Ogston Chiral Discrimination Theorems.
-- THEOREM 1A (Universal Enantiotopic Indistinguishability in Achiral Environments):
tc-enantiotopic-eq : (W A : Type) → (add : A → A → A) →
  (B : W → W → A) → (V : W → A) → (tau : W → W) →
  ((x : W) → B (tau x) (tau x) ≡ B x x) →
  ((x : W) → V (tau x) ≡ V x) →
  (x : W) → add (B (tau x) (tau x)) (V (tau x)) ≡ add (B x x) (V x)
tc-enantiotopic-eq W A add B V tau hB hV x = λ i → add (hB x i) (hV x i)
