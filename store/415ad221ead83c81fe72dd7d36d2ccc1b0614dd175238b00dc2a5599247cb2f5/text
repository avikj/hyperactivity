sc-two : sqs-eq (inner (word-act (sc-word (cons (1 , 0) (cons (0 , 1) (cons (0 , 0) (cons (0 , 0) nil))))) (sc-ends (cons (1 , 0) (cons (0 , 1) (cons (0 , 0) (cons (0 , 0) nil)))))))
  (inner (word-act (sc-word (cons (0 , 0) (cons (0 , 0) (cons (1 , 0) (cons (0 , 1) nil))))) (sc-ends (cons (0 , 0) (cons (0 , 0) (cons (1 , 0) (cons (0 , 1) nil))))))) ≡ true
sc-two = λ i → true
