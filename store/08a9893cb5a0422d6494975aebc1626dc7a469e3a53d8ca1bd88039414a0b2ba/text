-- ⟨H^n⟩ at s = 0; variables t, K, L
ra-moment : Nat → (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A
ra-moment n A ad mu q vs = al-nth A (q (fn-q 0 1)) 12
  (ra-pow A ad mu (q (fn-q 0 1)) (mu (q (fn-nq 1 1)) (al-nth A (q (fn-q 0 1)) 0 vs)) (mu (q (fn-nq 1 1)) (al-nth A (q (fn-q 0 1)) 1 vs))
    (ra-pot A mu q (al-nth A (q (fn-q 0 1)) 2 vs) ra-w) n (ra-e0 A (q (fn-q 0 1)) (q (fn-q 1 1))))
