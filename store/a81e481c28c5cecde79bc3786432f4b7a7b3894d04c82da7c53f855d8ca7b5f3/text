b2-thead : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-thead mm_ bk tel ctx def s kq_ =
  b2-wnf mm_ bk tel (λ t → let mm_10103 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_10103 b2-ERR)) else (let t_10105 = t in scmd (w-load ((b2-a mm_10103 t_10105))) (λ x_10104 → let mm_10106 = b2-dep mm_10103 x_10104 in let tg = (%wand x_10104 #255) in if (%weq tg b2-ALL) then (kq_ (h4-depl mm_10106 (t))) else (b2-fail mm_10106 bk ctx "unreachable (a telescope binds its parameters and fields)" #0 s def (λ r → let mm_10107 = b2-dep mm_10106 r in kq_ (h4-depl mm_10107 (r)))))))
