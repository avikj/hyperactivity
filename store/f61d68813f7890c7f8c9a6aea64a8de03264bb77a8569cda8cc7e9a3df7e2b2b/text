  (sl-ln "  if (seed_len == 0) { for (uint32_t i = 0; i < 4096u; i++) buf[i] = (uint8_t)(32u + (i % 95u)); seed_len = 4096u; }"
  (sl-ln "  for (size_t off = seed_len; off < NBYTES; off++) buf[off] = (uint8_t)(buf[off - seed_len] ^ ((off >> 16u) & 7u));"
  (sl-ln "  uint32_t need = 0u, give = 0u, aud = 0u, eb = 400u, ec = 300u;"
  (sl-ln "  uint32_t lok = 1u, aok = 1u, cok = 1u, max_r2 = 0u, thist = 0u;"
  (sl-ln "  const uint32_t KEY = 31337u, R2 = 1000000u;"
  (sl-ln "  double t0 = now_s();"
  (sl-ln "  for (uint32_t i = 0u; i < NBYTES; i++) {"
  (sl-ln "    uint32_t b = buf[i];"
  (sl-ln "    uint32_t vn = (b == 40u || b == 41u || b == 58u) ? 2u : ((b >= 48u && b <= 57u) ? 0u : ((b >= 65u && b <= 122u) ? 1u : 0u));"
  (sl-ln "    if (give <= vn) { need += (vn - give); give = 1u; } else { give = (give - vn) + 1u; }"
  (sl-ln "    uint32_t lum = (b + eb) & 255u, gx = (b ^ aud) & 255u, chr = (need + give) & 255u;"
  (sl-ln "    uint32_t vis = (lum << 16u) | (gx << 8u) | chr;"
  (sl-ln "    uint32_t op = (b + chr) % 3u, aud2 = tonnetz_step(aud, op);"
  (sl-ln "    if (tonnetz_step(aud2, op) != aud || aud2 >= 24u) aok = 0u;"
  (sl-ln "    aud = aud2; thist |= (1u << aud);"
  (sl-ln "    uint32_t raw = (aud << 24u) | vis, recv = feistel_dec(KEY, feistel_enc(KEY, raw));"
