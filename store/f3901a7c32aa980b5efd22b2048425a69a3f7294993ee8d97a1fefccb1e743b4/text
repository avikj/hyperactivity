r4d-bf-lhs-jA : (C : Type) → (Nat → Nat → Nat → Nat) → (Nat → Nat → Nat → Nat → Nat) →
  Nat → R4dFrac → (R4dFrac → C) → C
r4d-bf-lhs-jA C base bndK fuel acc cont = case fuel of
  zero → cont acc
  suc jA →
    (λ tf →
      r4d-bf-lhs-k3 C tf bndK (r4d-tet-ks 0 1 2 3 tf) (r4d-tet-ks 0 1 2 4 tf) (r4d-tet-ks 0 1 2 5 tf)
        r4d-fr-zero (λ sub →
          if r4d-fr-is-zero sub then r4d-bf-lhs-jA C base bndK jA acc cont
          else r4d-force-fr C (r4d-fr-add acc (r4d-fr-mul ((bin-of-nat (suc jA) , nil) , bin-one) sub))
                 (λ acc2 → r4d-bf-lhs-jA C base bndK jA acc2 cont)))
    (r4d-with-fA base jA)
