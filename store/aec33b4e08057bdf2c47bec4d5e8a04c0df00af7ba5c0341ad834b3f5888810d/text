b2-ploop : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-ploop mm_ zero p kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ploop mm_ (suc f) p kq_ =
  b2-pitem mm_ p (λ dd_13912 → let mm_13913 = b2-dep mm_ dd_13912 in scmd (w-load ((b2-HR mm_13913 #28))) (λ r → let mm_13914 = b2-dep mm_13913 r in if (%weq r #1) then (b2-ploop mm_13914 f p kq_) else (kq_ (h4-depl mm_13914 (r)))))
