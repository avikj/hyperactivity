  (sl-ln "    // 1. Technical natural language ValMon step (classify ASCII: op/delim/ident/num)"
  (sl-ln "    uint vn = (b == 40u || b == 41u || b == 58u) ? 2u : ((b >= 48u && b <= 57u) ? 0u : ((b >= 65u && b <= 122u) ? 1u : 0u));"
  (sl-ln "    if (give <= vn) { need += (vn - give); give = 1u; } else { give = (give - vn) + 1u; }"
  (sl-ln "    // 2. Vision Jet/Stokes chroma projection"
  (sl-ln "    uint lum = (b + eb) & 255u, gx = (b ^ aud) & 255u, chr = (need + give) & 255u;"
  (sl-ln "    uint vis = (lum << 16u) | (gx << 8u) | chr;"
  (sl-ln "    // 3. Sound Neo-Riemannian Tonnetz unitary involution step"
  (sl-ln "    uint op = (b + chr) % 3u;"
  (sl-ln "    uint aud2 = tonnetz_step(aud, op);"
  (sl-ln "    if (tonnetz_step(aud2, op) != aud || aud2 >= 24u) aud_ok = 0u;"
  (sl-ln "    aud = aud2; thist |= (1u << aud);"
