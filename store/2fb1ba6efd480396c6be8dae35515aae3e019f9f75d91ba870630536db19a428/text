  (sl-ln "  uint link_ok = 1u, aud_ok = 1u, cbf_ok = 1u, max_r2 = 0u, thist = 0u, dig = 0u;"
  (sl-ln "  const uint KEY = 31337u, R2 = 1000000u;"
