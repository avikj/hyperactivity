  sl-ln "struct SynRes { uint link_ok; uint aud_ok; uint cbf_ok; uint max_r2; uint triad_hist; uint digest; };"
  (sl-ln "kernel void synesthesia_closed_loop("
  (sl-ln "  device const uchar* corpus [[buffer(0)]],"
