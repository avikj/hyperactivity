-- Fast allocation-free 1-electron single-edge hop check (fa -> fb = fa +/- e_k):
emg-edge-hop-1e : Nat → Nat → Nat → Nat → List BZ → Nat → List BZ → BZ
emg-edge-hop-1e k a b u fa w fb =
  if both (eqb u a) (eqb w b)
  then (if sc-hop-delta-ok k true fa fb then bz-one else bz-zero)
  else (if both (eqb u b) (eqb w a)
        then (if sc-hop-delta-ok k false fa fb then bz-one else bz-zero)
        else bz-zero)
