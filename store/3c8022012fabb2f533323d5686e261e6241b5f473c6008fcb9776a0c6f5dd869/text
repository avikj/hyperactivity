rp-haar-lift : List Word → List Word → List Word → (List Word × List Word)
rp-haar-lift nil sa da = (rp-rev sa nil , rp-rev da nil)
rp-haar-lift (cons x nil) sa da = (rp-rev (cons (rp-w32 x) sa) nil , rp-rev da nil)
rp-haar-lift (cons a (cons b r)) sa da =
  let p = rp-haar-lift-pair (a , b)
  in rp-haar-lift r (cons (fst p) sa) (cons (snd p) da)
