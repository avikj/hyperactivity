b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_7323 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_7323 (k))) else (b2-nbytes mm_7323 ns (λ nb → let mm_7324 = b2-dpl mm_7323 nb in b2-nbytes mm_7324 k (λ kb → let mm_7325 = b2-dpl mm_7324 kb in b2-nm mm_7325 (list-append nb (cons #58 kb)) (λ r → let mm_7326 = b2-dep mm_7325 r in kq_ (h4-depl mm_7326 (r)))))))
