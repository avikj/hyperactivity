r4d-side-reduce : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → R4dAb A z add neg →
  (r0 r1 r2 : A × (A × A)) → (u0 u1 u2 : A) →
  r4d-side-boundary A add neg r0 r1 r2 u0 u1 u2 ≡
  add (r4d-sum3 A add r0) (add (r4d-sum3 A add r1) (r4d-sum3 A add r2))
r4d-side-reduce A z add neg ab r0 r1 r2 u0 u1 u2 =
  lor-tr A
    (r4d-side-boundary A add neg r0 r1 r2 u0 u1 u2)
    (add (add (r4d-sum3 A add r0) (add (r4d-sum3 A add r1) (r4d-sum3 A add r2)))
         (add (add u0 (neg u1)) (add (add u1 (neg u2)) (add u2 (neg u0)))))
    (add (r4d-sum3 A add r0) (add (r4d-sum3 A add r1) (r4d-sum3 A add r2)))
    (concat
      (cong (λ t → add (add (r4d-sum3 A add r0) (add u0 (neg u1))) t)
            (r4d-swap4 A z add neg ab (r4d-sum3 A add r1) (add u1 (neg u2)) (r4d-sum3 A add r2) (add u2 (neg u0))))
      (r4d-swap4 A z add neg ab
        (r4d-sum3 A add r0) (add u0 (neg u1))
        (add (r4d-sum3 A add r1) (r4d-sum3 A add r2))
        (add (add u1 (neg u2)) (add u2 (neg u0)))))
    (concat
      (cong (λ t → add (add (r4d-sum3 A add r0) (add (r4d-sum3 A add r1) (r4d-sum3 A add r2))) t)
            (r4d-cycle3-zero A z add neg ab u0 u1 u2))
      (r4d-zr A z add neg ab (add (r4d-sum3 A add r0) (add (r4d-sum3 A add r1) (r4d-sum3 A add r2)))))
