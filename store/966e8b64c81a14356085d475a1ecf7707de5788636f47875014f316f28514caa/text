-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13167 = seen in let j_13168 = j in scmd (w-load ((b2-a mm_ (%wadd v_13167 #2)))) (λ d_13165 → let mm_13169 = b2-dep mm_ d_13165 in scmd (w-load ((b2-a mm_13169 (%wadd d_13165 (%wsucc j_13168))))) (λ x_13166 → let mm_13170 = b2-dep mm_13169 x_13166 in let e = x_13166 in let i_13172 = e in scmd (w-load ((b2-a mm_13170 i_13172))) (λ x_13171 → let mm_13173 = b2-dep mm_13170 x_13171 in let x = x_13171 in if (%weq x p) then (kq_ (h4-depl mm_13173 (e))) else (b2-seenat mm_13173 f seen p (%wsucc j) n kq_)))))
