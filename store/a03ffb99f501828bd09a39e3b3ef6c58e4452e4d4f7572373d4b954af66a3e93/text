derive-show-at : Nat → Word → Opt Code
derive-show-at zero d = none
derive-show-at (suc n) d =
  d-omap (λ shapes → cann (clam (ccase d (show-branches (λ d2 → d-or (derive-show-at n d2) (clam c-nil)) shapes #0) (cvar #0)))
                          (cpi #2 (cdata d lnil) (code (List Word))))
    (all-shapes d)
