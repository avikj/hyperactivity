-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_9846 = s in let j_9847 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_9846 (%wadd #2 j_9847))))) (λ x_9845 → let mm_9848 = b2-dep mm_ x_9845 in let fl = x_9845 in kq_ (h4-depl mm_9848 (fl))))
