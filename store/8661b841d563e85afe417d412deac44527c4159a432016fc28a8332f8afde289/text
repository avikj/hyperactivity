b2-firstexs : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstexs mm_ zero cls j n kq_ =
  kq_ (h4-depl mm_ (n))
b2-firstexs mm_ (suc f) cls j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (n))) else (let v_8051 = cls in let j_8052 = j in scmd (w-load ((b2-a mm_ (%wadd v_8051 #2)))) (λ d_8049 → let mm_8053 = b2-dep mm_ d_8049 in scmd (w-load ((b2-a mm_8053 (%wadd d_8049 (%wsucc j_8052))))) (λ x_8050 → let mm_8054 = b2-dep mm_8053 x_8050 in let c = x_8050 in let i_8056 = c in scmd (w-load ((b2-a mm_8054 i_8056))) (λ x_8055 → let mm_8057 = b2-dep mm_8054 x_8055 in let all = x_8055 in if (%weq all #0) then (kq_ (h4-depl mm_8057 (j))) else (b2-firstexs mm_8057 f cls (%wsucc j) n kq_)))))
