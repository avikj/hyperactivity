-- Abelian group bundle (add-zl, add-zr, add-assoc, inv-r, inv-l) for universal telescoping series:
BstAb : (A : Type) → A → (A → A → A) → (A → A) → Type
BstAb A z add neg =
  ((x : A) → add z x ≡ x) ×
  (((x : A) → add x z ≡ x) ×
  (((x y w : A) → add (add x y) w ≡ add x (add y w)) ×
  (((x : A) → add x (neg x) ≡ z) ×
  ((x : A) → add (neg x) x ≡ z))))
