-- the text before each mention and its number
e-marks : Nat → List Word → List Word → List (List Word × Word)
e-marks zero acc t = nil
e-marks (suc f) acc nil = nil
e-marks (suc f) acc (cons c r) =
  if andB (weq c #0) (h-infix (cons #0 nil) r)
  then cons (h-rev acc nil , h-number (e-upto-c #0 r)) (e-marks f nil (e-or (e-after-c #0 r)))
  else e-marks f (cons c acc) r
