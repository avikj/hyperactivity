-- Non-trivial factorable expression: excludes bare atoms and raw binder wrappers
hf-factorable-head : Code → Bool
hf-factorable-head (cvar _) = false
hf-factorable-head (cglob _) = false
hf-factorable-head (cwlit _) = false
hf-factorable-head (cplit _ _) = false
hf-factorable-head (clam _) = false
hf-factorable-head (cdlam _) = false
hf-factorable-head (cplam _) = false
hf-factorable-head cword = false
hf-factorable-head clzero = false
hf-factorable-head _ = true
