-- signed: (sign, magnitude), sign 1 negative; zero has sign 0
sx-add : Word × List Word → Word × List Word → Word × List Word
sx-add a b =
  if %weq (fst a) (fst b) then (fst a , bg-add (snd a) (snd b))
  else (let c = bg-cmp (snd a) (snd b)
        in if %weq c #2 then (fst a , bg-sub (snd a) (snd b))
           else if %weq c #0 then (fst b , bg-sub (snd b) (snd a))
           else (#0 , nil))
