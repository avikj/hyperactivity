-- the index's bytes: the root's place and the depth (four bytes each), the table from 8, the records, the tree
-- made from the tokens T and their search tree t (si-tree T), each computed once
si-make-t : List (List Word) → RTree (El entry-ord) → Word → List Word
si-make-t T t r = si-w4 r (si-w4 (fromNat (si-depth t)) (si-w-tab T (si-o0 T) (si-w-recs T (si-w-tree t r nil))))
