b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_7197 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_7197 (k))) else (b2-nbytes mm_7197 ns (λ nb → let mm_7198 = b2-dpl mm_7197 nb in b2-nbytes mm_7198 k (λ kb → let mm_7199 = b2-dpl mm_7198 kb in b2-nm mm_7199 (list-append nb (cons #58 kb)) (λ r → let mm_7200 = b2-dep mm_7199 r in kq_ (h4-depl mm_7200 (r)))))))
