-- `Superopt == Hypercrack` hardware bottleneck extractor:
--   `inl unit` -> Empty throttle fiber (100% mechanical-sympathy peak)
--   `inr code` -> Concrete throttle witness (#1..#6) to unlock
hc-hypercrack-audit : MacSysState → Sum Unit Word
hc-hypercrack-audit (mac-sys vp sb kt mr tb pt) =
  if %wlt vp #85 then inr #1
  else if %wlt sb #64 then inr #2
  else if %wlt #1 kt then inr #3
  else if mr then
    (if %wlt tb #40 then inr #5
     else if pt then inl unit else inr #6)
  else inr #4
