r4d-tri-census : Nat → Nat → Nat → Nat × (Nat × Nat) → Nat × (Nat × Nat)
r4d-tri-census v0 v1 v2 counts =
  (λ aCount →
    if eqb aCount 3 then (suc (fst counts) , snd counts)
    else (if eqb aCount 0 then (fst counts , (suc (fst (snd counts)) , snd (snd counts)))
          else (fst counts , (fst (snd counts) , suc (snd (snd counts))))))
  (plus (r4d-in-A v0) (plus (r4d-in-A v1) (r4d-in-A v2)))
