b2-rehash : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-rehash mm_ zero t cap t2 j kq_ =
  kq_ (h4-depl mm_ (t2))
b2-rehash mm_ (suc f) t cap t2 j kq_ =
  if (%weq j cap) then (kq_ (h4-depl mm_ (t2))) else (let i_174 = (%wadd t (%wsucc j)) in scmd (w-load ((b2-a mm_ i_174))) (λ x_173 → let mm_175 = b2-dep mm_ x_173 in let k = x_173 in if (%weq k #0) then (b2-rehash mm_175 f t cap t2 (%wsucc j) kq_) else (let i_177 = (%wadd t (%wadd (%wsucc j) cap)) in scmd (w-load ((b2-a mm_175 i_177))) (λ x_176 → let mm_178 = b2-dep mm_175 x_176 in let v = x_176 in b2-tput mm_178 t2 k v (λ dd_179 → let mm_180 = b2-dep mm_178 dd_179 in b2-rehash mm_180 f t cap t2 (%wsucc j) kq_)))))
