b2-markbase : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13499 = bk in let j_13500 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13499 (%wadd #2 j_13500))))) (λ x_13498 → let mm_13501 = b2-dep mm_ x_13498 in let ov = x_13498 in let v_13504 = ov in let j_13505 = j in scmd (w-load ((b2-a mm_13501 (%wadd v_13504 #2)))) (λ d_13503 → let mm_13506 = b2-dep mm_13501 d_13503 in scmd (w-load ((b2-a mm_13506 (%wadd d_13503 (%wsucc j_13505))))) (λ x_13502 → let mm_13507 = b2-dep mm_13506 x_13502 in let k = x_13502 in b2-tld mm_13507 bk k (λ t → let mm_13508 = b2-dep mm_13507 t in let t_13510 = t in scmd (w-load ((b2-a mm_13508 t_13510))) (λ x_13509 → let mm_13511 = b2-dep mm_13508 x_13509 in let tg = (%wand x_13509 #255) in let t_13512 = t in let j_13513 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13514 = #1 in scmd (w-store ((b2-a mm_13511 (%wadd t_13512 (%wadd #2 j_13513)))) (v_13514)) (λ uu_13515 → let mm_13516 = hv2-u mm_13511 uu_13515 in b2-markbase mm_13516 f bk (%wsucc j) n kq_)))))))
