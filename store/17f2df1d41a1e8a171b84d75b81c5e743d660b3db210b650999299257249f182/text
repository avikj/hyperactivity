-- the argument cells an array native evaluates first, by index (JS is strict: a stored value
-- is computed when it is stored, not when it is read, after later writes): the type, depth
-- and value of a new array; otherwise the array, its index, a stored value, an atomic's operands
b2-arrneed : Word → Word → Bool
b2-arrneed ic j = if %weq ic #100 then %wlt j #3 else if orB (%weq ic #105) (%weq ic #106) then %weq j #1 else if orB (%weq ic #103) (%weq ic #104) then %wlt #0 j else if orB (%weq ic #101) (%weq ic #102) then orB (%weq j #1) (%weq j #2) else %wlt #0 j
