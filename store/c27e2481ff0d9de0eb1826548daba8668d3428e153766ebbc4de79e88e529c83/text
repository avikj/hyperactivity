     add (mul c (emg-tail-form A z add mul c br qs)) (emg-norm2 A z add mul br) ≡
     emg-sos-vec A z add mul c br qs) →
  (qs : List A) → suc (emg-len A br) ≡ emg-len A qs →
  add (mul c (emg-tail-form A z add mul c (cons bk br) qs)) (emg-norm2 A z add mul (cons bk br)) ≡
  emg-sos-vec A z add mul c (cons bk br) qs
emg-schur-vec-cons A z add mul neg r c bk br ih qs hlen =
  (case qs return λ qlist → suc (emg-len A br) ≡ emg-len A qlist →
