     emg-sos-vec A z add mul c (cons bk br) qlist of
     nil → λ p → Empty-rec (emg-zero-neq-suc (emg-len A br) (sym p))
     cons qk qr → λ p →
       lor-tr A
         (add (mul c (add (add (mul c (mul qk qk)) (add (mul bk qk) (mul qk bk)))
                          (emg-tail-form A z add mul c br qr)))
              (add (mul bk bk) (emg-norm2 A z add mul br)))
         (add (add (mul c (add (mul c (mul qk qk)) (add (mul bk qk) (mul qk bk)))) (mul bk bk))
              (add (mul c (emg-tail-form A z add mul c br qr)) (emg-norm2 A z add mul br)))
         (add (mul (add (mul c qk) bk) (add (mul c qk) bk))
              (emg-sos-vec A z add mul c br qr))
         (lor-tr A
           (add (mul c (add (add (mul c (mul qk qk)) (add (mul bk qk) (mul qk bk)))
                            (emg-tail-form A z add mul c br qr)))
                (add (mul bk bk) (emg-norm2 A z add mul br)))
           (add (add (mul c (add (mul c (mul qk qk)) (add (mul bk qk) (mul qk bk))))
                     (mul c (emg-tail-form A z add mul c br qr)))
                (add (mul bk bk) (emg-norm2 A z add mul br)))
