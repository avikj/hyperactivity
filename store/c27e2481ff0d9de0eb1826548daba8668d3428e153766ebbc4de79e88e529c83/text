                (add (mul c (emg-tail-form A z add mul c br qr)) (emg-norm2 A z add mul br)))
           (cong (λ t → add t (add (mul bk bk) (emg-norm2 A z add mul br)))
                 (emg-ldist A z add mul neg r c
                   (add (mul c (mul qk qk)) (add (mul bk qk) (mul qk bk)))
