um-js-resp : List Word → List Word
um-js-resp body = list-append (h-concat (cons "HTTP/1.1 200 OK" (cons h-crlf (cons "Content-Type: application/javascript; charset=utf-8" (cons h-crlf (cons "Content-Length: " (cons (h-decimal (fromNat (list-length body))) (cons h-crlf (cons "Cache-Control: public, max-age=86400" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil))))))))))))) body
