ue-lem-peep-tim-sound : (env : Nat → Nat) → (a b : UeExpr) →
  ue-eval-nat env (ue-peep-tim a b) ≡ ue-mul (ue-eval-nat env a) (ue-eval-nat env b)
ue-lem-peep-tim-sound env (ue-lit zero)          b = refl
ue-lem-peep-tim-sound env (ue-lit (suc zero))    b = ue-sym (ue-add-zero-r (ue-eval-nat env b))
ue-lem-peep-tim-sound env (ue-lit (suc (suc n))) b = refl
ue-lem-peep-tim-sound env (ue-var k)             b = refl
ue-lem-peep-tim-sound env (ue-pls x y)           b = refl
ue-lem-peep-tim-sound env (ue-tim x y)           b = refl
ue-lem-peep-tim-sound env (ue-d01 x)             b = refl
