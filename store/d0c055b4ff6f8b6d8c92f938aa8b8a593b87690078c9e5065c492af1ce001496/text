ief-add : Word → Word → Word
ief-add a b =
  if orB (ief-isnan a) (ief-isnan b) then ief-NAN
  else if ief-isinf a then (if andB (ief-isinf b) (not (%weq (ief-sgn a) (ief-sgn b))) then ief-NAN else a)
  else if ief-isinf b then b
  else if andB (ief-iszero a) (ief-iszero b) then ief-sbit (%wand (ief-sgn a) (ief-sgn b))
  else if ief-iszero a then b
  else if ief-iszero b then a
  else if %wlt (ief-abs a) (ief-abs b)
  then ief-add-fin (ief-sgn b) (ief-m b) (ief-e b) (ief-sgn a) (ief-m a) (ief-e a)
  else ief-add-fin (ief-sgn a) (ief-m a) (ief-e a) (ief-sgn b) (ief-m b) (ief-e b)
