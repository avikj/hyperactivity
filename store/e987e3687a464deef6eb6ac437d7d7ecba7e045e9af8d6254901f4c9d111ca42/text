-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_6989 = tel in let j_6990 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_6989 (%wsucc j_6990))))) (λ x_6988 → let mm_6991 = b2-dep mm_ x_6988 in let c = x_6988 in let i_6993 = c in scmd (w-load ((b2-a mm_6991 i_6993))) (λ x_6992 → let mm_6994 = b2-dep mm_6991 x_6992 in let q = x_6992 in let i_6996 = (%wadd c #1) in scmd (w-load ((b2-a mm_6994 i_6996))) (λ x_6995 → let mm_6997 = b2-dep mm_6994 x_6995 in let k = x_6995 in let i_6999 = (%wadd c #2) in scmd (w-load ((b2-a mm_6997 i_6999))) (λ x_6998 → let mm_7000 = b2-dep mm_6997 x_6998 in let i = x_6998 in let i_7002 = (%wadd c #3) in scmd (w-load ((b2-a mm_7000 i_7002))) (λ x_7001 → let mm_7003 = b2-dep mm_7000 x_7001 in let vT = x_7001 in let i_7005 = (%wadd c #4) in scmd (w-load ((b2-a mm_7003 i_7005))) (λ x_7004 → let mm_7006 = b2-dep mm_7003 x_7004 in let s = x_7004 in b2-All mm_7006 q k i vT e s (λ a → let mm_7007 = b2-dep mm_7006 a in b2-telebindg mm_7007 f tel (%wsub j #1) a kq_))))))))
