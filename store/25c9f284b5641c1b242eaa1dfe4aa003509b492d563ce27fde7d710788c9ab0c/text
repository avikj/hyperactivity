-- Full exact Euclidean EPRL 4-simplex vertex amplitude as Amp = (sign, (num, den)).
sf-eprl-vertex : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Amp
sf-eprl-vertex J Jp Jm i1 i2 i3 i4 i5 =
  sf-amp-of-bq-d2 (sf-eprl-R J Jp Jm i1 i2 i3 i4 i5)
    (sf-bq-of-nat (times (times (suc i1) (suc i2)) (times (suc i3) (times (suc i4) (suc i5)))))
