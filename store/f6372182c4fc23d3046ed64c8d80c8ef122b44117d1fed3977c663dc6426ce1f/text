b2-firstexs : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstexs mm_ zero cls j n kq_ =
  kq_ (h4-depl mm_ (n))
b2-firstexs mm_ (suc f) cls j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (n))) else (let v_8787 = cls in let j_8788 = j in scmd (w-load ((b2-a mm_ (%wadd v_8787 #2)))) (λ d_8786 → let mm_8789 = b2-dep mm_ d_8786 in scmd (w-load ((b2-a mm_8789 (%wadd d_8786 (%wsucc j_8788))))) (λ x_8785 → let mm_8790 = b2-dep mm_8789 x_8785 in let c = x_8785 in let i_8792 = c in scmd (w-load ((b2-a mm_8790 i_8792))) (λ x_8791 → let mm_8793 = b2-dep mm_8790 x_8791 in let all = x_8791 in if (%weq all #0) then (kq_ (h4-depl mm_8793 (j))) else (b2-firstexs mm_8793 f cls (%wsucc j) n kq_)))))
