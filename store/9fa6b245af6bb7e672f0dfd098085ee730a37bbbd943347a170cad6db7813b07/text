  (sl-ln "}"
  (sl-ln "static uint32_t schmitt_finger(uint32_t prev_bit, const float th[3], const float tip[3]) {"
  (sl-ln "  float dx = (th[0] - tip[0]) * 1000.0f;"
  (sl-ln "  float dy = (th[1] - tip[1]) * 1000.0f;"
  (sl-ln "  float dz = (th[2] - tip[2]) * 1000.0f;"
  (sl-ln "  float d2 = dx*dx + dy*dy + dz*dz;"
  (sl-ln "  if (d2 <= 144.0f) return 1u;"
  (sl-ln "  if (d2 >= 324.0f) return 0u;"
  (sl-ln "  return prev_bit ? 1u : 0u;"
  (sl-ln "}"
  (sl-ln "static uint32_t tonnetz_next(uint32_t t, uint32_t op) {"
  (sl-ln "  uint32_t r = t >> 1u, m = t & 1u;"
  (sl-ln "  uint32_t r2 = (op == 0u) ? r : ((op == 1u) ? ((r + (m ? 8u : 4u)) % 12u) : ((r + (m ? 3u : 9u)) % 12u));"
  (sl-ln "  return (r2 << 1u) | (m ^ 1u);"
  (sl-ln "}" r))))))))))))))))))))))))))))))))))))
