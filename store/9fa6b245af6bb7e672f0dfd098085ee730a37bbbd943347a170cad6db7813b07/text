  (sl-ln "  (void)nfiles; (void)files;"
  (sl-ln (list-append "  const char* td = getenv(" (list-append (sl-str "TMPDIR") (list-append "); if (!td || !*td) td = " (list-append (sl-str "/tmp") ";"))))
  (sl-ln "  char d1[512], d2[512], fp[512];"
  (sl-ln (list-append "  snprintf(d1, sizeof d1, " (list-append (sl-str "%s/hx_vp_boot") ", td); mkdir(d1, 0777);"))
  (sl-ln (list-append "  snprintf(d2, sizeof d2, " (list-append (sl-str "%s/hx_vp_boot/lib") ", td); mkdir(d2, 0777);"))
  (sl-ln (list-append "  snprintf(fp, sizeof fp, " (list-append (sl-str "%s/hx_vp_boot/lib/prelude.hypercubical") ", td);"))
  (sl-ln (list-append "  FILE* f = fopen(fp, " (list-append (sl-str "wb") ");"))
  (sl-ln (list-append "  if (f) { fputs(" (list-append sl-q (list-append "data Bool = false | true" (list-append sl-esc-n (list-append "data Level = lzero | lsuc (a : Level)" (list-append sl-esc-n (list-append "vp-tonnetz-P t = %wxor t #1" (list-append sl-esc-n (list-append sl-q ", f); fclose(f); }")))))))))
