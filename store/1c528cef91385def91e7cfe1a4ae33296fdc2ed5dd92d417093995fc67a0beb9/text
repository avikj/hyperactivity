-- src/hvm.c heap_subst_cop: the other side's value left for its twin, this side's returned
h4-subcop : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-subcop m side loc r0 r1 k =
  scmd (w-store ((h4-ha m loc)) ((h4-setsub (if %weq side #0 then r1 else r0)))) (λ u36 → let m37 = hv2-u m u36 in k (h4-depl m37 ((if %weq side #0 then r0 else r1))))
