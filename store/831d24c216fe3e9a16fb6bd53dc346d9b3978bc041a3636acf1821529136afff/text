b2-ftab : Word → (Word → Step W Word) → Step W Word
b2-ftab mm_ kq_ =
  scmd (w-load ((b2-HR mm_ #23))) (λ t → let mm_15703 = b2-dep mm_ t in if (not (%weq t #0)) then (kq_ (h4-depl mm_15703 (t))) else (b2-vec mm_15703  (λ v → let mm_15704 = b2-dep mm_15703 v in scmd (w-store ((b2-HR mm_15704 #23)) (v)) (λ uu_15705 → let mm_15706 = hv2-u mm_15704 uu_15705 in kq_ (h4-depl mm_15706 (v))))))
