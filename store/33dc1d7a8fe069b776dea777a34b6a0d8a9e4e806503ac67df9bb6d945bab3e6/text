-- Exact dihedral squared cosine: cos^2(theta_12) = (8 J_1.J_2)^2 / (4 a_1^2 a_2^2) as BQ.
qg-cos2-dihedral : List Bool → List Bool → List Bool → BQ
qg-cos2-dihedral j1 j2 k = bq-make true
  (bin-mul (snd (qg-dot8 j1 j2 k)) (snd (qg-dot8 j1 j2 k)))
  (bin-mul (bin-pow2 2) (bin-mul (qg-area2 j1) (qg-area2 j2)))
