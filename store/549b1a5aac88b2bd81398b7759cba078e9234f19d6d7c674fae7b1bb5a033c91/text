-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10504 = tld in scmd (w-load ((b2-a mm_ t_10504))) (λ x_10503 → let mm_10505 = b2-dep mm_ x_10503 in let tg = (%wand x_10503 #255) in if (%weq tg b2-TADT) then (let t_10507 = tld in let j_10508 = #4 in scmd (w-load ((b2-a mm_10505 (%wadd t_10507 (%wadd #2 j_10508))))) (λ x_10506 → let mm_10509 = b2-dep mm_10505 x_10506 in let b = x_10506 in kq_ (h4-depl mm_10509 (b)))) else (let t_10511 = tld in let j_10512 = #5 in scmd (w-load ((b2-a mm_10505 (%wadd t_10511 (%wadd #2 j_10512))))) (λ x_10510 → let mm_10513 = b2-dep mm_10505 x_10510 in let b = x_10510 in kq_ (h4-depl mm_10513 (b))))))
