ga-star-cand : RProg
ga-star-cand =
  rprog #8 nil
    (cons (re-mul (re-v #0)
            (re-sub (re-add (ga-mul4 (re-v #5))
                            (re-add (ga-mul4 (re-v #6)) (ga-mul10 (re-v #7))))
                    (re-mul (re-v #1) (re-v #4))))
    (cons (re-k zi-zero)
    (cons (re-sub (re-k zi-zero) (re-v #4))
    (cons (re-v #6) nil))))
