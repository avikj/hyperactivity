<script>
// Lab 1: Exact Bias-Variance-Noise & Double Descent (Marchenko-Pastur / Ridge)
(function() {
  const stage = document.getElementById('bvStage');
  const canvas = document.getElementById('bvCanvas');
  if (!stage || !canvas) return;
  const ctx = canvas.getContext('2d');
  const slN = document.getElementById('bvN'), slLam = document.getElementById('bvLam'), slSig = document.getElementById('bvSig');
  const vN = document.getElementById('bvNV'), vLam = document.getElementById('bvLamV'), vSig = document.getElementById('bvSigV');
  const statusEl = document.getElementById('bvStatus');

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
    draw();
  }
  new ResizeObserver(resize).observe(stage);

  function bvAt(gamma, lam, sig) {
    // Exact Stieltjes transform of Marchenko-Pastur law for aspect ratio gamma = p/n (HMRT 2022)
    const z = Math.max(1e-6, lam);
    const eps = z * 1e-4 + 1e-9;
    const sq = Math.sqrt((1 - gamma + z) * (1 - gamma + z) + 4 * gamma * z);
    const ms = (-(1 - gamma + z) + sq) / (2 * gamma * z);
    const sq2 = Math.sqrt((1 - gamma + z + eps) * (1 - gamma + z + eps) + 4 * gamma * (z + eps));
    const ms2 = (-(1 - gamma + z + eps) + sq2) / (2 * gamma * (z + eps));
    const dms = (ms2 - ms) / eps;
    const variance = sig * sig * Math.max(0, gamma * (ms + z * dms));
    const approxBias = 0.55 * Math.exp(-1.7 * gamma);
    const shrinkBias = (1 - Math.exp(-1.7 * gamma)) * Math.max(0, z * z * (-dms));
    const bias2 = approxBias + shrinkBias;
    const noise = sig * sig;
    return { noise, bias2, variance, total: noise + bias2 + variance };
  }

  function draw() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;
    const dark = document.documentElement.classList.contains('dark');
    const ink = dark ? '#ffffff' : '#000000';
    const muted = dark ? '#999999' : '#555555';
    const grid = dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)';
    const pink = '#ff0a94';
    const blue = dark ? '#4da3ff' : '#1a73e8';

    const n = parseInt(slN.value, 10);
    const lam = Math.pow(10, parseFloat(slLam.value));
    const sig = parseFloat(slSig.value);
    vN.textContent = n;
    vLam.textContent = lam < 0.01 ? lam.toExponential(0) : lam.toFixed(2);
    vSig.textContent = sig.toFixed(2);

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const padL = 54, padR = 24, padT = 26, padB = 42;
    const pw = W - padL - padR, ph = H - padT - padB;
    const maxG = 2.8, maxY = 2.4;
    const tx = g => padL + (g / maxG) * pw;
    const ty = y => padT + ph - (Math.min(y, maxY) / maxY) * ph;

    ctx.strokeStyle = grid; ctx.lineWidth = 1;
    for (let y = 0.4; y <= maxY; y += 0.4) {
      ctx.beginPath(); ctx.moveTo(padL, ty(y)); ctx.lineTo(W - padR, ty(y)); ctx.stroke();
    }
    ctx.strokeStyle = ink; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + ph); ctx.lineTo(W - padR, padT + ph); ctx.stroke();

    ctx.save(); ctx.setLineDash([4, 4]); ctx.strokeStyle = pink; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(tx(1), padT); ctx.lineTo(tx(1), padT + ph); ctx.stroke();
    ctx.restore();
    ctx.fillStyle = pink; ctx.font = '700 10.5px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center';
    ctx.fillText('p = n (interpolation)', tx(1), padT - 8);

    const pts = [];
    for (let i = 0; i <= 260; i++) {
      const g = 0.04 + (i / 260) * (maxG - 0.04);
      pts.push({ g, ...bvAt(g, lam, sig) });
    }

    function plotLine(key, col, width, dash) {
      ctx.save(); ctx.strokeStyle = col; ctx.lineWidth = width;
      if (dash) ctx.setLineDash(dash);
      ctx.beginPath();
      pts.forEach((p, idx) => {
        const x = tx(p.g), y = ty(p[key]);
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke(); ctx.restore();
    }

    plotLine('noise', muted, 1.2, [3, 3]);
    plotLine('bias2', blue, 2, null);
    plotLine('variance', pink, 2, [5, 3]);
    plotLine('total', ink, 2.6, null);

    ctx.fillStyle = muted; ctx.font = '600 10.5px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    [0.5, 1.0, 1.5, 2.0, 2.5].forEach(g => ctx.fillText(`p/n=${g.toFixed(1)}`, tx(g), padT + ph + 16));
    ctx.fillText('Model capacity ratio p / n (n = ' + n + ')', padL + pw / 2, H - 8);
    ctx.textAlign = 'right';
    [0, 0.8, 1.6, 2.4].forEach(y => ctx.fillText(y.toFixed(1), padL - 8, ty(y) + 3));

    const lx = W - padR - 175, ly = padT + 8;
    const leg = [['Total MSE', ink], ['Bias²', blue], ['Variance', pink], ['Noise σ²', muted]];
    ctx.textAlign = 'left';
    leg.forEach(([nm, col], i) => {
      ctx.fillStyle = col; ctx.fillRect(lx, ly + i * 16, 12, 3);
      ctx.fillStyle = ink; ctx.fillText(nm, lx + 18, ly + i * 16 + 4);
    });

    const pAt1 = bvAt(1.0, lam, sig), pAt25 = bvAt(2.5, lam, sig);
    statusEl.textContent = `MSE(p=n)=${pAt1.total > 9 ? '>9' : pAt1.total.toFixed(2)} · MSE(p=2.5n)=${pAt25.total.toFixed(2)} · σ²=${(sig*sig).toFixed(2)}`;
  }

  slN.oninput = slLam.oninput = slSig.oninput = draw;
  document.getElementById('bvInterp').onclick = () => { slLam.value = -4.5; draw(); };
  document.getElementById('bvOpt').onclick = () => { slLam.value = -0.5; draw(); };
  const mo = new MutationObserver(draw);
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  resize();
})();

// Lab 2: RLHF Standpoint Marginalization & Exponential Minority Suppression
(function() {
  const stage = document.getElementById('rlhfStage');
  const canvas = document.getElementById('rlhfCanvas');
  if (!stage || !canvas) return;
  const ctx = canvas.getContext('2d');
  const slBeta = document.getElementById('rlhfBeta'), slMaj = document.getElementById('rlhfMaj');
  const vBeta = document.getElementById('rlhfBetaV'), vMaj = document.getElementById('rlhfMajV');
  const statusEl = document.getElementById('rlhfStatus');
  const btnSc = document.getElementById('rlhfModeScalar'), btnSt = document.getElementById('rlhfModeStand');
  let mode = 'scalar';

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
    draw();
  }
  new ResizeObserver(resize).observe(stage);

  function draw() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;
    const dark = document.documentElement.classList.contains('dark');
    const ink = dark ? '#ffffff' : '#000000';
    const muted = dark ? '#999999' : '#555555';
    const grid = dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)';
    const pink = '#ff0a94';
    const blue = dark ? '#4da3ff' : '#1a73e8';

    const beta = parseFloat(slBeta.value), pM = parseFloat(slMaj.value);
    vBeta.textContent = beta.toFixed(2);
    vMaj.textContent = pM.toFixed(2);

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const padL = 58, padR = 24, padT = 28, padB = 42;
    const pw = W - padL - padR, ph = H - padT - padB;
    const tx = b => padL + ((b - 0.05) / 0.95) * pw;
    const ty = r => padT + ph - Math.min(1, Math.max(0, r)) * ph;

    ctx.strokeStyle = grid; ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1.0].forEach(y => {
      ctx.beginPath(); ctx.moveTo(padL, ty(y)); ctx.lineTo(W - padR, ty(y)); ctx.stroke();
    });
    ctx.strokeStyle = ink; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + ph); ctx.lineTo(W - padR, padT + ph); ctx.stroke();

    const dr = Math.log((1 - pM) / Math.max(0.01, pM));
    const ratioAt = b => mode === 'scalar' ? Math.exp(dr / b) : 1.0;

    ctx.save(); ctx.setLineDash([4, 4]); ctx.strokeStyle = blue; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(padL, ty(1.0)); ctx.lineTo(W - padR, ty(1.0)); ctx.stroke();
    ctx.restore();

    ctx.strokeStyle = mode === 'scalar' ? pink : muted;
    ctx.lineWidth = mode === 'scalar' ? 2.6 : 1.3;
    ctx.beginPath();
    for (let i = 0; i <= 190; i++) {
      const b = 0.05 + (i / 190) * 0.95;
      const val = Math.exp(dr / b);
      const x = tx(b), y = ty(val);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    const curVal = ratioAt(beta);
    const cx = tx(beta), cy = ty(curVal);
    ctx.fillStyle = mode === 'scalar' ? pink : blue;
    ctx.beginPath(); ctx.arc(cx, cy, 6, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = ink; ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'left';
    ctx.fillText(mode === 'scalar' ? `π*(y_m)/π*(y_M) = ${curVal.toExponential(2)}` : 'π(y_m | x, u=m) preserved (1.00×)', Math.min(cx + 10, W - 260), Math.max(padT + 14, cy - 8));

    ctx.fillStyle = muted; ctx.font = '600 10.5px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    [0.1, 0.3, 0.5, 0.7, 0.9].forEach(b => ctx.fillText(`β=${b.toFixed(1)}`, tx(b), padT + ph + 16));
    ctx.fillText('KL temperature β (lower β = tighter RLHF / DPO fit)', padL + pw / 2, H - 8);
    ctx.textAlign = 'right';
    [0, 0.5, 1.0].forEach(y => ctx.fillText(y.toFixed(1) + '×', padL - 8, ty(y) + 3));

    statusEl.textContent = mode === 'scalar'
      ? `Scalar RLHF · Δr̂=${dr.toFixed(2)} · minority weight=${curVal < 0.001 ? curVal.toExponential(1) : curVal.toFixed(3)}×`
      : 'Standpoint-indexed π(y | x, u): zero minority suppression (1.00×)';
  }

  slBeta.oninput = slMaj.oninput = draw;
  btnSc.onclick = () => { mode = 'scalar'; btnSc.classList.add('on'); btnSt.classList.remove('on'); draw(); };
  btnSt.onclick = () => { mode = 'stand'; btnSt.classList.add('on'); btnSc.classList.remove('on'); draw(); };
  const mo = new MutationObserver(draw);
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  resize();
})();

// Lab 3: Observation-Fiber & Active-Querying Refinement
(function() {
  const stage = document.getElementById('fibStage');
  const canvas = document.getElementById('fibCanvas');
  if (!stage || !canvas) return;
  const ctx = canvas.getContext('2d');
  const statusEl = document.getElementById('fibStatus');
  const histories = [
    { id: 'h₀', safe: true,  a: 1, b: 1, c: 1 },
    { id: 'h₁', safe: true,  a: 1, b: 1, c: 0 },
    { id: 'h₂', safe: true,  a: 0, b: 1, c: 1 },
    { id: 'h₃', safe: true,  a: 0, b: 1, c: 0 },
    { id: 'h₄', safe: false, a: 1, b: 0, c: 1 },
    { id: 'h₅', safe: false, a: 1, b: 0, c: 0 },
    { id: 'h₆', safe: false, a: 0, b: 0, c: 1 },
    { id: 'h₇', safe: false, a: 0, b: 0, c: 0 },
  ];
  let qA = false, qB = false, qC = false;

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
    draw();
  }
  new ResizeObserver(resize).observe(stage);

  function compatible(h) {
    if (qA && h.a !== 1) return false;
    if (qB && h.b !== 1) return false;
    if (qC && h.c !== 1) return false;
    return true;
  }

  function updateUI() {
    document.getElementById('qA').classList.toggle('on', qA);
    document.getElementById('qB').classList.toggle('on', qB);
    document.getElementById('qC').classList.toggle('on', qC);
    const alive = histories.filter(compatible);
    const hasSafe = alive.some(h => h.safe), hasUnsafe = alive.some(h => !h.safe);
    if (hasSafe && hasUnsafe) {
      const s = alive.find(h => h.safe), u = alive.find(h => !h.safe);
      statusEl.textContent = `${alive.length} compatible histories · SPLIT WITNESS (${s.id} vs ${u.id})`;
    } else {
      statusEl.textContent = `${alive.length} compatible ${alive.length===1?'history':'histories'} · WARRANTED ACROSS ENTIRE FIBER`;
    }
    draw();
  }

  function draw() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;
    const dark = document.documentElement.classList.contains('dark');
    const ink = dark ? '#ffffff' : '#000000';
    const muted = dark ? '#777777' : '#888888';
    const pink = '#ff0a94';
    const blue = dark ? '#4da3ff' : '#1a73e8';

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const obsX = W * 0.16, obsY = H * 0.5;
    const colX = W * 0.56, resX = W * 0.85;
    const alive = histories.filter(compatible);
    const warranted = alive.every(h => h.safe);

    ctx.strokeStyle = ink; ctx.lineWidth = 2;
    ctx.strokeRect(obsX - 54, obsY - 26, 108, 52);
    ctx.fillStyle = ink; ctx.font = '700 12px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Obs y = o(h)', obsX, obsY - 3);
    ctx.font = '600 10px ui-monospace, Menlo, monospace'; ctx.fillStyle = muted;
    ctx.fillText(`|Fib| = ${alive.length}`, obsX, obsY + 14);

    histories.forEach((h, i) => {
      const y = 34 + i * ((H - 68) / 7);
      const ok = compatible(h);
      ctx.strokeStyle = ok ? (h.safe ? blue : pink) : (dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)');
      ctx.lineWidth = ok ? 1.8 : 1;
      ctx.beginPath(); ctx.moveTo(obsX + 54, obsY); ctx.lineTo(colX - 44, y); ctx.stroke();

      ctx.fillStyle = ok ? (h.safe ? blue : pink) : muted;
      ctx.globalAlpha = ok ? 1 : 0.35;
      ctx.strokeRect(colX - 44, y - 12, 88, 24);
      ctx.font = '700 11px ui-monospace, Menlo, monospace';
      ctx.fillText(`${h.id} · ${h.safe ? 'P' : '¬P'}`, colX, y + 4);
      ctx.globalAlpha = 1;

      if (ok) {
        ctx.strokeStyle = h.safe ? blue : pink; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.moveTo(colX + 44, y); ctx.lineTo(resX - 58, obsY); ctx.stroke();
      }
    });

    ctx.strokeStyle = warranted ? blue : pink; ctx.lineWidth = 2;
    ctx.strokeRect(resX - 58, obsY - 28, 116, 56);
    ctx.fillStyle = warranted ? blue : pink;
    ctx.font = '700 11.5px ui-monospace, Menlo, monospace';
    ctx.fillText(warranted ? 'WARRANTED' : 'BLOCKED', resX, obsY - 4);
    ctx.font = '600 10px ui-monospace, Menlo, monospace'; ctx.fillStyle = ink;
    ctx.fillText(warranted ? '∀h∈Fib, P(h)' : 'Split witness', resX, obsY + 13);
  }

  document.getElementById('qA').onclick = () => { qA = !qA; updateUI(); };
  document.getElementById('qB').onclick = () => { qB = !qB; updateUI(); };
  document.getElementById('qC').onclick = () => { qC = !qC; updateUI(); };
  document.getElementById('qReset').onclick = () => { qA = qB = qC = false; updateUI(); };
  const mo = new MutationObserver(draw);
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  resize(); updateUI();
})();

// Lab 4: Streaming rANS Renormalization & Exact Bit-Cost Register
(function() {
  const stage = document.getElementById('ransStage');
  const canvas = document.getElementById('ransCanvas');
  if (!stage || !canvas) return;
  const ctx = canvas.getContext('2d');
  const statusEl = document.getElementById('ransStatus');

  const M = 16, L = 256, B = 256;
  const SYMS = [
    { name: 'A', f: 8, C: 0,  info: 1.0 },
    { name: 'B', f: 4, C: 8,  info: 2.0 },
    { name: 'C', f: 3, C: 12, info: Math.log2(16 / 3) },
    { name: 'D', f: 1, C: 15, info: 4.0 },
  ];
  let s = L, bytes = [], hist = [], idealBits = 0, decoded = [];

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr));
    canvas.height = Math.max(1, Math.floor(r.height * dpr));
    draw();
  }
  new ResizeObserver(resize).observe(stage);

  function encodeSym(idx) {
    const sym = SYMS[idx];
    const maxS = Math.floor((L * B) / M) * sym.f;
    while (s >= maxS) {
      bytes.push(s & 0xff);
      s = Math.floor(s / B);
    }
    const q = Math.floor(s / sym.f), r = s % sym.f;
    s = q * M + sym.C + r;
    hist.push(sym.name);
    idealBits += sym.info;
    draw();
  }

  function decodeStep() {
    if (!hist.length) return;
    const slot = s % M;
    let sym = SYMS[0];
    for (const cand of SYMS) {
      if (slot >= cand.C && slot < cand.C + cand.f) { sym = cand; break; }
    }
    s = Math.floor(s / M) * sym.f + (slot - sym.C);
    while (s < L && bytes.length > 0) {
      s = s * B + bytes.pop();
    }
    hist.pop();
    idealBits = Math.max(0, idealBits - sym.info);
    decoded.push(sym.name);
    if (decoded.length > 18) decoded.shift();
    draw();
  }

  function draw() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = canvas.width / dpr, H = canvas.height / dpr;
    const dark = document.documentElement.classList.contains('dark');
    const ink = dark ? '#ffffff' : '#000000';
    const muted = dark ? '#999999' : '#555555';
    const pink = '#ff0a94';
    const blue = dark ? '#4da3ff' : '#1a73e8';

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const pad = 28;
    const barX = pad, barY = 58, barW = W - 2 * pad, barH = 38;
    ctx.strokeStyle = ink; ctx.lineWidth = 1.5;
    ctx.strokeRect(barX, barY, barW, barH);
    const frac = Math.max(0, Math.min(1, (Math.log2(s) - Math.log2(L)) / 8));
    ctx.fillStyle = pink;
    ctx.fillRect(barX + 1, barY + 1, Math.max(4, frac * (barW - 2)), barH - 2);

    ctx.fillStyle = ink; ctx.font = '700 12px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'left';
    ctx.fillText(`Active Register s = ${s}  (log₂ s = ${Math.log2(s).toFixed(2)} bits, window [256, 65536))`, barX, barY - 12);
    ctx.fillStyle = muted; ctx.font = '600 11px ui-monospace, Menlo, monospace';
    ctx.fillText('L = 256 (8 bits)', barX, barY + barH + 16);
    ctx.textAlign = 'right';
    ctx.fillText('256L = 65536 (16 bits → spill byte)', barX + barW, barY + barH + 16);

    ctx.textAlign = 'left'; ctx.fillStyle = ink; ctx.font = '700 12px ui-monospace, Menlo, monospace';
    ctx.fillText(`LIFO Spilled Bytes (${bytes.length} B):`, barX, 152);
    const showB = bytes.slice(-14);
    showB.forEach((b, i) => {
      const bx = barX + i * 44, by = 166;
      ctx.strokeStyle = blue; ctx.lineWidth = 1.4;
      ctx.strokeRect(bx, by, 38, 28);
      ctx.fillStyle = blue; ctx.font = '700 11px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('0x' + b.toString(16).padStart(2, '0').toUpperCase(), bx + 19, by + 18);
    });
    if (!showB.length) {
      ctx.fillStyle = muted; ctx.font = '600 11px ui-monospace, Menlo, monospace';
      ctx.fillText('(none spilled yet — register still inside [L, 256L))', barX, 184);
    }

    const actualBits = bytes.length * 8 + (Math.log2(s) - Math.log2(L));
    ctx.textAlign = 'left'; ctx.fillStyle = ink; ctx.font = '600 12px ui-monospace, Menlo, monospace';
    ctx.fillText(`Encoded stack (${hist.length}): ${hist.slice(-24).join(' ') || '∅'}`, barX, 236);
    ctx.fillStyle = muted;
    ctx.fillText(`Decoded (LIFO reverse): ${decoded.join(' ') || '∅'}`, barX, 260);
    ctx.fillStyle = pink; ctx.font = '700 12px ui-monospace, Menlo, monospace';
    ctx.fillText(`Actual stream: ${actualBits.toFixed(2)} bits   |   Exact Shannon Σ−log₂(f/M): ${idealBits.toFixed(2)} bits`, barX, 290);

    statusEl.textContent = `s=${s} · ${bytes.length} B spilled · actual=${actualBits.toFixed(2)}b vs entropy=${idealBits.toFixed(2)}b`;
  }

  document.querySelectorAll('[data-sym]').forEach(b => b.onclick = () => encodeSym(parseInt(b.dataset.sym, 10)));
  document.getElementById('ransDec').onclick = decodeStep;
  document.getElementById('ransReset').onclick = () => { s = L; bytes = []; hist = []; idealBits = 0; decoded = []; draw(); };
  const mo = new MutationObserver(draw);
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  resize();
})();
</script>
