b2-annwid : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-annwid mm_ zero anns j n w kq_ =
  kq_ (h4-depl mm_ (w))
b2-annwid mm_ (suc f) anns j n w kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (w))) else (let a_13503 = anns in let j_13504 = j in scmd (w-load ((b2-a mm_ (%wadd a_13503 (%wsucc j_13504))))) (λ x_13502 → let mm_13505 = b2-dep mm_ x_13502 in let a = x_13502 in if (%weq a #0) then (b2-annwid mm_13505 f anns (%wsucc j) n w kq_) else (let i_13507 = (%wadd a #1) in scmd (w-load ((b2-a mm_13505 i_13507))) (λ x_13506 → let mm_13508 = b2-dep mm_13505 x_13506 in let k = x_13506 in b2-nstr mm_13508 k (λ s → let mm_13509 = b2-dep mm_13508 s in let a_13511 = s in scmd (w-load ((b2-a mm_13509 a_13511))) (λ x_13510 → let mm_13512 = b2-dep mm_13509 x_13510 in let l = x_13510 in b2-annwid mm_13512 f anns (%wsucc j) n (the Word (if %wlt w l then l else w)) kq_))))))
