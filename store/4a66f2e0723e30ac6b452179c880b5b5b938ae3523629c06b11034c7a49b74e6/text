-- at s, opposite level > −a (p_f(−a) < 0, p_f′(−a) > 0); sharing level < −b (p_n(−(b+1)) < 0 < p_n(−b), p_n′(−b) > 0); a < b
bs-sep : Nat → Nat → Nat → Bool
bs-sep s a b = if bs-neg (bs-pf s a) then (if leb (suc 0) (bs-pf' s a)
  then (if bs-neg (bs-pn s (suc b)) then (if bs-pos (bs-pn s b) then (if leb (suc 0) (bs-pn' s b) then leb (suc a) b else false) else false) else false)
  else false) else false
