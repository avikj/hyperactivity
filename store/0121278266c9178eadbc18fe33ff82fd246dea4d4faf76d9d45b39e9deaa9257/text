-- 4-valent intertwiner dimension directly from triangle bounds: 0 if parity odd or amin > amax, else (amax - amin)/2 + 1.
qg-dim4 : List Bool → List Bool → List Bool → List Bool → List Bool
qg-dim4 j1 j2 j3 j4 =
  if bin-bit0 (bin-add (bin-add j1 j2) (bin-add j3 j4)) then nil
  else (if bin-leb (bvol-amin j1 j2 j3 j4) (bvol-amax j1 j2 j3 j4)
        then bin-succ (bin-half (bin-sub (bvol-amax j1 j2 j3 j4) (bvol-amin j1 j2 j3 j4)))
        else nil)
