e-letter-of : List Word → List (List Word) → List Word
e-letter-of n nil = nil
e-letter-of n (cons mk r) = if andB (h-eq (h-tail n) mk) (h-not (h-null n)) then
  (if weq (e-mark-cp (e-lc1 (e-head n)) mk) #0 then cons (e-head n) nil
   else e-utf8 (if e-upper (e-head n) then (if wlt (e-mark-cp (e-lc1 (e-head n)) mk) #256 then wsub (e-mark-cp (e-lc1 (e-head n)) mk) #32 else wsub (e-mark-cp (e-lc1 (e-head n)) mk) #1) else e-mark-cp (e-lc1 (e-head n)) mk))
  else e-letter-of n r
