-- a variable of the unit by its id: one with a constant initializer, one the unit's start-up
-- code initializes (cd-var-dynamic), or a specialization of a variable template
cx-find-var : List CDecl → Word → MRes CVar
cx-find-var nil i = mstop st-ill-typed
cx-find-var (cons d ds) i = case d of
  cd-var mangled v → (case weq (cx-var-id v) i of
    true → mok v
    false → cx-find-var ds i)
  cd-var-dynamic mangled v → (case weq (cx-var-id v) i of
    true → mok v
    false → cx-find-var ds i)
  cd-var-template-specialization args mangled v → (case weq (cx-var-id v) i of
    true → mok v
    false → cx-find-var ds i)
  _ → cx-find-var ds i
