b2-peek : Word → Word → (Word → Step W Word) → Step W Word
b2-peek mm_ p kq_ =
  b2-pstr mm_ p (λ s → let mm_6763 = b2-dep mm_ s in let p_6765 = p in let i_6767 = (%wadd p_6765 #1) in scmd (w-load ((b2-a mm_6763 i_6767))) (λ x_6766 → let mm_6768 = b2-dep mm_6763 x_6766 in let x_6764 = x_6766 in let i = x_6764 in b2-uat mm_6768 s i (λ c → let mm_6769 = b2-dep mm_6768 c in kq_ (h4-depl mm_6769 (c)))))
