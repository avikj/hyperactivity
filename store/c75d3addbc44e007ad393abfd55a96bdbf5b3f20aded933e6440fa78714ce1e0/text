b2-peek : Word → Word → (Word → Step W Word) → Step W Word
b2-peek mm_ p kq_ =
  b2-pstr mm_ p (λ s → let mm_6497 = b2-dep mm_ s in let p_6499 = p in let i_6501 = (%wadd p_6499 #1) in scmd (w-load ((b2-a mm_6497 i_6501))) (λ x_6500 → let mm_6502 = b2-dep mm_6497 x_6500 in let x_6498 = x_6500 in let i = x_6498 in b2-uat mm_6502 s i (λ c → let mm_6503 = b2-dep mm_6502 c in kq_ (h4-depl mm_6503 (c)))))
