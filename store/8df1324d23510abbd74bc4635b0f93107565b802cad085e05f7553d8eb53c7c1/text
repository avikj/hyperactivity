b2-pterms : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pterms mm_ zero xs ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-pterms mm_ (suc f) xs ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_6201 = xs in let j_6202 = j in scmd (w-load ((b2-a mm_ (%wadd a_6201 (%wsucc j_6202))))) (λ x_6200 → let mm_6203 = b2-dep mm_ x_6200 in let x = x_6200 in b2-pterm mm_6203 x #0 (λ t → let mm_6204 = b2-dep mm_6203 t in let a_6205 = ob in let j_6206 = j in let v_6207 = t in scmd (w-store ((b2-a mm_6204 (%wadd a_6205 (%wsucc j_6206)))) (v_6207)) (λ uu_6208 → let mm_6209 = hv2-u mm_6204 uu_6208 in b2-pterms mm_6209 f xs ob (%wsucc j) n kq_))))
