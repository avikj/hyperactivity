b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6556 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6556 (k))) else (b2-nbytes mm_6556 ns (λ nb → let mm_6557 = b2-dpl mm_6556 nb in b2-nbytes mm_6557 k (λ kb → let mm_6558 = b2-dpl mm_6557 kb in b2-nm mm_6558 (list-append nb (cons #58 kb)) (λ r → let mm_6559 = b2-dep mm_6558 r in kq_ (h4-depl mm_6559 (r)))))))
