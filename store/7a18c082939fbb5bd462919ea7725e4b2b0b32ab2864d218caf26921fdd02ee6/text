b2-appsg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-appsg mm_ zero t xs j n s kq_ =
  kq_ (h4-depl mm_ (t))
b2-appsg mm_ (suc f) t xs j n s kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (t))) else (let a_6866 = xs in let j_6867 = j in scmd (w-load ((b2-a mm_ (%wadd a_6866 (%wsucc j_6867))))) (λ x_6865 → let mm_6868 = b2-dep mm_ x_6865 in let x = x_6865 in b2-App mm_6868 t x s (λ g → let mm_6869 = b2-dep mm_6868 g in b2-appsg mm_6869 f g xs (%wsucc j) n s kq_)))
