stat-css = "*{box-sizing:border-box} :root{--bg:#fff;--fg:#000;--mut:rgba(0,0,0,.55);--soft:rgba(0,0,0,.06);--pink:#ff0a94;--pinkbg:rgba(255,10,148,.13)} @media(prefers-color-scheme:dark){:root{--bg:#000;--fg:#fff;--mut:rgba(255,255,255,.58);--soft:rgba(255,255,255,.08);--pinkbg:rgba(255,10,148,.22)}} body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.45 -apple-system,BlinkMacSystemFont,'Helvetica Neue',Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased} ::selection{background:var(--pink);color:#fff} a{color:inherit;text-decoration:none} a:hover{color:var(--pink)} nav{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:13px 24px;background:var(--bg);border-bottom:2px solid var(--fg);font:600 13px/1.2 ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:.03em;flex-wrap:wrap} nav .mark{font-weight:800} nav .tag{color:var(--pink);margin-left:8px} nav .r{display:flex;align-items:center;gap:14px;flex-wrap:wrap} nav button{font:inherit;background:none;border:2px solid var(--fg);color:var(--fg);padding:4px 10px;cursor:pointer;text-transform:lowercase} nav button:hover{background:var(--pink);border-color:var(--pink);color:#fff} .wrap{max-width:1120px;margin:0 auto;padding:28px 24px 96px} .bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px} .grp{display:inline-flex;border:2px solid var(--fg)} .grp button{font:700 12px ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:.05em;background:none;border:0;border-right:2px solid var(--fg);color:var(--fg);padding:7px 13px;cursor:pointer;text-transform:uppercase} .grp button:last-child{border-right:0} .grp button.on{background:var(--fg);color:var(--bg)} .grp button:hover:not(.on){color:var(--pink)} .chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px} .chip{display:inline-flex;align-items:center;gap:8px;border:2px solid var(--pink);padding:4px 10px;font:700 12px ui-monospace,'SF Mono',Menlo,monospace;color:var(--pink);cursor:pointer} .chip:hover{background:var(--pink);color:#fff} .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px} .kpi{border:2px solid var(--fg);padding:18px 18px 16px} .kpi .l{font:700 11px ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);display:flex;align-items:center;gap:7px} .kpi .v{font:800 38px/1.05 ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:-.03em;margin:10px 0 6px} .kpi .s{font:500 12px ui-monospace,'SF Mono',Menlo,monospace;color:var(--mut)} .kpi.live{border-color:var(--pink)} .kpi.live .l{color:var(--pink)} .dot{width:8px;height:8px;background:var(--pink);display:inline-block;animation:p 1.6s infinite} @keyframes p{0%,100%{opacity:1}50%{opacity:.2}} .box{border:2px solid var(--fg);padding:18px;margin-bottom:20px} .bh{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:14px;padding-bottom:10px;border-bottom:2px solid var(--fg)} .bt{font:700 12px ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--pink)} .bm{font:600 12px ui-monospace,'SF Mono',Menlo,monospace;color:var(--mut)} .leg{display:inline-flex;gap:14px;align-items:center;font:600 11px ui-monospace,'SF Mono',Menlo,monospace} .sw{display:inline-block;width:10px;height:10px;margin-right:5px;vertical-align:-1px} .chart{width:100%;height:210px;display:block;overflow:visible} .grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px} .rows{display:flex;flex-direction:column} .row{position:relative;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 8px;border-bottom:1px solid var(--soft);cursor:pointer;overflow:hidden} .row:last-child{border-bottom:0} .row:hover{background:var(--soft)} .row .fill{position:absolute;left:0;top:0;bottom:0;background:var(--pinkbg);pointer-events:none} .row .nm{position:relative;font:600 13px ui-monospace,'SF Mono',Menlo,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1} .row .open{position:relative;font:700 12px ui-monospace,'SF Mono',Menlo,monospace;color:var(--mut);padding:0 4px} .row .open:hover{color:var(--pink)} .row .num{position:relative;font:700 13px ui-monospace,'SF Mono',Menlo,monospace;white-space:nowrap} .row .sub{font-weight:500;color:var(--mut);margin-left:8px;font-size:12px} .devbar{display:flex;height:14px;border:2px solid var(--fg);margin:10px 0 12px;overflow:hidden} .devstats{display:flex;gap:20px;flex-wrap:wrap;font:600 12px ui-monospace,'SF Mono',Menlo,monospace} .feed{width:100%;border-collapse:collapse;font:13px ui-monospace,'SF Mono',Menlo,monospace} .feed th{text-align:left;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);padding:6px 8px;border-bottom:2px solid var(--fg)} .feed td{padding:8px;border-bottom:1px solid var(--soft);vertical-align:middle} .feed tr:hover td{background:var(--soft)} .clk{cursor:pointer} .clk:hover{color:var(--pink)} .pill{display:inline-block;padding:2px 6px;font:700 11px ui-monospace,'SF Mono',Menlo,monospace;color:#fff;cursor:pointer} .empty{padding:36px 12px;text-align:center;font:600 13px ui-monospace,'SF Mono',Menlo,monospace;color:var(--mut)} .meta{font:12px ui-monospace,'SF Mono',Menlo,monospace;color:var(--mut);margin-top:24px} @media(max-width:820px){.kpis{grid-template-columns:repeat(2,1fr)} .grid2{grid-template-columns:1fr}} @media(max-width:520px){.wrap{padding:18px 14px 72px} .kpi .v{font-size:28px} nav{padding:11px 14px}}"
