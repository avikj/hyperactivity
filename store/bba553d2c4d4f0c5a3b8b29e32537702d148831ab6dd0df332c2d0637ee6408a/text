data OsEffect
  = eff-view (ed : OsEdition) (dp : OsDepth) (fl : OsField) (fontPx : Word)
  | eff-accent (hex : List Word)
  | eff-inspect (path : List Word) (split : Bool)
  | eff-verify (path : List Word)
  | eff-mount-note (title : List Word) (body : List Word)
  | eff-mount-inet (title : List Word) (nPairs : Word)
  | eff-mount-app (title : List Word) (html : List Word)
  | eff-mount-ui (title : List Word) (tree : UiTree)
  | eff-daw (d : DawEffect)
  | eff-scroll (query : List Word)
  | eff-nav (route : List Word)
  | eff-reset
  | eff-seq (a : OsEffect) (b : OsEffect)
