b2-acopy : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-acopy mm_ zero src dst j off n kq_ =
  kq_ (h4-depl mm_ (dst))
b2-acopy mm_ (suc f) src dst j off n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (dst))) else (let a_3120 = src in let j_3121 = j in scmd (w-load ((b2-a mm_ (%wadd a_3120 (%wsucc j_3121))))) (λ x_3119 → let mm_3122 = b2-dep mm_ x_3119 in let x = x_3119 in let a_3123 = dst in let j_3124 = (%wadd off j) in let v_3125 = x in scmd (w-store ((b2-a mm_3122 (%wadd a_3123 (%wsucc j_3124)))) (v_3125)) (λ uu_3126 → let mm_3127 = hv2-u mm_3122 uu_3126 in b2-acopy mm_3127 f src dst (%wsucc j) off n kq_)))
