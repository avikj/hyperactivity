-- strip: a forced Var steps into its value, an Ann into its term
b2-stripg : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-stripg mm_ zero t kq_ =
  kq_ (h4-depl mm_ (t))
b2-stripg mm_ (suc f) t kq_ =
  if (%weq t #0) then (kq_ (h4-depl mm_ (t))) else (let t_705 = t in scmd (w-load ((b2-a mm_ t_705))) (λ x_704 → let mm_706 = b2-dep mm_ x_704 in let tg = (%wand x_704 #255) in if (%weq tg b2-VAR) then (let t_708 = t in let j_709 = #2 in scmd (w-load ((b2-a mm_706 (%wadd t_708 (%wadd #2 j_709))))) (λ x_707 → let mm_710 = b2-dep mm_706 x_707 in let v = x_707 in if (%weq v #0) then (kq_ (h4-depl mm_710 (t))) else (b2-stripg mm_710 f v kq_))) else (if (%weq tg b2-ANN) then (let t_712 = t in let j_713 = #0 in scmd (w-load ((b2-a mm_706 (%wadd t_712 (%wadd #2 j_713))))) (λ x_711 → let mm_714 = b2-dep mm_706 x_711 in let x = x_711 in b2-stripg mm_714 f x kq_)) else (kq_ (h4-depl mm_706 (t))))))
