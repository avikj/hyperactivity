-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10180 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10180))) (λ x_10179 → let mm_10181 = b2-dep mm_ x_10179 in let lb = x_10179 in if (%weq lb #0) then (let i_10183 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10181 i_10183))) (λ x_10182 → let mm_10184 = b2-dep mm_10181 x_10182 in let t = x_10182 in kq_ (h4-depl mm_10184 (t)))) else (let i_10186 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10181 i_10186))) (λ x_10185 → let mm_10187 = b2-dep mm_10181 x_10185 in let lx = x_10185 in b2-body mm_10187 bk lb lx (λ r → let mm_10188 = b2-dep mm_10187 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10188 b2-ERR)) else (kq_ (h4-depl mm_10188 (r)))))))
