b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_7031 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_7031 (k))) else (b2-nbytes mm_7031 ns (λ nb → let mm_7032 = b2-dpl mm_7031 nb in b2-nbytes mm_7032 k (λ kb → let mm_7033 = b2-dpl mm_7032 kb in b2-nm mm_7033 (list-append nb (cons #58 kb)) (λ r → let mm_7034 = b2-dep mm_7033 r in kq_ (h4-depl mm_7034 (r)))))))
