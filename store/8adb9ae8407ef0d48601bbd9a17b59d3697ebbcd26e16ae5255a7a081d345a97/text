b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10909 = xs in scmd (w-load ((b2-a mm_ a_10909))) (λ x_10908 → let mm_10910 = b2-dep mm_ x_10908 in let n = x_10908 in if (%weq j n) then (kq_ (h4-depl mm_10910 (h))) else (let a_10912 = xs in let j_10913 = j in scmd (w-load ((b2-a mm_10910 (%wadd a_10912 (%wsucc j_10913))))) (λ x_10911 → let mm_10914 = b2-dep mm_10910 x_10911 in let x = x_10911 in b2-tapp mm_10914 bk h x #0 (λ h2 → let mm_10915 = b2-dep mm_10914 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10915 b2-ERR)) else (b2-applyall mm_10915 f bk h2 xs (%wsucc j) kq_)))))
