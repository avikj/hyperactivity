stat-line : Word → List Word → List Word → List Word → Bool → List Word → List Word
stat-line ts path vh ref bot kind =
  h-concat (cons (h-decimal ts) (cons stat-tab (cons path (cons stat-tab (cons vh (cons stat-tab (cons ref (cons stat-tab (cons (if bot then "1" else "0") (cons stat-tab (cons kind (cons (cons #10 nil) nil))))))))))))
