-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10546 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10546))) (λ x_10545 → let mm_10547 = b2-dep mm_ x_10545 in let lb = x_10545 in if (%weq lb #0) then (let i_10549 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10547 i_10549))) (λ x_10548 → let mm_10550 = b2-dep mm_10547 x_10548 in let t = x_10548 in kq_ (h4-depl mm_10550 (t)))) else (let i_10552 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10547 i_10552))) (λ x_10551 → let mm_10553 = b2-dep mm_10547 x_10551 in let lx = x_10551 in b2-body mm_10553 bk lb lx (λ r → let mm_10554 = b2-dep mm_10553 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10554 b2-ERR)) else (kq_ (h4-depl mm_10554 (r)))))))
