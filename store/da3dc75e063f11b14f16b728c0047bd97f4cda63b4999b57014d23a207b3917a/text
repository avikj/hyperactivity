sc-c4-pairs-b2 : Nat → Nat → List (Nat × Nat) → List QmolState
sc-c4-pairs-b2 p1 p2 ps = case ps of
  nil → nil
  cons pr rest → qmol-append-st
    (sc-c4-ring-n0 p1 p2 (fst pr) (snd pr)
      (qmol-charge2 BZ bz-zero bz-one bz-add bz-neg 0 p1 p2 (fst pr) (snd pr))
      (qmol-charge2 BZ bz-zero bz-one bz-add bz-neg 1 p1 p2 (fst pr) (snd pr))
      (qmol-charge2 BZ bz-zero bz-one bz-add bz-neg 2 p1 p2 (fst pr) (snd pr))
      sc-range-b2)
    (sc-c4-pairs-b2 p1 p2 rest)
