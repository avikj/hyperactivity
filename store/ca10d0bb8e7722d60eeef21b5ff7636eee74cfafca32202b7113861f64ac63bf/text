vph-mac-bench-p2 : List Word
vph-mac-bench-p2 =
  sl-ln "    const uint32_t W = 1920u, H = 1824u;"
  (sl-ln "    MTLTextureDescriptor* cd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float width:W height:H mipmapped:NO];"
  (sl-ln "    cd.textureType = MTLTextureType2DArray; cd.arrayLength = 2; cd.usage = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead;"
  (sl-ln "    MTLTextureDescriptor* dd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Float width:W height:H mipmapped:NO];"
  (sl-ln "    dd.textureType = MTLTextureType2DArray; dd.arrayLength = 2; dd.usage = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead;"
  (sl-ln "    id<MTLTexture> cTex = [dev newTextureWithDescriptor:cd], dTex = [dev newTextureWithDescriptor:dd];"
  (sl-ln "    HxVpSensorIn s = {0}; s.head_pos[2] = 0.0f; s.head_vel[0] = 0.5f; s.desk_y = -0.4f;"
  (sl-ln "    s.l_tips[0][0] = 0.008f; s.l_tips[1][0] = 0.05f; s.l_tips[2][0] = 0.05f; s.l_tips[3][0] = 0.05f;"
  (sl-ln "    s.r_tips[0][0] = 0.006f; s.r_tips[1][0] = 0.05f; s.r_tips[2][0] = 0.05f; s.r_tips[3][0] = 0.05f;"
  (sl-ln "    HxVpFrameOut fo = {0}; float audL[512], audR[512]; uint32_t ph = 0u;"
  (sl-ln "    double best_e2e = 1e9;"
  (sl-ln "    for (int it = 0; it < 15; it++) {"
  (sl-ln "      double t0 = now_s();"
  (sl-ln "      hx_vp_sensor_step(&s, 0.011f, &fo); s.prev_l_chord = fo.l_chord; s.prev_r_chord = fo.r_chord;"
  (sl-ln "      hx_vp_render_binaural_48k(fo.tonnetz_triad, 2u, &ph, audL, audR, 512u); // 10.67ms 48kHz audio!"
  (sl-ln "      HxVpUniforms u = { { matrix_identity_float4x4, matrix_identity_float4x4 }, {fo.head_pred[0],fo.head_pred[1],fo.head_pred[2],1}, {-0.15f,0,-0.45f,(float)fo.l_chord}, {0.15f,0,-0.45f,(float)fo.r_chord}, {0,1,0,fo.clamped_y}, {1u,1u,fo.tonnetz_triad,fo.bimanual_cmd} };"
  (sl-ln "      id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
  (sl-ln "      [enc setComputePipelineState:pso]; [enc setTexture:cTex atIndex:0]; [enc setTexture:dTex atIndex:1];"
  (sl-ln "      [enc setBytes:&u length:sizeof(u) atIndex:0];"
  (sl-ln "      [enc dispatchThreads:MTLSizeMake(W, H, 2) threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];"
  (sl-ln "      [enc endEncoding]; [cb commit]; [cb waitUntilCompleted];"
  (sl-ln "      double dt = now_s() - t0; if (it > 0 && dt < best_e2e) best_e2e = dt;"
  (sl-ln "    }"
  (sl-ln "    int ok = (boot_rc == 0 && fo.bimanual_cmd == 17u && (fo.kernel_word_out ^ 1ULL) == fo.tonnetz_triad && best_e2e < 0.011111);"
  (sl-ln (list-append "    printf(" (list-append sl-q (list-append "[HX-VISIONPRO-HYPERVISOR-E2E] device=%s | libcubical_inproc_boot=%d | cubical_call_w_tonnetzP=(%u->%llu) | bimanual_zoom=0x%X | 48kHz_audio=512f | stereo_hdr_revZ=3840x1824 | full_e2e=%.3f ms (%.0f Hz, <11.11ms_90Hz=%d) | ok=%d" (list-append sl-esc-n (list-append sl-q ", [[dev name] UTF8String], boot_rc, fo.tonnetz_triad, (unsigned long long)fo.kernel_word_out, fo.bimanual_cmd, best_e2e*1e3, 1.0/best_e2e, best_e2e < 0.011111, ok);")))))
  (sl-ln "    return ok ? 0 : 1;"
  (sl-ln "  }"
  (sl-ln "}" nil)))))))))))))))))))))))))))
