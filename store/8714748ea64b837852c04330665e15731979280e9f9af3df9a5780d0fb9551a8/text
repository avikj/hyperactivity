-- the same table, each row a word of eight four-bit entries (what the machine reads)
hv2-roww : Word → Word
hv2-roww t =
  if %weq t #0 then #0 else if %weq t #1 then #286335520 else if %weq t #2 then #858989088
  else if %weq t #3 then #1983062560 else if %weq t #4 then #1431581456 else if %weq t #5 then #1430598416
  else if %weq t #6 then #1414882064 else #1163227920
