b2-pget : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-pget mm_ zero mp k kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-pget mm_ (suc f) mp k kq_ =
  if (%weq mp #0) then (kq_ (h4-depl mm_ (hv2-none))) else (if (%weq k #0) then (let i_347 = mp in scmd (w-load ((b2-a mm_ i_347))) (λ x_346 → let mm_348 = b2-dep mm_ x_346 in let h = x_346 in if (%weq h #0) then (kq_ (h4-depl mm_348 (hv2-none))) else (let i_350 = (%wadd mp #1) in scmd (w-load ((b2-a mm_348 i_350))) (λ x_349 → let mm_351 = b2-dep mm_348 x_349 in let v = x_349 in kq_ (h4-depl mm_351 (v)))))) else (let odd = %weq (%wmod k #2) #1 in let i_353 = (%wadd mp (the Word (if odd then #2 else #3))) in scmd (w-load ((b2-a mm_ i_353))) (λ x_352 → let mm_354 = b2-dep mm_ x_352 in let nx = x_352 in b2-pget mm_354 f nx (the Word (if odd then %wdiv (%wsub k #1) #2 else %wdiv (%wsub k #2) #2)) kq_)))
