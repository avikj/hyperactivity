vpf-ota-deploy-sh-q3 =
  vpf-lines-q
    (cons "    pass"
    (cons "PY"
    (cons ")`"
    (cons "  VP_CORE_ID=`$(printf `%s` `$VP_IDS` | awk '{print $1}')`"
    (cons "  VP_HW_UDID=`$(printf `%s` `$VP_IDS` | awk '{print $2}')`"
