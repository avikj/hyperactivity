sf-eprl-fold1 : Nat → Nat → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → BQ → BQ
sf-eprl-fold1 Jp Jm opts1 opts2 opts3 opts4 opts5 acc = case opts1 of
  nil → acc
  cons o1 rest1 →
    sf-eprl-fold1 Jp Jm rest1 opts2 opts3 opts4 opts5
      (sf-eprl-fold2 Jp Jm (fst o1) (fst (snd o1)) (snd (snd o1)) opts2 opts3 opts4 opts5 acc)
