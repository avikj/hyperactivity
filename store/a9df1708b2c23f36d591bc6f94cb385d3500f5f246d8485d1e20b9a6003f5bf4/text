h4-qup : Word → Nat → Word → (Word → Step W Word) → Step W Word
h4-qup mm_ zero i kq_ =
  kq_ (h4-depl mm_ (#0))
h4-qup mm_ (suc f) i kq_ =
  if (%weq i #0) then (kq_ (h4-depl mm_ (#0))) else (let p = %wdiv (%wsub i #1) #2 in h4-qlt mm_ i p (λ lt → let mm_3131 = h4-dpb mm_ lt in if (not lt) then (kq_ (h4-depl mm_3131 (#0))) else (h4-qswap mm_3131 i p (λ dd_3132 → let mm_3133 = h4-dep mm_3131 dd_3132 in h4-qup mm_3133 f p kq_))))
