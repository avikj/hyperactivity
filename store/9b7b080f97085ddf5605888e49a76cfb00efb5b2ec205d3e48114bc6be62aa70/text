h4-spine : Word → Nat → Word → Word → (Word × Word → Step W Word) → Step W Word
h4-spine mm_ zero t n kq_ =
  kq_ (h4-depl mm_ ((n , t)))
h4-spine mm_ (suc f) t n kq_ =
  if (andB (%wlt n #256) (orB (%weq (h4-tag t) h4-APP) (%weq (h4-tag t) h4-DRY))) then (scmd (w-load ((h4-ha mm_ (h4-val t)))) (λ x → let mm_2797 = h4-dep mm_ x in h4-spine mm_2797 f x (%wsucc n) kq_)) else (kq_ (h4-depl mm_ ((n , t))))
