-- Commutative semiring bundle (z, add, mul):
--   (add-zl, add-zr, add-assoc, add-comm, mul-zl, mul-zr, mul-assoc, mul-comm, ldist, rdist)
QentSR : (A : Type) → A → (A → A → A) → (A → A → A) → Type
QentSR A z add mul =
  ((x : A) → add z x ≡ x) ×
  (((x : A) → add x z ≡ x) ×
  (((x y w : A) → add (add x y) w ≡ add x (add y w)) ×
  (((x y : A) → add x y ≡ add y x) ×
  (((x : A) → mul z x ≡ z) ×
  (((x : A) → mul x z ≡ z) ×
  (((x y w : A) → mul (mul x y) w ≡ mul x (mul y w)) ×
  (((x y : A) → mul x y ≡ mul y x) ×
  (((x y w : A) → mul x (add y w) ≡ add (mul x y) (mul x w)) ×
  ((x y w : A) → mul (add x y) w ≡ add (mul x w) (mul y w))))))))))
