b2-tfillg : Word → Nat → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tfillg mm_ zero bk tel xs ctx def s j kq_ =
  kq_ (h4-depl mm_ (tel))
b2-tfillg mm_ (suc f) bk tel xs ctx def s j kq_ =
  let a_9900 = xs in scmd (w-load ((b2-a mm_ a_9900))) (λ x_9899 → let mm_9901 = b2-dep mm_ x_9899 in let n = x_9899 in if (%weq j n) then (kq_ (h4-depl mm_9901 (tel))) else (b2-thead mm_9901 bk tel ctx def s (λ h → let mm_9902 = b2-dep mm_9901 h in if (%weq h b2-ERR) then (kq_ (h4-depl mm_9902 b2-ERR)) else (let t_9904 = h in let j_9905 = #4 in scmd (w-load ((b2-a mm_9902 (%wadd t_9904 (%wadd #2 j_9905))))) (λ x_9903 → let mm_9906 = b2-dep mm_9902 x_9903 in let vB = x_9903 in let a_9908 = xs in let j_9909 = j in scmd (w-load ((b2-a mm_9906 (%wadd a_9908 (%wsucc j_9909))))) (λ x_9907 → let mm_9910 = b2-dep mm_9906 x_9907 in let x = x_9907 in b2-body mm_9910 bk vB x (λ t2 → let mm_9911 = b2-dep mm_9910 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_9911 b2-ERR)) else (b2-tfillg mm_9911 f bk t2 xs ctx def s (%wsucc j) kq_))))))))
