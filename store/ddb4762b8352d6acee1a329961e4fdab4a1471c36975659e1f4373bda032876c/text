sf-ninej-W : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-ninej-W j1 j2 j3 j4 j5 j6 j7 j8 j9 =
  if both (both (both (tri-ok j1 j2 j3) (tri-ok j4 j5 j6)) (both (tri-ok j7 j8 j9) (tri-ok j1 j4 j7)))
          (both (tri-ok j2 j5 j8) (tri-ok j3 j6 j9))
  then sf-ninej-loop (suc (nat-min (plus j1 j9) (nat-min (plus j4 j8) (plus j2 j6))))
         j1 j2 j3 j4 j5 j6 j7 j8 j9 bq-zero
  else bq-zero
