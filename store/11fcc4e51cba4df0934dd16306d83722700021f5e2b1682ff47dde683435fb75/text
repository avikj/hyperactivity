-- Section (2): Quantum tetrahedron dihedral angles and closure.
-- In the recoupling state |K> of faces (J1, J2, J3, J4) (all doubled spins),
-- 8 (J_1 . J_2) = K(K+2) - J1(J1+2) - J2(J2+2) as an exact signed binary integer BZ.
qg-dot8 : List Bool → List Bool → List Bool → BZ
qg-dot8 j1 j2 k = bz-add (bz-of (qg-area2 k)) (bz-neg (bz-of (bin-add (qg-area2 j1) (qg-area2 j2))))
