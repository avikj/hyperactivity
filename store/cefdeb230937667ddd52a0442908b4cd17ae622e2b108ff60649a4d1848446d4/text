b2-replg : Word → Nat → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-replg mm_ zero vs v w ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-replg mm_ (suc f) vs v w ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_6996 = vs in let j_6997 = j in scmd (w-load ((b2-a mm_ (%wadd a_6996 (%wsucc j_6997))))) (λ x_6995 → let mm_6998 = b2-dep mm_ x_6995 in let u = x_6995 in let a_6999 = ob in let j_7000 = j in let v_7001 = (the Word (if %weq u v then w else u)) in scmd (w-store ((b2-a mm_6998 (%wadd a_6999 (%wsucc j_7000)))) (v_7001)) (λ uu_7002 → let mm_7003 = hv2-u mm_6998 uu_7002 in b2-replg mm_7003 f vs v w ob (%wsucc j) n kq_)))
