-- Full exact rational 2-simplex BF amplitude for symmetric equilateral boundary (all spins J, i' = i):
sf2-bf-two-diag : Nat → Nat → Nat → Nat → Nat → BQ
sf2-bf-two-diag J i1 i2 i3 i4 =
  bq-mul
    (bq-mul (sf-bq-of-nat (times (times (suc i1) (suc i2)) (times (suc i3) (suc i4))))
            (bq-mul (bq-mul (bq-mul (sf-delta2 J J i1) (sf-delta2 J J i1))
                            (bq-mul (sf-delta2 J J i2) (sf-delta2 J J i2)))
                    (bq-mul (bq-mul (sf-delta2 J J i3) (sf-delta2 J J i3))
                            (bq-mul (sf-delta2 J J i4) (sf-delta2 J J i4)))))
    (sf2-bf-two-R J J J J J J J J J J i1 i2 i3 i4 i1 i2 i3 i4)
