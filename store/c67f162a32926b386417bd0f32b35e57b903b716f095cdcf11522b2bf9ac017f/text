-- Exact verification across ALL 1,600 (s, m) pairs in [1..40] x [1..40] (0 postulates!)
rh-all-pairs-go : Nat → Word → Word → (Word → Word → Bool) → Bool
rh-all-pairs-go zero _ _ _ = true
rh-all-pairs-go (suc rem) s maxm p =
  if rz-all-upto maxm (λ m → p s m) then rh-all-pairs-go rem (%wsucc s) maxm p else false
