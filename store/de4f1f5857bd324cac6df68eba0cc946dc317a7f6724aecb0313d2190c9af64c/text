-- Strict gain witness at p=3, a=8: classical floor(8/3)+floor(8/27) = 2,
-- whereas smooth CM bound floor(8*3 / 8) = 3 (+1 extra power of 3 with zero floor loss!)
rh-thm-lemniscate-strict-gain :
  andB (%weq (rh-odd-floor-sum #8 #3) #2)
       (%weq (rh-cm-lemniscate-vp #8 #3) #3) ≡ true
rh-thm-lemniscate-strict-gain = refl
