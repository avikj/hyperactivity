b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6636 = b2-dep mm_ c in let p_6638 = p in let i_6640 = (%wadd p_6638 #1) in scmd (w-load ((b2-a mm_6636 i_6640))) (λ x_6639 → let mm_6641 = b2-dep mm_6636 x_6639 in let x_6637 = x_6639 in let i = x_6637 in let p_6642 = p in let v_6643 = (%wsucc i) in let i_6644 = (%wadd p_6642 #1) in let v_6645 = v_6643 in scmd (w-store ((b2-a mm_6641 i_6644)) (v_6645)) (λ uu_6646 → let mm_6647 = hv2-u mm_6641 uu_6646 in kq_ (h4-depl mm_6647 (c)))))
