b2-nlcount : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-nlcount mm_ zero s j e cnt ls kq_ =
  kq_ (h4-depl mm_ (cnt))
b2-nlcount mm_ (suc f) s j e cnt ls kq_ =
  if (%weq j e) then (let a_13003 = cnt in let b_13004 = ls in let c_13005 = #0 in let n_13007 = #3 in scmd (w-load (mm_)) (λ at_13006 → let mm_13008 = b2-dep mm_ at_13006 in scmd (w-store (mm_13008) ((%wadd at_13006 n_13007))) (λ uu_13009 → let mm_13010 = hv2-u mm_13008 uu_13009 in let at_13002 = at_13006 in let i_13011 = at_13002 in let v_13012 = a_13003 in scmd (w-store ((b2-a mm_13010 i_13011)) (v_13012)) (λ uu_13013 → let mm_13014 = hv2-u mm_13010 uu_13013 in let i_13015 = (%wadd at_13002 #1) in let v_13016 = b_13004 in scmd (w-store ((b2-a mm_13014 i_13015)) (v_13016)) (λ uu_13017 → let mm_13018 = hv2-u mm_13014 uu_13017 in let i_13019 = (%wadd at_13002 #2) in let v_13020 = c_13005 in scmd (w-store ((b2-a mm_13018 i_13019)) (v_13020)) (λ uu_13021 → let mm_13022 = hv2-u mm_13018 uu_13021 in let r = at_13002 in kq_ (h4-depl mm_13022 (r)))))))) else (let a_13024 = s in let j_13025 = j in scmd (w-load ((b2-a mm_ (%wadd a_13024 (%wsucc j_13025))))) (λ x_13023 → let mm_13026 = b2-dep mm_ x_13023 in let c = x_13023 in if (%weq c #10) then (b2-nlcount mm_13026 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_13026 f s (%wsucc j) e cnt ls kq_)))
