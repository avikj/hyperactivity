ga-lem-mk-ite : (env : Nat → Bool) → (c t f : GaGuard) → ga-eval env (ga-mk-ite c t f) ≡ ga-iteB (ga-eval env c) (ga-eval env t) (ga-eval env f)
ga-lem-mk-ite env (ga-k true)      t f = refl
ga-lem-mk-ite env (ga-k false)     t f = refl
ga-lem-mk-ite env (ga-v i)         t f = ga-lem-ite-guard env (ga-v i) t f
ga-lem-mk-ite env (ga-not a)       t f = ga-lem-ite-guard env (ga-not a) t f
ga-lem-mk-ite env (ga-and a b)     t f = ga-lem-ite-guard env (ga-and a b) t f
ga-lem-mk-ite env (ga-ite c1 t1 f1) t f = ga-lem-ite-guard env (ga-ite c1 t1 f1) t f
