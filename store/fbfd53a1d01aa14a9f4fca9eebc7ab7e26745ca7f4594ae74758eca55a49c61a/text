sf2-node-ip-gen : Nat → Sf2Face → Sf2Face → Sf2Face → Sf2Face → Nat → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ))
sf2-node-ip-gen fuel fa fb fc fd k acc = case fuel of
  zero → acc
  suc ip → sf2-node-ip-gen ip fa fb fc fd k
    (if both (tri-ok (sf2-Jp fa) (sf2-Jp fb) ip) (tri-ok (sf2-Jp fc) (sf2-Jp fd) ip)
     then sf2-node-im-gen (suc (nat-min (plus (sf2-Jm fa) (sf2-Jm fb)) (plus (sf2-Jm fc) (sf2-Jm fd)))) fa fb fc fd k ip acc
     else acc)
