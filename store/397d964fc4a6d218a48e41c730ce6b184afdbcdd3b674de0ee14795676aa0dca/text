-- Σ (-1)^j p_j / (2j+1), p_{j+1} = p_j / n2 (atan(1/n) for p_0 = 2^W/n, n2 = n^2)
ief-ai : Nat → Word → Word → List Word → Word × List Word → Word → Word × List Word
ief-ai zero n2 k p acc sg = acc
ief-ai (suc f) n2 k p acc sg =
  if bg-is0 p then acc
  else ief-ai f n2 (%wadd k #2) (bg-divw p n2) (sx-add acc (sg , bg-divw p k)) (%wxor sg #1)
