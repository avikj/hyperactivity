  kq_ (h4-depl mm_ (t))
b2-classg mm_ (suc f) t kq_ =
  let t_2050 = t in let j_2051 = #3 in scmd (w-load ((b2-a mm_ (%wadd t_2050 (%wadd #2 j_2051))))) (λ x_2049 → let mm_2052 = b2-dep mm_ x_2049 in let c = x_2049 in if (%weq c #0) then (kq_ (h4-depl mm_2052 (t))) else (let t_2054 = c in let j_2055 = #3 in scmd (w-load ((b2-a mm_2052 (%wadd t_2054 (%wadd #2 j_2055))))) (λ x_2053 → let mm_2056 = b2-dep mm_2052 x_2053 in let cc = x_2053 in let c2 = the Word (if %weq cc #0 then c else cc) in let t_2057 = t in let j_2058 = #3 in let v_2059 = c2 in scmd (w-store ((b2-a mm_2056 (%wadd t_2057 (%wadd #2 j_2058)))) (v_2059)) (λ uu_2060 → let mm_2061 = hv2-u mm_2056 uu_2060 in b2-classg mm_2061 f c2 kq_))))
