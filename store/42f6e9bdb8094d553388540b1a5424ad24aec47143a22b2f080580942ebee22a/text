b2-linestart : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-linestart mm_ zero s i kq_ =
  kq_ (h4-depl mm_ (#0))
b2-linestart mm_ (suc f) s i kq_ =
  if (%weq i #0) then (kq_ (h4-depl mm_ (#0))) else (let a_7080 = s in let j_7081 = (%wsub i #1) in scmd (w-load ((b2-a mm_ (%wadd a_7080 (%wsucc j_7081))))) (λ x_7079 → let mm_7082 = b2-dep mm_ x_7079 in let c = x_7079 in if (%weq c #10) then (kq_ (h4-depl mm_7082 (i))) else (b2-linestart mm_7082 f s (%wsub i #1) kq_)))
