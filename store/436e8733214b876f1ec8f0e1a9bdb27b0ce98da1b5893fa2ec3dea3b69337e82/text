-- Run one full bottom-up OE cost level `tcost` across all 3 unary + 5 binary ops!
hd-run-level : Word → Word → (Word → Step W Word) → Step W Word
hd-run-level mem tcost k =
  scmd (w-load (hd-st-at mem #0)) (λ n0 →
  hd-exp-uop (toNat n0) mem #0 tcost #4 (λ _ →
  hd-exp-uop (toNat n0) mem #0 tcost #5 (λ _ →
  hd-exp-uop (toNat n0) mem #0 tcost #6 (λ _ →
  hd-exp-bop-i (toNat n0) mem #0 n0 tcost #7 (λ _ →
  hd-exp-bop-i (toNat n0) mem #0 n0 tcost #8 (λ _ →
  hd-exp-bop-i (toNat n0) mem #0 n0 tcost #9 (λ _ →
  hd-exp-bop-i (toNat n0) mem #0 n0 tcost #10 (λ _ →
  hd-exp-bop-i (toNat n0) mem #0 n0 tcost #11 k))))))))
