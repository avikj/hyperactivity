b2-varidx : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-varidx mm_ zero vs i j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-varidx mm_ (suc f) vs i j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_5473 = vs in let j_5474 = j in scmd (w-load ((b2-a mm_ (%wadd a_5473 (%wsucc j_5474))))) (λ x_5472 → let mm_5475 = b2-dep mm_ x_5472 in let w = x_5472 in let t_5477 = w in let j_5478 = #1 in scmd (w-load ((b2-a mm_5475 (%wadd t_5477 (%wadd #2 j_5478))))) (λ x_5476 → let mm_5479 = b2-dep mm_5475 x_5476 in let wi = x_5476 in if (%weq wi i) then (kq_ (h4-depl mm_5479 (j))) else (b2-varidx mm_5479 f vs i (%wsucc j) n kq_))))
