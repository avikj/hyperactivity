-- Theorem 3 (universal Nat): Lowering sequential `net_solo` cost on Mac mini (`s1 <= s2`)
-- for any parallel Metal GPU workload `g` preserves total cycle dominance `g + s1 <= g + s2`:
hc-thm-role-split-mono : (g s1 s2 : Nat) →
  hc-le s1 s2 ≡ true → hc-le (hc-add g s1) (hc-add g s2) ≡ true
hc-thm-role-split-mono g s1 s2 h = hc-le-add-mono-r g s1 s2 h
