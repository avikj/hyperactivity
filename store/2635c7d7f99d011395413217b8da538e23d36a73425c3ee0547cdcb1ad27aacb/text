b2-firstnq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstnq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-firstnq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_8085 = tel in let j_8086 = j in scmd (w-load ((b2-a mm_ (%wadd a_8085 (%wsucc j_8086))))) (λ x_8084 → let mm_8087 = b2-dep mm_ x_8084 in let c = x_8084 in let i_8089 = (%wadd c #3) in scmd (w-load ((b2-a mm_8087 i_8089))) (λ x_8088 → let mm_8090 = b2-dep mm_8087 x_8088 in let vT = x_8088 in let t_8092 = vT in scmd (w-load ((b2-a mm_8090 t_8092))) (λ x_8091 → let mm_8093 = b2-dep mm_8090 x_8091 in let tg = (%wand x_8091 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_8093 (j))) else (b2-firstnq mm_8093 f tel (%wsucc j) n kq_)))))
