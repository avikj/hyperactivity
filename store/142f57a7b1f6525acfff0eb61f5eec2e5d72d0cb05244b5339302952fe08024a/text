b2-failout : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-failout mm_ seen base kq_ =
  scmd (w-load ((b2-HERR mm_))) (λ e → let mm_14026 = b2-dep mm_ e in b2-errshow mm_14026 e (λ es → let mm_14027 = b2-dpl mm_14026 es in b2-location mm_14027 e seen base (λ lc → let mm_14028 = b2-dpl mm_14027 lc in scmd ((w-fd-write #2 (list-append "SOME PROOFS FAIL" (cons #10 (list-append es (list-append lc (cons #10 nil))))))) (λ w → let mm_14029 = b2-dep mm_14028 w in kq_ (h4-depl mm_14029 (#1))))))
