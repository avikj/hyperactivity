-- The elementary K_3 cycle (+1, +1, +1) has zero divergence at every vertex (so Theorem 2 applies to U_square).
qgm-k3-cycle-closed : both (qgm-bz-eq (qgm-div BZ bz-zero bz-add bz-neg 0 qgm-k3-edges qgm-loop-plus) bz-zero)
  (both (qgm-bz-eq (qgm-div BZ bz-zero bz-add bz-neg 1 qgm-k3-edges qgm-loop-plus) bz-zero)
        (qgm-bz-eq (qgm-div BZ bz-zero bz-add bz-neg 2 qgm-k3-edges qgm-loop-plus) bz-zero)) ≡ true
qgm-k3-cycle-closed = refl
