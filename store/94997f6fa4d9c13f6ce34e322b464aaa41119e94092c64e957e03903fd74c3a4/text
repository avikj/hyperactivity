b2-anynq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-anynq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-anynq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_8795 = tel in let j_8796 = j in scmd (w-load ((b2-a mm_ (%wadd a_8795 (%wsucc j_8796))))) (λ x_8794 → let mm_8797 = b2-dep mm_ x_8794 in let c = x_8794 in let i_8799 = (%wadd c #3) in scmd (w-load ((b2-a mm_8797 i_8799))) (λ x_8798 → let mm_8800 = b2-dep mm_8797 x_8798 in let vT = x_8798 in let t_8802 = vT in scmd (w-load ((b2-a mm_8800 t_8802))) (λ x_8801 → let mm_8803 = b2-dep mm_8800 x_8801 in let tg = (%wand x_8801 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_8803 (#1))) else (b2-anynq mm_8803 f tel (%wsucc j) n kq_)))))
