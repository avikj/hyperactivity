-- Cold-reset corollary at `(#0, #0)` for concrete linear taps `(3, 5)` over ALL infinite input streams `tr`:
vx-thm-fir2-cold-reset-3-5 : (tr : List Word) →
  vx-run (mk-vxsys (#0 , #0) (vx-fir2-spec-step (λ u → %wmul #3 u) (λ u → %wmul #5 u)) #4) tr ≡
  vx-run (mk-vxsys (#0 , #0) (vx-fir2-impl-step (λ u → %wmul #3 u) (λ u → %wmul #5 u)) #2) tr
vx-thm-fir2-cold-reset-3-5 tr =
  vx-thm-fir2-retiming-sound (λ u → %wmul #3 u) (λ u → %wmul #5 u) #0 #0 tr
