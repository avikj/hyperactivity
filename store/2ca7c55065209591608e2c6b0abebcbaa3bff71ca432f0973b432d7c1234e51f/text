-- THEOREM 2 (Digital Divination — Observation-Fiber Horizon Coalescing Preserves Warrants):
-- Overwriting superseded observation `y1` in-place with tighter fiber `y2` (`Fib(y2) <= Fib(y1)`)
-- preserves every warranted invariant `P s` at half wire bandwidth and zero dead-byte retransmit!
hxp-thm-divination-coalesce-warrants :
  {S O : Type} → (obs : S → O) → (P : S → Type) → (y1 y2 : O) →
  ((s : S) → obs s ≡ y2 → obs s ≡ y1) →
  ((s : S) → obs s ≡ y1 → P s) →
  (s : S) → obs s ≡ y2 → P s
hxp-thm-divination-coalesce-warrants obs P y1 y2 refines w1 s hy2 = w1 s (refines s hy2)
