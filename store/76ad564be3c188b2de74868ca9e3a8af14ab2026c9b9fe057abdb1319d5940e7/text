stat-data-hdr : Word → List Word
stat-data-hdr sz = h-concat (cons "HTTP/1.1 200 OK" (cons h-crlf (cons "Content-Type: text/plain; charset=utf-8" (cons h-crlf (cons "Content-Length: " (cons (h-decimal sz) (cons h-crlf (cons "Cache-Control: no-cache" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil))))))))))))
