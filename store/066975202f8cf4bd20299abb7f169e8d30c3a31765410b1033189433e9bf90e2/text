-- THEOREM 5 (SUPEROPT PROVES SAFETY / ZERO EXPLOITS):
-- Whenever `ge-superopt n eBad` hyperfactors to `ge-k false`, the fiber of exploit witnesses
-- `(env : Nat → Bool) × (ge-eval env eBad ≡ true)` maps directly to `Empty`!
bfm-eval-false : (env : Nat → Bool) → (x : GuardExpr) → x ≡ ge-k false → ge-eval env x ≡ false
bfm-eval-false env x h = λ i → ge-eval env (h i)
