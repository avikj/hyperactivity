-- THEOREM 2D (Variational Spectral Separation Corollary):
-- If quadratic form Q_1 admits a negative Rayleigh witness v (Neg(Q_1 v) > 0), then Q_1 cannot be positive
-- semidefinite (i.e. E_0(H_1, G_1) < lambda), whereas a Bareiss-certified Q_2 is positive definite (E_0(H_2, G_2) > lambda).
qmol-variational-sep : (A W : Type) → (Pos Nonneg : A → Type) → (neg : A → A) →
  ((x : A) → Pos (neg x) → Nonneg x → Empty) →
  (Q1 : W → A) → (v : W) → Pos (neg (Q1 v)) →
  ((u : W) → Nonneg (Q1 u)) → Empty
qmol-variational-sep A W Pos Nonneg neg disj Q1 v hneg hpsd = disj (Q1 v) hneg (hpsd v)
