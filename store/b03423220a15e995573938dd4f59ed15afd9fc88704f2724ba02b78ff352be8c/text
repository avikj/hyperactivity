b2-word : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-word mm_ p w kq_ =
  b2-atword mm_ p w (λ a → let mm_6809 = b2-dep mm_ a in if (%weq a #0) then (kq_ (h4-depl mm_6809 (#0))) else (b2-take mm_6809 p w (λ dd_6810 → let mm_6811 = b2-dep mm_6809 dd_6810 in kq_ (h4-depl mm_6811 (#1)))))
