ca-check-valid-at : {K V : Type} → (chk : K → V → Bool) → (k : K) → (x : Sum Unit V) →
  ((v : V) → x ≡ inr v → chk k v ≡ true) → ca-check chk k x ≡ x
ca-check-valid-at chk k (inl u) hx = cong inl (unit-eq-ca unit u)
ca-check-valid-at chk k (inr v) hx = λ i → if hx v refl i then inr v else inl unit
