-- THEOREM 1A (Norm Equality Tr(psi psi^T) = Tr(psi^T psi)):
qent-schmidt-norm-eq : (I J A : Type) → (z : A) → (add mul : A → A → A) → QentSR A z add mul →
  (psi : I → J → A) → (is : List I) → (js : List J) →
  qent-tr1-A I J A z add mul psi is js ≡ qent-tr1-B I J A z add mul psi is js
qent-schmidt-norm-eq I J A z add mul sr psi is js =
  qent-sum-swap I J A z add mul sr (λ i j → mul (psi i j) (psi i j)) is js
