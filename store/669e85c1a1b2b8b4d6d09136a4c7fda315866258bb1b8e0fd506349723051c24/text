-- THEOREM 5: UNIVERSAL 2-WIDE MACRO-STEP SUPEROPTIMIZATION EQUIVALENCE!
-- If `stepFast s x0 x1` computes 2 sequential steps `step1 (step1 s x0) x1` in 1 fused cycle,
-- then running `stepFast` over ANY stream of input pairs reaches the EXACT same state!
vx-fold1-pairs : {S I : Type} → (S → I → S) → S → List (I × I) → S
vx-fold1-pairs stp s nil         = s
vx-fold1-pairs stp s (cons p ps) = vx-fold1-pairs stp (stp (stp s (fst p)) (snd p)) ps
