b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_8059 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_8059 (k))) else (b2-nbytes mm_8059 ns (λ nb → let mm_8060 = b2-dpl mm_8059 nb in b2-nbytes mm_8060 k (λ kb → let mm_8061 = b2-dpl mm_8060 kb in b2-nm mm_8061 (list-append nb (cons #58 kb)) (λ r → let mm_8062 = b2-dep mm_8061 r in kq_ (h4-depl mm_8062 (r)))))))
