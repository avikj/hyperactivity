-- Section (1): Universal 2-electron discrete U(1) gauge invariance on arbitrary finite oriented graphs.
-- Neutral 2-proton + 2-electron charge density at vertex x: (+1 at p1) + (+1 at p2) + (-1 at e1) + (-1 at e2).
qmol-charge2 : (A : Type) → A → A → (A → A → A) → (A → A) → Nat → Nat → Nat → Nat → Nat → A
qmol-charge2 A z one add neg x p1 p2 e1 e2 =
  add (qgm-charge A z one add neg x p1 e1) (qgm-charge A z one add neg x p2 e2)
