-- ---------------------------------------------------------------- loads, stores, SP adjust & structured branches
-- Unsigned scaled 64-bit load/store: LDR/STR Xt, [Xn, #(idx * 8)] (idx < 4096)
a64-ldr-idx : Word → Word → Word → Lst Word
a64-ldr-idx rt rn idx =
  a64-insn (a64-or #4181721088 (a64-or (a64-shl (a64-and idx #4095) #10) (a64-or (a64-shl (a64-and rn #31) #5) (a64-and rt #31))))
