  b2-lexeme mm_ p (λ k → let mm_6387 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6387 b2-ERR)) else (b2-iskw mm_6387 k (λ kw → let mm_6388 = b2-dpb mm_6387 kw in if (kw) then (b2-nbytes mm_6388 k (λ kb → let mm_6389 = b2-dpl mm_6388 kb in let p_6391 = p in let i_6393 = (%wadd p_6391 #1) in scmd (w-load ((b2-a mm_6389 i_6393))) (λ x_6392 → let mm_6394 = b2-dep mm_6389 x_6392 in let x_6390 = x_6392 in let i = x_6390 in let p_6396 = p in let i_6398 = (%wadd p_6396 #1) in scmd (w-load ((b2-a mm_6394 i_6398))) (λ x_6397 → let mm_6399 = b2-dep mm_6394 x_6397 in let x_6395 = x_6397 in let ixq = x_6395 in b2-pfail mm_6399 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6400 = b2-dep mm_6399 r in kq_ (h4-depl mm_6400 (r))))))) else (kq_ (h4-depl mm_6388 (k))))))
