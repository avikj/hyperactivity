-- Deduplicate name bindings (latest key for each name wins, matching names_load)
sf-set-name : List Word → List Word → List SfBinding → List SfBinding
sf-set-name nm ky nil = cons (mkBind nm ky) nil
sf-set-name nm ky (cons (mkBind n0 k0) r) =
  if h-eq nm n0 then cons (mkBind nm ky) r
  else cons (mkBind n0 k0) (sf-set-name nm ky r)
