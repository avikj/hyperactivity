r4d-sum3-hom : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → R4dAb A z add neg →
  (u v : A × (A × A)) → add (r4d-sum3 A add u) (r4d-sum3 A add v) ≡ r4d-sum3 A add (r4d-v3add A add u v)
r4d-sum3-hom A z add neg ab u v =
  concat
    (r4d-swap4 A z add neg ab (fst u) (add (fst (snd u)) (snd (snd u))) (fst v) (add (fst (snd v)) (snd (snd v))))
    (cong (λ t → add (add (fst u) (fst v)) t)
          (r4d-swap4 A z add neg ab (fst (snd u)) (snd (snd u)) (fst (snd v)) (snd (snd v))))
