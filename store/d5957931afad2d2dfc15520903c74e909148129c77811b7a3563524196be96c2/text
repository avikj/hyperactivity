-- Exact rational factor R of A_v^EPRL = (prod_a sqrt(i_a + 1)) * R, in BQ.
sf-eprl-R : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-eprl-R J Jp Jm i1 i2 i3 i4 i5 =
  bq-mul
    (bq-mul
      (sf-bq-pow (bq-mul (sf-bq-of-nat (suc J)) (sf-delta2 Jp Jm J)) 10)
      (bq-mul (bq-mul (sf-delta2 J J i1) (sf-delta2 J J i2))
              (bq-mul (sf-delta2 J J i3) (bq-mul (sf-delta2 J J i4) (sf-delta2 J J i5)))))
    (sf-eprl-fold1 Jp Jm
      (sf-eprl-opts J Jp Jm i1) (sf-eprl-opts J Jp Jm i2) (sf-eprl-opts J Jp Jm i3)
      (sf-eprl-opts J Jp Jm i4) (sf-eprl-opts J Jp Jm i5) bq-zero)
