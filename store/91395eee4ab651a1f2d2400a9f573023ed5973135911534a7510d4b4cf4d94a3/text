b2-failout : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-failout mm_ seen base kq_ =
  scmd (w-load ((b2-HERR mm_))) (λ e → let mm_13770 = b2-dep mm_ e in b2-errshow mm_13770 e (λ es → let mm_13771 = b2-dpl mm_13770 es in b2-location mm_13771 e seen base (λ lc → let mm_13772 = b2-dpl mm_13771 lc in scmd ((w-fd-write #2 (list-append "SOME PROOFS FAIL" (cons #10 (list-append es (list-append lc (cons #10 nil))))))) (λ w → let mm_13773 = b2-dep mm_13772 w in kq_ (h4-depl mm_13773 (#1))))))
