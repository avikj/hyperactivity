-- the tail over n doublings: (1 − r)(1 + r + … + r^{n−1}) = 1 − r^n, one variable r
dz-geo : Nat → (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
dz-geo n A ad mu q vs = (λ r sub → (mu (sub (q (fn-q 1 1)) r) (dz-geosum A ad mu (q (fn-q 0 1)) (q (fn-q 1 1)) r n) , sub (q (fn-q 1 1)) (dz-pow A mu (q (fn-q 1 1)) r n))) (al-nth A (q (fn-q 0 1)) 0 vs) (al-gsub A ad mu q)
