
-- ===========================================================================================
-- Term nodes. Var [k, i, v, c]  Ref [k, b]  Sub [i, v, f]  Let [k, i, q, v, f]  Typ [g]  Qnt []
-- Qua [q]  Min [a, b]  All [q, k, i, A, B]  Lam [k, i, f, q]  App [f, x]  ADT [k, x, r]  Ctr [k, x]
-- Lit [k, v]  Mat [k, h, m]  Efq []  Eql [a, b, T]  Rfl []  Rwt [e, p, f]  Hol [k]  Ann [x, T];
-- arrays where TypeScript has them. A closure is [CLO, 0, kind, a, b, c, d].
-- ===========================================================================================

macro b2m-Var (k : Word) (i : Word) (s : Word) (v : Word) : Word
  t <- b2m-n4 b2-VAR s k i v #0
  ret t

macro b2m-clo (kd : Word) (a : Word) (b : Word) (c : Word) (d : Word) : Word
  t <- b2m-n5 b2-CLO #0 kd a b c d
  ret t

fn b2-Var (k : Word) (i : Word) (s : Word) (v : Word) : Word
  t <- b2m-n4 b2-VAR s k i v #0
  ret t

fn b2-Ref (k : Word) (s : Word) (b : Word) : Word
  t <- b2m-n2 b2-REF s k b
  ret t

fn b2-App (g : Word) (x : Word) (s : Word) : Word
  t <- b2m-n2 b2-APP s g x
  ret t

fn b2-Ctr (k : Word) (xs : Word) (s : Word) : Word
  t <- b2m-n2 b2-CTR s k xs
  ret t

fn b2-Adt (k : Word) (xs : Word) (s : Word) (r : Word) : Word
  t <- b2m-n3 b2-ADT s k xs r
  ret t

fn b2-Ann (x : Word) (vT : Word) (s : Word) : Word
  t <- b2m-n2 b2-ANN s x vT
  ret t

fn b2-All (q : Word) (k : Word) (i : Word) (vA : Word) (vB : Word) (s : Word) : Word
  t <- b2m-n5 b2-ALL s q k i vA vB
  ret t

fn b2-Lam (k : Word) (i : Word) (g : Word) (s : Word) (q : Word) : Word
  t <- b2m-n4 b2-LAM s k i g q
  ret t

fn b2-TypQ (q : Word) (s : Word) : Word
  g <- b2m-n1 b2-QUA s q
  t <- b2m-n1 b2-TYP s g
  ret t

-- term_cell(t, k): a share cell over t (a cell already is one)
fn b2-cell (t : Word) (k : Word) : Word
  tg <- b2m-tag t
  i <- b2m-f t #1
  if andB (%weq tg b2-VAR) (b2-neg i)
    ret t
  s <- b2m-span t
  c <- b2-Var k b2-M1 s t
  ret c

-- the class of a share cell (cell_class), its c links halved on the way
fnrec b2-classg (f : Nat) (t : Word) : Word
  zero: ret t
  c <- b2m-f t #3
  if %weq c #0
    ret t
  cc <- b2m-f c #3
  let c2 = the Word (if %weq cc #0 then c else cc)
  do b2m-setf t #3 c2
  jump b2-classg f c2

fn b2-class (t : Word) : Word
  r <- b2-classg (toNat #4294967295) t
  ret r

-- the book: [BOOK, 0, tlds (a map), ctrs (a map), order (a vector), hols, tmps (a map)]
fn b2-booknil : Word
  a <- b2-map #0
  b <- b2-map #0
  o <- b2-vec
  c <- b2-map #0
  t <- b2m-n5 b2-BOOK #0 a b o #0 c
  ret t

fn b2-tld (bk : Word) (k : Word) : Word
  tl <- b2m-f bk #0
  r <- b2-mget tl k
  ret (the Word (if %weq r hv2-none then #0 else r))

-- a TLD: ADT [TADT, 0, n, g, T, c (array of ctrs), b]; Def [TDEF, 0, n, x, T, v, e, b, u, i, m,
-- l] (b u l are 0/1, i 0 or an array of paths, v 0 when bodiless); Ctr [TCTR, 0, k, n, T, f]
fn b2-mkdef (n : Word) (x : Word) (vT : Word) (v : Word) : Word
  at <- b2m-alloc #12
  do b2m-wr at (%wor b2-TDEF #2560)
  do b2m-wr (%wadd at #1) #0
  do b2m-wr (%wadd at #2) n
  do b2m-wr (%wadd at #3) x
  do b2m-wr (%wadd at #4) vT
  do b2m-wr (%wadd at #5) v
  do b2m-wr (%wadd at #6) #0
  do b2m-wr (%wadd at #7) #0
  do b2m-wr (%wadd at #8) #0
  do b2m-wr (%wadd at #9) #0
  do b2m-wr (%wadd at #10) #0
  do b2m-wr (%wadd at #11) #0
  ret at

-- the machine's frames: [kind, a, b, c, d]: 1 APP{x, s} 2 MAT{t, e, lhs, s} 3 VAR{l, a}
-- 4 MNA{b, s} 5 MNB{a, s}; an lhs is [thunk, n]; a thunk is [1 t] [2 prev x s] [3 prev k n]
macro b2m-rec4 (a : Word) (b : Word) (c : Word) (d : Word) (e : Word) : Word
  at <- b2m-alloc #5
  do b2m-wr at a
  do b2m-wr (%wadd at #1) b
  do b2m-wr (%wadd at #2) c
  do b2m-wr (%wadd at #3) d
  do b2m-wr (%wadd at #4) e
  ret at

macro b2m-push (r : Word) : Word
  sp <- rd (b2-HSP M)
  wr (b2-sa M sp) r
  wr (b2-HSP M) (%wsucc sp)
  ret r

-- a Ref's def is an operator (a name ".x" with no other dot)
b2-isop : List Word → Bool
b2-isop s = andB (%weq (hv2-nth #0 s) #46) (not (b2-has #46 (hv2-drop1 s)))

-- patt_term(q, s): a pattern as a term, its span s when given (md 1: the fields xs into ob
-- from j)
fnrec b2-ptermg (f : Nat) (md : Word) (q : Word) (s : Word) (ob : Word) (j : Word) : Word
  zero: ret #0
  if %weq md #1
    n <- b2m-len q
    if %weq j n
      ret ob
    x <- b2m-at q j
    y <- b2-ptermg f #0 x s #0 #0
    do b2m-put ob j y
    jump b2-ptermg f #1 q s ob (%wsucc j)
  tg <- b2m-tag q
  qs <- b2m-span q
  let sp = the Word (if %weq s #0 then qs else s)
  k <- b2m-f q #0
  if %weq tg b2-PVAR
    i <- b2m-f q #1
    r <- b2-Var k i sp #0
    ret r
  xs <- b2m-f q #1
  n <- b2m-len xs
  o <- b2-arr n
  do b2-ptermg f #1 xs s o #0
  r <- b2-Ctr k o sp
  ret r

fn b2-pterm (q : Word) (s : Word) : Word
  r <- b2-ptermg (toNat #4294967295) #0 q s #0 #0
  ret r

-- a list's values oldest first (list_to_array(xs).reverse())
fn b2-ltoarrrev (l : Word) : Word
  xs <-[b2-dpl] b2-lvals (toNat #4294967295) l nil
  a <- b2-arrl xs
  ret a

-- a Let closure's environment: env with i[j] = xs[j]
fnrec b2-letenv (f : Nat) (is : Word) (xs : Word) (j : Word) (n : Word) (env : Word) : Word
  zero: ret env
  if %weq j n
    ret env
  i <- b2m-at is j
  x <- b2m-at xs j
  e2 <- b2-lset env i x
  jump b2-letenv f is xs (%wsucc j) n e2

-- the cells of an array of terms (term_cell each, named _)
fnrec b2-cellsg (f : Nat) (xs : Word) (ob : Word) (j : Word) (n : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  x <- b2m-at xs j
  c <- b2-cell x b2-N_
  do b2m-put ob j c
  jump b2-cellsg f xs ob (%wsucc j) n

fn b2-cells (xs : Word) : Word
  n <- b2m-len xs
  ob <- b2-arr n
  r <- b2-cellsg (toNat #4294967295) xs ob #0 n
  ret r

-- a term a VAR frame fills: its children as cells (term_wnf's back VAR case)
fn b2-recell (t : Word) : Word
  tg <- b2m-tag t
  s <- b2m-span t
  if %weq tg b2-CTR
    k <- b2m-f t #0
    xs <- b2m-f t #1
    cs <- b2-cells xs
    r <- b2-Ctr k cs s
    ret r
  if %weq tg b2-ADT
    k <- b2m-f t #0
    xs <- b2m-f t #1
    rs <- b2m-f t #2
    cs <- b2-cells xs
    r <- b2-Adt k cs s rs
    ret r
  if %weq tg b2-ALL
    q <- b2m-f t #0
    k <- b2m-f t #1
    i <- b2m-f t #2
    vA <- b2m-f t #3
    vB <- b2m-f t #4
    c <- b2-cell vA b2-N_
    r <- b2-All q k i c vB s
    ret r
  if %weq tg b2-MAT
    k <- b2m-f t #0
    h <- b2m-f t #1
    m <- b2m-f t #2
    ch <- b2-cell h b2-N_
    cm <- b2-cell m b2-N_
    r <- b2m-n3 b2-MAT s k ch cm
    ret r
  if %weq tg b2-EQL
    a <- b2m-f t #0
    b <- b2m-f t #1
    vT <- b2m-f t #2
    ca <- b2-cell a b2-N_
    cb <- b2-cell b b2-N_
    cT <- b2-cell vT b2-N_
    r <- b2m-n3 b2-EQL s ca cb cT
    ret r
  if %weq tg b2-MIN
    a <- b2m-f t #0
    b <- b2m-f t #1
    ca <- b2-cell a b2-N_
    cb <- b2-cell b b2-N_
    r <- b2m-n2 b2-MIN s ca cb
    ret r
  if %weq tg b2-TYP
    g <- b2m-f t #0
    cg <- b2-cell g b2-N_
    r <- b2m-n1 b2-TYP s cg
    ret r
  ret t

-- the APP frames on top of the stack, down to base, counted up to n
fnrec b2-runapp (f : Nat) (sp : Word) (base : Word) (n : Word) (run : Word) : Word
  zero: ret run
  if orB (not (%wlt run n)) (not (%wlt (%wadd base run) sp))
    ret run
  fr <- rd (b2-sa M (%wsub (%wsub sp #1) run))
  kd <- b2m-rd fr
  if not (%weq kd #1)
    ret run
  jump b2-runapp f sp base n (%wsucc run)

fn b2-qua (t : Word) (q : Word) : Bool
  tg <- b2m-tag t
  if not (%weq tg b2-QUA)
    ret false
  x <- b2m-f t #0
  ret (%weq x q)

fn b2-opfail (t : Word) (s : Word) (kb : List Word) : Word
  bk <- b2-booknil
  op <-[b2-dpl] b2-spantext s kb
  r <- b2-failn bk #0 (list-append "a type for this operator (write (a " (list-append op " b : Nat))")) #0 s #0 (list-append "Note: we broke this after launch, sorry. Until 2.0.16 a bare operator meant Nat." (cons #10 "That was a bug: operators demand annotation. Wrap the expression and it'll work again."))
  ret r

-- the text of a span (or the fallback when there is none)
fn b2-spantext (s : Word) (dflt : List Word) : List Word
  if %weq s #0
    ret dflt
  file <- b2m-f s #0
  beg <- b2m-f s #1
  end <- b2m-f s #2
  str <- b2m-f file #0
  us <-[b2-dpl] b2-slice str beg end
  ret (b2-utf8 us)

fn b2-fuelout : Word
  halt (cli-say "Error: the machine ran out of steps" (sdone #1))

-- lit_step when t is a literal
fn b2-litq (t : Word) : Word
  tg <- b2m-tag t
  if %weq tg b2-LIT
    r <- b2-litstep t
    ret r
  ret t

-- a literal stepped when the other side is a constructor
fn b2-litifctr (t : Word) (ot : Word) : Word
  tg <- b2m-tag t
  if andB (%weq tg b2-LIT) (%weq ot b2-CTR)
    r <- b2-litstep t
    ret r
  ret t

fn b2-tldn (tld : Word) : Word
  if %weq tld #0
    ret #0
  n <- b2m-f tld #0
  ret n

-- t applied to n fresh variables _ at d, d+1, ..
fnrec b2-appvarsg (f : Nat) (t : Word) (d : Word) (j : Word) (n : Word) : Word
  zero: ret t
  if %weq j n
    ret t
  x <- b2-Var b2-N_ (%wadd d j) #0 #0
  g <- b2-App t x #0
  jump b2-appvarsg f g d (%wsucc j) n

fn b2-appvars (t : Word) (d : Word) (n : Word) : Word
  r <- b2-appvarsg (toNat #4294967295) t d #0 n
  ret r

-- every name of array a is in array b
fnrec b2-inarr (f : Nat) (b : Word) (x : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if %weq j n
    ret #0
  y <- b2m-at b j
  if %weq x y
    ret #1
  jump b2-inarr f b x (%wsucc j) n

fnrec b2-subsetg (f : Nat) (a : Word) (b : Word) (j : Word) (n : Word) : Word
  zero: ret #1
  if %weq j n
    ret #1
  x <- b2m-at a j
  bn <- b2m-len b
  ok <- b2-inarr (toNat #4294967295) b x #0 bn
  if %weq ok #0
    ret #0
  jump b2-subsetg f a b (%wsucc j) n

fn b2-subset (a : Word) (b : Word) : Word
  n <- b2m-len a
  r <- b2-subsetg (toNat #4294967295) a b #0 n
  ret r

-- Var(k[j], d + j) for each name, and [d, d+1, ..]
fnrec b2-lowvarsg (f : Nat) (ks : Word) (d : Word) (ob : Word) (j : Word) (n : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  k <- b2m-at ks j
  x <- b2-Var k (%wadd d j) #0 #0
  do b2m-put ob j x
  jump b2-lowvarsg f ks d ob (%wsucc j) n

fn b2-lowvars (ks : Word) (d : Word) : Word
  n <- b2m-len ks
  ob <- b2-arr n
  r <- b2-lowvarsg (toNat #4294967295) ks d ob #0 n
  ret r

fnrec b2-iotag (f : Nat) (d : Word) (ob : Word) (j : Word) (n : Word) : Word
  zero: ret ob
  if %weq j n
    ret ob
  do b2m-put ob j (%wadd d j)
  jump b2-iotag f d ob (%wsucc j) n

fn b2-iota (d : Word) (n : Word) : Word
  ob <- b2-arr n
  r <- b2-iotag (toNat #4294967295) d ob #0 n
  ret r

-- ===========================================================================================
-- The machine (bend.ts term_higher, term_apply, the closures, lhs_ext, term_wnf, term_snf,
-- term_compare, term_lower), one function; md:
--   0 higher(a, env b)          1 apply(a, b, span c)       2 a closure a at b
--   3 wnf(bk, a)                4 snf(bk, a)                 5 compare(bk, a, b, mode c (0 EQ
--   1 LE), dep d) as 1/0        6 lower(a, dep b)            7 lhs_ext(lhs a, k b, n c, xs d)
--   8 a thunk forced            9 the match goal (cur a, n b, xs c, info d)
--   10 map over the array a (op d >> 32: 0 higher at b, 1 snf, 2 lower at b, 3 cells named b[j]),
--      ob c, from d & 2^32-1
--   20 wnf's main (tm a, lhs b, base c)   21 wnf's back (tm a, base c)   22 a match's walk
--   (arm a, frame b, base c, ctr d)   23 a match's fields pushed (ctr a, lhs b, base c, j d)
--   50 compare_go (bk, a, b, mode c, dep d)   51 two arrays compared EQ from c (dep d)
-- ===========================================================================================

