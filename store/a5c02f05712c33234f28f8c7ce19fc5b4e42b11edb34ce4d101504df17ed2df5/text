b2-ffloor x = let t = b2-ftrunc x in if andB (%weq (ief-sgn x) #1) (not (%weq t x)) then ief-sub t #1065353216 else t

b2-fceil : Word → Word
b2-fceil x = let t = b2-ftrunc x in if andB (%weq (ief-sgn x) #0) (not (%weq t x)) then ief-add t #1065353216 else (if andB (%weq (ief-sgn x) #1) (ief-iszero t) then #2147483648 else t)

b2-ftou32 : Word → Word
b2-ftou32 x =
  if orB (%wlt x #1065353216) (not (%wlt x #1333788672)) then #0
  else (let e = %wand (%wshr x #23) #255
            m = %wor (%wand x #8388607) #8388608
        in if %wlt e #150 then %wshr m (%wsub #150 e) else %wshl m (%wsub e #150))

