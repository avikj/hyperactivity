fnrec b2-intrinit (f : Nat) (mp : Word) (ns : List (List Word)) (cs : List Word) : Word
  zero: ret #0
  if h4-stknil0 ns
    ret #0
  k <- b2-nm (h4-tget-go #0 ns)
  do b2-mset mp k (hv2-nth #0 cs)
  jump b2-intrinit f mp (h4-tl0 ns) (hv2-drop1 cs)

fn b2-intrcode (k : Word) : Word
  mp <- rd (b2-HR M #21)
  if %weq mp #0
    ret #0
  c <- b2-mget mp k
  run <- rd (b2-HR M #20)
  if andB (%wlt #39 c) (not (%weq c hv2-none))
    ret (the Word (if %weq run #1 then c else #0))
  ret (the Word (if %weq c hv2-none then #0 else c))

-- a literal's number: U32 (k 0), Nat (k 1) or F32 bits (k 2), b2-NNONE when the term is not one
fn b2-numof (t : Word) (k : Word) : Word
  if %weq k #0
    r <- b2-u32ft t b2-NU32
    ret (the Word (if %weq r hv2-none then b2-NNONE else r))
  if %weq k #2
    r <- b2-u32ft t b2-NF32
    ret (the Word (if %weq r hv2-none then b2-NNONE else r))
  r <- b2-natnum (toNat #64) t #0
  ret r

-- no number (a Nat reaches 2^48, past hv2-none's 2^32, so numbers answer this instead)
b2-NNONE : Word
b2-NNONE = #18446744073709551614

-- a Nat term's number through up to 64 Succ: a literal or Zero at the end, its cells followed
fnrec b2-natnum (f : Nat) (t : Word) (acc : Word) : Word
  zero: ret b2-NNONE
  w <- b2-strip t
  tg <- b2m-tag w
  lk <- b2m-f w #0
  v <- b2m-f w #1
  if andB (%weq tg b2-LIT) (%weq lk b2-LNAT)
    ret (%wadd acc v)
  if andB (%weq tg b2-CTR) (%weq lk b2-NZero)
    ret acc
  if andB (%weq tg b2-CTR) (%weq lk b2-NSucc)
    x <- b2m-at v #0
    jump b2-natnum f x (%wsucc acc)
  ret b2-NNONE

fn b2-cmpv (a : Word) (b : Word) : Word
  k <- b2-nm (the (List Word) (if %wlt a b then "LT" else if %weq a b then "EQ" else "GT"))
  e <- b2-arr #0
  r <- b2-Ctr k e #0
  ret r

fn b2-boolv (b : Bool) : Word
  e <- b2-arr #0
  r <- b2-Ctr (the Word (if b then b2-NTrue else b2-NFalse)) e #0
  ret r

b2-m32 : Word → Word
b2-m32 x = %wand x #4294967295

-- F32 by its bits (the runtimes' F32 operations: comp.ts OPERATIONS, run on IO only)
b2-fnan : Word → Bool
b2-fnan x = ief-isnan x

-- an integer below 2^53 to the nearest F32 (Math.fround)
b2-u2f : Word → Word
b2-u2f n = if %weq n #0 then #0 else b2-u2fk n (b2-blen n #0)

b2-blen : Word → Word → Word
b2-blen n k = b2-blenn (toNat #64) n k

b2-blenn : Nat → Word → Word → Word
b2-blenn zero n k = k
b2-blenn (suc f) n k = if %weq n #0 then k else b2-blenn f (%wshr n #1) (%wsucc k)

b2-u2fk : Word → Word → Word
b2-u2fk n k =
  if not (%wlt #24 k) then %wor (%wshl (%wadd k #126) #23) (%wsub (%wshl n (%wsub #24 k)) #8388608)
  else (let sh = %wsub k #24
            m = %wshr n sh
            r = %wand n (%wsub (%wshl #1 sh) #1)
            h = %wshl #1 (%wsub sh #1)
            m2 = the Word (if orB (%wlt h r) (andB (%weq r h) (%weq (%wand m #1) #1)) then %wsucc m else m)
