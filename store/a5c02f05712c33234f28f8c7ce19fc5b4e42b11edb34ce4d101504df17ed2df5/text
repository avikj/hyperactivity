      ret r
    if %weq tg b2-MIN
      x <- b2m-f a #0
      y <- b2m-f a #1
      x2 <-! b2x f #0 bk x b #0 #0
      y2 <-! b2x f #0 bk y b #0 #0
      r <- b2m-n2 b2-MIN s x2 y2
      ret r
    if %weq tg b2-APP
      g <- b2m-f a #0
      x <- b2m-f a #1
      g2 <-! b2x f #0 bk g b #0 #0
