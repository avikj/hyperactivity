    ret v
  ret #0

fn b2-sunitsa (w0 : Word) : Word
  v <- b2-sunits w0
  if %weq v #0
    ret #0
  a <- b2-sarr v
  ret a

fnrec b2-acopy (f : Nat) (src : Word) (dst : Word) (j : Word) (off : Word) (n : Word) : Word
  zero: ret dst
  if %weq j n
    ret dst
  x <- b2m-at src j
  do b2m-put dst (%wadd off j) x
  jump b2-acopy f src dst (%wsucc j) off n

-- the units of a char starting at j: a surrogate pair 2, a packed code (U+DC00 and three) 4
fn b2-clen (a : Word) (j : Word) (n : Word) : Word
  u <- b2m-at a j
  if andB (%weq u #56320) (%wlt (%wadd j #3) n)
    ret #4
  if andB (andB (%wlt #55295 u) (%wlt u #56320)) (%wlt (%wsucc j) n)
    u2 <- b2m-at a (%wsucc j)
    ret (the Word (if andB (%wlt #56319 u2) (%wlt u2 #57344) then #2 else #1))
  ret #1

-- p's units at a's offset at
fnrec b2-sat (f : Nat) (a : Word) (p : Word) (at : Word) (j : Word) (m : Word) : Word
  zero: ret #0
  if %weq j m
    ret #1
  x <- b2m-at a (%wadd at j)
  y <- b2m-at p j
  if not (%weq x y)
    ret #0
  jump b2-sat f a p at (%wsucc j) m

-- a match of p starting at a char of a (as string_contains)
fnrec b2-scont (f : Nat) (a : Word) (n : Word) (p : Word) (m : Word) (at : Word) : Word
  zero: ret #0
  if %wlt n (%wadd at m)
    ret #0
  ok <- b2-sat (toNat #4294967295) a p at #0 m
  if %weq ok #1
    ret #1
  if %weq at n
    ret #0
  l <- b2-clen a at n
  jump b2-scont f a n p m (%wadd at l)

fnrec b2-scount (f : Nat) (a : Word) (n : Word) (j : Word) (acc : Word) : Word
  zero: ret acc
  if %weq j n
    ret acc
  l <- b2-clen a j n
  jump b2-scount f a n (%wadd j l) (%wsucc acc)

fn b2-sintr (ic : Word) (w0 : Word) (w1 : Word) : Word
