    if orB (%weq tg b2-EQL) (%weq tg b2-RWT)
      x <- b2m-f t #0
      y <- b2m-f t #1
      z <- b2m-f t #2
      x2 <-! b2x f #6 bk x b #0 #0
      y2 <-! b2x f #6 bk y b #0 #0
      z2 <-! b2x f #6 bk z b #0 #0
      r <- b2m-n3 tg s x2 y2 z2
      ret r
    if %weq tg b2-ANN
      x <- b2m-f t #0
      vT <- b2m-f t #1
      x2 <-! b2x f #6 bk x b #0 #0
      vT2 <-! b2x f #6 bk vT b #0 #0
      r <- b2-Ann x2 vT2 s
      ret r
    ret t
  -- ------------------------------------------------------------------------ compare
  if %weq md #5
    rigid <- rd (b2-HRIGID M)
    r1 <-! b2x f #50 rigid a b c d
    if %weq r1 #1
      ret #1
    jump b2x f #50 bk a b c d
  if %weq md #50
    if %weq a b
      ret #1
    ta <- b2m-tag a
    tb <- b2m-tag b
    if andB (%weq ta b2-VAR) (%weq tb b2-VAR)
      ca <- b2-class a
      cb <- b2-class b
      if %weq ca cb
        ret #1
    vA <-! b2x f #3 bk a #0 #0 #0
    vB <-! b2x f #3 bk b #0 #0 #0
    if %weq vA vB
      ret #1
    ia <- b2m-f a #1
    ib <- b2m-f b #1
    if andB (%weq c #0) (andB (andB (%weq ta b2-VAR) (%weq ia b2-M2)) (andB (%weq tb b2-VAR) (%weq ib b2-M2)))
      same <-! b2x f #50 bk vA vB c d
      l <- b2-class a
      r <- b2-class b
      if andB (%weq same #1) (not (%weq l r))
        do b2m-setf r #3 l
      ret same
    vAt0 <- b2m-tag vA
    vBt0 <- b2m-tag vB
    if orB (%weq vAt0 b2-LAM) (%weq vBt0 b2-LAM)
      x <- b2-Var b2-N_ d #0 #0
      a2 <-! b2x f #1 bk vA x #0 #0
      b2v <-! b2x f #1 bk vB x #0 #0
      jump b2x f #50 bk a2 b2v c (%wsucc d)
    vA1 <- b2-litifctr vA vBt0
    vAt1 <- b2m-tag vA1
    vB1 <- b2-litifctr vB vAt1
    jump b2x f #52 bk vA1 vB1 c d
  if %weq md #52
    vAt <- b2m-tag a
    vBt <- b2m-tag b
    if %weq vAt b2-VAR
      ai <- b2m-f a #1
      bi <- b2m-f b #1
      ret (hv2-b (andB (%weq vBt b2-VAR) (%weq ai bi)))
    if %weq vAt b2-REF
      if not (%weq vBt b2-REF)
        ret #0
      ak <- b2m-f a #0
      bk2 <- b2m-f b #0
      if %weq ak bk2
        ret #1
      ta <- b2-tld bk ak
      tb <- b2-tld bk bk2
      na <- b2-tldn ta
      nb <- b2-tldn tb
      let n = the Word (if %wlt na nb then nb else na)
      if %weq n #0
        ret #0
      fa <- b2-appvars a d n
      fb <- b2-appvars b d n
      jump b2x f #50 bk fa fb c (%wadd d n)
    if %weq vAt b2-TYP
      if not (%weq vBt b2-TYP)
        ret #0
      ag <- b2m-f a #0
      bg <- b2m-f b #0
      if %weq c #0
        jump b2x f #50 bk ag bg #0 d
      g <-! b2x f #3 bk ag #0 #0 #0
      h <-! b2x f #3 bk bg #0 #0 #0
      gt <- b2m-tag g
      ht <- b2m-tag h
      gq <- b2m-f g #0
      hq <- b2m-f h #0
      if orB (andB (%weq gt b2-QUA) (%weq gq b2-MANY)) (andB (%weq ht b2-QUA) (not (%weq hq b2-MANY)))
        ret #1
      if %weq gt b2-MIN
        ga <- b2m-f g #0
        gb <- b2m-f g #1
        tga <- b2m-n1 b2-TYP #0 ga
        r1 <-! b2x f #50 bk tga b #1 d
        if %weq r1 #0
          ret #0
        tgb <- b2m-n1 b2-TYP #0 gb
        jump b2x f #50 bk tgb b #1 d
      if %weq ht b2-MIN
        ha <- b2m-f h #0
        hb <- b2m-f h #1
        tha <- b2m-n1 b2-TYP #0 ha
        r1 <-! b2x f #50 bk a tha #1 d
        if %weq r1 #1
          ret #1
        thb <- b2m-n1 b2-TYP #0 hb
        jump b2x f #50 bk a thb #1 d
      jump b2x f #50 bk g h #1 d
    if orB (%weq vAt b2-QNT) (orB (%weq vAt b2-EFQ) (%weq vAt b2-RFL))
      ret (hv2-b (%weq vBt vAt))
    if %weq vAt b2-QUA
      aq <- b2m-f a #0
      bq <- b2m-f b #0
      ret (hv2-b (andB (%weq vBt b2-QUA) (%weq aq bq)))
    if %weq vAt b2-MIN
      if not (%weq vBt b2-MIN)
        ret #0
      x1 <- b2m-f a #0
      y1 <- b2m-f b #0
      r1 <-! b2x f #50 bk x1 y1 #0 d
      if %weq r1 #0
        ret #0
      x2 <- b2m-f a #1
      y2 <- b2m-f b #1
      jump b2x f #50 bk x2 y2 #0 d
    if %weq vAt b2-ALL
      if not (%weq vBt b2-ALL)
        ret #0
      aq <- b2m-f a #0
      bq <- b2m-f b #0
      if not (%weq aq bq)
        ret #0
      ak <- b2m-f a #1
      aA <- b2m-f a #3
      bA <- b2m-f b #3
      r1 <-! b2x f #50 bk bA aA c d
      if %weq r1 #0
        ret #0
      x <- b2-Var ak d #0 #0
      aB <- b2m-f a #4
      bB <- b2m-f b #4
      ax <-! b2x f #2 bk aB x #0 #0
      bx <-! b2x f #2 bk bB x #0 #0
      jump b2x f #50 bk ax bx c (%wsucc d)
    if %weq vAt b2-APP
      if not (%weq vBt b2-APP)
        ret #0
      af <- b2m-f a #0
      bf <- b2m-f b #0
      aft <- b2m-tag af
      bft <- b2m-tag bf
      if andB (%weq aft b2-REF) (%weq bft b2-REF)
        afk <- b2m-f af #0
        bfk <- b2m-f bf #0
        if not (%weq afk bfk)
          ret #0
      else
        r1 <-! b2x f #50 bk af bf #0 d
        if %weq r1 #0
          ret #0
      ax <- b2m-f a #1
      bx <- b2m-f b #1
      jump b2x f #50 bk ax bx #0 d
    if %weq vAt b2-ADT
      if not (%weq vBt b2-ADT)
        ret #0
      ak <- b2m-f a #0
      bk2 <- b2m-f b #0
      axs <- b2m-f a #1
      bxs <- b2m-f b #1
      ars <- b2m-f a #2
      brs <- b2m-f b #2
      an <- b2m-len axs
      bn <- b2m-len bxs
      arn <- b2m-len ars
      brn <- b2m-len brs
      if orB (not (%weq ak bk2)) (not (%weq an bn))
        ret #0
      if andB (%weq c #0) (not (%weq arn brn))
        ret #0
      sub <- b2-subset brs ars
      if %weq sub #0
        ret #0
      jump b2x f #51 bk axs bxs #0 d
    if %weq vAt b2-CTR
      if not (%weq vBt b2-CTR)
        ret #0
      ak <- b2m-f a #0
      bk2 <- b2m-f b #0
      axs <- b2m-f a #1
      bxs <- b2m-f b #1
      an <- b2m-len axs
      bn <- b2m-len bxs
      if orB (not (%weq ak bk2)) (not (%weq an bn))
        ret #0
      jump b2x f #51 bk axs bxs #0 d
    if %weq vAt b2-LIT
      if not (%weq vBt b2-LIT)
        ret #0
      ak <- b2m-f a #0
      bk2 <- b2m-f b #0
      av <- b2m-f a #1
      bv <- b2m-f b #1
      if not (%weq ak bk2)
        ret #0
      if %weq ak b2-LSTR
        r <- b2-streq av bv
        ret r
      ret (hv2-b (%weq av bv))
    if %weq vAt b2-MAT
      if not (%weq vBt b2-MAT)
        ret #0
      ak <- b2m-f a #0
      bk2 <- b2m-f b #0
      if not (%weq ak bk2)
        ret #0
      ah <- b2m-f a #1
      bh <- b2m-f b #1
      r1 <-! b2x f #50 bk ah bh #0 d
      if %weq r1 #0
        ret #0
      am <- b2m-f a #2
      bm <- b2m-f b #2
      jump b2x f #50 bk am bm #0 d
    if orB (%weq vAt b2-EQL) (%weq vAt b2-RWT)
      if not (%weq vBt vAt)
        ret #0
      x1 <- b2m-f a #0
      y1 <- b2m-f b #0
      r1 <-! b2x f #50 bk x1 y1 #0 d
      if %weq r1 #0
        ret #0
      x2 <- b2m-f a #1
      y2 <- b2m-f b #1
      r2 <-! b2x f #50 bk x2 y2 #0 d
      if %weq r2 #0
        ret #0
      x3 <- b2m-f a #2
      y3 <- b2m-f b #2
      jump b2x f #50 bk x3 y3 #0 d
    if %weq vAt b2-HOL
      ak <- b2m-f a #0
      bk2 <- b2m-f b #0
      ret (hv2-b (andB (%weq vBt b2-HOL) (%weq ak bk2)))
    ret #0
  if %weq md #51
    n <- b2m-len a
    if %weq c n
      ret #1
    x <- b2m-at a c
    y <- b2m-at b c
    r1 <-! b2x f #50 bk x y #0 d
    if %weq r1 #0
      ret #0
    jump b2x f #51 bk a b (%wsucc c) d
  ret #0
