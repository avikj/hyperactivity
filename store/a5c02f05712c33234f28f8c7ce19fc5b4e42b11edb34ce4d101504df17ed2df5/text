  ret (hv2-b (orB (%weq tg b2-LIT) (%weq tg b2-CTR)))

-- the String natives (JS strings: append, contains, eq, length) on literals' text units
fn b2-sunits (w0 : Word) : Word
  w <- b2-strip w0
  tg <- b2m-tag w
  lk <- b2m-f w #0
  if andB (%weq tg b2-LIT) (%weq lk b2-LSTR)
