    let lt = ief-lt a b
    let gt = ief-lt b a
    let eq = ief-eq a b
    bb <- b2-boolv (the Bool (if %weq ic #44 then eq else if %weq ic #45 then not eq else if %weq ic #46 then lt else if %weq ic #47 then orB lt eq else if %weq ic #48 then gt else orB gt eq))
    ret bb
