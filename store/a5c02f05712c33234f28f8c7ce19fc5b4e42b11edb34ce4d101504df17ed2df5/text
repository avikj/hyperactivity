-- weak normal forms in batches: each batch marks the closure heap, runs the machine's wnf loop
-- for up to 4096 steps (its state in the registers HR 11..14 when it stops short) and rewinds
-- with its caller's continuation, so the closures a batch made are reclaimed
B2X : Type
B2X = Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word

b2-SUSP : Word
b2-SUSP = #18446744073709551614

-- an inner region (a batch, a scan) marks only past the first 4096 in its outer region (a book
-- item, a definition's check, an IO step): the closure mark is one slot, and an inner mark
-- moves the outer region's rewind past what it made before (an IO step of a few batches then
-- kept them all)
fn b2-inner : Word
  n <- rd (b2-HR M #31)
  if %wlt n #4096
    wr (b2-HR M #31) (%wsucc n)
    ret #0
  ret #1

fn b2-wnfbatch (rx : B2X) (bk : Word) (md : Word) (a : Word) (b : Word) (c : Word) : Word
  -- a run's first 8 batches never mark: most runs end within them (a long run reclaims)
  im <- rd (b2-HR M #34)
  wr (b2-HR M #34) (%wsucc im)
  if %wlt im #8
    wr (b2-HR M #10) #0
    r0 <- rx md bk a b c #0
    wr (b2-HR M #7) (the Word (if %weq r0 b2-SUSP then #1 else #0))
    wr (b2-HR M #8) r0
    ret #0
  mk <- cmd (w-sys #900 #0 #0 #0 #0 #0 #0)
  wr (b2-HR M #10) #0
  r <- rx md bk a b c #0
  wr (b2-HR M #7) (the Word (if %weq r b2-SUSP then #1 else #0))
  wr (b2-HR M #8) r
  halt (scmd (w-sys #901 #0 #0 #0 #0 #0 #0) kq_)

fnrec b2-wnfrun (f : Nat) (rx : B2X) (bk : Word) (md : Word) (a : Word) (b : Word) (c : Word) : Word
  zero: ret a
  x <- b2-wnfbatch rx bk md a b c
  kd <- rd (b2-HR M #7)
  v <- rd (b2-HR M #8)
  if %weq kd #0
    ret v
  md2 <- rd (b2-HR M #11)
  a2 <- rd (b2-HR M #12)
  b2 <- rd (b2-HR M #13)
  c2 <- rd (b2-HR M #14)
  jump b2-wnfrun f rx bk md2 a2 b2 c2

@split b2x 1 4 5 7 20 21 50 52
