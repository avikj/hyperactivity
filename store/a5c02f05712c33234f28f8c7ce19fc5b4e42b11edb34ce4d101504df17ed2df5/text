b2-f32raw : Word → List Word
b2-f32raw x =
  let sg = the (List Word) (if %weq (ief-sgn x) #1 then "-" else nil)
  in if ief-isnan x then "nan"
     else if ief-isinf x then list-append sg "inf"
     else if ief-iszero x then list-append sg "0"
     else (let ct = ief-shortest x in list-append sg (b2-jsnum (ce-dec (fst ct)) (snd ct)))

