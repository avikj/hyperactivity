b2-fcos : Word → Word
b2-fcos x =
  if orB (ief-isnan x) (ief-isinf x) then ief-NAN
  else if ief-iszero x then #1065353216
  else (let rd = ief-reduce x
            q = fst rd
            sc = ief-sc (snd rd)
            v = the (Word × List Word) (if %weq q #0 then snd sc else if %weq q #1 then sx-neg (fst sc)
                else if %weq q #2 then sx-neg (snd sc) else fst sc)
        in ief-fix (fst v) (snd v))

b2-isdg : Word → Bool
b2-isdg c = andB (%wlt #47 c) (%wlt c #58)

b2-fdigs : List Word → List Word
b2-fdigs nil = nil
b2-fdigs (cons c r) = if b2-isdg c then b2-fdigs r else cons c r

b2-fndigs : List Word → Word
b2-fndigs nil = #0
b2-fndigs (cons c r) = if b2-isdg c then %wsucc (b2-fndigs r) else #0

-- [+-]? ((d+ (. d*)? | . d+) (e [+-]? d+)? | inf | infinity | nan), lower case
b2-unsign : List Word → List Word
b2-unsign nil = nil
b2-unsign (cons c r) = if orB (%weq c #43) (%weq c #45) then r else cons c r

b2-fexp : List Word → Bool
b2-fexp nil = true
b2-fexp (cons c r) = andB (%weq c #101) (andB (%wlt #0 (b2-fndigs (b2-unsign r))) (h4-isnil (b2-fdigs (b2-unsign r))))

b2-ffrac : Word → List Word → Bool
b2-ffrac n1 nil = %wlt #0 n1
b2-ffrac n1 (cons c r) = if %weq c #46 then andB (orB (%wlt #0 n1) (%wlt #0 (b2-fndigs r))) (b2-fexp (b2-fdigs r)) else andB (%wlt #0 n1) (b2-fexp (cons c r))

b2-fvalid : List Word → Bool
b2-fvalid s = b2-fvalid2 (b2-unsign s)

b2-fvalid2 : List Word → Bool
b2-fvalid2 t = orB (cli-eq t "inf") (orB (cli-eq t "infinity") (orB (cli-eq t "nan") (b2-ffrac (b2-fndigs t) (b2-fdigs t))))

b2-lws : List Word → List Word
b2-lws nil = nil
b2-lws (cons c r) = if orB (%weq c #32) (andB (%wlt #8 c) (%wlt c #14)) then b2-lws r else cons c r

-- F32.read on a literal text: Some(the nearest F32) or None
fn b2-fread32 (w0 : Word) : Word
  w <- b2-strip w0
  tg <- b2m-tag w
  lk <- b2m-f w #0
  if not (andB (%weq tg b2-LIT) (%weq lk b2-LSTR))
    ret hv2-none
  v <- b2m-f w #1
  us <-[b2-dpl] b2-units v
  let t = ief-low (b2-lws us)
  if b2-fvalid t
    x <- b2m-n2 b2-LIT #0 b2-LF32 (ief-parse t)
    sm <- b2-nm "Some"
    xs <- b2-arr1 x
    r <- b2-Ctr sm xs #0
    ret r
  nn <- b2-nm "None"
  e <- b2-arr #0
  r <- b2-Ctr nn e #0
  ret r

-- sqrt, correctly rounded: x = M·2^E (E even), q = isqrt(M·2^38), rounded to 24 bits with the
-- remainder as the sticky bit
b2-isqrtg : Nat → Word → Word → Word → Word
b2-isqrtg zero n q b = q
b2-isqrtg (suc k) n q b = let t = %wor q b in b2-isqrtg k n (the Word (if not (%wlt n (%wmul t t)) then t else q)) (%wshr b #1)

b2-isqrt : Word → Word
b2-isqrt n = b2-isqrtg (toNat #32) n #0 #2147483648

b2-fnorm : Nat → Word → Word → Word × Word
b2-fnorm zero m e = (m , e)
b2-fnorm (suc k) m e = if %wlt m #8388608 then b2-fnorm k (%wshl m #1) (%wsub e #1) else (m , e)

-- F32 exp, log2, log10, asin, acos and sinh, cosh, tanh, each Math.fround of the exact value
-- (the library's fixed point: (sign, magnitude) at 2^P, rounded once to the nearest F32)

-- |x| at 2^P (x = m * 2^(e - 4096))
b2-fxfix : Word → List Word
b2-fxfix x =
  let t = bg-shl (bg-of (ief-m x)) ief-P
      e = ief-e x
  in if %wlt e #4096 then bg-shr t (%wsub #4096 e) else bg-shl t (%wsub e #4096)

b2-fexpv : Word → Word
b2-fexpv x =
  if ief-isnan x then x
  else if ief-isinf x then (if %weq (ief-sgn x) #0 then x else #0)
  else if ief-iszero x then #1065353216
  else (let zs = b2-fxfix x
        in if bg-ge zs (bg-shl (bg-of #110) ief-P) then (if %weq (ief-sgn x) #0 then ief-INF else #0)
           else ief-expfix (if bg-is0 zs then #0 else ief-sgn x , zs))

b2-ln10-P : List Word
b2-ln10-P = snd (ief-lnfix #1092616192)

-- ln x over a constant's log (ln 2, ln 10)
b2-flogb : Word → List Word → Word
b2-flogb x c =
  if ief-isnan x then x
  else if ief-iszero x then ief-inf #1
  else if %weq (ief-sgn x) #1 then ief-NAN
  else if ief-isinf x then x
  else (let l = ief-lnfix x
        in if bg-is0 (snd l) then #0 else ief-ratio (fst l) (snd l) c #4096 #1)

-- e^z and e^-z for z >= 0 at 2^P: (n, (a, b)) with e^z = a 2^n, e^-z = b 2^-n
b2-fexps : List Word → Word × (List Word × List Word)
b2-fexps z =
  let l2 = ief-ln2-P
      nq = fst (bg-divmod (bg-add (bg-shl1 z) l2) (bg-shl1 l2))
      r = sx-add (#0 , z) (sx-neg (#0 , bg-mul nq l2))
      ep = ief-ex-ser ief-fuel #1 (snd r) (snd r) (fst r) (#0 , nil)
      em = ief-ex-ser ief-fuel #1 (snd r) (snd r) (%wxor (fst r) #1) (#0 , nil)
      one = the (Word × List Word) (#0 , bg-pow2 ief-P)
  in (bg-lo nq , (snd (sx-add ep one) , snd (sx-add em one)))

-- k 0 sinh, 1 cosh, 2 tanh
b2-fhyp : Word → Word → Word
b2-fhyp k x =
  let sg = ief-sgn x
  in if ief-isnan x then x
     else if ief-isinf x then (if %weq k #1 then ief-INF else if %weq k #0 then x else %wor (%wshl sg #31) #1065353216)
     else if ief-iszero x then (if %weq k #1 then #1065353216 else x)
     else (let z = b2-fxfix x
           in if bg-ge z (bg-shl (bg-of #100) ief-P)
              then (if %weq k #1 then ief-INF else if %weq k #0 then ief-inf sg else %wor (%wshl sg #31) #1065353216)
              else if andB (not (%weq k #1)) (%wlt (bg-bitlen z) (%wsub ief-P #12))
              then x
              else (let es = b2-fexps z
                        nw = fst es
                        a = bg-shl (fst (snd es)) (%wshl nw #1)
                        b = snd (snd es)
                        n = bg-sub a b
                        d = bg-add a b
                        ex = %wsub (%wsub #4096 nw) (%wadd #1 ief-P)
                    in if %weq k #0 then ief-round-bg sg n ex #1
                       else if %weq k #1 then ief-round-bg #0 d ex #1
                       else ief-ratio sg n d #4096 #1))

-- floor sqrt by Newton from above
b2-bgisq : Nat → List Word → List Word → List Word
b2-bgisq zero n y = y
b2-bgisq (suc f) n y =
  let y2 = bg-shr (bg-add y (fst (bg-divmod n y))) #1
  in if bg-ge y2 y then y else b2-bgisq f n y2

-- sqrt(1 - x^2) at 2^P for |x| = X / 2^P <= 1
b2-fcomp : List Word → List Word
b2-fcomp xx =
  let w = bg-sub (bg-pow2 (%wshl ief-P #1)) (bg-mul xx xx)
  in if bg-is0 w then w else b2-bgisq (toNat #600) w (bg-pow2 (%wadd ief-P #1))

b2-fasin : Word → Word
b2-fasin x =
  let sg = ief-sgn x
  in if ief-isnan x then x
     else if ief-iszero x then x
     else if ief-isinf x then ief-NAN
     else (let xx = b2-fxfix x
               one = bg-pow2 ief-P
               hpi = bg-shr ief-pi-P #1
           in if bg-ge xx (bg-add one bg-one) then ief-NAN
              else if %wlt (bg-bitlen xx) (%wsub ief-P #12) then x
              else (let d = b2-fcomp xx
                        at = the (List Word) (if bg-ge d xx then ief-atan01 xx d else bg-sub hpi (ief-atan01 d xx))
                    in ief-round-bg sg at (%wsub #4096 ief-P) #1))

b2-facos : Word → Word
b2-facos x =
  if ief-isnan x then x
  else if ief-isinf x then ief-NAN
  else (let xx = b2-fxfix x
            one = bg-pow2 ief-P
            pi = ief-pi-P
            hpi = bg-shr pi #1
        in if bg-ge xx (bg-add one bg-one) then ief-NAN
           else (let d = b2-fcomp xx
                     base = the (List Word) (if bg-is0 xx then hpi else if bg-ge xx d then ief-atan01 d xx else bg-sub hpi (ief-atan01 xx d))
                     v = the (List Word) (if %weq (ief-sgn x) #1 then bg-sub pi base else base)
                 in if bg-is0 v then #0 else ief-round-bg #0 v (%wsub #4096 ief-P) #1))

b2-fsqrt : Word → Word
b2-fsqrt x =
  if orB (ief-isnan x) (ief-iszero x) then x
  else if %weq (ief-sgn x) #1 then ief-NAN
  else if ief-isinf x then x
  else (let be = %wand (%wshr x #23) #255
            fr = %wand x #8388607
            me = the (Word × Word) (if %weq be #0 then b2-fnorm (toNat #24) fr #1001 else (%wor fr #8388608 , %wadd be #1000))
            odd = %weq (%wand (snd me) #1) #1
            m2 = the Word (if odd then %wshl (fst me) #1 else fst me)
            e2 = the Word (if odd then %wsub (snd me) #1 else snd me)
            n = %wshl m2 #38
            q = b2-isqrt n
            r = %wsub n (%wmul q q)
            l = b2-blen q #0
            sh = %wsub l #24
            qm = %wshr q sh
            rest = %wand q (%wsub (%wshl #1 sh) #1)
            half = %wshl #1 (%wsub sh #1)
            up = orB (%wlt half rest) (andB (%weq rest half) (orB (not (%weq r #0)) (%weq (%wand qm #1) #1)))
