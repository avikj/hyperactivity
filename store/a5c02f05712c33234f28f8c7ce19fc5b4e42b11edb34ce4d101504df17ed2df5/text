    va <- b2-sunits w0
    vb <- b2-sunits w1
    if orB (%weq va #0) (%weq vb #0)
      ret hv2-none
    n <- b2-slen va
    m <- b2-slen vb
    if %wlt #32 (%wadd n m)
      rp <- b2m-alloc #4
      do b2m-wr rp b2-ROPE
      do b2m-wr (%wadd rp #1) va
      do b2m-wr (%wadd rp #2) vb
      do b2m-wr (%wadd rp #3) (%wadd n m)
      r <- b2m-n2 b2-LIT #0 b2-LSTR rp
      ret r
    a <- b2-sarr va
    p <- b2-sarr vb
    o <- b2-arr (%wadd n m)
    do b2-acopy (toNat #4294967295) a o #0 #0 n
    do b2-acopy (toNat #4294967295) p o #0 n m
    r <- b2m-n2 b2-LIT #0 b2-LSTR o
    ret r
  a <- b2-sunitsa w0
  if %weq a #0
    ret hv2-none
  n <- b2m-len a
  if %weq ic #93
    c <- b2-scount (toNat #4294967295) a n #0 #0
    r <- b2m-n2 b2-LIT #0 b2-LNAT c
    ret r
  p <- b2-sunitsa w1
  if %weq p #0
    ret hv2-none
  m <- b2m-len p
  if %weq ic #92
    if %weq n m
      ok <- b2-sat (toNat #4294967295) a p #0 #0 m
      bb <- b2-boolv (%weq ok #1)
      ret bb
    bb <- b2-boolv false
    ret bb
  ok <- b2-scont (toNat #4294967295) a n p m #0
  bb <- b2-boolv (%weq ok #1)
  ret bb

fn b2-intr (ic : Word) (w0 : Word) (w1 : Word) : Word
