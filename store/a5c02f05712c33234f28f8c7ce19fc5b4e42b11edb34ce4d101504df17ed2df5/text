            q2 = the Word (if %weq qr #16777216 then #8388608 else qr)
            p1 = the Word (if %weq qr #16777216 then %wsucc p0 else p0)
        in %wor (%wshl p1 #23) (%wsub q2 #8388608))

-- an argument an intrinsic may read: a literal or a constructor (anything else is stuck, and
-- the definition's own match decides, as it would without the intrinsic)
-- an intrinsic's argument as it stands: a computed cell's value, 0 for a cell not yet
-- evaluated, anything else itself
fn b2-ipeek (x : Word) : Word
  tg <- b2m-tag x
  i <- b2m-f x #1
  if andB (%weq tg b2-VAR) (%weq i b2-M1)
    ret #0
  r <- b2-strip x
  ret r

-- a Nat argument as a literal through its Succ chain (64 at most): 1 with the literal in
-- register 33, 2 with a cell still to evaluate there, 0 when it is no Nat (or t is 0)
fnrec b2-inat (f : Nat) (t : Word) (acc : Word) : Word
  zero: ret #0
  if %weq t #0
    ret #0
  tg0 <- b2m-tag t
  ix0 <- b2m-f t #1
  if andB (%weq tg0 b2-VAR) (%weq ix0 b2-M1)
    wr (b2-HR M #33) t
    ret #2
  w <- b2-strip t
  tg <- b2m-tag w
  lk <- b2m-f w #0
  v <- b2m-f w #1
  if andB (%weq tg b2-LIT) (%weq lk b2-LNAT)
    r <- b2m-n2 b2-LIT #0 b2-LNAT (%wadd acc v)
    wr (b2-HR M #33) r
    ret #1
  if andB (%weq tg b2-CTR) (%weq lk b2-NZero)
    r <- b2m-n2 b2-LIT #0 b2-LNAT acc
    wr (b2-HR M #33) r
    ret #1
  if andB (%weq tg b2-CTR) (%weq lk b2-NSucc)
    x <- b2m-at v #0
    jump b2-inat f x (%wsucc acc)
  ret #0

-- ===========================================================================================
-- Arrays on the IO lane: the JS lane's arrays (a literal of kind 4 over a RAM array of cells).
-- Array.set and the swaps write in place, as JS's do; a match sees ALeaf{x} for one cell and
-- ANode{left half, right half} (copies, as slice makes) otherwise.
-- ===========================================================================================

b2-LARR : Word
b2-LARR = #4

-- the arity of an array native
b2-arrar : Word → Word
b2-arrar ic = if orB (%weq ic #105) (%weq ic #106) then #2 else if orB (%weq ic #100) (orB (%weq ic #101) (%weq ic #102)) then #3 else if %weq ic #117 then #5 else #4

-- the argument cells an array native evaluates first, by index (JS is strict: a stored value
-- is computed when it is stored, not when it is read, after later writes): the type, depth
-- and value of a new array; otherwise the array, its index, a stored value, an atomic's operands
b2-arrneed : Word → Word → Bool
b2-arrneed ic j = if %weq ic #100 then %wlt j #3 else if orB (%weq ic #105) (%weq ic #106) then %weq j #1 else if orB (%weq ic #103) (%weq ic #104) then %wlt #0 j else if orB (%weq ic #101) (%weq ic #102) then orB (%weq j #1) (%weq j #2) else %wlt #0 j

-- the argument cell j of a call whose frames end at sp
fn b2-argat (sp : Word) (j : Word) : Word
  fr <- rd (b2-sa M (%wsub sp (%wsucc j)))
  x <- b2m-rd (%wadd fr #1)
  ret x

-- the first argument it reads that is a cell not yet evaluated, or 0
fnrec b2-arrwant (f : Nat) (ic : Word) (sp : Word) (j : Word) (n : Word) : Word
  zero: ret #0
  if %weq j n
    ret #0
  x <- b2-argat sp j
  q <- b2-ipeek x
  if andB (b2-arrneed ic j) (%weq q #0)
    ret x
  jump b2-arrwant f ic sp (%wsucc j) n

-- a new array's cells, each v
fnrec b2-afill (f : Nat) (a : Word) (j : Word) (n : Word) (v : Word) : Word
  zero: ret a
  if %weq j n
    ret a
  do b2m-put a j v
  jump b2-afill f a (%wsucc j) n v

-- log2 of a cell's 32-bit words (lay_el, for the scalars: U32 and F32 one word, Nat two)
fn b2-arrlgs (t : Word) : Word
  w <- b2-strip t
  tg <- b2m-tag w
  k <- b2m-f w #0
  if andB (orB (%weq tg b2-ADT) (%weq tg b2-REF)) (%weq k b2-NNat)
    ret #1
  -- another datatype: its fields in more than one word (a record of two words, Pt{U32, U32})
  if andB (%weq tg b2-ADT) (not (orB (%weq k b2-NU32) (%weq k b2-NF32)))
    ret #1
  ret #0

-- an array native: its answer; hv2-none2 with register 35 the array argument when that is an
-- ALeaf/ANode tree (made a literal first); hv2-none2 with register 36 an element to evaluate;
-- hv2-none when it does not apply
fn b2-arrop (ic : Word) (sp : Word) : Word
  x0 <- b2-argat sp #0
  x1 <- b2-argat sp #1
  q0 <- b2-ipeek x0
  q1 <- b2-ipeek x1
  if %weq ic #100
    kd <- b2-inat (toNat #64) q1 #0
    if not (%weq kd #1)
      ret hv2-none
    dl <- rd (b2-HR M #33)
    d <- b2m-f dl #1
    lg <- b2-arrlgs q0
    if %wlt (%wsub #31 lg) d
      halt (scmd (w-fd-write #2 (list-append "bend: an array past the deepest block class 31 (depth + log2 words per cell)" (cons #10 nil))) (λ x → sdone #1))
    x2 <- b2-argat sp #2
    let n = %wshl #1 d
    a <- b2-arr n
    do b2-afill (toNat #4294967295) a #0 n x2
    r <- b2m-n2 b2-LIT #0 b2-LARR a
    ret r
  tg <- b2m-tag q1
  lk <- b2m-f q1 #0
  if andB (%weq tg b2-CTR) (orB (%weq lk b2-NALeaf) (%weq lk b2-NANode))
    wr (b2-HR M #35) x1
    ret hv2-none2
  if not (andB (%weq tg b2-LIT) (%weq lk b2-LARR))
    ret hv2-none
  a <- b2m-f q1 #1
  n <- b2m-len a
  if %weq ic #105
    nl <- b2m-n2 b2-LIT #0 b2-LU32 n
    r <- b2-ctr2 b2-NTuple q1 nl
    ret r
  if %weq ic #106
    o <- b2-arr n
    do b2-acopy (toNat #4294967295) a o #0 #0 n
    cl <- b2m-n2 b2-LIT #0 b2-LARR o
    r <- b2-ctr2 b2-NTuple q1 cl
    ret r
  x2 <- b2-argat sp #2
  q2 <- b2-ipeek x2
  iv <- b2-numof q2 #0
  if %weq iv b2-NNONE
    ret hv2-none
  let at = %wand iv (%wsub n #1)
  old <- b2m-at a at
  if orB (%weq ic #101) (%weq ic #102)
    r <- b2-ctr2 b2-NTuple q1 old
    ret r
  x3 <- b2-argat sp #3
  if %weq ic #103
    do b2m-put a at x3
    ret q1
  if %weq ic #104
    do b2m-put a at x3
    r <- b2-ctr2 b2-NTuple q1 old
    ret r
  -- the atomics: the old element and the operands as numbers
  qo <- b2-ipeek old
  if %weq qo #0
    wr (b2-HR M #36) old
    ret hv2-none2
  q3 <- b2-ipeek x3
  x4 <- b2-argat sp (the Word (if %weq ic #117 then #4 else #3))
  q4 <- b2-ipeek x4
  let fl = %weq ic #118
