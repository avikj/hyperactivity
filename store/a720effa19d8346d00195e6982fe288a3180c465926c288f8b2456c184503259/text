-- THEOREM 4 (UNIVERSAL SUPEROPT SOUNDNESS): Iterated hyperfactorization preserves exact semantics across ALL inputs!
bfm-thm-superopt-sound : (n : Nat) → (env : Nat → Bool) → (e : GuardExpr) → ge-eval env (ge-superopt n e) ≡ ge-eval env e
bfm-thm-superopt-sound zero    env e = refl
bfm-thm-superopt-sound (suc n) env e =
  bfm-trans (bfm-thm-superopt-sound n env (ge-factor e)) (ge-factor-sound env e)
