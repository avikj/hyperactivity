tc-cert-z2 : (QgmState → QgmState) → List Bool → List (List BZ) → List Bool → List (List BZ) → List (List BZ) → List QgmState → Bool
tc-cert-z2 tf se le-mat so lo-mat mat basis =
  (λ ts →
    if sc-z2-check-rows zero mat mat ts
    then both (sc-rump-pd se (sc-proj-mat mat (sc-build-even zero ts)) le-mat)
              (sc-rump-pd so (sc-proj-mat mat (sc-build-odd  zero ts)) lo-mat)
    else false)
  (tc-build-ts tf basis basis)
