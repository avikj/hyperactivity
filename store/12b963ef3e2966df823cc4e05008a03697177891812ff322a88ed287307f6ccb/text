-- (5) Explicit Sylvester Law of Inertia theorem instantiation on qgm-H-full at threshold -1/4:
--     any valid orthogonal witness vs for (4 * H_full + I) MUST exhibit exactly 1 negative direction.
qgc-bound-unique-sound : (vs : List (sy-vn ZrC (cq-len qgm-H-full))) →
  snd (inertia-cert (cq-len qgm-H-full) (zr-sym (cq-len qgm-H-full) (in-shift (bz-of (bin-of-nat 4)) (bz-neg bz-one) zero qgm-H-full)) vs) ≡ true →
  1 ≡ fst (inertia-cert (cq-len qgm-H-full) (zr-sym (cq-len qgm-H-full) (in-shift (bz-of (bin-of-nat 4)) (bz-neg bz-one) zero qgm-H-full)) vs)
qgc-bound-unique-sound vs hv = concat
  (sym (λ i → fst (qgc-full-hi i)))
  (inertia-cert-sound (cq-len qgm-H-full)
    (zr-sym (cq-len qgm-H-full) (in-shift (bz-of (bin-of-nat 4)) (bz-neg bz-one) zero qgm-H-full))
    (zr-wit qgm-H-full (bz-neg bz-one) (bz-of (bin-of-nat 4)))
    vs
    (λ i → snd (qgc-full-hi i))
    hv)
