h3d-xp-dup : (W : Type) → (zW : W) → (addW : W → W → W) → (negW : W → W) → QgmAb W zW addW negW →
  (tau : W → W) → ((x y : W) → tau (addW x y) ≡ addW (tau x) (tau y)) →
  (x : W) → sc-xp W addW tau (addW x x) ≡ addW (sc-xp W addW tau x) (sc-xp W addW tau x)
h3d-xp-dup W zW addW negW ab tau hlin x =
  lor-tr W
    (addW (addW x x) (tau (addW x x)))
    (addW (addW x x) (addW (tau x) (tau x)))
    (addW (sc-xp W addW tau x) (sc-xp W addW tau x))
    (cong (λ t → addW (addW x x) t) (hlin x x))
    (qgm-swap4 W zW addW negW ab x x (tau x) (tau x))
