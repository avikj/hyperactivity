h4-mk2 : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-mk2 m tag ext a b k =
  h4-alloc m #2 (λ at → let m10 = h4-dep m at in scmd (w-store ((h4-ha m10 at)) (a)) (λ u11 → let m12 = hv2-u m10 u11 in scmd (w-store ((h4-ha m12 (%wadd at #1))) (b)) (λ u13 → let m14 = hv2-u m12 u13 in k (h4-depl m14 ((h4-new tag ext at))))))
