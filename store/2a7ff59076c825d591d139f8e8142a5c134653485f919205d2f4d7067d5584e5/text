b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_7090 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_7090 (#1))) else (b2-pstr mm_7090 p (λ s → let mm_7091 = b2-dep mm_7090 s in let p_7093 = p in let i_7095 = (%wadd p_7093 #1) in scmd (w-load ((b2-a mm_7091 i_7095))) (λ x_7094 → let mm_7096 = b2-dep mm_7091 x_7094 in let x_7092 = x_7094 in let i = x_7092 in let a_7098 = s in scmd (w-load ((b2-a mm_7096 a_7098))) (λ x_7097 → let mm_7099 = b2-dep mm_7096 x_7097 in let n = x_7097 in b2-col mm_7099 s i (λ c → let mm_7100 = b2-dep mm_7099 c in kq_ (h4-depl mm_7100 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
