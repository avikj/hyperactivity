-- L R(0, v) for v, v + 1, … (k of them)
na-pot : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → A → Nat → List FaradayLine → Nat → Nat → List A
na-pot A ad mu q l n ls v k = case k of
  zero → nil
  suc g → cons (mu (na-of-sq A ad mu q (np-resistance n ls 0 v)) l) (na-pot A ad mu q l n ls (suc v) g)
