b2-name : Word → Word → (Word → Step W Word) → Step W Word
b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_6845 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6845 b2-ERR)) else (b2-iskw mm_6845 k (λ kw → let mm_6846 = b2-dpb mm_6845 kw in if (kw) then (b2-nbytes mm_6846 k (λ kb → let mm_6847 = b2-dpl mm_6846 kb in let p_6849 = p in let i_6851 = (%wadd p_6849 #1) in scmd (w-load ((b2-a mm_6847 i_6851))) (λ x_6850 → let mm_6852 = b2-dep mm_6847 x_6850 in let x_6848 = x_6850 in let i = x_6848 in let p_6854 = p in let i_6856 = (%wadd p_6854 #1) in scmd (w-load ((b2-a mm_6852 i_6856))) (λ x_6855 → let mm_6857 = b2-dep mm_6852 x_6855 in let x_6853 = x_6855 in let ixq = x_6853 in b2-pfail mm_6857 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6858 = b2-dep mm_6857 r in kq_ (h4-depl mm_6858 (r))))))) else (kq_ (h4-depl mm_6846 (k))))))
