h4-lend : Word → Nat → Word → (Word → Step W Word) → Step W Word
h4-lend mm_ zero x kq_ =
  kq_ (h4-depl mm_ (x))
h4-lend mm_ (suc f) x kq_ =
  if (andB (%weq (h4-tag x) h4-C02) (%weq (h4-ext x) h4-CON)) then (scmd (w-load ((h4-ha mm_ (%wadd (h4-val x) #1)))) (λ nx → let mm_2802 = h4-dep mm_ nx in h4-lend mm_2802 f nx kq_)) else (kq_ (h4-depl mm_ (x)))
