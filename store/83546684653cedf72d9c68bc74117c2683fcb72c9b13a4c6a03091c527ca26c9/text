-- the name of the lambda whose body is at loc, bound on first sight (print_state_lam)
h4-plook : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
h4-plook mm_ zero loc i kq_ =
  h4-rterr mm_ "print_state: too many lambdas" kq_
h4-plook mm_ (suc f) loc i kq_ =
  scmd (w-load ((h4-PLL mm_))) (λ n → let mm_2770 = h4-dep mm_ n in if (%weq i n) then (scmd (w-load ((h4-PNL mm_2770))) (λ nm → let mm_2771 = h4-dep mm_2770 nm in scmd (w-store ((h4-PNL mm_2771)) ((%wsucc nm))) (λ uu_2772 → let mm_2773 = hv2-u mm_2771 uu_2772 in scmd (w-store ((h4-plam mm_2773 i)) (loc)) (λ uu_2774 → let mm_2775 = hv2-u mm_2773 uu_2774 in scmd (w-store ((%wadd (h4-plam mm_2775 i) #8)) (nm)) (λ uu_2776 → let mm_2777 = hv2-u mm_2775 uu_2776 in scmd (w-store ((h4-PLL mm_2777)) ((%wsucc n))) (λ uu_2778 → let mm_2779 = hv2-u mm_2777 uu_2778 in kq_ (h4-depl mm_2779 (nm)))))))) else (scmd (w-load ((h4-plam mm_2770 i))) (λ l → let mm_2780 = h4-dep mm_2770 l in if (%weq l loc) then (scmd (w-load ((%wadd (h4-plam mm_2780 i) #8))) (λ nm → let mm_2781 = h4-dep mm_2780 nm in kq_ (h4-depl mm_2781 (nm)))) else (h4-plook mm_2780 f loc (%wsucc i) kq_))))
