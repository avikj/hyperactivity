-- ── 4. Thiele-Small Electromechanical Transducer Exact Port-Hamiltonian Law ──
-- Headphone / AirPods moving-coil driver: electrical coil (i, Re) coupled via
-- lossless gyrator Bl to mechanical diaphragm (v, Rm):
--   P_total = i*(-Re*i - Bl*v) + v*(Bl*i - Rm*v) == -(Re*i^2 + Rm*v^2) <= 0
-- Proves exact cancellation of gyrator power and unconditional transducer passivity!
-- Variables (0..4): Re, Rm, Bl, ic, vel.
one-field-thiele-small-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
one-field-thiele-small-poly A ad mu q vs =
  (λ g sub sq →
    let re = g 0; rm = g 1; bl = g 2; ic = g 3; vel = g 4
        pElec = mu ic (sub (sub (q (fn-q 0 1)) (mu re ic)) (mu bl vel))
        pMech = mu vel (sub (mu bl ic) (mu rm vel))
        lhs   = ad pElec pMech
        rhs   = sub (q (fn-q 0 1)) (ad (mu re (sq ic)) (mu rm (sq vel)))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
