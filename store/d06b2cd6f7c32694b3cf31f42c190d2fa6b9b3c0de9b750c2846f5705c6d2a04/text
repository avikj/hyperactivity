b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_7335 → let mm_7336 = b2-dep mm_ dd_7335 in b2-take mm_7336 p "-" (λ m → let mm_7337 = b2-dep mm_7336 m in if (%weq m #1) then (kq_ (h4-depl mm_7337 (b2-NONE))) else (b2-take mm_7337 p "+" (λ pl → let mm_7338 = b2-dep mm_7337 pl in if (%weq pl #1) then (kq_ (h4-depl mm_7338 (b2-MANY))) else (kq_ (h4-depl mm_7338 (b2-LONE))))))))
