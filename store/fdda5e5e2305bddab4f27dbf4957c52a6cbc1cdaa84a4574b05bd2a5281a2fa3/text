-- the one rule, in memory
hr-do : Nat → List Hv2Def → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
hr-do fu book r m a b k =
  if %weq r hv2-LINK then hr-ln fu m a b k
  else if %weq r hv2-CALL then hr-call fu book m a b k
  else if %weq r hv2-VOID then k m
  else if %weq r hv2-ERAS then hr-eras fu m a b k
  else if %weq r hv2-ANNI then hr-anni fu m a b k
  else if %weq r hv2-COMM then hr-comm fu m a b k
  else if %weq r hv2-OPER then hr-oper fu m a b k
  else hr-swit fu m a b k
