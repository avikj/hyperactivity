-- task i before task j
h4-qlt : Word → Word → Word → (Bool → Step W Word) → Step W Word
h4-qlt mm_ i j kq_ =
  scmd (w-load ((h4-qa mm_ i #0))) (λ ki → let mm_3101 = h4-dep mm_ ki in scmd (w-load ((h4-qa mm_3101 i #1))) (λ ci → let mm_3102 = h4-dep mm_3101 ci in scmd (w-load ((h4-qa mm_3102 i #2))) (λ si → let mm_3103 = h4-dep mm_3102 si in scmd (w-load ((h4-qa mm_3103 j #0))) (λ kj → let mm_3104 = h4-dep mm_3103 kj in scmd (w-load ((h4-qa mm_3104 j #1))) (λ cj → let mm_3105 = h4-dep mm_3104 cj in scmd (w-load ((h4-qa mm_3105 j #2))) (λ sj → let mm_3106 = h4-dep mm_3105 sj in let a = h4-okey ki ci in let b = h4-okey kj cj in kq_ (h4-depl mm_3106 ((the Bool (if %weq a b then %wlt si sj else %wlt a b))))))))))
