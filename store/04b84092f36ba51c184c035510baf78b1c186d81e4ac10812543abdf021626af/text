grv-wdw-boost-disc-pos : Nat → Bool
grv-wdw-boost-disc-pos ell =
  (λ aS absBS cS →
    leb (suc (times 4 (times aS cS))) (times absBS absBS))
  (times ell (times (times (suc ell) (suc ell)) (times ell (plus (times 3 ell) 2))))
  (times (plus (times 2 ell) 1)
         (times (times ell (suc ell))
                (monus (times 2 (times (times 2 ell) (suc (times 2 ell))))
                       (times 3 (times ell (suc ell))))))
  (times (suc ell) (times (times ell ell) (times (suc ell) (plus (times 3 ell) 1))))
