hxp-hex6-xor-cancel : (h m : Hex6) → hxp-hex6-xor (hxp-hex6-xor h m) m ≡ h
hxp-hex6-xor-cancel h m =
  λ i →
    ( hxp-bxor-cancel (fst h) (fst m) i
    , ( hxp-bxor-cancel (fst (snd h)) (fst (snd m)) i
      , ( hxp-bxor-cancel (fst (snd (snd h))) (fst (snd (snd m))) i
        , ( hxp-bxor-cancel (fst (snd (snd (snd h)))) (fst (snd (snd (snd m)))) i
          , ( hxp-bxor-cancel (fst (snd (snd (snd (snd h))))) (fst (snd (snd (snd (snd m))))) i
            , hxp-bxor-cancel (snd (snd (snd (snd (snd h))))) (snd (snd (snd (snd (snd m))))) i )))))
