-- Strict 0px Swiss Monospace Stylesheet (`#000000`, `#ffffff`, `#ff0a94` ONLY):
cl-sheet-a : List CssRule
cl-sheet-a =
  cons (css-rule "*,*::before,*::after" (d2 "box-sizing" "border-box" "border-radius" "0"))
  (cons (css-rule "html,body"
    (d5 "margin" "0" "padding" "0" "background" "#000000" "color" "#ffffff"
        "font" "12px/1.45 'SF Mono','JetBrains Mono',ui-monospace,Menlo,Consolas,monospace"))
  (cons (css-rule "a" (d2 "color" "#ffffff" "text-decoration" "underline"))
  (cons (css-rule "a:hover" (d1 "color" "#ff0a94"))
  (cons (css-rule ".top"
    (d6 "display" "flex" "flex-wrap" "wrap" "justify-content" "space-between" "align-items" "center"
        "padding" "10px 16px" "border-bottom" "2px solid #ffffff"))
  (cons (css-rule ".brand"
    (d4 "display" "inline-flex" "align-items" "center" "gap" "9px" "font-weight" "700"))
  (cons (css-rule ".sq"
    (d3 "width" "9px" "height" "9px" "background" "#ff0a94"))
  (cons (css-rule ".row"
    (d4 "display" "flex" "flex-wrap" "wrap" "align-items" "center" "gap" "6px"))
  (cons (css-rule ".btn"
    (d6 "background" "#000000" "color" "#ffffff" "border" "1px solid #ffffff"
        "padding" "6px 10px" "font" "700 11px ui-monospace,Menlo,monospace" "cursor" "pointer"))
  (cons (css-rule ".btn:hover"
    (d2 "border-color" "#ff0a94" "color" "#ff0a94"))
  (cons (css-rule ".btn.pri"
    (d3 "background" "#ff0a94" "color" "#ffffff" "border-color" "#ff0a94"))
  (cons (css-rule ".inp"
    (d5 "background" "#050505" "color" "#ffffff" "border" "1px solid #666666"
        "padding" "6px 8px" "font" "11.5px ui-monospace,Menlo,monospace"))
  nil)))))))))))
