b2-foreigntip : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-foreigntip mm_ zero bk tel d kq_ =
  kq_ (h4-depl mm_ (tel))
b2-foreigntip mm_ (suc f) bk tel d kq_ =
  b2-strip mm_ tel (λ t → let mm_12493 = b2-dep mm_ t in let t_12495 = t in scmd (w-load ((b2-a mm_12493 t_12495))) (λ x_12494 → let mm_12496 = b2-dep mm_12493 x_12494 in let tg = (%wand x_12494 #255) in if (not (%weq tg b2-ALL)) then (kq_ (h4-depl mm_12496 (t))) else (let t_12498 = t in let j_12499 = #1 in scmd (w-load ((b2-a mm_12496 (%wadd t_12498 (%wadd #2 j_12499))))) (λ x_12497 → let mm_12500 = b2-dep mm_12496 x_12497 in let k = x_12497 in let t_12502 = t in let j_12503 = #4 in scmd (w-load ((b2-a mm_12500 (%wadd t_12502 (%wadd #2 j_12503))))) (λ x_12501 → let mm_12504 = b2-dep mm_12500 x_12501 in let vB = x_12501 in b2-Var mm_12504 k d #0 #0 (λ x → let mm_12505 = b2-dep mm_12504 x in b2-body mm_12505 bk vB x (λ t2 → let mm_12506 = b2-dep mm_12505 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_12506 b2-ERR)) else (b2-foreigntip mm_12506 f bk t2 (%wsucc d) kq_))))))))
