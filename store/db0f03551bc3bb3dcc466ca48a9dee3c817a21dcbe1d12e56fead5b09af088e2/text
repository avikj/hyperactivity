r4d-bc-lhs-term : (C : Type) → Nat → (BstUF → C) → C
r4d-bc-lhs-term C kA cont =
  (λ tf →
    r4d-bc-simp C 0 1 2 4 5 tf (λ s3 →
    r4d-bc-simp C 0 1 2 3 5 tf (λ s4 →
    r4d-bc-simp C 0 1 2 3 4 tf (λ s5 →
    bst-force-uf C (r4d-uf-mul (bin-of-nat (times (suc kA) (suc kA)) , bin-one)
                               (r4d-uf-mul s3 (r4d-uf-mul s4 s5)))
      (λ n d → cont (n , d))))))
  (r4d-with-fA r4d-bc-tri kA)
