h3d-rump-rows : List Bool → Nat → List (List BZ) → List (List BZ) → List (List BZ) → List (List BZ) → Bool
h3d-rump-rows s2 i curM allM curL allL = case curM of
  nil → (case curL of nil → true; cons _ _ → false)
  cons rowM mrest → case curL of
    nil → false
    cons rowL lrest →
      if h3d-rump-cols s2 i zero rowM allM rowL allL h3d-gp-zero nil
      then h3d-rump-rows s2 (suc i) mrest allM lrest allL
      else false
