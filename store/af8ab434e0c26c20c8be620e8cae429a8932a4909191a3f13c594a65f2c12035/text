b2-namelen : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-namelen mm_ zero s i n kq_ =
  kq_ (h4-depl mm_ (i))
b2-namelen mm_ (suc f) s i n kq_ =
  if (not (%wlt i n)) then (kq_ (h4-depl mm_ (i))) else (let a_7304 = s in let j_7305 = i in scmd (w-load ((b2-a mm_ (%wadd a_7304 (%wsucc j_7305))))) (λ x_7303 → let mm_7306 = b2-dep mm_ x_7303 in let c = x_7303 in if (b2-ischar c) then (b2-namelen mm_7306 f s (%wsucc i) n kq_) else (kq_ (h4-depl mm_7306 (i)))))
