-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13555 = seen in let j_13556 = j in scmd (w-load ((b2-a mm_ (%wadd v_13555 #2)))) (λ d_13554 → let mm_13557 = b2-dep mm_ d_13554 in scmd (w-load ((b2-a mm_13557 (%wadd d_13554 (%wsucc j_13556))))) (λ x_13553 → let mm_13558 = b2-dep mm_13557 x_13553 in let e = x_13553 in let i_13560 = e in scmd (w-load ((b2-a mm_13558 i_13560))) (λ x_13559 → let mm_13561 = b2-dep mm_13558 x_13559 in let x = x_13559 in if (%weq x p) then (kq_ (h4-depl mm_13561 (e))) else (b2-seenat mm_13561 f seen p (%wsucc j) n kq_)))))
