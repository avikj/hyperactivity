-- batches of 2^10 interactions. Each batch marks the slab, runs, and rewinds to its mark, giving
-- back the transient memory it used (the net itself lives in the w-alloc block). The memory base
-- is the same word throughout, so the rewind's continuation is a function of book, m, n and k
-- alone: it is made before the mark, and nothing made after the mark is used after the rewind.
-- 2^22 batches, 2^32 interactions, at most
hr-run : Nat → List Hv2Def → Word → Nat → (Word → Step W Word) → Step W Word
hr-run fu book m zero k = k m
hr-run fu book m (suc n) k =
  scmd (w-sys #900 #0 #0 #0 #0 #0 #0) (λ r0 →
  hr-loop-d fu hv2-d10 book (hv2-keep m r0) k (λ m1 → scmd (w-sys #901 #0 #0 #0 #0 #0 #0) (λ r → hr-run fu book (hv2-keep m r) n k)))
