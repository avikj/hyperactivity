024))) (λ x_14023 → let mm_14025 = b2-dep mm_14022 x_14023 in let xs = x_14023 in let t_14027 = h in scmd (w-load ((b2-a mm_14025 t_14027))) (λ x_14026 → let mm_14028 = b2-dep mm_14025 x_14026 in let ht = (%wand x_14026 #255) in let t_14030 = h in let j_14031 = #0 in scmd (w-load ((b2-a mm_14028 (%wadd t_14030 (%wadd #2 j_14031))))) (λ x_14029 → let mm_14032 = b2-dep mm_14028 x_14029 in let hk = x_14029 in let a_14034 = xs in scmd (w-load ((b2-a mm_14032 a_14034))) (λ x_14033 → let mm_14035 = b2-dep mm_14032 x_14033 in let n = x_14033 in if (andB (%weq ht b2-REF) (%wlt #1 n)) then (let a_14037 = xs in let j_14038 = (%wsub n #1) in scmd (w-load ((b2-a mm_14035 (%wadd a_14037 (%wsucc j_14038))))) (λ x_14036 → let mm_14039 = b2-dep mm_14035 x_14036 in let kont = x_14036 in b2-effect mm_14039 bk hk xs argv (λ x → let mm_14040 = b2-dep mm_14039 x in if (not (%weq x hv2-none)) then (b2-tapp mm_14040 bk kont x #0 (λ t2 → let mm_14041 = b2-dep mm_14040 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_14041 b2-ERR)) else (b2-ioans mm_14041 #0 t2 kq_))) else (b2-namekey mm_14040 hk (λ kb → let mm_14042 = b2-dpl mm_14040 kb in scmd ((w-fd-write #2 (list-append "bend: no effect registers " (list-append kb (cons #10 nil))))) (λ e → let mm_14043 = b2-dep mm_14042 e in b2-ioans mm_14043 #1 #1 kq_)))))) else (scmd ((w-fd-write #2 (list-append "bend: an IO program stuck at a term that is no effect" (cons #10 nil)))) (λ e → let mm_14044 = b2-dep mm_14035 e in b2-ioans mm_14044 #1 #1 kq_)))))))))))))
