b2-dropg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-dropg mm_ zero a ob n j len kq_ =
  kq_ (h4-depl mm_ (ob))
b2-dropg mm_ (suc f) a ob n j len kq_ =
  if (%weq (%wadd n j) len) then (kq_ (h4-depl mm_ (ob))) else (let a_5455 = a in let j_5456 = (%wadd n j) in scmd (w-load ((b2-a mm_ (%wadd a_5455 (%wsucc j_5456))))) (λ x_5454 → let mm_5457 = b2-dep mm_ x_5454 in let x = x_5454 in let a_5458 = ob in let j_5459 = j in let v_5460 = x in scmd (w-store ((b2-a mm_5457 (%wadd a_5458 (%wsucc j_5459)))) (v_5460)) (λ uu_5461 → let mm_5462 = hv2-u mm_5457 uu_5461 in b2-dropg mm_5462 f a ob n (%wsucc j) len kq_)))
