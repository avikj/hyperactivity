-- Section (1): Universal Holographic Bulk-Factorization & Gram-Channel Reduction Theorem.
-- Given past amplitudes psi : B -> X -> A and future amplitudes phi : B -> Y -> A glued over bulk list bs : List B:
sfc-K : (B X Y A : Type) → A → (A → A → A) → (A → A → A) →
  (B → X → A) → (B → Y → A) → List B → X → Y → A
sfc-K B X Y A z add mul psi phi bs x y =
  qent-sum B A z add (λ a → mul (psi a x) (phi a y)) bs
