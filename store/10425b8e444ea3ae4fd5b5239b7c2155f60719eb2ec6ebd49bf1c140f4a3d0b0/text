b2-bctr : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-bctr mm_ bk k kq_ =
  let t_9999 = bk in let j_10000 = #1 in scmd (w-load ((b2-a mm_ (%wadd t_9999 (%wadd #2 j_10000))))) (λ x_9998 → let mm_10001 = b2-dep mm_ x_9998 in let cs = x_9998 in b2-mget mm_10001 cs k (λ r → let mm_10002 = b2-dep mm_10001 r in kq_ (h4-depl mm_10002 ((the Word (if %weq r hv2-none then #0 else r))))))
