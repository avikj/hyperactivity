ge-eq : GuardExpr → GuardExpr → Bool
ge-eq (ge-k a)       (ge-k b)       = bfm-eqB a b
ge-eq (ge-v i)       (ge-v j)       = bfm-eq-nat i j
ge-eq (ge-not a)     (ge-not b)     = ge-eq a b
ge-eq (ge-and a1 a2) (ge-and b1 b2) = bfm-andB (ge-eq a1 b1) (ge-eq a2 b2)
ge-eq (ge-ite c1 t1 f1) (ge-ite c2 t2 f2) = bfm-andB (ge-eq c1 c2) (bfm-andB (ge-eq t1 t2) (ge-eq f1 f2))
ge-eq a              b              = false
