b2-anynq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-anynq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-anynq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_8204 = tel in let j_8205 = j in scmd (w-load ((b2-a mm_ (%wadd a_8204 (%wsucc j_8205))))) (λ x_8203 → let mm_8206 = b2-dep mm_ x_8203 in let c = x_8203 in let i_8208 = (%wadd c #3) in scmd (w-load ((b2-a mm_8206 i_8208))) (λ x_8207 → let mm_8209 = b2-dep mm_8206 x_8207 in let vT = x_8207 in let t_8211 = vT in scmd (w-load ((b2-a mm_8209 t_8211))) (λ x_8210 → let mm_8212 = b2-dep mm_8209 x_8210 in let tg = (%wand x_8210 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_8212 (#1))) else (b2-anynq mm_8212 f tel (%wsucc j) n kq_)))))
