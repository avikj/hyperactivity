tir-portal-top : List Word
tir-portal-top =
  h-concat
    (cons "<header id='os-bar'><div class='brand'><span class='dot'></span><span>HYPERACTIVITY // 2D UNIVALENT PORTAL OS</span></div>"
    (cons "<input id='os-omni' spellcheck='false' placeholder='Open any URI (/nets, /kernel, /kg, /daw, /silicon, /physics, https://...), hx://, file, or expr (@this, kan, golay, dor)...'>"
    (cons "<button class='btn on' id='os-go' title='Materialize 2-cell in 2D space'>SPAWN &Omega;</button>"
    (cons "<button class='btn gold' data-spawn='/eval'>/EVAL</button><button class='btn' data-spawn='/nets'>/NETS</button><button class='btn' data-spawn='/kernel'>/KERNEL</button><button class='btn' data-spawn='/kg'>/KG</button><button class='btn' data-spawn='/monolith'>/MONOLITH</button><button class='btn' data-spawn='/daw'>/DAW</button><button class='btn' data-spawn='/silicon'>/SILICON</button><button class='btn' data-spawn='/physics'>/PHYSICS</button><button class='btn' data-spawn='/pdf'>/PDF</button>"
    (cons "<button class='btn gold' id='os-focus-bench'>BENCH [26]</button><button class='btn' id='os-quot-all' title='Collapse/expand all 2-cells to 1D boundary strips'>&part;-QUOTIENT</button><button class='btn' id='os-fit'>FIT</button><button class='btn' id='os-zm-out'>&minus;</button><button class='btn' id='os-zm-100'>100%</button><button class='btn' id='os-zm-in'>+</button>"
    (cons "<span class='pill' id='portal-pill' style='color:var(--ok)'>PORTAL-SYNC: LIVE #0</span><span class='pill' id='seam-pill' style='color:var(--pink)'>&part;-SEAMS: 2</span><span class='pill' id='wasm-pill' style='color:var(--ok)'>WASM: INIT</span>"
    (cons "<button class='btn' data-mode='off'>OFF</button><button class='btn' data-mode='idle'>4K</button><button class='btn on' data-mode='active'>16K</button><button class='btn gold' data-mode='max'>64K</button><button class='btn' id='tir-theme'>POLARITY</button></header>"
    (cons "<div id='os-vp'><div id='os-world'><svg id='os-svg' viewBox='0 0 6000 4000'><g id='os-edges'></g></svg>" nil))))))))
