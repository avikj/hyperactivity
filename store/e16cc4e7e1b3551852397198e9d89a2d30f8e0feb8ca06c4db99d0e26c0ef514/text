-- q·2^(u-4096) with q below 2^24, as a float (u is at least 3947, -149)
ief-compose : Word → Word → Word → Word
ief-compose s q u =
  if %wlt q #8388608 then %wadd (ief-sbit s) q
  else (let ef = %wsub u #3946
        in if %wlt #254 ef then ief-inf s
           else %wadd (ief-sbit s) (%wadd (%wshl ef #23) (%wsub q #8388608)))
