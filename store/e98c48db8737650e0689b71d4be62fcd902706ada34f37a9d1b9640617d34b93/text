-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7121 = tel in let j_7122 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7121 (%wsucc j_7122))))) (λ x_7120 → let mm_7123 = b2-dep mm_ x_7120 in let c = x_7120 in let i_7125 = c in scmd (w-load ((b2-a mm_7123 i_7125))) (λ x_7124 → let mm_7126 = b2-dep mm_7123 x_7124 in let q = x_7124 in let i_7128 = (%wadd c #1) in scmd (w-load ((b2-a mm_7126 i_7128))) (λ x_7127 → let mm_7129 = b2-dep mm_7126 x_7127 in let k = x_7127 in let i_7131 = (%wadd c #2) in scmd (w-load ((b2-a mm_7129 i_7131))) (λ x_7130 → let mm_7132 = b2-dep mm_7129 x_7130 in let i = x_7130 in let i_7134 = (%wadd c #3) in scmd (w-load ((b2-a mm_7132 i_7134))) (λ x_7133 → let mm_7135 = b2-dep mm_7132 x_7133 in let vT = x_7133 in let i_7137 = (%wadd c #4) in scmd (w-load ((b2-a mm_7135 i_7137))) (λ x_7136 → let mm_7138 = b2-dep mm_7135 x_7136 in let s = x_7136 in b2-All mm_7138 q k i vT e s (λ a → let mm_7139 = b2-dep mm_7138 a in b2-telebindg mm_7139 f tel (%wsub j #1) a kq_))))))))
