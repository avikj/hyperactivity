  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10625 = cs in let j_10626 = j in scmd (w-load ((b2-a mm_ (%wadd v_10625 #2)))) (λ d_10624 → let mm_10627 = b2-dep mm_ d_10624 in scmd (w-load ((b2-a mm_10627 (%wadd d_10624 (%wsucc j_10626))))) (λ x_10623 → let mm_10628 = b2-dep mm_10627 x_10623 in let c = x_10623 in let t_10630 = c in let j_10631 = #0 in scmd (w-load ((b2-a mm_10628 (%wadd t_10630 (%wadd #2 j_10631))))) (λ x_10629 → let mm_10632 = b2-dep mm_10628 x_10629 in let ck = x_10629 in if (%weq ck k) then (kq_ (h4-depl mm_10632 (c))) else (b2-ctrfind mm_10632 f cs k (%wsucc j) n kq_)))))
