qent-tr2-A : (I J A : Type) → A → (A → A → A) → (A → A → A) → (I → J → A) → List I → List J → A
qent-tr2-A I J A z add mul psi is js =
  qent-sum I A z add (λ i → qent-sum I A z add (λ k →
    mul (qent-sum J A z add (λ j → mul (psi i j) (psi k j)) js)
        (qent-sum J A z add (λ l → mul (psi k l) (psi i l)) js)) is) is
