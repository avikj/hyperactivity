  let i_14999 = (%wadd row #1) in scmd (w-load ((b2-a mm_ i_14999))) (λ x_14998 → let mm_15000 = b2-dep mm_ x_14998 in let rv = x_14998 in let i_15002 = (%wadd row #2) in scmd (w-load ((b2-a mm_15000 i_15002))) (λ x_15001 → let mm_15003 = b2-dep mm_15000 x_15001 in let rh = x_15001 in let v_15005 = rv in scmd (w-load ((b2-a mm_15003 v_15005))) (λ x_15004 → let mm_15006 = b2-dep mm_15003 x_15004 in let n = x_15004 in kq_ (h4-depl mm_15006 ((%wsub n rh))))))
