-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10638 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10638))) (λ x_10637 → let mm_10639 = b2-dep mm_ x_10637 in let lb = x_10637 in if (%weq lb #0) then (let i_10641 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10639 i_10641))) (λ x_10640 → let mm_10642 = b2-dep mm_10639 x_10640 in let t = x_10640 in kq_ (h4-depl mm_10642 (t)))) else (let i_10644 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10639 i_10644))) (λ x_10643 → let mm_10645 = b2-dep mm_10639 x_10643 in let lx = x_10643 in b2-body mm_10645 bk lb lx (λ r → let mm_10646 = b2-dep mm_10645 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10646 b2-ERR)) else (kq_ (h4-depl mm_10646 (r)))))))
