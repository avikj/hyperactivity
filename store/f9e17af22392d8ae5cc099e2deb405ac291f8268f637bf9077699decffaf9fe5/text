b2-lvals : Word → Nat → Word → List Word → (List Word → Step W Word) → Step W Word
b2-lvals mm_ zero l acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-lvals mm_ (suc f) l acc kq_ =
  if (%weq l #0) then (kq_ (h4-depl mm_ (acc))) else (let i_493 = (%wadd l #1) in scmd (w-load ((b2-a mm_ i_493))) (λ x_492 → let mm_494 = b2-dep mm_ x_492 in let v = x_492 in let i_496 = (%wadd l #2) in scmd (w-load ((b2-a mm_494 i_496))) (λ x_495 → let mm_497 = b2-dep mm_494 x_495 in let nx = x_495 in b2-lvals mm_497 f nx (cons v acc) kq_)))
