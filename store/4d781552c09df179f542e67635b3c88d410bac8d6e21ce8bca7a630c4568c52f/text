b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_7751 = b2-dep mm_ c in let p_7753 = p in let i_7755 = (%wadd p_7753 #1) in scmd (w-load ((b2-a mm_7751 i_7755))) (λ x_7754 → let mm_7756 = b2-dep mm_7751 x_7754 in let x_7752 = x_7754 in let i = x_7752 in let p_7757 = p in let v_7758 = (%wsucc i) in let i_7759 = (%wadd p_7757 #1) in let v_7760 = v_7758 in scmd (w-store ((b2-a mm_7756 i_7759)) (v_7760)) (λ uu_7761 → let mm_7762 = hv2-u mm_7756 uu_7761 in kq_ (h4-depl mm_7762 (c)))))
