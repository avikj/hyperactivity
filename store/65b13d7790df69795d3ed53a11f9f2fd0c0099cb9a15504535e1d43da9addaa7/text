b2-ctrnames : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-ctrnames mm_ zero cs j n acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-ctrnames mm_ (suc f) cs j n acc kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (acc))) else (let v_10550 = cs in let j_10551 = j in scmd (w-load ((b2-a mm_ (%wadd v_10550 #2)))) (λ d_10548 → let mm_10552 = b2-dep mm_ d_10548 in scmd (w-load ((b2-a mm_10552 (%wadd d_10548 (%wsucc j_10551))))) (λ x_10549 → let mm_10553 = b2-dep mm_10552 x_10549 in let c = x_10549 in let t_10555 = c in let j_10556 = #0 in scmd (w-load ((b2-a mm_10553 (%wadd t_10555 (%wadd #2 j_10556))))) (λ x_10554 → let mm_10557 = b2-dep mm_10553 x_10554 in let k = x_10554 in b2-namekey mm_10557 k (λ kb → let mm_10558 = b2-dpl mm_10557 kb in b2-ctrnames mm_10558 f cs (%wsucc j) n (the (List Word) (if %weq j #0 then kb else list-append acc (list-append ", " kb))) kq_)))))
