b2-pushk : Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pushk mm_ bk k x kq_ =
  b2-tapp mm_ bk k x #0 (λ t → let mm_15526 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_15526 b2-ERR)) else (b2-push mm_15526 t #0 (λ dd_15527 → let mm_15528 = b2-dep mm_15526 dd_15527 in kq_ (h4-depl mm_15528 (#0)))))
