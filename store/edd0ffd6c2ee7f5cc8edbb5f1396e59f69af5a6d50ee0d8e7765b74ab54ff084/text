-- a work's index made, written, read back and checked (si-made-ok-t); bytes that fail the check are
-- not kept, and the work is said to be unsearchable
sx-make-one : List Word → List Word → Work → Proc W Unit
sx-make-one st s (work n k p) = bind (h-read (sx-file st s n)) (sx-absent (bind (s-work-text (work n k p)) (λ t →
  bind (ret {lzero} {W} (tokenize (sx-lower t))) (λ T → bind (ret {lzero} {W} (suffix-array-fast T)) (λ sa → bind (ret {lzero} {W} (si-tree-of sa)) (λ tr →
  bind (h-write (sx-file st s n) (si-make-t T tr (wadd (si-o0 T) (si-recs-size T)))) (λ w → bind (h-read (sx-file st s n)) (λ rb →
  if si-made-ok-t T tr (list-length (s-or nil rb)) (text-bytes (s-or nil rb)) then ret {lzero} {W} unit
  else bind (h-write (sx-file st s n) nil) (λ w2 → h-out (h-line (list-append "search: the index does not check, not kept: " n)))))))))))
