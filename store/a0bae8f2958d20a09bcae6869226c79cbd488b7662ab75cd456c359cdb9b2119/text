hy-factor-probe : List (List Word) → List Word
hy-factor-probe ns =
  h-concat (list-map h-line (
    cons (list-append "import " (h-quote "../lib/host.hypercubical")) (
    cons "hf-code-of : Code → Code" (
    cons "hf-code-of (cglob g) = opt-or (def-source g) (cglob g)" (
    cons "hf-code-of c = c" (
    cons "hf-probe-in : Lst Code" (
    cons (list-append "hf-probe-in = " (hy-def-sources ns)) (
    cons "hf-probe-out : Lst (Word × Code) × Lst Code" (
    cons "hf-probe-out = pool-hyperfactor (toNat #8) #900000 hf-probe-in" (
    cons "hf-probe-msg : List Word" (
    cons (h-concat (cons "hf-probe-msg = h-line (list-append " (cons (h-quote "pool-hyperfactor (") (cons " (list-append (h-decimal (l-count hf-probe-in)) (list-append " (cons (h-quote " defs): ") (cons " (list-append (h-decimal (pool-code-size hf-probe-in)) (list-append " (cons (h-quote " Code nodes -> ") (cons " (list-append (h-decimal (pool-dag-size hf-probe-out)) (list-append " (cons (h-quote " DAG nodes, ") (cons " (list-append (h-decimal (l-count (fst hf-probe-out))) " (cons (h-quote " nameless lemmas extracted") (cons "))))))))" nil)))))))))))) (
    cons (hy-program "h-out hf-probe-msg") nil))))))))))))
