  b2-strval mm_ bk host (λ hs → let mm_15891 = b2-dpl mm_ hs in b2-u32val mm_15891 bk port (λ pt → let mm_15892 = b2-dep mm_15891 pt in let q = b2-ipq #0 #0 #0 #0 hs in if (orB (%weq q hv2-none) (%wlt #65535 pt)) then (kq_ (h4-depl mm_15892 (#0))) else (let n_15894 = #2 in scmd (w-load (mm_15892)) (λ at_15893 → let mm_15895 = b2-dep mm_15892 at_15893 in scmd (w-store (mm_15895) ((%wadd at_15893 n_15894))) (λ uu_15896 → let mm_15897 = hv2-u mm_15895 uu_15896 in let i = at_15893 in let i_15898 = i in let v_15899 = (%wor #2 (%wor (%wshl (%wshr pt #8) #16) (%wor (%wshl (%wand pt #255) #24) (%wshl q #32)))) in scmd (w-store ((b2-a mm_15897 i_15898)) (v_15899)) (λ uu_15900 → let mm_15901 = hv2-u mm_15897 uu_15900 in let i_15902 = (%wadd i #1) in let v_15903 = #0 in scmd (w-store ((b2-a mm_15901 i_15902)) (v_15903)) (λ uu_15904 → let mm_15905 = hv2-u mm_15901 uu_15904 in kq_ (h4-depl mm_15905 ((b2-a mm_15905 i))))))))))
