qgm-if-add : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → QgmAb A z add neg →
  (b : Bool) → (f g : A) → (if b then add f g else z) ≡ add (if b then f else z) (if b then g else z)
qgm-if-add A z add neg ab b f g = case b return λ u → (if u then add f g else z) ≡ add (if u then f else z) (if u then g else z) of
  true → refl
  false → sym (qgm-zl A z add neg ab z)
