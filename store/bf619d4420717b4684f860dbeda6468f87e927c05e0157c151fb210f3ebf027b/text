-- Unitary self-dual Fourier transform F = (1/2) H_4 over exact rationals Q!
atp-fourier4 : SB4 → SB4
atp-fourier4 (sb4 f0 f1 f2 f3) =
  let h0 = rq-div-w (rq-add (rq-add f0 f1) (rq-add f2 f3)) #2
      h1 = rq-div-w (rq-add (rq-sub f0 f1) (rq-sub f2 f3)) #2
      h2 = rq-div-w (rq-sub (rq-add f0 f1) (rq-add f2 f3)) #2
      h3 = rq-div-w (rq-sub (rq-sub f0 f1) (rq-sub f2 f3)) #2
  in sb4 h0 h1 h2 h3
