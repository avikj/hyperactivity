b2-linestart : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-linestart mm_ zero s i kq_ =
  kq_ (h4-depl mm_ (#0))
b2-linestart mm_ (suc f) s i kq_ =
  if (%weq i #0) then (kq_ (h4-depl mm_ (#0))) else (let a_6695 = s in let j_6696 = (%wsub i #1) in scmd (w-load ((b2-a mm_ (%wadd a_6695 (%wsucc j_6696))))) (λ x_6694 → let mm_6697 = b2-dep mm_ x_6694 in let c = x_6694 in if (%weq c #10) then (kq_ (h4-depl mm_6697 (i))) else (b2-linestart mm_6697 f s (%wsub i #1) kq_)))
