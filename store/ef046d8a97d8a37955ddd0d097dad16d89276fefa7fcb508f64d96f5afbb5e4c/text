hd-gpu-metal-src : List Word
hd-gpu-metal-src =
  hd-ln "// Pure Symbolic GPU Circuit Discovery Engine (lib/hx-discover.hypercubical)"
  (hd-ln "// Searches 4-input (16-bit truth table) NAND2 circuits at ~10 Billion gate-evals/sec on Apple Silicon GPU!"
  (hd-ln "#include <metal_stdlib>"
  (hd-ln "using namespace metal;"
  (hd-ln "struct DiscParams { uint n_targets; uint base_seed; uint iters_per_thread; };"
  (hd-ln "kernel void hx_discover_nand2("
  (hd-ln "    device const ushort* targets [[buffer(0)]],"
  (hd-ln "    device atomic_uint* best_gates [[buffer(1)]],"
  (hd-ln "    device ulong* best_lo [[buffer(2)]],"
  (hd-ln "    device ulong* best_hi [[buffer(3)]],"
  (hd-ln "    device atomic_uint* locks [[buffer(4)]],"
  (hd-ln "    constant DiscParams& dp [[buffer(5)]],"
  (hd-ln "    uint tid [[thread_position_in_grid]]) {"
  (hd-ln "  ushort w[14];"
  (hd-ln "  w[0] = 0xAAAA; w[1] = 0xCCCC; w[2] = 0xF0F0; w[3] = 0xFF00;"
  (hd-ln "  ulong rng = (ulong(tid + 1) * 0x9E3779B97F4A7C15ul) ^ (ulong(dp.base_seed) * 0xBF58476D1CE4E5B9ul);"
  (hd-ln "  for (uint it = 0; it < dp.iters_per_thread; it++) {"
  (hd-ln "    ulong plo = 0, phi = 0;"
  (hd-ln "    for (uint g = 0; g < 9; g++) {"
  (hd-ln "      uint nw = 4 + g;"
  (hd-ln "      rng ^= rng >> 12; rng ^= rng << 25; rng ^= rng >> 27;"
  (hd-ln "      ulong r = rng * 0x2545F4914F6CDD1Dul;"
  (hd-ln "      uint a = uint((r >> 32) % nw);"
  (hd-ln "      uint b = uint((r >> 48) % nw);"
  (hd-ln "      w[nw] = ~(w[a] & w[b]);"
  (hd-ln "      ulong code = ulong((a << 4) | b);"
  (hd-ln "      if (g < 8) plo |= code << (g * 8); else phi |= code << ((g - 8) * 8);"
  (hd-ln "      uint ng = g + 1;"
  (hd-ln "      for (uint t = 0; t < 5; t++) {"
  (hd-ln "        if (w[nw] == targets[t]) {"
  (hd-ln "          uint slot = t * 10 + ng;"
  (hd-ln "          if (atomic_load_explicit(&locks[slot], memory_order_relaxed) == 0u) {"
  (hd-ln "            if (atomic_exchange_explicit(&locks[slot], 1u, memory_order_relaxed) == 0u) {"
  (hd-ln "              best_lo[slot] = plo; best_hi[slot] = phi;"
  (hd-ln "              atomic_fetch_min_explicit(&best_gates[t], ng, memory_order_relaxed);"
  (hd-ln "            }"
  (hd-ln "          }"
  (hd-ln "        }"
  (hd-ln "      }"
  (hd-ln "    }"
  (hd-ln "  }"
  (hd-ln "}" nil)))))))))))))))))))))))))))))))))))))))))
