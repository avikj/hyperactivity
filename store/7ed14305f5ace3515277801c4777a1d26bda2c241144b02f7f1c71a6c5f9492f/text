  hc-ln "button,input{font:500 12px/1.2 var(--mono);background:#000;color:#fff;border:1px solid #383838;padding:7px 12px;}" (
  hc-ln "button{cursor:pointer;} button:hover{border-color:#fff;} button.pri{border-color:var(--pink);} button.pri:hover{background:var(--pink);}" (
