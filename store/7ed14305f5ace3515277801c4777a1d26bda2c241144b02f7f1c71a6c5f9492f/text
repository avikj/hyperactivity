hc-deploy-html =
  hc-ln "<!doctype html><html lang=`en`><head><meta charset=`utf-8`>" (
  hc-ln "<meta name=`viewport` content=`width=device-width,initial-scale=1`>" (
  hc-ln "<title>hyperactivity · one-click deploy &amp; hardware hypercrack</title>" (
  hc-ln "<style>" (
