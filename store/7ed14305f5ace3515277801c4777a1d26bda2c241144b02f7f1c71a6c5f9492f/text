  hc-ln "@media(max-width:900px){.grid2{grid-template-columns:1fr;}}" (
  hc-ln "</style></head><body>" (
  hc-ln "<nav><a class=`mark` href=`/`><span class=`sq`></span>hyperactivity / deploy</a>" (
  hc-ln "<div class=`nav-r`><a href=`/portal`>/portal</a><a href=`/eval`>/eval</a><a href=`/collab`>/collab</a><a href=`/silicon`>/silicon</a></div></nav>" (
  hc-ln "<main>" (
  hc-ln "<div class=`hdr`><h1>ONE-CLICK DEPLOYMENT &amp; APPLE SILICON HYPERCRACK</h1>" (
  hc-ln "<p>Zero-git bare-metal bootstrap, Mac Studio + Mac mini Thunderbolt 5 mesh, Studio Display Retina/Hz lock, and IOKit raw Magic Keyboard + Magic Mouse 1:1 sensor tuning.</p></div>" (
  hc-ln "<div class=`grid2`>" (
  hc-ln "<section class=`card`><h2><span>1 · BARE-METAL ZERO-GIT ONE-LINERS</span><span id=`origin-lbl`>LIVE</span></h2>" (
  hc-ln "<div>Mac Studio (Primary Ultra GPU + 90% Metal VRAM + :8080 LaunchAgent):</div>" (
  hc-ln "<div class=`cmd-row`><code class=`cmd` id=`c-studio`>curl -fsSL https://hyperactivity.ai/up | ROLE=studio sh</code><button type=`button` data-cp=`c-studio`>COPY</button></div>" (
  hc-ln "<div>Mac mini (Super-Core net_solo Coordinator + Thunderbolt/Bonjour Peer):</div>" (
  hc-ln "<div class=`cmd-row`><code class=`cmd` id=`c-mini`>curl -fsSL https://hyperactivity.ai/up | ROLE=mini sh</code><button type=`button` data-cp=`c-mini`>COPY</button></div>" (
  hc-ln "<div>Pair Mac Studio &lt;-&gt; Mac mini over Thunderbolt 5 / Bonjour SSH:</div>" (
  hc-ln "<div class=`cmd-row`><code class=`cmd` id=`c-pair`>./hyperactive deploy cluster mac-mini.local</code><button type=`button` data-cp=`c-pair`>COPY</button></div>" (
  hc-ln "<div>90% Unified Memory Metal Cap + 64 MB Socket Buf + Touch ID sudo:</div>" (
  hc-ln "<div class=`cmd-row`><code class=`cmd` id=`c-sudo`>sudo ./build/hx-mac --apply</code><button type=`button` data-cp=`c-sudo`>COPY</button></div>" (
  hc-ln "</section>" (
  hc-ln "<section class=`card`><h2><span>2 · LIVE ONE-CLICK NODE ACTIONS</span><span id=`node-st`>READY</span></h2>" (
  hc-ln "<div class=`cmd-row`><input id=`peer-in` placeholder=`Peer host (e.g. mac-mini.local or 169.254.77.2)` value=`mac-mini.local`><input id=`tok-in` type=`password` placeholder=`HYPERACTIVE_TOKEN (remote only)`></div>" (
  hc-ln "<div class=`btns`>" (
  hc-ln "<button class=`pri` type=`button` data-act=`mac`>1 · HYPERCRACK THIS MAC</button>" (
  hc-ln "<button type=`button` data-act=`cluster`>2 · PAIR CLUSTER PEER</button>" (
  hc-ln "<button type=`button` data-act=`ipad`>3 · FLASH IPAD PRO</button>" (
  hc-ln "<button type=`button` data-act=`live`>4 · PUSH POOL TO LIVE</button>" (
  hc-ln "<button type=`button` data-act=`status`>5 · NODE STATUS</button>" (
  hc-ln "</div>" (
  hc-ln "<div id=`out`>Ready. On localhost:8080 every button executes directly with zero token; on public nodes supply HYPERACTIVE_TOKEN.</div>" (
  hc-ln "</section></div>" (
  hc-ln "<div class=`grid2`>" (
  hc-ln "<section class=`card`><h2><span>3 · STUDIO DISPLAY + MAGIC MOUSE + MAGIC KEYBOARD LIVE PROBE</span><span id=`hz-badge`>MEASURING...</span></h2>" (
  hc-ln "<div class=`kv`>" (
  hc-ln "<span>Display Native Pixels</span><span id=`d-px`>-</span>" (
  hc-ln "<span>Logical Viewport / DPR</span><span id=`d-dpr`>-</span>" (
  hc-ln "<span>Color Gamut / Refresh</span><span id=`d-gamut`>-</span>" (
  hc-ln "<span>Magic Mouse Coalesced Hz</span><span id=`m-hz`>move mouse over page...</span>" (
  hc-ln "<span>Magic Keyboard Repeat Δt</span><span id=`k-dt`>hold any key to measure KeyRepeat=1...</span>" (
  hc-ln "</div></section>" (
  hc-ln "<section class=`card`><h2><span>4 · CHECKED SUPEROPT == HYPERCRACK GUARANTEES</span><span>0 POSTULATES</span></h2>" (
  hc-ln "<div class=`kv`>" (
  hc-ln "<span>hc-thm-factory-throttled</span><span>hc-hypercrack-audit factory == inr #1 (refl)</span>" (
  hc-ln "<span>hc-thm-cracked-zero-throttle</span><span>hc-hypercrack-audit cracked == inl unit (refl)</span>" (
  hc-ln "<span>hc-thm-studio-mini-split-wins</span><span>mini(22)+studio_gpu(8)+tb5(1) &lt; unsplit(68) (refl)</span>" (
  hc-ln "<span>hc-thm-blocks-ssh-flag</span><span>hc-safe-host &quot;-oProxyCommand=...&quot; == false (refl)</span>" (
  hc-ln "<span>hc-thm-plist-no-wildcard</span><span>0.0.0.0 absent in LaunchAgents (refl)</span>" (
  hc-ln "</div></section></div></main>" (
  hc-ln "<script>" (
  hc-ln "(function(){" (
  hc-ln "  var o = location.origin;" (
  hc-ln "  document.getElementById('origin-lbl').textContent = o;" (
  hc-ln "  if (o.indexOf('http') === 0) {" (
  hc-ln "    document.getElementById('c-studio').textContent = 'curl -fsSL ' + o + '/up | ROLE=studio sh';" (
  hc-ln "    document.getElementById('c-mini').textContent = 'curl -fsSL ' + o + '/up | ROLE=mini sh';" (
  hc-ln "  }" (
  hc-ln "  var out = document.getElementById('out'), st = document.getElementById('node-st');" (
  hc-ln "  var tokIn = document.getElementById('tok-in'), peerIn = document.getElementById('peer-in');" (
  hc-ln "  try { tokIn.value = sessionStorage.getItem('hx_tok') || ''; } catch(e){}" (
  hc-ln "  tokIn.addEventListener('change', function(){ try { sessionStorage.setItem('hx_tok', tokIn.value); } catch(e){} });" (
  hc-ln "  document.querySelectorAll('[data-cp]').forEach(function(b){" (
  hc-ln "    b.addEventListener('click', function(){" (
  hc-ln "      var t = document.getElementById(b.getAttribute('data-cp')).textContent;" (
  hc-ln "      navigator.clipboard.writeText(t); b.textContent = 'COPIED'; setTimeout(function(){ b.textContent = 'COPY'; }, 900);" (
  hc-ln "    });" (
  hc-ln "  });" (
  hc-ln "  function runAct(act){" (
  hc-ln "    st.textContent = 'RUNNING ' + act.toUpperCase() + '...';" (
  hc-ln "    var hdrs = {'Content-Type': 'text/plain'};" (
  hc-ln "    if (tokIn.value.trim()) hdrs['Authorization'] = 'Bearer ' + tokIn.value.trim();" (
  hc-ln "    var q = '?act=' + encodeURIComponent(act) + '&peer=' + encodeURIComponent(peerIn.value.trim());" (
  hc-ln "    fetch('/api/deploy/action' + q, {method: act === 'status-ro' ? 'GET' : 'POST', headers: hdrs, body: act})" (
  hc-ln "      .then(function(r){ return r.text().then(function(t){ return {ok: r.ok, code: r.status, text: t}; }); })" (
  hc-ln "      .then(function(res){ st.textContent = res.ok ? 'OK (' + res.code + ')' : 'HTTP ' + res.code; out.textContent = res.text; })" (
  hc-ln "      .catch(function(err){ st.textContent = 'ERR'; out.textContent = String(err); });" (
  hc-ln "  }" (
  hc-ln "  document.querySelectorAll('[data-act]').forEach(function(b){" (
  hc-ln "    b.addEventListener('click', function(){ runAct(b.getAttribute('data-act')); });" (
  hc-ln "  });" (
  hc-ln "  fetch('/api/deploy/status').then(function(r){ return r.text(); }).then(function(t){ out.textContent = t; }).catch(function(){});" (
  hc-ln "  var dpr = window.devicePixelRatio || 1;" (
  hc-ln "  document.getElementById('d-px').textContent = Math.round(screen.width*dpr) + ' x ' + Math.round(screen.height*dpr) + ' physical px';" (
  hc-ln "  document.getElementById('d-dpr').textContent = screen.width + ' x ' + screen.height + ' pt @ ' + dpr + 'x Retina';" (
  hc-ln "  var p3 = window.matchMedia && matchMedia('(color-gamut: p3)').matches ? 'Display-P3 Wide Gamut' : 'sRGB';" (
  hc-ln "  var fCnt = 0, fT0 = performance.now();" (
  hc-ln "  function raf(now){" (
  hc-ln "    fCnt++;" (
  hc-ln "    if (now - fT0 >= 500) {" (
  hc-ln "      var hz = Math.round((fCnt * 1000) / (now - fT0));" (
  hc-ln "      document.getElementById('d-gamut').textContent = p3 + ' · ' + hz + ' Hz rAF locked';" (
  hc-ln "      document.getElementById('hz-badge').textContent = hz + ' HZ';" (
  hc-ln "      fCnt = 0; fT0 = now;" (
  hc-ln "    }" (
  hc-ln "    requestAnimationFrame(raf);" (
  hc-ln "  }" (
  hc-ln "  requestAnimationFrame(raf);" (
  hc-ln "  var mEvs = 0, mT0 = performance.now();" (
  hc-ln "  window.addEventListener('pointermove', function(e){" (
  hc-ln "    var c = e.getCoalescedEvents ? e.getCoalescedEvents().length : 1;" (
  hc-ln "    mEvs += c;" (
  hc-ln "    var now = performance.now();" (
  hc-ln "    if (now - mT0 >= 300) {" (
  hc-ln "      var mhz = Math.round((mEvs * 1000) / (now - mT0));" (
  hc-ln "      document.getElementById('m-hz').textContent = mhz + ' Hz (' + c + ' coalesced/frame, dx=' + e.movementX + ', dy=' + e.movementY + ')';" (
  hc-ln "      mEvs = 0; mT0 = now;" (
  hc-ln "    }" (
  hc-ln "  });" (
  hc-ln "  var lastK = 0;" (
  hc-ln "  window.addEventListener('keydown', function(e){" (
  hc-ln "    var now = performance.now();" (
  hc-ln "    if (e.repeat && lastK > 0) {" (
  hc-ln "      document.getElementById('k-dt').textContent = (now - lastK).toFixed(1) + ' ms repeat interval (key=' + e.code + ')';" (
  hc-ln "    } else {" (
  hc-ln "      document.getElementById('k-dt').textContent = 'initial press (key=' + e.code + ', hold for repeat cadence)';" (
  hc-ln "    }" (
  hc-ln "    lastK = now;" (
  hc-ln "  });" (
  hc-ln "})();" (
  hc-ln "</script></body></html>" nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
