b2-unsub mm_ zero e kq_ =
  kq_ (h4-depl mm_ (e))
b2-unsub mm_ (suc f) e kq_ =
  let t_6601 = e in scmd (w-load ((b2-a mm_ t_6601))) (λ x_6600 → let mm_6602 = b2-dep mm_ x_6600 in let tg = (%wand x_6600 #255) in if (%weq tg b2-SUB) then (let t_6604 = e in let j_6605 = #2 in scmd (w-load ((b2-a mm_6602 (%wadd t_6604 (%wadd #2 j_6605))))) (λ x_6603 → let mm_6606 = b2-dep mm_6602 x_6603 in let g = x_6603 in b2-unsub mm_6606 f g kq_)) else (kq_ (h4-depl mm_6602 (e))))
