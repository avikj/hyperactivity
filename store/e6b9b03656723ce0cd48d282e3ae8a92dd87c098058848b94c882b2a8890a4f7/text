b2-markbase : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_14809 = bk in let j_14810 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_14809 (%wadd #2 j_14810))))) (λ x_14808 → let mm_14811 = b2-dep mm_ x_14808 in let ov = x_14808 in let v_14814 = ov in let j_14815 = j in scmd (w-load ((b2-a mm_14811 (%wadd v_14814 #2)))) (λ d_14812 → let mm_14816 = b2-dep mm_14811 d_14812 in scmd (w-load ((b2-a mm_14816 (%wadd d_14812 (%wsucc j_14815))))) (λ x_14813 → let mm_14817 = b2-dep mm_14816 x_14813 in let k = x_14813 in b2-tld mm_14817 bk k (λ t → let mm_14818 = b2-dep mm_14817 t in let t_14820 = t in scmd (w-load ((b2-a mm_14818 t_14820))) (λ x_14819 → let mm_14821 = b2-dep mm_14818 x_14819 in let tg = (%wand x_14819 #255) in let t_14822 = t in let j_14823 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_14824 = #1 in scmd (w-store ((b2-a mm_14821 (%wadd t_14822 (%wadd #2 j_14823)))) (v_14824)) (λ uu_14825 → let mm_14826 = hv2-u mm_14821 uu_14825 in b2-markbase mm_14826 f bk (%wsucc j) n kq_)))))))
