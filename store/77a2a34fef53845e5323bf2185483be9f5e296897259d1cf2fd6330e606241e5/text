b2-firstnq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstnq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-firstnq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_7648 = tel in let j_7649 = j in scmd (w-load ((b2-a mm_ (%wadd a_7648 (%wsucc j_7649))))) (λ x_7647 → let mm_7650 = b2-dep mm_ x_7647 in let c = x_7647 in let i_7652 = (%wadd c #3) in scmd (w-load ((b2-a mm_7650 i_7652))) (λ x_7651 → let mm_7653 = b2-dep mm_7650 x_7651 in let vT = x_7651 in let t_7655 = vT in scmd (w-load ((b2-a mm_7653 t_7655))) (λ x_7654 → let mm_7656 = b2-dep mm_7653 x_7654 in let tg = (%wand x_7654 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_7656 (j))) else (b2-firstnq mm_7656 f tel (%wsucc j) n kq_)))))
