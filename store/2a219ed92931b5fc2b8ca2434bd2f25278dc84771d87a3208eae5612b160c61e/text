vpi-cli-proc : List (List Word) → Proc W Word
vpi-cli-proc args =
  let a1  = vpi-a1 args
      a2  = vpi-a2 args
      dir = vpi-out-of a1 a2
      devApp = list-append dir "/HyperactivityVisionPro.app"
      simApp = list-append dir "/HyperactivityVisionProSim.app"
  in bind (h-mkdir "/tmp/hy_out") (λ _ →
     bind (h-mkdir dir) (λ _ →
     bind (h-mkdir devApp) (λ _ →
     bind (h-mkdir simApp) (λ _ →
     bind (h-write (list-append dir "/HyperactivityVisionProShader.metal") vph-metal-src) (λ _ →
     bind (h-write (list-append dir "/hx_vp_bridge.h") vpf-c-hdr) (λ _ →
     bind (h-write (list-append dir "/hx_vp_bridge.c") vpf-c-impl) (λ _ →
     bind (h-write (list-append dir "/HyperactivityVisionPro.swift") vpf-swift-src) (λ _ →
     bind (h-write (list-append dir "/Entitlements.plist") vpf-entitlements-src) (λ _ →
     bind (h-write (list-append dir "/hx_vp_e2e_bench.m") vpf-mac-bench-src) (λ _ →
     bind (h-write (list-append dir "/HyperactivityVpKernel.hypercubical") vph-embedded-kernel) (λ _ →
     bind (h-write (list-append dir "/project.pbxproj.tmpl") vpf-pbxproj) (λ _ →
     bind (h-write (list-append dir "/vpf_ota_deploy.sh") vpf-ota-deploy-sh) (λ _ →
     bind (h-write (list-append devApp "/Info.plist") vpf-plist-xros) (λ _ →
     bind (h-write (list-append devApp "/HyperactivityVisionProShader.metal") vph-metal-src) (λ _ →
     bind (h-write (list-append devApp "/HyperactivityVpKernel.hypercubical") vph-embedded-kernel) (λ _ →
     bind (h-write (list-append simApp "/Info.plist") vpf-plist-xrsim) (λ _ →
     bind (h-write (list-append simApp "/HyperactivityVisionProShader.metal") vph-metal-src) (λ _ →
     bind (h-write (list-append simApp "/HyperactivityVpKernel.hypercubical") vph-embedded-kernel) (λ _ →
     bind (h-run (cons "/bin/chmod" (cons "+x" (cons (list-append dir "/vpf_ota_deploy.sh") nil)))) (λ _ →
       if cli-eq a1 "emit" then
         bind (h-say (list-append "[HX-VISIONPRO] Emitted Zero-Config visionOS 2.0+ Spatial Hypervisor + .xcodeproj -> " (list-append dir (cons #10 nil)))) (λ _ →
         ret {lzero} {W} #0)
       else
         h-run (cons "/bin/sh" (cons (list-append dir "/vpf_ota_deploy.sh") (cons dir (cons "." nil))))))))))))))))))))))))
