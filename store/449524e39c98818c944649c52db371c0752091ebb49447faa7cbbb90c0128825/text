ue-le-trans : (a b c : Nat) → ue-le a b ≡ true → ue-le b c ≡ true → ue-le a c ≡ true
ue-le-trans zero    b       c       hab hbc = refl
ue-le-trans (suc a) zero    c       hab hbc = ue-false-imp (ue-le (suc a) c) hab
ue-le-trans (suc a) (suc b) zero    hab hbc = hbc
ue-le-trans (suc a) (suc b) (suc c) hab hbc = ue-le-trans a b c hab hbc
