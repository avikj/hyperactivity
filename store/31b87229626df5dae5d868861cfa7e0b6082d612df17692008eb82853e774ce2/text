sfc-foil : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → SfcRing A z add mul neg →
  (x y : A) → mul (add x y) (add x y) ≡ add (add (mul x x) (mul x y)) (add (mul y x) (mul y y))
sfc-foil A z add mul neg r x y =
  concat (fst (snd (snd (snd (snd (snd (snd (snd r))))))) x y (add x y))
    (λ i → add (fst (snd (snd (snd (snd (snd (snd r)))))) x x y i)
               (fst (snd (snd (snd (snd (snd (snd r)))))) y x y i))
