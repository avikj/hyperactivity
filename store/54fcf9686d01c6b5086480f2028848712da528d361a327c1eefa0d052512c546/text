b2-varidx : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-varidx mm_ zero vs i j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-varidx mm_ (suc f) vs i j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_6124 = vs in let j_6125 = j in scmd (w-load ((b2-a mm_ (%wadd a_6124 (%wsucc j_6125))))) (λ x_6123 → let mm_6126 = b2-dep mm_ x_6123 in let w = x_6123 in let t_6128 = w in let j_6129 = #1 in scmd (w-load ((b2-a mm_6126 (%wadd t_6128 (%wadd #2 j_6129))))) (λ x_6127 → let mm_6130 = b2-dep mm_6126 x_6127 in let wi = x_6127 in if (%weq wi i) then (kq_ (h4-depl mm_6130 (j))) else (b2-varidx mm_6130 f vs i (%wsucc j) n kq_))))
