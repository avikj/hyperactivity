si-all-mem : {o : Ord} → (P : El o → Type) → (l : List (El o)) → ((e : El o) → MemKey {o} e l → P e) → si-all P l
si-all-mem P l = case l return λ w → ((e : El o) → MemKey {o} e w → P e) → si-all P w of
  nil → λ h → unit
  cons x r → λ h → (h x (mem-head {o} x r) , rec r (λ e m → h e (mem-cons-r {o} e x r m)))
