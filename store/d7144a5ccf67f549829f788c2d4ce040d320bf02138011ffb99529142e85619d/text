b2-pushk : Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pushk mm_ bk k x kq_ =
  b2-tapp mm_ bk k x #0 (λ t → let mm_15635 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_15635 b2-ERR)) else (b2-push mm_15635 t #0 (λ dd_15636 → let mm_15637 = b2-dep mm_15635 dd_15636 in kq_ (h4-depl mm_15637 (#0)))))
