b2-nlcount : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-nlcount mm_ zero s j e cnt ls kq_ =
  kq_ (h4-depl mm_ (cnt))
b2-nlcount mm_ (suc f) s j e cnt ls kq_ =
  if (%weq j e) then (let a_13552 = cnt in let b_13553 = ls in let c_13554 = #0 in let n_13556 = #3 in scmd (w-load (mm_)) (λ at_13555 → let mm_13557 = b2-dep mm_ at_13555 in scmd (w-store (mm_13557) ((%wadd at_13555 n_13556))) (λ uu_13558 → let mm_13559 = hv2-u mm_13557 uu_13558 in let at_13551 = at_13555 in let i_13560 = at_13551 in let v_13561 = a_13552 in scmd (w-store ((b2-a mm_13559 i_13560)) (v_13561)) (λ uu_13562 → let mm_13563 = hv2-u mm_13559 uu_13562 in let i_13564 = (%wadd at_13551 #1) in let v_13565 = b_13553 in scmd (w-store ((b2-a mm_13563 i_13564)) (v_13565)) (λ uu_13566 → let mm_13567 = hv2-u mm_13563 uu_13566 in let i_13568 = (%wadd at_13551 #2) in let v_13569 = c_13554 in scmd (w-store ((b2-a mm_13567 i_13568)) (v_13569)) (λ uu_13570 → let mm_13571 = hv2-u mm_13567 uu_13570 in let r = at_13551 in kq_ (h4-depl mm_13571 (r)))))))) else (let a_13573 = s in let j_13574 = j in scmd (w-load ((b2-a mm_ (%wadd a_13573 (%wsucc j_13574))))) (λ x_13572 → let mm_13575 = b2-dep mm_ x_13572 in let c = x_13572 in if (%weq c #10) then (b2-nlcount mm_13575 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_13575 f s (%wsucc j) e cnt ls kq_)))
