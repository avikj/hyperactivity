  let i_10507 = (%wadd lhs #1) in scmd (w-load ((b2-a mm_ i_10507))) (λ x_10506 → let mm_10508 = b2-dep mm_ x_10506 in let n = x_10506 in if (%weq n #0) then (kq_ (h4-depl mm_10508 (lhs))) else (let i_10510 = lhs in scmd (w-load ((b2-a mm_10508 i_10510))) (λ x_10509 → let mm_10511 = b2-dep mm_10508 x_10509 in let lt = x_10509 in b2-tapp mm_10511 bk lt x #0 (λ t2 → let mm_10512 = b2-dep mm_10511 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_10512 b2-ERR)) else (b2-lhsstep mm_10512 lhs t2 (%wsub n #1) (λ r → let mm_10513 = b2-dep mm_10512 r in kq_ (h4-depl mm_10513 (r))))))))
