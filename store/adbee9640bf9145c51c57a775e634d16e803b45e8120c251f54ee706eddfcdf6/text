b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_2651 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_2651 #7))) (λ kd → let mm_2652 = b2-dep mm_2651 kd in scmd (w-load ((b2-HR mm_2652 #8))) (λ v → let mm_2653 = b2-dep mm_2652 v in if (%weq kd #0) then (kq_ (h4-depl mm_2653 (v))) else (scmd (w-load ((b2-HR mm_2653 #11))) (λ md2 → let mm_2654 = b2-dep mm_2653 md2 in scmd (w-load ((b2-HR mm_2654 #12))) (λ a2 → let mm_2655 = b2-dep mm_2654 a2 in scmd (w-load ((b2-HR mm_2655 #13))) (λ b2 → let mm_2656 = b2-dep mm_2655 b2 in scmd (w-load ((b2-HR mm_2656 #14))) (λ c2 → let mm_2657 = b2-dep mm_2656 c2 in b2-wnfrun mm_2657 f rx bk md2 a2 b2 c2 kq_))))))))
