e-untag-f : Nat → List Word → List Word
e-untag-f zero t = t
e-untag-f (suc f) nil = nil
e-untag-f (suc f) (cons c r) =
  if andB (weq c #60) (fst (e-tag-skip (cons c r)))
  then list-append (if fst (snd (e-tag-skip (cons c r))) then " " else nil) (e-untag-f f (snd (snd (e-tag-skip (cons c r)))))
  else cons c (e-untag-f f r)
