-- an argument an intrinsic may read: a literal or a constructor (anything else is stuck, and
-- the definition's own match decides, as it would without the intrinsic)
-- an intrinsic's argument as it stands: a computed cell's value, 0 for a cell not yet
-- evaluated, anything else itself
b2-ipeek : Word → Word → (Word → Step W Word) → Step W Word
b2-ipeek mm_ x kq_ =
  let t_2607 = x in scmd (w-load ((b2-a mm_ t_2607))) (λ x_2606 → let mm_2608 = b2-dep mm_ x_2606 in let tg = (%wand x_2606 #255) in let t_2610 = x in let j_2611 = #1 in scmd (w-load ((b2-a mm_2608 (%wadd t_2610 (%wadd #2 j_2611))))) (λ x_2609 → let mm_2612 = b2-dep mm_2608 x_2609 in let i = x_2609 in if (andB (%weq tg b2-VAR) (%weq i b2-M1)) then (kq_ (h4-depl mm_2612 (#0))) else (b2-strip mm_2612 x (λ r → let mm_2613 = b2-dep mm_2612 r in kq_ (h4-depl mm_2613 (r))))))
