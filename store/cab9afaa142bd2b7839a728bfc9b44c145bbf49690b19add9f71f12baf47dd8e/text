-- THEOREM 1 (CONSTRUCTIVE CLOSURE OF SYNTHETIC SYNESTHESIA):
-- Composing 1D visual symbols <-> 1D acoustic wave <-> KV/memory concept state preserves
-- exact unitary invertibility across arbitrary sensory-motor loops!
sm-compose : {A B C : Type} → SynModalityKnot A B → SynModalityKnot B C → SynModalityKnot A C
sm-compose k1 k2 = SynModalityKnot
  { sm-fwd = λ a → sm-fwd k2 (sm-fwd k1 a)
  ; sm-bwd = λ c → sm-bwd k1 (sm-bwd k2 c)
  ; sm-ret = λ a → sm-path-trans (sm-path-cong (sm-bwd k1) (sm-ret k2 (sm-fwd k1 a))) (sm-ret k1 a)
  ; sm-sec = λ c → sm-path-trans (sm-path-cong (sm-fwd k2) (sm-sec k1 (sm-bwd k2 c))) (sm-sec k2 c)
  }
