b2-pterms mm_ zero xs ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-pterms mm_ (suc f) xs ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_6121 = xs in let j_6122 = j in scmd (w-load ((b2-a mm_ (%wadd a_6121 (%wsucc j_6122))))) (λ x_6120 → let mm_6123 = b2-dep mm_ x_6120 in let x = x_6120 in b2-pterm mm_6123 x #0 (λ t → let mm_6124 = b2-dep mm_6123 t in let a_6125 = ob in let j_6126 = j in let v_6127 = t in scmd (w-store ((b2-a mm_6124 (%wadd a_6125 (%wsucc j_6126)))) (v_6127)) (λ uu_6128 → let mm_6129 = hv2-u mm_6124 uu_6128 in b2-pterms mm_6129 f xs ob (%wsucc j) n kq_))))
