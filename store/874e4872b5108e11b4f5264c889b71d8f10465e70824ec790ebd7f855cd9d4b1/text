-- THEOREM 2: EXACT 54-JOINT BIMANUAL FOUNDER ACTUATOR DISPATCH + HYSTERESIS HOLD BY `refl`!
vpf-thm-founder-chord-actuator :
  let rThis  = vph-hand-chord #0 vp-thumb vp-far vp-far vp-far vp-close
      lPinky = vph-hand-chord #0 vp-thumb vp-far vp-far vp-far vp-close
      rHold  = vph-hand-chord rThis vp-thumb vp-far vp-far vp-far vp-mid
      dualP  = vph-bimanual-cmd lPinky rHold
  in andB (%weq (vpf-chord-action rThis) #4)
     (andB (%weq (vpf-chord-action dualP) #6)
           (%weq (vpf-chord-action #17) #5)) ≡ true
vpf-thm-founder-chord-actuator = refl
