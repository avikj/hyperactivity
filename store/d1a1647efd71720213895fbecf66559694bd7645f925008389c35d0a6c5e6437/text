qgm-edge-div-self : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → QgmAb A z add neg →
  (x u : Nat) → (f : A) → qgm-edge-div A z add neg x u u f ≡ z
qgm-edge-div-self A z add neg ab x u f =
  case eqb x u return λ b → add (if b then f else z) (if b then neg f else z) ≡ z of
    true → qgm-inv A z add neg ab f
    false → qgm-zl A z add neg ab z
