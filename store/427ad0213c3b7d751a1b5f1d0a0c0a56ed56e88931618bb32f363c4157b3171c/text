b2-lineend : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-lineend mm_ zero s j n kq_ =
  kq_ (h4-depl mm_ (j))
b2-lineend mm_ (suc f) s j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (j))) else (let a_12772 = s in let j_12773 = j in scmd (w-load ((b2-a mm_ (%wadd a_12772 (%wsucc j_12773))))) (λ x_12771 → let mm_12774 = b2-dep mm_ x_12771 in let c = x_12771 in if (%weq c #10) then (kq_ (h4-depl mm_12774 (j))) else (b2-lineend mm_12774 f s (%wsucc j) n kq_)))
