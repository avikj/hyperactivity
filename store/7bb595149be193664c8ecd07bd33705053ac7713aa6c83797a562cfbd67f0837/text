-- Explicit verification across all 16 spin-1/2 magnetic states in Bool^4:
bst-pop4 : Bool × (Bool × (Bool × Bool)) → Nat
bst-pop4 s =
  plus (if fst s then 1 else 0)
    (plus (if fst (snd s) then 1 else 0)
      (plus (if fst (snd (snd s)) then 1 else 0)
            (if snd (snd (snd s)) then 1 else 0)))
