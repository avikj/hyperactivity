-- ---------------------------------------------------------------- machine-checked hyperfactoring theorems
-- Three caller definitions with DIFFERENT arities and PERMUTED de Bruijn variable orders sharing
-- the quadratic polynomial motif `(u * u) + (3 * v + 1)` (`cwop #2` = %wadd, `cwop #5` = %wmul):
--   hf-ex-f1 = λ x y   → ((x * x) + ((#3 * y) + #1)) + y
--   hf-ex-f2 = λ a b z → ((z * z) + ((#3 * a) + #1)) * b
--   hf-ex-f3 = λ p q   → ((q * q) + ((#3 * p) + #1)) + ((p * p) + ((#3 * q) + #1))
hf-motif-at : Code → Code → Code
hf-motif-at u v = cwop #2 (cwop #5 u u) (cwop #2 (cwop #5 (cwlit #3) v) (cwlit #1))
