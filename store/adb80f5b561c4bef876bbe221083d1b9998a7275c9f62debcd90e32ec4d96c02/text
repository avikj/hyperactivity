k-mem-out : (t : List (List Word)) → (f : List (List Word) → Word) → (q : El k-PR) → MemKey {k-PR} q (k-Lf t f) → MemKey {k-PR} q (list-map (k-psi f) (sufs t))
k-mem-out t f q m =
  let ml = list-map (k-psi f) (sufs t)
  in subst {_} {_} {Nat} {λ c → isTrue (ltn zero c)} (msort-fuel-count {k-PR} q (list-length ml) ml) m
