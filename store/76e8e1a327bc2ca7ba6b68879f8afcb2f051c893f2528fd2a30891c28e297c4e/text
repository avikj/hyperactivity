b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10942 = xs in scmd (w-load ((b2-a mm_ a_10942))) (λ x_10941 → let mm_10943 = b2-dep mm_ x_10941 in let n = x_10941 in if (%weq j n) then (kq_ (h4-depl mm_10943 (h))) else (let a_10945 = xs in let j_10946 = j in scmd (w-load ((b2-a mm_10943 (%wadd a_10945 (%wsucc j_10946))))) (λ x_10944 → let mm_10947 = b2-dep mm_10943 x_10944 in let x = x_10944 in b2-tapp mm_10947 bk h x #0 (λ h2 → let mm_10948 = b2-dep mm_10947 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10948 b2-ERR)) else (b2-applyall mm_10948 f bk h2 xs (%wsucc j) kq_)))))
