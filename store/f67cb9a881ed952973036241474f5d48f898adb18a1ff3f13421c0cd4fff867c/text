b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_7243 → let mm_7244 = b2-dep mm_ dd_7243 in b2-take mm_7244 p "-" (λ m → let mm_7245 = b2-dep mm_7244 m in if (%weq m #1) then (kq_ (h4-depl mm_7245 (b2-NONE))) else (b2-take mm_7245 p "+" (λ pl → let mm_7246 = b2-dep mm_7245 pl in if (%weq pl #1) then (kq_ (h4-depl mm_7246 (b2-MANY))) else (kq_ (h4-depl mm_7246 (b2-LONE))))))))
