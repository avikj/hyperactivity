b2-pterms : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pterms mm_ zero xs ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-pterms mm_ (suc f) xs ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_6683 = xs in let j_6684 = j in scmd (w-load ((b2-a mm_ (%wadd a_6683 (%wsucc j_6684))))) (λ x_6682 → let mm_6685 = b2-dep mm_ x_6682 in let x = x_6682 in b2-pterm mm_6685 x #0 (λ t → let mm_6686 = b2-dep mm_6685 t in let a_6687 = ob in let j_6688 = j in let v_6689 = t in scmd (w-store ((b2-a mm_6686 (%wadd a_6687 (%wsucc j_6688)))) (v_6689)) (λ uu_6690 → let mm_6691 = hv2-u mm_6686 uu_6690 in b2-pterms mm_6691 f xs ob (%wsucc j) n kq_))))
