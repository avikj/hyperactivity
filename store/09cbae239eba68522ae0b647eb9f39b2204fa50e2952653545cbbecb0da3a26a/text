-- Exact squared triangle coefficient Delta^2(A, B, C) in BQ for doubled spins A, B, C : Nat.
sf-delta2 : Nat → Nat → Nat → BQ
sf-delta2 a b c = if tri-ok a b c
  then bq-make true
    (bin-mul (sf-bfact (nat-half (monus (plus a b) c)))
      (bin-mul (sf-bfact (nat-half (monus (plus a c) b)))
               (sf-bfact (nat-half (monus (plus b c) a)))))
    (sf-bfact (suc (nat-half (plus (plus a b) c))))
  else bq-zero
