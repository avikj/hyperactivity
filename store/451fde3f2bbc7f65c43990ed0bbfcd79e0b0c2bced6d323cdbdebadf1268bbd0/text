-- THEOREM 1 (Universal Data-Processing Theorem — Pullback of Independence):
-- Any k mutually independent yes/no questions on the output image of a channel ch : A -> B pull back to k
-- mutually independent questions on the source xs. Post-processing can NEVER create new relevant information.
qi-data-processing-indep : (A B : Type) → (ch : A → B) → (k : Nat) → (qs : rp-Qs B k) → (xs : List A) →
  rp-Indep B k qs (qi-map A B ch xs) → rp-Indep A k (qi-pullback-qs A B ch k qs) xs
qi-data-processing-indep A B ch k qs xs ind bs =
  qi-dp-witness A B ch k qs xs bs (fst (ind bs)) (snd (ind bs))
