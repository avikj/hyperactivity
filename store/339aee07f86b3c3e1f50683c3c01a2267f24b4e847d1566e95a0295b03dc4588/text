b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6977 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6977 (k))) else (b2-nbytes mm_6977 ns (λ nb → let mm_6978 = b2-dpl mm_6977 nb in b2-nbytes mm_6978 k (λ kb → let mm_6979 = b2-dpl mm_6978 kb in b2-nm mm_6979 (list-append nb (cons #58 kb)) (λ r → let mm_6980 = b2-dep mm_6979 r in kq_ (h4-depl mm_6980 (r)))))))
