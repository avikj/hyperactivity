b2-foreigntip : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-foreigntip mm_ zero bk tel d kq_ =
  kq_ (h4-depl mm_ (tel))
b2-foreigntip mm_ (suc f) bk tel d kq_ =
  b2-strip mm_ tel (λ t → let mm_13999 = b2-dep mm_ t in let t_14001 = t in scmd (w-load ((b2-a mm_13999 t_14001))) (λ x_14000 → let mm_14002 = b2-dep mm_13999 x_14000 in let tg = (%wand x_14000 #255) in if (not (%weq tg b2-ALL)) then (kq_ (h4-depl mm_14002 (t))) else (let t_14004 = t in let j_14005 = #1 in scmd (w-load ((b2-a mm_14002 (%wadd t_14004 (%wadd #2 j_14005))))) (λ x_14003 → let mm_14006 = b2-dep mm_14002 x_14003 in let k = x_14003 in let t_14008 = t in let j_14009 = #4 in scmd (w-load ((b2-a mm_14006 (%wadd t_14008 (%wadd #2 j_14009))))) (λ x_14007 → let mm_14010 = b2-dep mm_14006 x_14007 in let vB = x_14007 in b2-Var mm_14010 k d #0 #0 (λ x → let mm_14011 = b2-dep mm_14010 x in b2-body mm_14011 bk vB x (λ t2 → let mm_14012 = b2-dep mm_14011 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_14012 b2-ERR)) else (b2-foreigntip mm_14012 f bk t2 (%wsucc d) kq_))))))))
