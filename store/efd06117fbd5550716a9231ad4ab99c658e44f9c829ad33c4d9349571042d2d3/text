b2-arrfill : Word → Nat → Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-arrfill mm_ zero a j xs kq_ =
  kq_ (h4-depl mm_ (a))
b2-arrfill mm_ (suc f) a j xs kq_ =
  if (h4-isnil xs) then (kq_ (h4-depl mm_ (a))) else (let a_26 = a in let j_27 = j in let v_28 = (hv2-nth #0 xs) in scmd (w-store ((b2-a mm_ (%wadd a_26 (%wsucc j_27)))) (v_28)) (λ uu_29 → let mm_30 = hv2-u mm_ uu_29 in b2-arrfill mm_30 f a (%wsucc j) (hv2-drop1 xs) kq_))
