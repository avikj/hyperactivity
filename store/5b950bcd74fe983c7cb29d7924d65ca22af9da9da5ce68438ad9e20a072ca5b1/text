b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_7095 = b2-dep mm_ c in let p_7097 = p in let i_7099 = (%wadd p_7097 #1) in scmd (w-load ((b2-a mm_7095 i_7099))) (λ x_7098 → let mm_7100 = b2-dep mm_7095 x_7098 in let x_7096 = x_7098 in let i = x_7096 in let p_7101 = p in let v_7102 = (%wsucc i) in let i_7103 = (%wadd p_7101 #1) in let v_7104 = v_7102 in scmd (w-store ((b2-a mm_7100 i_7103)) (v_7104)) (λ uu_7105 → let mm_7106 = hv2-u mm_7100 uu_7105 in kq_ (h4-depl mm_7106 (c)))))
