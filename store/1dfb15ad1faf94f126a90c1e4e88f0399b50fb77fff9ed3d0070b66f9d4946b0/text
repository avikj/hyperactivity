-- src/hvm.c link: A ~ B, a variable pointed at its other end, two principal ports a redex. One
-- step of the loop either finishes or hands on the pair to link next (the variable's old target
-- and B); the loop is the same doubling
data Hv2L = hv2l-done (net : Hv2Net) | hv2l-go (net : Hv2Net) (a : Word) (b : Word)
