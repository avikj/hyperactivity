-- the lines of the cage from vertex u into the set xs
hp-into : Nat → List Nat → List FaradayLine → Nat
hp-into u xs ls = case ls of
  nil → zero
  cons l rest → (if eqb (fst l) u then (if hp-in (snd l) xs then suc (hp-into u xs rest) else hp-into u xs rest)
    else (if eqb (snd l) u then (if hp-in (fst l) xs then suc (hp-into u xs rest) else hp-into u xs rest) else hp-into u xs rest))
