-- the first operator of the list at p (nil when none)
b2-findop : Word → Nat → Word → List (List Word) → (List Word → Step W Word) → Step W Word
b2-findop mm_ zero p os kq_ =
  kq_ (h4-depl mm_ (nil))
b2-findop mm_ (suc f) p os kq_ =
  if (h4-stknil0 os) then (kq_ (h4-depl mm_ (nil))) else (let o = h4-tget-go #0 os in b2-at mm_ p o (λ a → let mm_7545 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_7545 (o))) else (b2-findop mm_7545 f p (h4-tl0 os) kq_)))
