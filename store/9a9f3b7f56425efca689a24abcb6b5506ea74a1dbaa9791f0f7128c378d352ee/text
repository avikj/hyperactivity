b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_8417 → let mm_8418 = b2-dep mm_ dd_8417 in b2-take mm_8418 p "-" (λ m → let mm_8419 = b2-dep mm_8418 m in if (%weq m #1) then (kq_ (h4-depl mm_8419 (b2-NONE))) else (b2-take mm_8419 p "+" (λ pl → let mm_8420 = b2-dep mm_8419 pl in if (%weq pl #1) then (kq_ (h4-depl mm_8420 (b2-MANY))) else (kq_ (h4-depl mm_8420 (b2-LONE))))))))
