le-phi-path : (t : List (List Word)) → (f : List (List Word) → Word) → FinRank t f → (e e' : El entry-ord) →
              MemKey {suffix-ord} (fst e) (sufs t) → MemKey {suffix-ord} (fst e') (sufs t) →
              lex-step (leq {suffix-ord} (fst e) (fst e')) (leq {suffix-ord} (fst e') (fst e)) (leq {entry-ord} e e') ≡ leq {PO} (phi f e) (phi f e')
le-phi-path t f fin e e' m m' = λ i → lex-step (fin (fst e) (fst e') m m' (~ i)) (fin (fst e') (fst e) m' m (~ i)) (leq {entry-ord} e e')
