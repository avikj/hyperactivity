-- a file's records indexed into out (its lines appended), the file cut into pieces split makes
e-index-file : List Word → List Word → List Word → List Word → Proc W Bool
e-index-file file prefix syn out = bind h-args (λ a → bind (h-write "build/etym/tmp/carry" nil) (λ w →
  bind (e-pieces file prefix) (λ ps → e-run-chunks (e-nth zero a) (e-nth (toNat #1) a) syn out ps)))
