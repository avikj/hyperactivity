  kq_ (h4-depl mm_ (q))
b2-pmarkg mm_ (suc f) rs j n q kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (q))) else (let a_5889 = rs in let j_5890 = j in scmd (w-load ((b2-a mm_ (%wadd a_5889 (%wsucc j_5890))))) (λ x_5888 → let mm_5891 = b2-dep mm_ x_5888 in let row = x_5888 in let t_5893 = row in let j_5894 = #0 in scmd (w-load ((b2-a mm_5891 (%wadd t_5893 (%wadd #2 j_5894))))) (λ x_5892 → let mm_5895 = b2-dep mm_5891 x_5892 in let ps = x_5892 in let a_5897 = ps in let j_5898 = #0 in scmd (w-load ((b2-a mm_5895 (%wadd a_5897 (%wsucc j_5898))))) (λ x_5896 → let mm_5899 = b2-dep mm_5895 x_5896 in let p0 = x_5896 in let t_5901 = p0 in scmd (w-load ((b2-a mm_5899 t_5901))) (λ x_5900 → let mm_5902 = b2-dep mm_5899 x_5900 in let tg = (%wand x_5900 #255) in if (%weq tg b2-PVAR) then (let t_5904 = p0 in let j_5905 = #2 in scmd (w-load ((b2-a mm_5902 (%wadd t_5904 (%wadd #2 j_5905))))) (λ x_5903 → let mm_5906 = b2-dep mm_5902 x_5903 in let pq = x_5903 in b2-pmarkg mm_5906 f rs (%wsucc j) n (b2-qjoin q pq) kq_)) else (b2-pmarkg mm_5902 f rs (%wsucc j) n q kq_))))))
