hr-call-def : Nat → Hv2Def → Word → Word → (Word → Step W Word) → Step W Word
hr-call-def fu (hv2def s root ns rb nv nn) m b k =
  hr-tab-nodes m ns (λ m1 →
  hr-tab-vars m1 (toNat nv) #0 (λ m2 →
  hr-copy-nodes m2 ns (λ m3 →
  hr-copy-rbag fu m3 rb (λ m4 →
  hr-adj m4 root (λ q → hr-ln fu (hv2-keep m4 q) q b k)))))
