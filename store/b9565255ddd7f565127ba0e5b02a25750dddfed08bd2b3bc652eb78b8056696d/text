-- Secondary complementary live store/ module for cross-domain grounding
this-select-mod2 : List Word → List Word → List Word
this-select-mod2 route q =
  let lq = this-lower q
      lr = this-lower route
  in if this-has-any (cons "riemann" (cons "zeta" (cons "prime" nil))) lq
       then "lib/math/rh-alpo-masullo.hypercubical"
     else if this-has-any (cons "sky130" (cons "silicon" (cons "hardware" (cons "cache" (cons "net" nil))))) lq
       then "lib/silicon/inet-compiler.hypercubical"
     else if this-has-any (cons "swarm" (cons "agent" (cons "trace" (cons "live" (cons "network" nil))))) lq
       then "lib/hx-swarm.hypercubical"
     else if h-infix "/silicon" lr then "lib/silicon/inet-compiler.hypercubical"
     else if h-infix "/physics" lr then "chem/wetlab-laws.hypercubical"
     else if h-infix "/hyperfactor" lr then "lib/hx.hypercubical"
     else "lib/os-flux.hypercubical"
