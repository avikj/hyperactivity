h3d-e5 : Nat → Nat → BZ → BZ → BZ → BZ → BZ → List BZ → List QmolState
h3d-e5 u1 u2 q1 q2 q3 e3 e4 ns = case ns of
  nil → nil
  cons e5 rest →
    (λ e0 e1 e2 →
      if both (tc-le1 e0) (both (tc-le1 e1) (tc-le1 e2))
      then cons ((u1 , u2) , tc-vec6 e0 e1 e2 e3 e4 e5) (h3d-e5 u1 u2 q1 q2 q3 e3 e4 rest)
      else h3d-e5 u1 u2 q1 q2 q3 e3 e4 rest)
    (qmol-bz-sub (qmol-bz-sub e3 e5) q1)
    (qmol-bz-sub (qmol-bz-sub e4 e3) q2)
    (qmol-bz-sub (qmol-bz-sub e5 e4) q3)
