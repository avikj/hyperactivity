b2-forceg : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-forceg mm_ zero t kq_ =
  kq_ (h4-depl mm_ (t))
b2-forceg mm_ (suc f) t kq_ =
  let t_717 = t in scmd (w-load ((b2-a mm_ t_717))) (λ x_716 → let mm_718 = b2-dep mm_ x_716 in let tg = (%wand x_716 #255) in if (%weq tg b2-VAR) then (let t_720 = t in let j_721 = #2 in scmd (w-load ((b2-a mm_718 (%wadd t_720 (%wadd #2 j_721))))) (λ x_719 → let mm_722 = b2-dep mm_718 x_719 in let v = x_719 in if (%weq v #0) then (kq_ (h4-depl mm_722 (t))) else (b2-forceg mm_722 f v kq_))) else (kq_ (h4-depl mm_718 (t))))
