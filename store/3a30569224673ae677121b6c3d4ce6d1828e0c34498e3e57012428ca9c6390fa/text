-- LHS 3-3 BF sum over jA in 0..6 and interior tetrahedra t3=(0,1,2,3), t4=(0,1,2,4), t5=(0,1,2,5):
r4d-lhs-tetK : (Nat → Nat → Nat → Nat → Nat) → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat
r4d-lhs-tetK bndK k3 k4 k5 w0 w1 w2 w3 =
  if both (eqb w0 0) (both (eqb w1 1) (eqb w2 2))
  then (if eqb w3 3 then k3 else (if eqb w3 4 then k4 else k5))
  else bndK w0 w1 w2 w3
