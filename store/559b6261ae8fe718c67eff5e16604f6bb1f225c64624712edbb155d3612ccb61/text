emg-triples-core1 : List (Nat × (Nat × Nat))
emg-triples-core1 =
  bst-bind (Nat × Nat) (Nat × (Nat × Nat)) emg-up-pairs (λ p →
  bst-bind Nat (Nat × (Nat × Nat)) emg-verts4 (λ d →
    if leb (plus (if eqb (fst p) 0 then 1 else 0) (if eqb d 0 then 1 else 0)) 1
    then cons (fst p , (snd p , d)) nil else nil))
