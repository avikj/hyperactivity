b2-pcall : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pcall mm_ p k xs s kq_ =
  b2-reso mm_ p k #0 (λ q → let mm_7039 = b2-dep mm_ q in if (%weq q b2-ERR) then (kq_ (h4-depl mm_7039 b2-ERR)) else (b2-Ref mm_7039 q s #0 (λ rf → let mm_7040 = b2-dep mm_7039 rf in b2-apps mm_7040 rf xs s (λ r → let mm_7041 = b2-dep mm_7040 r in kq_ (h4-depl mm_7041 (r))))))
