-- Dual Hypercracker Witness Extractor over the superoptimized residual form:
bfm-env4 : Word → Nat → Bool
bfm-env4 mask zero                = %weq (%wand mask #1) #1
bfm-env4 mask (suc zero)          = %weq (%wand (%wshr mask #1) #1) #1
bfm-env4 mask (suc (suc zero))    = %weq (%wand (%wshr mask #2) #1) #1
bfm-env4 mask (suc (suc (suc k))) = %weq (%wand (%wshr mask #3) #1) #1
