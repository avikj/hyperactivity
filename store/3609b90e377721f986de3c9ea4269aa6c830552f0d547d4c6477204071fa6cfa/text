syntax py
  def gn_py_fredkin_a(c: Word, a: Word, b: Word) -> Word:
    d = a ^ b
    m = c & d
    return a ^ m

  def gn_py_fredkin_b(c: Word, a: Word, b: Word) -> Word:
    d = a ^ b
    m = c & d
    return b ^ m

  def gn_py_hadamard0(f0: Word, f1: Word, f2: Word, f3: Word) -> Word:
    e = f0 + f2
    o = f1 + f3
    return e + o

  def gn_py_bhaskara_lobe(u: Word) -> Word:
    rem = 1024 - u
    return (u * rem) / 64
