b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_9820 = cs in let j_9821 = j in scmd (w-load ((b2-a mm_ (%wadd v_9820 #2)))) (λ d_9819 → let mm_9822 = b2-dep mm_ d_9819 in scmd (w-load ((b2-a mm_9822 (%wadd d_9819 (%wsucc j_9821))))) (λ x_9818 → let mm_9823 = b2-dep mm_9822 x_9818 in let c = x_9818 in let t_9825 = c in let j_9826 = #0 in scmd (w-load ((b2-a mm_9823 (%wadd t_9825 (%wadd #2 j_9826))))) (λ x_9824 → let mm_9827 = b2-dep mm_9823 x_9824 in let ck = x_9824 in if (%weq ck k) then (kq_ (h4-depl mm_9827 (c))) else (b2-ctrfind mm_9827 f cs k (%wsucc j) n kq_)))))
