b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6519 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6519 (k))) else (b2-nbytes mm_6519 ns (λ nb → let mm_6520 = b2-dpl mm_6519 nb in b2-nbytes mm_6520 k (λ kb → let mm_6521 = b2-dpl mm_6520 kb in b2-nm mm_6521 (list-append nb (cons #58 kb)) (λ r → let mm_6522 = b2-dep mm_6521 r in kq_ (h4-depl mm_6522 (r)))))))
