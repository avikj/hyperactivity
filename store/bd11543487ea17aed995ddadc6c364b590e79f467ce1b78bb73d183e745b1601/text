uf-mul16 : Word → Word → Word
uf-mul16 a b =
  let ua  = uf-w32 a
      ub  = uf-w32 b
      na  = %wlt #2147483647 ua
      nb  = %wlt #2147483647 ub
      ma  = if na then uf-neg ua else ua
      mb  = if nb then uf-neg ub else ub
      pr  = %wshr (%wmul ma mb) #16
      neg = if na then not nb else nb
  in if neg then uf-neg pr else uf-w32 pr
