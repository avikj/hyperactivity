-- Darwin XNU ARM64 WCmd command body:
--   Input:  x1 = WCmd value (immediate < 4096 for w-now=0 / w-fence=10, or cell [tag][fields...] >= 4096)
--   Output: x0 = WCmd response value (Word, Unit=#0, Bytes, or Pair [0][count][bytes])
a64-wcmd-body : Lst Word
a64-wcmd-body =
  let -- Immediate WCmd constructors (< 4096): w-now (0) via Darwin gettimeofday (#116), w-fence (10) via DMB ISH
      c-now = xcat6 (a64-insn #3506455551)
                    (xcat5 (a64-insn #2432697312) (a64-movz #1 #0 #0) (a64-movz #2 #0 #0) (a64-movz #16 #116 #0) a64-svc-darwin)
                    (l-app (a64-insn #4181722080) (a64-insn #3107982314))
                    (a64-insn #2432713727)
                    (l-app (a64-imm32 #9 #1000000000) (a64-mul #0 #0 #9))
                    (xcat3 (a64-movz #9 #1000 #0) (a64-mul #10 #10 #9) (a64-add #0 #0 #10))
      c-fence = l-app a64-dmb-ish (a64-movz #0 #0 #0)
      imm-br  = l-app (a64-cmp #1 #31) (a64-if-cc a64-cc-eq a64-cc-ne c-now c-fence)
      -- Heap WCmd constructors ([cm, #0] in x1, cm saved in x12):
      -- 1: w-write fd=cm[1] n=cm[2] b=cm[3] -> Darwin write (#4), 0 on error/empty
      w-wr-do = xcat4 (a64-movz #9 #8 #0) (a64-add #1 #3 #9) (l-app (a64-movz #16 #4 #0) a64-svc-darwin) (a64-csel #0 #31 #0 a64-cc-hs)
      c-write = xcat6 (a64-ldr-idx #0 #12 #1) (a64-ldr-idx #2 #12 #2) (a64-ldr-idx #3 #12 #3)
                      (l-app (a64-ldr-idx #9 #3 #0) (l-app (a64-cmp #2 #9) (a64-csel #2 #2 #9 a64-cc-lo)))
                      (a64-cmp #2 #31)
                      (a64-if-cc a64-cc-eq a64-cc-ne (a64-movz #0 #0 #0) w-wr-do)
      -- 2: w-read fd=cm[1] n=cm[2] -> fresh zeroed Bytes n + Darwin read (#3) + Pair [0, count, bytes]
      r-zstep = xcat4 (a64-add #10 #13 #9) (a64-str-idx #31 #10 #0) (a64-movz #11 #8 #0) (a64-add #9 #9 #11)
      r-alloc = xcat6 (a64-ldr-idx #2 #12 #2)
                      (xcat4 (a64-movz #9 #15 #0) (a64-adds #14 #2 #9) a64-over-if-hs (a64-insn #2457727009))
                      (l-app (a64-mov-r #1 #14) (a64-insn #2457727009))
                      (xcat6 (a64-mov-r #13 #21) (a64-movz #9 #24 #0) (a64-adds #1 #1 #9) a64-over-if-hs (l-app (a64-adds #21 #21 #1) a64-over-if-hs) (l-app (a64-cmp #21 #22) a64-over-if-hi))
                      (xcat3 (a64-str-idx #2 #13 #0) (a64-movz #9 #8 #0) (a64-while-cc (a64-cmp #9 #14) a64-cc-hs r-zstep))
                      (l-app (a64-mov-r #0 #13) (a64-insn #4162585504))
      r-call  = xcat5 (a64-insn #4166779808) (l-app (a64-movz #9 #8 #0) (a64-add #1 #0 #9))
                      (a64-ldr-idx #0 #12 #1) (a64-ldr-idx #2 #12 #2)
                      (xcat3 (a64-movz #16 #3 #0) a64-svc-darwin (a64-csel #0 #31 #0 a64-cc-hs))
      r-pair  = xcat6 (a64-insn #4166779808) (a64-mov-r #2 #0)
                      (xcat4 (a64-ldr-idx #9 #2 #0) (a64-movz #10 #15 #0) (a64-add #9 #9 #10) (l-app (a64-mov-r #1 #9) (a64-insn #2457727009)))
                      (a64-add #1 #2 #1)
                      (xcat3 (a64-str-idx #31 #1 #0) (a64-str-idx #3 #1 #1) (a64-str-idx #2 #1 #2))
                      (a64-mov-r #0 #1)
      c-read  = xcat4 r-alloc
                      (l-app (a64-cmp #2 #31) (a64-if-cc a64-cc-eq a64-cc-ne (a64-movz #0 #0 #0) r-call))
                      (a64-mov-r #3 #0) r-pair
      -- 3: w-sleep ns=cm[1] -> Darwin select(0,0,0,0,&tv) (#93) -> unit (#0)
      c-sleep = xcat6 (a64-ldr-idx #0 #12 #1) (a64-imm32 #9 #1000000000)
                      (xcat4 (a64-udiv #10 #0 #9) (a64-msub #11 #10 #9 #0) (a64-movz #9 #1000 #0) (a64-udiv #11 #11 #9))
                      (xcat3 (a64-insn #3506455551) (l-app (a64-mov-r #0 #10) (a64-insn #4177527776)) (a64-str-idx #11 #31 #1))
                      (xcat6 (a64-movz #0 #0 #0) (a64-movz #1 #0 #0) (a64-movz #2 #0 #0) (a64-movz #3 #0 #0)
                             (l-app (a64-insn #2432697312) (a64-mov-r #4 #0)) (l-app (a64-movz #16 #93 #0) a64-svc-darwin))
                      (l-app (a64-insn #2432713727) (a64-movz #0 #0 #0))
      -- 4: w-exit ec=cm[1] -> Darwin exit (#1)
      c-exit  = xcat3 (a64-ldr-idx #0 #12 #1) (a64-movz #16 #1 #0) a64-svc-darwin
      -- 5: w-open n=cm[1] p=cm[2] flags=cm[3] mode=cm[4] -> arena NUL-terminated copy + Darwin open (#5)
      o-cstep = xcat4 (a64-insn #943723938) (a64-insn #939529666) (a64-movz #15 #1 #0) (a64-add #9 #9 #15)
      c-open  = xcat6 (l-app (a64-ldr-idx #10 #12 #1) (a64-ldr-idx #11 #12 #2))
                      (xcat3 (a64-ldr-idx #9 #11 #0) (a64-cmp #10 #9) (a64-csel #10 #10 #9 a64-cc-lo))
                      (xcat6 (a64-movz #9 #8 #0) (a64-adds #1 #10 #9) a64-over-if-hs (a64-insn #2457727009)
                             (l-app (a64-mov-r #0 #21) (l-app (a64-adds #21 #21 #1) a64-over-if-hs))
                             (l-app (a64-cmp #21 #22) a64-over-if-hi))
                      (xcat5 (a64-movz #9 #8 #0) (a64-add #13 #11 #9) (a64-mov-r #14 #0) (a64-movz #9 #0 #0)
                             (l-app (a64-while-cc (a64-cmp #9 #10) a64-cc-hs o-cstep) (l-app (a64-mov-r #10 #14) (a64-insn #956301663))))
                      (xcat3 (a64-ldr-idx #3 #12 #3) a64-oflags (a64-ldr-idx #2 #12 #4))
                      (xcat4 (a64-movz #16 #5 #0) a64-svc-darwin (a64-insn #2470476800)
                             (l-app (a64-insn #2457862148) (a64-csel #0 #4 #0 a64-cc-hs)))
      -- 6: w-close fd=cm[1] -> Darwin close (#6)
      c-close = xcat5 (a64-ldr-idx #0 #12 #1) (a64-movz #16 #6 #0) a64-svc-darwin
                      (a64-insn #2470476800) (l-app (a64-insn #2457862148) (a64-csel #0 #4 #0 a64-cc-hs))
      -- 7: w-load a=cm[1] (acquire), 8: w-store a=cm[1] v=cm[2] (release), 9: w-cas a=cm[1] old=cm[2] new=cm[3] (LSE CASAL)
      c-load  = l-app (a64-ldr-idx #0 #12 #1) a64-ldar-x0
      c-store = xcat4 (a64-ldr-idx #0 #12 #1) (a64-ldr-idx #1 #12 #2) a64-stlr-x1-x0 (a64-movz #0 #0 #0)
      c-cas   = xcat4 (a64-ldr-idx #2 #12 #1) (a64-ldr-idx #0 #12 #2) (a64-ldr-idx #1 #12 #3) (a64-casal #0 #1 #2)
      -- 11: w-sys nr=cm[1] a1..a6=cm[2..7] (Linux-to-Darwin syscall mapping + /proc/self/cmdline synthesis for sg-macho)
      magic-fd = a64-movz #15 #32767 #1
      s-open-magic = xcat3 (a64-str-idx #31 #20 #5) magic-fd (a64-mov-r #0 #15)
      s-open-real  = xcat5 (a64-ldr-idx #0 #12 #2) (a64-ldr-idx #3 #12 #3) a64-oflags (a64-ldr-idx #2 #12 #4)
                           (xcat4 (a64-movz #16 #5 #0) a64-svc-darwin (l-app (a64-mov-r #9 #0) (a64-sub #9 #31 #9)) (a64-csel #0 #9 #0 a64-cc-hs))
      s-open = xcat3 (a64-ldr-idx #0 #12 #2) (a64-cmp #0 #31)
                     (a64-if-cc a64-cc-eq a64-cc-ne s-open-real
                       (xcat4 (a64-ldr-idx #9 #0 #0) (a64-imm64 #10 #7310234824689709103) (a64-cmp #9 #10)
                              (a64-if-cc a64-cc-ne a64-cc-eq s-open-real
                                (xcat4 (a64-ldr-idx #9 #0 #1) (a64-imm64 #10 #7596566418025838188) (a64-cmp #9 #10)
                                       (a64-if-cc a64-cc-eq a64-cc-ne s-open-magic s-open-real)))))
      arg-ch-step = xcat5 (a64-insn #960495906) (a64-insn #939529666) (a64-movz #10 #1 #0) (a64-add #9 #9 #10)
                          (l-app (a64-cmp #2 #31) (a64-if-cc a64-cc-eq a64-cc-ne (a64-mov-r #9 #15) lnil))
      arg-ch-test = l-app (a64-cmp #9 #15) (a64-if-cc a64-cc-eq a64-cc-ne (a64-cmp #15 #15) (a64-cmp #14 #15))
      arg-i-step  = xcat4 (l-app (a64-mov-r #14 #13) (a64-insn #3548246479))
                          (l-app (a64-add #10 #11 #15) (a64-ldr-idx #9 #10 #1))
                          (xcat4 (a64-mov-r #14 #2) (a64-ldr-idx #10 #12 #3) (a64-ldr-idx #15 #12 #4) (a64-add #15 #10 #15))
                          (l-app (a64-while-cc arg-ch-test a64-cc-hs arg-ch-step)
                                 (xcat3 (a64-mov-r #2 #14) (a64-movz #10 #1 #0) (a64-add #13 #13 #10)))
      s-read-magic = xcat3 (a64-ldr-idx #9 #20 #5) (a64-cmp #9 #31)
                           (a64-if-cc a64-cc-ne a64-cc-eq (a64-movz #0 #0 #0)
                             (xcat6 (l-app (a64-movz #9 #1 #0) (a64-str-idx #9 #20 #5))
                                    (a64-ldr-idx #11 #20 #4) (a64-ldr-idx #1 #11 #0)
                                    (l-app (a64-ldr-idx #2 #12 #3) (a64-movz #13 #0 #0))
                                    (a64-while-cc (a64-cmp #13 #1) a64-cc-hs arg-i-step)
                                    (l-app (a64-ldr-idx #10 #12 #3) (a64-sub #0 #2 #10))))
      s-gen-call = xcat6 (a64-ldr-idx #0 #12 #2) (a64-ldr-idx #1 #12 #3) (a64-ldr-idx #2 #12 #4)
                         (l-app (a64-ldr-idx #3 #12 #5) (l-app (a64-ldr-idx #4 #12 #6) (a64-ldr-idx #5 #12 #7)))
                         a64-svc-darwin
                         (l-app (l-app (a64-mov-r #9 #0) (a64-sub #9 #31 #9)) (a64-csel #0 #9 #0 a64-cc-hs))
      s-read  = xcat4 (a64-ldr-idx #0 #12 #2) magic-fd (a64-cmp #0 #15)
                      (a64-if-cc a64-cc-eq a64-cc-ne s-read-magic (l-app (a64-movz #16 #3 #0) s-gen-call))
      s-close = xcat4 (a64-ldr-idx #0 #12 #2) magic-fd (a64-cmp #0 #15)
                      (a64-if-cc a64-cc-eq a64-cc-ne (a64-movz #0 #0 #0) (l-app (a64-movz #16 #6 #0) s-gen-call))
      s-exit  = xcat3 (a64-ldr-idx #0 #12 #2) (a64-movz #16 #1 #0) a64-svc-darwin
      s-other = xcat3 (a64-movz #9 #65535 #0) (a64-and-r #16 #1 #9) s-gen-call
      c-sys   = l-app (a64-ldr-idx #1 #12 #1)
                  (a64-case-chain
                    (lcons (#0 , s-read)
                    (lcons (#1 , l-app (a64-movz #16 #4 #0) s-gen-call)
                    (lcons (#2 , s-open)
                    (lcons (#3 , s-close)
                    (lcons (#10 , l-app (a64-movz #16 #74 #0) s-gen-call)
                    (lcons (#11 , l-app (a64-movz #16 #73 #0) s-gen-call)
                    (lcons (#39 , l-app (a64-movz #16 #20 #0) s-gen-call)
                    (lcons (#60 , s-exit)
                    (lcons (#80 , l-app (a64-movz #16 #12 #0) s-gen-call)
                    (lcons (#82 , l-app (a64-movz #16 #128 #0) s-gen-call)
                    (lcons (#83 , l-app (a64-movz #16 #136 #0) s-gen-call)
                    (lcons (#87 , l-app (a64-movz #16 #10 #0) s-gen-call)
                    (lcons (#231 , s-exit)
                    (lcons (#0 , s-other) lnil)))))))))))))))
      -- 12: w-alloc n=cm[1] -> 16 KiB-aligned Darwin mmap (#197), overflow exit on carry
      c-alloc = xcat6 (a64-ldr-idx #0 #12 #1) (a64-movz #9 #16383 #0)
                      (xcat3 (a64-adds #0 #0 #9) a64-over-if-hs (a64-insn #2456994816))
                      (xcat3 (a64-movz #9 #16384 #0) (a64-cmp #0 #9) (a64-csel #1 #9 #0 a64-cc-lo))
                      (xcat6 (a64-movz #0 #0 #0) (a64-movz #2 #3 #0) (a64-movz #3 #4098 #0)
                             (a64-insn #2457862148) (a64-movz #5 #0 #0) (l-app (a64-movz #16 #197 #0) a64-svc-darwin))
                      a64-over-if-hs
      -- 13: w-load8 a=cm[1], 14: w-store8 a=cm[1] v=cm[2]
      c-ld8   = l-app (a64-ldr-idx #0 #12 #1) (a64-insn #960495616)
      c-st8   = xcat4 (a64-ldr-idx #0 #12 #1) (a64-ldr-idx #1 #12 #2) (a64-insn #956301313) (a64-movz #0 #0 #0)
      heap-br = xcat3 (a64-mov-r #12 #1) (a64-ldr-idx #1 #12 #0)
                  (a64-case-chain
                    (lcons (#1 , c-write)
                    (lcons (#2 , c-read)
                    (lcons (#3 , c-sleep)
                    (lcons (#4 , c-exit)
                    (lcons (#5 , c-open)
                    (lcons (#6 , c-close)
                    (lcons (#7 , c-load)
                    (lcons (#8 , c-store)
                    (lcons (#9 , c-cas)
                    (lcons (#11 , c-sys)
                    (lcons (#12 , c-alloc)
                    (lcons (#13 , c-ld8)
                    (lcons (#14 , c-st8)
                    (lcons (#0 , a64-brk) lnil)))))))))))))))
  in xcat3 (a64-movz #9 #4096 #0) (a64-cmp #1 #9) (a64-if-cc a64-cc-lo a64-cc-hs imm-br heap-br)
