sx-box = "<div class='section'>Search</div><input id='sq' type='search' placeholder='Search every work' autocomplete='off' style='width:100%;box-sizing:border-box;padding:.6em;font:inherit;border:1px solid #ccc;border-radius:4px'><ul class='list' id='sr'></ul><script>(function(){var q=document.getElementById('sq'),r=document.getElementById('sr'),t={},n=0;for(var i=0;i<document.links.length;i++){var a=document.links[i],h=a.getAttribute('href');if(h&&h.charAt(0)=='/'&&!t[h])t[h]=a.firstChild?a.firstChild.textContent:h;}q.addEventListener('input',function(){var v=q.value.trim(),k=++n;if(!v){r.innerHTML='';return;}fetch('/search?q='+encodeURIComponent(v)).then(function(x){return x.json();}).then(function(a){if(k!=n)return;r.innerHTML='';a.forEach(function(e){var li=document.createElement('li'),l=document.createElement('a'),s=document.createElement('span');l.href=e.h;l.textContent=t[e.h]||e.h;s.className='kind';s.textContent=e.w?'being indexed':(e.c+(e.c==1?' place':' places'));l.appendChild(s);li.appendChild(l);r.appendChild(li);});if(!a.length)r.innerHTML='<li>No work holds it.</li>';});});})();</script>"
