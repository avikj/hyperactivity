-- a sentence that goes on deriving the word (etym.py: The/This/… … from, borrowed, derived; From)
e-goes-on : List Word → Bool
e-goes-on a =
  orB (orB (e-any-word-at (cons "From" (cons "from" nil)) a) (andB (h-prefix "Ultimately " a) (e-any-word-at (cons "From" (cons "from" nil)) (h-drop "Ultimately " a))))
      (e-goes-on-the (h-split #32 "The This That Its Ultimately Further Ultimate") a)
