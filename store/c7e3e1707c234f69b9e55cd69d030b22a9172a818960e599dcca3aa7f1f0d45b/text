-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10426 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10426))) (λ x_10425 → let mm_10427 = b2-dep mm_ x_10425 in let lb = x_10425 in if (%weq lb #0) then (let i_10429 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10427 i_10429))) (λ x_10428 → let mm_10430 = b2-dep mm_10427 x_10428 in let t = x_10428 in kq_ (h4-depl mm_10430 (t)))) else (let i_10432 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10427 i_10432))) (λ x_10431 → let mm_10433 = b2-dep mm_10427 x_10431 in let lx = x_10431 in b2-body mm_10433 bk lb lx (λ r → let mm_10434 = b2-dep mm_10433 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10434 b2-ERR)) else (kq_ (h4-depl mm_10434 (r)))))))
