-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7421 = tel in let j_7422 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7421 (%wsucc j_7422))))) (λ x_7420 → let mm_7423 = b2-dep mm_ x_7420 in let c = x_7420 in let i_7425 = c in scmd (w-load ((b2-a mm_7423 i_7425))) (λ x_7424 → let mm_7426 = b2-dep mm_7423 x_7424 in let q = x_7424 in let i_7428 = (%wadd c #1) in scmd (w-load ((b2-a mm_7426 i_7428))) (λ x_7427 → let mm_7429 = b2-dep mm_7426 x_7427 in let k = x_7427 in let i_7431 = (%wadd c #2) in scmd (w-load ((b2-a mm_7429 i_7431))) (λ x_7430 → let mm_7432 = b2-dep mm_7429 x_7430 in let i = x_7430 in let i_7434 = (%wadd c #3) in scmd (w-load ((b2-a mm_7432 i_7434))) (λ x_7433 → let mm_7435 = b2-dep mm_7432 x_7433 in let vT = x_7433 in let i_7437 = (%wadd c #4) in scmd (w-load ((b2-a mm_7435 i_7437))) (λ x_7436 → let mm_7438 = b2-dep mm_7435 x_7436 in let s = x_7436 in b2-All mm_7438 q k i vT e s (λ a → let mm_7439 = b2-dep mm_7438 a in b2-telebindg mm_7439 f tel (%wsub j #1) a kq_))))))))
