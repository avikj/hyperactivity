  kq_ (h4-depl mm_ (tel))
b2-tfillg mm_ (suc f) bk tel xs ctx def s j kq_ =
  let a_10542 = xs in scmd (w-load ((b2-a mm_ a_10542))) (λ x_10541 → let mm_10543 = b2-dep mm_ x_10541 in let n = x_10541 in if (%weq j n) then (kq_ (h4-depl mm_10543 (tel))) else (b2-thead mm_10543 bk tel ctx def s (λ h → let mm_10544 = b2-dep mm_10543 h in if (%weq h b2-ERR) then (kq_ (h4-depl mm_10544 b2-ERR)) else (let t_10546 = h in let j_10547 = #4 in scmd (w-load ((b2-a mm_10544 (%wadd t_10546 (%wadd #2 j_10547))))) (λ x_10545 → let mm_10548 = b2-dep mm_10544 x_10545 in let vB = x_10545 in let a_10550 = xs in let j_10551 = j in scmd (w-load ((b2-a mm_10548 (%wadd a_10550 (%wsucc j_10551))))) (λ x_10549 → let mm_10552 = b2-dep mm_10548 x_10549 in let x = x_10549 in b2-body mm_10552 bk vB x (λ t2 → let mm_10553 = b2-dep mm_10552 t2 in if (%weq t2 b2-ERR) then (kq_ (h4-depl mm_10553 b2-ERR)) else (b2-tfillg mm_10553 f bk t2 xs ctx def s (%wsucc j) kq_))))))))
