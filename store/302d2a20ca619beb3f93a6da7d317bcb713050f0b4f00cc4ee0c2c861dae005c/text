tui-parse-peers : List Word → List Word
tui-parse-peers s =
  let pat = h-concat (cons tui-q (cons "peers" (cons tui-q (cons ":[" nil)))) in
  if h-infix pat s then tui-parse-peers-go (toNat #14) (h-after pat s)
  else tui-line (tui-paint tui-muted "(polling https://hyperactivity.ai/api/p2p/signal ...)")
