b2-pcall : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pcall mm_ p k xs s kq_ =
  b2-reso mm_ p k #0 (λ q → let mm_6827 = b2-dep mm_ q in if (%weq q b2-ERR) then (kq_ (h4-depl mm_6827 b2-ERR)) else (b2-Ref mm_6827 q s #0 (λ rf → let mm_6828 = b2-dep mm_6827 rf in b2-apps mm_6828 rf xs s (λ r → let mm_6829 = b2-dep mm_6828 r in kq_ (h4-depl mm_6829 (r))))))
