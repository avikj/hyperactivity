s-trace-read-lines : List (List Word) → List Word
s-trace-read-lines nil = nil
s-trace-read-lines (cons l nil) = if h-null l then nil else l
s-trace-read-lines (cons l ls) =
  if h-null l then s-trace-read-lines ls
  else let rest = s-trace-read-lines ls in
       if h-null rest then l else h-concat (cons l (cons "," (cons rest nil)))
