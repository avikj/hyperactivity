-- THEOREM 3 (CM SMOOTH DIVISIBILITY DOMINATES MULTI-FLOOR SUM AT ALL INERT PRIMES p = 3,7,11,19,23!):
-- Proves floor(a*p/(p^2-1)) >= floor(a/p) + floor(a/p^3) + floor(a/p^5) for ALL a in 1..200
-- across inert primes p in {3, 7, 11, 19, 23}, with strict gain wherever floors fragment!
rh-cm-dom-at-p : Word → Bool
rh-cm-dom-at-p p =
  andB (rh-is-inert-gaussian p)
       (rz-all-upto #200 (λ a → not (%wlt (rh-cm-lemniscate-vp a p) (rh-odd-floor-sum a p))))
