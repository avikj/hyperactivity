data SemRelation : Type where
  RelDigestEq : SemRelation   -- digest(d1) = digest(d2) (exact canonical collision)
  RelDataIso  : SemRelation   -- canon_decl(D1) = canon_decl(D2) (univalent ua candidate)
  RelSemEq    : SemRelation   -- shape-erased (type, term) match across generative types
  RelSubterm  : SemRelation   -- shared internal compound sub-expression
