b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10499 = cs in let j_10500 = j in scmd (w-load ((b2-a mm_ (%wadd v_10499 #2)))) (λ d_10498 → let mm_10501 = b2-dep mm_ d_10498 in scmd (w-load ((b2-a mm_10501 (%wadd d_10498 (%wsucc j_10500))))) (λ x_10497 → let mm_10502 = b2-dep mm_10501 x_10497 in let c = x_10497 in let t_10504 = c in let j_10505 = #0 in scmd (w-load ((b2-a mm_10502 (%wadd t_10504 (%wadd #2 j_10505))))) (λ x_10503 → let mm_10506 = b2-dep mm_10502 x_10503 in let ck = x_10503 in if (%weq ck k) then (kq_ (h4-depl mm_10506 (c))) else (b2-ctrfind mm_10506 f cs k (%wsucc j) n kq_)))))
