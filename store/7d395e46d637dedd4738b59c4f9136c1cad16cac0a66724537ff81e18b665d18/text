gn-q-check-hperp : QState3 → Bool
gn-q-check-hperp (qs3 s0 s1 s2 s3 s4 s5 s6 s7) =
  web-andB (z8-eq s0 z8-two)
  (web-andB (z8-eq s1 z8-zero)
  (web-andB (z8-eq s2 z8-zero)
  (web-andB (z8-eq s3 z8-two)
  (web-andB (z8-eq s4 z8-zero)
  (web-andB (z8-eq s5 z8-two)
  (web-andB (z8-eq s6 z8-two)
            (z8-eq s7 z8-zero)))))))
