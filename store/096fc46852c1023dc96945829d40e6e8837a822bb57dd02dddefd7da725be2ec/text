-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10693 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10693))) (λ x_10692 → let mm_10694 = b2-dep mm_ x_10692 in let lb = x_10692 in if (%weq lb #0) then (let i_10696 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10694 i_10696))) (λ x_10695 → let mm_10697 = b2-dep mm_10694 x_10695 in let t = x_10695 in kq_ (h4-depl mm_10697 (t)))) else (let i_10699 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10694 i_10699))) (λ x_10698 → let mm_10700 = b2-dep mm_10694 x_10698 in let lx = x_10698 in b2-body mm_10700 bk lb lx (λ r → let mm_10701 = b2-dep mm_10700 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10701 b2-ERR)) else (kq_ (h4-depl mm_10701 (r)))))))
