-- the operator at the text (src/hvm.c parse_term_opr_peek): (code or 99, length)
h4-opr : List Word → Word × Word
h4-opr s =
  let c = hv2-nth #0 s
      d = hv2-nth #1 s
  in if andB (%weq c #61) (%weq d #61) then (#11 , #2)
     else if andB (%weq c #33) (%weq d #61) then (#12 , #2)
     else if andB (%weq c #60) (%weq d #61) then (#14 , #2)
     else if andB (%weq c #62) (%weq d #61) then (#16 , #2)
     else if andB (%weq c #60) (%weq d #60) then (#8 , #2)
     else if andB (%weq c #62) (%weq d #62) then (#9 , #2)
     else if andB (%weq c #38) (%weq d #38) then (#5 , #2)
     else if andB (%weq c #124) (%weq d #124) then (#6 , #2)
     else if %weq c #43 then (#0 , #1) else if %weq c #45 then (#1 , #1) else if %weq c #42 then (#2 , #1)
     else if %weq c #47 then (#3 , #1) else if %weq c #37 then (#4 , #1) else if %weq c #94 then (#7 , #1)
     else if %weq c #126 then (#10 , #1) else if %weq c #60 then (#13 , #1) else if %weq c #62 then (#15 , #1)
     else (#99 , #0)
