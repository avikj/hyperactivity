b2-M1 : Word
b2-M1 = #18446744073709551615
b2-M2 : Word
b2-M2 = #18446744073709551614

b2-neg : Word → Bool
b2-neg i = %wlt #9223372036854775807 i

-- ===========================================================================================
-- Memory steps (inlined)
-- ===========================================================================================

macro b2m-rd (i : Word) : Word
  x <- rd (b2-a M i)
  ret x

macro b2m-wr (i : Word) (v : Word) : Word
  wr (b2-a M i) v
  ret v

macro b2m-alloc (n : Word) : Word
  at <- rd M
  wr M (%wadd at n)
  ret at

-- a node's tag, span and j-th field
macro b2m-tag (t : Word) : Word
  x <- rd (b2-a M t)
  ret (%wand x #255)

macro b2m-span (t : Word) : Word
  x <- rd (b2-a M (%wadd t #1))
  ret x

macro b2m-f (t : Word) (j : Word) : Word
  x <- rd (b2-a M (%wadd t (%wadd #2 j)))
  ret x

macro b2m-setf (t : Word) (j : Word) (v : Word) : Word
  wr (b2-a M (%wadd t (%wadd #2 j))) v
  ret v

macro b2m-n0 (tg : Word) (s : Word) : Word
  at <- b2m-alloc #2
  do b2m-wr at tg
  do b2m-wr (%wadd at #1) s
  ret at

macro b2m-n1 (tg : Word) (s : Word) (a : Word) : Word
  at <- b2m-alloc #3
  do b2m-wr at (%wor tg #256)
  do b2m-wr (%wadd at #1) s
  do b2m-wr (%wadd at #2) a
  ret at

macro b2m-n2 (tg : Word) (s : Word) (a : Word) (b : Word) : Word
  at <- b2m-alloc #4
  do b2m-wr at (%wor tg #512)
  do b2m-wr (%wadd at #1) s
  do b2m-wr (%wadd at #2) a
  do b2m-wr (%wadd at #3) b
  ret at

macro b2m-n3 (tg : Word) (s : Word) (a : Word) (b : Word) (c : Word) : Word
  at <- b2m-alloc #5
  do b2m-wr at (%wor tg #768)
  do b2m-wr (%wadd at #1) s
  do b2m-wr (%wadd at #2) a
  do b2m-wr (%wadd at #3) b
  do b2m-wr (%wadd at #4) c
  ret at

macro b2m-n4 (tg : Word) (s : Word) (a : Word) (b : Word) (c : Word) (e : Word) : Word
  at <- b2m-alloc #6
  do b2m-wr at (%wor tg #1024)
  do b2m-wr (%wadd at #1) s
  do b2m-wr (%wadd at #2) a
  do b2m-wr (%wadd at #3) b
  do b2m-wr (%wadd at #4) c
  do b2m-wr (%wadd at #5) e
  ret at

macro b2m-n5 (tg : Word) (s : Word) (a : Word) (b : Word) (c : Word) (e : Word) (g : Word) : Word
  at <- b2m-alloc #7
  do b2m-wr at (%wor tg #1280)
  do b2m-wr (%wadd at #1) s
  do b2m-wr (%wadd at #2) a
  do b2m-wr (%wadd at #3) b
  do b2m-wr (%wadd at #4) c
  do b2m-wr (%wadd at #5) e
  do b2m-wr (%wadd at #6) g
  ret at

-- a copy of a node (JavaScript's { ...v })
fnrec b2-copyf (f : Nat) (src : Word) (dst : Word) (j : Word) (n : Word) : Word
  zero: ret dst
  if %weq j n
    ret dst
  x <- b2m-rd (%wadd src j)
  do b2m-wr (%wadd dst j) x
  jump b2-copyf f src dst (%wsucc j) n

fn b2-copy (t : Word) : Word
  h <- b2m-rd t
  let n = %wadd #2 (%wshr h #8)
  at <- b2m-alloc n
  r <- b2-copyf (toNat #16) t at #0 n
  ret r

-- ===========================================================================================
-- Arrays: [length, items..]; a growing vector is [length, capacity, array]
-- ===========================================================================================

macro b2m-len (a : Word) : Word
  x <- rd (b2-a M a)
  ret x

macro b2m-at (a : Word) (j : Word) : Word
  x <- rd (b2-a M (%wadd a (%wsucc j)))
  ret x

macro b2m-put (a : Word) (j : Word) (v : Word) : Word
  wr (b2-a M (%wadd a (%wsucc j))) v
  ret v

fn b2-arr (n : Word) : Word
  at <- b2m-alloc (%wsucc n)
  do b2m-wr at n
  ret at

-- an array from a list
fnrec b2-arrfill (f : Nat) (a : Word) (j : Word) (xs : List Word) : Word
  zero: ret a
  if h4-isnil xs
    ret a
  do b2m-put a j (hv2-nth #0 xs)
  jump b2-arrfill f a (%wsucc j) (hv2-drop1 xs)

fn b2-arrl (xs : List Word) : Word
  a <- b2-arr (cli-len xs)
  r <- b2-arrfill (toNat #4294967295) a #0 xs
  ret r

-- the items of an array as a list
fnrec b2-arrlist (f : Nat) (a : Word) (j : Word) (acc : List Word) : List Word
  zero: ret acc
  if %weq j #0
    ret acc
  x <- b2m-at a (%wsub j #1)
  jump b2-arrlist f a (%wsub j #1) (cons x acc)

fn b2-list (a : Word) : List Word
  if %weq a #0
    ret nil
  n <- b2m-len a
  r <-[b2-dpl] b2-arrlist (toNat #4294967295) a n nil
  ret r

fn b2-vec : Word
  d <- b2-arr #8
  at <- b2m-alloc #3
  do b2m-wr at #0
  do b2m-wr (%wadd at #1) #8
  do b2m-wr (%wadd at #2) d
  ret at

fn b2-vgrow (v : Word) : Word
  n <- b2m-rd v
  c <- b2m-rd (%wadd v #1)
  d <- b2m-rd (%wadd v #2)
  e <- b2-arr (%wmul c #2)
  do b2-copyf (toNat #4294967295) (%wsucc d) (%wsucc e) #0 n
  do b2m-wr (%wadd v #1) (%wmul c #2)
  do b2m-wr (%wadd v #2) e
  ret v

fn b2-vpush (v : Word) (x : Word) : Word
  n <- b2m-rd v
  c <- b2m-rd (%wadd v #1)
  if %weq n c
    do b2-vgrow v
  d <- b2m-rd (%wadd v #2)
  do b2m-put d n x
  do b2m-wr v (%wsucc n)
  ret x

macro b2m-vlen (v : Word) : Word
  x <- rd (b2-a M v)
  ret x

macro b2m-vat (v : Word) (j : Word) : Word
  d <- rd (b2-a M (%wadd v #2))
  x <- rd (b2-a M (%wadd d (%wsucc j)))
  ret x

-- the vector's items as an array of their own
fn b2-vfreeze (v : Word) : Word
  n <- b2m-rd v
  d <- b2m-rd (%wadd v #2)
  a <- b2-arr n
  do b2-copyf (toNat #4294967295) (%wsucc d) (%wsucc a) #0 n
  ret a

-- ===========================================================================================
-- Maps from words (names, keys) to words: [table, count, parent]; a table is [capacity, keys..,
-- values..], key 0 empty. A miss reads the parent (JavaScript's Object.create(parent)).
-- ===========================================================================================

b2-hash : Word → Word
b2-hash k = %wand (%wxor (%wmul (%wand k #4294967295) #2654435761) (%wshr k #32)) #4294967295

fn b2-tab (cap : Word) : Word
  at <- b2m-alloc (%wadd #1 (%wmul cap #2))
  do b2m-wr at cap
  ret at

fn b2-map (parent : Word) : Word
  t <- b2-tab #16
  at <- b2m-alloc #3
  do b2m-wr at t
  do b2m-wr (%wadd at #1) #0
  do b2m-wr (%wadd at #2) parent
  ret at

-- the slot of k in a table: its own, or the empty one where it would go
fnrec b2-slot (f : Nat) (t : Word) (cap : Word) (k : Word) (j : Word) : Word
  zero: ret hv2-none
  x <- b2m-rd (%wadd t (%wsucc j))
  if orB (%weq x k) (%weq x #0)
    ret j
  jump b2-slot f t cap k (%wmod (%wsucc j) cap)

-- the value of k in this map alone (0 when absent), and whether it is there
fn b2-mget1 (mp : Word) (k : Word) : Word
  t <- b2m-rd mp
  cap <- b2m-rd t
  j <- b2-slot (toNat #4294967295) t cap k (%wmod (b2-hash k) cap)
  x <- b2m-rd (%wadd t (%wsucc j))
  if %weq x #0
    ret hv2-none
  v <- b2m-rd (%wadd t (%wadd (%wsucc j) cap))
  ret v

-- through the parents: hv2-none when absent everywhere
fnrec b2-mgetp (f : Nat) (mp : Word) (k : Word) : Word
  zero: ret hv2-none
  if %weq mp #0
    ret hv2-none
  v <- b2-mget1 mp k
  if not (%weq v hv2-none)
    ret v
  p <- b2m-rd (%wadd mp #2)
  jump b2-mgetp f p k

fn b2-mget (mp : Word) (k : Word) : Word
  r <- b2-mgetp (toNat #64) mp k
  ret r

-- put k = v in a table; 1 when k is new there
fn b2-tput (t : Word) (k : Word) (v : Word) : Word
  cap <- b2m-rd t
  j <- b2-slot (toNat #4294967295) t cap k (%wmod (b2-hash k) cap)
  x <- b2m-rd (%wadd t (%wsucc j))
  do b2m-wr (%wadd t (%wadd (%wsucc j) cap)) v
  if not (%weq x #0)
    ret #0
  do b2m-wr (%wadd t (%wsucc j)) k
  ret #1

fnrec b2-rehash (f : Nat) (t : Word) (cap : Word) (t2 : Word) (j : Word) : Word
  zero: ret t2
  if %weq j cap
    ret t2
  k <- b2m-rd (%wadd t (%wsucc j))
  if %weq k #0
    jump b2-rehash f t cap t2 (%wsucc j)
  v <- b2m-rd (%wadd t (%wadd (%wsucc j) cap))
  do b2-tput t2 k v
  jump b2-rehash f t cap t2 (%wsucc j)

-- set k to v in this map (its own layer)
fn b2-mset (mp : Word) (k : Word) (v : Word) : Word
  t <- b2m-rd mp
  nw <- b2-tput t k v
  if %weq nw #0
    ret v
  cnt <- b2m-rd (%wadd mp #1)
  do b2m-wr (%wadd mp #1) (%wsucc cnt)
  cap <- b2m-rd t
  if %wlt (%wmul (%wsucc cnt) #10) (%wmul cap #7)
    ret v
  t2 <- b2-tab (%wmul cap #2)
  do b2-rehash (toNat #4294967295) t cap t2 #0
  do b2m-wr mp t2
  ret v

-- ===========================================================================================
-- Strings: arrays of UTF-16 code units (JavaScript's strings); text from the code is UTF-8 bytes
-- ===========================================================================================

-- the code points of UTF-8 bytes
b2-cpsg : Nat → List Word → List Word
b2-cpsg zero r = nil
b2-cpsg (suc f) nil = nil
b2-cpsg (suc f) (cons b0 r) =
  if %wlt b0 #128 then cons b0 (b2-cpsg f r)
  else if %weq (%wand b0 #224) #192 then cons (%wor (%wshl (%wand b0 #31) #6) (%wand (hv2-nth #0 r) #63)) (b2-cpsg f (hv2-drop1 r))
  else if %weq (%wand b0 #240) #224 then cons (%wor (%wshl (%wand b0 #15) #12) (%wor (%wshl (%wand (hv2-nth #0 r) #63) #6) (%wand (hv2-nth #1 r) #63))) (b2-cpsg f (hv2-drop1 (hv2-drop1 r)))
  else cons (%wor (%wshl (%wand b0 #7) #18) (%wor (%wshl (%wand (hv2-nth #0 r) #63) #12) (%wor (%wshl (%wand (hv2-nth #1 r) #63) #6) (%wand (hv2-nth #2 r) #63)))) (b2-cpsg f (hv2-drop1 (hv2-drop1 (hv2-drop1 r))))

b2-cps : List Word → List Word
b2-cps s = b2-cpsg (toNat (cli-len s)) s

-- code points as UTF-16 units
b2-u16 : List Word → List Word
b2-u16 nil = nil
b2-u16 (cons c r) =
  if %wlt c #65536 then cons c (b2-u16 r)
  else (let d = %wsub c #65536 in cons (%wadd #55296 (%wshr d #10)) (cons (%wadd #56320 (%wand d #1023)) (b2-u16 r)))

-- UTF-16 units as UTF-8 bytes (a lone surrogate as the replacement character, as a write does)
b2-utf8g : Nat → List Word → List Word
b2-utf8g zero r = nil
b2-utf8g (suc f) nil = nil
b2-utf8g (suc f) (cons u r) =
  if andB (%wlt #55295 u) (%wlt u #56320) then
    (let v = hv2-nth #0 r in
     if andB (%wlt #56319 v) (%wlt v #57344)
     then list-append (h4-utf8enc (%wadd #65536 (%wor (%wshl (%wsub u #55296) #10) (%wsub v #56320)))) (b2-utf8g f (hv2-drop1 r))
     else list-append (h4-utf8enc #65533) (b2-utf8g f r))
  else if andB (%wlt #56319 u) (%wlt u #57344) then list-append (h4-utf8enc #65533) (b2-utf8g f r)
  else list-append (h4-utf8enc u) (b2-utf8g f r)

b2-utf8 : List Word → List Word
b2-utf8 s = b2-utf8g (toNat (cli-len s)) s

-- a RAM string from UTF-8 text
fn b2-str (s : List Word) : Word
  a <- b2-arrl (b2-u16 (b2-cps s))
  ret a

-- a String literal's text: an array of units, or (made by String.append on the IO lane) a rope
-- [ROPE, left, right, total] of two texts, flattened to an array the first time it is read
-- (and kept: [FWD, the array, 0, total])
b2-ROPE : Word
b2-ROPE = #4611686018427387904

b2-FWD : Word
b2-FWD = #4611686018427387905

fn b2-slen (v : Word) : Word
  h <- b2m-rd v
  if orB (%weq h b2-ROPE) (%weq h b2-FWD)
    n <- b2m-rd (%wadd v #3)
    ret n
  ret h

-- a text's units into o from off, the texts still to copy on the worklist
fnrec b2-sflat (f : Nat) (ws : List Word) (o : Word) (off : Word) : Word
  zero: ret o
  if h4-isnil ws
    ret o
  let v = hv2-nth #0 ws
  h <- b2m-rd v
  if %weq h b2-ROPE
    l <- b2m-rd (%wadd v #1)
    r <- b2m-rd (%wadd v #2)
    jump b2-sflat f (cons l (cons r (hv2-drop1 ws))) o off
  a2 <- b2m-rd (%wadd v #1)
  let arr = the Word (if %weq h b2-FWD then a2 else v)
  n <- b2m-len arr
  do b2-scopy (toNat #4294967295) arr o #0 off n
  jump b2-sflat f (hv2-drop1 ws) o (%wadd off n)

fnrec b2-scopy (f : Nat) (src : Word) (dst : Word) (j : Word) (off : Word) (n : Word) : Word
  zero: ret dst
  if %weq j n
    ret dst
  x <- b2m-at src j
  do b2m-put dst (%wadd off j) x
  jump b2-scopy f src dst (%wsucc j) off n

-- a text as an array (a rope flattened once)
fn b2-sarr (v : Word) : Word
  h <- b2m-rd v
  if %weq h b2-FWD
    a <- b2m-rd (%wadd v #1)
    ret a
  if not (%weq h b2-ROPE)
    ret v
  n <- b2m-rd (%wadd v #3)
  o <- b2-arr n
  do b2-sflat (toNat #4294967295) (cons v nil) o #0
  do b2m-wr v b2-FWD
  do b2m-wr (%wadd v #1) o
  ret o

fn b2-sarrk (k : Word) (v : Word) : Word
  if not (%weq k b2-LSTR)
    ret v
  a <- b2-sarr v
  ret a

-- a RAM string's units, and its UTF-8 bytes
fn b2-units (a0 : Word) : List Word
  a <- b2-sarr a0
  r <-[b2-dpl] b2-list a
  ret r

fn b2-bytes (a : Word) : List Word
  r <-[b2-dpl] b2-list a
  ret (b2-utf8 r)

-- the units [beg, end) of a RAM string
fnrec b2-slicel (f : Nat) (a : Word) (j : Word) (beg : Word) (acc : List Word) : List Word
  zero: ret acc
  if %wlt j (%wsucc beg)
    ret acc
  x <- b2m-at a (%wsub j #1)
  jump b2-slicel f a (%wsub j #1) beg (cons x acc)

fn b2-slice (a : Word) (beg : Word) (end : Word) : List Word
  n <- b2m-len a
  let e = the Word (if %wlt n end then n else end)
  r <-[b2-dpl] b2-slicel (toNat #4294967295) a e beg nil
  ret r

-- string equality and hashing
fnrec b2-streqg (f : Nat) (a : Word) (b : Word) (j : Word) (n : Word) : Word
  zero: ret #1
  if %weq j n
    ret #1
  x <- b2m-at a j
  y <- b2m-at b j
  if not (%weq x y)
    ret #0
  jump b2-streqg f a b (%wsucc j) n

fn b2-streq (a0 : Word) (b0 : Word) : Word
  a <- b2-sarr a0
  b <- b2-sarr b0
  n <- b2m-len a
  o <- b2m-len b
  if not (%weq n o)
    ret #0
  r <- b2-streqg (toNat #4294967295) a b #0 n
  ret r

fnrec b2-strhg (f : Nat) (a : Word) (j : Word) (n : Word) (h : Word) : Word
  zero: ret h
  if %weq j n
    ret h
  x <- b2m-at a j
  jump b2-strhg f a (%wsucc j) n (%wand (%wadd (%wmul h #31) x) #4294967295)

fn b2-strhash (a : Word) : Word
  n <- b2m-len a
  h <- b2-strhg (toNat #4294967295) a #0 n #7
  ret (%wor (%wshl h #1) #1)

-- ===========================================================================================
-- Names: interned strings. m+16 maps a string's hash to the latest id with it; m+24 is a vector
-- of [string, the previous id with the same hash]; id 0 is no name.
-- ===========================================================================================

fnrec b2-chain (f : Nat) (ids : Word) (id : Word) (s : Word) : Word
  zero: ret #0
  if %weq id #0
    ret #0
  r <- b2m-vat ids (%wsub id #1)
  t <- b2m-rd r
  e <- b2-streq t s
  if %weq e #1
    ret id
  nx <- b2m-rd (%wadd r #1)
  jump b2-chain f ids nx s

-- the id of a RAM string
fn b2-intern (s : Word) : Word
  names <- rd (b2-HNAMES M)
  ids <- rd (b2-HIDS M)
  h <- b2-strhash s
  top <- b2-mget names h
  let t0 = the Word (if %weq top hv2-none then #0 else top)
  id <- b2-chain (toNat #4294967295) ids t0 s
  if not (%weq id #0)
    ret id
  r <- b2m-alloc #2
  do b2m-wr r s
  do b2m-wr (%wadd r #1) t0
  do b2-vpush ids r
  n <- b2m-vlen ids
  do b2-mset names h n
  ret n

-- the id of UTF-8 text, and the string of an id
fn b2-nm (s : List Word) : Word
  a <- b2-str s
  r <- b2-intern a
  ret r

fn b2-nstr (id : Word) : Word
  ids <- rd (b2-HIDS M)
  r <- b2m-vat ids (%wsub id #1)
  s <- b2m-rd r
  ret s

fn b2-nbytes (id : Word) : List Word
  s <- b2-nstr id
  r <-[b2-dpl] b2-bytes s
  ret r

