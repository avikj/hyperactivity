fnrec b2-internall (f : Nat) (xs : List (List Word)) : Word
  zero: ret #0
  if h4-stknil0 xs
    ret #0
  do b2-nm (h4-tget-go #0 xs)
  jump b2-internall f (h4-tl0 xs)

h4-stknil0 : List (List Word) → Bool
h4-stknil0 nil = true
h4-stknil0 (cons x r) = false

h4-tl0 : List (List Word) → List (List Word)
h4-tl0 nil = nil
h4-tl0 (cons x r) = r

-- ===========================================================================================
-- Quantities (quant_add, quant_join, quant_dem)
-- ===========================================================================================

b2-qadd : Word → Word → Word
b2-qadd a b = if %weq a b2-NONE then b else if %weq b b2-NONE then a else b2-MANY

b2-qjoin : Word → Word → Word
b2-qjoin a b = if orB (%weq a b2-MANY) (%weq b b2-MANY) then b2-MANY else if %weq a b2-NONE then b else a

b2-qdem : Word → Word → Word
b2-qdem q qt = if %weq q b2-NONE then b2-NONE else qt

-- quant_show
b2-qshow : Word → List Word
b2-qshow q = if %weq q b2-NONE then "-" else if %weq q b2-MANY then "+" else ""

-- ===========================================================================================
-- PMap (a persistent map on numbers: [has, value, left, right], 0 the empty one)
-- ===========================================================================================

fnrec b2-pget (f : Nat) (mp : Word) (k : Word) : Word
  zero: ret hv2-none
  if %weq mp #0
    ret hv2-none
  if %weq k #0
    h <- b2m-rd mp
    if %weq h #0
      ret hv2-none
    v <- b2m-rd (%wadd mp #1)
    ret v
  let odd = %weq (%wmod k #2) #1
  nx <- b2m-rd (%wadd mp (the Word (if odd then #2 else #3)))
  jump b2-pget f nx (the Word (if odd then %wdiv (%wsub k #1) #2 else %wdiv (%wsub k #2) #2))

macro b2m-pnode (h : Word) (v : Word) (l : Word) (r : Word) : Word
  at <- b2m-alloc #4
  do b2m-wr at h
  do b2m-wr (%wadd at #1) v
  do b2m-wr (%wadd at #2) l
  do b2m-wr (%wadd at #3) r
  ret at

fnrec b2-pset (f : Nat) (mp : Word) (k : Word) (v : Word) : Word
  zero: ret mp
  h <- b2m-rd mp
  x <- b2m-rd (%wadd mp #1)
  l <- b2m-rd (%wadd mp #2)
  r <- b2m-rd (%wadd mp #3)
  let bin = not (%weq mp #0)
  let h1 = the Word (if bin then h else #0)
  let x1 = the Word (if bin then x else #0)
  let l1 = the Word (if bin then l else #0)
  let r1 = the Word (if bin then r else #0)
  if %weq k #0
    n <- b2m-pnode #1 v l1 r1
    ret n
  if %weq (%wmod k #2) #1
    l2 <- b2-pset f l1 (%wdiv (%wsub k #1) #2) v
    n <- b2m-pnode h1 x1 l2 r1
    ret n
  r2 <- b2-pset f r1 (%wdiv (%wsub k #2) #2) v
  n <- b2m-pnode h1 x1 l1 r2
  ret n

-- pmap_union with f: 0 quant_add, 1 quant_join
fnrec b2-punion (f : Nat) (a : Word) (b : Word) (md : Word) : Word
  zero: ret a
  if %weq a #0
    ret b
  if %weq b #0
    ret a
  ah <- b2m-rd a
  av <- b2m-rd (%wadd a #1)
  al <- b2m-rd (%wadd a #2)
  ar <- b2m-rd (%wadd a #3)
  bh <- b2m-rd b
  bv <- b2m-rd (%wadd b #1)
  bl <- b2m-rd (%wadd b #2)
  br <- b2m-rd (%wadd b #3)
  let h = the Word (if orB (%weq ah #1) (%weq bh #1) then #1 else #0)
  let v = the Word (if %weq ah #0 then bv else if %weq bh #0 then av else if %weq md #0 then b2-qadd av bv else b2-qjoin av bv)
  l <- b2-punion f al bl md
  r <- b2-punion f ar br md
  n <- b2m-pnode h v l r
  ret n

-- pmap_to_array: the (key, value) pairs in its order, into a vector of pairs
fnrec b2-parr (f : Nat) (mp : Word) (acc : Word) (scl : Word) (ob : Word) : Word
  zero: ret ob
  if %weq mp #0
    ret ob
  h <- b2m-rd mp
  if %weq h #1
    v <- b2m-rd (%wadd mp #1)
    do b2-vpush ob acc
    do b2-vpush ob v
  l <- b2m-rd (%wadd mp #2)
  r <- b2m-rd (%wadd mp #3)
  do b2-parr f l (%wadd acc scl) (%wmul scl #2) ob
  jump b2-parr f r (%wadd acc (%wmul scl #2)) (%wmul scl #2) ob

fn b2-pairs (mp : Word) : Word
  v <- b2-vec
  do b2-parr (toNat #64) mp #0 #1 v
  ret v

-- ===========================================================================================
-- Lists (an environment: [key, value, next], 0 the empty one)
-- ===========================================================================================

fnrec b2-lget (f : Nat) (l : Word) (k : Word) : Word
  zero: ret hv2-none
  if %weq l #0
    ret hv2-none
  x <- b2m-rd l
  if %weq x k
    v <- b2m-rd (%wadd l #1)
    ret v
  nx <- b2m-rd (%wadd l #2)
  jump b2-lget f nx k

fn b2-lset (l : Word) (k : Word) (v : Word) : Word
  at <- b2m-alloc #3
  do b2m-wr at k
  do b2m-wr (%wadd at #1) v
  do b2m-wr (%wadd at #2) l
  ret at

-- the values of a list, last pushed first (list_to_array)
fnrec b2-lvals (f : Nat) (l : Word) (acc : List Word) : List Word
  zero: ret acc
  if %weq l #0
    ret acc
  v <- b2m-rd (%wadd l #1)
  nx <- b2m-rd (%wadd l #2)
  jump b2-lvals f nx (cons v acc)

fn b2-ltoarr (l : Word) : Word
  xs <-[b2-dpl] b2-lvals (toNat #4294967295) l nil
  a <- b2-arrl (hv2-rev xs)
  ret a

-- ===========================================================================================
-- Spans, files and errors
-- ===========================================================================================

-- a file: [FILE, 0, string, namespace (a name), aliases (a map name -> name)]
-- a span: [SPAN, 0, file, beg, end]
fn b2-span (file : Word) (beg : Word) (end : Word) : Word
  s <- b2m-n3 b2-SPAN #0 file beg end
  ret s

-- a message (a STR node holding a RAM string)
fn b2-msg (s : List Word) : Word
  a <- b2-str s
  t <- b2m-n1 b2-STR #0 a
  ret t

-- raise: an Err [ERRR, 0, book, ctx, exp, obs, spn, def, nte] stored at m+8, and the failure
fn b2-raise (bok : Word) (ctx : Word) (exp : Word) (obs : Word) (spn : Word) (def : Word) (nte : Word) : Word
  at <- b2m-alloc #9
  do b2m-wr at (%wor b2-ERRR #1792)
  do b2m-wr (%wadd at #1) #0
  do b2m-wr (%wadd at #2) bok
  do b2m-wr (%wadd at #3) ctx
  do b2m-wr (%wadd at #4) exp
  do b2m-wr (%wadd at #5) obs
  do b2m-wr (%wadd at #6) spn
  do b2m-wr (%wadd at #7) def
  do b2m-wr (%wadd at #8) nte
  wr (b2-HERR M) at
  ret b2-ERR

-- raise with a message for exp (and obs a message too when given)
fn b2-fail (bok : Word) (ctx : Word) (exp : List Word) (obs : Word) (spn : Word) (def : Word) : Word
  e <- b2-msg exp
  r <- b2-raise bok ctx e obs spn def #0
  ret r

fn b2-failn (bok : Word) (ctx : Word) (exp : List Word) (obs : Word) (spn : Word) (def : Word) (nte : List Word) : Word
  e <- b2-msg exp
  n <- b2-str nte
  r <- b2-raise bok ctx e obs spn def n
  ret r

b2-dpe : Word → Bool × List Word → Word
b2-dpe m p = b2-dep m (cli-len (snd p))
