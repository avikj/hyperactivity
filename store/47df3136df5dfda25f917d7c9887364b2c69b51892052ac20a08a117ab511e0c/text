-- Bend in hyperactivity: the language of HigherOrderCO/bend (bend2/bend.ts: its parser, its
-- pattern flattener, its machine, its checker and its printer), on a flat memory of words. A term
-- is a node in the memory; a binder's body is a closure record (the TypeScript holds JavaScript
-- functions there); a share cell is a node written in place, as the TypeScript writes its object.
-- `bend FILE` prints what `bun bend2/main.ts FILE` prints: the verdict on a book with no main, the
-- error under SOME PROOFS FAIL with its excerpt and location, a value main at normal form, and an
-- IO main run on the scheduler, called by value as the JS lane is (print, write, print_err,
-- args, args_bytes, get_env, now, sleep, random_u32, spawn, channels, files, TCP and UDP; the
-- lanes' U32, Nat, F32 and String operations natively, Strings as ropes, Arrays as in-place JS
-- arrays). Process.run, Window, Audio and a test's own foreign JS do not run here (no fork or
-- exec syscall, no JS). Base is BEND_DIR's base.bend (or a second argument).
--
-- The binary is b2-c compiled; its C is made in pieces, one run each, so no run holds the whole
-- emission (lib/emit-slices):
--   n = ./hyperactive view in lib/bend.hypercubical b2-c-count       (the functions, k < n/1000)
--   ./hyperactive view in lib/bend.hypercubical b2-c-head          > bend.c
--   ./hyperactive view in lib/bend.hypercubical b2-c-protos       >> bend.c
--   ./hyperactive view in lib/bend.hypercubical "b2-c-part #k"    >> bend.c   (k = 0, 1, ..)
--   ./hyperactive view in lib/bend.hypercubical b2-c-main         >> bend.c
--   cc -O2 -o bend bend.c
import "native-opt.hypercubical"
import "hvm2.hypercubical"
import "hvm4.hypercubical"
import "emit-slices.hypercubical"

-- The sequencing deps: the memory word after a step depends on the step's value by one strict
-- operation, so a chain of n steps is a term of size n (a branch on the value would copy the rest).
b2-dep : Word → Word → Word
b2-dep m x = %wadd m (%wand x #0)

b2-dpl : Word → List Word → Word
b2-dpl m xs = b2-dep m (cli-len xs)

b2-dpb : Word → Bool → Word
b2-dpb m b = b2-dep m (if b then #1 else #0)

-- ===========================================================================================
-- The memory: a header of 512 words, then the heap (2^29 words), then the machine's frame stack
-- (2^24 words). A node is [tag | fields << 8, span, field0, field1, ..]; an array is [length,
-- item0, ..]; index 0 is no node (JavaScript's undefined and null).
-- ===========================================================================================

b2-heapb : Word → Word
b2-heapb m = %wadd m #4096

b2-stkb : Word → Word
b2-stkb m = %wadd m #4299165696

b2-size : Word
b2-size = #4433383424

b2-a : Word → Word → Word
b2-a m i = %wadd (b2-heapb m) (%wshl (%wand i #536870911) #3)

b2-sa : Word → Word → Word
b2-sa m i = %wadd (b2-stkb m) (%wshl (%wand i #16777215) #3)

-- the header: m+0 the next free heap word, m+8 the error raised (an Err record), m+16 the
-- interned names (a map), m+24 the names by id (a vector), m+32 the frame stack's top, m+40
-- RIGID (the empty book), m+48 the trampoline counter, m+56.. registers
b2-HN : Word → Word
b2-HN m = m
b2-HERR : Word → Word
b2-HERR m = %wadd m #8
b2-HNAMES : Word → Word
b2-HNAMES m = %wadd m #16
b2-HIDS : Word → Word
b2-HIDS m = %wadd m #24
b2-HSP : Word → Word
b2-HSP m = %wadd m #32
b2-HRIGID : Word → Word
b2-HRIGID m = %wadd m #40
b2-HR : Word → Word → Word
b2-HR m j = %wadd m (%wadd #64 (%wshl j #3))

-- the failure a function answers when it raised an Err (stored at m+8)
b2-ERR : Word
b2-ERR = #18446744073709551615

b2-iserr : Word → Bool
b2-iserr x = %weq x b2-ERR

