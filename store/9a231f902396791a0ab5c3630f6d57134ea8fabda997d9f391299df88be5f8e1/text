  kq_ (h4-depl mm_ (#1))
b2-nlg mm_ (suc f) s j kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (#1))) else (let a_7085 = s in let j_7086 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7085 (%wsucc j_7086))))) (λ x_7084 → let mm_7087 = b2-dep mm_ x_7084 in let c = x_7084 in if (%weq c #10) then (kq_ (h4-depl mm_7087 (#1))) else (if (orB (%weq c #32) (orB (%weq c #13) (%weq c #9))) then (b2-nlg mm_7087 f s (%wsub j #1) kq_) else (kq_ (h4-depl mm_7087 (#0))))))
