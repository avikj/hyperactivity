  kq_ (h4-depl mm_ (w))
b2-annwid mm_ (suc f) anns j n w kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (w))) else (let a_12698 = anns in let j_12699 = j in scmd (w-load ((b2-a mm_ (%wadd a_12698 (%wsucc j_12699))))) (λ x_12697 → let mm_12700 = b2-dep mm_ x_12697 in let a = x_12697 in if (%weq a #0) then (b2-annwid mm_12700 f anns (%wsucc j) n w kq_) else (let i_12702 = (%wadd a #1) in scmd (w-load ((b2-a mm_12700 i_12702))) (λ x_12701 → let mm_12703 = b2-dep mm_12700 x_12701 in let k = x_12701 in b2-nstr mm_12703 k (λ s → let mm_12704 = b2-dep mm_12703 s in let a_12706 = s in scmd (w-load ((b2-a mm_12704 a_12706))) (λ x_12705 → let mm_12707 = b2-dep mm_12704 x_12705 in let l = x_12705 in b2-annwid mm_12707 f anns (%wsucc j) n (the Word (if %wlt w l then l else w)) kq_))))))
