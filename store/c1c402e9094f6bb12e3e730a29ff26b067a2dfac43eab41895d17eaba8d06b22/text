-- Effective number of equally likely states N_eff = floor(1 / P_2) = floor(W^2 / sum w_i^2),
-- and exact integer Renyi-2 / Shannon entropy lower bound in bits: floor(log2 N_eff).
qi-neff : List (List Bool) → List Bool
qi-neff ws = fst (bin-divmod (bin-mul (qi-sum-bin ws) (qi-sum-bin ws)) (qi-sum-sq-bin ws))
