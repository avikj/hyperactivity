hy-bridge : List Word → List Word → List Word → List (List Word) → Proc W Unit
hy-bridge st m c rest =
  if h-eq c "deploy" then hy-deploy m rest else
  if h-eq c "factor" then hy-factor st m rest else
  if h-eq c "etym" then hy-runs (cons m (cons "lib/etym.hypercubical" rest)) else
  if h-eq c "chat" then hy-runs (cons m (cons "lib/chat.hypercubical" rest)) else
  if h-eq c "view" then hy-view-term m rest else
  if h-eq c "why" then hy-why st m rest else
  if h-eq c "unexplained" then hy-unexplained st m rest else
  if h-eq c "same-type" then hy-same-type st m rest else
  if h-eq c "same-text" then hy-same-text st m rest else
  if h-eq c "held-whole" then hy-held-whole st m rest else
  if h-eq c "unimported" then hy-unimported m else
  if h-eq c "foldable" then hy-foldable st m rest else
  if h-eq c "fold-safe" then hy-fold-safe st m rest else
  if h-eq c "every" then hy-every m else
  if h-eq c "server" then hy-runs (cons m (cons "lib/server.hypercubical" rest)) else
  if h-eq c "peers" then hy-peers rest else
  if h-eq c "peer-pull" then hy-peer-pull st m rest else
  if h-eq c "delegate" then hy-delegate m rest else
  if h-eq c "dht-join" then hy-dht-join st rest else
  if h-eq c "dht-provide" then hy-dht-provide st rest else
  if h-eq c "dht-find" then hy-dht-find st rest else
  if h-eq c "brunerie" then hy-brunerie m else
  if h-eq c "repl" then hy-runs (cons m (cons "lib/core.hypercubical" (list-append rest (cons "--serve" nil)))) else
  if h-eq c "library" then hy-runs (cons m (cons "lib/library.hypercubical" nil)) else ret unit
