-- Exact U(1) Gauss check on C_4 at all four vertices {0, 1, 2, 3} for neutral H_2 (protons at p1, p2).
qmol-c4-gauss-at : Nat → Nat → Nat → Nat → Nat → List BZ → Bool
qmol-c4-gauss-at p1 p2 x e1 e2 fs =
  qgm-bz-eq
    (qgm-div BZ bz-zero bz-add bz-neg x qmol-c4-edges fs)
    (qmol-charge2 BZ bz-zero bz-one bz-add bz-neg x p1 p2 e1 e2)
