b2-peek : Word → Word → (Word → Step W Word) → Step W Word
b2-peek mm_ p kq_ =
  b2-pstr mm_ p (λ s → let mm_7200 = b2-dep mm_ s in let p_7202 = p in let i_7204 = (%wadd p_7202 #1) in scmd (w-load ((b2-a mm_7200 i_7204))) (λ x_7203 → let mm_7205 = b2-dep mm_7200 x_7203 in let x_7201 = x_7203 in let i = x_7201 in b2-uat mm_7205 s i (λ c → let mm_7206 = b2-dep mm_7205 c in kq_ (h4-depl mm_7206 (c)))))
