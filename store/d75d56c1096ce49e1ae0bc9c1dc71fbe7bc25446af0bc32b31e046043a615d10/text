r4d-cancel-pm : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → R4dAb A z add neg →
  (p q m : A) → add (add p m) (add q (neg m)) ≡ add p q
r4d-cancel-pm A z add neg ab p q m =
  lor-tr A
    (add (add p m) (add q (neg m)))
    (add (add p q) (add m (neg m)))
    (add p q)
    (r4d-swap4 A z add neg ab p m q (neg m))
    (lor-tr A (add (add p q) (add m (neg m))) (add (add p q) z) (add p q)
      (cong (λ t → add (add p q) t) (r4d-inv-r A z add neg ab m))
      (r4d-zr A z add neg ab (add p q)))
