s-to-canonical : List Word → List Word
s-to-canonical req =
  h-concat (cons "HTTP/1.1 301 Moved Permanently" (cons h-crlf (cons "Location: https://" (cons s-canonical-host (cons (s-canon-path (s-req-path-any req)) (cons h-crlf (cons "Content-Length: 0" (cons h-crlf (cons "Cache-Control: no-cache" (cons h-crlf (cons "Connection: close" (cons h-crlf (cons h-crlf nil)))))))))))))
