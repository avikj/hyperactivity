h4-lsget : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
h4-lsget mm_ zero ls idx kq_ =
  kq_ (h4-depl mm_ (ls))
h4-lsget mm_ (suc f) ls idx kq_ =
  if (orB (%weq idx #0) (%weq ls #0)) then (kq_ (h4-depl mm_ (ls))) else (scmd (w-load ((h4-ha mm_ (%wadd ls #1)))) (λ x → let mm_2796 = h4-dep mm_ x in h4-lsget mm_2796 f (h4-val x) (%wsub idx #1) kq_))
