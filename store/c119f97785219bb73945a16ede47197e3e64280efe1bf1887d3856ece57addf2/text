  kq_ (h4-depl mm_ (hv2-none))
b2-lastidx mm_ (suc f) v j k kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (hv2-none))) else (let v_633 = v in let j_634 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd v_633 #2)))) (λ d_631 → let mm_635 = b2-dep mm_ d_631 in scmd (w-load ((b2-a mm_635 (%wadd d_631 (%wsucc j_634))))) (λ x_632 → let mm_636 = b2-dep mm_635 x_632 in let x = x_632 in if (%weq x k) then (kq_ (h4-depl mm_636 ((%wsub j #1)))) else (b2-lastidx mm_636 f v (%wsub j #1) k kq_))))
