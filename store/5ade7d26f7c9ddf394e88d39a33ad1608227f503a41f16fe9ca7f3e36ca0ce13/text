e-chunk-main : List (List Word) → Proc W Unit
e-chunk-main args = bind (h-read "build/etym/tmp/carry") (λ c → bind (h-read (e-nth (toNat #2) args)) (λ t →
  bind (e-open-app (e-nth (toNat #1) args)) (λ fd → bind (e-chunk fd (h-eq (e-nth zero args) "1") (list-append (e-or c) (e-or t))) (λ left →
  bind (h-write "build/etym/tmp/carry" left) (λ w → bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ x → exit (if w then #0 else #1)))))))
