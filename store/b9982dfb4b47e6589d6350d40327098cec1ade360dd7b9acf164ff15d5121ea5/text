-- Map outer variable `k - b_in` to canonical parameter index `b_in + (m - 1 - j)` under `lam-k m`
hf-canon-var : Lst Word → Word → Code → Word → Opt Code
hf-canon-var fvs m (cvar k) b =
  if %wlt k b then some (cvar k)
  else some (cvar (%wadd b (%wsub (%wsub m #1) (opt-or (w-index (%wsub k b) fvs #0) #0))))
hf-canon-var fvs m _ b = none
