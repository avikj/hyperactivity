fl-c-bench =
  fl-ln "// Generated from lib/ir/flow-lang.hypercubical (Zero-Parenthesis Valence Language + Continuous InQuery)"
  (fl-ln "#include <stdio.h>"
  (fl-ln "#include <stdint.h>"
  (fl-ln "#include <stdlib.h>"
  (fl-ln "#include <sys/time.h>"
  (fl-ln "typedef struct { uint32_t need, give; } ValMon;"
  (fl-ln "static inline ValMon vm_comp(ValMon a, ValMon b) {"
  (fl-ln "  if (a.give <= b.need) return (ValMon){ a.need + (b.need - a.give), b.give };"
  (fl-ln "  return (ValMon){ a.need, (a.give - b.need) + b.give };"
  (fl-ln "}"
  (fl-ln "static double now_s(void){ struct timeval tv; gettimeofday(&tv,NULL); return tv.tv_sec + tv.tv_usec*1e-6; }"
  (fl-ln "int main(void) {"
  (fl-ln "  const uint32_t N = 16777216u;"
  (fl-ln "  uint8_t* toks = (uint8_t*)malloc(N);"
  (fl-ln "  const uint8_t pat[8] = {0, 0, 2, 0, 1, 4, 2, 4};"
  (fl-ln "  for (uint32_t i = 0; i < N; i++) toks[i] = pat[i & 7u];"
  (fl-ln "  double t0 = now_s();"
  (fl-ln "  ValMon acc = {0u, 0u};"
  (fl-ln "  for (uint32_t i = 0; i < N; i++) {"
  (fl-ln "    uint8_t t = toks[i];"
  (fl-ln "    ValMon v = (t == 4u) ? (ValMon){0u, 0u} : (ValMon){t, 1u};"
  (fl-ln "    acc = vm_comp(acc, v);"
  (fl-ln "  }"
  (fl-ln "  double dt = now_s() - t0;"
  (fl-ln "  ValMon c0={0,0}, c1={0,0}, c2={0,0}, c3={0,0};"
  (fl-ln "  uint32_t q = N / 4u;"
  (fl-ln "  for (uint32_t i = 0; i < q; i++) {"
  (fl-ln "    uint8_t t0b=toks[i], t1b=toks[q+i], t2b=toks[2*q+i], t3b=toks[3*q+i];"
  (fl-ln "    c0 = vm_comp(c0, t0b==4u?(ValMon){0,0}:(ValMon){t0b,1});"
  (fl-ln "    c1 = vm_comp(c1, t1b==4u?(ValMon){0,0}:(ValMon){t1b,1});"
  (fl-ln "    c2 = vm_comp(c2, t2b==4u?(ValMon){0,0}:(ValMon){t2b,1});"
  (fl-ln "    c3 = vm_comp(c3, t3b==4u?(ValMon){0,0}:(ValMon){t3b,1});"
  (fl-ln "  }"
  (fl-ln "  ValMon par = vm_comp(vm_comp(c0, c1), vm_comp(c2, c3));"
  (fl-ln "  int ok = (acc.need == 0u && acc.give == (N / 8u) && par.need == acc.need && par.give == acc.give);"
  (fl-ln (list-append "  printf(" (list-append fl-q (list-append "[HX-FLOW-CPU] N=%u zero-paren tokens | queries_closed=%u | seq==4way_parallel=%d | %.2f G-tok/s (%.3f ms)" (list-append fl-esc-n (list-append fl-q ", N, acc.give, ok, (double)N/(dt*1e9), dt*1e3);")))))
  (fl-ln "  free(toks);"
  (fl-ln "  return ok ? 0 : 1;"
  (fl-ln "}" nil))))))))))))))))))))))))))))))))))))))
