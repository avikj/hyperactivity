grv-sg-cp : Nat → Nat → Nat → Nat → Nat → GrvZ
grv-sg-cp J J2 J3 J5 J6 =
  grv-z-mul (grv-z-of-nat J)
    (grv-z-mul
      (grv-z-mul (grv-z-sub-nat (plus (plus J 2) J2) J3) (grv-z-sub-nat (plus (plus J 2) J3) J2))
      (grv-z-mul (grv-z-sub-nat (plus (plus J 2) J5) J6) (grv-z-sub-nat (plus (plus J 2) J6) J5)))
