b2-nlcount : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-nlcount mm_ zero s j e cnt ls kq_ =
  kq_ (h4-depl mm_ (cnt))
b2-nlcount mm_ (suc f) s j e cnt ls kq_ =
  if (%weq j e) then (let a_13076 = cnt in let b_13077 = ls in let c_13078 = #0 in let n_13080 = #3 in scmd (w-load (mm_)) (λ at_13079 → let mm_13081 = b2-dep mm_ at_13079 in scmd (w-store (mm_13081) ((%wadd at_13079 n_13080))) (λ uu_13082 → let mm_13083 = hv2-u mm_13081 uu_13082 in let at_13075 = at_13079 in let i_13084 = at_13075 in let v_13085 = a_13076 in scmd (w-store ((b2-a mm_13083 i_13084)) (v_13085)) (λ uu_13086 → let mm_13087 = hv2-u mm_13083 uu_13086 in let i_13088 = (%wadd at_13075 #1) in let v_13089 = b_13077 in scmd (w-store ((b2-a mm_13087 i_13088)) (v_13089)) (λ uu_13090 → let mm_13091 = hv2-u mm_13087 uu_13090 in let i_13092 = (%wadd at_13075 #2) in let v_13093 = c_13078 in scmd (w-store ((b2-a mm_13091 i_13092)) (v_13093)) (λ uu_13094 → let mm_13095 = hv2-u mm_13091 uu_13094 in let r = at_13075 in kq_ (h4-depl mm_13095 (r)))))))) else (let a_13097 = s in let j_13098 = j in scmd (w-load ((b2-a mm_ (%wadd a_13097 (%wsucc j_13098))))) (λ x_13096 → let mm_13099 = b2-dep mm_ x_13096 in let c = x_13096 in if (%weq c #10) then (b2-nlcount mm_13099 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_13099 f s (%wsucc j) e cnt ls kq_)))
