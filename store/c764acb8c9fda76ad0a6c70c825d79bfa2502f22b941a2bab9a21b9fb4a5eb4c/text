e-forms : (List Word → Proc W (List ERow)) → List Word → List ERow → Proc W (List ERow)
e-forms k w nil = ret nil
e-forms k w (cons r rs) = if andB (h-not (h-null (e-rf r))) (h-not (h-eq (e-key (e-rf r)) (e-key w)))
  then bind (k (e-rf r)) (λ g → if e-nullr g then e-forms k w rs else ret {lzero} {W} g) else e-forms k w rs
