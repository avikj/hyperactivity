-- the shown names k1 .. kn of a Let, each after its quantity
b2-letks : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-letks mm_ zero ks qs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-letks mm_ (suc f) ks qs j acc kq_ =
  let a_1499 = ks in scmd (w-load ((b2-a mm_ a_1499))) (λ x_1498 → let mm_1500 = b2-dep mm_ x_1498 in let n = x_1498 in if (%weq j n) then (kq_ (h4-depl mm_1500 (acc))) else (let a_1502 = ks in let j_1503 = j in scmd (w-load ((b2-a mm_1500 (%wadd a_1502 (%wsucc j_1503))))) (λ x_1501 → let mm_1504 = b2-dep mm_1500 x_1501 in let k = x_1501 in let a_1506 = qs in let j_1507 = j in scmd (w-load ((b2-a mm_1504 (%wadd a_1506 (%wsucc j_1507))))) (λ x_1505 → let mm_1508 = b2-dep mm_1504 x_1505 in let q = x_1505 in b2-nbytes mm_1508 k (λ kb → let mm_1509 = b2-dpl mm_1508 kb in let one = list-append (b2-qshow q) kb in b2-letks mm_1509 f ks qs (%wsucc j) (the (List Word) (if %weq j #0 then one else list-append acc (cons #32 one))) kq_)))))
