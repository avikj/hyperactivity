-- the numbers as their bytes in hex (read back by e-num-onto #16 when a lookup needs them)
e-nums : Bool → List Word → List Word
e-nums syn r = if syn then list-append e-tab (list-append "#" (h-line (h-hex (h-take e-four r))))
  else list-append e-tab (list-append (h-hex (h-take e-four r)) (list-append e-tab (h-line (h-hex (h-take e-four (e-drop-n e-four r))))))
