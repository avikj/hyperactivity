b2-anynq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-anynq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-anynq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_7501 = tel in let j_7502 = j in scmd (w-load ((b2-a mm_ (%wadd a_7501 (%wsucc j_7502))))) (λ x_7500 → let mm_7503 = b2-dep mm_ x_7500 in let c = x_7500 in let i_7505 = (%wadd c #3) in scmd (w-load ((b2-a mm_7503 i_7505))) (λ x_7504 → let mm_7506 = b2-dep mm_7503 x_7504 in let vT = x_7504 in let t_7508 = vT in scmd (w-load ((b2-a mm_7506 t_7508))) (λ x_7507 → let mm_7509 = b2-dep mm_7506 x_7507 in let tg = (%wand x_7507 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_7509 (#1))) else (b2-anynq mm_7509 f tel (%wsucc j) n kq_)))))
