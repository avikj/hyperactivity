-- the sum of the vector over the lines at u
na-at : (A : Type) → (A → A → A) → A → Nat → List FaradayLine → List A → A
na-at A ad z u ls vec = case ls of
  nil → z
  cons l rest → (if eqb (fst l) u then ad (al-nth A z (snd l) vec) (na-at A ad z u rest vec)
    else (if eqb (snd l) u then ad (al-nth A z (fst l) vec) (na-at A ad z u rest vec) else na-at A ad z u rest vec))
