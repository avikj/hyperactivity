-- Checked declarative 2D Canvas IR (replaces raw HTML/JS for procedural vector graphics)
data CanvasOp
  = cv-clear (hex : List Word)
  | cv-rect (x : Word) (y : Word) (w : Word) (h : Word) (hex : List Word)
  | cv-circle (x : Word) (y : Word) (r : Word) (hex : List Word)
  | cv-line (x1 : Word) (y1 : Word) (x2 : Word) (y2 : Word) (hex : List Word)
  | cv-text (x : Word) (y : Word) (txt : List Word) (hex : List Word)
