-- a mention at the start of t: [code, term, page, transliteration, gloss] and the text after it
e-mention-in : List Word → List Word → List Word × List Word → Bool × (List (List Word) × List Word)
e-mention-in lang inner pr =
  (true , (cons lang (cons (e-text inner) (cons (e-title (e-text inner) inner) (cons (e-tr-f (list-length (fst pr)) (fst pr))
    (cons (e-join "; " (e-gl-f (list-length (fst pr)) (fst pr))) nil)))) , snd pr))
