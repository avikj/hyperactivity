d-map-branches : (Word → Word → Code) → Word → Lst (Lst (Word × Word)) → Lst (Lst (Word × Word)) → Lst Word → Word → Lst Code
d-map-branches mf d2 lnil sh2 perm c1 = lnil
d-map-branches mf d2 (lcons ks1 r1) sh2 perm c1 =
  let c2 = d-nth-w perm c1
      ks2 = d-nth-sh sh2 c2
      nf = d-len ks1
      nr = count-rec ks1
  in lcons (clams (%wadd nf nr) (ccon d2 c2 (d-map-fields mf ks1 ks2 nf nr #0 #0) lnil))
           (d-map-branches mf d2 r1 sh2 perm (%wsucc c1))
