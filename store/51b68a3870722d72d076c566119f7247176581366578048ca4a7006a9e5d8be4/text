sl-host-p2 : List Word
sl-host-p2 =
  sl-ln "    const uint32_t NBYTES = 67108864u; // 64 MiB dense technical corpus stream!"
  (sl-ln "    const uint32_t CHUNK  = 1024u;"
  (sl-ln "    const uint32_t STREAMS = NBYTES / CHUNK; // 65,536 parallel 5-modal loops!"
  (sl-ln "    id<MTLBuffer> bCorp = [dev newBufferWithLength:NBYTES options:MTLResourceStorageModeShared];"
  (sl-ln "    id<MTLBuffer> bOut  = [dev newBufferWithLength:STREAMS * sizeof(SynRes) options:MTLResourceStorageModeShared];"
  (sl-ln "    uint8_t* dst = (uint8_t*)[bCorp contents];"
  (sl-ln (list-append "    FILE* fp = fopen(cpath, " (list-append (sl-str "rb") ");"))
  (sl-ln "    size_t seed_len = 0;"
  (sl-ln "    if (fp) { seed_len = fread(dst, 1, NBYTES, fp); fclose(fp); }"
  (sl-ln "    if (seed_len == 0) { for (uint32_t i = 0; i < 4096u; i++) dst[i] = (uint8_t)(32u + (i % 95u)); seed_len = 4096u; }"
  (sl-ln "    for (size_t off = seed_len; off < NBYTES; off++) dst[off] = (uint8_t)(dst[off - seed_len] ^ ((off >> 16u) & 7u));"
  (sl-ln "    uint32_t chunk_val = CHUNK;"
  (sl-ln "    double best_dt = 1e9;"
  (sl-ln "    for (int it = 0; it < 11; it++) {"
  (sl-ln "      id<MTLCommandBuffer> cb = [q commandBuffer];"
  (sl-ln "      id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
  (sl-ln "      [enc setComputePipelineState:pso];"
  (sl-ln "      [enc setBuffer:bCorp offset:0 atIndex:0];"
  (sl-ln "      [enc setBuffer:bOut offset:0 atIndex:1];"
  (sl-ln "      [enc setBytes:&chunk_val length:sizeof(uint32_t) atIndex:2];"
  (sl-ln "      [enc dispatchThreads:MTLSizeMake(STREAMS, 1, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];"
  (sl-ln "      [enc endEncoding];"
  (sl-ln "      double t0 = now_s();"
  (sl-ln "      [cb commit]; [cb waitUntilCompleted];"
  (sl-ln "      double dt = now_s() - t0;"
  (sl-ln "      if (it > 0 && dt < best_dt) best_dt = dt;"
  (sl-ln "    }"
  (sl-ln "    SynRes* res = (SynRes*)[bOut contents];"
  (sl-ln "    uint32_t lok = 1u, aok = 1u, cok = 1u, max_r2 = 0u, thist = 0u, dig = 0u;"
  (sl-ln "    for (uint32_t i = 0u; i < STREAMS; i++) {"
  (sl-ln "      lok &= res[i].link_ok; aok &= res[i].aud_ok; cok &= res[i].cbf_ok;"
  (sl-ln "      if (res[i].max_r2 > max_r2) max_r2 = res[i].max_r2;"
  (sl-ln "      thist |= res[i].triad_hist; dig ^= res[i].digest;"
  (sl-ln "    }"
  (sl-ln "    uint32_t triads_hit = __builtin_popcount(thist & 0xFFFFFFu);"
  (sl-ln "    int ok = (lok == 1u && aok == 1u && cok == 1u && triads_hit == 24u);"
  (sl-ln (list-append "    printf(" (list-append sl-q (list-append "[HX-SYNLOOP-METAL] device=%s | tech_seed=%zuB | stream=%uB | loops=%u | triads=%u/24 | max_cbf_r2=%u/1000000 | link_ok=%u aud_ok=%u cbf_ok=%u | ok=%d | %.2f G-ticks/s (%.2f GB/s, %.3f ms)" (list-append sl-esc-n (list-append sl-q ", [[dev name] UTF8String], seed_len, NBYTES, STREAMS, triads_hit, max_r2, lok, aok, cok, ok, (double)NBYTES/(best_dt*1e9), (double)NBYTES/(best_dt*1e9), best_dt*1e3);")))))
  (sl-ln "    return ok ? 0 : 1;"
  (sl-ln "  }"
  (sl-ln "}" nil)))))))))))))))))))))))))))))))))))))))
