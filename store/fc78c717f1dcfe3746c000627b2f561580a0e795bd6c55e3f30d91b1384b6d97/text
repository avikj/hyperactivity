b2-msg : Word → List Word → (Word → Step W Word) → Step W Word
b2-msg mm_ s kq_ =
  b2-str mm_ s (λ a → let mm_587 = b2-dep mm_ a in let tg_589 = b2-STR in let s_590 = #0 in let a_591 = a in let n_593 = #3 in scmd (w-load (mm_587)) (λ at_592 → let mm_594 = b2-dep mm_587 at_592 in scmd (w-store (mm_594) ((%wadd at_592 n_593))) (λ uu_595 → let mm_596 = hv2-u mm_594 uu_595 in let at_588 = at_592 in let i_597 = at_588 in let v_598 = (%wor tg_589 #256) in scmd (w-store ((b2-a mm_596 i_597)) (v_598)) (λ uu_599 → let mm_600 = hv2-u mm_596 uu_599 in let i_601 = (%wadd at_588 #1) in let v_602 = s_590 in scmd (w-store ((b2-a mm_600 i_601)) (v_602)) (λ uu_603 → let mm_604 = hv2-u mm_600 uu_603 in let i_605 = (%wadd at_588 #2) in let v_606 = a_591 in scmd (w-store ((b2-a mm_604 i_605)) (v_606)) (λ uu_607 → let mm_608 = hv2-u mm_604 uu_607 in let t = at_588 in kq_ (h4-depl mm_608 (t))))))))
