sfc-purity3u-in : SfcM3U → Bool
sfc-purity3u-in w =
  sfc-force-m3u Bool (sfc-mm3u w w) (λ w2 →
  sfc-force-bin Bool (sfc-tr3u (sfc-mm3u w2 w2)) (λ tr4 →
  sfc-force-bin Bool (sfc-tr3u w2) (λ t2 →
  sfc-force-bin Bool (sfc-bmul t2 t2) (λ tr2sq →
    both (sfc-bq-pos-lt (bq-make true bin-one (bin-of-nat 3)) (true , (tr4 , tr2sq)))
         (sfc-bq-pos-lt (true , (tr4 , tr2sq)) (bq-make true bin-one bin-two))))))
