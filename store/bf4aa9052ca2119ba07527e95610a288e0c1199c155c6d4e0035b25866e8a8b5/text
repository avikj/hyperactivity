-- a Nat term's number through up to 64 Succ: a literal or Zero at the end, its cells followed
b2-natnum : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-natnum mm_ zero t acc kq_ =
  kq_ (h4-depl mm_ (b2-NNONE))
b2-natnum mm_ (suc f) t acc kq_ =
  b2-strip mm_ t (λ w → let mm_2530 = b2-dep mm_ w in let t_2532 = w in scmd (w-load ((b2-a mm_2530 t_2532))) (λ x_2531 → let mm_2533 = b2-dep mm_2530 x_2531 in let tg = (%wand x_2531 #255) in let t_2535 = w in let j_2536 = #0 in scmd (w-load ((b2-a mm_2533 (%wadd t_2535 (%wadd #2 j_2536))))) (λ x_2534 → let mm_2537 = b2-dep mm_2533 x_2534 in let lk = x_2534 in let t_2539 = w in let j_2540 = #1 in scmd (w-load ((b2-a mm_2537 (%wadd t_2539 (%wadd #2 j_2540))))) (λ x_2538 → let mm_2541 = b2-dep mm_2537 x_2538 in let v = x_2538 in if (andB (%weq tg b2-LIT) (%weq lk b2-LNAT)) then (kq_ (h4-depl mm_2541 ((%wadd acc v)))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NZero)) then (kq_ (h4-depl mm_2541 (acc))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NSucc)) then (let a_2543 = v in let j_2544 = #0 in scmd (w-load ((b2-a mm_2541 (%wadd a_2543 (%wsucc j_2544))))) (λ x_2542 → let mm_2545 = b2-dep mm_2541 x_2542 in let x = x_2542 in b2-natnum mm_2545 f x (%wsucc acc) kq_)) else (kq_ (h4-depl mm_2541 (b2-NNONE)))))))))
