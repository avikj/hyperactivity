h4-strbytes : Word → Nat → Word → List Word → (List Word → Step W Word) → Step W Word
h4-strbytes m zero x acc k =
  k (h4-depl m (acc))
h4-strbytes m (suc f) x acc k =
  if (%weq (h4-tag x) h4-C02) then (scmd (w-load ((h4-ha m (h4-val x)))) (λ h → let m2801 = h4-dep m h in scmd (w-load ((h4-ha m2801 (h4-val h)))) (λ c → let m2802 = h4-dep m2801 c in scmd (w-load ((h4-ha m2802 (%wadd (h4-val x) #1)))) (λ nx → let m2803 = h4-dep m2802 nx in h4-strbytes m2803 f nx (list-append acc (h4-esc (h4-val c) #1)) k)))) else (k (h4-depl m (acc)))
