-- THEOREM 1: UNIVERSAL 100.00% FOUNDER EQUITY INVARIANT ACROSS ALL REVENUE EPOCHS!
tr-thm-zero-dilution : (revs : List Word) → (tw jb : Word) →
  tr-equity (tr-credit-seq revs (mk-tr-state #10000 tw jb)) ≡ #10000
tr-thm-zero-dilution nil         tw jb = refl
tr-thm-zero-dilution (cons w ws) tw jb =
  tr-thm-zero-dilution ws (%wadd tw w) (%wadd jb #1)
