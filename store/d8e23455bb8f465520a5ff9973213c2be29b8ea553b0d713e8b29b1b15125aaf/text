-- THEOREM 3 (`refl`): STRICT 3-TONE `#000000 / #ffffff / #ff0a94` PALETTE (ZERO RAINBOW HEXES):
cl-thm-strict-palette :
  andB (cl-contains "#ff0a94" cl-collablink-html)
  (andB (h-not (cl-contains "#18e68c" cl-collablink-html))
  (andB (h-not (cl-contains "#ffd400" cl-collablink-html))
  (andB (h-not (cl-contains "#4da3ff" cl-collablink-html))
        (h-not (cl-contains "#00e5ff" cl-collablink-html))))) ≡ true
cl-thm-strict-palette = refl
