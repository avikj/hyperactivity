-- the address a port of a definition is placed by (the free-stack entries a call took), and the
-- placed port: nodes and variables by the tables, every other port as it is
hr-cd-ta : Word → Word → Word → Word → Word
hr-cd-ta m nb vb p =
  if hv2-isvar p then hr-fva m (%wadd vb (hv2-val p))
  else hr-fna m (%wadd nb (if hv2-isnode p then hv2-val p else #0))
