-- Preset 2: Cyber Industrial (112 BPM dark half-time stomp + cubic wavefolder WASM)
daw-industrial : OsEffect
daw-industrial = eff-daw (daw-all (
  cons (daw-bpm #112) (
  cons (daw-loop #0 #4) (
  cons (daw-grid #1) (
  cons (daw-patch #0 "bass" #38 #36 #38 #28) (
  cons (daw-patch #1 "pad"  #28 #24 #18 #32) (
  cons (daw-patch #3 "lead" #72 #40 #28 #85) (
  cons (daw-mix #0 #94 #8  #6) (
  cons (daw-mix #2 #95 #22 #8) (
  cons (daw-wasm "mul (div (add in (mul p1 (mul (mul in in) in))) (add 1.0 (abs (mul p1 (mul in in))))) p2") (
  cons (daw-play true) nil)))))))))))
