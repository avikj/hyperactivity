-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_8283 = tel in let j_8284 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_8283 (%wsucc j_8284))))) (λ x_8282 → let mm_8285 = b2-dep mm_ x_8282 in let c = x_8282 in let i_8287 = c in scmd (w-load ((b2-a mm_8285 i_8287))) (λ x_8286 → let mm_8288 = b2-dep mm_8285 x_8286 in let q = x_8286 in let i_8290 = (%wadd c #1) in scmd (w-load ((b2-a mm_8288 i_8290))) (λ x_8289 → let mm_8291 = b2-dep mm_8288 x_8289 in let k = x_8289 in let i_8293 = (%wadd c #2) in scmd (w-load ((b2-a mm_8291 i_8293))) (λ x_8292 → let mm_8294 = b2-dep mm_8291 x_8292 in let i = x_8292 in let i_8296 = (%wadd c #3) in scmd (w-load ((b2-a mm_8294 i_8296))) (λ x_8295 → let mm_8297 = b2-dep mm_8294 x_8295 in let vT = x_8295 in let i_8299 = (%wadd c #4) in scmd (w-load ((b2-a mm_8297 i_8299))) (λ x_8298 → let mm_8300 = b2-dep mm_8297 x_8298 in let s = x_8298 in b2-All mm_8300 q k i vT e s (λ a → let mm_8301 = b2-dep mm_8300 a in b2-telebindg mm_8301 f tel (%wsub j #1) a kq_))))))))
