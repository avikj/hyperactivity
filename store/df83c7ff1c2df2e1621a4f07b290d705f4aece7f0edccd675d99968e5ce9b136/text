-- One term of Racah's rational sum at t (a1..a4, b1..b3 already halved).
sf-racah-term : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-racah-term a1 a2 a3 a4 b1 b2 b3 t = bq-make (not (odd t))
  (sf-bfact (suc t))
  (bin-mul
    (bin-mul (sf-bfact (monus t a1)) (sf-bfact (monus t a2)))
    (bin-mul
      (bin-mul (sf-bfact (monus t a3)) (sf-bfact (monus t a4)))
      (bin-mul (sf-bfact (monus b1 t)) (bin-mul (sf-bfact (monus b2 t)) (sf-bfact (monus b3 t))))))
