sc-hop-delta-ok : Nat → Bool → List BZ → List BZ → Bool
sc-hop-delta-ok k plus1 fa fb = case fa of
  nil → false
  cons a ar → case fb of
    nil → false
    cons b br → case k of
      zero → both (qgm-bz-eq (if plus1 then bz-add a bz-one else qmol-bz-sub a bz-one) b) (qgm-vec-eq ar br)
      suc m → both (qgm-bz-eq a b) (sc-hop-delta-ok m plus1 ar br)
