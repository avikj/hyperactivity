-- Single-pass structural O(k) unsigned binary comparison (0 = lt, 1 = eq, 2 = gt):
sc-bin-cmp : List Bool → List Bool → Nat
sc-bin-cmp a b = case a of
  nil → if bin-zero b then 1 else 0
  cons ba ar → case b of
    nil → if both (not ba) (bin-zero ar) then 1 else 2
    cons bb br →
      (λ c → if eqb c 1 then (if bit-eq ba bb then 1 else (if bb then 0 else 2)) else c)
      (sc-bin-cmp ar br)
