-- Exact Hund's First Rule: unpaired electrons in a subshell with l and e electrons
-- half = 2*l + 1: if e <= half -> e unpaired; else -> 2*half - e unpaired!
pt-hund-unpaired-shell : Word → Word → Word
pt-hund-unpaired-shell l e =
  let half = %wadd (%wmul #2 l) #1
      cap  = %wmul #2 half
  in if pt-le e half then e else %wsub cap e
