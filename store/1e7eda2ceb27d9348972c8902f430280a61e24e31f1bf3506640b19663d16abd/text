b2-namelist mm_ (suc f) v j n acc kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (acc))) else (let v_14500 = v in let j_14501 = j in scmd (w-load ((b2-a mm_ (%wadd v_14500 #2)))) (λ d_14498 → let mm_14502 = b2-dep mm_ d_14498 in scmd (w-load ((b2-a mm_14502 (%wadd d_14498 (%wsucc j_14501))))) (λ x_14499 → let mm_14503 = b2-dep mm_14502 x_14499 in let k = x_14499 in b2-namekey mm_14503 k (λ kb → let mm_14504 = b2-dpl mm_14503 kb in b2-namelist mm_14504 f v (%wsucc j) n (the (List Word) (if %weq j #0 then kb else list-append acc (list-append ", " kb))) kq_))))
