ue-settle-split : Word → Word → Word → Word → Word → Word × (Word × Word)
ue-settle-split pElast qElast xBase yPhys muTau =
  if %wlt xBase yPhys
  then (yPhys , (#0 , #0))
  else
    let pStar = ue-kkt-price pElast qElast xBase yPhys muTau
        prof  = %wsub pStar yPhys
        saved = %wsub xBase pStar
    in (yPhys , (prof , saved))
