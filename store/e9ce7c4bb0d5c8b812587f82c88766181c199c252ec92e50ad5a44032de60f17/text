b2-failout : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-failout mm_ seen base kq_ =
  scmd (w-load ((b2-HERR mm_))) (λ e → let mm_15289 = b2-dep mm_ e in b2-errshow mm_15289 e (λ es → let mm_15290 = b2-dpl mm_15289 es in b2-location mm_15290 e seen base (λ lc → let mm_15291 = b2-dpl mm_15290 lc in scmd ((w-fd-write #2 (list-append "SOME PROOFS FAIL" (cons #10 (list-append es (list-append lc (cons #10 nil))))))) (λ w → let mm_15292 = b2-dep mm_15291 w in kq_ (h4-depl mm_15292 (#1))))))
