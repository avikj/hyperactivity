-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13681 = seen in let j_13682 = j in scmd (w-load ((b2-a mm_ (%wadd v_13681 #2)))) (λ d_13679 → let mm_13683 = b2-dep mm_ d_13679 in scmd (w-load ((b2-a mm_13683 (%wadd d_13679 (%wsucc j_13682))))) (λ x_13680 → let mm_13684 = b2-dep mm_13683 x_13680 in let e = x_13680 in let i_13686 = e in scmd (w-load ((b2-a mm_13684 i_13686))) (λ x_13685 → let mm_13687 = b2-dep mm_13684 x_13685 in let x = x_13685 in if (%weq x p) then (kq_ (h4-depl mm_13687 (e))) else (b2-seenat mm_13687 f seen p (%wsucc j) n kq_)))))
