-- the language name marked just before a mention, if any (\x01 name \x01 and only whitespace after)
e-etyl-name : List Word → Sum Unit (List Word)
e-etyl-name before = if andB (weq (e-head (e-dropws (h-rev before nil))) #1) (h-infix (cons #1 nil) (h-tail (e-dropws (h-rev before nil))))
  then inr (h-rev (e-upto-c #1 (h-tail (e-dropws (h-rev before nil)))) nil) else inl unit
