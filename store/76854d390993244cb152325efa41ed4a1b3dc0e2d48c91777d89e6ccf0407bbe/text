tc-is-k4-hop : QgmState → QgmState → Bool
tc-is-k4-hop a b =
  if tc-k4-hop-edge 0 0 1 a b then true
  else (if tc-k4-hop-edge 1 0 2 a b then true
        else (if tc-k4-hop-edge 2 0 3 a b then true
              else (if tc-k4-hop-edge 3 1 2 a b then true
                    else (if tc-k4-hop-edge 4 2 3 a b then true
                          else tc-k4-hop-edge 5 3 1 a b))))
