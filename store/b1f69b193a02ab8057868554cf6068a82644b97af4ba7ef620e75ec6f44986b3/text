-- Exact purity growth under coarse-graining [4, 2, 1] -> [4, 3]:
--   P_2([4, 2, 1]) = 21/49 = 3/7 < 25/49 = P_2([4, 3])!
qt-coarse-grain-boltz : both
  (qt-bq-eq (qi-purity (cons qt-w4 (cons qt-w2 (cons qt-w1 nil)))) (qt-q 3 7))
  (qt-bq-eq (qi-purity (cons qt-w4 (cons (bin-of-nat 3) nil))) (qt-q 25 49)) ≡ true
qt-coarse-grain-boltz = refl
