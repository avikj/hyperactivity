rxn-dpo-step : (A : Type) → (A → A → A) → (A → A) → List A → List A → List A → List A
rxn-dpo-step A add neg g l r = case g of
  nil → nil
  cons gx gr → case l of
    nil → cons gx gr
    cons lx lr → case r of
      nil → cons gx gr
      cons rx rr → cons (add gx (add rx (neg lx))) (rxn-dpo-step A add neg gr lr rr)
