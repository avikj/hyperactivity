-- an argument an intrinsic may read: a literal or a constructor (anything else is stuck, and
-- the definition's own match decides, as it would without the intrinsic)
-- an intrinsic's argument as it stands: a computed cell's value, 0 for a cell not yet
-- evaluated, anything else itself
b2-ipeek : Word → Word → (Word → Step W Word) → Step W Word
b2-ipeek mm_ x kq_ =
  let t_2820 = x in scmd (w-load ((b2-a mm_ t_2820))) (λ x_2819 → let mm_2821 = b2-dep mm_ x_2819 in let tg = (%wand x_2819 #255) in let t_2823 = x in let j_2824 = #1 in scmd (w-load ((b2-a mm_2821 (%wadd t_2823 (%wadd #2 j_2824))))) (λ x_2822 → let mm_2825 = b2-dep mm_2821 x_2822 in let i = x_2822 in if (andB (%weq tg b2-VAR) (%weq i b2-M1)) then (kq_ (h4-depl mm_2825 (#0))) else (b2-strip mm_2825 x (λ r → let mm_2826 = b2-dep mm_2825 r in kq_ (h4-depl mm_2826 (r))))))
