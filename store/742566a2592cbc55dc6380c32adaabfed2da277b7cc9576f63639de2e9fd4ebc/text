r4d-side-boundary : (A : Type) → (A → A → A) → (A → A) →
  A × (A × A) → A × (A × A) → A × (A × A) → A → A → A → A
r4d-side-boundary A add neg r0 r1 r2 u0 u1 u2 =
  add (add (r4d-sum3 A add r0) (add u0 (neg u1)))
      (add (add (r4d-sum3 A add r1) (add u1 (neg u2)))
           (add (r4d-sum3 A add r2) (add u2 (neg u0))))
