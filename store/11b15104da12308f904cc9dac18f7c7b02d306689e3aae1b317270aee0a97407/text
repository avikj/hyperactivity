hf-eq-at : Nat → Code → Code → Bool
hf-eq-at zero _ _ = false
hf-eq-at (suc n) (cvar a) (cvar b) = %weq a b
hf-eq-at (suc n) (cglob a) (cglob b) = %weq a b
hf-eq-at (suc n) (clam a) (clam b) = hf-eq-at n a b
hf-eq-at (suc n) (cdlam a) (cdlam b) = hf-eq-at n a b
hf-eq-at (suc n) (cplam a) (cplam b) = hf-eq-at n a b
hf-eq-at (suc n) (cforall a) (cforall b) = hf-eq-at n a b
hf-eq-at (suc n) (capp f1 a1) (capp f2 a2) = c-and (hf-eq-at n f1 f2) (hf-eq-at n a1 a2)
hf-eq-at (suc n) (cpair a1 b1) (cpair a2 b2) = c-and (hf-eq-at n a1 a2) (hf-eq-at n b1 b2)
hf-eq-at (suc n) (cfst a) (cfst b) = hf-eq-at n a b
hf-eq-at (suc n) (csnd a) (csnd b) = hf-eq-at n a b
hf-eq-at (suc n) (clet v1 b1) (clet v2 b2) = c-and (hf-eq-at n v1 v2) (hf-eq-at n b1 b2)
hf-eq-at (suc n) (cann t1 T1) (cann t2 T2) = c-and (hf-eq-at n t1 t2) (hf-eq-at n T1 T2)
hf-eq-at (suc n) (cpi m1 a1 b1) (cpi m2 a2 b2) = c-and (%weq m1 m2) (c-and (hf-eq-at n a1 a2) (hf-eq-at n b1 b2))
hf-eq-at (suc n) (csigma a1 b1) (csigma a2 b2) = c-and (hf-eq-at n a1 a2) (hf-eq-at n b1 b2)
hf-eq-at (suc n) (cpathp A1 x1 y1) (cpathp A2 x2 y2) = c-and (hf-eq-at n A1 A2) (c-and (hf-eq-at n x1 x2) (hf-eq-at n y1 y2))
hf-eq-at (suc n) (cpapp p1 r1) (cpapp p2 r2) = c-and (hf-eq-at n p1 p2) (hf-eq-at n r1 r2)
hf-eq-at (suc n) (cdata d1 p1) (cdata d2 p2) = c-and (%weq d1 d2) (hf-eq-l (hf-eq-at n) p1 p2)
hf-eq-at (suc n) (ccon d1 c1 f1 s1) (ccon d2 c2 f2 s2) = c-and (%weq d1 d2) (c-and (%weq c1 c2) (c-and (hf-eq-l (hf-eq-at n) f1 f2) (hf-eq-l (hf-eq-at n) s1 s2)))
hf-eq-at (suc n) (ccase d1 B1 x1) (ccase d2 B2 x2) = c-and (%weq d1 d2) (c-and (hf-eq-l (hf-eq-at n) B1 B2) (hf-eq-at n x1 x2))
hf-eq-at (suc n) (celim d1 P1 B1 x1) (celim d2 P2 B2 x2) = c-and (%weq d1 d2) (c-and (hf-eq-at n P1 P2) (c-and (hf-eq-l (hf-eq-at n) B1 B2) (hf-eq-at n x1 x2)))
hf-eq-at (suc n) (cforce a) (cforce b) = hf-eq-at n a b
hf-eq-at (suc n) (cthunk a) (cthunk b) = hf-eq-at n a b
hf-eq-at (suc n) (cwlit a) (cwlit b) = %weq a b
hf-eq-at (suc n) (cwsucc a) (cwsucc b) = hf-eq-at n a b
hf-eq-at (suc n) (cwop o1 a1 b1) (cwop o2 a2 b2) = c-and (%weq o1 o2) (c-and (hf-eq-at n a1 a2) (hf-eq-at n b1 b2))
hf-eq-at (suc n) (cprim k1 a1) (cprim k2 a2) = c-and (%weq k1 k2) (hf-eq-l (hf-eq-at n) a1 a2)
hf-eq-at (suc n) (cplit k1 x1) (cplit k2 x2) = c-and (%weq k1 k2) (%weq x1 x2)
hf-eq-at (suc n) (cpty k1 x1) (cpty k2 x2) = c-and (%weq k1 k2) (hf-eq-at n x1 x2)
hf-eq-at (suc n) (cuniv a) (cuniv b) = hf-eq-at n a b
hf-eq-at (suc n) cword cword = true
hf-eq-at (suc n) clzero clzero = true
hf-eq-at (suc n) (clsuc a) (clsuc b) = hf-eq-at n a b
hf-eq-at (suc n) (clmax a1 b1) (clmax a2 b2) = c-and (hf-eq-at n a1 a2) (hf-eq-at n b1 b2)
hf-eq-at (suc n) _ _ = false
