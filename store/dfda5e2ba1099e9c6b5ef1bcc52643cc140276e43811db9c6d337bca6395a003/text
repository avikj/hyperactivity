emg-star-k4-ok : BZ → BZ → BZ → BZ → BZ → Bool
emg-star-k4-ok a0 a1 a2 a3 b =
  (λ s4 lhs rhs → h3d-bz-eq lhs rhs)
  (bz-add (bz-add a0 a1) (bz-add a2 a3))
  (bz-mul (sc-p (bin-pow2 2))
    (bz-add (bz-add (emg-bz-sq (qmol-bz-sub a0 b)) (emg-bz-sq (qmol-bz-sub a1 b)))
            (bz-add (emg-bz-sq (qmol-bz-sub a2 b)) (emg-bz-sq (qmol-bz-sub a3 b)))))
  (bz-add
    (emg-bz-sq (qmol-bz-sub (bz-mul (sc-p (bin-pow2 2)) b) (bz-add (bz-add a0 a1) (bz-add a2 a3))))
    (bz-add
      (bz-add (emg-bz-sq (qmol-bz-sub a0 a1)) (emg-bz-sq (qmol-bz-sub a0 a2)))
      (bz-add (bz-add (emg-bz-sq (qmol-bz-sub a0 a3)) (emg-bz-sq (qmol-bz-sub a1 a2)))
              (bz-add (emg-bz-sq (qmol-bz-sub a1 a3)) (emg-bz-sq (qmol-bz-sub a2 a3))))))
