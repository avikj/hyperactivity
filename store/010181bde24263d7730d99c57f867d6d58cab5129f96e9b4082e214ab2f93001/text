-- 1. Alpoge-Sernau (`New.grh` in `Main.lean:174`):
--    Putative off-line zero `Re(rho) > 1/2` requires Landau violation (`~one_sided_bound`)
--    simultaneously with `star_inequality` + `isPolar` window shift (`one_sided_bound`)!
ga-alpo-offline-bad : GaGuard
ga-alpo-offline-bad =
  ga-ite (ga-v zero)
    (ga-ite (ga-v (suc zero))
      (ga-and (ga-v (suc (suc zero))) (ga-not (ga-v (suc (suc zero)))))
      (ga-and (ga-v (suc zero)) (ga-not (ga-v (suc zero)))))
    (ga-and (ga-v zero) (ga-not (ga-v zero)))
