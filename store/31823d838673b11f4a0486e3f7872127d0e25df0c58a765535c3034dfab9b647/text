usf-doc-wrap : List Word → UsfNode → List Word
usf-doc-wrap bodyCls spec =
  usf-ln "<!doctype html><html lang='en'><head><meta charset='utf-8'>" (
  usf-ln "<meta name='viewport' content='width=device-width,initial-scale=1'>" (
  usf-ln "<title>hyperactivity — Hyperactive Labs</title>" (
  usf-ln "<meta name='description' content='Cubical type theory and interaction-net reduction in one content-addressed store, compiled directly to machine code, WebAssembly, GPU kernels, and silicon.'>" (
  usf-ln "<link rel='icon' href='/favicon.svg' type='image/svg+xml'><style>" (
  list-append usf-css-all (
  usf-ln (list-append "</style></head><body" (list-append bodyCls ">")) (
  list-append (usf-emit-node (usf-superopt spec))
  (list-append usf-js-all "</body></html>"))))))))
