e-chain-of : List (List (List Word)) → Bool → Bool → List (List Word × Word) → List (List (List Word))
e-chain-of found seen active nil = nil
e-chain-of found seen active (cons b r) =
  e-chain-put (e-here-of found seen active (fst b) (snd b)) (e-chain-of found true (fst (e-here-of found seen active (fst b) (snd b))) r)
