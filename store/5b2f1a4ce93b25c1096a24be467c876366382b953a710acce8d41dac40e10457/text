-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7692 = tel in let j_7693 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7692 (%wsucc j_7693))))) (λ x_7691 → let mm_7694 = b2-dep mm_ x_7691 in let c = x_7691 in let i_7696 = c in scmd (w-load ((b2-a mm_7694 i_7696))) (λ x_7695 → let mm_7697 = b2-dep mm_7694 x_7695 in let q = x_7695 in let i_7699 = (%wadd c #1) in scmd (w-load ((b2-a mm_7697 i_7699))) (λ x_7698 → let mm_7700 = b2-dep mm_7697 x_7698 in let k = x_7698 in let i_7702 = (%wadd c #2) in scmd (w-load ((b2-a mm_7700 i_7702))) (λ x_7701 → let mm_7703 = b2-dep mm_7700 x_7701 in let i = x_7701 in let i_7705 = (%wadd c #3) in scmd (w-load ((b2-a mm_7703 i_7705))) (λ x_7704 → let mm_7706 = b2-dep mm_7703 x_7704 in let vT = x_7704 in let i_7708 = (%wadd c #4) in scmd (w-load ((b2-a mm_7706 i_7708))) (λ x_7707 → let mm_7709 = b2-dep mm_7706 x_7707 in let s = x_7707 in b2-All mm_7709 q k i vT e s (λ a → let mm_7710 = b2-dep mm_7709 a in b2-telebindg mm_7710 f tel (%wsub j #1) a kq_))))))))
