b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10141 = xs in scmd (w-load ((b2-a mm_ a_10141))) (λ x_10140 → let mm_10142 = b2-dep mm_ x_10140 in let n = x_10140 in if (%weq j n) then (kq_ (h4-depl mm_10142 (h))) else (let a_10144 = xs in let j_10145 = j in scmd (w-load ((b2-a mm_10142 (%wadd a_10144 (%wsucc j_10145))))) (λ x_10143 → let mm_10146 = b2-dep mm_10142 x_10143 in let x = x_10143 in b2-tapp mm_10146 bk h x #0 (λ h2 → let mm_10147 = b2-dep mm_10146 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10147 b2-ERR)) else (b2-applyall mm_10147 f bk h2 xs (%wsucc j) kq_)))))
