h4-strbytes : Word → Nat → Word → List Word → (List Word → Step W Word) → Step W Word
h4-strbytes mm_ zero x acc kq_ =
  kq_ (h4-depl mm_ (acc))
h4-strbytes mm_ (suc f) x acc kq_ =
  if (%weq (h4-tag x) h4-C02) then (scmd (w-load ((h4-ha mm_ (h4-val x)))) (λ h → let mm_2803 = h4-dep mm_ h in scmd (w-load ((h4-ha mm_2803 (h4-val h)))) (λ c → let mm_2804 = h4-dep mm_2803 c in scmd (w-load ((h4-ha mm_2804 (%wadd (h4-val x) #1)))) (λ nx → let mm_2805 = h4-dep mm_2804 nx in h4-strbytes mm_2805 f nx (list-append acc (h4-esc (h4-val c) #1)) kq_)))) else (kq_ (h4-depl mm_ (acc)))
