-- Search for an 8-bit target with the given remaining NAND2 gate budget (up to six
-- in total). The bank holds nw wires, starting with A, B and C. Append each gate
-- to the packed program at shift. Return (program + 1, candidates examined) on
-- success, or (0, candidates examined) on a miss.
-- With only primary inputs, the final gate can use any unordered pair, including
-- ties. Otherwise it must use the newest gate in a minimum circuit, since an
-- unused penultimate gate could be removed.
hs-dfs : Nat → Word → Word → Word → Word → Word → Word × Word
hs-dfs zero target bank nw shift prog = (#0 , #0)
hs-dfs (suc zero) target bank nw shift prog =
  let last = %wsub nw #1
      first = if %weq nw #3 then #0 else last
  in %welimP (λ _ → Word × Word) (%wsub nw first) (#0 , #0) (λ dj found →
       if %wlt #0 (fst found) then found
       else
         let j = %wadd first dj
             wj = hs-get bank j
         in %welimP (λ _ → Word × Word) (%wsucc j) found (λ i st1 →
              if %wlt #0 (fst st1) then st1
              else
                let t = hs-nand (hs-get bank i) wj
                    nc = %wsucc (snd st1)
                in if %weq t target then
                     (%wsucc (%wor prog (%wshl (%wor (%wshl i #3) j) shift)) , nc)
                   else (#0 , nc)))
hs-dfs (suc (suc d)) target bank nw shift prog =
  %welimP (λ _ → Word × Word) nw (#0 , #0) (λ i st0 →
    if %wlt #0 (fst st0) then st0
    else
      let wi = hs-get bank i
      in %welimP (λ _ → Word × Word) (%wsub nw i) st0 (λ dj st1 →
           if %wlt #0 (fst st1) then st1
           else
             let j = %wadd i dj
                 t = hs-nand wi (hs-get bank j)
                 nc = %wsucc (snd st1)
             in if %weq t #0 then (#0 , nc)
                else if %weq t #255 then (#0 , nc)
                else if %weq (hs-has bank nw t) #1 then (#0 , nc)
                else
                  let g = %wor (%wshl i #3) j
                      sub = hs-dfs (suc d) target (hs-set bank nw t) (%wsucc nw) (%wadd shift #6) (%wor prog (%wshl g shift))
                  in (fst sub , %wadd nc (snd sub))))
