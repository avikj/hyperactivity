sc-certify-ss2 : List QmolState → Bool
sc-certify-ss2 bss =
  (λ m39 ts1 →
    if sc-z2-check-rows zero m39 m39 ts1
    then
      ((λ me20 mo19 →
        both
          (if sc-z2-check-rows zero me20 me20 sc-t2-ev1
           then both (sc-rump-pd ((sc-o (sc-o (sc-o (sc-o (sc-o (sc-o (sc-o (sc-o (sc-o bin-one)))))))))) (sc-proj-mat me20 (sc-build-even zero sc-t2-ev1)) sc-L-ee)
                     (sc-rump-pd ((sc-o (sc-o bin-one))) (sc-proj-mat me20 (sc-build-odd  zero sc-t2-ev1)) sc-L-eo)
           else false)
          (if sc-z2-check-rows zero mo19 mo19 sc-t2-od1
           then both (sc-rump-pd ((sc-o (sc-o (sc-o bin-one)))) (sc-proj-mat mo19 (sc-build-even zero sc-t2-od1)) sc-L-oe)
                     (sc-rump-pd ((sc-o (sc-o bin-one))) (sc-proj-mat mo19 (sc-build-odd  zero sc-t2-od1)) sc-L-oo)
           else false))
       (sc-proj-mat m39 (sc-build-even zero ts1))
       (sc-proj-mat m39 (sc-build-odd  zero ts1)))
    else false)
  (sc-shift-mat false (sc-p (sc-i bin-one)) (sc-p (bin-pow2 3)) bss)
  (sc-build-ts-tau1 bss bss)
