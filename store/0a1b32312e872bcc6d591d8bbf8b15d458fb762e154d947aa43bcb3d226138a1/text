qv-4x4-det-odd : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → QvRing A z add mul neg →
  (s1 s2 s3 : A) → add (mul s3 (add s1 s2)) (neg (mul s3 s2)) ≡ mul s3 s1
qv-4x4-det-odd A z add mul neg r s1 s2 s3 =
  concat (cong (λ t → add t (neg (mul s3 s2))) (fst (snd (snd (snd (snd (snd (snd (snd (snd r)))))))) s3 s1 s2))
    (concat (fst (snd (snd r)) (mul s3 s1) (mul s3 s2) (neg (mul s3 s2)))
      (concat (cong (λ t → add (mul s3 s1) t) (fst (snd (snd (snd (snd r)))) (mul s3 s2)))
              (fst (snd r) (mul s3 s1))))
