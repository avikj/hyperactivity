ga-eq : GaGuard → GaGuard → Bool
ga-eq (ga-k a)          (ga-k b)          = ga-eqB a b
ga-eq (ga-v i)          (ga-v j)          = ga-eq-nat i j
ga-eq (ga-not a)        (ga-not b)        = ga-eq a b
ga-eq (ga-and a1 a2)    (ga-and b1 b2)    = ga-andB (ga-eq a1 b1) (ga-eq a2 b2)
ga-eq (ga-ite c1 t1 f1) (ga-ite c2 t2 f2) = ga-andB (ga-eq c1 c2) (ga-andB (ga-eq t1 t2) (ga-eq f1 f2))
ga-eq _                 _                 = false
