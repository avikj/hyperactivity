-- entries kept: each page's entries parsed once, in a process of its own (the machine keeps what a
-- process reads until it ends), and kept in build/etym/rows/LANG/<the page's key in hex>: fields
-- apart by byte 2, a chain's mentions by 3 and their fields by 4, entries by 5
e-ser-row : ERow → List Word
e-ser-row r = e-join (cons #2 nil) (cons (e-rh r) (cons (e-rp r) (cons (e-rd r) (cons (e-re r)
  (cons (e-join (cons #3 nil) (list-map (λ m → e-join (cons #4 nil) m) (e-rc r))) (cons (e-rf r) nil))))))
