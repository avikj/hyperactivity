h4-mk2 : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-mk2 mm_ tag ext a b kq_ =
  h4-alloc mm_ #2 (λ at → let mm_10 = h4-dep mm_ at in scmd (w-store ((h4-ha mm_10 at)) (a)) (λ uu_11 → let mm_12 = hv2-u mm_10 uu_11 in scmd (w-store ((h4-ha mm_12 (%wadd at #1))) (b)) (λ uu_13 → let mm_14 = hv2-u mm_12 uu_13 in kq_ (h4-depl mm_14 ((h4-new tag ext at))))))
