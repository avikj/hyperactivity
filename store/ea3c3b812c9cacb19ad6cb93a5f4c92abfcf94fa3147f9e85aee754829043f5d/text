pt-slater-sigma-other : Word → List ShellFill → Word
pt-slater-sigma-other _ nil = #0
pt-slater-sigma-other nval (cons f rest) =
  let sn = sf-n f
      se = sf-e f
      c = if andB (%weq sn nval) (pt-le (sf-l f) #1) then #0
          else if %weq (%wadd sn #1) nval then %wmul #85 se
          else if %wlt sn nval then %wmul #100 se
          else #0
  in %wadd c (pt-slater-sigma-other nval rest)
