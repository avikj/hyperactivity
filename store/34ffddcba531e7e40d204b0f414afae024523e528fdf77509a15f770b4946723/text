s-cached-treatise-file : List Word → List Word → Proc W (List Word)
s-cached-treatise-file st p =
  if h-eq p "/paper.pdf" then s-mod-file st "bin" "docs/hyperactivity.pdf.hex" else
  if orB (h-eq p "/pdf") (h-eq p "/monograph") then s-mod-file st "doc" "docs/pdf-viewer.html" else
  if h-eq p "/kg" then s-mod-file st "doc" "docs/kg.html" else
  if h-eq p "/api/kg/index" then s-mod-file st "json" "docs/kg-index.json" else
  if h-eq p "/nets" then s-mod-file st "doc" "docs/nets.html" else
  if orB (h-eq p "/daw") (h-eq p "/sound") then s-mod-file st "doc" "docs/daw.html" else
  if h-eq p "/neuro" then s-mod-file st "doc" "docs/neuro.html" else
  if h-eq p "/physics" then s-mod-file st "doc" "docs/physics.html" else
  if h-eq p "/ai" then s-mod-file st "doc" "docs/ai.html" else
  if h-eq p "/silicon" then s-mod-file st "doc" "docs/silicon.html" else
  if h-eq p "/hyperfactor" then s-mod-file st "doc" "docs/hyperfactor.html" else
  if orB (h-eq p "/decentralized") (h-eq p "/pouw") then s-mod-file st "doc" "docs/decentralized.html" else
  if h-eq p "/learn" then s-mod-file st "doc" "docs/learn.html" else
  if orB (h-eq p "/grh") (h-eq p "/rh") then s-mod-file st "doc" "lib/ir/hx-grh-surface.hypercubical" else
  ret {lzero} {W} nil
