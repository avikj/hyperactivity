hf-disjoint-in : Nat → Code → Code → Word
hf-disjoint-in zero tmpl _ = #0
hf-disjoint-in (suc n) tmpl c =
  case code-abstract c return (λ _ → Word) of
    some q → if code-eq (fst q) tmpl then #1 else hf-disjoint-l (hf-disjoint-in n tmpl) (code-kids c)
    none → hf-disjoint-l (hf-disjoint-in n tmpl) (code-kids c)
