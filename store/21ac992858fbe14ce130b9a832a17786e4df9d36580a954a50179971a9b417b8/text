-- atan(n/d) for 0 < n/d ≤ 1, scaled by 2^P
ief-atser : Nat → Word → List Word → List Word → Word × List Word → Word → Word × List Word
ief-atser zero k p z2 acc sg = acc
ief-atser (suc n) k p z2 acc sg =
  if bg-is0 p then acc
  else ief-atser n (%wadd k #2) (bg-shr (bg-mul p z2) ief-P) z2 (sx-add acc (sg , bg-divw p k)) (%wxor sg #1)
