  kq_ (h4-depl mm_ (s))
h4-defs mm_ (suc f) s stk seen file kq_ =
  let s1 = h4-skip s in if (h4-isnil (h4s-src s1)) then (if (h4-stknil stk) then (kq_ (h4-depl mm_ (s1))) else (let top = h4-stkhd stk in h4-defs mm_ f (h4s-wsrc s1 (snd top)) (h4-stktl stk) seen (fst top) kq_)) else (let mi = h4-match s1 "#include" in if (fst mi) then (let s2 = h4-skip (snd mi) in let c1 = h4-cons s2 (cons #34 nil) in let nm = h4-upto (h4s-src (snd c1)) in let s3 = h4s-wsrc (snd c1) (hv2-drop1 (snd nm)) in let path = h4-join file (fst nm) in if (h4-seenp seen path) then (h4-defs mm_ f s3 stk seen file kq_) else (scmd ((w-file-read-named path)) (λ fr → if (not (%weq (fst fr) #0)) then ((cli-say (list-append "Error: could not open '" (list-append path "'")) (sdone #1))) else (h4-defs mm_ f (h4s-wsrc s3 (snd fr)) (cons (file , h4s-src s3) stk) (cons path seen) path kq_)))) else (let ma = h4-match s1 "@" in if (fst ma) then (let nr = h4-name (snd ma) in if (not (fst nr)) then ((h4-perr "expected: name")) else (let c2 = h4-cons (fst (snd nr)) "=" in if (not (fst c2)) then ((h4-perr "expected: =")) else (h4p mm_ (h4s-fu s) #0 (h4s-wbs (snd c2) nil) #0 #0 #0 #0 (λ tx → let mm_3204 = h4-dpw mm_ tx in let n_3206 = #1 in scmd (w-load (mm_3204)) (λ at_3205 → let mm_3207 = h4-dep mm_3204 at_3205 in scmd (w-store (mm_3207) ((%wadd at_3205 n_3206))) (λ uu_3208 → let mm_3209 = hv2-u mm_3207 uu_3208 in let at = at_3205 in let i_3210 = at in let v_3211 = (snd tx) in scmd (w-store ((h4-ha mm_3209 i_3210)) (v_3211)) (λ uu_3212 → let mm_3213 = hv2-u mm_3209 uu_3212 in scmd (w-store ((h4-ba mm_3213 (snd (snd nr)))) (at)) (λ uu_3214 → let mm_3215 = hv2-u mm_3213 uu_3214 in h4-defs mm_3215 f (fst tx) stk seen file kq_)))))))) else ((h4-perr "expected: definition or #include"))))
