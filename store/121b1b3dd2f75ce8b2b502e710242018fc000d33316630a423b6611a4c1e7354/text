-- THEOREM 4 (EXACT RATIONAL CRITICAL-LINE LOCK — FUNCTIONAL EQUATION SYMMETRY):
-- For any rational candidate real part sigma = k/20 in (0, 1):
--   (sigma <= 1/2 AND 1 - sigma <= 1/2)  iff  sigma == 1/2!
rh-check-crit-lock : Word → Bool
rh-check-crit-lock k =
  let sig   = rq-mk (rz true k) #20
      dual  = rq-sub rq-one sig
      both  = andB (rh-q-le sig rh-half-q) (rh-q-le dual rh-half-q)
      is12  = rq-eq sig rh-half-q
  in rz-eqb both is12
