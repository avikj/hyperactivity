-- a reduction out of steps: its registers kept for the next batch, and the mark of a suspension
h4-wsusp : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-wsusp m st cur sp ra rb k =
  scmd (w-store ((%wadd m #64)) (st)) (λ u236 → let m237 = hv2-u m u236 in scmd (w-store ((%wadd m237 #72)) (cur)) (λ u238 → let m239 = hv2-u m237 u238 in scmd (w-store ((%wadd m239 #80)) (sp)) (λ u240 → let m241 = hv2-u m239 u240 in scmd (w-store ((%wadd m241 #88)) (ra)) (λ u242 → let m243 = hv2-u m241 u242 in scmd (w-store ((%wadd m243 #96)) (rb)) (λ u244 → let m245 = hv2-u m243 u244 in k (h4-depl m245 (hv2-none)))))))
