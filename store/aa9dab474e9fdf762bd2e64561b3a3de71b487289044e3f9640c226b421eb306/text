b2-varidx : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-varidx mm_ zero vs i j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-varidx mm_ (suc f) vs i j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_6250 = vs in let j_6251 = j in scmd (w-load ((b2-a mm_ (%wadd a_6250 (%wsucc j_6251))))) (λ x_6249 → let mm_6252 = b2-dep mm_ x_6249 in let w = x_6249 in let t_6254 = w in let j_6255 = #1 in scmd (w-load ((b2-a mm_6252 (%wadd t_6254 (%wadd #2 j_6255))))) (λ x_6253 → let mm_6256 = b2-dep mm_6252 x_6253 in let wi = x_6253 in if (%weq wi i) then (kq_ (h4-depl mm_6256 (j))) else (b2-varidx mm_6256 f vs i (%wsucc j) n kq_))))
