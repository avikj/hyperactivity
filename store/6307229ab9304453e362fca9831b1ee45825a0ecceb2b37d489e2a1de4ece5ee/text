-- the deepest root a followed chain reaches: Proto-Indo-European where it does, else another
-- reconstructed root, else the last attested term
e-rank : List (List Word) → Word
e-rank m = if h-eq (e-m (toNat #1) m) "ine-pro" then #3 else if orB (h-ends "-pro" (e-m (toNat #1) m)) (h-prefix "*" (e-m (toNat #3) m)) then #2 else #1
