b2-cwait : Word → Word → (Word → Step W Word) → Step W Word
b2-cwait mm_ item kq_ =
  if (%weq item hv2-none) then (b2-unitv mm_  (λ u → let mm_15096 = b2-dep mm_ u in b2-c1 mm_15096 "Wait" u (λ r → let mm_15097 = b2-dep mm_15096 r in kq_ (h4-depl mm_15097 (r))))) else (b2-c1 mm_ "Wait" item (λ r → let mm_15098 = b2-dep mm_ r in kq_ (h4-depl mm_15098 (r))))
