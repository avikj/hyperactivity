-- Signed dihedral cosine (sign of cos theta_12, squared magnitude) as Amp.
qg-cos-dihedral : List Bool → List Bool → List Bool → Amp
qg-cos-dihedral j1 j2 k = (fst (qg-dot8 j1 j2 k) ,
  (bin-mul (snd (qg-dot8 j1 j2 k)) (snd (qg-dot8 j1 j2 k)) ,
   bin-mul (bin-pow2 2) (bin-mul (qg-area2 j1) (qg-area2 j2))))
