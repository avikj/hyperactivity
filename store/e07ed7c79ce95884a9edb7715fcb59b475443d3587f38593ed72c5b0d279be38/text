hxp-le-trans : (a b c : Nat) → hxp-le a b ≡ true → hxp-le b c ≡ true → hxp-le a c ≡ true
hxp-le-trans zero b c hab hbc          = refl
hxp-le-trans (suc a) zero c hab hbc    =
  transport (λ i → if hab i then hxp-le (suc a) c ≡ true else Unit) unit
hxp-le-trans (suc a) (suc b) zero hab hbc = hbc
hxp-le-trans (suc a) (suc b) (suc c) hab hbc = hxp-le-trans a b c hab hbc
