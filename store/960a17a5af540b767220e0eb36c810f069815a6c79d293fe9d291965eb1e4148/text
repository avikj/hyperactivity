h4-mk2at : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-mk2at mm_ at tag ext a b kq_ =
  scmd (w-store ((h4-ha mm_ at)) (a)) (λ uu_15 → let mm_16 = hv2-u mm_ uu_15 in scmd (w-store ((h4-ha mm_16 (%wadd at #1))) (b)) (λ uu_17 → let mm_18 = hv2-u mm_16 uu_17 in kq_ (h4-depl mm_18 ((h4-new tag ext at)))))
