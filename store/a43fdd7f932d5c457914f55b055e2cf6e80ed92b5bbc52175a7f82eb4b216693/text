    (add (mul (add (add a0 (neg b)) (add a1 (neg b))) (add (add a0 (neg b)) (add a1 (neg b))))
         (mul (add a0 (neg a1)) (add a0 (neg a1))))
    (sym (emg-para2 A z add mul neg r (add a0 (neg b)) (add a1 (neg b))))
