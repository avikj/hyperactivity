      (add (mul (add a0 (neg b)) (add a0 (neg b))) (mul (add a1 (neg b)) (add a1 (neg b)))) ≡
  add (mul (add (add a0 (neg b)) (add a1 (neg b))) (add (add a0 (neg b)) (add a1 (neg b))))
      (mul (add a0 (neg a1)) (add a0 (neg a1)))
emg-star-mesh-2 A z add mul neg r a0 a1 b =
  lor-tr A
    (add (add (mul (add a0 (neg b)) (add a0 (neg b))) (mul (add a1 (neg b)) (add a1 (neg b))))
         (add (mul (add a0 (neg b)) (add a0 (neg b))) (mul (add a1 (neg b)) (add a1 (neg b)))))
