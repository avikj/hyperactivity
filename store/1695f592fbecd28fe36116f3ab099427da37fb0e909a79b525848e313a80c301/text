-- Connection to chem/facts.cub: a warrant established over observer o1's reading transfers directly to every
-- history in o2's fiber whenever o1's fact is StableFor o2.
rqm-stable-warrants : (H : Type 0) → (o1 o2 : Observer H) → (s : StableFor H o1 o2) →
  (W : obs-type H o1 → Type 0) → (y : obs-type H o2) → W (fst s y) →
  (h : H) → obs-of H o2 h ≡ y → W (obs-of H o1 h)
rqm-stable-warrants H o1 o2 s W y wy h p = subst {lzero} {lzero} {obs-type H o1} {W} (sym (stable-fiber H o1 o2 s y h p)) wy
