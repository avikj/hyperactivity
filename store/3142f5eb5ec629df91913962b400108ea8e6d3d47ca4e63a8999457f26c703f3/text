-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10931 = tld in scmd (w-load ((b2-a mm_ t_10931))) (λ x_10930 → let mm_10932 = b2-dep mm_ x_10930 in let tg = (%wand x_10930 #255) in if (%weq tg b2-TADT) then (let t_10934 = tld in let j_10935 = #4 in scmd (w-load ((b2-a mm_10932 (%wadd t_10934 (%wadd #2 j_10935))))) (λ x_10933 → let mm_10936 = b2-dep mm_10932 x_10933 in let b = x_10933 in kq_ (h4-depl mm_10936 (b)))) else (let t_10938 = tld in let j_10939 = #5 in scmd (w-load ((b2-a mm_10932 (%wadd t_10938 (%wadd #2 j_10939))))) (λ x_10937 → let mm_10940 = b2-dep mm_10932 x_10937 in let b = x_10937 in kq_ (h4-depl mm_10940 (b))))))
