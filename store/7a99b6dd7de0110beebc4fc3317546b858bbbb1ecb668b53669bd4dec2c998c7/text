  function pow2Ceil(m) { let p = 1; while (p < m) p <<= 1; return p; }
  function runHXZ(str) {
    const bytes = Array.from(new TextEncoder().encode(str)).slice(0, 1500);
    const L = 32768;
    // Build causal tables per position forward
    const tables = [new Map(), new Map(), new Map(), new Map(), new Map()];
    const snapshots = [];
    const depthHits = [0, 0, 0, 0, 0, 0]; // 0=ground, 1..5=order 0..4
    const ctxKey = (pos, ord) => {
      if (ord === 0) return '';
      if (pos < ord) return null;
      let k = '';
      for (let i = pos - ord; i < pos; i++) k += String.fromCharCode(bytes[i]);
      return k;
    };
    const getFiber = (ord, key) => {
      if (key === null) return null;
      const m = tables[ord].get(key);
      return m ? new Map(m) : null;
    };
    const updateTables = (pos, b) => {
      for (let ord = 0; ord < 5; ord++) {
        const k = ctxKey(pos, ord);
        if (k === null) continue;
        let m = tables[ord].get(k);
        if (!m) { m = new Map(); tables[ord].set(k, m); }
        m.set(b, (m.get(b) || 0) + 1);
      }
    };
    for (let i = 0; i < bytes.length; i++) {
      const fibers = [];
      for (let ord = 0; ord < 5; ord++) fibers.push(getFiber(ord, ctxKey(i, ord)));
      snapshots.push({ b: bytes[i], fibers });
      updateTables(i, bytes[i]);
    }

    function buildPadded(fib, excl) {
      const entries = [];
      let sum = 0;
      if (fib) {
        for (const [sym, cnt] of fib.entries()) {
          if (!excl.has(sym)) { entries.push([sym, cnt]); sum += cnt; }
        }
      }
      if (!entries.length) return null;
      entries.sort((a, b) => a[0] - b[0]);
      const baseEsc = entries.length;
      const rawM = sum + baseEsc;
      const M = pow2Ceil(rawM);
      const escF = baseEsc + (M - rawM);
      const tbl = [{ sym: -1, C: 0, f: escF }];
      let cum = escF;
      for (const [sym, cnt] of entries) { tbl.push({ sym, C: cum, f: cnt }); cum += cnt; }
      return { M, tbl, syms: entries.map(e => e[0]) };
    }

    // Encode reverse (exact LIFO streaming rANS)
    let s = L;
    const out = [];
    const trace = [];
    function encSym(tblInfo, sym) {
      const entry = tblInfo.tbl.find(e => e.sym === sym);
      const hi = Math.floor((256 * L) / tblInfo.M) * entry.f;
      while (s >= hi) { out.push(s & 255); s = Math.floor(s / 256); }
      s = Math.floor(s / entry.f) * tblInfo.M + entry.C + (s % entry.f);
    }
    for (let i = bytes.length - 1; i >= 0; i--) {
      const { b, fibers } = snapshots[i];
      const steps = [];
      const excl = new Set();
      let hitDepth = 0;
      for (let k = 4; k >= 0; k--) {
        const pt = buildPadded(fibers[k], excl);
        if (!pt) continue;
        if (pt.tbl.some(e => e.sym === b)) {
          steps.push({ kind: 'sym', pt, sym: b });
          hitDepth = k + 1;
          break;
        } else {
          steps.push({ kind: 'sym', pt, sym: -1 });
          for (const sy of pt.syms) excl.add(sy);
        }
      }
      depthHits[hitDepth]++;
      if (hitDepth === 0) steps.push({ kind: 'ground', sym: b });
      for (let j = steps.length - 1; j >= 0; j--) {
        const st = steps[j];
        if (st.kind === 'ground') {
          while (s >= L) { out.push(s & 255); s = Math.floor(s / 256); }
          s = s * 256 + st.sym;
        } else {
          encSym(st.pt, st.sym);
        }
      }
      trace.push(s);
    }
    trace.reverse();

    // Decode forward (verifying exact bit-for-bit reconstruction)
    let ds = s, dptr = out.length - 1;
    const dtables = [new Map(), new Map(), new Map(), new Map(), new Map()];
    const dec = [];
    const dCtxKey = (pos, ord) => {
      if (ord === 0) return '';
      if (pos < ord) return null;
      let k = '';
      for (let i = pos - ord; i < pos; i++) k += String.fromCharCode(dec[i]);
      return k;
    };
    for (let i = 0; i < bytes.length; i++) {
      const excl = new Set();
      let sym = -1;
      for (let k = 4; k >= 0; k--) {
        const key = dCtxKey(i, k);
        const fib = (key !== null && dtables[k].get(key)) || null;
        const pt = buildPadded(fib, excl);
        if (!pt) continue;
        const r = ds % pt.M;
        const q = Math.floor(ds / pt.M);
        let found = pt.tbl[0];
        for (const e of pt.tbl) { if (r >= e.C && r < e.C + e.f) { found = e; break; } }
        ds = q * found.f + (r - found.C);
        while (ds < L && dptr >= 0) { ds = ds * 256 + out[dptr--]; }
        if (found.sym !== -1) { sym = found.sym; break; }
        for (const sy of pt.syms) excl.add(sy);
      }
      if (sym === -1) {
        sym = ds & 255;
        ds = Math.floor(ds / 256);
        while (ds < L && dptr >= 0) { ds = ds * 256 + out[dptr--]; }
      }
      dec.push(sym);
      for (let ord = 0; ord < 5; ord++) {
        const k = dCtxKey(i, ord);
        if (k === null) continue;
        let m = dtables[ord].get(k);
        if (!m) { m = new Map(); dtables[ord].set(k, m); }
        m.set(sym, (m.get(sym) || 0) + 1);
      }
    }
    let exact = dec.length === bytes.length && dec.every((v, idx) => v === bytes[idx]);
    // Order-0 Shannon entropy baseline
    const freq = new Map();
    for (const b of bytes) freq.set(b, (freq.get(b) || 0) + 1);
    let h0 = 0;
    for (const c of freq.values()) { const p = c / bytes.length; h0 -= p * Math.log2(p); }
    const compBytes = out.length + 13; // 4B magic + 9B block header
    return { orig: bytes.length, comp: compBytes, h0Bytes: Math.ceil(h0 * bytes.length / 8), exact, depthHits, trace, L };
  }

