    // Top half: Sequence Contact Arc Diagram
    ctx.fillStyle = pink;
    ctx.fillText(`AUTONOMOUS FOLD: ${f.isHP ? 'β-HAIRPIN (turn=' + f.bestT + ')' : 'α-HELIX (Pro-aware)'} · ${f.s.length} aa`, 20, 22);
    const n = f.s.length, baseY = 148, padX = 28, span = W - 2 * padX;
    const xOf = i => padX + (n > 1 ? (i / (n - 1)) * span : span / 2);
    f.contacts.forEach(([i, j]) => {
