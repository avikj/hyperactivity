  /* ============================================================ LAB 4: FOLD + K^4 POCKET BINDER */
  const HYDRO = { G:0,A:1,V:2,L:3,I:3,P:1,F:4,Y:4,W:5,M:2,S:0,T:0,C:2,N:0,Q:0,D:0,E:0,K:0,R:0,H:1 };
  function pairScore(a, b) {
    const ha = HYDRO[a] || 0, hb = HYDRO[b] || 0;
    let s = 1; // backbone H-bond
    if (ha >= 2 && hb >= 2) s += 2; // hydrophobic core
    if (ha >= 4 && hb >= 4) s += 3; // aromatic pi-stack (Y-W, F-F)
    if ((a === 'D' || a === 'E') && (b === 'K' || b === 'R')) s += 3;
    if ((b === 'D' || b === 'E') && (a === 'K' || a === 'R')) s += 3;
    return s;
  }
  function solveFold(seq) {
    const s = seq.toUpperCase().replace(/[^ACDEFGHIKLMNPQRSTVWY]/g, '') || 'GYDPETGTWG';
    const n = s.length;
    const helix = [];
    for (let i = 0; i + 4 < n; i++) if (s[i + 4] !== 'P') helix.push([i, i + 4]);
    const hScore = helix.reduce((a, [i, j]) => a + pairScore(s[i], s[j]), 0);
    let bestT = 0, bestHP = [], bestHPS = -1;
    for (let t = 0; t <= Math.max(0, n - 4); t++) {
      const hp = [];
      let lo = t, hi = t + 3;
      while (lo >= 0 && hi < n) { hp.push([lo, hi]); lo--; hi++; }
      const sc = hp.reduce((a, [i, j]) => a + pairScore(s[i], s[j]), 0);
      if (sc >= bestHPS) { bestHPS = sc; bestT = t; bestHP = hp; }
    }
    const isHP = bestHPS >= hScore;
    return { s, isHP, bestT, hScore, bestHPS, contacts: isHP ? bestHP : helix, gap: Math.abs(bestHPS - hScore) };
  }
  function solveBB(K) {
    const e1 = i => i === 2 ? 11 : (i === 0 ? 65 : 14 + ((i * 7) % 30));
    const e2 = i => i === 2 ? 0 : (i === 1 ? 70 : 3 + ((i * 5) % 20));
    let best = 9999, pruned = 0, evaled = 0;
    const r1Status = [];
    const K2 = K * K, K3 = K2 * K;
    for (let r1 = 0; r1 < K; r1++) {
      const v1 = e1(r1);
      if (best < v1) { pruned += K3; r1Status.push('pruned'); continue; }
      r1Status.push(r1 === 2 ? 'opt' : 'expanded');
      for (let r2 = 0; r2 < K; r2++) {
        const v12 = v1 + e2(r2);
        if (best < v12) { pruned += K2; continue; }
        for (let r3 = 0; r3 < K; r3++) {
          const v123 = v12 + e2(r3);
          if (best < v123) { pruned += K; continue; }
          for (let r4 = 0; r4 < K; r4++) {
            const e = v123 + e2(r4);
            if (e < best) best = e;
            evaled++;
          }
        }
      }
    }
    return { total: K * K * K * K, best, pruned, evaled, r1Status };
  }
  const foldSeqIn = document.getElementById('foldSeqIn'), foldK = document.getElementById('foldK');
  function drawFold() {
