  /* ============================================================ LAB 5: ORDER BOOK CONSERVATION */
  let bk = { bid: 120, ask: 90, exec: 40, cancel: 10, totalAdd: 260, msgs: 6, hist: [[120, 90, 40]] };
  function bkStep(tag, side, qty) {
