b2-cmpv : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-cmpv mm_ a b kq_ =
  b2-nm mm_ (the (List Word) (if %wlt a b then "LT" else if %weq a b then "EQ" else "GT")) (λ k → let mm_2546 = b2-dep mm_ k in b2-arr mm_2546 #0 (λ e → let mm_2547 = b2-dep mm_2546 e in b2-Ctr mm_2547 k e #0 (λ r → let mm_2548 = b2-dep mm_2547 r in kq_ (h4-depl mm_2548 (r)))))
