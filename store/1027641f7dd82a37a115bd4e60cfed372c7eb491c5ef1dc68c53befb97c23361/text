s-request : Bool → List Word → List Word → Sum Unit (List Word) → List Word → Proc W (List Word)
s-request pub st m tok req =
  if h-prefix "PUT " req then (
    let p = h-before " " (h-drop "PUT " (h-before (cons #13 nil) req)) in
    if s-allowed pub tok req then (
      if h-prefix "/roots/" p then s-put-root st m (h-drop "/roots/" (h-before "?" p)) (h-after (list-append h-crlf h-crlf) req)
      else ret {lzero} {W} (s-respond "404 Not Found" "text/plain" "not found"))
    else ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "this server is read-only"))
  else if h-prefix "POST " req then (
    let p = h-before " " (h-drop "POST " (h-before (cons #13 nil) req)) in
    if um-send-path p then um-send req
    else if orB (h-eq (h-before "?" p) "/eval") (h-eq (h-before "?" p) "/api/eval") then bind (ue-eval-hypercubical (if h-null m then "./build/cubical" else if orB (h-prefix "/" m) (h-prefix "./" m) then m else list-append "./" m) (s-query p) (h-after (list-append h-crlf h-crlf) req)) (λ cert → ret {lzero} {W} (s-response "text/plain; charset=utf-8" cert))
    else if h-eq (h-before "?" p) "/api/x402/verify" then bind (x4-verify-tx (s-query p) (h-after (list-append h-crlf h-crlf) req)) (λ cert → ret {lzero} {W} (s-response "text/plain; charset=utf-8" cert))
    else if orB (h-eq (h-before "?" p) "/api/this") (h-eq (h-before "?" p) "/api/oracle") then bind (this-handle-post (h-after (list-append h-crlf h-crlf) req)) (λ j → ret {lzero} {W} (s-response "application/json" j))
    else if h-eq (h-before "?" p) "/api/trace" then s-trace-post st (h-after (list-append h-crlf h-crlf) req)
    else if andB (h-eq (h-before "?" p) "/api/net/pulse") (s-allowed pub tok req) then s-net-pulse-post st (h-after (list-append h-crlf h-crlf) req)
    else if h-prefix "/api/p2p/signal" p then s-p2p-signal-body st (s-query p) (h-after (list-append h-crlf h-crlf) req)
    else if h-eq (h-before "?" p) "/dht/announce" then s-dht-announce pub st (h-after (list-append h-crlf h-crlf) req)
    else if h-eq (h-before "?" p) "/dht/provide" then s-dht-provide pub st (h-after (list-append h-crlf h-crlf) req)
    else if s-allowed pub tok req then s-post st m p req
    else if h-eq (h-before "?" p) "/peer/reduce" then bind (h-env "HYPERACTIVE_PEER_COMPUTE") (λ pc → case pc of
      inr v → (if h-null v then ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "peer compute not enabled") else s-peer-reduce st m (h-after (list-append h-crlf h-crlf) req))
      inl u → ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "peer compute requires token or HYPERACTIVE_PEER_COMPUTE=1"))
    else ret {lzero} {W} (s-respond "403 Forbidden" "text/plain" "this server is read-only"))
  else if h-not (orB (h-prefix "GET " req) (h-prefix "HEAD " req)) then ret {lzero} {W} (s-respond "405 Method Not Allowed" "text/plain" "method not allowed")
  else if s-redirect-onrender pub req then ret {lzero} {W} (s-to-canonical req)
  else if andB pub (andB (s-views-path (s-request-path req)) (h-not (s-allowed pub tok req))) then ret {lzero} {W} s-to-front
  else if andB pub (andB (s-withheld (s-request-path req)) (h-not (s-allowed pub tok req))) then ret {lzero} {W} (s-respond "404 Not Found" s-html s-not-found)
  else if andB pub (h-not (s-allowed pub tok req)) then s-public-answer st m (s-request-path req)
  else s-answer st m (s-request-path req)











-- the socket: port, listening on 127.0.0.1, or on every address when HYPERACTIVE_PUBLIC is set
s-addr-bytes : Bool → Word → List Word
s-addr-bytes pub port = cons #2 (cons #0 (cons (wshr port #8) (cons (wand port #255) (if pub then cons #0 (cons #0 (cons #0 (cons #0 nil))) else cons #127 (cons #0 (cons #0 (cons #1 nil)))))))









s-addr : Bool → Word → Proc W Word
s-addr pub port = bind (alloc-bytes #16) (λ a → bind (h-poke a (s-addr-bytes pub port)) (λ u → ret a))









s-listen : Bool → Word → Proc W Word
s-listen pub port = bind (sys-call #41 #2 #1 #0 #0 #0 #0) (λ fd → bind (alloc-bytes #4) (λ one → bind (store8-at one #1) (λ u →
  bind (sys-call #54 fd #1 #2 one #4 #0) (λ o → bind (s-addr pub port) (λ a → bind (sys-call #49 fd a #16 #0 #0 #0) (λ b →
  bind (sys-call #50 fd #128 #0 #0 #0 #0) (λ l → ret {lzero} {W} (if orB (wlt #9223372036854775807 b) (wlt #9223372036854775807 l) then #18446744073709551615 else fd))))))))











-- harden client socket: 10s recv timeout, 15s send timeout (Slowloris immunity), TCP_NODELAY (zero 40ms Nagle stall)
s-tv16 : Word → List Word
s-tv16 sec = cons sec (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 nil)))))))))))))))











s-tune-sock : Word → Proc W Unit
s-tune-sock c =
  bind (with-bytes {Unit} #16 (λ tv →
    bind (h-poke tv (s-tv16 #10)) (λ u1 →
    bind (sys-call #54 c #1 #20 tv #16 #0) (λ r1 →
    bind (h-poke tv (s-tv16 #15)) (λ u2 →
    bind (sys-call #54 c #1 #21 tv #16 #0) (λ r2 → ret {lzero} {W} unit)))))) (λ u3 →
  bind (with-bytes {Unit} #4 (λ one →
    bind (h-poke one (cons #1 (cons #0 (cons #0 (cons #0 nil))))) (λ u4 →
    bind (sys-call #54 c #6 #1 one #4 #0) (λ r3 → ret {lzero} {W} unit)))) (λ u5 →
  ret {lzero} {W} unit))











-- exact HTTP header boundary finder (MSG_PEEK = 2 on recvfrom sys-call #45) so PUT /packs/<SHA256> leaves 100% of binary body in socket for 64 KiB streaming
s-hdr-end : Word → List Word → Word
s-hdr-end k nil = #0
s-hdr-end k (cons x r) =
  if h-prefix (list-append h-crlf h-crlf) (cons x r)
  then wadd k #4
  else s-hdr-end (wadd k #1) r











-- HTTP header boundary ends right after CRLFCRLF leaving binary body intact (part of product-implementation)
s-hdr-end-example : Path Word (s-hdr-end #0 (list-append "PUT /x" (list-append h-crlf (list-append h-crlf "BODY")))) #10
s-hdr-end-example = refl











s-read-head : Nat → Word → List Word → Proc W (List Word)
s-read-head zero c acc = ret acc
s-read-head (suc k) c acc =
  if wlt #16384 (fromNat (list-length acc)) then ret {lzero} {W} acc
  else bind (with-bytes {Sum Unit (Word × List Word)} #8192 (λ buf →
    bind (sys-call #45 c buf #8192 #2 #0 #0) (λ n →
    if orB (weq n #0) (wlt #9223372036854775807 n) then ret {lzero} {W} (inl unit)
    else bind (h-peek buf (toNat n)) (λ pk →
      let comb = list-append acc pk in
      let he = s-hdr-end #0 comb in
      let eat = if weq he #0 then n else wsub he (fromNat (list-length acc)) in
      bind (sys-call #0 c buf eat #0 #0 #0) (λ r →
      ret {lzero} {W} (inr (he , (if weq he #0 then comb else h-take (toNat he) comb)))))))) (λ res →
    case res of
      inl u → ret {lzero} {W} acc
      inr hw → if weq (fst hw) #0 then s-read-head k c (snd hw) else ret {lzero} {W} (snd hw))











s-read-body : Nat → Word → Word → List Word → Proc W (List Word)
s-read-body zero c want acc = ret acc
s-read-body (suc k) c want acc =
  if h-not (wlt (fromNat (list-length acc)) want) then ret {lzero} {W} acc
  else let rem = wsub want (fromNat (list-length acc)) in
  let ask = if wlt rem #65536 then rem else #65536 in
  bind (with-bytes {Sum Unit (List Word)} #65536 (λ buf →
    bind (sys-call #0 c buf ask #0 #0 #0) (λ n →
    if orB (weq n #0) (wlt #9223372036854775807 n) then ret {lzero} {W} (inl unit)
    else bind (h-peek buf (toNat n)) (λ b → ret {lzero} {W} (inr b))))) (λ r →
    case r of
      inl u → ret {lzero} {W} acc
      inr b → s-read-body k c want (list-append acc b))











-- one connection answered: /healthz fast-path, zero-copy 64 KiB raw streaming for cached pages & binary packs, bounded body for dynamic routes
s-handle-cached : Bool → List Word → List Word → Sum Unit (List Word) → Word → List Word → Proc W Unit
s-handle-cached pub st m tok c hdr =
  let p = h-before "?" (s-request-path hdr) in
  bind (s-cached-route-file st p) (λ cf →
  bind (if h-null cf then ret {lzero} {W} false else s-stream-raw c cf) (λ streamed →
  if streamed then ret {lzero} {W} unit
  else bind (s-request pub st m tok hdr) (λ resp → bind (fd-write c resp) (λ w → ret {lzero} {W} unit))))











s-handle-text : Bool → List Word → List Word → Sum Unit (List Word) → Word → List Word → Proc W Unit
s-handle-text pub st m tok c hdr =
  let clen = h-number (um-header "content-length" hdr) in
  let cap = if s-allowed pub tok hdr then #16777216 else #65536 in
  if wlt cap clen
  then bind (fd-write c (s-respond "413 Payload Too Large" "text/plain" "payload too large")) (λ w → ret {lzero} {W} unit)
  else bind (if andB (wlt #0 clen) (h-infix "100-continue" (sx-lower (um-header "expect" hdr)))
             then fd-write c (list-append "HTTP/1.1 100 Continue" (list-append h-crlf h-crlf))
             else ret {lzero} {W} #0) (λ cont →
    bind (s-read-body (toNat #4096) c clen nil) (λ body →
    bind (s-request pub st m tok (list-append hdr body)) (λ resp →
    bind (fd-write c resp) (λ w → ret {lzero} {W} unit))))











