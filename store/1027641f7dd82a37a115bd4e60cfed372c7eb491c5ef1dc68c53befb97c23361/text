-- build bootstrap.tgz (~95 KB: Makefile, src/*, hyperactive, README.md) so any bare peer machine can bootstrap without git
s-make-bootstrap : List Word → Proc W Unit
s-make-bootstrap dst =
  bind (h-file-time "Makefile") (λ mt →
  if wlt #0 mt
  then bind (h-run (cons "/bin/sh" (cons "-c" (cons "IFS=; COPYFILE_DISABLE=1 tar -czf $1 Makefile src hyperactive README.md" (cons "_" (cons dst nil)))))) (λ r → ret {lzero} {W} unit)
  else ret {lzero} {W} unit)











-- seed initial pack + roots/latest + root when absent so `hyperactive take latest` works out of the box immediately on deploy
s-seed-place : List Word → Proc W Unit
s-seed-place m =
  bind (h-mkdir "packs") (λ u0 →
  bind (h-mkdir "roots") (λ u1 →
  bind (h-mkdir ".cubical-store") (λ u2 →
  bind (h-file-time "roots/latest") (λ lt →
  if wlt #0 lt then ret {lzero} {W} unit
  else bind (h-capture (cons m (cons "--root" nil))) (λ rr →
    let rt = s-head nil (h-nonempty (h-lines (snd rr))) in
    if h-null rt then ret {lzero} {W} unit
    else let tmp = the (List Word) "packs/.seed.tgz" in
      bind (h-run (cons "/usr/bin/env" (cons "tar" (cons "-czf" (cons tmp (cons "store" nil)))))) (λ tc →
      if h-not (weq tc #0) then bind (h-unlink tmp) (λ u → ret {lzero} {W} unit)
      else bind (s-sha256 tmp) (λ sh →
        let ph = s-head nil (h-split #32 (snd sh)) in
        bind (s-rename tmp (list-append "packs/" ph)) (λ rn →
        bind (h-write ".cubical-store/packs" (h-line ph)) (λ w0 →
        bind (h-write ".cubical-store/sent-marker" nil) (λ w1 →
        bind (h-write (list-append "roots/" rt) (h-line ph)) (λ w2 →
        bind (h-write "roots/latest" (h-line ph)) (λ w3 →
        bind (h-write "root" (h-line rt)) (λ w4 → ret {lzero} {W} unit)))))))))))))











-- optional HYPERACTIVE_DATA persistent directory (e.g. /var/data on Render Persistent Disk): union-merges boot store/ + .cubical-store/ and chdirs into it
s-sync-deploy-root : List Word → List Word → Proc W Unit
s-sync-deploy-root m boot-r =
  if h-not (s-hex64 boot-r) then ret {lzero} {W} unit
  else bind (h-read ".cubical-store/boot-root") (λ prev →
    if h-eq boot-r (h-trim (h-before (cons #10 nil) (s-or nil prev)))
    then ret {lzero} {W} unit
    else bind (h-mkdir "packs") (λ u0 →
      bind (h-mkdir "roots") (λ u1 →
      bind (h-run (cons m (cons "--take" (cons boot-r nil)))) (λ tk →
      let tmp = the (List Word) "packs/.deploy.tgz" in
      bind (h-run (cons "/bin/sh" (cons "-c" (cons "if [ -e ./.cubical-store/sent-marker ]; then find store -newer ./.cubical-store/sent-marker -type f > .cubical-store/deploy.files && if [ -s .cubical-store/deploy.files ]; then COPYFILE_DISABLE=1 tar -czf packs/.deploy.tgz -T .cubical-store/deploy.files; else COPYFILE_DISABLE=1 tar -czf packs/.deploy.tgz store/ROOT/root; fi; else COPYFILE_DISABLE=1 tar -czf packs/.deploy.tgz store; fi" nil)))) (λ tc →
      if h-not (weq tc #0) then bind (h-unlink tmp) (λ u2 → ret {lzero} {W} unit)
      else bind (s-sha256 tmp) (λ sh →
        let ph = s-head nil (h-split #32 (snd sh)) in
        bind (s-rename tmp (list-append "packs/" ph)) (λ rn →
        bind (s-record-pack ph) (λ rp →
        bind (h-read ".cubical-store/packs") (λ allp →
        bind (h-write ".cubical-store/sent-marker" nil) (λ wm →
        bind (h-write (list-append "roots/" boot-r) (s-or (h-line ph) allp)) (λ wr1 →
        bind (h-write "roots/latest" (s-or (h-line ph) allp)) (λ wr2 →
        bind (h-write "root" (h-line boot-r)) (λ wr3 →
        bind (h-write ".cubical-store/boot-root" (h-line boot-r)) (λ wb →
        ret {lzero} {W} unit))))))))))))))











s-boot-data : List Word → Proc W (List Word × List Word)
s-boot-data m =
  bind h-cwd (λ cwd →
  let abs-m = if h-prefix "/" m then m else list-append cwd (cons #47 m) in
  bind (h-read "store/ROOT/root") (λ br0 →
  let boot-r = h-trim (h-before (cons #10 nil) (s-or nil br0)) in
  bind (h-env "HYPERACTIVE_DATA") (λ ed →
  case ed of
    inl u → bind (s-make-bootstrap "bootstrap.tgz") (λ mb → ret {lzero} {W} (abs-m , boot-r))
    inr ddir →
      if h-null ddir then bind (s-make-bootstrap "bootstrap.tgz") (λ mb → ret {lzero} {W} (abs-m , boot-r))
      else bind (h-mkdir ddir) (λ d0 →
        bind (h-file-time ddir) (λ dt →
        if h-not (wlt #0 dt) then bind (s-make-bootstrap "bootstrap.tgz") (λ mb → ret {lzero} {W} (abs-m , boot-r))
        else bind (h-mkdir (list-append ddir "/store")) (λ d1 →
        bind (h-mkdir (list-append ddir "/.cubical-store")) (λ d2 →
        bind (s-make-bootstrap (list-append ddir "/bootstrap.tgz")) (λ mb →
        bind (h-read (list-append ddir "/.cubical-store/boot-root")) (λ prev →
        let same = andB (h-not (h-null boot-r)) (h-eq boot-r (h-trim (h-before (cons #10 nil) (s-or nil prev)))) in
        bind (h-file-time "store") (λ st0 →
        bind (if andB (wlt #0 st0) (h-not same) then h-run (cons "/bin/sh" (cons "-c" (cons "IFS=; cp -rn store/. $1/store/ && cp -f store/ROOT/root $1/store/ROOT/root 2>/dev/null || true" (cons "_" (cons ddir nil))))) else ret {lzero} {W} #0) (λ cp1 →
        bind (h-file-time ".cubical-store") (λ cs0 →
        bind (if wlt #0 cs0 then h-run (cons "/bin/sh" (cons "-c" (cons "IFS=; for p in .cubical-store/mod-* .cubical-store/site-* .cubical-store/site-stamp; do [ -e $p ] && cp -f $p $1/.cubical-store/ 2>/dev/null || true; done; for d in paper views index site; do [ -d .cubical-store/$d ] && cp -rf .cubical-store/$d $1/.cubical-store/ 2>/dev/null || true; done; true" (cons "_" (cons ddir nil))))) else ret {lzero} {W} #0) (λ cp2 →
        bind (s-chdir ddir) (λ cd →
        bind (if andB (s-hex64 boot-r) (h-not same) then h-run (cons abs-m (cons "--take" (cons boot-r nil))) else ret {lzero} {W} #0) (λ ix →
        ret {lzero} {W} (abs-m , boot-r))))))))))))))))











