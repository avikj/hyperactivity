s-handle : Bool → List Word → List Word → Sum Unit (List Word) → Word → Proc W Unit
s-handle pub st m tok c =
  bind (s-tune-sock c) (λ tu →
  bind (s-read-head (toNat #32) c nil) (λ hdr →
  let line1 = h-before (cons #13 nil) hdr in
  bind (
    if h-null hdr then ret {lzero} {W} unit
    else if orB (h-prefix "GET /healthz " line1) (h-prefix "HEAD /healthz " line1)
    then bind (fd-write c (s-response "text/plain; charset=utf-8" "ok")) (λ w → ret {lzero} {W} unit)
    else if andB pub (h-not (s-allowed pub tok hdr))
    then s-handle-dark pub st m c hdr
    else if h-prefix "PUT /packs/" line1
    then let ph = h-before "?" (h-before " " (h-drop "PUT /packs/" line1)) in
      s-put-pack pub tok c ph hdr
    else if andB (h-prefix "GET /packs/" line1) (h-not (s-redirect-onrender pub hdr))
    then let ph = h-before "?" (h-before " " (h-drop "GET /packs/" line1)) in
      if s-hex64 ph then s-stream-file c (list-append "packs/" ph) "application/gzip" nil
      else bind (fd-write c (s-respond "404 Not Found" "text/plain" "not found")) (λ w → ret {lzero} {W} unit)
    else if andB (orB (h-eq (h-before "?" (s-request-path hdr)) "/bootstrap.tgz") (h-eq (h-before "?" (s-request-path hdr)) "/bootstrap")) (h-not (s-redirect-onrender pub hdr))
    then s-stream-file c "bootstrap.tgz" "application/gzip" "attachment; filename=hyperactivity-bootstrap.tgz"
    else if andB (h-prefix "GET " line1) (h-not (s-redirect-onrender pub hdr))
    then s-handle-cached pub st m tok c hdr
    else s-handle-text pub st m tok c hdr) (λ u →
  bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → ret unit))))











s-room : Word → Proc W Word
s-room n = if wlt n #64 then ret {lzero} {W} n else bind (sys-call #61 #18446744073709551615 #0 #0 #0 #0 #0) (λ r → ret {lzero} {W} (if wlt r #9223372036854775808 then wsub n #1 else #0))











s-reap : Nat → Word → Proc W Word
s-reap zero n = ret n
s-reap (suc k) n = bind (sys-call #61 #18446744073709551615 #0 #1 #0 #0 #0) (λ r → if andB (wlt #0 r) (wlt r #9223372036854775808) then s-reap k (wsub n #1) else ret {lzero} {W} n)











s-serve : Nat → Word → Bool → List Word → List Word → Sum Unit (List Word) → Word → Proc W Unit
s-serve zero n pub st m tok fd = ret unit
s-serve (suc k) n pub st m tok fd = bind (s-room n) (λ n1 → bind (sys-call #43 fd #0 #0 #0 #0 #0) (λ c →
  if wlt #9223372036854775807 c then bind (s-reap (toNat #64) n1) (λ n2 → s-serve k n2 pub st m tok fd)
  else bind (sys-call #57 #0 #0 #0 #0 #0 #0) (λ pid →
  if weq pid #0 then bind (sys-call #3 fd #0 #0 #0 #0 #0) (λ cf → bind (s-handle pub st m tok c) (λ u → bind (sys-call #231 #0 #0 #0 #0 #0 #0) (λ x → ret {lzero} {W} unit)))
  else if wlt pid #9223372036854775808 then bind (sys-call #3 c #0 #0 #0 #0 #0) (λ cl → bind (s-reap (toNat #64) (wadd n1 #1)) (λ n2 → s-serve k n2 pub st m tok fd))
  else bind (s-handle pub st m tok c) (λ u → s-serve k n1 pub st m tok fd))))











