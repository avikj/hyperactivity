-- 1. Howell-Lafon Rank-8 Non-Commutative Quaternion Product 2*(q * r): 16 muls -> 8 muls (-50%!)
gn-howell8-spec : RProg
gn-howell8-spec =
  rprog #8
    (cons (#8  , gn-dbl (re-v #0))
    (cons (#9  , gn-dbl (re-v #1))
    (cons (#10 , gn-dbl (re-v #2))
    (cons (#11 , gn-dbl (re-v #3)) nil))))
    (cons (re-sub (re-sub (re-sub (re-mul (re-v #8) (re-v #4)) (re-mul (re-v #9) (re-v #5)))
                          (re-mul (re-v #10) (re-v #6))) (re-mul (re-v #11) (re-v #7)))
    (cons (re-sub (re-add (re-add (re-mul (re-v #8) (re-v #5)) (re-mul (re-v #9) (re-v #4)))
                          (re-mul (re-v #10) (re-v #7))) (re-mul (re-v #11) (re-v #6)))
    (cons (re-add (re-add (re-sub (re-mul (re-v #8) (re-v #6)) (re-mul (re-v #9) (re-v #7)))
                          (re-mul (re-v #10) (re-v #4))) (re-mul (re-v #11) (re-v #5)))
    (cons (re-add (re-sub (re-add (re-mul (re-v #8) (re-v #7)) (re-mul (re-v #9) (re-v #6)))
                          (re-mul (re-v #10) (re-v #5))) (re-mul (re-v #11) (re-v #4))) nil))))
