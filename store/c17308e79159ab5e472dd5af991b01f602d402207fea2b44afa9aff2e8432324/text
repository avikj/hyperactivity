vp-thm-pinch-hysteresis-and-90hz :
  let s1 = vp-pinch-step false vp-thumb vp-close
      s2 = vp-pinch-step s1    vp-thumb vp-mid
      s3 = vp-pinch-step s2    vp-thumb vp-far
      s4 = vp-pinch-step s3    vp-thumb vp-mid
  in andB s1
     (andB s2
     (andB (if s3 then false else true)
     (andB (if s4 then false else true)
           (vp-meets-90hz #450 #800 #2100 #300)))) ≡ true
vp-thm-pinch-hysteresis-and-90hz = refl
