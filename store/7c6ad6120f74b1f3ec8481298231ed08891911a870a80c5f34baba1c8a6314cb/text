-- Verifies (1 LHS bulk triangle, 1 RHS bulk triangle, 18 boundary triangles) and
--          (3 LHS bulk tetrahedra, 3 RHS bulk tetrahedra, 9 shared boundary tetrahedra):
r4d-k6-uv-finite :
  (λ tc tetc →
    both (both (eqb (fst tc) 1) (both (eqb (fst (snd tc)) 1) (eqb (snd (snd tc)) 18)))
         (both (eqb (fst tetc) 3) (both (eqb (fst (snd tetc)) 3) (eqb (snd (snd tetc)) 9))))
  (r4d-count-tris-i 6 (0 , (0 , 0)))
  (r4d-count-tets-i 6 (0 , (0 , 0))) ≡ true
r4d-k6-uv-finite = refl
