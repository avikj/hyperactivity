-- THEOREM 10 (Superconducting Zero-Resistance Rational Cayley Unitarity over Z[q, d]):
-- `((q + d)^2 - q^2)^2 + (2*(q + d)*q)^2 == ((q + d)^2 + q^2)^2` holds in EVERY commutative ring!
hxp-thm-supercond-cayley-unitary :
  let q   = pz-var #0
      d   = pz-var #1
      qd  = pz-add q d
      qd2 = pz-mul qd qd
      q2  = pz-mul q q
      a   = pz-sub qd2 q2
      b   = pz-mul hxp-pz-two (pz-mul qd q)
      c   = pz-add qd2 q2
  in pz-eq (pz-add (pz-mul a a) (pz-mul b b)) (pz-mul c c) ≡ true
hxp-thm-supercond-cayley-unitary = refl
