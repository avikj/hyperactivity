usf-superopt : UsfNode → UsfNode
usf-superopt usf-empty           = usf-empty
usf-superopt (usf-seq a b)       = usf-drop-empty-r (usf-superopt a) (usf-superopt b)
usf-superopt (usf-nav p)         = usf-nav p
usf-superopt (usf-splash t s w)  = usf-splash t s w
usf-superopt usf-portal          = usf-portal
usf-superopt (usf-section i l p) = usf-section i l p
usf-superopt (usf-benches i l b) = usf-benches i l b
usf-superopt usf-footer          = usf-footer
