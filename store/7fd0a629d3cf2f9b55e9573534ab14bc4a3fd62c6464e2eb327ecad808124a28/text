-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7580 = tel in let j_7581 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7580 (%wsucc j_7581))))) (λ x_7579 → let mm_7582 = b2-dep mm_ x_7579 in let c = x_7579 in let i_7584 = c in scmd (w-load ((b2-a mm_7582 i_7584))) (λ x_7583 → let mm_7585 = b2-dep mm_7582 x_7583 in let q = x_7583 in let i_7587 = (%wadd c #1) in scmd (w-load ((b2-a mm_7585 i_7587))) (λ x_7586 → let mm_7588 = b2-dep mm_7585 x_7586 in let k = x_7586 in let i_7590 = (%wadd c #2) in scmd (w-load ((b2-a mm_7588 i_7590))) (λ x_7589 → let mm_7591 = b2-dep mm_7588 x_7589 in let i = x_7589 in let i_7593 = (%wadd c #3) in scmd (w-load ((b2-a mm_7591 i_7593))) (λ x_7592 → let mm_7594 = b2-dep mm_7591 x_7592 in let vT = x_7592 in let i_7596 = (%wadd c #4) in scmd (w-load ((b2-a mm_7594 i_7596))) (λ x_7595 → let mm_7597 = b2-dep mm_7594 x_7595 in let s = x_7595 in b2-All mm_7597 q k i vT e s (λ a → let mm_7598 = b2-dep mm_7597 a in b2-telebindg mm_7598 f tel (%wsub j #1) a kq_))))))))
