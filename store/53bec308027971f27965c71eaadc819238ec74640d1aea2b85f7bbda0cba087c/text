bst-bin-cmp : List Bool → List Bool → Nat
bst-bin-cmp a b = case a of
  nil → if bst-all-zero b then 1 else 0
  cons ba ar → case b of
    nil → if both (not ba) (bst-all-zero ar) then 1 else 2
    cons bb br → case bst-bin-cmp ar br of
      zero → zero
      suc n → case n of
        zero → if bit-eq ba bb then 1 else (if bb then 0 else 2)
        suc _ → 2
