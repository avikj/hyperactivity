-- Exact Prime-Music Wave Packet:
--   n-idx     : integer index n in the prime harmonic series
--   prime-p   : exact von Mangoldt prime base p (1 if composite non-prime-power)
--   mu-sgn    : exact Mobius phase polarity (RZ: +1, 0, -1)
--   pitch-hz  : deterministic harmonic frequency mapped from (n, p)
data PrimeWave : Type where
  pwave : (n-idx prime-p : Word) (mu-sgn : RZ) (pitch-hz : Word) → PrimeWave
