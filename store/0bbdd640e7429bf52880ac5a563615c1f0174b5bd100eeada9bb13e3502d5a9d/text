-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_9966 = s in let j_9967 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_9966 (%wadd #2 j_9967))))) (λ x_9965 → let mm_9968 = b2-dep mm_ x_9965 in let fl = x_9965 in kq_ (h4-depl mm_9968 (fl))))
