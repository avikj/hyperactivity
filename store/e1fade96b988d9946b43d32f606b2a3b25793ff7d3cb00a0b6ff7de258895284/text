qent-tr2-B : (I J A : Type) → A → (A → A → A) → (A → A → A) → (I → J → A) → List I → List J → A
qent-tr2-B I J A z add mul psi is js =
  qent-sum J A z add (λ j → qent-sum J A z add (λ l →
    mul (qent-sum I A z add (λ i → mul (psi i j) (psi i l)) is)
        (qent-sum I A z add (λ k → mul (psi k l) (psi k j)) is)) js) js
