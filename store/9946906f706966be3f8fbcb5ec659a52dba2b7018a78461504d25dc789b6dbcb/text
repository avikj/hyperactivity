  grh-ln "        <textarea class='code-ed' id='ed-01' spellcheck='false'>data RZ : Type where&#10;  rz : (sgn : Bool) (mag : Word) → RZ&#10;rz-norm : Bool → Word → RZ&#10;rz-norm s m = if %weq m #0 then rz true #0 else rz s m&#10;rz-neg : RZ → RZ&#10;rz-neg (rz s m) = rz-norm (if s then false else true) m&#10;rz-eqb : Bool → Bool → Bool&#10;rz-eqb true true = true&#10;rz-eqb false false = true&#10;rz-eqb _ _ = false&#10;rz-add : RZ → RZ → RZ&#10;rz-add (rz s1 m1) (rz s2 m2) = if rz-eqb s1 s2 then rz-norm s1 (%wadd m1 m2) else if %wlt m1 m2 then rz-norm s2 (%wsub m2 m1) else rz-norm s1 (%wsub m1 m2)&#10;rz-sub : RZ → RZ → RZ&#10;rz-sub a b = rz-add a (rz-neg b)&#10;rz-mul : RZ → RZ → RZ&#10;rz-mul (rz s1 m1) (rz s2 m2) = rz-norm (rz-eqb s1 s2) (%wmul m1 m2)&#10;rz-eq : RZ → RZ → Bool&#10;rz-eq (rz s1 m1) (rz s2 m2) = if andB (%weq m1 #0) (%weq m2 #0) then true else andB (rz-eqb s1 s2) (%weq m1 m2)&#10;rz-spf-go : Nat → Word → Word → Word&#10;rz-spf-go zero n _ = n&#10;rz-spf-go (suc k) n d = if %wlt n (%wmul d d) then n else if %weq (%wmod n d) #0 then d else rz-spf-go k n (%wsucc d)&#10;rz-spf : Word → Word&#10;rz-spf n = if %wlt n #2 then n else rz-spf-go (toNat n) n #2&#10;rz-mu-go : Nat → Word → RZ → RZ&#10;rz-mu-go zero _ acc = acc&#10;rz-mu-go (suc k) n acc = if %wlt n #2 then acc else let p = rz-spf n in let q = %wdiv n p in if %weq (%wmod q p) #0 then rz true #0 else rz-mu-go k q (rz-neg acc)&#10;rz-mu : Word → RZ&#10;rz-mu n = if %weq n #0 then rz true #0 else rz-mu-go (toNat n) n (rz true #1)&#10;rz-conv-go : Nat → (Word → RZ) → (Word → RZ) → Word → Word → RZ → RZ&#10;rz-conv-go zero _ _ _ _ acc = acc&#10;rz-conv-go (suc k) f g n d acc = rz-conv-go k f g n (%wsucc d) (if %weq (%wmod n d) #0 then rz-add acc (rz-mul (f d) (g (%wdiv n d))) else acc)&#10;rz-all-upto-go : Nat → Word → (Word → Bool) → Bool&#10;rz-all-upto-go zero _ _ = true&#10;rz-all-upto-go (suc k) cur p = if p cur then rz-all-upto-go k (%wsucc cur) p else false&#10;rz-all-upto : Word → (Word 