b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10198 = cs in let j_10199 = j in scmd (w-load ((b2-a mm_ (%wadd v_10198 #2)))) (λ d_10196 → let mm_10200 = b2-dep mm_ d_10196 in scmd (w-load ((b2-a mm_10200 (%wadd d_10196 (%wsucc j_10199))))) (λ x_10197 → let mm_10201 = b2-dep mm_10200 x_10197 in let c = x_10197 in let t_10203 = c in let j_10204 = #0 in scmd (w-load ((b2-a mm_10201 (%wadd t_10203 (%wadd #2 j_10204))))) (λ x_10202 → let mm_10205 = b2-dep mm_10201 x_10202 in let ck = x_10202 in if (%weq ck k) then (kq_ (h4-depl mm_10205 (c))) else (b2-ctrfind mm_10205 f cs k (%wsucc j) n kq_)))))
