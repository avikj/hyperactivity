ga-lem-mk-and : (env : Nat → Bool) → (a b : GaGuard) → ga-eval env (ga-mk-and a b) ≡ ga-andB (ga-eval env a) (ga-eval env b)
ga-lem-mk-and env (ga-k false)     b            = refl
ga-lem-mk-and env (ga-k true)      b            = refl
ga-lem-mk-and env (ga-v i)         (ga-k false) = ga-sym (ga-lem-and-false-r (env i))
ga-lem-mk-and env (ga-v i)         (ga-k true)  = ga-sym (ga-lem-and-true-r (env i))
ga-lem-mk-and env (ga-v i)         (ga-v j)     = ga-lem-and-guard env (ga-v i) (ga-v j)
ga-lem-mk-and env (ga-v i)         (ga-not b)   = ga-lem-and-guard env (ga-v i) (ga-not b)
ga-lem-mk-and env (ga-v i)         (ga-and b1 b2) = ga-lem-and-guard env (ga-v i) (ga-and b1 b2)
ga-lem-mk-and env (ga-v i)         (ga-ite c t f) = ga-lem-and-guard env (ga-v i) (ga-ite c t f)
ga-lem-mk-and env (ga-not a)       (ga-k false) = ga-sym (ga-lem-and-false-r (ga-eval env (ga-not a)))
ga-lem-mk-and env (ga-not a)       (ga-k true)  = ga-sym (ga-lem-and-true-r (ga-eval env (ga-not a)))
ga-lem-mk-and env (ga-not a)       (ga-v j)     = ga-lem-and-guard env (ga-not a) (ga-v j)
ga-lem-mk-and env (ga-not a)       (ga-not b)   = ga-lem-and-guard env (ga-not a) (ga-not b)
ga-lem-mk-and env (ga-not a)       (ga-and b1 b2) = ga-lem-and-guard env (ga-not a) (ga-and b1 b2)
ga-lem-mk-and env (ga-not a)       (ga-ite c t f) = ga-lem-and-guard env (ga-not a) (ga-ite c t f)
ga-lem-mk-and env (ga-and a1 a2)   (ga-k false) = ga-sym (ga-lem-and-false-r (ga-eval env (ga-and a1 a2)))
ga-lem-mk-and env (ga-and a1 a2)   (ga-k true)  = ga-sym (ga-lem-and-true-r (ga-eval env (ga-and a1 a2)))
ga-lem-mk-and env (ga-and a1 a2)   (ga-v j)     = ga-lem-and-guard env (ga-and a1 a2) (ga-v j)
ga-lem-mk-and env (ga-and a1 a2)   (ga-not b)   = ga-lem-and-guard env (ga-and a1 a2) (ga-not b)
ga-lem-mk-and env (ga-and a1 a2)   (ga-and b1 b2) = ga-lem-and-guard env (ga-and a1 a2) (ga-and b1 b2)
ga-lem-mk-and env (ga-and a1 a2)   (ga-ite c t f) = ga-lem-and-guard env (ga-and a1 a2) (ga-ite c t f)
ga-lem-mk-and env (ga-ite c1 t1 f1) (ga-k false) = ga-sym (ga-lem-and-false-r (ga-eval env (ga-ite c1 t1 f1)))
ga-lem-mk-and env (ga-ite c1 t1 f1) (ga-k true)  = ga-sym (ga-lem-and-true-r (ga-eval env (ga-ite c1 t1 f1)))
ga-lem-mk-and env (ga-ite c1 t1 f1) (ga-v j)     = ga-lem-and-guard env (ga-ite c1 t1 f1) (ga-v j)
ga-lem-mk-and env (ga-ite c1 t1 f1) (ga-not b)   = ga-lem-and-guard env (ga-ite c1 t1 f1) (ga-not b)
ga-lem-mk-and env (ga-ite c1 t1 f1) (ga-and b1 b2) = ga-lem-and-guard env (ga-ite c1 t1 f1) (ga-and b1 b2)
ga-lem-mk-and env (ga-ite c1 t1 f1) (ga-ite c t f) = ga-lem-and-guard env (ga-ite c1 t1 f1) (ga-ite c t f)
