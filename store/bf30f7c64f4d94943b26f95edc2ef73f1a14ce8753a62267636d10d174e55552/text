-- task i before task j
h4-qlt : Word → Word → Word → (Bool → Step W Word) → Step W Word
h4-qlt m i j k =
  scmd (w-load ((h4-qa m i #0))) (λ ki → let m3146 = h4-dep m ki in scmd (w-load ((h4-qa m3146 i #1))) (λ ci → let m3147 = h4-dep m3146 ci in scmd (w-load ((h4-qa m3147 i #2))) (λ si → let m3148 = h4-dep m3147 si in scmd (w-load ((h4-qa m3148 j #0))) (λ kj → let m3149 = h4-dep m3148 kj in scmd (w-load ((h4-qa m3149 j #1))) (λ cj → let m3150 = h4-dep m3149 cj in scmd (w-load ((h4-qa m3150 j #2))) (λ sj → let m3151 = h4-dep m3150 sj in let a = h4-okey ki ci in let b = h4-okey kj cj in k (h4-depl m3151 ((the Bool (if %weq a b then %wlt si sj else %wlt a b))))))))))
