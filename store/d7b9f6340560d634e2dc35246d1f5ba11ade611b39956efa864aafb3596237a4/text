-- ── 4. Semiclassical 4-Simplex {15j} Spin-Foam -> Macroscopic Acoustic Lattice
-- In the semiclassical Regge limit of 4-simplex {15j} amplitudes, each triangle face f
-- carries doubled-spin area A_f = d_f + 1 > 0 coupling adjacent 4-simplex phases (phi_u, phi_v).
-- Exact quadratic form identity over Q:
--   phi_u * (d + 1)*(phi_u - phi_v) + phi_v * (d + 1)*(phi_v - phi_u) == (d + 1) * (phi_u - phi_v)^2 >= 0!
-- Proves spin-foam face area A_f = d_f + 1 IS the Port-Hamiltonian acoustic edge stiffness w_{uv}!
-- Variables (0..2): d, pu, pv.
uf-regge-laplacian-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
uf-regge-laplacian-poly A ad mu q vs =
  (λ g sub sq →
    let d = g 0; pu = g 1; pv = g 2
        area = ad d (q (fn-q 1 1))
        lhs  = ad (mu pu (mu area (sub pu pv))) (mu pv (mu area (sub pv pu)))
        rhs  = mu area (sq (sub pu pv))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
