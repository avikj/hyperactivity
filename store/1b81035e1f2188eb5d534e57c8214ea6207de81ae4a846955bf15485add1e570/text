b2-name : Word → Word → (Word → Step W Word) → Step W Word
b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_6765 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6765 b2-ERR)) else (b2-iskw mm_6765 k (λ kw → let mm_6766 = b2-dpb mm_6765 kw in if (kw) then (b2-nbytes mm_6766 k (λ kb → let mm_6767 = b2-dpl mm_6766 kb in let p_6769 = p in let i_6771 = (%wadd p_6769 #1) in scmd (w-load ((b2-a mm_6767 i_6771))) (λ x_6770 → let mm_6772 = b2-dep mm_6767 x_6770 in let x_6768 = x_6770 in let i = x_6768 in let p_6774 = p in let i_6776 = (%wadd p_6774 #1) in scmd (w-load ((b2-a mm_6772 i_6776))) (λ x_6775 → let mm_6777 = b2-dep mm_6772 x_6775 in let x_6773 = x_6775 in let ixq = x_6773 in b2-pfail mm_6777 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6778 = b2-dep mm_6777 r in kq_ (h4-depl mm_6778 (r))))))) else (kq_ (h4-depl mm_6766 (k))))))
