b2-pmarkg : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pmarkg mm_ zero rs j n q kq_ =
  kq_ (h4-depl mm_ (q))
b2-pmarkg mm_ (suc f) rs j n q kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (q))) else (let a_5724 = rs in let j_5725 = j in scmd (w-load ((b2-a mm_ (%wadd a_5724 (%wsucc j_5725))))) (λ x_5723 → let mm_5726 = b2-dep mm_ x_5723 in let row = x_5723 in let t_5728 = row in let j_5729 = #0 in scmd (w-load ((b2-a mm_5726 (%wadd t_5728 (%wadd #2 j_5729))))) (λ x_5727 → let mm_5730 = b2-dep mm_5726 x_5727 in let ps = x_5727 in let a_5732 = ps in let j_5733 = #0 in scmd (w-load ((b2-a mm_5730 (%wadd a_5732 (%wsucc j_5733))))) (λ x_5731 → let mm_5734 = b2-dep mm_5730 x_5731 in let p0 = x_5731 in let t_5736 = p0 in scmd (w-load ((b2-a mm_5734 t_5736))) (λ x_5735 → let mm_5737 = b2-dep mm_5734 x_5735 in let tg = (%wand x_5735 #255) in if (%weq tg b2-PVAR) then (let t_5739 = p0 in let j_5740 = #2 in scmd (w-load ((b2-a mm_5737 (%wadd t_5739 (%wadd #2 j_5740))))) (λ x_5738 → let mm_5741 = b2-dep mm_5737 x_5738 in let pq = x_5738 in b2-pmarkg mm_5741 f rs (%wsucc j) n (b2-qjoin q pq) kq_)) else (b2-pmarkg mm_5737 f rs (%wsucc j) n q kq_))))))
