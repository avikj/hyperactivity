h4-ctr : Word → Word → List Word → (Word → Step W Word) → Step W Word
h4-ctr mm_ nam xs kq_ =
  let n = cli-len xs in if (%weq n #0) then (kq_ (h4-depl mm_ ((h4-new h4-C00 nam #0)))) else (h4-alloc mm_ n (λ at → let mm_31 = h4-dep mm_ at in h4-wrs mm_31 (toNat #17) at xs (λ e → let mm_32 = h4-dep mm_31 e in kq_ (h4-depl mm_32 ((h4-new (%wadd h4-C00 n) nam (h4-depl e at)))))))
