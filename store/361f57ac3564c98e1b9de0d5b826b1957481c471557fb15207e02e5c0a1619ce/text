psc-mac4-zip : Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word → Word
psc-mac4-zip sm0 sm1 sm2 sm3 e0 e1 e2 e3 x0 x1 x2 x3 acc =
  let w0 = psc-bf16-unpack sm0 #0 e0 #0
      w1 = psc-bf16-unpack sm1 #1 e1 #0
      w2 = psc-bf16-unpack sm2 #2 e2 #0
      w3 = psc-bf16-unpack sm3 #15 #0 e3
  in %wadd acc (psc-mac4-raw w0 w1 w2 w3 x0 x1 x2 x3)
