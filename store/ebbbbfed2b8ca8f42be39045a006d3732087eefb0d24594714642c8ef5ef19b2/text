-- Exact rational Racah sum W(J1, J2, J3; J4, J5, J6) in BQ (doubled spins); {6j} = Delta1*Delta2*Delta3*Delta4 * W.
sf-racah-W : Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-racah-W j1 j2 j3 j4 j5 j6 =
  if both (both (tri-ok j1 j2 j3) (tri-ok j1 j5 j6)) (both (tri-ok j4 j2 j6) (tri-ok j4 j5 j3))
  then sf-racah-from
    (nat-half (plus (plus j1 j2) j3))
    (nat-half (plus (plus j1 j5) j6))
    (nat-half (plus (plus j4 j2) j6))
    (nat-half (plus (plus j4 j5) j3))
    (nat-half (plus (plus j1 j2) (plus j4 j5)))
    (nat-half (plus (plus j2 j3) (plus j5 j6)))
    (nat-half (plus (plus j3 j1) (plus j6 j4)))
  else bq-zero
