ief-expfix : Word × List Word → Word
ief-expfix z =
  let l2 = ief-ln2-P
      nq = fst (bg-divmod (bg-add (bg-shl1 (snd z)) l2) (bg-shl1 l2))
      nw = bg-lo nq
      r = sx-add z (sx-neg (fst z , bg-mul nq l2))
      ex = ief-ex-ser ief-fuel #1 (snd r) (snd r) (fst r) (#0 , nil)
      e1 = sx-add ex (#0 , bg-pow2 ief-P)
  in ief-fixn #0 (snd e1) (if %weq (fst z) #1 then %wsub #4096 nw else %wadd #4096 nw)
