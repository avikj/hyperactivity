-- the etymology section: after <h4>Etymology…</h4>, up to the section's end
e-ety-at : (List Word → Sum Unit (List Word)) → Sum Unit (List Word) → Sum Unit (List Word)
e-ety-at k (inl u) = inl unit
e-ety-at k (inr r) = if andB (h-prefix "</h4>" (h-drop (e-upto-c #60 r) r)) (h-infix "</section>" r)
  then inr (e-upto "</section>" (h-drop "</h4>" (h-drop (e-upto-c #60 r) r))) else k r
