b2-anynq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-anynq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-anynq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_8092 = tel in let j_8093 = j in scmd (w-load ((b2-a mm_ (%wadd a_8092 (%wsucc j_8093))))) (λ x_8091 → let mm_8094 = b2-dep mm_ x_8091 in let c = x_8091 in let i_8096 = (%wadd c #3) in scmd (w-load ((b2-a mm_8094 i_8096))) (λ x_8095 → let mm_8097 = b2-dep mm_8094 x_8095 in let vT = x_8095 in let t_8099 = vT in scmd (w-load ((b2-a mm_8097 t_8099))) (λ x_8098 → let mm_8100 = b2-dep mm_8097 x_8098 in let tg = (%wand x_8098 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_8100 (#1))) else (b2-anynq mm_8100 f tel (%wsucc j) n kq_)))))
