-- If two INet processes lhs, rhs agree on all environments, replacing lhs by rhs inside ANY meta-tower preserves semantics!
bst-thm-law-sound : (lhs rhs : INet) →
  ((env : Word → Bool) → in-eval env lhs ≡ in-eval env rhs) →
  (env : Word → Bool) → in-eval env (in-hyper-tower sc-n3 in-step lhs) ≡ in-eval env rhs
bst-thm-law-sound lhs rhs h env =
  web-trans-b (tw-thm-hyper-tower-sound sc-n3 in-step tw-thm-step-sound env lhs) (h env)
