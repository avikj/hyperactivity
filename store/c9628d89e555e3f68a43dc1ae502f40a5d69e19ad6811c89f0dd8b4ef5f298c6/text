b2-ploop : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-ploop mm_ zero p kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ploop mm_ (suc f) p kq_ =
  b2-pitem mm_ p (λ dd_13800 → let mm_13801 = b2-dep mm_ dd_13800 in scmd (w-load ((b2-HR mm_13801 #28))) (λ r → let mm_13802 = b2-dep mm_13801 r in if (%weq r #1) then (b2-ploop mm_13802 f p kq_) else (kq_ (h4-depl mm_13802 (r)))))
