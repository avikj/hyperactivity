b2-scopy : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-scopy mm_ zero src dst j off n kq_ =
  kq_ (h4-depl mm_ (dst))
b2-scopy mm_ (suc f) src dst j off n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (dst))) else (let a_227 = src in let j_228 = j in scmd (w-load ((b2-a mm_ (%wadd a_227 (%wsucc j_228))))) (λ x_226 → let mm_229 = b2-dep mm_ x_226 in let x = x_226 in let a_230 = dst in let j_231 = (%wadd off j) in let v_232 = x in scmd (w-store ((b2-a mm_229 (%wadd a_230 (%wsucc j_231)))) (v_232)) (λ uu_233 → let mm_234 = hv2-u mm_229 uu_233 in b2-scopy mm_234 f src dst (%wsucc j) off n kq_)))
