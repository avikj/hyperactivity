rqm-imul : Int → Int → Int
rqm-imul x y = case x of
  pos a → case y of
    pos b → pos (times a b)
    negsuc b → case a of
      zero → pos zero
      suc a1 → negsuc (plus b (times a1 (suc b)))
  negsuc a → case y of
    pos b → case b of
      zero → pos zero
      suc b1 → negsuc (plus a (times b1 (suc a)))
    negsuc b → pos (times (suc a) (suc b))
