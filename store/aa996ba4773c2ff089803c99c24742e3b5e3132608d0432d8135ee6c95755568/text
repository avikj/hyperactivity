-- Exact rational node weight for anisotropic tetrahedron (fa, fb | k | fc, fd) at internal (ip, im):
sf2-opt-wt-gen : Sf2Face → Sf2Face → Sf2Face → Sf2Face → Nat → Nat → Nat → BQ → BQ → BQ
sf2-opt-wt-gen fa fb fc fd k ip im w9a w9b =
  bq-mul
    (bq-mul (sf-bq-of-nat (times (suc ip) (suc im))) (sf-delta2 ip im k))
    (bq-mul
      (bq-mul (bq-mul (sf-delta2 (sf2-Jp fa) (sf2-Jp fb) ip) (sf-delta2 (sf2-Jp fc) (sf2-Jp fd) ip))
              (bq-mul (sf-delta2 (sf2-Jm fa) (sf2-Jm fb) im) (sf-delta2 (sf2-Jm fc) (sf2-Jm fd) im)))
      (bq-mul w9a w9b))
