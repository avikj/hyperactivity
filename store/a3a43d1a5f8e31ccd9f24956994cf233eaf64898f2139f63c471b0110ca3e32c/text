b2-uclose mm_ bk ctx us i k q s def kq_ =
  b2-pget mm_ (toNat #64) us i (λ o → let mm_9998 = b2-dep mm_ o in let u = the Word (if %weq o hv2-none then b2-NONE else o) in if (not (%weq (b2-qjoin u q) q)) then (b2-nbytes mm_9998 k (λ kb → let mm_9999 = b2-dpl mm_9998 kb in let obs = the (List Word) (if %weq u b2-MANY then list-append kb " (consumed more than once)" else list-append (b2-qshow u) kb) in b2-msg mm_9999 obs (λ ob → let mm_10000 = b2-dep mm_9999 ob in b2-fail mm_10000 bk ctx (list-append (b2-qshow q) kb) ob s def (λ r → let mm_10001 = b2-dep mm_10000 r in kq_ (h4-depl mm_10001 (r)))))) else (if (%weq o hv2-none) then (kq_ (h4-depl mm_9998 (us))) else (b2-pset mm_9998 (toNat #64) us i b2-NONE (λ r → let mm_10002 = b2-dep mm_9998 r in kq_ (h4-depl mm_10002 (r))))))
