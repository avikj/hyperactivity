sfc-baddc : Bool → List Bool → List Bool → List Bool
sfc-baddc c a b = case a of
  nil → if c then sfc-bsucc b else b
  cons x xs → case b of
    nil → if c then sfc-bsucc (cons x xs) else cons x xs
    cons y ys →
      cons (bit-eq (bit-eq x y) c)
           (sfc-baddc (if x then (if y then true else c) else (if y then c else false)) xs ys)
