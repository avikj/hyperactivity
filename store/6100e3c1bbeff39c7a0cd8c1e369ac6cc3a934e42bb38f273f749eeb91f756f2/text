-- / : the paper, then every published work by its kind (s-published), then the knowledge base
s-front : Proc W (List Word)
s-front = bind (s-section "papers" "Papers" (s-of-kind wk-paper s-published)) (λ a → bind (s-section "essays" "Essays" (s-of-kind wk-essay s-published)) (λ b → bind (s-section "notes" "Notes" (s-of-kind wk-note s-published)) (λ c → bind (s-section "records" "Records and reports" (s-of-kind wk-record s-published)) (λ d →
  ret {lzero} {W} (s-response s-html (h-concat (cons s-home-head (cons sx-box (cons a (cons b (cons c (cons d (cons "<div class='section' id='knowledge'>The knowledge base</div><ul class='list'><li><a href='/synesthesia'>Synthetic synesthesia<span class='kind'>text as Avik sees it</span></a></li></ul><footer>Served by hyperactive, from its own source.</footer></main></body></html>" nil)))))))))))))
