boc-le-trans : (a b c : Nat) → boc-le-nat a b ≡ true → boc-le-nat b c ≡ true → boc-le-nat a c ≡ true
boc-le-trans zero    _       _       _   _   = refl
boc-le-trans (suc _) zero    _       hab _   = Empty-rec (true≢false (boc-sym hab))
boc-le-trans (suc _) (suc _) zero    _   hbc = Empty-rec (true≢false (boc-sym hbc))
boc-le-trans (suc a) (suc b) (suc c) hab hbc = boc-le-trans a b c hab hbc
