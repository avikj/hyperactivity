s-answer-hx : List Word → Proc W (List Word) → Proc W (List Word)
s-answer-hx p next =
  if h-eq p "/hx/being.css" then ret {lzero} {W} (s-response "text/css; charset=utf-8" being-compiled-css) else
  if h-eq p "/hx/being-field.wasm" then ret {lzero} {W} (s-response "application/wasm" being-field-wasm) else
  if h-eq p "/hx/being-spec.json" then ret {lzero} {W} (s-response "application/json" being-default-json) else
  if h-eq p "/hx/psc1.wasm" then ret {lzero} {W} (s-response "application/wasm" psc-wasm-bytes) else
  if h-eq p "/hx/psc1.gds" then ret {lzero} {W} (s-response "application/octet-stream" psc-gds6-bytes) else
  if h-eq p "/hx/psc1-spec.json" then ret {lzero} {W} (s-response "application/json" psc-spec-json) else
  if h-eq p "/hx/hyperinet-opt.wasm" then ret {lzero} {W} (s-response "application/wasm" io-wasm-bytes) else
  if h-eq p "/hx/hyperinet-opt.gds" then ret {lzero} {W} (s-response "application/octet-stream" io-gds6-bytes) else
  if h-eq p "/hx/hyperinet-opt-spec.json" then ret {lzero} {W} (s-response "application/json" io-spec-json) else
  if h-eq p "/hx/meta-inet.wasm" then ret {lzero} {W} (s-response "application/wasm" ms-wasm-bytes) else
  if h-eq p "/hx/meta-inet.gds" then ret {lzero} {W} (s-response "application/octet-stream" ms-gds6-bytes) else
  if h-eq p "/hx/meta-inet-spec.json" then ret {lzero} {W} (s-response "application/json" ms-spec-json) else
  if h-eq p "/hx/this-prefix.txt" then bind (h-document "docs/this-prefix.txt") (λ t → ret (s-response "text/plain; charset=utf-8" (s-or nil t))) else
  if h-eq p "/hx/lens.css" then bind (h-document "docs/hx-lens.css") (λ t → ret (s-response "text/css; charset=utf-8" (s-or nil t))) else
  if h-eq p "/hx/lens.js" then bind (h-document "docs/hx-lens.js") (λ t → ret (s-response "application/javascript; charset=utf-8" (s-or nil t))) else
  if h-eq p "/hx/oracle.js" then bind (h-document "docs/hx-oracle.js") (λ t → ret (s-response "application/javascript; charset=utf-8" (s-or nil t))) else
  if h-eq p "/hx/mesh.js" then bind (h-document "docs/hx-mesh.js") (λ t → ret (s-response "application/javascript; charset=utf-8" (s-or nil t))) else
  s-answer-supercomp p next
