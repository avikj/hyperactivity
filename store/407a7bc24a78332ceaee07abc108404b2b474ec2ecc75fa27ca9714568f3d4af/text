b2-acopy : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-acopy mm_ zero src dst j off n kq_ =
  kq_ (h4-depl mm_ (dst))
b2-acopy mm_ (suc f) src dst j off n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (dst))) else (let a_2724 = src in let j_2725 = j in scmd (w-load ((b2-a mm_ (%wadd a_2724 (%wsucc j_2725))))) (λ x_2723 → let mm_2726 = b2-dep mm_ x_2723 in let x = x_2723 in let a_2727 = dst in let j_2728 = (%wadd off j) in let v_2729 = x in scmd (w-store ((b2-a mm_2726 (%wadd a_2727 (%wsucc j_2728)))) (v_2729)) (λ uu_2730 → let mm_2731 = hv2-u mm_2726 uu_2730 in b2-acopy mm_2731 f src dst (%wsucc j) off n kq_)))
