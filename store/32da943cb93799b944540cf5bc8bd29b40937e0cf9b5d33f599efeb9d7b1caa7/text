-- Export 4: hx_market_holonomy(pa=0, pb=1, pc=2, fee=3) -> i32
tir-wf-mkt : List Word
tir-wf-mkt =
  let locHdr = the (List Word) (cons #1 (cons #3 (cons #127 nil)))
      m1     = tir-sel (pw-get #1) (pw-get #0) (pw-bin #73 (pw-get #0) (pw-get #1))
      setHi  = list-append (tir-sel (pw-get #2) m1 (pw-bin #73 m1 (pw-get #2))) (pw-set #4)
      n1     = tir-sel (pw-get #0) (pw-get #1) (pw-bin #73 (pw-get #0) (pw-get #1))
      setLo  = list-append (tir-sel n1 (pw-get #2) (pw-bin #73 n1 (pw-get #2))) (pw-set #5)
      setGr  = list-append (pw-bin #107 (pw-get #4) (pw-get #5)) (pw-set #6)
      pos    = pw-bin #73 (pw-get #3) (pw-get #6)
      res    = tir-sel (pw-bin #107 (pw-get #6) (pw-get #3)) (pw-c #0) pos
  in pw-cat (cons locHdr (cons setHi (cons setLo (cons setGr (cons res (cons (pw-op #11) nil))))))
