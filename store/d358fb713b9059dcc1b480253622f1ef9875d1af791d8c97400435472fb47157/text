b2-name : Word → Word → (Word → Step W Word) → Step W Word
b2-name mm_ p kq_ =
  b2-lexeme mm_ p (λ k → let mm_6633 = b2-dep mm_ k in if (%weq k b2-ERR) then (kq_ (h4-depl mm_6633 b2-ERR)) else (b2-iskw mm_6633 k (λ kw → let mm_6634 = b2-dpb mm_6633 kw in if (kw) then (b2-nbytes mm_6634 k (λ kb → let mm_6635 = b2-dpl mm_6634 kb in let p_6637 = p in let i_6639 = (%wadd p_6637 #1) in scmd (w-load ((b2-a mm_6635 i_6639))) (λ x_6638 → let mm_6640 = b2-dep mm_6635 x_6638 in let x_6636 = x_6638 in let i = x_6636 in let p_6642 = p in let i_6644 = (%wadd p_6642 #1) in scmd (w-load ((b2-a mm_6640 i_6644))) (λ x_6643 → let mm_6645 = b2-dep mm_6640 x_6643 in let x_6641 = x_6643 in let ixq = x_6641 in b2-pfail mm_6645 p (list-append "a name (got the keyword '" (list-append kb "')")) (%wsub i (cli-len kb)) ixq (λ r → let mm_6646 = b2-dep mm_6645 r in kq_ (h4-depl mm_6646 (r))))))) else (kq_ (h4-depl mm_6634 (k))))))
