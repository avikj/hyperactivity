grv-s3j-loop : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat × Nat → Nat × Nat
grv-s3j-loop fuel a1 a2 a3 m1 c1 m2 k acc = case fuel of
  zero → acc
  suc rem →
    (λ term →
      grv-s3j-loop rem a1 a2 a3 m1 c1 m2 (suc k)
        (if odd k then (fst acc , plus (snd acc) term) else (plus (fst acc) term , snd acc)))
    (times (grv-six-div (times (grv-fact-small k) (grv-fact-small (monus a1 k))))
      (times (grv-six-div (times (grv-fact-small (monus a2 k)) (grv-fact-small (monus (plus k m1) a1))))
             (grv-six-div (times (grv-fact-small (monus a3 k)) (grv-fact-small (monus (plus k c1) m2))))))
