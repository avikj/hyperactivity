  class HxMesh {
    constructor(opts = {}) {
      this.peerId = 'hx_' + Math.random().toString(36).slice(2, 10);
      this.signalBase = opts.signalBase || '';
      this.peers = new Map(); // remoteId -> { pc, dc, state, rtt }
      this.outbox = new Map(); // remoteId -> { kind, sdp, ts } (bundled in every heartbeat so offers/answers are never clobbered!)
      this.atlas = new Map(); // ttHex -> { name, tt, cost, gates, peerId, verified }
      this.casPeers = new Set();
      this.listeners = new Set();
      this.stats = { evals: 0, identities: 0, u4n: 0, gossipsRx: 0, gossipsTx: 0, verifiedRx: 0, rejectedRx: 0 };
      this.mode = opts.mode || 'idle';
      this.worker = null;
      this.pollTimer = null;
    }

    onUpdate(fn) { this.listeners.add(fn); return () => this.listeners.delete(fn); }
    emit(ev) { for (const fn of this.listeners) try { fn(ev, this.snapshot()); } catch (_) {} }

    snapshot() {
      const peerList = [];
      for (const [id, p] of this.peers) peerList.push({ id, state: p.state });
      const atlasArr = Array.from(this.atlas.values()).sort((a, b) => a.name.localeCompare(b.name));
      return {
        peerId: this.peerId,
        mode: this.mode,
        peers: peerList,
        atlas: atlasArr,
        stats: { ...this.stats }
      };
    }

    // CRDT Join-Semilattice Merge (eg-thm-min-comm/idem/le): strictly verified + strictly min cost!
    mergeDiscovery(d, fromPeer) {
      if (!d || !d.tt || !d.gates) return false;
      if (!verifyNand64(d.gates, d.tt)) {
        this.stats.rejectedRx++;
        this.emit({ type: 'rejected', fromPeer, name: d.name });
        return false;
      }
      if (fromPeer !== this.peerId) this.stats.verifiedRx++;
      const prev = this.atlas.get(d.tt);
      if (!prev || d.gates.length < prev.cost) {
        const entry = {
          name: d.name || ('fn_' + d.tt.slice(0, 8)),
          tt: d.tt,
          cost: d.gates.length,
          gates: d.gates,
          peerId: d.peerId || fromPeer,
          verified: true,
          ts: Date.now()
        };
        this.atlas.set(d.tt, entry);
        this.gossip({ type: 'discovery', ...entry }, fromPeer);
        this.emit({ type: 'merged', entry });
        return true;
      }
      return false;
    }

    gossip(msg, excludePeer) {
      const raw = JSON.stringify(msg);
      for (const [id, p] of this.peers) {
        if (id === excludePeer) continue;
        if (p.dc && p.dc.readyState === 'open') {
          try { p.dc.send(raw); this.stats.gossipsTx++; } catch (_) {}
        }
      }
    }

    setMode(m) {
      this.mode = m;
      if (this.worker) this.worker.postMessage({ mode: m });
      this.emit({ type: 'mode', mode: m });
    }

    startWorker() {
      if (this.worker || typeof Worker === 'undefined') return;
      const blob = new Blob([WORKER_SRC], { type: 'application/javascript' });
      this.worker = new Worker(URL.createObjectURL(blob));
      this.worker.postMessage({ mode: this.mode });
      this.worker.onmessage = (e) => {
        const m = e.data;
        if (!m) return;
        if (m.type === 'discovery') {
          this.mergeDiscovery({ ...m, peerId: this.peerId }, this.peerId);
        } else if (m.type === 'u4_done' || m.type === 'stats') {
          this.stats.evals = m.evals;
          this.stats.identities = m.identities;
          this.stats.u4n = m.u4n;
          this.emit({ type: 'stats' });
        }
      };
    }

    // WebRTC Signaling via Hyperactivity's existing stateless /api/p2p/signal?id=<peer>
    async postSignal(payload) {
      try {
        const res = await fetch(this.signalBase + '/api/p2p/signal?id=' + encodeURIComponent(this.peerId), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) return [];
        const j = await res.json();
        return Array.isArray(j.peers) ? j.peers : [];
      } catch (_) {
        return [];
      }
    }

    wireChannel(remoteId, pc, dc) {
      const rec = this.peers.get(remoteId) || { pc, dc, state: 'connecting' };
      rec.dc = dc;
      this.peers.set(remoteId, rec);
      dc.onopen = () => {
        rec.state = 'open';
        // Sync our verified CRDT atlas immediately upon link up!
        for (const entry of this.atlas.values()) {
          try { dc.send(JSON.stringify({ type: 'discovery', ...entry })); this.stats.gossipsTx++; } catch (_) {}
        }
        this.emit({ type: 'peer_open', remoteId });
      };
      dc.onclose = () => { rec.state = 'closed'; this.peers.delete(remoteId); this.emit({ type: 'peer_closed', remoteId }); };
      dc.onmessage = (ev) => {
        this.stats.gossipsRx++;
        try {
          const msg = JSON.parse(ev.data);
          if (msg.type === 'discovery') this.mergeDiscovery(msg, remoteId);
        } catch (_) {}
      };
    }

    async initiateOffer(remoteId) {
      if (this.peers.has(remoteId) || this.peers.size >= MAX_PEERS) return;
      const pc = new RTCPeerConnection({ iceServers: ICE_SERVERS });
      const dc = pc.createDataChannel('hx-p2p-atlas');
      this.peers.set(remoteId, { pc, dc, state: 'offering' });
      this.wireChannel(remoteId, pc, dc);
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      await new Promise((r) => {
        if (pc.iceGatheringState === 'complete') return r();
        const t = setTimeout(r, 1200);
        pc.onicegatheringstatechange = () => { if (pc.iceGatheringState === 'complete') { clearTimeout(t); r(); } };
      });
      this.outbox.set(remoteId, { kind: 'offer', sdp: pc.localDescription.sdp, ts: Date.now() });
      await this.pollRendezvous();
    }

    async handleOffer(remoteId, sdp) {
      if (this.peers.has(remoteId) || this.peers.size >= MAX_PEERS) return;
      const pc = new RTCPeerConnection({ iceServers: ICE_SERVERS });
      this.peers.set(remoteId, { pc, dc: null, state: 'answering' });
      pc.ondatachannel = (ev) => this.wireChannel(remoteId, pc, ev.channel);
      await pc.setRemoteDescription({ type: 'offer', sdp });
      const ans = await pc.createAnswer();
      await pc.setLocalDescription(ans);
      await new Promise((r) => {
        if (pc.iceGatheringState === 'complete') return r();
        const t = setTimeout(r, 1200);
        pc.onicegatheringstatechange = () => { if (pc.iceGatheringState === 'complete') { clearTimeout(t); r(); } };
      });
      this.outbox.set(remoteId, { kind: 'answer', sdp: pc.localDescription.sdp, ts: Date.now() });
      await this.pollRendezvous();
    }

    async pollRendezvous() {
      // Prune completed or stale outbox signals (>45s)
      const now = Date.now();
      const signals = {};
      for (const [to, sig] of this.outbox) {
        const rec = this.peers.get(to);
        if (now - sig.ts > 45000 || (rec && rec.state === 'open')) { this.outbox.delete(to); continue; }
        signals[to] = sig;
      }
      const peers = await this.postSignal({ id: this.peerId, kind: 'hello', atlas_cnt: this.atlas.size, signals, ts: now });
      for (const raw of peers) {
        let msg = raw;
        if (typeof raw === 'string') { try { msg = JSON.parse(raw); } catch (_) { continue; } }
        if (!msg || !msg.id || msg.id === this.peerId) continue;
        const forMe = msg.signals && msg.signals[this.peerId];
        if (forMe && forMe.kind === 'offer' && forMe.sdp) {
          this.handleOffer(msg.id, forMe.sdp).catch(() => {});
        } else if (forMe && forMe.kind === 'answer' && forMe.sdp) {
          const rec = this.peers.get(msg.id);
          if (rec && rec.pc && rec.pc.signalingState === 'have-local-offer') {
            rec.pc.setRemoteDescription({ type: 'answer', sdp: forMe.sdp }).catch(() => {});
          }
        } else if (this.peerId < msg.id && !this.peers.has(msg.id) && typeof RTCPeerConnection !== 'undefined') {
          this.initiateOffer(msg.id).catch(() => {});
        }
      }
      this.emit({ type: 'poll' });
    }

    start() {
      this.startWorker();
      this.pollRendezvous();
      this.pollTimer = setInterval(() => this.pollRendezvous(), 6000);
      return this;
    }

    stop() {
      if (this.pollTimer) clearInterval(this.pollTimer);
      if (this.worker) this.worker.terminate();
      for (const p of this.peers.values()) try { p.pc.close(); } catch (_) {}
      this.peers.clear();
    }
  }

  HxMesh.verifyNand64 = verifyNand64;
  global.HxMesh = HxMesh;
  global.verifyNand64 = verifyNand64;
