        evals++;
        if (idx.has(y)) { identities++; return idx.get(y); }
        const id = nd.length; nd.push({ a, b, tt: y }); idx.set(y, id); return id;
      }
      function fromU4(t16) {
        const b16 = BigInt(t16);
        const t64 = b16 | (b16 << 16n) | (b16 << 32n) | (b16 << 48n);
        if (idx.has(t64)) return idx.get(t64);
        if (u4d[t16] === 255) return 6;
        return addNand(fromU4(u4a[t16]), fromU4(u4b[t16]));
      }
      function mux(s, t1, t0) {
        if (nd[t1].tt === nd[t0].tt) return t1;
        const ns = addNand(s, s);
