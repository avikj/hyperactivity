      }
      const q0 = Number(tt64 & 0xFFFFn), q1 = Number((tt64 >> 16n) & 0xFFFFn);
      const q2 = Number((tt64 >> 32n) & 0xFFFFn), q3 = Number((tt64 >> 48n) & 0xFFFFn);
      const root = mux(5, mux(4, fromU4(q3), fromU4(q2)), mux(4, fromU4(q1), fromU4(q0)));
      // Compact live sub-DAG
      const need = new Uint8Array(nd.length); need[root] = 1;
      for (let i = root; i >= 8; i--) if (need[i]) { need[nd[i].a] = 1; need[nd[i].b] = 1; }
      const map = new Int32Array(nd.length).fill(-1);
      for (let i = 0; i < 8; i++) map[i] = i;
      const gates = [];
      for (let i = 8; i <= root; i++) if (need[i]) {
        gates.push([map[nd[i].a], map[nd[i].b]]);
        map[i] = 8 + gates.length - 1;
      }
      return { gates, got: nd[root].tt };
    }

    let tIdx = 0;
    let rng = 0x1337C0DE;
    function xr() { rng ^= rng << 13; rng ^= rng >>> 17; rng ^= rng << 5; return rng >>> 0; }

    function tick() {
      if (mode === 'off') return setTimeout(tick, 400);
      if (!u4Ready) {
        buildU4();
        return setTimeout(tick, 50);
      }
      // First pass: emit exact Shannon+CSE witnesses for all 6 frontier targets
      if (tIdx < TARGETS.length) {
        const tgt = TARGETS[tIdx++];
        const res = synth6(tgt.tt);
        if (res.got === tgt.tt) {
          self.postMessage({
            type: 'discovery',
            name: tgt.name,
            tt: tgt.tt.toString(16).padStart(16, '0'),
            cost: res.gates.length,
            gates: res.gates
          });
        }
      } else {
        // Coinductive background wave: mine 64-bit algebraic identities & strict compressions
        const iters = mode === 'max' ? 8000 : mode === 'active' ? 2500 : 400;
        const regs = new BigUint64Array(24);
        for (let i = 0; i < 6; i++) regs[i] = V6[i];
