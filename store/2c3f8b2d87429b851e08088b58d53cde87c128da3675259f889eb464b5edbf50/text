    const V6 = [
      0xAAAAAAAAAAAAAAAAn, 0xCCCCCCCCCCCCCCCCn, 0xF0F0F0F0F0F0F0F0n,
      0xFF00FF00FF00FF00n, 0xFFFF0000FFFF0000n, 0xFFFFFFFF00000000n
    ];
    const M64 = 0xFFFFFFFFFFFFFFFFn;
    const TARGETS = [
      { name: 'parity5', tt: (V6[0]^V6[1]^V6[2]^V6[3]^V6[4]) & M64 },
      { name: 'parity6', tt: (V6[0]^V6[1]^V6[2]^V6[3]^V6[4]^V6[5]) & M64 },
      { name: 'ge3',     tt: 0x80c0e0f0f8fcfeffn },
      { name: 'add3c',   tt: 0xfefcf8f0e0c08000n },
      { name: 'maj5',    tt: 0xfee8e880fee8e880n },
      { name: 'shacm',   tt: 0x272727d827d8d8d8n }
    ];
    let mode = 'idle'; // 'off' | 'idle' | 'active' | 'max'
    let evals = 0, identities = 0, u4Ready = false;
    const u4d = new Uint8Array(65536).fill(255);
    const u4a = new Uint16Array(65536), u4b = new Uint16Array(65536), u4l = new Uint16Array(65536);
    let u4n = 0;

    function buildU4() {
      const seeds = [0x0000, 0xFFFF, 0xAAAA, 0xCCCC, 0xF0F0, 0xFF00];
      for (const s of seeds) { u4d[s] = 0; u4a[s] = s; u4b[s] = s; u4l[u4n++] = s; }
      const ls = [0, u4n];
      for (let d = 1; d <= 6 && u4n < 65536; d++) {
