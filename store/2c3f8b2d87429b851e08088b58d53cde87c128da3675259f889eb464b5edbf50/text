  // 64-bit exact truth-table verifier (runs in <10us in JS BigInt to reject ANY forged peer packet!)
  const V6 = [
    0xAAAAAAAAAAAAAAAAn, 0xCCCCCCCCCCCCCCCCn, 0xF0F0F0F0F0F0F0F0n,
    0xFF00FF00FF00FF00n, 0xFFFF0000FFFF0000n, 0xFFFFFFFF00000000n
  ];
  const MASK64 = 0xFFFFFFFFFFFFFFFFn;

  function verifyNand64(gates, targetHex) {
    if (!Array.isArray(gates) || gates.length === 0 || gates.length > 64) return false;
    const vals = [V6[0], V6[1], V6[2], V6[3], V6[4], V6[5], 0n, MASK64];
    for (let k = 0; k < gates.length; k++) {
      const g = gates[k];
      if (!Array.isArray(g) || g.length !== 2) return false;
      const a = g[0] | 0, b = g[1] | 0;
      if (a < 0 || a >= vals.length || b < 0 || b >= vals.length) return false;
      vals.push((~(vals[a] & vals[b])) & MASK64);
    }
    const got = vals[vals.length - 1];
    try {
      return got === BigInt('0x' + String(targetHex).replace(/^0x/i, ''));
    } catch (_) {
      return false;
    }
  }

