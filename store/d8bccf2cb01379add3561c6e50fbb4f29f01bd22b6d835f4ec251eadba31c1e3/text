-- THEOREM 1 (UNIVERSAL UNITARY COMPOSITION OF SYNESTHETIC FLOW NETWORKS — 0 POSTULATES!):
-- Composing ANY chain of lossless synesthetic knots (Visual <-> Sound <-> Memory <-> UX)
-- is ALWAYS lossless and unitary: bwd(fwd(a)) == a AND fwd(bwd(b)) == b universally!
sk-comp : {A B C : Type} → SynKnot A B → SynKnot B C → SynKnot A C
sk-comp k1 k2 =
  let f1 = fst k1
      g1 = fst (snd k1)
      r1 = fst (snd (snd k1))
      s1 = snd (snd (snd k1))
      f2 = fst k2
      g2 = fst (snd k2)
      r2 = fst (snd (snd k2))
      s2 = snd (snd (snd k2))
  in sknot
       (λ a → f2 (f1 a))
       (λ c → g1 (g2 c))
       (λ a → sk-trans (sk-cong g1 (r2 (f1 a))) (r1 a))
       (λ c → sk-trans (sk-cong f2 (s1 (g2 c))) (s2 c))
