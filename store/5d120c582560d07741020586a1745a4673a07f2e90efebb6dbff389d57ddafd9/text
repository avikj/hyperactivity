r4d-tet-census : Nat → Nat → Nat → Nat → Nat × (Nat × Nat) → Nat × (Nat × Nat)
r4d-tet-census w0 w1 w2 w3 counts =
  (λ aCount →
    if eqb aCount 3 then (suc (fst counts) , snd counts)
    else (if eqb aCount 1 then (fst counts , (suc (fst (snd counts)) , snd (snd counts)))
          else (fst counts , (fst (snd counts) , suc (snd (snd counts))))))
  (plus (plus (r4d-in-A w0) (r4d-in-A w1)) (plus (r4d-in-A w2) (r4d-in-A w3)))
