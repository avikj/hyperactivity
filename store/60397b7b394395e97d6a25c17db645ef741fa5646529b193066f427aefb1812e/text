b2-ftab : Word → (Word → Step W Word) → Step W Word
b2-ftab mm_ kq_ =
  scmd (w-load ((b2-HR mm_ #23))) (λ t → let mm_16110 = b2-dep mm_ t in if (not (%weq t #0)) then (kq_ (h4-depl mm_16110 (t))) else (b2-vec mm_16110  (λ v → let mm_16111 = b2-dep mm_16110 v in scmd (w-store ((b2-HR mm_16111 #23)) (v)) (λ uu_16112 → let mm_16113 = hv2-u mm_16111 uu_16112 in kq_ (h4-depl mm_16113 (v))))))
