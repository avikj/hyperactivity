sfc-get-t5 : SfcT5 → Nat → Nat → Nat → Nat → Nat → BZ
sfc-get-t5 t a b c d e =
  (λ t4 → (λ t3 → (λ t2 → (λ t1 → if eqb e 0 then fst t1 else snd t1)
                           (if eqb d 0 then fst t2 else snd t2))
                   (if eqb c 0 then fst t3 else snd t3))
           (if eqb b 0 then fst t4 else snd t4))
  (if eqb a 0 then fst t else snd t)
