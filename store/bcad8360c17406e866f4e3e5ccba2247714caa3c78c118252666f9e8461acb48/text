-- ---------------------------------------------------------------- loops reach the balanced labelling, flux kept
-- move edges 1..3 onto edge 0 (zero-word), then hand edge 0's surplus out one unit at a time to edges 1, 2, 3
loops-reach : List Loop → Ends → List SQ → Bool
loops-reach w es ns = if sqs-eq (inner (word-act w es)) ns then sqs-eq (beyonds (word-act w es)) (beyonds es) else false
