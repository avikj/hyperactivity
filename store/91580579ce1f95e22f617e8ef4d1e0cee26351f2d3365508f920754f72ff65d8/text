b2-arrwant : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-arrwant mm_ zero ic sp j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-arrwant mm_ (suc f) ic sp j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (b2-argat mm_ sp j (λ x → let mm_2912 = b2-dep mm_ x in b2-ipeek mm_2912 x (λ q → let mm_2913 = b2-dep mm_2912 q in if (andB (b2-arrneed ic j) (%weq q #0)) then (kq_ (h4-depl mm_2913 (x))) else (b2-arrwant mm_2913 f ic sp (%wsucc j) n kq_))))
