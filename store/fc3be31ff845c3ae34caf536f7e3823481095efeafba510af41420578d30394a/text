b2-ploop : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-ploop mm_ zero p kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ploop mm_ (suc f) p kq_ =
  b2-pitem mm_ p (λ dd_13639 → let mm_13640 = b2-dep mm_ dd_13639 in scmd (w-load ((b2-HR mm_13640 #28))) (λ r → let mm_13641 = b2-dep mm_13640 r in if (%weq r #1) then (b2-ploop mm_13641 f p kq_) else (kq_ (h4-depl mm_13641 (r)))))
