ue-kkt-price : Word → Word → Word → Word → Word → Word
ue-kkt-price pElast qElast xBase yPhys muTau =
  if %wlt xBase yPhys then yPhys
  else
    let yEff  = ue-y-eff xBase yPhys muTau
        surp  = %wsub xBase yEff
        denom = ue-max-w #1 (%wadd pElast qElast)
        capt  = %wdiv (%wmul qElast surp) denom
    in %wadd yEff capt
