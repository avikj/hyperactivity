-- Fused compressed-stream integer MAC lane (model for systolic dot-product verification):
-- Proves fused MAC over compressed stream === raw MAC over uncompressed BF16 weights!
psc-mac4-raw : Word → Word → Word → Word → Word → Word → Word → Word → Word
psc-mac4-raw w0 w1 w2 w3 x0 x1 x2 x3 =
  %wadd (%wadd (%wmul w0 x0) (%wmul w1 x1))
        (%wadd (%wmul w2 x2) (%wmul w3 x3))
