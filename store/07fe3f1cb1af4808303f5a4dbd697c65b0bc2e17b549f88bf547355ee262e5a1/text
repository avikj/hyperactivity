b2-jitem : Word → Word → Word → (List Word → Step W Word) → Step W Word
b2-jitem mm_ md x kq_ =
  if (%weq md #2) then (b2-jname mm_ x (λ r → let mm_11399 = b2-dpl mm_ r in kq_ (h4-depl mm_11399 (r)))) else (if (%weq md #3) then (kq_ (h4-depl mm_ ((b2-jsquant x)))) else (kq_ (h4-depl mm_ ((b2-jint x)))))
