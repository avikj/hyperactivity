-- Total surface area enclosure over a list of punctured links, in units of (4 pi gamma l_P^2) / 2^s.
qg-surface-area : Nat → List (List Bool) → List Bool × List Bool
qg-surface-area s js = case js of
  nil → (nil , nil)
  cons j rest → (bin-add (fst (qg-link-area s j)) (fst (qg-surface-area s rest)) ,
                 bin-add (snd (qg-link-area s j)) (snd (qg-surface-area s rest)))
