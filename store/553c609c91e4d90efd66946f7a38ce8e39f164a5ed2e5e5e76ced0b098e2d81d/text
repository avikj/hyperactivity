-- the class of a weak normal form: 1 ERA, 2 NAM/BJV/BJ0/BJ1, 3 DRY, 4 LAM, 5 SUP, 6 INC, 7 MAT/SWI, 8 USE, 9 NUM, 10 a constructor, 11 ANY, 12 OP2, 13 DSU, 14 DDU, 0 other
h4-wcls : Word → Word
h4-wcls tg =
  let h = %wshr tg #4
      w = the Word (if %weq h #0 then #12296818335723553792 else if %weq h #1 then #8767007274614565546 else if %weq h #2 then #600792910327240 else if %weq h #3 then #0 else #0)
  in %wand (%wshr w (%wshl (%wand tg #15) #2)) #15
