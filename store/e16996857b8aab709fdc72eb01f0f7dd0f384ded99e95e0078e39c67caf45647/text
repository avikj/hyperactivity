b2c : Word → Nat → Word → Word → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2c mm_ zero md bk lhs a b c ctx d kq_ =
  b2-fuelout mm_  kq_
b2c mm_ (suc f) md bk lhs a b c ctx d kq_ =
  if (%wlt md #2) then (if (%wlt md #1) then (b2c-p0 mm_ (λ mz__ → b2c mz__ f) md bk lhs a b c ctx d kq_) else (b2c-p1 mm_ (λ mz__ → b2c mz__ f) md bk lhs a b c ctx d kq_)) else (if (%wlt md #5) then (b2c-p2 mm_ (λ mz__ → b2c mz__ f) md bk lhs a b c ctx d kq_) else (if (%wlt md #6) then (b2c-p3 mm_ (λ mz__ → b2c mz__ f) md bk lhs a b c ctx d kq_) else (b2c-p4 mm_ (λ mz__ → b2c mz__ f) md bk lhs a b c ctx d kq_)))
