bst-master-uf : Nat → Nat → List Bool → List Bool → BstUF
bst-master-uf p2 q2 en ed =
  bst-force-bin BstUF (bin-of-nat p2) (λ bp →
  bst-force-bin BstUF (bin-of-nat q2) (λ bq →
  bst-force-bin BstUF (bst-bmul bp bp) (λ bp4 →
  bst-force-bin BstUF (bst-bmul bq bq) (λ bq4 →
  bst-force-bin BstUF (bst-bsub (bst-badd bq4 (bst-bmul (bin-of-nat 30) (bst-bmul bp bq)))
                                (bst-bmul (bin-of-nat 19) bp4)) (λ cpos →
  bst-force-bin BstUF (bst-bmul (bin-of-nat 4) (bst-bsub bq4 bp4)) (λ cneg →
  bst-force-bin BstUF (bst-bmul (bin-of-nat 16) bq4) (λ pref →
  bst-force-bin BstUF (bst-bmul (bin-of-nat 15) (bst-bpow4 (bst-badd bq bp))) (λ dpow →
    (bst-bmul pref (bst-bsub (bst-bmul cpos ed) (bst-bmul cneg en)) ,
     bst-bmul dpow ed)))))))))
