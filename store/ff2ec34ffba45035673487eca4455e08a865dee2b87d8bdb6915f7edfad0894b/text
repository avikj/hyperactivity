b2-varidx : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-varidx mm_ zero vs i j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-varidx mm_ (suc f) vs i j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_5510 = vs in let j_5511 = j in scmd (w-load ((b2-a mm_ (%wadd a_5510 (%wsucc j_5511))))) (λ x_5509 → let mm_5512 = b2-dep mm_ x_5509 in let w = x_5509 in let t_5514 = w in let j_5515 = #1 in scmd (w-load ((b2-a mm_5512 (%wadd t_5514 (%wadd #2 j_5515))))) (λ x_5513 → let mm_5516 = b2-dep mm_5512 x_5513 in let wi = x_5513 in if (%weq wi i) then (kq_ (h4-depl mm_5516 (j))) else (b2-varidx mm_5516 f vs i (%wsucc j) n kq_))))
