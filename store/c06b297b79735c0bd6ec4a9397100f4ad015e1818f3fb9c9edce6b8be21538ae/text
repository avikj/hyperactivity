b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_7468 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_7468 (k))) else (b2-nbytes mm_7468 ns (λ nb → let mm_7469 = b2-dpl mm_7468 nb in b2-nbytes mm_7469 k (λ kb → let mm_7470 = b2-dpl mm_7469 kb in b2-nm mm_7470 (list-append nb (cons #58 kb)) (λ r → let mm_7471 = b2-dep mm_7470 r in kq_ (h4-depl mm_7471 (r)))))))
