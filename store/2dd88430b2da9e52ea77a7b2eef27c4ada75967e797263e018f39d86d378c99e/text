-- Gauss's law at vertices v, v − 1, … , 0: what leaves, and the electron if it is here, is what enters, and the nucleus
cv-gauss-to : Nat → List FaradayLine → CvState → Bool
cv-gauss-to v ls s = if eqb (plus (fst (cv-div v ls (snd s))) (cv-one (eqb v (fst s)))) (plus (snd (cv-div v ls (snd s))) (cv-one (eqb v zero)))
  then (case v of
    zero → true
    suc g → cv-gauss-to g ls s)
  else false
