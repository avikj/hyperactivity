b2-tipown : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tipown mm_ zero bk xs j n kq_ =
  kq_ (h4-depl mm_ (#1))
b2-tipown mm_ (suc f) bk xs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#1))) else (let a_12662 = xs in let j_12663 = j in scmd (w-load ((b2-a mm_ (%wadd a_12662 (%wsucc j_12663))))) (λ x_12661 → let mm_12664 = b2-dep mm_ x_12661 in let x = x_12661 in b2-wnf mm_12664 bk x (λ w → let mm_12665 = b2-dep mm_12664 w in if (%weq w b2-ERR) then (kq_ (h4-depl mm_12665 b2-ERR)) else (let t_12667 = w in scmd (w-load ((b2-a mm_12665 t_12667))) (λ x_12666 → let mm_12668 = b2-dep mm_12665 x_12666 in let wt = (%wand x_12666 #255) in let t_12670 = w in let j_12671 = #1 in scmd (w-load ((b2-a mm_12668 (%wadd t_12670 (%wadd #2 j_12671))))) (λ x_12669 → let mm_12672 = b2-dep mm_12668 x_12669 in let wi = x_12669 in if (orB (not (%weq wt b2-VAR)) (not (%weq wi j))) then (kq_ (h4-depl mm_12672 (#0))) else (b2-tipown mm_12672 f bk xs (%wsucc j) n kq_)))))))
