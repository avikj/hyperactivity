tc-tau23-st : QgmState → QgmState
tc-tau23-st s =
  ((if eqb (fst s) 2 then 3 else (if eqb (fst s) 3 then 2 else fst s)) ,
   tc-vec6 (sc-nth-bz (snd s) 0) (sc-nth-bz (snd s) 2) (sc-nth-bz (snd s) 1)
           (bz-neg (sc-nth-bz (snd s) 5)) (bz-neg (sc-nth-bz (snd s) 4)) (bz-neg (sc-nth-bz (snd s) 3)))
