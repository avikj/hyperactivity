b2-namelist : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-namelist mm_ zero v j n acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-namelist mm_ (suc f) v j n acc kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (acc))) else (let v_13901 = v in let j_13902 = j in scmd (w-load ((b2-a mm_ (%wadd v_13901 #2)))) (λ d_13900 → let mm_13903 = b2-dep mm_ d_13900 in scmd (w-load ((b2-a mm_13903 (%wadd d_13900 (%wsucc j_13902))))) (λ x_13899 → let mm_13904 = b2-dep mm_13903 x_13899 in let k = x_13899 in b2-namekey mm_13904 k (λ kb → let mm_13905 = b2-dpl mm_13904 kb in b2-namelist mm_13905 f v (%wsucc j) n (the (List Word) (if %weq j #0 then kb else list-append acc (list-append ", " kb))) kq_))))
