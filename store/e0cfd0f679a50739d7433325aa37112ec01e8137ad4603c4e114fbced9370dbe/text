ue-default-program : List Word
ue-default-program =
  ue-ln (list-append "import " (list-append ue-q (list-append "lib/core.hypercubical" ue-q))) (
  ue-ln "-- computational univalence (ua) transport on Bool + exact step reduction:" (
  ue-ln "hx-not-invol : (b : Bool) → not (not b) ≡ b" (
  ue-ln "hx-not-invol false = refl" (
  ue-ln "hx-not-invol true  = refl" (
  ue-ln "hx-not-equiv : Equiv Bool Bool" (
  ue-ln "hx-not-equiv = isoToEquiv not not hx-not-invol hx-not-invol" (
  ue-ln "#show (transport (λ i → ua hx-not-equiv i) true)" (
  ue-ln "#show (plus (toNat #314) (toNat #686))" nil))))))))
