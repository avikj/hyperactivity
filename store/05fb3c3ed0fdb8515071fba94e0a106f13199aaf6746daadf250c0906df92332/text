derive-eq-at : Nat → Word → Opt Code
derive-eq-at zero d = none
derive-eq-at (suc n) d =
  d-omap (λ shapes → cann (clam (ccase d (outer-branches (λ d2 → d-or (derive-eq-at n d2) (clam (clam d-false))) d shapes shapes #0) (cvar #0)))
                          (cpi #2 (cdata d lnil) (cpi #2 (cdata d lnil) (cdata bool-d lnil))))
    (all-shapes d)
