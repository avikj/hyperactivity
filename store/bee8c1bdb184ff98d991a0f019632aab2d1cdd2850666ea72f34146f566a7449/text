-- one mention's step: whether the chain is still being followed there, and its link if it is
e-here-with : List (List (List Word)) → Bool → List Word → List Word → Word → Bool × List (List (List Word))
e-here-with found act plain name n = (act , (if act then cons (e-link plain name (e-nthr (toNat n) found)) nil else nil))
