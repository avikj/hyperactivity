b2-firstnq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstnq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-firstnq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_7594 = tel in let j_7595 = j in scmd (w-load ((b2-a mm_ (%wadd a_7594 (%wsucc j_7595))))) (λ x_7593 → let mm_7596 = b2-dep mm_ x_7593 in let c = x_7593 in let i_7598 = (%wadd c #3) in scmd (w-load ((b2-a mm_7596 i_7598))) (λ x_7597 → let mm_7599 = b2-dep mm_7596 x_7597 in let vT = x_7597 in let t_7601 = vT in scmd (w-load ((b2-a mm_7599 t_7601))) (λ x_7600 → let mm_7602 = b2-dep mm_7599 x_7600 in let tg = (%wand x_7600 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_7602 (j))) else (b2-firstnq mm_7602 f tel (%wsucc j) n kq_)))))
