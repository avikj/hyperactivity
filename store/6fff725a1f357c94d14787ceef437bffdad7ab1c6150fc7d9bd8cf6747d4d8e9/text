hyperos-cli-main : List (List Word) → Step W Word
hyperos-cli-main args =
  let a1   = ho-arg1 args
      a2   = ho-arg2 args
      mode = ho-mode-of a1
      dir  = ho-dir-of a1 a2 mode
  in ho-materialize-all dir (λ totB →
       if cli-eq mode "emit" then
         cli-say (list-append "[HX-HYPEROS] Materialized Dual-Arch ARM64+x86-64 Bare-Metal Hyperkernel + VZ + m1n1 + HXSV Mesh ("
           (list-append (ce-dec totB) (list-append "B) -> " dir)))
           (sdone #0)
       else
         cli-system (list-append "/bin/sh " (list-append dir (list-append "/hx_oneclick_deploy.sh " (list-append mode (list-append " " (list-append dir " ."))))))
           (λ rc → sdone rc))
