h4-dlook : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-dlook mm_ zero loc lab i kq_ =
  h4-rterr mm_ "print_state: too many dups" kq_
h4-dlook mm_ (suc f) loc lab i kq_ =
  scmd (w-load ((h4-PDL mm_))) (λ n → let mm_2782 = h4-dep mm_ n in if (%weq i n) then (scmd (w-load ((h4-PND mm_2782))) (λ nm → let mm_2783 = h4-dep mm_2782 nm in scmd (w-store ((h4-PND mm_2783)) ((%wsucc nm))) (λ uu_2784 → let mm_2785 = hv2-u mm_2783 uu_2784 in scmd (w-store ((h4-pdup mm_2785 i)) (loc)) (λ uu_2786 → let mm_2787 = hv2-u mm_2785 uu_2786 in scmd (w-store ((%wadd (h4-pdup mm_2787 i) #8)) (nm)) (λ uu_2788 → let mm_2789 = hv2-u mm_2787 uu_2788 in scmd (w-store ((%wadd (h4-pdup mm_2789 i) #16)) (lab)) (λ uu_2790 → let mm_2791 = hv2-u mm_2789 uu_2790 in scmd (w-store ((h4-PDL mm_2791)) ((%wsucc n))) (λ uu_2792 → let mm_2793 = hv2-u mm_2791 uu_2792 in kq_ (h4-depl mm_2793 (nm))))))))) else (scmd (w-load ((h4-pdup mm_2782 i))) (λ l → let mm_2794 = h4-dep mm_2782 l in if (%weq l loc) then (scmd (w-load ((%wadd (h4-pdup mm_2794 i) #8))) (λ nm → let mm_2795 = h4-dep mm_2794 nm in kq_ (h4-depl mm_2795 (nm)))) else (h4-dlook mm_2794 f loc lab (%wsucc i) kq_))))
