  b2-wnf mm_ bk tel (λ t → let mm_10662 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_10662 b2-ERR)) else (let t_10664 = t in scmd (w-load ((b2-a mm_10662 t_10664))) (λ x_10663 → let mm_10665 = b2-dep mm_10662 x_10663 in let tg = (%wand x_10663 #255) in if (%weq tg b2-ALL) then (kq_ (h4-depl mm_10665 (t))) else (b2-fail mm_10665 bk ctx "unreachable (a telescope binds its parameters and fields)" #0 s def (λ r → let mm_10666 = b2-dep mm_10665 r in kq_ (h4-depl mm_10666 (r)))))))
