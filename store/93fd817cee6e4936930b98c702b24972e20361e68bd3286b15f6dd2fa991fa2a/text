b2-pushk : Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pushk mm_ bk k x kq_ =
  b2-tapp mm_ bk k x #0 (λ t → let mm_14982 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_14982 b2-ERR)) else (b2-push mm_14982 t #0 (λ dd_14983 → let mm_14984 = b2-dep mm_14982 dd_14983 in kq_ (h4-depl mm_14984 (#0)))))
