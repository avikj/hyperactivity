b2-ftab : Word → (Word → Step W Word) → Step W Word
b2-ftab mm_ kq_ =
  scmd (w-load ((b2-HR mm_ #23))) (λ t → let mm_16852 = b2-dep mm_ t in if (not (%weq t #0)) then (kq_ (h4-depl mm_16852 (t))) else (b2-vec mm_16852  (λ v → let mm_16853 = b2-dep mm_16852 v in scmd (w-store ((b2-HR mm_16853 #23)) (v)) (λ uu_16854 → let mm_16855 = hv2-u mm_16853 uu_16854 in kq_ (h4-depl mm_16855 (v))))))
