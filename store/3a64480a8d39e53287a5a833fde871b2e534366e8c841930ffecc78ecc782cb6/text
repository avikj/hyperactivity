rh-thm-bost-chain-compose : (chain : List ThetaLiftLink) →
  rh-chain-all-bost chain ≡ true →
  rh-le (rh-chain-div chain) (rh-chain-bound chain) ≡ true
rh-thm-bost-chain-compose nil _ = refl
rh-thm-bost-chain-compose (cons (tlink d n l) xs) h =
  rh-andB-split (rh-le d (plus n l)) (rh-chain-all-bost xs) h
    (λ h1 h2 → rh-le-add-mono d (plus n l) (rh-chain-div xs) (rh-chain-bound xs) h1 (rh-thm-bost-chain-compose xs h2))
