-- THEOREM 3 (REWRITING LOOP ASSOCIATIVITY — RECURSIVE RECOMPACTION INVARIANCE):
sm-thm-loop-assoc : {A B C D : Type} →
  (k1 : SynModalityKnot A B) → (k2 : SynModalityKnot B C) → (k3 : SynModalityKnot C D) → (a : A) →
  sm-fwd (sm-compose (sm-compose k1 k2) k3) a ≡ sm-fwd (sm-compose k1 (sm-compose k2 k3)) a
sm-thm-loop-assoc k1 k2 k3 a = refl
