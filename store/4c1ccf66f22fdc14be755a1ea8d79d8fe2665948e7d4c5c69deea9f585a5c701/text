b2-slen : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-slen mm_ zero a n j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-slen mm_ (suc f) a n j acc kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (acc))) else (b2-clen mm_ a j n (λ l → let mm_2750 = b2-dep mm_ l in b2-slen mm_2750 f a n (%wadd j l) (%wsucc acc) kq_))
