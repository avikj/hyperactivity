-- Section (2): Universal Cubical Schur-Complement / Bareiss Positive-Definiteness Theorem.
-- Commutative semiring laws (add-assoc, mul-assoc, mul-comm, ldist, rdist):
QmolSR : (A : Type) → (A → A → A) → (A → A → A) → Type
QmolSR A add mul =
  ((x y w : A) → add (add x y) w ≡ add x (add y w)) ×
  (((x y w : A) → mul (mul x y) w ≡ mul x (mul y w)) ×
  (((x y : A) → mul x y ≡ mul y x) ×
  (((x y w : A) → mul x (add y w) ≡ add (mul x y) (mul x w)) ×
  ((x y w : A) → mul (add x y) w ≡ add (mul x w) (mul y w)))))
