bst-baddc : Bool → List Bool → List Bool → List Bool
bst-baddc c a b = case a of
  nil → if c then bst-bsucc b else b
  cons x xs → case b of
    nil → if c then bst-bsucc (cons x xs) else cons x xs
    cons y ys →
      cons (bit-eq (bit-eq x y) c)
           (bst-baddc (if x then (if y then true else c) else (if y then c else false)) xs ys)
