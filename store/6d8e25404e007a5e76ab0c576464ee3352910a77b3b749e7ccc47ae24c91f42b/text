-- the hop along line i, forward (from its first vertex to its second) or back; nothing if the electron is not there
cv-step : List FaradayLine → Nat × Bool → CvState → CvState
cv-step ls m s = if snd m
  then (if eqb (fst s) (fst (cv-line (fst m) ls)) then (snd (cv-line (fst m) ls) , cv-at (fst m) true (snd s)) else s)
  else (if eqb (fst s) (snd (cv-line (fst m) ls)) then (fst (cv-line (fst m) ls) , cv-at (fst m) false (snd s)) else s)
