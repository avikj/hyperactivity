b2-sat : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-sat mm_ zero a p at j m kq_ =
  kq_ (h4-depl mm_ (#0))
b2-sat mm_ (suc f) a p at j m kq_ =
  if (%weq j m) then (kq_ (h4-depl mm_ (#1))) else (let a_3137 = a in let j_3138 = (%wadd at j) in scmd (w-load ((b2-a mm_ (%wadd a_3137 (%wsucc j_3138))))) (λ x_3136 → let mm_3139 = b2-dep mm_ x_3136 in let x = x_3136 in let a_3141 = p in let j_3142 = j in scmd (w-load ((b2-a mm_3139 (%wadd a_3141 (%wsucc j_3142))))) (λ x_3140 → let mm_3143 = b2-dep mm_3139 x_3140 in let y = x_3140 in if (not (%weq x y)) then (kq_ (h4-depl mm_3143 (#0))) else (b2-sat mm_3143 f a p at (%wsucc j) m kq_))))
