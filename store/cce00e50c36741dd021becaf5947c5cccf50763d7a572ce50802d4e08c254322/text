/* ==========================================================================
   HYPERACTIVITY — HX-LENS: Unified Compositional Reader & Epistemic Engine
   One algebra over live HTML5 + store/ + /cubical.wasm:
     View     : Edition(6) × Depth(3) × Field(2) × SplitPane(2)
     Surfaces : Stat Expositions · Theorem Verifiers · Equation Layers ·
                Hover-Peek Symbols · Split-Pane Source & WASM Drawer · ⌘K
   Zero SaaS chrome. Zero synthetic synesthesia. Zero dead ends.
   ========================================================================== */

:root {
  --hx-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
  --hx-dyslexic: 'Comic Sans MS', 'Comic Neue', 'Chalkboard SE', 'Marker Felt', sans-serif;
  --hx-pink: #ff0a94;
  --hx-split-w: min(560px, 44vw);
}

/* ==================== SPLIT-PANE READING MODE ==================== */
@media (min-width: 1080px) {
  html.hx-split-pinned body {
    padding-right: var(--hx-split-w) !important;
    transition: padding-right 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  html.hx-split-pinned #hx-src-drawer {
    width: var(--hx-split-w) !important;
    box-shadow: none !important;
  }
}

/* ==================== NAV CONTROLS & VIEW POPOVER ==================== */
#hx-view-trigger,
#hx-cmd-trigger {
  font: 600 11.5px/1 var(--hx-mono);
  background: none;
  color: inherit;
  border: 1px solid currentColor;
  padding: 4px 8px;
  cursor: pointer;
  letter-spacing: 0.02em;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  opacity: 0.86;
  transition: color 0.14s, border-color 0.14s, opacity 0.14s;
}
#hx-view-trigger:hover,
#hx-view-trigger[aria-expanded="true"],
#hx-cmd-trigger:hover {
  color: var(--hx-pink);
  border-color: var(--hx-pink);
  opacity: 1;
}
#hx-view-trigger .dot {
  width: 5px;
  height: 5px;
  background: var(--hx-pink);
  display: inline-block;
}

#hx-view-panel {
  position: fixed;
  top: 52px;
  right: 18px;
  z-index: 9999;
  width: min(448px, calc(100vw - 24px));
  background: #ffffff;
  color: #000000;
  border: 1px solid #000000;
  padding: 16px 18px 14px;
  font-family: var(--hx-mono);
  font-size: 12px;
  line-height: 1.45;
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.14);
  display: none;
}
html.dark #hx-view-panel {
  background: #000000;
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.42);
  box-shadow: 0 18px 54px rgba(0, 0, 0, 0.72);
}
#hx-view-panel.open { display: block; }
#hx-view-panel .hx-p-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 10px;
  margin-bottom: 12px;
  border-bottom: 1px solid rgba(128, 128, 128, 0.25);
}
#hx-view-panel .hx-p-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
#hx-view-panel .hx-p-close {
  background: none;
  border: 0;
  color: inherit;
  font: 500 11px/1 var(--hx-mono);
  opacity: 0.6;
  cursor: pointer;
  padding: 2px 4px;
}
#hx-view-panel .hx-p-close:hover { opacity: 1; color: var(--hx-pink); }
#hx-view-panel .hx-row { margin-bottom: 13px; }
#hx-view-panel .hx-row:last-of-type { margin-bottom: 8px; }
#hx-view-panel .hx-row-lbl {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.52;
  margin-bottom: 6px;
  display: flex;
  justify-content: space-between;
}
#hx-view-panel .hx-ed-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 6px;
}
#hx-view-panel .hx-opt {
  text-align: left;
  background: none;
  color: inherit;
  border: 1px solid rgba(128, 128, 128, 0.28);
  padding: 8px 10px;
  cursor: pointer;
  font-family: var(--hx-mono);
  transition: border-color 0.12s, background 0.12s, color 0.12s;
}
#hx-view-panel .hx-opt:hover { border-color: var(--hx-pink); }
#hx-view-panel .hx-opt.on {
  border-color: var(--hx-pink);
  background: rgba(255, 10, 148, 0.07);
}
#hx-view-panel .hx-opt-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11.5px;
  font-weight: 700;
}
#hx-view-panel .hx-opt.on .hx-opt-name { color: var(--hx-pink); }
#hx-view-panel .hx-opt-key { font-size: 10px; opacity: 0.45; font-weight: 500; }
#hx-view-panel .hx-opt-desc { font-size: 10px; opacity: 0.62; margin-top: 3px; line-height: 1.32; }
#hx-view-panel .hx-seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
#hx-view-panel .hx-seg.two { grid-template-columns: repeat(2, 1fr); }
#hx-view-panel .hx-seg .hx-opt { padding: 7px 9px; text-align: center; }
#hx-view-panel .hx-seg .hx-opt-top { justify-content: center; gap: 6px; }
#hx-view-panel .hx-api-foot {
  margin-top: 10px;
  padding-top: 9px;
  border-top: 1px solid rgba(128, 128, 128, 0.22);
  font-size: 10px;
  opacity: 0.56;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
#hx-view-panel .hx-api-code {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
#hx-view-panel .hx-store-live {
  color: var(--hx-pink);
  opacity: 0.92;
}

#hx-view-toast {
  position: fixed;
  bottom: 18px;
  right: 18px;
  z-index: 9998;
  background: #000000;
  color: #ffffff;
  border: 1px solid var(--hx-pink);
  padding: 7px 12px;
  font: 600 11.5px/1 var(--hx-mono);
  letter-spacing: 0.03em;
  pointer-events: none;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.16s ease, transform 0.16s ease;
}
html.dark #hx-view-toast { background: #ffffff; color: #000000; }
#hx-view-toast.show { opacity: 1; transform: translateY(0); }
#hx-view-toast b { color: var(--hx-pink); }

#hx-float-pill {
  position: fixed;
  bottom: 18px;
  left: 18px;
  z-index: 9990;
  font: 600 11px/1 var(--hx-mono);
  background: rgba(255, 255, 255, 0.92);
  color: #000000;
  border: 1px solid rgba(0, 0, 0, 0.25);
  padding: 6px 10px;
  cursor: pointer;
  backdrop-filter: blur(8px);
  display: inline-flex;
  align-items: center;
  gap: 7px;
  transition: border-color 0.14s, color 0.14s;
}
html.dark #hx-float-pill {
  background: rgba(0, 0, 0, 0.88);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.28);
}
#hx-float-pill:hover { border-color: var(--hx-pink); color: var(--hx-pink); }
#hx-float-pill .k { opacity: 0.48; }

/* ==================== SHARED MONOCHROMATIC DISCIPLINE ==================== */
html[data-hx-edition] {
  --blue: var(--hx-pink);
  --green: var(--ink);
  --amber: var(--ink);
}
html[data-hx-edition] nav {
  border-bottom-width: 1px !important;
  border-bottom-color: var(--line, rgba(0, 0, 0, 0.16)) !important;
}
html.dark[data-hx-edition] nav {
  border-bottom-color: rgba(255, 255, 255, 0.16) !important;
}

/* ==================== MODE 1 (DEFAULT): MONO — Pure Monospace OS ==================== */
html[data-hx-edition="mono"] body,
html[data-hx-edition="margin"] body {
  font-family: var(--hx-mono) !important;
  font-size: 14.5px !important;
  line-height: 1.78 !important;
  letter-spacing: -0.005em;
}
html[data-hx-edition="mono"] main p,
html[data-hx-edition="mono"] main li,
html[data-hx-edition="mono"] .lede,
html[data-hx-edition="mono"] .l-desc,
html[data-hx-edition="mono"] .hg-intro,
html[data-hx-edition="mono"] .hg-ins-desc,
html[data-hx-edition="mono"] .feature p,
html[data-hx-edition="margin"] main p,
html[data-hx-edition="margin"] main li,
html[data-hx-edition="margin"] .lede,
html[data-hx-edition="margin"] .l-desc,
html[data-hx-edition="margin"] .hg-intro,
html[data-hx-edition="margin"] .hg-ins-desc,
html[data-hx-edition="margin"] .feature p {
  font-family: var(--hx-mono) !important;
}
html[data-hx-edition="mono"] main p,
html[data-hx-edition="mono"] main li { max-width: 72ch; }
html[data-hx-edition="mono"] h1,
html[data-hx-edition="margin"] h1 {
  font-family: var(--hx-mono) !important;
  font-weight: 500 !important;
  font-size: clamp(24px, 3.3vw, 40px) !important;
  line-height: 1.15 !important;
  letter-spacing: -0.035em !important;
}
html[data-hx-edition="mono"] .splash h1,
html[data-hx-edition="margin"] .splash h1 {
  font-weight: 700 !important;
  font-size: clamp(46px, 8.6vw, 134px) !important;
  line-height: 0.94 !important;
}
html[data-hx-edition="mono"] h2,
html[data-hx-edition="margin"] h2 {
  font-family: var(--hx-mono) !important;
  font-weight: 600 !important;
  font-size: clamp(19px, 2.2vw, 24px) !important;
  line-height: 1.24 !important;
  letter-spacing: -0.025em !important;
}
html[data-hx-edition="mono"] h3,
html[data-hx-edition="margin"] h3 {
  font-family: var(--hx-mono) !important;
  font-weight: 600 !important;
  font-size: 15.5px !important;
  letter-spacing: -0.015em !important;
}
html[data-hx-edition="mono"] .lede,
html[data-hx-edition="margin"] .lede {
  font-size: 15px !important;
  line-height: 1.72 !important;
  opacity: 0.78;
}
html[data-hx-edition="mono"] .title-block,
html[data-hx-edition="mono"] .chapter,
html[data-hx-edition="margin"] .title-block,
html[data-hx-edition="margin"] .chapter {
  border-width: 1px !important;
  border-color: var(--line-strong, currentColor) !important;
}
html[data-hx-edition="mono"] .thm-box,
html[data-hx-edition="mono"] .callout,
html[data-hx-edition="mono"] .eq-box,
html[data-hx-edition="mono"] .lab-card,
html[data-hx-edition="mono"] .stat-cell,
html[data-hx-edition="mono"] .stack-card,
html[data-hx-edition="margin"] .thm-box,
html[data-hx-edition="margin"] .eq-box,
html[data-hx-edition="margin"] .lab-card,
html[data-hx-edition="margin"] .stat-cell,
html[data-hx-edition="margin"] .stack-card {
  border-width: 1px !important;
  border-radius: 0 !important;
}
html[data-hx-edition="mono"] .thm-box,
html[data-hx-edition="margin"] .thm-box { border-left: 2px solid var(--hx-pink) !important; }
html[data-hx-edition="mono"] .stat-cell > b,
html[data-hx-edition="margin"] .stat-cell > b { font-weight: 600 !important; }
html[data-hx-edition="mono"] .lab-btn,
html[data-hx-edition="margin"] .lab-btn { border-width: 1px !important; font-family: var(--hx-mono) !important; }

/* ==================== MODE 2: PHOTONIC — Weightless Light-Like Monospace ==================== */
html[data-hx-edition="photonic"] { --line: rgba(0, 0, 0, 0.11); --surf: transparent; }
html.dark[data-hx-edition="photonic"] {
  --bg: #000000;
  --ink: #ffffff;
  --muted: rgba(255, 255, 255, 0.56);
  --line: rgba(255, 255, 255, 0.13);
  --surf: transparent;
}
html[data-hx-edition="photonic"] body {
  font-family: var(--hx-mono) !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 1.9 !important;
  letter-spacing: 0.005em;
}
html[data-hx-edition="photonic"] main p,
html[data-hx-edition="photonic"] main li { max-width: 66ch; }
html[data-hx-edition="photonic"] .book-wrap { gap: 72px !important; padding-top: 72px !important; }
html[data-hx-edition="photonic"] .toc { border-right-color: var(--line) !important; opacity: 0.72; transition: opacity 0.2s; }
html[data-hx-edition="photonic"] .toc:hover { opacity: 1; }
html[data-hx-edition="photonic"] h1 {
  font-family: var(--hx-mono) !important;
  font-weight: 300 !important;
  font-size: clamp(28px, 3.8vw, 48px) !important;
  line-height: 1.16 !important;
  letter-spacing: -0.04em !important;
}
html[data-hx-edition="photonic"] .splash h1 {
  font-weight: 700 !important;
  font-size: clamp(46px, 8.6vw, 134px) !important;
  line-height: 0.94 !important;
}
html[data-hx-edition="photonic"] h2 {
  font-family: var(--hx-mono) !important;
  font-weight: 300 !important;
  font-size: clamp(21px, 2.5vw, 29px) !important;
  line-height: 1.24 !important;
  letter-spacing: -0.03em !important;
}
html[data-hx-edition="photonic"] h3 {
  font-family: var(--hx-mono) !important;
  font-weight: 500 !important;
  font-size: 14.5px !important;
  letter-spacing: 0.02em !important;
}
html[data-hx-edition="photonic"] .lede {
  font-family: var(--hx-mono) !important;
  font-size: 15px !important;
  font-weight: 300 !important;
  line-height: 1.82 !important;
  opacity: 0.72;
  max-width: 64ch;
}
html[data-hx-edition="photonic"] .title-block {
  border-bottom: 1px solid var(--line) !important;
  padding-bottom: 42px !important;
  margin-bottom: 56px !important;
}
html[data-hx-edition="photonic"] .chapter {
  margin-top: 96px !important;
  padding-top: 34px !important;
  border-top: 1px solid var(--line) !important;
}
html[data-hx-edition="photonic"] .thm-box,
html[data-hx-edition="photonic"] .callout,
html[data-hx-edition="photonic"] .eq-box,
html[data-hx-edition="photonic"] .stat-cell,
html[data-hx-edition="photonic"] .stack-card,
html[data-hx-edition="photonic"] .card {
  border: 0 !important;
  background: transparent !important;
  border-left: 1px solid var(--hx-pink) !important;
  padding: 6px 0 6px 20px !important;
}
html[data-hx-edition="photonic"] .eq-box {
  border-left: 1px solid var(--line) !important;
  padding: 22px 0 22px 24px !important;
}
html[data-hx-edition="photonic"] .stat-cell {
  border-left: 0 !important;
  border-top: 1px solid var(--line) !important;
  padding: 14px 0 4px !important;
}
html[data-hx-edition="photonic"] .stat-cell > b { font-weight: 400 !important; font-size: 24px !important; }
html[data-hx-edition="photonic"] .lab-card { border: 1px solid var(--line) !important; background: transparent !important; }
html[data-hx-edition="photonic"] pre {
  border: 0 !important;
  border-left: 1px solid var(--line) !important;
  background: transparent !important;
  padding: 12px 0 12px 20px !important;
}

/* ==================== MODE 3: MARGIN — Asymmetric Monospace Margin Notes ==================== */
html[data-hx-edition="margin"] .eq-box { border: 0 !important; background: transparent !important; padding: 16px 0 !important; }
@media (min-width: 1180px) {
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap {
    max-width: 1380px !important;
    grid-template-columns: 185px minmax(0, 1fr) !important;
    gap: 44px !important;
  }
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main {
    padding-right: 300px !important;
    position: relative;
  }
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main .callout,
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main .meta-line {
    float: right !important;
    clear: right !important;
    width: 262px !important;
    margin: 4px -296px 18px 24px !important;
    border: 0 !important;
    border-top: 1px solid var(--hx-pink) !important;
    background: transparent !important;
    padding: 8px 0 0 !important;
    font-family: var(--hx-mono) !important;
    font-size: 11.5px !important;
    line-height: 1.55 !important;
    opacity: 0.85;
  }
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main .lab-card,
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main .tbl-wrap,
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main .stat-strip,
  html[data-hx-edition="margin"]:not(.hx-split-pinned) .book-wrap > main .hx-ex-drawer {
    margin-right: -296px !important;
    clear: both;
  }
}

/* ==================== MODE 4: DYSLEXIC — Comic Sans Accessibility Mode ==================== */
html[data-hx-edition="dyslexic"]:not(.dark) {
  --bg: #faf8f2;
  --ink: #1a1917;
  --muted: #4f4c46;
  --line: rgba(26, 25, 23, 0.18);
  --line-strong: #1a1917;
  --surf: rgba(26, 25, 23, 0.035);
}
html[data-hx-edition="dyslexic"].dark {
  --bg: #121210;
  --ink: #f0ece2;
  --muted: #b0aa9e;
  --line: rgba(240, 236, 226, 0.18);
  --line-strong: #f0ece2;
  --surf: rgba(240, 236, 226, 0.05);
}
html[data-hx-edition="dyslexic"]:not(.dark) nav { background: #faf8f2 !important; color: #1a1917 !important; }
html[data-hx-edition="dyslexic"].dark nav { background: #121210 !important; color: #f0ece2 !important; }
html[data-hx-edition="dyslexic"] body {
  background: var(--bg) !important;
  color: var(--ink) !important;
  font-family: var(--hx-dyslexic) !important;
  font-size: 17px !important;
  line-height: 1.92 !important;
  letter-spacing: 0.032em !important;
  word-spacing: 0.14em !important;
}
html[data-hx-edition="dyslexic"] main p,
html[data-hx-edition="dyslexic"] main li {
  max-width: 62ch;
}
html[data-hx-edition="dyslexic"] h1,
html[data-hx-edition="dyslexic"] h2,
html[data-hx-edition="dyslexic"] h3,
html[data-hx-edition="dyslexic"] .lede {
  font-family: var(--hx-dyslexic) !important;
  letter-spacing: 0.02em !important;
}
html[data-hx-edition="dyslexic"] .splash h1,
html[data-hx-edition="dyslexic"] .splash .sub,
html[data-hx-edition="dyslexic"] .splash .who {
  font-family: var(--hx-mono) !important;
  letter-spacing: normal !important;
  word-spacing: normal !important;
}

/* ==================== DEPTH LENSES (Geodesic / Formal) ==================== */
.hx-fold-chip {
  display: none;
  margin: 8px 0 12px;
  padding: 5px 10px;
  font: 500 11px/1.2 var(--hx-mono);
  color: inherit;
  opacity: 0.56;
  border: 1px dashed rgba(128, 128, 128, 0.35);
  background: transparent;
  cursor: pointer;
  letter-spacing: 0.03em;
  transition: opacity 0.14s, border-color 0.14s, color 0.14s;
}
.hx-fold-chip:hover { opacity: 1; color: var(--hx-pink); border-color: var(--hx-pink); }
html[data-hx-depth="geodesic"] .hx-prose-folded { display: none !important; }
html[data-hx-depth="geodesic"] .hx-fold-chip { display: inline-flex; align-items: center; gap: 8px; }
html[data-hx-depth="geodesic"] .hx-fold-chip.expanded { border-style: solid; border-color: var(--hx-pink); color: var(--hx-pink); opacity: 0.9; }

html[data-hx-depth="formal"] .chapter > p,
html[data-hx-depth="formal"] .chapter > ul:not(.list):not(.bib-list),
html[data-hx-depth="formal"] .chapter > ol:not(.list):not(.bib-list),
html[data-hx-depth="formal"] article > p {
  opacity: 0.32;
  transition: opacity 0.18s ease;
}
html[data-hx-depth="formal"] .chapter > p:hover,
html[data-hx-depth="formal"] .chapter > ul:not(.list):not(.bib-list):hover,
html[data-hx-depth="formal"] .chapter > ol:not(.list):not(.bib-list):hover,
html[data-hx-depth="formal"] article > p:hover { opacity: 1; }
html[data-hx-depth="formal"] .thm-box,
html[data-hx-depth="formal"] .eq-box,
html[data-hx-depth="formal"] .lab-card,
html[data-hx-depth="formal"] pre,
html[data-hx-depth="formal"] .tbl-wrap { opacity: 1 !important; }
html[data-hx-depth="formal"] pre,
html[data-hx-depth="formal"] .thm-box { box-shadow: -3px 0 0 var(--hx-pink); }

/* ==================== STAT-CELL UNFOLDING EXPOSITIONS ==================== */
.hx-strip-hint {
  font: 500 10.5px/1.3 var(--hx-mono);
  opacity: 0.48;
  margin: 18px 0 7px;
  letter-spacing: 0.03em;
}
.hx-strip-hint + .stat-strip { margin-top: 0 !important; }
.stat-cell.hx-expandable {
  position: relative;
  cursor: pointer;
  transition: border-color 0.14s ease, background 0.14s ease;
}
.stat-cell.hx-expandable > b { padding-right: 20px; }
.stat-cell.hx-expandable:hover { border-color: var(--hx-pink) !important; }
.stat-cell.hx-expandable.hx-open {
  border-color: var(--hx-pink) !important;
  box-shadow: inset 0 -2px 0 var(--hx-pink);
}
.stat-cell .hx-cell-cue {
  position: absolute;
  top: 9px;
  right: 10px;
