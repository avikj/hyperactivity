b2-pfreshif : Word → Bool → Word → Word → (Word → Step W Word) → Step W Word
b2-pfreshif mm_ c p nm kq_ =
  if (c) then (b2-pfresh mm_ p nm #0 "a fresh name" (λ r → let mm_8811 = b2-dep mm_ r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_8811 b2-ERR)) else (kq_ (h4-depl mm_8811 (r))))) else (kq_ (h4-depl mm_ (#0)))
