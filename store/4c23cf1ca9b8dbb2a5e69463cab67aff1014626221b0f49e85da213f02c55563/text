ho-mode-of : List Word → List Word
ho-mode-of a1 =
  if cli-eq a1 nil then "all"
  else if cli-eq a1 "emit" then "emit"
  else if cli-eq a1 "baremetal" then "baremetal"
  else if cli-eq a1 "mesh" then "mesh"
  else if cli-eq a1 "daemon" then "daemon"
  else if cli-eq a1 "visionpro" then "visionpro"
  else if cli-eq a1 "all" then "all"
  else "emit"
