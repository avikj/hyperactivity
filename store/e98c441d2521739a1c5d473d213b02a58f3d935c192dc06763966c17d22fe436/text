h4-DUP = #6
h4-ALO : Word
h4-ALO = #7
h4-REF : Word
h4-REF = #8
h4-NAM : Word
h4-NAM = #9
h4-DRY : Word
h4-DRY = #10
h4-ERA : Word
h4-ERA = #11
h4-MAT : Word
h4-MAT = #12
h4-C00 : Word
h4-C00 = #13
h4-C01 : Word
h4-C01 = #14
h4-C02 : Word
h4-C02 = #15
h4-C16 : Word
h4-C16 = #29
