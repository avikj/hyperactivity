h4-NUM = #30
h4-SWI : Word
h4-SWI = #31
h4-USE : Word
h4-USE = #32
h4-OP2 : Word
h4-OP2 = #33
h4-DSU : Word
h4-DSU = #34
h4-DDU : Word
h4-DDU = #35
h4-EQL : Word
h4-EQL = #36
h4-AND : Word
h4-AND = #37
h4-OR : Word
h4-OR = #38
h4-UNS : Word
h4-UNS = #39
h4-ANY : Word
h4-ANY = #40
