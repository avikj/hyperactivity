-- Terms
-- ===========================================================================================

h4-APP : Word
h4-APP = #0
h4-VAR : Word
h4-VAR = #1
h4-LAM : Word
h4-LAM = #2
h4-DP0 : Word
h4-DP0 = #3
h4-DP1 : Word
h4-DP1 = #4
h4-SUP : Word
h4-SUP = #5
