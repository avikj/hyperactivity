-- Multi-round hierarchical DAG hyperfactoring:
-- Later rounds scan `l-app (l-map snd lemmas) defs` so outer lemmas factor over earlier inner lemmas!
hf-rewrite-lemmas : Code → Word → Lst (Word × Code) → Lst (Word × Code)
hf-rewrite-lemmas tmpl gid lnil = lnil
hf-rewrite-lemmas tmpl gid (lcons gc r) = lcons (fst gc , code-factor-with tmpl gid (snd gc)) (hf-rewrite-lemmas tmpl gid r)
