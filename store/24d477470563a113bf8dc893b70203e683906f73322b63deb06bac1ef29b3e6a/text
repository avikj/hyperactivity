-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_12874 = seen in let j_12875 = j in scmd (w-load ((b2-a mm_ (%wadd v_12874 #2)))) (λ d_12873 → let mm_12876 = b2-dep mm_ d_12873 in scmd (w-load ((b2-a mm_12876 (%wadd d_12873 (%wsucc j_12875))))) (λ x_12872 → let mm_12877 = b2-dep mm_12876 x_12872 in let e = x_12872 in let i_12879 = e in scmd (w-load ((b2-a mm_12877 i_12879))) (λ x_12878 → let mm_12880 = b2-dep mm_12877 x_12878 in let x = x_12878 in if (%weq x p) then (kq_ (h4-depl mm_12880 (e))) else (b2-seenat mm_12880 f seen p (%wsucc j) n kq_)))))
