b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_6877 → let mm_6878 = b2-dep mm_ dd_6877 in b2-take mm_6878 p "-" (λ m → let mm_6879 = b2-dep mm_6878 m in if (%weq m #1) then (kq_ (h4-depl mm_6879 (b2-NONE))) else (b2-take mm_6879 p "+" (λ pl → let mm_6880 = b2-dep mm_6879 pl in if (%weq pl #1) then (kq_ (h4-depl mm_6880 (b2-MANY))) else (kq_ (h4-depl mm_6880 (b2-LONE))))))))
