  let t_7304 = e in scmd (w-load ((b2-a mm_ t_7304))) (λ x_7303 → let mm_7305 = b2-dep mm_ x_7303 in let tg = (%wand x_7303 #255) in if (%weq tg b2-SUB) then (let t_7307 = e in let j_7308 = #2 in scmd (w-load ((b2-a mm_7305 (%wadd t_7307 (%wadd #2 j_7308))))) (λ x_7306 → let mm_7309 = b2-dep mm_7305 x_7306 in let g = x_7306 in b2-unsub mm_7309 f g kq_)) else (kq_ (h4-depl mm_7305 (e))))
