-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_11721 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_11721))) (λ x_11720 → let mm_11722 = b2-dep mm_ x_11720 in let lb = x_11720 in if (%weq lb #0) then (let i_11724 = (%wadd tc #4) in scmd (w-load ((b2-a mm_11722 i_11724))) (λ x_11723 → let mm_11725 = b2-dep mm_11722 x_11723 in let t = x_11723 in kq_ (h4-depl mm_11725 (t)))) else (let i_11727 = (%wadd tc #3) in scmd (w-load ((b2-a mm_11722 i_11727))) (λ x_11726 → let mm_11728 = b2-dep mm_11722 x_11726 in let lx = x_11726 in b2-body mm_11728 bk lb lx (λ r → let mm_11729 = b2-dep mm_11728 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_11729 b2-ERR)) else (kq_ (h4-depl mm_11729 (r)))))))
