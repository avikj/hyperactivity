b2-lowvarsg : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-lowvarsg mm_ zero ks d ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-lowvarsg mm_ (suc f) ks d ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_2500 = ks in let j_2501 = j in scmd (w-load ((b2-a mm_ (%wadd a_2500 (%wsucc j_2501))))) (λ x_2499 → let mm_2502 = b2-dep mm_ x_2499 in let k = x_2499 in b2-Var mm_2502 k (%wadd d j) #0 #0 (λ x → let mm_2503 = b2-dep mm_2502 x in let a_2504 = ob in let j_2505 = j in let v_2506 = x in scmd (w-store ((b2-a mm_2503 (%wadd a_2504 (%wsucc j_2505)))) (v_2506)) (λ uu_2507 → let mm_2508 = hv2-u mm_2503 uu_2507 in b2-lowvarsg mm_2508 f ks d ob (%wsucc j) n kq_))))
