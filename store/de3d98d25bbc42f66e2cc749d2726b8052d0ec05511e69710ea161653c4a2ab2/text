-- Strip `=<binder_name>` annotations from serialized forms/decl so alpha-equivalent binders match identically
hy-drop-ident : List Word → List Word
hy-drop-ident nil = nil
hy-drop-ident (cons c r) =
  if orB (weq c #32) (orB (weq c #41) (orB (weq c #40) (weq c #10))) then cons c r
  else hy-drop-ident r
