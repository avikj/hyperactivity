rp-plus-cancel-r : (a b c : Nat) → plus a c ≡ plus b c → a ≡ b
rp-plus-cancel-r a b c = case c return λ n → plus a n ≡ plus b n → a ≡ b of
  zero → λ p → concat (sym (plus-zero a)) (concat p (plus-zero b))
  suc g → λ p → rec g (rp-suc-inj (plus a g) (plus b g) (concat (sym (plus-suc a g)) (concat p (plus-suc b g))))
