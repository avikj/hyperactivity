b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_6258 = b2-dep mm_ c in let p_6260 = p in let i_6262 = (%wadd p_6260 #1) in scmd (w-load ((b2-a mm_6258 i_6262))) (λ x_6261 → let mm_6263 = b2-dep mm_6258 x_6261 in let x_6259 = x_6261 in let i = x_6259 in let p_6264 = p in let v_6265 = (%wsucc i) in let i_6266 = (%wadd p_6264 #1) in let v_6267 = v_6265 in scmd (w-store ((b2-a mm_6263 i_6266)) (v_6267)) (λ uu_6268 → let mm_6269 = hv2-u mm_6263 uu_6268 in kq_ (h4-depl mm_6269 (c)))))
