      { i: 1, k: 'ADD', p0: 0, p1: 8, v: 0 },
      { i: 2, k: 'NUM', p0: 5, p1: 3, v: b },
      { i: 3, k: 'NUM', p0: 16, p1: 3, v: c },
      { i: 4, k: 'ADD', p0: 12, p1: 20, v: 0 },
      { i: 5, k: 'NUM', p0: 17, p1: 3, v: d }
    ];
  }

  function outSlots() {
    if (kind === 'lit') return [0, 0];
    if (kind === 'add') return [2, 2];
    if (kind === 'dup') return [0, 1];
    return [2, 5];
  }

  function evalSpec() {
    const a = clamp(inA), b = clamp(inB), c = clamp(inC), d = clamp(inD);
    if (kind === 'lit') return [a % 256, a % 256];
    if (kind === 'add') return [(a + b) % 256, (a + b) % 256];
    if (kind === 'dup') {
      const val = driftBug ? ((a + a) % 256) : (a % 256);
      return [val, val];
    }
    return [(a + b) % 256, driftBug ? ((c + d + 1) % 256) : ((c + d) % 256)];
  }

  function isActive(a, b) {
    return CODE[a.k] !== 0 && CODE[b.k] !== 0 && a.p0 === b.i * 4 && b.p0 === a.i * 4;
  }

  function stepCycle(slots) {
    const res = [];
    let rwDst = 3, rwNr = 3, fired = 0;
    const rewires = [];
    const applyRw = s => {
      if (rwDst % 4 === 0 && Math.floor(rwDst / 4) === s.i) return { ...s, p0: rwNr };
      return { ...s };
    };
    let idx = 0;
    while (idx < slots.length) {
      const a = applyRw(slots[idx]);
      if (idx + 1 < slots.length) {
        const b = applyRw(slots[idx + 1]);
        if (isActive(a, b)) {
          fired++;
          if (a.k === 'NUM' && b.k === 'ADD') {
            res.push({ i: a.i, k: 'FREE', p0: 3, p1: 3, v: 0 });
            res.push({ i: b.i, k: 'ADD1', p0: b.p1, p1: 3, v: a.v });
            rwDst = b.p1; rwNr = b.i * 4;
            rewires.push({ from: b.i, to: Math.floor(b.p1 / 4) });
          } else if (a.k === 'ADD1' && b.k === 'NUM') {
            res.push({ i: a.i, k: 'FREE', p0: 3, p1: 3, v: 0 });
            res.push({ i: b.i, k: 'NUM', p0: a.p1, p1: 3, v: (a.v + b.v) % 256 });
            rwDst = a.p1; rwNr = b.i * 4;
          } else if (a.k === 'NUM' && b.k === 'DUP') {
            res.push({ i: a.i, k: 'NUM', p0: b.p1, p1: 3, v: a.v % 256 });
            res.push({ i: b.i, k: 'NUM', p0: 3, p1: 3, v: a.v % 256 });
            rwDst = 3; rwNr = 3;
          } else {
            res.push(a, b);
          }
          idx += 2;
          continue;
        }
      }
      res.push(a);
      idx++;
    }
    return { slots: res, fired, rewires };
  }

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr)); canvas.height = Math.max(1, Math.floor(r.height * dpr));
  }
  new ResizeObserver(resize).observe(stage); resize();

  function setCyc(n) {
    cyc = n;
    cycBtns.forEach((b, i) => b.classList.toggle('on', i === n));
  }
  document.querySelectorAll('[data-ic]').forEach(b => {
    b.onclick = () => {
      kind = b.dataset.ic;
      document.querySelectorAll('[data-ic]').forEach(x => x.classList.toggle('on', x === b));
      if (kind === 'dup') { inA.value = '21'; }
      else if (kind === 'add') { inA.value = '100'; inB.value = '23'; }
      else if (kind === 'par') { inA.value = '17'; inB.value = '25'; inC.value = '30'; inD.value = '12'; }
      else if (kind === 'lit') { inA.value = '42'; }
      setCyc(0);
    };
  });
  cycBtns.forEach((b, i) => { b.onclick = () => { autoPlay = false; btnPlay.classList.remove('on'); setCyc(i); }; });
  btnPlay.onclick = () => { autoPlay = !autoPlay; btnPlay.classList.toggle('on', autoPlay); };
  btnBug.onclick = () => {
    driftBug = !driftBug;
    btnBug.classList.toggle('on', driftBug);
    btnBug.textContent = driftBug ? 'Spec Drift Bug: ACTIVE' : 'Inject Spec Drift Bug';
    if (driftBug && kind !== 'dup' && kind !== 'par') {
      kind = 'dup'; inA.value = '21';
      document.querySelectorAll('[data-ic]').forEach(x => x.classList.toggle('on', x.dataset.ic === 'dup'));
    }
  };

  function draw() {
    tick++;
    if (autoPlay && tick % 55 === 0) setCyc((cyc + 1) % 3);

    const g0 = buildGraph();
    const s1 = stepCycle(g0);
    const s2 = stepCycle(s1.slots);
    const cur = cyc === 0 ? g0 : (cyc === 1 ? s1.slots : s2.slots);
    const rcnt = cyc === 0 ? 0 : (cyc === 1 ? s1.fired : s1.fired + s2.fired);
    const rws = cyc === 1 ? s1.rewires : [];
    const [oHi, oLo] = outSlots();
    const valAt = (sl, id) => { const f = sl.find(x => x.i === id); return f ? f.v : 0; };
    const hwFinal = [valAt(s2.slots, oHi), valAt(s2.slots, oLo)];
    const spec = evalSpec();
    const soundOk = hwFinal[0] === spec[0] && hwFinal[1] === spec[1];

    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#000' : '#fff', ink = dark ? '#fff' : '#000';
    const sub = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.035)';
    const muted = dark ? 'rgba(255,255,255,0.18)' : 'rgba(0,0,0,0.15)';
    const pink = '#ff0a94', blue = dark ? '#4da3ff' : '#1a73e8', green = dark ? '#22c55e' : '#0a8f5c';
    const dpr = Math.min(devicePixelRatio || 1, 2), W = canvas.width / dpr, H = canvas.height / dpr;
    ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height); ctx.scale(dpr, dpr);

    // Top-left: Single-source wire-graph slots S0..S5
    const leftW = Math.floor(W * 0.57), pad = 16;
    ctx.fillStyle = pink; ctx.font = '700 11.5px ui-monospace, Menlo, monospace';
    ctx.fillText(`WIRE GRAPH (ic-graph e) · CYCLE ${cyc} · rcnt = ${rcnt}${cyc === 2 && kind === 'par' ? ' (2.0 redexes/cyc!)' : ''}`, pad, 22);

    const n = cur.length, cols = Math.min(3, Math.max(1, n));
    const sw = (leftW - pad * 2 - (cols - 1) * 14) / cols, sh = 92;
    const pos = {};
    cur.forEach((s, idx) => {
      const r = Math.floor(idx / 3), c = idx % 3;
      const x = pad + c * (sw + 14), y = 40 + r * (sh + 24);
      pos[s.i] = { x, y, cx: x + sw / 2, cy: y + sh / 2 };
      const activeWithNext = idx + 1 < cur.length && isActive(s, cur[idx + 1]);
      const activeWithPrev = idx > 0 && isActive(cur[idx - 1], s);
      const isOut = cyc === 2 && (s.i === oHi || s.i === oLo);
      const col = (activeWithNext || activeWithPrev) ? pink : (isOut ? green : (s.k === 'FREE' ? muted : blue));
      ctx.fillStyle = (activeWithNext || activeWithPrev) ? 'rgba(255,10,148,0.10)' : (isOut ? 'rgba(10,143,92,0.12)' : sub);
      ctx.fillRect(x, y, sw, sh);
      ctx.strokeStyle = col; ctx.lineWidth = (activeWithNext || activeWithPrev || isOut) ? 2 : 1.2;
      ctx.strokeRect(x, y, sw, sh);

      ctx.fillStyle = col; ctx.font = '700 11px ui-monospace, Menlo, monospace';
      ctx.fillText(`SLOT ${s.i} · ${s.k}`, x + 8, y + 18);
      ctx.fillStyle = ink; ctx.font = '600 11px ui-monospace, Menlo, monospace';
      ctx.fillText(`val = #${s.v}`, x + 8, y + 38);
      ctx.fillStyle = dark ? '#aaa' : '#555';
      ctx.fillText(`p0=${s.p0 === 3 ? 'EXT' : '{' + Math.floor(s.p0/4) + ',' + (s.p0%4) + '}'}`, x + 8, y + 58);
      ctx.fillText(`p1=${s.p1 === 3 ? 'EXT' : '{' + Math.floor(s.p1/4) + ',' + (s.p1%4) + '}'}`, x + 8, y + 76);
      if (activeWithNext) {
        // glowing active pair bridge
        ctx.fillStyle = pink; ctx.fillRect(x + sw, y + sh / 2 - 2, 14, 4);
        ctx.beginPath(); ctx.arc(x + sw + 7, y + sh / 2, 4, 0, Math.PI * 2); ctx.fill();
      }
    });
    // Draw rewire arcs on cycle 1
    rws.forEach(rw => {
      const a = pos[rw.from], b = pos[rw.to];
      if (!a || !b) return;
      ctx.strokeStyle = blue; ctx.lineWidth = 1.6; ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(a.cx, a.y + sh); ctx.quadraticCurveTo((a.cx + b.cx) / 2, a.y + sh + 18, b.cx, b.y + sh); ctx.stroke();
      ctx.setLineDash([]);
    });

    // Bottom-left: Proof-time ic-compile-sound witness box
    const py = 276, ph = H - py - 14;
    ctx.fillStyle = soundOk ? 'rgba(10,143,92,0.10)' : 'rgba(255,10,148,0.14)';
    ctx.fillRect(pad, py, leftW - pad * 2, ph);
    ctx.strokeStyle = soundOk ? green : pink; ctx.lineWidth = 2;
    ctx.strokeRect(pad, py, leftW - pad * 2, ph);
    ctx.fillStyle = soundOk ? green : pink; ctx.font = '700 11.5px ui-monospace, Menlo, monospace';
    ctx.fillText(soundOk ? 'ic-compile-sound : Path (Word × Word) ... = refl ✓' : 'ic-compile-sound : REFUSED AT PROOF-TIME ✗ (SPEC DRIFT)', pad + 10, py + 20);
    ctx.fillStyle = ink; ctx.font = '600 11.5px ui-monospace, Menlo, monospace';
    ctx.fillText(`Hardware readout (slots #${oHi}, #${oLo}) : (#${hwFinal[0]} , #${hwFinal[1]})`, pad + 10, py + 44);
    ctx.fillText(`Denotation (eval-hi, eval-lo)     : (#${spec[0]} , #${spec[1]})`, pad + 10, py + 64);
    ctx.fillStyle = soundOk ? blue : pink;
    ctx.fillText(soundOk
      ? (kind === 'par' ? `ic-par-dual-fire-4 : rcnt = #${s1.fired + s2.fired} in 2 cyc (2.0/cyc) = refl ✓` : 'Testbench ic-expect-out projected directly from spec ✓')
      : 'Disagreement (#21 vs #42) blocked before any SV or GDSII is emitted!',
      pad + 10, py + 88);

    // Right column: Structural Tiny Tapeout pin transactions from compile-hexpr
    const rx = leftW + 4, rw = W - rx - 16;
    ctx.fillStyle = dark ? '#080c14' : '#0f172a';
    ctx.fillRect(rx, 14, rw, H - 28);
    ctx.strokeStyle = blue; ctx.lineWidth = 1.4; ctx.strokeRect(rx, 14, rw, H - 28);
    ctx.fillStyle = '#ff0a94'; ctx.font = '700 11px ui-monospace, Menlo, monospace';
    ctx.fillText('EMITTED TINY TAPEOUT PIN STREAM (compile-hexpr)', rx + 10, 32);

    const lines = ['load_field(3\'d0, 2\'d0, 8\'d128); // clear + rst rcnt'];
    g0.forEach(s => {
      lines.push(`load_field(3'd${s.i}, 2'd0, 8'd${CODE[s.k]}); // ${s.k}`);
      lines.push(`load_field(3'd${s.i}, 2'd3, 8'd${s.v}); // val`);
      lines.push(`load_field(3'd${s.i}, 2'd1, 8'd${s.p0}); // p0`);
      if (s.p1 !== 3) lines.push(`load_field(3'd${s.i}, 2'd2, 8'd${s.p1}); // p1`);
    });
    lines.push(`// ic-expect-out: slot ${oHi} === 8'd${spec[0]}${oLo !== oHi ? `, slot ${oLo} === 8'd${spec[1]}` : ''}`);
    ctx.font = '500 10.5px ui-monospace, Menlo, monospace';
    const maxL = Math.floor((H - 64) / 16);
    lines.slice(0, maxL).forEach((ln, i) => {
      ctx.fillStyle = ln.startsWith('//') ? '#22c55e' : '#e2e8f0';
      ctx.fillText(ln, rx + 10, 54 + i * 16);
    });

    st.textContent = `hx-${kind} · Cycle ${cyc}/2 · rcnt=${rcnt} · Readout=(#${hwFinal[0]}, #${hwFinal[1]}) · ${soundOk ? 'ic-compile-sound = refl ✓' : 'PROOF REFUSED ✗'}`;
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();

// Lab 3: Hierarchical Calma GDSII v6.0 Die Inspector + Live Single-Source GdsHier Calculator
(function() {
  const stage = document.getElementById('gdsStage'), canvas = document.getElementById('gdsCanvas'), ctx = canvas.getContext('2d');
  const st = document.getElementById('gdsStatus'), algEl = document.getElementById('gdsAlg');
  let zoom = 0, tc = 45, tr = 30, dc = 4, dr = 4;
  const vis = { feol: true, m12: true, sram: true, noc: true };

  function resize() {
    const r = stage.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(r.width * dpr)); canvas.height = Math.max(1, Math.floor(r.height * dpr));
    render();
  }
  new ResizeObserver(resize).observe(stage);

  document.querySelectorAll('[data-z]').forEach(b => {
    b.onclick = () => { zoom = parseInt(b.getAttribute('data-z'), 10); document.querySelectorAll('[data-z]').forEach(x => x.classList.toggle('on', x === b)); render(); };
  });
  document.querySelectorAll('[data-grid]').forEach(b => {
    b.onclick = () => {
      [tc, tr, dc, dr] = b.getAttribute('data-grid').split(',').map(Number);
      document.querySelectorAll('[data-grid]').forEach(x => x.classList.toggle('on', x === b));
      render();
    };
  });
  document.querySelectorAll('[data-ly]').forEach(b => {
    b.onclick = () => { const k = b.getAttribute('data-ly'); vis[k] = !vis[k]; b.classList.toggle('on', vis[k]); render(); };
  });
  canvas.onclick = () => {
    zoom = (zoom + 1) % 3;
    document.querySelectorAll('[data-z]').forEach(x => x.classList.toggle('on', parseInt(x.getAttribute('data-z'), 10) === zoom));
    render();
  };

  function drawTile(x, y, s, detail) {
    if (vis.m12) { ctx.fillStyle = '#ef4444'; ctx.fillRect(x, y, s, Math.max(2, s * 0.033)); ctx.fillRect(x, y + s * 0.967, s, Math.max(2, s * 0.033)); }
    if (vis.sram) {
      ctx.fillStyle = 'rgba(255,10,148,0.26)'; ctx.strokeStyle = '#ff0a94'; ctx.lineWidth = 1.2;
      const sy = y + s * 0.08, sh = s * 0.38, sw = s * 0.42;
      ctx.fillRect(x + s * 0.04, sy, sw, sh); ctx.strokeRect(x + s * 0.04, sy, sw, sh);
      ctx.fillRect(x + s * 0.54, sy, sw, sh); ctx.strokeRect(x + s * 0.54, sy, sw, sh);
      if (detail) {
        ctx.fillStyle = '#ff0a94'; ctx.font = '700 10px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center';
        ctx.fillText('CELL_SRAM (15/0)', x + s * 0.25, sy + sh * 0.5);
        ctx.fillText('STRIPED VAR_SRAM (15/0)', x + s * 0.75, sy + sh * 0.5);
      }
    }
    if (vis.feol) {
      const rows = detail ? Math.min(30, tr) : Math.min(10, tr);
      const ry0 = y + s * 0.53, rh = (s * 0.40) / rows;
      for (let r = 0; r < rows; r++) {
        ctx.fillStyle = (r % 2 === 0) ? 'rgba(26,115,232,0.55)' : 'rgba(77,163,255,0.38)';
        ctx.fillRect(x + s * 0.05, ry0 + r * rh, s * 0.90, Math.max(1, rh * 0.72));
      }
    }
    if (vis.m12) {
      ctx.fillStyle = '#f59e0b'; ctx.fillRect(x + s * 0.07, y + s * 0.485, s * 0.86, Math.max(2, s * 0.025));
      ctx.fillStyle = '#10b981'; ctx.fillRect(x + s * 0.23, y + s * 0.20, Math.max(2, s * 0.03), s * 0.62);
      ctx.fillRect(x + s * 0.74, y + s * 0.20, Math.max(2, s * 0.03), s * 0.62);
      ctx.fillStyle = '#ffffff'; const vs = Math.max(2.5, s * 0.03);
      ctx.fillRect(x + s * 0.23, y + s * 0.485, vs, vs); ctx.fillRect(x + s * 0.74, y + s * 0.485, vs, vs);
    }
  }

  function render() {
    const sliceP = 6 * 9, tileP = sliceP * tc * tr + 9, dieP = tileP * dc * dr + 8, dieC = 6 * tc * tr * dc * dr;
    const isCert = (tc === 45 && tr === 30 && dc === 4 && dr === 4);
    algEl.innerHTML = `<span><b>GdsHier:</b> 6×9=${sliceP}/slice → <code>gh-rep ${tc} ${tr}</code> + 9 = <b>${tileP.toLocaleString()}</b>/tile → <code>gh-rep ${dc} ${dr}</code> + 8 = <b style="color:var(--pink)">${dieP.toLocaleString()} polys</b> &amp; <b>${dieC.toLocaleString()} cells</b></span><span style="color:${isCert ? 'var(--green)' : 'var(--blue)'}">${isCert ? 'hypernet16-die-polys-cert = refl ✓' : 'gds-rep-poly-law (universal) = refl ✓'}</span>`;

    const dark = document.documentElement.classList.contains('dark');
    const bg = dark ? '#080b12' : '#f8fafc', ink = dark ? '#fff' : '#000';
    const dpr = Math.min(devicePixelRatio || 1, 2), W = canvas.width / dpr, H = canvas.height / dpr;
    ctx.setTransform(1,0,0,1,0,0); ctx.fillStyle = bg; ctx.fillRect(0,0,canvas.width,canvas.height); ctx.scale(dpr, dpr);

    if (zoom === 0) {
      const dieS = Math.min(W - 40, H - 28), dx = (W - dieS) / 2, dy = (H - dieS) / 2;
      if (vis.m12) { ctx.fillStyle = '#ef4444'; ctx.fillRect(dx, dy, dieS, 3); ctx.fillRect(dx, dy + dieS - 3, dieS, 3); }
      const pad = dieS * 0.03, pitch = (dieS - pad * 2) / dc, ts = pitch * 0.90;
      for (let r = 0; r < dr; r++) for (let c = 0; c < dc; c++) drawTile(dx + pad + c * pitch + pitch * 0.05, dy + pad + r * pitch + pitch * 0.05, ts, false);
      if (vis.noc) {
        for (let ch = 1; ch < dc; ch++) {
          const p = pad + ch * pitch;
          ctx.fillStyle = '#06b6d4'; ctx.fillRect(dx + pad, dy + p - 1.5, dieS - pad * 2, 3);
          ctx.fillStyle = '#ff0a94'; ctx.fillRect(dx + p - 1.5, dy + pad, 3, dieS - pad * 2);
        }
      }
      st.textContent = `HYPERNET16_${dc}X${dr}_DIE · AREF ${dc}×${dr} = ${dieC.toLocaleString()} CMOS7 Cells · ${dieP.toLocaleString()} Polygons (click to zoom)`;
    } else if (zoom === 1) {
      const ts = Math.min(W - 60, H - 32);
      drawTile((W - ts) / 2, (H - ts) / 2, ts, true);
      st.textContent = `HYPERNET16_TILE · AREF ${tc}×${tr} STDCELL_SLICE6 = ${(6 * tc * tr).toLocaleString()} CMOS7 Cells · ${tileP.toLocaleString()} Polygons (click to zoom)`;
    } else {
      const names = ['CMOS7_INV', 'CMOS7_NAND2', 'CMOS7_NOR2', 'CMOS7_XOR2', 'CMOS7_MUX2', 'CMOS7_DFF'];
      const gates = [[3,3], [2,7], [2,7], [2,8], [2,8], [2,8]];
      const sw = Math.min(W - 36, 760), sh = Math.min(H - 64, 240), sx = (W - sw) / 2, sy = (H - sh) / 2, cw = sw / 6;
      for (let i = 0; i < 6; i++) {
        const cx = sx + i * cw;
        if (vis.feol) {
          ctx.fillStyle = 'rgba(59,130,246,0.18)'; ctx.fillRect(cx, sy, cw, sh * 0.5);
          ctx.fillStyle = 'rgba(16,185,129,0.45)';
          ctx.fillRect(cx + cw * 0.1, sy + sh * 0.15, cw * 0.8, sh * 0.25);
          ctx.fillRect(cx + cw * 0.1, sy + sh * 0.60, cw * 0.8, sh * 0.25);
          ctx.fillStyle = '#ff0a94';
          const [g1, g2] = gates[i];
          ctx.fillRect(cx + cw * (g1 / 10), sy + sh * 0.10, Math.max(3, cw * 0.09), sh * 0.80);
          if (g2 !== g1) ctx.fillRect(cx + cw * (g2 / 10), sy + sh * 0.10, Math.max(3, cw * 0.09), sh * 0.80);
        }
        if (vis.m12) {
          ctx.fillStyle = '#ef4444'; ctx.fillRect(cx, sy, cw, sh * 0.06); ctx.fillRect(cx, sy + sh * 0.94, cw, sh * 0.06);
          ctx.fillStyle = '#f59e0b'; ctx.fillRect(cx + cw * 0.2, sy + sh * 0.45, cw * 0.6, sh * 0.10);
          ctx.fillStyle = '#ffffff'; ctx.fillRect(cx + cw * 0.46, sy + sh * 0.45, cw * 0.10, sh * 0.10);
        }
        ctx.strokeStyle = dark ? 'rgba(255,255,255,0.28)' : 'rgba(0,0,0,0.28)'; ctx.strokeRect(cx, sy, cw, sh);
        ctx.fillStyle = ink; ctx.font = '700 10.5px ui-monospace, Menlo, monospace'; ctx.textAlign = 'center';
        ctx.fillText(names[i].replace('CMOS7_', ''), cx + cw * 0.5, sy + sh + 16);
      }
      st.textContent = 'STDCELL_SLICE6 (600×200 nm, dbu=1 nm) · 6 Masters × 9 Boxes = 54 Polygons/Slice';
    }
  }
  new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  render();
})();
</script>
