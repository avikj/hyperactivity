b2-thead : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-thead mm_ bk tel ctx def s kq_ =
  b2-wnf mm_ bk tel (λ t → let mm_11398 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_11398 b2-ERR)) else (let t_11400 = t in scmd (w-load ((b2-a mm_11398 t_11400))) (λ x_11399 → let mm_11401 = b2-dep mm_11398 x_11399 in let tg = (%wand x_11399 #255) in if (%weq tg b2-ALL) then (kq_ (h4-depl mm_11401 (t))) else (b2-fail mm_11401 bk ctx "unreachable (a telescope binds its parameters and fields)" #0 s def (λ r → let mm_11402 = b2-dep mm_11401 r in kq_ (h4-depl mm_11402 (r)))))))
