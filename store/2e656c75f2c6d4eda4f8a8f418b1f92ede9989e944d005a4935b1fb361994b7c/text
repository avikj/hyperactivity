tr-run : Proc W Unit
tr-run = bind (h-env "SI_PATH") (λ pth → bind (h-source-text (h-source-or pth)) (λ st → bind (ret (h-source-or st)) (λ t → bind time-now (λ t0 →
  bind (ret (tokenize t)) (λ T → bind (h-out (h-line (list-append "tokens: " (h-decimal (si-len T))))) (λ u →
  bind (ret (si-make T)) (λ L → bind (h-out (h-line (list-append "index bytes: " (h-decimal (si-len L))))) (λ u1 →
  bind time-now (λ t1 → bind (h-out (h-line (list-append "made: " (tr-ms t0 t1)))) (λ u2 →
  bind (h-out (h-line (if si-made-ok T L then "checked: yes" else "checked: NO"))) (λ u3 →
  bind time-now (λ t2 → bind (h-out (h-line (list-append "check: " (tr-ms t1 t2)))) (λ u4 →
  bind (h-out (h-line (list-append "the: " (h-decimal (si-query L (tokenize "the")))))) (λ u5 →
  bind (h-out (h-line (list-append "Kanye: " (h-decimal (si-query L (tokenize "Kanye")))))) (λ u6 →
  bind time-now (λ t3 → bind (h-out (h-line (list-append "two queries: " (tr-ms t2 t3)))) (λ u7 → exit #0)))))))))))))))))
