-- Preset 1: Midnight Drive (91 BPM A-minor Nightcall / Outrun — 1/32 grid, rolling bass, gated snare, vocoder lead)
daw-nightcall : OsEffect
daw-nightcall = eff-daw (daw-all (
  cons (daw-bpm #91) (
  cons (daw-loop #0 #8) (
  cons (daw-grid #2) (
  cons (daw-patch #0 "bass" #26 #24 #22 #18) (
  cons (daw-patch #1 "pad"  #44 #18 #8  #22) (
  cons (daw-patch #3 "lead" #58 #32 #16 #68) (
  cons (daw-mix #0 #88 #6  #4) (
  cons (daw-mix #1 #80 #54 #24) (
  cons (daw-mix #2 #90 #18 #5) (
  cons (daw-mix #3 #76 #58 #52) (
  cons (daw-wasm "mul (div (mul in p1) (add 1.0 (abs (mul in p1)))) p2") (
  cons (daw-play true) nil)))))))))))))
