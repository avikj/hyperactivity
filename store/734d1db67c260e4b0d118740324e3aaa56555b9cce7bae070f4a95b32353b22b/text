-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10805 = tld in scmd (w-load ((b2-a mm_ t_10805))) (λ x_10804 → let mm_10806 = b2-dep mm_ x_10804 in let tg = (%wand x_10804 #255) in if (%weq tg b2-TADT) then (let t_10808 = tld in let j_10809 = #4 in scmd (w-load ((b2-a mm_10806 (%wadd t_10808 (%wadd #2 j_10809))))) (λ x_10807 → let mm_10810 = b2-dep mm_10806 x_10807 in let b = x_10807 in kq_ (h4-depl mm_10810 (b)))) else (let t_10812 = tld in let j_10813 = #5 in scmd (w-load ((b2-a mm_10806 (%wadd t_10812 (%wadd #2 j_10813))))) (λ x_10811 → let mm_10814 = b2-dep mm_10806 x_10811 in let b = x_10811 in kq_ (h4-depl mm_10814 (b))))))
