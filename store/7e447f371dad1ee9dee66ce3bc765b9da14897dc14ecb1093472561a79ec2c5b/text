b2-failout : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-failout mm_ seen base kq_ =
  scmd (w-load ((b2-HERR mm_))) (λ e → let mm_15242 = b2-dep mm_ e in b2-errshow mm_15242 e (λ es → let mm_15243 = b2-dpl mm_15242 es in b2-location mm_15243 e seen base (λ lc → let mm_15244 = b2-dpl mm_15243 lc in scmd ((w-fd-write #2 (list-append "SOME PROOFS FAIL" (cons #10 (list-append es (list-append lc (cons #10 nil))))))) (λ w → let mm_15245 = b2-dep mm_15244 w in kq_ (h4-depl mm_15245 (#1))))))
