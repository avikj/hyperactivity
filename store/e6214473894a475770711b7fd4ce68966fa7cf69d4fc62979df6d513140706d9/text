-- what induction builds on constructor k's fields (the last field innermost, then the
-- eliminator's own wires)
nk-elim-body : NkTm → Word → NkTm
nk-elim-body cs k =
  let fl = nk-el-args (nk-branch (nk-el-args (nk-branch cs #0)) k)
  in nk-el-ihs fl (nk-el-up fl cs) (nk-el-fields fl (nk-el-up fl (nk-branch cs (%wadd k #2))))
