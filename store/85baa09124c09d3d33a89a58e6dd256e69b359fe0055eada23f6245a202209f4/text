r4d-bc-rhs-term : (C : Type) → Nat → (BstUF → C) → C
r4d-bc-rhs-term C kB cont =
  (λ tf →
    r4d-bc-simp C 1 2 3 4 5 tf (λ s0 →
    r4d-bc-simp C 0 2 3 4 5 tf (λ s1 →
    r4d-bc-simp C 0 1 3 4 5 tf (λ s2 →
    bst-force-uf C (r4d-uf-mul (bin-of-nat (times (suc kB) (suc kB)) , bin-one)
                               (r4d-uf-mul s0 (r4d-uf-mul s1 s2)))
      (λ n d → cont (n , d))))))
  (r4d-with-fB r4d-bc-tri kB)
