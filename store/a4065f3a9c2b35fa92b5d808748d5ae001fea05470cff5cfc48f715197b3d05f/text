b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10770 = cs in let j_10771 = j in scmd (w-load ((b2-a mm_ (%wadd v_10770 #2)))) (λ d_10768 → let mm_10772 = b2-dep mm_ d_10768 in scmd (w-load ((b2-a mm_10772 (%wadd d_10768 (%wsucc j_10771))))) (λ x_10769 → let mm_10773 = b2-dep mm_10772 x_10769 in let c = x_10769 in let t_10775 = c in let j_10776 = #0 in scmd (w-load ((b2-a mm_10773 (%wadd t_10775 (%wadd #2 j_10776))))) (λ x_10774 → let mm_10777 = b2-dep mm_10773 x_10774 in let ck = x_10774 in if (%weq ck k) then (kq_ (h4-depl mm_10777 (c))) else (b2-ctrfind mm_10777 f cs k (%wsucc j) n kq_)))))
