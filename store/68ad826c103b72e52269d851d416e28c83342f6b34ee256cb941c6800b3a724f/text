sf-eprl-fold2 : Nat → Nat → Nat → Nat → BQ → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → List (Nat × (Nat × BQ)) → BQ → BQ
sf-eprl-fold2 Jp Jm ip1 im1 wt1 opts2 opts3 opts4 opts5 acc = case opts2 of
  nil → acc
  cons o2 rest2 →
    sf-eprl-fold2 Jp Jm ip1 im1 wt1 rest2 opts3 opts4 opts5
      (sf-eprl-fold3 Jp Jm ip1 im1 (fst o2) (fst (snd o2)) (bq-mul wt1 (snd (snd o2))) opts3 opts4 opts5 acc)
