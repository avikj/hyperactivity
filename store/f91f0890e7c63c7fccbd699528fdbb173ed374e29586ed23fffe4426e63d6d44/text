e-tr-at : (List Word → List Word) → Sum Unit (List Word) → List Word
e-tr-at k (inl u) = nil
e-tr-at k (inr r) = if andB (h-infix "mention-tr" (e-upto-c #34 r)) (andB (h-infix e-q r) (h-infix ">" (e-or (e-after-c #34 r))))
  then e-text (e-upto "</span>" (e-or (e-after ">" (e-or (e-after-c #34 r))))) else k r
