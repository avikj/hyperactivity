-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10639 = tld in scmd (w-load ((b2-a mm_ t_10639))) (λ x_10638 → let mm_10640 = b2-dep mm_ x_10638 in let tg = (%wand x_10638 #255) in if (%weq tg b2-TADT) then (let t_10642 = tld in let j_10643 = #4 in scmd (w-load ((b2-a mm_10640 (%wadd t_10642 (%wadd #2 j_10643))))) (λ x_10641 → let mm_10644 = b2-dep mm_10640 x_10641 in let b = x_10641 in kq_ (h4-depl mm_10644 (b)))) else (let t_10646 = tld in let j_10647 = #5 in scmd (w-load ((b2-a mm_10640 (%wadd t_10646 (%wadd #2 j_10647))))) (λ x_10645 → let mm_10648 = b2-dep mm_10640 x_10645 in let b = x_10645 in kq_ (h4-depl mm_10648 (b))))))
