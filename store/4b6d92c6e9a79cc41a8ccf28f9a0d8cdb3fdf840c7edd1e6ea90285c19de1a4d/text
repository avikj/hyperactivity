tir-hex-loop : List Word → List Word
tir-hex-loop tl =
  tir-ln "static void fmt_abi_u64(char out65[65], uint64_t v){"
  (tir-ln (list-append "  const char* H = " (list-append (tir-qq "0123456789abcdef") ";"))
  (tir-ln "  for(int i=0;i<48;i++) out65[i]='0';"
  (tir-ln "  for(int i=0;i<16;i++) out65[63-i] = H[(v >> (i*4)) & 0xFu];"
  (tir-ln "  out65[64] = 0;"
  (tir-ln "}" tl)))))
