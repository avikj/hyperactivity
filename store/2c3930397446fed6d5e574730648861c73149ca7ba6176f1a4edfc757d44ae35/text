b2-namelist : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-namelist mm_ zero v j n acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-namelist mm_ (suc f) v j n acc kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (acc))) else (let v_15091 = v in let j_15092 = j in scmd (w-load ((b2-a mm_ (%wadd v_15091 #2)))) (λ d_15089 → let mm_15093 = b2-dep mm_ d_15089 in scmd (w-load ((b2-a mm_15093 (%wadd d_15089 (%wsucc j_15092))))) (λ x_15090 → let mm_15094 = b2-dep mm_15093 x_15090 in let k = x_15090 in b2-namekey mm_15094 k (λ kb → let mm_15095 = b2-dpl mm_15094 kb in b2-namelist mm_15095 f v (%wsucc j) n (the (List Word) (if %weq j #0 then kb else list-append acc (list-append ", " kb))) kq_))))
