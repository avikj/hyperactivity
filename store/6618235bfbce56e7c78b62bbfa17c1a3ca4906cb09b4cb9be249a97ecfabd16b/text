-- Section (5): exact integer instantiation, Wigner's friend qubit, and timeless relational spin-clock.
-- Exact signed integers over Int (pos n = +n, negsuc n = -(n+1)) for small concrete verdicts.
rqm-iadd-pn : Nat → Nat → Int
rqm-iadd-pn a b = case a of
  zero → negsuc b
  suc a1 → case b of
    zero → pos a1
    suc b1 → rqm-iadd-pn a1 b1
