  b2-at mm_ p w (λ r → let mm_7082 = b2-dep mm_ r in if (%weq r #0) then (kq_ (h4-depl mm_7082 (#0))) else (let p_7084 = p in let i_7086 = (%wadd p_7084 #1) in scmd (w-load ((b2-a mm_7082 i_7086))) (λ x_7085 → let mm_7087 = b2-dep mm_7082 x_7085 in let x_7083 = x_7085 in let i = x_7083 in let p_7088 = p in let v_7089 = (%wadd i (cli-len w)) in let i_7090 = (%wadd p_7088 #1) in let v_7091 = v_7089 in scmd (w-store ((b2-a mm_7087 i_7090)) (v_7091)) (λ uu_7092 → let mm_7093 = hv2-u mm_7087 uu_7092 in kq_ (h4-depl mm_7093 (#1))))))
