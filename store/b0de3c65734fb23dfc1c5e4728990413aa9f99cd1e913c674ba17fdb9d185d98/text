rxn-match-cols : List (List Nat) → List (List Nat) → List Nat → Nat → Nat → List Nat → Bool
rxn-match-cols adjL adjG m u v rowL = case rowL of
  nil → true
  cons luv lr →
    if eqb luv (rxn-adj adjG (rxn-nth-nat m u) (rxn-nth-nat m v))
    then rxn-match-cols adjL adjG m u (suc v) lr
    else false
