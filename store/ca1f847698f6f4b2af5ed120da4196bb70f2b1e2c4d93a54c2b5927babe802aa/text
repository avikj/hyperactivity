-- safety (src/ast.rs propagate_safety): a definition is unsafe if it has a DUP or refers to an
-- unsafe one; the closure is reached after as many rounds as there are definitions
hv2-safe-of : List Word → List (List Word) → List Bool → Bool
hv2-safe-of n names safes = hv2-bool-at (hv2-index n names) safes
