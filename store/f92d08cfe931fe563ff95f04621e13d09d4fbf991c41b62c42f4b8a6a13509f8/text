b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_6834 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_6834 (#1))) else (b2-pstr mm_6834 p (λ s → let mm_6835 = b2-dep mm_6834 s in let p_6837 = p in let i_6839 = (%wadd p_6837 #1) in scmd (w-load ((b2-a mm_6835 i_6839))) (λ x_6838 → let mm_6840 = b2-dep mm_6835 x_6838 in let x_6836 = x_6838 in let i = x_6836 in let a_6842 = s in scmd (w-load ((b2-a mm_6840 a_6842))) (λ x_6841 → let mm_6843 = b2-dep mm_6840 x_6841 in let n = x_6841 in b2-col mm_6843 s i (λ c → let mm_6844 = b2-dep mm_6843 c in kq_ (h4-depl mm_6844 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
