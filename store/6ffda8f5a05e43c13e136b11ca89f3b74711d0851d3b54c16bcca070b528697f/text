-- the potential row G(v, ·) for vertex v (chem/h2plus-net's hp-s0 … hp-s9, in 1/280)
cw-srow : Nat → List Nat
cw-srow v = case v of
  zero → hp-s0
  suc a → (case a of
    zero → hp-s1
    suc b → (case b of
      zero → hp-s2
      suc c → (case c of
        zero → hp-s3
        suc d → (case d of
          zero → hp-s4
          suc e → (case e of
            zero → hp-s5
            suc f → (case f of
              zero → hp-s6
              suc g → (case g of
                zero → hp-s7
                suc h → (case h of
                  zero → hp-s8
                  suc i → hp-s9))))))))
