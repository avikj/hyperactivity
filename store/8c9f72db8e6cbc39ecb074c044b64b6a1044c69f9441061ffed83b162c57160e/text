-- THEOREM 3 (UNIVERSAL ZERO-FALSE-NEGATIVE CONVEX-HULL & BINDING BNB PRUNING):
boc-thm-hull-bnb-sound :
  (lb e best : Nat) →
  boc-le-nat lb e ≡ true →
  boc-le-nat (suc best) lb ≡ true →
  boc-le-nat (suc best) e ≡ true
boc-thm-hull-bnb-sound lb e best hle hlt = boc-le-trans (suc best) lb e hlt hle
