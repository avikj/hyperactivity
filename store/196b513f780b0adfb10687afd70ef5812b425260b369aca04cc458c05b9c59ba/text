-- the shown names k1 .. kn of a Let, each after its quantity
b2-letks : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-letks mm_ zero ks qs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-letks mm_ (suc f) ks qs j acc kq_ =
  let a_1299 = ks in scmd (w-load ((b2-a mm_ a_1299))) (λ x_1298 → let mm_1300 = b2-dep mm_ x_1298 in let n = x_1298 in if (%weq j n) then (kq_ (h4-depl mm_1300 (acc))) else (let a_1302 = ks in let j_1303 = j in scmd (w-load ((b2-a mm_1300 (%wadd a_1302 (%wsucc j_1303))))) (λ x_1301 → let mm_1304 = b2-dep mm_1300 x_1301 in let k = x_1301 in let a_1306 = qs in let j_1307 = j in scmd (w-load ((b2-a mm_1304 (%wadd a_1306 (%wsucc j_1307))))) (λ x_1305 → let mm_1308 = b2-dep mm_1304 x_1305 in let q = x_1305 in b2-nbytes mm_1308 k (λ kb → let mm_1309 = b2-dpl mm_1308 kb in let one = list-append (b2-qshow q) kb in b2-letks mm_1309 f ks qs (%wsucc j) (the (List Word) (if %weq j #0 then one else list-append acc (cons #32 one))) kq_)))))
