h4-wrs : Word → Nat → Word → List Word → (Word → Step W Word) → Step W Word
h4-wrs m zero at xs k =
  k (h4-depl m (at))
h4-wrs m (suc f) at xs k =
  if (%weq (cli-len xs) #0) then (k (h4-depl m (at))) else (scmd (w-store ((h4-ha m at)) ((hv2-nth #0 xs))) (λ u29 → let m30 = hv2-u m u29 in h4-wrs m30 f (%wsucc at) (hv2-drop1 xs) k))
