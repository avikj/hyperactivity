-- the table, one row per tag of the first port, read at the tag of the second
hv2-row : Word → List Word
hv2-row t =
  if %weq t #0 then cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 (cons #0 nil)))))))
  else if %weq t #1 then cons #0 (cons #2 (cons #2 (cons #2 (cons #1 (cons #1 (cons #1 (cons #1 nil)))))))
  else if %weq t #2 then cons #0 (cons #2 (cons #2 (cons #2 (cons #3 (cons #3 (cons #3 (cons #3 nil)))))))
  else if %weq t #3 then cons #0 (cons #2 (cons #2 (cons #2 (cons #3 (cons #3 (cons #6 (cons #7 nil)))))))
  else if %weq t #4 then cons #0 (cons #1 (cons #3 (cons #3 (cons #4 (cons #5 (cons #5 (cons #5 nil)))))))
  else if %weq t #5 then cons #0 (cons #1 (cons #3 (cons #3 (cons #5 (cons #4 (cons #5 (cons #5 nil)))))))
  else if %weq t #6 then cons #0 (cons #1 (cons #3 (cons #6 (cons #5 (cons #5 (cons #4 (cons #5 nil)))))))
  else cons #0 (cons #1 (cons #3 (cons #7 (cons #5 (cons #5 (cons #5 (cons #4 nil)))))))
