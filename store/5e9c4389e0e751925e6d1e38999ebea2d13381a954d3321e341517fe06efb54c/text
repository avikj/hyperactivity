b2-pushall mm_ zero v ks j kq_ =
  kq_ (h4-depl mm_ (#0))
b2-pushall mm_ (suc f) v ks j kq_ =
  let a_1738 = ks in scmd (w-load ((b2-a mm_ a_1738))) (λ x_1737 → let mm_1739 = b2-dep mm_ x_1737 in let n = x_1737 in if (%weq j n) then (kq_ (h4-depl mm_1739 (#0))) else (let a_1741 = ks in let j_1742 = j in scmd (w-load ((b2-a mm_1739 (%wadd a_1741 (%wsucc j_1742))))) (λ x_1740 → let mm_1743 = b2-dep mm_1739 x_1740 in let k = x_1740 in b2-vpush mm_1743 v k (λ dd_1744 → let mm_1745 = b2-dep mm_1743 dd_1744 in b2-pushall mm_1745 f v ks (%wsucc j) kq_))))
