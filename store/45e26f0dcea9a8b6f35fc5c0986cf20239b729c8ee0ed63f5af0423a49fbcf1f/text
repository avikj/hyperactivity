-- at u: (the lines there, the sum of the potential over their other ends)
hp-at : Nat → List FaradayLine → List Nat → Nat × Nat
hp-at u ls phi = case ls of
  nil → (zero , zero)
  cons l rest → (if eqb (fst l) u then (suc (fst (hp-at u rest phi)) , plus (np-nth (snd l) phi) (snd (hp-at u rest phi)))
    else (if eqb (snd l) u then (suc (fst (hp-at u rest phi)) , plus (np-nth (fst l) phi) (snd (hp-at u rest phi))) else hp-at u rest phi))
