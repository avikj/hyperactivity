grv-sg-c0 : Nat → Nat → Nat → Nat → Nat → Nat → GrvZ
grv-sg-c0 J J2 J3 J4 J5 J6 =
  (λ K K2 K3 K4 K5 K6 →
    grv-z-mul (grv-z-of-nat (times 2 (suc J)))
      (grv-z-add
        (grv-z-mul (grv-z-of-nat K)
                   (grv-z-sub-nat (plus (plus K2 K3) (plus K5 K6)) (plus K (times 2 K4))))
        (grv-z-mul (grv-z-sub-nat K2 K3) (grv-z-sub-nat K5 K6))))
  (times J (plus J 2)) (times J2 (plus J2 2)) (times J3 (plus J3 2))
  (times J4 (plus J4 2)) (times J5 (plus J5 2)) (times J6 (plus J6 2))
