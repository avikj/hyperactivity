b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10333 = cs in let j_10334 = j in scmd (w-load ((b2-a mm_ (%wadd v_10333 #2)))) (λ d_10332 → let mm_10335 = b2-dep mm_ d_10332 in scmd (w-load ((b2-a mm_10335 (%wadd d_10332 (%wsucc j_10334))))) (λ x_10331 → let mm_10336 = b2-dep mm_10335 x_10331 in let c = x_10331 in let t_10338 = c in let j_10339 = #0 in scmd (w-load ((b2-a mm_10336 (%wadd t_10338 (%wadd #2 j_10339))))) (λ x_10337 → let mm_10340 = b2-dep mm_10336 x_10337 in let ck = x_10337 in if (%weq ck k) then (kq_ (h4-depl mm_10340 (c))) else (b2-ctrfind mm_10340 f cs k (%wsucc j) n kq_)))))
