-- Section (3): Exact SU(2) intertwiner space dimension for ARBITRARY valence N via Weyl character polynomials.
-- Represent a symmetric character product as a list of binary natural coefficients for shifted powers 0 .. S
-- (where S = sum J_i). Multiplying by chi_J(z) = z^{-J}(1 + z^2 + ... + z^{2J}) adds J+1 shifted copies of p.
qg-poly-add : List (List Bool) → List (List Bool) → List (List Bool)
qg-poly-add p q = case p of
  nil → q
  cons x xs → case q of
    nil → p
    cons y ys → cons (bin-add x y) (qg-poly-add xs ys)
