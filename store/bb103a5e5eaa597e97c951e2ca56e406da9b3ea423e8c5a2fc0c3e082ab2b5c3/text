    (cons "if [ `$OS` = `Darwin` ] && ! xcode-select -p >/dev/null 2>&1; then"
    (cons "  echo `[BOOT] Triggering Xcode Command Line Tools install (re-run after install completes)...`"
    (cons "  xcode-select --install || true"
    (cons "  exit 1"
    (cons "fi"
    (cons nil
    nil))))))))))))))))))))))
