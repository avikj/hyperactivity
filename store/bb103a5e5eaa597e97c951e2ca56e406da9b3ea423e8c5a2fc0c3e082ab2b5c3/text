s-install-sh-q0 : List Word
s-install-sh-q0 =
  s-lines-q
    (cons "#!/bin/sh"
    (cons "# Hyperactivity One-Click Fleet, Hypernet & Bare-Metal Hyperkernel Bootstrapper"
    (cons "# Targets: Mac Studio · Mac mini · Magic Keyboard/Mouse · Display · Apple Vision Pro · Bare-Metal EL1"
    (cons "set -eu"
