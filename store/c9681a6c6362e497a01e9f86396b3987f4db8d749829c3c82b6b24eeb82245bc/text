-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7109 = tel in let j_7110 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7109 (%wsucc j_7110))))) (λ x_7108 → let mm_7111 = b2-dep mm_ x_7108 in let c = x_7108 in let i_7113 = c in scmd (w-load ((b2-a mm_7111 i_7113))) (λ x_7112 → let mm_7114 = b2-dep mm_7111 x_7112 in let q = x_7112 in let i_7116 = (%wadd c #1) in scmd (w-load ((b2-a mm_7114 i_7116))) (λ x_7115 → let mm_7117 = b2-dep mm_7114 x_7115 in let k = x_7115 in let i_7119 = (%wadd c #2) in scmd (w-load ((b2-a mm_7117 i_7119))) (λ x_7118 → let mm_7120 = b2-dep mm_7117 x_7118 in let i = x_7118 in let i_7122 = (%wadd c #3) in scmd (w-load ((b2-a mm_7120 i_7122))) (λ x_7121 → let mm_7123 = b2-dep mm_7120 x_7121 in let vT = x_7121 in let i_7125 = (%wadd c #4) in scmd (w-load ((b2-a mm_7123 i_7125))) (λ x_7124 → let mm_7126 = b2-dep mm_7123 x_7124 in let s = x_7124 in b2-All mm_7126 q k i vT e s (λ a → let mm_7127 = b2-dep mm_7126 a in b2-telebindg mm_7127 f tel (%wsub j #1) a kq_))))))))
