-- (B) Concrete Smerlak-Rovelli no-signaling: Alice's marginal p(+ | a0, b0) = p(+ | a0, b1) = 1/2!
qe-no-signaling-345 : both
  (qe-bq-eq (bq-add (qe-singlet-prob qe-a0 qe-b0-345 true true) (qe-singlet-prob qe-a0 qe-b0-345 true false)) (qe-q 1 2))
  (qe-bq-eq (bq-add (qe-singlet-prob qe-a0 qe-b1-345 true true) (qe-singlet-prob qe-a0 qe-b1-345 true false)) (qe-q 1 2)) ≡ true
qe-no-signaling-345 = refl
