s-page-as : Bool → List Word → List Word → List Word
s-page-as md path text = list-append (h-concat (cons "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" (cons (s-esc (s-title-of path (inr text))) (cons (list-append " · Avik Jain</title>" (list-append (s-og (s-esc (s-title-of path (inr text)))) "<style>")) (cons s-style (cons "</style>" (cons s-math (cons um-tag (cons "</head><body>" (cons s-nav (cons "<main><div class='path'>" (cons (s-esc path) (cons "</div>" (cons (if h-eq path "paper.md" then "<div class='paper-actions'><a class='primary' href='/pdf'>◈ View PDF</a><a href='/paper.pdf' download='hyperactivity.pdf'>↓ Download PDF</a><button type='button' onclick='window.print()'>⎙ Print</button><a href='/nets'>Interaction Net Lab</a><a href='/learn'>Language Tour</a></div>" else nil) nil))))))))))))))
  (list-append (if md then md-doc text else list-append "<pre>" (list-append (s-esc text) "</pre>")) "</main></body></html>")
