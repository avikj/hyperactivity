-- In input order A=0xaa, B=0xcc, C=0xf0 the six unordered NAND pairs are
-- AA=85, AB=119, AC=95, BB=51, BC=63 and CC=15, including tied inputs.
hs-thm-one-gate-pairs :
  andB (andB (hs-one-gate-ok #85) (hs-one-gate-ok #119))
    (andB (andB (hs-one-gate-ok #95) (hs-one-gate-ok #51))
          (andB (hs-one-gate-ok #63) (hs-one-gate-ok #15))) ≡ true
hs-thm-one-gate-pairs = refl
