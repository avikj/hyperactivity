grh-emit : GrhNode → List Word
grh-emit grh-empty = nil
grh-emit (grh-seq a b) = list-append (grh-emit a) (grh-emit b)
grh-emit (grh-raw s) = s
grh-emit (grh-chap cid cnum ctitle body) =
  grh-ln (list-append "<section class='chapter' id='" (list-append cid "'>")) (
  grh-ln (list-append "  <div class='ch-num'>" (list-append cnum "</div>")) (
  grh-ln (list-append "  <h2>" (list-append ctitle "</h2>")) (
  list-append body (
  grh-ln "</section>" nil))))
