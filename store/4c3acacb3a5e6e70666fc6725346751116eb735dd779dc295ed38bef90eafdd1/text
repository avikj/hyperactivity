-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10163 = tld in scmd (w-load ((b2-a mm_ t_10163))) (λ x_10162 → let mm_10164 = b2-dep mm_ x_10162 in let tg = (%wand x_10162 #255) in if (%weq tg b2-TADT) then (let t_10166 = tld in let j_10167 = #4 in scmd (w-load ((b2-a mm_10164 (%wadd t_10166 (%wadd #2 j_10167))))) (λ x_10165 → let mm_10168 = b2-dep mm_10164 x_10165 in let b = x_10165 in kq_ (h4-depl mm_10168 (b)))) else (let t_10170 = tld in let j_10171 = #5 in scmd (w-load ((b2-a mm_10164 (%wadd t_10170 (%wadd #2 j_10171))))) (λ x_10169 → let mm_10172 = b2-dep mm_10164 x_10169 in let b = x_10169 in kq_ (h4-depl mm_10172 (b))))))
