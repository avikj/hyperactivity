b2-bodyor : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-bodyor mm_ bk lb lx t kq_ =
  if (%weq lb #0) then (kq_ (h4-depl mm_ (t))) else (b2-body mm_ bk lb lx (λ r → let mm_10773 = b2-dep mm_ r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10773 b2-ERR)) else (kq_ (h4-depl mm_10773 (r)))))
