-- THEOREM 2 (Postulate 1 + Postulate 2 => Necessary Erasure / Quantum Complementarity):
-- On any finite system of capacity 2^M distinguishable states, NO family of M + 1 yes/no questions
-- can be jointly realized as mutually independent facts. Thus acquiring genuinely new information
-- (Postulate 2) after a complete M-bit measurement NECESSARILY erases prior relevant information.
rp-postulate2-erasure : (S : Type) → (M : Nat) → (qs : rp-Qs S (suc M)) → (xs : List S) →
  rp-len S xs ≡ rp-pow2 M → rp-Indep S (suc M) qs xs → Empty
rp-postulate2-erasure S M qs xs hlen ind =
  rp-postulate2-le M (rp-len S xs) hlen (rp-postulate1 S (suc M) qs xs ind)
