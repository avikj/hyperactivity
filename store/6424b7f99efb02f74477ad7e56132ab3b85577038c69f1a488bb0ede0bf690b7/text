ga-mk-and : GaGuard → GaGuard → GaGuard
ga-mk-and (ga-k false) b            = ga-k false
ga-mk-and (ga-k true)  b            = b
ga-mk-and a            (ga-k false) = ga-k false
ga-mk-and a            (ga-k true)  = a
ga-mk-and a            b            =
  if ga-eq b (ga-not a) then ga-k false
  else if ga-eq a (ga-not b) then ga-k false
  else ga-and a b
