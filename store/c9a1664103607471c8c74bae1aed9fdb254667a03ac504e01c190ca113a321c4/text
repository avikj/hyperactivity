-- ── 2. Zero-Block 4-Stem Physical Modal Separator & Superposition Law ───────
-- Decomposes ANY raw acoustic stream sample x[n] causally in 1 sample (0 STFT lag)
-- into 4 physical stems: Bass (s0), Vocal/Body (s1), Percussion/Transient (s2),
-- and Air/Harmonic residual (s3 = x - s0 - s1 - s2).
-- Universal exact conservation over Q: s0 + s1 + s2 + s3 = x identically!
-- Variables (0..3): x, s0, s1, s2.
stem4-conserve-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
stem4-conserve-poly A ad mu q vs =
  (λ g sub _ →
    let x = g 0; s0 = g 1; s1 = g 2; s2 = g 3
        s3 = sub (sub (sub x s0) s1) s2
        recomp = ad (ad (ad s0 s1) s2) s3
    in (recomp , x))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
