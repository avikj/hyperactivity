grv-sg-equil-fact-at : Nat → Bool
grv-sg-equil-fact-at ell =
  (λ l2lp12 →
    (λ aFull bFull cFull →
      both (eqb aFull (times l2lp12 (plus (times 3 ell) 2)))
           (both (eqb bFull (times l2lp12 (plus (times 2 ell) 1)))
                 (eqb cFull (times l2lp12 (plus (times 3 ell) 1)))))
    (times ell (times (times (suc ell) (suc ell))
                      (monus (times (plus (times 2 ell) 1) (plus (times 2 ell) 1))
                             (times (suc ell) (suc ell)))))
    (times (plus (times 2 ell) 1) (times (times ell (suc ell)) (times ell (suc ell))))
    (times (suc ell) (times (times ell ell)
                            (monus (times (plus (times 2 ell) 1) (plus (times 2 ell) 1))
                                   (times ell ell)))))
  (times (times ell ell) (times (suc ell) (suc ell)))
