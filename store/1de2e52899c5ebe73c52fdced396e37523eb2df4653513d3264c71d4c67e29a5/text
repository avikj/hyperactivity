function selectScene(id, playSound = false) {
  const sc = SCENES.find(s => s.id === id) || SCENES[0];
  state.scene = sc.id;
  document.querySelectorAll('.scene-btn').forEach(b => b.classList.toggle('active', b.dataset.id === sc.id));
  document.getElementById('hudKicker').textContent = sc.kicker;
  document.getElementById('hudModule').textContent = sc.mod;
  document.getElementById('hudTitle').textContent = sc.title;
  document.getElementById('hudFormula').textContent = sc.formula;
  document.getElementById('hudDesc').textContent = sc.desc;
  document.getElementById('proofLedger').innerHTML = `
    <div class="ledger-mod"><span>${sc.mod}</span><span>✓ CHECKED</span></div>
    <div class="ledger-thm">${sc.thm}</div>
    <div class="ledger-txt">${sc.ledger}</div>
    <div class="ledger-links">
      <a href="${sc.secUrl}">Read Monograph →</a>
      <a href="${sc.netUrl}">Open in /nets →</a>
    </div>
  `;
  try {
    const url = new URL(location.href);
    url.searchParams.set('scene', sc.id);
    history.replaceState(null, '', url.toString());
  } catch (_) {}
  buildParamsUI();
  updateMetrics();
  if (playSound) chimeCurrentScene();
}

