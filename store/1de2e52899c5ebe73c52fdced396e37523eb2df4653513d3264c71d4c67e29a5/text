  [ 0.95, -0.55, -0.45, -0.65], // 1 (f_A)
  [ 0.00,  1.05, -0.45, -0.65], // 2 (f_A)
  [-0.85,  0.50,  0.65,  0.65], // 3 (f_B)
  [ 0.85,  0.50,  0.65,  0.65], // 4 (f_B)
  [ 0.00, -1.00,  0.65,  0.65]  // 5 (f_B)
];

function drawPachnerScene(W, H, isLight, ink) {
  const cx = W * 0.48, cy = H * 0.55, sc = Math.min(W, H) * 0.27;
  const m = state.morph33;
  const pts = K6_VERTS_4D.map((v, idx) => {
    const isA = idx < 3;
    const pull = isA ? (1 - 0.26 * m) : (0.74 + 0.26 * m);
    return proj4D([v[0]*pull, v[1]*pull, v[2], v[3]], cx, cy, sc);
  });

  // All 15 edges of K_6
  for (let i = 0; i < 6; i++) {
    for (let j = i + 1; j < 6; j++) {
      const inFA = (i < 3 && j < 3);
      const inFB = (i >= 3 && j >= 3);
      const inGrav = state.gravitonOn && ((i===0&&j===1)||(i===0&&j===3)||(i===1&&j===3));
      ctx.save();
      if (inFA) {
        ctx.strokeStyle = synColor('a', '#ff0a94');
        ctx.lineWidth = 3.8 * (1.25 - 0.6 * m);
        ctx.globalAlpha = 0.95 - 0.55 * m;
      } else if (inFB) {
        ctx.strokeStyle = synColor('b', '#00e5ff');
        ctx.lineWidth = 3.8 * (0.65 + 0.6 * m);
        ctx.globalAlpha = 0.40 + 0.55 * m;
      } else {
        ctx.strokeStyle = isLight ? 'rgba(0,0,0,0.24)' : 'rgba(255,255,255,0.24)';
        ctx.lineWidth = 1.5;
      }
      if (inGrav) {
        ctx.strokeStyle = '#ffd400';
        ctx.lineWidth = 4.2;
        ctx.globalAlpha = 1;
      }
      ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); ctx.stroke();
      ctx.restore();
    }
  }

  // Internal Bulk Hinge f_A = (0,1,2)
  ctx.save();
  ctx.fillStyle = `rgba(255, 10, 148, ${(0.28 * (1 - m * 0.7)).toFixed(3)})`;
  ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y); ctx.lineTo(pts[1].x, pts[1].y); ctx.lineTo(pts[2].x, pts[2].y); ctx.closePath(); ctx.fill();
  ctx.restore();

  // Dual Internal Bulk Hinge f_B = (3,4,5)
  ctx.save();
  ctx.fillStyle = `rgba(0, 229, 255, ${(0.28 * (0.3 + m * 0.7)).toFixed(3)})`;
  ctx.beginPath(); ctx.moveTo(pts[3].x, pts[3].y); ctx.lineTo(pts[4].x, pts[4].y); ctx.lineTo(pts[5].x, pts[5].y); ctx.closePath(); ctx.fill();
  ctx.restore();

  // Boundary Spin-3/2 Graviton Face (0,1,3) + Animated Wave Ripples
  if (state.gravitonOn) {
    const pulse = 0.24 + 0.14 * Math.sin(state.t * 4.2);
    ctx.save();
    ctx.fillStyle = `rgba(255, 212, 0, ${pulse.toFixed(3)})`;
    ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y); ctx.lineTo(pts[1].x, pts[1].y); ctx.lineTo(pts[3].x, pts[3].y); ctx.closePath(); ctx.fill();
    const gx = (pts[0].x + pts[1].x + pts[3].x) / 3;
    const gy = (pts[0].y + pts[1].y + pts[3].y) / 3;
    for (let k = 0; k < 2; k++) {
      const r = ((state.t * 48 + k * 28) % 56);
      ctx.strokeStyle = `rgba(255,212,0,${(1 - r/56)*0.85})`;
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(gx, gy, r, 0, Math.PI*2); ctx.stroke();
    }
    ctx.fillStyle = '#ffd400';
    ctx.font = '700 11.5px ui-monospace, Menlo, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('★ j = 3/2 GRAVITON (0,1,3)', gx, gy - 10);
    ctx.restore();
  }

  // Bulk Hinge Labels & Interference Bar
  const cAx = (pts[0].x + pts[1].x + pts[2].x) / 3, cAy = (pts[0].y + pts[1].y + pts[2].y) / 3;
  const cBx = (pts[3].x + pts[4].x + pts[5].x) / 3, cBy = (pts[3].y + pts[4].y + pts[5].y) / 3;
  ctx.font = '700 12px ui-monospace, Menlo, monospace';
  ctx.textAlign = 'center';
  ctx.fillStyle = '#ff0a94';
  ctx.fillText('LHS₃ Hinge f_A (0,1,2)', cAx, cAy + 4);
  ctx.fillStyle = '#00e5ff';
  ctx.fillText('RHS₃ Hinge f_B (3,4,5)', cBx, cBy + 4);

  // Vertices 0..5
  pts.forEach((p, idx) => {
    const col = idx < 3 ? synColor(String(idx), '#ff0a94') : synColor(String(idx), '#00e5ff');
    ctx.fillStyle = isLight ? '#fff' : '#000';
    ctx.strokeStyle = col; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(p.x, p.y, 13 * p.s, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = ink;
    ctx.font = `700 ${Math.round(11.5 * p.s)}px ui-monospace, Menlo, monospace`;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(`v${idx}`, p.x, p.y);
  });

  // Bottom-left Bulk Channel Interference Meter (j_A = 1/2 vs j_A = 3/2)
  const bx = 24, by = H - 108, bw = 310, bh = 84;
  ctx.save();
  ctx.fillStyle = isLight ? 'rgba(255,255,255,0.92)' : 'rgba(7,7,7,0.92)';
  ctx.strokeStyle = ink; ctx.lineWidth = 2;
  ctx.fillRect(bx, by, bw, bh); ctx.strokeRect(bx, by, bw, bh);
  ctx.font = '700 10px ui-monospace, Menlo, monospace';
  ctx.textAlign = 'left'; ctx.fillStyle = '#ff0a94';
  ctx.fillText(state.gravitonOn ? 'BULK HINGE f_A INTERFERENCE (1-GRAVITON)' : 'BULK HINGE f_A WEIGHTS (MONO j=1/2)', bx + 10, by + 16);

  const wHalf = 1.0;
  const wThreeHalf = state.pachnerMode === 'bf' ? (state.gravitonOn ? -1.0 : 1.0)
                   : state.pachnerMode === 'bc' ? -0.42
                   : (state.gravitonOn ? -0.198 : (15625 / 117649));
  ctx.fillStyle = '#00f900';
  ctx.fillRect(bx + 92, by + 28, wHalf * 125, 13);
  ctx.fillStyle = ink; ctx.fillText('j_A = 1/2:', bx + 10, by + 38);
  ctx.fillText(state.gravitonOn ? '+64 · B(1/2)' : '7⁶ = 117,649', bx + 224, by + 38);

  ctx.fillStyle = wThreeHalf < 0 ? '#ff0a94' : '#00e5ff';
  const barW = Math.abs(wThreeHalf) * 125;
  ctx.fillRect(bx + 92, by + 49, barW, 13);
  ctx.fillStyle = ink; ctx.fillText('j_A = 3/2:', bx + 10, by + 59);
  ctx.fillText(state.gravitonOn ? (state.pachnerMode==='bf' ? '−64 (CANCELS!)' : '−64 · UV SUPP') : '5⁶ = 15,625', bx + 224, by + 59);

  ctx.fillStyle = (state.gravitonOn && state.pachnerMode !== 'bf') ? '#ffd400' : '#00e5ff';
  ctx.fillText(state.gravitonOn
    ? (state.pachnerMode === 'bf' ? 'SUM: +64 − 64 = 0 (TOPOLOGICAL)' : 'SUM: > 0 — LOCAL CURVATURE AWAKENED!')
    : 'RATIO: 7⁶ : 5⁶ = 7.53× UV FINITE SUPPRESSION', bx + 10, by + 76);
  ctx.restore();

  // Sub-canvas: 4*pi*B_4^gamma(1/2^4) exact curve from 16/15 to 4/5
  document.getElementById('subTitle').textContent = 'SPEZIALE BOOSTER 4π B₄^γ';
  document.getElementById('subBadge').textContent = `γ=${state.gamma.toFixed(2)}`;
  drawBoosterGammaSub(isLight, ink);
}

function drawBoosterGammaSub(isLight, ink) {
  const W = subCanvas.width, H = subCanvas.height;
  subCtx.clearRect(0, 0, W, H);
  const padL = 56, padR = 24, padT = 26, padB = 38;
  const pw = W - padL - padR, ph = H - padT - padB;
  subCtx.strokeStyle = isLight ? 'rgba(0,0,0,0.25)' : 'rgba(255,255,255,0.25)';
  subCtx.lineWidth = 2;
  subCtx.strokeRect(padL, padT, pw, ph);

  subCtx.strokeStyle = '#ff0a94'; subCtx.lineWidth = 4;
  subCtx.beginPath();
  for (let s = 0; s <= 60; s++) {
    const g = s / 60;
    const val = exactB4Half(g); // in [0.80, 1.0667]
    const x = padL + g * pw;
    const y = padT + (1 - (val - 0.75) / 0.36) * ph;
    if (s === 0) subCtx.moveTo(x, y); else subCtx.lineTo(x, y);
  }
  subCtx.stroke();

  // Exact theorem anchors: gamma=0 (16/15), gamma=1/4, gamma=1/2, gamma=1 (4/5)
  [[0, '16/15', '#00f900'], [0.25, 'Euler', '#00e5ff'], [0.5, 'Euler', '#00e5ff'], [1.0, '4/5', '#ffd400']].forEach(([g, lbl, col]) => {
    const val = exactB4Half(g);
    const x = padL + g * pw, y = padT + (1 - (val - 0.75) / 0.36) * ph;
    subCtx.fillStyle = col;
    subCtx.beginPath(); subCtx.arc(x, y, 6.5, 0, Math.PI*2); subCtx.fill();
    subCtx.font = '700 15px ui-monospace, Menlo, monospace';
    subCtx.textAlign = 'center';
    subCtx.fillText(lbl, x, y - 12);
  });

  // Current gamma marker
  const curV = exactB4Half(state.gamma);
  const gx = padL + state.gamma * pw, gy = padT + (1 - (curV - 0.75) / 0.36) * ph;
  subCtx.strokeStyle = '#ffd400'; subCtx.lineWidth = 3;
  subCtx.beginPath(); subCtx.arc(gx, gy, 11, 0, Math.PI*2); subCtx.stroke();
  subCtx.fillStyle = ink; subCtx.font = '700 15px ui-monospace, Menlo, monospace';
  subCtx.textAlign = 'left'; subCtx.fillText('γ=0', padL, H - 10);
  subCtx.textAlign = 'right'; subCtx.fillText('γ=1', W - padR, H - 10);
}

