<script>
// ============================================================================
// 1. AVIK'S EXACT SYNESTHESIA PALETTE (docs/synesthesia.cub)
// ============================================================================
const SYN_COLORS = {
  a:'#ff2600', b:'#fffb00', c:'#00f900', d:'#945200', e:'#00f900', f:'#008f00',
  g:'#008f00', h:'#ffb6dc', i:'#0433ff', j:'#0433ff', k:'#942193', l:'#ffffff',
  m:'#ff2600', n:'#fffb00', o:'#87cefa', p:'#ffb6dc', q:'#d880c8', r:'#945200',
  s:'#fffb00', t:'#00f900', u:'#ffb6dc', v:'#fffb00', w:'#942193', x:'#942193',
  y:'#fffb00', z:'#ffffff',
  '0':'#ffffff', '1':'#ffffff', '2':'#87cefa', '3':'#ff9300', '4':'#fffb00',
  '5':'#0433ff', '6':'#ff2600', '7':'#00f900', '8':'#fffb00', '9':'#942193'
};
let synMode = false;
function synColor(label, fallback) {
  if (!synMode) return fallback;
  const ch = String(label || 'h').toLowerCase().replace(/[^a-z0-9]/g, '')[0] || 'h';
  return SYN_COLORS[ch] || fallback;
}

// ============================================================================
// 2. EXACT RATIONAL HARMONIC SONIFICATION ENGINE
// ============================================================================
const SPHERE_RINGS = [
  { label:'1:1',   num:1,  den:1,  ang:-Math.PI/2 },
  { label:'16:15', num:16, den:15, ang:-Math.PI/2 + Math.PI*2*(1/8) },
  { label:'9:8',   num:9,  den:8,  ang:-Math.PI/2 + Math.PI*2*(2/8) },
  { label:'5:4',   num:5,  den:4,  ang:-Math.PI/2 + Math.PI*2*(3/8) },
  { label:'4:3',   num:4,  den:3,  ang:-Math.PI/2 + Math.PI*2*(4/8) },
  { label:'3:2',   num:3,  den:2,  ang:-Math.PI/2 + Math.PI*2*(5/8) },
  { label:'21:16', num:21, den:16, ang:-Math.PI/2 + Math.PI*2*(6/8) },
  { label:'2:1',   num:2,  den:1,  ang:-Math.PI/2 + Math.PI*2*(7/8) }
];
const activeArcs = [];

class RationalHarmonicEngine {
  constructor() {
    this.ctx = null; this.master = null; this.analyser = null;
    this.enabled = true; this.baseHz = 256;
    this.droneOn = false; this.droneNodes = null;
    this.lastToneAt = 0;
  }
  init() {
    if (this.ctx) { if (this.ctx.state === 'suspended') this.ctx.resume(); return; }
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    this.ctx = new AC();
    this.master = this.ctx.createGain();
    this.master.gain.value = 0.20;
    this.analyser = this.ctx.createAnalyser();
    this.analyser.fftSize = 256;
    this.master.connect(this.analyser);
    this.analyser.connect(this.ctx.destination);
  }
  playRatio(num, den, tag, color = '#ff0a94', dur = 0.42, throttleMs = 55) {
    const nowPerf = performance.now();
    if (nowPerf - this.lastToneAt < throttleMs) return;
    this.lastToneAt = nowPerf;
    let r = Math.abs(num / (den || 1));
    if (!isFinite(r) || r <= 0) r = 1;
    while (r < 0.5) r *= 2;
    while (r > 2.5) r *= 0.5;
    document.getElementById('sphereRatio').textContent = `${num}:${den}`;
    document.getElementById('ratioReadout').innerHTML = `${num}:${den} · ${(r).toFixed(3)}×<span>${tag || 'exact rational harmonic'}</span>`;
    activeArcs.push({ ratio: r, label: `${num}:${den}`, color, alpha: 1.0 });
    if (activeArcs.length > 10) activeArcs.shift();
    if (!this.enabled) return;
    this.init();
    if (!this.ctx) return;
    const t0 = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const osc2 = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'triangle';
    osc2.type = 'sine';
    osc.frequency.setValueAtTime(this.baseHz * r, t0);
    osc2.frequency.setValueAtTime(this.baseHz, t0);
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.exponentialRampToValueAtTime(0.18, t0 + 0.018);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    const g2 = this.ctx.createGain();
    g2.gain.value = 0.35;
    osc.connect(g);
    osc2.connect(g2); g2.connect(g);
    g.connect(this.master);
    osc.start(t0); osc2.start(t0);
    osc.stop(t0 + dur + 0.03); osc2.stop(t0 + dur + 0.03);
  }
  playChord(ratios, tag) {
    ratios.forEach(([n, d, col], idx) => {
      setTimeout(() => this.playRatio(n, d, tag, col || '#ff0a94', 0.65, 0), idx * 75);
    });
  }
  toggleDrone() {
    this.init();
    if (!this.ctx) return false;
    this.droneOn = !this.droneOn;
    if (!this.droneOn && this.droneNodes) {
      const now = this.ctx.currentTime;
      this.droneNodes.g.gain.exponentialRampToValueAtTime(0.0001, now + 0.3);
      const dn = this.droneNodes;
      setTimeout(() => { try { dn.o1.stop(); dn.o2.stop(); } catch (_) {} }, 340);
      this.droneNodes = null;
      return false;
    }
    if (this.droneOn) {
      const o1 = this.ctx.createOscillator(), o2 = this.ctx.createOscillator(), g = this.ctx.createGain();
      o1.type = 'sine'; o2.type = 'triangle';
      o1.frequency.value = this.baseHz * 0.5;
      o2.frequency.value = this.baseHz * 0.75;
      g.gain.value = 0.08;
      o1.connect(g); o2.connect(g); g.connect(this.master);
      o1.start(); o2.start();
      this.droneNodes = { o1, o2, g };
    }
    return this.droneOn;
  }
  setBase(hz) {
    this.baseHz = hz;
    if (this.droneNodes && this.ctx) {
      this.droneNodes.o1.frequency.setValueAtTime(hz * 0.5, this.ctx.currentTime);
      this.droneNodes.o2.frequency.setValueAtTime(hz * 0.75, this.ctx.currentTime);
    }
  }
}
const audio = new RationalHarmonicEngine();

// ============================================================================
// 3. EXACT MACHINE-VERIFIED DATASETS FROM THE 24 LQG/*.CUB MODULES
// ============================================================================
const TAUTOMER_ATLAS = [
  { id:1,  name:'1,3-Keto–enol',        pair:'Acetone ⇌ Prop-1-en-2-ol',      L:'CH₃-C(=O)-CH₃',   R:'CH₂=C(OH)-CH₃',   barrier:58, bias:11, inchi:true,  crys:false, assay:false, nmr:true,  atoms:['C','C','O','C','H'], shift:'O←H←Cα' },
  { id:2,  name:'1,3-β-Diketone',       pair:'Acetylacetone keto ⇌ enol',     L:'O=C-CH₂-C=O',     R:'O=C-CH=C-OH',     barrier:24, bias:2,  inchi:true,  crys:false, assay:true,  nmr:true,  atoms:['O','C','C','C','O','H'], shift:'O₁⋯H⋯O₂' },
