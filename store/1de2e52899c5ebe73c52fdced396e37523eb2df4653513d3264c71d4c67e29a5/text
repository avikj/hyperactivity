let dragStart = null;
canvas.addEventListener('pointerdown', e => {
  dragStart = { x: e.clientX, y: e.clientY, rx: state.rotX, ry: state.rotY };
  canvas.setPointerCapture(e.pointerId);
  // Check Booster matrix click
  if (state.scene === 'booster' && lastMatrixRect) {
    const rect = canvas.getBoundingClientRect();
    const sx = e.clientX - rect.left;
    const sy = e.clientY - rect.top;
    const mr = lastMatrixRect;
    if (sx >= mr.x && sx <= mr.x + mr.size && sy >= mr.y && sy <= mr.y + mr.size) {
      const ci = Math.floor(((sx - mr.x) / mr.size) * 4);
      const ri = Math.floor(((sy - mr.y) / mr.size) * 4);
      if (ri >= 0 && ri < 4 && ci >= 0 && ci < 4) {
        state.selCell = [ri, ci];
        const cell = B4_SPIN32[ri][ci];
        audio.playRatio(cell.rNum, cell.rDen, `B̂(${2*ri},${2*ci}) = ${cell.str}`, cell.num === 0 ? '#00e5ff' : '#ff0a94', 0.48, 0);
        dragStart = null;
      }
    }
  }
});
canvas.addEventListener('pointermove', e => {
  if (!dragStart) return;
  state.rotY = dragStart.ry + (e.clientX - dragStart.x) * 0.0065;
  state.rotX = Math.max(-1.35, Math.min(1.35, dragStart.rx + (e.clientY - dragStart.y) * 0.0065));
});
canvas.addEventListener('pointerup', () => { dragStart = null; });
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  state.zoom = Math.max(0.55, Math.min(1.9, state.zoom * (e.deltaY < 0 ? 1.08 : 0.93)));
}, { passive: false });

function proj3D(x, y, z, cx, cy, scale) {
  const cy1 = Math.cos(state.rotY), sy1 = Math.sin(state.rotY);
  const cx1 = Math.cos(state.rotX), sx1 = Math.sin(state.rotX);
  const x1 = x * cy1 + z * sy1;
  const z1 = -x * sy1 + z * cy1;
  const y2 = y * cx1 - z1 * sx1;
  const z2 = y * sx1 + z1 * cx1;
  const persp = 4.2 / (4.2 + z2 * 0.48);
  return { x: cx + x1 * scale * persp * state.zoom, y: cy + y2 * scale * persp * state.zoom, z: z2, s: persp * state.zoom };
}

function proj4D(v4, cx, cy, scale) {
  const cw = Math.cos(state.rotW), sw = Math.sin(state.rotW);
  const x = v4[0] * cw - v4[3] * sw;
  const w = v4[0] * sw + v4[3] * cw;
  const y = v4[1] * Math.cos(state.rotW * 0.6) - w * 0.32;
  const z = v4[2] + w * 0.45;
  return proj3D(x, y, z, cx, cy, scale);
}

