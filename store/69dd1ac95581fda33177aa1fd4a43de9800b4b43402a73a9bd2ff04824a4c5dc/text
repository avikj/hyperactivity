tir-c4 : List Word → List Word
tir-c4 tl =
  tir-ln "static uint64_t flash_profit_uusdc(u128 wethBuy, u128 usdcBuy, uint32_t feeBuy, u128 wethSell, u128 usdcSell, uint32_t feeSell, uint64_t dxUusdc, uint64_t gasUusdc){"
  (tir-ln "  u128 wethOut = amm_out_256(usdcBuy, wethBuy, (u128)dxUusdc, feeBuy);"
  (tir-ln "  u128 usdcOut = amm_out_256(wethSell, usdcSell, wethOut, feeSell);"
  (tir-ln "  u128 cost = (u128)dxUusdc + (u128)gasUusdc;"
  (tir-ln "  return (usdcOut > cost) ? (uint64_t)(usdcOut - cost) : 0ull;"
  (tir-ln "}"
  (tir-ln "// Unclamped signed gross return (usdcOut - dxUusdc) — globally concave on (0, inf), ZERO 0-clamp plateau!"
  (tir-ln "static int64_t flash_gross_delta(u128 wethBuy, u128 usdcBuy, uint32_t fB, u128 wethSell, u128 usdcSell, uint32_t fS, uint64_t dxUusdc){"
  (tir-ln "  u128 wethOut = amm_out_256(usdcBuy, wethBuy, (u128)dxUusdc, fB);"
  (tir-ln "  u128 usdcOut = amm_out_256(wethSell, usdcSell, wethOut, fS);"
  (tir-ln "  return (usdcOut >= (u128)dxUusdc) ? (int64_t)(usdcOut - (u128)dxUusdc) : -(int64_t)((u128)dxUusdc - usdcOut);"
  (tir-ln "}"
  (tir-ln "static uint64_t opt_flash_arb(u128 wethBuy, u128 usdcBuy, uint32_t fB, u128 wethSell, u128 usdcSell, uint32_t fS, uint64_t gasUusdc, uint64_t* outBestDx){"
  (tir-ln "  uint64_t lo = 1ull, hi = (uint64_t)(usdcBuy / 40000u);"
  (tir-ln "  if(hi < 2ull) hi = 2ull;"
  (tir-ln "  while(lo < hi){"
  (tir-ln "    uint64_t mid = lo + ((hi - lo) >> 1);"
  (tir-ln "    int64_t g0 = flash_gross_delta(wethBuy,usdcBuy,fB,wethSell,usdcSell,fS,mid*10000ull);"
  (tir-ln "    int64_t g1 = flash_gross_delta(wethBuy,usdcBuy,fB,wethSell,usdcSell,fS,(mid+1ull)*10000ull);"
  (tir-ln "    if(g1 > g0) lo = mid + 1ull; else hi = mid;"
  (tir-ln "  }"
  (tir-ln "  uint64_t bestDx = 0ull, bestP = 0ull;"
  (tir-ln "  uint64_t startK = (lo > 16ull) ? (lo - 16ull) : 1ull;"
  (tir-ln "  for(uint64_t k = startK; k <= lo + 16ull; k++){"
  (tir-ln "    uint64_t dx = k * 10000ull;"
  (tir-ln "    uint64_t p = flash_profit_uusdc(wethBuy,usdcBuy,fB,wethSell,usdcSell,fS,dx,gasUusdc);"
  (tir-ln "    if(p > bestP){ bestP = p; bestDx = dx; }"
  (tir-ln "  }"
  (tir-ln "  *outBestDx = bestDx; return bestP;"
  (tir-ln "}" tl)))))))))))))))))))))))))))))
