b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_3002 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_3002 #7))) (λ kd → let mm_3003 = b2-dep mm_3002 kd in scmd (w-load ((b2-HR mm_3003 #8))) (λ v → let mm_3004 = b2-dep mm_3003 v in if (%weq kd #0) then (kq_ (h4-depl mm_3004 (v))) else (scmd (w-load ((b2-HR mm_3004 #11))) (λ md2 → let mm_3005 = b2-dep mm_3004 md2 in scmd (w-load ((b2-HR mm_3005 #12))) (λ a2 → let mm_3006 = b2-dep mm_3005 a2 in scmd (w-load ((b2-HR mm_3006 #13))) (λ b2 → let mm_3007 = b2-dep mm_3006 b2 in scmd (w-load ((b2-HR mm_3007 #14))) (λ c2 → let mm_3008 = b2-dep mm_3007 c2 in b2-wnfrun mm_3008 f rx bk md2 a2 b2 c2 kq_))))))))
