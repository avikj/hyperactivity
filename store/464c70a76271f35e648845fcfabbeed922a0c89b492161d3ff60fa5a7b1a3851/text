b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_3114 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_3114 #7))) (λ kd → let mm_3115 = b2-dep mm_3114 kd in scmd (w-load ((b2-HR mm_3115 #8))) (λ v → let mm_3116 = b2-dep mm_3115 v in if (%weq kd #0) then (kq_ (h4-depl mm_3116 (v))) else (scmd (w-load ((b2-HR mm_3116 #11))) (λ md2 → let mm_3117 = b2-dep mm_3116 md2 in scmd (w-load ((b2-HR mm_3117 #12))) (λ a2 → let mm_3118 = b2-dep mm_3117 a2 in scmd (w-load ((b2-HR mm_3118 #13))) (λ b2 → let mm_3119 = b2-dep mm_3118 b2 in scmd (w-load ((b2-HR mm_3119 #14))) (λ c2 → let mm_3120 = b2-dep mm_3119 c2 in b2-wnfrun mm_3120 f rx bk md2 a2 b2 c2 kq_))))))))
