h4-autodup : Word → H4S → Word → Word → Word → Word → Word → Word → (H4S × Word → Step W Word) → Step W Word
h4-autodup mm_ s body lvl base tgt ext uses kq_ =
  if (not (%wlt #1 uses)) then (kq_ (h4-depl mm_ ((s , body)))) else (let kk = %wsub uses #1 in let lab = h4s-flab s in let s1 = h4s-wflab s (%wadd lab kk) in h4-ad mm_ (h4s-fu s) #1 (h4-val body) #0 (h4-arity body) lvl base #0 kk lab tgt ext (λ dd_52 → let mm_53 = h4-dep mm_ dd_52 in h4-adwrap mm_53 (h4s-fu s) kk kk lab lvl base tgt ext body (λ r → let mm_54 = h4-dep mm_53 r in kq_ (h4-depl mm_54 ((s1 , r))))))
