-- Section (3): Landauer Bottleneck Theorem — projecting into a 2^M-state target necessarily erases > M bits.
-- If every output ch(a) lies in a target alphabet ys of size 2^M, then no M + 1 yes/no questions on B can
-- remain mutually independent over ys (even if the source A had strictly larger capacity).
qi-landauer-bottleneck : (A B : Type) → (M : Nat) → (qs : rp-Qs B (suc M)) → (ys : List B) →
  rp-len B ys ≡ rp-pow2 M → rp-Indep B (suc M) qs ys → Empty
qi-landauer-bottleneck A B M qs ys hlen ind = rp-postulate2-erasure B M qs ys hlen ind
