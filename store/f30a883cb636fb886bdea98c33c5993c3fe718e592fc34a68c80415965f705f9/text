-- 280 (U(v) − U(a)) = k for nuclei at a and b, the electron's vertex v next to a nucleus
hp-gap : Nat → Nat → List Nat → List Nat → List Nat → Nat → Bool
hp-gap v a sv sa sb k = eqb (plus (plus (fst (hp-u v sv sa sb)) (snd (hp-u a sa sa sb))) zero) (plus (plus (snd (hp-u v sv sa sb)) (fst (hp-u a sa sa sb))) k)
