-- ---------------------------------------------------------------- lookups (etym.py's Etym)
-- a page name as Wiktionary links it (etym.py's key without its lowercase): Unicode decomposed, macrons
-- and breves dropped, composed again (Latin īnfāns → infans, Greek πᾰ́σχω → πάσχω)
-- a Latin vowel with a macron or a breve: its letter (0 when not one)
e-unmac : Word → Word → Word
e-unmac a b =
  if weq a #196 then (if weq b #128 then #65 else if weq b #129 then #97 else if weq b #130 then #65 else if weq b #131 then #97 else if weq b #146 then #69 else if weq b #147 then #101
    else if weq b #148 then #69 else if weq b #149 then #101 else if weq b #170 then #73 else if weq b #171 then #105 else if weq b #172 then #73 else if weq b #173 then #105 else #0)
  else if weq a #197 then (if weq b #140 then #79 else if weq b #141 then #111 else if weq b #142 then #79 else if weq b #143 then #111 else if weq b #170 then #85 else if weq b #171 then #117
    else if weq b #172 then #85 else if weq b #173 then #117 else #0)
  else if andB (weq a #200) (weq b #178) then #89 else if andB (weq a #200) (weq b #179) then #121 else #0
