eg-main : List (List Word) → Step W Word
eg-main args =
  let p  = eg-pref args
      cf = list-append p "_endgame.c"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf eg-c-src) (λ bc →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-ENDGAME (32nd Engine — Closed-Loop Autopoietic Self-Prover) | Shannon=Proved | P2P-CRDT=Proved | Autopoiesis=Proved | C="
       (list-append (ce-dec bc)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))
       (sdone #0))))
