-- Σ ± t_j with t_{j+1} = t_j·r2 / ((k+1)(k+2)), alternating
ief-ser : Nat → Word → List Word → List Word → Word × List Word → Word → Word × List Word
ief-ser zero k t r2 acc sg = acc
ief-ser (suc n) k t r2 acc sg =
  if bg-is0 t then acc
  else ief-ser n (%wadd k #2) (bg-divw (bg-shr (bg-mul t r2) ief-P) (%wmul (%wadd k #1) (%wadd k #2))) r2
         (sx-add acc (sg , t)) (%wxor sg #1)
