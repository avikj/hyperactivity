-- named character references MediaWiki writes, and the numeric ones
e-named : List Word → List Word
e-named n =
  if h-eq n "amp" then "&" else if h-eq n "lt" then "<" else if h-eq n "gt" then ">" else
  if h-eq n "quot" then cons #34 nil else if h-eq n "apos" then "'" else if h-eq n "nbsp" then e-utf8 #160 else
  if h-eq n "ndash" then e-utf8 #8211 else if h-eq n "mdash" then e-utf8 #8212 else if h-eq n "hellip" then e-utf8 #8230 else
  if h-eq n "lsquo" then e-utf8 #8216 else if h-eq n "rsquo" then e-utf8 #8217 else if h-eq n "ldquo" then e-utf8 #8220 else
  if h-eq n "rdquo" then e-utf8 #8221 else if h-eq n "laquo" then e-utf8 #171 else if h-eq n "raquo" then e-utf8 #187 else
  if h-eq n "middot" then e-utf8 #183 else if h-eq n "times" then e-utf8 #215 else if h-eq n "minus" then e-utf8 #8722 else
  if h-eq n "thinsp" then e-utf8 #8201 else if h-eq n "lrm" then e-utf8 #8206 else if h-eq n "rlm" then e-utf8 #8207 else
  if h-eq n "shy" then e-utf8 #173 else if h-eq n "deg" then e-utf8 #176 else if h-eq n "prime" then e-utf8 #8242 else
  if h-eq n "zwj" then e-utf8 #8205 else if h-eq n "zwnj" then e-utf8 #8204 else if h-eq n "ensp" then e-utf8 #8194 else
  if h-eq n "emsp" then e-utf8 #8195 else nil
