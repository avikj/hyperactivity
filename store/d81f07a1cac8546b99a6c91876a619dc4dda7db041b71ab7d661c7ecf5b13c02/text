vx-decide-mealy :
  Word → Word → Word →
  Word → (Word → Word → Word × Word) →
  Word → (Word → Word → Word × Word) →
  VxMealyVerdict
vx-decide-mealy nS1 nS2 nI s10 stp1 s20 stp2 =
  vx-bfs-mealy stp1 stp2 (toNat nI) (toNat (%wmul nS1 nS2))
    (cons (s10 , s20) nil)
    (cons ((s10 , s20) , nil) nil)
