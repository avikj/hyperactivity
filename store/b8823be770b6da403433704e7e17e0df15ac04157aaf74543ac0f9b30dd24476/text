-- Discrete divergence at vertex x on any finite oriented graph es : List (Nat x Nat).
qgm-div : (A : Type) → A → (A → A → A) → (A → A) → Nat → List (Nat × Nat) → List A → A
qgm-div A z add neg x es fs = case es of
  nil → z
  cons e erest → add (qgm-edge-div A z add neg x (fst e) (snd e) (qgm-hd A z fs))
                     (qgm-div A z add neg x erest (qgm-tl A fs))
