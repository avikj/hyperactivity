-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10964 = tld in scmd (w-load ((b2-a mm_ t_10964))) (λ x_10963 → let mm_10965 = b2-dep mm_ x_10963 in let tg = (%wand x_10963 #255) in if (%weq tg b2-TADT) then (let t_10967 = tld in let j_10968 = #4 in scmd (w-load ((b2-a mm_10965 (%wadd t_10967 (%wadd #2 j_10968))))) (λ x_10966 → let mm_10969 = b2-dep mm_10965 x_10966 in let b = x_10966 in kq_ (h4-depl mm_10969 (b)))) else (let t_10971 = tld in let j_10972 = #5 in scmd (w-load ((b2-a mm_10965 (%wadd t_10971 (%wadd #2 j_10972))))) (λ x_10970 → let mm_10973 = b2-dep mm_10965 x_10970 in let b = x_10970 in kq_ (h4-depl mm_10973 (b))))))
