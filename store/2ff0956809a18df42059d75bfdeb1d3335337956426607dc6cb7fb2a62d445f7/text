-- the check of bytes L against the tokens T, decided once when they are made
si-made-ok-t : List (List Word) → RTree (El entry-ord) → (n : Nat) → Bytes n → Bool
si-made-ok-t T t n B = andB (si-chk-chain n B #8 (si-o0 T) T) (andB (si-chk-tree n B t (si-rd4 n B #0))
  (andB (si-fuel t (toNat (si-rd4 n B #4))) (si-tokens-ok T)))
