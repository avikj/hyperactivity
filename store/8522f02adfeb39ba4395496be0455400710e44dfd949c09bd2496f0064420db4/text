b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10562 = xs in scmd (w-load ((b2-a mm_ a_10562))) (λ x_10561 → let mm_10563 = b2-dep mm_ x_10561 in let n = x_10561 in if (%weq j n) then (kq_ (h4-depl mm_10563 (h))) else (let a_10565 = xs in let j_10566 = j in scmd (w-load ((b2-a mm_10563 (%wadd a_10565 (%wsucc j_10566))))) (λ x_10564 → let mm_10567 = b2-dep mm_10563 x_10564 in let x = x_10564 in b2-tapp mm_10567 bk h x #0 (λ h2 → let mm_10568 = b2-dep mm_10567 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10568 b2-ERR)) else (b2-applyall mm_10568 f bk h2 xs (%wsucc j) kq_)))))
