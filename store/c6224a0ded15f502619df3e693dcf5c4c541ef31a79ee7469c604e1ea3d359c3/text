usf-drop-l-sound :
  (a b : UsfNode) →
  usf-emit-node (usf-drop-empty-l a b) ≡ list-append (usf-emit-node a) (usf-emit-node b)
usf-drop-l-sound usf-empty b           = refl
usf-drop-l-sound (usf-seq x y) b       = refl
usf-drop-l-sound (usf-nav p) b         = refl
usf-drop-l-sound (usf-splash t s w) b  = refl
usf-drop-l-sound usf-portal b          = refl
usf-drop-l-sound (usf-section i l p) b = refl
usf-drop-l-sound (usf-benches i l r) b = refl
usf-drop-l-sound usf-footer b          = refl
