  grh-ln "        <textarea class='code-ed' id='ed-10' spellcheck='false'>subr : Nat → Nat → Nat&#10;subr zero a = a&#10;subr (suc _) zero = zero&#10;subr (suc b) (suc a) = subr b a&#10;subr-plus-cancel : (a b : Nat) → subr b (plus a b) ≡ a&#10;subr-plus-cancel a zero = plus-zero a&#10;subr-plus-cancel a (suc b) = concat (cong (subr (suc b)) (plus-suc a b)) (subr-plus-cancel a b)&#10;corank-step : Word → Word → Bool&#10;corank-step k rho = let m = %wadd (%wmul #2 rho) #2 in let r = %wsub (%wadd k m) #1 in let t = %wmul #5 r in %weq (%wsub (%wadd k (%wmul m (%wadd t #1))) (%wadd r (%wmul m t))) #1&#10;thm-codim1-tower-pairing : rz-all-upto #25 (λ k → rz-all-upto #25 (corank-step k)) ≡ true&#10;thm-codim1-tower-pairing = refl</textarea>" (
