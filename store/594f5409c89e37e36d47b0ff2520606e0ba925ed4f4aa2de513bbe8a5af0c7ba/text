grv-intertwiner-c : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → GrvZ
grv-intertwiner-c dj1 dj2 dj3 dj4 di m1 m2 m3 m4 =
  (λ a1 →
    if not (leb a1 (plus m1 m2)) then grv-z-zero
    else
      ((λ iM →
         if not (leb iM di) then grv-z-zero
         else
           (grv-force-z GrvZ (grv-z-of-pn (grv-s3j-216 dj1 m1 dj2 m2 di (monus di iM))) (λ sL →
            if grv-z-is-zero sL then grv-z-zero
            else
              (grv-force-z GrvZ (grv-z-of-pn (grv-s3j-216 dj3 m3 dj4 m4 di iM)) (λ sR →
               if grv-z-is-zero sR then grv-z-zero
               else
                 ((λ prod → if odd (monus di iM) then grv-z-neg prod else prod)
                  (grv-z-mul (grv-z-of-nat (times (grv-fact-small (monus di iM)) (grv-fact-small iM)))
                             (grv-z-mul sL sR))))))))
       (monus (plus m1 m2) a1)))
  (nat-half (monus (plus dj1 dj2) di))
