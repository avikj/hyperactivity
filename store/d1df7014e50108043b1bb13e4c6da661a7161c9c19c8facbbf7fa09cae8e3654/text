-- Exact SU(2)-invariant intertwiner space dimension dim Inv(V_{j_1} x ... x V_{j_N}) = [z^0] - [z^2].
qg-intertwiner-dim : List (List Bool) → List Bool
qg-intertwiner-dim js = if bin-bit0 (qg-spin-sum js) then nil
  else bin-sub (qg-nth (bin-to-nat (bin-half (qg-spin-sum js))) (qg-char-prod js))
               (qg-nth (suc (bin-to-nat (bin-half (qg-spin-sum js)))) (qg-char-prod js))
