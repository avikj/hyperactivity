b2-rshow : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-rshow mm_ zero file rs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-rshow mm_ (suc f) file rs j acc kq_ =
  let a_1511 = rs in scmd (w-load ((b2-a mm_ a_1511))) (λ x_1510 → let mm_1512 = b2-dep mm_ x_1510 in let n = x_1510 in if (%weq j n) then (kq_ (h4-depl mm_1512 (acc))) else (let a_1514 = rs in let j_1515 = j in scmd (w-load ((b2-a mm_1512 (%wadd a_1514 (%wsucc j_1515))))) (λ x_1513 → let mm_1516 = b2-dep mm_1512 x_1513 in let k = x_1513 in b2-nameshow mm_1516 file k (λ s → let mm_1517 = b2-dpl mm_1516 s in b2-rshow mm_1517 f file rs (%wsucc j) (list-append acc (list-append " - " (list-append s "{}"))) kq_))))
