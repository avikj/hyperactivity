sf2-eprl-two-diag : Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf2-eprl-two-diag J Jp Jm i1 i2 i3 i4 =
  bq-mul (sf-bq-of-nat (times (times (suc i1) (suc i2)) (times (suc i3) (suc i4))))
         (sf2-eprl-two-R J Jp Jm i1 i2 i3 i4 i1 i2 i3 i4)
