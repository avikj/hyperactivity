-- RHS 3-3 BF sum over jB in 0..6 and dual interior tetrahedra t0=(0,3,4,5), t1=(1,3,4,5), t2=(2,3,4,5):
r4d-rhs-tetK : (Nat → Nat → Nat → Nat → Nat) → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat
r4d-rhs-tetK bndK k0 k1 k2 w0 w1 w2 w3 =
  if both (eqb w1 3) (both (eqb w2 4) (eqb w3 5))
  then (if eqb w0 0 then k0 else (if eqb w0 1 then k1 else k2))
  else bndK w0 w1 w2 w3
