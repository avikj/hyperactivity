-- THEOREM 1B (Universal Probabilistic LHV Bell-CHSH Bound):
-- For ANY finite local-hidden-variable distribution ws, BOTH P <= 2*W and N <= 2*W, so |P - N| <= 2*W (|S_LHV| <= 2)!
qe-lhv-pos-le : (ws : List QeLHV) → le (qe-lhv-P ws) (plus (qe-lhv-W ws) (qe-lhv-W ws))
qe-lhv-pos-le ws = (qe-lhv-N ws , concat (plus-comm (qe-lhv-N ws) (qe-lhv-P ws)) (qe-lhv-sum-eq ws))
