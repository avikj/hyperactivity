usf-emit-pillars : List UsfPillar → List Word
usf-emit-pillars nil = nil
usf-emit-pillars (cons (usf-pillar ttl bdy eqn) rest) =
  usf-ln "    <div class='item'>" (
  usf-ln (list-append "      <h3>" (list-append ttl "</h3>")) (
  usf-ln (list-append "      <p>" (list-append bdy "</p>")) (
  usf-ln (list-append "      <code class='eq'>" (list-append eqn "</code>")) (
  usf-ln "    </div>" (usf-emit-pillars rest)))))
