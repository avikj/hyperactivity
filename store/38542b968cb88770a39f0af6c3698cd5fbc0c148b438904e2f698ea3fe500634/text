e-row-lines : ERow → Proc W (List (List Word))
e-row-lines r = bind (e-parts r) (λ p → ret (list-append (cons (list-append "    " (list-append (if h-null (e-rp r) then nil else list-append "(" (list-append (e-lc (e-rp r)) ") ")) (e-rd r))) nil)
  (list-append (list-map (λ para → list-append "    [" (list-append (e-take-chars (toNat #1200) para) "]")) (h-split #10 (e-re r)))
  (if h-null p then nil else cons (list-append "     " p) nil))))
