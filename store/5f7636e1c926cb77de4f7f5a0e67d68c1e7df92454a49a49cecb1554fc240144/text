b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_10186 = cs in let j_10187 = j in scmd (w-load ((b2-a mm_ (%wadd v_10186 #2)))) (λ d_10185 → let mm_10188 = b2-dep mm_ d_10185 in scmd (w-load ((b2-a mm_10188 (%wadd d_10185 (%wsucc j_10187))))) (λ x_10184 → let mm_10189 = b2-dep mm_10188 x_10184 in let c = x_10184 in let t_10191 = c in let j_10192 = #0 in scmd (w-load ((b2-a mm_10189 (%wadd t_10191 (%wadd #2 j_10192))))) (λ x_10190 → let mm_10193 = b2-dep mm_10189 x_10190 in let ck = x_10190 in if (%weq ck k) then (kq_ (h4-depl mm_10193 (c))) else (b2-ctrfind mm_10193 f cs k (%wsucc j) n kq_)))))
