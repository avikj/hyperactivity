b2-fresh : Word → Word → (Word → Step W Word) → Step W Word
b2-fresh mm_ p kq_ =
  let i_5401 = (%wadd p #6) in scmd (w-load ((b2-a mm_ i_5401))) (λ x_5400 → let mm_5402 = b2-dep mm_ x_5400 in let n = x_5400 in let i_5403 = (%wadd p #6) in let v_5404 = (%wsucc n) in scmd (w-store ((b2-a mm_5402 i_5403)) (v_5404)) (λ uu_5405 → let mm_5406 = hv2-u mm_5402 uu_5405 in kq_ (h4-depl mm_5406 (n))))
