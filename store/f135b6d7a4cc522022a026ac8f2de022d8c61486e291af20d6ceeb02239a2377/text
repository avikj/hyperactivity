b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_7356 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_7356 (k))) else (b2-nbytes mm_7356 ns (λ nb → let mm_7357 = b2-dpl mm_7356 nb in b2-nbytes mm_7357 k (λ kb → let mm_7358 = b2-dpl mm_7357 kb in b2-nm mm_7358 (list-append nb (cons #58 kb)) (λ r → let mm_7359 = b2-dep mm_7358 r in kq_ (h4-depl mm_7359 (r)))))))
