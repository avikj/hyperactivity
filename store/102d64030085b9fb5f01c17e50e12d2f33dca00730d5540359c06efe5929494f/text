-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13828 = seen in let j_13829 = j in scmd (w-load ((b2-a mm_ (%wadd v_13828 #2)))) (λ d_13826 → let mm_13830 = b2-dep mm_ d_13826 in scmd (w-load ((b2-a mm_13830 (%wadd d_13826 (%wsucc j_13829))))) (λ x_13827 → let mm_13831 = b2-dep mm_13830 x_13827 in let e = x_13827 in let i_13833 = e in scmd (w-load ((b2-a mm_13831 i_13833))) (λ x_13832 → let mm_13834 = b2-dep mm_13831 x_13832 in let x = x_13832 in if (%weq x p) then (kq_ (h4-depl mm_13834 (e))) else (b2-seenat mm_13834 f seen p (%wsucc j) n kq_)))))
