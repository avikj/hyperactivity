-- a Nat term's number through up to 64 Succ: a literal or Zero at the end, its cells followed
b2-natnum : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-natnum mm_ zero t acc kq_ =
  kq_ (h4-depl mm_ (b2-NNONE))
b2-natnum mm_ (suc f) t acc kq_ =
  b2-strip mm_ t (λ w → let mm_2673 = b2-dep mm_ w in let t_2675 = w in scmd (w-load ((b2-a mm_2673 t_2675))) (λ x_2674 → let mm_2676 = b2-dep mm_2673 x_2674 in let tg = (%wand x_2674 #255) in let t_2678 = w in let j_2679 = #0 in scmd (w-load ((b2-a mm_2676 (%wadd t_2678 (%wadd #2 j_2679))))) (λ x_2677 → let mm_2680 = b2-dep mm_2676 x_2677 in let lk = x_2677 in let t_2682 = w in let j_2683 = #1 in scmd (w-load ((b2-a mm_2680 (%wadd t_2682 (%wadd #2 j_2683))))) (λ x_2681 → let mm_2684 = b2-dep mm_2680 x_2681 in let v = x_2681 in if (andB (%weq tg b2-LIT) (%weq lk b2-LNAT)) then (kq_ (h4-depl mm_2684 ((%wadd acc v)))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NZero)) then (kq_ (h4-depl mm_2684 (acc))) else (if (andB (%weq tg b2-CTR) (%weq lk b2-NSucc)) then (let a_2686 = v in let j_2687 = #0 in scmd (w-load ((b2-a mm_2684 (%wadd a_2686 (%wsucc j_2687))))) (λ x_2685 → let mm_2688 = b2-dep mm_2684 x_2685 in let x = x_2685 in b2-natnum mm_2688 f x (%wsucc acc) kq_)) else (kq_ (h4-depl mm_2684 (b2-NNONE)))))))))
