-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10217 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10217))) (λ x_10216 → let mm_10218 = b2-dep mm_ x_10216 in let lb = x_10216 in if (%weq lb #0) then (let i_10220 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10218 i_10220))) (λ x_10219 → let mm_10221 = b2-dep mm_10218 x_10219 in let t = x_10219 in kq_ (h4-depl mm_10221 (t)))) else (let i_10223 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10218 i_10223))) (λ x_10222 → let mm_10224 = b2-dep mm_10218 x_10222 in let lx = x_10222 in b2-body mm_10224 bk lb lx (λ r → let mm_10225 = b2-dep mm_10224 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10225 b2-ERR)) else (kq_ (h4-depl mm_10225 (r)))))))
