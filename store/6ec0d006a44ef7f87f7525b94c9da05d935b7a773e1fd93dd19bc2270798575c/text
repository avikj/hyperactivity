b2-varidx : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-varidx mm_ zero vs i j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-varidx mm_ (suc f) vs i j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_5851 = vs in let j_5852 = j in scmd (w-load ((b2-a mm_ (%wadd a_5851 (%wsucc j_5852))))) (λ x_5850 → let mm_5853 = b2-dep mm_ x_5850 in let w = x_5850 in let t_5855 = w in let j_5856 = #1 in scmd (w-load ((b2-a mm_5853 (%wadd t_5855 (%wadd #2 j_5856))))) (λ x_5854 → let mm_5857 = b2-dep mm_5853 x_5854 in let wi = x_5854 in if (%weq wi i) then (kq_ (h4-depl mm_5857 (j))) else (b2-varidx mm_5857 f vs i (%wsucc j) n kq_))))
