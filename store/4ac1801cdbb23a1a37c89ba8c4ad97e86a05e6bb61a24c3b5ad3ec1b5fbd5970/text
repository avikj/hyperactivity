-- Expected exact 3x3 Barrett-Crane bulk channel matrix:
--   WG_BC = [[42217, 0, 4394], [0, 31232, 0], [21970, 0, 40020]] / (2^22 * 9)
--   Factorizations: 42217 = 7*37*163; 4394 = 2*13^3; 31232 = 2^9 * 61; 21970 = 10*13^3; 40020 = 60*23*29.
--   Scaled by (2^10 * 36^5)^2 = 2^40 * 3^20, this equals (2^18 * 3^18) * sfc-W-bc-u!
sfc-scale-bc : List Bool
sfc-scale-bc = sfc-bmul (bin-pow2 18) (sf2-bin-pow sfc-b3 18)
