qmol-one-hop : Nat → Nat → List BZ → Nat → Nat → List BZ → BZ
qmol-one-hop u1 u2 fa w1 w2 fb =
  bz-add (bz-add (qmol-one-hop-edge 0 0 1 u1 u2 fa w1 w2 fb) (qmol-one-hop-edge 1 1 2 u1 u2 fa w1 w2 fb))
         (bz-add (qmol-one-hop-edge 2 2 3 u1 u2 fa w1 w2 fb) (qmol-one-hop-edge 3 3 0 u1 u2 fa w1 w2 fb))
