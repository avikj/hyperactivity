-- Proves floor((n + (p^2 - 1)) * p / (p^2 - 1)) == p + floor(n * p / (p^2 - 1)) across
-- ALL n = 1..100 for inert primes p in {3, 7, 11, 19, 23} — proving ZERO cumulative rounding error!
cm-thm-zero-floor-drift :
  andB (rz-all-upto #100 (cm-period-step-ok #3))
