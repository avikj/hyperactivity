-- Pretty-printer for discovered expression trees straight from flat RAM E[idx]!
hd-fmt-meta : Nat → Word → Word → (List Word → Step W Word) → Step W Word
hd-fmt-meta zero _ _ k = k "?"
hd-fmt-meta (suc d) mem meta k =
  let op = %wand meta #255
      l  = %wand (%wshr meta #8) #4095
      r  = %wand (%wshr meta #20) #4095
  in if %weq op #0 then k "0"
     else if %weq op #1 then k "1"
     else if %weq op #2 then k "x"
     else if %weq op #3 then k "y"
     else if %wlt op #7 then
       scmd (w-load (%wadd (hd-e-at mem l) #16)) (λ lm →
       hd-fmt-meta d mem lm (λ sl →
       k (list-append (hd-uop-pfx op) (list-append sl (hd-uop-sfx op)))))
     else
       scmd (w-load (%wadd (hd-e-at mem l) #16)) (λ lm →
       scmd (w-load (%wadd (hd-e-at mem r) #16)) (λ rm →
       hd-fmt-meta d mem lm (λ sl →
       hd-fmt-meta d mem rm (λ sr →
       k (list-append "(" (list-append sl (list-append (hd-bop-sym op) (list-append sr ")"))))))))
