tir-le-trans : (a b c : Nat) → tir-le-nat a b ≡ true → tir-le-nat b c ≡ true → tir-le-nat a c ≡ true
tir-le-trans zero    b       c       hab hbc = refl
tir-le-trans (suc a) zero    c       hab hbc = tir-false-imp (tir-le-nat (suc a) c) hab
tir-le-trans (suc a) (suc b) zero    hab hbc = hbc
tir-le-trans (suc a) (suc b) (suc c) hab hbc = tir-le-trans a b c hab hbc
