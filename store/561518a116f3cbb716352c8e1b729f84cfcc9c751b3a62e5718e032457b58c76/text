gn-prime-sample16 : Word → Word
gn-prime-sample16 t =
  let a0 = #32768
      a1 = gn-prime-voice t #2  #3 a0
      a2 = gn-prime-voice t #3  #2 a1
      a3 = gn-prime-voice t #5  #2 a2
      a4 = gn-prime-voice t #7  #1 a3
      a5 = gn-prime-voice t #11 #1 a4
      a6 = gn-prime-voice t #13 #1 a5
  in if web-notB (%wlt a6 #32768) then %wsub a6 #32768
     else %wsub #65536 (%wsub #32768 a6)
