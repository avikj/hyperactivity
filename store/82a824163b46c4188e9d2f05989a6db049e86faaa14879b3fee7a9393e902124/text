b2-lshow : Word → Word → Word → Word → (List Word → Step W Word) → Step W Word
b2-lshow mm_ x bnd fl kq_ =
  let v_10099 = bnd in scmd (w-load ((b2-a mm_ v_10099))) (λ x_10098 → let mm_10100 = b2-dep mm_ x_10098 in let n = x_10098 in b2-lower mm_10100 x n (λ l → let mm_10101 = b2-dep mm_10100 l in if (%weq l b2-ERR) then (kq_ (h4-depl mm_10101 (nil))) else (b2-show mm_10101 l #0 bnd fl (λ s → let mm_10102 = b2-dpl mm_10101 s in kq_ (h4-depl mm_10102 (s))))))
