h3d-k4-pairs : (Nat → BZ) → List (Nat × Nat) → List QmolState
h3d-k4-pairs qnuc ps = case ps of
  nil → nil
  cons pr rest →
    qmol-append-st
      (h3d-e3 (fst pr) (snd pr)
        (h3d-q-at qnuc 1 (fst pr) (snd pr))
        (h3d-q-at qnuc 2 (fst pr) (snd pr))
        (h3d-q-at qnuc 3 (fst pr) (snd pr))
        h3d-range1)
      (h3d-k4-pairs qnuc rest)
