-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10126 = tld in scmd (w-load ((b2-a mm_ t_10126))) (λ x_10125 → let mm_10127 = b2-dep mm_ x_10125 in let tg = (%wand x_10125 #255) in if (%weq tg b2-TADT) then (let t_10129 = tld in let j_10130 = #4 in scmd (w-load ((b2-a mm_10127 (%wadd t_10129 (%wadd #2 j_10130))))) (λ x_10128 → let mm_10131 = b2-dep mm_10127 x_10128 in let b = x_10128 in kq_ (h4-depl mm_10131 (b)))) else (let t_10133 = tld in let j_10134 = #5 in scmd (w-load ((b2-a mm_10127 (%wadd t_10133 (%wadd #2 j_10134))))) (λ x_10132 → let mm_10135 = b2-dep mm_10127 x_10132 in let b = x_10132 in kq_ (h4-depl mm_10135 (b))))))
