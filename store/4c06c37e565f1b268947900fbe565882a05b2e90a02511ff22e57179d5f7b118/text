-- fold-safe: the foldable modules whose path no other module's text holds and the Makefile does not
-- hold. A command reaches a module by writing its path, so a path written nowhere is reached by nothing.
-- Each module's text is read once and searched for every candidate.
hy-nm-hits : List Word → List Word → List (List Word) → List (List Word)
hy-nm-hits q t nil = nil
hy-nm-hits q t (cons p r) =
  if h-eq p q then hy-nm-hits q t r
  else if h-infix p t then cons p (hy-nm-hits q t r) else hy-nm-hits q t r





