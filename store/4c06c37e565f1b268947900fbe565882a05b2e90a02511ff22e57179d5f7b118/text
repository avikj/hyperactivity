-- The session (2026-11-15, Avik: "the interactive loop of understanding/contributing"; "the cli may
-- simply deliver exactly the onboarding contents in a sequence of turns"): one loop whose state is a
-- value, the actions taken so far (session/log in the store, one per line) folded from the first
-- state. Each call of `hyperactive ACTION` takes one action, if it is valid where the session is,
-- and shows the state it reaches with the actions valid there; `hyperactive` alone shows where the
-- session is. A session begins with the walk of the onboarding, where next and prev are the only
-- actions; then the work: the graph's views, reading code by name, and the rest; `done` declares
-- the work done and ends the session. A session not ended by `done` stays where it was.
-- Decomposing a document by pulls (Avik, 2026-11-16, “Avik's words, verbatim”; 10:06–11:06 UTC; lib/selection.cub):
-- `decompose FILE` shows the document (a file, or the source of a decomposed one); `pull FROM TO
-- [FROM TO …]` names the lines of one piece; the piece is shown with its surroundings and asserted
-- `self-contained` or given `re-expressed` (on standard input); `finish` writes each piece as a
-- definition, the selection of the source's lines or its re-expression. Pulls are independent: none
-- claims the lines it takes, and any may overlap another.
data HyState = hy-walking (k : Nat) | hy-working | hy-reading (file : List Word)
             | hy-decomposing (file : List Word) (lines : List Word)





hy-pred : Nat → Nat
hy-pred zero = suc zero
hy-pred (suc zero) = suc zero
hy-pred (suc (suc k)) = suc k



hy-work-words : List (List Word)
hy-work-words = cons "show" (cons "tree" (cons "order" (cons "open" (cons "def" (cons "write" (cons "remove" (cons "history" (cons "paper" (cons "check" (cons "done" (cons "root" (cons "take" (cons "send" (cons "apply" nil))))))))))))))



hy-rest : List (List Word) → List (List Word)
hy-rest nil = nil
hy-rest (cons w r) = r



hy-second : List (List Word) → List Word
hy-second a = hy-head (hy-rest a)



-- a range of lines: from the first line on, not ending before it begins
-- the lines of a pull: ranges FROM TO, in order, each beginning after the last ended (a subsequence of
-- the document's lines)
hy-ranges-ok-after : Word → List Word → Bool
hy-ranges-ok-after prev nil = true
hy-ranges-ok-after prev (cons x nil) = false
hy-ranges-ok-after prev (cons x (cons y r)) = if wlt prev x then (if wlt y x then false else hy-ranges-ok-after y r) else false



hy-ranges-ok : List Word → Bool
hy-ranges-ok nil = false
hy-ranges-ok ws = hy-ranges-ok-after #0 ws





-- an action applied: the state it reaches, or none when it is not valid there. The walk is open, never a
-- gate (Avik, 2026-11-17 09:18 UTC: "I'm sick of hearing of onboarding preventing shit just remove
-- onboarding or something then for now"): a working command during the walk leaves it for work.
hy-step : Nat → HyState → List (List Word) → Sum Unit HyState
hy-step count (hy-walking k) a =
  if h-eq (hy-head a) "next" then inr (if hy-same-nat k count then hy-working else hy-walking (suc k)) else
  if h-eq (hy-head a) "prev" then inr (hy-walking (hy-pred k)) else
  if orB (h-has (hy-head a) hy-work-words) (h-has (hy-head a) hy-bridge-words) then inr hy-working else inl unit
hy-step count hy-working a =
  if h-eq (hy-head a) "decompose" then (if h-null (hy-second a) then inl unit else inr (hy-reading (hy-second a))) else
  if orB (h-has (hy-head a) hy-work-words) (h-has (hy-head a) hy-bridge-words) then inr hy-working else inl unit
hy-step count (hy-reading f) a =
  if h-eq (hy-head a) "pull"
  then (if hy-ranges-ok (list-map h-number (hy-rest a)) then inr (hy-decomposing f (list-map h-number (hy-rest a))) else inl unit) else
  if h-eq (hy-head a) "finish" then inr hy-working else
  if h-eq (hy-head a) "part" then inr (hy-reading f) else inl unit
hy-step count (hy-decomposing f xy) a =
  if h-has (hy-head a) (cons "self-contained" (cons "re-expressed" nil)) then inr (hy-reading f) else
  if h-eq (hy-head a) "part" then inr (hy-decomposing f xy) else inl unit



hy-or-state : HyState → Sum Unit HyState → HyState
hy-or-state s (inl u) = s
hy-or-state s (inr t) = t



-- the state the log reaches
hy-fold : Nat → HyState → List (List Word) → HyState
hy-fold count s nil = s
hy-fold count s (cons l r) = hy-fold count (hy-or-state s (hy-step count s (h-split #32 l))) r





