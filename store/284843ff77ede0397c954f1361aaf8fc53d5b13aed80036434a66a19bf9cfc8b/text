h4-dlook : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-dlook m zero loc lab i k =
  h4-rterr m "print_state: too many dups" k
h4-dlook m (suc f) loc lab i k =
  scmd (w-load ((h4-PDL m))) (λ n → let m2780 = h4-dep m n in if (%weq i n) then (scmd (w-load ((h4-PND m2780))) (λ nm → let m2781 = h4-dep m2780 nm in scmd (w-store ((h4-PND m2781)) ((%wsucc nm))) (λ u2782 → let m2783 = hv2-u m2781 u2782 in scmd (w-store ((h4-pdup m2783 i)) (loc)) (λ u2784 → let m2785 = hv2-u m2783 u2784 in scmd (w-store ((%wadd (h4-pdup m2785 i) #8)) (nm)) (λ u2786 → let m2787 = hv2-u m2785 u2786 in scmd (w-store ((%wadd (h4-pdup m2787 i) #16)) (lab)) (λ u2788 → let m2789 = hv2-u m2787 u2788 in scmd (w-store ((h4-PDL m2789)) ((%wsucc n))) (λ u2790 → let m2791 = hv2-u m2789 u2790 in k (h4-depl m2791 (nm))))))))) else (scmd (w-load ((h4-pdup m2780 i))) (λ l → let m2792 = h4-dep m2780 l in if (%weq l loc) then (scmd (w-load ((%wadd (h4-pdup m2792 i) #8))) (λ nm → let m2793 = h4-dep m2792 nm in k (h4-depl m2793 (nm)))) else (h4-dlook m2792 f loc lab (%wsucc i) k))))
