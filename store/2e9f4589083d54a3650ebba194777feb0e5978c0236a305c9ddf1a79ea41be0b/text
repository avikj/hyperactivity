b2-fail : Word → Word → Word → List Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-fail mm_ bok ctx exp obs spn def kq_ =
  b2-msg mm_ exp (λ e → let mm_596 = b2-dep mm_ e in b2-raise mm_596 bok ctx e obs spn def #0 (λ r → let mm_597 = b2-dep mm_596 r in kq_ (h4-depl mm_597 (r))))
