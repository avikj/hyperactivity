vx-fir2-step-lemma : (f1 f2 : Word → Word) → (s1 s2 : Word × Word) → (x : Word) →
  vx-fir2-rel f1 f2 s1 s2 →
  (fst (vx-fir2-spec-step f1 f2 s1 x) ≡ fst (vx-fir2-impl-step f1 f2 s2 x)) ×
  vx-fir2-rel f1 f2 (snd (vx-fir2-spec-step f1 f2 s1 x)) (snd (vx-fir2-impl-step f1 f2 s2 x))
vx-fir2-step-lemma f1 f2 s1 s2 x hr =
  (vx-cong (λ v → %wadd x v) (vx-sym (fst hr)) ,
   (vx-cong (λ v → %wadd (f1 x) v) (snd hr) , refl))
