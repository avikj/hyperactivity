-- 2^d interactions, or fewer if no redex is left
hr-loop-d : Nat → Nat → List Hv2Def → Word → (Word → Step W Word) → (Word → Step W Word) → Step W Word
hr-loop-d fu zero book m kd km = hr-loop1 fu book m kd km
hr-loop-d fu (suc d) book m kd km = hr-loop-d fu d book m kd (λ m1 → hr-loop-d fu d book m1 kd km)
