b2-cwait : Word → Word → (Word → Step W Word) → Step W Word
b2-cwait mm_ item kq_ =
  if (%weq item hv2-none) then (b2-unitv mm_  (λ u → let mm_15898 = b2-dep mm_ u in b2-c1 mm_15898 "Wait" u (λ r → let mm_15899 = b2-dep mm_15898 r in kq_ (h4-depl mm_15899 (r))))) else (b2-c1 mm_ "Wait" item (λ r → let mm_15900 = b2-dep mm_ r in kq_ (h4-depl mm_15900 (r))))
