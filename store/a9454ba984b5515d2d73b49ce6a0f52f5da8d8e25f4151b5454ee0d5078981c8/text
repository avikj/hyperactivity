-- Exact Nat-valued spectral/geometric trace balance:
-- Every non-negative exterior-zero test mass `ext` satisfying:
--   (1) Weil Explicit Formula: plus spec ext == geom
--   (2) Strip-Geometric Trace Match: spec == geom
-- MUST vanish identically: ext == 0!
ms-thm-trace-subtraction : (spec ext geom : Nat) →
  plus spec ext ≡ geom →
  spec ≡ geom →
  ext ≡ zero
ms-thm-trace-subtraction spec ext geom h-weil h-strip =
  ms-plus-cancel-l spec ext (sk-trans h-weil (λ i → h-strip (~ i)))
