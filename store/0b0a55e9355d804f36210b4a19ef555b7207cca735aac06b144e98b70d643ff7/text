sc-neg-sq : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → ScRing A z add mul neg →
  (v : A) → mul (neg v) (neg v) ≡ mul v v
sc-neg-sq A z add mul neg r v =
  concat (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd r))))))))) v (neg v))
    (concat (cong neg (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd (snd r)))))))))) v v))
            (snd (snd (snd (snd (snd (snd (snd (snd (snd (snd (snd r)))))))))) (mul v v)))
