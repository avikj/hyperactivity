b2-inarr : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-inarr mm_ zero b x j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-inarr mm_ (suc f) b x j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_2484 = b in let j_2485 = j in scmd (w-load ((b2-a mm_ (%wadd a_2484 (%wsucc j_2485))))) (λ x_2483 → let mm_2486 = b2-dep mm_ x_2483 in let y = x_2483 in if (%weq x y) then (kq_ (h4-depl mm_2486 (#1))) else (b2-inarr mm_2486 f b x (%wsucc j) n kq_)))
