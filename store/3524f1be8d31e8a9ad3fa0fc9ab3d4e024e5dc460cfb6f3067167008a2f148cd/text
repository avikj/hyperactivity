b2-markbase mm_ zero bk j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-markbase mm_ (suc f) bk j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_14069 = bk in let j_14070 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_14069 (%wadd #2 j_14070))))) (λ x_14068 → let mm_14071 = b2-dep mm_ x_14068 in let ov = x_14068 in let v_14074 = ov in let j_14075 = j in scmd (w-load ((b2-a mm_14071 (%wadd v_14074 #2)))) (λ d_14073 → let mm_14076 = b2-dep mm_14071 d_14073 in scmd (w-load ((b2-a mm_14076 (%wadd d_14073 (%wsucc j_14075))))) (λ x_14072 → let mm_14077 = b2-dep mm_14076 x_14072 in let k = x_14072 in b2-tld mm_14077 bk k (λ t → let mm_14078 = b2-dep mm_14077 t in let t_14080 = t in scmd (w-load ((b2-a mm_14078 t_14080))) (λ x_14079 → let mm_14081 = b2-dep mm_14078 x_14079 in let tg = (%wand x_14079 #255) in let t_14082 = t in let j_14083 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_14084 = #1 in scmd (w-store ((b2-a mm_14081 (%wadd t_14082 (%wadd #2 j_14083)))) (v_14084)) (λ uu_14085 → let mm_14086 = hv2-u mm_14081 uu_14085 in b2-markbase mm_14086 f bk (%wsucc j) n kq_)))))))
