grv-orbit-int : Nat → Nat → R4dFrac
grv-orbit-int nMid nExt =
  (λ raw → (fst raw , bst-bmul (bin-of-nat (grv-pow-nat 3 nExt)) (snd raw)))
  (grv-haar-sum 3
    (grv-poly-mul-lin nExt (bin-of-nat 3) bin-one
      (grv-poly-mul-lin (suc nMid) bin-one bin-one (cons (bin-one , nil) nil)))
    r4d-fr-zero)
