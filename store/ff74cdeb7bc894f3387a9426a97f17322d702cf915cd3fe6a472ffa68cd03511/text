b2-slen : Word → Word → (Word → Step W Word) → Step W Word
b2-slen mm_ v kq_ =
  let i_204 = v in scmd (w-load ((b2-a mm_ i_204))) (λ x_203 → let mm_205 = b2-dep mm_ x_203 in let h = x_203 in if (orB (%weq h b2-ROPE) (%weq h b2-FWD)) then (let i_207 = (%wadd v #3) in scmd (w-load ((b2-a mm_205 i_207))) (λ x_206 → let mm_208 = b2-dep mm_205 x_206 in let n = x_206 in kq_ (h4-depl mm_208 (n)))) else (kq_ (h4-depl mm_205 (h))))
