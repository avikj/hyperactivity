b2-thead : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-thead mm_ bk tel ctx def s kq_ =
  b2-wnf mm_ bk tel (λ t → let mm_10807 = b2-dep mm_ t in if (%weq t b2-ERR) then (kq_ (h4-depl mm_10807 b2-ERR)) else (let t_10809 = t in scmd (w-load ((b2-a mm_10807 t_10809))) (λ x_10808 → let mm_10810 = b2-dep mm_10807 x_10808 in let tg = (%wand x_10808 #255) in if (%weq tg b2-ALL) then (kq_ (h4-depl mm_10810 (t))) else (b2-fail mm_10810 bk ctx "unreachable (a telescope binds its parameters and fields)" #0 s def (λ r → let mm_10811 = b2-dep mm_10810 r in kq_ (h4-depl mm_10811 (r)))))))
