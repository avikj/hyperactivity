-- Fast vertex-short-circuiting 6-edge 2-electron hop & 4-face plaquette on 3D K_4:
h3d-is-k4-plaq : List BZ → List BZ → Bool
h3d-is-k4-plaq fa fb =
  if tc-pm-face fa fb tc-face0 then true
  else (if tc-pm-face fa fb tc-face1 then true
        else (if tc-pm-face fa fb tc-face2 then true
              else tc-pm-face fa fb tc-face3))
