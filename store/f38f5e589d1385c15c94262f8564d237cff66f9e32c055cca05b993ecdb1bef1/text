b2-peek : Word → Word → (Word → Step W Word) → Step W Word
b2-peek mm_ p kq_ =
  b2-pstr mm_ p (λ s → let mm_6251 = b2-dep mm_ s in let p_6253 = p in let i_6255 = (%wadd p_6253 #1) in scmd (w-load ((b2-a mm_6251 i_6255))) (λ x_6254 → let mm_6256 = b2-dep mm_6251 x_6254 in let x_6252 = x_6254 in let i = x_6252 in b2-uat mm_6256 s i (λ c → let mm_6257 = b2-dep mm_6256 c in kq_ (h4-depl mm_6257 (c)))))
