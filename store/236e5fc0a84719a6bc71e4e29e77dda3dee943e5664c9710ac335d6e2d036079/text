b2-arrsug : Word → Nat → Word → Word → (Word → Step W Word) → Step W Word
b2-arrsug mm_ zero t v kq_ =
  kq_ (h4-depl mm_ (#0))
b2-arrsug mm_ (suc f) t v kq_ =
  let t_1269 = t in scmd (w-load ((b2-a mm_ t_1269))) (λ x_1268 → let mm_1270 = b2-dep mm_ x_1268 in let tg = (%wand x_1268 #255) in if (not (%weq tg b2-CTR)) then (kq_ (h4-depl mm_1270 (#0))) else (let t_1272 = t in let j_1273 = #0 in scmd (w-load ((b2-a mm_1270 (%wadd t_1272 (%wadd #2 j_1273))))) (λ x_1271 → let mm_1274 = b2-dep mm_1270 x_1271 in let k = x_1271 in let t_1276 = t in let j_1277 = #1 in scmd (w-load ((b2-a mm_1274 (%wadd t_1276 (%wadd #2 j_1277))))) (λ x_1275 → let mm_1278 = b2-dep mm_1274 x_1275 in let xs = x_1275 in let a_1280 = xs in scmd (w-load ((b2-a mm_1278 a_1280))) (λ x_1279 → let mm_1281 = b2-dep mm_1278 x_1279 in let l = x_1279 in if (andB (%weq k b2-NALeaf) (%weq l #1)) then (let a_1283 = xs in let j_1284 = #0 in scmd (w-load ((b2-a mm_1281 (%wadd a_1283 (%wsucc j_1284))))) (λ x_1282 → let mm_1285 = b2-dep mm_1281 x_1282 in let x = x_1282 in b2-vpush mm_1285 v x (λ dd_1286 → let mm_1287 = b2-dep mm_1285 dd_1286 in kq_ (h4-depl mm_1287 (#1))))) else (if (not (andB (%weq k b2-NANode) (%weq l #2))) then (kq_ (h4-depl mm_1281 (#0))) else (let a_1289 = xs in let j_1290 = #0 in scmd (w-load ((b2-a mm_1281 (%wadd a_1289 (%wsucc j_1290))))) (λ x_1288 → let mm_1291 = b2-dep mm_1281 x_1288 in let a = x_1288 in let a_1293 = xs in let j_1294 = #1 in scmd (w-load ((b2-a mm_1291 (%wadd a_1293 (%wsucc j_1294))))) (λ x_1292 → let mm_1295 = b2-dep mm_1291 x_1292 in let b = x_1292 in b2-arrsug mm_1295 f a v (λ ok → let mm_1296 = b2-dep mm_1295 ok in if (%weq ok #0) then (kq_ (h4-depl mm_1296 (#0))) else (b2-arrsug mm_1296 f b v (λ r → let mm_1297 = b2-dep mm_1296 r in kq_ (h4-depl mm_1297 (r))))))))))))))
