b2-word : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-word mm_ p w kq_ =
  b2-atword mm_ p w (λ a → let mm_7300 = b2-dep mm_ a in if (%weq a #0) then (kq_ (h4-depl mm_7300 (#0))) else (b2-take mm_7300 p w (λ dd_7301 → let mm_7302 = b2-dep mm_7300 dd_7301 in kq_ (h4-depl mm_7302 (#1)))))
