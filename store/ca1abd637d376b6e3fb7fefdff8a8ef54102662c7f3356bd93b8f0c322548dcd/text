  kq_ (h4-depl mm_ (#0))
b2-floodadd mm_ (suc f) bad inb u j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_15000 = u in let j_15001 = j in scmd (w-load ((b2-a mm_ (%wadd v_15000 #2)))) (λ d_14999 → let mm_15002 = b2-dep mm_ d_14999 in scmd (w-load ((b2-a mm_15002 (%wadd d_14999 (%wsucc j_15001))))) (λ x_14998 → let mm_15003 = b2-dep mm_15002 x_14998 in let x = x_14998 in b2-inmap mm_15003 inb x (λ hit → let mm_15004 = b2-dep mm_15003 hit in if (%weq hit #0) then (b2-mset mm_15004 inb x #1 (λ dd_15005 → let mm_15006 = b2-dep mm_15004 dd_15005 in b2-vpush mm_15006 bad x (λ dd_15007 → let mm_15008 = b2-dep mm_15006 dd_15007 in b2-floodadd mm_15008 f bad inb u (%wsucc j) n kq_))) else (b2-floodadd mm_15004 f bad inb u (%wsucc j) n kq_)))))
