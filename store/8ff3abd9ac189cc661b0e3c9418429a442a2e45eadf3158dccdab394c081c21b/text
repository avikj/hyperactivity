-- THEOREM 1: UNIVERSAL SHANNON COFACTOR DECOMPOSITION (web-chB s t1 t0 === if s then t1 else t0)
-- Proves ANY n-input function decomposes with 0 error onto the exact (n-1)-input / 4-input Atlas!
eg-thm-shannon-exact : (s t1 t0 : Bool) → web-chB s t1 t0 ≡ (if s then t1 else t0)
eg-thm-shannon-exact true  true  true  = refl
eg-thm-shannon-exact true  true  false = refl
eg-thm-shannon-exact true  false true  = refl
eg-thm-shannon-exact true  false false = refl
eg-thm-shannon-exact false true  true  = refl
eg-thm-shannon-exact false true  false = refl
eg-thm-shannon-exact false false true  = refl
eg-thm-shannon-exact false false false = refl
