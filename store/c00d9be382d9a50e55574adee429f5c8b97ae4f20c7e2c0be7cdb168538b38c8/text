-- COMM: two nodes of different kinds pass through each other: four nodes and four variables
hv2-comm : Hv2Net → Word → Word → Hv2Net
hv2-comm net a b =
  let wa = hv2-node-get net (hv2-val a)
      wb = hv2-node-get net (hv2-val b)
      n0 = hv2-nn net
      v0 = hv2-nv net
      x0 = hv2-port hv2-VAR v0
      x1 = hv2-port hv2-VAR (%wadd v0 #1)
      x2 = hv2-port hv2-VAR (%wadd v0 #2)
      x3 = hv2-port hv2-VAR (%wadd v0 #3)
      net1 = hv2-alloc (hv2-node-del (hv2-node-del net (hv2-val a)) (hv2-val b)) #4 #4
      net2 = hv2-node-set (hv2-node-set (hv2-node-set (hv2-node-set net1 n0 (hv2-pair x0 x1)) (%wadd n0 #1) (hv2-pair x2 x3)) (%wadd n0 #2) (hv2-pair x0 x2)) (%wadd n0 #3) (hv2-pair x1 x3)
      net3 = hv2-ln (hv2-ln net2 (hv2-port (hv2-tag b) n0) (hv2-fst wa)) (hv2-port (hv2-tag b) (%wadd n0 #1)) (hv2-snd wa)
  in hv2-ln (hv2-ln net3 (hv2-port (hv2-tag a) (%wadd n0 #2)) (hv2-fst wb)) (hv2-port (hv2-tag a) (%wadd n0 #3)) (hv2-snd wb)
