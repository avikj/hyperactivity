  kq_ (h4-depl mm_ (q))
b2-pmarkg mm_ (suc f) rs j n q kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (q))) else (let a_5797 = rs in let j_5798 = j in scmd (w-load ((b2-a mm_ (%wadd a_5797 (%wsucc j_5798))))) (λ x_5796 → let mm_5799 = b2-dep mm_ x_5796 in let row = x_5796 in let t_5801 = row in let j_5802 = #0 in scmd (w-load ((b2-a mm_5799 (%wadd t_5801 (%wadd #2 j_5802))))) (λ x_5800 → let mm_5803 = b2-dep mm_5799 x_5800 in let ps = x_5800 in let a_5805 = ps in let j_5806 = #0 in scmd (w-load ((b2-a mm_5803 (%wadd a_5805 (%wsucc j_5806))))) (λ x_5804 → let mm_5807 = b2-dep mm_5803 x_5804 in let p0 = x_5804 in let t_5809 = p0 in scmd (w-load ((b2-a mm_5807 t_5809))) (λ x_5808 → let mm_5810 = b2-dep mm_5807 x_5808 in let tg = (%wand x_5808 #255) in if (%weq tg b2-PVAR) then (let t_5812 = p0 in let j_5813 = #2 in scmd (w-load ((b2-a mm_5810 (%wadd t_5812 (%wadd #2 j_5813))))) (λ x_5811 → let mm_5814 = b2-dep mm_5810 x_5811 in let pq = x_5811 in b2-pmarkg mm_5814 f rs (%wsucc j) n (b2-qjoin q pq) kq_)) else (b2-pmarkg mm_5810 f rs (%wsucc j) n q kq_))))))
