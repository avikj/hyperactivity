-- THEOREM 2: PRODUCTIVE CASHFLOW FIXED POINT PRESERVES 100% FOUNDER EQUITY AT ALL HORIZONS n : Nat!
tr-thm-stream-100pct-equity : (n : Nat) → (ep tw jb : Word) →
  tr-equity (tr-obs-epoch n (tr-cashflow-fix ep (mk-tr-state #10000 tw jb))) ≡ #10000
tr-thm-stream-100pct-equity zero    ep tw jb = refl
tr-thm-stream-100pct-equity (suc n) ep tw jb =
  tr-thm-stream-100pct-equity n (%wadd ep #1) (%wadd tw (tr-epoch-revenue ep)) (%wadd jb #1)
