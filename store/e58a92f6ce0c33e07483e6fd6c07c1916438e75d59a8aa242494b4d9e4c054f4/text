grh-drop-r-sound : (a b : GrhNode) → grh-emit (grh-drop-r a b) ≡ list-append (grh-emit a) (grh-emit b)
grh-drop-r-sound a grh-empty     = grh-sym (grh-app-nil-r (grh-emit a))
grh-drop-r-sound a (grh-seq x y) = grh-drop-l-sound a (grh-seq x y)
grh-drop-r-sound a (grh-raw s)   = grh-drop-l-sound a (grh-raw s)
