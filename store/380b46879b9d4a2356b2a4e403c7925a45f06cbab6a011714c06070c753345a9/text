-- 4-term abelian interchange: (a + b) + (c + d) = (a + c) + (b + d).
qgm-swap4 : (A : Type) → (z : A) → (add : A → A → A) → (neg : A → A) → QgmAb A z add neg →
  (a b c d : A) → add (add a b) (add c d) ≡ add (add a c) (add b d)
qgm-swap4 A z add neg ab a b c d = concat
  (qgm-assoc A z add neg ab a b (add c d))
  (concat
    (cong (λ t → add a t)
      (concat
        (sym (qgm-assoc A z add neg ab b c d))
        (concat
          (cong (λ t → add t d) (qgm-comm A z add neg ab b c))
          (qgm-assoc A z add neg ab c b d))))
    (sym (qgm-assoc A z add neg ab a c (add b d))))
