b2-arrlist : Word → Nat → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-arrlist mm_ zero a j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-arrlist mm_ (suc f) a j acc kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (acc))) else (let a_34 = a in let j_35 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_34 (%wsucc j_35))))) (λ x_33 → let mm_36 = b2-dep mm_ x_33 in let x = x_33 in b2-arrlist mm_36 f a (%wsub j #1) (cons x acc) kq_))
