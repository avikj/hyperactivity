b2-letenv : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-letenv mm_ zero is xs j n env kq_ =
  kq_ (h4-depl mm_ (env))
b2-letenv mm_ (suc f) is xs j n env kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (env))) else (let a_2152 = is in let j_2153 = j in scmd (w-load ((b2-a mm_ (%wadd a_2152 (%wsucc j_2153))))) (λ x_2151 → let mm_2154 = b2-dep mm_ x_2151 in let i = x_2151 in let a_2156 = xs in let j_2157 = j in scmd (w-load ((b2-a mm_2154 (%wadd a_2156 (%wsucc j_2157))))) (λ x_2155 → let mm_2158 = b2-dep mm_2154 x_2155 in let x = x_2155 in b2-lset mm_2158 env i x (λ e2 → let mm_2159 = b2-dep mm_2158 e2 in b2-letenv mm_2159 f is xs (%wsucc j) n e2 kq_))))
