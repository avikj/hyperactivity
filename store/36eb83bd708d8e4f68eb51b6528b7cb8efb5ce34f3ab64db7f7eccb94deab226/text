-- Deterministic Knowledge-Graph Module Selector 1 (primary live store/ module for (route, question))
this-select-mod1 : List Word → List Word → List Word
this-select-mod1 route q =
  let dp = this-doc-route-path route
      lq = this-lower q
      lr = this-lower route
  in if h-not (h-null dp) then dp
     else if this-has-any (cons "poly" (cons "karatsuba" (cons "polyz" (cons "polyf2" (cons "normal-form" nil))))) lq
       then "lib/ir/poly-opt.hypercubical"
     else if this-has-any (cons "sky130" (cons "foundry" (cons "gds" (cons "fmax" (cons "stdcell" (cons "cell count" (cons "42-gpu" (cons "42 gpu" (cons "h200" (cons "nvlink" (cons "llm-zip" nil))))))))))) lq
       then "lib/silicon/hx-foundry.hypercubical"
     else if this-has-any (cons "darwin" (cons "hyperbolic" (cons "evolv" (cons "h^2" nil)))) lq
       then "lib/math/darwin-evolution.hypercubical"
     else if this-has-any (cons "alpoge" (cons "masullo" (cons "bost" (cons "lemniscate" nil)))) lq
       then "lib/math/rh-alpo-masullo.hypercubical"
     else if this-has-any (cons "riemann" (cons "zeta" (cons "prime" (cons "mobius" (cons "mertens" nil))))) lq
       then "lib/math/riemann-zeta.hypercubical"
     else if this-has-any (cons "synesth" (cons "knot" (cons "remix" (cons "work-flow" (cons "workflow" nil))))) lq
       then "lib/math/synesthetic-flow.hypercubical"
     else if this-has-any (cons "kexpr" (cons "toffoli" (cons "qasm" (cons "clifford" nil)))) lq
       then "lib/ir/kexpr.hypercubical"
     else if this-has-any (cons "guard" (cons "extension" (cons "smuggl" nil))) lq
       then "lib/guard.hypercubical"
     else if this-has-any (cons "swarm" (cons "agent" (cons "flux" (cons "lens" (cons "crdt" (cons "memory" nil)))))) lq
       then "lib/os-flux.hypercubical"
     else if this-has-any (cons "wetlab" (cons "cayley" (cons "aspirin" (cons "stoichiom" nil)))) lq
       then "chem/wetlab-laws.hypercubical"
     else if h-infix "/silicon" lr then "lib/silicon/hx-foundry.hypercubical"
     else if h-infix "/physics" lr then "lib/math/riemann-zeta.hypercubical"
     else if h-infix "/hyperfactor" lr then "lib/ir/poly-opt.hypercubical"
     else if h-infix "/supercomputer" lr then "lib/hx-supercomp.hypercubical"
     else "lib/hx.hypercubical"
