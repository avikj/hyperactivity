-- Exercise the six-gate search used by hx synth. Success requires a one-gate
-- result whose packed netlist reproduces the target on all eight input rows.
hs-one-gate-ok : Word → Bool
hs-one-gate-ok target =
  let result = hs-id target #6
      gates = fst result
      prog = fst (snd result)
  in andB (%weq gates #1) (hs-verify target prog (toNat gates))
