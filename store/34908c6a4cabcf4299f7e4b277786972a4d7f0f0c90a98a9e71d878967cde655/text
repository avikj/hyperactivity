b2-wnfrun : Word → Nat → B2X → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-wnfrun mm_ zero rx bk md a b c kq_ =
  kq_ (h4-depl mm_ (a))
b2-wnfrun mm_ (suc f) rx bk md a b c kq_ =
  b2-wnfbatch mm_ rx bk md a b c (λ x → let mm_3451 = b2-dep mm_ x in scmd (w-load ((b2-HR mm_3451 #7))) (λ kd → let mm_3452 = b2-dep mm_3451 kd in scmd (w-load ((b2-HR mm_3452 #8))) (λ v → let mm_3453 = b2-dep mm_3452 v in if (%weq kd #0) then (kq_ (h4-depl mm_3453 (v))) else (scmd (w-load ((b2-HR mm_3453 #11))) (λ md2 → let mm_3454 = b2-dep mm_3453 md2 in scmd (w-load ((b2-HR mm_3454 #12))) (λ a2 → let mm_3455 = b2-dep mm_3454 a2 in scmd (w-load ((b2-HR mm_3455 #13))) (λ b2 → let mm_3456 = b2-dep mm_3455 b2 in scmd (w-load ((b2-HR mm_3456 #14))) (λ c2 → let mm_3457 = b2-dep mm_3456 c2 in b2-wnfrun mm_3457 f rx bk md2 a2 b2 c2 kq_))))))))
