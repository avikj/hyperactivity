taut-tail-zero : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → ScRing A z add mul neg →
  (c : A) → (bs : List A) → (n : Nat) →
  taut-tail-form A z add mul c bs (taut-zeros A z n) ≡ z
taut-tail-zero A z add mul neg r c bs =
  case bs return λ blist → (n : Nat) → taut-tail-form A z add mul c blist (taut-zeros A z n) ≡ z of
    nil → λ n → refl
    cons bk br → taut-tail-zero-cons A z add mul neg r c bk br (rec br)
