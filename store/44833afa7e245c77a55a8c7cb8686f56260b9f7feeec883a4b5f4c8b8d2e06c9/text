  b2-mget mm_ tmps k (λ is0 → let mm_10775 = b2-dep mm_ is0 in if (not (%weq is0 hv2-none)) then (kq_ (h4-depl mm_10775 (is0))) else (b2-map mm_10775 #0 (λ mp → let mm_10776 = b2-dep mm_10775 mp in let n_10778 = #2 in scmd (w-load (mm_10776)) (λ at_10777 → let mm_10779 = b2-dep mm_10776 at_10777 in scmd (w-store (mm_10779) ((%wadd at_10777 n_10778))) (λ uu_10780 → let mm_10781 = hv2-u mm_10779 uu_10780 in let at = at_10777 in let i_10782 = at in let v_10783 = mp in scmd (w-store ((b2-a mm_10781 i_10782)) (v_10783)) (λ uu_10784 → let mm_10785 = hv2-u mm_10781 uu_10784 in let i_10786 = (%wadd at #1) in let v_10787 = #0 in scmd (w-store ((b2-a mm_10785 i_10786)) (v_10787)) (λ uu_10788 → let mm_10789 = hv2-u mm_10785 uu_10788 in b2-mset mm_10789 tmps k at (λ dd_10790 → let mm_10791 = b2-dep mm_10789 dd_10790 in kq_ (h4-depl mm_10791 (at))))))))))
