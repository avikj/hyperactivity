  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_14106 = bk in let j_14107 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_14106 (%wadd #2 j_14107))))) (λ x_14105 → let mm_14108 = b2-dep mm_ x_14105 in let ov = x_14105 in let v_14111 = ov in let j_14112 = j in scmd (w-load ((b2-a mm_14108 (%wadd v_14111 #2)))) (λ d_14109 → let mm_14113 = b2-dep mm_14108 d_14109 in scmd (w-load ((b2-a mm_14113 (%wadd d_14109 (%wsucc j_14112))))) (λ x_14110 → let mm_14114 = b2-dep mm_14113 x_14110 in let k = x_14110 in b2-tld mm_14114 bk k (λ t → let mm_14115 = b2-dep mm_14114 t in let t_14117 = t in scmd (w-load ((b2-a mm_14115 t_14117))) (λ x_14116 → let mm_14118 = b2-dep mm_14115 x_14116 in let tg = (%wand x_14116 #255) in let t_14119 = t in let j_14120 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_14121 = #1 in scmd (w-store ((b2-a mm_14118 (%wadd t_14119 (%wadd #2 j_14120)))) (v_14121)) (λ uu_14122 → let mm_14123 = hv2-u mm_14118 uu_14122 in b2-markbase mm_14123 f bk (%wsucc j) n kq_)))))))
