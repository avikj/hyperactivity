ga-thm-hypercrack-masullo-closure :
  let rawCrack    = ga-hypercrack ga-masullo-unpatched-bad
      unifiedChk  = ga-hypercrack ga-masullo-unified-bad
      alpoCheck   = ga-hypercrack ga-alpo-offline-bad
      okRaw       = case rawCrack   of inl _ → false ; inr w → andB (%weq w #0) (ga-eval (ga-env4 w) ga-masullo-unpatched-bad)
      okUnified   = case unifiedChk of inl _ → true  ; inr _ → false
      okAlpo      = case alpoCheck  of inl _ → true  ; inr _ → false
  in andB okRaw (andB okUnified okAlpo) ≡ true
ga-thm-hypercrack-masullo-closure = refl
