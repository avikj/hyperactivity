usf-drop-empty-l : UsfNode → UsfNode → UsfNode
usf-drop-empty-l usf-empty b           = b
usf-drop-empty-l (usf-seq x y) b       = usf-seq (usf-seq x y) b
usf-drop-empty-l (usf-nav p) b         = usf-seq (usf-nav p) b
usf-drop-empty-l (usf-splash t s w) b  = usf-seq (usf-splash t s w) b
usf-drop-empty-l usf-portal b          = usf-seq usf-portal b
usf-drop-empty-l (usf-section i l p) b = usf-seq (usf-section i l p) b
usf-drop-empty-l (usf-benches i l r) b = usf-seq (usf-benches i l r) b
usf-drop-empty-l usf-footer b          = usf-seq usf-footer b
