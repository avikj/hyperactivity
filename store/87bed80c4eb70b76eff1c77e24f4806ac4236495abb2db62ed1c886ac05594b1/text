b2-base : Word → List (List Word) → (List Word → Step W Word) → Step W Word
b2-base mm_ rest kq_ =
  if (not (h4-stknil0 rest)) then (kq_ (h4-depl mm_ ((h4-tget-go #0 rest)))) else (b2-getenv mm_ "BEND_DIR" (λ e → let mm_16503 = b2-dpe mm_ e in if (fst e) then (kq_ (h4-depl mm_16503 ((list-append (snd e) "/base.bend")))) else (kq_ (h4-depl mm_16503 (b2-basedefault)))))
