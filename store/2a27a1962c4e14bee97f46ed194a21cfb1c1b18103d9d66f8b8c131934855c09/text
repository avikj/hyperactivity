-- the key of s is above the key of z exactly when s is above z
k-key-psi : (t : List (List Word)) → (f : List (List Word) → Word) → FinRank t f → (s z : List (List Word)) →
            MemKey {suffix-ord} s (sufs t) → MemKey {suffix-ord} z (sufs t) → leq {k-PR} (k-key (f s)) (k-psi f z) ≡ leq {suffix-ord} s z
k-key-psi t f fin s z ms mz = tr {Bool} {leq {k-PR} (k-key (f s)) (k-psi f z)} {leq {suffix-ord} s z} (word-le (f s) (f z)) (k-key-le (f s) (k-psi f z)) (fin s z ms mz)
