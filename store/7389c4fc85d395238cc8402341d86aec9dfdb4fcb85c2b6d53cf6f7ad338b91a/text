b2-lvals : Word → Nat → Word → List Word → (List Word → Step W Word) → Step W Word
b2-lvals mm_ zero l acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-lvals mm_ (suc f) l acc kq_ =
  if (%weq l #0) then (kq_ (h4-depl mm_ (acc))) else (let i_549 = (%wadd l #1) in scmd (w-load ((b2-a mm_ i_549))) (λ x_548 → let mm_550 = b2-dep mm_ x_548 in let v = x_548 in let i_552 = (%wadd l #2) in scmd (w-load ((b2-a mm_550 i_552))) (λ x_551 → let mm_553 = b2-dep mm_550 x_551 in let nx = x_551 in b2-lvals mm_553 f nx (cons v acc) kq_)))
