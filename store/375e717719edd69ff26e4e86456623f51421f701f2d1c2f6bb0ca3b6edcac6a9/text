-- Order laws for positive definiteness:
--   (sq-nn, pos-mul-nn, nn-add, pos-cancel-nn, pos-mul, nn-add-pos, pos-cancel-pos)
QmolOrd : (A : Type) → (A → A → A) → (A → A → A) → (A → Type) → (A → Type) → Type
QmolOrd A add mul Pos Nonneg =
  ((x : A) → Nonneg (mul x x)) ×
  (((x y : A) → Pos x → Nonneg y → Nonneg (mul x y)) ×
  (((x y : A) → Nonneg x → Nonneg y → Nonneg (add x y)) ×
  (((x y : A) → Pos x → Nonneg (mul x y) → Nonneg y) ×
  (((x y : A) → Pos x → Pos y → Pos (mul x y)) ×
  (((x y : A) → Nonneg x → Pos y → Pos (add x y)) ×
  ((x y : A) → Pos x → Pos (mul x y) → Pos y))))))
