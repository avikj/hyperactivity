-- first-party ad-blocker-proof Umami tag: loads tracker via /hx/x.js and posts beacons to /hx/ev (proxied to gateway.umami.is/api/send)
um-tag : List Word
um-tag = if h-null um-website-id then nil
  else h-concat (cons "<script defer src='/hx/x.js' data-website-id='" (cons um-website-id (cons "' data-host-url='/hx' data-domains='hyperactivity.onrender.com'></script>" (cons um-events-js nil))))
