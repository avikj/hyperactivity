-- ANNI: two nodes of one kind: their aux ports joined pairwise
hv2-anni : Hv2Net → Word → Word → Hv2Net
hv2-anni net a b =
  let wa = hv2-node-get net (hv2-val a)
      wb = hv2-node-get net (hv2-val b)
      net1 = hv2-node-del (hv2-node-del net (hv2-val a)) (hv2-val b)
  in hv2-ln (hv2-ln net1 (hv2-fst wa) (hv2-fst wb)) (hv2-snd wa) (hv2-snd wb)
