sfc-neg-sq : (A : Type) → (z : A) → (add mul : A → A → A) → (neg : A → A) → SfcRing A z add mul neg →
  (y : A) → mul (neg y) (neg y) ≡ mul y y
sfc-neg-sq A z add mul neg r y =
  concat (fst (snd (snd (snd (snd (snd (snd (snd (snd r)))))))) y (neg y))
    (concat (cong neg (fst (snd (snd (snd (snd (snd (snd (snd (snd (snd r))))))))) y y))
            (snd (snd (snd (snd (snd (snd (snd (snd (snd (snd r))))))))) (mul y y)))
