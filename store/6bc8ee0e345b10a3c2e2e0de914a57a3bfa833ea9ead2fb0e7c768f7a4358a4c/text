b2-namelen : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-namelen mm_ zero s i n kq_ =
  kq_ (h4-depl mm_ (i))
b2-namelen mm_ (suc f) s i n kq_ =
  if (not (%wlt i n)) then (kq_ (h4-depl mm_ (i))) else (let a_7033 = s in let j_7034 = i in scmd (w-load ((b2-a mm_ (%wadd a_7033 (%wsucc j_7034))))) (λ x_7032 → let mm_7035 = b2-dep mm_ x_7032 in let c = x_7032 in if (b2-ischar c) then (b2-namelen mm_7035 f s (%wsucc i) n kq_) else (kq_ (h4-depl mm_7035 (i)))))
