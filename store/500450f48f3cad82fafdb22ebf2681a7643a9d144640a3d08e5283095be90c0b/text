vx-rel-all-ok :
  (Word → Word → Word × Word) →
  (Word → Word → Word × Word) →
  Nat → List (Word × Word) → List (Word × Word) → Bool
vx-rel-all-ok stp1 stp2 nI fullRel nil = true
vx-rel-all-ok stp1 stp2 nI fullRel (cons p ps) =
  web-andB (vx-pair-ok-inputs stp1 stp2 fullRel (fst p) (snd p) nI #0)
           (vx-rel-all-ok stp1 stp2 nI fullRel ps)
