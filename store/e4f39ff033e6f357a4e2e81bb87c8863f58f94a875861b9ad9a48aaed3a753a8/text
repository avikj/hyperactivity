b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_6797 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_6797 (#1))) else (b2-pstr mm_6797 p (λ s → let mm_6798 = b2-dep mm_6797 s in let p_6800 = p in let i_6802 = (%wadd p_6800 #1) in scmd (w-load ((b2-a mm_6798 i_6802))) (λ x_6801 → let mm_6803 = b2-dep mm_6798 x_6801 in let x_6799 = x_6801 in let i = x_6799 in let a_6805 = s in scmd (w-load ((b2-a mm_6803 a_6805))) (λ x_6804 → let mm_6806 = b2-dep mm_6803 x_6804 in let n = x_6804 in b2-col mm_6806 s i (λ c → let mm_6807 = b2-dep mm_6806 c in kq_ (h4-depl mm_6807 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
