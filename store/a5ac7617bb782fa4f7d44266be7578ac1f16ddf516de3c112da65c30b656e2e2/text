b2-firstctr mm_ zero rs j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-firstctr mm_ (suc f) rs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_5495 = rs in let j_5496 = j in scmd (w-load ((b2-a mm_ (%wadd a_5495 (%wsucc j_5496))))) (λ x_5494 → let mm_5497 = b2-dep mm_ x_5494 in let row = x_5494 in let t_5499 = row in let j_5500 = #0 in scmd (w-load ((b2-a mm_5497 (%wadd t_5499 (%wadd #2 j_5500))))) (λ x_5498 → let mm_5501 = b2-dep mm_5497 x_5498 in let ps = x_5498 in let a_5503 = ps in let j_5504 = #0 in scmd (w-load ((b2-a mm_5501 (%wadd a_5503 (%wsucc j_5504))))) (λ x_5502 → let mm_5505 = b2-dep mm_5501 x_5502 in let p0 = x_5502 in let t_5507 = p0 in scmd (w-load ((b2-a mm_5505 t_5507))) (λ x_5506 → let mm_5508 = b2-dep mm_5505 x_5506 in let tg = (%wand x_5506 #255) in if (%weq tg b2-PCTR) then (kq_ (h4-depl mm_5508 (p0))) else (b2-firstctr mm_5508 f rs (%wsucc j) n kq_))))))
