-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_11620 = tld in scmd (w-load ((b2-a mm_ t_11620))) (λ x_11619 → let mm_11621 = b2-dep mm_ x_11619 in let tg = (%wand x_11619 #255) in if (%weq tg b2-TADT) then (let t_11623 = tld in let j_11624 = #4 in scmd (w-load ((b2-a mm_11621 (%wadd t_11623 (%wadd #2 j_11624))))) (λ x_11622 → let mm_11625 = b2-dep mm_11621 x_11622 in let b = x_11622 in kq_ (h4-depl mm_11625 (b)))) else (let t_11627 = tld in let j_11628 = #5 in scmd (w-load ((b2-a mm_11621 (%wadd t_11627 (%wadd #2 j_11628))))) (λ x_11626 → let mm_11629 = b2-dep mm_11621 x_11626 in let b = x_11626 in kq_ (h4-depl mm_11629 (b))))))
