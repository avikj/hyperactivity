b2-take : Word → Word → List Word → (Word → Step W Word) → Step W Word
b2-take mm_ p w kq_ =
  b2-at mm_ p w (λ r → let mm_6644 = b2-dep mm_ r in if (%weq r #0) then (kq_ (h4-depl mm_6644 (#0))) else (let p_6646 = p in let i_6648 = (%wadd p_6646 #1) in scmd (w-load ((b2-a mm_6644 i_6648))) (λ x_6647 → let mm_6649 = b2-dep mm_6644 x_6647 in let x_6645 = x_6647 in let i = x_6645 in let p_6650 = p in let v_6651 = (%wadd i (cli-len w)) in let i_6652 = (%wadd p_6650 #1) in let v_6653 = v_6651 in scmd (w-store ((b2-a mm_6649 i_6652)) (v_6653)) (λ uu_6654 → let mm_6655 = hv2-u mm_6649 uu_6654 in kq_ (h4-depl mm_6655 (#1))))))
