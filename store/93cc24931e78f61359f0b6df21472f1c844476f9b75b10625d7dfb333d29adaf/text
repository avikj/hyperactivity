e-part-one : List Word → List Word → Sum Unit EFound → Proc W (List Word × List (List Word))
e-part-one lw p (inl u) = ret (p , (if h-eq p lw then nil else cons (list-append "  " p) nil))
e-part-one lw p (inr f) = bind (e-part-out lw p f) (λ go → ret (fst go , list-append (if h-eq p lw then nil else cons (list-append "  " p) nil) (snd go)))
