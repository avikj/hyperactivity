b2-qual : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-qual mm_ p k kq_ =
  b2-pns mm_ p (λ ns → let mm_6765 = b2-dep mm_ ns in if (%weq ns b2-NEMPTYSTR) then (kq_ (h4-depl mm_6765 (k))) else (b2-nbytes mm_6765 ns (λ nb → let mm_6766 = b2-dpl mm_6765 nb in b2-nbytes mm_6766 k (λ kb → let mm_6767 = b2-dpl mm_6766 kb in b2-nm mm_6767 (list-append nb (cons #58 kb)) (λ r → let mm_6768 = b2-dep mm_6767 r in kq_ (h4-depl mm_6768 (r)))))))
