hv2-apply : Word → Word → Word → Word → Word
hv2-apply opc tyc xa xb =
  if %weq tyc hv2-TY-U24 then hv2-new hv2-TY-U24 (hv2-op-u opc (hv2-u24 xa) (hv2-u24 xb))
  else if %weq tyc hv2-TY-I24 then hv2-op-i opc (hv2-u24 xa) (hv2-u24 xb)
  else if %weq tyc hv2-TY-F24 then hv2-op-f opc (ief-of-f24 (hv2-u24 xa)) (ief-of-f24 (hv2-u24 xb))
  else hv2-new hv2-TY-U24 #0
