-- THEOREM 6: EXACT ASSOCIATIVITY OF COLLECTIVE CRDT MERGE
fl-min-assoc : (a b c : Nat) → fl-min (fl-min a b) c ≡ fl-min a (fl-min b c)
fl-min-assoc zero b c = refl
fl-min-assoc (suc a) zero c = refl
fl-min-assoc (suc a) (suc b) zero = refl
fl-min-assoc (suc a) (suc b) (suc c) = λ i → suc (fl-min-assoc a b c i)
