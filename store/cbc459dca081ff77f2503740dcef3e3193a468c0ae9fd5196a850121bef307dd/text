-- THEOREM 3 (CONVERSE: GRH ==> ZERO EXTERIOR MASS FOR ALL STRIP WIDTHS alpha >= 1!):
ms-thm-grh-implies-no-exterior : (alpha : Nat) (zs : List Nat) →
  ms-all-on-line zs ≡ true →
  ms-exterior-count (suc alpha) zs ≡ zero
ms-thm-grh-implies-no-exterior alpha nil _ = refl
ms-thm-grh-implies-no-exterior alpha (cons zero ds) h =
  ms-thm-grh-implies-no-exterior alpha ds h
ms-thm-grh-implies-no-exterior alpha (cons (suc d) ds) h =
  rh-absurd-f h
