fl-metal-host-p2 : List Word
fl-metal-host-p2 =
  fl-ln "    const uint32_t N = 67108864u;"
  (fl-ln "    const uint32_t CHUNK = 256u;"
  (fl-ln "    const uint32_t NBLOCKS = N / CHUNK;"
  (fl-ln "    id<MTLBuffer> bToks = [dev newBufferWithLength:N options:MTLResourceStorageModeShared];"
  (fl-ln "    id<MTLBuffer> bOut  = [dev newBufferWithLength:NBLOCKS * sizeof(ValMon) options:MTLResourceStorageModeShared];"
  (fl-ln "    uint8_t* toks = (uint8_t*)[bToks contents];"
  (fl-ln "    const uint8_t pat[8] = {0, 0, 2, 0, 1, 4, 2, 4};"
  (fl-ln "    for (uint32_t i = 0; i < N; i++) toks[i] = pat[i & 7u];"
  (fl-ln "    uint32_t chunk_val = CHUNK;"
  (fl-ln "    double best_dt = 1e9;"
  (fl-ln "    for (int it = 0; it < 11; it++) {"
  (fl-ln "      id<MTLCommandBuffer> cb = [q commandBuffer];"
  (fl-ln "      id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];"
  (fl-ln "      [enc setComputePipelineState:pso];"
  (fl-ln "      [enc setBuffer:bToks offset:0 atIndex:0];"
  (fl-ln "      [enc setBuffer:bOut offset:0 atIndex:1];"
  (fl-ln "      [enc setBytes:&chunk_val length:sizeof(uint32_t) atIndex:2];"
  (fl-ln "      [enc dispatchThreads:MTLSizeMake(NBLOCKS, 1, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];"
  (fl-ln "      [enc endEncoding];"
  (fl-ln "      double t0 = now_s();"
  (fl-ln "      [cb commit]; [cb waitUntilCompleted];"
  (fl-ln "      double dt = now_s() - t0;"
  (fl-ln "      if (it > 0 && dt < best_dt) best_dt = dt;"
  (fl-ln "    }"
  (fl-ln "    ValMon* out = (ValMon*)[bOut contents];"
  (fl-ln "    ValMon tot = {0u, 0u};"
  (fl-ln "    for (uint32_t i = 0; i < NBLOCKS; i++) tot = vm_comp(tot, out[i]);"
  (fl-ln "    int ok = (tot.need == 0u && tot.give == (N / 8u));"
  (fl-ln (list-append "    printf(" (list-append fl-q (list-append "[HX-FLOW-METAL] device=%s | N=%u zero-paren tokens | queries_closed=%u | ok=%d | %.2f G-tok/s (%.3f ms)" (list-append fl-esc-n (list-append fl-q ", [[dev name] UTF8String], N, tot.give, ok, (double)N/(best_dt*1e9), best_dt*1e3);")))))
  (fl-ln "    return ok ? 0 : 1;"
  (fl-ln "  }"
  (fl-ln "}" nil)))))))))))))))))))))))))))))))
