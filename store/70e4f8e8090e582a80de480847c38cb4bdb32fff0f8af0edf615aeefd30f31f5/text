  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_14419 = seen in let j_14420 = j in scmd (w-load ((b2-a mm_ (%wadd v_14419 #2)))) (λ d_14417 → let mm_14421 = b2-dep mm_ d_14417 in scmd (w-load ((b2-a mm_14421 (%wadd d_14417 (%wsucc j_14420))))) (λ x_14418 → let mm_14422 = b2-dep mm_14421 x_14418 in let e = x_14418 in let i_14424 = e in scmd (w-load ((b2-a mm_14422 i_14424))) (λ x_14423 → let mm_14425 = b2-dep mm_14422 x_14423 in let x = x_14423 in if (%weq x p) then (kq_ (h4-depl mm_14425 (e))) else (b2-seenat mm_14425 f seen p (%wsucc j) n kq_)))))
