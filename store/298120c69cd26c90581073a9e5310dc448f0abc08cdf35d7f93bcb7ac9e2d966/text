-- the alias whose target is ns, in the order the aliases were made: a file's aliases are a
-- vector of [alias, target] pairs (names)
b2-alias : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-alias mm_ zero als j n ns kq_ =
  kq_ (h4-depl mm_ (#0))
b2-alias mm_ (suc f) als j n ns kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_604 = als in let j_605 = j in scmd (w-load ((b2-a mm_ (%wadd v_604 #2)))) (λ d_602 → let mm_606 = b2-dep mm_ d_602 in scmd (w-load ((b2-a mm_606 (%wadd d_602 (%wsucc j_605))))) (λ x_603 → let mm_607 = b2-dep mm_606 x_603 in let pr = x_603 in let i_609 = (%wadd pr #1) in scmd (w-load ((b2-a mm_607 i_609))) (λ x_608 → let mm_610 = b2-dep mm_607 x_608 in let t = x_608 in if (%weq t ns) then (let i_612 = pr in scmd (w-load ((b2-a mm_610 i_612))) (λ x_611 → let mm_613 = b2-dep mm_610 x_611 in let a = x_611 in kq_ (h4-depl mm_613 (a)))) else (b2-alias mm_610 f als (%wsucc j) n ns kq_)))))
