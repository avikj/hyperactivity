b2-namelen : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-namelen mm_ zero s i n kq_ =
  kq_ (h4-depl mm_ (i))
b2-namelen mm_ (suc f) s i n kq_ =
  if (not (%wlt i n)) then (kq_ (h4-depl mm_ (i))) else (let a_6392 = s in let j_6393 = i in scmd (w-load ((b2-a mm_ (%wadd a_6392 (%wsucc j_6393))))) (λ x_6391 → let mm_6394 = b2-dep mm_ x_6391 in let c = x_6391 in if (b2-ischar c) then (b2-namelen mm_6394 f s (%wsucc i) n kq_) else (kq_ (h4-depl mm_6394 (i)))))
