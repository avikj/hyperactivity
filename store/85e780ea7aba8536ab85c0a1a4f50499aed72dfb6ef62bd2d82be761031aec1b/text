tc-k4-vs : Bool → List Nat → List QgmState
tc-k4-vs hm vs = case vs of
  nil → nil
  cons v rest → qgm-append-st
    (tc-k4-e3
      (if hm then qgm-charge BZ bz-zero bz-one bz-add bz-neg 1 0 v else bz-zero)
      (if hm then qgm-charge BZ bz-zero bz-one bz-add bz-neg 2 0 v else bz-zero)
      (if hm then qgm-charge BZ bz-zero bz-one bz-add bz-neg 3 0 v else bz-zero)
      v qmol-flux-range1 qmol-flux-range1)
    (tc-k4-vs hm rest)
