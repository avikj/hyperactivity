h4-strfold : Word → Nat → List Word → Word → (Word → Step W Word) → Step W Word
h4-strfold m zero rcs t k =
  k (h4-depl m (t))
h4-strfold m (suc f) rcs t k =
  if (%weq (cli-len rcs) #0) then (k (h4-depl m (t))) else (h4-ctr m h4-CHR (cons (h4-num (hv2-nth #0 rcs)) nil) (λ h → let m58 = h4-dep m h in h4-ctr m58 h4-CON (cons h (cons t nil)) (λ c → let m59 = h4-dep m58 c in h4-strfold m59 f (hv2-drop1 rcs) c k)))
