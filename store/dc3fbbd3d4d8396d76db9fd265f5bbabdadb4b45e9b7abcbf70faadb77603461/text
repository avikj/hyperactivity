-- Exact dyadic enclosure of sqrt(J(J+2)) at precision s: returns (lo, hi) integers in units of 1/2^s
-- satisfying lo/2^s <= sqrt(J(J+2)) < hi/2^s (with hi = lo if exact square, else lo + 1).
qg-link-area : Nat → List Bool → List Bool × List Bool
qg-link-area s J = (qg-isqrt (bin-mul (qg-area2 J) (bin-pow2 (plus s s))) ,
  if bin-eq (bin-mul (qg-isqrt (bin-mul (qg-area2 J) (bin-pow2 (plus s s)))) (qg-isqrt (bin-mul (qg-area2 J) (bin-pow2 (plus s s))))) (bin-mul (qg-area2 J) (bin-pow2 (plus s s)))
  then qg-isqrt (bin-mul (qg-area2 J) (bin-pow2 (plus s s)))
  else bin-succ (qg-isqrt (bin-mul (qg-area2 J) (bin-pow2 (plus s s)))))
