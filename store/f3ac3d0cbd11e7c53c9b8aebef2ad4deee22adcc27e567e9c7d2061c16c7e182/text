b2-netbytes : Word → Word → Bool → Word → (List Word → Step W Word) → Step W Word
b2-netbytes mm_ bk byt dat kq_ =
  if (byt) then (b2-fbytesarg mm_ bk true dat (λ db → let mm_16104 = b2-dpl mm_ db in kq_ (h4-depl mm_16104 (db)))) else (b2-strval mm_ bk dat (λ ds → let mm_16105 = b2-dpl mm_ ds in kq_ (h4-depl mm_16105 ((b2-utf8 ds)))))
