gn-wav-header : Word → List Word → List Word
gn-wav-header dataBytes tail =
  list-append "RIFF"
  (gn-u32le (%wadd #36 dataBytes)
  (list-append "WAVEfmt "
  (gn-u32le #16
  (gn-u16le #1
  (gn-u16le #1
  (gn-u32le #8000
  (gn-u32le #16000
  (gn-u16le #2
  (gn-u16le #16
  (list-append "data"
  (gn-u32le dataBytes tail)))))))))))
