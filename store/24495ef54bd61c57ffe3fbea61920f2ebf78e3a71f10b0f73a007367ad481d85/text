bg-sub-b : Word → List Word → List Word → List Word
bg-sub-b br nil ys = nil
bg-sub-b br (cons x xs) nil = bg-dec br (cons x xs)
bg-sub-b br (cons x xs) (cons y ys) =
  if %wlt x (%wadd y br) then cons (%wsub (%wadd x bg-B) (%wadd y br)) (bg-sub-b #1 xs ys)
  else cons (%wsub x (%wadd y br)) (bg-sub-b #0 xs ys)
