stat-record-go : List Word → List Word → List Word → List Word → List Word → Bool → Proc W Unit
stat-record-go st req raw base lua bot =
  bind time-now (λ ns →
  stat-append (list-append st "/hits.log")
    (stat-line (wquot ns #1000000000) (stat-log-path raw base) (stat-vhash (stat-ip req) lua) (stat-ref-host (stat-header "referer" req) raw) bot (stat-kind bot lua)))
