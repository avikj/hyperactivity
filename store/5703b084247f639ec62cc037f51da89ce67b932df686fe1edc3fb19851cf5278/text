-- a work in the answer: its address and the number of its places that start with the query, or that
-- its index is still being made
sx-item : List Word → List (List Word) → Sum Unit (List Word) → List Word
sx-item n q (inl u) = h-concat (cons "{" (cons (s-cj-str "h") (cons ":" (cons (s-cj-str (list-append "/" n)) (cons "," (cons (s-cj-str "w") (cons ":1}" nil)))))))
sx-item n q (inr l) = if h-null l then nil else (if weq (si-query l q) #0 then nil
  else h-concat (cons "{" (cons (s-cj-str "h") (cons ":" (cons (s-cj-str (list-append "/" n)) (cons "," (cons (s-cj-str "c") (cons ":" (cons (h-decimal (si-query l q)) (cons "}" nil))))))))))
