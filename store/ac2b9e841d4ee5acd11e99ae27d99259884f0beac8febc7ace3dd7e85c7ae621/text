e-roots-cmd : List Word
e-roots-cmd = e-dq "cat build/wiktionary/*-en/*-en.dict | grep -aoE '<(i|b) class=`[^`]*mention[^`]*` lang=`[^`]+`[^>]*>([^<]|<(a|span)[ >][^>]*>|</(a|span)>)*</(i|b)>(<span> </span>)?<span class=`mention-gloss-paren annotation-paren`>\(</span>(<span[^>]*>[^<]*</span>)*<span class=`mention-gloss`>[^<]*</span>' | sed -E 's/^<(i|b) class=`[^`]*` lang=`([^`]+)`[^>]*>(.*)<\/(i|b)>(<span> <\/span>)?<span class=`mention-gloss-paren annotation-paren`>.*<span class=`mention-gloss`>([^<]*)<\/span>$/\2\t\3\t\6/; s/<[^>]*>//g' | grep -aP '^[^\t]+\t\*' | LC_ALL=C sort | uniq -c | LC_ALL=C sort -k1,1nr -s > build/etym/roots.tmp && mv build/etym/roots.tmp build/etym/roots"
