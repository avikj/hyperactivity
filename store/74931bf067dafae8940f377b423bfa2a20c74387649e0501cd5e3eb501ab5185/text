-- Section (3): Universal Perspectival Coarse-Graining Purity Growth Theorem over Nat.
-- Self-contained Nat multiplication laws for (u + v)^2 = (u^2 + v^2) + 2*u*v.
qt-times-rdist : (a b c : Nat) → times (plus a b) c ≡ plus (times a c) (times b c)
qt-times-rdist a b c = case a return λ n → times (plus n b) c ≡ plus (times n c) (times b c) of
  zero → refl
  suc k → concat (cong (λ t → plus c t) (rec k)) (sym (plus-assoc c (times k c) (times b c)))
