b2-uptoq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-uptoq mm_ zero s i n kq_ =
  kq_ (h4-depl mm_ (i))
b2-uptoq mm_ (suc f) s i n kq_ =
  if (not (%wlt i n)) then (kq_ (h4-depl mm_ (i))) else (let a_8860 = s in let j_8861 = i in scmd (w-load ((b2-a mm_ (%wadd a_8860 (%wsucc j_8861))))) (λ x_8859 → let mm_8862 = b2-dep mm_ x_8859 in let c = x_8859 in if (%weq c #34) then (kq_ (h4-depl mm_8862 (i))) else (b2-uptoq mm_8862 f s (%wsucc i) n kq_)))
