b2-vfill : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-vfill mm_ zero v x j n kq_ =
  kq_ (h4-depl mm_ (v))
b2-vfill mm_ (suc f) v x j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (v))) else (b2-vpush mm_ v x (λ dd_10924 → let mm_10925 = b2-dep mm_ dd_10924 in b2-vfill mm_10925 f v x (%wsucc j) n kq_))
