b2-cwait : Word → Word → (Word → Step W Word) → Step W Word
b2-cwait mm_ item kq_ =
  if (%weq item hv2-none) then (b2-unitv mm_  (λ u → let mm_14804 = b2-dep mm_ u in b2-c1 mm_14804 "Wait" u (λ r → let mm_14805 = b2-dep mm_14804 r in kq_ (h4-depl mm_14805 (r))))) else (b2-c1 mm_ "Wait" item (λ r → let mm_14806 = b2-dep mm_ r in kq_ (h4-depl mm_14806 (r))))
