-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13389 = seen in let j_13390 = j in scmd (w-load ((b2-a mm_ (%wadd v_13389 #2)))) (λ d_13388 → let mm_13391 = b2-dep mm_ d_13388 in scmd (w-load ((b2-a mm_13391 (%wadd d_13388 (%wsucc j_13390))))) (λ x_13387 → let mm_13392 = b2-dep mm_13391 x_13387 in let e = x_13387 in let i_13394 = e in scmd (w-load ((b2-a mm_13392 i_13394))) (λ x_13393 → let mm_13395 = b2-dep mm_13392 x_13393 in let x = x_13393 in if (%weq x p) then (kq_ (h4-depl mm_13395 (e))) else (b2-seenat mm_13395 f seen p (%wsucc j) n kq_)))))
