-- ---------------------------------------------------------------- O(depth) occurrence & context lookup
-- specification: the k-th suffix position in sorted order in the search tree
si-kth-pos : RTree (El entry-ord) → Word → Word
si-kth-pos rleaf k = #0
si-kth-pos (rnode a sz x b) k =
  if wlt k sz then si-kth-pos a k
  else if weq k sz then snd x
  else si-kth-pos b (wsub k (%wsucc sz))
