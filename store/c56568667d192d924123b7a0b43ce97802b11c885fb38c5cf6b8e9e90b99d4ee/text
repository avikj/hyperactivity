-- a tele cell: [q, k, i, T, s]
b2-telebindg : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-telebindg mm_ zero tel j e kq_ =
  kq_ (h4-depl mm_ (e))
b2-telebindg mm_ (suc f) tel j e kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (e))) else (let a_7201 = tel in let j_7202 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_7201 (%wsucc j_7202))))) (λ x_7200 → let mm_7203 = b2-dep mm_ x_7200 in let c = x_7200 in let i_7205 = c in scmd (w-load ((b2-a mm_7203 i_7205))) (λ x_7204 → let mm_7206 = b2-dep mm_7203 x_7204 in let q = x_7204 in let i_7208 = (%wadd c #1) in scmd (w-load ((b2-a mm_7206 i_7208))) (λ x_7207 → let mm_7209 = b2-dep mm_7206 x_7207 in let k = x_7207 in let i_7211 = (%wadd c #2) in scmd (w-load ((b2-a mm_7209 i_7211))) (λ x_7210 → let mm_7212 = b2-dep mm_7209 x_7210 in let i = x_7210 in let i_7214 = (%wadd c #3) in scmd (w-load ((b2-a mm_7212 i_7214))) (λ x_7213 → let mm_7215 = b2-dep mm_7212 x_7213 in let vT = x_7213 in let i_7217 = (%wadd c #4) in scmd (w-load ((b2-a mm_7215 i_7217))) (λ x_7216 → let mm_7218 = b2-dep mm_7215 x_7216 in let s = x_7216 in b2-All mm_7218 q k i vT e s (λ a → let mm_7219 = b2-dep mm_7218 a in b2-telebindg mm_7219 f tel (%wsub j #1) a kq_))))))))
