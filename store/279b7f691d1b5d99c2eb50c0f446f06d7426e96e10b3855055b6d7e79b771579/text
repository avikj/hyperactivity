-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_12911 = seen in let j_12912 = j in scmd (w-load ((b2-a mm_ (%wadd v_12911 #2)))) (λ d_12910 → let mm_12913 = b2-dep mm_ d_12910 in scmd (w-load ((b2-a mm_12913 (%wadd d_12910 (%wsucc j_12912))))) (λ x_12909 → let mm_12914 = b2-dep mm_12913 x_12909 in let e = x_12909 in let i_12916 = e in scmd (w-load ((b2-a mm_12914 i_12916))) (λ x_12915 → let mm_12917 = b2-dep mm_12914 x_12915 in let x = x_12915 in if (%weq x p) then (kq_ (h4-depl mm_12917 (e))) else (b2-seenat mm_12917 f seen p (%wsucc j) n kq_)))))
