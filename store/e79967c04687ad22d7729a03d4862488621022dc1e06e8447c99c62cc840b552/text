ge-mk-and : GuardExpr → GuardExpr → GuardExpr
ge-mk-and (ge-k false) b            = ge-k false
ge-mk-and (ge-k true)  b            = b
ge-mk-and a            (ge-k false) = ge-k false
ge-mk-and a            (ge-k true)  = a
ge-mk-and a            b            =
  if ge-eq b (ge-not a) then ge-k false
  else if ge-eq a (ge-not b) then ge-k false
  else ge-and a b
