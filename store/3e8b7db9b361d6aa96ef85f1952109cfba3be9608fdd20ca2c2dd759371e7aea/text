b2-quant : Word → Bool → Word → (Word → Step W Word) → Step W Word
b2-quant mm_ exi p kq_ =
  if (exi) then (kq_ (h4-depl mm_ (b2-LONE))) else (b2-skip mm_ p (λ dd_8370 → let mm_8371 = b2-dep mm_ dd_8370 in b2-take mm_8371 p "-" (λ m → let mm_8372 = b2-dep mm_8371 m in if (%weq m #1) then (kq_ (h4-depl mm_8372 (b2-NONE))) else (b2-take mm_8372 p "+" (λ pl → let mm_8373 = b2-dep mm_8372 pl in if (%weq pl #1) then (kq_ (h4-depl mm_8373 (b2-MANY))) else (kq_ (h4-depl mm_8373 (b2-LONE))))))))
