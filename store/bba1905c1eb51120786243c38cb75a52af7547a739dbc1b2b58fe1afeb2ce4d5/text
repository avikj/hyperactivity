b2-peek : Word → Word → (Word → Step W Word) → Step W Word
b2-peek mm_ p kq_ =
  b2-pstr mm_ p (λ s → let mm_6288 = b2-dep mm_ s in let p_6290 = p in let i_6292 = (%wadd p_6290 #1) in scmd (w-load ((b2-a mm_6288 i_6292))) (λ x_6291 → let mm_6293 = b2-dep mm_6288 x_6291 in let x_6289 = x_6291 in let i = x_6289 in b2-uat mm_6293 s i (λ c → let mm_6294 = b2-dep mm_6293 c in kq_ (h4-depl mm_6294 (c)))))
