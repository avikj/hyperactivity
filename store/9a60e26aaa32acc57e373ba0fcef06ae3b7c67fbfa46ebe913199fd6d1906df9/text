sc-build-odd : Nat → List (Nat × Bool) → List ScKet
sc-build-odd i ts = case ts of
  nil → nil
  cons p rest →
    if eqb i (fst p)
    then sc-build-odd (suc i) rest
    else (if leb i (fst p)
          then cons (inr (i , (fst p , not (snd p)))) (sc-build-odd (suc i) rest)
          else sc-build-odd (suc i) rest)
