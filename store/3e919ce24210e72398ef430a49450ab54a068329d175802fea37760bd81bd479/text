e-word-parts : Bool → List Word → List Word → List Word → Proc W (List (List Word × Sum Unit EFound))
e-word-parts proper w lw prior = if proper
  then bind (e-one w (inr w)) (λ r → bind (e-or-found r (e-one lw (inr w))) (λ r2 → ret {lzero} {W} (e-parts-if lw r2)))
  else e-resolve (toNat #3) true lw
