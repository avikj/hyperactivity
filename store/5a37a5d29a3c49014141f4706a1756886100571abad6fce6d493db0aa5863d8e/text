-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10584 = tld in scmd (w-load ((b2-a mm_ t_10584))) (λ x_10583 → let mm_10585 = b2-dep mm_ x_10583 in let tg = (%wand x_10583 #255) in if (%weq tg b2-TADT) then (let t_10587 = tld in let j_10588 = #4 in scmd (w-load ((b2-a mm_10585 (%wadd t_10587 (%wadd #2 j_10588))))) (λ x_10586 → let mm_10589 = b2-dep mm_10585 x_10586 in let b = x_10586 in kq_ (h4-depl mm_10589 (b)))) else (let t_10591 = tld in let j_10592 = #5 in scmd (w-load ((b2-a mm_10585 (%wadd t_10591 (%wadd #2 j_10592))))) (λ x_10590 → let mm_10593 = b2-dep mm_10585 x_10590 in let b = x_10590 in kq_ (h4-depl mm_10593 (b))))))
