  orB (h-eq p "/portal") (orB (h-eq p "/collab") (orB (h-eq p "/collablink") (orB (h-eq p "/supercomputer") (orB (orB (h-eq p "/os") (orB (h-eq p "/eval") (orB (h-eq p "/api/eval") (orB (h-eq p "/pay") (h-prefix "/api/x402/" path))))) (orB (orB (h-eq p "/api/this/status") (h-eq p "/api/oracle/status")) (orB (h-prefix "/hx/" path) (
