sfc-mm2 : SfcM2 → SfcM2 → SfcM2
sfc-mm2 a b =
  ((bq-add (bq-mul (fst (fst a)) (fst (fst b))) (bq-mul (snd (fst a)) (fst (snd b))) ,
    bq-add (bq-mul (fst (fst a)) (snd (fst b))) (bq-mul (snd (fst a)) (snd (snd b)))) ,
   (bq-add (bq-mul (fst (snd a)) (fst (fst b))) (bq-mul (snd (snd a)) (fst (snd b))) ,
    bq-add (bq-mul (fst (snd a)) (snd (fst b))) (bq-mul (snd (snd a)) (snd (snd b)))))
