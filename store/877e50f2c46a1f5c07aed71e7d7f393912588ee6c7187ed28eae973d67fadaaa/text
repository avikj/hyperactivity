-- THEOREM 2B (Universal Schur-Complement / Bareiss Positive-Semidefiniteness Inductive Step):
-- If pivot a > 0, previous pivot d > 0, Bareiss reduction satisfies a * q(v) = (b.v)^2 + d * q_S(v)
-- for every sub-vector v, and q_S(v) >= 0 for all v, then Q(u, v) = a*u^2 + 2*u*(b.v) + q(v) >= 0 for ALL (u, v)!
qmol-schur-psd : (A V : Type) → (add mul : A → A → A) → (Pos Nonneg : A → Type) →
  QmolSR A add mul → QmolOrd A add mul Pos Nonneg →
  (a d : A) → Pos a → Pos d →
  (bdot q qS : V → A) →
  ((v : V) → mul a (q v) ≡ add (mul (bdot v) (bdot v)) (mul d (qS v))) →
  ((v : V) → Nonneg (qS v)) →
  (u : A) → (v : V) → Nonneg (add (mul a (mul u u)) (add (add (mul u (bdot v)) (mul u (bdot v))) (q v)))
qmol-schur-psd A V add mul Pos Nonneg sr ord a d pa pd bdot q qS hbar hnn u v =
  fst (snd (snd (snd ord))) a
    (add (mul a (mul u u)) (add (add (mul u (bdot v)) (mul u (bdot v))) (q v)))
    pa
    (transport (λ i → Nonneg (sym (qmol-schur-id A add mul sr a u (bdot v) (q v) d (qS v) (hbar v)) i))
      (fst (snd (snd ord))
        (mul (add (mul a u) (bdot v)) (add (mul a u) (bdot v)))
        (mul d (qS v))
        (fst ord (add (mul a u) (bdot v)))
        (fst (snd ord) d (qS v) pd (hnn v))))
