sorted-phi : (t : List (List Word)) → (f : List (List Word) → Word) → FinRank t f → (l : List (El entry-ord)) →
             ((e : El entry-ord) → MemKey {entry-ord} e l → MemKey {suffix-ord} (fst e) (sufs t)) → Sorted {entry-ord} l → Sorted {PO} (list-map (phi f) l)
sorted-phi t f fin l =
  case l return λ w → ((e : El entry-ord) → MemKey {entry-ord} e w → MemKey {suffix-ord} (fst e) (sufs t)) → Sorted {entry-ord} w → Sorted {PO} (list-map (phi f) w) of
    nil → λ hm s → unit
    cons x q → λ hm s → ( allle-phi t f fin x q (hm x (mem-head {entry-ord} x q)) (λ e m → hm e (mem-cons-r {entry-ord} e x q m)) (fst s)
                         , rec q (λ e m → hm e (mem-cons-r {entry-ord} e x q m)) (snd s))
