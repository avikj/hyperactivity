ge-lem-mk-not : (env : Nat → Bool) → (a : GuardExpr) → ge-eval env (ge-mk-not a) ≡ bfm-notB (ge-eval env a)
ge-lem-mk-not env (ge-k b)       = refl
ge-lem-mk-not env (ge-v i)       = refl
ge-lem-mk-not env (ge-not a)     = bfm-sym (bfm-lem-not-not (ge-eval env a))
ge-lem-mk-not env (ge-and a1 a2) = refl
ge-lem-mk-not env (ge-ite c t f) = refl
