b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10482 = xs in scmd (w-load ((b2-a mm_ a_10482))) (λ x_10481 → let mm_10483 = b2-dep mm_ x_10481 in let n = x_10481 in if (%weq j n) then (kq_ (h4-depl mm_10483 (h))) else (let a_10485 = xs in let j_10486 = j in scmd (w-load ((b2-a mm_10483 (%wadd a_10485 (%wsucc j_10486))))) (λ x_10484 → let mm_10487 = b2-dep mm_10483 x_10484 in let x = x_10484 in b2-tapp mm_10487 bk h x #0 (λ h2 → let mm_10488 = b2-dep mm_10487 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10488 b2-ERR)) else (b2-applyall mm_10488 f bk h2 xs (%wsucc j) kq_)))))
