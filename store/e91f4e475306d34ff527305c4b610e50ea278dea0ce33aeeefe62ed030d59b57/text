b2-nstr : Word → Word → (Word → Step W Word) → Step W Word
b2-nstr mm_ id kq_ =
  scmd (w-load ((b2-HIDS mm_))) (λ ids → let mm_332 = b2-dep mm_ ids in let v_335 = ids in let j_336 = (%wsub id #1) in scmd (w-load ((b2-a mm_332 (%wadd v_335 #2)))) (λ d_334 → let mm_337 = b2-dep mm_332 d_334 in scmd (w-load ((b2-a mm_337 (%wadd d_334 (%wsucc j_336))))) (λ x_333 → let mm_338 = b2-dep mm_337 x_333 in let r = x_333 in let i_340 = r in scmd (w-load ((b2-a mm_338 i_340))) (λ x_339 → let mm_341 = b2-dep mm_338 x_339 in let s = x_339 in kq_ (h4-depl mm_341 (s))))))
