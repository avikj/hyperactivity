-- CALL: a reference expanded into a fresh copy of its definition (or, a safe one meeting a
-- duplicator, copied as itself: HVM2's copy optimization)
hv2-call : List Hv2Def → Hv2Net → Word → Word → Hv2Net
hv2-call book net a b =
  let d = hv2-def-at (%wand (hv2-val a) #268435455) book
  in if andB (hv2d-safe d) (%weq (hv2-tag b) hv2-DUP) then hv2-eras net a b
     else hv2-call-def d net b
