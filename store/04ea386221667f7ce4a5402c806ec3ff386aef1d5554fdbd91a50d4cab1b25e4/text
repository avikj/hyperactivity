-- (5) Abstract Sylvester Law of Inertia soundness lemma + instantiation on qgm-H-full at -1/4:
--     any valid orthogonal witness vs for (4 * qgm-H-full + I) MUST exhibit exactly 1 negative direction.
qgc-sound-of : (n : Nat) → (s : it-sym ZrC n) → (ws : List (sy-vn ZrC n)) → (k : Nat) →
  inertia-cert n s ws ≡ (k , true) →
  (vs : List (sy-vn ZrC n)) → snd (inertia-cert n s vs) ≡ true → k ≡ fst (inertia-cert n s vs)
qgc-sound-of n s ws k h vs hv = concat (sym (λ i → fst (h i))) (inertia-cert-sound n s ws vs (λ i → snd (h i)) hv)
