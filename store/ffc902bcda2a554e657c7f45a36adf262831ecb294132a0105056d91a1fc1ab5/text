fl-metal-src : List Word
fl-metal-src =
  fl-ln "#include <metal_stdlib>"
  (fl-ln "using namespace metal;"
  (fl-ln "// Proved associative ValMon = (need, give) from lib/ir/flow-lang.hypercubical (fl-thm-mon-assoc)"
  (fl-ln "struct ValMon { uint need; uint give; };"
  (fl-ln "inline ValMon vm_comp(ValMon a, ValMon b) {"
  (fl-ln "  if (a.give <= b.need) return { a.need + (b.need - a.give), b.give };"
  (fl-ln "  return { a.need, (a.give - b.need) + b.give };"
  (fl-ln "}"
  (fl-ln "kernel void flow_parallel_valence_scan("
  (fl-ln "  device const uchar* toks [[buffer(0)]],"
  (fl-ln "  device ValMon* block_out [[buffer(1)]],"
  (fl-ln "  constant uint& chunk_len [[buffer(2)]],"
  (fl-ln "  uint gid [[thread_position_in_grid]]) {"
  (fl-ln "  uint base = gid * chunk_len;"
  (fl-ln "  ValMon acc = { 0u, 0u };"
  (fl-ln "  for (uint i = 0; i < chunk_len; i++) {"
  (fl-ln "    uchar t = toks[base + i];"
  (fl-ln "    // 0=lit(0,1), 1=unary(1,1), 2=binop(2,1), 3=ifz(3,1), 4=prose_word(0,0)"
  (fl-ln "    ValMon v = (t == 4u) ? ValMon{0u, 0u} : ValMon{(uint)t, 1u};"
  (fl-ln "    acc = vm_comp(acc, v);"
  (fl-ln "  }"
  (fl-ln "  block_out[gid] = acc;"
  (fl-ln "}" nil))))))))))))))))))))))
