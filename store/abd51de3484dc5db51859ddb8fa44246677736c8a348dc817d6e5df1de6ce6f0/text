-- the literal's text (src/ast.rs parse_numb_lit: letters, digits, + - .)
hv2-tokc : Word → Bool
hv2-tokc c =
  if andB (%wlt #47 c) (%wlt c #58) then true
  else if andB (%wlt #64 c) (%wlt c #91) then true
  else if andB (%wlt #96 c) (%wlt c #123) then true
  else if %weq c #43 then true else if %weq c #45 then true else %weq c #46
