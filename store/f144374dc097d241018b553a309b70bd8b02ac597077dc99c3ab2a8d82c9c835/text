-- O(27) Tree-Cotree Gauss Solver on 3D K_4 at cutoff B = 1:
-- Cotree triangle edges (e3, e4, e5) range over [-1, 0, +1]; tree star edges (e0, e1, e2) are UNIQUELY
-- determined by Gauss's law at vertices 1, 2, 3: e0 = e3-e5-q1, e1 = e4-e3-q2, e2 = e5-e4-q3!
tc-le1 : BZ → Bool
tc-le1 x = not (sc-bin-lt bin-one (snd x))
