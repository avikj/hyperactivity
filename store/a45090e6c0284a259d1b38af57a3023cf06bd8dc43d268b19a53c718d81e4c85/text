e-gloss-via : List (List Word) → List ERow → ERow → Proc W (List Word × List (List (List Word) × ERow))
e-gloss-via m nil row = e-gloss-base row
e-gloss-via m (cons r rs) row = if e-only-en (e-rc r) then e-gloss-base row else
  bind (e-gloss-base r) (λ gh → ret (list-append (e-m (toNat #3) m) (list-append ": " (fst gh)) , cons (m , r) (snd gh)))
