b2-nlcount mm_ zero s j e cnt ls kq_ =
  kq_ (h4-depl mm_ (cnt))
b2-nlcount mm_ (suc f) s j e cnt ls kq_ =
  if (%weq j e) then (let a_13664 = cnt in let b_13665 = ls in let c_13666 = #0 in let n_13668 = #3 in scmd (w-load (mm_)) (λ at_13667 → let mm_13669 = b2-dep mm_ at_13667 in scmd (w-store (mm_13669) ((%wadd at_13667 n_13668))) (λ uu_13670 → let mm_13671 = hv2-u mm_13669 uu_13670 in let at_13663 = at_13667 in let i_13672 = at_13663 in let v_13673 = a_13664 in scmd (w-store ((b2-a mm_13671 i_13672)) (v_13673)) (λ uu_13674 → let mm_13675 = hv2-u mm_13671 uu_13674 in let i_13676 = (%wadd at_13663 #1) in let v_13677 = b_13665 in scmd (w-store ((b2-a mm_13675 i_13676)) (v_13677)) (λ uu_13678 → let mm_13679 = hv2-u mm_13675 uu_13678 in let i_13680 = (%wadd at_13663 #2) in let v_13681 = c_13666 in scmd (w-store ((b2-a mm_13679 i_13680)) (v_13681)) (λ uu_13682 → let mm_13683 = hv2-u mm_13679 uu_13682 in let r = at_13663 in kq_ (h4-depl mm_13683 (r)))))))) else (let a_13685 = s in let j_13686 = j in scmd (w-load ((b2-a mm_ (%wadd a_13685 (%wsucc j_13686))))) (λ x_13684 → let mm_13687 = b2-dep mm_ x_13684 in let c = x_13684 in if (%weq c #10) then (b2-nlcount mm_13687 f s (%wsucc j) e (%wsucc cnt) (%wsucc j) kq_) else (b2-nlcount mm_13687 f s (%wsucc j) e cnt ls kq_)))
