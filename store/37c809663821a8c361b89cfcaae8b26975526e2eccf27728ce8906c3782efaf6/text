    (cons "make -C `$DIR` -j`$JOBS` build/cubical build/hx"
    (cons nil
    (cons "echo `[2/3] Deploying Decentralized HXSV Hypernet Mesh + Bare-Metal ARM64 HyperOS + Vision Pro OTA...`"
    (cons "(CDPATH= cd -- `$DIR` && ./build/hx deploy all)"
    (cons nil
    (cons "echo `[3/3] Launching local Hyperactivity Cockpit & Pool Server on :$PORT...`"
    (cons "if [ `$OS` = `Darwin` ]; then"
    (cons "  LA=`$HOME/Library/LaunchAgents`"
    (cons "  mkdir -p `$LA`"
    (cons "  cat > `$LA/ai.hyperactivity.server.plist` <<PLIST"
    (cons "<?xml version=`1.0` encoding=`UTF-8`?>"
    nil))))))))))))))))))))))
