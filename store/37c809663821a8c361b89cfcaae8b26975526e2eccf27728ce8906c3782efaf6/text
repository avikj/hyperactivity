s-install-sh-q1 : List Word
s-install-sh-q1 =
  s-lines-q
    (cons "if [ -d `$DIR/.git` ]; then"
    (cons "  git -C `$DIR` fetch --depth 1 origin && git -C `$DIR` pull --ff-only || true"
    (cons "elif command -v git >/dev/null 2>&1; then"
    (cons "  git clone --depth 1 `$REPO_URL` `$DIR`"
