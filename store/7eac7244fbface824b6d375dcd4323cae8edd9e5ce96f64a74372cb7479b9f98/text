-- Structured conditional & loop combinators (branch displacements derived structurally by l-count)
a64-if-cc : Word → Word → Lst Word → Lst Word → Lst Word
a64-if-cc _ neg-cc t-bs e-bs =
  if l-isnil e-bs
  then l-app (a64-bcond-skip neg-cc (l-count t-bs)) t-bs
  else (let tp = l-app t-bs (a64-b-skip (l-count e-bs))
        in xcat3 (a64-bcond-skip neg-cc (l-count tp)) tp e-bs)
