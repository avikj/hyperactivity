#!/usr/bin/env python3
# Generates the flat-memory HVM2 machine's interaction loop for lib/hvm2.hypercubical: every
# memory step written out as an inline scmd, so the emitted C has no closure per step.
import itertools, re, sys

cnt = itertools.count()
def fresh(p): return f"{p}{next(cnt)}"

def ld(addr, cont):
    v = fresh('v')
    return f"scmd (w-load ({addr})) (λ {v} →\n{cont(v)})"

def st(m, addr, val, cont):
    u = fresh('u'); m2 = fresh('m')
    return f"scmd (w-store ({addr}) ({val})) (λ {u} →\nlet {m2} = hv2-u {m} {u} in\n{cont(m2)})"

def push(m, off, region, x, y, cont):
    return ld(f"%wadd {m} #{off}", lambda t:
           st(m, f"{region} {m} {t}", f"hv2-pair ({x}) ({y})", lambda m1:
           st(m1, f"%wadd {m1} #{off}", f"%wsucc {t}", cont)))

def link(m, x, y, cont): return push(m, 48, "hr-lsa", x, y, cont)
def redex(m, x, y, cont): return push(m, 16, "hr-ba", x, y, cont)

def free(m, off, region, i, cont):
    return ld(f"%wadd {m} #{off}", lambda c:
           st(m, f"{region} {m} {c}", i, lambda m1:
           st(m1, f"%wadd {m1} #{off}", f"%wsucc {c}", cont)))

def free_node(m, i, cont): return free(m, 32, "hr-fna", i, cont)
def free_var(m, i, cont): return free(m, 40, "hr-fva", i, cont)

# take a node (or variable): the most recently freed, else a fresh one; no branch
def alloc(m, cntoff, freeoff, region, cont):
    return ld(f"%wadd {m} #{freeoff}", lambda c:
           ld(f"{region} {m} (%wsub {c} #1)", lambda tp:
           ld(f"%wadd {m} #{cntoff}", lambda nx:
           (lambda i:
             f"let {i} = if %weq {c} #0 then {nx} else {tp} in\n" +
             st(m, f"%wadd {m} #{freeoff}", f"if %weq {c} #0 then #0 else %wsub {c} #1", lambda m1:
             st(m1, f"%wadd {m1} #{cntoff}", f"if %weq {c} #0 then %wsucc {nx} else {nx}", lambda m2:
             cont(i, m2))))(fresh('i')))))

def alloc_node(m, cont): return alloc(m, 0, 32, "hr-fna", cont)
def alloc_var(m, cont): return alloc(m, 8, 40, "hr-fva", cont)

def GO(m): return f"hr-go f {m} book kd km"

def setvar(m, a1, b, done):
    # a1 := b; if a1's other occurrence had arrived, link what it held with b
    return ld(f"hr-va {m} (hv2-val {a1})", lambda old:
           st(m, f"hr-va {m} (hv2-val {a1})", f"%wsucc {b}", lambda m1:
           f"if %weq {old} #0 then {done(m1)}\nelse (" +
           st(m1, f"hr-va {m1} (hv2-val {a1})", "#0", lambda m2:
           free_var(m2, f"hv2-val {a1}", lambda m3:
           link(m3, f"%wsub {old} #1", b, done))) + ")"))

def link_step(m):
    def after_pop(lk):
        def body(m0):
            la, lb, sw, a1, b1 = fresh('la'), fresh('lb'), fresh('sw'), fresh('a'), fresh('b')
            s = (f"let {la} = hv2-fst {lk}\n    {lb} = hv2-snd {lk}\n"
                 f"    {sw} = andB (not (hv2-isvar {la})) (hv2-isvar {lb})\n"
                 f"    {a1} = if {sw} then {lb} else {la}\n    {b1} = if {sw} then {la} else {lb}\nin ")
            s += (f"if not (hv2-isvar {a1}) then (" + redex(m0, a1, b1, GO) + ")\n"
                  f"else if hv2-isvar {b1} then (" +
                  ld(f"hr-va {m0} (hv2-val {b1})", lambda vb:
                     f"if %weq {vb} #0 then (" + setvar(m0, a1, b1, GO) + ")\nelse (" +
                     st(m0, f"hr-va {m0} (hv2-val {b1})", "#0", lambda m2:
                     free_var(m2, f"hv2-val {b1}", lambda m3:
                     link(m3, a1, f"%wsub {vb} #1", GO))) + ")") + ")\n"
                  f"else (" + setvar(m0, a1, b1, GO) + ")")
            return s
        return body
    return lambda lt: ld(f"hr-lsa m (%wsub {lt} #1)", lambda lk:
                      st("m", "%wadd m #48", f"%wsub {lt} #1", after_pop(lk)))

def eras(m, a, b):
    return ld(f"hr-na {m} (hv2-val {b})", lambda w:
           free_node(m, f"hv2-val {b}", lambda m0:
           link(m0, a, f"hv2-fst {w}", lambda m1:
           link(m1, a, f"hv2-snd {w}", GO))))

def anni(m, a, b):
    return ld(f"hr-na {m} (hv2-val {a})", lambda wa:
           ld(f"hr-na {m} (hv2-val {b})", lambda wb:
           free_node(m, f"hv2-val {a}", lambda m0:
           free_node(m0, f"hv2-val {b}", lambda m1:
           link(m1, f"hv2-fst {wa}", f"hv2-fst {wb}", lambda m2:
           link(m2, f"hv2-snd {wa}", f"hv2-snd {wb}", GO))))))

def comm(m, a, b):
    def nodes(m1, ns):
        if len(ns) < 4:
            return alloc_node(m1, lambda i, m2: nodes(m2, ns + [i]))
        return vars_(m1, ns, [])
    def vars_(m1, ns, vs):
        if len(vs) < 4:
            return alloc_var(m1, lambda i, m2: vars_(m2, ns, vs + [i]))
        x = [f"hv2-port hv2-VAR {v}" for v in vs]
        n0, n1, n2, n3 = ns
        return st(m1, f"hr-na {m1} {n0}", f"hv2-pair ({x[0]}) ({x[1]})", lambda s1:
               st(s1, f"hr-na {s1} {n1}", f"hv2-pair ({x[2]}) ({x[3]})", lambda s2:
               st(s2, f"hr-na {s2} {n2}", f"hv2-pair ({x[0]}) ({x[2]})", lambda s3:
               st(s3, f"hr-na {s3} {n3}", f"hv2-pair ({x[1]}) ({x[3]})", lambda s4:
               link(s4, f"hv2-port (hv2-tag {b}) {n0}", f"hv2-fst {WA}", lambda q1:
               link(q1, f"hv2-port (hv2-tag {b}) {n1}", f"hv2-snd {WA}", lambda q2:
               link(q2, f"hv2-port (hv2-tag {a}) {n2}", f"hv2-fst {WB}", lambda q3:
               link(q3, f"hv2-port (hv2-tag {a}) {n3}", f"hv2-snd {WB}", GO))))))))
    def go(wa, wb):
        global WA, WB
        WA, WB = wa, wb
        return free_node(m, f"hv2-val {a}", lambda m0:
               free_node(m0, f"hv2-val {b}", lambda m1: nodes(m1, [])))
    return ld(f"hr-na {m} (hv2-val {a})", lambda wa:
           ld(f"hr-na {m} (hv2-val {b})", lambda wb: go(wa, wb)))

def oper(m, a, b):
    return ld(f"hr-na {m} (hv2-val {b})", lambda w:
           free_node(m, f"hv2-val {b}", lambda m0:
           f"if %weq (hv2-tag (hv2-fst {w})) hv2-NUM\nthen (" +
           link(m0, f"hv2-port hv2-NUM (hv2-operate (hv2-val {a}) (hv2-val (hv2-fst {w})))", f"hv2-snd {w}", GO) +
           ")\nelse (" +
           alloc_node(m0, lambda n0, m1:
             st(m1, f"hr-na {m1} {n0}", f"hv2-pair {a} (hv2-snd {w})", lambda m2:
             link(m2, f"hv2-fst {w}", f"hv2-port hv2-OPR {n0}", GO))) + ")"))

def swit(m, a, b):
    era = "hv2-port hv2-ERA #0"
    return ld(f"hr-na {m} (hv2-val {b})", lambda w:
           free_node(m, f"hv2-val {b}", lambda m0:
           f"if %weq (hv2-u24 (hv2-val {a})) #0\nthen (" +
           alloc_node(m0, lambda n0, m1:
             st(m1, f"hr-na {m1} {n0}", f"hv2-pair (hv2-snd {w}) ({era})", lambda m2:
             link(m2, f"hv2-port hv2-CON {n0}", f"hv2-fst {w}", GO))) +
           ")\nelse (" +
           alloc_node(m0, lambda n0, m1:
           alloc_node(m1, lambda n1, m2:
             st(m2, f"hr-na {m2} {n0}", f"hv2-pair ({era}) (hv2-port hv2-CON {n1})", lambda m3:
             st(m3, f"hr-na {m3} {n1}",
                f"hv2-pair (hv2-port hv2-NUM (hv2-new hv2-TY-U24 (%wsub (hv2-u24 (hv2-val {a})) #1))) (hv2-snd {w})", lambda m4:
             link(m4, f"hv2-port hv2-CON {n0}", f"hv2-fst {w}", GO))))) + ")"))

def redex_step():
    def after(t):
        def popped(rx):
            def counted(mR):
                a0, b0, rt, sw, a, b, r, d = (fresh(x) for x in ['a', 'b', 'rt', 'sw', 'ra', 'rb', 'r', 'd'])
                s = (f"let {a0} = hv2-fst {rx}\n    {b0} = hv2-snd {rx}\n"
                     f"    {rt} = andB (%weq (hv2-tag {a0}) hv2-REF) (%weq {b0} hv2-root)\n"
                     f"    {sw} = andB (not {rt}) (%wlt (hv2-tag {b0}) (hv2-tag {a0}))\n"
                     f"    {a} = if {sw} then {b0} else {a0}\n    {b} = if {sw} then {a0} else {b0}\n"
                     f"    {r} = if {rt} then hv2-CALL else hv2-rule (hv2-tag {a}) (hv2-tag {b})\nin ")
                s += (f"if %weq {r} hv2-LINK then (" + link(mR, a, b, GO) + ")\n"
                      f"else if %weq {r} hv2-CALL then (let {d} = hv2-def-at (%wand (hv2-val {a}) #268435455) book in\n"
                      f"  if %weq (hv2-tag {b}) hv2-DUP\n"
                      f"  then (if hv2d-safe {d} then (" + eras(mR, a, b) + ")\n"
                      f"        else hv2-err-clone {mR})\n"
                      f"  else hr-call-def {d} {mR} {b} (λ mc → hr-go f mc book kd km))\n"
                      f"else if %weq {r} hv2-VOID then {GO(mR)}\n"
                      f"else if %weq {r} hv2-ERAS then (" + eras(mR, a, b) + ")\n"
                      f"else if %weq {r} hv2-ANNI then (" + anni(mR, a, b) + ")\n"
                      f"else if %weq {r} hv2-COMM then (" + comm(mR, a, b) + ")\n"
                      f"else if %weq {r} hv2-OPER then (" + oper(mR, a, b) + ")\n"
                      f"else (" + swit(mR, a, b) + ")")
                return s
            return st("m", "%wadd m #16", f"%wsub {t} #1", lambda m1:
                   ld(f"%wadd {m1} #24", lambda it:
                   st(m1, f"%wadd {m1} #24", f"%wsucc {it}", counted)))
        return (f"if %weq {t} #0 then kd m\nelse (" +
                ld(f"hr-ba m (%wsub {t} #1)", popped) + ")")
    return ld("%wadd m #16", after)

go_body = ld("%wadd m #48", lambda lt:
    f"if %weq {lt} #0 then (" + redex_step() + ")\nelse (" + link_step("m")(lt) + ")")

# count parentheses for safety
def balanced(s): return s.count('(') == s.count(')')

out = []
out.append("""-- The interaction loop, one function: a step either performs one pending link (the stack at m+48,
-- links being how every rule connects its wires) or pops a redex and performs its rule; every
-- memory step is an inline load or store, and the loop calls itself in tail position, so no step
-- makes a closure (only a call, which places its definition in a loop of its own). The fuel is
-- the number of steps of a batch; kd is taken when no work is left, km when the fuel is spent.
hr-go : Nat → Word → List Hv2Def → (Word → Step W Word) → (Word → Step W Word) → Step W Word
hr-go zero m book kd km = km m
hr-go (suc f) m book kd km =
""")
body = go_body
assert balanced(body), (body.count('('), body.count(')'))
# indent continuation lines
out.append("  " + body.replace("\n", "\n  ") + "\n")
sys.stdout.write("".join(out))
