-- a language name written plainly before a mention (etym.py's bare): the text before it and the name
e-bare-f : Nat → List Word → Bool → List Word → Bool × (List Word × List Word)
e-bare-f zero acc at t = (false , (nil , nil))
e-bare-f (suc f) acc at nil = (false , (nil , nil))
e-bare-f (suc f) acc at (cons c r) =
  if andB at (e-bare-ok (cons c r)) then (true , (h-rev acc nil , e-strip (cons c r)))
  else e-bare-f f (cons c acc) (e-space c) r
