rqm-interf-zero : (A E : Type) → (z : A) → (ad mu : A → A → A) → (cj : A → A) → (ip : E → E → A) →
  ((x : A) → ad x z ≡ x) → ((x : A) → mu x z ≡ z) →
  (bs : List (A × E)) → RqmOrth A E z ip bs → rqm-interf A E z ad mu cj ip bs ≡ z
rqm-interf-zero A E z ad mu cj ip a0r m0r bs = case bs return λ l → RqmOrth A E z ip l → rqm-interf A E z ad mu cj ip l ≡ z of
  nil → λ h → refl
  cons b rest → λ h → rqm-tr3 A
    (ad (ad (rqm-row A E z ad mu cj ip (fst b) (snd b) rest) (rqm-col A E z ad mu cj ip (fst b) (snd b) rest)) (rqm-interf A E z ad mu cj ip rest))
    (ad (ad z z) z)
    (ad z z)
    z
    (λ i → ad (ad (rqm-row-zero A E z ad mu cj ip a0r m0r (fst b) (snd b) rest (fst h) i) (rqm-col-zero A E z ad mu cj ip a0r m0r (fst b) (snd b) rest (fst h) i)) (rqm-interf-zero A E z ad mu cj ip a0r m0r rest (snd h) i))
    (λ i → ad (a0r z i) z)
    (a0r z)
