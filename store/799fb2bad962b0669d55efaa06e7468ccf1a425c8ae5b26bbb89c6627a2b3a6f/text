          word-le (round-f t h0 r inv s) (round-f t h0 r inv s') ≡ leq {suffix-ord} (take-n (plus (suc h0) (suc h0)) s) (take-n (plus (suc h0) (suc h0)) s')
round-p t h0 r inv s s' m m' = concat (round-rank t h0 r inv s s' m') (round-key t h0 r inv s s' m m')
