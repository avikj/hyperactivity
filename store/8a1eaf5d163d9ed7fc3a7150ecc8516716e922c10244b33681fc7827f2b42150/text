-- 3. Coupled Eigenmode + Bilinear State-Space Step Spec (8 muls) vs Gauss-Factored Superopt Impl (4 muls, -50%!)
vx-eigen-spec : RProg
vx-eigen-spec =
  rprog #8 nil
    (cons (re-add (re-add (re-mul (re-v #0) (re-v #2)) (re-mul (re-v #0) (re-v #3)))
                  (re-add (re-mul (re-v #1) (re-v #2)) (re-mul (re-v #1) (re-v #3))))
    (cons (re-sub (re-mul (re-v #4) (re-v #6)) (re-mul (re-v #5) (re-v #7)))
    (cons (re-add (re-mul (re-v #4) (re-v #7)) (re-mul (re-v #5) (re-v #6))) nil)))
