b2-fget mm_ zero v at mx line acc kq_ =
  kq_ (h4-depl mm_ ((hv2-rev acc)))
b2-fget mm_ (suc f) v at mx line acc kq_ =
  let v_15299 = v in scmd (w-load ((b2-a mm_ v_15299))) (λ x_15298 → let mm_15300 = b2-dep mm_ x_15298 in let n = x_15298 in if (orB (%weq mx #0) (not (%wlt at n))) then (kq_ (h4-depl mm_15300 ((hv2-rev acc)))) else (let v_15303 = v in let j_15304 = at in scmd (w-load ((b2-a mm_15300 (%wadd v_15303 #2)))) (λ d_15301 → let mm_15305 = b2-dep mm_15300 d_15301 in scmd (w-load ((b2-a mm_15305 (%wadd d_15301 (%wsucc j_15304))))) (λ x_15302 → let mm_15306 = b2-dep mm_15305 x_15302 in let x = x_15302 in if (andB line (%weq x #10)) then (kq_ (h4-depl mm_15306 ((hv2-rev (cons x acc))))) else (b2-fget mm_15306 f v (%wsucc at) (%wsub mx #1) line (cons x acc) kq_)))))
