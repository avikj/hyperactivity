-- Generic 4-atom 1,3-prototropic shift builder X0=Y1-Z2-H3 <-> H3-X0-Y1=Z2 for arbitrary Z = [z0, z1, z2, 1]:
taut-13shift-L : Nat → Nat → Nat → RxnGraph
taut-13shift-L z0 z1 z2 =
  (rxn-l4 Nat z0 z1 z2 1 ,
   rxn-l4 (List Nat)
     (rxn-l4 Nat 0 2 0 0) (rxn-l4 Nat 2 0 1 0) (rxn-l4 Nat 0 1 0 1) (rxn-l4 Nat 0 0 1 0))
