boc-feistel-enc : Word → Word
boc-feistel-enc x =
  let l0 = %wand (%wshr x #16) #65535
      r0 = %wand x #65535
      l1 = r0
      r1 = %wxor l0 (boc-rf16 #40503 r0)
      l2 = r1
      r2 = %wxor l1 (boc-rf16 #31161 r1)
      l3 = r2
      r3 = %wxor l2 (boc-rf16 #42435 r2)
      l4 = r3
      r4 = %wxor l3 (boc-rf16 #40727 r3)
  in %wor (%wshl l4 #16) r4
