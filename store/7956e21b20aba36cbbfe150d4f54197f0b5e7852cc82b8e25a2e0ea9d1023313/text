-- Order laws for Rump-Gershgorin positive definiteness:
ScOrd : (A : Type) → A → (A → A → A) → (A → A → A) → (A → Type) → (A → Type) → Type
ScOrd A z add mul Pos Nonneg =
  Nonneg z ×
  (((x : A) → Nonneg (mul x x)) ×
  (((x y : A) → Nonneg x → Nonneg y → Nonneg (mul x y)) ×
  (((x y : A) → Nonneg x → Nonneg y → Nonneg (add x y)) ×
  (((x y : A) → Nonneg x → Pos y → Pos (add x y)) ×
  (((x y : A) → Pos x → Pos y → Pos (mul x y)) ×
  ((x y : A) → Pos x → Pos (mul x y) → Pos y))))))
