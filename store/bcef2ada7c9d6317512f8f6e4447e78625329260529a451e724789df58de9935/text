  canvas.width = r.width * dpr;
  canvas.height = r.height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
window.addEventListener('resize', resize);
resize();

function screenToWorld(sx, sy) {
  const r = canvas.getBoundingClientRect();
  return {
    x: (sx - r.width / 2) / cam.zoom - cam.x,
    y: (sy - r.height / 2) / cam.zoom - cam.y
  };
}

function loadPreset(preset) {
  stopPlay();
  currentPreset = preset;
  nextId = 1;
  net = new Net();
  cam = { x: 0, y: 0, zoom: 1 };
  preset.build(net, 0, 0);

  document.getElementById('presetKicker').textContent = preset.kicker;
  document.getElementById('presetExpr').textContent = preset.expr;
  document.getElementById('presetDesc').textContent = preset.desc;
  document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b.dataset.id === preset.id));
  document.getElementById('kanBox').classList.toggle('show', !!net.kanMode);
  updateHUD();
}

function updateHUD() {
  const active = net.activePairs();
  document.getElementById('mWork').textContent = net.work;
  document.getElementById('mDepth').textContent = net.depth;
  document.getElementById('mPar').textContent = net.depth > 0 ? (net.work / net.depth).toFixed(2) : '—';
  document.getElementById('mActive').textContent = active.length;
  const st = document.getElementById('mState');
  if (active.length === 0) {
    st.textContent = 'NORMAL ≡';
    st.className = 'mv ok';
  } else {
    st.textContent = playing ? 'RUNNING' : 'ACTIVE';
    st.className = 'mv pink';
  }
  document.getElementById('traceCount').textContent = `${net.work} step${net.work === 1 ? '' : 's'}`;
  const log = document.getElementById('traceLog');
  log.innerHTML = net.trace.map(t =>
    `<div class="trace-row"><span class="rule">#${t.step} ${t.rule}</span><span class="ratio">${t.ratio.split('·')[0]}</span></div>`
  ).join('');
}

// Force-directed relaxation keeping wires taut and non-overlapping
function stepPhysics() {
  const cells = [...net.cells.values()];
  for (let i = 0; i < cells.length; i++) {
    const a = cells[i];
    a.age += 0.04;
    for (let j = i + 1; j < cells.length; j++) {
      const b = cells[j];
      let dx = b.x - a.x, dy = b.y - a.y;
      let d2 = dx * dx + dy * dy + 0.01;
      let d = Math.sqrt(d2);
      if (d < 220) {
        const f = 3200 / d2;
        const fx = (dx / d) * f, fy = (dy / d) * f;
        if (!a.fixed && a !== dragCell) { a.vx -= fx; a.vy -= fy; }
        if (!b.fixed && b !== dragCell) { b.vx += fx; b.vy += fy; }
      }
    }
  }
  // Wire springs
  for (const c of cells) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p];
      if (!ep || ep.cell <= c.id) continue;
      const o = net.cells.get(ep.cell);
      if (!o) continue;
      const dx = o.x - c.x, dy = o.y - c.y;
      const d = Math.sqrt(dx * dx + dy * dy) + 0.01;
      const target = (p === 0 && ep.port === 0) ? 92 : 108;
      const f = (d - target) * 0.045;
      const fx = (dx / d) * f, fy = (dy / d) * f;
      if (!c.fixed && c !== dragCell) { c.vx += fx; c.vy += fy; }
      if (!o.fixed && o !== dragCell) { o.vx -= fx; o.vy -= fy; }
    }
  }
  // Gentle gravity towards center y-flow
  for (const c of cells) {
    if (c.fixed || c === dragCell) { c.vx = 0; c.vy = 0; continue; }
    c.vx *= 0.82; c.vy *= 0.82;
    c.x += Math.max(-14, Math.min(14, c.vx));
    c.y += Math.max(-14, Math.min(14, c.vy));
  }
}

function portPos(c, pIdx) {
  const n = c.ports.length;
  if (pIdx === 0) {
    // Principal port points toward connected partner if available, else up/down
    const ep = c.ports[0];
    if (ep && net.cells.has(ep.cell)) {
      const o = net.cells.get(ep.cell);
      const ang = Math.atan2(o.y - c.y, o.x - c.x);
      return { x: c.x + Math.cos(ang) * 26, y: c.y + Math.sin(ang) * 26, ang };
    }
    return { x: c.x, y: c.y - 26, ang: -Math.PI / 2 };
  }
  // Auxiliary ports fanned cleanly opposite the principal port
  const p0 = portPos(c, 0);
  const baseAng = p0.ang + Math.PI;
  const auxCount = n - 1;
  const spread = auxCount === 1 ? 0 : 0.72;
  const offset = auxCount === 1 ? 0 : ((pIdx - 1) / (auxCount - 1) - 0.5) * 2 * spread;
  const ang = baseAng + offset;
  return { x: c.x + Math.cos(ang) * 24, y: c.y + Math.sin(ang) * 24, ang };
}

function draw() {
  animTime += 0.03;
  stepPhysics();

  const r = canvas.getBoundingClientRect();
  const W = r.width, H = r.height;
  const isLight = document.documentElement.classList.contains('light');
  const ink = isLight ? '#000000' : '#ffffff';
  const muted = isLight ? '#888888' : '#555555';
  const gridCol = isLight ? 'rgba(0,0,0,0.045)' : 'rgba(255,255,255,0.045)';

  ctx.clearRect(0, 0, W, H);

  // Subtle architectural grid
  const gs = 40 * cam.zoom;
  ctx.strokeStyle = gridCol;
  ctx.lineWidth = 1;
  const ox = ((W / 2 + cam.x * cam.zoom) % gs + gs) % gs;
  const oy = ((H / 2 + cam.y * cam.zoom) % gs + gs) % gs;
  ctx.beginPath();
  for (let x = ox; x < W; x += gs) { ctx.moveTo(x, 0); ctx.lineTo(x, H); }
  for (let y = oy; y < H; y += gs) { ctx.moveTo(0, y); ctx.lineTo(W, y); }
  ctx.stroke();

  ctx.save();
  ctx.translate(W / 2, H / 2);
  ctx.scale(cam.zoom, cam.zoom);
  ctx.translate(cam.x, cam.y);

  // 1. Draw wires
  const activeSet = new Set(net.activePairs().map(p => `${Math.min(p.op.id, p.val.id)}-${Math.max(p.op.id, p.val.id)}`));
  for (const c of net.cells.values()) {
    for (let p = 0; p < c.ports.length; p++) {
      const ep = c.ports[p];
      if (!ep) continue;
      // Self-loop (e.g. identity lambda param -> body)
      if (ep.cell === c.id && p < ep.port) {
        const a = portPos(c, p), b = portPos(c, ep.port);
        const mx = (a.x + b.x) / 2 + (a.x - c.x) * 1.1;
        const my = (a.y + b.y) / 2 + (a.y - c.y) * 1.1;
        ctx.strokeStyle = muted;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.quadraticCurveTo(mx, my, b.x, b.y);
        ctx.stroke();
        continue;
      }
      if (ep.cell <= c.id) continue;
      const o = net.cells.get(ep.cell);
      if (!o) continue;
      const a = portPos(c, p), b = portPos(o, ep.port);
      const key = `${Math.min(c.id, o.id)}-${Math.max(c.id, o.id)}`;
      const isActive = (p === 0 && ep.port === 0 && activeSet.has(key));
      const isHover = hoveredPair && ((hoveredPair.op.id === c.id && hoveredPair.val.id === o.id) || (hoveredPair.op.id === o.id && hoveredPair.val.id === c.id));

      if (isActive) {
        // High-voltage electric-pink standing wave!
        ctx.save();
        ctx.strokeStyle = '#ff0a94';
        ctx.lineWidth = isHover ? 5 : 3.2;
        ctx.shadowColor = '#ff0a94';
        ctx.shadowBlur = isHover ? 18 : 10;
        ctx.beginPath();
        const steps = 18;
        const dx = b.x - a.x, dy = b.y - a.y;
        const len = Math.sqrt(dx * dx + dy * dy) || 1;
        const nx = -dy / len, ny = dx / len;
        for (let s = 0; s <= steps; s++) {
          const t = s / steps;
          const env = Math.sin(t * Math.PI);
          const wave = Math.sin(t * Math.PI * 3 + animTime * 5) * 4.5 * env;
          const px = a.x + dx * t + nx * wave;
          const py = a.y + dy * t + ny * wave;
          if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();

        // Principal port sparks ●═══●
        ctx.fillStyle = '#ff0a94';
        ctx.beginPath(); ctx.arc(a.x, a.y, 4.5, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(b.x, b.y, 4.5, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      } else {
        ctx.strokeStyle = isLight ? '#222222' : '#7a7a7a';
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }
  }

  // 2. Draw shockwaves & pulses
  for (let i = net.sparks.length - 1; i >= 0; i--) {
    const sp = net.sparks[i];
    sp.r += 4.2;
    sp.alpha -= 0.045;
    if (sp.alpha <= 0) { net.sparks.splice(i, 1); continue; }
    ctx.save();
    ctx.strokeStyle = sp.color;
    ctx.globalAlpha = sp.alpha;
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.arc(sp.x, sp.y, sp.r, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
  }

  // 3. Draw cells with exact Polarity Geometry
  for (const c of net.cells.values()) {
    const scale = Math.min(1, 0.3 + c.age * 1.8);
    const p0 = portPos(c, 0);
    const isCubical = ['V_PLAM', 'V_IV', 'V_SYS', 'V_GLUE', 'V_GLUEV', 'O_PAPPP', 'O_SUBST', 'O_COMP', 'O_UNGLUE'].includes(c.kind);
    const accent = synMode ? synColorFor(c.label) : (isCubical ? '#ffd400' : (c.polarity === 'val' ? '#ff0a94' : '#00e5ff'));

    ctx.save();
    ctx.translate(c.x, c.y);
    ctx.scale(scale, scale);

    if (c.polarity === 'root') {
      // Stark observer terminal
      ctx.fillStyle = isLight ? '#000' : '#fff';
      ctx.fillRect(-34, -15, 68, 30);
      ctx.fillStyle = isLight ? '#fff' : '#000';
      ctx.font = '800 11px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('OUT', 0, 1);
    } else if (c.polarity === 'val') {
      // VALUE (V_*): Positive outward-pointing geometric prism/triangle/diamond
      ctx.save();
      ctx.rotate(p0.ang + Math.PI / 2);
      ctx.beginPath();
      if (isCubical) {
        // Cubical diamond prism
        ctx.moveTo(0, -28); ctx.lineTo(26, 0); ctx.lineTo(0, 26); ctx.lineTo(-26, 0);
      } else {
        // Sharp upward chevron prism (principal port at apex!)
        ctx.moveTo(0, -28); ctx.lineTo(27, 20); ctx.lineTo(-27, 20);
      }
      ctx.closePath();
      ctx.fillStyle = isLight ? '#fff0f8' : '#140410';
      ctx.fill();
      ctx.lineWidth = hoveredCell === c ? 3.5 : 2.2;
      ctx.strokeStyle = accent;
      ctx.stroke();
      ctx.restore();

      // Label
      ctx.fillStyle = ink;
      ctx.font = '800 13px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(c.label, 0, -2);
      if (c.sub) {
        ctx.fillStyle = accent;
        ctx.font = '600 9.5px ui-monospace, Menlo, monospace';
        ctx.fillText(c.sub, 0, 12);
      }
    } else {
      // OPERATION (O_*): Negative notched square socket (principal port is a sharp V-notch!)
      ctx.save();
      ctx.rotate(p0.ang + Math.PI / 2);
      ctx.beginPath();
      ctx.moveTo(-25, -22);
      ctx.lineTo(-8, -22);
      ctx.lineTo(0, -12); // concave consumer notch at principal port!
      ctx.lineTo(8, -22);
      ctx.lineTo(25, -22);
      ctx.lineTo(25, 22);
      ctx.lineTo(-25, 22);
      ctx.closePath();
      ctx.fillStyle = isLight ? '#f4f4f4' : '#0a0a0c';
      ctx.fill();
      ctx.lineWidth = hoveredCell === c ? 3.5 : 2.2;
      ctx.strokeStyle = accent;
      ctx.stroke();
      ctx.restore();

      ctx.fillStyle = ink;
      ctx.font = '800 12px ui-monospace, Menlo, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(c.label, 0, -1);
      if (c.sub) {
        ctx.fillStyle = accent;
        ctx.font = '600 9px ui-monospace, Menlo, monospace';
        ctx.fillText(c.sub, 0, 12);
      }
    }
    ctx.restore();
  }

  ctx.restore();

  drawKanBox();
  drawScope();
  requestAnimationFrame(draw);
}

// Synchronized Kan Open-Box Geometric Visualizer
function drawKanBox() {
  if (!net.kanMode) return;
  const W = kanCanvas.width, H = kanCanvas.height;
  const isLight = document.documentElement.classList.contains('light');
  kctx.clearRect(0, 0, W, H);
  const p = net.kanProgress;
  document.getElementById('kanPhase').textContent = `j = ${p.toFixed(2)}`;
  document.getElementById('kanTitle').textContent =
    net.kanMode === 'univalence' ? 'GLUE / UA FIBER' :
    net.kanMode === 'path' ? 'INTERVAL I = [0,1]' : 'KAN OPEN BOX';

  const x0 = 66, x1 = W - 66, y0 = H - 48, y1 = 46;
  // Filled interior sweeping upward with j
  if (p > 0) {
    const curY = y0 - (y0 - y1) * p;
    kctx.fillStyle = 'rgba(255, 10, 148, 0.16)';
    kctx.fillRect(x0, curY, x1 - x0, y0 - curY);
  }
  // Left wall (i=0)
  kctx.strokeStyle = '#00e5ff'; kctx.lineWidth = 4;
  kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x0, y1); kctx.stroke();
  // Right wall (i=1)
  kctx.strokeStyle = '#ffd400'; kctx.lineWidth = 4;
  kctx.beginPath(); kctx.moveTo(x1, y0); kctx.lineTo(x1, y1); kctx.stroke();
  // Base (j=0)
  kctx.strokeStyle = isLight ? '#000' : '#fff'; kctx.lineWidth = 4;
  kctx.beginPath(); kctx.moveTo(x0, y0); kctx.lineTo(x1, y0); kctx.stroke();

  // Animated lid (j = p)
  const lidY = y0 - (y0 - y1) * p;
  kctx.strokeStyle = '#ff0a94';
  kctx.lineWidth = p >= 1 ? 5 : 3;
  kctx.setLineDash(p >= 1 ? [] : [8, 6]);
  kctx.beginPath(); kctx.moveTo(x0, lidY); kctx.lineTo(x1, lidY); kctx.stroke();
  kctx.setLineDash([]);

  // Labels
  kctx.font = '700 20px ui-monospace, Menlo, monospace';
  kctx.fillStyle = isLight ? '#000' : '#fff';
  kctx.textAlign = 'center';
  kctx.fillText(net.kanMode === 'univalence' ? 'true : Bool' : 'p(i)', W / 2, y0 + 28);
  kctx.fillStyle = '#00e5ff';
  kctx.fillText('i=0', x0 - 34, (y0 + y1) / 2);
  kctx.fillStyle = '#ffd400';
  kctx.fillText('i=1', x1 + 34, (y0 + y1) / 2);
  if (p >= 1) {
    kctx.fillStyle = '#ff0a94';
    kctx.fillText(net.kanMode === 'univalence' ? 'false : Bool' : 'p ∙ q', W / 2, y1 - 14);
  }
}

// Live Pythagorean Harmonic Oscilloscope
function drawScope() {
  const W = scopeCanvas.width, H = scopeCanvas.height;
  sctx.clearRect(0, 0, W, H);
  sctx.strokeStyle = '#ff0a94';
  sctx.lineWidth = 2.5;
  sctx.beginPath();
  if (audio.analyser && audio.enabled) {
    const buf = new Uint8Array(audio.analyser.frequencyBinCount);
    audio.analyser.getByteTimeDomainData(buf);
    for (let i = 0; i < buf.length; i++) {
      const x = (i / (buf.length - 1)) * W;
      const y = (buf[i] / 255) * H;
      if (i === 0) sctx.moveTo(x, y); else sctx.lineTo(x, y);
    }
  } else {
    sctx.moveTo(0, H / 2); sctx.lineTo(W, H / 2);
  }
  sctx.stroke();
}

// ============================================================================
// 6. POINTER INTERACTION (Click active pair to fire, drag cells, pan/zoom)
// ============================================================================
function findHit(wx, wy) {
  // Check active pairs first (segment hit)
  for (const pair of net.activePairs()) {
    const a = portPos(pair.op, 0), b = portPos(pair.val, 0);
    const dx = b.x - a.x, dy = b.y - a.y;
    const len2 = dx * dx + dy * dy + 0.01;
    const t = Math.max(0, Math.min(1, ((wx - a.x) * dx + (wy - a.y) * dy) / len2));
    const px = a.x + t * dx, py = a.y + t * dy;
    if (Math.hypot(wx - px, wy - py) < 16) return { type: 'pair', pair };
  }
  // Check cells
  for (const c of net.cells.values()) {
    if (Math.hypot(wx - c.x, wy - c.y) < 28) return { type: 'cell', cell: c };
  }
  return null;
}

canvas.addEventListener('pointermove', e => {
  const rect = canvas.getBoundingClientRect();
  const sx = e.clientX - rect.left, sy = e.clientY - rect.top;
  const w = screenToWorld(sx, sy);
  if (dragCell) {
    dragCell.x = w.x; dragCell.y = w.y;
    return;
  }
  if (panStart) {
    cam.x = panStart.cx + (e.clientX - panStart.x) / cam.zoom;
    cam.y = panStart.cy + (e.clientY - panStart.y) / cam.zoom;
    return;
  }
  const hit = findHit(w.x, w.y);
  const tip = document.getElementById('hoverTip');
  hoveredPair = hit && hit.type === 'pair' ? hit.pair : null;
  hoveredCell = hit && hit.type === 'cell' ? hit.cell : null;
  if (hoveredPair) {
    const info = net.describeRule(hoveredPair.op, hoveredPair.val);
    const pyth = PYTH[info.key] || PYTH.beta;
    canvas.style.cursor = 'pointer';
    tip.style.display = 'block';
    tip.innerHTML = `<div>ACTIVE PAIR: ${info.text}</div><div class="ht-sub">Click to fire this local step · ${pyth.name}</div>`;
  } else if (hoveredCell) {
    canvas.style.cursor = 'grab';
    tip.style.display = 'block';
    tip.innerHTML = `<div>${hoveredCell.kind} (${hoveredCell.label})</div><div class="ht-sub">polarity: ${hoveredCell.polarity} · ports: ${hoveredCell.ports.length} · drag to reposition</div>`;
  } else {
    canvas.style.cursor = 'grab';
    tip.style.display = 'none';
  }
});

canvas.addEventListener('pointerdown', e => {
  const rect = canvas.getBoundingClientRect();
  const w = screenToWorld(e.clientX - rect.left, e.clientY - rect.top);
  const hit = findHit(w.x, w.y);
  if (hit && hit.type === 'pair') {
    net.depth++;
    const info = net.firePair(hit.pair.op.id, hit.pair.val.id);
    if (info) audio.playRule(info.key, 0, 1);
    if (net.activePairs().length === 0) setTimeout(() => audio.playNormalForm(), 160);
    updateHUD();
    return;
  }
  if (hit && hit.type === 'cell') {
    dragCell = hit.cell;
    canvas.setPointerCapture(e.pointerId);
    return;
  }
  panStart = { x: e.clientX, y: e.clientY, cx: cam.x, cy: cam.y };
  canvas.setPointerCapture(e.pointerId);
});

canvas.addEventListener('pointerup', () => { dragCell = null; panStart = null; });
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  const factor = e.deltaY < 0 ? 1.1 : 0.91;
  cam.zoom = Math.max(0.35, Math.min(2.5, cam.zoom * factor));
}, { passive: false });

// ============================================================================
// 7. UI WIRING
// ============================================================================
const presetList = document.getElementById('presetList');
PRESETS.forEach(p => {
  const btn = document.createElement('button');
  btn.className = 'preset-btn';
  btn.dataset.id = p.id;
  btn.innerHTML = `<div class="pt"><span>${p.title}</span></div><div class="pe">${p.expr}</div>`;
  btn.onclick = () => loadPreset(p);
  presetList.appendChild(btn);
});

function stopPlay() {
  playing = false;
  if (playTimer) clearInterval(playTimer);
  playTimer = null;
  document.getElementById('btnPlay').textContent = '▶ Play';
  updateHUD();
}

document.getElementById('btnPlay').onclick = () => {
  if (playing) { stopPlay(); return; }
  if (net.activePairs().length === 0) loadPreset(currentPreset);
  playing = true;
  document.getElementById('btnPlay').textContent = '❚❚ Pause';
  updateHUD();
  const tick = () => {
    const fired = net.stepParallel();
    updateHUD();
    if (!fired || net.activePairs().length === 0) stopPlay();
  };
  tick();
  if (playing) playTimer = setInterval(tick, 680);
};

document.getElementById('btnStep').onclick = () => {
  stopPlay();
  net.stepParallel();
  updateHUD();
};
document.getElementById('btnReset').onclick = () => loadPreset(currentPreset);
document.getElementById('btnFit').onclick = () => { cam = { x: 0, y: 0, zoom: 1 }; };

document.getElementById('btnSound').onclick = function() {
  audio.enabled = !audio.enabled;
  this.textContent = audio.enabled ? '♫ Sound: ON' : '♫ Sound: OFF';
  this.classList.toggle('on', audio.enabled);
};
document.getElementById('tuningSel').onchange = function() {
  audio.baseHz = parseFloat(this.value);
};
document.getElementById('btnSyn').onclick = function() {
  synMode = !synMode;
  this.classList.toggle('on', synMode);
};
document.getElementById('btnTheme').onclick = () => {
  document.documentElement.classList.toggle('light');
};
document.addEventListener('keydown', e => {
  if (e.key === 's' || e.key === 'S') {
    synMode = !synMode;
    document.getElementById('btnSyn').classList.toggle('on', synMode);
  } else if (e.key === ' ') {
    e.preventDefault();
    document.getElementById('btnStep').click();
  }
});

// Deep-link preset support (?preset=univalence)
const qPreset = new URLSearchParams(location.search).get('preset');
const initial = PRESETS.find(p => p.id === qPreset) || PRESETS[0];
loadPreset(initial);
requestAnimationFrame(draw);
</script>
