<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Interaction Net Lab · Hyperactivity</title>
<meta name="description" content="Visual and Pythagorean harmonic cubical interaction net engine for hyperactivity.">
<style>
:root {
  --bg: #000000;
  --panel: #080808;
  --ink: #ffffff;
  --muted: #8a8a8a;
  --border: #2a2a2a;
  --border-hi: #ffffff;
  --pink: #ff0a94;
  --cyan: #00e5ff;
  --gold: #ffd400;
  --green: #00f900;
  --purple: #9e6eff;
  --val-fill: #160410;
  --op-fill: #0b0b0b;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
html.light {
  --bg: #ffffff;
  --panel: #fafafa;
  --ink: #000000;
  --muted: #666666;
  --border: #d4d4d4;
  --border-hi: #000000;
  --val-fill: #fff0f8;
  --op-fill: #f4f4f4;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}
::selection { background: var(--pink); color: #fff; }

/* Top nav matching hyperactivity.ai */
nav {
  height: 46px; display: flex; justify-content: space-between; align-items: center;
  padding: 0 22px; background: var(--bg); border-bottom: 2px solid var(--border-hi);
  font: 600 13px/1 var(--mono); letter-spacing: .04em; z-index: 10; position: relative;
}
nav a { color: var(--ink); text-decoration: none; }
nav a:hover, nav a.active { color: var(--pink); }
nav .mark { font-weight: 700; }
nav .links { display: flex; align-items: center; gap: 20px; }
nav .badge {
  border: 1.5px solid var(--pink); color: var(--pink); padding: 2px 7px;
  font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
}

/* Main workspace grid */
.workspace {
  display: grid;
  grid-template-columns: 280px 1fr;
  grid-template-rows: 1fr 62px;
  height: calc(100vh - 46px);
}

/* Left sidebar */
.sidebar {
  grid-row: 1 / 3;
  background: var(--panel);
  border-right: 2px solid var(--border-hi);
  display: flex; flex-direction: column;
  overflow: hidden;
}
.sec-head {
  padding: 10px 14px;
  font: 700 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase;
  color: var(--pink); border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
}
.presets {
  overflow-y: auto; border-bottom: 2px solid var(--border-hi);
  flex: 0 0 auto; max-height: 52%;
}
.preset-btn {
  display: block; width: 100%; text-align: left;
  background: transparent; color: var(--ink); border: 0;
  border-bottom: 1px solid var(--border);
  padding: 10px 14px; cursor: pointer;
  transition: background .1s, padding-left .1s;
}
.preset-btn:hover { background: rgba(255,10,148,.08); padding-left: 18px; }
.preset-btn.active {
  background: var(--pink); color: #fff;
}
.preset-btn .pt {
  font: 700 13px/1.25 var(--mono); display: flex; justify-content: space-between;
}
.preset-btn .pe {
  font: 400 11.5px/1.35 var(--mono); opacity: .78; margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.preset-btn.active .pe { opacity: .95; }

.legend {
  padding: 10px 14px; border-bottom: 1px solid var(--border);
  font: 500 11px/1.5 var(--mono); color: var(--muted);
  display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px;
}
.leg-item { display: flex; align-items: center; gap: 7px; color: var(--ink); }
.leg-swatch { width: 12px; height: 12px; display: inline-block; flex-shrink: 0; }
.sw-val { background: var(--pink); clip-path: polygon(50% 0%, 100% 100%, 0% 100%); }
.sw-op { border: 2px solid var(--cyan); background: transparent; }
.sw-act { background: var(--pink); height: 3px; box-shadow: 0 0 8px var(--pink); }
.sw-cub { background: var(--gold); clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }

.trace-wrap {
  flex: 1; display: flex; flex-direction: column; min-height: 0;
}
.trace {
  flex: 1; overflow-y: auto; padding: 8px 14px;
  font: 500 11px/1.55 var(--mono);
}
.trace-row {
  padding: 4px 0; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; gap: 8px;
}
.trace-row .rule { color: var(--ink); }
.trace-row .ratio { color: var(--pink); font-weight: 700; white-space: nowrap; }

/* Stage */
.stage {
  position: relative; overflow: hidden; background: var(--bg);
  cursor: grab;
}
.stage:active { cursor: grabbing; }
#netCanvas {
  display: block; width: 100%; height: 100%;
}

/* Floating HUD on canvas */
.stage-hud {
  position: absolute; top: 14px; left: 16px; right: 16px;
  pointer-events: none;
  display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;
}
.expr-card {
  pointer-events: auto;
  background: var(--bg); border: 2px solid var(--border-hi);
  padding: 10px 14px; max-width: 540px;
}
.expr-card .kicker {
  font: 700 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase;
  color: var(--pink); margin-bottom: 5px;
}
.expr-card .code {
  font: 700 15px/1.3 var(--mono); color: var(--ink);
}
.expr-card .desc {
  font: 400 12.5px/1.45 var(--sans); color: var(--muted); margin-top: 5px;
}

.metrics-card {
  pointer-events: auto;
  background: var(--bg); border: 2px solid var(--border-hi);
  padding: 8px 12px; display: flex; gap: 14px; align-items: center;
  font: 600 11.5px/1.2 var(--mono);
}
.metric { display: flex; flex-direction: column; gap: 2px; }
.metric .ml { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.metric .mv { font-size: 15px; font-weight: 800; color: var(--ink); }
.metric .mv.pink { color: var(--pink); }
.metric .mv.ok { color: var(--green); }

/* Tooltip for active pair / cell inspection */
.hover-tip {
  position: absolute; bottom: 14px; left: 16px;
  pointer-events: none;
  background: var(--bg); border: 2px solid var(--pink);
  padding: 8px 12px; font: 600 12px/1.4 var(--mono);
  display: none; max-width: 480px;
}
.hover-tip .ht-sub { color: var(--muted); font-weight: 400; font-size: 11px; margin-top: 2px; }

/* Synchronized Kan Box / Cubical Geometry panel */
.kan-box {
  position: absolute; bottom: 14px; right: 16px;
  background: var(--bg); border: 2px solid var(--border-hi);
  padding: 10px 12px; width: 224px; display: none;
}
.kan-box.show { display: block; }
.kan-box .kb-head {
  font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 8px; display: flex; justify-content: space-between;
}
#kanCanvas { display: block; width: 196px; height: 148px; }

/* Bottom control bar */
.controls {
  grid-column: 2;
  background: var(--panel);
  border-top: 2px solid var(--border-hi);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 16px; gap: 12px; overflow-x: auto;
}
.ctrl-group { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.btn {
  font: 700 12px/1 var(--mono); letter-spacing: .04em; text-transform: uppercase;
  background: var(--bg); color: var(--ink);
  border: 2px solid var(--border-hi); padding: 8px 13px; cursor: pointer;
  white-space: nowrap;
}
.btn:hover { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.primary { background: var(--pink); color: #fff; border-color: var(--pink); }
.btn.primary:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.btn.on { background: var(--ink); color: var(--bg); }

.scope-wrap {
  display: flex; align-items: center; gap: 10px;
  border: 1.5px solid var(--border); padding: 4px 10px; background: var(--bg);
}
#scopeCanvas { width: 110px; height: 28px; display: block; }
.ratio-readout {
  font: 700 11.5px/1.2 var(--mono); color: var(--pink); min-width: 118px;
}
.ratio-readout span { display: block; font-size: 9.5px; color: var(--muted); font-weight: 500; }

select.tuning {
  font: 600 11px var(--mono); background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--border); padding: 6px 8px; cursor: pointer;
}

@media (max-width: 820px) {
  .workspace { grid-template-columns: 1fr; grid-template-rows: auto 1fr 62px; }
  .sidebar { grid-row: 1; max-height: 180px; border-right: 0; border-bottom: 2px solid var(--border-hi); }
  .legend, .trace-wrap { display: none; }
  .controls { grid-column: 1; }
  .metrics-card { display: none; }
  nav .mark span { display: none; }
}
</style>
