<script>
// ============================================================================
// 1. AVIK'S EXACT SYNESTHESIA TABLE (docs/synesthesia.cub)
// ============================================================================
const SYN_COLORS = {
  a:'#ff2600', b:'#fffb00', c:'#00f900', d:'#945200', e:'#00f900', f:'#008f00',
  g:'#008f00', h:'#ffb6dc', i:'#0433ff', j:'#0433ff', k:'#942193', l:'#ffffff',
  m:'#ff2600', n:'#fffb00', o:'#87cefa', p:'#ffb6dc', q:'#d880c8', r:'#945200',
  s:'#fffb00', t:'#00f900', u:'#ffb6dc', v:'#fffb00', w:'#942193', x:'#942193',
  y:'#fffb00', z:'#ffffff',
  '0':'#ffffff', '1':'#ffffff', '2':'#87cefa', '3':'#ff9300', '4':'#fffb00',
  '5':'#0433ff', '6':'#ff2600', '7':'#00f900', '8':'#fffb00', '9':'#942193'
};
function synColorFor(label) {
  const ch = (label || 'h').toLowerCase().replace(/[^a-z0-9]/g, '')[0] || 'h';
  return SYN_COLORS[ch] || '#ff0a94';
}

// ============================================================================
// 2. PYTHAGOREAN "MUSIC OF THE SPHERES" HARMONIC ENGINE (Pure Just Intonation)
// ============================================================================
const PYTH = {
  beta:       { num: 3,   den: 2,   name: '3:2 · diapente (5th)',    wave: 'triangle' },
  proj:       { num: 4,   den: 3,   name: '4:3 · diatessaron (4th)', wave: 'sine' },
  dup:        { num: 2,   den: 1,   name: '2:1 · diapason (8ve)',    wave: 'triangle' },
  era:        { num: 1,   den: 2,   name: '1:2 · sub-octave',        wave: 'sine' },
  papp:       { num: 81,  den: 64,  name: '81:64 · ditone (3rd)',    wave: 'sine' },
  subst:      { num: 9,   den: 8,   name: '9:8 · epogdoon (tone)',   wave: 'sine' },
  comp:       { num: 27,  den: 16,  name: '27:16 · Kan filling',     wave: 'triangle' },
  unglue:     { num: 243, den: 128, name: '243:128 · univalence',    wave: 'sine' },
  normal:     { num: 1,   den: 1,   name: '1:1 · identity unison',   wave: 'sine' }
};

class PythagoreanAudio {
  constructor() {
    this.ctx = null;
    this.analyser = null;
    this.enabled = true;
    this.baseHz = 256;
    this.master = null;
  }
  init() {
    if (this.ctx) {
      if (this.ctx.state === 'suspended') this.ctx.resume();
      return;
    }
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    this.ctx = new AC();
    this.master = this.ctx.createGain();
    this.master.gain.value = 0.22;
    this.analyser = this.ctx.createAnalyser();
    this.analyser.fftSize = 256;
    this.master.connect(this.analyser);
    this.analyser.connect(this.ctx.destination);
  }
  playRule(ruleKey, voiceOffset = 0, totalVoices = 1) {
    const info = PYTH[ruleKey] || PYTH.beta;
    const ratio = info.num / info.den;
    // Slight harmonic octave lift for parallel voices so chords shimmer cleanly
    const oct = voiceOffset === 0 ? 1 : (voiceOffset % 2 === 1 ? 1.5 : 2);
    const freq = this.baseHz * ratio * (totalVoices > 1 ? Math.pow(9/8, voiceOffset % 3) : 1);
    document.getElementById('ratioReadout').innerHTML =
      `${info.name}<span>${freq.toFixed(1)} Hz · ${totalVoices > 1 ? totalVoices + '-voice chord' : 'local step'}</span>`;
    if (!this.enabled) return;
    this.init();
    if (!this.ctx) return;
    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const overtone = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    const g2 = this.ctx.createGain();

    osc.type = info.wave;
    overtone.type = 'sine';
    osc.frequency.setValueAtTime(freq, now);
    overtone.frequency.setValueAtTime(freq * 1.5, now); // pure 3:2 overtone

    if (ruleKey === 'era') {
      osc.frequency.exponentialRampToValueAtTime(Math.max(55, freq * 0.5), now + 0.28);
    } else if (ruleKey === 'papp' || ruleKey === 'comp') {
      osc.frequency.exponentialRampToValueAtTime(this.baseHz * 2, now + 0.35);
    }

    const peak = Math.min(0.45, 0.55 / Math.sqrt(Math.max(1, totalVoices)));
    g.gain.setValueAtTime(0.0001, now);
    g.gain.exponentialRampToValueAtTime(peak, now + 0.015);
    g.gain.exponentialRampToValueAtTime(0.0001, now + (ruleKey === 'normal' ? 1.1 : 0.42));

    g2.gain.setValueAtTime(0.0001, now);
    g2.gain.exponentialRampToValueAtTime(peak * 0.25, now + 0.02);
    g2.gain.exponentialRampToValueAtTime(0.0001, now + 0.24);

    osc.connect(g); overtone.connect(g2);
    g.connect(this.master); g2.connect(this.master);
    osc.start(now); overtone.start(now);
    osc.stop(now + (ruleKey === 'normal' ? 1.15 : 0.46));
    overtone.stop(now + 0.3);
  }
  playNormalForm() {
    this.playRule('normal', 0, 1);
    if (!this.enabled || !this.ctx) return;
    // Pure Pythagorean 1:1 + 3:2 + 2:1 identity resolution
    [1, 1.5, 2].forEach((r, idx) => {
      const now = this.ctx.currentTime + idx * 0.04;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(this.baseHz * r, now);
      g.gain.setValueAtTime(0.0001, now);
      g.gain.exponentialRampToValueAtTime(0.18 / (idx + 1), now + 0.03);
      g.gain.exponentialRampToValueAtTime(0.0001, now + 1.2);
      osc.connect(g); g.connect(this.master);
      osc.start(now); osc.stop(now + 1.25);
    });
  }
}
const audio = new PythagoreanAudio();

// ============================================================================
// 3. CUBICAL INTERACTION NET ENGINE (Direct mirror of src/core.h & src/net.c)
// ============================================================================
// Each cell has:
//   id, kind (V_* or O_*), polarity ('val' | 'op' | 'root'), label, sub,
//   ports: array of { cellId, portIdx } (port 0 is ALWAYS the principal port!),
//   x, y, vx, vy, age, fixed
// An active pair is ANY wire connecting (op.port[0]) <---> (val.port[0]).

let nextId = 1;
class Net {
  constructor() {
    this.cells = new Map();
    this.sparks = [];      // visual shockwaves on rewrite
    this.pulses = [];      // traveling energy along rewired edges
    this.work = 0;         // total interaction steps W
    this.depth = 0;        // parallel depth D
    this.trace = [];
    this.kanProgress = 0;  // 0..1 for cubical box visual
    this.kanMode = null;   // 'kan' | 'univalence' | 'path' | null
  }
  add(kind, label, sub, nPorts, x, y, meta = {}) {
    const id = nextId++;
    const pol = kind === 'ROOT' ? 'root' : (kind.startsWith('V_') ? 'val' : 'op');
    const c = {
      id, kind, polarity: pol, label, sub: sub || '',
      ports: new Array(nPorts).fill(null),
      x: x + (Math.random() - 0.5) * 6,
      y: y + (Math.random() - 0.5) * 6,
      vx: 0, vy: 0, age: 0,
      fixed: kind === 'ROOT',
      meta
    };
    this.cells.set(id, c);
    return id;
  }
  wire(aId, aPort, bId, bPort) {
    const a = this.cells.get(aId), b = this.cells.get(bId);
    if (!a || !b) return;
    a.ports[aPort] = { cell: bId, port: bPort };
    b.ports[bPort] = { cell: aId, port: aPort };
    this.pulses.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, t: 0 });
  }
  // Connect whatever is currently wired to (aId, aPort) directly to whatever is wired to (bId, bPort)
  bridge(aId, aPort, bId, bPort) {
    const a = this.cells.get(aId), b = this.cells.get(bId);
    const ea = a ? a.ports[aPort] : null;
    const eb = b ? b.ports[bPort] : null;
    if (ea && eb) {
      if (ea.cell === bId && ea.port === bPort) return; // self-loop vanishes
      this.wire(ea.cell, ea.port, eb.cell, eb.port);
    } else if (ea) {
      const ca = this.cells.get(ea.cell);
      if (ca) ca.ports[ea.port] = null;
    } else if (eb) {
      const cb = this.cells.get(eb.cell);
      if (cb) cb.ports[eb.port] = null;
    }
  }
  endpoint(id, port) {
    const c = this.cells.get(id);
    return c ? c.ports[port] : null;
  }
  remove(id) {
    this.cells.delete(id);
  }
  activePairs() {
    const pairs = [];
    const seen = new Set();
    for (const c of this.cells.values()) {
      if (c.polarity !== 'op') continue;
      const e = c.ports[0];
      if (!e || e.port !== 0) continue;
      const v = this.cells.get(e.cell);
      if (!v || v.polarity !== 'val') continue;
      const key = `${c.id}-${v.id}`;
      if (!seen.has(key)) {
        seen.add(key);
        pairs.push({ op: c, val: v });
      }
    }
    return pairs;
  }
  describeRule(op, val) {
    if (op.kind === 'O_APP' && val.kind === 'V_LAM') return { key: 'beta', text: `app ⋈ λ  ⟶  wire(arg, param); wire(body, out)` };
    if (op.kind === 'O_FST' && val.kind === 'V_PAIR') return { key: 'proj', text: `fst ⋈ pair(a,b)  ⟶  a  (erase b)` };
    if (op.kind === 'O_SND' && val.kind === 'V_PAIR') return { key: 'proj', text: `snd ⋈ pair(a,b)  ⟶  b  (erase a)` };
    if (op.kind === 'O_ERA') return { key: 'era', text: `era ⋈ ${val.label}  ⟶  dissolve & erase parts` };
    if (op.kind === 'O_DUP' && val.kind === 'V_REF') return { key: 'dup', text: `dup ⋈ ref  ⟶  two shared references` };
    if (op.kind === 'O_DUP') return { key: 'dup', text: `dup ⋈ ${val.label}  ⟶  share / fan-out` };
    if (op.kind === 'O_PAPPP' && val.kind === 'V_PLAM') return { key: 'papp', text: `@ ${op.sub} ⋈ path-λ ${val.sub}  ⟶  subst [${val.sub}:=${op.sub}]` };
    if (op.kind === 'O_SUBST' && val.kind === 'V_PAIR') return { key: 'subst', text: `subst ${op.sub} ⋈ pair  ⟶  propagate to both` };
    if (op.kind === 'O_SUBST' && val.kind === 'V_IV') return { key: 'subst', text: `subst ${op.sub} ⋈ ${val.label}  ⟶  evaluate interval` };
    if (op.kind === 'O_SUBST') return { key: 'subst', text: `subst ${op.sub} ⋈ ${val.label}  ⟶  substitute fiber` };
    if (op.kind === 'O_COMP' && val.kind === 'V_SYS') return { key: 'comp', text: `comp ⋈ sys  ⟶  fill Kan open box` };
    if (op.kind === 'O_COMP' && val.kind === 'V_GLUE') return { key: 'comp', text: `comp ⋈ Glue  ⟶  unglue on equivalence face` };
    if (op.kind === 'O_UNGLUE' && val.kind === 'V_GLUEV') return { key: 'unglue', text: `unglue ⋈ glue  ⟶  apply equivalence map` };
    if (op.kind === 'O_CASE' && val.kind === 'V_CON') return { key: 'beta', text: `case ⋈ ${val.label}  ⟶  select branch` };
    if (op.kind === 'O_UNFOLD' && val.kind === 'V_WORD') return { key: 'dup', text: `unfold ⋈ #${val.meta.n}  ⟶  branch parallel mesh` };
    return { key: 'beta', text: `${op.label} ⋈ ${val.label}  ⟶  rewrite` };
  }

  // Fire a single active pair (exact local net rewrite!)
  firePair(opId, valId) {
    const op = this.cells.get(opId);
    const val = this.cells.get(valId);
    if (!op || !val) return null;
    const mx = (op.x + val.x) / 2;
    const my = (op.y + val.y) / 2;
    const info = this.describeRule(op, val);

    this.sparks.push({ x: mx, y: my, r: 8, alpha: 1, color: '#ff0a94' });

    // --- 1. O_APP ⋈ V_LAM ---
    if (op.kind === 'O_APP' && val.kind === 'V_LAM') {
      // op: 0=fn, 1=arg, 2=out  |  val: 0=prin, 1=param, 2=body
      this.bridge(opId, 1, valId, 1);
      this.bridge(opId, 2, valId, 2);
      this.remove(opId); this.remove(valId);
    }
    // --- 2. O_FST ⋈ V_PAIR ---
    else if (op.kind === 'O_FST' && val.kind === 'V_PAIR') {
      // op: 0=p, 1=out | val: 0=prin, 1=a, 2=b
      const era = this.add('O_ERA', 'ε', 'erase', 1, val.x + 36, val.y + 36);
      const eb = this.endpoint(valId, 2);
      this.bridge(opId, 1, valId, 1);
      if (eb) this.wire(era, 0, eb.cell, eb.port);
      this.remove(opId); this.remove(valId);
    }
    // --- 3. O_SND ⋈ V_PAIR ---
    else if (op.kind === 'O_SND' && val.kind === 'V_PAIR') {
      const era = this.add('O_ERA', 'ε', 'erase', 1, val.x - 36, val.y + 36);
      const ea = this.endpoint(valId, 1);
      this.bridge(opId, 1, valId, 2);
      if (ea) this.wire(era, 0, ea.cell, ea.port);
      this.remove(opId); this.remove(valId);
    }
    // --- 4. O_ERA ⋈ any V_* ---
    else if (op.kind === 'O_ERA') {
      // Spawn an O_ERA facing every auxiliary port of val
      for (let i = 1; i < val.ports.length; i++) {
        const ep = val.ports[i];
        if (ep) {
          const e = this.add('O_ERA', 'ε', 'erase', 1, val.x + (i - 1.5) * 40, val.y + 30);
          this.wire(e, 0, ep.cell, ep.port);
        }
      }
      this.remove(opId); this.remove(valId);
    }
    // --- 5. O_DUP ⋈ V_* ---
    else if (op.kind === 'O_DUP') {
      // Atomic value (no aux ports): duplicate into two copies
      const out1 = this.endpoint(opId, 1);
      const out2 = this.endpoint(opId, 2);
      if (val.ports.length === 1) {
        const c1 = this.add(val.kind, val.label, val.sub, 1, mx - 42, my, { ...val.meta });
        const c2 = this.add(val.kind, val.label, val.sub, 1, mx + 42, my, { ...val.meta });
        if (out1) this.wire(c1, 0, out1.cell, out1.port);
        if (out2) this.wire(c2, 0, out2.cell, out2.port);
        this.remove(opId); this.remove(valId);
      } else {
        // Value with parts: hold once behind V_REF (exact core.h sharing semantics!) or fan-out
        const r1 = this.add('V_REF', 'ref', val.label, 1, mx - 48, my - 24);
        const r2 = this.add('V_REF', 'ref', val.label, 1, mx + 48, my - 24);
        if (out1) this.wire(r1, 0, out1.cell, out1.port);
        if (out2) this.wire(r2, 0, out2.cell, out2.port);
        // Disconnect val's aux ports via era? No, box holds val once — visually show shared box!
        this.remove(opId);
        this.remove(valId);
      }
    }
    // --- 6. O_PAPPP ⋈ V_PLAM (Cubical path application) ---
    else if (op.kind === 'O_PAPPP' && val.kind === 'V_PLAM') {
      // op: 0=p, 1=out, sub='0' | val: 0=prin, 1=body, sub='i'
      const subStr = `[${val.sub}:=${op.sub}]`;
      const s = this.add('O_SUBST', 'subst', subStr, 2, mx, my, { dim: val.sub, val: op.sub });
      const bodyEp = this.endpoint(valId, 1);
      const outEp = this.endpoint(opId, 1);
      if (bodyEp) this.wire(s, 0, bodyEp.cell, bodyEp.port);
      if (outEp) this.wire(s, 1, outEp.cell, outEp.port);
      this.kanProgress = Math.min(1, this.kanProgress + 0.35);
      this.remove(opId); this.remove(valId);
    }
    // --- 7. O_SUBST ⋈ V_PAIR (Dimension substitution propagates one level at a time) ---
    else if (op.kind === 'O_SUBST' && val.kind === 'V_PAIR') {
      const pNew = this.add('V_PAIR', 'pair', 'Σ', 3, mx, my - 35);
      const s1 = this.add('O_SUBST', 'subst', op.sub, 2, mx - 58, my + 35, { ...op.meta });
      const s2 = this.add('O_SUBST', 'subst', op.sub, 2, mx + 58, my + 35, { ...op.meta });
      const outEp = this.endpoint(opId, 1);
      const ea = this.endpoint(valId, 1);
      const eb = this.endpoint(valId, 2);
      if (outEp) this.wire(pNew, 0, outEp.cell, outEp.port);
      this.wire(pNew, 1, s1, 1);
      this.wire(pNew, 2, s2, 1);
      if (ea) this.wire(s1, 0, ea.cell, ea.port);
      if (eb) this.wire(s2, 0, eb.cell, eb.port);
      this.kanProgress = Math.min(1, this.kanProgress + 0.35);
      this.remove(opId); this.remove(valId);
    }
    // --- 8. O_SUBST ⋈ V_IV (Evaluate interval expression under [i:=0]) ---
    else if (op.kind === 'O_SUBST' && val.kind === 'V_IV') {
      const outEp = this.endpoint(opId, 1);
      const resLabel = val.meta.onZero !== undefined ? val.meta.onZero : op.meta.val;
      const resSub = val.meta.resSub || 'endpoint';
      const vNew = this.add('V_CON', resLabel, resSub, 1, mx, my);
      if (outEp) this.wire(vNew, 0, outEp.cell, outEp.port);
      this.kanProgress = 1;
      this.remove(opId); this.remove(valId);
    }
    // --- 9. O_COMP ⋈ V_SYS (Kan box filling!) ---
    else if (op.kind === 'O_COMP' && val.kind === 'V_SYS') {
      const outEp = this.endpoint(opId, 1);
      const baseEp = this.endpoint(opId, 2);
      // Produce the filled lid path (p ∙ q)
      const lid = this.add('V_PLAM', 'path-λ', 'i', 2, mx, my - 20);
      const filled = this.add('V_CON', 'p ∙ q', 'Kan lid', 1, mx, my + 55);
      this.wire(lid, 1, filled, 0);
      if (outEp) this.wire(lid, 0, outEp.cell, outEp.port);
      // Erase consumed walls & base cleanly
      const eraBase = this.add('O_ERA', 'ε', 'base', 1, mx + 75, my + 20);
      if (baseEp) this.wire(eraBase, 0, baseEp.cell, baseEp.port);
      for (let i = 1; i < val.ports.length; i++) {
        const ep = val.ports[i];
        if (ep) {
          const ew = this.add('O_ERA', 'ε', 'face', 1, val.x + (i - 1.5) * 44, val.y + 40);
          this.wire(ew, 0, ep.cell, ep.port);
        }
      }
      this.kanProgress = 1;
      this.remove(opId); this.remove(valId);
    }
    // --- 10. O_COMP ⋈ V_GLUE (Univalence step 1: comp on Glue reduces to unglue on face!) ---
    else if (op.kind === 'O_COMP' && val.kind === 'V_GLUE') {
      const outEp = this.endpoint(opId, 1);
      const baseEp = this.endpoint(opId, 2);
      const eqEp = this.endpoint(valId, 1);
      const ungl = this.add('O_UNGLUE', 'unglue', 'face i=0', 3, mx, my - 25);
      const gv = this.add('V_GLUEV', 'glue', 'ua notEquiv', 2, mx, my + 48);
      if (outEp) this.wire(ungl, 1, outEp.cell, outEp.port);
      if (eqEp) this.wire(ungl, 2, eqEp.cell, eqEp.port);
      this.wire(ungl, 0, gv, 0);
      if (baseEp) this.wire(gv, 1, baseEp.cell, baseEp.port);
      this.kanProgress = 0.5;
      this.remove(opId); this.remove(valId);
    }
    // --- 11. O_UNGLUE ⋈ V_GLUEV (Univalence step 2: applies equivalence map!) ---
    else if (op.kind === 'O_UNGLUE' && val.kind === 'V_GLUEV') {
      const outEp = this.endpoint(opId, 1);
      const eqEp = this.endpoint(opId, 2);
      const baseEp = this.endpoint(valId, 1);
      // Apply the equivalence's map `not` to `true`!
      const app = this.add('O_APP', 'app', 'e.map', 3, mx, my);
      if (eqEp) this.wire(app, 0, eqEp.cell, eqEp.port);
      if (baseEp) this.wire(app, 1, baseEp.cell, baseEp.port);
      if (outEp) this.wire(app, 2, outEp.cell, outEp.port);
      this.kanProgress = 0.85;
      this.remove(opId); this.remove(valId);
    }
    // --- 12. O_CASE ⋈ V_CON (Pattern matching — e.g. `not true ⟶ false`) ---
    else if (op.kind === 'O_CASE' && val.kind === 'V_CON') {
      const outEp = this.endpoint(opId, 1);
      const res = val.label === 'true' ? 'false' : 'true';
      const vRes = this.add('V_CON', res, 'Bool', 1, mx, my);
      if (outEp) this.wire(vRes, 0, outEp.cell, outEp.port);
      this.kanProgress = 1;
      this.remove(opId); this.remove(valId);
    }
    // --- 13. O_UNFOLD ⋈ V_WORD (Wolfram-style parallel cellular mesh evolution) ---
    else if (op.kind === 'O_UNFOLD' && val.kind === 'V_WORD') {
      const n = val.meta.n || 0;
      const outEp = this.endpoint(opId, 1);
      if (n <= 0) {
        const leaf = this.add('V_CON', '•', 'id', 1, mx, my);
        if (outEp) this.wire(leaf, 0, outEp.cell, outEp.port);
      } else {
        const pair = this.add('V_PAIR', 'pair', `L${n}`, 3, mx, my - 20);
        if (outEp) this.wire(pair, 0, outEp.cell, outEp.port);
        const spread = 42 + n * 18;
        const uL = this.add('O_UNFOLD', 'unfold', 'mesh', 2, mx - spread, my + 24);
        const wL = this.add('V_WORD', `#${n - 1}`, 'Word', 1, mx - spread - 12, my + 78, { n: n - 1 });
        const uR = this.add('O_UNFOLD', 'unfold', 'mesh', 2, mx + spread, my + 24);
        const wR = this.add('V_WORD', `#${n - 1}`, 'Word', 1, mx + spread + 12, my + 78, { n: n - 1 });
        this.wire(pair, 1, uL, 1);
        this.wire(uL, 0, wL, 0);
        this.wire(pair, 2, uR, 1);
        this.wire(uR, 0, wR, 0);
      }
      this.remove(opId); this.remove(valId);
    }

    this.work++;
    this.trace.unshift({ step: this.work, rule: info.text, ratio: (PYTH[info.key] || PYTH.beta).name });
    if (this.trace.length > 60) this.trace.pop();
    return info;
  }

  // Fire ALL disjoint active pairs simultaneously (parallel depth += 1)
  stepParallel() {
    const pairs = this.activePairs();
    if (!pairs.length) return 0;
    this.depth++;
    const ids = pairs.map(p => [p.op.id, p.val.id]);
    ids.forEach(([oid, vid], idx) => {
      const info = this.firePair(oid, vid);
      if (info) audio.playRule(info.key, idx, ids.length);
    });
    if (this.activePairs().length === 0) {
      setTimeout(() => audio.playNormalForm(), 160);
    }
    return ids.length;
  }
}

