-- THEOREM 1B (Universal Self-Dual Immirzi gamma = 1 Annihilation of Hyperbolic Transcendentals):
bst-gamma1-trans-vanish : (A : Type) → (z one : A) → (add mul : A → A → A) → (neg : A → A) →
  LorRing A z one add mul neg →
  add one (neg (mul (mul one one) (mul one one))) ≡ z
bst-gamma1-trans-vanish A z one add mul neg r =
  lor-tr A
    (add one (neg (mul (mul one one) (mul one one))))
    (add one (neg one))
    z
    (cong (λ t → add one (neg t))
          (concat (cong (λ u → mul u (mul one one)) (fst (snd (snd (snd r))) one))
                  (concat (fst (snd (snd (snd r))) (mul one one))
                          (fst (snd (snd (snd r))) one))))
    (fst r one)
