b2-firstctr : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstctr mm_ zero rs j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-firstctr mm_ (suc f) rs j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let a_5704 = rs in let j_5705 = j in scmd (w-load ((b2-a mm_ (%wadd a_5704 (%wsucc j_5705))))) (λ x_5703 → let mm_5706 = b2-dep mm_ x_5703 in let row = x_5703 in let t_5708 = row in let j_5709 = #0 in scmd (w-load ((b2-a mm_5706 (%wadd t_5708 (%wadd #2 j_5709))))) (λ x_5707 → let mm_5710 = b2-dep mm_5706 x_5707 in let ps = x_5707 in let a_5712 = ps in let j_5713 = #0 in scmd (w-load ((b2-a mm_5710 (%wadd a_5712 (%wsucc j_5713))))) (λ x_5711 → let mm_5714 = b2-dep mm_5710 x_5711 in let p0 = x_5711 in let t_5716 = p0 in scmd (w-load ((b2-a mm_5714 t_5716))) (λ x_5715 → let mm_5717 = b2-dep mm_5714 x_5715 in let tg = (%wand x_5715 #255) in if (%weq tg b2-PCTR) then (kq_ (h4-depl mm_5717 (p0))) else (b2-firstctr mm_5717 f rs (%wsucc j) n kq_))))))
