  if h-eq nm "ua" then ("Univalence Equivalence-to-Path Formation" , "Voevodsky Univalence")
  else if h-eq nm "uaβ" then ("Path-Transport Computation Reduction Law" , "Voevodsky-CCHM ua-beta")
