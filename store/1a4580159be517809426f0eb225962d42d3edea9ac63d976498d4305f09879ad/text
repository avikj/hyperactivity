  else if h-eq nm "portal-arrive" then ("Univalent Motive Transport Across Isomorphic Types" , "Univalent Structure Transfer")
  else if orB (h-eq nm "derive-ua") (h-eq nm "derive-equiv") then ("Nameless Inductive Telescope Equivalence Synthesis" , "Generic Data Isomorphism")
