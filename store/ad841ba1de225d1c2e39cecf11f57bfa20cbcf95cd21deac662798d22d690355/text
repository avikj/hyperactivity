gn-keccak-spec =
  f2prog #5 nil
    (cons (gn-chi-sop (f2-v #0) (f2-v #1) (f2-v #2))
    (cons (gn-chi-sop (f2-v #1) (f2-v #2) (f2-v #3))
    (cons (gn-chi-sop (f2-v #2) (f2-v #3) (f2-v #4))
    (cons (gn-chi-sop (f2-v #3) (f2-v #4) (f2-v #0))
    (cons (gn-chi-sop (f2-v #4) (f2-v #0) (f2-v #1)) nil)))))
