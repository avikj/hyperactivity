round-key : (t : List (List Word)) → (h0 : Nat) → (r : List Word) → (inv : DblInv t (suc h0) r) → (s s' : List (List Word)) → MemKey {suffix-ord} s (sufs t) → MemKey {suffix-ord} s' (sufs t) →
         leq {WW} (dkey (fst inv) (suc h0) s) (dkey (fst inv) (suc h0) s') ≡ leq {suffix-ord} (take-n (plus (suc h0) (suc h0)) s) (take-n (plus (suc h0) (suc h0)) s')
round-key t h0 r inv s s' m m' = dkey-lemma t h0 (fst inv) (fst (snd (snd inv))) (snd (snd (snd inv))) s s' m m'
