-- a Greek vowel and a combining accent composed (NFC): acute (tonos), grave (varia), circumflex
e-compose : Word → Word → Word → List Word
e-compose v m1 m2 =
  if andB (weq m1 #204) (weq m2 #129) then
    (if weq v #177 then cons #206 (cons #172 nil) else if weq v #181 then cons #206 (cons #173 nil) else if weq v #183 then cons #206 (cons #174 nil)
     else if weq v #185 then cons #206 (cons #175 nil) else if weq v #191 then cons #207 (cons #140 nil) else nil)
  else if andB (weq m1 #204) (weq m2 #128) then
    (if weq v #177 then cons #225 (cons #189 (cons #176 nil)) else if weq v #185 then cons #225 (cons #189 (cons #182 nil)) else nil)
  else if andB (weq m1 #205) (weq m2 #130) then
    (if weq v #177 then cons #225 (cons #190 (cons #182 nil)) else if weq v #185 then cons #225 (cons #191 (cons #150 nil)) else nil)
  else nil
