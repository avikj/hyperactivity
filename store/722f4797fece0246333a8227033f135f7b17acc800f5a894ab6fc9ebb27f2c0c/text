-- Section (3): Exact Gauss-invariant finite Hilbert space and symmetric Hamiltonian matrix H = H_E + H_B + H_D
-- on the triangle spin network K_3: vertices {0, 1, 2}, oriented edges e0=(0->1), e1=(1->2), e2=(2->0),
-- elementary loop square = (e0, e1, e2), reference proton at v0 = 0.
qgm-bz-eq : BZ → BZ → Bool
qgm-bz-eq a b = if bin-zero (snd a) then bin-zero (snd b)
  else both (bit-eq (fst a) (fst b)) (bin-eq (snd a) (snd b))
