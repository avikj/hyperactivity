h4-mk3 : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-mk3 m tag ext a b c k =
  h4-alloc m #3 (λ at → let m22 = h4-dep m at in scmd (w-store ((h4-ha m22 at)) (a)) (λ u23 → let m24 = hv2-u m22 u23 in scmd (w-store ((h4-ha m24 (%wadd at #1))) (b)) (λ u25 → let m26 = hv2-u m24 u25 in scmd (w-store ((h4-ha m26 (%wadd at #2))) (c)) (λ u27 → let m28 = hv2-u m26 u27 in k (h4-depl m28 ((h4-new tag ext at)))))))
