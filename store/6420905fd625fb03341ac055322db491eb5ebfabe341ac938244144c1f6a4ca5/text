b2-ploop : Word → Nat → Word → (Word → Step W Word) → Step W Word
b2-ploop mm_ zero p kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ploop mm_ (suc f) p kq_ =
  b2-pitem mm_ p (λ dd_14503 → let mm_14504 = b2-dep mm_ dd_14503 in scmd (w-load ((b2-HR mm_14504 #28))) (λ r → let mm_14505 = b2-dep mm_14504 r in if (%weq r #1) then (b2-ploop mm_14505 f p kq_) else (kq_ (h4-depl mm_14505 (r)))))
