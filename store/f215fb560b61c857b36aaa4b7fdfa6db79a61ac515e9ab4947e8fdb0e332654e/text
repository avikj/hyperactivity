b2-uat : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-uat mm_ s i kq_ =
  let a_6703 = s in scmd (w-load ((b2-a mm_ a_6703))) (λ x_6702 → let mm_6704 = b2-dep mm_ x_6702 in let n = x_6702 in if (not (%wlt i n)) then (kq_ (h4-depl mm_6704 (hv2-none))) else (let a_6706 = s in let j_6707 = i in scmd (w-load ((b2-a mm_6704 (%wadd a_6706 (%wsucc j_6707))))) (λ x_6705 → let mm_6708 = b2-dep mm_6704 x_6705 in let c = x_6705 in kq_ (h4-depl mm_6708 (c)))))
