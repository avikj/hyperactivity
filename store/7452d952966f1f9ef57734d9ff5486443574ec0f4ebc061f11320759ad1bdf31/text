-- Section (1): Universal KMS Detailed-Balance Stationarity over any Commutative Semiring.
-- Semiring bundle (mul-zr, mul-one-r, ldist):
QtSR : (A : Type) → A → A → (A → A → A) → (A → A → A) → Type
QtSR A z one add mul =
  ((x : A) → mul x z ≡ z) ×
  (((x : A) → mul x one ≡ x) ×
  ((x y w : A) → mul x (add y w) ≡ add (mul x y) (mul x w)))
