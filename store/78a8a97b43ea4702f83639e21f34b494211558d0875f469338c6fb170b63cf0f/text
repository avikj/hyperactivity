b2-replg : Word → Nat → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-replg mm_ zero vs v w ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-replg mm_ (suc f) vs v w ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_6199 = vs in let j_6200 = j in scmd (w-load ((b2-a mm_ (%wadd a_6199 (%wsucc j_6200))))) (λ x_6198 → let mm_6201 = b2-dep mm_ x_6198 in let u = x_6198 in let a_6202 = ob in let j_6203 = j in let v_6204 = (the Word (if %weq u v then w else u)) in scmd (w-store ((b2-a mm_6201 (%wadd a_6202 (%wsucc j_6203)))) (v_6204)) (λ uu_6205 → let mm_6206 = hv2-u mm_6201 uu_6205 in b2-replg mm_6206 f vs v w ob (%wsucc j) n kq_)))
