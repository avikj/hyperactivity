  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let t_13943 = bk in let j_13944 = #2 in scmd (w-load ((b2-a mm_ (%wadd t_13943 (%wadd #2 j_13944))))) (λ x_13942 → let mm_13945 = b2-dep mm_ x_13942 in let ov = x_13942 in let v_13948 = ov in let j_13949 = j in scmd (w-load ((b2-a mm_13945 (%wadd v_13948 #2)))) (λ d_13947 → let mm_13950 = b2-dep mm_13945 d_13947 in scmd (w-load ((b2-a mm_13950 (%wadd d_13947 (%wsucc j_13949))))) (λ x_13946 → let mm_13951 = b2-dep mm_13950 x_13946 in let k = x_13946 in b2-tld mm_13951 bk k (λ t → let mm_13952 = b2-dep mm_13951 t in let t_13954 = t in scmd (w-load ((b2-a mm_13952 t_13954))) (λ x_13953 → let mm_13955 = b2-dep mm_13952 x_13953 in let tg = (%wand x_13953 #255) in let t_13956 = t in let j_13957 = (the Word (if %weq tg b2-TADT then #4 else #5)) in let v_13958 = #1 in scmd (w-store ((b2-a mm_13955 (%wadd t_13956 (%wadd #2 j_13957)))) (v_13958)) (λ uu_13959 → let mm_13960 = hv2-u mm_13955 uu_13959 in b2-markbase mm_13960 f bk (%wsucc j) n kq_)))))))
