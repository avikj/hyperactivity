-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_10419 = tld in scmd (w-load ((b2-a mm_ t_10419))) (λ x_10418 → let mm_10420 = b2-dep mm_ x_10418 in let tg = (%wand x_10418 #255) in if (%weq tg b2-TADT) then (let t_10422 = tld in let j_10423 = #4 in scmd (w-load ((b2-a mm_10420 (%wadd t_10422 (%wadd #2 j_10423))))) (λ x_10421 → let mm_10424 = b2-dep mm_10420 x_10421 in let b = x_10421 in kq_ (h4-depl mm_10424 (b)))) else (let t_10426 = tld in let j_10427 = #5 in scmd (w-load ((b2-a mm_10420 (%wadd t_10426 (%wadd #2 j_10427))))) (λ x_10425 → let mm_10428 = b2-dep mm_10420 x_10425 in let b = x_10425 in kq_ (h4-depl mm_10428 (b))))))
