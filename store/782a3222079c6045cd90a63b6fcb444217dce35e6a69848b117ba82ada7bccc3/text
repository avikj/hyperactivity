hxp-main : List (List Word) → Step W Word
hxp-main args =
  let p    = hxp-pref args
      cf   = list-append p ".c"
      mf   = list-append p ".metal"
      mh   = list-append p "_metal.m"
      sf   = list-append p ".sv"
      spec = hxp-default-ir
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf (hxp-emit-c11 spec)) (λ bc →
     scmd (w-file-write-named mf (hxp-emit-metal-shader spec)) (λ bm →
     scmd (w-file-write-named mh (hxp-emit-metal-host spec)) (λ bmh →
     scmd (w-file-write-named sf (hxp-emit-sv spec)) (λ bs →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-HXP (45th Engine) | Hexagram == Hyperactive Exchange Protocol ("
       (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))
       (cli-say "  [PROVED] 4,096 I Ching Q_6 x Q_6 Transitions + Divination Fiber Warrants + Hermetic Scale Naturality"
       (cli-say "  [PROVED] 24-Triad Synesthetic Tonnetz + Clebsch srg(16,5,0,2) Diam-2 + Indra's Net IBLT/GF(2) + Liquification"
       (cli-say "  [PROVED] Zero-Float Superconductivity: Rational Cayley Unitary + Meissner d_omega=0 + Josephson Lyapunov"
       (cli-say (list-append "  [EMITTED] C11=" (list-append (ce-dec bc)
         (list-append "B Metal=" (list-append (ce-dec bm)
         (list-append "B UnifiedHost=" (list-append (ce-dec bmh)
         (list-append "B SV=" (list-append (ce-dec bs) "B"))))))))
         (sdone #0)))))))))))
