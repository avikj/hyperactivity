b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_11598 = xs in scmd (w-load ((b2-a mm_ a_11598))) (λ x_11597 → let mm_11599 = b2-dep mm_ x_11597 in let n = x_11597 in if (%weq j n) then (kq_ (h4-depl mm_11599 (h))) else (let a_11601 = xs in let j_11602 = j in scmd (w-load ((b2-a mm_11599 (%wadd a_11601 (%wsucc j_11602))))) (λ x_11600 → let mm_11603 = b2-dep mm_11599 x_11600 in let x = x_11600 in b2-tapp mm_11603 bk h x #0 (λ h2 → let mm_11604 = b2-dep mm_11603 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_11604 b2-ERR)) else (b2-applyall mm_11604 f bk h2 xs (%wsucc j) kq_)))))
