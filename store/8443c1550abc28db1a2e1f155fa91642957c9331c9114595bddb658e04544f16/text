-- a TLD's b flag (an ADT's or a Def's)
b2-tldb : Word → Word → (Word → Step W Word) → Step W Word
b2-tldb mm_ tld kq_ =
  if (%weq tld #0) then (kq_ (h4-depl mm_ (#0))) else (let t_11667 = tld in scmd (w-load ((b2-a mm_ t_11667))) (λ x_11666 → let mm_11668 = b2-dep mm_ x_11666 in let tg = (%wand x_11666 #255) in if (%weq tg b2-TADT) then (let t_11670 = tld in let j_11671 = #4 in scmd (w-load ((b2-a mm_11668 (%wadd t_11670 (%wadd #2 j_11671))))) (λ x_11669 → let mm_11672 = b2-dep mm_11668 x_11669 in let b = x_11669 in kq_ (h4-depl mm_11672 (b)))) else (let t_11674 = tld in let j_11675 = #5 in scmd (w-load ((b2-a mm_11668 (%wadd t_11674 (%wadd #2 j_11675))))) (λ x_11673 → let mm_11676 = b2-dep mm_11668 x_11673 in let b = x_11673 in kq_ (h4-depl mm_11676 (b))))))
