-- a page: the document read as markdown (md) or shown as its text
s-page-as : Bool → List Word → List Word → List Word
s-page-as md path text = list-append (h-concat (cons "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" (cons (s-esc (s-title-of path (inr text))) (cons (list-append " · Avik Jain</title>" (list-append (s-og (s-esc (s-title-of path (inr text)))) "<style>")) (cons s-style (cons "</style>" (cons s-math (cons um-tag (cons "</head><body>" (cons s-nav (cons "<main><div class='path'>" (cons (s-esc path) (cons "</div>" nil)))))))))))))
  (list-append (if md then md-doc text else list-append "<pre>" (list-append (s-esc text) "</pre>")) "</main></body></html>")
