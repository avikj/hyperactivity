b2-applyall : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-applyall mm_ zero bk h xs j kq_ =
  kq_ (h4-depl mm_ (h))
b2-applyall mm_ (suc f) bk h xs j kq_ =
  let a_10350 = xs in scmd (w-load ((b2-a mm_ a_10350))) (λ x_10349 → let mm_10351 = b2-dep mm_ x_10349 in let n = x_10349 in if (%weq j n) then (kq_ (h4-depl mm_10351 (h))) else (let a_10353 = xs in let j_10354 = j in scmd (w-load ((b2-a mm_10351 (%wadd a_10353 (%wsucc j_10354))))) (λ x_10352 → let mm_10355 = b2-dep mm_10351 x_10352 in let x = x_10352 in b2-tapp mm_10355 bk h x #0 (λ h2 → let mm_10356 = b2-dep mm_10355 h2 in if (%weq h2 b2-ERR) then (kq_ (h4-depl mm_10356 b2-ERR)) else (b2-applyall mm_10356 f bk h2 xs (%wsucc j) kq_)))))
