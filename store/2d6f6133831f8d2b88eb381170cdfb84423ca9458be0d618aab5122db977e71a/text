hyperos-deploy-sh-p2 : List Word
hyperos-deploy-sh-p2 =
  os-lines-q
    (cons "    $QTIMEOUT qemu-system-aarch64 -M virt -cpu cortex-a72 -m 256M -nographic \"
    (cons "      -device virtio-gpu-device -device virtio-keyboard-device -device virtio-mouse-device -device virtio-net-device \"
    (cons "      -kernel `$OUT/hyperos-arm64.img` -append `hyperos.oneshot=1` </dev/null"
    (cons "  fi"
    (cons "fi"
    (cons nil
    (cons "if [ `$OS` = `Darwin` ]; then"
    (cons "  if command -v xcrun >/dev/null 2>&1; then"
    (cons "    echo `[APPLE VIRTUALIZATION.FRAMEWORK] Compiling native EL1 Bare-Metal Hypervisor window ($OUT/hx-vm)...`"
    (cons "    xcrun swiftc -O `$OUT/hyperos_vz_macos.swift` -framework Virtualization -framework AppKit -o `$OUT/hx-vm`"
    (cons "    /usr/bin/codesign --force --sign - --entitlements `$OUT/hyperos_vz.entitlements` `$OUT/hx-vm`"
    (cons "  fi"
    (cons "  if [ `$MODE` = `all` ] || [ `$MODE` = `daemon` ] || [ `$MODE` = `mesh` ]; then"
    (cons "    LA=`$HOME/Library/LaunchAgents`"
    (cons "    mkdir -p `$LA`"
    (cons "    ABS_REPO=`$(CDPATH= cd -- `$REPO` && pwd)`"
    (cons "    cat > `$LA/ai.hyperactivity.hypernet.plist` <<PLIST"
    (cons "<?xml version=`1.0` encoding=`UTF-8`?>"
    (cons "<!DOCTYPE plist PUBLIC `-//Apple//DTD PLIST 1.0//EN` `http://www.apple.com/DTDs/PropertyList-1.0.dtd`>"
    (cons "<plist version=`1.0`><dict>"
    (cons "  <key>Label</key><string>ai.hyperactivity.hypernet</string>"
    (cons "  <key>ProgramArguments</key><array>"
    nil))))))))))))))))))))))
