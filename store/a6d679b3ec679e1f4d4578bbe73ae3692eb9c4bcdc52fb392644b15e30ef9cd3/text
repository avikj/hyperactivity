-- Addition of le inequalities: a <= b and c <= d => a + c <= b + d.
rp-swap4-nat : (a b c d : Nat) → plus (plus a b) (plus c d) ≡ plus (plus a c) (plus b d)
rp-swap4-nat a b c d = concat
  (plus-assoc a b (plus c d))
  (concat
    (cong (λ t → plus a t)
      (concat (sym (plus-assoc b c d))
        (concat (cong (λ t → plus t d) (plus-comm b c)) (plus-assoc c b d))))
    (sym (plus-assoc a c (plus b d))))
