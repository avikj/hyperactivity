-- name characters (TSPL parse_name): letters, digits, _ . - /
hv2-namec : Word → Bool
hv2-namec c =
  if andB (%wlt #47 c) (%wlt c #58) then true
  else if andB (%wlt #64 c) (%wlt c #91) then true
  else if andB (%wlt #96 c) (%wlt c #123) then true
  else if %weq c #95 then true
  else if %weq c #46 then true
  else if %weq c #45 then true
  else %weq c #47
