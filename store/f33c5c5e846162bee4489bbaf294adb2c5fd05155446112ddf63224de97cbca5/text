tir-thm-mask4-invol : (k x : TirCube4) → tir-mask4 k (tir-mask4 k x) ≡ x
tir-thm-mask4-invol (mk-tc4 k0 k1 k2 k3) (mk-tc4 x0 x1 x2 x3) =
  let p0 = tir-lem-xorB-cancel k0 x0
      p1 = tir-lem-xorB-cancel k1 x1
      p2 = tir-lem-xorB-cancel k2 x2
      p3 = tir-lem-xorB-cancel k3 x3
  in λ i → mk-tc4 (p0 i) (p1 i) (p2 i) (p3 i)
