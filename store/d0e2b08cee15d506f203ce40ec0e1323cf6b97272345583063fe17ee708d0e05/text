-- ── 3. Cochlear Hopf-Bifurcation Normal Form Exact Energy & Compression Law ──
-- Exact biological outer-hair-cell normal form: dz/dt = (mu + i*w0)*z - |z|^2*z
-- In real coordinates z = (q, p), r^2 = q^2 + p^2:
--   dq/dt = -w0*p - (r^2 - mu)*q,   dp/dt = w0*q - (r^2 - mu)*p
-- Proves exact instantaneous power balance over Q:
--   q*(dq/dt) + p*(dp/dt) == -(r^2 - mu)*(q^2 + p^2)
-- (Zero symplectic work from w0; strict SOS boundedness for all r^2 >= mu;
--  exact 1/3-power cochlear loudness compression |z| = |F|^{1/3} at mu = 0!)
-- Variables (0..3): w0, muB, qv, pv.
one-field-hopf-energy-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
one-field-hopf-energy-poly A ad mu q vs =
  (λ g sub sq →
    let w0 = g 0; muB = g 1; qv = g 2; pv = g 3
        r2  = ad (sq qv) (sq pv)
        sat = sub r2 muB
        dq  = sub (sub (q (fn-q 0 1)) (mu w0 pv)) (mu sat qv)
        dp  = sub (mu w0 qv) (mu sat pv)
        lhs = ad (mu qv dq) (mu pv dp)
        rhs = sub (q (fn-q 0 1)) (mu sat r2)
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
