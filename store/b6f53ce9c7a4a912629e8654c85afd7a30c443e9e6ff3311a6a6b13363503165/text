bst-main : List (List Word) → Step W Word
bst-main args =
  let p  = bst-pref args
      cf = list-append p "_daemon.c"
  in scmd w-now (λ t0 →
     scmd (w-file-write-named cf bst-c-src) (λ bc →
     scmd w-now (λ t1 →
     cli-say (list-append "HX-BEAST (31st Engine — Unbounded Coinductive Identity Atlas) | CantorDovetail=Proved | AtlasMono=Proved | OptCostMono=Proved | LawSound=Proved | DaemonC="
       (list-append (ce-dec bc)
       (list-append "B (" (list-append (ce-dec (%wdiv (%wsub t1 t0) #1000)) " us)"))))
       (sdone #0))))
