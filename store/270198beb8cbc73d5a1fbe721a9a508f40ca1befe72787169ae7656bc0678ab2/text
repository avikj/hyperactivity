sf-take-hex64-go : Nat → List Word → List Word → Bool × (List Word × List Word)
sf-take-hex64-go zero acc s = (true , (h-rev acc nil , s))
sf-take-hex64-go (suc k) acc nil = (false , (nil , nil))
sf-take-hex64-go (suc k) acc (cons c r) =
  if sf-is-hex c then sf-take-hex64-go k (cons c acc) r
  else (false , (nil , nil))
