-- Section (1): Universal discrete gauge theory on arbitrary finite oriented graphs over an abelian group.
-- Abelian group bundle (A, z, add, neg):
--   (add-zl, add-zr, add-assoc, add-comm, neg-hom, neg-z, add-inv)
QgmAb : (A : Type) → A → (A → A → A) → (A → A) → Type
QgmAb A z add neg =
  ((x : A) → add z x ≡ x) ×
  (((x : A) → add x z ≡ x) ×
  (((x y w : A) → add (add x y) w ≡ add x (add y w)) ×
  (((x y : A) → add x y ≡ add y x) ×
  (((x y : A) → neg (add x y) ≡ add (neg x) (neg y)) ×
  ((neg z ≡ z) ×
  ((x : A) → add x (neg x) ≡ z))))))
