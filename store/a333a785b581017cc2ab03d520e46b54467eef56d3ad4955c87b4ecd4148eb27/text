b2-stklen : Word → Word → (Word → Step W Word) → Step W Word
b2-stklen mm_ p kq_ =
  let i_8000 = (%wadd p #4) in scmd (w-load ((b2-a mm_ i_8000))) (λ x_7999 → let mm_8001 = b2-dep mm_ x_7999 in let stk = x_7999 in let v_8003 = stk in scmd (w-load ((b2-a mm_8001 v_8003))) (λ x_8002 → let mm_8004 = b2-dep mm_8001 x_8002 in let l = x_8002 in kq_ (h4-depl mm_8004 (l))))
