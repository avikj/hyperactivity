ge-eval : (Nat → Bool) → GuardExpr → Bool
ge-eval env (ge-k b)       = b
ge-eval env (ge-v x)       = env x
ge-eval env (ge-not a)     = bfm-notB (ge-eval env a)
ge-eval env (ge-and a b)   = bfm-andB (ge-eval env a) (ge-eval env b)
ge-eval env (ge-ite c t f) = bfm-iteB (ge-eval env c) (ge-eval env t) (ge-eval env f)
