b2-pcall : Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-pcall mm_ p k xs s kq_ =
  b2-reso mm_ p k #0 (λ q → let mm_6947 = b2-dep mm_ q in if (%weq q b2-ERR) then (kq_ (h4-depl mm_6947 b2-ERR)) else (b2-Ref mm_6947 q s #0 (λ rf → let mm_6948 = b2-dep mm_6947 rf in b2-apps mm_6948 rf xs s (λ r → let mm_6949 = b2-dep mm_6948 r in kq_ (h4-depl mm_6949 (r))))))
