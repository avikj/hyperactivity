-- the shown names k1 .. kn of a Let, each after its quantity
b2-letks : Word → Nat → Word → Word → Word → List Word → (List Word → Step W Word) → Step W Word
b2-letks mm_ zero ks qs j acc kq_ =
  kq_ (h4-depl mm_ (acc))
b2-letks mm_ (suc f) ks qs j acc kq_ =
  let a_1286 = ks in scmd (w-load ((b2-a mm_ a_1286))) (λ x_1285 → let mm_1287 = b2-dep mm_ x_1285 in let n = x_1285 in if (%weq j n) then (kq_ (h4-depl mm_1287 (acc))) else (let a_1289 = ks in let j_1290 = j in scmd (w-load ((b2-a mm_1287 (%wadd a_1289 (%wsucc j_1290))))) (λ x_1288 → let mm_1291 = b2-dep mm_1287 x_1288 in let k = x_1288 in let a_1293 = qs in let j_1294 = j in scmd (w-load ((b2-a mm_1291 (%wadd a_1293 (%wsucc j_1294))))) (λ x_1292 → let mm_1295 = b2-dep mm_1291 x_1292 in let q = x_1292 in b2-nbytes mm_1295 k (λ kb → let mm_1296 = b2-dpl mm_1295 kb in let one = list-append (b2-qshow q) kb in b2-letks mm_1296 f ks qs (%wsucc j) (the (List Word) (if %weq j #0 then one else list-append acc (cons #32 one))) kq_)))))
