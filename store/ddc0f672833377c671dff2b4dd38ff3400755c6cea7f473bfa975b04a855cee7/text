-- ---------------------------------------------------------------- fixed-width 32/64-bit immediates, ALU & IEEE-754 FP
a64-movz : Word → Word → Word → Lst Word
a64-movz rd imm16 hw =
  a64-insn (a64-or #3531603968 (a64-or (a64-shl (a64-and hw #3) #21) (a64-or (a64-shl (a64-and imm16 #65535) #5) (a64-and rd #31))))
