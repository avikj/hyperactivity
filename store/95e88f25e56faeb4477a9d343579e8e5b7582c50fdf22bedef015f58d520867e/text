-- ── 2. Unconditional Implicit-Midpoint Cochlear Hopf Passivity (ALL dt > 0) ──
-- Let sq = q0 + q1, sp = p0 + p1, r2 = sq^2 + sp^2, sat = r2 - 4*mu.
-- Implicit midpoint Hopf update:
--   2*dq = dt * (-w0*sp - sat*sq),   2*dp = dt * (w0*sq - sat*sp)
-- Exact discrete amplitude-squared change:
--   sq*(2*dq) + sp*(2*dp) == -dt * (r2 - 4*mu) * (sq^2 + sp^2)
-- Proves exact discrete SOS passivity for ALL dt > 0 and exact limit-cycle at r2 = 4*mu!
-- Variables (0..4): dt, w0, mu4, sqv, spv.
uf-midpoint-hopf-poly : (A : Type) → (A → A → A) → (A → A → A) → (BQ → A) → List A → A × A
uf-midpoint-hopf-poly A ad mu q vs =
  (λ g sub sq →
    let dt = g 0; w0 = g 1; mu4 = g 2; sqv = g 3; spv = g 4
        z   = q (fn-q 0 1)
        r2  = ad (sq sqv) (sq spv)
        sat = sub r2 mu4
        dq  = mu dt (sub (sub z (mu w0 spv)) (mu sat sqv))
        dp  = mu dt (sub (mu w0 sqv) (mu sat spv))
        lhs = ad (mu sqv dq) (mu spv dp)
        rhs = sub z (mu dt (mu sat r2))
    in (lhs , rhs))
  (λ n → al-nth A (q (fn-q 0 1)) n vs) (al-gsub A ad mu q) (al-gsq A mu)
