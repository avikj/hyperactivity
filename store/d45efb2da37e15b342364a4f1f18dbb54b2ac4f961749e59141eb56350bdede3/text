boc-feistel-dec : Word → Word
boc-feistel-dec y =
  let l4 = %wand (%wshr y #16) #65535
      r4 = %wand y #65535
      r3 = l4
      l3 = %wxor r4 (boc-rf16 #40727 r3)
      r2 = l3
      l2 = %wxor r3 (boc-rf16 #42435 r2)
      r1 = l2
      l1 = %wxor r2 (boc-rf16 #31161 r1)
      r0 = l1
      l0 = %wxor r1 (boc-rf16 #40503 r0)
  in %wor (%wshl l0 #16) r0
