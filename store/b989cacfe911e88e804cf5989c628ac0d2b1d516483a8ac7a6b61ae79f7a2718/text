b2-bump : Word → Word → (Word → Step W Word) → Step W Word
b2-bump mm_ p kq_ =
  b2-peek mm_ p (λ c → let mm_7798 = b2-dep mm_ c in let p_7800 = p in let i_7802 = (%wadd p_7800 #1) in scmd (w-load ((b2-a mm_7798 i_7802))) (λ x_7801 → let mm_7803 = b2-dep mm_7798 x_7801 in let x_7799 = x_7801 in let i = x_7799 in let p_7804 = p in let v_7805 = (%wsucc i) in let i_7806 = (%wadd p_7804 #1) in let v_7807 = v_7805 in scmd (w-store ((b2-a mm_7803 i_7806)) (v_7807)) (λ uu_7808 → let mm_7809 = hv2-u mm_7803 uu_7808 in kq_ (h4-depl mm_7809 (c)))))
