b2-streqg : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-streqg mm_ zero a b j n kq_ =
  kq_ (h4-depl mm_ (#1))
b2-streqg mm_ (suc f) a b j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#1))) else (let a_268 = a in let j_269 = j in scmd (w-load ((b2-a mm_ (%wadd a_268 (%wsucc j_269))))) (λ x_267 → let mm_270 = b2-dep mm_ x_267 in let x = x_267 in let a_272 = b in let j_273 = j in scmd (w-load ((b2-a mm_270 (%wadd a_272 (%wsucc j_273))))) (λ x_271 → let mm_274 = b2-dep mm_270 x_271 in let y = x_271 in if (not (%weq x y)) then (kq_ (h4-depl mm_274 (#0))) else (b2-streqg mm_274 f a b (%wsucc j) n kq_))))
