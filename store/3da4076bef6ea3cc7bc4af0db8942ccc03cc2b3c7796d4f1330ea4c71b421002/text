sf-15j-loop : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ → BQ
sf-15j-loop fuel a0 b0 c0 a1 b1 c1 a2 b2 c2 a3 b3 c3 a4 b4 c4 acc = case fuel of
  zero → acc
  suc x → sf-15j-loop x a0 b0 c0 a1 b1 c1 a2 b2 c2 a3 b3 c3 a4 b4 c4
    (if both (both (both (tri-ok a0 b0 x) (tri-ok a1 b1 x)) (both (tri-ok a2 b2 x) (tri-ok a3 b3 x))) (tri-ok a4 b4 x)
     then bq-add acc (sf-15j-term a0 b0 c0 a1 b1 c1 a2 b2 c2 a3 b3 c3 a4 b4 c4 x)
     else acc)
