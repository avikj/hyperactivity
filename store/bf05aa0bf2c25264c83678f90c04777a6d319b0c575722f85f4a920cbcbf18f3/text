qent-sum-cong : (S A : Type) → (z : A) → (add : A → A → A) → (f g : S → A) →
  ((s : S) → f s ≡ g s) → (xs : List S) → qent-sum S A z add f xs ≡ qent-sum S A z add g xs
qent-sum-cong S A z add f g h xs = case xs return λ l → qent-sum S A z add f l ≡ qent-sum S A z add g l of
  nil → refl
  cons x rest → λ i → add (h x i) (rec rest i)
