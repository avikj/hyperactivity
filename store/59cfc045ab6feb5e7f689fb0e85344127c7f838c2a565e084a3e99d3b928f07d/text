-- Section (3): Exact binary Wigner 9j symbol.
-- {j1 j2 j3; j4 j5 j6; j7 j8 j9} = (prod 6 outer Delta) * W9, where W9 is exact rational in BQ.
sf-ninej-term : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → BQ
sf-ninej-term j1 j2 j3 j4 j5 j6 j7 j8 j9 x =
  bq-mul
    (bq-mul (bq-mul (sf-bq-of-sign (not (odd x))) (sf-bq-of-nat (suc x)))
            (bq-mul (sf-delta2 j1 j9 x) (bq-mul (sf-delta2 j4 j8 x) (sf-delta2 j2 j6 x))))
    (bq-mul (sf-racah-W j1 j4 j7 j8 j9 x)
            (bq-mul (sf-racah-W j2 j5 j8 j4 x j6) (sf-racah-W j3 j6 j9 x j1 j2)))
