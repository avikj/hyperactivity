sf-extract-sub-go : List (List Word) → List Word → List SfSubHit → List SfSubHit
sf-extract-sub-go stk nil acc = acc
sf-extract-sub-go stk (cons c r) acc =
  if weq c #40 then
    sf-extract-sub-go (cons (cons c nil) (sf-push-all c stk)) r acc
  else if weq c #41 then
    case stk of
      nil → sf-extract-sub-go nil r acc
      cons top rest →
        let expr = h-rev (cons c top) nil in
        let len = fromNat (list-length expr) in
        sf-extract-sub-go (sf-push-all c rest) r
          (if andB (wlt #23 len) (wlt len #240)
           then cons (mkSub (sf-h1-go #14695981039346656037 expr) (sf-hash128 expr) expr) acc
           else acc)
  else
    sf-extract-sub-go (sf-push-all c stk) r acc
