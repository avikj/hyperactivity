grv-haar-sum : Nat → List GrvZ → R4dFrac → R4dFrac
grv-haar-sum twoR3 poly acc = case poly of
  nil → acc
  cons c rest →
    grv-force-fr R4dFrac
      (r4d-fr-add acc ((bst-bmul (bin-of-nat 8) (fst c) , bst-bmul (bin-of-nat 8) (snd c)) , bin-of-nat twoR3))
      (λ acc2 → grv-haar-sum (plus twoR3 2) rest acc2)
