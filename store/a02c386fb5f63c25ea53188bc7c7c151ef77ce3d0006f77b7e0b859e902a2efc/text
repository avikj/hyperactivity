grv-sg-cm : Nat → Nat → Nat → Nat → Nat → GrvZ
grv-sg-cm J J2 J3 J5 J6 =
  grv-z-mul (grv-z-of-nat (plus J 2))
    (grv-z-mul
      (grv-z-mul (grv-z-sub-nat (plus (plus J2 J3) 2) J) (grv-z-of-nat (plus (plus J2 J3) (plus 2 J))))
      (grv-z-mul (grv-z-sub-nat (plus (plus J5 J6) 2) J) (grv-z-of-nat (plus (plus J5 J6) (plus 2 J)))))
