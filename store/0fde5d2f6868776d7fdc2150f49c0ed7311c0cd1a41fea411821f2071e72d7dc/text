b2-consall : Word → Nat → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-consall mm_ zero ys j ck t s kq_ =
  kq_ (h4-depl mm_ (t))
b2-consall mm_ (suc f) ys j ck t s kq_ =
  if (%weq j #0) then (kq_ (h4-depl mm_ (t))) else (let a_8583 = ys in let j_8584 = (%wsub j #1) in scmd (w-load ((b2-a mm_ (%wadd a_8583 (%wsucc j_8584))))) (λ x_8582 → let mm_8585 = b2-dep mm_ x_8582 in let x = x_8582 in b2-arrl mm_8585 (cons x (cons t nil)) (λ xs → let mm_8586 = b2-dep mm_8585 xs in b2-Ctr mm_8586 ck xs s (λ c → let mm_8587 = b2-dep mm_8586 c in b2-consall mm_8587 f ys (%wsub j #1) ck c s kq_))))
