-- THEOREM 1B (Exact Self-Dual gamma = 1 Limit: C_1 + 1 = 0 identically for all spins j):
lor-selfdual-c1 : (A : Type) → (z one : A) → (add mul : A → A → A) → (neg : A → A) → LorRing A z one add mul neg →
  (j : A) → add (mul j j) (neg (mul (mul one j) (mul one j))) ≡ z
lor-selfdual-c1 A z one add mul neg r j =
  concat
    (cong (λ t → add (mul j j) (neg t))
          (λ i → mul (fst (snd (snd (snd r))) j i) (fst (snd (snd (snd r))) j i)))
    (fst r (mul j j))
