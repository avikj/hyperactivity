-- affine checks and auto-dups of a fork's binders (mode 0 fork, 1 sup-fork core)
h4-forkfix : Word → Nat → H4S → List H4B → Word → Word → Word → Word → Word → Word → Word → Word → (H4S × (Word × Word) → Step W Word) → Step W Word
h4-forkfix m zero s caps i d dd dyn lab bd lt rt k =
  k (h4-depl m ((s , (lt , rt))))
h4-forkfix m (suc f) s caps i d dd dyn lab bd lt rt k =
  if (%weq (cli-len-b caps) #0) then (k (h4-depl m ((s , (lt , rt))))) else (let c = h4-headb caps in let lvl = %wadd (%wadd d (%wmul i dd)) #1 in h4-uses m s lt lvl (if %weq dyn #1 then h4-BJV else h4-BJ0) (if %weq dyn #1 then #0 else lab) (λ u0 → let m60 = h4-dep m u0 in h4-uses m60 s rt (if %weq dyn #1 then %wsucc lvl else lvl) (if %weq dyn #1 then h4-BJV else h4-BJ1) (if %weq dyn #1 then #0 else lab) (λ u1 → let m61 = h4-dep m60 u1 in if (%weq (h4b-cl c) #1) then (h4-autodup m61 s lt lvl bd (if %weq dyn #1 then h4-BJV else h4-BJ0) (if %weq dyn #1 then #0 else lab) u0 (λ r0 → let m62 = h4-dpw m61 r0 in h4-autodup m62 (fst r0) rt (if %weq dyn #1 then %wsucc lvl else lvl) bd (if %weq dyn #1 then h4-BJV else h4-BJ1) (if %weq dyn #1 then #0 else lab) u1 (λ r1 → let m63 = h4-dpw m62 r1 in h4-forkfix m63 f (fst r1) (h4-tailb caps) (%wsucc i) d dd dyn lab bd (snd r0) (snd r1) k))) else (if (%wlt #1 u0) then ((h4-perr-affine s (h4b-nm c) u0)) else (if (%wlt #1 u1) then ((h4-perr-affine s (h4b-nm c) u1)) else (h4-forkfix m61 f s (h4-tailb caps) (%wsucc i) d dd dyn lab bd lt rt k))))))
