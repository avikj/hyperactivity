r4d-mul-neg1 : (A : Type) → (z one : A) → (add mul : A → A → A) → (neg : A → A) →
  LorRing A z one add mul neg → (w : A) → mul (neg one) w ≡ neg w
r4d-mul-neg1 A z one add mul neg r w =
  lor-tr A (mul (neg one) w) (neg (mul one w)) (neg w)
    (r4d-neg-ml A z one add mul neg r one w)
    (cong neg (r4d-one-l A z one add mul neg r w))
