-- the heap chain of fields, as a list
h4-chain : Word → Nat → Word → List Word → (List Word → Step W Word) → Step W Word
h4-chain m zero c acc k =
  k (h4-depl m ((hv2-rev acc)))
h4-chain m (suc f) c acc k =
  if (%weq c #0) then (k (h4-depl m ((hv2-rev acc)))) else (h4-rd m c (λ x → let m55 = h4-dep m x in h4-rd m55 (%wsucc c) (λ n → let m56 = h4-dep m55 n in h4-chain m56 f n (cons x acc) k)))
