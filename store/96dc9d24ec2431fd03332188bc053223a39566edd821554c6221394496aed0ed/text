b2-replg : Word → Nat → Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-replg mm_ zero vs v w ob j n kq_ =
  kq_ (h4-depl mm_ (ob))
b2-replg mm_ (suc f) vs v w ob j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (ob))) else (let a_5585 = vs in let j_5586 = j in scmd (w-load ((b2-a mm_ (%wadd a_5585 (%wsucc j_5586))))) (λ x_5584 → let mm_5587 = b2-dep mm_ x_5584 in let u = x_5584 in let a_5588 = ob in let j_5589 = j in let v_5590 = (the Word (if %weq u v then w else u)) in scmd (w-store ((b2-a mm_5587 (%wadd a_5588 (%wsucc j_5589)))) (v_5590)) (λ uu_5591 → let mm_5592 = hv2-u mm_5587 uu_5591 in b2-replg mm_5592 f vs v w ob (%wsucc j) n kq_)))
