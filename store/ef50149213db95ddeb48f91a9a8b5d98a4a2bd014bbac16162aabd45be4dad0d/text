b2-firstnq : Word → Nat → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-firstnq mm_ zero tel j n kq_ =
  kq_ (h4-depl mm_ (hv2-none))
b2-firstnq mm_ (suc f) tel j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (hv2-none))) else (let a_7502 = tel in let j_7503 = j in scmd (w-load ((b2-a mm_ (%wadd a_7502 (%wsucc j_7503))))) (λ x_7501 → let mm_7504 = b2-dep mm_ x_7501 in let c = x_7501 in let i_7506 = (%wadd c #3) in scmd (w-load ((b2-a mm_7504 i_7506))) (λ x_7505 → let mm_7507 = b2-dep mm_7504 x_7505 in let vT = x_7505 in let t_7509 = vT in scmd (w-load ((b2-a mm_7507 t_7509))) (λ x_7508 → let mm_7510 = b2-dep mm_7507 x_7508 in let tg = (%wand x_7508 #255) in if (not (%weq tg b2-QNT)) then (kq_ (h4-depl mm_7510 (j))) else (b2-firstnq mm_7510 f tel (%wsucc j) n kq_)))))
