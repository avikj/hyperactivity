emg-li-build : List (Nat × (Nat × Nat)) → List EmgLiState
emg-li-build ts = case ts of
  nil → nil
  cons t tr →
    (λ u1 u2 d →
      emg-li-app
        (emg-li-e3 u1 u2 d (emg-li-q 1 u1 u2 d) (emg-li-q 2 u1 u2 d) (emg-li-q 3 u1 u2 d) h3d-range1)
        (emg-li-build tr))
    (fst t) (fst (snd t)) (snd (snd t))
