-- Exact CHSH combination S = E(a0,b0) + E(a0,b1) + E(a1,b0) - E(a1,b1) in BQ.
qe-singlet-CHSH : (BQ × BQ) → (BQ × BQ) → (BQ × BQ) → (BQ × BQ) → BQ
qe-singlet-CHSH a0 a1 b0 b1 =
  bq-add (bq-add (qe-singlet-E a0 b0) (qe-singlet-E a0 b1))
         (bq-add (qe-singlet-E a1 b0) (qe-bq-neg (qe-singlet-E a1 b1)))
