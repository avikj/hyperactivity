b2-ctrfind : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-ctrfind mm_ zero cs k j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-ctrfind mm_ (suc f) cs k j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_9857 = cs in let j_9858 = j in scmd (w-load ((b2-a mm_ (%wadd v_9857 #2)))) (λ d_9856 → let mm_9859 = b2-dep mm_ d_9856 in scmd (w-load ((b2-a mm_9859 (%wadd d_9856 (%wsucc j_9858))))) (λ x_9855 → let mm_9860 = b2-dep mm_9859 x_9855 in let c = x_9855 in let t_9862 = c in let j_9863 = #0 in scmd (w-load ((b2-a mm_9860 (%wadd t_9862 (%wadd #2 j_9863))))) (λ x_9861 → let mm_9864 = b2-dep mm_9860 x_9861 in let ck = x_9861 in if (%weq ck k) then (kq_ (h4-depl mm_9864 (c))) else (b2-ctrfind mm_9864 f cs k (%wsucc j) n kq_)))))
