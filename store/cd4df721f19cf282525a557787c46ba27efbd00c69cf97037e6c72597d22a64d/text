qent-sum-zero : (S A : Type) → (z : A) → (add mul : A → A → A) → QentSR A z add mul →
  (xs : List S) → qent-sum S A z add (λ s → z) xs ≡ z
qent-sum-zero S A z add mul sr xs = case xs return λ l → qent-sum S A z add (λ s → z) l ≡ z of
  nil → refl
  cons x rest → concat (cong (λ t → add z t) (rec rest)) (qent-add-zl A z add mul sr z)
