-- charge 1: in twice on edges 0 and 1, out on edge 3; balanced (1, 0, 0, 0)
charge-one : loops-reach (zero-word (bare (cons sq-one (cons sq-one (cons sq-zero (cons (sq-neg sq-one) nil))))))
  (bare (cons sq-one (cons sq-one (cons sq-zero (cons (sq-neg sq-one) nil)))))
  (cons sq-one (cons sq-zero (cons sq-zero (cons sq-zero nil)))) ≡ true
charge-one = λ i → true
