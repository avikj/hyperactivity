b2-nstr : Word → Word → (Word → Step W Word) → Step W Word
b2-nstr mm_ id kq_ =
  scmd (w-load ((b2-HIDS mm_))) (λ ids → let mm_276 = b2-dep mm_ ids in let v_279 = ids in let j_280 = (%wsub id #1) in scmd (w-load ((b2-a mm_276 (%wadd v_279 #2)))) (λ d_278 → let mm_281 = b2-dep mm_276 d_278 in scmd (w-load ((b2-a mm_281 (%wadd d_278 (%wsucc j_280))))) (λ x_277 → let mm_282 = b2-dep mm_281 x_277 in let r = x_277 in let i_284 = r in scmd (w-load ((b2-a mm_282 i_284))) (λ x_283 → let mm_285 = b2-dep mm_282 x_283 in let s = x_283 in kq_ (h4-depl mm_285 (s))))))
