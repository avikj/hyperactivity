-- Scaled integer cycle surplus `P_scaled(m, x) = 2*m*x - x^2` where `2*m = D_eff * g`:
-- At `x* = m`, `P_scaled(m, m) = m^2`, whereas for any `x`, `P_scaled(m, x) <= m^2`!
bl-concave-surplus : Word → Word → Word
bl-concave-surplus m x =
  let gross = %wmul (%wmul #2 m) x
      impact = %wmul x x
  in if %wlt gross impact then #0 else %wsub gross impact
