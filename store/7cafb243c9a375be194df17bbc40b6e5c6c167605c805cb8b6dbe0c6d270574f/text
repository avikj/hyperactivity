-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_13240 = seen in let j_13241 = j in scmd (w-load ((b2-a mm_ (%wadd v_13240 #2)))) (λ d_13239 → let mm_13242 = b2-dep mm_ d_13239 in scmd (w-load ((b2-a mm_13242 (%wadd d_13239 (%wsucc j_13241))))) (λ x_13238 → let mm_13243 = b2-dep mm_13242 x_13238 in let e = x_13238 in let i_13245 = e in scmd (w-load ((b2-a mm_13243 i_13245))) (λ x_13244 → let mm_13246 = b2-dep mm_13243 x_13244 in let x = x_13244 in if (%weq x p) then (kq_ (h4-depl mm_13246 (e))) else (b2-seenat mm_13246 f seen p (%wsucc j) n kq_)))))
