h4-mk2at : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-mk2at m at tag ext a b k =
  scmd (w-store ((h4-ha m at)) (a)) (λ u15 → let m16 = hv2-u m u15 in scmd (w-store ((h4-ha m16 (%wadd at #1))) (b)) (λ u17 → let m18 = hv2-u m16 u17 in k (h4-depl m18 ((h4-new tag ext at)))))
