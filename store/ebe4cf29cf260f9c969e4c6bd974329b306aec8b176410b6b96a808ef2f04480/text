b2-more : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-more mm_ p col kq_ =
  b2-at mm_ p ";" (λ a → let mm_7255 = b2-dep mm_ a in if (%weq a #1) then (kq_ (h4-depl mm_7255 (#1))) else (b2-pstr mm_7255 p (λ s → let mm_7256 = b2-dep mm_7255 s in let p_7258 = p in let i_7260 = (%wadd p_7258 #1) in scmd (w-load ((b2-a mm_7256 i_7260))) (λ x_7259 → let mm_7261 = b2-dep mm_7256 x_7259 in let x_7257 = x_7259 in let i = x_7257 in let a_7263 = s in scmd (w-load ((b2-a mm_7261 a_7263))) (λ x_7262 → let mm_7264 = b2-dep mm_7261 x_7262 in let n = x_7262 in b2-col mm_7264 s i (λ c → let mm_7265 = b2-dep mm_7264 c in kq_ (h4-depl mm_7265 ((hv2-b (andB (%wlt i n) (%weq c col)))))))))))
