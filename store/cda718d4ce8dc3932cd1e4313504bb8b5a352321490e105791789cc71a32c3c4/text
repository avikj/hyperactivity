-- the seen entry of a path, or 0
b2-seenat : Word → Nat → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
b2-seenat mm_ zero seen p j n kq_ =
  kq_ (h4-depl mm_ (#0))
b2-seenat mm_ (suc f) seen p j n kq_ =
  if (%weq j n) then (kq_ (h4-depl mm_ (#0))) else (let v_14372 = seen in let j_14373 = j in scmd (w-load ((b2-a mm_ (%wadd v_14372 #2)))) (λ d_14371 → let mm_14374 = b2-dep mm_ d_14371 in scmd (w-load ((b2-a mm_14374 (%wadd d_14371 (%wsucc j_14373))))) (λ x_14370 → let mm_14375 = b2-dep mm_14374 x_14370 in let e = x_14370 in let i_14377 = e in scmd (w-load ((b2-a mm_14375 i_14377))) (λ x_14376 → let mm_14378 = b2-dep mm_14375 x_14376 in let x = x_14376 in if (%weq x p) then (kq_ (h4-depl mm_14378 (e))) else (b2-seenat mm_14378 f seen p (%wsucc j) n kq_)))))
