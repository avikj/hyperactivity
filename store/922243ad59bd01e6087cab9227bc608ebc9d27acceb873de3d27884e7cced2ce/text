-- the file of a span (0 when there is none)
b2-sfile : Word → Word → (Word → Step W Word) → Step W Word
b2-sfile mm_ s kq_ =
  if (%weq s #0) then (kq_ (h4-depl mm_ (#0))) else (let t_9637 = s in let j_9638 = #0 in scmd (w-load ((b2-a mm_ (%wadd t_9637 (%wadd #2 j_9638))))) (λ x_9636 → let mm_9639 = b2-dep mm_ x_9636 in let fl = x_9636 in kq_ (h4-depl mm_9639 (fl))))
