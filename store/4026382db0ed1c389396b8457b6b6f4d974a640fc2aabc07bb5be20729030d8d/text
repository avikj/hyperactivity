-- a tele_check's ret(): the last All's body at the last argument, or the telescope itself
b2-tret : Word → Word → Word → (Word → Step W Word) → Step W Word
b2-tret mm_ bk tc kq_ =
  let i_10859 = (%wadd tc #2) in scmd (w-load ((b2-a mm_ i_10859))) (λ x_10858 → let mm_10860 = b2-dep mm_ x_10858 in let lb = x_10858 in if (%weq lb #0) then (let i_10862 = (%wadd tc #4) in scmd (w-load ((b2-a mm_10860 i_10862))) (λ x_10861 → let mm_10863 = b2-dep mm_10860 x_10861 in let t = x_10861 in kq_ (h4-depl mm_10863 (t)))) else (let i_10865 = (%wadd tc #3) in scmd (w-load ((b2-a mm_10860 i_10865))) (λ x_10864 → let mm_10866 = b2-dep mm_10860 x_10864 in let lx = x_10864 in b2-body mm_10866 bk lb lx (λ r → let mm_10867 = b2-dep mm_10866 r in if (%weq r b2-ERR) then (kq_ (h4-depl mm_10867 b2-ERR)) else (kq_ (h4-depl mm_10867 (r)))))))
