h4-mk3 : Word → Word → Word → Word → Word → Word → (Word → Step W Word) → Step W Word
h4-mk3 mm_ tag ext a b c kq_ =
  h4-alloc mm_ #3 (λ at → let mm_22 = h4-dep mm_ at in scmd (w-store ((h4-ha mm_22 at)) (a)) (λ uu_23 → let mm_24 = hv2-u mm_22 uu_23 in scmd (w-store ((h4-ha mm_24 (%wadd at #1))) (b)) (λ uu_25 → let mm_26 = hv2-u mm_24 uu_25 in scmd (w-store ((h4-ha mm_26 (%wadd at #2))) (c)) (λ uu_27 → let mm_28 = hv2-u mm_26 uu_27 in kq_ (h4-depl mm_28 ((h4-new tag ext at)))))))
