-- one mention's place in the chain: [joining words, code, language, term, page, transliteration, gloss]
e-link : List Word → List Word → List (List Word) → List (List Word)
e-link plain name m = cons (e-last-chars (toNat #24) (e-strip plain)) (cons (e-nth zero m) (cons name (e-drop-n-l (toNat #1) m)))
