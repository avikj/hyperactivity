-- src/hvm.c boot_redex: the root emptied, and a redex
hio-boot : Word → Word → Word → (Word → Step W Word) → Step W Word
hio-boot m a b k =
  hr-st m (hr-va m #0) #0 (λ m1 →
  scmd (w-load (%wadd m1 #16)) (λ t →
  hr-st m1 (hr-ba m1 t) (hv2-pair a b) (λ m2 →
  hr-st m2 (%wadd m2 #16) (%wsucc t) k)))
