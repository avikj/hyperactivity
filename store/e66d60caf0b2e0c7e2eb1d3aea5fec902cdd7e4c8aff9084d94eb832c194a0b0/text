-- {k ½ kt; kt 0 k} from doubled K, KT: sign (−1)^((K+1+KT)/2), square 1/((KT+1)(K+1))
vh-zero-at : Nat → Nat → Bool
vh-zero-at k kt = (λ s → both (bit-eq (fst s) (not (bin-bit1 (bin-of-nat (plus (suc k) kt))))) (eqb (times (fst (snd s)) (times (suc kt) (suc k))) (snd (snd s)))) (sixj k 1 kt kt 0 k)
