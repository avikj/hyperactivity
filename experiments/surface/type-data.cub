-- Item 8: #type of a data type's name (tracks/H-obs.md, Found: `#type o-Q2` ended the run).
data Td1 (A : Type) = td1-in (a : A)
data Td2 = td2-a | td2-b
data Td3 (A : Type) (B : Type) = td3-in (a : A) (b : B)

#type Td1
#type Td2
#type Td3 Nat
#type List
#type Td1 Nat

-- a command that cannot be answered is its own failure, the load going on
#type no-such-name

td-after : Td2
td-after = td2-a
