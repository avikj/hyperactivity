-- Layer: example: the typed linear arithmetic of lib/library/lin.cub at work (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
import "../../lib/core.cub"
import "../../lib/library/lin.cub"
#same dec-eq (cwop #2 (cvar #0) (cwlit #1)) (cwsucc (cvar #0)) = true
#same dec-le (cvar #0) (cwop #2 (cvar #0) (cvar #1)) = true
#same check-cert (lcons (cvar #0 , cvar #1) lnil) (lcons #1 lnil) (cvar #0) (cwop #2 (cvar #1) (cwlit #2)) = true
#same find-cert #2 (lcons (cvar #0 , cvar #1) lnil) (cvar #0) (cwop #2 (cvar #1) (cwlit #2)) = some (lcons #1 lnil)
#same omega-cert (lcons (cvar #0 , cvar #1) lnil) (cvar #0) (cwop #2 (cvar #1) (cwlit #2)) = some (lcons #1 lnil)
