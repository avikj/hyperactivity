-- Layer: example: the typed rewriting of lib/capacities/rewrite.cub at work (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
import "../../lib/library.cub"
#same code-shift #0 #2 (clam (capp (cvar #0) (cvar #1))) = clam (capp (cvar #0) (cvar #3))
#same code-same (ccon #1 #2 (lcons (cvar #0) lnil) lnil) (ccon #1 #2 (lcons (cvar #0) lnil) lnil) = true
#same mt #0 (capp (cglob #5) (cvar #0)) #0 (capp (cglob #5) (cwlit #7)) mnil = some (mcons #0 (cwlit #7) mnil)
#same rewrite-first (rule #0 (capp (cglob #5) (cvar #0)) (cvar #0) nojust) (clam (capp (cglob #5) (cwlit #7))) = some (clam (cwlit #7))
#same fst (rules-orient (lcons (rule #0 (capp (cglob #5) (cvar #0)) (cvar #0) nojust) lnil)) = lcons (rule #0 (capp (cglob #5) (cvar #0)) (cvar #0) nojust) lnil
