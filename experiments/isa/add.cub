-- experiments/isa/add.cub — one instruction under the imported model, operands as variables.
-- 48 01 C8 = add rax, rcx at 0x400000.
import "../../lib/isa/x86/run.cub"
add-state : Word → Word → X86
add-state a c = x86-set-rax a (x86-set-rcx c (x86-set-rip #4194304 (x86-poke #3 #4194304 #13107528 x86-user64)))
#show λ (a c : Word) → x86-rip (snd (x86-step (add-state a c)))
#show λ (a c : Word) → x86-rax (snd (x86-step (add-state a c)))
#show λ (a c : Word) → fst (x86-step (add-state a c))
