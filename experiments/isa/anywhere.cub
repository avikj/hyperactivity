cons s16 (cons s17 (cons s18 (cons s19 (cons s20 (cons s21 (cons s22 (cons s23 (cons s24 (cons s25 (cons s26 (cons s27 (cons s28 (cons s29 (cons s30 (cons s31 (cons s32 (cons s33 (cons s34 (cons s35 (cons s36 (cons s37 (cons s38 (cons s39 (cons s40 (cons s41 (cons s42 (cons s43 (cons false (cons true (cons true nil))))))))))))))))))))))))))))))))))))))))))))))))))) ≡ (nbw (cons a0 (cons a1 (cons a2 (cons a3 (cons a4 (cons a5 (cons a6 (cons a7 (cons a8 (cons a9 (cons a10 (cons a11 (cons a12 (cons a13 (cons a14 (cons a15 (cons a16 (cons a17 (cons a18 (cons a19 (cons a20 (cons a21 (cons a22 (cons a23 (cons a24 (cons a25 (cons a26 (cons a27 (cons a28 (cons a29 (cons a30 (cons a31 (cons a32 (cons a33 (cons a34 (cons a35 (cons a36 (cons a37 (cons a38 (cons a39 (cons a40 (cons a41 (cons a42 (cons a43 (cons a44 (cons a45 (cons a46 (cons a47 (cons a48 (cons a49 (cons a50 (cons a51 (cons a52 (cons a53 (cons a54 (cons a55 (cons a56 (cons a57 (cons a58 (cons a59 (cons a60 (cons a61 (cons a62 (cons a63 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
sym-pp a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 a32 a33 a34 a35 a36 a37 a38 a39 a40 a41 a42 a43 a44 a45 a46 a47 a48 a49 a50 a51 a52 a53 a54 a55 a56 a57 a58 a59 a60 a61 a62 a63 p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15 p16 p17 p18 p19 p20 p21 p22 p23 p24 p25 p26 p27 p28 p29 p30 p31 p32 p33 p34 p35 p36 p37 p38 p39 p40 p41 p42 p43 s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19 s20 s21 s22 s23 s24 s25 s26 s27 s28 s29 s30 s31 s32 s33 s34 s35 s36 s37 s38 s39 s40 s41 s42 s43 = refl
