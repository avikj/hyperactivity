-- experiments/isa/pushpop.cub — push rax; pop rcx under the imported x86 semantics: the word popped is the
-- word pushed, for every word below 2^64. Loaded after the library, lib/prim.cub, lib/word.cub,
-- lib/bits.cub, lib/isa/x86/ORDER's files and lib/isa/x86/run.cub.
