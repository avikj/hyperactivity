-- push rax; pop rcx: the word popped is the word pushed
pp-state : Word → X86
pp-state a = x86-set-rax a (x86-set-rsp #117440512 (x86-set-rip #4194304 (x86-poke #2 #4194304 #22864 x86-user64)))

pp-ok : (b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28 b29 b30 b31 b32 b33 b34 b35 b36 b37 b38 b39 b40 b41 b42 b43 b44 b45 b46 b47 b48 b49 b50 b51 b52 b53 b54 b55 b56 b57 b58 b59 b60 b61 b62 b63 : Bool) →
        x86-rcx (snd (x86-run #2 (pp-state (nbw (cons b0 (cons b1 (cons b2 (cons b3 (cons b4 (cons b5 (cons b6 (cons b7 (cons b8 (cons b9 (cons b10 (cons b11 (cons b12 (cons b13 (cons b14 (cons b15 (cons b16 (cons b17 (cons b18 (cons b19 (cons b20 (cons b21 (cons b22 (cons b23 (cons b24 (cons b25 (cons b26 (cons b27 (cons b28 (cons b29 (cons b30 (cons b31 (cons b32 (cons b33 (cons b34 (cons b35 (cons b36 (cons b37 (cons b38 (cons b39 (cons b40 (cons b41 (cons b42 (cons b43 (cons b44 (cons b45 (cons b46 (cons b47 (cons b48 (cons b49 (cons b50 (cons b51 (cons b52 (cons b53 (cons b54 (cons b55 (cons b56 (cons b57 (cons b58 (cons b59 (cons b60 (cons b61 (cons b62 (cons b63 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) ≡ nbw (cons b0 (cons b1 (cons b2 (cons b3 (cons b4 (cons b5 (cons b6 (cons b7 (cons b8 (cons b9 (cons b10 (cons b11 (cons b12 (cons b13 (cons b14 (cons b15 (cons b16 (cons b17 (cons b18 (cons b19 (cons b20 (cons b21 (cons b22 (cons b23 (cons b24 (cons b25 (cons b26 (cons b27 (cons b28 (cons b29 (cons b30 (cons b31 (cons b32 (cons b33 (cons b34 (cons b35 (cons b36 (cons b37 (cons b38 (cons b39 (cons b40 (cons b41 (cons b42 (cons b43 (cons b44 (cons b45 (cons b46 (cons b47 (cons b48 (cons b49 (cons b50 (cons b51 (cons b52 (cons b53 (cons b54 (cons b55 (cons b56 (cons b57 (cons b58 (cons b59 (cons b60 (cons b61 (cons b62 (cons b63 nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
pp-ok b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28 b29 b30 b31 b32 b33 b34 b35 b36 b37 b38 b39 b40 b41 b42 b43 b44 b45 b46 b47 b48 b49 b50 b51 b52 b53 b54 b55 b56 b57 b58 b59 b60 b61 b62 b63 = be-sound ppe (cons (cons b0 (cons b1 (cons b2 (cons b3 (cons b4 (cons b5 (cons b6 (cons b7 (cons b8 (cons b9 (cons b10 (cons b11 (cons b12 (cons b13 (cons b14 (cons b15 (cons b16 (cons b17 (cons b18 (cons b19 (cons b20 (cons b21 (cons b22 (cons b23 (cons b24 (cons b25 (cons b26 (cons b27 (cons b28 (cons b29 (cons b30 (cons b31 (cons b32 (cons b33 (cons b34 (cons b35 (cons b36 (cons b37 (cons b38 (cons b39 (cons b40 (cons b41 (cons b42 (cons b43 (cons b44 (cons b45 (cons b46 (cons b47 (cons b48 (cons b49 (cons b50 (cons b51 (cons b52 (cons b53 (cons b54 (cons b55 (cons b56 (cons b57 (cons b58 (cons b59 (cons b60 (cons b61 (cons b62 (cons b63 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) nil)

-- for every word below 2^64
