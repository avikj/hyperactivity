-- experiments/isa/e1.cub — a compiled program run under the imported x86 semantics: the term
-- jop jxor (jop jand (jvar 0) (jlit 255)) (jvar 1), compiled (lib/compile/stack.cub) and encoded
-- (lib/compile/enc.cub), pop rax after it, from a stack holding x then y: after its 13
-- instructions rax is jev's value, (x and 255) xor y, and no step faults. By computation: on words
-- given by their bits the model's run and jev compute the same bits (e1-bits, refl); every word
-- below 2^64 is the word of its bits (e1-ok). Loaded after lib/compile/enc.cub and the x86 files.

cs-store : Word → Word → X86 → X86
cs-store a v s = snd (wml64 a v s)

cs-poke : List Word → Word → X86 → X86
cs-poke nil a s = s
cs-poke (cons b r) a s = cs-poke r (%wadd a #1) (x86-poke #1 a b s)

e1-t : JTm
e1-t = jop jxor (jop jand (jvar zero) (jlit #255)) (jvar (suc zero))

e1-g : List JTy
e1-g = cons jw (cons jw nil)

e1-bytes : List Word
e1-bytes = enc-ap (enc (jcx e1-t e1-g jw (zero , (suc zero , unit)) kdone)) (cons #88 nil)

e1-base : X86
e1-base = cs-poke e1-bytes #4194304 x86-user64



e1-st : Word → Word → X86
e1-st x y = x86-set-rsp #117440512 (x86-set-rip #4194304 (cs-store #117440520 y (cs-store #117440512 x e1-base)))

-- on two words given by their bits, the run's rax is jev's value, by computation
e1-bits : (b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28 b29 b30 b31 b32 b33 b34 b35 b36 b37 b38 b39 b40 b41 b42 b43 b44 b45 b46 b47 b48 b49 b50 b51 b52 b53 b54 b55 b56 b57 b58 b59 b60 b61 b62 b63 : Bool) → (c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31 c32 c33 c34 c35 c36 c37 c38 c39 c40 c41 c42 c43 c44 c45 c46 c47 c48 c49 c50 c51 c52 c53 c54 c55 c56 c57 c58 c59 c60 c61 c62 c63 : Bool) →
          x86-rax (snd (x86-run #13 (e1-st (nbw (cons b0 (cons b1 (cons b2 (cons b3 (cons b4 (cons b5 (cons b6 (cons b7 (cons b8 (cons b9 (cons b10 (cons b11 (cons b12 (cons b13 (cons b14 (cons b15 (cons b16 (cons b17 (cons b18 (cons b19 (cons b20 (cons b21 (cons b22 (cons b23 (cons b24 (cons b25 (cons b26 (cons b27 (cons b28 (cons b29 (cons b30 (cons b31 (cons b32 (cons b33 (cons b34 (cons b35 (cons b36 (cons b37 (cons b38 (cons b39 (cons b40 (cons b41 (cons b42 (cons b43 (cons b44 (cons b45 (cons b46 (cons b47 (cons b48 (cons b49 (cons b50 (cons b51 (cons b52 (cons b53 (cons b54 (cons b55 (cons b56 (cons b57 (cons b58 (cons b59 (cons b60 (cons b61 (cons b62 (cons b63 nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) (nbw (cons c0 (cons c1 (cons c2 (cons c3 (cons c4 (cons c5 (cons c6 (cons c7 (cons c8 (cons c9 (cons c10 (cons c11 (cons c12 (cons c13 (cons c14 (cons c15 (cons c16 (cons c17 (cons c18 (cons c19 (cons c20 (cons c21 (cons c22 (cons c23 (cons c24 (cons c25 (cons c26 (cons c27 (cons c28 (cons c29 (cons c30 (cons c31 (cons c32 (cons c33 (cons c34 (cons c35 (cons c36 (cons c37 (cons c38 (cons c39 (cons c40 (cons c41 (cons c42 (cons c43 (cons c44 (cons c45 (cons c46 (cons c47 (cons c48 (cons c49 (cons c50 (cons c51 (cons c52 (cons c53 (cons c54 (cons c55 (cons c56 (cons c57 (cons c58 (cons c59 (cons c60 (cons c61 (cons c62 (cons c63 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) ≡ jev e1-t e1-g jw (nbw (cons b0 (cons b1 (cons b2 (cons b3 (cons b4 (cons b5 (cons b6 (cons b7 (cons b8 (cons b9 (cons b10 (cons b11 (cons b12 (cons b13 (cons b14 (cons b15 (cons b16 (cons b17 (cons b18 (cons b19 (cons b20 (cons b21 (cons b22 (cons b23 (cons b24 (cons b25 (cons b26 (cons b27 (cons b28 (cons b29 (cons b30 (cons b31 (cons b32 (cons b33 (cons b34 (cons b35 (cons b36 (cons b37 (cons b38 (cons b39 (cons b40 (cons b41 (cons b42 (cons b43 (cons b44 (cons b45 (cons b46 (cons b47 (cons b48 (cons b49 (cons b50 (cons b51 (cons b52 (c