-- experiments/isa/classes.cub — one instruction of each class lib/capacities/x86.cub's template table
-- emits, under the imported model, the data operands variables.
-- Written by a script from the byte lists in the comments; the numerals are those bytes,
-- lowest address lowest. The state: the bytes at 0x400000 (a ret at 0x400010), rip there,
-- rsp = rbp = 0x7fff0000 with the stack's 16 bytes below rbp holding the variables p and q,
-- rax = a, rcx = c, rdx = d.
import "../../lib/languages/isa/x86/run.cub"
cls-base : Word → Word → Word → Word → Word → X86
cls-base a c d p q =
  x86-set-rax a (x86-set-rcx c (x86-set-rdx d (x86-set-rsp #2147418112 (x86-set-rbp #2147418112
    (x86-set-rip #4194304 (x86-poke #8 #2147418104 p (x86-poke #8 #2147418096 q (x86-poke #1 #4194320 #195 x86-user64))))))))
cls-at : (n : Word) → Word → X86 → X86
cls-at n bytes s = x86-poke n #4194304 bytes s
cls-m8 : X86 → Word
cls-m8 s = x86-read-mem #8 #2147418104 s
-- mov-rcx-rax: mov rcx, rax   (48 89 C1)
cls-mov-rcx-rax : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-mov-rcx-rax a c d p q = x86-run #1 (cls-at #3 #12683592 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-mov-rcx-rax a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-mov-rcx-rax a c d p q))
#show λ (a c d p q : Word) → x86-rcx (snd (cls-mov-rcx-rax a c d p q))
-- mov-rax-imm: mov rax, 0x0807060504030201   (48 B8 01 02 03 04 05 06 07 08)
cls-mov-rax-imm : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-mov-rax-imm a c d p q = x86-run #1 (cls-at #10 #37908492828823204771912 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-mov-rax-imm a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-mov-rax-imm a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-mov-rax-imm a c d p q))
-- ld-rbp: mov rax, [rbp-8]   (48 8B 85 F8 FF FF FF)
cls-ld-rbp : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-ld-rbp a c d p q = x86-run #1 (cls-at #7 #72057593912462152 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-ld-rbp a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-ld-rbp a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-ld-rbp a c d p q))
-- st-rbp: mov [rbp-8], rax   (48 89 85 F8 FF FF FF)
cls-st-rbp : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-st-rbp a c d p q = x86-run #1 (cls-at #7 #72057593912461640 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-st-rbp a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-st-rbp a c d p q))
#show λ (a c d p q : Word) → cls-m8 (snd (cls-st-rbp a c d p q))
-- lea-rbp: lea rax, [rbp-8]   (48 8D 85 F8 FF FF FF)
cls-lea-rbp : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-lea-rbp a c d p q = x86-run #1 (cls-at #7 #72057593912462664 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-lea-rbp a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-lea-rbp a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-lea-rbp a c d p q))
-- ld8: movzx eax, byte [rax+8]   (0F B6 40 08)
cls-ld8 : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-ld8 a c d p q = x86-run #1 (cls-at #4 #138458639 (cls-base #2147418096 c d p q))
#show λ (a c d p q : Word) → fst (cls-ld8 a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-ld8 a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-ld8 a c d p q))
-- st8: mov [rax+8], dl   (88 50 08)
cls-st8 : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-st8 a c d p q = x86-run #1 (cls-at #3 #544904 (cls-base #2147418096 c d p q))
#show λ (a c d p q : Word) → fst (cls-st8 a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-st8 a c d p q))
#show λ (a c d p q : Word) → x86-read-mem #8 #2147418104 (snd (cls-st8 a c d p q))
-- sub: sub rax, rcx   (48 29 C8)
cls-sub : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-sub a c d p q = x86-run #1 (cls-at #3 #13117768 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-sub a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-sub a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-sub a c d p q))
