cls-imul : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-imul a c d p q = x86-run #1 (cls-at #4 #3249475400 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-imul a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-imul a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-imul a c d p q))
-- and: and rax, rcx   (48 21 C8)
cls-and : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-and a c d p q = x86-run #1 (cls-at #3 #13115720 (cls-base a c d p q))
#show λ (a c d p q : Word) → fst (cls-and a c d p q)
#show λ (a c d p q : Word) → x86-rip (snd (cls-and a c d p q))
#show λ (a c d p q : Word) → x86-rax (snd (cls-and a c d p q))
