cls-rep-movsb : Word → Word → Word → Word → Word → Outc exception Unit × X86
cls-rep-movsb a c d p q = x86-run #1 (x86-set-rsi #2147418096 (x86-set-rdi #2147418104 (cls-at #2 #42227 (cls-base a #3 d p q))))
