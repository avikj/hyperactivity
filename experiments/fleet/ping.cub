-- Two nodes exchanging one message (loaded after lib/net.cub and lib/fleet.cub). Node 0 sends 42
-- to node 1 and stops; node 1 receives until a message arrives (at most three tries) and stops
-- with it. The run is a recorded list of choices; the result is node 1's tree of steps, done
-- with the message.
ping-send : Proc {lzero} (NetSig Word) Word
ping-send = bind {lzero} {NetSig Word} {Unit} {Word} (net-send {lzero} {Word} 1 #42) (λ u → ret {lzero} {NetSig Word} {Word} #0)
ping-recv : Nat → Proc {lzero} (NetSig Word) Word
ping-recv n = case n of
  zero → ret {lzero} {NetSig Word} {Word} #0
  suc k → bind {lzero} {NetSig Word} {Rcv Word} {Word} (net-recv {lzero} {Word}) (λ r → case r of r-timeout → rec k; r-msg f m → ret {lzero} {NetSig Word} {Word} m)
ping-nodes : NodeId → Proc {lzero} (NetSig Word) Word
ping-nodes i = case i of zero → ping-send; suc j → ping-recv 3
ping-init : FState Word (Step (NetSig Word) Word)
ping-init = procs-init {Word} {Word} ping-nodes
ping-result : Step (NetSig Word) Word → Word
ping-result t = case t of sdone a → a; scmd c k → #999
-- node 1 times out once, node 0 sends, the packet is delivered
ping-choices : List Adv
ping-choices = cons (a-run 1) (cons (a-run 0) (cons (a-deliver 0) nil))
ping-final : FState Word (Step (NetSig Word) Word)
ping-final = fleet-run {Word} {Step (NetSig Word) Word} (proc-beh {Word} {Word}) ping-choices ping-init
#show ping-result (fst ping-final 1)
#show fleet-trace {Word} {Step (NetSig Word) Word} (proc-beh {Word} {Word}) ping-choices ping-init
#show flight (snd ping-final)
ping-delivered : ping-result (fst ping-final 1) ≡ #42
ping-delivered = λ i → #42
-- the same exchange with nodes that run for ever, as guarded processes at every clock: a
-- machine whose state is the sum of the words it has received (node 1), and one that sends its
-- state to node 1 and adds one, again and again (node 0)
ping-mach : NodeId → Word → NView Word Word
ping-mach i s = case i of zero → v-send 1 s (%wsucc s); suc j → v-recv (λ r → case r of r-timeout → s; r-msg f m → wadd s m)
ping-gnodes : NodeId → GNode Word Word
ping-gnodes i = λ κ → mach-gproc {κ} {Word} {Word} (ping-mach i) #5
ping-gfinal : FState Word (GNode Word Word)
ping-gfinal = fleet-run {Word} {GNode Word Word} (gproc-beh {Word} {Word})
                (cons (a-run 0) (cons (a-run 0) (cons (a-dup 0) (cons (a-deliver 0) (cons (a-deliver 0) (cons (a-deliver 0) nil))))))
                (ping-gnodes , net-empty {Word})
-- after the run node 1 is at a receive, and after a timeout it is at a command again (#1): the
-- guarded process is unfolded only as far as the run observes it
ping-gsum : NView Word (GNode Word Word) → Word
ping-gsum v = case v of
  v-recv k → (case k r-timeout κ0 of gret a → #0; gcmd c k2 → #1; gtau t → #2)
  _ → #3
#show ping-gsum (gview {Word} {Word} (fst ping-gfinal 1))
-- the same machine run directly as a node (its state is the word): 5 + 6 + 6 + 5
ping-mfinal : FState Word Word
ping-mfinal = fleet-run {Word} {Word} ping-mach
                (cons (a-run 0) (cons (a-run 0) (cons (a-dup 0) (cons (a-deliver 0) (cons (a-deliver 0) (cons (a-deliver 0) nil))))))
                ((λ i → #5) , net-empty {Word})
#show fst ping-mfinal 1
