rf-step-del g p rest h m s = rf-del-to g (p-to p) (p-from p) (p-msg p) rest h (fst (snd (snd (snd h))) p m) s
rf-step-net : (g : RfG) → (n : Net KvMsg) → RfInv g → SubL {Pkt KvMsg} (flight n) (flight (snd g)) → RfInv (fst g , n)
rf-step-net g n h s = rf-shrink (r-app (fst (fst g 0))) (r-pend (fst (fst g 0))) (c-hist (snd (fst g 3))) (c-conf (snd (fst g 3))) (c-idx (snd (fst g 3))) (c-ph (snd (fst g 3))) (flight (snd g)) (flight n) s h
-- ---------------------------------------------------------------- the statements
rf-init : (prog : List KvCmd) → RfInv (kv-init (kv-seq-cli prog))
rf-init prog = ((λ x m → Empty-rec m) , ((λ x m → m) , (unit , ((λ p m → Empty-rec m) , (λ i k → #0)))))
kv-seq-safe : (prog : List KvCmd) → Safe {KvMsg} {KvSt} RfInv kv-seq-beh (kv-init (kv-seq-cli prog))
kv-seq-safe prog = safe-by-events {KvMsg} {KvSt} RfInv kv-seq-beh (kv-init (kv-seq-cli prog)) (rf-init prog) rf-step-run rf-step-del rf-step-net
-- the service refines the single sequential map: for every program of the sequential client and
-- every choice sequence, the history the client has observed is a history of kv-map-world
-- from the empty map
kv-refines : (prog : List KvCmd) → Refines {KvS} {Word → Word} {KvMsg} {KvSt} kv-map-world (λ k → #0) (λ g → c-hist (snd (fst g 3))) kv-seq-beh (kv-init (kv-seq-cli prog))
kv-refines prog chs =
  (kv-store (c-conf (snd (fst (fleet-run {KvMsg} {KvSt} kv-seq-beh chs (kv-init (kv-seq-cli prog))) 3))) , snd (snd (snd (snd (kv-seq-safe prog chs)))))
