-- experiments/fleet/kv/run3.cub — the client node of the deployed kv fleet performed on the net
-- (#run, with build/kv-node0, 1, 2 running): it puts (1,10), (2,20),
-- (1,11) to the three replicas, gets key 1 from replica 0, and leaves with the value as status
import "deploy.cub"
kv-node3-run : Step W (Sum Errno Word)
kv-node3-run = fl-node kv-fleet 3
#run kv-node3-run
