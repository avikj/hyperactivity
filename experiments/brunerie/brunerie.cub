-- Ljungström's Brunerie number (agda/cubical BrunerieExperiments.brunerie'), untyped port.

-- ---------------------------------------------------------------- spaces
data S1 = base | loop (i : I) [ i = 0 ↦ base , i = 1 ↦ base ]
data S2 = base2 | surf (i : I) (j : I) [ i = 0 ↦ base2 , i = 1 ↦ base2 , j = 0 ↦ base2 , j = 1 ↦ base2 ]
data SS2 = N | S | merid (t : S2) (i : I) [ i = 0 ↦ N , i = 1 ↦ S ]

-- path composition in a type A (Agda's _∙_: refl ∙∙ p ∙∙ q)
compP A p q = λ (i : I) → hcomp A [ i = 0 ↦ λ (j : I) → p @ 0 , i = 1 ↦ λ (j : I) → q @ j ] (p @ i)

-- ---------------------------------------------------------------- integers
sucZ z = case z return λ w → Int of pos n → pos (suc n) ; negsuc n → (case n return λ w → Int of zero → pos zero ; suc m → negsuc m)
predZ z = case z return λ w → Int of pos n → (case n return λ w → Int of zero → negsuc zero ; suc m → pos m) ; negsuc n → negsuc (suc n)
sucEquiv = isoToEquiv lzero Int Int sucZ predZ (λ z → λ (i : I) → sucZ (predZ z)) (λ z → λ (i : I) → predZ (sucZ z))
helix x = case x return λ y → Type of base → Int ; loop i → ua lzero Int Int sucEquiv @ i

-- ---------------------------------------------------------------- the circle's multiplication
rotLoop a = case a return λ y → PathP (λ (j : I) → S1) y y of
    base → λ (j : I) → loop j
    loop i → λ (j : I) → hcomp S1 [ i = 0 ↦ λ (k : I) → loop (j \/ ~ k) , i = 1 ↦ λ (k : I) → loop (j /\ k) , j = 0 ↦ λ (k : I) → loop (i \/ ~ k) , j = 1 ↦ λ (k : I) → loop (i /\ k) ] base
mulS1 x y = case x return λ w → S1 of base → y ; loop i → rotLoop y @ i
isEquivS1 f = (y : S1) → Contr (fib S1 S1 f y)
isPropFamS1 P pP b0 = λ (i : I) →
  pP (loop i) (comp (λ (j : I) → P (loop (i /\ j))) [ i = 0 ↦ λ (j : I) → b0 ] b0)
              (comp (λ (j : I) → P (loop (i \/ ~ j))) [ i = 1 ↦ λ (j : I) → b0 ] b0) @ i
rotIsEquiv a = case a return λ x → isEquivS1 (λ z → mulS1 x z) of
    base → snd (idequiv S1)
    loop i → isPropFamS1 (λ x → isEquivS1 (λ z → mulS1 x z)) (λ x → isPropIsEquiv lzero lzero S1 S1 (λ z → mulS1 x z)) (snd (idequiv S1)) @ i

-- the Hopf fibration over S²
HopfS2 x = case x return λ y → Type of
    base2 → S1
    surf i j → Glue S1 [ i = 0 ↦ (S1 , idequiv S1) , i = 1 ↦ (S1 , idequiv S1) , j = 0 ↦ (S1 , idequiv S1) , j = 1 ↦ (S1 , (λ z → mulS1 (loop i) z , rotIsEquiv (loop i))) ]

-- ---------------------------------------------------------------- truncations
data T2 (A : Type) = t2inc (a : A)
  | squash2 (x : T2 A) (y : T2 A) (p : PathP (λ (m : I) → T2 A) x y) (q : PathP (λ (m : I) → T2 A) x y) (i : I) (j : I)
      [ i = 0 ↦ p @ j , i = 1 ↦ q @ j , j = 0 ↦ x , j = 1 ↦ y ]
data T3 (A : Type) = t3inc (a : A)
  | squash3 (x : T3 A) (y : T3 A) (p : PathP (λ (m : I) → T3 A) x y) (q : PathP (λ (m : I) → T3 A) x y)
      (r : PathP (λ (m : I) → PathP (λ (n : I) → T3 A) x y) p q) (s : PathP (λ (m : I) → PathP (λ (n : I) → T3 A) x y) p q)
      (i : I) (j : I) (k : I)
      [ i = 0 ↦ r @ j @ k , i = 1 ↦ s @ j @ k , j = 0 ↦ p @ k , j = 1 ↦ q @ k , k = 0 ↦ x , k = 1 ↦ y ]
data K2 = tinc (a : S2)
  | squash4 (x : K2) (y : K2) (p : PathP (λ (m : I) → K2) x y) (q : PathP (λ (m : I) → K2) x y)
      (r : PathP (λ (m : I) → PathP (λ (n : I) → K2) x y) p q) (s : PathP (λ (m : I) → PathP (λ (n : I) → K2) x y) p q)
      (t : PathP (λ (m : I) → PathP (λ (n : I) → PathP (λ (o : I) → K2) x y) p q) r s)
      (u : PathP (λ (m : I) → PathP (λ (n : I) → PathP (λ (o : I) → K2) x y) p q) r s)
      (i : I) (j : I) (k : I) (l : I)
      [ i = 0 ↦ t @ j @ k @ l , i = 1 ↦ u @ j @ k @ l , j = 0 ↦ r @ k @ l , j = 1 ↦ s @ k @ l
      , k = 0 ↦ p @ l , k = 1 ↦ q @ l , l = 0 ↦ x , l = 1 ↦ y ]

-- recursors (non-dependent), with the target's h-level
rec2 B g f x = case x return λ w → B of
    t2inc a → f a
    squash2 x1 y1 p q i j → g (rec2 B g f x1) (rec2 B g f y1) (λ (m : I) → rec2 B g f (p @ m)) (λ (m : I) → rec2 B g f (q @ m)) @ i @ j
rec3 B g f x = case x return λ w → B of
    t3inc a → f a
    squash3 x1 y1 p q r s i j k →
      g (rec3 B g f x1) (rec3 B g f y1) (λ (m : I) → rec3 B g f (p @ m)) (λ (m : I) → rec3 B g f (q @ m))
        (λ (m : I) (n : I) → rec3 B g f (r @ m @ n)) (λ (m : I) (n : I) → rec3 B g f (s @ m @ n)) @ i @ j @ k
rec4 B g f x = case x return λ w → B of
    tinc a → f a
    squash4 x1 y1 p q r s t u i j k l →
      g (rec4 B g f x1) (rec4 B g f y1) (λ (m : I) → rec4 B g f (p @ m)) (λ (m : I) → rec4 B g f (q @ m))
        (λ (m : I) (n : I) → rec4 B g f (r @ m @ n)) (λ (m : I) (n : I) → rec4 B g f (s @ m @ n))
        (λ (m : I) (n : I) (o : I) → rec4 B g f (t @ m @ n @ o)) (λ (m : I) (n : I) (o : I) → rec4 B g f (u @ m @ n @ o))
        @ i @ j @ k @ l

-- ---------------------------------------------------------------- h-levels (any proof of a proposition serves)
isPropT X = (x : X) → (y : X) → PathP (λ (m : I) → X) x y
Pth X a b = PathP (λ (m : I) → X) a b
HL1 X = (a : X) → (b : X) → Pth X a b
HL2 X = (a : X) → (b : X) → HL1 (Pth X a b)
HL3 X = (a : X) → (b : X) → HL2 (Pth X a b)
-- isProp→isSet
propToSet A h a b p q = λ (j : I) (i : I) →
  hcomp A [ i = 0 ↦ λ (k : I) → h a a @ k , i = 1 ↦ λ (k : I) → h a b @ k
          , j = 0 ↦ λ (k : I) → h a (p @ i) @ k , j = 1 ↦ λ (k : I) → h a (q @ i) @ k ] a
propPathProp X h a b = λ x y → propToSet X h a b x y
-- isPropIsOfHLevel 1, 2, 3
isPropHL1 A f g = λ (i : I) → λ a b → propToSet A f a b (f a b) (g a b) @ i
isPropHL2 A f g = λ (i : I) → λ a b → isPropHL1 (Pth A a b) (f a b) (g a b) @ i
isPropHL3 A f g = λ (i : I) → λ a b → isPropHL2 (Pth A a b) (f a b) (g a b) @ i
-- isProp→PathP, by transport to the middle
isPropToPathP BL hB b0 b1 = λ (i : I) →
  (hB @ i) (comp (λ (j : I) → BL @ (i /\ j)) [ i = 0 ↦ λ (j : I) → b0 ] b0)
           (comp (λ (j : I) → BL @ (i \/ ~ j)) [ i = 1 ↦ λ (j : I) → b1 ] b1) @ i
-- Σ≡Prop and its section
SigProp BL pB u v p = λ (i : I) →
  (p @ i , isPropToPathP (λ (m : I) → BL (p @ m)) (λ (m : I) → pB (p @ m)) (snd u) (snd v) @ i)
secSigProp BL pB u v p =
  let sg = λ (i : I) → snd (SigProp BL pB u v (λ (m : I) → fst (p @ m)) @ i)
  in λ (j : I) (i : I) →
       (fst (p @ i)
       , isPropToPathP (λ (m : I) → Pth (BL (fst (p @ m))) (sg @ m) (snd (p @ m)))
           (λ (m : I) → propPathProp (BL (fst (p @ m))) (pB (fst (p @ m))) (sg @ m) (snd (p @ m)))
           (λ (m : I) → snd u) (λ (m : I) → snd v) @ i @ j)
eqv-fst w = λ (m : I) → fst (w @ m)
-- retracts
isPropRetract A f g h p x y = λ (i : I) →
  hcomp A [ i = 0 ↦ λ (j : I) → h x @ j , i = 1 ↦ λ (j : I) → h y @ j ] (g (p (f x) (f y) @ i))
isSetRetract A f g h set x y p q = λ (i : I) (j : I) →
  hcomp A [ i = 0 ↦ λ (k : I) → h (p @ j) @ k , i = 1 ↦ λ (k : I) → h (q @ j) @ k
          , j = 0 ↦ λ (k : I) → h x @ k , j = 1 ↦ λ (k : I) → h y @ k ]
    (g (set (f x) (f y) (λ (m : I) → f (p @ m)) (λ (m : I) → f (q @ m)) @ i @ j))
isGroupoidRetract A f g h grp x y p q P Q = λ (i : I) (j : I) (k : I) →
  hcomp A [ i = 0 ↦ λ (l : I) → h (P @ j @ k) @ l , i = 1 ↦ λ (l : I) → h (Q @ j @ k) @ l
          , j = 0 ↦ λ (l : I) → h (p @ k) @ l , j = 1 ↦ λ (l : I) → h (q @ k) @ l
          , k = 0 ↦ λ (l : I) → h x @ l , k = 1 ↦ λ (l : I) → h y @ l ]
    (g (grp (f x) (f y) (λ (m : I) → f (p @ m)) (λ (m : I) → f (q @ m))
            (λ (m : I) (n : I) → f (P @ m @ n)) (λ (m : I) (n : I) → f (Q @ m @ n)) @ i @ j @ k))
-- function types (constant family)
piHL2 hB f g F G = λ (i : I) (j : I) → λ z → hB (f z) (g z) (λ (m : I) → (F @ m) z) (λ (m : I) → (G @ m) z) @ i @ j
piHL3 hB f g p q P Q = λ (i : I) (j : I) (k : I) → λ z →
  hB (f z) (g z) (λ (m : I) → (p @ m) z) (λ (m : I) → (q @ m) z)
     (λ (m : I) (n : I) → (P @ m @ n) z) (λ (m : I) (n : I) → (Q @ m @ n) z) @ i @ j @ k
-- equivalences
isEqvT X Y f = (y : Y) → Contr (fib X Y f y)
EqvT X Y = (f : X → Y) × isEqvT X Y f
pIE X Y f = isPropIsEquiv lzero lzero X Y f
equivHL2 X Y hB = λ x y →
  isPropRetract (Pth (EqvT X Y) x y) eqv-fst (SigProp (λ f → isEqvT X Y f) (pIE X Y) x y)
    (secSigProp (λ f → isEqvT X Y f) (pIE X Y) x y) (piHL2 hB (fst x) (fst y))
equivHL3 X Y hB = λ x y →
  isSetRetract (Pth (EqvT X Y) x y) eqv-fst (SigProp (λ f → isEqvT X Y f) (pIE X Y) x y)
    (secSigProp (λ f → isEqvT X Y f) (pIE X Y) x y) (piHL3 hB (fst x) (fst y))
-- univalence: transpEquiv, pathToEquiv, uaη
tE P i =
  ( λ x → comp (λ (j : I) → P @ (i \/ j)) [ i = 1 ↦ λ (j : I) → x ] x
  , comp (λ (k : I) → isEqvT (P @ i) (P @ (i \/ k))
                        (λ x → comp (λ (j : I) → P @ (i \/ (k /\ j))) [ i = 1 ↦ λ (j : I) → x , k = 0 ↦ λ (j : I) → x ] x))
      [ i = 1 ↦ λ (k : I) → snd (idequiv (P @ 1)) ] (snd (idequiv (P @ i))) )
-- (an interval literal given as an ordinary argument reads as the numeral: bound with λ (a : I) and @)
pE P = (λ (a : I) → tE P a) @ 0
uaeta X Y P = λ (i : I) (j : I) →
  Glue Y [ i = 1 ↦ (P @ j , tE P j) , j = 0 ↦ (X , pE P) , j = 1 ↦ (Y , idEquiv lzero Y) ]
pathHL2 X Y a b = isSetRetract (Pth Type X Y) pE (λ e → ua lzero X Y e) (λ P → uaeta X Y P) (equivHL2 X Y b)
pathHL3 X Y a b = isGroupoidRetract (Pth Type X Y) pE (λ e → ua lzero X Y e) (λ P → uaeta X Y P) (equivHL3 X Y b)
-- the universes of 2- and 3-types (isOfHLevelTypeOfHLevel 2, 3)
hSet = (X : Type) × HL2 X
hGroupoid = (X : Type) × HL3 X
TL2 xx yy = isSetRetract (Pth hSet xx yy) eqv-fst (SigProp HL2 isPropHL2 xx yy) (secSigProp HL2 isPropHL2 xx yy)
  (pathHL2 (fst xx) (fst yy) (snd xx) (snd yy))
TL3 xx yy = isGroupoidRetract (Pth hGroupoid xx yy) eqv-fst (SigProp HL3 isPropHL3 xx yy) (secSigProp HL3 isPropHL3 xx yy)
  (pathHL3 (fst xx) (fst yy) (snd xx) (snd yy))
-- isOfHLevelΠ 4 (λ _ → squash₄)
P4 f g p q r s t u = λ (i : I) (j : I) (k : I) (l : I) → λ z →
  squash4 (f z) (g z) (λ (m : I) → (p @ m) z) (λ (m : I) → (q @ m) z)
    (λ (m : I) (n : I) → (r @ m @ n) z) (λ (m : I) (n : I) → (s @ m @ n) z)
    (λ (m : I) (n : I) (o : I) → (t @ m @ n @ o) z) (λ (m : I) (n : I) (o : I) → (u @ m @ n @ o) z) i j k l
-- S²ToSetElim, generic: A a family of sets (setA x u v : isProp (u ≡ v)), b : A base
helperG A setA b p = transp (λ (k : I) → (b1 : A (p @ k)) → isPropT (PathP (λ (i : I) → A (p @ (k /\ i))) b b1))
                       (λ b1 → setA base2 b b1) b
S2SetElimG A setA b a = case a return λ y → A y of
    base2 → b
    surf k l → isPropToPathP (λ (i : I) → PathP (λ (j : I) → A (surf i j)) b b)
                 (λ (i : I) → helperG A setA b (λ (m : I) → surf i m)) (λ (j : I) → b) (λ (j : I) → b) @ k @ l

-- ---------------------------------------------------------------- K₂ = ∥S²∥₄ as an H-space
Om2 x = PathP (λ (i : I) → PathP (λ (j : I) → K2) x x) (λ (j : I) → x) (λ (j : I) → x)
X0 = tinc base2
bOm = λ (i : I) (j : I) → tinc (surf i j)
-- Ω²(K₂, ∣base∣) is a set: squash₄
setOm2 x y = λ p q → λ (i : I) (j : I) (k : I) (l : I) → squash4 X0 X0 (λ (m : I) → X0) (λ (m : I) → X0) x y p q i j k l
-- S²ToSetElim at surf: isOfHLevel→isOfHLevelDep 2, its J by transport
helperS2 p = transp (λ (k : I) → (b1 : Om2 (tinc (p @ k))) → isPropT (PathP (λ (i : I) → Om2 (tinc (p @ (k /\ i)))) bOm b1))
                    (λ b1 → setOm2 bOm b1) bOm
S2SetElim a = case a return λ y → Om2 (tinc y) of
    base2 → bOm
    surf k l → isPropToPathP (λ (i : I) → PathP (λ (j : I) → Om2 (tinc (surf i j))) bOm bOm)
                 (λ (i : I) → helperS2 (λ (m : I) → surf i m)) (λ (j : I) → bOm) (λ (j : I) → bOm) @ k @ l
-- (checked: it has a type)
-- a family of sets over A fills over every 4-cube of A (isOfHLevel→isOfHLevelDep 4, for sets): the
-- 3-cubes over the 4-cube's sections, with fixed faces, form a line of propositions (each a path over a
-- line of propositions, down to paths in a set), so the 3-cube over t and the one over u are joined
fill4OverSets : {A : Type} → (B : A → Type) → ((a : A) → isSet (B a)) →
  {x y : A} {p q : x ≡ y} {r s : p ≡ q} {t u : r ≡ s} → (c : t ≡ u) →
  {b0 : B x} {b1 : B y} {bp : PathP (λ l → B (p l)) b0 b1} {bq : PathP (λ l → B (q l)) b0 b1}
  {br : PathP (λ k → PathP (λ l → B (r k l)) b0 b1) bp bq} {bs : PathP (λ k → PathP (λ l → B (s k l)) b0 b1) bp bq} →
  (bt : PathP (λ j → PathP (λ k → PathP (λ l → B (t j k l)) b0 b1) bp bq) br bs) →
  (bu : PathP (λ j → PathP (λ k → PathP (λ l → B (u j k l)) b0 b1) bp bq) br bs) →
  PathP (λ i → PathP (λ j → PathP (λ k → PathP (λ l → B (c i j k l)) b0 b1) bp bq) br bs) bt bu
fill4OverSets {A} B setB {x} {y} {p} {q} {r} {s} {t} {u} c {b0} {b1} {bp} {bq} {br} {bs} bt bu =
  let propDp = isPropPathP (λ l → B (q l)) (setB y) b0 b1
      propSq = isPropPathP (λ k → PathP (λ l → B (s k l)) b0 b1) (isProp→isSet propDp) bp bq
      propC3 = isPropPathP (λ j → PathP (λ k → PathP (λ l → B (u j k l)) b0 b1) bp bq) (isProp→isSet propSq) br bs
  in isProp→PathP (λ i → PathP (λ j → PathP (λ k → PathP (λ l → B (c i j k l)) b0 b1) bp bq) br bs) propC3 bt bu
-- Ω²(K₂, y) is a set at every y: squash₄ at y
setOm2y y = λ x z p q → λ (i : I) (j : I) → λ (k : I) (l : I) →
  squash4 y y (λ (m : I) → y) (λ (m : I) → y) x z p q i j k l
-- surfc on squash₄: the dependent 4-cube over it, Ω² being a family of sets
surfc x = case x return λ y → Om2 y of
    tinc a → S2SetElim a
    squash4 x1 y1 p q r s t u i j k l →
      fill4OverSets K2 Om2 setOm2y x1 y1 p q r s t u
        (λ (i : I) (j : I) (k : I) (l : I) → squash4 x1 y1 p q r s t u i j k l)
        (surfc x1) (surfc y1) (λ (m : I) → surfc (p @ m)) (λ (m : I) → surfc (q @ m))
        (λ (m : I) (n : I) → surfc (r @ m @ n)) (λ (m : I) (n : I) → surfc (s @ m @ n))
        (λ (m : I) (n : I) (o : I) → surfc (t @ m @ n @ o)) (λ (m : I) (n : I) (o : I) → surfc (u @ m @ n @ o))
        @ i @ j @ k @ l
plus2 x = rec4 (K2 → K2) P4
  (λ a → case a return λ w → K2 → K2 of base2 → (λ z → z) ; surf i j → (λ z → surfc z @ i @ j)) x
isEquivK f = (y : K2) → Contr (fib K2 K2 f y)
help a = S2SetElimG (λ x → isEquivK (λ y → plus2 (tinc x) y))
  (λ x → propToSet (isEquivK (λ y → plus2 (tinc x) y)) (isPropIsEquiv lzero lzero K2 K2 (λ y → plus2 (tinc x) y)))
  (snd (idequiv K2)) a
K2eq a = (λ y → plus2 (tinc a) y , help a)
Code z = case z return λ w → Type of
    N → K2
    S → K2
    merid a i → ua lzero K2 K2 (K2eq a) @ i
f7 q = transp (λ (k : I) → Code (q @ k)) (tinc base2)

-- ---------------------------------------------------------------- η₃ and the encode chain
s11 x y = case x return λ w → S2 of base → base2 ; loop i → (case y return λ w → S2 of base → base2 ; loop j → surf i j)
sigma x = compP SS2 (λ (i : I) → merid x i) (λ (i : I) → merid base2 (~ i))
eta3push a b = compP SS2 (sigma (s11 a b)) (sigma (s11 a b))

codeS2 s = (T3 (HopfS2 s) , λ a b p q r s2 → λ (i : I) (j : I) (k : I) → squash3 a b p q r s2 i j k)
codeTruncS2 x = rec4 hGroupoid TL3 codeS2 x
encodeTruncS2 p = transp (λ (j : I) → fst (codeTruncS2 (p @ j))) (t3inc base)
codeS1 s = (T2 (helix s) , λ a b p q → λ (i : I) (j : I) → squash2 a b p q i j)
codeTruncS1 x = rec3 hSet TL2 codeS1 x
encodeTruncS1 p = transp (λ (i : I) → fst (codeTruncS1 (p @ i))) (t2inc (pos zero))
g10 x = rec2 Int isSetInt (λ z → z) x

F = λ (i : I) (j : I) → f7 (λ (k : I) → eta3push (loop i) (loop j) @ k)
g8 = λ (i : I) → encodeTruncS2 (λ (j : I) → F @ i @ j)
brunerie = g10 (encodeTruncS1 g8)
