-- Ljungström's brunerie' with every definition typed and checked (A10b, the typed port, in PLAN.md revision 7.9, 6 Nov 2026, git 2ca8d747aaa5:PLAN.md, §12 “The build list”, “A. The rewriting runtime”, item 10: Brunerie's number, and Agda measured on the same machine). Built on lib/library/std.cub.
import "../../lib/core.cub"

-- ---------------------------------------------------------------- spaces
data S1 = base | loop (i : I) [ i = 0 ↦ base , i = 1 ↦ base ]
data S2 = base2 | surf (i : I) (j : I) [ i = 0 ↦ base2 , i = 1 ↦ base2 , j = 0 ↦ base2 , j = 1 ↦ base2 ]
data SS2 = N | S | merid (t : S2) (i : I) [ i = 0 ↦ N , i = 1 ↦ S ]

-- ---------------------------------------------------------------- integers
sucZ : Int → Int
sucZ z = case z of pos n → pos (suc n) ; negsuc n → (case n of zero → pos zero ; suc m → negsuc m)
predZ : Int → Int
predZ z = case z of pos n → (case n of zero → negsuc zero ; suc m → pos m) ; negsuc n → negsuc (suc n)
sucPred : (z : Int) → sucZ (predZ z) ≡ z
sucPred z = case z return (λ w → sucZ (predZ w) ≡ w) of pos n → (case n return (λ k → sucZ (predZ (pos k)) ≡ pos k) of zero → refl ; suc m → refl) ; negsuc n → refl
predSuc : (z : Int) → predZ (sucZ z) ≡ z
predSuc z = case z return (λ w → predZ (sucZ w) ≡ w) of pos n → refl ; negsuc n → (case n return (λ k → predZ (sucZ (negsuc k)) ≡ negsuc k) of zero → refl ; suc m → refl)
sucEquiv : Equiv Int Int
sucEquiv = isoToEquiv sucZ predZ sucPred predSuc
helix : S1 → Type
helix x = case x return (λ y → Type) of base → Int ; loop i → ua sucEquiv i

-- ---------------------------------------------------------------- the circle's multiplication
rotLoop : (a : S1) → a ≡ a
rotLoop a = case a return (λ y → PathP (λ (j : I) → S1) y y) of
    base → λ j → loop j
    loop i → λ j → comp (λ k → S1) (λ k → [ i = 0 ↦ loop (j \/ ~ k) , i = 1 ↦ loop (j /\ k) , j = 0 ↦ loop (i \/ ~ k) , j = 1 ↦ loop (i /\ k) ]) base
mulS1 : S1 → S1 → S1
mulS1 x y = case x return (λ w → S1) of base → y ; loop i → rotLoop y i
isPropFamS1 : (P : S1 → Type) → ((x : S1) → isProp (P x)) → (b0 : P base) → PathP (λ i → P (loop i)) b0 b0
isPropFamS1 P pP b0 = λ i →
  pP (loop i) (comp (λ j → P (loop (i /\ j))) (λ j → [ i = 0 ↦ b0 ]) b0)
              (comp (λ j → P (loop (i \/ ~ j))) (λ j → [ i = 1 ↦ b0 ]) b0) i
rotIsEquiv : (a : S1) → isEquiv (λ (z : S1) → mulS1 a z)
rotIsEquiv a = case a return (λ x → isEquiv (λ (z : S1) → mulS1 x z)) of
    base → snd (idEquiv {lzero} {S1})
    loop i → isPropFamS1 (λ x → isEquiv (λ (z : S1) → mulS1 x z)) (λ x → isPropIsEquiv (λ (z : S1) → mulS1 x z)) (snd (idEquiv {lzero} {S1})) i

-- the Hopf fibration over S²
HopfS2 : S2 → Type
HopfS2 x = case x return (λ y → Type) of
    base2 → S1
    surf i j → Glue S1 [ i = 0 ↦ (S1 , idEquiv {lzero} {S1}) , i = 1 ↦ (S1 , idEquiv {lzero} {S1}) , j = 0 ↦ (S1 , idEquiv {lzero} {S1}) , j = 1 ↦ (S1 , (λ z → mulS1 (loop i) z , rotIsEquiv (loop i))) ]

-- ---------------------------------------------------------------- truncations
-- The recursors: a branch takes an induction hypothesis for a path-typed field too, the line of
-- the eliminations of its points (rec p : PathP (λ m → B) (rec x) (rec y)).
isGroupoid : {l : Level} → Type l → Type l
isGroupoid A = (a b : A) → isSet (a ≡ b)
is2Groupoid : {l : Level} → Type l → Type l
is2Groupoid A = (a b : A) → isGroupoid (a ≡ b)
data T2 (A : Type) = t2inc (a : A)
  | squash2 (x : T2 A) (y : T2 A) (p : PathP (λ (m : I) → T2 A) x y) (q : PathP (λ (m : I) → T2 A) x y) (i : I) (j : I)
      [ i = 0 ↦ p @ j , i = 1 ↦ q @ j , j = 0 ↦ x , j = 1 ↦ y ]
data T3 (A : Type) = t3inc (a : A)
  | squash3 (x : T3 A) (y : T3 A) (p : PathP (λ (m : I) → T3 A) x y) (q : PathP (λ (m : I) → T3 A) x y)
      (r : PathP (λ (m : I) → PathP (λ (n : I) → T3 A) x y) p q) (s : PathP (λ (m : I) → PathP (λ (n : I) → T3 A) x y) p q)
      (i : I) (j : I) (k : I)
      [ i = 0 ↦ r @ j @ k , i = 1 ↦ s @ j @ k , j = 0 ↦ p @ k , j = 1 ↦ q @ k , k = 0 ↦ x , k = 1 ↦ y ]
data K2 = tinc (a : S2)
  | squash4 (x : K2) (y : K2) (p : PathP (λ (m : I) → K2) x y) (q : PathP (λ (m : I) → K2) x y)
      (r : PathP (λ (m : I) → PathP (λ (n : I) → K2) x y) p q) (s : PathP (λ (m : I) → PathP (λ (n : I) → K2) x y) p q)
      (t : PathP (λ (m : I) → PathP (λ (n : I) → PathP (λ (o : I) → K2) x y) p q) r s)
      (u : PathP (λ (m : I) → PathP (λ (n : I) → PathP (λ (o : I) → K2) x y) p q) r s)
      (i : I) (j : I) (k : I) (l : I)
      [ i = 0 ↦ t @ j @ k @ l , i = 1 ↦ u @ j @ k @ l , j = 0 ↦ r @ k @ l , j = 1 ↦ s @ k @ l
      , k = 0 ↦ p @ l , k = 1 ↦ q @ l , l = 0 ↦ x , l = 1 ↦ y ]
rec2 : {l : Level} {A : Type} {B : Type l} → isSet B → (A → B) → T2 A → B
rec2 g f x = case x return (λ w → B) of
    t2inc a → f a
    squash2 x1 y1 p q i j → g (rec x1) (rec y1) (rec p) (rec q) i j
rec3 : {l : Level} {A : Type} {B : Type l} → isGroupoid B → (A → B) → T3 A → B
rec3 g f x = case x return (λ w → B) of
    t3inc a → f a
    squash3 x1 y1 p q r s i j k → g (rec x1) (rec y1) (rec p) (rec q) (rec r) (rec s) i j k
rec4 : {l : Level} {B : Type l} → is2Groupoid B → (S2 → B) → K2 → B
rec4 g f x = case x return (λ w → B) of
    tinc a → f a
    squash4 x1 y1 p q r s t u i j k l → g (rec x1) (rec y1) (rec p) (rec q) (rec r) (rec s) (rec t) (rec u) i j k l
-- ---------------------------------------------------------------- h-levels (the untyped proofs, typed)
-- isProp→isSet is std's; a proposition's paths are propositions
propPathProp : {X : Type} → isProp X → (a b : X) → isProp (a ≡ b)
propPathProp h a b = λ x y → isProp→isSet h a b x y
isPropIsProp : {A : Type} → isProp (isProp A)
isPropIsProp f g = λ i → λ a b → isProp→isSet f a b (f a b) (g a b) i
isPropIsSet : {A : Type} → isProp (isSet A)
isPropIsSet f g = λ i → λ a b → isPropIsProp (f a b) (g a b) i
isPropIsGroupoid : {A : Type} → isProp (isGroupoid A)
isPropIsGroupoid f g = λ i → λ a b → isPropIsSet (f a b) (g a b) i
-- isProp→PathP, by transport to the middle (a line of propositions, with its ends)
isPropToPathP : {B0 B1 : Type} (BL : B0 ≡ B1) (h0 : isProp B0) (h1 : isProp B1) (hB : PathP (λ i → isProp (BL i)) h0 h1) (b0 : B0) (b1 : B1) → PathP (λ i → BL i) b0 b1
isPropToPathP BL h0 h1 hB b0 b1 = λ i →
  hB i (comp (λ j → BL (i /\ j)) (λ j → [ i = 0 ↦ b0 ]) b0)
       (comp (λ j → BL (i \/ ~ j)) (λ j → [ i = 1 ↦ b1 ]) b1) i
-- Σ≡Prop and its section
SigProp : {l : Level} {A : Type l} (B : A → Type) (pB : (a : A) → isProp (B a)) (u v : (a : A) × B a) → fst u ≡ fst v → u ≡ v
SigProp B pB u v p = λ i → (p i , isPropToPathP (λ m → B (p m)) (pB (fst u)) (pB (fst v)) (λ m → pB (p m)) (snd u) (snd v) i)
congFst : {l : Level} {A : Type l} {B : A → Type} {u v : (a : A) × B a} → u ≡ v → fst u ≡ fst v
congFst w = λ m → fst (w m)
secSigProp : {l : Level} {A : Type l} (B : A → Type) (pB : (a : A) → isProp (B a)) (u v : (a : A) × B a) (p : u ≡ v) → SigProp B pB u v (congFst p) ≡ p
secSigProp B pB u v p =
  let sg = λ i → snd (SigProp B pB u v (congFst p) i)
  in λ j i →
       (fst (p i)
       , isPropToPathP (λ m → Path (B (fst (p m))) (sg m) (snd (p m)))
           (propPathProp (pB (fst u)) (snd u) (snd u)) (propPathProp (pB (fst v)) (snd v) (snd v))
           (λ m → propPathProp (pB (fst (p m))) (sg m) (snd (p m)))
           (λ m → snd u) (λ m → snd v) i j)
-- retracts
isPropRetract : {l m : Level} {A : Type l} {B : Type m} (f : A → B) (g : B → A) (h : (x : A) → g (f x) ≡ x) → isProp B → isProp A
isPropRetract f g h p x y = λ i →
  comp (λ j → A) (λ j → [ i = 0 ↦ h x j , i = 1 ↦ h y j ]) (g (p (f x) (f y) i))
isSetRetract : {l m : Level} {A : Type l} {B : Type m} (f : A → B) (g : B → A) (h : (x : A) → g (f x) ≡ x) → isSet B → isSet A
isSetRetract f g h set x y p q = λ i j →
  comp (λ k → A) (λ k → [ i = 0 ↦ h (p j) k , i = 1 ↦ h (q j) k , j = 0 ↦ h x k , j = 1 ↦ h y k ])
    (g (set (f x) (f y) (λ m → f (p m)) (λ m → f (q m)) i j))
isGroupoidRetract : {l m : Level} {A : Type l} {B : Type m} (f : A → B) (g : B → A) (h : (x : A) → g (f x) ≡ x) → isGroupoid B → isGroupoid A
isGroupoidRetract f g h grp x y p q P Q = λ i j k →
  comp (λ l → A) (λ l → [ i = 0 ↦ h (P j k) l , i = 1 ↦ h (Q j k) l , j = 0 ↦ h (p k) l , j = 1 ↦ h (q k) l , k = 0 ↦ h x l , k = 1 ↦ h y l ])
    (g (grp (f x) (f y) (λ m → f (p m)) (λ m → f (q m)) (λ m n → f (P m n)) (λ m n → f (Q m n)) i j k))
-- function types (constant family)
piHL2 : {A B : Type} → isSet B → isSet (A → B)
piHL2 hB f g F G = λ i j → λ z → hB (f z) (g z) (λ m → F m z) (λ m → G m z) i j
piHL3 : {A B : Type} → isGroupoid B → isGroupoid (A → B)
piHL3 hB f g p q P Q = λ i j k → λ z →
  hB (f z) (g z) (λ m → p m z) (λ m → q m z) (λ m n → P m n z) (λ m n → Q m n z) i j k
-- equivalences
equivHL2 : (X Y : Type) → isSet Y → isSet (Equiv X Y)
equivHL2 X Y hB = λ x y →
  isPropRetract (λ (w : x ≡ y) → congFst w) (SigProp (λ f → isEquiv f) (λ f → isPropIsEquiv f) x y)
    (secSigProp (λ f → isEquiv f) (λ f → isPropIsEquiv f) x y) (piHL2 hB (fst x) (fst y))
equivHL3 : (X Y : Type) → isGroupoid Y → isGroupoid (Equiv X Y)
equivHL3 X Y hB = λ x y →
  isSetRetract (λ (w : x ≡ y) → congFst w) (SigProp (λ f → isEquiv f) (λ f → isPropIsEquiv f) x y)
    (secSigProp (λ f → isEquiv f) (λ f → isPropIsEquiv f) x y) (piHL3 hB (fst x) (fst y))
-- univalence: transpEquiv (as a line of equivalences), pathToEquiv, uaη
pE : {X Y : Type} (P : X ≡ Y) → Equiv X Y
pE P =
  ( λ x → comp (λ j → P j) (λ j → []) x
  , comp (λ k → isEquiv (λ (x : X) → comp (λ j → P (k /\ j)) (λ j → [ k = 0 ↦ x ]) x)) (λ k → []) (snd (idEquiv {lzero} {X})) )
tE : {X Y : Type} (P : X ≡ Y) → PathP (λ i → Equiv (P i) Y) (pE P) (idEquiv {lzero} {Y})
tE P = λ i →
  ( λ x → comp (λ j → P (i \/ j)) (λ j → [ i = 1 ↦ x ]) x
  , comp (λ k → isEquiv (λ (x : P i) → comp (λ j → P (i \/ (k /\ j))) (λ j → [ i = 1 ↦ x , k = 0 ↦ x ]) x))
      (λ k → [ i = 1 ↦ snd (idEquiv {lzero} {Y}) ]) (snd (idEquiv {lzero} {P i})) )
uaeta : {X Y : Type} (P : X ≡ Y) → ua (pE P) ≡ P
uaeta P = λ i j → Glue Y [ i = 1 ↦ (P j , tE P j) , j = 0 ↦ (X , pE P) , j = 1 ↦ (Y , idEquiv {lzero} {Y}) ]
pathHL2 : (X Y : Type) → isSet Y → isSet (X ≡ Y)
pathHL2 X Y b = isSetRetract (λ (P : X ≡ Y) → pE P) (λ (e : Equiv X Y) → ua e) (λ P → uaeta P) (equivHL2 X Y b)
pathHL3 : (X Y : Type) → isGroupoid Y → isGroupoid (X ≡ Y)
pathHL3 X Y b = isGroupoidRetract (λ (P : X ≡ Y) → pE P) (λ (e : Equiv X Y) → ua e) (λ P → uaeta P) (equivHL3 X Y b)
-- the universes of 2- and 3-types (isOfHLevelTypeOfHLevel 2, 3)
hSet : Type 1
hSet = (X : Type) × isSet X
hGroupoid : Type 1
hGroupoid = (X : Type) × isGroupoid X
TL2 : isGroupoid hSet
TL2 xx yy = isSetRetract (λ (w : xx ≡ yy) → congFst w) (SigProp (λ X → isSet X) (λ X → isPropIsSet) xx yy) (secSigProp (λ X → isSet X) (λ X → isPropIsSet) xx yy)
  (pathHL2 (fst xx) (fst yy) (snd yy))
TL3 : is2Groupoid hGroupoid
TL3 xx yy = isGroupoidRetract (λ (w : xx ≡ yy) → congFst w) (SigProp (λ X → isGroupoid X) (λ X → isPropIsGroupoid) xx yy) (secSigProp (λ X → isGroupoid X) (λ X → isPropIsGroupoid) xx yy)
  (pathHL3 (fst xx) (fst yy) (snd yy))
-- isOfHLevelΠ 4 (λ _ → squash₄)
P4 : {A : Type} → is2Groupoid (A → K2)
P4 f g p q r s t u = λ i j k l → λ z →
  squash4 (f z) (g z) (λ m → p m z) (λ m → q m z) (λ m n → r m n z) (λ m n → s m n z) (λ m n o → t m n o z) (λ m n o → u m n o z) i j k l
-- S²ToSetElim: a family of sets over S² is determined by its value at base2 (the square over surf
-- is a path in a line of propositions: paths over a line of sets)
S2SetElimG : (A : S2 → Type) → ((x : S2) → isSet (A x)) → A base2 → (a : S2) → A a
S2SetElimG A setA b a = case a return (λ y → A y) of
    base2 → b
    surf k l → isPropToPathP (λ i → PathP (λ j → A (surf i j)) b b)
                 (isPropPathP (λ j → A base2) (setA base2) b b) (isPropPathP (λ j → A base2) (setA base2) b b)
                 (λ i → isPropPathP (λ j → A (surf i j)) (setA base2) b b) (λ j → b) (λ j → b) k l

-- ---------------------------------------------------------------- K₂ = ∥S²∥₄ as an H-space
Om2 : K2 → Type
Om2 x = PathP (λ i → x ≡ x) (λ j → x) (λ j → x)
X0 : K2
X0 = tinc base2
bOm : Om2 X0
bOm = λ i j → tinc (surf i j)
-- Ω²(K₂, y) is a set at every y: squash₄ at y
setOm2y : (y : K2) → isSet (Om2 y)
setOm2y y = λ x z p q → λ i j k l → squash4 y y (λ m → y) (λ m → y) x z p q i j k l
S2SetElim : (a : S2) → Om2 (tinc a)
S2SetElim a = S2SetElimG (λ y → Om2 (tinc y)) (λ x → setOm2y (tinc x)) bOm a
-- a family of sets over A fills over every 4-cube of A (isOfHLevel→isOfHLevelDep 4, for sets): the
-- 3-cubes over the 4-cube's sections, with fixed faces, form a line of propositions (each a path over a
-- line of propositions, down to paths in a set), so the 3-cube over t and the one over u are joined
fill4OverSets : {A : Type} → (B : A → Type) → ((a : A) → isSet (B a)) →
  {x y : A} {p q : x ≡ y} {r s : p ≡ q} {t u : r ≡ s} → (c : t ≡ u) →
  {b0 : B x} {b1 : B y} {bp : PathP (λ l → B (p l)) b0 b1} {bq : PathP (λ l → B (q l)) b0 b1}
  {br : PathP (λ k → PathP (λ l → B (r k l)) b0 b1) bp bq} {bs : PathP (λ k → PathP (λ l → B (s k l)) b0 b1) bp bq} →
  (bt : PathP (λ j → PathP (λ k → PathP (λ l → B (t j k l)) b0 b1) bp bq) br bs) →
  (bu : PathP (λ j → PathP (λ k → PathP (λ l → B (u j k l)) b0 b1) bp bq) br bs) →
  PathP (λ i → PathP (λ j → PathP (λ k → PathP (λ l → B (c i j k l)) b0 b1) bp bq) br bs) bt bu
fill4OverSets {A} B setB {x} {y} {p} {q} {r} {s} {t} {u} c {b0} {b1} {bp} {bq} {br} {bs} bt bu =
  let propDp = isPropPathP (λ l → B (q l)) (setB y) b0 b1
      propSq = isPropPathP (λ k → PathP (λ l → B (s k l)) b0 b1) (isProp→isSet propDp) bp bq
      propC3 = isPropPathP (λ j → PathP (λ k → PathP (λ l → B (u j k l)) b0 b1) bp bq) (isProp→isSet propSq) br bs
  in isProp→PathP (λ i → PathP (λ j → PathP (λ k → PathP (λ l → B (c i j k l)) b0 b1) bp bq) br bs) propC3 bt bu
-- surfc on squash₄: the dependent 4-cube over it, Ω² being a family of sets
surfc : (x : K2) → Om2 x
surfc x = case x return (λ y → Om2 y) of
    tinc a → S2SetElim a
    squash4 x1 y1 p q r s t u i j k l →
      fill4OverSets {K2} Om2 setOm2y {x1} {y1} {p} {q} {r} {s} {t} {u} (λ i j k l → squash4 x1 y1 p q r s t u i j k l)
        {rec x1} {rec y1} {rec p} {rec q} {rec r} {rec s} (rec t) (rec u) i j k l
plus2 : K2 → K2 → K2
plus2 x = rec4 P4 (λ a → case a return (λ w → K2 → K2) of base2 → (λ z → z) ; surf i j → (λ z → surfc z i j)) x
help : (a : S2) → isEquiv (λ (y : K2) → plus2 (tinc a) y)
help a = S2SetElimG (λ x → isEquiv (λ (y : K2) → plus2 (tinc x) y))
  (λ x → isProp→isSet (isPropIsEquiv (λ (y : K2) → plus2 (tinc x) y)))
  (snd (idEquiv {lzero} {K2})) a
K2eq : S2 → Equiv K2 K2
K2eq a = (λ y → plus2 (tinc a) y , help a)
CodeK : SS2 → Type
CodeK z = case z return (λ w → Type) of
    N → K2
    S → K2
    merid a i → ua (K2eq a) i
f7 : N ≡ N → K2
f7 q = transport (λ k → CodeK (q k)) (tinc base2)

-- ---------------------------------------------------------------- η₃ and the encode chain
-- S¹ × S¹ → S² (the loop at the loop is surf; by a path for the outer loop, so that the branch's
-- ends are base2 by the path's type)
s11loop : S1 → base2 ≡ base2
s11loop y = case y return (λ w → base2 ≡ base2) of base → (λ i → base2) ; loop j → (λ i → surf i j)
s11 : S1 → S1 → S2
s11 x y = case x return (λ w → S2) of base → base2 ; loop i → s11loop y i
sigma : S2 → N ≡ N
sigma x = (λ i → merid x i) ∙ (λ i → merid base2 (~ i))
eta3push : S1 → S1 → N ≡ N
eta3push a b = sigma (s11 a b) ∙ sigma (s11 a b)
codeS2 : S2 → hGroupoid
codeS2 s = (T3 (HopfS2 s) , λ a b p q r s2 → λ i j k → squash3 a b p q r s2 i j k)
codeTruncS2 : K2 → hGroupoid
codeTruncS2 x = rec4 TL3 codeS2 x
encodeTruncS2 : X0 ≡ X0 → T3 S1
encodeTruncS2 p = transport (λ j → fst (codeTruncS2 (p j))) (t3inc base)
codeS1 : S1 → hSet
codeS1 s = (T2 (helix s) , λ a b p q → λ i j → squash2 a b p q i j)
codeTruncS1 : T3 S1 → hSet
codeTruncS1 x = rec3 TL2 codeS1 x
encodeTruncS1 : t3inc base ≡ t3inc base → T2 Int
encodeTruncS1 p = transport (λ i → fst (codeTruncS1 (p i))) (t2inc (pos zero))
g10 : T2 Int → Int
g10 x = rec2 isSetInt (λ z → z) x

-- ---------------------------------------------------------------- the number
-- η₃ at the loops, transported: a square in K₂ at X0 (its sides compute to X0: the typed statement
-- is the untyped one's, checked by that computation)
F : Om2 X0
F = λ i j → f7 (λ k → eta3push (loop i) (loop j) k)
g8 : t3inc base ≡ t3inc base
g8 = λ i → encodeTruncS2 (λ j → F i j)
brunerie : Int
brunerie = g10 (encodeTruncS1 g8)
