-- experiments/tso/mp.cub — message passing (MP) on the operational x86-TSO machine.
-- x at #0, y at #1, both initially 0.
--   thread 0: x := 1; y := 1         thread 1: r0 := y; r1 := x
-- The outcome is (r0 , r1). x86-TSO forbids (1 , 0): a buffer is FIFO, so y's write reaches
-- memory after x's.
import "../../lib/library.cub"
mp-t0 : TsoThread
mp-t0 = ti-store #0 #1 (ti-store #1 #1 (ti-ret nil))
mp-t1 : TsoThread
mp-t1 = ti-load #1 (λ r0 → ti-load #0 (λ r1 → ti-ret (cons r0 (cons r1 nil))))
mp : List TsoThread
mp = cons mp-t0 (cons mp-t1 nil)
-- 6 transitions finish every schedule (2 stores, 2 flushes, 2 loads)
#show tso-outcomes 6 mp
-- every schedule's execution is TSO-consistent (TsoSound at MP, by computation)
#show tso-sound-upto 6 mp
mp-sound : isTrue (tso-sound-upto 6 mp)
mp-sound = unit
-- the reading as a statement: the set over every schedule is exactly the x86-TSO set
-- ((1 , 0) is not an outcome), from 30 finished schedules, none cut by the bound
mp-set : List (List Word)
mp-set = cons (cons #0 (cons #0 nil)) (cons (cons #0 (cons #1 nil)) (cons (cons #1 (cons #1 nil)) nil))
mp-exact : tso-outcomes 6 mp ≡ tso-sum mp-set #30 #0
mp-exact = λ i → tso-sum mp-set #30 #0
-- the axiomatic form's outcomes for the same threads (lib/isa/tso.cub, `tso-ax-outcomes`): every
-- candidate execution with read values in {0 , 1}, every rf and every order of the writes to
-- each address; 4 candidates, 3 TSO-consistent, and their results are the same set
mp-dom : List Word
mp-dom = cons #0 (cons #1 nil)
#show tso-ax-outcomes (λ a → #0) mp-dom mp
mp-ax : tso-ax-outcomes (λ a → #0) mp-dom mp ≡ tso-ax mp-set #4 #3
mp-ax = λ i → tso-ax mp-set #4 #3
