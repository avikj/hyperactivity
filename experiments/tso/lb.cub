-- experiments/tso/lb.cub — load buffering (LB) on the operational x86-TSO machine.
-- x at #0, y at #1, both initially 0.
--   thread 0: r0 := x; y := 1        thread 1: r1 := y; x := 1
-- The outcome is (r0 , r1). x86-TSO forbids (1 , 1): a load is not delayed past a later store.
lb-t0 : TsoThread
lb-t0 = ti-load #0 (λ r → ti-store #1 #1 (ti-ret (cons r nil)))
lb-t1 : TsoThread
lb-t1 = ti-load #1 (λ r → ti-store #0 #1 (ti-ret (cons r nil)))
lb : List TsoThread
lb = cons lb-t0 (cons lb-t1 nil)
-- 6 transitions finish every schedule (2 loads, 2 stores, 2 flushes)
#show tso-outcomes 6 lb
-- every schedule's execution is TSO-consistent (TsoSound at LB, by computation)
#show tso-sound-upto 6 lb
lb-sound : isTrue (tso-sound-upto 6 lb)
lb-sound = unit
-- the reading as a statement: the set over every schedule is exactly the x86-TSO set
-- ((1 , 1) is not an outcome), from 20 finished schedules, none cut by the bound
lb-set : List (List Word)
lb-set = cons (cons #0 (cons #0 nil)) (cons (cons #0 (cons #1 nil)) (cons (cons #1 (cons #0 nil)) nil))
lb-exact : tso-outcomes 6 lb ≡ tso-sum lb-set #20 #0
lb-exact = λ i → tso-sum lb-set #20 #0
-- the axiomatic form's outcomes for the same threads (lib/isa/tso.cub, `tso-ax-outcomes`): every
-- candidate execution with read values in {0 , 1}, every rf and every order of the writes to
-- each address; 4 candidates, 3 TSO-consistent, and their results are the same set
lb-dom : List Word
lb-dom = cons #0 (cons #1 nil)
#show tso-ax-outcomes (λ a → #0) lb-dom lb
lb-ax : tso-ax-outcomes (λ a → #0) lb-dom lb ≡ tso-ax lb-set #4 #3
lb-ax = λ i → tso-ax lb-set #4 #3
