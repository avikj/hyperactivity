-- experiments/tso/sb.cub — store buffering (SB) on the operational x86-TSO machine
-- (lib/languages/isa/tso.cub). x at #0, y at #1, both initially 0.
--   thread 0: x := 1; r0 := y        thread 1: y := 1; r1 := x
-- The outcome is (r0 , r1). x86-TSO allows all four, including the relaxed (0 , 0).
import "../../lib/library.cub"
sb-t0 : TsoThread
sb-t0 = ti-store #0 #1 (ti-load #1 (λ r → ti-ret (cons r nil)))
sb-t1 : TsoThread
sb-t1 = ti-store #1 #1 (ti-load #0 (λ r → ti-ret (cons r nil)))
sb : List TsoThread
sb = cons sb-t0 (cons sb-t1 nil)
-- 6 transitions finish every schedule (2 stores, 2 flushes, 2 loads)
#show tso-outcomes 6 sb
-- the execution of one schedule (both stores, both loads, both flushes): the relaxed outcome
#show tso-exec (snd (tso-run (cons (ch-go #0) (cons (ch-go #1) (cons (ch-go #0) (cons (ch-go #1) (cons (ch-flush #0) (cons (ch-flush #1) nil)))))) sb tso-init))
-- every schedule's execution is TSO-consistent (TsoSound at SB, by computation)
#show tso-sound-upto 6 sb
sb-sound : isTrue (tso-sound-upto 6 sb)
sb-sound = unit
-- the reading as a statement: the set over every schedule is exactly the x86-TSO set
-- (all four outcomes, the relaxed (0 , 0) among them), from 80 finished schedules, none cut by the bound
sb-set : List (List Word)
sb-set = cons (cons #0 (cons #0 nil)) (cons (cons #0 (cons #1 nil)) (cons (cons #1 (cons #0 nil)) (cons (cons #1 (cons #1 nil)) nil)))
sb-exact : tso-outcomes 6 sb ≡ tso-sum sb-set #80 #0
sb-exact = λ i → tso-sum sb-set #80 #0
-- the axiomatic form's outcomes for the same threads (lib/languages/isa/tso.cub, `tso-ax-outcomes`): every
-- candidate execution with read values in {0 , 1}, every rf and every order of the writes to
-- each address; 4 candidates, 4 TSO-consistent, and their results are the same set
sb-dom : List Word
sb-dom = cons #0 (cons #1 nil)
#show tso-ax-outcomes (λ a → #0) sb-dom sb
sb-ax : tso-ax-outcomes (λ a → #0) sb-dom sb ≡ tso-ax sb-set #4 #4
sb-ax = λ i → tso-ax sb-set #4 #4
