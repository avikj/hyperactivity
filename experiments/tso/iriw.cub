-- experiments/tso/iriw.cub — independent reads of independent writes (IRIW) on the operational
-- x86-TSO machine. x at #0, y at #1, both initially 0.
--   thread 0: x := 1     thread 1: y := 1
--   thread 2: r0 := x; r1 := y       thread 3: r2 := y; r3 := x
-- The outcome is (r0 , r1 , r2 , r3). x86-TSO forbids (1 , 0 , 1 , 0): the two readers would
-- see the two writes reach memory in opposite orders, and there is one memory.
iriw-t0 : TsoThread
iriw-t0 = ti-store #0 #1 (ti-ret nil)
iriw-t1 : TsoThread
iriw-t1 = ti-store #1 #1 (ti-ret nil)
iriw-t2 : TsoThread
iriw-t2 = ti-load #0 (λ r0 → ti-load #1 (λ r1 → ti-ret (cons r0 (cons r1 nil))))
iriw-t3 : TsoThread
iriw-t3 = ti-load #1 (λ r2 → ti-load #0 (λ r3 → ti-ret (cons r2 (cons r3 nil))))
iriw : List TsoThread
iriw = cons iriw-t0 (cons iriw-t1 (cons iriw-t2 (cons iriw-t3 nil)))
-- 8 transitions finish every schedule (2 stores, 2 flushes, 4 loads)
#show tso-outcomes 8 iriw
-- every schedule's execution is TSO-consistent (TsoSound at IRIW, by computation)
-- (69,469,228 steps as a #show; here it is the check of the definition)
iriw-sound : isTrue (tso-sound-upto 8 iriw)
iriw-sound = unit
-- the reading as a statement: the set over every schedule is exactly the x86-TSO set
-- (fifteen outcomes; (1 , 0 , 1 , 0) is not one), from 2520 finished schedules, none cut by the bound
iriw-set : List (List Word)
iriw-set = cons (cons #0 (cons #0 (cons #0 (cons #0 nil)))) (cons (cons #0 (cons #0 (cons #0 (cons #1 nil)))) (cons (cons #0 (cons #0 (cons #1 (cons #0 nil)))) (cons (cons #0 (cons #0 (cons #1 (cons #1 nil)))) (cons (cons #0 (cons #1 (cons #0 (cons #0 nil)))) (cons (cons #0 (cons #1 (cons #0 (cons #1 nil)))) (cons (cons #0 (cons #1 (cons #1 (cons #0 nil)))) (cons (cons #0 (cons #1 (cons #1 (cons #1 nil)))) (cons (cons #1 (cons #0 (cons #0 (cons #0 nil)))) (cons (cons #1 (cons #0 (cons #0 (cons #1 nil)))) (cons (cons #1 (cons #0 (cons #1 (cons #1 nil)))) (cons (cons #1 (cons #1 (cons #0 (cons #0 nil)))) (cons (cons #1 (cons #1 (cons #0 (cons #1 nil)))) (cons (cons #1 (cons #1 (cons #1 (cons #0 nil)))) (cons (cons #1 (cons #1 (cons #1 (cons #1 nil)))) nil))))))))))))))
iriw-exact : tso-outcomes 8 iriw ≡ tso-sum iriw-set #2520 #0
iriw-exact = λ i → tso-sum iriw-set #2520 #0
-- the axiomatic form's outcomes for the same threads (lib/isa/tso.cub, `tso-ax-outcomes`): every
-- candidate execution with read values in {0 , 1}, every rf and every order of the writes to
-- each address; 16 candidates, 15 TSO-consistent, and their results are the same set
iriw-dom : List Word
iriw-dom = cons #0 (cons #1 nil)
#show tso-ax-outcomes (λ a → #0) iriw-dom iriw
iriw-ax : tso-ax-outcomes (λ a → #0) iriw-dom iriw ≡ tso-ax iriw-set #16 #15
iriw-ax = λ i → tso-ax iriw-set #16 #15
