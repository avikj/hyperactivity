-- experiments/nbe/check-wip.cub — the checker that returns derivations (task graph:
-- checker-returns-derivations), built up here and moved into lib/nbe.cub when it checks. Checking
-- mode takes the expected type as a cube M of some Y with h : Y → Sem s reading the type off it, and
-- returns the element cube E over M (a cube over the base paired with M) with a derivation at
-- pairM M E; an elimination's premises' meanings are the projections of one dcube-pull, so the paths
-- der-tr needs are fmap-pull and pull-ignore.
import "../../lib/nbe.cub"

-- the base of an element cube: a vertex and a type at each environment
ElB : (Γ : CCtx) (Y : Type 1) → Type 1
ElB Γ Y = (ebγ : CtxV (fst Γ)) × FbE (fst Γ) Y ebγ
elb : (Γ : CCtx) (Y : Type 1) (γ : CtxV (fst Γ)) → FbE (fst Γ) Y γ → ElB Γ Y
elb Γ Y γ m = (γ , m)
-- the fibre over such a pair: an element of the type h reads off the value, at every environment
ElF : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) → ElB Γ Y → Type 1
ElF Γ s Y h q = (ρ : EnvV (fst Γ) (fst q)) → El s (h (snd q ρ))
-- a vertex with the type h reads off a meaning's value there
phih : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (γ : CtxV (fst Γ)) → FbE (fst Γ) Y γ → ElB Γ (Sem s)
phih Γ s Y h γ m = (γ , λ ρ → h (m ρ))
-- an element cube over a meaning M of Y, with the type read off by h: over the cube of the types
ElOver : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) → Type 1
ElOver Γ s Y h M =
  DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t))
    (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (ElB Γ (Sem s)) (phih Γ s Y h) (snd Γ) M)
-- the meaning of a term checked against M: its type off M, its element E
pairM : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) → ElOver Γ s Y h M → Mean Γ (TV s)
pairM Γ s Y h M E =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) Y) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t)) (phih Γ s Y h)
    (λ γ m e ρ → (h (m ρ) , e ρ)) (snd Γ) M E

-- ---------------------------------------------------------------- pulling back over a lift and over a map
-- pulling back the lift of a section is mapping by the section
pull-lift0 : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X')
  (g : (x : X) (y : Y x) → F' (f x y) → F x) (l : (x : X) (y : Y x) → F' (f x y)) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y F F' f g c d (dcube-lift n X X' Y F' f l c d)) (dcube-fmap n X Y F (λ x y → g x y (l x y)) c d)
pull-lift0 zero X X' Y F F' f g l c d = λ i → g c d (l c d)
pull-lift0 (suc n) X X' Y F F' f g l c d =
  pull-lift0 n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (λ L D → lineo-push X X' Y Y F' f (λ x y z → l x y) L D D) c d
-- pulling back over a mapped cube is pulling back over the cube with the map composed, along any
-- path over dmap-fmap between the cubes pulled
pull-fm : (n : Nat) (X X' : Type 1) (Y Y' F : X → Type 1) (F' : X' → Type 1) (k : (x : X) → Y x → Y' x) (f : (x : X) → Y' x → X')
  (g : (x : X) (y : Y' x) → F' (f x y) → F x) (c : Cube n X) (d : DCube n X Y c)
  (E0 : DCube n X' F' (dcube-map n X Y' X' f c (dcube-fmap n X Y Y' k c d)))
  (E1 : DCube n X' F' (dcube-map n X Y X' (λ x y → f x (k x y)) c d)) →
  PathP (λ i → DCube n X' F' (dmap-fmap n X Y Y' X' k f c d i)) E0 E1 →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y' F F' f g c (dcube-fmap n X Y Y' k c d) E0)
    (dcube-pull n X X' Y F F' (λ x y → f x (k x y)) (λ x y → g x (k x y)) c d E1)
pull-fm zero X X' Y Y' F F' k f g c d E0 E1 Q = λ i → g c (k c d) (Q i)
pull-fm (suc n) X X' Y Y' F F' k f g c d E0 E1 Q =
  pull-fm n (Line X) (Line X') (LineO X Y) (LineO X Y') (LineO X F) (LineO X' F') (lineo-fmap X Y Y' k) (lineo-map X Y' X' f)
    (lineo-pull X X' Y' F F' f g) c d E0 E1 Q

-- ---------------------------------------------------------------- application
-- the domain read off a function's meaning
fdom : (a b : TyShape) → TV (s-pi a b) → Sem a
fdom a b q = fam-dom a b (fst q)
-- an application's meaning: the function's and the argument's element over it, by one pull
appR : (Γ : CCtx) (a b : TyShape) (Mf : Mean Γ (TV (s-pi a b))) → ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf → Mean Γ (AppV a b)
appR Γ a b Mf E =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (AppV a b))
    (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b))
    (λ γ m e ρ → (fst (m ρ) , snd (m ρ) , e ρ)) (snd Γ) Mf E
-- its function part is the function's meaning
appR-f : (Γ : CCtx) (a b : TyShape) (Mf : Mean Γ (TV (s-pi a b))) (E : ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf) →
  PathM Γ (TV (s-pi a b)) (fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) (appR Γ a b Mf E)) Mf
appR-f Γ a b Mf E =
  pcat (Mean Γ (TV (s-pi a b))) (fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) (appR Γ a b Mf E))
    (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
       (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b)) (λ γ m e ρ → m ρ) (snd Γ) Mf E)
    Mf
    (fmap-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (AppV a b)) (FbE (fst Γ) (TV (s-pi a b)))
       (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b))
       (λ γ m e ρ → (fst (m ρ) , snd (m ρ) , e ρ)) (λ γ e ρ → app-f a b (e ρ)) (snd Γ) Mf E)
    (pcat (Mean Γ (TV (s-pi a b)))
       (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
          (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b)) (λ γ m e ρ → m ρ) (snd Γ) Mf E)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b))) (λ γ m → m) (snd Γ) Mf)
       Mf
       (pull-ignore (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
          (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b)) (λ γ m → m) (snd Γ) Mf E)
       (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (s-pi a b))) (snd Γ) Mf))
-- its argument part is the argument's meaning checked against the function's domain
appR-a : (Γ : CCtx) (a b : TyShape) (Mf : Mean Γ (TV (s-pi a b))) (E : ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf) →
  PathM Γ (TV a) (fmapM Γ (AppV a b) (TV a) (app-a a b) (appR Γ a b Mf E)) (pairM Γ a (TV (s-pi a b)) (fdom a b) Mf E)
appR-a Γ a b Mf E =
  fmap-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (AppV a b)) (FbE (fst Γ) (TV a))
    (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b))
    (λ γ m e ρ → (fst (m ρ) , snd (m ρ) , e ρ)) (λ γ e ρ → app-a a b (e ρ)) (snd Γ) Mf E
-- the application rule over a checked argument: the premises carried to the projections of appR
dapp-c : (Γ : CCtx) (a b : TyShape) (f c : Code) (Mf : Mean Γ (TV (s-pi a b))) (E : ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf) →
  Der (j-tm , Γ , s-pi a b , f , Mf) → Der (j-tm , Γ , a , c , pairM Γ a (TV (s-pi a b)) (fdom a b) Mf E) →
  Der (j-tm , Γ , b , capp f c , fmapM Γ (AppV a b) (TV b) (app-r a b) (appR Γ a b Mf E))
dapp-c Γ a b f c Mf E df dc =
  dapp Γ a b (appR Γ a b Mf E) f c
    (der-tr j-tm Γ (s-pi a b) f Mf (fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) (appR Γ a b Mf E)) (λ i → appR-f Γ a b Mf E (~ i)) df)
    (der-tr j-tm Γ a c (pairM Γ a (TV (s-pi a b)) (fdom a b) Mf E) (fmapM Γ (AppV a b) (TV a) (app-a a b) (appR Γ a b Mf E)) (λ i → appR-a Γ a b Mf E (~ i)) dc)

-- ---------------------------------------------------------------- from synthesis to checking
-- a synthesized meaning S read as checked against its own type cube (its elements lifted)
selfE : (Γ : CCtx) (s : TyShape) (S : Mean Γ (TV s)) → ElOver Γ s (TV s) (λ q → fst q) S
selfE Γ s S =
  dcube-lift (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t))
    (phih Γ s (TV s) (λ q → fst q)) (λ γ m ρ → snd (m ρ)) (snd Γ) S
self-pair : (Γ : CCtx) (s : TyShape) (S : Mean Γ (TV s)) → PathM Γ (TV s) (pairM Γ s (TV s) (λ q → fst q) S (selfE Γ s S)) S
self-pair Γ s S =
  pcat (Mean Γ (TV s)) (pairM Γ s (TV s) (λ q → fst q) S (selfE Γ s S))
    (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) (FbE (fst Γ) (TV s)) (λ γ m → m) (snd Γ) S) S
    (pull-lift0 (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) (TV s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t))
       (phih Γ s (TV s) (λ q → fst q)) (λ γ m e ρ → (fst (m ρ) , e ρ)) (λ γ m ρ → snd (m ρ)) (snd Γ) S)
    (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) (snd Γ) S)
-- the pairs' base of a type cube, and the cube of types of (Y, h, M) mapped to it
pairT : (Γ : CCtx) (s : TyShape) (γ : CtxV (fst Γ)) → FbE (fst Γ) (Sem s) γ → ElB Γ (Sem s)
pairT Γ s γ t = (γ , t)
tybase : (Γ : CCtx) (s : TyShape) (T : Mean Γ (Sem s)) → Cube (dims (fst Γ)) (ElB Γ (Sem s))
tybase Γ s T = dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Sem s)) (ElB Γ (Sem s)) (pairT Γ s) (snd Γ) T
tyb-path : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) →
  PathP (λ i → Cube (dims (fst Γ)) (ElB Γ (Sem s))) (tybase Γ s (fmapM Γ Y (Sem s) h M))
    (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (ElB Γ (Sem s)) (phih Γ s Y h) (snd Γ) M)
tyb-path Γ s Y h M =
  dmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (FbE (fst Γ) (Sem s)) (ElB Γ (Sem s)) (λ γ e ρ → h (e ρ)) (pairT Γ s) (snd Γ) M
-- the meaning over a type cube
pairTy : (Γ : CCtx) (s : TyShape) (T : Mean Γ (Sem s)) →
  DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s T) → Mean Γ (TV s)
pairTy Γ s T E =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) (Sem s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t)) (pairT Γ s)
    (λ γ t e ρ → (t ρ , e ρ)) (snd Γ) T E
-- (Y, h, M)'s meaning is the meaning over its type cube, for an element carried along tyb-path
pair-ty : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y)
  (E0 : DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s (fmapM Γ Y (Sem s) h M))) (E1 : ElOver Γ s Y h M) →
  PathP (λ i → DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tyb-path Γ s Y h M i)) E0 E1 →
  PathM Γ (TV s) (pairTy Γ s (fmapM Γ Y (Sem s) h M) E0) (pairM Γ s Y h M E1)
pair-ty Γ s Y h M E0 E1 Q =
  pull-fm (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) Y) (FbE (fst Γ) (Sem s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t))
    (λ γ e ρ → h (e ρ)) (pairT Γ s) (λ γ t e ρ → (t ρ , e ρ)) (snd Γ) M E0 E1 Q
-- checking a synthesized meaning S against (Y, h, M) along a path of their type cubes: the element
-- cube, and the path from S to its meaning as checked
conv-E : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) (S : Mean Γ (TV s)) →
  PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) S) (fmapM Γ Y (Sem s) h M) → ElOver Γ s Y h M
conv-E Γ s Y h M S p =
  carry (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s (fmapM Γ Y (Sem s) h M))
    (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (ElB Γ (Sem s)) (phih Γ s Y h) (snd Γ) M) (tyb-path Γ s Y h M)
    (carry (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s (fmapM Γ (TV s) (Sem s) (λ q → fst q) S)) (tybase Γ s (fmapM Γ Y (Sem s) h M))
       (λ i → tybase Γ s (p i))
       (carry (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t))
          (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) (ElB Γ (Sem s)) (phih Γ s (TV s) (λ q → fst q)) (snd Γ) S)
          (tybase Γ s (fmapM Γ (TV s) (Sem s) (λ q → fst q) S)) (λ i → tyb-path Γ s (TV s) (λ q → fst q) S (~ i)) (selfE Γ s S)))
conv-path : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) (S : Mean Γ (TV s)) →
  (p : PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) S) (fmapM Γ Y (Sem s) h M)) →
  PathM Γ (TV s) S (pairM Γ s Y h M (conv-E Γ s Y h M S p))
conv-path Γ s Y h M S p =
  let n = dims (fst Γ)
      XB = ElB Γ (Sem s)
      FB = ElF Γ s (Sem s) (λ t → t)
      TS = fmapM Γ (TV s) (Sem s) (λ q → fst q) S
      TM = fmapM Γ Y (Sem s) h M
      BS = dcube-map n (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) XB (phih Γ s (TV s) (λ q → fst q)) (snd Γ) S
      BM = dcube-map n (CtxV (fst Γ)) (FbE (fst Γ) Y) XB (phih Γ s Y h) (snd Γ) M
      E1 = selfE Γ s S
      E0 = carry n XB FB BS (tybase Γ s TS) (λ i → tyb-path Γ s (TV s) (λ q → fst q) S (~ i)) E1
      F0 = carry-fill n XB FB BS (tybase Γ s TS) (λ i → tyb-path Γ s (TV s) (λ q → fst q) S (~ i)) E1
      ET = carry n XB FB (tybase Γ s TS) (tybase Γ s TM) (λ i → tybase Γ s (p i)) E0
      FT = carry-fill n XB FB (tybase Γ s TS) (tybase Γ s TM) (λ i → tybase Γ s (p i)) E0
      FM = carry-fill n XB FB (tybase Γ s TM) BM (tyb-path Γ s Y h M) ET
      m1 = pairM Γ s (TV s) (λ q → fst q) S E1
      m2 = pairTy Γ s TS E0
      m3 = pairTy Γ s TM ET
      res = pairM Γ s Y h M (conv-E Γ s Y h M S p)
  in pcat (Mean Γ (TV s)) S m1 res (λ i → self-pair Γ s S (~ i))
       (pcat (Mean Γ (TV s)) m1 m2 res (λ i → pair-ty Γ s (TV s) (λ q → fst q) S E0 E1 (λ j → F0 (~ j)) (~ i))
          (pcat (Mean Γ (TV s)) m2 m3 res (λ i → pairTy Γ s (p i) (FT i))
             (pair-ty Γ s Y h M ET (conv-E Γ s Y h M S p) FM)))

-- ---------------------------------------------------------------- cubes reindexed from a pointwise cube
-- the action of the structural maps on a pointwise cube reindexed along k: each a reindexing of a
-- pointwise cube again (plain induction; each level is judgmental)
fmap-pt : (n : Nat) (X X' : Type 1) (F' F2 : X' → Type 1) (k : X → X') (h : (x' : X') → F' x' → F2 x') (g : (x : X) → F' (k x)) (c : Cube n X) →
  PathP (λ i → DCube n X' F2 (cube-map n X X' k c))
    (dcube-fmap n X' F' F2 h (cube-map n X X' k c) (dcube-reidx n X X' (λ x → F' (k x)) F' k (λ x y → y) c (dcube-of n X (λ x → F' (k x)) g c)))
    (dcube-reidx n X X' (λ x → F2 (k x)) F2 k (λ x y → y) c (dcube-of n X (λ x → F2 (k x)) (λ x → h (k x) (g x)) c))
fmap-pt zero X X' F' F2 k h g c = λ i → h (k c) (g c)
fmap-pt (suc n) X X' F' F2 k h g c =
  fmap-pt n (Line X) (Line X') (LineO X' F') (LineO X' F2) (line-map X X' k) (lineo-fmap X' F' F2 h) (lineo-of X (λ x → F' (k x)) g) c
of-pt : (n : Nat) (X X' : Type 1) (F' : X' → Type 1) (k : X → X') (G : (x' : X') → F' x') (c : Cube n X) →
  PathP (λ i → DCube n X' F' (cube-map n X X' k c)) (dcube-of n X' F' G (cube-map n X X' k c))
    (dcube-reidx n X X' (λ x → F' (k x)) F' k (λ x y → y) c (dcube-of n X (λ x → F' (k x)) (λ x → G (k x)) c))
of-pt zero X X' F' k G c = λ i → G (k c)
of-pt (suc n) X X' F' k G c = of-pt n (Line X) (Line X') (LineO X' F') (line-map X X' k) (lineo-of X' F' G) c
-- a context extended over a pointwise cube is a map of the base, and a lift over it a reindexing
PT-map : (n : Nat) (X X' X2 : Type 1) (Y' : X' → Type 1) (k : X → X') (f : (x' : X') → Y' x' → X2) (g : (x : X) → Y' (k x)) (c : Cube n X) →
  PathP (λ i → Cube n X2)
    (dcube-map n X' Y' X2 f (cube-map n X X' k c) (dcube-reidx n X X' (λ x → Y' (k x)) Y' k (λ x y → y) c (dcube-of n X (λ x → Y' (k x)) g c)))
    (cube-map n X X2 (λ x → f (k x) (g x)) c)
PT-map zero X X' X2 Y' k f g c = λ i → f (k c) (g c)
PT-map (suc n) X X' X2 Y' k f g c =
  PT-map n (Line X) (Line X') (Line X2) (LineO X' Y') (line-map X X' k) (lineo-map X' Y' X2 f) (lineo-of X (λ x → Y' (k x)) g) c
PT-lift : (n : Nat) (X X' X2 : Type 1) (Y' : X' → Type 1) (F2 : X2 → Type 1) (k : X → X') (f : (x' : X') → Y' x' → X2)
  (l : (x' : X') (y : Y' x') → F2 (f x' y)) (g : (x : X) → Y' (k x)) (c : Cube n X) →
  PathP (λ i → DCube n X2 F2 (PT-map n X X' X2 Y' k f g c i))
    (dcube-lift n X' X2 Y' F2 f l (cube-map n X X' k c) (dcube-reidx n X X' (λ x → Y' (k x)) Y' k (λ x y → y) c (dcube-of n X (λ x → Y' (k x)) g c)))
    (dcube-reidx n X X2 (λ x → F2 (f (k x) (g x))) F2 (λ x → f (k x) (g x)) (λ x y → y) c (dcube-of n X (λ x → F2 (f (k x) (g x))) (λ x → l (k x) (g x)) c))
PT-lift zero X X' X2 Y' F2 k f l g c = λ i → l (k c) (g c)
PT-lift (suc n) X X' X2 Y' F2 k f l g c =
  PT-lift n (Line X) (Line X') (Line X2) (LineO X' Y') (LineO X2 F2) (line-map X X' k) (lineo-map X' Y' X2 f)
    (λ L D → lineo-push X' X2 Y' Y' F2 f (λ x y z → l x y) L D D) (lineo-of X (λ x → Y' (k x)) g) c

-- ---------------------------------------------------------------- the simple-types fragment
data STy = sbool | sarr (a : STy) (b : STy)
shp : STy → TyShape
shp sbool = s-bool
shp (sarr a b) = s-pi (shp a) (shp b)
sem : (t : STy) → Sem (shp t)
sem sbool = one
sem (sarr a b) = (sem a , λ x → sem b)
tcode : STy → Code
tcode sbool = c-bool
tcode (sarr a b) = cpi #2 (tcode a) (tcode b)
sk : List STy → Lst Entry
sk nil = lnil
sk (cons t ts) = lcons (e-ty (shp t)) (sk ts)
-- the context value over the one point, with its types constant
into : (ts : List STy) → One1 → CtxV (sk ts)
into nil x = x
into (cons t ts) x = (into ts x , λ ρ → sem t)
cube0 : (ts : List STy) → Cube (dims (sk ts)) One1
cube0 nil = one
cube0 (cons t ts) = cube0 ts
ctx-of : List STy → CCtx
ctx-of ts = (sk ts , cube-map (dims (sk ts)) One1 (CtxV (sk ts)) (into ts) (cube0 ts))
-- a meaning over ctx-of ts given pointwise over the one point
ptM : (ts : List STy) (Z : Type 1) (g : (x : One1) → EnvV (sk ts) (into ts x) → Z) → Mean (ctx-of ts) Z
ptM ts Z g =
  dcube-reidx (dims (sk ts)) One1 (CtxV (sk ts)) (λ x → FbE (sk ts) Z (into ts x)) (FbE (sk ts) Z) (into ts) (λ x y → y) (cube0 ts)
    (dcube-of (dims (sk ts)) One1 (λ x → FbE (sk ts) Z (into ts x)) g (cube0 ts))
-- the derivation of a simple type in any context of simple types, at its constant meaning
dty-s : (ts : List STy) (t : STy) → Der (j-ty , ctx-of ts , shp t , tcode t , ptM ts (Sem (shp t)) (λ x ρ → sem t))
dty-s ts sbool = dty-bool (ctx-of ts) (ptM ts One1 (λ x ρ → one))
dty-s ts (sarr a b) =
  dty-pi (ctx-of ts) (shp a) (shp b) (ptM ts (Fam (shp a) (shp b)) (λ x ρ → sem (sarr a b))) (tcode a) (tcode b)
    (der-tr j-ty (ctx-of ts) (shp a) (tcode a) (ptM ts (Sem (shp a)) (λ x ρ → sem a))
       (fmapM (ctx-of ts) (Fam (shp a) (shp b)) (Sem (shp a)) (fam-dom (shp a) (shp b)) (ptM ts (Fam (shp a) (shp b)) (λ x ρ → sem (sarr a b))))
       (λ i → fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (Fam (shp a) (shp b))) (FbE (sk ts) (Sem (shp a))) (into ts)
                (λ γ e ρ → fam-dom (shp a) (shp b) (e ρ)) (λ x ρ → sem (sarr a b)) (cube0 ts) (~ i))
       (dty-s ts a))
    (transport (λ i → Der (j-ty , (lcons (e-ty (shp a)) (sk ts) ,
                                PT-map (dims (sk ts)) One1 (CtxV (sk ts)) (CtxV (sk (cons a ts))) (FbE (sk ts) (Fam (shp a) (shp b))) (into ts)
                                  (λ γ e → (γ , λ ρ → fam-dom (shp a) (shp b) (e ρ))) (λ x ρ → sem (sarr a b)) (cube0 ts) (~ i)) ,
                        shp b , tcode b ,
                        PT-lift (dims (sk ts)) One1 (CtxV (sk ts)) (CtxV (sk (cons a ts))) (FbE (sk ts) (Fam (shp a) (shp b)))
                          (FbE (sk (cons a ts)) (Sem (shp b))) (into ts) (λ γ e → (γ , λ ρ → fam-dom (shp a) (shp b) (e ρ)))
                          (λ γ e ρ → snd (e (fst ρ)) (snd ρ)) (λ x ρ → sem (sarr a b)) (cube0 ts) (~ i)))
       (dty-s (cons a ts) b))

-- ---------------------------------------------------------------- variables of the simple-types fragment
vty : (ts : List STy) → VarP (sk ts) → STy
vty nil v = Empty-rec v
vty (cons t ts) none = t
vty (cons t ts) (some v) = vty ts v
vshape : (ts : List STy) (v : VarP (sk ts)) → PathP (λ i → TyShape) (var-shape (sk ts) v) (shp (vty ts v))
vshape nil v = Empty-rec v
vshape (cons t ts) none = λ i → shp t
vshape (cons t ts) (some v) = vshape ts v
venv : (ts : List STy) (v : VarP (sk ts)) (x : One1) → EnvV (sk ts) (into ts x) → El (shp (vty ts v)) (sem (vty ts v))
venv nil v x ρ = Empty-rec v
venv (cons t ts) none x ρ = snd ρ
venv (cons t ts) (some v) x ρ = venv ts v x (fst ρ)
vpath : (ts : List STy) (v : VarP (sk ts)) (x : One1) (ρ : EnvV (sk ts) (into ts x)) →
  PathP (λ i → TV (vshape ts v i)) (varM (sk ts) v (into ts x) ρ) (sem (vty ts v) , venv ts v x ρ)
vpath nil v x ρ = Empty-rec v
vpath (cons t ts) none x ρ = λ i → (sem t , snd ρ)
vpath (cons t ts) (some v) x ρ = vpath ts v x (fst ρ)
-- a variable's derivation at its constant meaning
vder : (ts : List STy) (v : VarP (sk ts)) →
  Der (j-tm , ctx-of ts , shp (vty ts v) , cvar (var-word (sk ts) v) , ptM ts (TV (shp (vty ts v))) (λ x ρ → (sem (vty ts v) , venv ts v x ρ)))
vder ts v =
  transport (λ i → Der (j-tm , ctx-of ts , vshape ts v i , cvar (var-word (sk ts) v) , ptM ts (TV (vshape ts v i)) (λ x ρ → vpath ts v x ρ i)))
    (der-tr j-tm (ctx-of ts) (var-shape (sk ts) v) (cvar (var-word (sk ts) v)) (varCube (ctx-of ts) v)
       (ptM ts (TV (var-shape (sk ts) v)) (λ x ρ → varM (sk ts) v (into ts x) ρ))
       (of-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (TV (var-shape (sk ts) v))) (into ts) (varM (sk ts) v) (cube0 ts))
       (dvar (ctx-of ts) v))
-- the variable a word names
lookw : (ts : List STy) (k : Word) → Opt ((v : VarP (sk ts)) × PathP (λ i → Word) (var-word (sk ts) v) k)
lookw nil k = none
lookw (cons t ts) k =
  %welimP (λ w → Opt ((v : VarP (sk (cons t ts))) × PathP (λ i → Word) (var-word (sk (cons t ts)) v) w)) k
    (some (none , λ i → #0))
    (λ m h → case lookw ts m return (λ o → Opt ((v : VarP (sk (cons t ts))) × PathP (λ i → Word) (var-word (sk (cons t ts)) v) (%wsucc m))) of
               none → none
               some p → some (some (fst p) , λ i → %wsucc (snd p i)))

-- ---------------------------------------------------------------- the checker over the simple-types fragment
-- a term checked at t: its element pointwise, and its derivation at the constant type's meaning
CK : (ts : List STy) (c : Code) (t : STy) → Type 1
CK ts c t =
  (cke : (x : One1) → EnvV (sk ts) (into ts x) → El (shp t) (sem t)) ×
  Der (j-tm , ctx-of ts , shp t , c , ptM ts (TV (shp t)) (λ x ρ → (sem t , cke x ρ)))
-- an optional value at level 1 (Opt is at level 0)
data May (A : Type 1) = may-no | may-yes (a : A)
SY : (ts : List STy) (c : Code) → Type 1
SY ts c = (syt : STy) × CK ts c syt
steq : (a b : STy) → Opt (PathP (λ i → STy) a b)
steq sbool sbool = some (λ i → sbool)
steq (sarr a b) (sarr c d) =
  case steq a c return (λ o → Opt (PathP (λ i → STy) (sarr a b) (sarr c d))) of
    none → none
    some p → (case steq b d return (λ o → Opt (PathP (λ i → STy) (sarr a b) (sarr c d))) of
                none → none
                some q → some (λ i → sarr (p i) (q i)))
steq a b = none
-- a synthesized term checked at t: its type compared with t
to-chk : (ts : List STy) (c : Code) (t : STy) → May (SY ts c) → May (CK ts c t)
to-chk ts c t s =
  case s return (λ o → May (CK ts c t)) of
    may-no → may-no
    may-yes r → (case steq (fst r) t return (λ o → May (CK ts c t)) of
                   none → may-no
                   some p → may-yes (transport (λ i → CK ts c (p i)) (snd r)))
-- application: the function's meaning and the argument's, one pointwise cube
app-ok : (ts : List STy) (f a : Code) (t1 t2 : STy) → CK ts f (sarr t1 t2) → CK ts a t1 → CK ts (capp f a) t2
app-ok ts f a t1 t2 cf ca =
  let n = dims (sk ts)
      A = shp t1
      B = shp t2
      gR = the ((x : One1) → EnvV (sk ts) (into ts x) → AppV A B) (λ x ρ → (sem (sarr t1 t2) , fst cf x ρ , fst ca x ρ))
      R = ptM ts (AppV A B) gR
  in (λ x ρ → fst cf x ρ (fst ca x ρ) ,
      der-tr j-tm (ctx-of ts) B (capp f a) (fmapM (ctx-of ts) (AppV A B) (TV B) (app-r A B) R) (ptM ts (TV B) (λ x ρ → (sem t2 , fst cf x ρ (fst ca x ρ))))
        (fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AppV A B)) (FbE (sk ts) (TV B)) (into ts) (λ γ e ρ → app-r A B (e ρ)) gR (cube0 ts))
        (dapp (ctx-of ts) A B R f a
           (der-tr j-tm (ctx-of ts) (s-pi A B) f (ptM ts (TV (s-pi A B)) (λ x ρ → (sem (sarr t1 t2) , fst cf x ρ)))
              (fmapM (ctx-of ts) (AppV A B) (TV (s-pi A B)) (app-f A B) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AppV A B)) (FbE (sk ts) (TV (s-pi A B))) (into ts) (λ γ e ρ → app-f A B (e ρ)) gR (cube0 ts) (~ i))
              (snd cf))
           (der-tr j-tm (ctx-of ts) A a (ptM ts (TV A) (λ x ρ → (sem t1 , fst ca x ρ)))
              (fmapM (ctx-of ts) (AppV A B) (TV A) (app-a A B) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AppV A B)) (FbE (sk ts) (TV A)) (into ts) (λ γ e ρ → app-a A B (e ρ)) gR (cube0 ts) (~ i))
              (snd ca))))
-- λ checked at t1 → t2: its body at t2 in the context extended by t1, carried to lam-ctx
lam-ok : (ts : List STy) (b : Code) (t1 t2 : STy) → CK (cons t1 ts) b t2 → CK ts (clam b) (sarr t1 t2)
lam-ok ts b t1 t2 cb =
  let n = dims (sk ts)
      A = shp t1
      B = shp t2
      gX = the ((x : One1) → EnvV (sk ts) (into ts x) → TV (s-pi A B)) (λ x ρ → (sem (sarr t1 t2) , λ v → fst cb x (ρ , v)))
      X = ptM ts (TV (s-pi A B)) gX
      fx = the ((γ : CtxV (sk ts)) → FbE (sk ts) (TV (s-pi A B)) γ → CtxV (sk (cons t1 ts))) (λ γ e → (γ , lam-dom (sk ts) A B γ e))
  in (λ x ρ v → fst cb x (ρ , v) ,
      dlam (ctx-of ts) A B X (tcode t1) b
        (der-tr j-ty (ctx-of ts) A (tcode t1) (ptM ts (Sem A) (λ x ρ → sem t1))
           (fmapM (ctx-of ts) (TV (s-pi A B)) (Sem A) (λ q → fam-dom A B (fst q)) X)
           (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (TV (s-pi A B))) (FbE (sk ts) (Sem A)) (into ts)
                    (λ γ e ρ → fam-dom A B (fst (e ρ))) gX (cube0 ts) (~ i))
           (dty-s ts t1))
        (transport (λ i → Der (j-tm , (lcons (e-ty A) (sk ts) ,
                                       PT-map n One1 (CtxV (sk ts)) (CtxV (sk (cons t1 ts))) (FbE (sk ts) (TV (s-pi A B))) (into ts) fx gX (cube0 ts) (~ i)) ,
                               B , b ,
                               PT-lift n One1 (CtxV (sk ts)) (CtxV (sk (cons t1 ts))) (FbE (sk ts) (TV (s-pi A B))) (FbE (sk (cons t1 ts)) (TV B))
                                 (into ts) fx (λ γ e ρ → (snd (fst (e (fst ρ))) (snd ρ) , snd (e (fst ρ)) (snd ρ))) gX (cube0 ts) (~ i)))
           (snd cb)))
-- the mode: checking at a type, or synthesizing one
data Mode = mchk (t : STy) | msyn
RT : (ts : List STy) (c : Code) (m : Mode) → Type 1
RT ts c (mchk t) = May (CK ts c t)
RT ts c msyn = May (SY ts c)
-- a synthesized result given in either mode
finish : (ts : List STy) (c : Code) (m : Mode) → May (SY ts c) → RT ts c m
finish ts c (mchk t) s = to-chk ts c t s
finish ts c msyn s = s
-- a variable synthesizes its type
syn-var : (ts : List STy) (k : Word) → May (SY ts (cvar k))
syn-var ts k =
  case lookw ts k return (λ o → May (SY ts (cvar k))) of
    none → may-no
    some p → may-yes (vty ts (fst p) ,
                      venv ts (fst p) ,
                      transport (λ i → Der (j-tm , ctx-of ts , shp (vty ts (fst p)) , cvar (snd p i) ,
                                            ptM ts (TV (shp (vty ts (fst p)))) (λ x ρ → (sem (vty ts (fst p)) , venv ts (fst p) x ρ))))
                        (vder ts (fst p)))
-- an application synthesizes the function's codomain, its argument checked at the domain
app-at : (ts : List STy) (f a : Code) (t : STy) → CK ts f t → ((t1 : STy) → May (CK ts a t1)) → May (SY ts (capp f a))
app-at ts f a sbool cf ca = may-no
app-at ts f a (sarr t1 t2) cf ca =
  case ca t1 return (λ o → May (SY ts (capp f a))) of
    may-no → may-no
    may-yes q → may-yes (t2 , app-ok ts f a t1 t2 cf q)
syn-app : (ts : List STy) (f a : Code) → May (SY ts f) → ((t1 : STy) → May (CK ts a t1)) → May (SY ts (capp f a))
syn-app ts f a sf ca =
  case sf return (λ o → May (SY ts (capp f a))) of
    may-no → may-no
    may-yes r → app-at ts f a (fst r) (snd r) ca
-- a λ checks at a function type
lam-at : (ts : List STy) (b : Code) (t : STy) → ((t1 t2 : STy) → May (CK (cons t1 ts) b t2)) → May (CK ts (clam b) t)
lam-at ts b sbool cb = may-no
lam-at ts b (sarr t1 t2) cb =
  case cb t1 t2 return (λ o → May (CK ts (clam b) (sarr t1 t2))) of
    may-no → may-no
    may-yes r → may-yes (lam-ok ts b t1 t2 r)
-- a λ in either mode: it checks at a function type and does not synthesize
lam-m : (ts : List STy) (b : Code) (m : Mode) → ((t1 t2 : STy) → May (CK (cons t1 ts) b t2)) → RT ts (clam b) m
lam-m ts b (mchk t) cb = lam-at ts b t cb
lam-m ts b msyn cb = may-no
-- the checker: a derivation of the code at the type checked, or of the type it synthesizes (the
-- context after the code, so its change under a λ is a later argument of the structural call)
ck : (c : Code) (ts : List STy) (m : Mode) → RT ts c m
ck (cvar k) ts m = finish ts (cvar k) m (syn-var ts k)
ck (clam b) ts m = lam-m ts b m (λ t1 t2 → ck b (cons t1 ts) (mchk t2))
ck (capp f a) ts m = finish ts (capp f a) m (syn-app ts f a (ck f ts msyn) (λ t1 → ck a ts (mchk t1)))
ck c ts m = finish ts c m may-no

-- ---------------------------------------------------------------- examples: raw codes checked, then normalized
-- a closed checked term as a typed code, or none
tcode-of : (c : Code) (t : STy) → May (CK nil c t) → Opt Code
tcode-of c t r =
  case r return (λ o → Opt Code) of
    may-no → none
    may-yes q → some (fst (normalize-nf (ctx-of nil) tc-nil (shp t) (c , ptM nil (TV (shp t)) (λ x ρ → (sem t , fst q x ρ)) , snd q)))
-- λ x. x checks at Bool → Bool, and normalizes to itself
#same tcode-of (clam (cvar #0)) (sarr sbool sbool) (ck (clam (cvar #0)) nil (mchk (sarr sbool sbool))) = some (clam (cvar #0))
