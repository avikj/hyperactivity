-- experiments/nbe/check-wip.cub — the checker that returns derivations (task graph:
-- checker-returns-derivations), built up here and moved into lib/capacities/nbe.cub when it checks. Checking
-- mode takes the expected type as a cube M of some Y with h : Y → Sem s reading the type off it, and
-- returns the element cube E over M (a cube over the base paired with M) with a derivation at
-- pairM M E; an elimination's premises' meanings are the projections of one dcube-pull, so the paths
-- der-tr needs are fmap-pull and pull-ignore.
import "../../lib/capacities/nbe.cub"

-- the base of an element cube: a vertex and a type at each environment
ElB : (Γ : CCtx) (Y : Type 1) → Type 1
ElB Γ Y = (ebγ : CtxV (fst Γ)) × FbE (fst Γ) Y ebγ
elb : (Γ : CCtx) (Y : Type 1) (γ : CtxV (fst Γ)) → FbE (fst Γ) Y γ → ElB Γ Y
elb Γ Y γ m = (γ , m)
-- the fibre over such a pair: an element of the type h reads off the value, at every environment
ElF : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) → ElB Γ Y → Type 1
ElF Γ s Y h q = (ρ : EnvV (fst Γ) (fst q)) → El s (h (snd q ρ))
-- a vertex with the type h reads off a meaning's value there
phih : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (γ : CtxV (fst Γ)) → FbE (fst Γ) Y γ → ElB Γ (Sem s)
phih Γ s Y h γ m = (γ , λ ρ → h (m ρ))
-- an element cube over a meaning M of Y, with the type read off by h: over the cube of the types
ElOver : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) → Type 1
ElOver Γ s Y h M =
  DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t))
    (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (ElB Γ (Sem s)) (phih Γ s Y h) (snd Γ) M)
-- the meaning of a term checked against M: its type off M, its element E
pairM : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) → ElOver Γ s Y h M → Mean Γ (TV s)
pairM Γ s Y h M E =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) Y) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t)) (phih Γ s Y h)
    (λ γ m e ρ → (h (m ρ) , e ρ)) (snd Γ) M E

-- ---------------------------------------------------------------- pulling back over a lift and over a map
-- pulling back the lift of a section is mapping by the section
pull-lift0 : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X')
  (g : (x : X) (y : Y x) → F' (f x y) → F x) (l : (x : X) (y : Y x) → F' (f x y)) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y F F' f g c d (dcube-lift n X X' Y F' f l c d)) (dcube-fmap n X Y F (λ x y → g x y (l x y)) c d)
pull-lift0 zero X X' Y F F' f g l c d = λ i → g c d (l c d)
pull-lift0 (suc n) X X' Y F F' f g l c d =
  pull-lift0 n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (λ L D → lineo-push X X' Y Y F' f (λ x y z → l x y) L D D) c d
-- pulling back over a mapped cube is pulling back over the cube with the map composed, along any
-- path over dmap-fmap between the cubes pulled
pull-fm : (n : Nat) (X X' : Type 1) (Y Y' F : X → Type 1) (F' : X' → Type 1) (k : (x : X) → Y x → Y' x) (f : (x : X) → Y' x → X')
  (g : (x : X) (y : Y' x) → F' (f x y) → F x) (c : Cube n X) (d : DCube n X Y c)
  (E0 : DCube n X' F' (dcube-map n X Y' X' f c (dcube-fmap n X Y Y' k c d)))
  (E1 : DCube n X' F' (dcube-map n X Y X' (λ x y → f x (k x y)) c d)) →
  PathP (λ i → DCube n X' F' (dmap-fmap n X Y Y' X' k f c d i)) E0 E1 →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y' F F' f g c (dcube-fmap n X Y Y' k c d) E0)
    (dcube-pull n X X' Y F F' (λ x y → f x (k x y)) (λ x y → g x (k x y)) c d E1)
pull-fm zero X X' Y Y' F F' k f g c d E0 E1 Q = λ i → g c (k c d) (Q i)
pull-fm (suc n) X X' Y Y' F F' k f g c d E0 E1 Q =
  pull-fm n (Line X) (Line X') (LineO X Y) (LineO X Y') (LineO X F) (LineO X' F') (lineo-fmap X Y Y' k) (lineo-map X Y' X' f)
    (lineo-pull X X' Y' F F' f g) c d E0 E1 Q

-- ---------------------------------------------------------------- application
-- the domain read off a function's meaning
fdom : (a b : TyShape) → TV (s-pi a b) → Sem a
fdom a b q = fam-dom a b (fst q)
-- an application's meaning: the function's and the argument's element over it, by one pull
appR : (Γ : CCtx) (a b : TyShape) (Mf : Mean Γ (TV (s-pi a b))) → ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf → Mean Γ (AppV a b)
appR Γ a b Mf E =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (AppV a b))
    (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b))
    (λ γ m e ρ → (fst (m ρ) , snd (m ρ) , e ρ)) (snd Γ) Mf E
-- its function part is the function's meaning
appR-f : (Γ : CCtx) (a b : TyShape) (Mf : Mean Γ (TV (s-pi a b))) (E : ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf) →
  PathM Γ (TV (s-pi a b)) (fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) (appR Γ a b Mf E)) Mf
appR-f Γ a b Mf E =
  pcat (Mean Γ (TV (s-pi a b))) (fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) (appR Γ a b Mf E))
    (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
       (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b)) (λ γ m e ρ → m ρ) (snd Γ) Mf E)
    Mf
    (fmap-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (AppV a b)) (FbE (fst Γ) (TV (s-pi a b)))
       (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b))
       (λ γ m e ρ → (fst (m ρ) , snd (m ρ) , e ρ)) (λ γ e ρ → app-f a b (e ρ)) (snd Γ) Mf E)
    (pcat (Mean Γ (TV (s-pi a b)))
       (dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
          (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b)) (λ γ m e ρ → m ρ) (snd Γ) Mf E)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b))) (λ γ m → m) (snd Γ) Mf)
       Mf
       (pull-ignore (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
          (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b)) (λ γ m → m) (snd Γ) Mf E)
       (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV (s-pi a b))) (snd Γ) Mf))
-- its argument part is the argument's meaning checked against the function's domain
appR-a : (Γ : CCtx) (a b : TyShape) (Mf : Mean Γ (TV (s-pi a b))) (E : ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf) →
  PathM Γ (TV a) (fmapM Γ (AppV a b) (TV a) (app-a a b) (appR Γ a b Mf E)) (pairM Γ a (TV (s-pi a b)) (fdom a b) Mf E)
appR-a Γ a b Mf E =
  fmap-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem a)) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (AppV a b)) (FbE (fst Γ) (TV a))
    (ElF Γ a (Sem a) (λ t → t)) (phih Γ a (TV (s-pi a b)) (fdom a b))
    (λ γ m e ρ → (fst (m ρ) , snd (m ρ) , e ρ)) (λ γ e ρ → app-a a b (e ρ)) (snd Γ) Mf E
-- the application rule over a checked argument: the premises carried to the projections of appR
dapp-c : (Γ : CCtx) (a b : TyShape) (f c : Code) (Mf : Mean Γ (TV (s-pi a b))) (E : ElOver Γ a (TV (s-pi a b)) (fdom a b) Mf) →
  Der (j-tm , Γ , s-pi a b , f , Mf) → Der (j-tm , Γ , a , c , pairM Γ a (TV (s-pi a b)) (fdom a b) Mf E) →
  Der (j-tm , Γ , b , capp f c , fmapM Γ (AppV a b) (TV b) (app-r a b) (appR Γ a b Mf E))
dapp-c Γ a b f c Mf E df dc =
  dapp Γ a b (appR Γ a b Mf E) f c
    (der-tr j-tm Γ (s-pi a b) f Mf (fmapM Γ (AppV a b) (TV (s-pi a b)) (app-f a b) (appR Γ a b Mf E)) (λ i → appR-f Γ a b Mf E (~ i)) df)
    (der-tr j-tm Γ a c (pairM Γ a (TV (s-pi a b)) (fdom a b) Mf E) (fmapM Γ (AppV a b) (TV a) (app-a a b) (appR Γ a b Mf E)) (λ i → appR-a Γ a b Mf E (~ i)) dc)

-- ---------------------------------------------------------------- from synthesis to checking
-- a synthesized meaning S read as checked against its own type cube (its elements lifted)
selfE : (Γ : CCtx) (s : TyShape) (S : Mean Γ (TV s)) → ElOver Γ s (TV s) (λ q → fst q) S
selfE Γ s S =
  dcube-lift (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t))
    (phih Γ s (TV s) (λ q → fst q)) (λ γ m ρ → snd (m ρ)) (snd Γ) S
self-pair : (Γ : CCtx) (s : TyShape) (S : Mean Γ (TV s)) → PathM Γ (TV s) (pairM Γ s (TV s) (λ q → fst q) S (selfE Γ s S)) S
self-pair Γ s S =
  pcat (Mean Γ (TV s)) (pairM Γ s (TV s) (λ q → fst q) S (selfE Γ s S))
    (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) (FbE (fst Γ) (TV s)) (λ γ m → m) (snd Γ) S) S
    (pull-lift0 (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) (TV s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t))
       (phih Γ s (TV s) (λ q → fst q)) (λ γ m e ρ → (fst (m ρ) , e ρ)) (λ γ m ρ → snd (m ρ)) (snd Γ) S)
    (fmap-id (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) (snd Γ) S)
-- the pairs' base of a type cube, and the cube of types of (Y, h, M) mapped to it
pairT : (Γ : CCtx) (s : TyShape) (γ : CtxV (fst Γ)) → FbE (fst Γ) (Sem s) γ → ElB Γ (Sem s)
pairT Γ s γ t = (γ , t)
tybase : (Γ : CCtx) (s : TyShape) (T : Mean Γ (Sem s)) → Cube (dims (fst Γ)) (ElB Γ (Sem s))
tybase Γ s T = dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (Sem s)) (ElB Γ (Sem s)) (pairT Γ s) (snd Γ) T
tyb-path : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) →
  PathP (λ i → Cube (dims (fst Γ)) (ElB Γ (Sem s))) (tybase Γ s (fmapM Γ Y (Sem s) h M))
    (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (ElB Γ (Sem s)) (phih Γ s Y h) (snd Γ) M)
tyb-path Γ s Y h M =
  dmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (FbE (fst Γ) (Sem s)) (ElB Γ (Sem s)) (λ γ e ρ → h (e ρ)) (pairT Γ s) (snd Γ) M
-- the meaning over a type cube
pairTy : (Γ : CCtx) (s : TyShape) (T : Mean Γ (Sem s)) →
  DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s T) → Mean Γ (TV s)
pairTy Γ s T E =
  dcube-pull (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) (Sem s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t)) (pairT Γ s)
    (λ γ t e ρ → (t ρ , e ρ)) (snd Γ) T E
-- (Y, h, M)'s meaning is the meaning over its type cube, for an element carried along tyb-path
pair-ty : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y)
  (E0 : DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s (fmapM Γ Y (Sem s) h M))) (E1 : ElOver Γ s Y h M) →
  PathP (λ i → DCube (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tyb-path Γ s Y h M i)) E0 E1 →
  PathM Γ (TV s) (pairTy Γ s (fmapM Γ Y (Sem s) h M) E0) (pairM Γ s Y h M E1)
pair-ty Γ s Y h M E0 E1 Q =
  pull-fm (dims (fst Γ)) (CtxV (fst Γ)) (ElB Γ (Sem s)) (FbE (fst Γ) Y) (FbE (fst Γ) (Sem s)) (FbE (fst Γ) (TV s)) (ElF Γ s (Sem s) (λ t → t))
    (λ γ e ρ → h (e ρ)) (pairT Γ s) (λ γ t e ρ → (t ρ , e ρ)) (snd Γ) M E0 E1 Q
-- checking a synthesized meaning S against (Y, h, M) along a path of their type cubes: the element
-- cube, and the path from S to its meaning as checked
conv-E : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) (S : Mean Γ (TV s)) →
  PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) S) (fmapM Γ Y (Sem s) h M) → ElOver Γ s Y h M
conv-E Γ s Y h M S p =
  carry (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s (fmapM Γ Y (Sem s) h M))
    (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (ElB Γ (Sem s)) (phih Γ s Y h) (snd Γ) M) (tyb-path Γ s Y h M)
    (carry (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t)) (tybase Γ s (fmapM Γ (TV s) (Sem s) (λ q → fst q) S)) (tybase Γ s (fmapM Γ Y (Sem s) h M))
       (λ i → tybase Γ s (p i))
       (carry (dims (fst Γ)) (ElB Γ (Sem s)) (ElF Γ s (Sem s) (λ t → t))
          (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) (ElB Γ (Sem s)) (phih Γ s (TV s) (λ q → fst q)) (snd Γ) S)
          (tybase Γ s (fmapM Γ (TV s) (Sem s) (λ q → fst q) S)) (λ i → tyb-path Γ s (TV s) (λ q → fst q) S (~ i)) (selfE Γ s S)))
conv-path : (Γ : CCtx) (s : TyShape) (Y : Type 1) (h : Y → Sem s) (M : Mean Γ Y) (S : Mean Γ (TV s)) →
  (p : PathM Γ (Sem s) (fmapM Γ (TV s) (Sem s) (λ q → fst q) S) (fmapM Γ Y (Sem s) h M)) →
  PathM Γ (TV s) S (pairM Γ s Y h M (conv-E Γ s Y h M S p))
conv-path Γ s Y h M S p =
  let n = dims (fst Γ)
      XB = ElB Γ (Sem s)
      FB = ElF Γ s (Sem s) (λ t → t)
      TS = fmapM Γ (TV s) (Sem s) (λ q → fst q) S
      TM = fmapM Γ Y (Sem s) h M
      BS = dcube-map n (CtxV (fst Γ)) (FbE (fst Γ) (TV s)) XB (phih Γ s (TV s) (λ q → fst q)) (snd Γ) S
      BM = dcube-map n (CtxV (fst Γ)) (FbE (fst Γ) Y) XB (phih Γ s Y h) (snd Γ) M
      E1 = selfE Γ s S
      E0 = carry n XB FB BS (tybase Γ s TS) (λ i → tyb-path Γ s (TV s) (λ q → fst q) S (~ i)) E1
      F0 = carry-fill n XB FB BS (tybase Γ s TS) (λ i → tyb-path Γ s (TV s) (λ q → fst q) S (~ i)) E1
      ET = carry n XB FB (tybase Γ s TS) (tybase Γ s TM) (λ i → tybase Γ s (p i)) E0
      FT = carry-fill n XB FB (tybase Γ s TS) (tybase Γ s TM) (λ i → tybase Γ s (p i)) E0
      FM = carry-fill n XB FB (tybase Γ s TM) BM (tyb-path Γ s Y h M) ET
      m1 = pairM Γ s (TV s) (λ q → fst q) S E1
      m2 = pairTy Γ s TS E0
      m3 = pairTy Γ s TM ET
      res = pairM Γ s Y h M (conv-E Γ s Y h M S p)
  in pcat (Mean Γ (TV s)) S m1 res (λ i → self-pair Γ s S (~ i))
       (pcat (Mean Γ (TV s)) m1 m2 res (λ i → pair-ty Γ s (TV s) (λ q → fst q) S E0 E1 (λ j → F0 (~ j)) (~ i))
          (pcat (Mean Γ (TV s)) m2 m3 res (λ i → pairTy Γ s (p i) (FT i))
             (pair-ty Γ s Y h M ET (conv-E Γ s Y h M S p) FM)))

-- ---------------------------------------------------------------- cubes reindexed from a pointwise cube
-- the action of the structural maps on a pointwise cube reindexed along k: each a reindexing of a
-- pointwise cube again (plain induction; each level is judgmental)
fmap-pt : (n : Nat) (X X' : Type 1) (F' F2 : X' → Type 1) (k : X → X') (h : (x' : X') → F' x' → F2 x') (g : (x : X) → F' (k x)) (c : Cube n X) →
  PathP (λ i → DCube n X' F2 (cube-map n X X' k c))
    (dcube-fmap n X' F' F2 h (cube-map n X X' k c) (dcube-reidx n X X' (λ x → F' (k x)) F' k (λ x y → y) c (dcube-of n X (λ x → F' (k x)) g c)))
    (dcube-reidx n X X' (λ x → F2 (k x)) F2 k (λ x y → y) c (dcube-of n X (λ x → F2 (k x)) (λ x → h (k x) (g x)) c))
fmap-pt zero X X' F' F2 k h g c = λ i → h (k c) (g c)
fmap-pt (suc n) X X' F' F2 k h g c =
  fmap-pt n (Line X) (Line X') (LineO X' F') (LineO X' F2) (line-map X X' k) (lineo-fmap X' F' F2 h) (lineo-of X (λ x → F' (k x)) g) c
of-pt : (n : Nat) (X X' : Type 1) (F' : X' → Type 1) (k : X → X') (G : (x' : X') → F' x') (c : Cube n X) →
  PathP (λ i → DCube n X' F' (cube-map n X X' k c)) (dcube-of n X' F' G (cube-map n X X' k c))
    (dcube-reidx n X X' (λ x → F' (k x)) F' k (λ x y → y) c (dcube-of n X (λ x → F' (k x)) (λ x → G (k x)) c))
of-pt zero X X' F' k G c = λ i → G (k c)
of-pt (suc n) X X' F' k G c = of-pt n (Line X) (Line X') (LineO X' F') (line-map X X' k) (lineo-of X' F' G) c
-- a context extended over a pointwise cube is a map of the base, and a lift over it a reindexing
PT-map : (n : Nat) (X X' X2 : Type 1) (Y' : X' → Type 1) (k : X → X') (f : (x' : X') → Y' x' → X2) (g : (x : X) → Y' (k x)) (c : Cube n X) →
  PathP (λ i → Cube n X2)
    (dcube-map n X' Y' X2 f (cube-map n X X' k c) (dcube-reidx n X X' (λ x → Y' (k x)) Y' k (λ x y → y) c (dcube-of n X (λ x → Y' (k x)) g c)))
    (cube-map n X X2 (λ x → f (k x) (g x)) c)
PT-map zero X X' X2 Y' k f g c = λ i → f (k c) (g c)
PT-map (suc n) X X' X2 Y' k f g c =
  PT-map n (Line X) (Line X') (Line X2) (LineO X' Y') (line-map X X' k) (lineo-map X' Y' X2 f) (lineo-of X (λ x → Y' (k x)) g) c
PT-lift : (n : Nat) (X X' X2 : Type 1) (Y' : X' → Type 1) (F2 : X2 → Type 1) (k : X → X') (f : (x' : X') → Y' x' → X2)
  (l : (x' : X') (y : Y' x') → F2 (f x' y)) (g : (x : X) → Y' (k x)) (c : Cube n X) →
  PathP (λ i → DCube n X2 F2 (PT-map n X X' X2 Y' k f g c i))
    (dcube-lift n X' X2 Y' F2 f l (cube-map n X X' k c) (dcube-reidx n X X' (λ x → Y' (k x)) Y' k (λ x y → y) c (dcube-of n X (λ x → Y' (k x)) g c)))
    (dcube-reidx n X X2 (λ x → F2 (f (k x) (g x))) F2 (λ x → f (k x) (g x)) (λ x y → y) c (dcube-of n X (λ x → F2 (f (k x) (g x))) (λ x → l (k x) (g x)) c))
PT-lift zero X X' X2 Y' F2 k f l g c = λ i → l (k c) (g c)
PT-lift (suc n) X X' X2 Y' F2 k f l g c =
  PT-lift n (Line X) (Line X') (Line X2) (LineO X' Y') (LineO X2 F2) (line-map X X' k) (lineo-map X' Y' X2 f)
    (λ L D → lineo-push X' X2 Y' Y' F2 f (λ x y z → l x y) L D D) (lineo-of X (λ x → Y' (k x)) g) c

-- ---------------------------------------------------------------- the simple-types fragment
data STy = sbool | sarr (a : STy) (b : STy) | sprod (a : STy) (b : STy) | snat | sunit | sempty
shp : STy → TyShape
shp sbool = s-bool
shp (sarr a b) = s-pi (shp a) (shp b)
shp (sprod a b) = s-sig (shp a) (shp b)
shp snat = s-nat
shp sunit = s-unit
shp sempty = s-empty
sem : (t : STy) → Sem (shp t)
sem sbool = one
sem (sarr a b) = (sem a , λ x → sem b)
sem (sprod a b) = (sem a , λ x → sem b)
sem snat = one
sem sunit = one
sem sempty = one
tcode : STy → Code
tcode sbool = c-bool
tcode (sarr a b) = cpi #2 (tcode a) (tcode b)
tcode (sprod a b) = csigma (tcode a) (tcode b)
tcode snat = c-nat
tcode sunit = c-unit
tcode sempty = c-empty
sk : List STy → Lst Entry
sk nil = lnil
sk (cons t ts) = lcons (e-ty (shp t)) (sk ts)
-- the context value over the one point, with its types constant
into : (ts : List STy) → One1 → CtxV (sk ts)
into nil x = x
into (cons t ts) x = (into ts x , λ ρ → sem t)
cube0 : (ts : List STy) → Cube (dims (sk ts)) One1
cube0 nil = one
cube0 (cons t ts) = cube0 ts
ctx-of : List STy → CCtx
ctx-of ts = (sk ts , cube-map (dims (sk ts)) One1 (CtxV (sk ts)) (into ts) (cube0 ts))
-- a meaning over ctx-of ts given pointwise over the one point
ptM : (ts : List STy) (Z : Type 1) (g : (x : One1) → EnvV (sk ts) (into ts x) → Z) → Mean (ctx-of ts) Z
ptM ts Z g =
  dcube-reidx (dims (sk ts)) One1 (CtxV (sk ts)) (λ x → FbE (sk ts) Z (into ts x)) (FbE (sk ts) Z) (into ts) (λ x y → y) (cube0 ts)
    (dcube-of (dims (sk ts)) One1 (λ x → FbE (sk ts) Z (into ts x)) g (cube0 ts))
-- the derivation of a simple type in any context of simple types, at its constant meaning
dty-s : (ts : List STy) (t : STy) → Der (j-ty , ctx-of ts , shp t , tcode t , ptM ts (Sem (shp t)) (λ x ρ → sem t))
dty-s ts sbool = dty-bool (ctx-of ts) (ptM ts One1 (λ x ρ → one))
dty-s ts snat = dty-nat (ctx-of ts) (ptM ts One1 (λ x ρ → one))
dty-s ts sunit = dty-unit (ctx-of ts) (ptM ts One1 (λ x ρ → one))
dty-s ts sempty = dty-empty (ctx-of ts) (ptM ts One1 (λ x ρ → one))
dty-s ts (sarr a b) =
  dty-pi (ctx-of ts) (shp a) (shp b) (ptM ts (Fam (shp a) (shp b)) (λ x ρ → sem (sarr a b))) (tcode a) (tcode b)
    (der-tr j-ty (ctx-of ts) (shp a) (tcode a) (ptM ts (Sem (shp a)) (λ x ρ → sem a))
       (fmapM (ctx-of ts) (Fam (shp a) (shp b)) (Sem (shp a)) (fam-dom (shp a) (shp b)) (ptM ts (Fam (shp a) (shp b)) (λ x ρ → sem (sarr a b))))
       (λ i → fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (Fam (shp a) (shp b))) (FbE (sk ts) (Sem (shp a))) (into ts)
                (λ γ e ρ → fam-dom (shp a) (shp b) (e ρ)) (λ x ρ → sem (sarr a b)) (cube0 ts) (~ i))
       (dty-s ts a))
    (transport (λ i → Der (j-ty , (lcons (e-ty (shp a)) (sk ts) ,
                                PT-map (dims (sk ts)) One1 (CtxV (sk ts)) (CtxV (sk (cons a ts))) (FbE (sk ts) (Fam (shp a) (shp b))) (into ts)
                                  (λ γ e → (γ , λ ρ → fam-dom (shp a) (shp b) (e ρ))) (λ x ρ → sem (sarr a b)) (cube0 ts) (~ i)) ,
                        shp b , tcode b ,
                        PT-lift (dims (sk ts)) One1 (CtxV (sk ts)) (CtxV (sk (cons a ts))) (FbE (sk ts) (Fam (shp a) (shp b)))
                          (FbE (sk (cons a ts)) (Sem (shp b))) (into ts) (λ γ e → (γ , λ ρ → fam-dom (shp a) (shp b) (e ρ)))
                          (λ γ e ρ → snd (e (fst ρ)) (snd ρ)) (λ x ρ → sem (sarr a b)) (cube0 ts) (~ i)))
       (dty-s (cons a ts) b))
dty-s ts (sprod a b) =
  dty-sig (ctx-of ts) (shp a) (shp b) (ptM ts (Fam (shp a) (shp b)) (λ x ρ → sem (sprod a b))) (tcode a) (tcode b)
    (der-tr j-ty (ctx-of ts) (shp a) (tcode a) (ptM ts (Sem (shp a)) (λ x ρ → sem a))
       (fmapM (ctx-of ts) (Fam (shp a) (shp b)) (Sem (shp a)) (fam-dom (shp a) (shp b)) (ptM ts (Fam (shp a) (shp b)) (λ x ρ → sem (sprod a b))))
       (λ i → fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (Fam (shp a) (shp b))) (FbE (sk ts) (Sem (shp a))) (into ts)
                (λ γ e ρ → fam-dom (shp a) (shp b) (e ρ)) (λ x ρ → sem (sprod a b)) (cube0 ts) (~ i))
       (dty-s ts a))
    (transport (λ i → Der (j-ty , (lcons (e-ty (shp a)) (sk ts) ,
                                PT-map (dims (sk ts)) One1 (CtxV (sk ts)) (CtxV (sk (cons a ts))) (FbE (sk ts) (Fam (shp a) (shp b))) (into ts)
                                  (λ γ e → (γ , λ ρ → fam-dom (shp a) (shp b) (e ρ))) (λ x ρ → sem (sprod a b)) (cube0 ts) (~ i)) ,
                        shp b , tcode b ,
                        PT-lift (dims (sk ts)) One1 (CtxV (sk ts)) (CtxV (sk (cons a ts))) (FbE (sk ts) (Fam (shp a) (shp b)))
                          (FbE (sk (cons a ts)) (Sem (shp b))) (into ts) (λ γ e → (γ , λ ρ → fam-dom (shp a) (shp b) (e ρ)))
                          (λ γ e ρ → snd (e (fst ρ)) (snd ρ)) (λ x ρ → sem (sprod a b)) (cube0 ts) (~ i)))
       (dty-s (cons a ts) b))

-- ---------------------------------------------------------------- variables of the simple-types fragment
vty : (ts : List STy) → VarP (sk ts) → STy
vty nil v = Empty-rec v
vty (cons t ts) none = t
vty (cons t ts) (some v) = vty ts v
vshape : (ts : List STy) (v : VarP (sk ts)) → PathP (λ i → TyShape) (var-shape (sk ts) v) (shp (vty ts v))
vshape nil v = Empty-rec v
vshape (cons t ts) none = λ i → shp t
vshape (cons t ts) (some v) = vshape ts v
venv : (ts : List STy) (v : VarP (sk ts)) (x : One1) → EnvV (sk ts) (into ts x) → El (shp (vty ts v)) (sem (vty ts v))
venv nil v x ρ = Empty-rec v
venv (cons t ts) none x ρ = snd ρ
venv (cons t ts) (some v) x ρ = venv ts v x (fst ρ)
vpath : (ts : List STy) (v : VarP (sk ts)) (x : One1) (ρ : EnvV (sk ts) (into ts x)) →
  PathP (λ i → TV (vshape ts v i)) (varM (sk ts) v (into ts x) ρ) (sem (vty ts v) , venv ts v x ρ)
vpath nil v x ρ = Empty-rec v
vpath (cons t ts) none x ρ = λ i → (sem t , snd ρ)
vpath (cons t ts) (some v) x ρ = vpath ts v x (fst ρ)
-- a variable's derivation at its constant meaning
vder : (ts : List STy) (v : VarP (sk ts)) →
  Der (j-tm , ctx-of ts , shp (vty ts v) , cvar (var-word (sk ts) v) , ptM ts (TV (shp (vty ts v))) (λ x ρ → (sem (vty ts v) , venv ts v x ρ)))
vder ts v =
  transport (λ i → Der (j-tm , ctx-of ts , vshape ts v i , cvar (var-word (sk ts) v) , ptM ts (TV (vshape ts v i)) (λ x ρ → vpath ts v x ρ i)))
    (der-tr j-tm (ctx-of ts) (var-shape (sk ts) v) (cvar (var-word (sk ts) v)) (varCube (ctx-of ts) v)
       (ptM ts (TV (var-shape (sk ts) v)) (λ x ρ → varM (sk ts) v (into ts x) ρ))
       (of-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (TV (var-shape (sk ts) v))) (into ts) (varM (sk ts) v) (cube0 ts))
       (dvar (ctx-of ts) v))
-- the variable a word names
lookw : (ts : List STy) (k : Word) → Opt ((v : VarP (sk ts)) × PathP (λ i → Word) (var-word (sk ts) v) k)
lookw nil k = none
lookw (cons t ts) k =
  %welimP (λ w → Opt ((v : VarP (sk (cons t ts))) × PathP (λ i → Word) (var-word (sk (cons t ts)) v) w)) k
    (some (none , λ i → #0))
    (λ m h → case lookw ts m return (λ o → Opt ((v : VarP (sk (cons t ts))) × PathP (λ i → Word) (var-word (sk (cons t ts)) v) (%wsucc m))) of
               none → none
               some p → some (some (fst p) , λ i → %wsucc (snd p i)))

-- ---------------------------------------------------------------- the checker over the simple-types fragment
-- a term checked at t: its element pointwise, and its derivation at the constant type's meaning
CK : (ts : List STy) (c : Code) (t : STy) → Type 1
CK ts c t =
  (cke : (x : One1) → EnvV (sk ts) (into ts x) → El (shp t) (sem t)) ×
  Der (j-tm , ctx-of ts , shp t , c , ptM ts (TV (shp t)) (λ x ρ → (sem t , cke x ρ)))
-- an optional value at level 1 (Opt is at level 0)
data May (A : Type 1) = may-no | may-yes (a : A)
SY : (ts : List STy) (c : Code) → Type 1
SY ts c = (syt : STy) × CK ts c syt
steq : (a b : STy) → Opt (PathP (λ i → STy) a b)
steq sbool sbool = some (λ i → sbool)
steq snat snat = some (λ i → snat)
steq sunit sunit = some (λ i → sunit)
steq sempty sempty = some (λ i → sempty)
steq (sarr a b) (sarr c d) =
  case steq a c return (λ o → Opt (PathP (λ i → STy) (sarr a b) (sarr c d))) of
    none → none
    some p → (case steq b d return (λ o → Opt (PathP (λ i → STy) (sarr a b) (sarr c d))) of
                none → none
                some q → some (λ i → sarr (p i) (q i)))
steq (sprod a b) (sprod c d) =
  case steq a c return (λ o → Opt (PathP (λ i → STy) (sprod a b) (sprod c d))) of
    none → none
    some p → (case steq b d return (λ o → Opt (PathP (λ i → STy) (sprod a b) (sprod c d))) of
                none → none
                some q → some (λ i → sprod (p i) (q i)))
steq a b = none
-- a synthesized term checked at t: its type compared with t
to-chk : (ts : List STy) (c : Code) (t : STy) → May (SY ts c) → May (CK ts c t)
to-chk ts c t s =
  case s return (λ o → May (CK ts c t)) of
    may-no → may-no
    may-yes r → (case steq (fst r) t return (λ o → May (CK ts c t)) of
                   none → may-no
                   some p → may-yes (transport (λ i → CK ts c (p i)) (snd r)))
-- application: the function's meaning and the argument's, one pointwise cube
app-ok : (ts : List STy) (f a : Code) (t1 t2 : STy) → CK ts f (sarr t1 t2) → CK ts a t1 → CK ts (capp f a) t2
app-ok ts f a t1 t2 cf ca =
  let n = dims (sk ts)
      A = shp t1
      B = shp t2
      gR = the ((x : One1) → EnvV (sk ts) (into ts x) → AppV A B) (λ x ρ → (sem (sarr t1 t2) , fst cf x ρ , fst ca x ρ))
      R = ptM ts (AppV A B) gR
  in (λ x ρ → fst cf x ρ (fst ca x ρ) ,
      der-tr j-tm (ctx-of ts) B (capp f a) (fmapM (ctx-of ts) (AppV A B) (TV B) (app-r A B) R) (ptM ts (TV B) (λ x ρ → (sem t2 , fst cf x ρ (fst ca x ρ))))
        (fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AppV A B)) (FbE (sk ts) (TV B)) (into ts) (λ γ e ρ → app-r A B (e ρ)) gR (cube0 ts))
        (dapp (ctx-of ts) A B R f a
           (der-tr j-tm (ctx-of ts) (s-pi A B) f (ptM ts (TV (s-pi A B)) (λ x ρ → (sem (sarr t1 t2) , fst cf x ρ)))
              (fmapM (ctx-of ts) (AppV A B) (TV (s-pi A B)) (app-f A B) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AppV A B)) (FbE (sk ts) (TV (s-pi A B))) (into ts) (λ γ e ρ → app-f A B (e ρ)) gR (cube0 ts) (~ i))
              (snd cf))
           (der-tr j-tm (ctx-of ts) A a (ptM ts (TV A) (λ x ρ → (sem t1 , fst ca x ρ)))
              (fmapM (ctx-of ts) (AppV A B) (TV A) (app-a A B) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AppV A B)) (FbE (sk ts) (TV A)) (into ts) (λ γ e ρ → app-a A B (e ρ)) gR (cube0 ts) (~ i))
              (snd ca))))
-- λ checked at t1 → t2: its body at t2 in the context extended by t1, carried to lam-ctx
lam-ok : (ts : List STy) (b : Code) (t1 t2 : STy) → CK (cons t1 ts) b t2 → CK ts (clam b) (sarr t1 t2)
lam-ok ts b t1 t2 cb =
  let n = dims (sk ts)
      A = shp t1
      B = shp t2
      gX = the ((x : One1) → EnvV (sk ts) (into ts x) → TV (s-pi A B)) (λ x ρ → (sem (sarr t1 t2) , λ v → fst cb x (ρ , v)))
      X = ptM ts (TV (s-pi A B)) gX
      fx = the ((γ : CtxV (sk ts)) → FbE (sk ts) (TV (s-pi A B)) γ → CtxV (sk (cons t1 ts))) (λ γ e → (γ , lam-dom (sk ts) A B γ e))
  in (λ x ρ v → fst cb x (ρ , v) ,
      dlam (ctx-of ts) A B X (tcode t1) b
        (der-tr j-ty (ctx-of ts) A (tcode t1) (ptM ts (Sem A) (λ x ρ → sem t1))
           (fmapM (ctx-of ts) (TV (s-pi A B)) (Sem A) (λ q → fam-dom A B (fst q)) X)
           (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (TV (s-pi A B))) (FbE (sk ts) (Sem A)) (into ts)
                    (λ γ e ρ → fam-dom A B (fst (e ρ))) gX (cube0 ts) (~ i))
           (dty-s ts t1))
        (transport (λ i → Der (j-tm , (lcons (e-ty A) (sk ts) ,
                                       PT-map n One1 (CtxV (sk ts)) (CtxV (sk (cons t1 ts))) (FbE (sk ts) (TV (s-pi A B))) (into ts) fx gX (cube0 ts) (~ i)) ,
                               B , b ,
                               PT-lift n One1 (CtxV (sk ts)) (CtxV (sk (cons t1 ts))) (FbE (sk ts) (TV (s-pi A B))) (FbE (sk (cons t1 ts)) (TV B))
                                 (into ts) fx (λ γ e ρ → (snd (fst (e (fst ρ))) (snd ρ) , snd (e (fst ρ)) (snd ρ))) gX (cube0 ts) (~ i)))
           (snd cb)))
-- the mode: checking at a type, or synthesizing one
data Mode = mchk (t : STy) | msyn
RT : (ts : List STy) (c : Code) (m : Mode) → Type 1
RT ts c (mchk t) = May (CK ts c t)
RT ts c msyn = May (SY ts c)
-- a synthesized result given in either mode
finish : (ts : List STy) (c : Code) (m : Mode) → May (SY ts c) → RT ts c m
finish ts c (mchk t) s = to-chk ts c t s
finish ts c msyn s = s
-- a variable synthesizes its type
syn-var : (ts : List STy) (k : Word) → May (SY ts (cvar k))
syn-var ts k =
  case lookw ts k return (λ o → May (SY ts (cvar k))) of
    none → may-no
    some p → may-yes (vty ts (fst p) ,
                      venv ts (fst p) ,
                      transport (λ i → Der (j-tm , ctx-of ts , shp (vty ts (fst p)) , cvar (snd p i) ,
                                            ptM ts (TV (shp (vty ts (fst p)))) (λ x ρ → (sem (vty ts (fst p)) , venv ts (fst p) x ρ))))
                        (vder ts (fst p)))
-- an application synthesizes the function's codomain, its argument checked at the domain
app-at : (ts : List STy) (f a : Code) (t : STy) → CK ts f t → ((t1 : STy) → May (CK ts a t1)) → May (SY ts (capp f a))
app-at ts f a sbool cf ca = may-no
app-at ts f a (sprod t1 t2) cf ca = may-no
app-at ts f a snat cf ca = may-no
app-at ts f a sunit cf ca = may-no
app-at ts f a sempty cf ca = may-no
app-at ts f a (sarr t1 t2) cf ca =
  case ca t1 return (λ o → May (SY ts (capp f a))) of
    may-no → may-no
    may-yes q → may-yes (t2 , app-ok ts f a t1 t2 cf q)
syn-app : (ts : List STy) (f a : Code) → May (SY ts f) → ((t1 : STy) → May (CK ts a t1)) → May (SY ts (capp f a))
syn-app ts f a sf ca =
  case sf return (λ o → May (SY ts (capp f a))) of
    may-no → may-no
    may-yes r → app-at ts f a (fst r) (snd r) ca
-- a λ checks at a function type
lam-at : (ts : List STy) (b : Code) (t : STy) → ((t1 t2 : STy) → May (CK (cons t1 ts) b t2)) → May (CK ts (clam b) t)
lam-at ts b sbool cb = may-no
lam-at ts b (sprod t1 t2) cb = may-no
lam-at ts b snat cb = may-no
lam-at ts b sunit cb = may-no
lam-at ts b sempty cb = may-no
lam-at ts b (sarr t1 t2) cb =
  case cb t1 t2 return (λ o → May (CK ts (clam b) (sarr t1 t2))) of
    may-no → may-no
    may-yes r → may-yes (lam-ok ts b t1 t2 r)
-- a λ in either mode: it checks at a function type and does not synthesize
lam-m : (ts : List STy) (b : Code) (m : Mode) → ((t1 t2 : STy) → May (CK (cons t1 ts) b t2)) → RT ts (clam b) m
lam-m ts b (mchk t) cb = lam-at ts b t cb
lam-m ts b msyn cb = may-no
-- ---------------------------------------------------------------- Bool's constructors
zeroP : (w : Word) → Opt (PathP (λ i → Word) w #0)
zeroP w = %welimP (λ v → Opt (PathP (λ i → Word) v #0)) w (some (λ i → #0)) (λ m h → none)
oneP : (w : Word) → Opt (PathP (λ i → Word) w #1)
oneP w =
  %welimP (λ v → Opt (PathP (λ i → Word) v #1)) w none
    (λ m h → case zeroP m return (λ o → Opt (PathP (λ i → Word) (%wsucc m) #1)) of
               none → none
               some p → some (λ i → %wsucc (p i)))
nilP : (l : Lst Code) → Opt (PathP (λ i → Lst Code) l lnil)
nilP lnil = some (λ i → lnil)
nilP (lcons x r) = none
-- true and false at their constant meanings
bool-ok : (ts : List STy) (b : Bool) (k : Word) →
  Der (j-tm , ctx-of ts , s-bool , ccon #0 k lnil lnil , fmapM (ctx-of ts) One1 (TV s-bool) (bool-v b) (ptM ts One1 (λ x ρ → one))) →
  CK ts (ccon #0 k lnil lnil) sbool
bool-ok ts b k D =
  (λ x ρ → b ,
   der-tr j-tm (ctx-of ts) s-bool (ccon #0 k lnil lnil) (fmapM (ctx-of ts) One1 (TV s-bool) (bool-v b) (ptM ts One1 (λ x ρ → one)))
     (ptM ts (TV s-bool) (λ x ρ → (one , b)))
     (fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) One1) (FbE (sk ts) (TV s-bool)) (into ts) (λ γ e ρ → bool-v b (e ρ)) (λ x ρ → one) (cube0 ts))
     D)
-- a constructor code checked at Bool: Bool's (data 0) first or second constructor, with no fields
con-at : (ts : List STy) (d k : Word) (fs ds : Lst Code) → May (CK ts (ccon d k fs ds) sbool)
con-at ts d k fs ds =
  case zeroP d return (λ o → May (CK ts (ccon d k fs ds) sbool)) of
    none → may-no
    some pd → (case nilP fs return (λ o → May (CK ts (ccon d k fs ds) sbool)) of
      none → may-no
      some pf → (case nilP ds return (λ o → May (CK ts (ccon d k fs ds) sbool)) of
        none → may-no
        some pds → (case zeroP k return (λ o → May (CK ts (ccon d k fs ds) sbool)) of
          some pk → may-yes (transport (λ i → CK ts (ccon (pd (~ i)) (pk (~ i)) (pf (~ i)) (pds (~ i))) sbool)
                               (bool-ok ts true #0 (dtrue (ctx-of ts) (ptM ts One1 (λ x ρ → one)))))
          none → (case oneP k return (λ o → May (CK ts (ccon d k fs ds) sbool)) of
            none → may-no
            some pk → may-yes (transport (λ i → CK ts (ccon (pd (~ i)) (pk (~ i)) (pf (~ i)) (pds (~ i))) sbool)
                                 (bool-ok ts false #1 (dfalse (ctx-of ts) (ptM ts One1 (λ x ρ → one)))))))))
con-syn : (ts : List STy) (d k : Word) (fs ds : Lst Code) → May (SY ts (ccon d k fs ds))
con-syn ts d k fs ds =
  case con-at ts d k fs ds return (λ o → May (SY ts (ccon d k fs ds))) of
    may-no → may-no
    may-yes r → may-yes (sbool , r)
-- ---------------------------------------------------------------- pairs
-- a pair checked at t1 × t2: its components at t1 and t2, the second component's type the constant
-- t2 over the context extended by t1 (dty-s there, carried to ext-h as λ's body is)
pair-ok : (ts : List STy) (c1 c2 : Code) (t1 t2 : STy) → CK ts c1 t1 → CK ts c2 t2 → CK ts (cpair c1 c2) (sprod t1 t2)
pair-ok ts c1 c2 t1 t2 cp1 cp2 =
  let n = dims (sk ts)
      A = shp t1
      B = shp t2
      gR = the ((x : One1) → EnvV (sk ts) (into ts x) → TV (s-sig A B)) (λ x ρ → (sem (sprod t1 t2) , fst cp1 x ρ , fst cp2 x ρ))
      R = ptM ts (TV (s-sig A B)) gR
      fx = the ((γ : CtxV (sk ts)) → FbE (sk ts) (TV (s-sig A B)) γ → CtxV (sk (cons t1 ts))) (λ γ e → (γ , λ ρ → fam-dom A B (fst (e ρ))))
  in (λ x ρ → (fst cp1 x ρ , fst cp2 x ρ) ,
      dpair (ctx-of ts) A B R (tcode t2) c1 c2
        (transport (λ i → Der (j-ty , (lcons (e-ty A) (sk ts) ,
                                       PT-map n One1 (CtxV (sk ts)) (CtxV (sk (cons t1 ts))) (FbE (sk ts) (TV (s-sig A B))) (into ts) fx gR (cube0 ts) (~ i)) ,
                               B , tcode t2 ,
                               PT-lift n One1 (CtxV (sk ts)) (CtxV (sk (cons t1 ts))) (FbE (sk ts) (TV (s-sig A B))) (FbE (sk (cons t1 ts)) (Sem B))
                                 (into ts) fx (λ γ e ρ → snd (fst (e (fst ρ))) (snd ρ)) gR (cube0 ts) (~ i)))
           (dty-s (cons t1 ts) t2))
        (der-tr j-tm (ctx-of ts) A c1 (ptM ts (TV A) (λ x ρ → (sem t1 , fst cp1 x ρ)))
           (fmapM (ctx-of ts) (TV (s-sig A B)) (TV A) (sig-1 A B) R)
           (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (TV (s-sig A B))) (FbE (sk ts) (TV A)) (into ts) (λ γ e ρ → sig-1 A B (e ρ)) gR (cube0 ts) (~ i))
           (snd cp1))
        (der-tr j-tm (ctx-of ts) B c2 (ptM ts (TV B) (λ x ρ → (sem t2 , fst cp2 x ρ)))
           (fmapM (ctx-of ts) (TV (s-sig A B)) (TV B) (sig-2 A B) R)
           (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (TV (s-sig A B))) (FbE (sk ts) (TV B)) (into ts) (λ γ e ρ → sig-2 A B (e ρ)) gR (cube0 ts) (~ i))
           (snd cp2)))
-- the projections of a term checked at t1 × t2
fst-ok : (ts : List STy) (p : Code) (t1 t2 : STy) → CK ts p (sprod t1 t2) → CK ts (cfst p) t1
fst-ok ts p t1 t2 cp =
  let A = shp t1
      B = shp t2
      gR = the ((x : One1) → EnvV (sk ts) (into ts x) → TV (s-sig A B)) (λ x ρ → (sem (sprod t1 t2) , fst cp x ρ))
  in (λ x ρ → fst (fst cp x ρ) ,
      der-tr j-tm (ctx-of ts) A (cfst p) (fmapM (ctx-of ts) (TV (s-sig A B)) (TV A) (sig-1 A B) (ptM ts (TV (s-sig A B)) gR))
        (ptM ts (TV A) (λ x ρ → (sem t1 , fst (fst cp x ρ))))
        (fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (TV (s-sig A B))) (FbE (sk ts) (TV A)) (into ts) (λ γ e ρ → sig-1 A B (e ρ)) gR (cube0 ts))
        (dfst (ctx-of ts) A B (ptM ts (TV (s-sig A B)) gR) p (snd cp)))
snd-ok : (ts : List STy) (p : Code) (t1 t2 : STy) → CK ts p (sprod t1 t2) → CK ts (csnd p) t2
snd-ok ts p t1 t2 cp =
  let A = shp t1
      B = shp t2
      gR = the ((x : One1) → EnvV (sk ts) (into ts x) → TV (s-sig A B)) (λ x ρ → (sem (sprod t1 t2) , fst cp x ρ))
  in (λ x ρ → snd (fst cp x ρ) ,
      der-tr j-tm (ctx-of ts) B (csnd p) (fmapM (ctx-of ts) (TV (s-sig A B)) (TV B) (sig-2 A B) (ptM ts (TV (s-sig A B)) gR))
        (ptM ts (TV B) (λ x ρ → (sem t2 , snd (fst cp x ρ))))
        (fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (TV (s-sig A B))) (FbE (sk ts) (TV B)) (into ts) (λ γ e ρ → sig-2 A B (e ρ)) gR (cube0 ts))
        (dsnd (ctx-of ts) A B (ptM ts (TV (s-sig A B)) gR) p (snd cp)))
-- a projection synthesizes its component's type from the pair's synthesized product type
fst-at : (ts : List STy) (p : Code) (t : STy) → CK ts p t → May (SY ts (cfst p))
fst-at ts p (sprod t1 t2) cp = may-yes (t1 , fst-ok ts p t1 t2 cp)
fst-at ts p t cp = may-no
snd-at : (ts : List STy) (p : Code) (t : STy) → CK ts p t → May (SY ts (csnd p))
snd-at ts p (sprod t1 t2) cp = may-yes (t2 , snd-ok ts p t1 t2 cp)
snd-at ts p t cp = may-no
syn-fst : (ts : List STy) (p : Code) → May (SY ts p) → May (SY ts (cfst p))
syn-fst ts p sp =
  case sp return (λ o → May (SY ts (cfst p))) of
    may-no → may-no
    may-yes r → fst-at ts p (fst r) (snd r)
syn-snd : (ts : List STy) (p : Code) → May (SY ts p) → May (SY ts (csnd p))
syn-snd ts p sp =
  case sp return (λ o → May (SY ts (csnd p))) of
    may-no → may-no
    may-yes r → snd-at ts p (fst r) (snd r)
-- a pair checked at a product, or synthesizing the product of its components' types
pair-at : (ts : List STy) (c1 c2 : Code) (t : STy) → ((t1 : STy) → May (CK ts c1 t1)) → ((t2 : STy) → May (CK ts c2 t2)) →
  May (CK ts (cpair c1 c2) t)
pair-at ts c1 c2 (sprod t1 t2) m1 m2 =
  case m1 t1 return (λ o → May (CK ts (cpair c1 c2) (sprod t1 t2))) of
    may-no → may-no
    may-yes cp1 → (case m2 t2 return (λ o → May (CK ts (cpair c1 c2) (sprod t1 t2))) of
                     may-no → may-no
                     may-yes cp2 → may-yes (pair-ok ts c1 c2 t1 t2 cp1 cp2))
pair-at ts c1 c2 t m1 m2 = may-no
pair-m : (ts : List STy) (c1 c2 : Code) (m : Mode) → ((t1 : STy) → May (CK ts c1 t1)) → ((t2 : STy) → May (CK ts c2 t2)) →
  May (SY ts c1) → May (SY ts c2) → RT ts (cpair c1 c2) m
pair-m ts c1 c2 (mchk t) m1 m2 s1 s2 = pair-at ts c1 c2 t m1 m2
pair-m ts c1 c2 msyn m1 m2 s1 s2 =
  case s1 return (λ o → May (SY ts (cpair c1 c2))) of
    may-no → may-no
    may-yes r1 → (case s2 return (λ o → May (SY ts (cpair c1 c2))) of
                    may-no → may-no
                    may-yes r2 → may-yes (sprod (fst r1) (fst r2) , pair-ok ts c1 c2 (fst r1) (fst r2) (snd r1) (snd r2)))
-- ---------------------------------------------------------------- Nat
twoP : (w : Word) → Opt (PathP (λ i → Word) w #2)
twoP w =
  %welimP (λ v → Opt (PathP (λ i → Word) v #2)) w none
    (λ m h → case oneP m return (λ o → Opt (PathP (λ i → Word) (%wsucc m) #2)) of
               none → none
               some p → some (λ i → %wsucc (p i)))
-- zero and the successor of a term checked at Nat, at their constant meanings
zero-ok : (ts : List STy) → CK ts c-zero snat
zero-ok ts =
  (λ x ρ → zero ,
   der-tr j-tm (ctx-of ts) s-nat c-zero (fmapM (ctx-of ts) One1 (TV s-nat) (nat-v zero) (ptM ts One1 (λ x ρ → one)))
     (ptM ts (TV s-nat) (λ x ρ → (one , zero)))
     (fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) One1) (FbE (sk ts) (TV s-nat)) (into ts) (λ γ e ρ → nat-v zero (e ρ)) (λ x ρ → one) (cube0 ts))
     (dzero (ctx-of ts) (ptM ts One1 (λ x ρ → one))))
suc-ok : (ts : List STy) (c : Code) → CK ts c snat → CK ts (c-suc c) snat
suc-ok ts c cc =
  let g = the ((x : One1) → EnvV (sk ts) (into ts x) → TV s-nat) (λ x ρ → (one , fst cc x ρ))
  in (λ x ρ → suc (fst cc x ρ) ,
      der-tr j-tm (ctx-of ts) s-nat (c-suc c) (fmapM (ctx-of ts) (TV s-nat) (TV s-nat) nat-sucv (ptM ts (TV s-nat) g))
        (ptM ts (TV s-nat) (λ x ρ → (one , suc (fst cc x ρ))))
        (fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) (TV s-nat)) (FbE (sk ts) (TV s-nat)) (into ts) (λ γ e ρ → nat-sucv (e ρ)) g (cube0 ts))
        (dsuc (ctx-of ts) (ptM ts (TV s-nat) g) c (snd cc)))
-- the recursor checked at t: the base at t, the step at Nat → t → t, the scrutinee at Nat, the motive
-- the constant type t over the context extended by Nat (dty-s there, carried to ext-h as for case)
nrec-ok : (ts : List STy) (z st x : Code) (t : STy) → CK ts z t → CK ts st (sarr snat (sarr t t)) → CK ts x snat →
  CK ts (c-nrec (tcode t) z st x) t
nrec-ok ts z st x t cz cst cx =
  let n = dims (sk ts)
      s = shp t
      gR = the ((y : One1) → EnvV (sk ts) (into ts y) → NRecV s) (λ y ρ → (one , (λ k → sem t) , fst cx y ρ , fst cz y ρ , fst cst y ρ))
      R = ptM ts (NRecV s) gR
      fx = the ((γ : CtxV (sk ts)) → FbE (sk ts) (NRecV s) γ → CtxV (sk (cons snat ts))) (λ γ e → (γ , λ ρ → nrec-b s (e ρ)))
      res = the ((y : One1) → EnvV (sk ts) (into ts y) → El s (sem t)) (λ y ρ → nat-elim (λ k → El s (sem t)) (fst cz y ρ) (fst cst y ρ) (fst cx y ρ))
  in (res ,
      der-tr j-tm (ctx-of ts) s (c-nrec (tcode t) z st x) (fmapM (ctx-of ts) (NRecV s) (TV s) (nrec-r s) R)
        (ptM ts (TV s) (λ y ρ → (sem t , res y ρ)))
        (fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (NRecV s)) (FbE (sk ts) (TV s)) (into ts) (λ γ e ρ → nrec-r s (e ρ)) gR (cube0 ts))
        (dnrec (ctx-of ts) s R (tcode t) z st x
           (transport (λ i → Der (j-ty , (lcons (e-ty s-nat) (sk ts) ,
                                          PT-map n One1 (CtxV (sk ts)) (CtxV (sk (cons snat ts))) (FbE (sk ts) (NRecV s)) (into ts) fx gR (cube0 ts) (~ i)) ,
                                  s , tcode t ,
                                  PT-lift n One1 (CtxV (sk ts)) (CtxV (sk (cons snat ts))) (FbE (sk ts) (NRecV s)) (FbE (sk (cons snat ts)) (Sem s))
                                    (into ts) fx (λ γ e ρ → fst (snd (e (fst ρ))) (snd ρ)) gR (cube0 ts) (~ i)))
              (dty-s (cons snat ts) t))
           (der-tr j-tm (ctx-of ts) s z (ptM ts (TV s) (λ y ρ → (sem t , fst cz y ρ)))
              (fmapM (ctx-of ts) (NRecV s) (TV s) (nrec-z s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (NRecV s)) (FbE (sk ts) (TV s)) (into ts) (λ γ e ρ → nrec-z s (e ρ)) gR (cube0 ts) (~ i))
              (snd cz))
           (der-tr j-tm (ctx-of ts) (s-pi s-nat (s-pi s s)) st (ptM ts (TV (s-pi s-nat (s-pi s s))) (λ y ρ → (sem (sarr snat (sarr t t)) , fst cst y ρ)))
              (fmapM (ctx-of ts) (NRecV s) (TV (s-pi s-nat (s-pi s s))) (nrec-st s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (NRecV s)) (FbE (sk ts) (TV (s-pi s-nat (s-pi s s)))) (into ts) (λ γ e ρ → nrec-st s (e ρ)) gR (cube0 ts) (~ i))
              (snd cst))
           (der-tr j-tm (ctx-of ts) s-nat x (ptM ts (TV s-nat) (λ y ρ → (one , fst cx y ρ)))
              (fmapM (ctx-of ts) (NRecV s) (TV s-nat) (nrec-x s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (NRecV s)) (FbE (sk ts) (TV s-nat)) (into ts) (λ γ e ρ → nrec-x s (e ρ)) gR (cube0 ts) (~ i))
              (snd cx))))
-- ---------------------------------------------------------------- Unit and Empty
-- equality of words, with its path
wordP : (a b : Word) → Opt (PathP (λ i → Word) a b)
wordP a =
  %welimP (λ v → (b : Word) → Opt (PathP (λ i → Word) v b)) a
    (λ b → case zeroP b return (λ o → Opt (PathP (λ i → Word) #0 b)) of
             none → none
             some p → some (λ i → p (~ i)))
    (λ m h b → %welimP (λ v → Opt (PathP (λ i → Word) (%wsucc m) v)) b none
                 (λ n h2 → case h n return (λ o → Opt (PathP (λ i → Word) (%wsucc m) (%wsucc n))) of
                             none → none
                             some p → some (λ i → %wsucc (p i))))
tt-ok : (ts : List STy) → CK ts c-tt sunit
tt-ok ts =
  (λ x ρ → unit ,
   der-tr j-tm (ctx-of ts) s-unit c-tt (fmapM (ctx-of ts) One1 (TV s-unit) unit-v (ptM ts One1 (λ x ρ → one)))
     (ptM ts (TV s-unit) (λ x ρ → (one , unit)))
     (fmap-pt (dims (sk ts)) One1 (CtxV (sk ts)) (FbE (sk ts) One1) (FbE (sk ts) (TV s-unit)) (into ts) (λ γ e ρ → unit-v (e ρ)) (λ x ρ → one) (cube0 ts))
     (dtt (ctx-of ts) (ptM ts One1 (λ x ρ → one))))
-- absurd at t of a term checked at Empty, the motive the constant t over the context extended by Empty
absurd-ok : (ts : List STy) (x : Code) (t : STy) → CK ts x sempty → CK ts (c-absurd (tcode t) x) t
absurd-ok ts x t cx =
  let n = dims (sk ts)
      s = shp t
      gR = the ((y : One1) → EnvV (sk ts) (into ts y) → AbsV s) (λ y ρ → (one , (λ e → sem t) , fst cx y ρ))
      R = ptM ts (AbsV s) gR
      fx = the ((γ : CtxV (sk ts)) → FbE (sk ts) (AbsV s) γ → CtxV (sk (cons sempty ts))) (λ γ e → (γ , λ ρ → abs-b s (e ρ)))
      res = the ((y : One1) → EnvV (sk ts) (into ts y) → El s (sem t)) (λ y ρ → empty-elim (λ e → El s (sem t)) (fst cx y ρ))
  in (res ,
      der-tr j-tm (ctx-of ts) s (c-absurd (tcode t) x) (fmapM (ctx-of ts) (AbsV s) (TV s) (abs-r s) R)
        (ptM ts (TV s) (λ y ρ → (sem t , res y ρ)))
        (fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AbsV s)) (FbE (sk ts) (TV s)) (into ts) (λ γ e ρ → abs-r s (e ρ)) gR (cube0 ts))
        (dabsurd (ctx-of ts) s R (tcode t) x
           (transport (λ i → Der (j-ty , (lcons (e-ty s-empty) (sk ts) ,
                                          PT-map n One1 (CtxV (sk ts)) (CtxV (sk (cons sempty ts))) (FbE (sk ts) (AbsV s)) (into ts) fx gR (cube0 ts) (~ i)) ,
                                  s , tcode t ,
                                  PT-lift n One1 (CtxV (sk ts)) (CtxV (sk (cons sempty ts))) (FbE (sk ts) (AbsV s)) (FbE (sk (cons sempty ts)) (Sem s))
                                    (into ts) fx (λ γ e ρ → fst (snd (e (fst ρ))) (snd ρ)) gR (cube0 ts) (~ i)))
              (dty-s (cons sempty ts) t))
           (der-tr j-tm (ctx-of ts) s-empty x (ptM ts (TV s-empty) (λ y ρ → (one , fst cx y ρ)))
              (fmapM (ctx-of ts) (AbsV s) (TV s-empty) (abs-x s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (AbsV s)) (FbE (sk ts) (TV s-empty)) (into ts) (λ γ e ρ → abs-x s (e ρ)) gR (cube0 ts) (~ i))
              (snd cx))))
-- tt: Unit's (unit-d) constructor 0 with no fields
tt-at : (ts : List STy) (d k : Word) (fs ds : Lst Code) → May (CK ts (ccon d k fs ds) sunit)
tt-at ts d k fs ds =
  case wordP d unit-d return (λ o → May (CK ts (ccon d k fs ds) sunit)) of
    none → may-no
    some pd → (case zeroP k return (λ o → May (CK ts (ccon d k fs ds) sunit)) of
      none → may-no
      some pk → (case nilP fs return (λ o → May (CK ts (ccon d k fs ds) sunit)) of
        none → may-no
        some pf → (case nilP ds return (λ o → May (CK ts (ccon d k fs ds) sunit)) of
          none → may-no
          some pds → may-yes (transport (λ i → CK ts (ccon (pd (~ i)) (pk (~ i)) (pf (~ i)) (pds (~ i))) sunit) (tt-ok ts)))))
-- absurd's code: Empty's (empty-d) elimination with the motive a λ and no branches
-- ---------------------------------------------------------------- reading codes; Unit and Empty checked
-- a type code read back as a simple type, with the path from its code
sty-of : (c : Code) → Opt ((t : STy) × PathP (λ i → Code) (tcode t) c)
sty-of (cdata d ps) =
  case nilP ps return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cdata d ps))) of
    none → none
    some pp → (case zeroP d return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cdata d ps))) of
      some pd → some (sbool , λ i → cdata (pd (~ i)) (pp (~ i)))
      none → (case oneP d return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cdata d ps))) of
        some pd → some (snat , λ i → cdata (pd (~ i)) (pp (~ i)))
        none → (case wordP d unit-d return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cdata d ps))) of
          some pd → some (sunit , λ i → cdata (pd (~ i)) (pp (~ i)))
          none → (case wordP d empty-d return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cdata d ps))) of
            some pd → some (sempty , λ i → cdata (pd (~ i)) (pp (~ i)))
            none → none))))
sty-of (cpi w a b) =
  case twoP w return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cpi w a b))) of
    none → none
    some pw → (case sty-of a return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cpi w a b))) of
      none → none
      some ra → (case sty-of b return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (cpi w a b))) of
        none → none
        some rb → some (sarr (fst ra) (fst rb) , λ i → cpi (pw (~ i)) (snd ra i) (snd rb i))))
sty-of (csigma a b) =
  case sty-of a return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (csigma a b))) of
    none → none
    some ra → (case sty-of b return (λ o → Opt ((t : STy) × PathP (λ i → Code) (tcode t) (csigma a b))) of
      none → none
      some rb → some (sprod (fst ra) (fst rb) , λ i → csigma (snd ra i) (snd rb i)))
sty-of c = none
-- the recursor's code, Nat's (data 1) elimination with the motive a λ and two branches
nrec-chk : (ts : List STy) (d : Word) (cP z st x : Code) (t : STy) → ((t1 : STy) → May (CK ts z t1)) →
  ((t1 : STy) → May (CK ts st (sarr snat (sarr t1 t1)))) → May (CK ts x snat) →
  May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)
nrec-chk ts d cP z st x t mz mst mx =
  case oneP d return (λ o → May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)) of
    none → may-no
    some pd → (case sty-of cP return (λ o → May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)) of
      none → may-no
      some rp → (case steq (fst rp) t return (λ o → May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)) of
        none → may-no
        some pt → (case mz t return (λ o → May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)) of
          may-no → may-no
          may-yes cz → (case mst t return (λ o → May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)) of
            may-no → may-no
            may-yes cst → (case mx return (λ o → May (CK ts (celim d (clam cP) (lcons z (lcons st lnil)) x) t)) of
              may-no → may-no
              may-yes cx → may-yes (transport (λ i → CK ts (celim (pd (~ i)) (clam (snd rp i)) (lcons z (lcons st lnil)) x) t)
                                      (transport (λ i → CK ts (c-nrec (tcode (pt (~ i))) z st x) t) (nrec-ok ts z st x t cz cst cx))))))))
-- checked at t, or synthesizing the motive's type
nrec-m : (ts : List STy) (d : Word) (cP z st x : Code) (m : Mode) → ((t1 : STy) → May (CK ts z t1)) →
  ((t1 : STy) → May (CK ts st (sarr snat (sarr t1 t1)))) → May (CK ts x snat) → RT ts (celim d (clam cP) (lcons z (lcons st lnil)) x) m
nrec-m ts d cP z st x (mchk t) mz mst mx = nrec-chk ts d cP z st x t mz mst mx
nrec-m ts d cP z st x msyn mz mst mx =
  case sty-of cP return (λ o → May (SY ts (celim d (clam cP) (lcons z (lcons st lnil)) x))) of
    none → may-no
    some rp → (case nrec-chk ts d cP z st x (fst rp) mz mst mx return (λ o → May (SY ts (celim d (clam cP) (lcons z (lcons st lnil)) x))) of
      may-no → may-no
      may-yes q → may-yes (fst rp , q))
-- Nat's constructors: zero (data 1, constructor 0, no fields), the successor (constructor 1, one field)
zero-at : (ts : List STy) (d k : Word) (fs ds : Lst Code) → May (CK ts (ccon d k fs ds) snat)
zero-at ts d k fs ds =
  case oneP d return (λ o → May (CK ts (ccon d k fs ds) snat)) of
    none → may-no
    some pd → (case zeroP k return (λ o → May (CK ts (ccon d k fs ds) snat)) of
      none → may-no
      some pk → (case nilP fs return (λ o → May (CK ts (ccon d k fs ds) snat)) of
        none → may-no
        some pf → (case nilP ds return (λ o → May (CK ts (ccon d k fs ds) snat)) of
          none → may-no
          some pds → may-yes (transport (λ i → CK ts (ccon (pd (~ i)) (pk (~ i)) (pf (~ i)) (pds (~ i))) snat) (zero-ok ts)))))
suc-at : (ts : List STy) (d k : Word) (c : Code) (ds : Lst Code) → May (CK ts c snat) → May (CK ts (ccon d k (lcons c lnil) ds) snat)
suc-at ts d k c ds mc =
  case oneP d return (λ o → May (CK ts (ccon d k (lcons c lnil) ds) snat)) of
    none → may-no
    some pd → (case oneP k return (λ o → May (CK ts (ccon d k (lcons c lnil) ds) snat)) of
      none → may-no
      some pk → (case nilP ds return (λ o → May (CK ts (ccon d k (lcons c lnil) ds) snat)) of
        none → may-no
        some pds → (case mc return (λ o → May (CK ts (ccon d k (lcons c lnil) ds) snat)) of
          may-no → may-no
          may-yes cc → may-yes (transport (λ i → CK ts (ccon (pd (~ i)) (pk (~ i)) (lcons c lnil) (pds (~ i))) snat) (suc-ok ts c cc)))))
-- a constructor code: Bool's, else Nat's zero
con-syn2 : (ts : List STy) (d k : Word) (fs ds : Lst Code) → May (SY ts (ccon d k fs ds))
con-syn2 ts d k fs ds =
  case con-syn ts d k fs ds return (λ o → May (SY ts (ccon d k fs ds))) of
    may-yes r → may-yes r
    may-no → (case zero-at ts d k fs ds return (λ o → May (SY ts (ccon d k fs ds))) of
      may-yes q → may-yes (snat , q)
      may-no → (case tt-at ts d k fs ds return (λ o → May (SY ts (ccon d k fs ds))) of
        may-no → may-no
        may-yes q → may-yes (sunit , q)))
suc-syn : (ts : List STy) (d k : Word) (c : Code) (ds : Lst Code) → May (CK ts c snat) → May (SY ts (ccon d k (lcons c lnil) ds))
suc-syn ts d k c ds mc =
  case suc-at ts d k c ds mc return (λ o → May (SY ts (ccon d k (lcons c lnil) ds))) of
    may-no → may-no
    may-yes q → may-yes (snat , q)
absurd-chk : (ts : List STy) (d : Word) (cP x : Code) (t : STy) → May (CK ts x sempty) → May (CK ts (celim d (clam cP) lnil x) t)
absurd-chk ts d cP x t mx =
  case wordP d empty-d return (λ o → May (CK ts (celim d (clam cP) lnil x) t)) of
    none → may-no
    some pd → (case sty-of cP return (λ o → May (CK ts (celim d (clam cP) lnil x) t)) of
      none → may-no
      some rp → (case steq (fst rp) t return (λ o → May (CK ts (celim d (clam cP) lnil x) t)) of
        none → may-no
        some pt → (case mx return (λ o → May (CK ts (celim d (clam cP) lnil x) t)) of
          may-no → may-no
          may-yes cx → may-yes (transport (λ i → CK ts (celim (pd (~ i)) (clam (snd rp i)) lnil x) t)
                                  (transport (λ i → CK ts (c-absurd (tcode (pt (~ i))) x) t) (absurd-ok ts x t cx))))))
absurd-m : (ts : List STy) (d : Word) (cP x : Code) (m : Mode) → May (CK ts x sempty) → RT ts (celim d (clam cP) lnil x) m
absurd-m ts d cP x (mchk t) mx = absurd-chk ts d cP x t mx
absurd-m ts d cP x msyn mx =
  case sty-of cP return (λ o → May (SY ts (celim d (clam cP) lnil x))) of
    none → may-no
    some rp → (case absurd-chk ts d cP x (fst rp) mx return (λ o → May (SY ts (celim d (clam cP) lnil x))) of
      may-no → may-no
      may-yes q → may-yes (fst rp , q))
-- ---------------------------------------------------------------- case on Bool
-- case on Bool checked at t: the scrutinee at Bool, both branches at t, the motive the constant type t
-- in the context extended by a Bool (dty-s there, carried to ext-h over the case's cube as λ's body is)
case-ok : (ts : List STy) (t0 f0 x0 : Code) (t : STy) → CK ts x0 sbool → CK ts t0 t → CK ts f0 t → CK ts (c-case t0 f0 x0) t
case-ok ts t0 f0 x0 t cx ct cf =
  let n = dims (sk ts)
      s = shp t
      gR = the ((x : One1) → EnvV (sk ts) (into ts x) → CaseV s) (λ x ρ → (one , (λ b → sem t) , fst cx x ρ , fst ct x ρ , fst cf x ρ))
      R = ptM ts (CaseV s) gR
      fx = the ((γ : CtxV (sk ts)) → FbE (sk ts) (CaseV s) γ → CtxV (sk (cons sbool ts))) (λ γ e → (γ , λ ρ → case-b s (e ρ)))
  in (λ x ρ → bool-elim (λ b → El s (sem t)) (fst ct x ρ) (fst cf x ρ) (fst cx x ρ) ,
      der-tr j-tm (ctx-of ts) s (c-case t0 f0 x0) (fmapM (ctx-of ts) (CaseV s) (TV s) (case-r s) R)
        (ptM ts (TV s) (λ x ρ → (sem t , bool-elim (λ b → El s (sem t)) (fst ct x ρ) (fst cf x ρ) (fst cx x ρ))))
        (fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (CaseV s)) (FbE (sk ts) (TV s)) (into ts) (λ γ e ρ → case-r s (e ρ)) gR (cube0 ts))
        (dcase (ctx-of ts) s R (tcode t) x0 t0 f0
           (transport (λ i → Der (j-ty , (lcons (e-ty s-bool) (sk ts) ,
                                          PT-map n One1 (CtxV (sk ts)) (CtxV (sk (cons sbool ts))) (FbE (sk ts) (CaseV s)) (into ts) fx gR (cube0 ts) (~ i)) ,
                                  s , tcode t ,
                                  PT-lift n One1 (CtxV (sk ts)) (CtxV (sk (cons sbool ts))) (FbE (sk ts) (CaseV s)) (FbE (sk (cons sbool ts)) (Sem s))
                                    (into ts) fx (λ γ e ρ → fst (snd (e (fst ρ))) (snd ρ)) gR (cube0 ts) (~ i)))
              (dty-s (cons sbool ts) t))
           (der-tr j-tm (ctx-of ts) s-bool x0 (ptM ts (TV s-bool) (λ x ρ → (one , fst cx x ρ)))
              (fmapM (ctx-of ts) (CaseV s) (TV s-bool) (case-x s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (CaseV s)) (FbE (sk ts) (TV s-bool)) (into ts) (λ γ e ρ → case-x s (e ρ)) gR (cube0 ts) (~ i))
              (snd cx))
           (der-tr j-tm (ctx-of ts) s t0 (ptM ts (TV s) (λ x ρ → (sem t , fst ct x ρ)))
              (fmapM (ctx-of ts) (CaseV s) (TV s) (case-t s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (CaseV s)) (FbE (sk ts) (TV s)) (into ts) (λ γ e ρ → case-t s (e ρ)) gR (cube0 ts) (~ i))
              (snd ct))
           (der-tr j-tm (ctx-of ts) s f0 (ptM ts (TV s) (λ x ρ → (sem t , fst cf x ρ)))
              (fmapM (ctx-of ts) (CaseV s) (TV s) (case-f s) R)
              (λ i → fmap-pt n One1 (CtxV (sk ts)) (FbE (sk ts) (CaseV s)) (FbE (sk ts) (TV s)) (into ts) (λ γ e ρ → case-f s (e ρ)) gR (cube0 ts) (~ i))
              (snd cf))))
-- a case code checked at t: Bool's (data 0) case with its two branches
bcase-at : (ts : List STy) (d : Word) (t0 f0 x0 : Code) (t : STy) → May (CK ts x0 sbool) → May (CK ts t0 t) → May (CK ts f0 t) →
  May (CK ts (ccase d (lcons t0 (lcons f0 lnil)) x0) t)
bcase-at ts d t0 f0 x0 t mx mt mf =
  case zeroP d return (λ o → May (CK ts (ccase d (lcons t0 (lcons f0 lnil)) x0) t)) of
    none → may-no
    some pd → (case mx return (λ o → May (CK ts (ccase d (lcons t0 (lcons f0 lnil)) x0) t)) of
      may-no → may-no
      may-yes cx → (case mt return (λ o → May (CK ts (ccase d (lcons t0 (lcons f0 lnil)) x0) t)) of
        may-no → may-no
        may-yes ct → (case mf return (λ o → May (CK ts (ccase d (lcons t0 (lcons f0 lnil)) x0) t)) of
          may-no → may-no
          may-yes cf → may-yes (transport (λ i → CK ts (ccase (pd (~ i)) (lcons t0 (lcons f0 lnil)) x0) t) (case-ok ts t0 f0 x0 t cx ct cf)))))
-- checked at t, or synthesizing the true branch's type and checking the rest at it
case-m : (ts : List STy) (d : Word) (t0 f0 x0 : Code) (m : Mode) → May (CK ts x0 sbool) → ((t : STy) → May (CK ts t0 t)) →
  ((t : STy) → May (CK ts f0 t)) → May (SY ts t0) → RT ts (ccase d (lcons t0 (lcons f0 lnil)) x0) m
case-m ts d t0 f0 x0 (mchk t) mx mt mf st = bcase-at ts d t0 f0 x0 t mx (mt t) (mf t)
case-m ts d t0 f0 x0 msyn mx mt mf st =
  case st return (λ o → May (SY ts (ccase d (lcons t0 (lcons f0 lnil)) x0))) of
    may-no → may-no
    may-yes r → (case bcase-at ts d t0 f0 x0 (fst r) mx (may-yes (snd r)) (mf (fst r))
                   return (λ o → May (SY ts (ccase d (lcons t0 (lcons f0 lnil)) x0))) of
                   may-no → may-no
                   may-yes q → may-yes (fst r , q))
-- the checker: a derivation of the code at the type checked, or of the type it synthesizes (the
-- context after the code, so its change under a λ is a later argument of the structural call)
ck : (c : Code) (ts : List STy) (m : Mode) → RT ts c m
ck (cvar k) ts m = finish ts (cvar k) m (syn-var ts k)
ck (clam b) ts m = lam-m ts b m (λ t1 t2 → ck b (cons t1 ts) (mchk t2))
ck (capp f a) ts m = finish ts (capp f a) m (syn-app ts f a (ck f ts msyn) (λ t1 → ck a ts (mchk t1)))
ck (ccon d k (lcons c lnil) ds) ts m = finish ts (ccon d k (lcons c lnil) ds) m (suc-syn ts d k c ds (ck c ts (mchk snat)))
ck (ccon d k fs ds) ts m = finish ts (ccon d k fs ds) m (con-syn2 ts d k fs ds)
ck (celim d (clam cP) lnil x) ts m = absurd-m ts d cP x m (ck x ts (mchk sempty))
ck (celim d (clam cP) (lcons z (lcons st lnil)) x) ts m =
  nrec-m ts d cP z st x m (λ t → ck z ts (mchk t)) (λ t → ck st ts (mchk (sarr snat (sarr t t)))) (ck x ts (mchk snat))
ck (cpair a b) ts m = pair-m ts a b m (λ t → ck a ts (mchk t)) (λ t → ck b ts (mchk t)) (ck a ts msyn) (ck b ts msyn)
ck (cfst p) ts m = finish ts (cfst p) m (syn-fst ts p (ck p ts msyn))
ck (csnd p) ts m = finish ts (csnd p) m (syn-snd ts p (ck p ts msyn))
ck (ccase d (lcons t0 (lcons f0 lnil)) x0) ts m =
  case-m ts d t0 f0 x0 m (ck x0 ts (mchk sbool)) (λ t → ck t0 ts (mchk t)) (λ t → ck f0 ts (mchk t)) (ck t0 ts msyn)
ck c ts m = finish ts c m may-no

-- ---------------------------------------------------------------- examples: raw codes checked, then normalized
-- a closed checked term as a typed code, or none
tcode-of : (c : Code) (t : STy) → May (CK nil c t) → Opt Code
tcode-of c t r =
  case r return (λ o → Opt Code) of
    may-no → none
    may-yes q → some (fst (normalize-nf (ctx-of nil) tc-nil (shp t) (c , ptM nil (TV (shp t)) (λ x ρ → (sem t , fst q x ρ)) , snd q)))
-- λ x. x checks at Bool → Bool, and normalizes to itself
#same tcode-of (clam (cvar #0)) (sarr sbool sbool) (ck (clam (cvar #0)) nil (mchk (sarr sbool sbool))) = some (clam (cvar #0))
-- λ f. f checks at (Bool → Bool) → Bool → Bool and normalizes to its η-long form
#same tcode-of (clam (cvar #0)) (sarr (sarr sbool sbool) (sarr sbool sbool))
  (ck (clam (cvar #0)) nil (mchk (sarr (sarr sbool sbool) (sarr sbool sbool)))) = some (clam (clam (capp (cvar #1) (cvar #0))))
-- true checks at Bool and is its own normal form; true applied to false is refused
#same tcode-of c-true sbool (ck c-true nil (mchk sbool)) = some c-true
#same tcode-of (capp c-true c-false) sbool (ck (capp c-true c-false) nil (mchk sbool)) = none
-- λ f. λ x. f x checks at (Bool → Bool) → Bool → Bool and is its own normal form
#same tcode-of (clam (clam (capp (cvar #1) (cvar #0)))) (sarr (sarr sbool sbool) (sarr sbool sbool))
  (ck (clam (clam (capp (cvar #1) (cvar #0)))) nil (mchk (sarr (sarr sbool sbool) (sarr sbool sbool)))) = some (clam (clam (capp (cvar #1) (cvar #0))))
-- case on Bool, its subterms checked by ck and the rule applied directly (ck cannot yet recurse into a
-- case's branches: they sit in a Lst Code): case true of false, true normalizes to false, and
-- λ b. case b of false, true (negation) at Bool → Bool is its own normal form
#same tcode-of (c-case c-false c-true c-true) sbool
  (bcase-at nil #0 c-false c-true c-true sbool (ck c-true nil (mchk sbool)) (ck c-false nil (mchk sbool)) (ck c-true nil (mchk sbool)))
  = some c-false
#same tcode-of (clam (c-case c-false c-true (cvar #0))) (sarr sbool sbool)
  (lam-at nil (c-case c-false c-true (cvar #0)) (sarr sbool sbool)
     (λ t1 t2 → bcase-at (cons t1 nil) #0 c-false c-true (cvar #0) t2
                  (ck (cvar #0) (cons t1 nil) (mchk sbool)) (ck c-false (cons t1 nil) (mchk t2)) (ck c-true (cons t1 nil) (mchk t2))))
  = some (clam (c-case c-false c-true (cvar #0)))
-- pairs: the swap λ p. (snd p , fst p) at Bool × Bool → Bool × Bool is its own normal form; fst of
-- (true , false) synthesizes Bool and normalizes to true; a pair at Bool is refused
#same tcode-of (clam (cpair (csnd (cvar #0)) (cfst (cvar #0)))) (sarr (sprod sbool sbool) (sprod sbool sbool))
  (ck (clam (cpair (csnd (cvar #0)) (cfst (cvar #0)))) nil (mchk (sarr (sprod sbool sbool) (sprod sbool sbool))))
  = some (clam (cpair (csnd (cvar #0)) (cfst (cvar #0))))
#same tcode-of (cfst (cpair c-true c-false)) sbool (ck (cfst (cpair c-true c-false)) nil (mchk sbool)) = some c-true
#same tcode-of (cpair c-true c-false) sbool (ck (cpair c-true c-false) nil (mchk sbool)) = none
-- λ f. λ x. x at (Bool → Bool) → Bool → Bool is its own normal form
#same tcode-of (clam (clam (cvar #0))) (sarr (sarr sbool sbool) (sarr sbool sbool))
  (ck (clam (clam (cvar #0))) nil (mchk (sarr (sarr sbool sbool) (sarr sbool sbool)))) = some (clam (clam (cvar #0)))
-- case on Bool through ck itself (its branches are a case code's nested Lst Code): negation is its own
-- normal form, case true of false, true normalizes to false, and λ b. case b of b, false (and) at
-- Bool → Bool → Bool is its own normal form
#same tcode-of (clam (c-case c-false c-true (cvar #0))) (sarr sbool sbool) (ck (clam (c-case c-false c-true (cvar #0))) nil (mchk (sarr sbool sbool)))
  = some (clam (c-case c-false c-true (cvar #0)))
#same tcode-of (c-case c-false c-true c-true) sbool (ck (c-case c-false c-true c-true) nil (mchk sbool)) = some c-false
#same tcode-of (clam (clam (c-case (cvar #0) c-false (cvar #1)))) (sarr sbool (sarr sbool sbool))
  (ck (clam (clam (c-case (cvar #0) c-false (cvar #1)))) nil (mchk (sarr sbool (sarr sbool sbool))))
  = some (clam (clam (c-case (cvar #0) c-false (cvar #1))))
-- Nat: 2 checks and normalizes to itself; the recursor adding one to its argument (λ k r. suc r) on 2
-- normalizes to 3 (suc (suc (suc zero))); λ n. nrec n 0 (λ k r. suc r) at Nat → Nat checks, its
-- normal form the recursor stuck on the variable
#same tcode-of (c-suc (c-suc c-zero)) snat (ck (c-suc (c-suc c-zero)) nil (mchk snat)) = some (c-suc (c-suc c-zero))
#same tcode-of (c-nrec c-nat (c-suc c-zero) (clam (clam (c-suc (cvar #0)))) (c-suc (c-suc c-zero))) snat
  (ck (c-nrec c-nat (c-suc c-zero) (clam (clam (c-suc (cvar #0)))) (c-suc (c-suc c-zero))) nil (mchk snat))
  = some (c-suc (c-suc (c-suc c-zero)))
-- Unit and Empty: tt checks at Unit and normalizes to itself; λ e. absurd e at Empty → Bool checks and
-- normalizes to itself (absurd stuck on the variable)
#same tcode-of c-tt sunit (ck c-tt nil (mchk sunit)) = some c-tt
#same tcode-of (clam (c-absurd c-bool (cvar #0))) (sarr sempty sbool) (ck (clam (c-absurd c-bool (cvar #0))) nil (mchk (sarr sempty sbool)))
  = some (clam (c-absurd c-bool (cvar #0)))
