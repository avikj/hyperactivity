-- experiments/nbe/examples.cub — lib/nbe.cub's normalizer run on derivations (2026-11-12).
-- Load after CORE and lib/nbe.cub.
-- ---------------------------------------------------------------- P1: Π, Σ, Bool
-- Bool → Bool as a semantic type, and as a type in the empty context
bbT : Env emp → Fam s-bool s-bool
bbT ρ = (one , λ x → one)
bb : PTy (Env emp)
bb = (s-pi s-bool s-bool , bbT)
-- λ x. x : Bool → Bool
id-der : Der (emp , bb , clam (cvar #0) , λ ρ x → x)
id-der = dlam emp s-bool s-bool bbT (cvar #0) (λ ρ → snd ρ)
  (dvar (ext emp (dom (Env emp) s-bool s-bool bbT)) (cod (Env emp) s-bool s-bool bbT) #0 (λ ρ → snd ρ)
        (vz emp (dom (Env emp) s-bool s-bool bbT)))
-- (λ x. x) true : Bool, a β-redex
app-der : Der (emp , (s-bool , λ ρ → one) , capp (clam (cvar #0)) c-true , λ ρ → true)
app-der = dapp emp s-bool s-bool bbT (clam (cvar #0)) (λ ρ x → x) c-true (λ ρ → true) id-der (dtrue emp (λ ρ → one))
#same fst (normalize-nf emp (s-bool , λ ρ → one) (capp (clam (cvar #0)) c-true , (λ ρ → true) , app-der)) = c-true
#same fst (normalize-nf emp bb (clam (cvar #0) , (λ ρ x → x) , id-der)) = clam (cvar #0)
-- a context with f : Bool → Bool; f normalizes to its η-expansion λ x. f x
Γf : Ctx
Γf = ext emp bb
f-der : Der (Γf , wk emp bb bb , cvar #0 , λ ρ → snd ρ)
f-der = dvar Γf (wk emp bb bb) #0 (λ ρ → snd ρ) (vz emp bb)
#same fst (normalize-nf Γf (wk emp bb bb) (cvar #0 , (λ ρ → snd ρ) , f-der)) = clam (capp (cvar #1) (cvar #0))
-- a context with b : Bool; not b = case b of true → false; false → true is neutral, and stays
Γb : Ctx
Γb = ext emp (s-bool , λ ρ → one)
bP : PTy (Env (ext Γb (s-bool , λ ρ → one)))
bP = (s-bool , λ ρ → one)
not-der : Der (Γb , (s-bool , λ ρ → one) , c-case c-false c-true (cvar #0) , λ ρ → bool-elim (λ b → Bool) false true (snd ρ))
not-der = dcase Γb (λ ρ → one) bP (cvar #0) (λ ρ → snd ρ) c-false (λ ρ → false) c-true (λ ρ → true)
  (dvar Γb (s-bool , λ ρ → one) #0 (λ ρ → snd ρ) (vz emp (s-bool , λ ρ → one)))
  (dfalse Γb (λ ρ → one)) (dtrue Γb (λ ρ → one))
#same fst (normalize-nf Γb (s-bool , λ ρ → one) (c-case c-false c-true (cvar #0) , (λ ρ → bool-elim (λ b → Bool) false true (snd ρ)) , not-der)) = c-case c-false c-true (cvar #0)
