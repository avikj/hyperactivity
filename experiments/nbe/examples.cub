-- experiments/nbe/examples.cub — lib/nbe.cub's normalizer run on derivations (2026-11-12).
-- Load after CORE and lib/nbe.cub.
-- Bool as a closure over any environments, and its structure
bc : Clo s-bool Unit
bc = (Unit , (λ u → unit) , one)
-- the type Bool → Bool in the empty context, as a Π closure over the empty context's environments
bb : PTy (Env emp)
bb = pi-ty (Env emp) (Env emp) s-bool s-bool (λ ρ → ρ) (Unit , (λ u → unit) , one) (Unit , (λ u → unit) , one)
-- λ x. x : Bool → Bool
id-der : Der (emp , bb , clam (cvar #0) , λ ρ x → x)
id-der = dlam emp (Env emp) s-bool s-bool (λ ρ → ρ) (Unit , (λ u → unit) , one) (Unit , (λ u → unit) , one)
  (cvar #0) (λ ρ → snd ρ)
  (dvar (ext emp (cl-dom (Env emp) (Env emp) s-bool (λ ρ → ρ) (Unit , (λ u → unit) , one)))
        (cl-cod (Env emp) (Env emp) s-bool s-bool (λ ρ → ρ) (Unit , (λ u → unit) , one) (Unit , (λ u → unit) , one))
        #0 (λ ρ → snd ρ)
        (vz emp (cl-dom (Env emp) (Env emp) s-bool (λ ρ → ρ) (Unit , (λ u → unit) , one))))
-- (λ x. x) true : Bool, a β-redex
app-der : Der (emp , bool-cl (Env emp) Unit (λ ρ → unit) one , capp (clam (cvar #0)) c-true , λ ρ → true)
app-der = dapp emp (Env emp) s-bool s-bool (λ ρ → ρ) (Unit , (λ u → unit) , one) (Unit , (λ u → unit) , one)
  (clam (cvar #0)) (λ ρ x → x) c-true (λ ρ → true) id-der (dtrue emp Unit (λ ρ → unit) one)
#same fst (normalize-nf emp (bool-cl (Env emp) Unit (λ ρ → unit) one) (capp (clam (cvar #0)) c-true , (λ ρ → true) , app-der)) = c-true
#same fst (normalize-nf emp bb (clam (cvar #0) , (λ ρ x → x) , id-der)) = clam (cvar #0)
-- a context with f : Bool → Bool; f normalizes to its η-expansion λ x. f x
Γf : Ctx
Γf = ext emp bb
f-der : Der (Γf , wk emp bb bb , cvar #0 , λ ρ → snd ρ)
f-der = dvar Γf (wk emp bb bb) #0 (λ ρ → snd ρ) (vz emp bb)
#same fst (normalize-nf Γf (wk emp bb bb) (cvar #0 , (λ ρ → snd ρ) , f-der)) = clam (capp (cvar #1) (cvar #0))
-- a context with b : Bool; not b = case b of true → false; false → true is neutral, and stays
Γb : Ctx
Γb = ext emp (bool-cl (Env emp) Unit (λ ρ → unit) one)
bP : PTy (Env (ext Γb (bool-cl (Env Γb) Unit (λ ρ → unit) one)))
bP = bool-cl (Env (ext Γb (bool-cl (Env Γb) Unit (λ ρ → unit) one))) Unit (λ ρ → unit) one
not-der : Der (Γb , bool-cl (Env Γb) Unit (λ ρ → unit) one , c-case c-false c-true (cvar #0) ,
               λ ρ → bool-elim (λ b → Bool) false true (snd ρ))
not-der = dcase Γb Unit (λ ρ → unit) one bP (cvar #0) (λ ρ → snd ρ) c-false (λ ρ → false) c-true (λ ρ → true)
  (dvar Γb (bool-cl (Env Γb) Unit (λ ρ → unit) one) #0 (λ ρ → snd ρ) (vz emp (bool-cl (Env emp) Unit (λ ρ → unit) one)))
  (dfalse Γb Unit (λ ρ → unit) one) (dtrue Γb Unit (λ ρ → unit) one)
#same fst (normalize-nf Γb (bool-cl (Env Γb) Unit (λ ρ → unit) one) (c-case c-false c-true (cvar #0) , (λ ρ → bool-elim (λ b → Bool) false true (snd ρ)) , not-der)) = c-case c-false c-true (cvar #0)
