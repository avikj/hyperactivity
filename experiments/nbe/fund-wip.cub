-- the substitution of the new variable's form: on a canonical g, dnf-subst at dnf-v0 is the
-- normalizer's join with 0 of its meet with 1 of g, which is g (meet-one: meeting with 1 is
-- normalizing; join-nil: joining 0 to a canonical form; norm-id)
meet-one : (g : DNF) → dnf-meet g dnf-one ≡ dnf-norm g
meet-one lnil = λ i → lnil
meet-one (lcons c cs) = λ i → dnf-add (conj-meet c lnil) (meet-one cs i)
join-nil : (f : DNF) → dnf-ok f ≡ true → dnf-join f lnil ≡ f
join-nil lnil h = λ i → lnil
join-nil (lcons c cs) h =
  pcat0 DNF (dnf-add c (dnf-join cs lnil)) (dnf-add c cs) (lcons c cs) (λ i → dnf-add c (join-nil cs (ok-tail c cs h) i)) (add-head c cs h)
subst-v0 : (sk' sk : Lst Entry) (σ : CMap sk' sk) (g : DNF) → isTrue (dnf-canon g) → dnf-subst sk' (lcons e-dim sk) (σ , g) dnf-v0 ≡ g
subst-v0 sk' sk σ g cg =
  pcat0 DNF (dnf-join (dnf-meet g dnf-one) lnil) (dnf-join g lnil) g
    (λ i → dnf-join (pcat0 DNF (dnf-meet g dnf-one) (dnf-norm g) g (meet-one g) (norm-id g (canon-ok g (isTrue→eq {dnf-canon g} cg))) i) lnil)
    (join-nil g (canon-ok g (isTrue→eq {dnf-canon g} cg)))
-- a path λ's body (any meaning read off as lines over dext) under sub-form at a canonical g is path
-- application at g of σ's action (plam-beta: papp-dwk, papp-line-subst, subst-v0, sub-form-dwk)
plam-beta : (Δ' Δ : CCtx) (σ : Sub Δ' Δ) (g : DNF) (cg : isTrue (dnf-canon g)) (Y Z : Type 1) (ℓ : Y → Line Z) (X : Mean Δ Y) →
  PathM Δ' Z (subM Δ' (dext Δ) Z (sub-form Δ' Δ σ g) (dline-body Δ Y Z ℓ X)) (papp-line Δ' Y Z ℓ g (subM Δ' Δ Y σ X))
plam-beta Δ' Δ σ g cg Y Z ℓ X =
  (pcat (Mean Δ' Z) (subM Δ' (dext Δ) Z (sub-form Δ' Δ σ g) (dline-body Δ Y Z ℓ X)) (subM Δ' (dext Δ) Z (sub-form Δ' Δ σ g) (papp-line (dext Δ) Y Z ℓ dnf-v0 (dwkM Δ Y X))) (papp-line Δ' Y Z ℓ g (subM Δ' Δ Y σ X)) (λ i → subM Δ' (dext Δ) Z (sub-form Δ' Δ σ g) (papp-dwk Δ Y Z ℓ X (~ i))) (pcat (Mean Δ' Z) (subM Δ' (dext Δ) Z (sub-form Δ' Δ σ g) (papp-line (dext Δ) Y Z ℓ dnf-v0 (dwkM Δ Y X))) (papp-line Δ' Y Z ℓ (dnf-subst (fst Δ') (lcons e-dim (fst Δ)) (fst σ , g) dnf-v0) (subM Δ' (dext Δ) Y (sub-form Δ' Δ σ g) (dwkM Δ Y X))) (papp-line Δ' Y Z ℓ g (subM Δ' Δ Y σ X)) (psym (Mean Δ' Z) (papp-line Δ' Y Z ℓ (dnf-subst (fst Δ') (lcons e-dim (fst Δ)) (fst σ , g) dnf-v0) (subM Δ' (dext Δ) Y (sub-form Δ' Δ σ g) (dwkM Δ Y X))) (subM Δ' (dext Δ) Z (sub-form Δ' Δ σ g) (papp-line (dext Δ) Y Z ℓ dnf-v0 (dwkM Δ Y X))) (papp-line-subst Δ' (dext Δ) (sub-form Δ' Δ σ g) Y Z ℓ dnf-v0 (dwkM Δ Y X))) (pcat (Mean Δ' Z) (papp-line Δ' Y Z ℓ (dnf-subst (fst Δ') (lcons e-dim (fst Δ)) (fst σ , g) dnf-v0) (subM Δ' (dext Δ) Y (sub-form Δ' Δ σ g) (dwkM Δ Y X))) (papp-line Δ' Y Z ℓ g (subM Δ' (dext Δ) Y (sub-form Δ' Δ σ g) (dwkM Δ Y X))) (papp-line Δ' Y Z ℓ g (subM Δ' Δ Y σ X)) (λ i → papp-line Δ' Y Z ℓ (subst-v0 (fst Δ') (fst Δ) (fst σ) g cg i) (subM Δ' (dext Δ) Y (sub-form Δ' Δ σ g) (dwkM Δ Y X))) (λ i → papp-line Δ' Y Z ℓ g (sub-form-dwk Δ' Δ σ g Y X i)))))


-- ---------------------------------------------------------------- fund (1), (2): environments
-- (2026-11-14) σ's forms canonical (CanonCM, by recursion on the skeleton), kept by renaming
-- (canonCM-r); then substituted forms are canonical (canon-sform, canon-lsubst, canon-csubst,
-- canon-subst: canon-join, canon-meet, canon-neg)
CanonCM : (sk' sk : Lst Entry) → CMap sk' sk → Type
CanonCM sk' lnil σ = Unit
CanonCM sk' (lcons (e-ty a) sk) σ = CanonCM sk' sk σ
CanonCM sk' (lcons e-dim sk) σ = CanonCM sk' sk (fst σ) × isTrue (dnf-canon (snd σ))
canonCM-r : (sk2 sk1 sk : Lst Entry) (r : Word → Word) (h : MonoW r) (σ : CMap sk1 sk) → CanonCM sk1 sk σ → CanonCM sk2 sk (cmap-r sk2 sk1 sk r σ)
canonCM-r sk2 sk1 lnil r h σ cc = unit
canonCM-r sk2 sk1 (lcons (e-ty a) sk) r h σ cc = canonCM-r sk2 sk1 sk r h σ cc
canonCM-r sk2 sk1 (lcons e-dim sk) r h σ cc = (canonCM-r sk2 sk1 sk r h (fst σ) (fst cc) , canon-r r h (snd σ) (snd cc))
canon-sform : (sk' sk : Lst Entry) (σ : CMap sk' sk) → CanonCM sk' sk σ → (k : Word) → isTrue (dnf-canon (subst-form sk' sk σ k))
canon-sform sk' lnil σ cc k = unit
canon-sform sk' (lcons (e-ty a) sk) σ cc k =
  bool-elim (λ b → isTrue (dnf-canon (if b then dnf-zero else subst-form sk' sk σ (%wsub k #1)))) unit (canon-sform sk' sk σ cc (%wsub k #1)) (weq k #0)
canon-sform sk' (lcons e-dim sk) σ cc k =
  bool-elim (λ b → isTrue (dnf-canon (if b then snd σ else subst-form sk' sk (fst σ) (%wsub k #1)))) (snd cc) (canon-sform sk' sk (fst σ) (fst cc) (%wsub k #1)) (weq k #0)
canon-lsubst : (sk' sk : Lst Entry) (σ : CMap sk' sk) → CanonCM sk' sk σ → (l : Lit) → isTrue (dnf-canon (lit-subst sk' sk σ l))
canon-lsubst sk' sk σ cc l =
  bool-elim (λ b → isTrue (dnf-canon (if b then subst-form sk' sk σ (fst l) else dnf-neg (subst-form sk' sk σ (fst l)))))
    (canon-sform sk' sk σ cc (fst l)) (canon-neg (subst-form sk' sk σ (fst l))) (snd l)
canon-csubst : (sk' sk : Lst Entry) (σ : CMap sk' sk) → CanonCM sk' sk σ → (cj : Conj) → isTrue (dnf-canon (conj-subst sk' sk σ cj))
canon-csubst sk' sk σ cc lnil = unit
canon-csubst sk' sk σ cc (lcons l ls) =
  canon-meet (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls) (canon-lsubst sk' sk σ cc l) (canon-csubst sk' sk σ cc ls)
canon-subst : (sk' sk : Lst Entry) (σ : CMap sk' sk) → CanonCM sk' sk σ → (g : DNF) → isTrue (dnf-canon (dnf-subst sk' sk σ g))
canon-subst sk' sk σ cc lnil = unit
canon-subst sk' sk σ cc (lcons cj cs) =
  canon-join (conj-subst sk' sk σ cj) (dnf-subst sk' sk σ cs) (canon-csubst sk' sk σ cc cj) (canon-subst sk' sk σ cc cs)
-- a computable environment: σ's forms canonical and each variable's value computable; kept along a
-- world (env-w: canonCM-r, comp-ren, subM-wcomp)
CompEnv : (Γ Δ : CCtx) → Sub Δ Γ → Type 1
CompEnv Γ Δ σ = (ceF : CanonCM (fst Δ) (fst Γ) (fst σ)) ×
  ((v : VarP (fst Γ)) → CompS (var-shape (fst Γ) v) Δ (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)))
env-w : (Γ Δ : CCtx) (σ : Sub Δ Γ) → CompEnv Γ Δ σ → (Δ' : CCtx) (w : World Δ' Δ) → CompEnv Γ Δ' (sub-wcomp Δ' Δ Γ w σ)
env-w Γ Δ σ e Δ' w =
  (canonCM-r (fst Δ') (fst Δ) (fst Γ) (fst w) (fst (snd w)) (fst σ) (fst e) ,
   λ v → comp-tr (var-shape (fst Γ) v) Δ' (wact Δ' Δ w (TV (var-shape (fst Γ) v)) (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)))
           (subM Δ' Γ (TV (var-shape (fst Γ) v)) (sub-wcomp Δ' Δ Γ w σ) (varCube Γ v))
           (psym (Mean Δ' (TV (var-shape (fst Γ) v))) (subM Δ' Γ (TV (var-shape (fst Γ) v)) (sub-wcomp Δ' Δ Γ w σ) (varCube Γ v))
              (wact Δ' Δ w (TV (var-shape (fst Γ) v)) (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)))
              (subM-wcomp Δ' Δ Γ w σ (TV (var-shape (fst Γ) v)) (varCube Γ v)))
           (comp-ren (var-shape (fst Γ) v) Δ (subM Δ Γ (TV (var-shape (fst Γ) v)) σ (varCube Γ v)) (snd e v) Δ' w))
-- the extension's variables: an old one's value is σ's (ext-old: of-lift, subM-ext, pull-ignore,
-- fmap-pull, pull-ignore, subM-of), the new one's is zpt's argument (ext-new: var-lift, ext-beta);
-- so a computable environment extends by a computable argument (ext-env)
ext-old : (Δ' Δ : CCtx) (a : TyShape) (Y Y' : Type 1) (j : Y → Y') (h' : Y' → Sem a) (M : Mean Δ Y) (σ : Sub Δ' Δ) (A' : Mean Δ' ((yq : Y') × El a (h' yq)))
  (p : PathM Δ' Y' (fmapM Δ' ((yq : Y') × El a (h' yq)) Y' (λ z → fst z) A') (fmapM Δ' Y Y' j (subM Δ' Δ Y σ M))) (v : VarP (fst Δ)) →
  PathM Δ' (TV (var-shape (fst Δ) v)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) (some v))) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v))
ext-old Δ' Δ a Y Y' j h' M σ A' p v =
  (pcat (Mean Δ' (TV (var-shape (fst Δ) v))) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) (some v))) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (ext-liftG Δ a Y (λ y → h' (j y)) (TV (var-shape (fst Δ) v)) (λ γ e ρ'' → varM (fst Δ) v γ (fst ρ'')) M)) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (λ i → subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (of-lift (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (lcons (e-ty a) (fst Δ))) (FbE (fst Δ) Y) (FbE (lcons (e-ty a) (fst Δ)) (TV (var-shape (fst Δ) v))) (λ γ e → (γ , λ ρ → h' (j (e ρ)))) (varM (lcons (e-ty a) (fst Δ)) (some v)) (snd Δ) M i)) (pcat (Mean Δ' (TV (var-shape (fst Δ) v))) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (ext-liftG Δ a Y (λ y → h' (j y)) (TV (var-shape (fst Δ) v)) (λ γ e ρ'' → varM (fst Δ) v γ (fst ρ'')) M)) (dcube-pull (dims (fst Δ')) (CtxV (fst Δ')) (TotT (fst Δ') (fst Δ) Y) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (ExtV (fst Δ') (fst Δ) a Y (λ γ e ρ → h' (j (e ρ)))) (λ γ' t → (γ' , t)) (λ γ' t v' ρ' → varM (fst Δ) v (fst (fst t)) (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y σ M) (ext-val Δ' Δ a Y Y' j h' M σ A' p)) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (subM-ext Δ' Δ a Y (λ y → h' (j y)) M σ (ext-val Δ' Δ a Y Y' j h' M σ A' p) (TV (var-shape (fst Δ) v)) (λ γ e ρ'' → varM (fst Δ) v γ (fst ρ''))) (pcat (Mean Δ' (TV (var-shape (fst Δ) v))) (dcube-pull (dims (fst Δ')) (CtxV (fst Δ')) (TotT (fst Δ') (fst Δ) Y) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (ExtV (fst Δ') (fst Δ) a Y (λ γ e ρ → h' (j (e ρ)))) (λ γ' t → (γ' , t)) (λ γ' t v' ρ' → varM (fst Δ) v (fst (fst t)) (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y σ M) (ext-val Δ' Δ a Y Y' j h' M σ A' p)) (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (λ γ' t ρ' → varM (fst Δ) v (fst (fst t)) (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y σ M)) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (pull-ignore (dims (fst Δ')) (CtxV (fst Δ')) (TotT (fst Δ') (fst Δ) Y) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (ExtV (fst Δ') (fst Δ) a Y (λ γ e ρ → h' (j (e ρ)))) (λ γ' t → (γ' , t)) (λ γ' t ρ' → varM (fst Δ) v (fst (fst t)) (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y σ M) (ext-val Δ' Δ a Y Y' j h' M σ A' p)) (pcat (Mean Δ' (TV (var-shape (fst Δ) v))) (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (λ γ' t ρ' → varM (fst Δ) v (fst (fst t)) (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y σ M)) (dcube-pull (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p e ρ' → varM (fst Δ) v (fst p) (snd p ρ')) (snd Δ') (fst (snd σ)) (sub-carried Δ' Δ Y σ M)) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (fmap-pull (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p e → (p , e)) (λ γ' t ρ' → varM (fst Δ) v (fst (fst t)) (snd (fst t) ρ')) (snd Δ') (fst (snd σ)) (sub-carried Δ' Δ Y σ M)) (pcat (Mean Δ' (TV (var-shape (fst Δ) v))) (dcube-pull (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p e ρ' → varM (fst Δ) v (fst p) (snd p ρ')) (snd Δ') (fst (snd σ)) (sub-carried Δ' Δ Y σ M)) (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ)) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (λ γ' p ρ' → varM (fst Δ) v (fst p) (snd p ρ')) (snd Δ') (fst (snd σ))) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (pull-ignore (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p ρ' → varM (fst Δ) v (fst p) (snd p ρ')) (snd Δ') (fst (snd σ)) (sub-carried Δ' Δ Y σ M)) (psym (Mean Δ' (TV (var-shape (fst Δ) v))) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ)) (FbE (fst Δ') (TV (var-shape (fst Δ) v))) (λ γ' p ρ' → varM (fst Δ) v (fst p) (snd p ρ')) (snd Δ') (fst (snd σ))) (subM-of Δ' Δ (TV (var-shape (fst Δ) v)) σ (varM (fst Δ) v))))))))
ext-new : (Δ' Δ : CCtx) (a : TyShape) (Y Y' : Type 1) (j : Y → Y') (h' : Y' → Sem a) (M : Mean Δ Y) (σ : Sub Δ' Δ) (A' : Mean Δ' ((yq : Y') × El a (h' yq)))
  (p : PathM Δ' Y' (fmapM Δ' ((yq : Y') × El a (h' yq)) Y' (λ z → fst z) A') (fmapM Δ' Y Y' j (subM Δ' Δ Y σ M))) →
  PathM Δ' (TV a) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) none)) (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p))
ext-new Δ' Δ a Y Y' j h' M σ A' p =
  (pcat (Mean Δ' (TV a)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) none)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (ext-lift Δ a Y (λ y → h' (j y)) (TV a) (λ q x → (h' (j q) , x)) M)) (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) (λ i → subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (var-lift Δ a Y (λ y → h' (j y)) M i)) (ext-beta Δ' Δ a Y Y' j h' M σ A' p (TV a) (λ q x → (h' (j q) , x))))
ext-env-v : (Δ' Δ : CCtx) (a : TyShape) (Y Y' : Type 1) (j : Y → Y') (h' : Y' → Sem a) (M : Mean Δ Y) (σ : Sub Δ' Δ) (A' : Mean Δ' ((yq : Y') × El a (h' yq)))
  (p : PathM Δ' Y' (fmapM Δ' ((yq : Y') × El a (h' yq)) Y' (λ z → fst z) A') (fmapM Δ' Y Y' j (subM Δ' Δ Y σ M))) → CompEnv Δ Δ' σ → CompS a Δ' (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) →
  (v : VarP (lcons (e-ty a) (fst Δ))) → CompS (var-shape (lcons (e-ty a) (fst Δ)) v) Δ' (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (lcons (e-ty a) (fst Δ)) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) v))
ext-env-v Δ' Δ a Y Y' j h' M σ A' p e cn none = comp-tr a Δ' (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) none)) (psym (Mean Δ' (TV a)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV a) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) none)) (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) (ext-new Δ' Δ a Y Y' j h' M σ A' p)) cn
ext-env-v Δ' Δ a Y Y' j h' M σ A' p e cn (some v) = comp-tr (var-shape (fst Δ) v) Δ' (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) (some v))) (psym (Mean Δ' (TV (var-shape (fst Δ) v))) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) (TV (var-shape (fst Δ) v)) (ext-at Δ' Δ a Y Y' j h' M σ A' p) (varCube (ext-h Δ a Y (λ y → h' (j y)) M) (some v))) (subM Δ' Δ (TV (var-shape (fst Δ) v)) σ (varCube Δ v)) (ext-old Δ' Δ a Y Y' j h' M σ A' p v)) (snd e v)
ext-env : (Δ' Δ : CCtx) (a : TyShape) (Y Y' : Type 1) (j : Y → Y') (h' : Y' → Sem a) (M : Mean Δ Y) (σ : Sub Δ' Δ) (A' : Mean Δ' ((yq : Y') × El a (h' yq)))
  (p : PathM Δ' Y' (fmapM Δ' ((yq : Y') × El a (h' yq)) Y' (λ z → fst z) A') (fmapM Δ' Y Y' j (subM Δ' Δ Y σ M))) → CompEnv Δ Δ' σ → CompS a Δ' (fmapM Δ' ((yz : Y) × El a (h' (j yz))) (TV a) (λ z → (h' (j (fst z)) , snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p)) → CompEnv (ext-h Δ a Y (λ y → h' (j y)) M) Δ' (ext-at Δ' Δ a Y Y' j h' M σ A' p)
ext-env Δ' Δ a Y Y' j h' M σ A' p e cn = (fst e , ext-env-v Δ' Δ a Y Y' j h' M σ A' p e cn)

