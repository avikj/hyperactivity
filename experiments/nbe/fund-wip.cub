       (fmap-pull (dims (fst Δ')) (CtxV (fst Δ')) (TotT (fst Δ') (fst Δ) Y) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') ((yz : Y) × El a (h' (j yz)))) (FbE (fst Δ') Z) (ExtV (fst Δ') (fst Δ) a Y (λ γ e ρ → h' (j (e ρ)))) (λ γ' t → (γ' , t)) (λ γ' t v ρ → (snd t (snd (fst t) ρ) , v ρ)) (λ γ' e ρ → G0 (fst (e ρ)) (snd (e ρ))) (snd Δ') (sub-tot Δ' Δ Y σ M) (ext-val Δ' Δ a Y Y' j h' M σ A' p)))


