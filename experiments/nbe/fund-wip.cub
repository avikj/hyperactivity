    (fmapM Δ' ((yz : Y) × El a (h' (j yz))) Z (λ z → G0 (fst z) (snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p))
    (subM-ext Δ' Δ a Y (λ y → h' (j y)) M σ (ext-val Δ' Δ a Y Y' j h' M σ A' p) Z (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)))
    (psym (Mean Δ' Z) (fmapM Δ' ((yz : Y) × El a (h' (j yz))) Z (λ z → G0 (fst z) (snd z)) (zpt Δ' Δ a Y Y' j h' M σ A' p))
