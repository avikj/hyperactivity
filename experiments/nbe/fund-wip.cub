-- ---------------------------------------------------------------- fund (4a): the extension at a cube of arguments
-- (2026-11-14) transport of an element of El along a path of codes of semantic types, and its filler
el-tr : (a : TyShape) (Y' : Type 1) (h' : Y' → Sem a) (y0 y1 : Y') (P : PathP (λ i → Y') y0 y1) → El a (h' y0) → El a (h' y1)
el-tr a Y' h' y0 y1 P b = comp (λ i → El a (h' (P i))) (λ i → []) b
el-fill : (a : TyShape) (Y' : Type 1) (h' : Y' → Sem a) (y0 y1 : Y') (P : PathP (λ i → Y') y0 y1) (b : El a (h' y0)) →
  PathP (λ i → El a (h' (P i))) b (el-tr a Y' h' y0 y1 P b)
el-fill a Y' h' y0 y1 P b = λ i → comp (λ j → El a (h' (P (i ∧ j)))) (λ j → [ i = 0 ↦ b ]) b
-- a cube A' of pairs (value in Y', argument) whose values agree along p with σ's action on M after j
-- (ext-path-A: p, then fmap-pull twice) gives V over tot-base (ext-val, dcube-dzip at el-tr), the
-- extended substitution (ext-at) and the cube zpt of pairs (value in Y, argument), V paired back with
-- sub-tot: its values are σ's action on M (zpt-fst), and after j it is A' (zpt-snd, dzip-pull at el-fill)
ext-path-A : (Δ' Δ : CCtx) (a : TyShape) (Y Y' : Type 1) (j : Y → Y') (h' : Y' → Sem a) (M : Mean Δ Y) (σ : Sub Δ' Δ) (A' : Mean Δ' ((yq : Y') × El a (h' yq)))
  (p : PathM Δ' Y' (fmapM Δ' ((yq : Y') × El a (h' yq)) Y' (λ z → fst z) A') (fmapM Δ' Y Y' j (subM Δ' Δ Y σ M))) →
  PathP (λ i → Mean Δ' Y') (fmapM Δ' ((yq : Y') × El a (h' yq)) Y' (λ z → fst z) A') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y') (λ γ' t ρ → j (snd t (snd (fst t) ρ))) (snd Δ') (sub-tot Δ' Δ Y σ M))
