import "p26-wip.cub"
-- fund-wip: work toward fund (lib/nbe.cub head, fund's plan); moved into p26-wip.cub when checked

-- ---------------------------------------------------------------- fund (4a): a cube of arguments over sub-tot
-- (2026-11-14) A cube A over a base whose image (π) agrees along a path P with the image (k) of a
-- cube T over the same base gives a cube over T's total (dcube-dzip): at each vertex the pointwise
-- tr (in use, a transport of A's argument along P). Pulling it back with g that recovers A
-- pointwise (qz, in use the transport's filler) gives A (dzip-pull). By recursion on n, as pull-gen.
lineo-dzip : (X R : Type 1) (S F G : X → Type 1) (W : R → Type 1) (f : (x : X) → S x → R) (k : (x : X) → S x → G x) (π : (x : X) → F x → G x)
  (tr : (x : X) (t : S x) (φ : F x) → PathP (λ i → G x) (π x φ) (k x t) → W (f x t))
  (L : Line X) (T : LineO X S L) (A : LineO X F L) → PathP (λ i → LineO X G L) (lineo-fmap X F G π L A) (lineo-fmap X S G k L T) →
  LineO R W (lineo-map X S R f L T)
lineo-dzip X R S F G W f k π tr L T A P =
  (tr (fst L) (fst T) (fst A) (λ i → fst (P i)) , tr (fst (snd L)) (fst (snd T)) (fst (snd A)) (λ i → fst (snd (P i))) ,
   λ j → tr (snd (snd L) j) (snd (snd T) j) (snd (snd A) j) (λ i → snd (snd (P i)) j))
dcube-dzip : (n : Nat) (X R : Type 1) (S F G : X → Type 1) (W : R → Type 1) (f : (x : X) → S x → R) (k : (x : X) → S x → G x) (π : (x : X) → F x → G x)
  (tr : (x : X) (t : S x) (φ : F x) → PathP (λ i → G x) (π x φ) (k x t) → W (f x t))
  (c : Cube n X) (T : DCube n X S c) (A : DCube n X F c) → PathP (λ i → DCube n X G c) (dcube-fmap n X F G π c A) (dcube-fmap n X S G k c T) →
  DCube n R W (dcube-map n X S R f c T)
dcube-dzip zero X R S F G W f k π tr c T A P = tr c T A P
dcube-dzip (suc n) X R S F G W f k π tr c T A P =
  dcube-dzip n (Line X) (Line R) (LineO X S) (LineO X F) (LineO X G) (LineO R W) (lineo-map X S R f) (lineo-fmap X S G k) (lineo-fmap X F G π)
    (lineo-dzip X R S F G W f k π tr) c T A P
dzip-pull : (n : Nat) (X R : Type 1) (S F G : X → Type 1) (W : R → Type 1) (f : (x : X) → S x → R) (k : (x : X) → S x → G x) (π : (x : X) → F x → G x)
  (tr : (x : X) (t : S x) (φ : F x) → PathP (λ i → G x) (π x φ) (k x t) → W (f x t))
  (g : (x : X) (t : S x) → W (f x t) → F x)
  (qz : (x : X) (t : S x) (φ : F x) (P : PathP (λ i → G x) (π x φ) (k x t)) → PathP (λ i → F x) (g x t (tr x t φ P)) φ)
  (c : Cube n X) (T : DCube n X S c) (A : DCube n X F c) (P : PathP (λ i → DCube n X G c) (dcube-fmap n X F G π c A) (dcube-fmap n X S G k c T)) →
  PathP (λ i → DCube n X F c) (dcube-pull n X R S F W f g c T (dcube-dzip n X R S F G W f k π tr c T A P)) A
dzip-pull zero X R S F G W f k π tr g qz c T A P = qz c T A P
dzip-pull (suc n) X R S F G W f k π tr g qz c T A P =
  dzip-pull n (Line X) (Line R) (LineO X S) (LineO X F) (LineO X G) (LineO R W) (lineo-map X S R f) (lineo-fmap X S G k) (lineo-fmap X F G π)
    (lineo-dzip X R S F G W f k π tr) (lineo-pull X R S F W f g)
    (λ L T A P i →
       (qz (fst L) (fst T) (fst A) (λ i' → fst (P i')) i , qz (fst (snd L)) (fst (snd T)) (fst (snd A)) (λ i' → fst (snd (P i'))) i ,
        λ j → qz (snd (snd L) j) (snd (snd T) j) (snd (snd A) j) (λ i' → snd (snd (P i')) j) i))
    c T A P

-- ---------------------------------------------------------------- fund (4b): through a pull
-- (2026-11-14) A map out of the pull of e along d that ignores e is a map out of d (map-pull-i, q
-- judgmental where used); a cube over the pull's image read off d and e (dcube-liftp, a lift through
-- the pull) is reached from the lift over d along it (lift-pull-i); pulling back along the pull
-- reads the lift through it pointwise (pull-liftp). By recursion on n, as map-pull and lift-pull.
map-pull-i : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (kT : (x : X) → Y x → Z)
  (q : PathP (λ i → (x : X) (y : Y x) → F' (f x y) → Z) (λ x y e → kT x y) (λ x y e → k x (g x y e)))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → Cube n Z) (dcube-map n X Y Z kT c d) (dcube-map n X F Z k c (dcube-pull n X X' Y F F' f g c d e))
map-pull-i zero X X' Y F F' f g Z k kT q c d e = λ i → q i c d e
map-pull-i (suc n) X X' Y F F' f g Z k kT q c d e =
  map-pull-i n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (Line Z) (lineo-map X F Z k) (lineo-map X Y Z kT)
    (λ i L D E → (q i (fst L) (fst D) (fst E) , q i (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ j → q i (snd (snd L) j) (snd (snd D) j) (snd (snd E) j)))
    c d e
lineo-liftp : (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (H : Z → Type 1) (l : (x : X) (y : Y x) (v : F' (f x y)) → H (k x (g x y v)))
  (L : Line X) (D : LineO X Y L) (E : LineO X' F' (lineo-map X Y X' f L D)) → LineO Z H (lineo-map X F Z k L (lineo-pull X X' Y F F' f g L D E))
lineo-liftp X X' Y F F' f g Z k H l L D E =
  (l (fst L) (fst D) (fst E) , l (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ j → l (snd (snd L) j) (snd (snd D) j) (snd (snd E) j))
dcube-liftp : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (H : Z → Type 1) (l : (x : X) (y : Y x) (v : F' (f x y)) → H (k x (g x y v)))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  DCube n Z H (dcube-map n X F Z k c (dcube-pull n X X' Y F F' f g c d e))
dcube-liftp zero X X' Y F F' f g Z k H l c d e = l c d e
dcube-liftp (suc n) X X' Y F F' f g Z k H l c d e =
  dcube-liftp n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (Line Z) (lineo-map X F Z k) (LineO Z H) (lineo-liftp X X' Y F F' f g Z k H l) c d e
lift-pull-i : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (kT : (x : X) → Y x → Z)
  (q : PathP (λ i → (x : X) (y : Y x) → F' (f x y) → Z) (λ x y e → kT x y) (λ x y e → k x (g x y e)))
  (H : Z → Type 1) (lT : (x : X) (y : Y x) → H (kT x y)) (l : (x : X) (y : Y x) (v : F' (f x y)) → H (k x (g x y v)))
  (ql : PathP (λ i → (x : X) (y : Y x) (v : F' (f x y)) → H (q i x y v)) (λ x y v → lT x y) l)
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n Z H (map-pull-i n X X' Y F F' f g Z k kT q c d e i)) (dcube-lift n X Z Y H kT lT c d) (dcube-liftp n X X' Y F F' f g Z k H l c d e)
lift-pull-i zero X X' Y F F' f g Z k kT q H lT l ql c d e = λ i → ql i c d e
lift-pull-i (suc n) X X' Y F F' f g Z k kT q H lT l ql c d e =
  lift-pull-i n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (Line Z) (lineo-map X F Z k) (lineo-map X Y Z kT)
    (λ i L D E → (q i (fst L) (fst D) (fst E) , q i (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ j → q i (snd (snd L) j) (snd (snd D) j) (snd (snd E) j)))
    (LineO Z H) (lineo-lift X Z Y H kT lT) (lineo-liftp X X' Y F F' f g Z k H l)
    (λ i L D E → (ql i (fst L) (fst D) (fst E) , ql i (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ j → ql i (snd (snd L) j) (snd (snd D) j) (snd (snd E) j)))
    c d e
pull-liftp : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (H : Z → Type 1) (l : (x : X) (y : Y x) (v : F' (f x y)) → H (k x (g x y v)))
  (F2 : X → Type 1) (gp : (x : X) (p : F x) → H (k x p) → F2 x)
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F2 c) (dcube-pull n X Z F F2 H k gp c (dcube-pull n X X' Y F F' f g c d e) (dcube-liftp n X X' Y F F' f g Z k H l c d e))
    (dcube-pull n X X' Y F2 F' f (λ x y v → gp x (g x y v) (l x y v)) c d e)
pull-liftp zero X X' Y F F' f g Z k H l F2 gp c d e = λ i → gp c (g c d e) (l c d e)
pull-liftp (suc n) X X' Y F F' f g Z k H l F2 gp c d e =
  pull-liftp n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (Line Z) (lineo-map X F Z k) (LineO Z H) (lineo-liftp X X' Y F F' f g Z k H l) (LineO X F2) (lineo-pull X Z F F2 H k gp) c d e

-- ---------------------------------------------------------------- fund (4b): the action of an extended substitution
-- (2026-11-14) a lift over ext-h Γ's cube with its function at the vertex, the value and the
-- environment (ext-liftG; ext-lift is ext-liftG at λ γ e ρ → G0 (e (fst ρ)) (snd ρ), judgmentally; a
-- variable of the extended context is one at varM)
ext-liftG : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (Z : Type 1)
  (l : (γ : CtxV (fst Γ)) (e : EnvV (fst Γ) γ → Y) → FbE (lcons (e-ty a) (fst Γ)) Z (γ , λ ρ → h (e ρ))) (M : Mean Γ Y) →
  Mean (ext-h Γ a Y h M) Z
ext-liftG Γ a Y h Z l M =
  dcube-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) Z)
    (λ γ e → (γ , λ ρ → h (e ρ))) l (snd Γ) M
-- the dimension part's action on such a lift, carried along ext-path, is the lift over sub-tot (kl-DE
-- with σ in place of world-sub w and l in place of G0's function; generic in both)
ext-D : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (σ : Sub Δ' Δ) (Z : Type 1) (l : (γ : CtxV (fst Δ)) (e : EnvV (fst Δ) γ → Y) → FbE (lcons (e-ty a) (fst Δ)) Z (γ , λ ρ → h (e ρ))) → PathP (λ i → (DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ))) (FbE (lcons (e-ty a) (fst Δ)) Z) ((ext-path Δ' Δ a Y (λ γ e ρ → h (e ρ)) M σ) i))) ((cmap-d (fst Δ') (fst Δ) (fst σ) (CtxV (lcons (e-ty a) (fst Δ))) (FbE (lcons (e-ty a) (fst Δ)) Z) (snd (ext-h Δ a Y h M)) (ext-liftG Δ a Y h Z l M))) ((dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ))) (SubT (fst Δ') (fst Δ) Y) (FbE (lcons (e-ty a) (fst Δ)) Z) (λ γ' t → (fst (fst t) , λ ρ → h (snd t ρ))) (λ γ' t → l (fst (fst t)) (snd t)) (snd Δ') (sub-tot Δ' Δ Y σ M)))
ext-D Δ' Δ a Y h M σ Z l =
