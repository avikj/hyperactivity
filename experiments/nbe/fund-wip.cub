-- case (fund-case): a branch selected by the scrutinee's equation (case-at, sel-t, sel-f: a zip of
-- the meaning with its scrutinee, the scrutinee replaced along the equation, the constant's branch)
case-at : (s : TyShape) (q : CaseV s) (xb : TV s-bool) → TV s
case-at s q xb = (fst (snd q) (snd xb) , bool-elim (λ b → El s (fst (snd q) b)) (fst (snd (snd (snd q)))) (snd (snd (snd (snd q)))) (snd xb))

