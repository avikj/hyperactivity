  pcat (Mean Δ' Z) (subM Δ' (ext-h Δ a Y (λ y → h' (j y)) M) Z (ext-at Δ' Δ a Y Y' j h' M σ A' p) (ext-lift Δ a Y (λ y → h' (j y)) Z G0 M))
