-- experiments/nbe/papp-subst-draft.cub — papp-subst step 1, written 2026-11-14, CHECKED (1304 passed, 0 failed, with p26-wip.cub); to be
-- loaded after experiments/nbe/p26-wip.cub (./build/cubical lib/core.cub experiments/nbe/p26-wip.cub this-file),
-- moved into p26-wip.cub after cmap-papp-ex, and this file deleted (lib/nbe.cub head: "Next, papp-subst").
-- (papp-subst) substitution on canonical forms: a literal becomes σ's form for its variable (its
-- negation for ~i), a conjunction the normalizer's meet, a form the normalizer's join (so dnf-subst
-- of a canonical form is canonical, F2d'); its reading is the substituted expression up to IEq (F2d)
subst-form : (sk' sk : Lst Entry) → CMap sk' sk → Word → DNF
subst-form sk' lnil σ k = dnf-zero
subst-form sk' (lcons (e-ty a) sk) σ k = if weq k #0 then dnf-zero else subst-form sk' sk σ (%wsub k #1)
subst-form sk' (lcons e-dim sk) σ k = if weq k #0 then snd σ else subst-form sk' sk (fst σ) (%wsub k #1)
sform-ix : (sk' sk : Lst Entry) (σ : CMap sk' sk) (k : Word) → Path IEx (dnf-ix (subst-form sk' sk σ k)) (subst-var sk' sk σ k)
sform-ix sk' lnil σ k = λ i → ix0
sform-ix sk' (lcons (e-ty a) sk) σ k =
  bool-elim (λ b → Path IEx (dnf-ix (if b then dnf-zero else subst-form sk' sk σ (%wsub k #1))) (if b then ix0 else subst-var sk' sk σ (%wsub k #1)))
    (λ i → ix0) (sform-ix sk' sk σ (%wsub k #1)) (weq k #0)
sform-ix sk' (lcons e-dim sk) σ k =
  bool-elim (λ b → Path IEx (dnf-ix (if b then snd σ else subst-form sk' sk (fst σ) (%wsub k #1))) (if b then dnf-ix (snd σ) else subst-var sk' sk (fst σ) (%wsub k #1)))
    (λ i → dnf-ix (snd σ)) (sform-ix sk' sk (fst σ) (%wsub k #1)) (weq k #0)
lit-subst : (sk' sk : Lst Entry) → CMap sk' sk → Lit → DNF
lit-subst sk' sk σ l = if snd l then subst-form sk' sk σ (fst l) else dnf-neg (subst-form sk' sk σ (fst l))
conj-subst : (sk' sk : Lst Entry) → CMap sk' sk → Conj → DNF
conj-subst sk' sk σ lnil = dnf-one
conj-subst sk' sk σ (lcons l ls) = dnf-meet (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls)
dnf-subst : (sk' sk : Lst Entry) → CMap sk' sk → DNF → DNF
dnf-subst sk' sk σ lnil = dnf-zero
dnf-subst sk' sk σ (lcons c cs) = dnf-join (conj-subst sk' sk σ c) (dnf-subst sk' sk σ cs)
-- an equation of expressions gives one path application
ieq-path : (sk : Lst Entry) (e e' : IEx) → Path IEx e e' → IEq sk e e'
ieq-path sk e e' p X F G d = λ i → papp-ex sk X F (p i) G d
-- the substituted reading of a cons, as a meet and a join
ixs-conj-cons : (sk' sk : Lst Entry) (σ : CMap sk' sk) (l : Lit) (ls : Conj) → IEq sk' (ixs sk' sk σ (conj-ix (lcons l ls))) (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix ls)))
ixs-conj-cons sk' sk σ l lnil = ieq-sym sk' (ixmeet (ixs sk' sk σ (lit-ix l)) ix1) (ixs sk' sk σ (lit-ix l)) (law-unit-m-r sk' (ixs sk' sk σ (lit-ix l)))
ixs-conj-cons sk' sk σ l (lcons m ms) = ieq-refl sk' (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix-from m ms)))
ixs-dnf-cons : (sk' sk : Lst Entry) (σ : CMap sk' sk) (c : Conj) (cs : DNF) → IEq sk' (ixs sk' sk σ (dnf-ix (lcons c cs))) (ixjoin (ixs sk' sk σ (conj-ix c)) (ixs sk' sk σ (dnf-ix cs)))
ixs-dnf-cons sk' sk σ c lnil = ieq-sym sk' (ixjoin (ixs sk' sk σ (conj-ix c)) ix0) (ixs sk' sk σ (conj-ix c)) (law-unit-j-r sk' (ixs sk' sk σ (conj-ix c)))
ixs-dnf-cons sk' sk σ c (lcons d ds) = ieq-refl sk' (ixjoin (ixs sk' sk σ (conj-ix c)) (ixs sk' sk σ (dnf-ix-from d ds)))
lit-subst-sound : (sk' sk : Lst Entry) (σ : CMap sk' sk) (l : Lit) → IEq sk' (dnf-ix (lit-subst sk' sk σ l)) (ixs sk' sk σ (lit-ix l))
lit-subst-sound sk' sk σ l =
  bool-elim2 (λ b → IEq sk' (dnf-ix (if b then subst-form sk' sk σ (fst l) else dnf-neg (subst-form sk' sk σ (fst l)))) (ixs sk' sk σ (if b then ixv (fst l) else ixneg (ixv (fst l)))))
    (ieq-path sk' (dnf-ix (subst-form sk' sk σ (fst l))) (subst-var sk' sk σ (fst l)) (sform-ix sk' sk σ (fst l)))
    (ieq-trans sk' (dnf-ix (dnf-neg (subst-form sk' sk σ (fst l)))) (ixneg (dnf-ix (subst-form sk' sk σ (fst l)))) (ixneg (subst-var sk' sk σ (fst l)))
      (dnf-neg-sound sk' (subst-form sk' sk σ (fst l)))
      (ieq-neg sk' (dnf-ix (subst-form sk' sk σ (fst l))) (subst-var sk' sk σ (fst l)) (ieq-path sk' (dnf-ix (subst-form sk' sk σ (fst l))) (subst-var sk' sk σ (fst l)) (sform-ix sk' sk σ (fst l)))))
    (snd l)
conj-subst-sound : (sk' sk : Lst Entry) (σ : CMap sk' sk) (c : Conj) → IEq sk' (dnf-ix (conj-subst sk' sk σ c)) (ixs sk' sk σ (conj-ix c))
conj-subst-sound sk' sk σ lnil = ieq-refl sk' ix1
conj-subst-sound sk' sk σ (lcons l ls) =
  ieq-trans sk' (dnf-ix (dnf-meet (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls))) (ixmeet (dnf-ix (lit-subst sk' sk σ l)) (dnf-ix (conj-subst sk' sk σ ls))) (ixs sk' sk σ (conj-ix (lcons l ls)))
    (dnf-meet-sound sk' (lit-subst sk' sk σ l) (conj-subst sk' sk σ ls))
    (ieq-trans sk' (ixmeet (dnf-ix (lit-subst sk' sk σ l)) (dnf-ix (conj-subst sk' sk σ ls))) (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix ls))) (ixs sk' sk σ (conj-ix (lcons l ls)))
      (ieq-meet sk' (dnf-ix (lit-subst sk' sk σ l)) (ixs sk' sk σ (lit-ix l)) (dnf-ix (conj-subst sk' sk σ ls)) (ixs sk' sk σ (conj-ix ls)) (lit-subst-sound sk' sk σ l) (conj-subst-sound sk' sk σ ls))
      (ieq-sym sk' (ixs sk' sk σ (conj-ix (lcons l ls))) (ixmeet (ixs sk' sk σ (lit-ix l)) (ixs sk' sk σ (conj-ix ls))) (ixs-conj-cons sk' sk σ l ls)))
dnf-subst-sound : (sk' sk : Lst Entry) (σ : CMap sk' sk) (f : DNF) → IEq sk' (dnf-ix (dnf-subst sk' sk σ f)) (ixs sk' sk σ (dnf-ix f))
dnf-subst-sound sk' sk σ lnil = ieq-refl sk' ix0
dnf-subst-sound sk' sk σ (lcons c cs) =
  ieq-trans sk' (dnf-ix (dnf-join (conj-subst sk' sk σ c) (dnf-subst sk' sk σ cs))) (ixjoin (dnf-ix (conj-subst sk' sk σ c)) (dnf-ix (dnf-subst sk' sk σ cs))) (ixs sk' sk σ (dnf-ix (lcons c cs)))
    (dnf-join-sound sk' (conj-subst sk' sk σ c) (dnf-subst sk' sk σ cs))
    (ieq-trans sk' (ixjoin (dnf-ix (conj-subst sk' sk σ c)) (dnf-ix (dnf-subst sk' sk σ cs))) (ixjoin (ixs sk' sk σ (conj-ix c)) (ixs sk' sk σ (dnf-ix cs))) (ixs sk' sk σ (dnf-ix (lcons c cs)))
      (ieq-join sk' (dnf-ix (conj-subst sk' sk σ c)) (ixs sk' sk σ (conj-ix c)) (dnf-ix (dnf-subst sk' sk σ cs)) (ixs sk' sk σ (dnf-ix cs)) (conj-subst-sound sk' sk σ c) (dnf-subst-sound sk' sk σ cs))
      (ieq-sym sk' (ixs sk' sk σ (dnf-ix (lcons c cs))) (ixjoin (ixs sk' sk σ (conj-ix c)) (ixs sk' sk σ (dnf-ix cs))) (ixs-dnf-cons sk' sk σ c cs)))
-- path application at canonical forms under a substitution: at the substituted form of the substituted
-- cube, the substitution of path application (F2d then F2e)
cmap-papp-ddS : (sk' sk : Lst Entry) (σ : CMap sk' sk) (f : DNF) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (Q : DCube (dims sk) X (DL X F) G) →
  PathP (λ i → DCube (dims sk') X F (cmap-cube sk' sk σ X G)) (papp-dd sk' X F (dnf-subst sk' sk σ f) (cmap-cube sk' sk σ X G) (cmap-d sk' sk σ X (DL X F) G Q)) (cmap-d sk' sk σ X F G (papp-dd sk X F f G Q))
cmap-papp-ddS sk' sk σ f X F G Q =
  pcat (DCube (dims sk') X F (cmap-cube sk' sk σ X G)) (papp-dd sk' X F (dnf-subst sk' sk σ f) (cmap-cube sk' sk σ X G) (cmap-d sk' sk σ X (DL X F) G Q))
    (papp-ex sk' X F (ixs sk' sk σ (dnf-ix f)) (cmap-cube sk' sk σ X G) (cmap-d sk' sk σ X (DL X F) G Q)) (cmap-d sk' sk σ X F G (papp-dd sk X F f G Q))
    (dnf-subst-sound sk' sk σ f X F (cmap-cube sk' sk σ X G) (cmap-d sk' sk σ X (DL X F) G Q))
    (cmap-papp-ex sk' sk σ (dnf-ix f) X F G Q)
