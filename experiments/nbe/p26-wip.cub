  (pcat (Cube (dims sk2) X) (papp-cube sk2 X (snd σ) (cmap-cube sk2 sk1 (fst σ) (Line X) (cube-const (dims sk1) (Line X) (degen-l X x)))) (papp-cube sk2 X (snd σ) (cube-const (dims sk2) (Line X) (degen-l X x))) (cube-const (dims sk2) X x) (λ i → papp-cube sk2 X (snd σ) (cmap-const sk2 sk1 (fst σ) (Line X) (degen-l X x) i)) (pcat (Cube (dims sk2) X) (papp-cube sk2 X (snd σ) (cube-const (dims sk2) (Line X) (degen-l X x))) (papp-cube sk2 X (snd σ) (cube-map (dims sk2) X (Line X) (degen-l X) (cube-const (dims sk2) X x))) (cube-const (dims sk2) X x) (λ i → papp-cube sk2 X (snd σ) (const-map (dims sk2) X (Line X) (degen-l X) x (~ i))) (papp-deg sk2 X (snd σ) (cube-const (dims sk2) X x))))
