       (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)))
    (λ i → papp-conj-d sk X F' o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))
       (pcat (DCube (suc (dims sk)) X F' (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
          (dcube-fmap (suc (dims sk)) X F F' h (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))
             (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
                (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)))
          (papp-dnf-from-d (lcons e-dim sk) X F' (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (dcube-fmap (suc (suc (dims sk))) X F F' h (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
                (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)))
          (papp-dnf-from-d (lcons e-dim sk) X F' (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F') (LineO (Line X) (LineO X F')) (join-l X) (join-o X F') c
                (dcube-fmap (suc (dims sk)) X F F' h c d)))
          (fmap-papp-dnf-from (lcons e-dim sk) X F F' h (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d))
          (λ j → papp-dnf-from-d (lcons e-dim sk) X F' (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (fmap-gen (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO X F') (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F'))
                (join-l X) (join-o X F) (join-o X F') (lineo-fmap X F F' h) (lineo-fmap (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h))
                (λ k L D → lineo-fmap (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) (join-l X L) (join-o X F L D)) c d j)) i))
fmap-papp : (sk : Lst Entry) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (f : DNF)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → DCube (dims sk) X F' (papp-cube sk X f c))
    (dcube-fmap (dims sk) X F F' h (papp-cube sk X f c) (papp-cube-d sk X F f c d))
    (papp-cube-d sk X F' f c (dcube-fmap (suc (dims sk)) X F F' h c d))
fmap-papp sk X F F' h lnil c d =
  fmap-gen (dims sk) (Line X) X (LineO X F) (LineO X F') F F' (face0-l X) (face0-o X F) (face0-o X F') (lineo-fmap X F F' h) h
    (λ i L D → h (fst L) (fst D)) c d
fmap-papp sk X F F' h (lcons cj cs) c d = fmap-papp-dnf-from sk X F F' h #0 cj cs c d

-- ---------------------------------------------------------------- P2.6d: judgments, normal forms and derivations over cubes
-- (2026-11-12) the path shape's semantic types are P2.3's, judgmentally (t50: PathP at Type 1)
sem-path : (a : TyShape) → PathP (λ i → Type 1) (Sem (s-path a)) (PathS (Sem a) (El a))
sem-path a = λ i → PathS (Sem a) (El a)
-- a judgment: a context over cubes, a shape, a raw code and a meaning over the context (each vertex's
-- environments to a semantic type of the shape with an element)
Jdg : Type 1
-- binder names chosen not to collide: t46
Jdg = (jΓ : CCtx) × (js : TyShape) × Code × Mean jΓ (TV js)
-- the rules' data, read pointwise, and the named projections that give their premises' and
-- conclusions' meanings (shared by NN, Der, CompS and reify)
AppV : TyShape → TyShape → Type 1
-- binder names chosen not to collide: t46
AppV a b = (avT : Fam a b) × El (s-pi a b) avT × El a (fst avT)
app-f : (a b : TyShape) → AppV a b → TV (s-pi a b)
app-f a b q = (fst q , fst (snd q))
app-a : (a b : TyShape) → AppV a b → TV a
app-a a b q = (fst (fst q) , snd (snd q))
app-r : (a b : TyShape) → AppV a b → TV b
app-r a b q = (snd (fst q) (snd (snd q)) , fst (snd q) (snd (snd q)))
sig-1 : (a b : TyShape) → TV (s-sig a b) → TV a
sig-1 a b q = (fst (fst q) , fst (snd q))
sig-2 : (a b : TyShape) → TV (s-sig a b) → TV b
sig-2 a b q = (snd (fst q) (fst (snd q)) , snd (snd q))
CaseV : TyShape → Type 1
-- binder names chosen not to collide: t46
CaseV sP = (cvB : One1) × (cvP : Bool → Sem sP) × (cvx : Bool) × El sP (cvP true) × El sP (cvP false)
case-x : (sP : TyShape) → CaseV sP → TV s-bool
case-x sP q = (fst q , fst (snd (snd q)))
case-t : (sP : TyShape) → CaseV sP → TV sP
case-t sP q = (fst (snd q) true , fst (snd (snd (snd q))))
case-f : (sP : TyShape) → CaseV sP → TV sP
case-f sP q = (fst (snd q) false , snd (snd (snd (snd q))))
case-r : (sP : TyShape) → CaseV sP → TV sP
case-r sP q =
  (fst (snd q) (fst (snd (snd q))) ,
   bool-elim (λ b → El sP (fst (snd q) b)) (fst (snd (snd (snd q)))) (snd (snd (snd (snd q)))) (fst (snd (snd q))))
bool-v : Bool → One1 → TV s-bool
bool-v b u = (u , b)
-- a λ's body: its context is extM at the λ's own conclusion X (the domain read off X), its meaning X
-- pushed over X, applied to the new variable
lam-dom : (sk : Lst Entry) (a b : TyShape) (γ : CtxV sk) → (EnvV sk γ → TV (s-pi a b)) → EnvV sk γ → Sem a
lam-dom sk a b γ e ρ = fst (fst (e ρ))
lam-ctx : (Γ : CCtx) (a b : TyShape) → Mean Γ (TV (s-pi a b)) → CCtx
lam-ctx Γ a b X = extM Γ a (TV (s-pi a b)) (lam-dom (fst Γ) a b) X
lam-body : (Γ : CCtx) (a b : TyShape) (X : Mean Γ (TV (s-pi a b))) → Mean (lam-ctx Γ a b X) (TV b)
lam-body Γ a b X =
  dcube-push (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) (TV (s-pi a b))) (FbE (fst Γ) (TV (s-pi a b)))
    (FbE (lcons (e-ty a) (fst Γ)) (TV b)) (λ γ e → (γ , lam-dom (fst Γ) a b γ e))
    (λ γ e e2 ρ → (snd (fst (e (fst ρ))) (snd ρ) , snd (e (fst ρ)) (snd ρ))) (snd Γ) X X
-- a path λ's body: over dext Γ, the conclusion X reindexed at the degeneracy, each vertex's path read
-- as the line of its (type, value) pairs (its ends are the path type's endpoints judgmentally)
plam-line : (sk : Lst Entry) (a : TyShape) (γ : CtxV sk) (e : EnvV sk γ → TV (s-path a)) →
  LineO (CtxV sk) (FbE sk (TV a)) (degen-l (CtxV sk) γ)
plam-line sk a γ e =
  ((λ ρ → (fst (fst (fst (e ρ))) , fst (snd (fst (e ρ))))) ,
   (λ ρ → (fst (snd (fst (fst (e ρ)))) , snd (snd (fst (e ρ))))) ,
   λ i ρ → (snd (snd (fst (fst (e ρ)))) i , snd (e ρ) i))
plam-body : (Γ : CCtx) (a : TyShape) → Mean Γ (TV (s-path a)) → Mean (dext Γ) (TV a)
plam-body Γ a X =
  dcube-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) (TV (s-path a))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) (TV a)))
    (degen-l (CtxV (fst Γ))) (plam-line (fst Γ) a) (snd Γ) X
-- carrying a cube over a base along a path of bases (the form fmap-transp is about)
carry : (n : Nat) (X : Type 1) (F : X → Type 1) (c0 c1 : Cube n X) → PathP (λ i → Cube n X) c0 c1 → DCube n X F c0 → DCube n X F c1
carry n X F c0 c1 p d = comp (λ i → DCube n X F (p i)) (λ i → []) d
-- the meaning of a path applied at a canonical form f: the path's body over dext Γ applied at f
-- (papp-cube-d), carried back over Γ along papp-deg
papp-mean : (Γ : CCtx) (a : TyShape) (f : DNF) → Mean Γ (TV (s-path a)) → Mean Γ (TV a)
papp-mean Γ a f P =
  carry (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) (TV a))
    (papp-cube (fst Γ) (CtxV (fst Γ)) f (snd (dext Γ))) (snd Γ) (papp-deg (fst Γ) (CtxV (fst Γ)) f (snd Γ))
    (papp-cube-d (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) (TV a)) f (snd (dext Γ)) (plam-body Γ a P))
-- a path between meanings, as a named type: a PathP over a path λ in a constructor's field is refused
-- (t52; workaround: this definition, used by npapp and dpapp)
PathM : (Γ : CCtx) (Z : Type 1) → Mean Γ Z → Mean Γ Z → Type 1
PathM Γ Z M N = PathP (λ i → Mean Γ Z) M N
-- neutral and normal forms, one family (the kind in the index), η-long and redex-free: a neutral is
-- normal only at Bool; a path application is neutral only at a canonical non-constant form
-- constructor binders subscripted ₀: t46
data NN : (KJ : NK × Jdg) → Type 1 where
  nvar : (Γ₀ : CCtx) (v₀ : VarP (fst Γ₀)) →
    NN (k-ne , (Γ₀ , var-shape (fst Γ₀) v₀ , cvar (var-word (fst Γ₀) v₀) , varCube Γ₀ v₀))
  napp : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (AppV a₀ b₀)) (f₀ c₀ : Code) →
    NN (k-ne , (Γ₀ , s-pi a₀ b₀ , f₀ , fmapM Γ₀ (AppV a₀ b₀) (TV (s-pi a₀ b₀)) (app-f a₀ b₀) R₀)) →
    NN (k-nf , (Γ₀ , a₀ , c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV a₀) (app-a a₀ b₀) R₀)) →
    NN (k-ne , (Γ₀ , b₀ , capp f₀ c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV b₀) (app-r a₀ b₀) R₀))
  nfst : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    NN (k-ne , (Γ₀ , s-sig a₀ b₀ , p₀ , R₀)) →
    NN (k-ne , (Γ₀ , a₀ , cfst p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀))
  nsnd : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    NN (k-ne , (Γ₀ , s-sig a₀ b₀ , p₀ , R₀)) →
    NN (k-ne , (Γ₀ , b₀ , csnd p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀))
  ncase : (Γ₀ : CCtx) (s₀ : TyShape) (R₀ : Mean Γ₀ (CaseV s₀)) (x₀ t₀ f₀ : Code) →
    NN (k-ne , (Γ₀ , s-bool , x₀ , fmapM Γ₀ (CaseV s₀) (TV s-bool) (case-x s₀) R₀)) →
    NN (k-nf , (Γ₀ , s₀ , t₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-t s₀) R₀)) →
    NN (k-nf , (Γ₀ , s₀ , f₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-f s₀) R₀)) →
    NN (k-ne , (Γ₀ , s₀ , c-case t₀ f₀ x₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-r s₀) R₀))
  nne : (Γ₀ : CCtx) (R₀ : Mean Γ₀ (TV s-bool)) (x₀ : Code) →
    NN (k-ne , (Γ₀ , s-bool , x₀ , R₀)) → NN (k-nf , (Γ₀ , s-bool , x₀ , R₀))
  ntrue : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → NN (k-nf , (Γ₀ , s-bool , c-true , fmapM Γ₀ One1 (TV s-bool) (bool-v true) B₀))
  nfalse : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → NN (k-nf , (Γ₀ , s-bool , c-false , fmapM Γ₀ One1 (TV s-bool) (bool-v false) B₀))
  nlam : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-pi a₀ b₀))) (c₀ : Code) →
    NN (k-nf , (lam-ctx Γ₀ a₀ b₀ X₀ , b₀ , c₀ , lam-body Γ₀ a₀ b₀ X₀)) → NN (k-nf , (Γ₀ , s-pi a₀ b₀ , clam c₀ , X₀))
  npair : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (c1₀ c2₀ : Code) →
    NN (k-nf , (Γ₀ , a₀ , c1₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀)) →
    NN (k-nf , (Γ₀ , b₀ , c2₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀)) →
    NN (k-nf , (Γ₀ , s-sig a₀ b₀ , cpair c1₀ c2₀ , R₀))
  nplam : (Γ₀ : CCtx) (a₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-path a₀))) (c₀ : Code) →
    NN (k-nf , (dext Γ₀ , a₀ , c₀ , plam-body Γ₀ a₀ X₀)) → NN (k-nf , (Γ₀ , s-path a₀ , cplam c₀ , X₀))
  npapp : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) (f₀ : DNF) →
    isTrue (dnf-canon f₀) → isTrue (dnf-nonconst f₀) →
    (Y₀ : Mean Γ₀ (TV a₀)) → PathM Γ₀ (TV a₀) (papp-mean Γ₀ a₀ f₀ P₀) Y₀ →
    NN (k-ne , (Γ₀ , s-path a₀ , p₀ , P₀)) → NN (k-ne , (Γ₀ , a₀ , cpapp p₀ (dnf-code f₀) , Y₀))
-- typing derivations, the same rules without the kinds; path application at any canonical form
-- constructor binders subscripted ₀: t46
data Der : (J : Jdg) → Type 1 where
  dvar : (Γ₀ : CCtx) (v₀ : VarP (fst Γ₀)) →
    Der (Γ₀ , var-shape (fst Γ₀) v₀ , cvar (var-word (fst Γ₀) v₀) , varCube Γ₀ v₀)
  dapp : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (AppV a₀ b₀)) (f₀ c₀ : Code) →
    Der (Γ₀ , s-pi a₀ b₀ , f₀ , fmapM Γ₀ (AppV a₀ b₀) (TV (s-pi a₀ b₀)) (app-f a₀ b₀) R₀) →
    Der (Γ₀ , a₀ , c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV a₀) (app-a a₀ b₀) R₀) →
    Der (Γ₀ , b₀ , capp f₀ c₀ , fmapM Γ₀ (AppV a₀ b₀) (TV b₀) (app-r a₀ b₀) R₀)
  dfst : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    Der (Γ₀ , s-sig a₀ b₀ , p₀ , R₀) → Der (Γ₀ , a₀ , cfst p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀)
  dsnd : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (p₀ : Code) →
    Der (Γ₀ , s-sig a₀ b₀ , p₀ , R₀) → Der (Γ₀ , b₀ , csnd p₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀)
  dcase : (Γ₀ : CCtx) (s₀ : TyShape) (R₀ : Mean Γ₀ (CaseV s₀)) (x₀ t₀ f₀ : Code) →
    Der (Γ₀ , s-bool , x₀ , fmapM Γ₀ (CaseV s₀) (TV s-bool) (case-x s₀) R₀) →
    Der (Γ₀ , s₀ , t₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-t s₀) R₀) →
    Der (Γ₀ , s₀ , f₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-f s₀) R₀) →
    Der (Γ₀ , s₀ , c-case t₀ f₀ x₀ , fmapM Γ₀ (CaseV s₀) (TV s₀) (case-r s₀) R₀)
  dtrue : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → Der (Γ₀ , s-bool , c-true , fmapM Γ₀ One1 (TV s-bool) (bool-v true) B₀)
  dfalse : (Γ₀ : CCtx) (B₀ : Mean Γ₀ One1) → Der (Γ₀ , s-bool , c-false , fmapM Γ₀ One1 (TV s-bool) (bool-v false) B₀)
  dlam : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-pi a₀ b₀))) (c₀ : Code) →
    Der (lam-ctx Γ₀ a₀ b₀ X₀ , b₀ , c₀ , lam-body Γ₀ a₀ b₀ X₀) → Der (Γ₀ , s-pi a₀ b₀ , clam c₀ , X₀)
  dpair : (Γ₀ : CCtx) (a₀ b₀ : TyShape) (R₀ : Mean Γ₀ (TV (s-sig a₀ b₀))) (c1₀ c2₀ : Code) →
    Der (Γ₀ , a₀ , c1₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV a₀) (sig-1 a₀ b₀) R₀) →
    Der (Γ₀ , b₀ , c2₀ , fmapM Γ₀ (TV (s-sig a₀ b₀)) (TV b₀) (sig-2 a₀ b₀) R₀) →
    Der (Γ₀ , s-sig a₀ b₀ , cpair c1₀ c2₀ , R₀)
  dplam : (Γ₀ : CCtx) (a₀ : TyShape) (X₀ : Mean Γ₀ (TV (s-path a₀))) (c₀ : Code) →
    Der (dext Γ₀ , a₀ , c₀ , plam-body Γ₀ a₀ X₀) → Der (Γ₀ , s-path a₀ , cplam c₀ , X₀)
  dpapp : (Γ₀ : CCtx) (a₀ : TyShape) (P₀ : Mean Γ₀ (TV (s-path a₀))) (p₀ : Code) (f₀ : DNF) →
    isTrue (dnf-canon f₀) →
    (Y₀ : Mean Γ₀ (TV a₀)) → PathM Γ₀ (TV a₀) (papp-mean Γ₀ a₀ f₀ P₀) Y₀ →
    Der (Γ₀ , s-path a₀ , p₀ , P₀) → Der (Γ₀ , a₀ , cpapp p₀ (dnf-code f₀) , Y₀)
-- typed codes (paper §6.1): Code(Γ, A) = Σ c. Der(Γ, c, A), the meaning carried with the derivation;
-- evaluation (6.1) is that meaning
TCode : CCtx → TyShape → Type 1
TCode Γ s = (c : Code) × (v : Mean Γ (TV s)) × Der (Γ , s , c , v)
teval : (Γ : CCtx) (s : TyShape) → TCode Γ s → Mean Γ (TV s)
teval Γ s t = fst (snd t)
-- normal and neutral forms are derivations, with the same code and meaning
embed : {KJ : NK × Jdg} → NN KJ → Der (snd KJ)
embed (nvar Γ v) = dvar Γ v
embed (napp Γ a b R f c nf na) = dapp Γ a b R f c (embed nf) (embed na)
embed (nfst Γ a b R p np) = dfst Γ a b R p (embed np)
embed (nsnd Γ a b R p np) = dsnd Γ a b R p (embed np)
embed (ncase Γ s R x t f nx nt nf) = dcase Γ s R x t f (embed nx) (embed nt) (embed nf)
embed (nne Γ R x nx) = embed nx
embed (ntrue Γ B) = dtrue Γ B
embed (nfalse Γ B) = dfalse Γ B
embed (nlam Γ a b X c nb) = dlam Γ a b X c (embed nb)
embed (npair Γ a b R c1 c2 n1 n2) = dpair Γ a b R c1 c2 (embed n1) (embed n2)
embed (nplam Γ a X c nb) = dplam Γ a X c (embed nb)
embed (npapp Γ a P p f cf nc Y q np) = dpapp Γ a P p f cf Y q (embed np)

-- ---------------------------------------------------------------- P2.6e (begun): substitutions over cubes
-- (2026-11-12) The dimension part of a substitution Δ → Γ is a map of the cube category given, as in
-- CCHM, by an interval form over Δ's skeleton for each dimension of Γ's (CMap; a world's forms are
-- variables). Its action on cubes: the constant cube at no dimension, then path application at each
-- form (papp-cube), newest innermost; on cubes over cubes likewise (papp-cube-d).
cube-const : (n : Nat) (X : Type 1) → X → Cube n X
cube-const zero X x = x
cube-const (suc n) X x = cube-const n (Line X) (degen-l X x)
dcube-const : (n : Nat) (X : Type 1) (F : X → Type 1) (x : X) → F x → DCube n X F (cube-const n X x)
dcube-const zero X F x y = y
dcube-const (suc n) X F x y = dcube-const n (Line X) (LineO X F) (degen-l X x) (degen-o X F x y)
CMap : Lst Entry → Lst Entry → Type
CMap sk' lnil = Unit
CMap sk' (lcons (e-ty a) sk) = CMap sk' sk
CMap sk' (lcons e-dim sk) = CMap sk' sk × DNF
cmap-cube : (sk' sk : Lst Entry) → CMap sk' sk → (X : Type 1) → Cube (dims sk) X → Cube (dims sk') X
cmap-cube sk' lnil σ X c = cube-const (dims sk') X c
cmap-cube sk' (lcons (e-ty a) sk) σ X c = cmap-cube sk' sk σ X c
cmap-cube sk' (lcons e-dim sk) σ X c = papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)
cmap-d : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) X) →
  DCube (dims sk) X F c → DCube (dims sk') X F (cmap-cube sk' sk σ X c)
cmap-d sk' lnil σ X F c d = dcube-const (dims sk') X F c d
cmap-d sk' (lcons (e-ty a) sk) σ X F c d = cmap-d sk' sk σ X F c d
cmap-d sk' (lcons e-dim sk) σ X F c d =
  papp-cube-d sk' X F (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X F) c d)
-- a substitution Δ → Γ: its dimension part, a cube over Δ's context cube of Γ's vertex contexts with
-- environment maps, and a path from the dimension part of Γ's cube to that cube's first projection
SubF : (sk' sk : Lst Entry) → CtxV sk' → Type 1
-- binder names chosen not to collide: t46
SubF sk' sk γ' = (sfγ : CtxV sk) × (EnvV sk' γ' → EnvV sk sfγ)
sub-base : (Δ Γ : CCtx) → DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ) → Cube (dims (fst Δ)) (CtxV (fst Γ))
sub-base Δ Γ S = dcube-map (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (snd Δ) S
Sub : CCtx → CCtx → Type 1
-- binder names chosen not to collide: t46
Sub Δ Γ = (sbd : CMap (fst Δ) (fst Γ)) × (sbS : DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ)) ×
  PathP (λ i → Cube (dims (fst Δ)) (CtxV (fst Γ))) (cmap-cube (fst Δ) (fst Γ) sbd (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ sbS)
-- its action on meanings: the dimension part, carried along the path (sub-carried), then pulled
-- back along the environment maps
sub-carried : (Δ Γ : CCtx) (Z : Type 1) (σ : Sub Δ Γ) → Mean Γ Z → DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Δ Γ (fst (snd σ)))
sub-carried Δ Γ Z σ M =
  carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
    (snd (snd σ)) (cmap-d (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M)
sub-pull : (Δ Γ : CCtx) (Z : Type 1) (S : DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (snd Δ)) →
  DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Δ Γ S) → Mean Δ Z
sub-pull Δ Γ Z S E =
  dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (FbE (fst Γ) Z)
    (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (snd Δ) S E
subM : (Δ Γ : CCtx) (Z : Type 1) → Sub Δ Γ → Mean Γ Z → Mean Δ Z
subM Δ Γ Z σ M = sub-pull Δ Γ Z (fst (snd σ)) (sub-carried Δ Γ Z σ M)
-- at no dimension, the dimension part is the identity judgmentally (P1's case)
cmap-zero : (sk' : Lst Entry) (X : Type 1) (x : X) → PathP (λ i → Cube (dims sk') X) (cmap-cube sk' lnil unit X x) (cube-const (dims sk') X x)
cmap-zero sk' X x = λ i → cube-const (dims sk') X x
-- (2026-11-12) a fibrewise map commutes with the constant cube and with the action of a dimension
-- part (next definitions (3); by fmap-papp at each form)
fmap-const : (n : Nat) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (x : X) (y : F x) →
  PathP (λ i → DCube n X F' (cube-const n X x)) (dcube-fmap n X F F' h (cube-const n X x) (dcube-const n X F x y)) (dcube-const n X F' x (h x y))
fmap-const zero X F F' h x y = λ i → h x y
fmap-const (suc n) X F F' h x y = fmap-const n (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) (degen-l X x) (degen-o X F x y)
fmap-cmap : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
  PathP (λ i → DCube (dims sk') X F' (cmap-cube sk' sk σ X c))
    (dcube-fmap (dims sk') X F F' h (cmap-cube sk' sk σ X c) (cmap-d sk' sk σ X F c d))
    (cmap-d sk' sk σ X F' c (dcube-fmap (dims sk) X F F' h c d))
fmap-cmap sk' lnil σ X F F' h c d = fmap-const (dims sk') X F F' h c d
fmap-cmap sk' (lcons (e-ty a) sk) σ X F F' h c d = fmap-cmap sk' sk σ X F F' h c d
fmap-cmap sk' (lcons e-dim sk) σ X F F' h c d =
  pcat (DCube (dims sk') X F' (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)))
    (dcube-fmap (dims sk') X F F' h (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c))
       (papp-cube-d sk' X F (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X F) c d)))
    (papp-cube-d sk' X F' (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)
       (dcube-fmap (suc (dims sk')) X F F' h (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X F) c d)))
    (papp-cube-d sk' X F' (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)
       (cmap-d sk' sk (fst σ) (Line X) (LineO X F') c (dcube-fmap (suc (dims sk)) X F F' h c d)))
    (fmap-papp sk' X F F' h (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X F) c d))
    (λ i → papp-cube-d sk' X F' (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)
       (fmap-cmap sk' sk (fst σ) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c d i))
-- pulling back after a fibrewise map is pulling back along the composite (a path, by induction)
pull-fmap : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' F2 : X' → Type 1) (f : (x : X) → Y x → X') (h : (x : X') → F' x → F2 x)
  (g : (x : X) (y : Y x) → F2 (f x y) → F x) (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F c)
    (dcube-pull n X X' Y F F2 f g c d (dcube-fmap n X' F' F2 h (dcube-map n X Y X' f c d) e))
    (dcube-pull n X X' Y F F' f (λ x y z → g x y (h (f x y) z)) c d e)
pull-fmap zero X X' Y F F' F2 f h g c d e = λ i → g c d (h (f c d) e)
pull-fmap (suc n) X X' Y F F' F2 f h g c d e =
  pull-fmap n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (LineO X' F2) (lineo-map X Y X' f) (lineo-fmap X' F' F2 h)
    (lineo-pull X X' Y F F2 f g) c d e
-- the action of a substitution commutes with a pointwise map of meanings (next definitions (3))
subM-fmap : (Δ Γ : CCtx) (Z Z' : Type 1) (h : Z → Z') (σ : Sub Δ Γ) (M : Mean Γ Z) →
  PathM Δ Z' (fmapM Δ Z Z' h (subM Δ Γ Z σ M)) (subM Δ Γ Z' σ (fmapM Γ Z Z' h M))
subM-fmap Δ Γ Z Z' h σ M =
  pcat (Mean Δ Z') (fmapM Δ Z Z' h (subM Δ Γ Z σ M))
    (dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
       (λ γ' p → fst p) (λ γ' p e ρ → h (e (snd p ρ))) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
    (subM Δ Γ Z' σ (fmapM Γ Z Z' h M))
    (fmap-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
       (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (λ γ e ρ → h (e ρ)) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
    (pcat (Mean Δ Z')
       (dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
          (λ γ' p → fst p) (λ γ' p e ρ → h (e (snd p ρ))) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
       (sub-pull Δ Γ Z' (fst (snd σ))
          (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Z σ M)))
       (subM Δ Γ Z' σ (fmapM Γ Z Z' h M))
       (psym (Mean Δ Z')
          (sub-pull Δ Γ Z' (fst (snd σ))
             (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Z σ M)))
          (dcube-pull (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z)
             (λ γ' p → fst p) (λ γ' p e ρ → h (e (snd p ρ))) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M))
          (pull-fmap (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z') (FbE (fst Γ) Z) (FbE (fst Γ) Z')
             (λ γ' p → fst p) (λ γ e ρ → h (e ρ)) (λ γ' p e ρ → e (snd p ρ)) (snd Δ) (fst (snd σ)) (sub-carried Δ Γ Z σ M)))
       (λ i → sub-pull Δ Γ Z' (fst (snd σ))
          (pcat (DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z') (sub-base Δ Γ (fst (snd σ))))
             (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (sub-base Δ Γ (fst (snd σ))) (sub-carried Δ Γ Z σ M))
             (carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z') (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
                (snd (snd σ))
                (dcube-fmap (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))
                   (cmap-d (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M)))
             (sub-carried Δ Γ Z' σ (fmapM Γ Z Z' h M))
             (fmap-transp (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ))
                (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ))) (snd (snd σ))
                (cmap-d (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M))
             (λ j → carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z') (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
                (snd (snd σ))
                (fmap-cmap (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → h (e ρ)) (snd Γ) M j)) i)))

-- ---------------------------------------------------------------- P2.6e (1): renaming interval forms
-- (2026-11-12, next definitions (1)) A renaming of forms applies a map of variables to every literal,
-- structurally (no normalization, so that path application at the renamed form is the renamed path
-- application, (4)). A map r of variables that preserves weq and wlt (a monotone injection) commutes
-- with every operation of dnf-norm, so it preserves canonicity; it preserves non-constancy
-- structurally. The renamings are those of order-preserving embeddings of skeletons (OPE, below).
lit-r : (Word → Word) → Lit → Lit
lit-r r l = (r (fst l) , snd l)
conj-r : (Word → Word) → Conj → Conj
conj-r r lnil = lnil
conj-r r (lcons l ls) = lcons (lit-r r l) (conj-r r ls)
dnf-r : (Word → Word) → DNF → DNF
dnf-r r lnil = lnil
dnf-r r (lcons c cs) = lcons (conj-r r c) (dnf-r r cs)
-- r preserves equality and order of variables
MonoW : (Word → Word) → Type
MonoW r = ((a b : Word) → weq (r a) (r b) ≡ weq a b) × ((a b : Word) → wlt (r a) (r b) ≡ wlt a b)
-- composition of paths in a type of level 0, its points explicit
pcat0 : (A : Type) (x y z : A) → x ≡ y → y ≡ z → x ≡ z
pcat0 A x y z p q = concat p q
-- a map out of a conditional (by cases on the condition)
if-map : (A B : Type) (f : A → B) (b : Bool) (x y : A) → f (if b then x else y) ≡ (if b then f x else f y)
if-map A B f b x y = bool-elim (λ c → f (if c then x else y) ≡ (if c then f x else f y)) (λ i → f x) (λ i → f y) b
lit-eq-r : (r : Word → Word) (h : MonoW r) (l m : Lit) → lit-eq (lit-r r l) (lit-r r m) ≡ lit-eq l m
lit-eq-r r h l m = λ i → andB (fst h (fst l) (fst m) i) (bool-eq (snd l) (snd m))
lit-lt-r : (r : Word → Word) (h : MonoW r) (l m : Lit) → lit-lt (lit-r r l) (lit-r r m) ≡ lit-lt l m
lit-lt-r r h l m = λ i →
  if snd h (fst l) (fst m) i then true else (if fst h (fst l) (fst m) i then andB (not (snd l)) (snd m) else false)
conj-ins-r : (r : Word → Word) (h : MonoW r) (l : Lit) (c : Conj) → conj-ins (lit-r r l) (conj-r r c) ≡ conj-r r (conj-ins l c)
conj-ins-r r h l lnil = λ i → lcons (lit-r r l) lnil
conj-ins-r r h l (lcons m ms) =
  pcat0 Conj
    (conj-ins (lit-r r l) (conj-r r (lcons m ms)))
    (if lit-eq l m then lcons (lit-r r m) (conj-r r ms)
     else (if lit-lt l m then lcons (lit-r r l) (lcons (lit-r r m) (conj-r r ms)) else lcons (lit-r r m) (conj-r r (conj-ins l ms))))
    (conj-r r (conj-ins l (lcons m ms)))
    (λ i → if lit-eq-r r h l m i then lcons (lit-r r m) (conj-r r ms)
           else (if lit-lt-r r h l m i then lcons (lit-r r l) (lcons (lit-r r m) (conj-r r ms))
                 else lcons (lit-r r m) (conj-ins-r r h l ms i)))
    (pcat0 Conj
       (if lit-eq l m then lcons (lit-r r m) (conj-r r ms)
        else (if lit-lt l m then lcons (lit-r r l) (lcons (lit-r r m) (conj-r r ms)) else lcons (lit-r r m) (conj-r r (conj-ins l ms))))
       (if lit-eq l m then conj-r r (lcons m ms) else conj-r r (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms)))
       (conj-r r (conj-ins l (lcons m ms)))
       (λ i → if lit-eq l m then lcons (lit-r r m) (conj-r r ms)
              else sym (if-map Conj Conj (conj-r r) (lit-lt l m) (lcons l (lcons m ms)) (lcons m (conj-ins l ms))) i)
       (sym (if-map Conj Conj (conj-r r) (lit-eq l m) (lcons m ms)
               (if lit-lt l m then lcons l (lcons m ms) else lcons m (conj-ins l ms)))))
conj-meet-r : (r : Word → Word) (h : MonoW r) (c d : Conj) → conj-meet (conj-r r c) (conj-r r d) ≡ conj-r r (conj-meet c d)
conj-meet-r r h lnil d = λ i → conj-r r d
conj-meet-r r h (lcons l ls) d = cong (conj-ins (lit-r r l)) (conj-meet-r r h ls d) ∙ conj-ins-r r h l (conj-meet ls d)
conj-has-r : (r : Word → Word) (h : MonoW r) (l : Lit) (c : Conj) → conj-has (lit-r r l) (conj-r r c) ≡ conj-has l c
conj-has-r r h l lnil = λ i → false
conj-has-r r h l (lcons m ms) = λ i → if lit-eq-r r h l m i then true else conj-has-r r h l ms i
conj-sub-r : (r : Word → Word) (h : MonoW r) (c d : Conj) → conj-sub (conj-r r c) (conj-r r d) ≡ conj-sub c d
conj-sub-r r h lnil d = λ i → true
conj-sub-r r h (lcons l ls) d = λ i → andB (conj-has-r r h l d i) (conj-sub-r r h ls d i)
conj-eq-r : (r : Word → Word) (h : MonoW r) (c d : Conj) → conj-eq (conj-r r c) (conj-r r d) ≡ conj-eq c d
conj-eq-r r h lnil lnil = λ i → true
conj-eq-r r h lnil (lcons m ms) = λ i → false
conj-eq-r r h (lcons l ls) lnil = λ i → false
conj-eq-r r h (lcons l ls) (lcons m ms) = λ i → andB (lit-eq-r r h l m i) (conj-eq-r r h ls ms i)
conj-lt-r : (r : Word → Word) (h : MonoW r) (c d : Conj) → conj-lt (conj-r r c) (conj-r r d) ≡ conj-lt c d
conj-lt-r r h lnil lnil = λ i → false
conj-lt-r r h lnil (lcons m ms) = λ i → true
conj-lt-r r h (lcons l ls) lnil = λ i → false
conj-lt-r r h (lcons l ls) (lcons m ms) = λ i →
  if lit-lt-r r h l m i then true else (if lit-eq-r r h l m i then conj-lt-r r h ls ms i else false)
dnf-any-sub-r : (r : Word → Word) (h : MonoW r) (c : Conj) (f : DNF) → dnf-any-sub (conj-r r c) (dnf-r r f) ≡ dnf-any-sub c f
dnf-any-sub-r r h c lnil = λ i → false
dnf-any-sub-r r h c (lcons d ds) = λ i → if conj-sub-r r h d c i then true else dnf-any-sub-r r h c ds i
dnf-drop-sup-r : (r : Word → Word) (h : MonoW r) (c : Conj) (f : DNF) → dnf-drop-sup (conj-r r c) (dnf-r r f) ≡ dnf-r r (dnf-drop-sup c f)
dnf-drop-sup-r r h c lnil = λ i → lnil
dnf-drop-sup-r r h c (lcons d ds) =
  (λ i → if conj-sub-r r h c d i then dnf-drop-sup-r r h c ds i else lcons (conj-r r d) (dnf-drop-sup-r r h c ds i)) ∙
  sym (if-map DNF DNF (dnf-r r) (conj-sub c d) (dnf-drop-sup c ds) (lcons d (dnf-drop-sup c ds)))
dnf-insert-r : (r : Word → Word) (h : MonoW r) (c : Conj) (f : DNF) → dnf-insert (conj-r r c) (dnf-r r f) ≡ dnf-r r (dnf-insert c f)
dnf-insert-r r h c lnil = λ i → lcons (conj-r r c) lnil
dnf-insert-r r h c (lcons d ds) =
  (λ i → if conj-lt-r r h c d i then lcons (conj-r r c) (lcons (conj-r r d) (dnf-r r ds)) else lcons (conj-r r d) (dnf-insert-r r h c ds i)) ∙
  sym (if-map DNF DNF (dnf-r r) (conj-lt c d) (lcons c (lcons d ds)) (lcons d (dnf-insert c ds)))
dnf-add-r : (r : Word → Word) (h : MonoW r) (c : Conj) (f : DNF) → dnf-add (conj-r r c) (dnf-r r f) ≡ dnf-r r (dnf-add c f)
dnf-add-r r h c f =
  (λ i → if dnf-any-sub-r r h c f i then dnf-r r f
         else (cong (dnf-insert (conj-r r c)) (dnf-drop-sup-r r h c f) ∙ dnf-insert-r r h c (dnf-drop-sup c f)) i) ∙
  sym (if-map DNF DNF (dnf-r r) (dnf-any-sub c f) f (dnf-insert c (dnf-drop-sup c f)))
dnf-norm-r : (r : Word → Word) (h : MonoW r) (f : DNF) → dnf-norm (dnf-r r f) ≡ dnf-r r (dnf-norm f)
dnf-norm-r r h lnil = λ i → lnil
dnf-norm-r r h (lcons c cs) =
  (λ i → dnf-add (conj-meet-r r h c lnil i) (dnf-norm-r r h cs i)) ∙ dnf-add-r r h (conj-meet c lnil) (dnf-norm cs)
dnf-eq-r : (r : Word → Word) (h : MonoW r) (f g : DNF) → dnf-eq (dnf-r r f) (dnf-r r g) ≡ dnf-eq f g
dnf-eq-r r h lnil lnil = λ i → true
dnf-eq-r r h lnil (lcons d ds) = λ i → false
dnf-eq-r r h (lcons c cs) lnil = λ i → false
dnf-eq-r r h (lcons c cs) (lcons d ds) = λ i → andB (conj-eq-r r h c d i) (dnf-eq-r r h cs ds i)
dnf-canon-r : (r : Word → Word) (h : MonoW r) (f : DNF) → dnf-canon (dnf-r r f) ≡ dnf-canon f
dnf-canon-r r h f = (λ i → dnf-eq (dnf-norm-r r h f i) (dnf-r r f)) ∙ dnf-eq-r r h (dnf-norm f) f
dnf-nonconst-r : (r : Word → Word) (f : DNF) → dnf-nonconst (dnf-r r f) ≡ dnf-nonconst f
dnf-nonconst-r r lnil = λ i → false
dnf-nonconst-r r (lcons lnil cs) = λ i → false
dnf-nonconst-r r (lcons (lcons l ls) cs) = λ i → true
-- equality and order of words at successors and zero (from their definitions by induction, std)
weq-ss : (a b : Word) → weq (%wsucc a) (%wsucc b) ≡ weq a b
weq-ss a b = pcat0 Bool (weq (%wsucc a) (%wsucc b)) (eqw a b) (weq a b) (sym (eqw≡weq (%wsucc a) (%wsucc b))) (eqw≡weq a b)
weq-0s : (b : Word) → weq #0 (%wsucc b) ≡ false
weq-0s b = sym (eqw≡weq #0 (%wsucc b))
weq-s0 : (a : Word) → weq (%wsucc a) #0 ≡ false
weq-s0 a = sym (eqw≡weq (%wsucc a) #0)
wlt-ss : (a b : Word) → wlt (%wsucc a) (%wsucc b) ≡ wlt a b
wlt-ss a b = pcat0 Bool (wlt (%wsucc a) (%wsucc b)) (ltw a b) (wlt a b) (sym (ltw≡wlt (%wsucc a) (%wsucc b))) (ltw≡wlt a b)
wlt-0s : (b : Word) → wlt #0 (%wsucc b) ≡ true
wlt-0s b = sym (ltw≡wlt #0 (%wsucc b))
wlt-s0 : (a : Word) → wlt (%wsucc a) #0 ≡ false
wlt-s0 a = sym (ltw≡wlt (%wsucc a) #0)
-- the successor is a monotone injection; so is a map extended by 0 ↦ 0 and n+1 ↦ r n + 1
mono-succ : (r : Word → Word) → MonoW r → MonoW (λ k → %wsucc (r k))
mono-succ r h =
  ((λ a b → pcat0 Bool (weq (%wsucc (r a)) (%wsucc (r b))) (weq (r a) (r b)) (weq a b) (weq-ss (r a) (r b)) (fst h a b)) ,
   (λ a b → pcat0 Bool (wlt (%wsucc (r a)) (%wsucc (r b))) (wlt (r a) (r b)) (wlt a b) (wlt-ss (r a) (r b)) (snd h a b)))
mono-id : MonoW (λ k → k)
mono-id = ((λ a b i → weq a b) , (λ a b i → wlt a b))
w-keep : (Word → Word) → Word → Word
w-keep r k = %welimP (λ v → Word) k #0 (λ n g → %wsucc (r n))
-- a property of a pair of words with its four cases at zero and successor
w-cases2 : (P : Word → Word → Type) → P #0 #0 → ((m : Word) → P #0 (%wsucc m)) → ((n : Word) → P (%wsucc n) #0) →
  ((n m : Word) → P (%wsucc n) (%wsucc m)) → (a b : Word) → P a b
w-cases2 P z0 zs sz ss a b =
  %welimP (λ v → (b : Word) → P v b) a
    (λ b → %welimP (λ v → P #0 v) b z0 (λ m g → zs m))
    (λ n g b → %welimP (λ v → P (%wsucc n) v) b (sz n) (λ m g' → ss n m)) b
mono-keep : (r : Word → Word) → MonoW r → MonoW (w-keep r)
mono-keep r h =
  (w-cases2 (λ a b → weq (w-keep r a) (w-keep r b) ≡ weq a b) (λ i → weq #0 #0)
     (λ m → pcat0 Bool (weq #0 (%wsucc (r m))) false (weq #0 (%wsucc m)) (weq-0s (r m)) (sym (weq-0s m)))
     (λ n → pcat0 Bool (weq (%wsucc (r n)) #0) false (weq (%wsucc n) #0) (weq-s0 (r n)) (sym (weq-s0 n)))
     (λ n m → pcat0 Bool (weq (%wsucc (r n)) (%wsucc (r m))) (weq n m) (weq (%wsucc n) (%wsucc m))
        (fst (mono-succ r h) n m) (sym (weq-ss n m))) ,
   w-cases2 (λ a b → wlt (w-keep r a) (w-keep r b) ≡ wlt a b) (λ i → wlt #0 #0)
     (λ m → pcat0 Bool (wlt #0 (%wsucc (r m))) true (wlt #0 (%wsucc m)) (wlt-0s (r m)) (sym (wlt-0s m)))
     (λ n → pcat0 Bool (wlt (%wsucc (r n)) #0) false (wlt (%wsucc n) #0) (wlt-s0 (r n)) (sym (wlt-s0 n)))
     (λ n m → pcat0 Bool (wlt (%wsucc (r n)) (%wsucc (r m))) (wlt n m) (wlt (%wsucc n) (%wsucc m))
        (snd (mono-succ r h) n m) (sym (wlt-ss n m))))
-- order-preserving embeddings of skeletons, as closed data: an embedding keeps or skips each entry of
-- the larger skeleton (ope-src), newest first; the kept ones are the smaller (ope-tgt). (Indexed by
-- the two skeletons, its clauses at wdone carry fording's transports, which do not reduce without
-- regularity, so ope-cube wdone would not be the identity judgmentally; tested 2026-11-12.)
data OPE = wdone | wskip (e : Entry) (w : OPE) | wkeep (e : Entry) (w : OPE)
ope-src : OPE → Lst Entry
ope-src wdone = lnil
ope-src (wskip e w) = lcons e (ope-src w)
ope-src (wkeep e w) = lcons e (ope-src w)
ope-tgt : OPE → Lst Entry
ope-tgt wdone = lnil
ope-tgt (wskip e w) = ope-tgt w
ope-tgt (wkeep e w) = lcons e (ope-tgt w)
-- its map of variable indices, a monotone injection
ope-var : OPE → Word → Word
ope-var wdone k = k
ope-var (wskip e w) k = %wsucc (ope-var w k)
ope-var (wkeep e w) k = w-keep (ope-var w) k
ope-mono : (w : OPE) → MonoW (ope-var w)
ope-mono wdone = mono-id
ope-mono (wskip e w) = mono-succ (ope-var w) (ope-mono w)
ope-mono (wkeep e w) = mono-keep (ope-var w) (ope-mono w)
-- renaming a form along an embedding; canonicity and non-constancy are kept
dnf-ren : OPE → DNF → DNF
dnf-ren w f = dnf-r (ope-var w) f
canon-ren : (w : OPE) (f : DNF) → isTrue (dnf-canon f) → isTrue (dnf-canon (dnf-ren w f))
canon-ren w f c = subst {lzero} {lzero} {Bool} {isTrue} (sym (dnf-canon-r (ope-var w) (ope-mono w) f)) c
nonconst-ren : (w : OPE) (f : DNF) → isTrue (dnf-nonconst f) → isTrue (dnf-nonconst (dnf-ren w f))
nonconst-ren w f c = subst {lzero} {lzero} {Bool} {isTrue} (sym (dnf-nonconst-r (ope-var w) f)) c

-- ---------------------------------------------------------------- P2.6e (4, first part): path application commutes with embeddings
-- (2026-11-12, next definitions (4); the identity and embedding laws of (2) are its instances) The
-- action of an embedding w : sk ⊆ sk' on cubes (ope-cube) is structural: a skipped dimension is a
-- degeneracy, a kept one is kept. Path application at a variable k over sk (diag-sk) commutes with it
-- at ope-var w k (diag-ren), by induction on w; the steps are diag-sk at a successor (diag-ty-s,
-- diag-dim-s), its naturality in the base (diag-nat) and that of ope-cube (ope-nat).
wsub-s1 : (a : Word) → wsub (%wsucc a) #1 ≡ a
wsub-s1 a =
  pcat0 Word (wsub (%wsucc a) #1) (subw a #0) a (sym (subw≡wsub (%wsucc a) #1))
    (%welimP (λ v → subw v #0 ≡ v) a (λ i → #0) (λ n h i → %wsucc n))
diag-ty-s : (sk : Lst Entry) (s : TyShape) (k : Word) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk) X) (diag-sk (lcons (e-ty s) sk) (%wsucc k) X c) (diag-sk sk k X c)
diag-ty-s sk s k X c = λ i →
  if weq-s0 k i then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (wsub-s1 k i) X c
diag-dim-s : (sk : Lst Entry) (k : Word) (X : Type 1) (c : Cube (suc (dims (lcons e-dim sk))) X) →
  PathP (λ i → Cube (suc (dims sk)) X) (diag-sk (lcons e-dim sk) (%wsucc k) X c)
    (diag-sk sk k (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))
diag-dim-s sk k X c = λ i →
  if weq-s0 k i then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c
  else diag-sk sk (wsub-s1 k i) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)
diag-nat : (sk : Lst Entry) (k : Word) (X Y : Type 1) (g : X → Y) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk) Y) (diag-sk sk k Y (cube-map (suc (dims sk)) X Y g c)) (cube-map (dims sk) X Y g (diag-sk sk k X c))
diag-nat lnil k X Y g c = λ i → g (fst c)
diag-nat (lcons (e-ty s) sk) k X Y g c =
  bool-elim1 (λ b → PathP (λ i → Cube (dims sk) Y)
                 (if b then cube-map (dims sk) (Line Y) Y (face0-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c)
                  else diag-sk sk (%wsub k #1) Y (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c))
                 (cube-map (dims sk) X Y g (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c)))
    (cube-comp2 (dims sk) (Line X) (Line Y) X Y (face0-l Y) (line-map X Y g) g (face0-l X) c (λ i → cube-map (dims sk) (Line X) Y (λ L → g (fst L)) c))
    (diag-nat sk (%wsub k #1) X Y g c) (weq k #0)
diag-nat (lcons e-dim sk) k X Y g c =
  bool-elim1 (λ b → PathP (λ i → Cube (suc (dims sk)) Y)
                 (if b then cube-map (dims sk) (Line (Line Y)) (Line Y) (diag-l Y) (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y g)) c)
                  else diag-sk sk (%wsub k #1) (Line Y) (cube-map (dims sk) (Line (Line Y)) (Line (Line Y)) (exch-l Y)
                         (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y g)) c)))
                 (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g)
                   (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c
                    else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))))
    (cube-comp2 (dims sk) (Line (Line X)) (Line (Line Y)) (Line X) (Line Y) (diag-l Y) (line-map (Line X) (Line Y) (line-map X Y g))
       (line-map X Y g) (diag-l X) c (λ i → cube-map (dims sk) (Line (Line X)) (Line Y) (λ Q → line-map X Y g (diag-l X Q)) c))
    (pcat (Cube (suc (dims sk)) Y)
       (diag-sk sk (%wsub k #1) (Line Y) (cube-map (dims sk) (Line (Line Y)) (Line (Line Y)) (exch-l Y)
          (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y g)) c)))
       (diag-sk sk (%wsub k #1) (Line Y) (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y g))
          (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
       (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
       (λ i → diag-sk sk (%wsub k #1) (Line Y)
          (cube-comp2 (dims sk) (Line (Line X)) (Line (Line Y)) (Line (Line X)) (Line (Line Y)) (exch-l Y) (line-map (Line X) (Line Y) (line-map X Y g))
             (line-map (Line X) (Line Y) (line-map X Y g)) (exch-l X) c
             (λ j → cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (λ Q → exch-l Y (line-map (Line X) (Line Y) (line-map X Y g) Q)) c) i))
       (diag-nat sk (%wsub k #1) (Line X) (Line Y) (line-map X Y g) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
    (weq k #0)
-- the action of an embedding on cubes: a skipped dimension degenerate, a kept one kept; one step,
-- by cases on the entry, for any action f of the rest (skip-cube, keep-cube), so that each lemma
-- below is one step for any f with the property, then an induction on the embedding
skip-cube : (e : Entry) (sk' : Lst Entry) (X : Type 1) → Cube (dims sk') X → Cube (dims (lcons e sk')) X
skip-cube (e-ty s) sk' X c = c
skip-cube e-dim sk' X c = cube-map (dims sk') X (Line X) (degen-l X) c
keep-cube : (e : Entry) (sk' sk : Lst Entry) → ((Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) →
  (X : Type 1) → Cube (dims (lcons e sk)) X → Cube (dims (lcons e sk')) X
keep-cube (e-ty s) sk' sk f X c = f X c
keep-cube e-dim sk' sk f X c = f (Line X) c
ope-cube : (w : OPE) (X : Type 1) → Cube (dims (ope-tgt w)) X → Cube (dims (ope-src w)) X
ope-cube wdone X c = c
ope-cube (wskip e w) X c = skip-cube e (ope-src w) X (ope-cube w X c)
ope-cube (wkeep e w) X c = keep-cube e (ope-src w) (ope-tgt w) (λ Y → ope-cube w Y) X c
-- naturality in the base, one step for an action f natural in it, then by induction on w
CubeNat : (sk' sk : Lst Entry) → ((Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → Type 2
CubeNat sk' sk f = (X Y : Type 1) (g : X → Y) (c : Cube (dims sk) X) →
  PathP (λ i → Cube (dims sk') Y) (f Y (cube-map (dims sk) X Y g c)) (cube-map (dims sk') X Y g (f X c))
skip-nat : (e : Entry) (sk' sk : Lst Entry) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → CubeNat sk' sk f →
  CubeNat (lcons e sk') sk (λ Y c → skip-cube e sk' Y (f Y c))
skip-nat (e-ty s) sk' sk f fn X Y g c = fn X Y g c
skip-nat e-dim sk' sk f fn X Y g c =
  pcat (Cube (dims sk') (Line Y))
    (cube-map (dims sk') Y (Line Y) (degen-l Y) (f Y (cube-map (dims sk) X Y g c)))
    (cube-map (dims sk') Y (Line Y) (degen-l Y) (cube-map (dims sk') X Y g (f X c)))
    (cube-map (dims sk') (Line X) (Line Y) (line-map X Y g) (cube-map (dims sk') X (Line X) (degen-l X) (f X c)))
    (λ i → cube-map (dims sk') Y (Line Y) (degen-l Y) (fn X Y g c i))
    (cube-comp2 (dims sk') X Y (Line X) (Line Y) (degen-l Y) g (line-map X Y g) (degen-l X) (f X c)
       (λ i → cube-map (dims sk') X (Line Y) (λ x → degen-l Y (g x)) (f X c)))
keep-nat : (e : Entry) (sk' sk : Lst Entry) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → CubeNat sk' sk f →
  CubeNat (lcons e sk') (lcons e sk) (keep-cube e sk' sk f)
keep-nat (e-ty s) sk' sk f fn X Y g c = fn X Y g c
keep-nat e-dim sk' sk f fn X Y g c = fn (Line X) (Line Y) (line-map X Y g) c
ope-nat : (w : OPE) → CubeNat (ope-src w) (ope-tgt w) (ope-cube w)
ope-nat wdone X Y g c = λ i → g c
ope-nat (wskip e w) X Y g c = skip-nat e (ope-src w) (ope-tgt w) (ope-cube w) (ope-nat w) X Y g c
ope-nat (wkeep e w) X Y g c = keep-nat e (ope-src w) (ope-tgt w) (ope-cube w) (ope-nat w) X Y g c
-- path application at a variable commutes with an embedding's action: one step for an action f
-- natural in the base with variable map r, then by induction on w
DiagRen : (sk' sk : Lst Entry) → (Word → Word) → ((Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → Type 2
DiagRen sk' sk r f = (k : Word) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk') X) (diag-sk sk' (r k) X (f (Line X) c)) (f X (diag-sk sk k X c))
skip-diag : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) →
  DiagRen sk' sk r f → DiagRen (lcons e sk') sk (λ k → %wsucc (r k)) (λ Y c → skip-cube e sk' Y (f Y c))
skip-diag (e-ty s) sk' sk r f ih k X c =
  pcat (Cube (dims sk') X) (diag-sk (lcons (e-ty s) sk') (%wsucc (r k)) X (f (Line X) c))
    (diag-sk sk' (r k) X (f (Line X) c)) (f X (diag-sk sk k X c))
    (diag-ty-s sk' s (r k) X (f (Line X) c)) (ih k X c)
skip-diag e-dim sk' sk r f ih k X c =
  pcat (Cube (suc (dims sk')) X)
    (diag-sk (lcons e-dim sk') (%wsucc (r k)) X (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (f (Line X) c)))
    (diag-sk sk' (r k) (Line X) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X)
       (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (f (Line X) c))))
    (cube-map (dims sk') X (Line X) (degen-l X) (f X (diag-sk sk k X c)))
    (diag-dim-s sk' (r k) X (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (f (Line X) c)))
    (pcat (Cube (suc (dims sk')) X)
       (diag-sk sk' (r k) (Line X) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X)
          (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (f (Line X) c))))
       (diag-sk sk' (r k) (Line X) (cube-map (dims sk') (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) (f (Line X) c)))
       (cube-map (dims sk') X (Line X) (degen-l X) (f X (diag-sk sk k X c)))
       (λ i → diag-sk sk' (r k) (Line X)
          (cube-comp (dims sk') (Line X) (Line (Line X)) (Line (Line X)) (exch-l X) (degen-l (Line X)) (f (Line X) c) i))
       (pcat (Cube (suc (dims sk')) X)
          (diag-sk sk' (r k) (Line X) (cube-map (dims sk') (Line X) (Line (Line X)) (line-map X (Line X) (degen-l X)) (f (Line X) c)))
          (cube-map (dims sk') X (Line X) (degen-l X) (diag-sk sk' (r k) X (f (Line X) c)))
          (cube-map (dims sk') X (Line X) (degen-l X) (f X (diag-sk sk k X c)))
          (diag-nat sk' (r k) X (Line X) (degen-l X) (f (Line X) c))
          (λ i → cube-map (dims sk') X (Line X) (degen-l X) (ih k X c i))))
keep-diag : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) →
  CubeNat sk' sk f → DiagRen sk' sk r f → DiagRen (lcons e sk') (lcons e sk) (w-keep r) (keep-cube e sk' sk f)
keep-diag (e-ty s) sk' sk r f fn ih k X c =
  %welimP (λ v → PathP (λ i → Cube (dims sk') X) (diag-sk (lcons (e-ty s) sk') (w-keep r v) X (f (Line X) c))
                    (f X (diag-sk (lcons (e-ty s) sk) v X c))) k
    (psym (Cube (dims sk') X) (f X (cube-map (dims sk) (Line X) X (face0-l X) c))
       (cube-map (dims sk') (Line X) X (face0-l X) (f (Line X) c)) (fn (Line X) X (face0-l X) c))
    (λ n h → pcat (Cube (dims sk') X) (diag-sk (lcons (e-ty s) sk') (%wsucc (r n)) X (f (Line X) c))
       (f X (diag-sk sk n X c)) (f X (diag-sk (lcons (e-ty s) sk) (%wsucc n) X c))
       (skip-diag (e-ty s) sk' sk r f ih n X c)
       (λ i → f X (diag-ty-s sk s n X c (~ i))))
keep-diag e-dim sk' sk r f fn ih k X c =
  %welimP (λ v → PathP (λ i → Cube (suc (dims sk')) X) (diag-sk (lcons e-dim sk') (w-keep r v) X (f (Line (Line X)) c))
                    (f (Line X) (diag-sk (lcons e-dim sk) v X c))) k
    (psym (Cube (suc (dims sk')) X) (f (Line X) (cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c))
       (cube-map (dims sk') (Line (Line X)) (Line X) (diag-l X) (f (Line (Line X)) c)) (fn (Line (Line X)) (Line X) (diag-l X) c))
    (λ n h → pcat (Cube (suc (dims sk')) X) (diag-sk (lcons e-dim sk') (%wsucc (r n)) X (f (Line (Line X)) c))
       (f (Line X) (diag-sk sk n (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
       (f (Line X) (diag-sk (lcons e-dim sk) (%wsucc n) X c))
       (pcat (Cube (suc (dims sk')) X) (diag-sk (lcons e-dim sk') (%wsucc (r n)) X (f (Line (Line X)) c))
          (diag-sk sk' (r n) (Line X) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X) (f (Line (Line X)) c)))
          (f (Line X) (diag-sk sk n (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
          (diag-dim-s sk' (r n) X (f (Line (Line X)) c))
          (pcat (Cube (suc (dims sk')) X)
             (diag-sk sk' (r n) (Line X) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X) (f (Line (Line X)) c)))
             (diag-sk sk' (r n) (Line X) (f (Line (Line X)) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
             (f (Line X) (diag-sk sk n (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
             (λ i → diag-sk sk' (r n) (Line X) (fn (Line (Line X)) (Line (Line X)) (exch-l X) c (~ i)))
             (ih n (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))))
       (λ i → f (Line X) (diag-dim-s sk n X c (~ i))))
diag-ren : (w : OPE) → DiagRen (ope-src w) (ope-tgt w) (ope-var w) (ope-cube w)
diag-ren wdone k X c = λ i → fst c
diag-ren (wskip e w) k X c = skip-diag e (ope-src w) (ope-tgt w) (ope-var w) (ope-cube w) (diag-ren w) k X c
diag-ren (wkeep e w) k X c = keep-diag e (ope-src w) (ope-tgt w) (ope-var w) (ope-cube w) (ope-nat w) (diag-ren w) k X c
-- path application at a renamed form commutes with an embedding's action (next definitions (4),
-- papp-ren), by the recursion of papp-cube: under a connection the skeleton has one more dimension
-- in front (kept), and the index of a literal is offset by o; hr says the embedding at hand renames
-- an offset index as r does the form's
wadd-0 : (k : Word) → %wadd k #0 ≡ k
wadd-0 k = sym (plusw≡wadd k #0)
wadd-s : (k o : Word) → %wadd k (%wsucc o) ≡ %wsucc (%wadd k o)
wadd-s k o = pcat0 Word (%wadd k (%wsucc o)) (%wsucc (plusw k o)) (%wsucc (%wadd k o)) (sym (plusw≡wadd k (%wsucc o))) (λ i → %wsucc (plusw≡wadd k o i))
-- (2026-11-12, (4d)) the offset hypothesis for a renaming r of dimension variables (RenAtC: r at k
-- offset by o is r0 at k offset by o), at offset 0 (renatc-0) and kept once more (renatc-keep);
-- an embedding's is its renaming's (RenAt, renat-0, renat-keep, since ope-var (wkeep e w) is
-- w-keep (ope-var w) judgmentally)
RenAtC : (Word → Word) → (Word → Word) → Word → Type
RenAtC r r0 o = (k : Word) → r (%wadd k o) ≡ %wadd (r0 k) o
renatc-0 : (r : Word → Word) → RenAtC r r #0
renatc-0 r k = pcat0 Word (r (%wadd k #0)) (r k) (%wadd (r k) #0) (λ i → r (wadd-0 k i)) (sym (wadd-0 (r k)))
renatc-keep : (r r0 : Word → Word) (o : Word) → RenAtC r r0 o → RenAtC (w-keep r) r0 (%wsucc o)
renatc-keep r r0 o hr k =
  pcat0 Word (w-keep r (%wadd k (%wsucc o))) (%wsucc (%wadd (r0 k) o)) (%wadd (r0 k) (%wsucc o))
    (pcat0 Word (w-keep r (%wadd k (%wsucc o))) (%wsucc (r (%wadd k o))) (%wsucc (%wadd (r0 k) o))
       (λ i → w-keep r (wadd-s k o i)) (λ i → %wsucc (hr k i)))
    (sym (wadd-s (r0 k) o))
RenAt : OPE → (Word → Word) → Word → Type
RenAt w r o = RenAtC (ope-var w) r o
renat-keep : (w : OPE) (r : Word → Word) (o : Word) → RenAt w r o → RenAt (wkeep e-dim w) r (%wsucc o)
renat-keep w r o hr = renatc-keep (ope-var w) r o hr
renat-0 : (w : OPE) → RenAt w (ope-var w) #0
renat-0 w = renatc-0 (ope-var w)
papp-lit-ren : (w : OPE) (r : Word → Word) (o : Word) → RenAt w r o → (l : Lit) (X : Type 1) (c : Cube (suc (dims (ope-tgt w))) X) →
  PathP (λ i → Cube (dims (ope-src w)) X) (papp-lit (ope-src w) X o (lit-r r l) (ope-cube w (Line X) c)) (ope-cube w X (papp-lit (ope-tgt w) X o l c))
papp-lit-ren w r o hr l X c =
  bool-elim1 (λ b → PathP (λ i → Cube (dims (ope-src w)) X)
                 (if b then diag-sk (ope-src w) (%wadd (r (fst l)) o) X (ope-cube w (Line X) c)
                  else diag-sk (ope-src w) (%wadd (r (fst l)) o) X (cube-map (dims (ope-src w)) (Line X) (Line X) (rev-l X) (ope-cube w (Line X) c)))
                 (ope-cube w X (if b then diag-sk (ope-tgt w) (%wadd (fst l) o) X c
                                else diag-sk (ope-tgt w) (%wadd (fst l) o) X (cube-map (dims (ope-tgt w)) (Line X) (Line X) (rev-l X) c))))
    (pcat (Cube (dims (ope-src w)) X) (diag-sk (ope-src w) (%wadd (r (fst l)) o) X (ope-cube w (Line X) c))
       (diag-sk (ope-src w) (ope-var w (%wadd (fst l) o)) X (ope-cube w (Line X) c)) (ope-cube w X (diag-sk (ope-tgt w) (%wadd (fst l) o) X c))
       (λ i → diag-sk (ope-src w) (hr (fst l) (~ i)) X (ope-cube w (Line X) c)) (diag-ren w (%wadd (fst l) o) X c))
    (pcat (Cube (dims (ope-src w)) X)
       (diag-sk (ope-src w) (%wadd (r (fst l)) o) X (cube-map (dims (ope-src w)) (Line X) (Line X) (rev-l X) (ope-cube w (Line X) c)))
       (diag-sk (ope-src w) (ope-var w (%wadd (fst l) o)) X (ope-cube w (Line X) (cube-map (dims (ope-tgt w)) (Line X) (Line X) (rev-l X) c)))
       (ope-cube w X (diag-sk (ope-tgt w) (%wadd (fst l) o) X (cube-map (dims (ope-tgt w)) (Line X) (Line X) (rev-l X) c)))
       (λ i → diag-sk (ope-src w) (hr (fst l) (~ i)) X (ope-nat w (Line X) (Line X) (rev-l X) c (~ i)))
       (diag-ren w (%wadd (fst l) o) X (cube-map (dims (ope-tgt w)) (Line X) (Line X) (rev-l X) c)))
    (snd l)
papp-conj-from-ren : (w : OPE) (r : Word → Word) (o : Word) → RenAt w r o → (l : Lit) (ms : Conj) (X : Type 1) (c : Cube (suc (dims (ope-tgt w))) X) →
  PathP (λ i → Cube (dims (ope-src w)) X)
    (papp-conj-from (ope-src w) X o (lit-r r l) (conj-r r ms) (ope-cube w (Line X) c)) (ope-cube w X (papp-conj-from (ope-tgt w) X o l ms c))
papp-conj-from-ren w r o hr l lnil X c = papp-lit-ren w r o hr l X c
papp-conj-from-ren w r o hr l (lcons m ms) X c =
  pcat (Cube (dims (ope-src w)) X)
    (papp-lit (ope-src w) X o (lit-r r l) (papp-conj-from (lcons e-dim (ope-src w)) X (%wsucc o) (lit-r r m) (conj-r r ms)
       (cube-map (dims (ope-src w)) (Line X) (Line (Line X)) (meet-l X) (ope-cube w (Line X) c))))
    (papp-lit (ope-src w) X o (lit-r r l) (ope-cube w (Line X)
       (papp-conj-from (lcons e-dim (ope-tgt w)) X (%wsucc o) m ms (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (meet-l X) c))))
    (ope-cube w X (papp-conj-from (ope-tgt w) X o l (lcons m ms) c))
    (λ i → papp-lit (ope-src w) X o (lit-r r l)
       (pcat (Cube (suc (dims (ope-src w))) X)
          (papp-conj-from (lcons e-dim (ope-src w)) X (%wsucc o) (lit-r r m) (conj-r r ms)
             (cube-map (dims (ope-src w)) (Line X) (Line (Line X)) (meet-l X) (ope-cube w (Line X) c)))
          (papp-conj-from (lcons e-dim (ope-src w)) X (%wsucc o) (lit-r r m) (conj-r r ms)
             (ope-cube w (Line (Line X)) (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (meet-l X) c)))
          (ope-cube w (Line X) (papp-conj-from (lcons e-dim (ope-tgt w)) X (%wsucc o) m ms (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (meet-l X) c)))
          (λ j → papp-conj-from (lcons e-dim (ope-src w)) X (%wsucc o) (lit-r r m) (conj-r r ms) (ope-nat w (Line X) (Line (Line X)) (meet-l X) c (~ j)))
          (papp-conj-from-ren (wkeep e-dim w) r (%wsucc o) (renat-keep w r o hr) m ms X (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (meet-l X) c)) i))
    (papp-lit-ren w r o hr l X (papp-conj-from (lcons e-dim (ope-tgt w)) X (%wsucc o) m ms (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (meet-l X) c)))
papp-conj-ren : (w : OPE) (r : Word → Word) (o : Word) → RenAt w r o → (cj : Conj) (X : Type 1) (c : Cube (suc (dims (ope-tgt w))) X) →
  PathP (λ i → Cube (dims (ope-src w)) X) (papp-conj (ope-src w) X o (conj-r r cj) (ope-cube w (Line X) c)) (ope-cube w X (papp-conj (ope-tgt w) X o cj c))
papp-conj-ren w r o hr lnil X c =
  psym (Cube (dims (ope-src w)) X) (ope-cube w X (cube-map (dims (ope-tgt w)) (Line X) X (face1-l X) c))
    (cube-map (dims (ope-src w)) (Line X) X (face1-l X) (ope-cube w (Line X) c)) (ope-nat w (Line X) X (face1-l X) c)
papp-conj-ren w r o hr (lcons l ls) X c = papp-conj-from-ren w r o hr l ls X c
papp-dnf-from-ren : (w : OPE) (r : Word → Word) (o : Word) → RenAt w r o → (cj : Conj) (ds : DNF) (X : Type 1) (c : Cube (suc (dims (ope-tgt w))) X) →
  PathP (λ i → Cube (dims (ope-src w)) X)
    (papp-dnf-from (ope-src w) X o (conj-r r cj) (dnf-r r ds) (ope-cube w (Line X) c)) (ope-cube w X (papp-dnf-from (ope-tgt w) X o cj ds c))
papp-dnf-from-ren w r o hr cj lnil X c = papp-conj-ren w r o hr cj X c
papp-dnf-from-ren w r o hr cj (lcons d ds) X c =
  pcat (Cube (dims (ope-src w)) X)
    (papp-conj (ope-src w) X o (conj-r r cj) (papp-dnf-from (lcons e-dim (ope-src w)) X (%wsucc o) (conj-r r d) (dnf-r r ds)
       (cube-map (dims (ope-src w)) (Line X) (Line (Line X)) (join-l X) (ope-cube w (Line X) c))))
    (papp-conj (ope-src w) X o (conj-r r cj) (ope-cube w (Line X)
       (papp-dnf-from (lcons e-dim (ope-tgt w)) X (%wsucc o) d ds (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (join-l X) c))))
    (ope-cube w X (papp-dnf-from (ope-tgt w) X o cj (lcons d ds) c))
    (λ i → papp-conj (ope-src w) X o (conj-r r cj)
       (pcat (Cube (suc (dims (ope-src w))) X)
          (papp-dnf-from (lcons e-dim (ope-src w)) X (%wsucc o) (conj-r r d) (dnf-r r ds)
             (cube-map (dims (ope-src w)) (Line X) (Line (Line X)) (join-l X) (ope-cube w (Line X) c)))
          (papp-dnf-from (lcons e-dim (ope-src w)) X (%wsucc o) (conj-r r d) (dnf-r r ds)
             (ope-cube w (Line (Line X)) (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (join-l X) c)))
          (ope-cube w (Line X) (papp-dnf-from (lcons e-dim (ope-tgt w)) X (%wsucc o) d ds (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (join-l X) c)))
          (λ j → papp-dnf-from (lcons e-dim (ope-src w)) X (%wsucc o) (conj-r r d) (dnf-r r ds) (ope-nat w (Line X) (Line (Line X)) (join-l X) c (~ j)))
          (papp-dnf-from-ren (wkeep e-dim w) r (%wsucc o) (renat-keep w r o hr) d ds X (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (join-l X) c)) i))
    (papp-conj-ren w r o hr cj X (papp-dnf-from (lcons e-dim (ope-tgt w)) X (%wsucc o) d ds (cube-map (dims (ope-tgt w)) (Line X) (Line (Line X)) (join-l X) c)))
papp-ren : (w : OPE) (f : DNF) (X : Type 1) (c : Cube (suc (dims (ope-tgt w))) X) →
  PathP (λ i → Cube (dims (ope-src w)) X) (papp-cube (ope-src w) X (dnf-ren w f) (ope-cube w (Line X) c)) (ope-cube w X (papp-cube (ope-tgt w) X f c))
papp-ren w lnil X c =
  psym (Cube (dims (ope-src w)) X) (ope-cube w X (cube-map (dims (ope-tgt w)) (Line X) X (face0-l X) c))
    (cube-map (dims (ope-src w)) (Line X) X (face0-l X) (ope-cube w (Line X) c)) (ope-nat w (Line X) X (face0-l X) c)
papp-ren w (lcons cj cs) X c = papp-dnf-from-ren w (ope-var w) #0 (renat-0 w) cj cs X c

-- ---------------------------------------------------------------- P2.6e (2, first part): the dimension parts of worlds and of the identity
-- (2026-11-12, next definitions (2)) The dimension part sending dimension k of sk to the variable r k
-- of sk' (cmap-of). Its action: with a skipped entry in front of sk' and r one further (cmap-skip:
-- weakening by a type is the same cube, by a dimension the degenerate one), with a kept entry
-- (cmap-keep), the identity's (cmap-id) and an embedding's (cmap-ope: ope-cube).
cmap-of : (sk' sk : Lst Entry) → (Word → Word) → CMap sk' sk
cmap-of sk' lnil r = unit
cmap-of sk' (lcons (e-ty a) sk) r = cmap-of sk' sk (λ k → r (%wsucc k))
cmap-of sk' (lcons e-dim sk) r = (cmap-of sk' sk (λ k → r (%wsucc k)) , lcons (lcons (r #0 , true) lnil) lnil)
const-map : (n : Nat) (X Y : Type 1) (g : X → Y) (x : X) → PathP (λ i → Cube n Y) (cube-map n X Y g (cube-const n X x)) (cube-const n Y (g x))
const-map zero X Y g x = λ i → g x
const-map (suc n) X Y g x = const-map n (Line X) (Line Y) (line-map X Y g) (degen-l X x)
skip-const : (e : Entry) (sk' : Lst Entry) (X : Type 1) (x : X) →
  PathP (λ i → Cube (dims (lcons e sk')) X) (cube-const (dims (lcons e sk')) X x) (skip-cube e sk' X (cube-const (dims sk') X x))
skip-const (e-ty s) sk' X x = λ i → cube-const (dims sk') X x
skip-const e-dim sk' X x =
  psym (Cube (dims sk') (Line X)) (cube-map (dims sk') X (Line X) (degen-l X) (cube-const (dims sk') X x)) (cube-const (dims sk') (Line X) (degen-l X x))
    (const-map (dims sk') X (Line X) (degen-l X) x)
-- path application at a variable is diag-sk there
papp-var : (sk : Lst Entry) (X : Type 1) (k : Word) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk) X) (papp-cube sk X (lcons (lcons (k , true) lnil) lnil) c) (diag-sk sk k X c)
papp-var sk X k c = λ i → diag-sk sk (wadd-0 k i) X c
cmap-skip : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) (X : Type 1) (c : Cube (dims sk) X) →
  PathP (λ i → Cube (dims (lcons e sk')) X)
    (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r k))) X c) (skip-cube e sk' X (cmap-cube sk' sk (cmap-of sk' sk r) X c))
cmap-skip e sk' lnil r X c = skip-const e sk' X c
cmap-skip e sk' (lcons (e-ty a) sk) r X c = cmap-skip e sk' sk (λ k → r (%wsucc k)) X c
cmap-skip e sk' (lcons e-dim sk) r X c =
  pcat (Cube (dims (lcons e sk')) X)
    (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil)
       (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r (%wsucc k)))) (Line X) c))
    (diag-sk (lcons e sk') (%wsucc (r #0)) X (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
    (skip-cube e sk' X (papp-cube sk' X (lcons (lcons (r #0 , true) lnil) lnil) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
    (pcat (Cube (dims (lcons e sk')) X)
       (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil)
          (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r (%wsucc k)))) (Line X) c))
       (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil)
          (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (diag-sk (lcons e sk') (%wsucc (r #0)) X (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (λ i → papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil) (cmap-skip e sk' sk (λ k → r (%wsucc k)) (Line X) c i))
       (papp-var (lcons e sk') X (%wsucc (r #0)) (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c))))
    (pcat (Cube (dims (lcons e sk')) X)
       (diag-sk (lcons e sk') (%wsucc (r #0)) X (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (skip-cube e sk' X (diag-sk sk' (r #0) X (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (skip-cube e sk' X (papp-cube sk' X (lcons (lcons (r #0 , true) lnil) lnil) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
       (skip-diag e sk' sk' (λ k → k) (λ Y d → d) (λ k Y d i → diag-sk sk' k Y d) (r #0) X (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c))
       (λ i → skip-cube e sk' X (papp-var sk' X (r #0) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c) (~ i))))
cmap-keep : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) (X : Type 1) (c : Cube (dims (lcons e sk)) X) →
  PathP (λ i → Cube (dims (lcons e sk')) X)
    (cmap-cube (lcons e sk') (lcons e sk) (cmap-of (lcons e sk') (lcons e sk) (w-keep r)) X c) (keep-cube e sk' sk (λ Y → cmap-cube sk' sk (cmap-of sk' sk r) Y) X c)
cmap-keep (e-ty s) sk' sk r X c = cmap-skip (e-ty s) sk' sk r X c
cmap-keep e-dim sk' sk r X c =
  pcat (Cube (suc (dims sk')) X)
    (papp-cube (lcons e-dim sk') X (lcons (lcons (#0 , true) lnil) lnil)
       (cmap-cube (lcons e-dim sk') sk (cmap-of (lcons e-dim sk') sk (λ k → %wsucc (r k))) (Line X) c))
    (diag-sk (lcons e-dim sk') #0 X (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)))
    (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)
    (pcat (Cube (suc (dims sk')) X)
       (papp-cube (lcons e-dim sk') X (lcons (lcons (#0 , true) lnil) lnil)
          (cmap-cube (lcons e-dim sk') sk (cmap-of (lcons e-dim sk') sk (λ k → %wsucc (r k))) (Line X) c))
       (papp-cube (lcons e-dim sk') X (lcons (lcons (#0 , true) lnil) lnil)
          (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)))
       (diag-sk (lcons e-dim sk') #0 X (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)))
       (λ i → papp-cube (lcons e-dim sk') X (lcons (lcons (#0 , true) lnil) lnil) (cmap-skip e-dim sk' sk r (Line X) c i))
       (papp-var (lcons e-dim sk') X #0 (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c))))
    (pcat (Cube (suc (dims sk')) X)
       (cube-map (dims sk') (Line (Line X)) (Line X) (diag-l X) (cube-map (dims sk') (Line X) (Line (Line X)) (degen-l (Line X)) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)))
       (cube-map (dims sk') (Line X) (Line X) (λ L → L) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c))
       (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)
       (cube-comp (dims sk') (Line X) (Line (Line X)) (Line X) (diag-l X) (degen-l (Line X)) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c))
       (cube-id (dims sk') (Line X) (cmap-cube sk' sk (cmap-of sk' sk r) (Line X) c)))
cmap-id : (sk : Lst Entry) (X : Type 1) (c : Cube (dims sk) X) → PathP (λ i → Cube (dims sk) X) (cmap-cube sk sk (cmap-of sk sk (λ k → k)) X c) c
cmap-id lnil X c = λ i → c
cmap-id (lcons (e-ty s) sk) X c =
  pcat (Cube (dims sk) X) (cmap-cube (lcons (e-ty s) sk) (lcons (e-ty s) sk) (cmap-of (lcons (e-ty s) sk) (lcons (e-ty s) sk) (λ k → k)) X c)
    (cmap-cube sk sk (cmap-of sk sk (λ k → k)) X c) c (cmap-skip (e-ty s) sk sk (λ k → k) X c) (cmap-id sk X c)
cmap-id (lcons e-dim sk) X c =
  pcat (Cube (suc (dims sk)) X) (cmap-cube (lcons e-dim sk) (lcons e-dim sk) (cmap-of (lcons e-dim sk) (lcons e-dim sk) (λ k → k)) X c)
    (cmap-cube sk sk (cmap-of sk sk (λ k → k)) (Line X) c) c (cmap-keep e-dim sk sk (λ k → k) X c) (cmap-id sk (Line X) c)
cmap-ope : (w : OPE) (X : Type 1) (c : Cube (dims (ope-tgt w)) X) →
  PathP (λ i → Cube (dims (ope-src w)) X) (cmap-cube (ope-src w) (ope-tgt w) (cmap-of (ope-src w) (ope-tgt w) (ope-var w)) X c) (ope-cube w X c)
cmap-ope wdone X c = λ i → c
cmap-ope (wskip e w) X c =
  pcat (Cube (dims (lcons e (ope-src w))) X) (cmap-cube (lcons e (ope-src w)) (ope-tgt w) (cmap-of (lcons e (ope-src w)) (ope-tgt w) (λ k → %wsucc (ope-var w k))) X c)
    (skip-cube e (ope-src w) X (cmap-cube (ope-src w) (ope-tgt w) (cmap-of (ope-src w) (ope-tgt w) (ope-var w)) X c)) (ope-cube (wskip e w) X c)
    (cmap-skip e (ope-src w) (ope-tgt w) (ope-var w) X c) (λ i → skip-cube e (ope-src w) X (cmap-ope w X c i))
cmap-ope (wkeep e w) X c =
  pcat (Cube (dims (lcons e (ope-src w))) X)
    (cmap-cube (lcons e (ope-src w)) (lcons e (ope-tgt w)) (cmap-of (lcons e (ope-src w)) (lcons e (ope-tgt w)) (w-keep (ope-var w))) X c)
    (keep-cube e (ope-src w) (ope-tgt w) (λ Y → cmap-cube (ope-src w) (ope-tgt w) (cmap-of (ope-src w) (ope-tgt w) (ope-var w)) Y) X c) (ope-cube (wkeep e w) X c)
    (cmap-keep e (ope-src w) (ope-tgt w) (ope-var w) X c) (λ i → keep-cube e (ope-src w) (ope-tgt w) (λ Y d → cmap-ope w Y d i) X c)

-- ---------------------------------------------------------------- P2.6e (2d, first part): the dependent forms over cubes
-- (2026-11-12, next definitions (2d)) subM acts on meanings by cmap-d, so each law of (2) and (4) on
-- cubes is needed on cubes over cubes: a PathP over the law on the base, by the same recursion.
-- Composites of paths over composites of base paths (pcat-d, psym-d; pcat-d by the filler of the base
-- pcat), reindexing along composites (reidx-comp, reidx-id, cube-comp2-d); the action of an embedding on
-- cubes over cubes (skip-d, keep-d, ope-cube-d: a skipped dimension degen-o, a kept one kept), its
-- naturality (ope-nat-d), diag-sk-d at a successor (diag-ty-s-d, diag-dim-s-d) and in the base
pcat-d : (A : Type 1) (B : A → Type 1) (x y z : A) (p : PathP (λ i → A) x y) (q : PathP (λ i → A) y z)
  (bx : B x) (b1 : B y) (bz : B z) → PathP (λ i → B (p i)) bx b1 → PathP (λ i → B (q i)) b1 bz →
  PathP (λ i → B (pcat A x y z p q i)) bx bz
pcat-d A B x y z p q bx b1 bz P Q = λ i →
  comp (λ j → B (comp (λ k → A) (λ k → [ i = 0 ↦ x , i = 1 ↦ q (j ∧ k) , j = 0 ↦ p i ]) (p i)))
    (λ j → [ i = 0 ↦ bx , i = 1 ↦ Q j ]) (P i)
psym-d : (A : Type 1) (B : A → Type 1) (x y : A) (p : PathP (λ i → A) x y) (bx : B x) (b1 : B y) →
  PathP (λ i → B (p i)) bx b1 → PathP (λ i → B (psym A x y p i)) b1 bx
psym-d A B x y p bx b1 P = λ i → P (~ i)
reidx-comp : (n : Nat) (X Y Z : Type 1) (F : X → Type 1) (G : Y → Type 1) (H : Z → Type 1) (f : Y → Z) (fd : (y : Y) → G y → H (f y))
  (g : X → Y) (gd : (x : X) → F x → G (g x)) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n Z H (cube-comp n X Y Z f g c i))
    (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d)) (dcube-reidx n X Z F H (λ x → f (g x)) (λ x y → fd (g x) (gd x y)) c d)
reidx-comp zero X Y Z F G H f fd g gd c d = λ i → fd (g c) (gd c d)
reidx-comp (suc n) X Y Z F G H f fd g gd c d =
  reidx-comp n (Line X) (Line Y) (Line Z) (LineO X F) (LineO Y G) (LineO Z H) (line-map Y Z f) (lineo-reidx Y Z G H f fd)
    (line-map X Y g) (lineo-reidx X Y F G g gd) c d
reidx-id : (n : Nat) (X : Type 1) (F : X → Type 1) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n X F (cube-id n X c i)) (dcube-reidx n X X F F (λ x → x) (λ x y → y) c d) d
reidx-id zero X F c d = λ i → d
reidx-id (suc n) X F c d = reidx-id n (Line X) (LineO X F) c d
cube-comp2-d : (n : Nat) (X Y Y' Z : Type 1) (F : X → Type 1) (G : Y → Type 1) (G' : Y' → Type 1) (H : Z → Type 1)
  (f : Y → Z) (fd : (y : Y) → G y → H (f y)) (g : X → Y) (gd : (x : X) → F x → G (g x))
  (f' : Y' → Z) (fd' : (y : Y') → G' y → H (f' y)) (g' : X → Y') (gd' : (x : X) → F x → G' (g' x)) (c : Cube n X) (d : DCube n X F c)
  (p : PathP (λ i → Cube n Z) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)) →
  PathP (λ i → DCube n Z H (p i)) (dcube-reidx n X Z F H (λ x → f (g x)) (λ x y → fd (g x) (gd x y)) c d)
    (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d) →
  PathP (λ i → DCube n Z H (cube-comp2 n X Y Y' Z f g f' g' c p i))
    (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d))
    (dcube-reidx n Y' Z G' H f' fd' (cube-map n X Y' g' c) (dcube-reidx n X Y' F G' g' gd' c d))
cube-comp2-d n X Y Y' Z F G G' H f fd g gd f' fd' g' gd' c d p pd =
  pcat-d (Cube n Z) (DCube n Z H) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-map n Y' Z f' (cube-map n X Y' g' c))
    (pcat (Cube n Z) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)
       (cube-comp n X Y Z f g c) p)
    (psym (Cube n Z) (cube-map n Y' Z f' (cube-map n X Y' g' c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-comp n X Y' Z f' g' c))
    (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d))
    (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d)
    (dcube-reidx n Y' Z G' H f' fd' (cube-map n X Y' g' c) (dcube-reidx n X Y' F G' g' gd' c d))
    (pcat-d (Cube n Z) (DCube n Z H) (cube-map n Y Z f (cube-map n X Y g c)) (cube-map n X Z (λ x → f (g x)) c) (cube-map n X Z (λ x → f' (g' x)) c)
       (cube-comp n X Y Z f g c) p
       (dcube-reidx n Y Z G H f fd (cube-map n X Y g c) (dcube-reidx n X Y F G g gd c d))
       (dcube-reidx n X Z F H (λ x → f (g x)) (λ x y → fd (g x) (gd x y)) c d)
       (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d)
       (reidx-comp n X Y Z F G H f fd g gd c d) pd)
    (psym-d (Cube n Z) (DCube n Z H) (cube-map n Y' Z f' (cube-map n X Y' g' c)) (cube-map n X Z (λ x → f' (g' x)) c) (cube-comp n X Y' Z f' g' c)
       (dcube-reidx n Y' Z G' H f' fd' (cube-map n X Y' g' c) (dcube-reidx n X Y' F G' g' gd' c d))
       (dcube-reidx n X Z F H (λ x → f' (g' x)) (λ x y → fd' (g' x) (gd' x y)) c d)
       (reidx-comp n X Y' Z F G' H f' fd' g' gd' c d))
skip-d : (e : Entry) (sk' : Lst Entry) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk') X) →
  DCube (dims sk') X F c → DCube (dims (lcons e sk')) X F (skip-cube e sk' X c)
skip-d (e-ty s) sk' X F c d = d
skip-d e-dim sk' X F c d = dcube-reidx (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) c d
CubeD : (sk' sk : Lst Entry) → ((Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → Type 2
CubeD sk' sk f = (Y : Type 1) (G : Y → Type 1) (c : Cube (dims sk) Y) → DCube (dims sk) Y G c → DCube (dims sk') Y G (f Y c)
keep-d : (e : Entry) (sk' sk : Lst Entry) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → CubeD sk' sk f →
  CubeD (lcons e sk') (lcons e sk) (keep-cube e sk' sk f)
keep-d (e-ty s) sk' sk f fd X F c d = fd X F c d
keep-d e-dim sk' sk f fd X F c d = fd (Line X) (LineO X F) c d
ope-cube-d : (w : OPE) → CubeD (ope-src w) (ope-tgt w) (ope-cube w)
ope-cube-d wdone X F c d = d
ope-cube-d (wskip e w) X F c d = skip-d e (ope-src w) X F (ope-cube w X c) (ope-cube-d w X F c d)
ope-cube-d (wkeep e w) X F c d = keep-d e (ope-src w) (ope-tgt w) (ope-cube w) (ope-cube-d w) X F c d
CubeNatD : (sk' sk : Lst Entry) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) → CubeD sk' sk f → CubeNat sk' sk f → Type 2
CubeNatD sk' sk f fd fn = (X Y : Type 1) (F : X → Type 1) (G : Y → Type 1) (g : X → Y) (gd : (x : X) → F x → G (g x))
  (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
  PathP (λ i → DCube (dims sk') Y G (fn X Y g c i))
    (fd Y G (cube-map (dims sk) X Y g c) (dcube-reidx (dims sk) X Y F G g gd c d)) (dcube-reidx (dims sk') X Y F G g gd (f X c) (fd X F c d))
skip-nat-d : (e : Entry) (sk' sk : Lst Entry) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) (fd : CubeD sk' sk f)
  (fn : CubeNat sk' sk f) → CubeNatD sk' sk f fd fn →
  CubeNatD (lcons e sk') sk (λ Y c → skip-cube e sk' Y (f Y c)) (λ Y G c d → skip-d e sk' Y G (f Y c) (fd Y G c d))
    (skip-nat e sk' sk f fn)
skip-nat-d (e-ty s) sk' sk f fd fn fnd X Y F G g gd c d = fnd X Y F G g gd c d
skip-nat-d e-dim sk' sk f fd fn fnd X Y F G g gd c d =
  pcat-d (Cube (dims sk') (Line Y)) (DCube (dims sk') (Line Y) (LineO Y G))
    (cube-map (dims sk') Y (Line Y) (degen-l Y) (f Y (cube-map (dims sk) X Y g c)))
    (cube-map (dims sk') Y (Line Y) (degen-l Y) (cube-map (dims sk') X Y g (f X c)))
    (cube-map (dims sk') (Line X) (Line Y) (line-map X Y g) (cube-map (dims sk') X (Line X) (degen-l X) (f X c)))
    (λ i → cube-map (dims sk') Y (Line Y) (degen-l Y) (fn X Y g c i))
    (cube-comp2 (dims sk') X Y (Line X) (Line Y) (degen-l Y) g (line-map X Y g) (degen-l X) (f X c)
       (λ i → cube-map (dims sk') X (Line Y) (λ x → degen-l Y (g x)) (f X c)))
    (dcube-reidx (dims sk') Y (Line Y) G (LineO Y G) (degen-l Y) (degen-o Y G) (f Y (cube-map (dims sk) X Y g c))
       (fd Y G (cube-map (dims sk) X Y g c) (dcube-reidx (dims sk) X Y F G g gd c d)))
    (dcube-reidx (dims sk') Y (Line Y) G (LineO Y G) (degen-l Y) (degen-o Y G) (cube-map (dims sk') X Y g (f X c))
       (dcube-reidx (dims sk') X Y F G g gd (f X c) (fd X F c d)))
    (dcube-reidx (dims sk') (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y g) (lineo-reidx X Y F G g gd)
       (cube-map (dims sk') X (Line X) (degen-l X) (f X c)) (dcube-reidx (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) (f X c) (fd X F c d)))
    (λ i → dcube-reidx (dims sk') Y (Line Y) G (LineO Y G) (degen-l Y) (degen-o Y G) (fn X Y g c i) (fnd X Y F G g gd c d i))
    (cube-comp2-d (dims sk') X Y (Line X) (Line Y) F G (LineO X F) (LineO Y G) (degen-l Y) (degen-o Y G) g gd (line-map X Y g) (lineo-reidx X Y F G g gd)
       (degen-l X) (degen-o X F) (f X c) (fd X F c d)
       (λ i → cube-map (dims sk') X (Line Y) (λ x → degen-l Y (g x)) (f X c))
       (λ i → dcube-reidx (dims sk') X (Line Y) F (LineO Y G) (λ x → degen-l Y (g x)) (λ x y → degen-o Y G (g x) (gd x y)) (f X c) (fd X F c d)))
keep-nat-d : (e : Entry) (sk' sk : Lst Entry) (f : (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y) (fd : CubeD sk' sk f)
  (fn : CubeNat sk' sk f) → CubeNatD sk' sk f fd fn →
  CubeNatD (lcons e sk') (lcons e sk) (keep-cube e sk' sk f) (keep-d e sk' sk f fd) (keep-nat e sk' sk f fn)
keep-nat-d (e-ty s) sk' sk f fd fn fnd X Y F G g gd c d = fnd X Y F G g gd c d
keep-nat-d e-dim sk' sk f fd fn fnd X Y F G g gd c d =
  fnd (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y g) (lineo-reidx X Y F G g gd) c d
ope-nat-d : (w : OPE) → CubeNatD (ope-src w) (ope-tgt w) (ope-cube w) (ope-cube-d w) (ope-nat w)
ope-nat-d wdone X Y F G g gd c d = λ i → gd c d
ope-nat-d (wskip e w) X Y F G g gd c d =
  skip-nat-d e (ope-src w) (ope-tgt w) (ope-cube w) (ope-cube-d w) (ope-nat w) (ope-nat-d w) X Y F G g gd c d
ope-nat-d (wkeep e w) X Y F G g gd c d =
  keep-nat-d e (ope-src w) (ope-tgt w) (ope-cube w) (ope-cube-d w) (ope-nat w) (ope-nat-d w) X Y F G g gd c d



diag-ty-s-d : (sk : Lst Entry) (s : TyShape) (k : Word) (X : Type 1) (F : X → Type 1) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → DCube (dims sk) X F (diag-ty-s sk s k X c i)) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) X F c d) (diag-sk-d sk k X F c d)
diag-ty-s-d sk s k X F c d = λ i →
  bool-elim1 (λ b → DCube (dims sk) X F (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (wsub-s1 k i) X c))
    (dcube-reidx (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) c d) (diag-sk-d sk (wsub-s1 k i) X F c d) (weq-s0 k i)
diag-dim-s-d : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (c : Cube (suc (dims (lcons e-dim sk))) X) (d : DCube (suc (dims (lcons e-dim sk))) X F c) →
  PathP (λ i → DCube (suc (dims sk)) X F (diag-dim-s sk k X c i)) (diag-sk-d (lcons e-dim sk) (%wsucc k) X F c d)
    (diag-sk-d sk k (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d))
diag-dim-s-d sk k X F c d = λ i →
  bool-elim1 (λ b → DCube (suc (dims sk)) X F
                 (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c else diag-sk sk (wsub-s1 k i) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
    (dcube-reidx (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) c d)
    (diag-sk-d sk (wsub-s1 k i) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d)) (weq-s0 k i)
diag-nat-d : (sk : Lst Entry) (k : Word) (X Y : Type 1) (F : X → Type 1) (G : Y → Type 1) (g : X → Y) (gd : (x : X) → F x → G (g x))
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → DCube (dims sk) Y G (diag-nat sk k X Y g c i))
    (diag-sk-d sk k Y G (cube-map (suc (dims sk)) X Y g c) (dcube-reidx (suc (dims sk)) X Y F G g gd c d))
    (dcube-reidx (dims sk) X Y F G g gd (diag-sk sk k X c) (diag-sk-d sk k X F c d))
diag-nat-d lnil k X Y F G g gd c d = λ i → gd (fst c) (fst d)
diag-nat-d (lcons (e-ty s) sk) k X Y F G g gd c d =
  bool-elim1 (λ b → PathP (λ i → DCube (dims sk) Y G
                   (bool-elim1 (λ b → PathP (λ i → Cube (dims sk) Y)
                       (if b then cube-map (dims sk) (Line Y) Y (face0-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c) else diag-sk sk (%wsub k #1) Y (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c))
                       (cube-map (dims sk) X Y g (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c)))
                     (cube-comp2 (dims sk) (Line X) (Line Y) X Y (face0-l Y) (line-map X Y g) g (face0-l X) c (λ i → cube-map (dims sk) (Line X) Y (λ L → g (fst L)) c))
                     (diag-nat sk (%wsub k #1) X Y g c) b i))
                 (bool-elim1 (λ b → DCube (dims sk) Y G (if b then cube-map (dims sk) (Line Y) Y (face0-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c) else diag-sk sk (%wsub k #1) Y (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c)))
                    (dcube-reidx (dims sk) (Line Y) Y (LineO Y G) G (face0-l Y) (face0-o Y G) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c) (dcube-reidx (dims sk) (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y g) (lineo-reidx X Y F G g gd) c d)) (diag-sk-d sk (%wsub k #1) Y G (cube-map (dims sk) (Line X) (Line Y) (line-map X Y g) c) (dcube-reidx (dims sk) (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y g) (lineo-reidx X Y F G g gd) c d)) b)
                 (dcube-reidx (dims sk) X Y F G g gd (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c)
                    (bool-elim1 (λ b → DCube (dims sk) X F (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c))
                       (dcube-reidx (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) c d) (diag-sk-d sk (%wsub k #1) X F c d) b)))
    (cube-comp2-d (dims sk) (Line X) (Line Y) X Y (LineO X F) (LineO Y G) F G (face0-l Y) (face0-o Y G) (line-map X Y g) (lineo-reidx X Y F G g gd) g gd (face0-l X) (face0-o X F) c d
       (λ i → cube-map (dims sk) (Line X) Y (λ L → g (fst L)) c)
       (λ i → dcube-reidx (dims sk) (Line X) Y (LineO X F) G (λ L → g (fst L)) (λ L D → gd (fst L) (fst D)) c d))
    (diag-nat-d sk (%wsub k #1) X Y F G g gd c d) (weq k #0)
diag-nat-d (lcons e-dim sk) k X Y F G g gd c d =
  bool-elim1 (λ b → PathP (λ i → DCube (suc (dims sk)) Y G
                   (bool-elim1 (λ b → PathP (λ i → Cube (suc (dims sk)) Y)
                       (if b then cube-map (dims sk) (Line (Line Y)) (Line Y) (diag-l Y) (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y g)) c) else diag-sk sk (%wsub k #1) (Line Y) (cube-map (dims sk) (Line (Line Y)) (Line (Line Y)) (exch-l Y) (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y g)) c)))
