    (λ i → diag-sk-d sk k' X F (cube-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (line-map (Line X) X (face0-l X)) (exch-l X) D i) (reidx-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (LineO X F) (line-map (Line X) X (face0-l X)) (lineo-reidx (Line X) X (LineO X F) F (face0-l X) (face0-o X F)) (exch-l X) (exch-o X F) D d i))
