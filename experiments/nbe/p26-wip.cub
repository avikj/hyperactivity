    (λ i → papp-cube-d sk2 X F (snd σ) (cmap-const sk2 sk1 (fst σ) (Line X) (degen-l X x) i) (cmap-const-d sk2 sk1 (fst σ) (Line X) (LineO X F) (degen-l X x) (degen-o X F x y) i))
    (λ i → papp-cube-d sk2 X F (snd σ) (const-map (dims sk2) X (Line X) (degen-l X) x (~ i)) (const-map-d (dims sk2) X (Line X) F (LineO X F) (degen-l X) (degen-o X F) x y (~ i)))
    (papp-deg-d sk2 X F (snd σ) (cube-const (dims sk2) X x) (dcube-const (dims sk2) X F x y))
-- (2026-11-12, (4r-d)) the action of composite renamings on cubes over cubes is the composite of the
-- actions (over cmap-comp, by its cases: cmap-const-d; papp-var-d, cmap-diag-d at each dimension entry)
cmap-d-comp : (sk2 sk1 sk : Lst Entry) (r2 r1 : Word → Word) (dp2 : DimPres sk2 sk1 r2) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
  PathP (λ i → DCube (dims sk2) X F (cmap-comp sk2 sk1 sk r2 r1 dp2 X c i)) (cmap-d sk2 sk1 (cmap-of sk2 sk1 r2) X F (cmap-cube sk1 sk (cmap-of sk1 sk r1) X c) (cmap-d sk1 sk (cmap-of sk1 sk r1) X F c d)) (cmap-d sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 k))) X F c d)
cmap-d-comp sk2 sk1 lnil r2 r1 dp2 X F c d = cmap-const-d sk2 sk1 (cmap-of sk2 sk1 r2) X F c d
cmap-d-comp sk2 sk1 (lcons (e-ty a) sk) r2 r1 dp2 X F c d = cmap-d-comp sk2 sk1 sk r2 (λ k → r1 (%wsucc k)) dp2 X F c d
cmap-d-comp sk2 sk1 (lcons e-dim sk) r2 r1 dp2 X F c d =
  pc4-d (Cube (dims sk2) X) (DCube (dims sk2) X F)
    (cmap-cube sk2 sk1 (cmap-of sk2 sk1 r2) X (papp-cube sk1 X (lcons (lcons (r1 #0 , true) lnil) lnil) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c))) (cmap-cube sk2 sk1 (cmap-of sk2 sk1 r2) X (diag-sk sk1 (r1 #0) X (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c))) (diag-sk sk2 (r2 (r1 #0)) X (cmap-cube sk2 sk1 (cmap-of sk2 sk1 r2) (Line X) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c))) (diag-sk sk2 (r2 (r1 #0)) X (cmap-cube sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) c)) (papp-cube sk2 X (lcons (lcons (r2 (r1 #0) , true) lnil) lnil) (cmap-cube sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) c))
    (λ i → cmap-cube sk2 sk1 (cmap-of sk2 sk1 r2) X (papp-var sk1 X (r1 #0) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) i))
    (λ i → cmap-diag sk2 sk1 r2 dp2 (r1 #0) X (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) (~ i))
    (λ i → diag-sk sk2 (r2 (r1 #0)) X (cmap-comp sk2 sk1 sk r2 (λ k → r1 (%wsucc k)) dp2 (Line X) c i))
    (λ i → papp-var sk2 X (r2 (r1 #0)) (cmap-cube sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) c) (~ i))
    (cmap-d sk2 sk1 (cmap-of sk2 sk1 r2) X F (papp-cube sk1 X (lcons (lcons (r1 #0 , true) lnil) lnil) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c)) (papp-cube-d sk1 X F (lcons (lcons (r1 #0 , true) lnil) lnil) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) (cmap-d sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) (LineO X F) c d)))
    (cmap-d sk2 sk1 (cmap-of sk2 sk1 r2) X F (diag-sk sk1 (r1 #0) X (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c)) (diag-sk-d sk1 (r1 #0) X F (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) (cmap-d sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) (LineO X F) c d)))
    (diag-sk-d sk2 (r2 (r1 #0)) X F (cmap-cube sk2 sk1 (cmap-of sk2 sk1 r2) (Line X) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c)) (cmap-d sk2 sk1 (cmap-of sk2 sk1 r2) (Line X) (LineO X F) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) (cmap-d sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) (LineO X F) c d)))
    (diag-sk-d sk2 (r2 (r1 #0)) X F (cmap-cube sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) c) (cmap-d sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) (LineO X F) c d))
    (papp-cube-d sk2 X F (lcons (lcons (r2 (r1 #0) , true) lnil) lnil) (cmap-cube sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) c) (cmap-d sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) (LineO X F) c d))
    (λ i → cmap-d sk2 sk1 (cmap-of sk2 sk1 r2) X F (papp-var sk1 X (r1 #0) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) i) (papp-var-d sk1 X F (r1 #0) (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) (cmap-d sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) (LineO X F) c d) i))
    (λ i → cmap-diag-d sk2 sk1 r2 dp2 (r1 #0) X F (cmap-cube sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) c) (cmap-d sk1 sk (cmap-of sk1 sk (λ k → r1 (%wsucc k))) (Line X) (LineO X F) c d) (~ i))
    (λ i → diag-sk-d sk2 (r2 (r1 #0)) X F (cmap-comp sk2 sk1 sk r2 (λ k → r1 (%wsucc k)) dp2 (Line X) c i) (cmap-d-comp sk2 sk1 sk r2 (λ k → r1 (%wsucc k)) dp2 (Line X) (LineO X F) c d i))
    (λ i → papp-var-d sk2 X F (r2 (r1 #0)) (cmap-cube sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) c) (cmap-d sk2 sk (cmap-of sk2 sk (λ k → r2 (r1 (%wsucc k)))) (Line X) (LineO X F) c d) (~ i))

-- ---------------------------------------------------------------- (4d) path application commutes with a dimension part
-- (2026-11-12, (4d)) cmap-papp: the action of the dimension part of r (cco, an abbreviation of
-- cmap-cube at cmap-of) commutes with path application at a canonical form, the form renamed by r;
-- each clause is papp-ren's with ope-cube replaced by cco, ope-nat by cmap-nat, diag-ren by cmap-diag
-- (r dimension-preserving), and at each connection the kept renaming w-keep r over the kept
-- skeletons (dp-keep, renatc-keep), whose action is cco's at Line only up to cmap-keep e-dim
-- (the inner chains cpcf-in, cpdf-in)
cco : (sk' sk : Lst Entry) (r : Word → Word) (Y : Type 1) → Cube (dims sk) Y → Cube (dims sk') Y
cco sk' sk r Y c = cmap-cube sk' sk (cmap-of sk' sk r) Y c
pc4 : (A : Type 1) (x0 x1 x2 x3 x4 : A) → PathP (λ i → A) x0 x1 → PathP (λ i → A) x1 x2 → PathP (λ i → A) x2 x3 → PathP (λ i → A) x3 x4 → PathP (λ i → A) x0 x4
pc4 A x0 x1 x2 x3 x4 p1 p2 p3 p4 = pcat A x0 x1 x4 p1 (pcat A x1 x2 x4 p2 (pcat A x2 x3 x4 p3 p4))
cmap-papp-lit : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) → RenAtC r r0 o → DimPres sk' sk r → (l : Lit) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk') X) (papp-lit sk' X o (lit-r r0 l) (cco sk' sk r (Line X) c)) (cco sk' sk r X (papp-lit sk X o l c))
cmap-papp-lit sk' sk r r0 o hr dp l X c =
  bool-elim1 (λ b → PathP (λ i → Cube (dims sk') X)
                 (if b then diag-sk sk' (%wadd (r0 (fst l)) o) X (cco sk' sk r (Line X) c)
                  else diag-sk sk' (%wadd (r0 (fst l)) o) X (cube-map (dims sk') (Line X) (Line X) (rev-l X) (cco sk' sk r (Line X) c)))
                 (cco sk' sk r X (if b then diag-sk sk (%wadd (fst l) o) X c
                                  else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))))
    (pcat (Cube (dims sk') X) (diag-sk sk' (%wadd (r0 (fst l)) o) X (cco sk' sk r (Line X) c))
       (diag-sk sk' (r (%wadd (fst l) o)) X (cco sk' sk r (Line X) c)) (cco sk' sk r X (diag-sk sk (%wadd (fst l) o) X c))
       (λ i → diag-sk sk' (hr (fst l) (~ i)) X (cco sk' sk r (Line X) c)) (cmap-diag sk' sk r dp (%wadd (fst l) o) X c))
    (pcat (Cube (dims sk') X)
       (diag-sk sk' (%wadd (r0 (fst l)) o) X (cube-map (dims sk') (Line X) (Line X) (rev-l X) (cco sk' sk r (Line X) c)))
       (diag-sk sk' (r (%wadd (fst l) o)) X (cco sk' sk r (Line X) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (cco sk' sk r X (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (λ i → diag-sk sk' (hr (fst l) (~ i)) X (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) (Line X) (rev-l X) c (~ i)))
       (cmap-diag sk' sk r dp (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
    (snd l)
-- the rest of a conjunction under the kept renaming: under cmap-nat (meet-l), cmap-keep at Line, the
-- hypothesis ih (cmap-papp-conj-from at the kept renaming), cmap-keep
cpcf-in : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) (m : Lit) (ms : Conj) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (suc (dims sk')) X)
    (papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
    (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) X (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))) →
  PathP (λ i → Cube (suc (dims sk')) X)
    (papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cube-map (dims sk') (Line X) (Line (Line X)) (meet-l X) (cco sk' sk r (Line X) c)))
    (cco sk' sk r (Line X) (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
cpcf-in sk' sk r r0 o m ms X c ih =
  pc4 (Cube (suc (dims sk')) X)
    (papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cube-map (dims sk') (Line X) (Line (Line X)) (meet-l X) (cco sk' sk r (Line X) c)))
    (papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cco sk' sk r (Line (Line X)) (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
    (papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
    (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) X (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
    (cco sk' sk r (Line X) (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
    (λ j → papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) (Line (Line X)) (meet-l X) c (~ j)))
    (λ j → papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cmap-keep e-dim sk' sk r (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c) (~ j)))
    ih
    (cmap-keep e-dim sk' sk r X (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
cmap-papp-conj-from : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) → RenAtC r r0 o → DimPres sk' sk r → (l : Lit) (ms : Conj) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk') X) (papp-conj-from sk' X o (lit-r r0 l) (conj-r r0 ms) (cco sk' sk r (Line X) c)) (cco sk' sk r X (papp-conj-from sk X o l ms c))
cmap-papp-conj-from sk' sk r r0 o hr dp l lnil X c = cmap-papp-lit sk' sk r r0 o hr dp l X c
cmap-papp-conj-from sk' sk r r0 o hr dp l (lcons m ms) X c =
  pcat (Cube (dims sk') X)
    (papp-lit sk' X o (lit-r r0 l) (papp-conj-from (lcons e-dim sk') X (%wsucc o) (lit-r r0 m) (conj-r r0 ms) (cube-map (dims sk') (Line X) (Line (Line X)) (meet-l X) (cco sk' sk r (Line X) c))))
    (papp-lit sk' X o (lit-r r0 l) (cco sk' sk r (Line X) (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))))
    (cco sk' sk r X (papp-conj-from sk X o l (lcons m ms) c))
    (λ i → papp-lit sk' X o (lit-r r0 l) (cpcf-in sk' sk r r0 o m ms X c
       (cmap-papp-conj-from (lcons e-dim sk') (lcons e-dim sk) (w-keep r) r0 (%wsucc o) (renatc-keep r r0 o hr) (dp-keep sk' sk r dp) m ms X (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)) i))
    (cmap-papp-lit sk' sk r r0 o hr dp l X (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
cmap-papp-conj : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) → RenAtC r r0 o → DimPres sk' sk r → (cj : Conj) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk') X) (papp-conj sk' X o (conj-r r0 cj) (cco sk' sk r (Line X) c)) (cco sk' sk r X (papp-conj sk X o cj c))
cmap-papp-conj sk' sk r r0 o hr dp lnil X c =
  psym (Cube (dims sk') X) (cco sk' sk r X (cube-map (dims sk) (Line X) X (face1-l X) c))
    (cube-map (dims sk') (Line X) X (face1-l X) (cco sk' sk r (Line X) c)) (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) X (face1-l X) c)
cmap-papp-conj sk' sk r r0 o hr dp (lcons l ls) X c = cmap-papp-conj-from sk' sk r r0 o hr dp l ls X c
-- the rest of a disjunction likewise (join-l)
cpdf-in : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) (d : Conj) (ds : DNF) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (suc (dims sk')) X)
    (papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
    (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) X (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))) →
  PathP (λ i → Cube (suc (dims sk')) X)
    (papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cube-map (dims sk') (Line X) (Line (Line X)) (join-l X) (cco sk' sk r (Line X) c)))
    (cco sk' sk r (Line X) (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
cpdf-in sk' sk r r0 o d ds X c ih =
  pc4 (Cube (suc (dims sk')) X)
    (papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cube-map (dims sk') (Line X) (Line (Line X)) (join-l X) (cco sk' sk r (Line X) c)))
    (papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cco sk' sk r (Line (Line X)) (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
    (papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
    (cco (lcons e-dim sk') (lcons e-dim sk) (w-keep r) X (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
    (cco sk' sk r (Line X) (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
    (λ j → papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) (Line (Line X)) (join-l X) c (~ j)))
    (λ j → papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cmap-keep e-dim sk' sk r (Line X) (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c) (~ j)))
    ih
    (cmap-keep e-dim sk' sk r X (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
cmap-papp-dnf-from : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) → RenAtC r r0 o → DimPres sk' sk r → (cj : Conj) (ds : DNF) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk') X) (papp-dnf-from sk' X o (conj-r r0 cj) (dnf-r r0 ds) (cco sk' sk r (Line X) c)) (cco sk' sk r X (papp-dnf-from sk X o cj ds c))
cmap-papp-dnf-from sk' sk r r0 o hr dp cj lnil X c = cmap-papp-conj sk' sk r r0 o hr dp cj X c
cmap-papp-dnf-from sk' sk r r0 o hr dp cj (lcons d ds) X c =
  pcat (Cube (dims sk') X)
    (papp-conj sk' X o (conj-r r0 cj) (papp-dnf-from (lcons e-dim sk') X (%wsucc o) (conj-r r0 d) (dnf-r r0 ds) (cube-map (dims sk') (Line X) (Line (Line X)) (join-l X) (cco sk' sk r (Line X) c))))
    (papp-conj sk' X o (conj-r r0 cj) (cco sk' sk r (Line X) (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))))
    (cco sk' sk r X (papp-dnf-from sk X o cj (lcons d ds) c))
    (λ i → papp-conj sk' X o (conj-r r0 cj) (cpdf-in sk' sk r r0 o d ds X c
       (cmap-papp-dnf-from (lcons e-dim sk') (lcons e-dim sk) (w-keep r) r0 (%wsucc o) (renatc-keep r r0 o hr) (dp-keep sk' sk r dp) d ds X (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)) i))
    (cmap-papp-conj sk' sk r r0 o hr dp cj X (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
cmap-papp : (sk' sk : Lst Entry) (r : Word → Word) → DimPres sk' sk r → (f : DNF) (X : Type 1) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → Cube (dims sk') X) (papp-cube sk' X (dnf-r r f) (cco sk' sk r (Line X) c)) (cco sk' sk r X (papp-cube sk X f c))
cmap-papp sk' sk r dp lnil X c =
  psym (Cube (dims sk') X) (cco sk' sk r X (cube-map (dims sk) (Line X) X (face0-l X) c))
    (cube-map (dims sk') (Line X) X (face0-l X) (cco sk' sk r (Line X) c)) (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) X (face0-l X) c)
cmap-papp sk' sk r dp (lcons cj cs) X c = cmap-papp-dnf-from sk' sk r r #0 (renatc-0 r) dp cj cs X c
ccd : (sk' sk : Lst Entry) (r : Word → Word) (Y : Type 1) (G : Y → Type 1) (c : Cube (dims sk) Y) → DCube (dims sk) Y G c → DCube (dims sk') Y G (cco sk' sk r Y c)
ccd sk' sk r Y G c d = cmap-d sk' sk (cmap-of sk' sk r) Y G c d
-- the dependent forms (cmap-papp-lit-d … cmap-papp-d), each over its base lemma, by the same cases
CPL : (sk' sk : Lst Entry) (r r0 : Word → Word) (o : Word) (hr : RenAtC r r0 o) (dp : DimPres sk' sk r) (l : Lit) (X : Type 1) (F : X → Type 1) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) → Type 1
CPL sk' sk r r0 o hr dp l X F c d = PathP (λ i → DCube (dims sk') X F (cmap-papp-lit sk' sk r r0 o hr dp l X c i))
  (papp-lit-d sk' X F o (lit-r r0 l) (cco sk' sk r (Line X) c) (ccd sk' sk r (Line X) (LineO X F) c d)) (ccd sk' sk r X F (papp-lit sk X o l c) (papp-lit-d sk X F o l c d))
