papp-dnf-from-pull : (sk : Lst Entry) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x) (o : Word) (cj : Conj) (ds : DNF)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) (e : DCube (suc (dims sk)) X' F' (dcube-map (suc (dims sk)) X Y X' f c d)) →
  PullT (dims sk) X X' Y F F' f g (λ Z c' → papp-dnf-from sk Z o cj ds c') (λ Z G c' d' → papp-dnf-from-d sk Z G o cj ds c' d') c d (papp-dnf-from-dmap sk X Y X' f o cj ds c d) e
papp-dnf-from-pull sk X X' Y F F' f g o cj lnil c d e = papp-conj-pull sk X X' Y F F' f g o cj c d e
papp-dnf-from-pull sk X X' Y F F' f g o cj (lcons dj ds) c d e =
  pdf-pull-out sk X X' Y F F' f g o cj dj ds c d e
    (papp-dnf-from-pull (lcons e-dim sk) X X' Y F F' f g (%wsucc o) dj ds (joinc (dims sk) X c) (joind (dims sk) X Y c d)
       (carry (suc (suc (dims sk))) X' F' (joinc (dims sk) X' (dcube-map (suc (dims sk)) X Y X' f c d)) (dcube-map (suc (suc (dims sk))) X Y X' f (joinc (dims sk) X c) (joind (dims sk) X Y c d))
          (joing (dims sk) X Y X' f c d) (joind (dims sk) X' F' (dcube-map (suc (dims sk)) X Y X' f c d) e)))
papp-pull : (sk : Lst Entry) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x) (fm : DNF)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) (e : DCube (suc (dims sk)) X' F' (dcube-map (suc (dims sk)) X Y X' f c d)) →
  PullT (dims sk) X X' Y F F' f g (λ Z c' → papp-cube sk Z fm c') (λ Z G c' d' → papp-cube-d sk Z G fm c' d') c d (papp-dmap sk X Y X' f fm c d) e
papp-pull sk X X' Y F F' f g lnil c d e =
  pull-genc (dims sk) (Line X) (Line X') X X' (LineO X Y) (LineO X F) (LineO X' F') Y F F' (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) f g
    (face0-l X) (face0-o X Y) (face0-o X F) (face0-l X') (face0-o X' F') (λ i L D → f (fst L) (fst D)) (λ L D E e1 P i → g (fst L) (fst D) (P i)) c d e
papp-pull sk X X' Y F F' f g (lcons cj cs) c d e = papp-dnf-from-pull sk X X' Y F F' f g #0 cj cs c d e
-- (2026-11-12, (5)) pulling back commutes with the constant cube over dmap-const-cube (const-pull, by
-- induction: the pull of degenerate lines is the degenerate line judgmentally), and with the action of
-- a dimension part over cmap-dmap (cmap-d-pull: const-pull at no dimension, the hypothesis then
-- papp-pull at each dimension entry, by pull-chain)
const-pull : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : X) (d : Y c) (e : F' (f c d)) →
  PathP (λ i → DCube n X F (cube-const n X c)) (dcube-const n X F c (g c d e))
    (dcube-pull n X X' Y F F' f g (cube-const n X c) (dcube-const n X Y c d)
       (carry n X' F' (cube-const n X' (f c d)) (dcube-map n X Y X' f (cube-const n X c) (dcube-const n X Y c d))
          (psym (Cube n X') (dcube-map n X Y X' f (cube-const n X c) (dcube-const n X Y c d)) (cube-const n X' (f c d)) (dmap-const-cube n X Y X' f c d))
          (dcube-const n X' F' (f c d) e)))
const-pull zero X X' Y F F' f g c d e =
  λ i → g c d (carry-fill zero X' F' (f c d) (f c d) (psym (Cube zero X') (f c d) (f c d) (dmap-const-cube zero X Y X' f c d)) e i)
const-pull (suc n) X X' Y F F' f g c d e =
  const-pull n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) (degen-l X c) (degen-o X Y c d) (degen-o X' F' (f c d) e)
cmap-d-pull : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' F' (dcube-map (dims sk) X Y X' f c d)) →
  PathP (λ i → DCube (dims sk') X F (cmap-cube sk' sk σ X c)) (cmap-d sk' sk σ X F c (dcube-pull (dims sk) X X' Y F F' f g c d e))
    (dcube-pull (dims sk') X X' Y F F' f g (cmap-cube sk' sk σ X c) (cmap-d sk' sk σ X Y c d)
       (carry (dims sk') X' F' (cmap-cube sk' sk σ X' (dcube-map (dims sk) X Y X' f c d)) (dcube-map (dims sk') X Y X' f (cmap-cube sk' sk σ X c) (cmap-d sk' sk σ X Y c d))
          (cmap-dmap sk' sk σ X Y X' f c d) (cmap-d sk' sk σ X' F' (dcube-map (dims sk) X Y X' f c d) e)))
cmap-d-pull sk' lnil σ X X' Y F F' f g c d e = const-pull (dims sk') X X' Y F F' f g c d e
cmap-d-pull sk' (lcons (e-ty a) sk) σ X X' Y F F' f g c d e = cmap-d-pull sk' sk σ X X' Y F F' f g c d e
cmap-d-pull sk' (lcons e-dim sk) σ X X' Y F F' f g c d e =
  pull-chain (suc (dims sk')) (dims sk') X' X' F' F' (λ c' → papp-cube sk' X' (snd σ) c') (λ c' a' → papp-cube-d sk' X' F' (snd σ) c' a')
    (cmap-cube sk' sk (fst σ) (Line X') (dcube-map (suc (dims sk)) X Y X' f c d))
    (dcube-map (suc (dims sk')) X Y X' f (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
    (cmap-dmap sk' sk (fst σ) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
    (cmap-d sk' sk (fst σ) (Line X') (LineO X' F') (dcube-map (suc (dims sk)) X Y X' f c d) e)
    (dcube-map (dims sk') X Y X' f (cmap-cube sk' (lcons e-dim sk) σ X c) (cmap-d sk' (lcons e-dim sk) σ X Y c d))
    (papp-dmap sk' X Y X' f (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
    (DCube (suc (dims sk')) X F (cmap-cube sk' sk (fst σ) (Line X) c)) (DCube (dims sk') X F (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)))
    (λ u → papp-cube-d sk' X F (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) u)
    (cmap-d sk' sk (fst σ) (Line X) (LineO X F) c (dcube-pull (suc (dims sk)) X X' Y F F' f g c d e))
    (dcube-pull (suc (dims sk')) X X' Y F F' f g (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d)
       (carry (suc (dims sk')) X' F' (cmap-cube sk' sk (fst σ) (Line X') (dcube-map (suc (dims sk)) X Y X' f c d))
          (dcube-map (suc (dims sk')) X Y X' f (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
          (cmap-dmap sk' sk (fst σ) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
          (cmap-d sk' sk (fst σ) (Line X') (LineO X' F') (dcube-map (suc (dims sk)) X Y X' f c d) e)))
    (λ z → dcube-pull (dims sk') X X' Y F F' f g (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c))
       (papp-cube-d sk' X Y (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d)) z)
    (cmap-d-pull sk' sk (fst σ) (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) c d e)
    (papp-pull sk' X X' Y F F' f g (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d)
       (carry (suc (dims sk')) X' F' (cmap-cube sk' sk (fst σ) (Line X') (dcube-map (suc (dims sk)) X Y X' f c d))
          (dcube-map (suc (dims sk')) X Y X' f (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d sk' sk (fst σ) (Line X) (LineO X Y) c d))
          (cmap-dmap sk' sk (fst σ) (Line X) (LineO X Y) (Line X') (lineo-map X Y X' f) c d)
          (cmap-d sk' sk (fst σ) (Line X') (LineO X' F') (dcube-map (suc (dims sk)) X Y X' f c d) e)))

-- (2026-11-12, (5) toward subM-comp) carrying a pull along a path of its base with a path of its
-- data over it is pulling the carried cube (pull-move, by carry-uniq); a pull along a pulled cube is two
-- pulls (pull-pull, over map-pull: the matching lemma at map-pull; qF the pointwise statement,
-- judgmental where used)
pull-move : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c0 c1 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1) (K0 : DCube n X Y c0) (K1 : DCube n X Y c1) (Kp : PathP (λ i → DCube n X Y (p i)) K0 K1)
  (E : DCube n X' F' (dcube-map n X Y X' f c0 K0)) →
  PathP (λ i → DCube n X F c1) (carry n X F c0 c1 p (dcube-pull n X X' Y F F' f g c0 K0 E))
    (dcube-pull n X X' Y F F' f g c1 K1 (carry n X' F' (dcube-map n X Y X' f c0 K0) (dcube-map n X Y X' f c1 K1) (λ i → dcube-map n X Y X' f (p i) (Kp i)) E))
pull-move n X X' Y F F' f g c0 c1 p K0 K1 Kp E =
  carry-uniq n X F c0 c1 p (dcube-pull n X X' Y F F' f g c0 K0 E)
    (dcube-pull n X X' Y F F' f g c1 K1 (carry n X' F' (dcube-map n X Y X' f c0 K0) (dcube-map n X Y X' f c1 K1) (λ i → dcube-map n X Y X' f (p i) (Kp i)) E))
    (λ i → dcube-pull n X X' Y F F' f g (p i) (Kp i)
       (carry-fill n X' F' (dcube-map n X Y X' f c0 K0) (dcube-map n X Y X' f c1 K1) (λ i → dcube-map n X Y X' f (p i) (Kp i)) E i))
pull-pull : (n : Nat) (X0 X1 X2 : Type 1) (Y0 F0 Yc : X0 → Type 1) (Y1 F1 : X1 → Type 1) (F2 : X2 → Type 1)
  (f0 : (x : X0) → Y0 x → X1) (g0 : (x : X0) (y : Y0 x) → F1 (f0 x y) → F0 x) (f1 : (x : X1) → Y1 x → X2) (g1 : (x : X1) (y : Y1 x) → F2 (f1 x y) → F1 x)
  (gc : (x : X0) (y : Y0 x) → Y1 (f0 x y) → Yc x) (fc : (x : X0) → Yc x → X2) (gcf : (x : X0) (y : Yc x) → F2 (fc x y) → F0 x)
  (q : PathP (λ i → (x : X0) (y : Y0 x) → Y1 (f0 x y) → X2) (λ x y w → fc x (gc x y w)) (λ x y w → f1 (f0 x y) w))
  (qF : (x : X0) (y : Y0 x) (w : Y1 (f0 x y)) (E0 : F2 (f1 (f0 x y) w)) (E1 : F2 (fc x (gc x y w))) → PathP (λ i → F2 (q (~ i) x y w)) E0 E1 →
     PathP (λ i → F0 x) (gcf x (gc x y w) E1) (g0 x y (g1 (f0 x y) w E0)))
  (c : Cube n X0) (d : DCube n X0 Y0 c) (W : DCube n X1 Y1 (dcube-map n X0 Y0 X1 f0 c d)) (E : DCube n X2 F2 (dcube-map n X1 Y1 X2 f1 (dcube-map n X0 Y0 X1 f0 c d) W)) →
  PathP (λ i → DCube n X0 F0 c)
    (dcube-pull n X0 X2 Yc F0 F2 fc gcf c (dcube-pull n X0 X1 Y0 Yc Y1 f0 gc c d W)
       (carry n X2 F2 (dcube-map n X1 Y1 X2 f1 (dcube-map n X0 Y0 X1 f0 c d) W) (dcube-map n X0 Yc X2 fc c (dcube-pull n X0 X1 Y0 Yc Y1 f0 gc c d W))
          (λ i → map-pull n X0 X1 Y0 Yc Y1 f0 gc X2 fc f1 q c d W (~ i)) E))
    (dcube-pull n X0 X1 Y0 F0 F1 f0 g0 c d (dcube-pull n X1 X2 Y1 F1 F2 f1 g1 (dcube-map n X0 Y0 X1 f0 c d) W E))
pull-pull zero X0 X1 X2 Y0 F0 Yc Y1 F1 F2 f0 g0 f1 g1 gc fc gcf q qF c d W E =
  qF c d W E (carry zero X2 F2 (f1 (f0 c d) W) (fc c (gc c d W)) (λ i → q (~ i) c d W) E)
    (carry-fill zero X2 F2 (f1 (f0 c d) W) (fc c (gc c d W)) (λ i → q (~ i) c d W) E)
pull-pull (suc n) X0 X1 X2 Y0 F0 Yc Y1 F1 F2 f0 g0 f1 g1 gc fc gcf q qF c d W E =
  pull-pull n (Line X0) (Line X1) (Line X2) (LineO X0 Y0) (LineO X0 F0) (LineO X0 Yc) (LineO X1 Y1) (LineO X1 F1) (LineO X2 F2)
    (lineo-map X0 Y0 X1 f0) (lineo-pull X0 X1 Y0 F0 F1 f0 g0) (lineo-map X1 Y1 X2 f1) (lineo-pull X1 X2 Y1 F1 F2 f1 g1)
    (lineo-pull X0 X1 Y0 Yc Y1 f0 gc) (lineo-map X0 Yc X2 fc) (lineo-pull X0 X2 Yc F0 F2 fc gcf)
    (λ i L D V → (q i (fst L) (fst D) (fst V) , q i (fst (snd L)) (fst (snd D)) (fst (snd V)) , λ j → q i (snd (snd L) j) (snd (snd D) j) (snd (snd V) j)))
    (λ L D V Ea Eb P i →
       (qF (fst L) (fst D) (fst V) (fst Ea) (fst Eb) (λ k → fst (P k)) i ,
        qF (fst (snd L)) (fst (snd D)) (fst (snd V)) (fst (snd Ea)) (fst (snd Eb)) (λ k → fst (snd (P k))) i ,
        λ j → qF (snd (snd L) j) (snd (snd D) j) (snd (snd V) j) (snd (snd Ea) j) (snd (snd Eb) j) (λ k → snd (snd (P k)) j) i))
    c d W E
sc-A : (Δ2 Δ : CCtx) (ρ : CMap (fst Δ2) (fst Δ)) (Z : Type 1) (M : Mean Δ Z) → (DCube (dims (fst Δ2)) (CtxV (fst Δ)) (FbE (fst Δ) Z) (sc-x0 Δ2 Δ ρ))
sc-A Δ2 Δ ρ Z M = (cmap-d (fst Δ2) (fst Δ) ρ (CtxV (fst Δ)) (FbE (fst Δ) Z) (snd Δ) M)
