-- (2026-11-12, next definitions (2s)) σ extended by a cube of values: Q = sub-carried σ M pulled back
-- along σ's cube into Δ (sub-tot: at each vertex a vertex of σ with the value of M there), its total
-- (tot-base), and V a cube over the total of values in the extending type (ExtV); the new cube of
-- vertex substitutions pairs each with V's value (sub-ext-S). Its path: ext-path (below), then the
-- total's projections (dmap-map, dmap-fst) and map-pull out of V (sub-ext-tail).
SubT : (sk' sk : Lst Entry) (Y : Type 1) → CtxV sk' → Type 1
-- binder names chosen not to collide: t46
SubT sk' sk Y γ' = (stp : SubF sk' sk γ') × FbE sk Y (fst stp)
TotT : (sk' sk : Lst Entry) (Y : Type 1) → Type 1
-- binder names chosen not to collide: t46
TotT sk' sk Y = (ttγ : CtxV sk') × SubT sk' sk Y ttγ
ExtV : (sk' sk : Lst Entry) (a : TyShape) (Y : Type 1) (f : (γ : CtxV sk) → (EnvV sk γ → Y) → EnvV sk γ → Sem a) → TotT sk' sk Y → Type 1
-- binder names chosen not to collide: t46
ExtV sk' sk a Y f x = (evρ : EnvV sk' (fst x)) → El a (f (fst (fst (snd x))) (snd (snd x)) (snd (fst (snd x)) evρ))
sub-tot : (Δ Γ : CCtx) (Y : Type 1) (σ : Sub Δ Γ) (M : Mean Γ Y) → DCube (dims (fst Δ)) (CtxV (fst Δ)) (SubT (fst Δ) (fst Γ) Y) (snd Δ)
