  psym (Cube (dims sk') Z) (dcube-map (dims sk') X F Z g (cube-const (dims sk') X c) (dcube-const (dims sk') X F c d)) (cube-const (dims sk') Z (g c d))
    (dmap-const-cube (dims sk') X F Z g c d)
cmap-dmap sk' (lcons (e-ty a) sk) σ X F Z g c d = cmap-dmap sk' sk σ X F Z g c d
cmap-dmap sk' (lcons e-dim sk) σ X F Z g c d =
  pcat (Cube (dims sk') Z)
    (papp-cube sk' Z (snd σ) (cmap-cube sk' sk (fst σ) (Line Z) (dcube-map (suc (dims sk)) X F Z g c d)))
