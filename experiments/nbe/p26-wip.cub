  PathP (λ i → (DCube (dims sk') X F (cco sk' sk r X G))) (papp-ex sk' X F (ixr r cd) (cco sk' sk r X G) (ccd sk' sk r X (DL X F) G Q)) (ccd sk' sk r X F G (papp-ex sk X F cd G Q))
