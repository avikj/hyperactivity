  pcat-d (Cube (dims sk) X) (DCube (dims sk) X F)
    (f0c (dims sk) X (f0c (dims sk) (Line X) (exc (dims sk) X D))) (f0c (dims sk) X (cube-map (dims sk) (Line (Line X)) (Line X) (λ Q → face0-l (Line X) (exch-l X Q)) D)) (f0c (dims sk) X (f0c (dims sk) (Line X) D))
