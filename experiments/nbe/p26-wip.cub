       (fd (Line X) (LineO X F) (diag-sk (lcons e-dim sk) (%wsucc n) X c) (diag-sk-d (lcons e-dim sk) (%wsucc n) X F c d))
       (pcat-d (Cube (suc (dims sk')) X) (DCube (suc (dims sk')) X F) (diag-sk (lcons e-dim sk') (%wsucc (r n)) X (f (Line (Line X)) c))
