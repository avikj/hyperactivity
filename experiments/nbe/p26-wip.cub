cmap-papp-dd : (sk' sk : Lst Entry) (r : Word → Word) (dp : DimPres sk' sk r) (f : DNF) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (Q : DCube (dims sk) X (DL X F) G) →
  PathP (λ i → (DCube (dims sk') X F (cco sk' sk r X G))) (papp-dd sk' X F (dnf-r r f) (cco sk' sk r X G) (ccd sk' sk r X (DL X F) G Q)) (ccd sk' sk r X F G (papp-dd sk X F f G Q))
cmap-papp-dd sk' sk r dp f X F G Q =
  pcat (DCube (dims sk') X F (cco sk' sk r X G)) (papp-dd sk' X F (dnf-r r f) (cco sk' sk r X G) (ccd sk' sk r X (DL X F) G Q))
