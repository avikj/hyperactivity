    (f0d (dims sk) X F (diag-sk sk k' (Line X) (exc (dims sk) X D)) (diag-sk-d sk k' (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k' X F (cube-map (suc (dims sk)) (Line X) X (face0-l X) (exc (dims sk) X D)) (dcube-reidx (suc (dims sk)) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k' X F (f0c (dims sk) (Line X) D) (f0d (dims sk) (Line X) (LineO X F) D d))
    (diag-sk-d (lcons (e-ty s) sk) (%wsucc k') X F (f0c (dims sk) (Line X) D) (f0d (dims sk) (Line X) (LineO X F) D d))
    (λ i → f0d (dims sk) X F (diag-ty-s sk s k' (Line X) (exc (dims sk) X D) i) (diag-ty-s-d sk s k' (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d) i))
