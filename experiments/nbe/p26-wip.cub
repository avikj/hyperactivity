  (V : DCube (dims (fst Δ)) (TotT (fst Δ) (fst Γ) Y) (ExtV (fst Δ) (fst Γ) a Y f) (tot-base Δ Γ Y σ M)) →
  PathP (λ i → (Cube (dims (fst Δ)) (CtxV (lcons (e-ty a) (fst Γ))))) (dcube-map (dims (fst Δ)) (CtxV (fst Δ)) (SubT (fst Δ) (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ' t → (fst (fst t) , f (fst (fst t)) (snd t))) (snd Δ) (sub-tot Δ Γ Y σ M)) (sub-base Δ (extM Γ a Y f M) (sub-ext-S Δ Γ a Y f M σ V))
sub-ext-tail Δ Γ a Y f M σ V =
