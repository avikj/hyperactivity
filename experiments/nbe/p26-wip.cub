-- the action of weakening by a type is the weakening (wkM)
subM-wk : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y) (Z : Type 1) (N : Mean Γ Z) →
  PathM (extM Γ a Y f M) Z (wact (extM Γ a Y f M) Γ (world-wk Γ a Y f M) Z N) (wkM Γ a Y f M Z N)
subM-wk Γ a Y f M Z N =
  pcat (Mean (extM Γ a Y f M) Z) (wact (extM Γ a Y f M) Γ (world-wk Γ a Y f M) Z N)
    (sub-pull (extM Γ a Y f M) Γ Z (fst (snd (sub-wk Γ a Y f M))) (wk-car Γ a Y f M Z N)) (wkM Γ a Y f M Z N)
    (cong1 (DCube (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base (extM Γ a Y f M) Γ (fst (snd (sub-wk Γ a Y f M))))) (Mean (extM Γ a Y f M) Z)
       (λ e → sub-pull (extM Γ a Y f M) Γ Z (fst (snd (sub-wk Γ a Y f M))) e)
       (sub-carried (extM Γ a Y f M) Γ Z (sub-wk Γ a Y f M) N) (wk-car Γ a Y f M Z N)
       (carry-uniq (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z)
          (cmap-cube (lcons (e-ty a) (fst Γ)) (fst Γ) (cmap-of (lcons (e-ty a) (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ))
          (sub-base (extM Γ a Y f M) Γ (fst (snd (sub-wk Γ a Y f M)))) (snd (snd (sub-wk Γ a Y f M)))
          (cmap-d (lcons (e-ty a) (fst Γ)) (fst Γ) (cmap-of (lcons (e-ty a) (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
          (wk-car Γ a Y f M Z N) (wk-D Γ a Y f M Z N)))
    (pcat (Mean (extM Γ a Y f M) Z) (sub-pull (extM Γ a Y f M) Γ Z (fst (snd (sub-wk Γ a Y f M))) (wk-car Γ a Y f M Z N))
       (dcube-fmap (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (λ x' → FbE (fst Γ) Z (fst x')) (FbE (lcons (e-ty a) (fst Γ)) Z) (λ x z ρ → z (fst ρ)) (snd (extM Γ a Y f M))
          (dcube-unreidx (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ x → fst x) (snd (extM Γ a Y f M)) (wk-E1 Γ a Y f M Z N)))
       (wkM Γ a Y f M Z N)
       (pull-carry-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (FbE (lcons (e-ty a) (fst Γ)) Z) (FbE (fst Γ) Z)
          (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (λ γ' → (fst γ' , λ ρ → fst ρ)) (snd (extM Γ a Y f M)) (wk-E1 Γ a Y f M Z N))
       (pcat (Mean (extM Γ a Y f M) Z)
          (dcube-fmap (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (λ x' → FbE (fst Γ) Z (fst x')) (FbE (lcons (e-ty a) (fst Γ)) Z) (λ x z ρ → z (fst ρ)) (snd (extM Γ a Y f M))
             (dcube-unreidx (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ x → fst x) (snd (extM Γ a Y f M)) (wk-E1 Γ a Y f M Z N)))
          (dcube-fmap (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (λ x' → FbE (fst Γ) Z (fst x')) (FbE (lcons (e-ty a) (fst Γ)) Z) (λ x z ρ → z (fst ρ)) (snd (extM Γ a Y f M))
             (wk-R Γ a Y f M Z N))
          (wkM Γ a Y f M Z N)
          (cong1 (DCube (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (λ x' → FbE (fst Γ) Z (fst x')) (snd (extM Γ a Y f M))) (Mean (extM Γ a Y f M) Z)
             (λ R → dcube-fmap (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (λ x' → FbE (fst Γ) Z (fst x')) (FbE (lcons (e-ty a) (fst Γ)) Z) (λ x z ρ → z (fst ρ)) (snd (extM Γ a Y f M)) R)
             (dcube-unreidx (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ x → fst x) (snd (extM Γ a Y f M)) (wk-E1 Γ a Y f M Z N))
             (wk-R Γ a Y f M Z N)
             (urxi (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z) (λ x → fst x) (snd (extM Γ a Y f M)) (wk-R Γ a Y f M Z N)))
          (fmap-push (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (λ x' → FbE (fst Γ) Z (fst x')) (FbE (lcons (e-ty a) (fst Γ)) Z)
             (λ γ e → (γ , f γ e)) (λ γ e q → q) (λ x z ρ → z (fst ρ)) (snd Γ) M N)))
-- a substitution whose vertex maps are identities (sub-id's, sub-dwk's), at any base cube c: the cube of
-- its vertex substitutions (SF, the form of SubF when both skeletons have the vertex contexts X and
-- environments E), a meaning W over c reindexed along the identity and carried back along dcube-map-of
-- (idc-car), the dependent path from W to it over the vertex part of the substitution's path (idc-D),
-- and the pull of it, W again (idc-pull: pull-carry-of, urxi, fmap-id)
SF : (X : Type 1) (E : X → Type 1) → X → Type 1
-- binder names chosen not to collide: t46
SF X E γ = (sfγ0 : X) × (E γ → E sfγ0)
idc-car : (n : Nat) (X : Type 1) (E : X → Type 1) (Z : Type 1) (c : Cube n X) → DCube n X (λ γ → E γ → Z) c →
  DCube n X (λ γ → E γ → Z) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c))
idc-car n X E Z c W =
  carry n X (λ γ → E γ → Z) (cube-map n X X (λ x → x) c) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c))
    (psym (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c)
       (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c))
    (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W)
idc-D : (n : Nat) (X : Type 1) (E : X → Type 1) (Z : Type 1) (c : Cube n X) (W : DCube n X (λ γ → E γ → Z) c) →
  PathP (λ i → DCube n X (λ γ → E γ → Z)
                 (psym (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) c
                    (pcat (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c) c
                       (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c) (cube-id n X c)) i))
    W (idc-car n X E Z c W)
idc-D n X E Z c W =
  psym-d (Cube n X) (DCube n X (λ γ → E γ → Z)) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) c
    (pcat (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c) c
       (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c) (cube-id n X c))
    (idc-car n X E Z c W) W
    (pcat-d (Cube n X) (DCube n X (λ γ → E γ → Z)) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c) c
       (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c) (cube-id n X c)
       (idc-car n X E Z c W) (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W) W
       (psym-d (Cube n X) (DCube n X (λ γ → E γ → Z)) (cube-map n X X (λ x → x) c) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c))
          (psym (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c)
             (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c))
          (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W) (idc-car n X E Z c W)
          (carry-fill n X (λ γ → E γ → Z) (cube-map n X X (λ x → x) c) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c))
             (psym (Cube n X) (dcube-map n X (SF X E) X (λ γ' p → fst p) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c)) (cube-map n X X (λ x → x) c)
                (dcube-map-of n X (SF X E) X (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) c))
             (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W)))
       (reidx-id n X (λ γ → E γ → Z) c W))
idc-pull : (n : Nat) (X : Type 1) (E : X → Type 1) (Z : Type 1) (c : Cube n X) (W : DCube n X (λ γ → E γ → Z) c) →
  PathP (λ i → DCube n X (λ γ → E γ → Z) c)
    (dcube-pull n X X (SF X E) (λ γ → E γ → Z) (λ γ → E γ → Z) (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c) (idc-car n X E Z c W))
    W
idc-pull n X E Z c W =
  pcat (DCube n X (λ γ → E γ → Z) c)
    (dcube-pull n X X (SF X E) (λ γ → E γ → Z) (λ γ → E γ → Z) (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) c (dcube-of n X (SF X E) (λ γ → (γ , λ ρ → ρ)) c) (idc-car n X E Z c W))
    (dcube-fmap n X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x z ρ → z ρ) c (dcube-unreidx n X X (λ γ → E γ → Z) (λ x → x) c (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W)))
    W
    (pull-carry-of n X X (SF X E) (λ γ → E γ → Z) (λ γ → E γ → Z) (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) (λ γ → (γ , λ ρ → ρ)) c
       (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W))
    (pcat (DCube n X (λ γ → E γ → Z) c)
       (dcube-fmap n X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x z ρ → z ρ) c (dcube-unreidx n X X (λ γ → E γ → Z) (λ x → x) c (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W)))
       (dcube-fmap n X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x z ρ → z ρ) c W) W
       (cong1 (DCube n X (λ γ → E γ → Z) c) (DCube n X (λ γ → E γ → Z) c) (λ R → dcube-fmap n X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x z ρ → z ρ) c R)
          (dcube-unreidx n X X (λ γ → E γ → Z) (λ x → x) c (dcube-reidx n X X (λ γ → E γ → Z) (λ γ → E γ → Z) (λ x → x) (λ x y → y) c W)) W
          (urxi n X X (λ γ → E γ → Z) (λ x → x) c W))
       (fmap-id n X (λ γ → E γ → Z) c W))
-- the action of weakening by a dimension is the weakening (dwkM): the dimension part (cmap-skip-d, then
-- cmap-id-d under the degeneracy), then idc at the degenerate cube
subM-dwk : (Γ : CCtx) (Z : Type 1) (N : Mean Γ Z) → PathM (dext Γ) Z (wact (dext Γ) Γ (world-dwk Γ) Z N) (dwkM Γ Z N)
subM-dwk Γ Z N =
  pcat (Mean (dext Γ) Z) (wact (dext Γ) Γ (world-dwk Γ) Z N)
    (sub-pull (dext Γ) Γ Z (fst (snd (sub-dwk Γ))) (idc-car (suc (dims (fst Γ))) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd (dext Γ)) (dwkM Γ Z N))) (dwkM Γ Z N)
    (cong1 (DCube (suc (dims (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base (dext Γ) Γ (fst (snd (sub-dwk Γ))))) (Mean (dext Γ) Z)
       (λ e → sub-pull (dext Γ) Γ Z (fst (snd (sub-dwk Γ))) e) (sub-carried (dext Γ) Γ Z (sub-dwk Γ) N)
       (idc-car (suc (dims (fst Γ))) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd (dext Γ)) (dwkM Γ Z N))
       (carry-uniq (suc (dims (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z)
          (cmap-cube (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ))
          (sub-base (dext Γ) Γ (fst (snd (sub-dwk Γ)))) (snd (snd (sub-dwk Γ)))
          (cmap-d (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
          (idc-car (suc (dims (fst Γ))) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd (dext Γ)) (dwkM Γ Z N))
          (pcat-d (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (DCube (suc (dims (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z))
             (cmap-cube (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ)) (snd (dext Γ))
             (sub-base (dext Γ) Γ (fst (snd (sub-dwk Γ))))
             (pcat (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (cmap-cube (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ))
                (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ))) (snd (dext Γ))
                (cmap-skip e-dim (fst Γ) (fst Γ) (λ k → k) (CtxV (fst Γ)) (snd Γ))
                (λ i → cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ) i)))
             (psym (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (sub-base (dext Γ) Γ (fst (snd (sub-dwk Γ)))) (snd (dext Γ))
                (pcat (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (sub-base (dext Γ) Γ (fst (snd (sub-dwk Γ)))) (cube-map (suc (dims (fst Γ))) (CtxV (fst Γ)) (CtxV (fst Γ)) (λ x → x) (snd (dext Γ))) (snd (dext Γ))
                   (dcube-map-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) (snd (dext Γ)))
                   (cube-id (suc (dims (fst Γ))) (CtxV (fst Γ)) (snd (dext Γ)))))
             (cmap-d (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N) (dwkM Γ Z N)
             (idc-car (suc (dims (fst Γ))) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd (dext Γ)) (dwkM Γ Z N))
             (pcat-d (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (DCube (suc (dims (fst Γ))) (CtxV (fst Γ)) (FbE (fst Γ) Z))
                (cmap-cube (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ))
                (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ))) (snd (dext Γ))
                (cmap-skip e-dim (fst Γ) (fst Γ) (λ k → k) (CtxV (fst Γ)) (snd Γ))
                (λ i → cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ) i))
                (cmap-d (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
                (dcube-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Z) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (degen-o (CtxV (fst Γ)) (FbE (fst Γ) Z))
                   (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ)) (cmap-d (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N))
                (dwkM Γ Z N)
                (cmap-skip-d e-dim (fst Γ) (fst Γ) (λ k → k) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
                (λ i → dcube-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Z) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z)) (degen-l (CtxV (fst Γ))) (degen-o (CtxV (fst Γ)) (FbE (fst Γ) Z))
                   (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ) i) (cmap-id-d (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N i)))
             (idc-D (suc (dims (fst Γ))) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd (dext Γ)) (dwkM Γ Z N)))))
    (idc-pull (suc (dims (fst Γ))) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd (dext Γ)) (dwkM Γ Z N))
-- the identity substitution's action is the identity (cmap-id-d, then idc at Γ's cube)
subM-id : (Γ : CCtx) (Z : Type 1) (N : Mean Γ Z) → PathM Γ Z (subM Γ Γ Z (sub-id Γ) N) N
subM-id Γ Z N =
  pcat (Mean Γ Z) (subM Γ Γ Z (sub-id Γ) N)
    (sub-pull Γ Γ Z (fst (snd (sub-id Γ))) (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)) N
    (cong1 (DCube (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Γ Γ (fst (snd (sub-id Γ))))) (Mean Γ Z)
       (λ e → sub-pull Γ Γ Z (fst (snd (sub-id Γ))) e) (sub-carried Γ Γ Z (sub-id Γ) N)
       (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
       (carry-uniq (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z)
          (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ))
          (sub-base Γ Γ (fst (snd (sub-id Γ)))) (snd (snd (sub-id Γ)))
          (cmap-d (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
          (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
          (pcat-d (Cube (dims (fst Γ)) (CtxV (fst Γ))) (DCube (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z))
             (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ)) (snd Γ) (sub-base Γ Γ (fst (snd (sub-id Γ))))
             (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ))
             (psym (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (fst (snd (sub-id Γ)))) (snd Γ)
                (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (fst (snd (sub-id Γ)))) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (fst Γ)) (λ x → x) (snd Γ)) (snd Γ)
                   (dcube-map-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) (snd Γ))
                   (cube-id (dims (fst Γ)) (CtxV (fst Γ)) (snd Γ))))
             (cmap-d (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N) N
             (idc-car (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
             (cmap-id-d (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) N)
             (idc-D (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N))))
    (idc-pull (dims (fst Γ)) (CtxV (fst Γ)) (EnvV (fst Γ)) Z (snd Γ) N)
-- the identity world (each variable's meaning by subM-of and fmap-of, as world-wk's)
world-id : (Γ : CCtx) → World Γ Γ
world-id Γ =
  (λ k → k , mono-id , (λ k i → isdim (fst Γ) k) , snd (sub-id Γ) ,
   λ v → (v , (λ i → var-word (fst Γ) v) ,
          λ i → (var-shape (fst Γ) v ,
                 psym (Mean Γ (TV (var-shape (fst Γ) v)))
                   (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v)) (varCube Γ v)
                   (pcat (Mean Γ (TV (var-shape (fst Γ) v)))
                      (subM Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varCube Γ v))
                      (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd Γ) (fst (snd (sub-id Γ))))
                      (varCube Γ v)
                      (subM-of Γ Γ (TV (var-shape (fst Γ) v)) (sub-id Γ) (varM (fst Γ) v))
                      (fmap-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ → (γ , λ ρ → ρ)) (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd Γ)))
                   i)))
-- the form of the dimension variable #0
dnf-v0 : DNF
dnf-v0 = lcons (lcons (#0 , true) lnil) lnil
-- path application at the new dimension to a meaning weakened by it is the meaning read off as lines
papp-dwk : (Γ : CCtx) (Y Z : Type 1) (ℓ : Y → Line Z) (X : Mean Γ Y) →
  PathM (dext Γ) Z (papp-line (dext Γ) Y Z ℓ dnf-v0 (dwkM Γ Y X)) (dline-body Γ Y Z ℓ X)
papp-dwk Γ Y Z ℓ X =
  pcat (Mean (dext Γ) Z) (papp-line (dext Γ) Y Z ℓ dnf-v0 (dwkM Γ Y X))
    (dcube-fmap (dims (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Y)) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
       (λ L y → diag-o (CtxV (fst Γ)) (FbE (fst Γ) Z) (line-map (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) L)
          (lineo-fmap (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) L y))
       (snd (dext Γ)) (dwkM Γ Y X))
    (dline-body Γ Y Z ℓ X)
    (fmap-fmap (dims (fst Γ)) (Line (CtxV (fst Γ))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Y)) (LineO (CtxV (fst Γ)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z))) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
       (lineo-fmap (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ))
       (λ L q → diag-o (CtxV (fst Γ)) (FbE (fst Γ) Z) (line-map (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) L) q) (snd (dext Γ)) (dwkM Γ Y X))
    (fmap-reidx (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (FbE (fst Γ) Y) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Y)) (LineO (CtxV (fst Γ)) (FbE (fst Γ) Z))
       (degen-l (CtxV (fst Γ))) (degen-o (CtxV (fst Γ)) (FbE (fst Γ) Y))
       (λ L y → diag-o (CtxV (fst Γ)) (FbE (fst Γ) Z) (line-map (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) L)
          (lineo-fmap (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) L y))
       (snd Γ) X)
-- (2026-11-12, (6) toward rr; revised F2) path application over degenerate lines commutes with fibrewise
-- maps (papp-ex-fmap, by the recursion of papp-ex, as papp-ex-pull but with no base path: fmap-sw where
-- two fibrewise maps agree pointwise, the connections' inner hypothesis at the fibres DL), so path
-- application to a meaning read off as lines is natural in the values (papp-line-fmap); reflect at
-- PathP reads the type's computability at a path's instances through it. The statement for an
-- operation op: DDFmap; a fibrewise map of the fibres' lines over degenerate lines: dlf.
dlf : (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (x : X) → DL X F x → DL X F' x
dlf X F F' h x q = lineo-fmap X F F' h (degen-l X x) q
-- two composites of fibrewise maps that agree pointwise (q, judgmental where used)
fmap-sw : (n : Nat) (X : Type 1) (F1 G1 F2 G2 : X → Type 1) (k1 : (x : X) → F1 x → G1 x) (h : (x : X) → G1 x → G2 x)
  (h' : (x : X) → F1 x → F2 x) (k2 : (x : X) → F2 x → G2 x)
  (q : PathP (λ i → (xq : X) → F1 xq → G2 xq) (λ xq zq → h xq (k1 xq zq)) (λ xq zq → k2 xq (h' xq zq))) (c : Cube n X) (d : DCube n X F1 c) →
  PathP (λ i → DCube n X G2 c) (dcube-fmap n X G1 G2 h c (dcube-fmap n X F1 G1 k1 c d)) (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
fmap-sw n X F1 G1 F2 G2 k1 h h' k2 q c d =
  pcat (DCube n X G2 c) (dcube-fmap n X G1 G2 h c (dcube-fmap n X F1 G1 k1 c d)) (dcube-fmap n X F1 G2 (λ x z → h x (k1 x z)) c d)
    (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
    (fmap-fmap n X F1 G1 G2 k1 h c d)
    (pcat (DCube n X G2 c) (dcube-fmap n X F1 G2 (λ x z → h x (k1 x z)) c d) (dcube-fmap n X F1 G2 (λ x z → k2 x (h' x z)) c d)
       (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d))
       (λ i → dcube-fmap n X F1 G2 (q i) c d)
       (psym (DCube n X G2 c) (dcube-fmap n X F2 G2 k2 c (dcube-fmap n X F1 F2 h' c d)) (dcube-fmap n X F1 G2 (λ x z → k2 x (h' x z)) c d) (fmap-fmap n X F1 F2 G2 h' k2 c d)))
DDFmap : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube n X) (d : DCube n X (DL X F) c) → Type 1
DDFmap n op X F F' h c d =
  PathP (λ i → DCube n X F' c) (dcube-fmap n X F F' h c (op X F c d)) (op X F' c (dcube-fmap n X (DL X F) (DL X F') (dlf X F F' h) c d))
diag-dd-fmap : (sk : Lst Entry) (k : Word) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → diag-dd sk k Z H G q) X F F' h c d
diag-dd-fmap lnil k X F F' h c d = λ i → h c (fst d)
diag-dd-fmap (lcons (e-ty s) sk) k X F F' h c d =
  bool-elim1 (λ b → DDFmap (dims sk) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b) X F F' h c d)
    (fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst q) h (dlf X F F' h) (λ x q → fst q) (λ i x q → h x (fst q)) c d)
    (diag-dd-fmap sk (%wsub k #1) X F F' h c d) (weq k #0)
diag-dd-fmap (lcons e-dim sk) k X F F' h c d =
  bool-elim1 (λ b → DDFmap (suc (dims sk)) (λ Z H G q → bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
                     (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
                     (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
                        (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b)
                   X F F' h c d)
    (fmap-sw (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (LineO X (DL X F')) (LineO X F')
       (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) (lineo-fmap X F F' h) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h))
       (λ L q → diag-o X F' (line-map X (Line X) (degen-l X) L) q)
       (λ i L q → diag-o X F' (line-map X (Line X) (degen-l X) L) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h) L q)) c d)
    (pcat (DCube (dims sk) (Line X) (LineO X F') c)
       (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c
          (diag-dd sk (%wsub k #1) (Line X) (LineO X F) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X F)) (DL (Line X) (LineO X F')) (dlf (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h)) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F')) (DL (Line X) (LineO X F')) (λ L q → exch-o X F' (line-map X (Line X) (degen-l X) L) q) c
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X (DL X F')) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h)) c d)))
       (diag-dd-fmap sk (%wsub k #1) (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h) c
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) c d))
       (λ i → diag-dd sk (%wsub k #1) (Line X) (LineO X F') c
          (fmap-sw (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X (DL X F')) (DL (Line X) (LineO X F'))
             (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (dlf (Line X) (LineO X F) (LineO X F') (lineo-fmap X F F' h))
             (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h)) (λ L q → exch-o X F' (line-map X (Line X) (degen-l X) L) q)
             (λ t L q → exch-o X F' (line-map X (Line X) (degen-l X) L) (lineo-fmap X (DL X F) (DL X F') (dlf X F F' h) L q)) c d i)))
    (weq k #0)
papp-ex-fmap : (sk : Lst Entry) (cd : IEx) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → papp-ex sk Z H cd G q) X F F' h c d
papp-ex-fmap sk ix1 X F F' h c d = fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst (snd q)) h (dlf X F F' h) (λ x q → fst (snd q)) (λ i x q → h x (fst (snd q))) c d
papp-ex-fmap sk (ixv k) X F F' h c d = diag-dd-fmap sk k X F F' h c d
papp-ex-fmap sk (ixneg x) X F F' h c d =
  pcat (DCube (dims sk) X F' c) (dcube-fmap (dims sk) X F F' h c (papp-ex sk X F x c (dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) c d)))
    (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) c d)))
    (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F') (DL X F') (λ x q → rev-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)))
    (papp-ex-fmap sk x X F F' h c (dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) c d))
    (cong1 (DCube (dims sk) X (DL X F') c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c w) (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X F) (λ x q → rev-o X F (degen-l X x) q) c d)) (dcube-fmap (dims sk) X (DL X F') (DL X F') (λ x q → rev-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)) (fmap-sw (dims sk) X (DL X F) (DL X F) (DL X F') (DL X F') (λ x q → rev-o X F (degen-l X x) q) (dlf X F F' h) (dlf X F F' h) (λ x q → rev-o X F' (degen-l X x) q) (λ t x q → rev-o X F' (degen-l X x) (dlf X F F' h x q)) c d))
papp-ex-fmap sk (ixmeet x y) X F F' h c d =
  pcat (DCube (dims sk) X F' c) (dcube-fmap (dims sk) X F F' h c (papp-ex sk X F x c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → meet-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
    (papp-ex-fmap sk x X F F' h c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))
    (pcat (DCube (dims sk) X F' c) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → meet-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
       (cong1 (DCube (dims sk) X (DL X F') c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c w) (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d))) (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d))) (papp-ex-fmap sk y X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)))
       (cong1 (DCube (dims sk) X (DL X (DL X F')) c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c (papp-ex sk X (DL X F') y c w)) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) c d)) (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → meet-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)) (fmap-sw (dims sk) X (DL X F) (DL X (DL X F)) (DL X F') (DL X (DL X F')) (λ x q → meet-o X F (degen-l X x) q) (dlf X (DL X F) (DL X F') (dlf X F F' h)) (dlf X F F' h) (λ x q → meet-o X F' (degen-l X x) q) (λ t x q → meet-o X F' (degen-l X x) (dlf X F F' h x q)) c d)))
papp-ex-fmap sk (ixjoin x y) X F F' h c d =
  pcat (DCube (dims sk) X F' c) (dcube-fmap (dims sk) X F F' h c (papp-ex sk X F x c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → join-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
    (papp-ex-fmap sk x X F F' h c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))
    (pcat (DCube (dims sk) X F' c) (papp-ex sk X F' x c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))) (papp-ex sk X F' x c (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → join-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d))))
       (cong1 (DCube (dims sk) X (DL X F') c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c w) (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c (papp-ex sk X (DL X F) y c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d))) (papp-ex sk X (DL X F') y c (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d))) (papp-ex-fmap sk y X (DL X F) (DL X F') (dlf X F F' h) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)))
       (cong1 (DCube (dims sk) X (DL X (DL X F')) c) (DCube (dims sk) X F' c) (λ w → papp-ex sk X F' x c (papp-ex sk X (DL X F') y c w)) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F')) (dlf X (DL X F) (DL X F') (dlf X F F' h)) c (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → join-o X F (degen-l X x) q) c d)) (dcube-fmap (dims sk) X (DL X F') (DL X (DL X F')) (λ x q → join-o X F' (degen-l X x) q) c (dcube-fmap (dims sk) X (DL X F) (DL X F') (dlf X F F' h) c d)) (fmap-sw (dims sk) X (DL X F) (DL X (DL X F)) (DL X F') (DL X (DL X F')) (λ x q → join-o X F (degen-l X x) q) (dlf X (DL X F) (DL X F') (dlf X F F' h)) (dlf X F F' h) (λ x q → join-o X F' (degen-l X x) q) (λ t x q → join-o X F' (degen-l X x) (dlf X F F' h x q)) c d)))
papp-ex-fmap sk cd X F F' h c d = fmap-sw (dims sk) X (DL X F) F (DL X F') F' (λ x q → fst q) h (dlf X F F' h) (λ x q → fst q) (λ i x q → h x (fst q)) c d
papp-dd-fmap : (sk : Lst Entry) (fm : DNF) (X : Type 1) (F F' : X → Type 1) (h : (x : X) → F x → F' x) (c : Cube (dims sk) X) (d : DCube (dims sk) X (DL X F) c) →
  DDFmap (dims sk) (λ Z H G q → papp-dd sk Z H fm G q) X F F' h c d
papp-dd-fmap sk fm X F F' h c d = papp-ex-fmap sk (dnf-ix fm) X F F' h c d
-- path application to a meaning read off as lines is natural in the values: a pointwise map after it is
-- path application to the lines mapped (the fibre maps through fline agree judgmentally: fmap-fmap)
papp-line-fmap : (Γ : CCtx) (Y Z Z' : Type 1) (ℓ : Y → Line Z) (k : Z → Z') (f : DNF) (X : Mean Γ Y) →
  PathM Γ Z' (fmapM Γ Z Z' k (papp-line Γ Y Z ℓ f X)) (papp-line Γ Y Z' (λ y → line-map Z Z' k (ℓ y)) f X)
papp-line-fmap Γ Y Z Z' ℓ k f X =
  pcat (Mean Γ Z') (fmapM Γ Z Z' k (papp-line Γ Y Z ℓ f X))
    (papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z') f (snd Γ)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z')) (dlf (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → k (e ρ))) (snd Γ)
          (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) (snd Γ) X)))
    (papp-line Γ Y Z' (λ y → line-map Z Z' k (ℓ y)) f X)
    (papp-dd-fmap (fst Γ) f (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → k (e ρ)) (snd Γ)
       (dcube-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (fline (fst Γ) Y Z ℓ) (snd Γ) X))
    (λ i → papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z') f (snd Γ)
       (fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z'))
          (fline (fst Γ) Y Z ℓ) (dlf (CtxV (fst Γ)) (FbE (fst Γ) Z) (FbE (fst Γ) Z') (λ γ e ρ → k (e ρ))) (snd Γ) X i))

-- ---------------------------------------------------------------- F2: the De Morgan coherence of papp-ex
-- (2026-11-12, F2) Path application over degenerate lines (papp-ex) respects the equations of the De
-- Morgan algebra, each as a path in one fibre type DCube n X F G over a fixed base. Two fibre directions
-- over one base point are a square in the fibre (DL X (DL X F)); its generators fibrewise: exchange
-- (dexch), diagonal (ddiag), and degen-o (a fibre point as a degenerate line). (F2a) at variables:
-- diag-dd at two indices commutes after exchange (ddv-exch), diag-dd twice at one index is diag-dd of
-- the diagonal (ddv-diag), diag-dd of a degenerate line is its point (ddv-deg); each by the cases of
-- diag-dd at each entry, its fibrewise naturality (diag-dd-fmap), composites of fibrewise maps that
-- agree judgmentally pointwise (fmap-sw21 … fmap-sw2i), and at a successor index the hypothesis.
dexch : (X : Type 1) (F : X → Type 1) (x : X) → DL X (DL X F) x → DL X (DL X F) x
dexch X F x q = exch-o X F (degen-l (Line X) (degen-l X x)) q
ddiag : (X : Type 1) (F : X → Type 1) (x : X) → DL X (DL X F) x → DL X F x
ddiag X F x q = diag-o X F (degen-l (Line X) (degen-l X x)) q
-- diag-dd's two steps at a dimension entry, fibrewise over a line of the base
dxo : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X (DL X F) L → DL (Line X) (LineO X F) L
dxo X F L q = exch-o X F (line-map X (Line X) (degen-l X) L) q
dgo : (X : Type 1) (F : X → Type 1) (L : Line X) → LineO X (DL X F) L → LineO X F L
dgo X F L q = diag-o X F (line-map X (Line X) (degen-l X) L) q
-- composites of fibrewise maps agreeing pointwise (q: judgmental where used), by induction on n
fmap-sw21 : (n : Nat) (X : Type 1) (F0 F1 F2 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (k : (x : X) → F0 x → F2 x)
  (q : PathP (λ i → (x : X) → F0 x → F2 x) (λ x y → h1 x (h0 x y)) k) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F2 c) (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)) (dcube-fmap n X F0 F2 k c d)
fmap-sw21 zero X F0 F1 F2 h0 h1 k q c d = λ i → q i c d
fmap-sw21 (suc n) X F0 F1 F2 h0 h1 k q c d =
  fmap-sw21 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1) (lineo-fmap X F0 F2 k)
    (λ i L y → lineo-fmap X F0 F2 (q i) L y) c d
fmap-sw2i : (n : Nat) (X : Type 1) (F0 F1 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F0 x)
  (q : PathP (λ i → (x : X) → F0 x → F0 x) (λ x y → h1 x (h0 x y)) (λ x y → y)) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F0 c) (dcube-fmap n X F1 F0 h1 c (dcube-fmap n X F0 F1 h0 c d)) d
fmap-sw2i zero X F0 F1 h0 h1 q c d = λ i → q i c d
fmap-sw2i (suc n) X F0 F1 h0 h1 q c d =
  fmap-sw2i n (Line X) (LineO X F0) (LineO X F1) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F0 h1) (λ i L y → lineo-fmap X F0 F0 (q i) L y) c d
fmap-sw23 : (n : Nat) (X : Type 1) (F0 F1 F2 G1 G2 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x)
  (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → G2 x) (k2 : (x : X) → G2 x → F2 x)
  (q : PathP (λ i → (x : X) → F0 x → F2 x) (λ x y → h1 x (h0 x y)) (λ x y → k2 x (k1 x (k0 x y)))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F2 c) (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d))
    (dcube-fmap n X G2 F2 k2 c (dcube-fmap n X G1 G2 k1 c (dcube-fmap n X F0 G1 k0 c d)))
fmap-sw23 zero X F0 F1 F2 G1 G2 h0 h1 k0 k1 k2 q c d = λ i → q i c d
fmap-sw23 (suc n) X F0 F1 F2 G1 G2 h0 h1 k0 k1 k2 q c d =
  fmap-sw23 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X G1) (LineO X G2) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 G2 k1) (lineo-fmap X G2 F2 k2) (λ i L y → lineo-fmap X F0 F2 (q i) L y) c d
fmap-sw32 : (n : Nat) (X : Type 1) (F0 F1 F2 F3 G1 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (h2 : (x : X) → F2 x → F3 x)
  (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → F3 x)
  (q : PathP (λ i → (x : X) → F0 x → F3 x) (λ x y → h2 x (h1 x (h0 x y))) (λ x y → k1 x (k0 x y))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F3 c) (dcube-fmap n X F2 F3 h2 c (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)))
    (dcube-fmap n X G1 F3 k1 c (dcube-fmap n X F0 G1 k0 c d))
fmap-sw32 zero X F0 F1 F2 F3 G1 h0 h1 h2 k0 k1 q c d = λ i → q i c d
fmap-sw32 (suc n) X F0 F1 F2 F3 G1 h0 h1 h2 k0 k1 q c d =
  fmap-sw32 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X F3) (LineO X G1) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F2 F3 h2) (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 F3 k1) (λ i L y → lineo-fmap X F0 F3 (q i) L y) c d
fmap-sw33 : (n : Nat) (X : Type 1) (F0 F1 F2 F3 G1 G2 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (h2 : (x : X) → F2 x → F3 x)
  (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → G2 x) (k2 : (x : X) → G2 x → F3 x)
  (q : PathP (λ i → (x : X) → F0 x → F3 x) (λ x y → h2 x (h1 x (h0 x y))) (λ x y → k2 x (k1 x (k0 x y)))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F3 c) (dcube-fmap n X F2 F3 h2 c (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)))
    (dcube-fmap n X G2 F3 k2 c (dcube-fmap n X G1 G2 k1 c (dcube-fmap n X F0 G1 k0 c d)))
fmap-sw33 zero X F0 F1 F2 F3 G1 G2 h0 h1 h2 k0 k1 k2 q c d = λ i → q i c d
fmap-sw33 (suc n) X F0 F1 F2 F3 G1 G2 h0 h1 h2 k0 k1 k2 q c d =
  fmap-sw33 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X F3) (LineO X G1) (LineO X G2) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F2 F3 h2) (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 G2 k1) (lineo-fmap X G2 F3 k2) (λ i L y → lineo-fmap X F0 F3 (q i) L y) c d
-- the two booleans' dependent eliminator
bool-elim1-2 : (P : Bool → Bool → Type 1) → P true true → P true false → P false true → P false false → (a b : Bool) → P a b
bool-elim1-2 P tt tf ft ff true true = tt
bool-elim1-2 P tt tf ft ff true false = tf
bool-elim1-2 P tt tf ft ff false true = ft
bool-elim1-2 P tt tf ft ff false false = ff
-- diag-dd at a type entry and at a dimension entry, the index's test at 0 given as b (diag-dd at the
-- entry is the instance at weq k #0 judgmentally)
dd-ty-op : (sk : Lst Entry) (k : Word) (b : Bool) (Z : Type 1) (H : Z → Type 1) (G : Cube (dims sk) Z) → DCube (dims sk) Z (DL Z H) G → DCube (dims sk) Z H G
dd-ty-op sk k b Z H G q = bool-elim1 (λ b' → DCube (dims sk) Z H G) (dcube-fmap (dims sk) Z (DL Z H) H (λ x q' → fst q') G q) (diag-dd sk (%wsub k #1) Z H G q) b
dd-dim-op : (sk : Lst Entry) (k : Word) (b : Bool) (Z : Type 1) (H : Z → Type 1) (G : Cube (suc (dims sk)) Z) → DCube (suc (dims sk)) Z (DL Z H) G → DCube (suc (dims sk)) Z H G
dd-dim-op sk k b Z H G q =
  bool-elim1 (λ b' → DCube (dims sk) (Line Z) (LineO Z H) G)
    (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (LineO Z H) (λ L q' → diag-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)
    (diag-dd sk (%wsub k #1) (Line Z) (LineO Z H) G
       (dcube-fmap (dims sk) (Line Z) (LineO Z (DL Z H)) (DL (Line Z) (LineO Z H)) (λ L q' → exch-o Z H (line-map Z (Line Z) (degen-l Z) L) q') G q)) b
-- the statements for operations op, op1, op2 on cubes of lines over degenerate lines
DDExch : (n : Nat) (op1 op2 : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F : X → Type 1) (G : Cube n X) (d : DCube n X (DL X (DL X F)) G) → Type 1
DDExch n op1 op2 X F G d =
  PathP (λ i → DCube n X F G) (op1 X F G (op2 X (DL X F) G d))
    (op2 X F G (op1 X (DL X F) G (dcube-fmap n X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
DDDiag : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F : X → Type 1) (G : Cube n X) (d : DCube n X (DL X (DL X F)) G) → Type 1
DDDiag n op X F G d =
  PathP (λ i → DCube n X F G) (op X F G (op X (DL X F) G d)) (op X F G (dcube-fmap n X (DL X (DL X F)) (DL X F) (ddiag X F) G d))
DDDeg : (n : Nat) (op : (Z : Type 1) (H : Z → Type 1) (G : Cube n Z) → DCube n Z (DL Z H) G → DCube n Z H G)
  (X : Type 1) (F : X → Type 1) (G : Cube n X) (d : DCube n X F G) → Type 1
DDDeg n op X F G d = PathP (λ i → DCube n X F G) (op X F G (dcube-fmap n X F (DL X F) (degen-o X F) G d)) d
-- exchange at variables
ddv-exch-dim-tf : (sk : Lst Entry) (k j : Word) (X : Type 1) (F : X → Type 1) (G : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X (DL X (DL X F)) G) →
  DDExch (suc (dims sk)) (dd-dim-op sk k true) (dd-dim-op sk j false) X F G d
