    (skip-d e sk' X F (cmap-cube sk' sk (cmap-of sk' sk r) X c) (cmap-d sk' sk (cmap-of sk' sk r) X F c d))
cmap-skip-d e sk' lnil r X F c d = skip-const-d e sk' X F c d
cmap-skip-d e sk' (lcons (e-ty a) sk) r X F c d = cmap-skip-d e sk' sk (λ k → r (%wsucc k)) X F c d
