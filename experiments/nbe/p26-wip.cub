             (reidx-push-d (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (λ x' → FbE (fst Γ) Z (fst x')) (FbE (fst Γ) Z)
                (λ γ e → (γ , f γ e)) (λ γ e q → q) (λ x → fst x) (λ x' q → q) (snd Γ) M N)
