       (λ i → diag-sk sk' (hr (fst l) (~ i)) X (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) (Line X) (rev-l X) c (~ i))) (cmap-diag sk' sk r dp (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))
       (diag-sk-d sk' (%wadd (r0 (fst l)) o) X F (cube-map (dims sk') (Line X) (Line X) (rev-l X) (cco sk' sk r (Line X) c)) (dcube-reidx (dims sk') (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) (cco sk' sk r (Line X) c) (ccd sk' sk r (Line X) (LineO X F) c d)))
       (diag-sk-d sk' (r (%wadd (fst l) o)) X F (cco sk' sk r (Line X) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)) (ccd sk' sk r (Line X) (LineO X F) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
       (ccd sk' sk r X F (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)) (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
       (λ i → diag-sk-d sk' (hr (fst l) (~ i)) X F (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) (Line X) (rev-l X) c (~ i)) (cmap-nat-d sk' sk (cmap-of sk' sk r) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d (~ i)))
