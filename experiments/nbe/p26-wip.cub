       (skip-diag (e-ty s) sk' sk r f ih n X c) (λ i → f X (diag-ty-s sk s n X c (~ i)))
       (diag-sk-d (lcons (e-ty s) sk') (%wsucc (r n)) X F (f (Line X) c) (fd (Line X) (LineO X F) c d)) (fd X F (diag-sk sk n X c) (diag-sk-d sk n X F c d))
       (fd X F (diag-sk (lcons (e-ty s) sk) (%wsucc n) X c) (diag-sk-d (lcons (e-ty s) sk) (%wsucc n) X F c d))
       (skip-diag-d (e-ty s) sk' sk r f fd ih ihd n X F c d)
       (λ i → fd X F (diag-ty-s sk s n X c (~ i)) (diag-ty-s-d sk s n X F c d (~ i))))
keep-diag-d e-dim sk' sk r f fd fn fnd ih ihd k X F c d =
