    (diag-lift sk (%wadd (fst l) o) X Y Z H f g c d)
    (pcat-d (Cube (dims sk) Z) (λ u → DCube (dims sk) Z H u) (diag-sk sk (%wadd (fst l) o) Z (revc (dims sk) Z (dcube-map (suc (dims sk)) X Y Z f c d))) (diag-sk sk (%wadd (fst l) o) Z (dcube-map (suc (dims sk)) X Y Z f (revc (dims sk) X c) (revd (dims sk) X Y c d))) (dcube-map (dims sk) X Y Z f (diag-sk sk (%wadd (fst l) o) X (revc (dims sk) X c)) (diag-sk-d sk (%wadd (fst l) o) X Y (revc (dims sk) X c) (revd (dims sk) X Y c d))) (λ i → diag-sk sk (%wadd (fst l) o) Z (revg (dims sk) X Y Z f c d i)) (diag-dmap sk (%wadd (fst l) o) X Y Z f (revc (dims sk) X c) (revd (dims sk) X Y c d)) (diag-sk-d sk (%wadd (fst l) o) Z H (revc (dims sk) Z (dcube-map (suc (dims sk)) X Y Z f c d)) (revd (dims sk) Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d))) (diag-sk-d sk (%wadd (fst l) o) Z H (dcube-map (suc (dims sk)) X Y Z f (revc (dims sk) X c) (revd (dims sk) X Y c d)) (dcube-lift (suc (dims sk)) X Z Y H f g (revc (dims sk) X c) (revd (dims sk) X Y c d))) (dcube-lift (dims sk) X Z Y H f g (diag-sk sk (%wadd (fst l) o) X (revc (dims sk) X c)) (diag-sk-d sk (%wadd (fst l) o) X Y (revc (dims sk) X c) (revd (dims sk) X Y c d))) (λ i → diag-sk-d sk (%wadd (fst l) o) Z H (revg (dims sk) X Y Z f c d i) (lift-gen (dims sk) (Line X) (Line X) (LineO X Y) (LineO X Y) (Line Z) (Line Z) (rev-l X) (rev-o X Y) (rev-l Z) (lineo-map X Y Z f) (lineo-map X Y Z f) (λ k L D → rev-l Z (lineo-map X Y Z f L D)) (LineO Z H) (LineO Z H) (rev-o Z H) (lineo-lift X Z Y H f g) (lineo-lift X Z Y H f g) (λ k L D → rev-o Z H (lineo-map X Y Z f L D) (lineo-lift X Z Y H f g L D)) c d i)) (diag-lift sk (%wadd (fst l) o) X Y Z H f g (revc (dims sk) X c) (revd (dims sk) X Y c d)))
    (snd l)
