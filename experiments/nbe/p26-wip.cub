-- world-keep's variables: the newest by kp-lhs and kp-rhs (their middles agree judgmentally), an
-- older one through kp-some
kp-wv : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (v' : Opt (VarP (fst Δ))) →
  (wvv' : VarP (lcons (e-ty a) (fst Δ'))) × (var-word (lcons (e-ty a) (fst Δ')) wvv' ≡ w-keep (fst w) (var-word (lcons (e-ty a) (fst Δ)) v')) ×
  PathP (λ i → ShM (kp-ctx Δ' Δ a Y h M w)) (var-shape (lcons (e-ty a) (fst Δ')) wvv' , varCube (kp-ctx Δ' Δ a Y h M w) wvv') (var-shape (lcons (e-ty a) (fst Δ)) v' , subM (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M) (TV (var-shape (lcons (e-ty a) (fst Δ)) v')) (keep-sub Δ' Δ a Y h M w) (varCube (kp-x Δ a Y h M) v'))
kp-wv Δ' Δ a Y h M w none =
  (none , (λ i → #0) , λ i → (a , pcat (Mean (kp-ctx Δ' Δ a Y h M w) (TV a)) (varCube (kp-ctx Δ' Δ a Y h M w) none) (kp-carry Δ' Δ a Y h M w (TV a) (kp-lift Δ' Δ a Y h M w (TV a) (λ x t → varM (lcons (e-ty a) (fst Δ')) none ((kp-f (fst Δ') (fst Δ) a Y h) x t)))) (subM (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M) (TV a) (keep-sub Δ' Δ a Y h M w) (varCube (kp-x Δ a Y h M) none))
     (kp-lhs Δ' Δ a Y h M w none) (kp-rhs Δ' Δ a Y h M w none) i))
kp-wv Δ' Δ a Y h M w (some v) =
  (some (fst ((snd (snd (snd (snd w)))) v)) , (λ i → %wsucc (fst (snd ((snd (snd (snd (snd w)))) v)) i)) ,
   pcat (ShM (kp-ctx Δ' Δ a Y h M w)) ((var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v))) , varCube (kp-ctx Δ' Δ a Y h M w) (some (fst ((snd (snd (snd (snd w)))) v)))) ((var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v))) , (kp-carry Δ' Δ a Y h M w (TV (var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v)))) (kp-lift Δ' Δ a Y h M w (TV (var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v)))) (λ x t → varM (lcons (e-ty a) (fst Δ')) (some (fst ((snd (snd (snd (snd w)))) v))) ((kp-f (fst Δ') (fst Δ) a Y h) x t))))) (var-shape (lcons (e-ty a) (fst Δ)) (some v) , subM (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M) (TV (var-shape (lcons (e-ty a) (fst Δ)) (some v))) (keep-sub Δ' Δ a Y h M w) (varCube (kp-x Δ a Y h M) (some v)))
     (λ i → ((var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v))) , kp-lhs Δ' Δ a Y h M w (some (fst ((snd (snd (snd (snd w)))) v))) i))
     (pcat (ShM (kp-ctx Δ' Δ a Y h M w)) ((var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v))) , (kp-carry Δ' Δ a Y h M w (TV (var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v)))) (kp-lift Δ' Δ a Y h M w (TV (var-shape (fst Δ') (fst ((snd (snd (snd (snd w)))) v)))) (λ x t → varM (lcons (e-ty a) (fst Δ')) (some (fst ((snd (snd (snd (snd w)))) v))) ((kp-f (fst Δ') (fst Δ) a Y h) x t))))) ((var-shape (fst Δ) v) , (kp-carry Δ' Δ a Y h M w (TV (var-shape (fst Δ) v)) (kp-lift Δ' Δ a Y h M w (TV (var-shape (fst Δ) v)) (λ x t ρ'' → var-at (fst Δ') (fst Δ) v x (fst t) (fst ρ''))))) (var-shape (lcons (e-ty a) (fst Δ)) (some v) , subM (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M) (TV (var-shape (lcons (e-ty a) (fst Δ)) (some v))) (keep-sub Δ' Δ a Y h M w) (varCube (kp-x Δ a Y h M) (some v))) (kp-some Δ' Δ a Y h M w v) (λ i → ((var-shape (fst Δ) v) , kp-rhs Δ' Δ a Y h M w (some v) i))))
world-keep : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) → World (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M)
world-keep Δ' Δ a Y h M w =
  (w-keep (fst w) , mono-keep (fst w) (fst (snd w)) ,
   (λ k → %welimP (λ u → isdim (lcons (e-ty a) (fst Δ')) (w-keep (fst w) u) ≡ isdim (lcons (e-ty a) (fst Δ)) u) k (λ i → false)
      (λ m hm → pcat0 Bool (isdim (lcons (e-ty a) (fst Δ')) (%wsucc ((fst w) m))) (isdim (fst Δ') ((fst w) m)) (isdim (lcons (e-ty a) (fst Δ)) (%wsucc m))
         (λ i → if weq-s0 ((fst w) m) i then false else isdim (fst Δ') (wsub-s1 ((fst w) m) i))
         (pcat0 Bool (isdim (fst Δ') ((fst w) m)) (isdim (fst Δ) m) (isdim (lcons (e-ty a) (fst Δ)) (%wsucc m)) ((fst (snd (snd w))) m) (sym (λ i → if weq-s0 m i then false else isdim (fst Δ) (wsub-s1 m i)))))) ,
   snd (keep-sub Δ' Δ a Y h M w) , kp-wv Δ' Δ a Y h M w)
-- (2026-11-12, next definitions (4r)) diagonals at an index that names no dimension are the face at 0
-- (diag-nondim); two diagonals at one index are the diagonal of the diagonal (diag-diag); diagonals
-- at two indices commute past the exchange (diag-exch). Each by induction on the skeleton with the
-- cases of weq at each entry (bool-elim1, as diag-nat), every step a cube-comp, diag-nat or the
-- hypothesis.
tf-empty : true ≡ false → Empty
tf-empty p = comp (λ i → bool-elim1 (λ b → Type) Unit Empty (p i)) (λ i → []) unit
diag-nondim : (sk : Lst Entry) (j : Word) (X : Type 1) (c : Cube (suc (dims sk)) X) → isdim sk j ≡ false →
  PathP (λ i → Cube (dims sk) X) (diag-sk sk j X c) (cube-map (dims sk) (Line X) X (face0-l X) c)
diag-nondim lnil j X c hp = λ i → face0-l X c
diag-nondim (lcons (e-ty s) sk) j X c hp =
  bool-elim1 (λ b → (if b then false else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → (Cube (dims sk) X)) (if b then (cube-map (dims sk) (Line X) X (face0-l X) c) else (diag-sk sk (%wsub j #1) X c)) (cube-map (dims sk) (Line X) X (face0-l X) c)) (λ hq i → (cube-map (dims sk) (Line X) X (face0-l X) c)) (λ hq → diag-nondim sk (%wsub j #1) X c hq) (weq j #0) hp
