    (papp-conj sk Z o cj (papp-dnf-from (lcons e-dim sk) Z (%wsucc o) e es
       (cube-map (dims sk) (Line Z) (Line (Line Z)) (join-l Z) (dcube-map (suc (dims sk)) X F Z g c d))))
    (papp-conj sk Z o cj (dcube-map (suc (dims sk)) X F Z g
       (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))
       (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d))))
    (dcube-map (dims sk) X F Z g (papp-dnf-from sk X o cj (lcons e es) c) (papp-dnf-from-d sk X F o cj (lcons e es) c d))
    (λ i → papp-conj sk Z o cj
       (pcat (Cube (suc (dims sk)) Z)
          (papp-dnf-from (lcons e-dim sk) Z (%wsucc o) e es (cube-map (dims sk) (Line Z) (Line (Line Z)) (join-l Z) (dcube-map (suc (dims sk)) X F Z g c d)))
          (papp-dnf-from (lcons e-dim sk) Z (%wsucc o) e es (dcube-map (suc (suc (dims sk))) X F Z g
             (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)))
          (dcube-map (suc (dims sk)) X F Z g
             (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))
             (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
                (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)))
          (λ j → papp-dnf-from (lcons e-dim sk) Z (%wsucc o) e es
             (dmap-gen (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (Line Z) (Line (Line Z)) (join-l X) (join-o X F) (join-l Z)
                (lineo-map X F Z g) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g))
                (λ k L D → join-l Z (lineo-map X F Z g L D)) c d j))
          (papp-dnf-from-dmap (lcons e-dim sk) X F Z g (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)) i))
    (papp-conj-dmap sk X F Z g o cj
       (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))
       (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c d)))
papp-dmap : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z) (f : DNF)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → Cube (dims sk) Z) (papp-cube sk Z f (dcube-map (suc (dims sk)) X F Z g c d)) (dcube-map (dims sk) X F Z g (papp-cube sk X f c) (papp-cube-d sk X F f c d))
papp-dmap sk X F Z g lnil c d =
  dmap-gen (dims sk) (Line X) X (LineO X F) F (Line Z) Z (face0-l X) (face0-o X F) (face0-l Z) (lineo-map X F Z g) g (λ i L D → g (fst L) (fst D)) c d
papp-dmap sk X F Z g (lcons cj cs) c d = papp-dnf-from-dmap sk X F Z g #0 cj cs c d
cmap-dmap : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
