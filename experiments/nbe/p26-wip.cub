                   (cube-map (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (λ x → fst x) (snd (extM Γ a Y f M))) (wk-Q1 Γ a Y f M))
                (wk-E1 Γ a Y f M Z N)))
