       (pcat (Cube (dims (fst Δ)) (CtxV (lcons (e-ty a) (fst Γ)))) (cube-map (dims (fst Δ)) (TotT (fst Δ) (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ x → (fst (fst (snd x)) , f (fst (fst (snd x))) (snd (snd x)))) (dcube-map (dims (fst Δ)) (TotT (fst Δ) (fst Γ) Y) (ExtV (fst Δ) (fst Γ) a Y f) (TotT (fst Δ) (fst Γ) Y) (λ x v → x) (tot-base Δ Γ Y σ M) V)) (dcube-map (dims (fst Δ)) (TotT (fst Δ) (fst Γ) Y) (ExtV (fst Δ) (fst Γ) a Y f) (CtxV (lcons (e-ty a) (fst Γ))) (λ x v → (λ x → (fst (fst (snd x)) , f (fst (fst (snd x))) (snd (snd x)))) x) (tot-base Δ Γ Y σ M) V) (sub-base Δ (extM Γ a Y f M) (sub-ext-S Δ Γ a Y f M σ V))
