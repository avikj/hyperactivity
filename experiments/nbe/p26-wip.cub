papp-ex-pull sk ix0 X X' Y F F' f g c d e =
  pull-sw (dims sk) X X' Y (DL X F) F (DL X' F') F' f (pdl X X' Y F F' f g) g (λ x q → fst q) (λ x q → fst q) (λ t x y z → g x y (fst z)) c d e
papp-dd-pull : (sk : Lst Entry) (fm : DNF) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (c : Cube (dims sk) X) (d : DCube (dims sk) X Y c) (e : DCube (dims sk) X' (DL X' F') (dcube-map (dims sk) X Y X' f c d)) →
  DDPull (dims sk) (λ Z H G q → papp-dd sk Z H fm G q) X X' Y F F' f g c d e
papp-dd-pull sk fm X X' Y F F' f g c d e = papp-ex-pull sk (dnf-ix fm) X X' Y F F' f g c d e
-- (2026-11-12, (4d) toward subM-papp) (cm) the action of a renaming's dimension part on cubes over cubes
-- (ccd) commutes with path application over degenerate lines; first its steps at a variable: diag-dd
-- at a successor, at an index naming no dimension, natural in the base, against the diagonal at the
-- same index (dd-diag-diag) and, next, past it (dd-exch)
-- (2026-11-12, (4d) toward dd-cmap) diag-dd at a successor index (as diag-ty-s, diag-dim-s)
diag-dd-ty-s : (sk : Lst Entry) (s : TyShape) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (Q : DCube (dims sk) X (DL X F) G) →
  PathP (λ i → DCube (dims sk) X F G) (diag-dd (lcons (e-ty s) sk) (%wsucc k) X F G Q) (diag-dd sk k X F G Q)
diag-dd-ty-s sk s k X F G Q = λ i →
  bool-elim1 (λ b → DCube (dims sk) X F G) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q) (diag-dd sk (wsub-s1 k i) X F G Q) (weq-s0 k i)
diag-dd-dim-s : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (suc (dims sk)) X) (Q : DCube (suc (dims sk)) X (DL X F) G) →
  PathP (λ i → DCube (suc (dims sk)) X F G) (diag-dd (lcons e-dim sk) (%wsucc k) X F G Q)
    (diag-dd sk k (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q))
diag-dd-dim-s sk k X F G Q = λ i →
  bool-elim1 (λ b → DCube (dims sk) (Line X) (LineO X F) G) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) G Q)
    (diag-dd sk (wsub-s1 k i) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) (weq-s0 k i)
-- diag-dd at an index naming no dimension is the fibre lines' ends at 0 (as diag-nondim)
dd-nondim : (sk : Lst Entry) (j : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (Q : DCube (dims sk) X (DL X F) G) → isdim sk j ≡ false →
  PathP (λ i → DCube (dims sk) X F G) (diag-dd sk j X F G Q) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q)
dd-nondim lnil j X F G Q hp = λ i → fst Q
dd-nondim (lcons (e-ty s) sk) j X F G Q hp =
  bool-elim1 (λ b → (if b then false else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → DCube (dims sk) X F G)
                 (bool-elim1 (λ b' → DCube (dims sk) X F G) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q) (diag-dd sk (%wsub j #1) X F G Q) b) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q))
    (λ hq i → (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G Q)) (λ hq → dd-nondim sk (%wsub j #1) X F G Q hq) (weq j #0) hp
dd-nondim (lcons e-dim sk) j X F G Q hp =
  bool-elim1 (λ b → (if b then true else isdim sk (%wsub j #1)) ≡ false → PathP (λ i → (DCube (dims sk) (Line X) (LineO X F) G))
                 (bool-elim1 (λ b' → (DCube (dims sk) (Line X) (LineO X F) G)) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (λ L q → diag-o X F (line-map X (Line X) (degen-l X) L) q) G Q)
                    (diag-dd sk (%wsub j #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) b) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (lineo-fmap X (DL X F) F (λ x q → fst q)) G Q))
    (λ hq → Empty-rec {lsuc lzero} (tf-empty hq))
    (λ hq → (pcat (DCube (dims sk) (Line X) (LineO X F) G) (diag-dd sk (%wsub j #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X F)) (LineO X F) (λ x q → fst q) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q)) (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (LineO X F) (lineo-fmap X (DL X F) F (λ x q → fst q)) G Q) (dd-nondim sk (%wsub j #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) G Q) hq) (fmap-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (LineO X F) (λ L q → exch-o X F (line-map X (Line X) (degen-l X) L) q) (λ x q → fst q) G Q)))
    (weq j #0) hp
-- diag-dd is natural in a map of the base with a map of the fibres over it (dd-reidx; fmap-gen at
-- each generator, the hypothesis at the next entry)
dd-reidx : (sk : Lst Entry) (k : Word) (Z Z' : Type 1) (H : Z → Type 1) (H' : Z' → Type 1) (φ : Z → Z') (φH : (z : Z) → H z → H' (φ z))
  (G : Cube (dims sk) Z) (Q : DCube (dims sk) Z (DL Z H) G) →
  PathP (λ i → (DCube (dims sk) Z' H' (cube-map (dims sk) Z Z' φ G))) (dcube-reidx (dims sk) Z Z' H H' φ φH G (diag-dd sk k Z H G Q)) (diag-dd sk k Z' H' (cube-map (dims sk) Z Z' φ G) (dcube-reidx (dims sk) Z Z' (DL Z H) (DL Z' H') φ (λ z q → lineo-reidx Z Z' H H' φ φH (degen-l Z z) q) G Q))
