dexd-tS0 : (sk : Lst Entry) (s : TyShape) (k : Word) (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD (lcons (e-ty s) sk) (%wsucc k) #0 X F D d
dexd-tS0 sk s k X F D d =
  pc4-d (Cube (dims sk) X) (DCube (dims sk) X F)
    (diag-sk (lcons (e-ty s) sk) (%wsucc k) X (f0c (dims sk) (Line X) (exc (dims sk) X D))) (diag-sk sk k X (f0c (dims sk) (Line X) (exc (dims sk) X D))) (diag-sk sk k X (cube-map (suc (dims sk)) (Line X) X (face0-l X) D)) (f0c (dims sk) X (diag-sk sk k (Line X) D)) (f0c (dims sk) X (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D))
    (diag-ty-s sk s k X (f0c (dims sk) (Line X) (exc (dims sk) X D)))
    (λ i → diag-sk sk k X (cube-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (face0-l (Line X)) (exch-l X) D i))
    (diag-nat sk k (Line X) X (face0-l X) D)
    (λ i → f0c (dims sk) X (diag-ty-s sk s k (Line X) D (~ i)))
    (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) X F (f0c (dims sk) (Line X) (exc (dims sk) X D)) (f0d (dims sk) (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k X F (f0c (dims sk) (Line X) (exc (dims sk) X D)) (f0d (dims sk) (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k X F (cube-map (suc (dims sk)) (Line X) X (face0-l X) D) (dcube-reidx (suc (dims sk)) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) D d))
    (f0d (dims sk) X F (diag-sk sk k (Line X) D) (diag-sk-d sk k (Line X) (LineO X F) D d))
    (f0d (dims sk) X F (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) (Line X) (LineO X F) D d))
    (diag-ty-s-d sk s k X F (f0c (dims sk) (Line X) (exc (dims sk) X D)) (f0d (dims sk) (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (λ i → diag-sk-d sk k X F (cube-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (face0-l (Line X)) (exch-l X) D i) (reidx-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (LineO X F) (face0-l (Line X)) (face0-o (Line X) (LineO X F)) (exch-l X) (exch-o X F) D d i))
    (diag-nat-d sk k (Line X) X (LineO X F) F (face0-l X) (face0-o X F) D d)
    (λ i → f0d (dims sk) X F (diag-ty-s sk s k (Line X) D (~ i)) (diag-ty-s-d sk s k (Line X) (LineO X F) D d (~ i)))
dexd-tSS : (sk : Lst Entry) (s : TyShape) (k k' : Word) (ih : (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD sk k k' X F D d)
  (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD (lcons (e-ty s) sk) (%wsucc k) (%wsucc k') X F D d
dexd-tSS sk s k k' ih X F D d =
  pc5-d (Cube (dims sk) X) (DCube (dims sk) X F)
    (diag-sk (lcons (e-ty s) sk) (%wsucc k) X (diag-sk (lcons (e-ty s) sk) (%wsucc k') (Line X) (exc (dims sk) X D))) (diag-sk sk k X (diag-sk (lcons (e-ty s) sk) (%wsucc k') (Line X) (exc (dims sk) X D))) (diag-sk sk k X (diag-sk sk k' (Line X) (exc (dims sk) X D))) (diag-sk sk k' X (diag-sk sk k (Line X) D)) (diag-sk sk k' X (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D)) (diag-sk (lcons (e-ty s) sk) (%wsucc k') X (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D))
    (diag-ty-s sk s k X (diag-sk (lcons (e-ty s) sk) (%wsucc k') (Line X) (exc (dims sk) X D)))
    (λ i → diag-sk sk k X (diag-ty-s sk s k' (Line X) (exc (dims sk) X D) i))
    (diag-exch sk k k' X D)
    (λ i → diag-sk sk k' X (diag-ty-s sk s k (Line X) D (~ i)))
    (λ i → diag-ty-s sk s k' X (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D) (~ i))
    (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) X F (diag-sk (lcons (e-ty s) sk) (%wsucc k') (Line X) (exc (dims sk) X D)) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k') (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k X F (diag-sk (lcons (e-ty s) sk) (%wsucc k') (Line X) (exc (dims sk) X D)) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k') (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k X F (diag-sk sk k' (Line X) (exc (dims sk) X D)) (diag-sk-d sk k' (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (diag-sk-d sk k' X F (diag-sk sk k (Line X) D) (diag-sk-d sk k (Line X) (LineO X F) D d))
    (diag-sk-d sk k' X F (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) (Line X) (LineO X F) D d))
    (diag-sk-d (lcons (e-ty s) sk) (%wsucc k') X F (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) (Line X) (LineO X F) D d))
    (diag-ty-s-d sk s k X F (diag-sk (lcons (e-ty s) sk) (%wsucc k') (Line X) (exc (dims sk) X D)) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k') (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (λ i → diag-sk-d sk k X F (diag-ty-s sk s k' (Line X) (exc (dims sk) X D) i) (diag-ty-s-d sk s k' (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d) i))
    (ih X F D d)
    (λ i → diag-sk-d sk k' X F (diag-ty-s sk s k (Line X) D (~ i)) (diag-ty-s-d sk s k (Line X) (LineO X F) D d (~ i)))
    (λ i → diag-ty-s-d sk s k' X F (diag-sk (lcons (e-ty s) sk) (%wsucc k) (Line X) D) (diag-sk-d (lcons (e-ty s) sk) (%wsucc k) (Line X) (LineO X F) D d) (~ i))
-- the inner chains at a dimension entry (base: dex-c*, over them: dexd-c*), as written in diag-exch
