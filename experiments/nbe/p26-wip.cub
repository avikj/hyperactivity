    (cong1 (DCube (dims sk') X (DL X (DL X F)) (cco sk' sk r X G)) (DCube (dims sk') X F (cco sk' sk r X G)) (λ w → papp-ex sk' X F (ixr r x) (cco sk' sk r X G) (papp-ex sk' X (DL X F) (ixr r y) (cco sk' sk r X G) w)) (dcube-fmap (dims sk') X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) (cco sk' sk r X G) (ccd sk' sk r X (DL X F) G Q)) (ccd sk' sk r X (DL X (DL X F)) G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G Q)) (fmap-cmap sk' sk (cmap-of sk' sk r) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G Q))
