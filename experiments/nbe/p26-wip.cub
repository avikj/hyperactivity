    (cube-comp2 (dims sk) (Line (Line X)) (Line X) (Line X) X (face0-l X) (λ Q → face0-l (Line X) (exch-l X Q)) (face0-l X) (face0-l (Line X)) D (λ i → cube-map (dims sk) (Line (Line X)) X (λ Q → fst (fst Q)) D))
    (f0d (dims sk) X F (f0c (dims sk) (Line X) (exc (dims sk) X D)) (f0d (dims sk) (Line X) (LineO X F) (exc (dims sk) X D) (exd (dims sk) X F D d)))
    (f0d (dims sk) X F (cube-map (dims sk) (Line (Line X)) (Line X) (λ Q → face0-l (Line X) (exch-l X Q)) D) (dcube-reidx (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (λ Q → face0-l (Line X) (exch-l X Q)) (λ Q y → face0-o (Line X) (LineO X F) (exch-l X Q) (exch-o X F Q y)) D d))
    (f0d (dims sk) X F (f0c (dims sk) (Line X) D) (f0d (dims sk) (Line X) (LineO X F) D d))
    (λ i → f0d (dims sk) X F (cube-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (face0-l (Line X)) (exch-l X) D i) (reidx-comp (dims sk) (Line (Line X)) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (LineO X F) (face0-l (Line X)) (face0-o (Line X) (LineO X F)) (exch-l X) (exch-o X F) D d i))
    (cube-comp2-d (dims sk) (Line (Line X)) (Line X) (Line X) X (LineO (Line X) (LineO X F)) (LineO X F) (LineO X F) F (face0-l X) (face0-o X F) (λ Q → face0-l (Line X) (exch-l X Q)) (λ Q y → face0-o (Line X) (LineO X F) (exch-l X Q) (exch-o X F Q y)) (face0-l X) (face0-o X F) (face0-l (Line X)) (face0-o (Line X) (LineO X F)) D d (λ i → cube-map (dims sk) (Line (Line X)) X (λ Q → fst (fst Q)) D) (λ i → dcube-reidx (dims sk) (Line (Line X)) X (LineO (Line X) (LineO X F)) F (λ Q → fst (fst Q)) (λ Q y → fst (fst y)) D d))
dexd-t0S : (sk : Lst Entry) (s : TyShape) (k' : Word) (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD (lcons (e-ty s) sk) #0 (%wsucc k') X F D d
