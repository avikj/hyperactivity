          (fd (Line X) (LineO X F) (diag-sk sk n (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)) (diag-sk-d sk n (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d)))
