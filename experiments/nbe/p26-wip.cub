-- ---------------------------------------------------------------- P2.6e (2s): substitutions
-- (2026-11-12, next definitions (2s)) The identity, weakening by a type and by a dimension, each with
-- its path from the dimension part's action on Γ's cube to its cube's base (cmap-id, cmap-skip, and the
-- base of a cube of sections, dcube-map-of); mapping the base of a cube after mapping out of a cube
-- over it is one map out (dmap-map), and the first projection out of a cube over it is the cube
-- (dmap-fst).
dmap-map : (n : Nat) (X : Type 1) (Y : X → Type 1) (Z W : Type 1) (g : (x : X) → Y x → Z) (h : Z → W) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → Cube n W) (cube-map n Z W h (dcube-map n X Y Z g c d)) (dcube-map n X Y W (λ x y → h (g x y)) c d)
dmap-map zero X Y Z W g h c d = λ i → h (g c d)
dmap-map (suc n) X Y Z W g h c d = dmap-map n (Line X) (LineO X Y) (Line Z) (Line W) (lineo-map X Y Z g) (line-map Z W h) c d
dmap-fst : (n : Nat) (X : Type 1) (Y : X → Type 1) (c : Cube n X) (d : DCube n X Y c) → PathP (λ i → Cube n X) (dcube-map n X Y X (λ x y → x) c d) c
dmap-fst zero X Y c d = λ i → c
dmap-fst (suc n) X Y c d = dmap-fst n (Line X) (LineO X Y) c d
sub-id : (Γ : CCtx) → Sub Γ Γ
sub-id Γ =
  (cmap-of (fst Γ) (fst Γ) (λ k → k) ,
   dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (snd Γ) ,
   pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ)) (snd Γ)
     (sub-base Γ Γ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (snd Γ)))
     (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ))
     (psym (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (snd Γ))) (snd Γ)
        (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base Γ Γ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (snd Γ)))
           (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (fst Γ)) (λ x → x) (snd Γ)) (snd Γ)
           (dcube-map-of (dims (fst Γ)) (CtxV (fst Γ)) (SubF (fst Γ) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) (snd Γ))
           (cube-id (dims (fst Γ)) (CtxV (fst Γ)) (snd Γ)))))
sub-wk : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y) →
  Sub (extM Γ a Y f M) Γ
sub-wk Γ a Y f M =
  (cmap-of (lcons (e-ty a) (fst Γ)) (fst Γ) (λ k → %wsucc k) ,
   dcube-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (λ γ' → (fst γ' , λ ρ → fst ρ)) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M) ,
   pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (cmap-cube (lcons (e-ty a) (fst Γ)) (fst Γ) (cmap-of (lcons (e-ty a) (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ)) (snd Γ)
     (sub-base (extM Γ a Y f M) Γ (dcube-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (λ γ' → (fst γ' , λ ρ → fst ρ)) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M)))
     (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (cmap-cube (lcons (e-ty a) (fst Γ)) (fst Γ) (cmap-of (lcons (e-ty a) (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ))
        (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ)) (snd Γ)
        (cmap-skip (e-ty a) (fst Γ) (fst Γ) (λ k → k) (CtxV (fst Γ)) (snd Γ)) (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ)))
     (psym (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base (extM Γ a Y f M) Γ (dcube-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (λ γ' → (fst γ' , λ ρ → fst ρ)) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M))) (snd Γ)
        (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (sub-base (extM Γ a Y f M) Γ (dcube-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (λ γ' → (fst γ' , λ ρ → fst ρ)) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M)))
           (cube-map (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (λ x → fst x) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M)) (snd Γ)
           (dcube-map-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (λ γ' → (fst γ' , λ ρ → fst ρ)) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M))
           (pcat (Cube (dims (fst Γ)) (CtxV (fst Γ))) (cube-map (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (λ x → fst x) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M))
              (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (fst Γ)) (λ γ e → γ) (snd Γ) M) (snd Γ)
              (dmap-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (CtxV (fst Γ)) (λ γ e → (γ , f γ e)) (λ x → fst x) (snd Γ) M)
              (dmap-fst (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (snd Γ) M)))))
sub-dwk : (Γ : CCtx) → Sub (dext Γ) Γ
sub-dwk Γ =
  (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k) ,
   dcube-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ)) ,
   pcat (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (cmap-cube (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))
     (sub-base (dext Γ) Γ (dcube-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))))
     (pcat (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (cmap-cube (lcons e-dim (fst Γ)) (fst Γ) (cmap-of (lcons e-dim (fst Γ)) (fst Γ) (λ k → %wsucc k)) (CtxV (fst Γ)) (snd Γ))
        (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (cmap-cube (fst Γ) (fst Γ) (cmap-of (fst Γ) (fst Γ) (λ k → k)) (CtxV (fst Γ)) (snd Γ))) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))
        (cmap-skip e-dim (fst Γ) (fst Γ) (λ k → k) (CtxV (fst Γ)) (snd Γ))
        (λ i → cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (cmap-id (fst Γ) (CtxV (fst Γ)) (snd Γ) i)))
     (psym (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (sub-base (dext Γ) Γ (dcube-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ)))) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))
        (pcat (Cube (suc (dims (fst Γ))) (CtxV (fst Γ))) (sub-base (dext Γ) Γ (dcube-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (λ γ → (γ , λ ρ → ρ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))))
           (cube-map (suc (dims (fst Γ))) (CtxV (fst Γ)) (CtxV (fst Γ)) (λ x → x) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))
           (dcube-map-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (CtxV (fst Γ)) (λ γ' p → fst p) (λ γ → (γ , λ ρ → ρ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ)))
           (cube-id (suc (dims (fst Γ))) (CtxV (fst Γ)) (cube-map (dims (fst Γ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ))))))

-- (2026-11-12, next definitions (2s)) path application on cubes is natural in the base (papp-nat, by
-- the recursion of papp-cube: diag-nat at each literal, cube-comp2 at each generator), so the action of
-- a dimension part is (cmap-nat); a substitution extended by an interval form over Δ for Γ's new
-- dimension (sub-form; its path: cmap-nat at the degeneracy, then papp-deg, then the substitution's own)
papp-lit-nat : (sk : Lst Entry) (X Y : Type 1) (h : X → Y) (o : Word) (l : Lit) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → (Cube (dims sk) Y)) (papp-lit sk Y o l (cube-map (suc (dims sk)) X Y h c)) (cube-map (dims sk) X Y h (papp-lit sk X o l c))
papp-lit-nat sk X Y h o l c =
  bool-elim1 (λ b → PathP (λ i → (Cube (dims sk) Y))
                 (if b then diag-sk sk (%wadd (fst l) o) Y (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c) else diag-sk sk (%wadd (fst l) o) Y (cube-map (dims sk) (Line Y) (Line Y) (rev-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)))
                 (cube-map (dims sk) X Y h (if b then diag-sk sk (%wadd (fst l) o) X c else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))))
    (diag-nat sk (%wadd (fst l) o) X Y h c)
    (pcat (Cube (dims sk) Y) (diag-sk sk (%wadd (fst l) o) Y (cube-map (dims sk) (Line Y) (Line Y) (rev-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)))
       (diag-sk sk (%wadd (fst l) o) Y (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (cube-map (dims sk) X Y h (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (λ i → diag-sk sk (%wadd (fst l) o) Y (cube-comp2 (dims sk) (Line X) (Line Y) (Line X) (Line Y) (rev-l Y) (line-map X Y h) (line-map X Y h) (rev-l X) c
          (λ j → cube-map (dims sk) (Line X) (Line Y) (λ L → rev-l Y ((line-map X Y h) L)) c) i))
       (diag-nat sk (%wadd (fst l) o) X Y h (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
    (snd l)
papp-conj-from-nat : (sk : Lst Entry) (X Y : Type 1) (h : X → Y) (o : Word) (l : Lit) (ms : Conj) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → (Cube (dims sk) Y)) (papp-conj-from sk Y o l ms (cube-map (suc (dims sk)) X Y h c)) (cube-map (dims sk) X Y h (papp-conj-from sk X o l ms c))
papp-conj-from-nat sk X Y h o l lnil c = papp-lit-nat sk X Y h o l c
papp-conj-from-nat sk X Y h o l (lcons m ms) c =
  pcat (Cube (dims sk) Y)
    (papp-lit sk Y o l (papp-conj-from (lcons e-dim sk) Y (%wsucc o) m ms (cube-map (dims sk) (Line Y) (Line (Line Y)) (meet-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c))))
    (papp-lit sk Y o l (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h)
       (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))))
    (cube-map (dims sk) X Y h (papp-conj-from sk X o l (lcons m ms) c))
    (λ i → papp-lit sk Y o l
       (pcat (Cube (suc (dims sk)) Y)
          (papp-conj-from (lcons e-dim sk) Y (%wsucc o) m ms (cube-map (dims sk) (Line Y) (Line (Line Y)) (meet-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)))
          (papp-conj-from (lcons e-dim sk) Y (%wsucc o) m ms (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y h))
             (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
          (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h)
             (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
          (λ j → papp-conj-from (lcons e-dim sk) Y (%wsucc o) m ms
             (cube-comp2 (dims sk) (Line X) (Line Y) (Line (Line X)) (Line (Line Y)) (meet-l Y) (line-map X Y h) (line-map (Line X) (Line Y) (line-map X Y h)) (meet-l X) c
                (λ k → cube-map (dims sk) (Line X) (Line (Line Y)) (λ L → meet-l Y ((line-map X Y h) L)) c) j))
          (papp-conj-from-nat (lcons e-dim sk) X Y h (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)) i))
    (papp-lit-nat sk X Y h o l (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
papp-conj-nat : (sk : Lst Entry) (X Y : Type 1) (h : X → Y) (o : Word) (cj : Conj) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → (Cube (dims sk) Y)) (papp-conj sk Y o cj (cube-map (suc (dims sk)) X Y h c)) (cube-map (dims sk) X Y h (papp-conj sk X o cj c))
papp-conj-nat sk X Y h o lnil c =
  cube-comp2 (dims sk) (Line X) (Line Y) X Y (face1-l Y) (line-map X Y h) h (face1-l X) c (λ i → cube-map (dims sk) (Line X) Y (λ L → h (fst (snd L))) c)
papp-conj-nat sk X Y h o (lcons l ls) c = papp-conj-from-nat sk X Y h o l ls c
papp-dnf-from-nat : (sk : Lst Entry) (X Y : Type 1) (h : X → Y) (o : Word) (cj : Conj) (ds : DNF) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → (Cube (dims sk) Y)) (papp-dnf-from sk Y o cj ds (cube-map (suc (dims sk)) X Y h c)) (cube-map (dims sk) X Y h (papp-dnf-from sk X o cj ds c))
papp-dnf-from-nat sk X Y h o cj lnil c = papp-conj-nat sk X Y h o cj c
papp-dnf-from-nat sk X Y h o cj (lcons d ds) c =
  pcat (Cube (dims sk) Y)
    (papp-conj sk Y o cj (papp-dnf-from (lcons e-dim sk) Y (%wsucc o) d ds (cube-map (dims sk) (Line Y) (Line (Line Y)) (join-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c))))
    (papp-conj sk Y o cj (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h)
       (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))))
    (cube-map (dims sk) X Y h (papp-dnf-from sk X o cj (lcons d ds) c))
    (λ i → papp-conj sk Y o cj
       (pcat (Cube (suc (dims sk)) Y)
          (papp-dnf-from (lcons e-dim sk) Y (%wsucc o) d ds (cube-map (dims sk) (Line Y) (Line (Line Y)) (join-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)))
          (papp-dnf-from (lcons e-dim sk) Y (%wsucc o) d ds (cube-map (dims sk) (Line (Line X)) (Line (Line Y)) (line-map (Line X) (Line Y) (line-map X Y h))
             (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
          (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h)
             (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
          (λ j → papp-dnf-from (lcons e-dim sk) Y (%wsucc o) d ds
             (cube-comp2 (dims sk) (Line X) (Line Y) (Line (Line X)) (Line (Line Y)) (join-l Y) (line-map X Y h) (line-map (Line X) (Line Y) (line-map X Y h)) (join-l X) c
                (λ k → cube-map (dims sk) (Line X) (Line (Line Y)) (λ L → join-l Y ((line-map X Y h) L)) c) j))
          (papp-dnf-from-nat (lcons e-dim sk) X Y h (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)) i))
    (papp-conj-nat sk X Y h o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) d ds (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
papp-nat : (sk : Lst Entry) (X Y : Type 1) (h : X → Y) (f : DNF) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → (Cube (dims sk) Y)) (papp-cube sk Y f (cube-map (suc (dims sk)) X Y h c)) (cube-map (dims sk) X Y h (papp-cube sk X f c))
papp-nat sk X Y h lnil c =
  cube-comp2 (dims sk) (Line X) (Line Y) X Y (face0-l Y) (line-map X Y h) h (face0-l X) c (λ i → cube-map (dims sk) (Line X) Y (λ L → h (fst L)) c)
papp-nat sk X Y h (lcons cj cs) c = papp-dnf-from-nat sk X Y h #0 cj cs c
cmap-nat : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X Y : Type 1) (h : X → Y) (c : Cube (dims sk) X) →
  PathP (λ i → Cube (dims sk') Y) (cmap-cube sk' sk σ Y (cube-map (dims sk) X Y h c)) (cube-map (dims sk') X Y h (cmap-cube sk' sk σ X c))
cmap-nat sk' lnil σ X Y h c = psym (Cube (dims sk') Y) (cube-map (dims sk') X Y h (cube-const (dims sk') X c)) (cube-const (dims sk') Y (h c)) (const-map (dims sk') X Y h c)
cmap-nat sk' (lcons (e-ty a) sk) σ X Y h c = cmap-nat sk' sk σ X Y h c
cmap-nat sk' (lcons e-dim sk) σ X Y h c =
  pcat (Cube (dims sk') Y)
    (papp-cube sk' Y (snd σ) (cmap-cube sk' sk (fst σ) (Line Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)))
    (papp-cube sk' Y (snd σ) (cube-map (dims sk') (Line X) (Line Y) (line-map X Y h) (cmap-cube sk' sk (fst σ) (Line X) c)))
    (cube-map (dims sk') X Y h (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)))
    (λ i → papp-cube sk' Y (snd σ) (cmap-nat sk' sk (fst σ) (Line X) (Line Y) (line-map X Y h) c i))
    (papp-nat sk' X Y h (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c))
sub-form : (Δ Γ : CCtx) → Sub Δ Γ → DNF → Sub Δ (dext Γ)
sub-form Δ Γ σ g =
  ((fst σ , g) , fst (snd σ) ,
   pcat (Cube (dims (fst Δ)) (CtxV (fst Γ)))
     (cmap-cube (fst Δ) (lcons e-dim (fst Γ)) (fst σ , g) (CtxV (fst Γ)) (snd (dext Γ)))
     (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ)))
     (pcat (Cube (dims (fst Δ)) (CtxV (fst Γ)))
        (cmap-cube (fst Δ) (lcons e-dim (fst Γ)) (fst σ , g) (CtxV (fst Γ)) (snd (dext Γ)))
        (papp-cube (fst Δ) (CtxV (fst Γ)) g (cube-map (dims (fst Δ)) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ)))
           (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))))
        (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))
        (λ i → papp-cube (fst Δ) (CtxV (fst Γ)) g (cmap-nat (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (Line (CtxV (fst Γ))) (degen-l (CtxV (fst Γ))) (snd Γ) i))
        (papp-deg (fst Δ) (CtxV (fst Γ)) g (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ))))
     (snd (snd σ)))
-- (2026-11-12, next definitions (2s), toward sub-ext) the filler of carry; a map out of a constant cube
-- over a constant cube (dmap-const-cube); a map out of a cube pulled back along a pairing is a map out
-- over the pushed base, when the two maps agree pointwise (map-pull, q judgmental where used: refl)
carry-fill : (n : Nat) (X : Type 1) (F : X → Type 1) (c0 c1 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1) (d : DCube n X F c0) →
  PathP (λ i → DCube n X F (p i)) d (carry n X F c0 c1 p d)
carry-fill n X F c0 c1 p d = λ i → comp (λ j → DCube n X F (p (i ∧ j))) (λ j → [ i = 0 ↦ d ]) d
dmap-const-cube : (n : Nat) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z) (x : X) (y : F x) →
  PathP (λ i → Cube n Z) (dcube-map n X F Z g (cube-const n X x) (dcube-const n X F x y)) (cube-const n Z (g x y))
dmap-const-cube zero X F Z g x y = λ i → g x y
dmap-const-cube (suc n) X F Z g x y = dmap-const-cube n (Line X) (LineO X F) (Line Z) (lineo-map X F Z g) (degen-l X x) (degen-o X F x y)
map-pull : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F' (f x y) → F x)
  (Z : Type 1) (k : (x : X) → F x → Z) (k' : (x' : X') → F' x' → Z)
  (q : PathP (λ i → (x : X) (y : Y x) → F' (f x y) → Z) (λ x y e → k x (g x y e)) (λ x y e → k' (f x y) e))
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → Cube n Z) (dcube-map n X F Z k c (dcube-pull n X X' Y F F' f g c d e)) (dcube-map n X' F' Z k' (dcube-map n X Y X' f c d) e)
map-pull zero X X' Y F F' f g Z k k' q c d e = λ i → q i c d e
map-pull (suc n) X X' Y F F' f g Z k k' q c d e =
  map-pull n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g)
    (Line Z) (lineo-map X F Z k) (lineo-map X' F' Z k')
    (λ i L D E → (q i (fst L) (fst D) (fst E) , q i (fst (snd L)) (fst (snd D)) (fst (snd E)) , λ j → q i (snd (snd L) j) (snd (snd D) j) (snd (snd E) j)))
    c d e

-- (2026-11-12, next definitions (2s), toward sub-ext) a map out of a cube over a cube commutes with the
-- cube category's generators: mapping the base after mapping out is mapping out of the reindexed cube,
-- when the two maps agree pointwise (dmap-gen, q judgmental where used); so path application, by the
-- recursion of papp-cube (diag-dmap at each literal), and the action of a dimension part (cmap-dmap)
dmap-gen : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (Z Z' : Type 1) (f : X → X') (fo : (x : X) → F x → F' (f x))
  (h : Z → Z') (g : (x : X) → F x → Z) (g' : (x' : X') → F' x' → Z')
  (q : PathP (λ i → (xq : X) (yq : F xq) → Z') (λ xq yq → h (g xq yq)) (λ xq yq → g' (f xq) (fo xq yq))) (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → Cube n Z') (cube-map n Z Z' h (dcube-map n X F Z g c d)) (dcube-map n X' F' Z' g' (cube-map n X X' f c) (dcube-reidx n X X' F F' f fo c d))
dmap-gen zero X X' F F' Z Z' f fo h g g' q c d = λ i → q i c d
dmap-gen (suc n) X X' F F' Z Z' f fo h g g' q c d =
  dmap-gen n (Line X) (Line X') (LineO X F) (LineO X' F') (Line Z) (Line Z') (line-map X X' f) (lineo-reidx X X' F F' f fo)
    (line-map Z Z' h) (lineo-map X F Z g) (lineo-map X' F' Z' g')
    (λ i L D → (q i (fst L) (fst D) , q i (fst (snd L)) (fst (snd D)) , λ j → q i (snd (snd L) j) (snd (snd D) j))) c d
diag-dmap : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → Cube (dims sk) Z) (diag-sk sk k Z (dcube-map (suc (dims sk)) X F Z g c d)) (dcube-map (dims sk) X F Z g (diag-sk sk k X c) (diag-sk-d sk k X F c d))
diag-dmap lnil k X F Z g c d = λ i → g (fst c) (fst d)
diag-dmap (lcons (e-ty s) sk) k X F Z g c d =
  bool-elim1 (λ b → PathP (λ i → Cube (dims sk) Z)
                 (if b then cube-map (dims sk) (Line Z) Z (face0-l Z) (dcube-map (dims sk) (Line X) (LineO X F) (Line Z) (lineo-map X F Z g) c d)
                  else diag-sk sk (%wsub k #1) Z (dcube-map (dims sk) (Line X) (LineO X F) (Line Z) (lineo-map X F Z g) c d))
                 (dcube-map (dims sk) X F Z g (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c)
                    (bool-elim1 (λ b → DCube (dims sk) X F (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c))
                       (dcube-reidx (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) c d)
                       (diag-sk-d sk (%wsub k #1) X F c d) b)))
    (dmap-gen (dims sk) (Line X) X (LineO X F) F (Line Z) Z (face0-l X) (face0-o X F) (face0-l Z) (lineo-map X F Z g) g (λ i L D → g (fst L) (fst D)) c d)
    (diag-dmap sk (%wsub k #1) X F Z g c d) (weq k #0)
diag-dmap (lcons e-dim sk) k X F Z g c d =
  bool-elim1 (λ b → PathP (λ i → Cube (suc (dims sk)) Z)
                 (if b then cube-map (dims sk) (Line (Line Z)) (Line Z) (diag-l Z)
                              (dcube-map (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) (Line (Line Z)) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g)) c d)
                  else diag-sk sk (%wsub k #1) (Line Z) (cube-map (dims sk) (Line (Line Z)) (Line (Line Z)) (exch-l Z)
                              (dcube-map (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) (Line (Line Z)) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g)) c d)))
                 (dcube-map (suc (dims sk)) X F Z g
                    (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c
                     else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))
                    (bool-elim1 (λ b → DCube (suc (dims sk)) X F
                                   (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c
                                    else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
                       (dcube-reidx (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) c d)
                       (diag-sk-d sk (%wsub k #1) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)
                          (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d))
                       b)))
    (dmap-gen (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (Line (Line Z)) (Line Z) (diag-l X) (diag-o X F) (diag-l Z)
       (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g)) (lineo-map X F Z g)
       (λ i Q D → diag-l Z (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g) Q D)) c d)
    (pcat (Cube (suc (dims sk)) Z)
       (diag-sk sk (%wsub k #1) (Line Z) (cube-map (dims sk) (Line (Line Z)) (Line (Line Z)) (exch-l Z)
          (dcube-map (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) (Line (Line Z)) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g)) c d)))
       (diag-sk sk (%wsub k #1) (Line Z)
          (dcube-map (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) (Line (Line Z)) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g))
             (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)
             (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d)))
       (dcube-map (suc (dims sk)) X F Z g
          (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))
          (diag-sk-d sk (%wsub k #1) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)
             (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d)))
       (λ i → diag-sk sk (%wsub k #1) (Line Z)
          (dmap-gen (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (Line (Line Z)) (Line (Line Z))
             (exch-l X) (exch-o X F) (exch-l Z)
             (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g)) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g))
             (λ j Q D → exch-l Z (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g) Q D)) c d i))
       (diag-dmap sk (%wsub k #1) (Line X) (LineO X F) (Line Z) (lineo-map X F Z g) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)
          (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d)))
    (weq k #0)
papp-lit-dmap : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z) (o : Word) (l : Lit)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → Cube (dims sk) Z) (papp-lit sk Z o l (dcube-map (suc (dims sk)) X F Z g c d)) (dcube-map (dims sk) X F Z g (papp-lit sk X o l c) (papp-lit-d sk X F o l c d))
papp-lit-dmap sk X F Z g o l c d =
  bool-elim1 (λ b → PathP (λ i → Cube (dims sk) Z)
                 (if b then diag-sk sk (%wadd (fst l) o) Z (dcube-map (suc (dims sk)) X F Z g c d)
                  else diag-sk sk (%wadd (fst l) o) Z (cube-map (dims sk) (Line Z) (Line Z) (rev-l Z) (dcube-map (suc (dims sk)) X F Z g c d)))
                 (dcube-map (dims sk) X F Z g
                    (if b then diag-sk sk (%wadd (fst l) o) X c
                     else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))
                    (bool-elim1 (λ b → DCube (dims sk) X F
                                   (if b then diag-sk sk (%wadd (fst l) o) X c
                                    else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
                       (diag-sk-d sk (%wadd (fst l) o) X F c d)
                       (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)
                          (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d))
                       b)))
    (diag-dmap sk (%wadd (fst l) o) X F Z g c d)
    (pcat (Cube (dims sk) Z)
       (diag-sk sk (%wadd (fst l) o) Z (cube-map (dims sk) (Line Z) (Line Z) (rev-l Z) (dcube-map (suc (dims sk)) X F Z g c d)))
       (diag-sk sk (%wadd (fst l) o) Z (dcube-map (suc (dims sk)) X F Z g (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
       (dcube-map (dims sk) X F Z g (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))
          (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
       (λ i → diag-sk sk (%wadd (fst l) o) Z
          (dmap-gen (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (Line Z) (Line Z) (rev-l X) (rev-o X F) (rev-l Z)
             (lineo-map X F Z g) (lineo-map X F Z g) (λ j L D → rev-l Z (lineo-map X F Z g L D)) c d i))
       (diag-dmap sk (%wadd (fst l) o) X F Z g (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
    (snd l)
papp-conj-from-dmap : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z) (o : Word) (l : Lit) (ms : Conj)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → Cube (dims sk) Z) (papp-conj-from sk Z o l ms (dcube-map (suc (dims sk)) X F Z g c d))
    (dcube-map (dims sk) X F Z g (papp-conj-from sk X o l ms c) (papp-conj-from-d sk X F o l ms c d))
papp-conj-from-dmap sk X F Z g o l lnil c d = papp-lit-dmap sk X F Z g o l c d
papp-conj-from-dmap sk X F Z g o l (lcons m ms) c d =
  pcat (Cube (dims sk) Z)
    (papp-lit sk Z o l (papp-conj-from (lcons e-dim sk) Z (%wsucc o) m ms
       (cube-map (dims sk) (Line Z) (Line (Line Z)) (meet-l Z) (dcube-map (suc (dims sk)) X F Z g c d))))
    (papp-lit sk Z o l (dcube-map (suc (dims sk)) X F Z g
       (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))
       (papp-conj-from-d (lcons e-dim sk) X F (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c d))))
    (dcube-map (dims sk) X F Z g (papp-conj-from sk X o l (lcons m ms) c) (papp-conj-from-d sk X F o l (lcons m ms) c d))
    (λ i → papp-lit sk Z o l
       (pcat (Cube (suc (dims sk)) Z)
          (papp-conj-from (lcons e-dim sk) Z (%wsucc o) m ms (cube-map (dims sk) (Line Z) (Line (Line Z)) (meet-l Z) (dcube-map (suc (dims sk)) X F Z g c d)))
          (papp-conj-from (lcons e-dim sk) Z (%wsucc o) m ms (dcube-map (suc (suc (dims sk))) X F Z g
             (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c d)))
          (dcube-map (suc (dims sk)) X F Z g
             (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))
             (papp-conj-from-d (lcons e-dim sk) X F (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)
                (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c d)))
          (λ j → papp-conj-from (lcons e-dim sk) Z (%wsucc o) m ms
             (dmap-gen (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (Line Z) (Line (Line Z)) (meet-l X) (meet-o X F) (meet-l Z)
                (lineo-map X F Z g) (lineo-map (Line X) (LineO X F) (Line Z) (lineo-map X F Z g))
                (λ k L D → meet-l Z (lineo-map X F Z g L D)) c d j))
          (papp-conj-from-dmap (lcons e-dim sk) X F Z g (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)
             (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c d)) i))
    (papp-lit-dmap sk X F Z g o l
       (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))
       (papp-conj-from-d (lcons e-dim sk) X F (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)
          (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c d)))
papp-conj-dmap : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (Z : Type 1) (g : (x : X) → F x → Z) (o : Word) (cj : Conj)
  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → Cube (dims sk) Z) (papp-conj sk Z o cj (dcube-map (suc (dims sk)) X F Z g c d)) (dcube-map (dims sk) X F Z g (papp-conj sk X o cj c) (papp-conj-d sk X F o cj c d))
papp-conj-dmap sk X F Z g o lnil c d =
