diag-ren-d : (w : OPE) → DiagRenD (ope-src w) (ope-tgt w) (ope-var w) (ope-cube w) (ope-cube-d w) (diag-ren w)
diag-ren-d wdone k X F c d = λ i → fst d
diag-ren-d (wskip e w) k X F c d =
  skip-diag-d e (ope-src w) (ope-tgt w) (ope-var w) (ope-cube w) (ope-cube-d w) (diag-ren w) (diag-ren-d w) k X F c d
diag-ren-d (wkeep e w) k X F c d =
  keep-diag-d e (ope-src w) (ope-tgt w) (ope-var w) (ope-cube w) (ope-cube-d w) (ope-nat w) (ope-nat-d w) (diag-ren w) (diag-ren-d w) k X F c d

-- (2026-11-12, next definitions (2d), second part) the dimension parts of worlds and of the identity on
-- cubes over cubes, over cmap-skip, cmap-keep, cmap-id, cmap-ope
const-map-d : (n : Nat) (X Y : Type 1) (F : X → Type 1) (G : Y → Type 1) (g : X → Y) (gd : (x : X) → F x → G (g x)) (x : X) (y : F x) →
  PathP (λ i → DCube n Y G (const-map n X Y g x i)) (dcube-reidx n X Y F G g gd (cube-const n X x) (dcube-const n X F x y)) (dcube-const n Y G (g x) (gd x y))
const-map-d zero X Y F G g gd x y = λ i → gd x y
const-map-d (suc n) X Y F G g gd x y =
  const-map-d n (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y g) (lineo-reidx X Y F G g gd) (degen-l X x) (degen-o X F x y)
skip-const-d : (e : Entry) (sk' : Lst Entry) (X : Type 1) (F : X → Type 1) (x : X) (y : F x) →
  PathP (λ i → DCube (dims (lcons e sk')) X F (skip-const e sk' X x i))
    (dcube-const (dims (lcons e sk')) X F x y) (skip-d e sk' X F (cube-const (dims sk') X x) (dcube-const (dims sk') X F x y))
skip-const-d (e-ty s) sk' X F x y = λ i → dcube-const (dims sk') X F x y
skip-const-d e-dim sk' X F x y =
  psym-d (Cube (dims sk') (Line X)) (DCube (dims sk') (Line X) (LineO X F))
    (cube-map (dims sk') X (Line X) (degen-l X) (cube-const (dims sk') X x)) (cube-const (dims sk') (Line X) (degen-l X x))
    (const-map (dims sk') X (Line X) (degen-l X) x)
    (dcube-reidx (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) (cube-const (dims sk') X x) (dcube-const (dims sk') X F x y))
    (dcube-const (dims sk') (Line X) (LineO X F) (degen-l X x) (degen-o X F x y))
    (const-map-d (dims sk') X (Line X) F (LineO X F) (degen-l X) (degen-o X F) x y)
papp-var-d : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (k : Word) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) →
  PathP (λ i → DCube (dims sk) X F (papp-var sk X k c i)) (papp-cube-d sk X F (lcons (lcons (k , true) lnil) lnil) c d) (diag-sk-d sk k X F c d)
papp-var-d sk X F k c d = λ i → diag-sk-d sk (wadd-0 k i) X F c d
cmap-skip-d : (e : Entry) (sk' sk : Lst Entry) (r : Word → Word) (X : Type 1) (F : X → Type 1) (c : Cube (dims sk) X) (d : DCube (dims sk) X F c) →
