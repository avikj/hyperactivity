       (papp-cube (lcons e sk') X (lcons (lcons (%wsucc (r #0) , true) lnil) lnil) (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)))
