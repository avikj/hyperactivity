dexd-t00 : (sk : Lst Entry) (s : TyShape) (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD (lcons (e-ty s) sk) #0 #0 X F D d
