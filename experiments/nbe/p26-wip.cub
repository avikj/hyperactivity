  PathP (λ i → DCube (dims sk) X F (diag-diag sk j X D i)) (diag-sk-d sk j X F (diag-sk sk j (Line X) D) (diag-sk-d sk j (Line X) (LineO X F) D d))
    (diag-sk-d sk j X F (cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) D) (dcube-reidx (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) D d))
