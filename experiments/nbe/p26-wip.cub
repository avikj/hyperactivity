     (pcat (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ)))) (cmap-cube (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) (fst w)) (CtxV (lcons (e-ty a) (fst Δ))) (snd (extM Δ a Y (λ γ e ρ → h (e ρ)) M))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ))) (λ γ' t → (fst (fst t) , λ ρ → h (snd t ρ))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (sub-base (extM Δ' a Y (λ γ e ρ → h (e ρ)) (subM Δ' Δ Y (world-sub Δ' Δ w) M)) (extM Δ a Y (λ γ e ρ → h (e ρ)) M) (keep-S Δ' Δ a Y h M w)) (ext-path Δ' Δ a Y (λ γ e ρ → h (e ρ)) M (world-sub Δ' Δ w))
        (pcat (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ)))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ))) (λ γ' t → (fst (fst t) , λ ρ → h (snd t ρ))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (dcube-map (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (CtxV (lcons (e-ty a) (fst Δ))) (λ x p → fst p) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (λ γ' t → ((fst (fst t) , λ ρ → h (snd t ρ)) , λ ρ'' → (snd (fst t) (fst ρ'') , snd ρ''))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (sub-base (extM Δ' a Y (λ γ e ρ → h (e ρ)) (subM Δ' Δ Y (world-sub Δ' Δ w) M)) (extM Δ a Y (λ γ e ρ → h (e ρ)) M) (keep-S Δ' Δ a Y h M w)) (psym (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ)))) (dcube-map (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (CtxV (lcons (e-ty a) (fst Δ))) (λ x p → fst p) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (λ γ' t → ((fst (fst t) , λ ρ → h (snd t ρ)) , λ ρ'' → (snd (fst t) (fst ρ'') , snd ρ''))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ))) (λ γ' t → (fst (fst t) , λ ρ → h (snd t ρ))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (map-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (λ γ' t → ((fst (fst t) , λ ρ → h (snd t ρ)) , λ ρ'' → (snd (fst t) (fst ρ'') , snd ρ''))) (CtxV (lcons (e-ty a) (fst Δ))) (λ x p → fst p) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)))
           (λ i → dcube-map (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (CtxV (lcons (e-ty a) (fst Δ))) (λ x p → fst p) ((keep-base Δ' Δ a Y h M w) i) (carry-fill (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (snd (extM Δ' a Y (λ γ e ρ → h (e ρ)) (subM Δ' Δ Y (world-sub Δ' Δ w) M))) (keep-base Δ' Δ a Y h M w) (dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (λ γ' t → ((fst (fst t) , λ ρ → h (snd t ρ)) , λ ρ'' → (snd (fst t) (fst ρ'') , snd ρ''))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) i)))))
-- (2026-11-12, next definitions (2s)) world-keep. Composition and inversion of paths with the
-- endpoints inferred (pcat-i, psym-i: the elaborator finds them from the paths' types; not where an
-- endpoint contains a composition with a system, t55: pcat and psym there); pushing a
-- fibrewise map of the base's own cube, or a section, is a lift (push-diag, push-of); pulling back
-- by a map that ignores the fibre is a fibrewise map (pull-ignore).
pcat-i : (A : Type 1) {x y z : A} → PathP (λ i → A) x y → PathP (λ i → A) y z → PathP (λ i → A) x z
pcat-i A {x} {y} {z} p q = pcat A x y z p q
psym-i : (A : Type 1) {x y : A} → PathP (λ i → A) x y → PathP (λ i → A) y x
psym-i A p = λ i → p (~ i)
push-diag : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F x → F' (f x y))
  (h : (x : X) → Y x → F x) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X' F' (dcube-map n X Y X' f c d)) (dcube-push n X X' Y F F' f g c d (dcube-fmap n X Y F h c d)) (dcube-lift n X X' Y F' f (λ x y → g x y (h x y)) c d)
push-diag zero X X' Y F F' f g h c d = λ i → g c d (h c d)
push-diag (suc n) X X' Y F F' f g h c d =
  push-diag n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-push X X' Y F F' f g) (lineo-fmap X Y F h) c d
push-of : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (g : (x : X) (y : Y x) → F x → F' (f x y))
  (A : (x : X) → F x) (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X' F' (dcube-map n X Y X' f c d)) (dcube-push n X X' Y F F' f g c d (dcube-of n X F A c)) (dcube-lift n X X' Y F' f (λ x y → g x y (A x)) c d)
push-of zero X X' Y F F' f g A c d = λ i → g c d (A c)
push-of (suc n) X X' Y F F' f g A c d =
  push-of n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-push X X' Y F F' f g) (lineo-of X F A) c d
pull-ignore : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (k : (x : X) → Y x → F x)
  (c : Cube n X) (d : DCube n X Y c) (e : DCube n X' F' (dcube-map n X Y X' f c d)) →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y F F' f (λ x y z → k x y) c d e) (dcube-fmap n X Y F k c d)
pull-ignore zero X X' Y F F' f k c d e = λ i → k c d
pull-ignore (suc n) X X' Y F F' f k c d e =
  pull-ignore n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-fmap X Y F k) c d e
-- keeping a type entry (the names of keep-base, keep-S and keep-sub's parts): the two extended
-- contexts, the vertex substitutions sub-tot w M, the map to the kept context's vertices and the
-- vertex substitution there (kp-f, kp-g), the base they give (kp-c0), carrying along keep-base, a lift
-- of sub-tot, and weakening along it (kp-push)
kp-ctx : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) → CCtx
kp-ctx Δ' Δ a Y h M w = extM Δ' a Y (λ γ e ρ → h (e ρ)) (subM Δ' Δ Y (world-sub Δ' Δ w) M)
kp-x : (Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) → CCtx
kp-x Δ a Y h M = extM Δ a Y (λ γ e ρ → h (e ρ)) M
kp-tot : (Δ' Δ : CCtx) (Y : Type 1) (M : Mean Δ Y) (w : World Δ' Δ) → DCube (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (snd Δ')
kp-tot Δ' Δ Y M w = sub-tot Δ' Δ Y (world-sub Δ' Δ w) M
kp-f : (sk' sk : Lst Entry) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (γ' : CtxV sk') → SubT sk' sk Y γ' → CtxV (lcons (e-ty a) sk')
kp-f sk' sk a Y h γ' t = (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))
kp-g : (sk' sk : Lst Entry) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (γ' : CtxV sk') (t : SubT sk' sk Y γ') →
  SubF (lcons (e-ty a) sk') (lcons (e-ty a) sk) (kp-f sk' sk a Y h γ' t)
kp-g sk' sk a Y h γ' t = ((fst (fst t) , λ ρ → h (snd t ρ)) , λ ρ'' → (snd (fst t) (fst ρ'') , snd ρ''))
kp-c0 : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) → Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ')))
kp-c0 Δ' Δ a Y h M w = dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ'))) (kp-f (fst Δ') (fst Δ) a Y h) (snd Δ') (kp-tot Δ' Δ Y M w)
kp-carry : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (Z : Type 1) →
  DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-c0 Δ' Δ a Y h M w) → Mean (kp-ctx Δ' Δ a Y h M w) Z
kp-carry Δ' Δ a Y h M w Z D =
  carry (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-c0 Δ' Δ a Y h M w) (snd (kp-ctx Δ' Δ a Y h M w)) (keep-base Δ' Δ a Y h M w) D
kp-lift : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (Z : Type 1)
  (G : (x : CtxV (fst Δ')) (t : SubT (fst Δ') (fst Δ) Y x) → FbE (lcons (e-ty a) (fst Δ')) Z (kp-f (fst Δ') (fst Δ) a Y h x t)) →
  DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-c0 Δ' Δ a Y h M w)
kp-lift Δ' Δ a Y h M w Z G =
  dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-f (fst Δ') (fst Δ) a Y h) G (snd Δ') (kp-tot Δ' Δ Y M w)
kp-push : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (Z : Type 1) → Mean Δ' Z →
  DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) Z) (kp-c0 Δ' Δ a Y h M w)
kp-push Δ' Δ a Y h M w Z K =
  dcube-push (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Z) (FbE (lcons (e-ty a) (fst Δ')) Z)
    (kp-f (fst Δ') (fst Δ) a Y h) (λ x t e ρ'' → e (fst ρ'')) (snd Δ') (kp-tot Δ' Δ Y M w) K
-- a variable of the kept context, carried from a lift of sub-tot (kp-lhs: carry-of, of-lift), and
-- the action of keep-sub on a variable of the extended context, as such a carry (kp-rhs: subM-of,
-- fmap-transp, fmap-lift)
kp-S0 : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) →
  DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (kp-c0 Δ' Δ a Y h M w)
kp-S0 Δ' Δ a Y h M w =
  dcube-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (kp-f (fst Δ') (fst Δ) a Y h) (kp-g (fst Δ') (fst Δ) a Y h) (snd Δ') (kp-tot Δ' Δ Y M w)
-- a variable's meaning read through a vertex substitution
var-at : (sk' sk : Lst Entry) (v : VarP sk) (γ' : CtxV sk') → SubF sk' sk γ' → FbE sk' (TV (var-shape sk v)) γ'
var-at sk' sk v γ' p ρ' = varM sk v (fst p) (snd p ρ')
-- a variable of the kept context, carried from a lift of sub-tot (kp-lhs: carry-of, of-lift), and
-- the action of keep-sub on a variable of the extended context, as such a carry (kp-rhs: subM-of,
-- fmap-transp, fmap-lift)
kp-lhs : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (v' : VarP (lcons (e-ty a) (fst Δ'))) →
  PathM (kp-ctx Δ' Δ a Y h M w) (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (varCube (kp-ctx Δ' Δ a Y h M w) v')
    (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (kp-lift Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (λ x t → varM (lcons (e-ty a) (fst Δ')) v' (kp-f (fst Δ') (fst Δ) a Y h x t))))
kp-lhs Δ' Δ a Y h M w v' =
  pcat (Mean (kp-ctx Δ' Δ a Y h M w) (TV (var-shape (lcons (e-ty a) (fst Δ')) v'))) (varCube (kp-ctx Δ' Δ a Y h M w) v')
    (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (dcube-of (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) (TV (var-shape (lcons (e-ty a) (fst Δ')) v'))) (varM (lcons (e-ty a) (fst Δ')) v') (kp-c0 Δ' Δ a Y h M w)))
    (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (kp-lift Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (λ x t → varM (lcons (e-ty a) (fst Δ')) v' (kp-f (fst Δ') (fst Δ) a Y h x t))))
    (psym (Mean (kp-ctx Δ' Δ a Y h M w) (TV (var-shape (lcons (e-ty a) (fst Δ')) v')))
       (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v')) (dcube-of (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) (TV (var-shape (lcons (e-ty a) (fst Δ')) v'))) (varM (lcons (e-ty a) (fst Δ')) v') (kp-c0 Δ' Δ a Y h M w)))
       (varCube (kp-ctx Δ' Δ a Y h M w) v')
       (carry-of (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (FbE (lcons (e-ty a) (fst Δ')) (TV (var-shape (lcons (e-ty a) (fst Δ')) v'))) (varM (lcons (e-ty a) (fst Δ')) v') (kp-c0 Δ' Δ a Y h M w) (snd (kp-ctx Δ' Δ a Y h M w)) (keep-base Δ' Δ a Y h M w)))
    (λ i → kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ')) v'))
       (of-lift (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubT (fst Δ') (fst Δ) Y) (FbE (lcons (e-ty a) (fst Δ')) (TV (var-shape (lcons (e-ty a) (fst Δ')) v'))) (kp-f (fst Δ') (fst Δ) a Y h) (varM (lcons (e-ty a) (fst Δ')) v') (snd Δ') (kp-tot Δ' Δ Y M w) i))
kp-rhs : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) (v' : VarP (lcons (e-ty a) (fst Δ))) →
  PathM (kp-ctx Δ' Δ a Y h M w) (TV (var-shape (lcons (e-ty a) (fst Δ)) v'))
    (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ)) v')) (kp-lift Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ)) v'))
       (λ x t → var-at (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ)) v' (kp-f (fst Δ') (fst Δ) a Y h x t) (kp-g (fst Δ') (fst Δ) a Y h x t))))
    (subM (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M) (TV (var-shape (lcons (e-ty a) (fst Δ)) v')) (keep-sub Δ' Δ a Y h M w) (varCube (kp-x Δ a Y h M) v'))
kp-rhs Δ' Δ a Y h M w v' =
  pcat (Mean (kp-ctx Δ' Δ a Y h M w) (TV (var-shape (lcons (e-ty a) (fst Δ)) v')))
    (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ)) v')) (kp-lift Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ)) v'))
       (λ x t → var-at (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ)) v' (kp-f (fst Δ') (fst Δ) a Y h x t) (kp-g (fst Δ') (fst Δ) a Y h x t))))
    (kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ)) v')) (dcube-fmap (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (FbE (lcons (e-ty a) (fst Δ')) (TV (var-shape (lcons (e-ty a) (fst Δ)) v')))
       (var-at (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ)) v') (kp-c0 Δ' Δ a Y h M w) (kp-S0 Δ' Δ a Y h M w)))
    (subM (kp-ctx Δ' Δ a Y h M w) (kp-x Δ a Y h M) (TV (var-shape (lcons (e-ty a) (fst Δ)) v')) (keep-sub Δ' Δ a Y h M w) (varCube (kp-x Δ a Y h M) v'))
    (λ i → kp-carry Δ' Δ a Y h M w (TV (var-shape (lcons (e-ty a) (fst Δ)) v'))
