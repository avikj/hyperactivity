                    (fd (Line X) (LineO X F) (diag-sk (lcons e-dim sk) v X c) (diag-sk-d (lcons e-dim sk) v X F c d))) k
    (psym-d (Cube (suc (dims sk')) X) (DCube (suc (dims sk')) X F) (f (Line X) (cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c)) (cube-map (dims sk') (Line (Line X)) (Line X) (diag-l X) (f (Line (Line X)) c))
