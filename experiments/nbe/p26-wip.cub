-- a world after a world (world-comp's substitution is sub-after at cmap-of of the composite renaming,
-- cmap-comp, cmap-d-comp)
subM-comp : (Δ2 Δ1 Δ : CCtx) (w2 : World Δ2 Δ1) (w1 : World Δ1 Δ) (Z : Type 1) (M : Mean Δ Z) →
  PathP (λ i → (Mean Δ2 Z)) (subM Δ2 Δ Z (world-sub Δ2 Δ (world-comp Δ2 Δ1 Δ w2 w1)) M) (subM Δ2 Δ1 Z (world-sub Δ2 Δ1 w2) (subM Δ1 Δ Z (world-sub Δ1 Δ w1) M))
subM-comp Δ2 Δ1 Δ w2 w1 Z M =
  subM-after Δ2 Δ1 Δ w2 (world-sub Δ1 Δ w1) (cmap-of (fst Δ2) (fst Δ) (λ k → (fst w2) ((fst w1) k))) (cmap-comp (fst Δ2) (fst Δ1) (fst Δ) (fst w2) (fst w1) (fst (snd (snd w2))) (CtxV (fst Δ)) (snd Δ)) Z M
    (cmap-d-comp (fst Δ2) (fst Δ1) (fst Δ) (fst w2) (fst w1) (fst (snd (snd w2))) (CtxV (fst Δ)) (FbE (fst Δ) Z) (snd Δ) M)
-- (2026-11-12, F1) a substitution after a world: sub-after at the substitution's forms renamed by the
-- world's renaming (cmap-r, cmap-wcomp), and its action is the world's action on the substitution's
-- (subM-wcomp, by subM-after with cmap-d-wcomp)
sub-wcomp : (Δ' Δ Γ : CCtx) → World Δ' Δ → Sub Δ Γ → Sub Δ' Γ
sub-wcomp Δ' Δ Γ w σ = sub-after Δ' Δ Γ w σ (cmap-r (fst Δ') (fst Δ) (fst Γ) (fst w) (fst σ)) (cmap-wcomp (fst Δ') (fst Δ) (fst Γ) (fst w) (fst (snd (snd w))) (fst σ) (CtxV (fst Γ)) (snd Γ))
subM-wcomp : (Δ' Δ Γ : CCtx) (w : World Δ' Δ) (σ : Sub Δ Γ) (Z : Type 1) (M : Mean Γ Z) →
  PathP (λ i → Mean Δ' Z) (subM Δ' Γ Z (sub-wcomp Δ' Δ Γ w σ) M) (subM Δ' Δ Z (world-sub Δ' Δ w) (subM Δ Γ Z σ M))
subM-wcomp Δ' Δ Γ w σ Z M =
  subM-after Δ' Δ Γ w σ (cmap-r (fst Δ') (fst Δ) (fst Γ) (fst w) (fst σ)) (cmap-wcomp (fst Δ') (fst Δ) (fst Γ) (fst w) (fst (snd (snd w))) (fst σ) (CtxV (fst Γ)) (snd Γ)) Z M
    (cmap-d-wcomp (fst Δ') (fst Δ) (fst Γ) (fst w) (fst (snd (snd w))) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) (snd Γ) M)

