                (CtxV (lcons (e-ty a) (fst Γ))) (λ γ' p → fst p) (λ x v → (λ x → (fst (fst (snd x)) , f (fst (fst (snd x))) (snd (snd x)))) x) (λ i γ' t v → (fst (fst t) , f (fst (fst t)) (snd t))) (snd Δ) (sub-tot Δ Γ Y σ M) V))))
sub-ext : (Δ Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y) (σ : Sub Δ Γ)
  (V : DCube (dims (fst Δ)) (TotT (fst Δ) (fst Γ) Y) (ExtV (fst Δ) (fst Γ) a Y f) (tot-base Δ Γ Y σ M)) →
  Sub Δ (extM Γ a Y f M)
sub-ext Δ Γ a Y f M σ V =
  (fst σ , sub-ext-S Δ Γ a Y f M σ V , pcat (Cube (dims (fst Δ)) (CtxV (lcons (e-ty a) (fst Γ)))) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (lcons (e-ty a) (fst Γ))) (dcube-map (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ e → (γ , f γ e)) (snd Γ) M)) (dcube-map (dims (fst Δ)) (CtxV (fst Δ)) (SubT (fst Δ) (fst Γ) Y) (CtxV (lcons (e-ty a) (fst Γ))) (λ γ' t → (fst (fst t) , f (fst (fst t)) (snd t))) (snd Δ) (sub-tot Δ Γ Y σ M)) (sub-base Δ (extM Γ a Y f M) (sub-ext-S Δ Γ a Y f M σ V)) (ext-path Δ Γ a Y f M σ) (sub-ext-tail Δ Γ a Y f M σ V))
-- (2026-11-12, next definitions (2s), toward the worlds' variables) a section of a family over a cube
-- (dcube-of) commutes with the generators (reidx-of, q judgmental where used), with path application
-- (diag-of, papp-lit-of … papp-of), with the constant cube (const-of) and with the action of a
-- dimension part (cmap-d-of)
reidx-of : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (f : X → X') (fo : (x : X) → F x → F' (f x))
  (g : (x : X) → F x) (g' : (x' : X') → F' x') (q : PathP (λ i → (xq : X) → F' (f xq)) (λ xq → fo xq (g xq)) (λ xq → g' (f xq))) (c : Cube n X) →
  PathP (λ i → DCube n X' F' (cube-map n X X' f c)) (dcube-reidx n X X' F F' f fo c (dcube-of n X F g c)) (dcube-of n X' F' g' (cube-map n X X' f c))
reidx-of zero X X' F F' f fo g g' q c = λ i → q i c
reidx-of (suc n) X X' F F' f fo g g' q c =
  reidx-of n (Line X) (Line X') (LineO X F) (LineO X' F') (line-map X X' f) (lineo-reidx X X' F F' f fo) (lineo-of X F g) (lineo-of X' F' g')
    (λ i L → (q i (fst L) , q i (fst (snd L)) , λ j → q i (snd (snd L) j))) c
diag-of : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → DCube (dims sk) X F (diag-sk sk k X c)) (diag-sk-d sk k X F c (dcube-of (suc (dims sk)) X F g c)) (dcube-of (dims sk) X F g (diag-sk sk k X c))
diag-of lnil k X F g c = λ i → g (fst c)
diag-of (lcons (e-ty s) sk) k X F g c =
  bool-elim1 (λ b → PathP (λ i → DCube (dims sk) X F (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c))
                 (bool-elim1 (λ b → DCube (dims sk) X F (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c))
                    (dcube-reidx (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) c (dcube-of (suc (dims sk)) X F g c)) (diag-sk-d sk (%wsub k #1) X F c (dcube-of (suc (dims sk)) X F g c)) b)
                 (dcube-of (dims sk) X F g (if b then cube-map (dims sk) (Line X) X (face0-l X) c else diag-sk sk (%wsub k #1) X c)))
    (reidx-of (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) (lineo-of X F g) g (λ i L → g (fst L)) c)
    (diag-of sk (%wsub k #1) X F g c) (weq k #0)
diag-of (lcons e-dim sk) k X F g c =
  bool-elim1 (λ b → PathP (λ i → DCube (suc (dims sk)) X F (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
                 (bool-elim1 (λ b → DCube (suc (dims sk)) X F (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
                    (dcube-reidx (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) c (dcube-of (suc (suc (dims sk))) X F g c))
                    (diag-sk-d sk (%wsub k #1) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c (dcube-of (suc (suc (dims sk))) X F g c)))
                    b)
                 (dcube-of (suc (dims sk)) X F g (if b then cube-map (dims sk) (Line (Line X)) (Line X) (diag-l X) c else diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c))))
    (reidx-of (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X F)) (LineO X F) (diag-l X) (diag-o X F) (lineo-of (Line X) (LineO X F) (lineo-of X F g)) (lineo-of X F g) (λ i Q → diag-o X F Q ((lineo-of (Line X) (LineO X F) (lineo-of X F g)) Q)) c)
    (pcat (DCube (suc (dims sk)) X F (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
       (diag-sk-d sk (%wsub k #1) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c (dcube-of (suc (suc (dims sk))) X F g c)))
       (diag-sk-d sk (%wsub k #1) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-of (suc (suc (dims sk))) X F g (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
       (dcube-of (suc (dims sk)) X F g (diag-sk sk (%wsub k #1) (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
       (λ i → diag-sk-d sk (%wsub k #1) (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (reidx-of (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) (lineo-of (Line X) (LineO X F) (lineo-of X F g)) (lineo-of (Line X) (LineO X F) (lineo-of X F g)) (λ j Q → exch-o X F Q ((lineo-of (Line X) (LineO X F) (lineo-of X F g)) Q)) c i))
       (diag-of sk (%wsub k #1) (Line X) (LineO X F) (lineo-of X F g) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)))
    (weq k #0)
papp-lit-of : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (o : Word) (l : Lit) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → DCube (dims sk) X F (papp-lit sk X o l c)) (papp-lit-d sk X F o l c (dcube-of (suc (dims sk)) X F g c)) (dcube-of (dims sk) X F g (papp-lit sk X o l c))
papp-lit-of sk X F g o l c =
  bool-elim1 (λ b → PathP (λ i → DCube (dims sk) X F (if b then diag-sk sk (%wadd (fst l) o) X c else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
                 (bool-elim1 (λ b → DCube (dims sk) X F (if b then diag-sk sk (%wadd (fst l) o) X c else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
                    (diag-sk-d sk (%wadd (fst l) o) X F c (dcube-of (suc (dims sk)) X F g c)) (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c (dcube-of (suc (dims sk)) X F g c))) b)
                 (dcube-of (dims sk) X F g (if b then diag-sk sk (%wadd (fst l) o) X c else diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))))
    (diag-of sk (%wadd (fst l) o) X F g c)
    (pcat (DCube (dims sk) X F (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c (dcube-of (suc (dims sk)) X F g c)))
       (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-of (suc (dims sk)) X F g (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (dcube-of (dims sk) X F g (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (λ i → diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (reidx-of (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) (lineo-of X F g) (lineo-of X F g) (λ j L → rev-o X F L ((lineo-of X F g) L)) c i))
       (diag-of sk (%wadd (fst l) o) X F g (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
    (snd l)
papp-conj-from-of : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (o : Word) (l : Lit) (ms : Conj) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → DCube (dims sk) X F (papp-conj-from sk X o l ms c)) (papp-conj-from-d sk X F o l ms c (dcube-of (suc (dims sk)) X F g c)) (dcube-of (dims sk) X F g (papp-conj-from sk X o l ms c))
papp-conj-from-of sk X F g o l lnil c = papp-lit-of sk X F g o l c
papp-conj-from-of sk X F g o l (lcons m ms) c =
  pcat (DCube (dims sk) X F (papp-lit sk X o l (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))))
    (papp-conj-from-d sk X F o l (lcons m ms) c (dcube-of (suc (dims sk)) X F g c))
    (papp-lit-d sk X F o l (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)) (dcube-of (suc (dims sk)) X F g (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))))
    (dcube-of (dims sk) X F g (papp-lit sk X o l (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))))
    (λ i → papp-lit-d sk X F o l (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c))
       (pcat (DCube (suc (dims sk)) X F (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
          (papp-conj-from-d (lcons e-dim sk) X F (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c) (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) c (dcube-of (suc (dims sk)) X F g c)))
          (papp-conj-from-d (lcons e-dim sk) X F (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c) (dcube-of (suc (suc (dims sk))) X F g (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
          (dcube-of (suc (dims sk)) X F g (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
          (λ j → papp-conj-from-d (lcons e-dim sk) X F (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)
             (reidx-of (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (meet-l X) (meet-o X F) (lineo-of X F g) (lineo-of (Line X) (LineO X F) (lineo-of X F g)) (λ k L → meet-o X F L ((lineo-of X F g) L)) c j))
          (papp-conj-from-of (lcons e-dim sk) X F g (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)) i))
    (papp-lit-of sk X F g o l (papp-conj-from (lcons e-dim sk) X (%wsucc o) m ms (cube-map (dims sk) (Line X) (Line (Line X)) (meet-l X) c)))
papp-conj-of : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (o : Word) (cj : Conj) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → DCube (dims sk) X F (papp-conj sk X o cj c)) (papp-conj-d sk X F o cj c (dcube-of (suc (dims sk)) X F g c)) (dcube-of (dims sk) X F g (papp-conj sk X o cj c))
papp-conj-of sk X F g o lnil c = reidx-of (dims sk) (Line X) X (LineO X F) F (face1-l X) (face1-o X F) (lineo-of X F g) g (λ i L → g (fst (snd L))) c
papp-conj-of sk X F g o (lcons l ls) c = papp-conj-from-of sk X F g o l ls c
papp-dnf-from-of : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (o : Word) (cj : Conj) (ds : DNF) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → DCube (dims sk) X F (papp-dnf-from sk X o cj ds c)) (papp-dnf-from-d sk X F o cj ds c (dcube-of (suc (dims sk)) X F g c)) (dcube-of (dims sk) X F g (papp-dnf-from sk X o cj ds c))
papp-dnf-from-of sk X F g o cj lnil c = papp-conj-of sk X F g o cj c
papp-dnf-from-of sk X F g o cj (lcons e es) c =
  pcat (DCube (dims sk) X F (papp-conj sk X o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))))
    (papp-dnf-from-d sk X F o cj (lcons e es) c (dcube-of (suc (dims sk)) X F g c))
    (papp-conj-d sk X F o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)) (dcube-of (suc (dims sk)) X F g (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))))
    (dcube-of (dims sk) X F g (papp-conj sk X o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))))
    (λ i → papp-conj-d sk X F o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c))
       (pcat (DCube (suc (dims sk)) X F (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
          (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c) (dcube-reidx (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) c (dcube-of (suc (dims sk)) X F g c)))
          (papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c) (dcube-of (suc (suc (dims sk))) X F g (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
          (dcube-of (suc (dims sk)) X F g (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
          (λ j → papp-dnf-from-d (lcons e-dim sk) X F (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)
             (reidx-of (dims sk) (Line X) (Line (Line X)) (LineO X F) (LineO (Line X) (LineO X F)) (join-l X) (join-o X F) (lineo-of X F g) (lineo-of (Line X) (LineO X F) (lineo-of X F g)) (λ k L → join-o X F L ((lineo-of X F g) L)) c j))
          (papp-dnf-from-of (lcons e-dim sk) X F g (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)) i))
    (papp-conj-of sk X F g o cj (papp-dnf-from (lcons e-dim sk) X (%wsucc o) e es (cube-map (dims sk) (Line X) (Line (Line X)) (join-l X) c)))
papp-of : (sk : Lst Entry) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (f : DNF) (c : Cube (suc (dims sk)) X) →
  PathP (λ i → DCube (dims sk) X F (papp-cube sk X f c)) (papp-cube-d sk X F f c (dcube-of (suc (dims sk)) X F g c)) (dcube-of (dims sk) X F g (papp-cube sk X f c))
papp-of sk X F g lnil c = reidx-of (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) (lineo-of X F g) g (λ i L → g (fst L)) c
papp-of sk X F g (lcons cj cs) c = papp-dnf-from-of sk X F g #0 cj cs c
const-of : (n : Nat) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (x : X) →
  PathP (λ i → DCube n X F (cube-const n X x)) (dcube-const n X F x (g x)) (dcube-of n X F g (cube-const n X x))
const-of zero X F g x = λ i → g x
const-of (suc n) X F g x = const-of n (Line X) (LineO X F) (lineo-of X F g) (degen-l X x)
cmap-d-of : (sk' sk : Lst Entry) (σ : CMap sk' sk) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (c : Cube (dims sk) X) →
  PathP (λ i → DCube (dims sk') X F (cmap-cube sk' sk σ X c)) (cmap-d sk' sk σ X F c (dcube-of (dims sk) X F g c)) (dcube-of (dims sk') X F g (cmap-cube sk' sk σ X c))
cmap-d-of sk' lnil σ X F g c = const-of (dims sk') X F g c
cmap-d-of sk' (lcons (e-ty a) sk) σ X F g c = cmap-d-of sk' sk σ X F g c
cmap-d-of sk' (lcons e-dim sk) σ X F g c =
  pcat (DCube (dims sk') X F (papp-cube sk' X (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c)))
    (cmap-d sk' (lcons e-dim sk) σ X F c (dcube-of (suc (dims sk)) X F g c))
    (papp-cube-d sk' X F (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (dcube-of (suc (dims sk')) X F g (cmap-cube sk' sk (fst σ) (Line X) c)))
    (dcube-of (dims sk') X F g (cmap-cube sk' (lcons e-dim sk) σ X c))
    (λ i → papp-cube-d sk' X F (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c) (cmap-d-of sk' sk (fst σ) (Line X) (LineO X F) (lineo-of X F g) c i))
    (papp-of sk' X F g (snd σ) (cmap-cube sk' sk (fst σ) (Line X) c))
-- (2026-11-12, next definitions (2s), toward the worlds' variables) carrying a section's restriction
-- along a path of bases is the restriction at the end (carry-of); pulling back a section is mapping
-- its values into the fibres (pull-of); a fibrewise map of a section is a section (fmap-of); so a
-- substitution acts on a section by reading it at each vertex's environment map (subM-of)
carry-of : (n : Nat) (X : Type 1) (F : X → Type 1) (g : (x : X) → F x) (c0 c1 : Cube n X) (p : PathP (λ i → Cube n X) c0 c1) →
  PathP (λ i → DCube n X F c1) (carry n X F c0 c1 p (dcube-of n X F g c0)) (dcube-of n X F g c1)
carry-of n X F g c0 c1 p = λ k →
  comp (λ j → DCube n X F (p j)) (λ j → [ k = 0 ↦ carry-fill n X F c0 c1 p (dcube-of n X F g c0) j , k = 1 ↦ dcube-of n X F g (p j) ]) (dcube-of n X F g c0)
pull-of : (n : Nat) (X X' : Type 1) (Y F : X → Type 1) (F' : X' → Type 1) (f : (x : X) → Y x → X') (gp : (x : X) (y : Y x) → F' (f x y) → F x)
  (g : (x' : X') → F' x') (c : Cube n X) (d : DCube n X Y c) →
  PathP (λ i → DCube n X F c) (dcube-pull n X X' Y F F' f gp c d (dcube-of n X' F' g (dcube-map n X Y X' f c d))) (dcube-fmap n X Y F (λ x y → gp x y (g (f x y))) c d)
pull-of zero X X' Y F F' f gp g c d = λ i → gp c d (g (f c d))
pull-of (suc n) X X' Y F F' f gp g c d =
  pull-of n (Line X) (Line X') (LineO X Y) (LineO X F) (LineO X' F') (lineo-map X Y X' f) (lineo-pull X X' Y F F' f gp) (lineo-of X' F' g) c d
fmap-of : (n : Nat) (X : Type 1) (F F' : X → Type 1) (g : (x : X) → F x) (h : (x : X) → F x → F' x) (c : Cube n X) →
  PathP (λ i → DCube n X F' c) (dcube-fmap n X F F' h c (dcube-of n X F g c)) (dcube-of n X F' (λ x → h x (g x)) c)
fmap-of zero X F F' g h c = λ i → h c (g c)
fmap-of (suc n) X F F' g h c = fmap-of n (Line X) (LineO X F) (LineO X F') (lineo-of X F g) (lineo-fmap X F F' h) c
subM-of : (Δ Γ : CCtx) (Z : Type 1) (σ : Sub Δ Γ) (g : (γ : CtxV (fst Γ)) → EnvV (fst Γ) γ → Z) →
  PathM Δ Z (subM Δ Γ Z σ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (snd Γ))) (dcube-fmap (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (λ γ' p ρ' → g (fst p) (snd p ρ')) (snd Δ) (fst (snd σ)))
subM-of Δ Γ Z σ g =
  pcat (Mean Δ Z) (subM Δ Γ Z σ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (snd Γ))) (sub-pull Δ Γ Z (fst (snd σ)) (dcube-of (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (sub-base Δ Γ (fst (snd σ))))) (dcube-fmap (dims (fst Δ)) (CtxV (fst Δ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (λ γ' p ρ' → g (fst p) (snd p ρ')) (snd Δ) (fst (snd σ)))
    (λ i → sub-pull Δ Γ Z (fst (snd σ))
       (pcat (DCube (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (sub-base Δ Γ (fst (snd σ)))) (sub-carried Δ Γ Z σ (dcube-of (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (snd Γ))) (carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ))) (snd (snd σ)) (dcube-of (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)))) (dcube-of (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (sub-base Δ Γ (fst (snd σ))))
          (λ j → carry (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ))) (snd (snd σ)) (cmap-d-of (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (snd Γ) j))
          (carry-of (dims (fst Δ)) (CtxV (fst Γ)) (FbE (fst Γ) Z) g (cmap-cube (fst Δ) (fst Γ) (fst σ) (CtxV (fst Γ)) (snd Γ)) (sub-base Δ Γ (fst (snd σ))) (snd (snd σ))) i))
    (pull-of (dims (fst Δ)) (CtxV (fst Δ)) (CtxV (fst Γ)) (SubF (fst Δ) (fst Γ)) (FbE (fst Δ) Z) (FbE (fst Γ) Z) (λ γ' p → fst p) (λ γ' p e ρ → e (snd p ρ)) g (snd Δ) (fst (snd σ)))
-- ---------------------------------------------------------------- P2.6e (2s): worlds
-- (2026-11-12, next definitions (2s); the decision at the head) A world Δ' → Δ: a renaming r of
-- indices, monotone (canonicity and non-constancy of forms are kept: canon-ren's argument), sending
-- dimensions to dimensions and term entries to term entries or past the end (DimPres: path
-- application reads an index that names no dimension as the face at 0, on both sides of a renaming),
-- the substitution whose dimension part is cmap-of r, and for each term variable of Δ one of Δ' at
-- index r of its index, of the same shape and meaning (WVar, a path in ShM).
isdim : Lst Entry → Word → Bool
isdim lnil k = false
isdim (lcons (e-ty s) sk) k = if weq k #0 then false else isdim sk (%wsub k #1)
isdim (lcons e-dim sk) k = if weq k #0 then true else isdim sk (%wsub k #1)
DimPres : Lst Entry → Lst Entry → (Word → Word) → Type
DimPres sk' sk r = (k : Word) → isdim sk' (r k) ≡ isdim sk k
-- (2026-11-12, (4d)) a dimension-preserving renaming kept at a dimension entry is dimension-preserving
dp-keep : (sk' sk : Lst Entry) (r : Word → Word) → DimPres sk' sk r → DimPres (lcons e-dim sk') (lcons e-dim sk) (w-keep r)
dp-keep sk' sk r dp k =
  %welimP (λ u → isdim (lcons e-dim sk') (w-keep r u) ≡ isdim (lcons e-dim sk) u) k (λ i → true)
    (λ m hm → pcat0 Bool (isdim (lcons e-dim sk') (%wsucc (r m))) (isdim sk' (r m)) (isdim (lcons e-dim sk) (%wsucc m))
       (λ i → if weq-s0 (r m) i then true else isdim sk' (wsub-s1 (r m) i))
       (pcat0 Bool (isdim sk' (r m)) (isdim sk m) (isdim (lcons e-dim sk) (%wsucc m)) (dp m) (sym (λ i → if weq-s0 m i then true else isdim sk (wsub-s1 m i)))))
ShM : CCtx → Type 1
-- binder names chosen not to collide: t46
ShM Δ = (shs : TyShape) × Mean Δ (TV shs)
WSub : (Δ' Δ : CCtx) → (Word → Word) → Type 1
-- binder names chosen not to collide: t46
WSub Δ' Δ r = (wsS : DCube (dims (fst Δ')) (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ)) (snd Δ')) ×
  PathP (λ i → Cube (dims (fst Δ')) (CtxV (fst Δ))) (cmap-cube (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) r) (CtxV (fst Δ)) (snd Δ)) (sub-base Δ' Δ wsS)
WVar : (Δ' Δ : CCtx) → (Word → Word) → Sub Δ' Δ → Type 1
-- binder names chosen not to collide: t46
WVar Δ' Δ r σ = (wvv : VarP (fst Δ)) → (wvv' : VarP (fst Δ')) × (var-word (fst Δ') wvv' ≡ r (var-word (fst Δ) wvv)) ×
  PathP (λ i → ShM Δ') (var-shape (fst Δ') wvv' , varCube Δ' wvv') (var-shape (fst Δ) wvv , subM Δ' Δ (TV (var-shape (fst Δ) wvv)) σ (varCube Δ wvv))
World : CCtx → CCtx → Type 1
-- binder names chosen not to collide: t46
World Δ' Δ = (wr : Word → Word) × (wm : MonoW wr) × (wd : DimPres (fst Δ') (fst Δ) wr) × (ws : WSub Δ' Δ wr) ×
  WVar Δ' Δ wr (cmap-of (fst Δ') (fst Δ) wr , ws)
world-sub : (Δ' Δ : CCtx) → World Δ' Δ → Sub Δ' Δ
world-sub Δ' Δ w = (cmap-of (fst Δ') (fst Δ) (fst w) , fst (snd (snd (snd w))))
-- weakening by a type and by a dimension (r = succ; the substitutions sub-wk, sub-dwk; each variable's
-- meaning by subM-of and fmap-of)
world-wk : (Γ : CCtx) (a : TyShape) (Y : Type 1) (f : (γ : CtxV (fst Γ)) → (EnvV (fst Γ) γ → Y) → EnvV (fst Γ) γ → Sem a) (M : Mean Γ Y) →
  World (extM Γ a Y f M) Γ
world-wk Γ a Y f M =
  (λ k → %wsucc k , mono-succ (λ k → k) mono-id ,
   (λ k i → if weq-s0 k i then false else isdim (fst Γ) (wsub-s1 k i)) ,
   snd (sub-wk Γ a Y f M) ,
   λ v → (some v , (λ i → %wsucc (var-word (fst Γ) v)) ,
          λ i → (var-shape (fst Γ) v ,
                 psym (Mean (extM Γ a Y f M) (TV (var-shape (fst Γ) v)))
                   (subM (extM Γ a Y f M) Γ (TV (var-shape (fst Γ) v)) (sub-wk Γ a Y f M) (varCube Γ v)) (varCube (extM Γ a Y f M) (some v))
                   (pcat (Mean (extM Γ a Y f M) (TV (var-shape (fst Γ) v)))
                      (subM (extM Γ a Y f M) Γ (TV (var-shape (fst Γ) v)) (sub-wk Γ a Y f M) (varCube Γ v))
                      (dcube-fmap (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (FbE (lcons (e-ty a) (fst Γ)) (TV (var-shape (fst Γ) v)))
                         (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd (extM Γ a Y f M)) (fst (snd (sub-wk Γ a Y f M))))
                      (varCube (extM Γ a Y f M) (some v))
                      (subM-of (extM Γ a Y f M) Γ (TV (var-shape (fst Γ) v)) (sub-wk Γ a Y f M) (varM (fst Γ) v))
                      (fmap-of (dims (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (SubF (lcons (e-ty a) (fst Γ)) (fst Γ)) (FbE (lcons (e-ty a) (fst Γ)) (TV (var-shape (fst Γ) v)))
                         (λ γ' → (fst γ' , λ ρ → fst ρ)) (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd (extM Γ a Y f M))))
                   i)))
world-dwk : (Γ : CCtx) → World (dext Γ) Γ
world-dwk Γ =
  (λ k → %wsucc k , mono-succ (λ k → k) mono-id ,
   (λ k i → if weq-s0 k i then true else isdim (fst Γ) (wsub-s1 k i)) ,
   snd (sub-dwk Γ) ,
   λ v → (v , (λ i → %wsucc (var-word (fst Γ) v)) ,
          λ i → (var-shape (fst Γ) v ,
                 psym (Mean (dext Γ) (TV (var-shape (fst Γ) v)))
                   (subM (dext Γ) Γ (TV (var-shape (fst Γ) v)) (sub-dwk Γ) (varCube Γ v)) (varCube (dext Γ) v)
                   (pcat (Mean (dext Γ) (TV (var-shape (fst Γ) v)))
                      (subM (dext Γ) Γ (TV (var-shape (fst Γ) v)) (sub-dwk Γ) (varCube Γ v))
                      (dcube-fmap (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd (dext Γ)) (fst (snd (sub-dwk Γ))))
                      (varCube (dext Γ) v)
                      (subM-of (dext Γ) Γ (TV (var-shape (fst Γ) v)) (sub-dwk Γ) (varM (fst Γ) v))
                      (fmap-of (suc (dims (fst Γ))) (CtxV (fst Γ)) (SubF (lcons e-dim (fst Γ)) (fst Γ)) (FbE (fst Γ) (TV (var-shape (fst Γ) v)))
                         (λ γ → (γ , λ ρ → ρ)) (λ γ' p ρ' → varM (fst Γ) v (fst p) (snd p ρ')) (snd (dext Γ))))
                   i)))
-- keeping a dimension (r = w-keep r): the cube of vertex substitutions degenerate in the new direction
-- (dkeep-S), its path by cmap-keep, cmap-nat, the world's own and dmap-gen at the degeneracy
-- (dkeep-sub); each variable's meaning by the world's, reindexed at the degeneracy, with subM-of on
-- both sides (world-dkeep)
dkeep-S : (Δ' Δ : CCtx) → World Δ' Δ → DCube (suc (dims (fst Δ'))) (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ)) (snd (dext Δ'))
dkeep-S Δ' Δ w = (dcube-reidx (dims (fst Δ')) (CtxV (fst Δ')) (Line (CtxV (fst Δ'))) (SubF (fst Δ') (fst Δ)) (LineO (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ))) (degen-l (CtxV (fst Δ'))) (degen-o (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ))) (snd Δ') (fst (fst (snd (snd (snd w))))))
dkeep-sub : (Δ' Δ : CCtx) → World Δ' Δ → Sub (dext Δ') (dext Δ)
dkeep-sub Δ' Δ w =
  ((cmap-of (lcons e-dim (fst Δ')) (lcons e-dim (fst Δ)) (w-keep (fst w))) , (dkeep-S Δ' Δ w) ,
   pcat (Cube (suc (dims (fst Δ'))) (CtxV (fst Δ))) (cmap-cube (lcons e-dim (fst Δ')) (lcons e-dim (fst Δ)) (cmap-of (lcons e-dim (fst Δ')) (lcons e-dim (fst Δ)) (w-keep (fst w))) (CtxV (fst Δ)) (cube-map (dims (fst Δ)) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (snd Δ))) (cmap-cube (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) (fst w)) (Line (CtxV (fst Δ))) (cube-map (dims (fst Δ)) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (snd Δ))) (sub-base (dext Δ') (dext Δ) (dkeep-S Δ' Δ w)) (cmap-keep e-dim (fst Δ') (fst Δ) (fst w) (CtxV (fst Δ)) (cube-map (dims (fst Δ)) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (snd Δ)))
     (pcat (Cube (suc (dims (fst Δ'))) (CtxV (fst Δ))) (cmap-cube (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) (fst w)) (Line (CtxV (fst Δ))) (cube-map (dims (fst Δ)) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (snd Δ))) (cube-map (dims (fst Δ')) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (cmap-cube (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) (fst w)) (CtxV (fst Δ)) (snd Δ))) (sub-base (dext Δ') (dext Δ) (dkeep-S Δ' Δ w)) (cmap-nat (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) (fst w)) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (snd Δ))
        (pcat (Cube (suc (dims (fst Δ'))) (CtxV (fst Δ))) (cube-map (dims (fst Δ')) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (cmap-cube (fst Δ') (fst Δ) (cmap-of (fst Δ') (fst Δ) (fst w)) (CtxV (fst Δ)) (snd Δ))) (cube-map (dims (fst Δ')) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) (sub-base Δ' Δ (fst (fst (snd (snd (snd w))))))) (sub-base (dext Δ') (dext Δ) (dkeep-S Δ' Δ w)) (λ i → cube-map (dims (fst Δ')) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ))) ((snd (fst (snd (snd (snd w))))) i))
           (dmap-gen (dims (fst Δ')) (CtxV (fst Δ')) (Line (CtxV (fst Δ'))) (SubF (fst Δ') (fst Δ)) (LineO (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ))) (CtxV (fst Δ)) (Line (CtxV (fst Δ))) (degen-l (CtxV (fst Δ'))) (degen-o (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ))) (degen-l (CtxV (fst Δ))) (λ γ' p → fst p)
              (lineo-map (CtxV (fst Δ')) (SubF (fst Δ') (fst Δ)) (CtxV (fst Δ)) (λ γ' p → fst p)) (λ i γ' p → degen-l (CtxV (fst Δ)) (fst p)) (snd Δ') (fst (fst (snd (snd (snd w)))))))))
world-dkeep : (Δ' Δ : CCtx) → World Δ' Δ → World (dext Δ') (dext Δ)
world-dkeep Δ' Δ w =
  (w-keep (fst w) , mono-keep (fst w) (fst (snd w)) ,
   dp-keep (fst Δ') (fst Δ) (fst w) (fst (snd (snd w))) ,
   snd (dkeep-sub Δ' Δ w) ,
   λ v → ((fst ((snd (snd (snd (snd w)))) v)) , (λ i → %wsucc (fst (snd ((snd (snd (snd (snd w)))) v)) i)) ,
