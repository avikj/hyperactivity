       (hr X F G (papp-ex sk X (DL X (DL X F)) s G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X F))) (ddiag X (DL X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X (DL X F))) (DL X (DL X (DL X F))) (dexch X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X F)) (DL X (DL X (DL X F))) (dlf X (DL X F) (DL X (DL X F)) (cn X F))) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X (DL X F))) (cn X (DL X F)) G d))))))
       (cong1 (DCube (dims sk) X (DL X F) G) (DCube (dims sk) X F G) (λ w → (papp-ex sk X F r G w)) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (ddiag X F) G (papp-ex sk X (DL X (DL X F)) s G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X F))) (ddiag X (DL X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X (DL X F))) (DL X (DL X (DL X F))) (dexch X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X F)) (DL X (DL X (DL X F))) (dlf X (DL X F) (DL X (DL X F)) (cn X F))) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X (DL X F))) (cn X (DL X F)) G d)))))) (papp-ex sk X (DL X F) s G (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X F)) (dlf X (DL X (DL X F)) (DL X F) (ddiag X F)) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X F))) (ddiag X (DL X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X (DL X F))) (DL X (DL X (DL X F))) (dexch X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X F)) (DL X (DL X (DL X F))) (dlf X (DL X F) (DL X (DL X F)) (cn X F))) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X (DL X F))) (cn X (DL X F)) G d)))))) (papp-ex-fmap sk s X (DL X (DL X F)) (DL X F) (ddiag X F) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X F))) (ddiag X (DL X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X (DL X F))) (DL X (DL X (DL X F))) (dexch X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X F)) (DL X (DL X (DL X F))) (dlf X (DL X F) (DL X (DL X F)) (cn X F))) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X (DL X F))) (cn X (DL X F)) G d))))))
       (cong1 (DCube (dims sk) X (DL X (DL X F)) G) (DCube (dims sk) X F G) (λ w → (papp-ex sk X F r G (papp-ex sk X (DL X F) s G w))) (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X F)) (dlf X (DL X (DL X F)) (DL X F) (ddiag X F)) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X F))) (ddiag X (DL X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X (DL X F))) (DL X (DL X (DL X F))) (dexch X (DL X F))) G (dcube-fmap (dims sk) X (DL X (DL X (DL X F))) (DL X (DL X (DL X (DL X F)))) (dlf X (DL X (DL X F)) (DL X (DL X (DL X F))) (dlf X (DL X F) (DL X (DL X F)) (cn X F))) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X (DL X F))) (cn X (DL X F)) G d))))) (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (cn X F) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (ddiag X F) G d)) (fmap-sw52 (dims sk) X (DL X (DL X F)) (DL X (DL X (DL X F))) (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X (DL X F)))) (DL X (DL X (DL X F))) (DL X (DL X F)) (DL X F) (cn X (DL X F)) (dlf X (DL X (DL X F)) (DL X (DL X (DL X F))) (dlf X (DL X F) (DL X (DL X F)) (cn X F))) (dlf X (DL X (DL X (DL X F))) (DL X (DL X (DL X F))) (dexch X (DL X F))) (ddiag X (DL X (DL X F))) (dlf X (DL X (DL X F)) (DL X F) (ddiag X F))
             (ddiag X F) (cn X F) q G d)))
pex-diag : (sk : Lst Entry) (e : IEx) → PDiagT sk e
pex-diag sk ix0 X F G d = fmap-sw (dims sk) X (DL X (DL X F)) (DL X F) (DL X F) F (λ x q → fst q) (λ x q → fst q) (ddiag X F) (λ x q → fst q) (λ i x q → fst (fst q)) G d
pex-diag sk ix1 X F G d =
  fmap-sw (dims sk) X (DL X (DL X F)) (DL X F) (DL X F) F (λ x q → fst (snd q)) (λ x q → fst (snd q)) (ddiag X F) (λ x q → fst (snd q)) (λ i x q → fst (snd (fst (snd q)))) G d
pex-diag sk (ixv k) X F G d = ddv-diag sk k X F G d
pex-diag sk (ixneg r) X F G d = pex-diag-neg sk r (pex-diag sk r) X F G d
pex-diag sk (ixmeet r s) X F G d =
  pex-diag-cn sk dmeet r s (pex-diag sk r) (pex-diag sk s) (pex-exch sk s r) X F G d (λ i x y → dmeet X F x (ddiag X F x y))
pex-diag sk (ixjoin r s) X F G d =
  pex-diag-cn sk djoin r s (pex-diag sk r) (pex-diag sk s) (pex-exch sk s r) X F G d (λ i x y → djoin X F x (ddiag X F x y))
-- the degeneracy
pex-deg-cn : (sk : Lst Entry) (cn : (Z : Type 1) (H : Z → Type 1) (z : Z) → DL Z H z → DL Z (DL Z H) z) (r s : IEx) → PDegT sk r → PDegT sk s →
  (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X F G) →
  (q : PathP (λ i → (x : X) → F x → DL X (DL X F) x) (λ x y → cn X F x (degen-o X F x y)) (λ x y → degen-o X (DL X F) x (degen-o X F x y))) →
  DDDeg (dims sk) (λ Z H G' q' → papp-ex sk Z H r G' (papp-ex sk Z (DL Z H) s G' (dcube-fmap (dims sk) Z (DL Z H) (DL Z (DL Z H)) (cn Z H) G' q'))) X F G d
pex-deg-cn sk cn r s hr hs X F G d q =
  pc3 (DCube (dims sk) X F G)
    (papp-ex sk X F r G (papp-ex sk X (DL X F) s G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (cn X F) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d))))
    (papp-ex sk X F r G (papp-ex sk X (DL X F) s G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (degen-o X (DL X F)) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d))))
    (papp-ex sk X F r G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d))
    d
    (cong1 (DCube (dims sk) X (DL X (DL X F)) G) (DCube (dims sk) X F G) (λ w → (papp-ex sk X F r G (papp-ex sk X (DL X F) s G w))) (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (cn X F) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d)) (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (degen-o X (DL X F)) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d)) (fmap-sw (dims sk) X F (DL X F) (DL X F) (DL X (DL X F)) (degen-o X F) (cn X F) (degen-o X F) (degen-o X (DL X F)) q G d))
    (cong1 (DCube (dims sk) X (DL X F) G) (DCube (dims sk) X F G) (λ w → (papp-ex sk X F r G w)) (papp-ex sk X (DL X F) s G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (degen-o X (DL X F)) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d))) (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d) (hs X (DL X F) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d)))
    (hr X F G d)
pex-deg : (sk : Lst Entry) (e : IEx) → PDegT sk e
pex-deg sk ix0 X F G d = fmap-sw2i (dims sk) X F (DL X F) (degen-o X F) (λ x q → fst q) (λ i x y → y) G d
pex-deg sk ix1 X F G d = fmap-sw2i (dims sk) X F (DL X F) (degen-o X F) (λ x q → fst (snd q)) (λ i x y → y) G d
pex-deg sk (ixv k) X F G d = ddv-deg sk k X F G d
pex-deg sk (ixneg r) X F G d =
  (pcat (DCube (dims sk) X F G) (papp-ex sk X F r G (dcube-fmap (dims sk) X (DL X F) (DL X F) (drev X F) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d))) (papp-ex sk X F r G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d)) d (cong1 (DCube (dims sk) X (DL X F) G) (DCube (dims sk) X F G) (λ w → (papp-ex sk X F r G w)) (dcube-fmap (dims sk) X (DL X F) (DL X F) (drev X F) G (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d)) (dcube-fmap (dims sk) X F (DL X F) (degen-o X F) G d) (fmap-sw21 (dims sk) X F (DL X F) (DL X F) (degen-o X F) (drev X F) (degen-o X F) (λ i x y → degen-o X F x y) G d)) (pex-deg sk r X F G d))
pex-deg sk (ixmeet r s) X F G d = pex-deg-cn sk dmeet r s (pex-deg sk r) (pex-deg sk s) X F G d (λ i x y → degen-o X (DL X F) x (degen-o X F x y))
pex-deg sk (ixjoin r s) X F G d = pex-deg-cn sk djoin r s (pex-deg sk r) (pex-deg sk s) X F G d (λ i x y → degen-o X (DL X F) x (degen-o X F x y))

-- ---------------------------------------------------------------- (6) reify and reflect
-- (2026-11-12, (6)) reify-ty (a computable type to a normal type derivation), reify (a computable term
-- to a normal form) and reflect (a neutral at a computable type to a computable term), one triple by
-- recursion on the shape (RRT, rr), as in Abel–Coquand–Pagano. The bound variable of a λ, of a Π or Σ
-- type's codomain and of a pair's codomain is reflected over Γ extended by a type read off a meaning
-- (var-comp: the weakening's action, subM-wk, read as an ext-lift, wk-fm; the variable is one, var-lift);
-- a family's codomain is reified at the variable (cod-rty); a path λ's body and a PathP type's line at
-- dnf-v0 after world-dwk (subM-dwk, papp-dwk); reflect at Π applies the renamed neutral to the reified
-- argument, at Σ projects (the codomain's type at the identity world, subM-id), at PathP applies at the
-- form (the type's line read at the path's instance through papp-line-fmap and papp-line-pre).
-- composites of pointwise maps of meanings (fmapM-fmapM); path application to lines after a pointwise
-- map is to the composite lines (papp-line-pre)
fmapM-fmapM : (Γ : CCtx) (Z1 Z2 Z3 : Type 1) (g : Z1 → Z2) (g' : Z2 → Z3) (M : Mean Γ Z1) →
  PathM Γ Z3 (fmapM Γ Z2 Z3 g' (fmapM Γ Z1 Z2 g M)) (fmapM Γ Z1 Z3 (λ z → g' (g z)) M)
fmapM-fmapM Γ Z1 Z2 Z3 g g' M =
  fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Z1) (FbE (fst Γ) Z2) (FbE (fst Γ) Z3) (λ γ e ρ → g (e ρ)) (λ γ e ρ → g' (e ρ)) (snd Γ) M
papp-line-pre : (Γ : CCtx) (Y0 Y Z : Type 1) (g : Y0 → Y) (ℓ : Y → Line Z) (f : DNF) (M : Mean Γ Y0) →
  PathM Γ Z (papp-line Γ Y Z ℓ f (fmapM Γ Y0 Y g M)) (papp-line Γ Y0 Z (λ y → ℓ (g y)) f M)
papp-line-pre Γ Y0 Y Z g ℓ f M =
  λ i → papp-dd (fst Γ) (CtxV (fst Γ)) (FbE (fst Γ) Z) f (snd Γ)
    (fmap-fmap (dims (fst Γ)) (CtxV (fst Γ)) (FbE (fst Γ) Y0) (FbE (fst Γ) Y) (DL (CtxV (fst Γ)) (FbE (fst Γ) Z)) (λ γ e ρ → g (e ρ)) (fline (fst Γ) Y Z ℓ) (snd Γ) M i)
-- a pointwise map of a meaning, weakened to an extension read off M, is an ext-lift (wk-fm); a pointwise
-- map of an ext-lift is one (lift-fm); the new variable is one (var-lift)
wk-fm : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) (Z : Type 1) (k : Y → Z) →
  PathM (ext-h Γ a Y h M) Z (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) Z (fmapM Γ Y Z k M)) (ext-lift Γ a Y h Z (λ q x → k q) M)
wk-fm Γ a Y h M Z k =
  pcat (Mean (ext-h Γ a Y h M) Z) (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) Z (fmapM Γ Y Z k M))
    (wkM Γ a Y (λ γ e ρ → h (e ρ)) M Z (fmapM Γ Y Z k M)) (ext-lift Γ a Y h Z (λ q x → k q) M)
    (subM-wk Γ a Y (λ γ e ρ → h (e ρ)) M Z (fmapM Γ Y Z k M))
    (push-diag (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (fst Γ) Z) (FbE (lcons (e-ty a) (fst Γ)) Z)
       (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e N' ρ → N' (fst ρ)) (λ γ e ρ → k (e ρ)) (snd Γ) M)
lift-fm : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) (Z Z' : Type 1) (G0 : (q : Y) → El a (h q) → Z) (k : Z → Z') →
  PathM (ext-h Γ a Y h M) Z' (fmapM (ext-h Γ a Y h M) Z Z' k (ext-lift Γ a Y h Z G0 M)) (ext-lift Γ a Y h Z' (λ q x → k (G0 q x)) M)
lift-fm Γ a Y h M Z Z' G0 k =
  fmap-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) Z) (FbE (lcons (e-ty a) (fst Γ)) Z')
    (λ γ e → (γ , λ ρ → h (e ρ))) (λ γ e ρ → G0 (e (fst ρ)) (snd ρ)) (λ x' e ρ → k (e ρ)) (snd Γ) M
var-lift : (Γ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) →
  PathM (ext-h Γ a Y h M) (TV a) (varCube (ext-h Γ a Y h M) none) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M)
var-lift Γ a Y h M =
  of-lift (dims (fst Γ)) (CtxV (fst Γ)) (CtxV (lcons (e-ty a) (fst Γ))) (FbE (fst Γ) Y) (FbE (lcons (e-ty a) (fst Γ)) (TV a))
    (λ γ e → (γ , λ ρ → h (e ρ))) (varM (lcons (e-ty a) (fst Γ)) none) (snd Γ) M
-- the triple's types
RTyT : TyShape → Type 1
RTyT s = (Δ : CCtx) (T : Mean Δ (Sem s)) → CompTy s Δ T → RenR k-nf j-ty Δ s T
RfyT : TyShape → Type 1
RfyT s = (Δ : CCtx) (X : Mean Δ (TV s)) → CompS s Δ X → RenR k-nf j-tm Δ s X
RflT : TyShape → Type 1
RflT s = (Δ : CCtx) (X : Mean Δ (TV s)) → CompTy s Δ (fmapM Δ (TV s) (Sem s) (λ q → fst q) X) → (c : Code) → NN (k-ne , (j-tm , Δ , s , c , X)) → CompS s Δ X
RRT : TyShape → Type 1
RRT s = RTyT s × RfyT s × RflT s
-- the new variable of an extension read off M, at a computable type, is computable (reflected)
var-comp : (a : TyShape) → RflT a → (Γ : CCtx) (Y : Type 1) (h : Y → Sem a) (M : Mean Γ Y) → CompTy a Γ (fmapM Γ Y (Sem a) h M) →
  CompS a (ext-h Γ a Y h M) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M)
var-comp a rfl Γ Y h M ca =
  comp-tr a (ext-h Γ a Y h M) (varCube (ext-h Γ a Y h M) none) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M) (var-lift Γ a Y h M)
    (rfl (ext-h Γ a Y h M) (varCube (ext-h Γ a Y h M) none)
       (ty-tr a (ext-h Γ a Y h M) (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) (Sem a) (fmapM Γ Y (Sem a) h M))
          (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none))
          (pcat (Mean (ext-h Γ a Y h M) (Sem a)) (wact (ext-h Γ a Y h M) Γ (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M) (Sem a) (fmapM Γ Y (Sem a) h M))
             (ext-lift Γ a Y h (Sem a) (λ q x → h q) M) (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none))
             (wk-fm Γ a Y h M (Sem a) h)
             (psym (Mean (ext-h Γ a Y h M) (Sem a)) (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none)) (ext-lift Γ a Y h (Sem a) (λ q x → h q) M)
                (pcat (Mean (ext-h Γ a Y h M) (Sem a)) (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (varCube (ext-h Γ a Y h M) none))
                   (fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (ext-lift Γ a Y h (TV a) (λ q x → (h q , x)) M)) (ext-lift Γ a Y h (Sem a) (λ q x → h q) M)
                   (λ i → fmapM (ext-h Γ a Y h M) (TV a) (Sem a) (λ q → fst q) (var-lift Γ a Y h M i))
                   (lift-fm Γ a Y h M (TV a) (Sem a) (λ q x → (h q , x)) (λ q → fst q)))))
          (fst (comp-ren-e a) Γ (fmapM Γ Y (Sem a) h M) ca (ext-h Γ a Y h M) (world-wk Γ a Y (λ γ e ρ → h (e ρ)) M)))
       (cvar #0) (nvar (ext-h Γ a Y h M) none))
-- a family's codomain over the extension by its domain, read off M through k, reified at the variable
cod-rty : (a b : TyShape) → RflT a → RTyT b → (Δ : CCtx) (Y : Type 1) (k : Y → Fam a b) (M : Mean Δ Y) → CompTy (s-pi a b) Δ (fmapM Δ Y (Fam a b) k M) →
  RenR k-nf j-ty (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) b (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
cod-rty a b rfl rty Δ Y k M ct =
  rty (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
    (ty-tr b (ext-h Δ a Y (λ q → fam-dom a b (k q)) M)
       (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (Sem b) (fam-cod a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
       (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Sem b) (λ q x → snd (k q) x) M)
       (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (Sem b) (λ q x → (k q , x)) (fam-cod a b))
       (snd ct (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M)
          (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M)
          (pcat (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (Fam a b))
             (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (Fam a b) (λ q → fst q) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
             (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Fam a b) (λ q x → k q) M)
             (wact (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) Δ (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M) (Fam a b) (fmapM Δ Y (Fam a b) k M))
             (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (Fam a b) (λ q x → (k q , x)) (λ q → fst q))
             (psym (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (Fam a b))
                (wact (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) Δ (world-wk Δ a Y (λ γ e ρ → fam-dom a b (k (e ρ))) M) (Fam a b) (fmapM Δ Y (Fam a b) k M))
                (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (Fam a b) (λ q x → k q) M)
                (wk-fm Δ a Y (λ q → fam-dom a b (k q)) M (Fam a b) k)))
          (comp-tr a (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (TV a) (λ q x → (fam-dom a b (k q) , x)) M)
             (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (TV a) (fam-arg a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
             (psym (Mean (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (TV a))
                (fmapM (ext-h Δ a Y (λ q → fam-dom a b (k q)) M) (FamV a b) (TV a) (fam-arg a b) (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (FamV a b) (λ q x → (k q , x)) M))
                (ext-lift Δ a Y (λ q → fam-dom a b (k q)) (TV a) (λ q x → (fam-dom a b (k q) , x)) M)
                (lift-fm Δ a Y (λ q → fam-dom a b (k q)) M (FamV a b) (TV a) (λ q x → (k q , x)) (fam-arg a b)))
             (var-comp a rfl Δ Y (λ q → fam-dom a b (k q)) M
                (ty-tr a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ Y (Fam a b) k M)) (fmapM Δ Y (Sem a) (λ q → fam-dom a b (k q)) M)
                   (fmapM-fmapM Δ Y (Fam a b) (Sem a) k (fam-dom a b) M) (fst ct))))))
-- Bool
rty-bool : RTyT s-bool
rty-bool Δ T ct = (c-bool , nty-bool Δ T)
rfy-bool-c : (Δ : CCtx) (X : Mean Δ (TV s-bool)) → snd (CompE s-bool) Δ X → RenR k-nf j-tm Δ s-bool X
rfy-bool-c Δ X (inl1 p) = (c-true , nn-tr k-nf j-tm Δ s-bool c-true (fmapM Δ One1 (TV s-bool) (bool-v true) (fst p)) X (psym (Mean Δ (TV s-bool)) X (fmapM Δ One1 (TV s-bool) (bool-v true) (fst p)) (snd p)) (ntrue Δ (fst p)))
rfy-bool-c Δ X (inr1 (inl1 p)) = (c-false , nn-tr k-nf j-tm Δ s-bool c-false (fmapM Δ One1 (TV s-bool) (bool-v false) (fst p)) X (psym (Mean Δ (TV s-bool)) X (fmapM Δ One1 (TV s-bool) (bool-v false) (fst p)) (snd p)) (nfalse Δ (fst p)))
rfy-bool-c Δ X (inr1 (inr1 n)) = (fst n , nne Δ X (fst n) (snd n))
rfy-bool : RfyT s-bool
rfy-bool Δ X cx = rfy-bool-c Δ X (snd cx)
rfl-bool : RflT s-bool
rfl-bool Δ X ct c n = (ct , inr1 (inr1 (c , n)))
-- Π and Σ types: the domain, and the codomain at the variable (the family itself, k the identity, by fmap-id)
rty-fam-cod : (a b : TyShape) → RflT a → RTyT b → (Δ : CCtx) (T : Mean Δ (Fam a b)) → CompTy (s-pi a b) Δ T →
  RenR k-nf j-ty (ext-h Δ a (Fam a b) (fam-dom a b) T) b (fam-body Δ a b T)
rty-fam-cod a b rfl rty Δ T ct =
  cod-rty a b rfl rty Δ (Fam a b) (λ F → F) T
    (ty-tr (s-pi a b) Δ T (fmapM Δ (Fam a b) (Fam a b) (λ F → F) T)
       (psym (Mean Δ (Fam a b)) (fmapM Δ (Fam a b) (Fam a b) (λ F → F) T) T (fmap-id (dims (fst Δ)) (CtxV (fst Δ)) (FbE (fst Δ) (Fam a b)) (snd Δ) T)) ct)
rty-pi : (a b : TyShape) → RRT a → RRT b → RTyT (s-pi a b)
rty-pi a b Ra Rb Δ T ct = nn-ty-pi Δ a b T (fst Ra Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T) (fst ct)) (rty-fam-cod a b (snd (snd Ra)) (fst Rb) Δ T ct)
rty-sig : (a b : TyShape) → RRT a → RRT b → RTyT (s-sig a b)
rty-sig a b Ra Rb Δ T ct = nn-ty-sig Δ a b T (fst Ra Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) T) (fst ct)) (rty-fam-cod a b (snd (snd Ra)) (fst Rb) Δ T ct)
-- reify at Π: the body at the reflected variable over lam-ctx, the function applied to it by the
-- Kripke clause at world-wk (AppV data an ext-lift of X)
rfy-pi-dom : (a b : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-pi a b))) → CompTy (s-pi a b) Δ (fmapM Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) X) →
  CompTy a Δ (fmapM Δ (TV (s-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X)
rfy-pi-dom a b Δ X ct =
  ty-tr a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV (s-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X)
    (fmapM-fmapM Δ (TV (s-pi a b)) (Fam a b) (Sem a) (λ q → fst q) (fam-dom a b) X) (fst ct)
rfy-pi-body : (a b : TyShape) → RRT a → (Δ : CCtx) (X : Mean Δ (TV (s-pi a b))) → CompS (s-pi a b) Δ X → CompS b (lam-ctx Δ a b X) (lam-body Δ a b X)
rfy-pi-body a b Ra Δ X cx =
  comp-tr b (lam-ctx Δ a b X)
    (fmapM (lam-ctx Δ a b X) (AppV a b) (TV b) (app-r a b) (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
    (lam-body Δ a b X)
    (lift-fm Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV b) (λ q x → (fst q , snd q , x)) (app-r a b))
    (snd cx (lam-ctx Δ a b X) (world-wk Δ a (TV (s-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X)
       (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X)
       (pcat (Mean (lam-ctx Δ a b X) (TV (s-pi a b)))
          (fmapM (lam-ctx Δ a b X) (AppV a b) (TV (s-pi a b)) (app-f a b) (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
          (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-pi a b)) (λ q x → q) X)
          (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-pi a b)) X)
          (lift-fm Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV (s-pi a b)) (λ q x → (fst q , snd q , x)) (app-f a b))
          (psym (Mean (lam-ctx Δ a b X) (TV (s-pi a b)))
             (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-pi a b)) X)
             (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-pi a b)) (λ q x → q) X)
             (pcat (Mean (lam-ctx Δ a b X) (TV (s-pi a b)))
                (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-pi a b)) X)
                (wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-pi a b)) (fmapM Δ (TV (s-pi a b)) (TV (s-pi a b)) (λ q → q) X))
                (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (TV (s-pi a b)) (λ q x → q) X)
                (λ i → wact (lam-ctx Δ a b X) Δ (world-wk Δ a (TV (s-pi a b)) (λ γ e ρ → fam-dom a b (fst (e ρ))) X) (TV (s-pi a b))
                   (fmap-id (dims (fst Δ)) (CtxV (fst Δ)) (FbE (fst Δ) (TV (s-pi a b))) (snd Δ) X (~ i)))
                (wk-fm Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) X (TV (s-pi a b)) (λ q → q)))))
       (comp-tr a (lam-ctx Δ a b X) (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (TV a) (λ q x → (fam-dom a b (fst q) , x)) X)
          (fmapM (lam-ctx Δ a b X) (AppV a b) (TV a) (app-a a b) (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
          (psym (Mean (lam-ctx Δ a b X) (TV a))
             (fmapM (lam-ctx Δ a b X) (AppV a b) (TV a) (app-a a b) (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (AppV a b) (λ q x → (fst q , snd q , x)) X))
             (ext-lift Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) (TV a) (λ q x → (fam-dom a b (fst q) , x)) X)
             (lift-fm Δ a (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) X (AppV a b) (TV a) (λ q x → (fst q , snd q , x)) (app-a a b)))
          (var-comp a (snd (snd Ra)) Δ (TV (s-pi a b)) (λ q → fam-dom a b (fst q)) X (rfy-pi-dom a b Δ X (fst cx)))))
rfy-pi : (a b : TyShape) → RRT a → RRT b → RfyT (s-pi a b)
rfy-pi a b Ra Rb Δ X cx =
  nn-lam Δ a b X (fst Ra Δ (fmapM Δ (TV (s-pi a b)) (Sem a) (λ q → fam-dom a b (fst q)) X) (rfy-pi-dom a b Δ X (fst cx)))
    (fst (snd Rb) (lam-ctx Δ a b X) (lam-body Δ a b X) (rfy-pi-body a b Ra Δ X cx))
-- reify at Σ: the codomain at the pair's own family (cod-rty at fst), both components
rfy-sig : (a b : TyShape) → RRT a → RRT b → RfyT (s-sig a b)
rfy-sig a b Ra Rb Δ X cx =
  nn-pair Δ a b X (cod-rty a b (snd (snd Ra)) (fst Rb) Δ (TV (s-sig a b)) (λ q → fst q) X (fst cx))
    (fst (snd Ra) Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X) (fst (snd cx))) (fst (snd Rb) Δ (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X) (snd (snd cx)))
-- PathP: the line or the body at dnf-v0 after world-dwk, read back by subM-dwk and papp-dwk
rty-path-line : (a : TyShape) (Δ : CCtx) (T : Mean Δ (Sem (s-path a))) → CompTy (s-path a) Δ T → CompTy a (dext Δ) (path-line-ty Δ a T)
rty-path-line a Δ T ct =
  ty-tr a (dext Δ) (papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (Sem (s-path a)) T)) (path-line-ty Δ a T)
    (pcat (Mean (dext Δ) (Sem a)) (papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (Sem (s-path a)) T))
       (papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (dwkM Δ (Sem (s-path a)) T)) (path-line-ty Δ a T)
       (λ i → papp-line (dext Δ) (Sem (s-path a)) (Sem a) (ty-line a) dnf-v0 (subM-dwk Δ (Sem (s-path a)) T i))
       (papp-dwk Δ (Sem (s-path a)) (Sem a) (ty-line a) T))
    (fst ct (dext Δ) (world-dwk Δ) dnf-v0 unit unit)
rty-path : (a : TyShape) → RRT a → RTyT (s-path a)
rty-path a Ra Δ T ct =
  nn-ty-path Δ a T (fst Ra (dext Δ) (path-line-ty Δ a T) (rty-path-line a Δ T ct))
    (fst (snd Ra) Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-0 a) T) (fst (snd ct))) (fst (snd Ra) Δ (fmapM Δ (Sem (s-path a)) (TV a) (tend-1 a) T) (snd (snd ct)))
rfy-path-body : (a : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-path a))) → CompS (s-path a) Δ X → CompS a (dext Δ) (plam-body Δ a X)
rfy-path-body a Δ X cx =
  comp-tr a (dext Δ) (papp-mean (dext Δ) a dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (TV (s-path a)) X)) (plam-body Δ a X)
    (pcat (Mean (dext Δ) (TV a)) (papp-mean (dext Δ) a dnf-v0 (wact (dext Δ) Δ (world-dwk Δ) (TV (s-path a)) X))
       (papp-mean (dext Δ) a dnf-v0 (dwkM Δ (TV (s-path a)) X)) (plam-body Δ a X)
       (λ i → papp-mean (dext Δ) a dnf-v0 (subM-dwk Δ (TV (s-path a)) X i))
       (papp-dwk Δ (TV (s-path a)) (TV a) (path-pt a) X))
    (snd cx (dext Δ) (world-dwk Δ) dnf-v0 unit unit)
rfy-path : (a : TyShape) → RRT a → RfyT (s-path a)
rfy-path a Ra Δ X cx = nn-plam Δ a X (fst (snd Ra) (dext Δ) (plam-body Δ a X) (rfy-path-body a Δ X cx))
-- reflect at Π: at every later world and computable argument, the renamed neutral applied to the
-- reified argument, at the codomain's type that the type's Kripke clause gives (FamV data read off the
-- AppV data)
rfl-pi-cod : (a b : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-pi a b))) → CompTy (s-pi a b) Δ (fmapM Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) X) →
  (Δ' : CCtx) (w : World Δ' Δ) (Y : Mean Δ' (AppV a b)) →
  PathM Δ' (TV (s-pi a b)) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y) (wact Δ' Δ w (TV (s-pi a b)) X) →
  CompS a Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) → CompTy b Δ' (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
rfl-pi-cod a b Δ X ct Δ' w Y q ca =
  ty-tr b Δ' (fmapM Δ' (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
    (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
    (pcat (Mean Δ' (Sem b)) (fmapM Δ' (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
       (fmapM Δ' (AppV a b) (Sem b) (λ r → snd (fst r) (snd (snd r))) Y) (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y))
       (fmapM-fmapM Δ' (AppV a b) (FamV a b) (Sem b) (λ r → (fst r , snd (snd r))) (fam-cod a b) Y)
       (psym (Mean Δ' (Sem b)) (fmapM Δ' (TV b) (Sem b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y)) (fmapM Δ' (AppV a b) (Sem b) (λ r → snd (fst r) (snd (snd r))) Y)
          (fmapM-fmapM Δ' (AppV a b) (TV b) (Sem b) (app-r a b) (λ q → fst q) Y)))
    (snd ct Δ' w (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y)
       (pcat (Mean Δ' (Fam a b)) (fmapM Δ' (FamV a b) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
          (fmapM Δ' (AppV a b) (Fam a b) (λ r → fst r) Y) (wact Δ' Δ w (Fam a b) (fmapM Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) X))
          (fmapM-fmapM Δ' (AppV a b) (FamV a b) (Fam a b) (λ r → (fst r , snd (snd r))) (λ q → fst q) Y)
          (pcat (Mean Δ' (Fam a b)) (fmapM Δ' (AppV a b) (Fam a b) (λ r → fst r) Y)
             (fmapM Δ' (TV (s-pi a b)) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y))
             (wact Δ' Δ w (Fam a b) (fmapM Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) X))
             (psym (Mean Δ' (Fam a b)) (fmapM Δ' (TV (s-pi a b)) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y)) (fmapM Δ' (AppV a b) (Fam a b) (λ r → fst r) Y)
                (fmapM-fmapM Δ' (AppV a b) (TV (s-pi a b)) (Fam a b) (app-f a b) (λ q → fst q) Y))
             (pcat (Mean Δ' (Fam a b)) (fmapM Δ' (TV (s-pi a b)) (Fam a b) (λ q → fst q) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y))
                (fmapM Δ' (TV (s-pi a b)) (Fam a b) (λ q → fst q) (wact Δ' Δ w (TV (s-pi a b)) X))
                (wact Δ' Δ w (Fam a b) (fmapM Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) X))
                (λ i → fmapM Δ' (TV (s-pi a b)) (Fam a b) (λ q → fst q) (q i))
                (subM-fmap Δ' Δ (TV (s-pi a b)) (Fam a b) (λ q → fst q) (world-sub Δ' Δ w) X))))
       (comp-tr a Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) (fmapM Δ' (FamV a b) (TV a) (fam-arg a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y))
          (psym (Mean Δ' (TV a)) (fmapM Δ' (FamV a b) (TV a) (fam-arg a b) (fmapM Δ' (AppV a b) (FamV a b) (λ r → (fst r , snd (snd r))) Y)) (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y)
             (fmapM-fmapM Δ' (AppV a b) (FamV a b) (TV a) (λ r → (fst r , snd (snd r))) (fam-arg a b) Y))
          ca))
rfl-pi : (a b : TyShape) → RRT a → RRT b → RflT (s-pi a b)
rfl-pi a b Ra Rb Δ X ct c n =
  (ct , λ Δ' w Y q ca →
     snd (snd Rb) Δ' (fmapM Δ' (AppV a b) (TV b) (app-r a b) Y) (rfl-pi-cod a b Δ X ct Δ' w Y q ca)
       (capp (fst (ren-nn {(k-ne , (j-tm , Δ , s-pi a b , c , X))} n Δ' w)) (fst (fst (snd Ra) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) ca)))
       (napp Δ' a b Y (fst (ren-nn {(k-ne , (j-tm , Δ , s-pi a b , c , X))} n Δ' w)) (fst (fst (snd Ra) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) ca))
          (nn-tr k-ne j-tm Δ' (s-pi a b) (fst (ren-nn {(k-ne , (j-tm , Δ , s-pi a b , c , X))} n Δ' w)) (wact Δ' Δ w (TV (s-pi a b)) X) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y)
             (psym (Mean Δ' (TV (s-pi a b))) (fmapM Δ' (AppV a b) (TV (s-pi a b)) (app-f a b) Y) (wact Δ' Δ w (TV (s-pi a b)) X) q) (snd (ren-nn {(k-ne , (j-tm , Δ , s-pi a b , c , X))} n Δ' w)))
          (snd (fst (snd Ra) Δ' (fmapM Δ' (AppV a b) (TV a) (app-a a b) Y) ca))))
rfl-sig-1 : (a b : TyShape) → RRT a → (Δ : CCtx) (X : Mean Δ (TV (s-sig a b))) → CompTy (s-sig a b) Δ (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X) →
  (c : Code) → NN (k-ne , (j-tm , Δ , s-sig a b , c , X)) → CompS a Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X)
rfl-sig-1 a b Ra Δ X ct c n =
  snd (snd Ra) Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X)
    (ty-tr a Δ (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV a) (Sem a) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X))
       (pcat (Mean Δ (Sem a)) (fmapM Δ (Fam a b) (Sem a) (fam-dom a b) (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV (s-sig a b)) (Sem a) (λ q → fst (fst q)) X)
          (fmapM Δ (TV a) (Sem a) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X))
          (fmapM-fmapM Δ (TV (s-sig a b)) (Fam a b) (Sem a) (λ q → fst q) (fam-dom a b) X)
          (psym (Mean Δ (Sem a)) (fmapM Δ (TV a) (Sem a) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X)) (fmapM Δ (TV (s-sig a b)) (Sem a) (λ q → fst (fst q)) X)
             (fmapM-fmapM Δ (TV (s-sig a b)) (TV a) (Sem a) (sig-1 a b) (λ q → fst q) X)))
       (fst ct))
    (cfst c) (nfst Δ a b X c n)
-- the first projection reflected; the second's type by the Σ type's Kripke clause at the identity world
-- at the first
rfl-sig-cod : (a b : TyShape) (Δ : CCtx) (X : Mean Δ (TV (s-sig a b))) → CompTy (s-sig a b) Δ (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X) →
  CompS a Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X) → CompTy b Δ (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X))
rfl-sig-cod a b Δ X ct c1 =
  ty-tr b Δ (fmapM Δ (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ (TV (s-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
    (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X))
    (pcat (Mean Δ (Sem b)) (fmapM Δ (FamV a b) (Sem b) (fam-cod a b) (fmapM Δ (TV (s-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
       (fmapM Δ (TV (s-sig a b)) (Sem b) (λ q → snd (fst q) (fst (snd q))) X) (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X))
       (fmapM-fmapM Δ (TV (s-sig a b)) (FamV a b) (Sem b) (λ q → (fst q , fst (snd q))) (fam-cod a b) X)
       (psym (Mean Δ (Sem b)) (fmapM Δ (TV b) (Sem b) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X)) (fmapM Δ (TV (s-sig a b)) (Sem b) (λ q → snd (fst q) (fst (snd q))) X)
          (fmapM-fmapM Δ (TV (s-sig a b)) (TV b) (Sem b) (sig-2 a b) (λ q → fst q) X)))
    (snd ct Δ (world-id Δ) (fmapM Δ (TV (s-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X)
       (pcat (Mean Δ (Fam a b)) (fmapM Δ (FamV a b) (Fam a b) (λ q → fst q) (fmapM Δ (TV (s-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
          (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X) (wact Δ Δ (world-id Δ) (Fam a b) (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X))
          (fmapM-fmapM Δ (TV (s-sig a b)) (FamV a b) (Fam a b) (λ q → (fst q , fst (snd q))) (λ q → fst q) X)
          (psym (Mean Δ (Fam a b)) (wact Δ Δ (world-id Δ) (Fam a b) (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X)) (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X)
             (subM-id Δ (Fam a b) (fmapM Δ (TV (s-sig a b)) (Fam a b) (λ q → fst q) X))))
       (comp-tr a Δ (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X) (fmapM Δ (FamV a b) (TV a) (fam-arg a b) (fmapM Δ (TV (s-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X))
          (psym (Mean Δ (TV a)) (fmapM Δ (FamV a b) (TV a) (fam-arg a b) (fmapM Δ (TV (s-sig a b)) (FamV a b) (λ q → (fst q , fst (snd q))) X)) (fmapM Δ (TV (s-sig a b)) (TV a) (sig-1 a b) X)
             (fmapM-fmapM Δ (TV (s-sig a b)) (FamV a b) (TV a) (λ q → (fst q , fst (snd q))) (fam-arg a b) X))
          c1))
-- reflect at Σ: the projections (rfl-sig-1, rfl-sig-cod)
rfl-sig : (a b : TyShape) → RRT a → RRT b → RflT (s-sig a b)
rfl-sig a b Ra Rb Δ X ct c n =
  (ct , rfl-sig-1 a b Ra Δ X ct c n ,
   snd (snd Rb) Δ (fmapM Δ (TV (s-sig a b)) (TV b) (sig-2 a b) X) (rfl-sig-cod a b Δ X ct (rfl-sig-1 a b Ra Δ X ct c n)) (csnd c) (nsnd Δ a b X c n))
-- reflect at PathP: at every later world and canonical non-constant form, the renamed neutral applied
-- there, at the type's line there (papp-line-fmap, papp-line-pre, subM-fmap)
rfl-path-ty : (a : TyShape) (Δ' : CCtx) (f : DNF) (X' : Mean Δ' (TV (s-path a))) (T' : Mean Δ' (Sem (s-path a))) →
  PathM Δ' (Sem (s-path a)) (fmapM Δ' (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X') T' →
  PathM Δ' (Sem a) (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f T') (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X'))
rfl-path-ty a Δ' f X' T' p =
  pcat (Mean Δ' (Sem a)) (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f T')
    (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (fmapM Δ' (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X'))
    (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X'))
    (λ i → papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (p (~ i)))
    (pcat (Mean Δ' (Sem a)) (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (fmapM Δ' (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X'))
       (papp-line Δ' (TV (s-path a)) (Sem a) (λ y → line-map (TV a) (Sem a) (λ q → fst q) (path-pt a y)) f X')
       (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X'))
       (papp-line-pre Δ' (TV (s-path a)) (Sem (s-path a)) (Sem a) (λ q → fst q) (ty-line a) f X')
       (psym (Mean Δ' (Sem a)) (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f X')) (papp-line Δ' (TV (s-path a)) (Sem a) (λ y → line-map (TV a) (Sem a) (λ q → fst q) (path-pt a y)) f X')
          (papp-line-fmap Δ' (TV (s-path a)) (TV a) (Sem a) (path-pt a) (λ q → fst q) f X')))
rfl-path : (a : TyShape) → RRT a → RflT (s-path a)
rfl-path a Ra Δ X ct c n =
  (ct , λ Δ' w f cf nc →
     snd (snd Ra) Δ' (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X))
       (ty-tr a Δ' (papp-line Δ' (Sem (s-path a)) (Sem a) (ty-line a) f (wact Δ' Δ w (Sem (s-path a)) (fmapM Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X)))
          (fmapM Δ' (TV a) (Sem a) (λ q → fst q) (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)))
          (rfl-path-ty a Δ' f (wact Δ' Δ w (TV (s-path a)) X) (wact Δ' Δ w (Sem (s-path a)) (fmapM Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) X))
             (subM-fmap Δ' Δ (TV (s-path a)) (Sem (s-path a)) (λ q → fst q) (world-sub Δ' Δ w) X))
          (fst ct Δ' w f cf nc))
       (cpapp (fst (ren-nn {(k-ne , (j-tm , Δ , s-path a , c , X))} n Δ' w)) (dnf-code f))
       (npapp Δ' a (wact Δ' Δ w (TV (s-path a)) X) (fst (ren-nn {(k-ne , (j-tm , Δ , s-path a , c , X))} n Δ' w)) f cf nc (papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X))
          (λ i → papp-mean Δ' a f (wact Δ' Δ w (TV (s-path a)) X)) (snd (ren-nn {(k-ne , (j-tm , Δ , s-path a , c , X))} n Δ' w))))
-- reify-ty, reify and reflect, one triple by recursion on the shape
rr : (s : TyShape) → RRT s
rr s-bool = (rty-bool , rfy-bool , rfl-bool)
rr (s-pi a b) = (rty-pi a b (rr a) (rr b) , rfy-pi a b (rr a) (rr b) , rfl-pi a b (rr a) (rr b))
rr (s-sig a b) = (rty-sig a b (rr a) (rr b) , rfy-sig a b (rr a) (rr b) , rfl-sig a b (rr a) (rr b))
rr (s-path a) = (rty-path a (rr a) , rfy-path a (rr a) , rfl-path a (rr a))
