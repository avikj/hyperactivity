    (λ γ' t → (γ' , t)) (λ γ' t v → ((fst (fst t) , f (fst (fst t)) (snd t)) , λ ρ' → (snd (fst t) ρ' , v ρ'))) (snd Δ) (sub-tot Δ Γ Y σ M) V
