       (cong1 (DCube (dims sk') X (DL X F) (cco sk' sk r X G)) (DCube (dims sk') X F (cco sk' sk r X G)) (λ w → papp-ex sk' X F (ixr r x) (cco sk' sk r X G) w) (papp-ex sk' X (DL X F) (ixr r y) (cco sk' sk r X G) (ccd sk' sk r X (DL X (DL X F)) G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G Q))) (ccd sk' sk r X (DL X F) G (papp-ex sk X (DL X F) y G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G Q))) (papp-ex-cmap sk' sk r dp y X (DL X F) G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G Q)))
       (papp-ex-cmap sk' sk r dp x X F G (papp-ex sk X (DL X F) y G (dcube-fmap (dims sk) X (DL X F) (DL X (DL X F)) (λ x q → meet-o X F (degen-l X x) q) G Q))))
