    (psym (Cube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ')))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (dcube-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M))) (dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t → (γ' , λ ρ' → h (snd t (snd (fst t) ρ')))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)) (dmap-fmap (dims (fst Δ')) (CtxV (fst Δ')) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') (sub-tot Δ' Δ Y (world-sub Δ' Δ w) M)))
    (λ i → dcube-map (dims (fst Δ')) (CtxV (fst Δ')) (FbE (fst Δ') Y) (CtxV (lcons (e-ty a) (fst Δ'))) (λ γ e → (γ , λ ρ → h (e ρ))) (snd Δ') ((fmap-pull (dims (fst Δ')) (CtxV (fst Δ')) (CtxV (fst Δ)) (SubF (fst Δ') (fst Δ)) (SubT (fst Δ') (fst Δ) Y) (FbE (fst Δ') Y) (FbE (fst Δ) Y) (λ γ' p → fst p) (λ γ' p e → (p , e)) (λ γ' t ρ' → snd t (snd (fst t) ρ')) (snd Δ') (fst (snd (world-sub Δ' Δ w))) (sub-carried Δ' Δ Y (world-sub Δ' Δ w) M)) i))
keep-S : (Δ' Δ : CCtx) (a : TyShape) (Y : Type 1) (h : Y → Sem a) (M : Mean Δ Y) (w : World Δ' Δ) → DCube (dims (fst Δ')) (CtxV (lcons (e-ty a) (fst Δ'))) (SubF (lcons (e-ty a) (fst Δ')) (lcons (e-ty a) (fst Δ))) (snd (extM Δ' a Y (λ γ e ρ → h (e ρ)) (subM Δ' Δ Y (world-sub Δ' Δ w) M)))
