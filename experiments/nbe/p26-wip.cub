diag-exch-d : (sk : Lst Entry) (j j' : Word) (X : Type 1) (F : X → Type 1) (D : Cube (dims sk) (Line (Line X))) (d : DCube (dims sk) (Line (Line X)) (LineO (Line X) (LineO X F)) D) → DexD sk j j' X F D d
diag-exch-d lnil j j' X F D d = λ i → fst (fst d)
diag-exch-d (lcons (e-ty s) sk) j j' X F D d =
  %welimP (λ v → (v' : Word) → DexD (lcons (e-ty s) sk) v v' X F D d) j
    (λ v' → %welimP (λ u → DexD (lcons (e-ty s) sk) #0 u X F D d) v' (dexd-t00 sk s X F D d) (λ k' h' → dexd-t0S sk s k' X F D d))
    (λ k h v' → %welimP (λ u → DexD (lcons (e-ty s) sk) (%wsucc k) u X F D d) v' (dexd-tS0 sk s k X F D d) (λ k' h' → dexd-tSS sk s k k' (λ X' F' D' d' → diag-exch-d sk k k' X' F' D' d') X F D d))
    j'
diag-exch-d (lcons e-dim sk) j j' X F D d =
  %welimP (λ v → (v' : Word) → DexD (lcons e-dim sk) v v' X F D d) j
    (λ v' → %welimP (λ u → DexD (lcons e-dim sk) #0 u X F D d) v' (dexd-d00 sk X F D d) (λ k' h' → dexd-d0S sk k' X F D d))
    (λ k h v' → %welimP (λ u → DexD (lcons e-dim sk) (%wsucc k) u X F D d) v' (dexd-dS0 sk k X F D d) (λ k' h' → dexd-dSS sk k k' (λ X' F' D' d' → diag-exch-d sk k k' X' F' D' d') X F D d))
    j'
-- (2026-11-12, (4r-d)) path application on cubes over cubes is natural in the base (over papp-nat, by
-- its recursion: papp-lit-nat-d by the case of the literal's sign, the motive's base path papp-lit-nat
-- at (fst l , b), which is papp-lit-nat at l by η; the inner chains of the connections named, pcf-in
-- and pdf-in), so the action of a dimension part is (cmap-nat-d, over cmap-nat)
PLN : (sk : Lst Entry) (X Y : Type 1) (F : X → Type 1) (G : Y → Type 1) (h : X → Y) (hd : (x : X) → F x → G (h x)) (o : Word) (l : Lit) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) → Type 1
PLN sk X Y F G h hd o l c d = PathP (λ i → DCube (dims sk) Y G (papp-lit-nat sk X Y h o l c i)) (papp-lit-d sk Y G o l (cube-map (suc (dims sk)) X Y h c) (dcube-reidx (suc (dims sk)) X Y F G h hd c d)) (dcube-reidx (dims sk) X Y F G h hd (papp-lit sk X o l c) (papp-lit-d sk X F o l c d))
papp-lit-nat-d : (sk : Lst Entry) (X Y : Type 1) (F : X → Type 1) (G : Y → Type 1) (h : X → Y) (hd : (x : X) → F x → G (h x)) (o : Word) (l : Lit) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X F c) → PLN sk X Y F G h hd o l c d
papp-lit-nat-d sk X Y F G h hd o l c d =
  bool-elim1 (λ b → PLN sk X Y F G h hd o (fst l , b) c d)
    (diag-nat-d sk (%wadd (fst l) o) X Y F G h hd c d)
    (pcat-d (Cube (dims sk) Y) (DCube (dims sk) Y G)
       (diag-sk sk (%wadd (fst l) o) Y (cube-map (dims sk) (Line Y) (Line Y) (rev-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)))
       (diag-sk sk (%wadd (fst l) o) Y (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (cube-map (dims sk) X Y h (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)))
       (λ i → diag-sk sk (%wadd (fst l) o) Y (cube-comp2 (dims sk) (Line X) (Line Y) (Line X) (Line Y) (rev-l Y) (line-map X Y h) (line-map X Y h) (rev-l X) c (λ j → cube-map (dims sk) (Line X) (Line Y) (λ L → rev-l Y ((line-map X Y h) L)) c) i))
       (diag-nat sk (%wadd (fst l) o) X Y h (cube-map (dims sk) (Line X) (Line X) (rev-l X) c))
       (diag-sk-d sk (%wadd (fst l) o) Y G (cube-map (dims sk) (Line Y) (Line Y) (rev-l Y) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c)) (dcube-reidx (dims sk) (Line Y) (Line Y) (LineO Y G) (LineO Y G) (rev-l Y) (rev-o Y G) (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) c) (dcube-reidx (dims sk) (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y h) (lineo-reidx X Y F G h hd) c d)))
       (diag-sk-d sk (%wadd (fst l) o) Y G (cube-map (dims sk) (Line X) (Line Y) (line-map X Y h) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)) (dcube-reidx (dims sk) (Line X) (Line Y) (LineO X F) (LineO Y G) (line-map X Y h) (lineo-reidx X Y F G h hd) (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
       (dcube-reidx (dims sk) X Y F G h hd (diag-sk sk (%wadd (fst l) o) X (cube-map (dims sk) (Line X) (Line X) (rev-l X) c)) (diag-sk-d sk (%wadd (fst l) o) X F (cube-map (dims sk) (Line X) (Line X) (rev-l X) c) (dcube-reidx (dims sk) (Line X) (Line X) (LineO X F) (LineO X F) (rev-l X) (rev-o X F) c d)))
