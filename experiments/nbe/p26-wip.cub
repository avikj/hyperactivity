    (papp-cube-d (lcons e sk') X F (lcons (lcons (%wsucc (r #0) , true) lnil) lnil) (cmap-cube (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r (%wsucc k)))) (Line X) c)
       (cmap-d (lcons e sk') sk (cmap-of (lcons e sk') sk (λ k → %wsucc (r (%wsucc k)))) (Line X) (LineO X F) c d))
    (diag-sk-d (lcons e sk') (%wsucc (r #0)) X F (skip-cube e sk' (Line X) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)) (skip-d e sk' (Line X) (LineO X F) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c) (cmap-d sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) (LineO X F) c d)))
    (skip-d e sk' X F (papp-cube sk' X (lcons (lcons (r #0 , true) lnil) lnil) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c)) (papp-cube-d sk' X F (lcons (lcons (r #0 , true) lnil) lnil) (cmap-cube sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) c) (cmap-d sk' sk (cmap-of sk' sk (λ k → r (%wsucc k))) (Line X) (LineO X F) c d)))
