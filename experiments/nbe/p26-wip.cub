    (plam-body Δ' a (subM Δ' Δ (TV (s-path a)) (world-sub Δ' Δ w) X))
subM-plam-body Δ' Δ w a X = dkeep-line Δ' Δ w (TV (s-path a)) (TV a) (path-pt a) X

-- (2026-11-12, (6) toward subM-lam-body) a lift (dcube-lift: a cube over a mapped base read off the
-- cube itself) commutes with the generators, with path application and with a dimension part's action,
-- each a PathP over the matching dmap path (lift-gen over dmap-gen; diag-lift over diag-dmap;
-- papp-lit-lift … papp-lift over papp-lit-dmap … papp-dmap; const-lift over dmap-const-cube;
-- cmap-d-lift over cmap-dmap), by the recursion of those paths: the generator's case pointwise (ql,
-- judgmental where used), a composite by pcat-d of the pieces' lifts. Then a lift over a pulled cube
-- against the lift over the cube it is pulled from (lift-pull, over map-pull), a pull along a lift
-- (pull-lift, given the pulled cube's path over map-lift to a lift), and a lift over a fibrewise map
-- (lift-fmap, over dmap-fmap).
lift-gen : (n : Nat) (X X' : Type 1) (F : X → Type 1) (F' : X' → Type 1) (Z Z' : Type 1) (φ : X → X') (φo : (x : X) → F x → F' (φ x))
  (h : Z → Z') (gm : (x : X) → F x → Z) (gm' : (x' : X') → F' x' → Z')
  (q : PathP (λ i → (xq : X) (yq : F xq) → Z') (λ xq yq → h (gm xq yq)) (λ xq yq → gm' (φ xq) (φo xq yq)))
  (H : Z → Type 1) (H' : Z' → Type 1) (hH : (z : Z) → H z → H' (h z)) (l : (x : X) (y : F x) → H (gm x y)) (l' : (x' : X') (y' : F' x') → H' (gm' x' y'))
  (ql : PathP (λ i → (xq : X) (yq : F xq) → H' (q i xq yq)) (λ xq yq → hH (gm xq yq) (l xq yq)) (λ xq yq → l' (φ xq) (φo xq yq)))
  (c : Cube n X) (d : DCube n X F c) →
  PathP (λ i → DCube n Z' H' (dmap-gen n X X' F F' Z Z' φ φo h gm gm' q c d i))
    (dcube-reidx n Z Z' H H' h hH (dcube-map n X F Z gm c d) (dcube-lift n X Z F H gm l c d))
    (dcube-lift n X' Z' F' H' gm' l' (cube-map n X X' φ c) (dcube-reidx n X X' F F' φ φo c d))
lift-gen zero X X' F F' Z Z' φ φo h gm gm' q H H' hH l l' ql c d = λ i → ql i c d
lift-gen (suc n) X X' F F' Z Z' φ φo h gm gm' q H H' hH l l' ql c d =
  lift-gen n (Line X) (Line X') (LineO X F) (LineO X' F') (Line Z) (Line Z') (line-map X X' φ) (lineo-reidx X X' F F' φ φo) (line-map Z Z' h)
    (lineo-map X F Z gm) (lineo-map X' F' Z' gm')
    (λ i L D → (q i (fst L) (fst D) , q i (fst (snd L)) (fst (snd D)) , λ j → q i (snd (snd L) j) (snd (snd D) j)))
    (LineO Z H) (LineO Z' H') (lineo-reidx Z Z' H H' h hH) (lineo-lift X Z F H gm l) (lineo-lift X' Z' F' H' gm' l')
    (λ i L D → (ql i (fst L) (fst D) , ql i (fst (snd L)) (fst (snd D)) , λ j → ql i (snd (snd L) j) (snd (snd D) j))) c d
-- the statement of diag-lift (DLift), and its cases at a type entry and a dimension entry as functions of
-- the boolean weq k #0 (DLTy, DLDim: over ddm-ty and ddm-dim, which agree with diag-dmap's clauses,
-- ddm-ty-is, ddm-dim-is); the case at a dimension entry with k not 0 takes the hypothesis (dl-dim-f)
DLift : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → Type 1
DLift sk k X Y Z H f g c d =
  PathP (λ i → DCube (dims sk) Z H (diag-dmap sk k X Y Z f c d i))
    (diag-sk-d sk k Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d))
    (dcube-lift (dims sk) X Z Y H f g (diag-sk sk k X c) (diag-sk-d sk k X Y c d))
DLTy : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → Bool → Type 1
DLTy sk k X Y Z H f g c d b =
  PathP (λ i → DCube (dims sk) Z H (ddm-ty sk k X Y Z f c d b i))
    (dsd-ty sk k Z H (dcube-map (suc (dims sk)) X Y Z f c d) (dcube-lift (suc (dims sk)) X Z Y H f g c d) b)
    (dcube-lift (dims sk) X Z Y H f g (dsk-ty sk k X c b) (dsd-ty sk k X Y c d b))
DLDim : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (suc (dims sk))) X) (d : DCube (suc (suc (dims sk))) X Y c) → Bool → Type 1
DLDim sk k X Y Z H f g c d b =
  PathP (λ i → DCube (suc (dims sk)) Z H (ddm-dim sk k X Y Z f c d b i))
    (dsd-dim sk k Z H (dm2 (dims sk) X Y Z f c d) (dcube-lift (suc (suc (dims sk))) X Z Y H f g c d) b)
    (dcube-lift (suc (dims sk)) X Z Y H f g (dsk-dim sk k X c b) (dsd-dim sk k X Y c d b))
dl-dim-f : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (suc (dims sk))) X) (d : DCube (suc (suc (dims sk))) X Y c) →
  DLift sk (%wsub k #1) (Line X) (LineO X Y) (Line Z) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) (exc (dims sk) X c) (exd (dims sk) X Y c d) →
  DLDim sk k X Y Z H f g c d false
dl-dim-f sk k X Y Z H f g c d IH =
  (pcat-d (Cube (suc (dims sk)) Z) (λ u → DCube (suc (dims sk)) Z H u) (diag-sk sk (%wsub k #1) (Line Z) (exc (dims sk) Z (dm2 (dims sk) X Y Z f c d))) (diag-sk sk (%wsub k #1) (Line Z) (dm2 (dims sk) X Y Z f (exc (dims sk) X c) (exd (dims sk) X Y c d))) (dcube-map (suc (dims sk)) X Y Z f (diag-sk sk (%wsub k #1) (Line X) (exc (dims sk) X c)) (diag-sk-d sk (%wsub k #1) (Line X) (LineO X Y) (exc (dims sk) X c) (exd (dims sk) X Y c d))) (ddp1 sk k X Y Z f c d) (ddp2 sk k X Y Z f c d) (diag-sk-d sk (%wsub k #1) (Line Z) (LineO Z H) (exc (dims sk) Z (dm2 (dims sk) X Y Z f c d)) (exd (dims sk) Z H (dm2 (dims sk) X Y Z f c d) (dcube-lift (suc (suc (dims sk))) X Z Y H f g c d))) (diag-sk-d sk (%wsub k #1) (Line Z) (LineO Z H) (dm2 (dims sk) X Y Z f (exc (dims sk) X c) (exd (dims sk) X Y c d)) (dcube-lift (dims sk) (Line (Line X)) (Line (Line Z)) (LineO (Line X) (LineO X Y)) (LineO (Line Z) (LineO Z H)) (mf2 X Y Z f) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (exc (dims sk) X c) (exd (dims sk) X Y c d))) (dcube-lift (suc (dims sk)) X Z Y H f g (diag-sk sk (%wsub k #1) (Line X) (exc (dims sk) X c)) (diag-sk-d sk (%wsub k #1) (Line X) (LineO X Y) (exc (dims sk) X c) (exd (dims sk) X Y c d))) (λ i → diag-sk-d sk (%wsub k #1) (Line Z) (LineO Z H) (dpg sk X Z Y f c d i) (lift-gen (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X Y)) (LineO (Line X) (LineO X Y)) (Line (Line Z)) (Line (Line Z)) (exch-l X) (exch-o X Y) (exch-l Z) (mf2 X Y Z f) (mf2 X Y Z f) (λ j Q D → exch-l Z (mf2 X Y Z f Q D)) (LineO (Line Z) (LineO Z H)) (LineO (Line Z) (LineO Z H)) (exch-o Z H) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (λ j Q D → exch-o Z H (mf2 X Y Z f Q D) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) Q D)) c d i)) IH)
diag-lift : (sk : Lst Entry) (k : Word) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) → DLift sk k X Y Z H f g c d
diag-lift lnil k X Y Z H f g c d = λ i → g (fst c) (fst d)
diag-lift (lcons (e-ty s) sk) k X Y Z H f g c d =
  bool-elim1 (DLTy sk k X Y Z H f g c d)
    (lift-gen (dims sk) (Line X) X (LineO X Y) Y (Line Z) Z (face0-l X) (face0-o X Y) (face0-l Z) (lineo-map X Y Z f) f (λ i L D → f (fst L) (fst D)) (LineO Z H) H (face0-o Z H) (lineo-lift X Z Y H f g) g (λ i L D → g (fst L) (fst D)) c d)
    (diag-lift sk (%wsub k #1) X Y Z H f g c d) (weq k #0)
diag-lift (lcons e-dim sk) k X Y Z H f g c d =
  bool-elim1 (DLDim sk k X Y Z H f g c d)
    (lift-gen (dims sk) (Line (Line X)) (Line X) (LineO (Line X) (LineO X Y)) (LineO X Y) (Line (Line Z)) (Line Z) (diag-l X) (diag-o X Y) (diag-l Z) (mf2 X Y Z f) (lineo-map X Y Z f) (λ i Q D → diag-l Z (mf2 X Y Z f Q D)) (LineO (Line Z) (LineO Z H)) (LineO Z H) (diag-o Z H) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g)) (lineo-lift X Z Y H f g) (λ i Q D → diag-o Z H (mf2 X Y Z f Q D) (lineo-lift (Line X) (Line Z) (LineO X Y) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) Q D)) c d)
    (dl-dim-f sk k X Y Z H f g c d (diag-lift sk (%wsub k #1) (Line X) (LineO X Y) (Line Z) (LineO Z H) (lineo-map X Y Z f) (lineo-lift X Z Y H f g) (exc (dims sk) X c) (exd (dims sk) X Y c d)))
    (weq k #0)
-- the statement of a lift's commuting with an operation on cubes (oc, od) over its dmap path om (LiftT)
LiftT : (n : Nat) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y))
  (oc : (W : Type 1) → Cube (suc n) W → Cube n W) (od : (W : Type 1) (G : W → Type 1) (c : Cube (suc n) W) → DCube (suc n) W G c → DCube n W G (oc W c))
  (c : Cube (suc n) X) (d : DCube (suc n) X Y c) (om : PathP (λ i → Cube n Z) (oc Z (dcube-map (suc n) X Y Z f c d)) (dcube-map n X Y Z f (oc X c) (od X Y c d))) → Type 1
LiftT n X Y Z H f g oc od c d om =
  PathP (λ i → DCube n Z H (om i)) (od Z H (dcube-map (suc n) X Y Z f c d) (dcube-lift (suc n) X Z Y H f g c d)) (dcube-lift n X Z Y H f g (oc X c) (od X Y c d))
papp-lit-lift : (sk : Lst Entry) (X : Type 1) (Y : X → Type 1) (Z : Type 1) (H : Z → Type 1) (f : (x : X) → Y x → Z) (g : (x : X) (y : Y x) → H (f x y)) (o : Word) (l : Lit) (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) →
  LiftT (dims sk) X Y Z H f g (λ W c' → papp-lit sk W o l c') (λ W G c' d' → papp-lit-d sk W G o l c' d') c d (papp-lit-dmap sk X Y Z f o l c d)
