  (c : Cube (suc (dims sk)) X) (d : DCube (suc (dims sk)) X Y c) (e : DCube (suc (dims sk)) X' F' (dcube-map (suc (dims sk)) X Y X' f c d)) →
  PullT (dims sk) X X' Y F F' f g (λ Z c' → papp-cube sk Z fm c') (λ Z G c' d' → papp-cube-d sk Z G fm c' d') c d (papp-dmap sk X Y X' f fm c d) e
papp-pull sk X X' Y F F' f g lnil c d e =
  pull-genc (dims sk) (Line X) (Line X') X X' (LineO X Y) (LineO X F) (LineO X' F') Y F F' (lineo-map X Y X' f) (lineo-pull X X' Y F F' f g) f g
    (face0-l X) (face0-o X Y) (face0-o X F) (face0-l X') (face0-o X' F') (λ i L D → f (fst L) (fst D)) (λ L D E e1 P i → g (fst L) (fst D) (P i)) c d e
