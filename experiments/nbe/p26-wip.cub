          (diag-sk-d (lcons e-dim sk') (%wsucc (r n)) X F (f (Line (Line X)) c) (fd (Line (Line X)) (LineO (Line X) (LineO X F)) c d))
          (diag-sk-d sk' (r n) (Line X) (LineO X F) (cube-map (dims sk') (Line (Line X)) (Line (Line X)) (exch-l X) (f (Line (Line X)) c))
             (dcube-reidx (dims sk') (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) (f (Line (Line X)) c) (fd (Line (Line X)) (LineO (Line X) (LineO X F)) c d)))
          (fd (Line X) (LineO X F) (diag-sk sk n (Line X) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c)) (diag-sk-d sk n (Line X) (LineO X F) (cube-map (dims sk) (Line (Line X)) (Line (Line X)) (exch-l X) c) (dcube-reidx (dims sk) (Line (Line X)) (Line (Line X)) (LineO (Line X) (LineO X F)) (LineO (Line X) (LineO X F)) (exch-l X) (exch-o X F) c d)))
          (diag-dim-s-d sk' (r n) X F (f (Line (Line X)) c) (fd (Line (Line X)) (LineO (Line X) (LineO X F)) c d))
