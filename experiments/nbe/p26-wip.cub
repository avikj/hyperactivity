    (cmap-nat sk' sk (cmap-of sk' sk r) (Line X) X (face0-l X) c)
    (ccd sk' sk r X F (cube-map (dims sk) (Line X) X (face0-l X) c) (dcube-reidx (dims sk) (Line X) X (LineO X F) F (face0-l X) (face0-o X F) c d))
    (dcube-reidx (dims sk') (Line X) X (LineO X F) F (face0-l X) (face0-o X F) (cco sk' sk r (Line X) c) (ccd sk' sk r (Line X) (LineO X F) c d))
