             (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X (DL X F))) (lineo-fmap X (DL X (DL X F)) (DL X (DL X F)) (dexch X F)) G d)))))
ddv-exch : (sk : Lst Entry) (k j : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X (DL X (DL X F)) G) →
  DDExch (dims sk) (λ Z H G' q → diag-dd sk k Z H G' q) (λ Z H G' q → diag-dd sk j Z H G' q) X F G d
ddv-exch lnil k j X F G d = λ i → fst (fst d)
ddv-exch (lcons (e-ty s) sk) k j X F G d =
  bool-elim1-2 (λ bk bj → DDExch (dims sk) (dd-ty-op sk k bk) (dd-ty-op sk j bj) X F G d)
    (fmap-sw23 (dims sk) X (DL X (DL X F)) (DL X F) F (DL X (DL X F)) (DL X F) (λ x q → fst q) (λ x q → fst q) (dexch X F) (λ x q → fst q) (λ x q → fst q)
       (λ i x q → fst (fst q)) G d)
    (pcat (DCube (dims sk) X F G) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G (diag-dd sk (%wsub j #1) X (DL X F) G d))
       (diag-dd sk (%wsub j #1) X F G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G d))
       (diag-dd sk (%wsub j #1) X F G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (λ x q → fst q) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
       (diag-dd-fmap sk (%wsub j #1) X (DL X F) F (λ x q → fst q) G d)
       (cong1 (DCube (dims sk) X (DL X F) G) (DCube (dims sk) X F G) (λ w → diag-dd sk (%wsub j #1) X F G w)
          (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G d)
          (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (λ x q → fst q) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d))
          (psym (DCube (dims sk) X (DL X F) G) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (λ x q → fst q) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d))
             (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G d)
             (fmap-sw21 (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (DL X F) (dexch X F) (λ x q → fst q) (dlf X (DL X F) F (λ x q → fst q)) (λ i x q → fst (dexch X F x q)) G d))))
    (pcat (DCube (dims sk) X F G) (diag-dd sk (%wsub k #1) X F G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (λ x q → fst q) G d))
       (diag-dd sk (%wsub k #1) X F G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
       (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G (diag-dd sk (%wsub k #1) X (DL X F) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
       (cong1 (DCube (dims sk) X (DL X F) G) (DCube (dims sk) X F G) (λ w → diag-dd sk (%wsub k #1) X F G w)
          (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (λ x q → fst q) G d)
          (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d))
          (psym (DCube (dims sk) X (DL X F) G) (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d))
             (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (λ x q → fst q) G d)
             (fmap-sw21 (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (DL X F) (dexch X F) (dlf X (DL X F) F (λ x q → fst q)) (λ x q → fst q) (λ i x q → fst q) G d)))
       (psym (DCube (dims sk) X F G) (dcube-fmap (dims sk) X (DL X F) F (λ x q → fst q) G (diag-dd sk (%wsub k #1) X (DL X F) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
          (diag-dd sk (%wsub k #1) X F G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X F) (dlf X (DL X F) F (λ x q → fst q)) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d)))
          (diag-dd-fmap sk (%wsub k #1) X (DL X F) F (λ x q → fst q) G (dcube-fmap (dims sk) X (DL X (DL X F)) (DL X (DL X F)) (dexch X F) G d))))
    (ddv-exch sk (%wsub k #1) (%wsub j #1) X F G d)
    (weq k #0) (weq j #0)
ddv-exch (lcons e-dim sk) k j X F G d =
  bool-elim1-2 (λ bk bj → DDExch (suc (dims sk)) (dd-dim-op sk k bk) (dd-dim-op sk j bj) X F G d)
    (fmap-sw23 (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (LineO X F) (LineO X (DL X (DL X F))) (LineO X (DL X F))
       (dgo X (DL X F)) (dgo X F) (lineo-fmap X (DL X (DL X F)) (DL X (DL X F)) (dexch X F)) (dgo X (DL X F)) (dgo X F)
       (λ i L y → dgo X F L (dgo X (DL X F) L y)) G d)
    (ddv-exch-dim-tf sk k j X F G d)
    (ddv-exch-dim-ft sk k j X F G d)
    (ddv-exch-dim-ff sk k j X F G d
       (ddv-exch sk (%wsub k #1) (%wsub j #1) (Line X) (LineO X F) G
          (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))))
    (weq k #0) (weq j #0)
-- the diagonal at a variable
ddv-diag : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X (DL X (DL X F)) G) →
  DDDiag (dims sk) (λ Z H G' q → diag-dd sk k Z H G' q) X F G d
ddv-diag lnil k X F G d = λ i → fst (fst d)
ddv-diag (lcons (e-ty s) sk) k X F G d =
  bool-elim1 (λ b → DDDiag (dims sk) (dd-ty-op sk k b) X F G d)
    (fmap-sw (dims sk) X (DL X (DL X F)) (DL X F) (DL X F) F (λ x q → fst q) (λ x q → fst q) (ddiag X F) (λ x q → fst q) (λ i x q → fst (fst q)) G d)
    (ddv-diag sk (%wsub k #1) X F G d) (weq k #0)
ddv-diag (lcons e-dim sk) k X F G d =
  bool-elim1 (λ b → DDDiag (suc (dims sk)) (dd-dim-op sk k b) X F G d)
    (fmap-sw (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (LineO X (DL X F)) (LineO X F) (dgo X (DL X F)) (dgo X F)
       (lineo-fmap X (DL X (DL X F)) (DL X F) (ddiag X F)) (dgo X F) (λ i L y → dgo X F L (dgo X (DL X F) L y)) G d)
    (pcat (DCube (dims sk) (Line X) (LineO X F) G)
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (diag-dd sk (%wsub k #1) (Line X) (LineO X (DL X F)) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
          (diag-dd sk (%wsub k #1) (Line X) (DL (Line X) (LineO X F)) G
             (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (lineo-fmap X (DL X (DL X F)) (DL X F) (ddiag X F)) G d)))
       (cong1 (DCube (dims sk) (Line X) (DL (Line X) (LineO X F)) G) (DCube (dims sk) (Line X) (LineO X F) G) (λ w → diag-dd sk (%wsub k #1) (Line X) (LineO X F) G w)
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (diag-dd sk (%wsub k #1) (Line X) (LineO X (DL X F)) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
          (diag-dd sk (%wsub k #1) (Line X) (DL (Line X) (LineO X F)) G
             (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
          (diag-dd-fmap sk (%wsub k #1) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
       (pcat (DCube (dims sk) (Line X) (LineO X F) G)
          (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
             (diag-dd sk (%wsub k #1) (Line X) (DL (Line X) (LineO X F)) G
                (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
                   (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))))
          (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
             (dcube-fmap (dims sk) (Line X) (DL (Line X) (DL (Line X) (LineO X F))) (DL (Line X) (LineO X F)) (ddiag (Line X) (LineO X F)) G
                (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
                   (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d))))
          (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (lineo-fmap X (DL X (DL X F)) (DL X F) (ddiag X F)) G d)))
          (ddv-diag sk (%wsub k #1) (Line X) (LineO X F) G
             (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
          (cong1 (DCube (dims sk) (Line X) (DL (Line X) (LineO X F)) G) (DCube (dims sk) (Line X) (LineO X F) G) (λ w → diag-dd sk (%wsub k #1) (Line X) (LineO X F) G w)
             (dcube-fmap (dims sk) (Line X) (DL (Line X) (DL (Line X) (LineO X F))) (DL (Line X) (LineO X F)) (ddiag (Line X) (LineO X F)) G
                (dcube-fmap (dims sk) (Line X) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) G
                   (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (dxo X (DL X F)) G d)))
             (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
                (dcube-fmap (dims sk) (Line X) (LineO X (DL X (DL X F))) (LineO X (DL X F)) (lineo-fmap X (DL X (DL X F)) (DL X F) (ddiag X F)) G d))
             (fmap-sw32 (dims sk) (Line X) (LineO X (DL X (DL X F))) (DL (Line X) (LineO X (DL X F))) (DL (Line X) (DL (Line X) (LineO X F))) (DL (Line X) (LineO X F)) (LineO X (DL X F))
                (dxo X (DL X F)) (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F)) (ddiag (Line X) (LineO X F))
                (lineo-fmap X (DL X (DL X F)) (DL X F) (ddiag X F)) (dxo X F)
                (λ i L y → ddiag (Line X) (LineO X F) L (dlf (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) L (dxo X (DL X F) L y))) G d))))
    (weq k #0)
-- the degeneracy at a variable
ddv-deg : (sk : Lst Entry) (k : Word) (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X F G) →
  DDDeg (dims sk) (λ Z H G' q → diag-dd sk k Z H G' q) X F G d
ddv-deg lnil k X F G d = λ i → d
ddv-deg (lcons (e-ty s) sk) k X F G d =
  bool-elim1 (λ b → DDDeg (dims sk) (dd-ty-op sk k b) X F G d)
    (fmap-sw2i (dims sk) X F (DL X F) (degen-o X F) (λ x q → fst q) (λ i x y → y) G d)
    (ddv-deg sk (%wsub k #1) X F G d) (weq k #0)
ddv-deg (lcons e-dim sk) k X F G d =
  bool-elim1 (λ b → DDDeg (suc (dims sk)) (dd-dim-op sk k b) X F G d)
    (fmap-sw2i (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (lineo-fmap X F (DL X F) (degen-o X F)) (dgo X F) (λ i L y → y) G d)
    (pcat (DCube (dims sk) (Line X) (LineO X F) G)
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (lineo-fmap X F (DL X F) (degen-o X F)) G d)))
       (diag-dd sk (%wsub k #1) (Line X) (LineO X F) G (dcube-fmap (dims sk) (Line X) (LineO X F) (DL (Line X) (LineO X F)) (degen-o (Line X) (LineO X F)) G d))
       d
       (cong1 (DCube (dims sk) (Line X) (DL (Line X) (LineO X F)) G) (DCube (dims sk) (Line X) (LineO X F) G) (λ w → diag-dd sk (%wsub k #1) (Line X) (LineO X F) G w)
          (dcube-fmap (dims sk) (Line X) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (dxo X F) G
             (dcube-fmap (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (lineo-fmap X F (DL X F) (degen-o X F)) G d))
          (dcube-fmap (dims sk) (Line X) (LineO X F) (DL (Line X) (LineO X F)) (degen-o (Line X) (LineO X F)) G d)
          (fmap-sw21 (dims sk) (Line X) (LineO X F) (LineO X (DL X F)) (DL (Line X) (LineO X F)) (lineo-fmap X F (DL X F) (degen-o X F)) (dxo X F)
             (degen-o (Line X) (LineO X F)) (λ i L y → degen-o (Line X) (LineO X F) L y) G d))
       (ddv-deg sk (%wsub k #1) (Line X) (LineO X F) G d))
    (weq k #0)
-- (F2b) the same three for every expression (pex-exch, pex-diag, pex-deg), by induction on IEx: an end
-- (ix0, ix1) by papp-ex-fmap; reversal and a connection (any fibrewise map cn of a fibre line into a
-- square, meet-o or join-o) by papp-ex-fmap, the hypotheses and a judgmental pointwise identity of the
-- fibrewise maps; exchange of a variable with any expression by symmetry (pex-exch-sym) from the
-- cases with the expression outside
drev : (X : Type 1) (F : X → Type 1) (x : X) → DL X F x → DL X F x
drev X F x q = rev-o X F (degen-l X x) q
dmeet : (X : Type 1) (F : X → Type 1) (x : X) → DL X F x → DL X (DL X F) x
dmeet X F x q = meet-o X F (degen-l X x) q
djoin : (X : Type 1) (F : X → Type 1) (x : X) → DL X F x → DL X (DL X F) x
djoin X F x q = join-o X F (degen-l X x) q
fmap-sw52 : (n : Nat) (X : Type 1) (F0 F1 F2 F3 F4 F5 G1 : X → Type 1) (h0 : (x : X) → F0 x → F1 x) (h1 : (x : X) → F1 x → F2 x) (h2 : (x : X) → F2 x → F3 x)
  (h3 : (x : X) → F3 x → F4 x) (h4 : (x : X) → F4 x → F5 x) (k0 : (x : X) → F0 x → G1 x) (k1 : (x : X) → G1 x → F5 x)
  (q : PathP (λ i → (x : X) → F0 x → F5 x) (λ x y → h4 x (h3 x (h2 x (h1 x (h0 x y))))) (λ x y → k1 x (k0 x y))) (c : Cube n X) (d : DCube n X F0 c) →
  PathP (λ i → DCube n X F5 c) (dcube-fmap n X F4 F5 h4 c (dcube-fmap n X F3 F4 h3 c (dcube-fmap n X F2 F3 h2 c (dcube-fmap n X F1 F2 h1 c (dcube-fmap n X F0 F1 h0 c d)))))
    (dcube-fmap n X G1 F5 k1 c (dcube-fmap n X F0 G1 k0 c d))
fmap-sw52 zero X F0 F1 F2 F3 F4 F5 G1 h0 h1 h2 h3 h4 k0 k1 q c d = λ i → q i c d
fmap-sw52 (suc n) X F0 F1 F2 F3 F4 F5 G1 h0 h1 h2 h3 h4 k0 k1 q c d =
  fmap-sw52 n (Line X) (LineO X F0) (LineO X F1) (LineO X F2) (LineO X F3) (LineO X F4) (LineO X F5) (LineO X G1) (lineo-fmap X F0 F1 h0) (lineo-fmap X F1 F2 h1)
    (lineo-fmap X F2 F3 h2) (lineo-fmap X F3 F4 h3) (lineo-fmap X F4 F5 h4) (lineo-fmap X F0 G1 k0) (lineo-fmap X G1 F5 k1) (λ i L y → lineo-fmap X F0 F5 (q i) L y) c d
PExchT : (sk : Lst Entry) (e e' : IEx) → Type 2
PExchT sk e e' = (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X (DL X (DL X F)) G) →
  DDExch (dims sk) (λ Z H G' q → papp-ex sk Z H e G' q) (λ Z H G' q → papp-ex sk Z H e' G' q) X F G d
PDiagT : (sk : Lst Entry) (e : IEx) → Type 2
PDiagT sk e = (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X (DL X (DL X F)) G) →
  DDDiag (dims sk) (λ Z H G' q → papp-ex sk Z H e G' q) X F G d
PDegT : (sk : Lst Entry) (e : IEx) → Type 2
PDegT sk e = (X : Type 1) (F : X → Type 1) (G : Cube (dims sk) X) (d : DCube (dims sk) X F G) →
  DDDeg (dims sk) (λ Z H G' q → papp-ex sk Z H e G' q) X F G d
-- exchange
