-- the tour against the kernel's contract, from a state
-- with nothing arriving (the datagram it receives is the one it sends itself)
import "tour.cub"
os-tour-model : Outcome (Sum Errno Tour) × KState
os-tour-model = runp {Linux} {Sum Errno Tour} {KState} (os-tour {lzero}) linux-model (k-boot #4821 #1000000000 nil nil)
#show fst os-tour-model
#show k-regions (snd os-tour-model)
#show k-fds (snd os-tour-model)
#show k-clock (snd os-tour-model)
