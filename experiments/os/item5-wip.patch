 -- a process over Linux as a process of the drivers: the scratch area taken once, then the handler
 linux-run : {A : Type} → (pf : Platform) → LittleEndian pf → Proc {lsuc lzero} Linux A → Proc {lzero} W A
 linux-run {A} pf le p = lx-bw {Word} {A} (alloc-bytes lx-scratch) (λ sc → handle {Linux} {W} {A} (linux-on-w pf le sc) p)
