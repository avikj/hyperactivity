-- Layer: example: the interval as a pretype (functions returning and taking intervals), neutral interval atoms, and partial elements (Partial r A) with systems whose faces are computed (the four layers: see the language-implementation-remainder node of task-graph/hyperactivity.cub).
import "../../lib/core.cub"
-- an interval computed from data
pick : Bool → I
pick true = i1
pick false = i0
-- a path applied at a computed interval
at : {A : Type} {x y : A} (p : x ≡ y) (b : Bool) → A
at p b = p (pick b)
#same at (λ i → true) true = true
-- a function of the interval
cst : (i : I) → Bool
cst i = true
#same cst i0 = true
-- partial elements: a system on a face given as an interval term
p1 : (i : I) → Partial i Bool
p1 i = [ i = 1 ↦ true ]
-- on the face 1 a partial element is an element
#same p1 i1 = true
-- two branches on bound faces, agreeing on the overlap
both : (φ ψ : I) → Partial (φ ∨ ψ) Bool
both φ ψ = [ φ = 1 ↦ true , ψ = 1 ↦ true ]
-- faces computed from data: the same neutral is the same atom
both2 : (b c : Bool) → Partial (pick b ∨ pick c) Bool
both2 b c = [ pick b = 1 ↦ true , pick c = 1 ↦ true ]
#same both2 true false = true
-- a partial element used on its face
use : (φ : I) (u : Partial φ Bool) → Partial φ Bool
use φ u = [ φ = 1 ↦ u ]
-- disagreeing branches on an overlap are refused
#fail
bad : (φ ψ : I) → Partial (φ ∨ ψ) Bool
bad φ ψ = [ φ = 1 ↦ true , ψ = 1 ↦ false ]
-- a face that does not cover is refused
#fail
short : (φ ψ : I) → Partial (φ ∨ ψ) Bool
short φ ψ = [ φ = 1 ↦ true ]
-- a partial element extended to a total one along a path on its face: the second branch is a
-- composition whose tube is the path, so on the overlap (the face assumed, here an atom) it reduces to
-- the first branch by the boundary rule
extend : (A : Type) (φ : I) (x : A) (u : Partial φ A) (p : Partial φ (Path A u x)) → A
extend A φ x u p = [ φ = 1 ↦ u , 1 = 1 ↦ comp (λ _ → A) (λ j → [ φ = 1 ↦ p (~ j) ]) x ]
-- the same on a face computed from data
extendB : (A : Type) (b : Bool) (x : A) (u : Partial (pick b) A) (p : Partial (pick b) (Path A u x)) → A
extendB A b x u p = [ pick b = 1 ↦ u , 1 = 1 ↦ comp (λ _ → A) (λ j → [ pick b = 1 ↦ p (~ j) ]) x ]
#same extendB Bool true true true (λ j → true) = true
#same extendB Bool false false [] [] = false
-- composition whose tube is a line of partial elements computed by a function
tube : (A : Type) (φ : I) (u : (i : I) → Partial φ A) → (i : I) → Partial φ A
tube A φ u i = u i
-- its base agreeing with the tube at 0: the start extended along a path on the face
cmpT : (A : Type) (φ : I) (u : (i : I) → Partial φ A) (x : A) (p : Partial φ (Path A (u i0) x)) → A
cmpT A φ u x p = comp (λ _ → A) (λ i → [ φ = 1 ↦ tube A φ u i ]) (extend A φ x (u i0) p)
-- a base that does not agree with the tube is refused
#fail
cmpBad : (A : Type) (φ : I) (u : (i : I) → Partial φ A) (a : A) → A
cmpBad A φ u a = comp (λ _ → A) (λ i → [ φ = 1 ↦ tube A φ u i ]) a
-- a partial element on a face computed from a list, of as many branches as the list is long, built
-- by recursion: each new branch joined to the rest, the rest corrected by a composition along a path
-- to the new branch so that the two agree on the overlap (an assumption of two atoms) by the
-- boundary rule. The elements live in the singleton type of x, where such paths exist.
faces : List Bool → I
faces nil = i0
faces (cons b r) = pick b ∨ faces r
Singl : {A : Type} (x : A) → Type
Singl {A} x = (y : A) × (x ≡ y)
-- the singleton's centre, a path from it to any element, and so a path between any two
ctr : {A : Type} {x : A} (s : Singl x) → (x , λ k → x) ≡ s
ctr s = λ j → (snd s j , λ k → snd s (j ∧ k))
pth : {A : Type} {x : A} (s t : Singl x) → s ≡ t
pth {A} {x} s t = λ j → comp (λ _ → Singl x) (λ k → [ j = 0 ↦ ctr s k , j = 1 ↦ ctr t k ]) (x , λ k → x)
join : (A : Type) (x : A) (u : (b : Bool) → Partial (pick b) A) (e : (b : Bool) → Partial (pick b) (x ≡ u b))
       (bs : List Bool) → Partial (faces bs) (Singl x)
join A x u e nil = []
join A x u e (cons b r) =
  [ pick b = 1 ↦ (u b , e b)
  , faces r = 1 ↦ comp (λ _ → Singl x) (λ j → [ pick b = 1 ↦ pth (join A x u e r) (u b , e b) j ]) (join A x u e r) ]
-- on a total face the element: the branch whose face holds
uB : (b : Bool) → Partial (pick b) Bool
uB true = true
uB false = []
eB : (b : Bool) → Partial (pick b) (true ≡ uB b)
eB true = λ k → true
eB false = []
#same fst (join Bool true uB eB (cons false (cons true nil))) = true
