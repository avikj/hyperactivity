-- the roots: the nodes that are part of nothing, declared (lib/work.cub); read by tools/work.py
-- (part of work-object)
roots : List Node
roots = cons unified-computing nil
-- what must be complete before a node can be done (lib/work.cub); read by tools/work.py priority
-- (part of work-object)
after : List (Node × List Node)
after = cons (t29 , cons t7 nil) (cons (t39 , cons t16 nil) (cons (t42 , cons t61 nil) (cons (t44 , cons t61 nil) (cons (t64 , cons t61 (cons t62 nil)) nil))))
-- what a node's landing speeds (lib/work.cub); read by tools/work.py priority (part of work-object)
speeds : List (Node × List Node)
speeds = cons (work-object , cons core (cons publish (cons languages (cons hardware (cons os nil))))) (cons (interface , cons core (cons publish (cons languages (cons hardware (cons os nil))))) (cons (tooling , cons self-aware nil) nil))
