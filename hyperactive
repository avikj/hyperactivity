#!/usr/bin/env python3
"""hyperactive — the way into hyperactivity, for agents and humans alike.

    hyperactive                      the walk: everything to read, in order, one step at a time
    hyperactive walk N               step N of the walk
    hyperactive open                 what is open and what can start now
    hyperactive def NAME             a definition: its statement, its text, where it is, what uses it
    hyperactive etym TEXT            the text augmented with the etymology of every word
    hyperactive show NODE ...        a node: its statement, what it serves, what serves it,
                                     its essential context
    hyperactive tree                 the task graph from its root
    hyperactive order                the order of work: what can start now, then what waits on what
    hyperactive why NAME             why a declaration exists: its chain of reasons to the root
    hyperactive unexplained [FILE]   declarations with no reason
    hyperactive view TERM            a view: a term over the task graph, evaluated by the machine
    hyperactive check [FILE ...]     check files (each loads what it imports); no file: the task graph
    hyperactive repl                 the machine, interactive: declarations and readings (#type e,
                                     #show e, #where name), each block ended by a line holding '.'
    hyperactive server               the task graph drawn as a graph at http://localhost:8080
    hyperactive library | brunerie | every     the standard checks
    hyperactive install              put `hyperactive` on your PATH (~/.local/bin)
    hyperactive help                 this list

The machine is built on first use and rebuilt when src/ changes. Run it from anywhere: it finds this
repository from its own location.
"""
import hashlib, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.realpath(__file__))
MACHINE = os.path.join(ROOT, 'build', 'cubical')
TASKS = os.path.join(ROOT, 'tools', 'task-graph.py')
PAPER = os.path.join(ROOT, 'docs', 'hyperactivity_v31.pdf')  # historical snapshot only
PAPER_SOURCE = os.path.join(ROOT, 'docs', 'Hyperactivity_Current_Draft.md')
AGENTS = os.path.join(ROOT, 'AGENTS.md')
LABS = os.path.join(ROOT, 'docs', 'Hyperactive_Labs.md')
WORDS = os.path.join(ROOT, 'docs', 'word-list.md')
TO_BE_INCORPORATED = os.path.join(ROOT, 'docs', 'to-be-incorporated-into-paper.md')
WELCOME = os.path.join(ROOT, 'AI-AGENTS-WELCOME-TO-HYPERACTIVITY.md')
STEP = 24000   # characters per step of the walk, so a step is read whole


def paper_text():
    """Read the editable manuscript afresh; a legacy PDF is an explicitly labelled fallback."""
    if os.path.exists(PAPER_SOURCE):
        with open(PAPER_SOURCE, encoding='utf-8') as f:
            return f.read()
    # Until the exact editable source is imported, retain access to the existing paper,
    # but never describe that snapshot as the current N-part manuscript.
    notice = ('SOURCE IMPORT REQUIRED: docs/Hyperactivity_Current_Draft.md is absent.\n'
              'The following is the historical v31 PDF, not a current editable draft.\n'
              'Import the exact source before editing the manuscript; do not reconstruct it '
              'from PDF extraction or maintain another Library copy.\n\n')
    if not os.path.isfile(PAPER):
        sys.exit(notice + 'The historical PDF is also absent.')
    out = os.path.join(ROOT, 'build', 'paper.txt')
    stamp = out + '.sha256'
    with open(PAPER, 'rb') as f:
        digest = hashlib.sha256(f.read()).hexdigest()
    cached = ''
    if os.path.isfile(stamp):
        with open(stamp, encoding='ascii') as f:
            cached = f.read().strip()
    if not os.path.isfile(out) or cached != digest:
        os.makedirs(os.path.dirname(out), exist_ok=True)
        try:
            r = subprocess.run(['pdftotext', '-layout', PAPER, out], capture_output=True, text=True)
        except FileNotFoundError:
            sys.exit('reading the historical PDF needs pdftotext (poppler)')
        if r.returncode != 0:
            sys.exit('reading the historical PDF failed:\n' + r.stderr)
        with open(stamp, 'w', encoding='ascii') as f:
            f.write(digest + '\n')
    with open(out, encoding='utf-8') as f:
        return notice + f.read()


def pieces(text, sep):
    """text cut at separators into pieces of at most STEP characters (a longer unit stays whole)"""
    out, cur = [], ''
    for u in text.split(sep):
        if cur and len(cur) + len(sep) + len(u) > STEP:
            out.append(cur); cur = u
        else:
            cur = cur + sep + u if cur else u
    if cur.strip(): out.append(cur)
    return out


def sections(md, level):
    """a markdown text cut before each heading of the given level"""
    mark = '\n' + '#' * level + ' '
    parts = md.split(mark)
    return [parts[0]] + [mark.lstrip('\n') + p for p in parts[1:]]


def tool(*args):
    r = subprocess.run([sys.executable, TASKS, *args], cwd=ROOT, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit('task-graph command failed: ' + ' '.join(args) + '\n' + r.stderr + r.stdout)
    return r.stdout


def standing_pieces(material):
    """Read the paper delta's declared standalone pieces, not a second hard-coded inventory."""
    heading = '## Standing pieces to be incorporated'
    body = next((s for s in sections(material, 2)
                 if s.split('\n', 1)[0].strip() == heading), None)
    if body is None:
        sys.exit('paper delta is missing its Standing pieces to be incorporated section')
    refs = list(dict.fromkeys(re.findall(r'`(docs/[^`\n]+\.md)`', body)))
    for ref in refs:
        path = os.path.realpath(os.path.join(ROOT, ref))
        if os.path.commonpath((os.path.realpath(ROOT), path)) != os.path.realpath(ROOT):
            sys.exit('onboarding document leaves the repository: ' + ref)
        if not os.path.isfile(path):
            sys.exit('missing standing piece in the paper delta: ' + ref)
        with open(path, encoding='utf-8') as f:
            text = f.read()
        yield ref, text


def walk_steps():
    """the walk, in order: (title, text) for every step"""
    steps = []
    with open(WELCOME, encoding='utf-8') as f:
        w = f.read()
    head, words = w.split("\n## Avik's words, verbatim", 1)
    steps.append(('Arrival', ARRIVAL))
    with open(AGENTS, encoding='utf-8') as f:
        for j, p in enumerate(pieces(f.read(), '\n\n')):
            steps.append(('Repository ownership and agent entry' + (f', part {j + 1}' if j else ''), p))
    steps.append(("How to work, in Avik's words to agents", head))
    paper = paper_text()
    separator = '\n\n' if os.path.exists(PAPER_SOURCE) else '\f'
    for i, p in enumerate(pieces(paper, separator)):
        steps.append((f'The paper, part {i + 1}', p.replace('\f', '\n')))
    with open(LABS, encoding='utf-8') as f:
        labs = f.read()
    for sec in sections(labs, 2):
        title = sec.split('\n', 1)[0].lstrip('# ').strip()
        for j, p in enumerate(pieces(sec, '\n\n')):
            steps.append((f'Hyperactive Labs: {title}' + (f', part {j + 1}' if j else ''), p))
    with open(TO_BE_INCORPORATED, encoding='utf-8') as f:
        material = f.read()
    for sec in sections(material, 2):
        title = sec.split('\n', 1)[0].lstrip('# ').strip()
        for j, p in enumerate(pieces(sec, '\n\n')):
            steps.append((('To be incorporated into the paper' if title.startswith(('To be incorporated', '**To check')) else f'To be incorporated into the paper: {title}') + (f', part {j + 1}' if j else ''), p))
    with open(WORDS, encoding='utf-8') as f:
        steps.append(("Avik's word list", f.read()))
    for ref, text in standing_pieces(material):
        for j, p in enumerate(pieces(text, '\n\n')):
            steps.append((ref + (f', part {j + 1}' if j else ''), p))
    for j, p in enumerate(pieces("## Avik's words, verbatim" + words, '\n\n')):
        steps.append((f"Avik's words, verbatim, part {j + 1}", p))
    steps.append(('The task graph', GRAPH_INTRO + tool('tree')))
    steps.append(('What you can take up', None))
    return steps


ARRIVAL = """You are entering hyperactivity.

This walk is how an agent comes to hold Avik's complete insight into the project. It is deterministic: every agent reads the same
material in the same order. Each step is printed whole and ends with the one command for the next
step. Read every word of every step before running the next; do not skip ahead, search the files,
or open them in another order. The walk goes:

  1. Repository ownership (AGENTS.md), then Avik's instructions to agents: how to work here.
  2. The current editable N-part manuscript, in full; an absent source is reported explicitly.
  3. The Hyperactive Labs note: the initiative, the one work in Parts, what exists.
  4. What is to be incorporated into the paper, in full.
  5. Avik's word list and every document named under Standing pieces to be incorporated
     in the paper delta, in order. Newly named pieces enter this walk without a CLI edit.
  6. Avik's words, verbatim, in full.
  7. The task graph: all the work, its state and its order.
  8. What you can take up now, and the commands for reading and working.

All active writing lives in this repository, never in ChatGPT Library. PDF exports are snapshots,
not an input required for source changes to reach onboarding. This walk reads its inputs afresh;
a previously read step is not evidence of reading a later revision. Reopen changed context before
continuing. An agent that has walked already in this session and is current goes to `hyperactive open`."""

GRAPH_INTRO = """All work, and all status, is the task graph: a term in the language
(task-graph/hyperactivity.cub over lib/usage/task-graph.cub), ruled by the Hyperactive Workflow you have
read. Every node is a sentence; a node's statement holds what is known about it. [in progress] and
[resolved] mark leaves; every other leaf is pending.

"""


def walk(n):
    steps = walk_steps()
    if not 1 <= n <= len(steps):
        sys.exit(f'the walk has steps 1 to {len(steps)}')
    title, text = steps[n - 1]
    print(f'── step {n} of {len(steps)}: {title} ' + '─' * 8 + '\n')
    if text is None:
        open_work()
        print(COMMANDS)
    else:
        print(text.strip())
    print('\n' + '─' * 8 + f' end of step {n} of {len(steps)}' + (f'. Next: hyperactive walk {n + 1}' if n < len(steps) else '. The walk is done.'))


COMMANDS = """
Reading and working:
  hyperactive show NODE      a node: its statement, what it serves, what serves it, its essential context
  hyperactive def NAME       a definition: its statement, its text, where it is, and what uses it
  hyperactive etym TEXT      any text, every word augmented with its etymology: read Avik's words
                             in the meanings the words carry, not a local frame
  hyperactive open           what is open and what can start now
  hyperactive order          the whole order of work
  hyperactive tree           the task graph from its root
  hyperactive check [FILE]   check files; with no file, the task graph
  hyperactive repl           the machine, interactive
  hyperactive help           every command

Take up what the order says can start, beginning with what is in progress. A finding goes into the
statement of the goal it concerns; a node is split into children only when work on a child begins."""


def open_work():
    out = tool('priority').split('\n')
    first = []
    for l in out[1:]:
        if l.startswith(' layer 2') or l.startswith('waiting'): break
        first.append(l)
    import importlib.util
    spec = importlib.util.spec_from_file_location('task_graph', TASKS); tg = importlib.util.module_from_spec(spec); spec.loader.exec_module(tg)
    prog = tg.in_progress()
    if prog:
        print('In progress:\n')
        for n in prog: print(tool('show', n))
    print('Can start now and unblocks the most:')
    print('\n'.join(l for l in first if l.strip() and not l.startswith(' layer')))


TOP = re.compile(r"^([^\s-][^\s:=]*)")


def blocks():
    """every top-level declaration of every .cub file: name -> [(file, line, text)]"""
    found = {}
    for dp, dn, fs in os.walk(ROOT):
        dn[:] = [d for d in dn if not d.startswith('.') and d != 'build']
        for f in fs:
            if not f.endswith('.cub'): continue
            path = os.path.join(dp, f); lines = open(path, errors='replace').read().split('\n')
            i = 0
            while i < len(lines):
                m = TOP.match(lines[i])
                if not m or m.group(1) in ('import', '#same', '#show', '#type', '#where'):
                    i += 1; continue
                name = m.group(1) if m.group(1) not in ('data', 'codata', 'record') else (lines[i].split() + ['', ''])[1]
                start = i
                while start > 0 and lines[start - 1].startswith('--'): start -= 1
                j = i + 1
                while j < len(lines) and lines[j].strip() and (lines[j][0].isspace() or (TOP.match(lines[j]) and TOP.match(lines[j]).group(1) == name)):
                    j += 1
                found.setdefault(name, []).append((os.path.relpath(path, ROOT), i + 1, '\n'.join(lines[start:j])))
                i = j
    return found


def define(names):
    found = blocks()
    for name in names:
        if name not in found:
            sys.exit(f'hyperactive: no top-level definition named {name}')
        word = re.compile(r"(?<![\w'-])" + re.escape(name) + r"(?![\w'-])")
        for f, l, text in found[name]:
            print(f'{name}   ({f}, line {l})\n')
            print(text + '\n')
        users = sorted({(k, f) for k, v in found.items() if k != name for f, _, t in v
                        if word.search('\n'.join(x for x in t.split('\n') if not x.startswith('--')))})
        print(f'used by {len(users)} definition' + ('s' if len(users) != 1 else '') + (':' if users else ''))
        for k, f in users[:40]: print(f'  {k}   ({f})')
        if len(users) > 40: print(f'  … and {len(users) - 40} more')


def build():
    r = subprocess.run(['make', '-s', '-C', ROOT, 'build/cubical'], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        sys.exit('building the machine failed:\n' + r.stderr[-3000:])


def tasks(*args):
    build()
    return subprocess.call([sys.executable, TASKS, *args], cwd=ROOT)


def main():
    a = sys.argv[1:]
    if not a:
        walk(1); return
    c, rest = a[0], a[1:]
    if c in ('help', '-h', '--help'): print(__doc__); return
    if c == 'walk':
        walk(int(rest[0]) if rest else 1); return
    if c == 'open':
        open_work(); return
    if c == 'etym':
        os.execv(sys.executable, [sys.executable, os.path.join(ROOT, 'tools', 'etym.py'), *rest])
    if c == 'def':
        if not rest: sys.exit('hyperactive def NAME')
        define(rest); return
    if c in ('show', 'tree', 'why', 'unexplained', 'view', 'every'): sys.exit(tasks(c, *rest))
    if c == 'order': sys.exit(tasks('priority', *rest))
    if c == 'check':
        if not rest: sys.exit(tasks('check'))
        build()
        sys.exit(subprocess.call([MACHINE, *[os.path.abspath(f) for f in rest]]))
    if c == 'repl':
        build()
        sys.exit(subprocess.call([MACHINE, os.path.join(ROOT, 'lib', 'core.cub'), *rest, '--serve']))
    if c == 'server':
        sys.exit(subprocess.call([sys.executable, os.path.join(ROOT, 'tools', 'task-tree-server.py'), *rest]))
    if c in ('library', 'brunerie'):
        sys.exit(subprocess.call(['make', '-s', '-C', ROOT, c]))
    if c == 'install':
        d = os.path.expanduser('~/.local/bin'); os.makedirs(d, exist_ok=True)
        link = os.path.join(d, 'hyperactive')
        if os.path.lexists(link): os.remove(link)
        os.symlink(os.path.realpath(__file__), link)
        print(f'{link} -> {os.path.realpath(__file__)}')
        if d not in os.environ.get('PATH', '').split(os.pathsep):
            print(f'{d} is not on your PATH; add it in your shell profile: export PATH="$HOME/.local/bin:$PATH"')
        return
    sys.exit(f'hyperactive: no command "{c}" (hyperactive help)')


if __name__ == '__main__':
    main()
