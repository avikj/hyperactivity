-- region.cub — the Region threading idiom (plan C20, item 20) over lib/region.cub: programs over a
-- region as state, their readings, the laws at pointers, and #safe telling a program over its own
-- region from one entering memory it does not own
-- pointers at 0 and 8 into a 16-byte region
p0 : Ptr 16
p0 = (0 , (8 , λ i → 16))
p8 : Ptr 16
p8 = (8 , (0 , λ i → 16))
-- a program: write w at p0 and w + 1 at p8, then their sum
two : Word → RM 16 Int64
two w = rthen (wr p0 (i64 w)) (rthen (wr p8 (i64 (%wsucc w))) (rbind (rd p0) (λ a → rmap (λ b → i64add a b) (rd p8))))
#same i64toWord (eval-fresh 16 (two #20)) = #41
-- a counter bumped three times
bump3 : RM 16 Int64
bump3 = rthen (rmodify p8 (λ v → i64add v (i64 #1))) (rthen (rmodify p8 (λ v → i64add v (i64 #1))) (rthen (rmodify p8 (λ v → i64add v (i64 #1))) (rd p8)))
#same i64toWord (eval-fresh 16 bump3) = #3
-- the laws at these pointers
p0p8 : Sum (le (plus 0 8) 8) (le (plus 8 8) 0)
p0p8 = inl (0 , λ i → 8)
rd-p8 : (v : Int64) → (r : Region 16) → PathP (λ (i : I) → Int64) (snd (rthen (wr p0 v) (rd p8) r)) (snd (rd p8 r))
rd-p8 v r = rd-wr-disj p0 p8 v r p0p8
-- safe: no assumption; entering memory the program does not own is listed
#safe two
enter-two : Word → Int64
enter-two w = snd (enter-at w 16 (two #20))
#safe enter-two
-- a byte string quotes as a code (the fresh string, then a store per nonzero word): so the
-- specializer's normal form of a program over a fresh region exists (experiments/fo/run.py's
-- `region` compiles `two` with its stores in place)
#same quote-top (Bytes 12) (store32 12 (bytes 12) 8 (0 , λ i → 12) (u32 #7)) = some (cprim #1028 (lcons (cprim #1536 (lcons (cwlit #12) lnil)) (lcons (cwlit #8) (lcons (cplit #1 #7) (lcons (cwlit #12) lnil)))))
#same quote-top (Bytes 16) (fst (run-fresh 16 (two #20))) = some (cprim #1032 (lcons (cprim #1032 (lcons (cprim #1536 (lcons (cwlit #16) lnil)) (lcons (cwlit #0) (lcons (cplit #0 #20) (lcons (cwlit #16) lnil))))) (lcons (cwlit #8) (lcons (cplit #0 #21) (lcons (cwlit #16) lnil)))))
#same quote-top (Bytes 8) (bytes 8) = some (cprim #1536 (lcons (cwlit #8) lnil))
