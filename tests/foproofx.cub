-- tests/foproofx.cub — lib/foproofx.cub's readings: XA's encoder (xa-prog) prints the bytes
-- lib/emitx86.cub's emit-x86 prints, and the machine's meaning (evx) answers what the first-order
-- form's (evq) does, on every construct the x86 fragment has and on the proved programs.
-- Loaded after lib/foproofx.cub (and lib/foproofq.cub, lib/foproofc.cub for the proved programs).
-- ---------------------------------------------------------------- a machine to run on
-- the arena [4096, 1048576), the stack from 2000000 up, rsp at 4000000 at the call
xt-B = xb #4096 #1048576 #2000000
xt-arg l i = case l of lnil → #0; lcons x r → if %weq i #0 then x else xt-arg r (%wsub i #1)
xt-s0 args = xm #0 #0 #0 #4000000 #4096 (λ i → xt-arg args i) (λ a → #0)
-- an outcome: the word in rax when the call returned; 77777 a limit hit; 99999 no value
xt-ans o = case o of xon s → x-rax s; xlim → #77777; _ → #99999
xt-run defs g args = xt-ans (evx (λ k → xa-table defs k) xt-B (dnat #200) (x1 (xcall g)) (xt-s0 args))
-- the first-order form's answer for main (key 0, no parameters)
xt-q defs = case evq (λ g → xa-body defs g) (dnat #200) (xa-body defs #0) kqnil of kqw w → w; _ → #99999
-- the encoder against lib/emitx86.cub on a program
xt-bytes defs = lst-eq (xa-prog defs) (emit-x86 (xq-defs-fo defs))
lst-eq a b = case a of lnil → (case b of lnil → true; lcons y s → false); lcons x r → (case b of lnil → false; lcons y s → andx (%weq x y) (lst-eq r s))
-- ---------------------------------------------------------------- constructs
-- a word, and a primitive on two words
xt-p1 = lcons (#0 , (#0 , fqprim #0 (fq2 (fql #40) (fql #2)))) lnil
#same xt-run xt-p1 #0 lnil = #42
#same xt-q xt-p1 = #42
#same xt-bytes xt-p1 = true
#same xq-defs-ok xt-p1 = true
-- subtraction is the source's truncating one: (3 − 5) + 7 = 7
xt-p2 = lcons (#0 , (#0 , fqprim #0 (fq2 (fqprim #1 (fq2 (fql #3) (fql #5))) (fql #7)))) lnil
#same xt-run xt-p2 #0 lnil = #7
#same xt-q xt-p2 = #7
#same xt-bytes xt-p2 = true
-- an addition past 2^64 is a limit: the machine claims nothing (the CPU would wrap)
xt-p3 = lcons (#0 , (#0 , fqprim #0 (fq2 (fql #18446744073709551615) (fql #1)))) lnil
#same xt-run xt-p3 #0 lnil = #77777
-- a multiplication, comparisons as 1 or 0
xt-p4 = lcons (#0 , (#0 , fqprim #0 (fq2 (fqprim #2 (fq2 (fql #6) (fql #7))) (fqprim #0 (fq2 (fqprim #3 (fq2 (fql #5) (fql #5))) (fqprim #4 (fq2 (fql #9) (fql #5)))))))) lnil
#same xt-run xt-p4 #0 lnil = #43
#same xt-q xt-p4 = #43
#same xt-bytes xt-p4 = true
-- let and if
xt-p5 = lcons (#0 , (#0 , fqlet (fql #5) (fqif (fqprim #3 (fq2 (fqv zero) (fql #5))) (fqprim #0 (fq2 (fqv zero) (fql #1))) (fql #2)))) lnil
#same xt-run xt-p5 #0 lnil = #6
#same xt-q xt-p5 = #6
#same xt-bytes xt-p5 = true
-- a call of two arguments, the order of the parameters (10 − 3)
xt-p6 = lcons (#0 , (#0 , fqcall #1 (fq2 (fql #10) (fql #3)))) (lcons (#1 , (#2 , fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)))) lnil)
#same xt-run xt-p6 #0 lnil = #7
#same xt-q xt-p6 = #7
#same xt-bytes xt-p6 = true
#same xq-defs-ok xt-p6 = true
-- a call at another arity than its definition's is outside the fragment
xt-p6b = lcons (#0 , (#0 , fqcall #1 (fq2 (fql #10) (fql #3)))) (lcons (#1 , (#1 , fqv zero)) lnil)
#same xq-defs-ok xt-p6b = false
-- a constructor in the arena, a field loaded
xt-p7 = lcons (#0 , (#0 , fqproj #0 #0 #1 (fqcon #0 #0 (fq2 (fql #8) (fql #9))))) lnil
#same xt-run xt-p7 #0 lnil = #9
#same xt-q xt-p7 = #9
#same xt-bytes xt-p7 = true
-- a loop: sum 1 .. 4 over a state (i , acc), continuing (tag 0) while i > 0, breaking (tag 1) with acc
xt-p8 = lcons (#0 , (#0 , fqloop (fq2 (fql #4) (fql #0)) (fqif (fqprim #4 (fq2 (fql #0) (fqv (suc zero)))) (fqcon #0 #0 (fq2 (fqprim #1 (fq2 (fqv (suc zero)) (fql #1))) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero)))))) (fqcon #0 #1 (fqcons (fqv zero) fqnil))))) lnil
#same xt-run xt-p8 #0 lnil = #10
#same xt-q xt-p8 = #10
#same xt-bytes xt-p8 = true
#same xq-defs-ok xt-p8 = true
-- ---------------------------------------------------------------- the proved programs (run.py's X86 route)
xt-pr = lcons (#0 , (#1 , fw-to-fq (spec-w std-vrule ex-c))) lnil
#same xq-defs-ok xt-pr = true
#same xt-bytes xt-pr = true
#same xt-run xt-pr #0 (lcons #4 lnil) = #13
xt-fibx : Word → Word
xt-fibx n = fst (%welimP (λ v → Word × Word) n (#0 , #1) (λ k p → (snd p , %wadd (fst p) (snd p))))
xt-fib = snd (specialize-proved-q (Word → Word) lnil (code (λ (w : Word) → xt-fibx w)))
#same xq-defs-ok xt-fib = true
#same xt-bytes xt-fib = true
#same xt-run xt-fib #0 (lcons #90 lnil) = #2880067194370816120
