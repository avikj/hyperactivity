-- tests/elab.cub — elaboration conveniences (plan E28): records built by field name and updated
-- (R { f = a }, R { r | f = v }), parameterized modules (module M params where ...; open M args).
-- Loaded after lib/std.cub.
record Pt3 = { x : Nat ; y : Nat ; z : Nat }
origin : Pt3
origin = Pt3 { x = 0 ; y = 0 ; z = 0 }
p1 : Pt3
p1 = Pt3 { z = 3 ; x = 1 ; y = 2 }
#same x p1 = 1
#same z p1 = 3
p2 : Pt3
p2 = Pt3 { p1 | y = 7 }
#same y p2 = 7
#same x p2 = 1
#same p2 = (1 , 7 , 3)
#same p2.z = 3
record Box (A : Type) = { val : A ; tag : Nat }
b1 : Box Bool
b1 = Box { val = true ; tag = 4 }
#same val b1 = true
#same (Box { b1 | tag = 5 }).tag = 5
-- ---------------------------------------------------------------- parameterized modules
record Eq (A : Type) = { eq : A → A → Bool ; eqid : Unit }
instance eqNat : Eq Nat
eqNat = (eqb , unit)
module Dup (A : Type) (e : Eq A) where
  same : A → A → Bool
  same x y = eq e x y
  has : A → List A → Bool
  has x nil = false
  has x (cons y ys) = if same x y then true else has x ys
  dup : List A → Bool
  dup nil = false
  dup (cons x xs) = if has x xs then true else dup xs
#same Dup·same Nat eqNat 2 2 = true
open Dup Nat eqNat
#same has 2 (cons 1 (cons 2 nil)) = true
#same dup (cons 1 (cons 2 (cons 1 nil))) = true
#same dup (cons 1 (cons 2 nil)) = false
module Pair {A : Type} (x : A) where
  twice : List A
  twice = cons x (cons x nil)
  thrice : List A
  thrice = cons x twice
open Pair true
#same thrice = cons true (cons true (cons true nil))

-- ---------------------------------------------------------------- indexed families by fording (E28)
-- data D ps : (i : Idx) → Type: the indices are the last parameters; each constructor gets an
-- equality field per index at multiplicity 0; applications get refl, patterns are padded; the
-- field is there to transport along or refute by
data Vec (A : Type) : (n : Nat) → Type where
  vnil : Vec A zero
  vcons : (n : Nat) → A → Vec A n → Vec A (suc n)
v2 : Vec Nat 2
v2 = vcons 1 7 (vcons 0 9 vnil)
vhead : (n : Nat) → Vec Nat (suc n) → Nat
vhead n v = case v of vnil → 0; vcons m x xs → x
#same vhead 1 v2 = 7
vlen : {n : Nat} → Vec Nat n → Nat
vlen vnil = 0
vlen (vcons m x xs) = suc (vlen xs)
#same vlen v2 = 2
-- the equality field: in a branch the index m is related to the constructor's by e
vhead2 : (m : Nat) → Vec Nat m → Nat
vhead2 m v = case v of vnil e → 0; vcons k x xs e → x
#same vhead2 2 v2 = 7
vtail : {n : Nat} → Vec Nat (suc n) → Vec Nat n
vtail {n} (vcons m x xs e) = transport (λ i → Vec Nat (predN (e (~ i)))) xs
vtail {n} (vnil e) = Empty-rec (snotz {n} e)
#same vlen (vtail v2) = 1
#fail
v3 : Vec Nat 2
v3 = vcons 0 7 vnil

-- E28: implicit arguments determined through a hypothesis whose type unfolds (a motive applied, a
-- defined type), and a quoted word recursion's motive (none in its code) found as the constant one
catw : {x y z : Word} → x ≡ y → y ≡ z → x ≡ z
catw p q = λ i → comp (λ j → Word) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
congw : (f : Word → Word) → {a b : Word} → a ≡ b → f a ≡ f b
congw f p = λ i → f (p i)
plusw-suc-l : (a b : Word) → plusw (%wsucc a) b ≡ %wsucc (plusw a b)
plusw-suc-l a b = %welimP (λ v → plusw (%wsucc a) v ≡ %wsucc (plusw a v)) b (λ i → %wsucc a) (λ n h i → %wsucc (h i))
plusw-zero-l : (b : Word) → plusw #0 b ≡ b
plusw-zero-l b = %welimP (λ v → plusw #0 v ≡ v) b (λ i → #0) (λ n h i → %wsucc (h i))
-- the step inside the induction: the composed path's endpoints from the hypothesis h : P n
plusw-comm-e : (a b : Word) → plusw a b ≡ plusw b a
plusw-comm-e a b = %welimP (λ v → plusw v b ≡ plusw b v) a (plusw-zero-l b) (λ n h → catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h))
-- a hypothesis of a defined type
motw : Word → Word → Type
motw b v = plusw v b ≡ plusw b v
step-e : (b n : Word) → motw b n → motw b (%wsucc n)
step-e b n h = catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h)
-- a λ applied in a signature
step-l : (b n : Word) → (λ (v : Word) → plusw v b ≡ plusw b v) n → plusw (%wsucc n) b ≡ plusw b (%wsucc n)
step-l b n h = catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h)
#same plusw-comm-e #3 #4 = plusw-comm-e #3 #4
