-- tests/elab.cub — elaboration conveniences (plan E28): records built by field name and updated
-- (R { f = a }, R { r | f = v }), parameterized modules (module M params where ...; open M args).
-- Loaded after lib/std.cub.
record Pt3 = { x : Nat ; y : Nat ; z : Nat }
origin : Pt3
origin = Pt3 { x = 0 ; y = 0 ; z = 0 }
p1 : Pt3
p1 = Pt3 { z = 3 ; x = 1 ; y = 2 }
#same x p1 = 1
#same z p1 = 3
p2 : Pt3
p2 = Pt3 { p1 | y = 7 }
#same y p2 = 7
#same x p2 = 1
#same p2 = (1 , 7 , 3)
#same p2.z = 3
record Box (A : Type) = { val : A ; tag : Nat }
b1 : Box Bool
b1 = Box { val = true ; tag = 4 }
#same val b1 = true
#same (Box { b1 | tag = 5 }).tag = 5
-- ---------------------------------------------------------------- parameterized modules
record Eq (A : Type) = { eq : A → A → Bool ; eqid : Unit }
instance eqNat : Eq Nat
eqNat = (eqb , unit)
module Dup (A : Type) (e : Eq A) where
  same : A → A → Bool
  same x y = eq e x y
  has : A → List A → Bool
  has x nil = false
  has x (cons y ys) = if same x y then true else has x ys
  dup : List A → Bool
  dup nil = false
  dup (cons x xs) = if has x xs then true else dup xs
#same Dup·same Nat eqNat 2 2 = true
open Dup Nat eqNat
#same has 2 (cons 1 (cons 2 nil)) = true
#same dup (cons 1 (cons 2 (cons 1 nil))) = true
#same dup (cons 1 (cons 2 nil)) = false
module Pair {A : Type} (x : A) where
  twice : List A
  twice = cons x (cons x nil)
  thrice : List A
  thrice = cons x twice
open Pair true
#same thrice = cons true (cons true (cons true nil))

-- ---------------------------------------------------------------- indexed families by fording (E28)
-- data D ps : (i : Idx) → Type: the indices are the last parameters; each constructor gets an
-- equality field per index at multiplicity 0; applications get refl, patterns are padded; the
-- field is there to transport along or refute by
data Vec (A : Type) : (n : Nat) → Type where
  vnil : Vec A zero
  vcons : (n : Nat) → A → Vec A n → Vec A (suc n)
v2 : Vec Nat 2
v2 = vcons 1 7 (vcons 0 9 vnil)
vhead : (n : Nat) → Vec Nat (suc n) → Nat
vhead n v = case v of vnil → 0; vcons m x xs → x
#same vhead 1 v2 = 7
vlen : {n : Nat} → Vec Nat n → Nat
vlen vnil = 0
vlen (vcons m x xs) = suc (vlen xs)
#same vlen v2 = 2
-- the equality field: in a branch the index m is related to the constructor's by e
vhead2 : (m : Nat) → Vec Nat m → Nat
vhead2 m v = case v of vnil e → 0; vcons k x xs e → x
#same vhead2 2 v2 = 7
vtail : {n : Nat} → Vec Nat (suc n) → Vec Nat n
vtail {n} (vcons m x xs e) = transport (λ i → Vec Nat (predN (e (~ i)))) xs
vtail {n} (vnil e) = Empty-rec (snotz {n} e)
#same vlen (vtail v2) = 1
#fail
v3 : Vec Nat 2
v3 = vcons 0 7 vnil

-- E28: implicit arguments determined through a hypothesis whose type unfolds (a motive applied, a
-- defined type), and a quoted word recursion's motive (none in its code) found as the constant one
catw : {x y z : Word} → x ≡ y → y ≡ z → x ≡ z
catw p q = λ i → comp (λ j → Word) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
congw : (f : Word → Word) → {a b : Word} → a ≡ b → f a ≡ f b
congw f p = λ i → f (p i)
plusw-suc-l : (a b : Word) → plusw (%wsucc a) b ≡ %wsucc (plusw a b)
plusw-suc-l a b = %welimP (λ v → plusw (%wsucc a) v ≡ %wsucc (plusw a v)) b (λ i → %wsucc a) (λ n h i → %wsucc (h i))
plusw-zero-l : (b : Word) → plusw #0 b ≡ b
plusw-zero-l b = %welimP (λ v → plusw #0 v ≡ v) b (λ i → #0) (λ n h i → %wsucc (h i))
-- the step inside the induction: the composed path's endpoints from the hypothesis h : P n
plusw-comm-e : (a b : Word) → plusw a b ≡ plusw b a
plusw-comm-e a b = %welimP (λ v → plusw v b ≡ plusw b v) a (plusw-zero-l b) (λ n h → catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h))
-- a hypothesis of a defined type
motw : Word → Word → Type
motw b v = plusw v b ≡ plusw b v
step-e : (b n : Word) → motw b n → motw b (%wsucc n)
step-e b n h = catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h)
-- a λ applied in a signature
step-l : (b n : Word) → (λ (v : Word) → plusw v b ≡ plusw b v) n → plusw (%wsucc n) b ≡ plusw b (%wsucc n)
step-l b n h = catw (plusw-suc-l n b) (congw (λ z → %wsucc z) h)
#same plusw-comm-e #3 #4 = plusw-comm-e #3 #4
-- E28: a composition's line left to find is the constant line at the type expected (or at the
-- base's type); a composition at Word with an empty tube is its base
catw-h : {x y z : Word} → x ≡ y → y ≡ z → x ≡ z
catw-h p q = λ i → comp _ (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
#same catw-h {#1} {#1} {#1} (λ i → #1) (λ i → #1) @ 0 = #1
snd-comp : Word
snd-comp = snd (comp _ (λ i → []) (the (Word × Word) (#3 , #4)))
#same snd-comp = #4
-- E28: generalized variables — a signature mentioning a declared variable free gets it (and the
-- variables its type mentions) as leading implicit parameters, in declaration order
variable gn : Nat
variable GA : Type
variable gxs : List GA
gplus-n0 : plus gn zero ≡ gn
gplus-n0 = plus-zero gn
gcons2 : List GA → List GA
gcons2 zs = case zs of nil → nil; cons y r → cons y (cons y (rec r))
gcons2-xs : gcons2 gxs ≡ gcons2 gxs
gcons2-xs = λ i → gcons2 gxs
#same gplus-n0 {suc zero} = plus-zero (suc zero)
#same gcons2-xs {Nat} {cons zero nil} @ 1 = cons zero (cons zero nil)
-- E28: the index unified at the split — a recursion returning an indexed type: the hypothesis is
-- at the field's own index (vmap f xs : Vec B m), so the constructor is rebuilt with the equality
-- field; the motive is (λ ix v → Vec B ix) n, as hyp-motive in check.cub reads it
vmap : {A B : Type} {n : Nat} → (A → B) → Vec A n → Vec B n
vmap f (vnil e) = vnil e
vmap f (vcons m x xs e) = vcons m (f x) (vmap f xs) e
#same vlen (vmap (λ x → suc x) v2) = 2
#same vhead 1 (vmap (λ x → suc x) v2) = 8
-- the hypothesis at the outer index would have let this through: a vector of length m as one of n
#fail
vbad : {A B : Type} {n : Nat} → (A → B) → Vec A n → Vec B n
vbad f (vnil e) = vnil e
vbad f (vcons m x xs e) = vbad f xs
-- E28 finding (ii): a λ-path written in an argument position whose body applies a lemma at an
-- open word: the lemma's stuck recursion at 0 is its type's left end (the motive travels with
-- a %welimP, so a stuck word elimination's endpoints are read from it)
lam-path-arg : (b : Word) → plusw (%wsucc #0) b ≡ %wsucc b
lam-path-arg b = catw (plusw-suc-l #0 b) (λ i → %wsucc (plusw-zero-l b i))
#same lam-path-arg #3 @ 1 = #4
-- delay e: e held unbuilt and transparent — typed as e, built by the operation that meets it,
-- force of it is it; its code is cthunk (lib/code.cub), evaluated by eval-g as a delay
dl-suc : Nat → Nat
dl-suc n = force (delay (suc n))
dl-fun : Nat → Nat
dl-fun = force (delay (λ n → suc (suc n)))
dl-bare : Word
dl-bare = %wadd (delay #1) #2
dl-arg : Word → Word → Word
dl-arg a b = a
#same dl-suc 1 = 2
#same dl-fun 1 = 3
#same dl-bare = #3
#same dl-arg #7 (delay (dl-arg #1 #2)) = #7
#same eval-g lnil (code (λ (n : Nat) → delay (suc n))) zero = suc zero
#same eval-g lnil (code (λ (w : Word) → %wadd (delay w) (force (delay #1)))) #4 = #5
-- E28: the goal rewritten by the index equations — clauses that leave the equality fields out are
-- checked at the constructor's own index and transported along the equation (Agda's unification
-- at the split); naming the field keeps the old reading (vmap above)
vmap-u : {A B : Type} {n : Nat} → (A → B) → Vec A n → Vec B n
vmap-u f vnil = vnil
vmap-u f (vcons m x xs) = vcons m (f x) (vmap-u f xs)
vsum-u : {n : Nat} → Vec Nat n → Nat
vsum-u vnil = 0
vsum-u (vcons m x xs) = plus x (vsum-u xs)
#same vlen (vmap-u (λ x → suc x) v2) = 2
#same vsum-u (vmap-u (λ x → suc x) v2) = 18
#fail
vbad-u : {A B : Type} {n : Nat} → (A → B) → Vec A n → Vec B n
vbad-u f vnil = vnil
vbad-u f (vcons m x xs) = vbad-u f xs
-- soundness: a recursion whose motive is not over the indices (an index that is not a variable,
-- or a motive written by hand) gets no hypothesis at the outer index for a field at another one:
-- the hypothesis is of an abstract type, so neither of these checks
#fail
sbad : {A : Type} {n : Nat} → Vec A (suc n) → Vec A (suc n)
sbad (vnil e) = vnil e
sbad (vcons m x xs e) = sbad xs
#fail
sbad2 : {A : Type} {n : Nat} → Vec A n → Vec A n
sbad2 xs = case xs return (λ v → Vec A n) of vnil e → vnil e; vcons m x ys e → rec ys
-- E28: index unification at a split (as Agda's): a clash makes a case absurd (vhead has no vnil
-- clause, vzip no mixed ones), the same constructor gives injectivity and a field met by a term is
-- solved (vzip's second vector is at the first's length), and a missing clause is covered when a
-- later argument's type admits no constructor (vlookup's vnil: Fin zero is empty)
vzip : {A B : Type} {n : Nat} → Vec A n → Vec B n → Vec (A × B) n
vzip vnil vnil = vnil
vzip (vcons m x xs) (vcons m2 y ys) = vcons m (x , y) (vzip xs ys)
vhead-u : {A : Type} {n : Nat} → Vec A (suc n) → A
vhead-u (vcons m x xs) = x
vtl-u : {A : Type} {n : Nat} → Vec A (suc n) → Vec A n
vtl-u (vcons m x xs) = xs
data Fin : (n : Nat) → Type where
  fzero : (n : Nat) → Fin (suc n)
  fsuc : (n : Nat) → Fin n → Fin (suc n)
vlookup : {A : Type} {n : Nat} → Vec A n → Fin n → A
vlookup (vcons m x xs) (fzero k) = x
vlookup (vcons m x xs) (fsuc k i) = vlookup xs i
#same vhead-u (vtl-u v2) = 9
#same vhead-u (vzip v2 v2) = (7 , 7)
#same vlookup v2 (fsuc 1 (fzero 0)) = 9
-- the unification does not make a wrong clause right: xs is not a Vec B m
#fail
vzip-bad : {A B : Type} {n : Nat} → Vec A n → Vec B n → Vec (A × B) n
vzip-bad vnil vnil = vnil
vzip-bad (vcons m x xs) (vcons m2 y ys) = vcons m2 (x , y) (vzip-bad xs xs)
-- the substitution below a rewritten split does not capture: n := suc m under the right side's own
-- λ named m (subst_multi renames a binder that would capture a substituted value's name)
vcons-of : {A : Type} {k : Nat} → Vec A k → A → Vec A (suc k)
vcons-of ys y = vcons k y ys
vcap : {A : Type} {n : Nat} → Vec A n → Nat → Vec A n
vcap vnil = λ k → vnil
vcap (vcons m x xs) = λ m → the (Vec A n) (vcons-of xs x)
#same vlen (vcap v2 #3) = 2
-- index unification: the fields a solved field's value is transported through form a dependent
-- telescope (h's type mentions i, both mention m), and several fields are solved at one split
data Tagged (m : Nat) (i : Fin m) = tagged
data Q : (n : Nat) → Type where
  qmk : (m : Nat) → (i : Fin m) → (h : Tagged m i) → Q (suc m)
getq : {n : Nat} → Q (suc n) → (m2 : Nat) × ((i2 : Fin m2) × Tagged m2 i2)
getq (qmk m i h) = (m , (i , h))
data T2 : (a b : Nat) → Type where
  t2 : (x y : Nat) → Vec Nat x → Vec Nat y → T2 (suc x) (suc y)
both : {a b : Nat} → T2 (suc a) (suc b) → Vec Nat a × Vec Nat b
both (t2 x y u w) = (u , w)
#same fst (getq {1} (qmk 1 (fzero 0) tagged)) = 1
-- (the transported vector's equality fields are composite paths — CCHM transport is not regular —
-- so its contents are compared, not the vector itself)
#same vhead-u (snd (both {0} {1} (t2 0 1 vnil (vcons 0 5 vnil)))) = 5
