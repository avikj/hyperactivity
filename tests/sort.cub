-- tests/sort.cub — 9.15 run: lib/sort.cub's declaration over three ordered types, posed and
-- normalized. Nat by its inductive order; Word by one machine comparison; a three-colour type
-- with no numeric content. The same eight elements written as a balanced and as a chained sum
-- sort to the same list: the sorting is fixed by the bag, not by how the sum was written.
--
-- RETARDED IMPLEMENTATION, as a sort to run. Nothing in the declaration requires its cost; the
-- declaration's normal form is the sorted list, at the cost 9.7 fixes (24 emissions, at most 17
-- comparisons, for eight elements). The excess is how the term is written:
--   1. merge recurses on its first list alone, so every step builds a function ("merge with this
--      list") and then calls it, instead of following both lists.
--   2. every node returns a pair (list, the part only the type checker reads) that is built, split,
--      and its unused half erased, 15 times for eight elements.
--   3. (the machine, not the term) every elimination carries its motive and the free variables of
--      all its branches through every step and erases them at each constructor; an argument used k
--      times is duplicated k-1 times and an unused one erased. Structure never read still costs steps.
--   4. for Nat, elements are unary and leb peels one suc per level by a function-valued elimination.
import "../lib/sort.cub"
-- ---------------------------------------------------------------- instance: Nat, by its inductive order
leb : Nat → Nat → Bool
leb m =
  case m return (λ y → Nat → Bool) of
    zero → λ n → true
    suc m1 → λ n → case n of zero → false; suc n1 → rec m1 n1
leb-refl : (n : Nat) → isTrue (leb n n)
leb-refl n = case n return (λ y → isTrue (leb y y)) of zero → unit; suc k → rec k
leb-total : {m n : Nat} → leb m n ≡ false → isTrue (leb n m)
leb-total =
  (case m return (λ y → (n : Nat) → leb y n ≡ false → isTrue (leb n y)) of
     zero → λ n e → Empty-rec {_} {isTrue (leb n zero)} (true≢false e)
     suc m1 → 
       λ n →
         case n return (λ z → leb (suc m1) z ≡ false → isTrue (leb z (suc m1))) of
           zero → λ e → unit
           suc n1 → λ e → rec m1 n1 e) n
leb-trans : {a b c : Nat} → isTrue (leb a b) → isTrue (leb b c) → isTrue (leb a c)
leb-trans =
  (case a return (λ y → (b c : Nat) → isTrue (leb y b) → isTrue (leb b c) → isTrue (leb y c)) of
     zero → λ b c p q → unit
     suc a1 → 
       λ b →
         case b return (λ z →
                          (c : Nat) →
                          isTrue (leb (suc a1) z) → isTrue (leb z c) → isTrue (leb (suc a1) c)) of
           zero → λ c p q → Empty-rec {_} {isTrue (leb (suc a1) c)} p
           suc b1 → 
             λ c →
               case c return (λ w →
                                isTrue (leb (suc a1) (suc b1)) →
                                isTrue (leb (suc b1) w) → isTrue (leb (suc a1) w)) of
                 zero → λ p q → Empty-rec {_} {isTrue (leb (suc a1) zero)} q
                 suc c1 → λ p q → rec a1 b1 c1 p q) b c
leb-antisym : {m n : Nat} → isTrue (leb m n) → isTrue (leb n m) → m ≡ n
leb-antisym =
  (case m return (λ y → (n : Nat) → isTrue (leb y n) → isTrue (leb n y) → y ≡ n) of
     zero → 
       λ n →
         case n return (λ z → isTrue (leb zero z) → isTrue (leb z zero) → zero ≡ z) of
           zero → λ a b i → zero
           suc k → λ a b → Empty-rec {_} {Path Nat zero (suc k)} b
     suc m1 → 
       λ n →
         case n return (λ z → isTrue (leb (suc m1) z) → isTrue (leb z (suc m1)) → suc m1 ≡ z) of
           zero → λ a b → Empty-rec {_} {Path Nat (suc m1) zero} a
           suc n1 → λ a b i → suc (rec m1 n1 a b i)) n
natOrd : Ord
natOrd =
  mkOrd {Nat} {leb}
    (leb-refl , λ x0 x1 → leb-total {x0} {x1} , λ x0 x1 x2 → leb-trans {x0} {x1} {x2}
    , λ x0 x1 → leb-antisym {x0} {x1})
-- ---------------------------------------------------------------- instance: Word, by one machine comparison
-- the order by elimination, to prove its laws ...
lew : Word → Word → Bool
lew a =
  %welimP (λ v → Word → Bool) a (λ b → true) (λ n h b → %welimP (λ v → Bool) b false (λ m g → h m))
lew-refl-s : (a : Word) → isTrue (lew a a)
lew-refl-s a = %welimP (λ v → isTrue (lew v v)) a unit (λ n h → h)
lew-total : {x y : Word} → lew x y ≡ false → isTrue (lew y x)
lew-total =
  %welimP (λ v → (y : Word) → lew v y ≡ false → isTrue (lew y v)) x
    (λ y e → Empty-rec {_} {isTrue (lew y #0)} (true≢false e))
    (λ n h y →
       %welimP (λ z → lew (%wsucc n) z ≡ false → isTrue (lew z (%wsucc n))) y (λ e → unit)
         (λ m g e → h m e)) y
lew-trans : {a b c : Word} → isTrue (lew a b) → isTrue (lew b c) → isTrue (lew a c)
lew-trans =
  %welimP (λ v → (b c : Word) → isTrue (lew v b) → isTrue (lew b c) → isTrue (lew v c)) a
    (λ b c p q → unit)
    (λ a1 h b →
       %welimP
         (λ z →
            (c : Word) → isTrue (lew (%wsucc a1) z) → isTrue (lew z c) → isTrue (lew (%wsucc a1) c))
         b (λ c p q → Empty-rec {_} {isTrue (lew (%wsucc a1) c)} p)
         (λ b1 g c →
            %welimP
              (λ w →
                 isTrue (lew (%wsucc a1) (%wsucc b1)) →
                 isTrue (lew (%wsucc b1) w) → isTrue (lew (%wsucc a1) w)) c
              (λ p q → Empty-rec {_} {isTrue (lew (%wsucc a1) #0)} q) (λ c1 k p q → h b1 c1 p q)))
    b c
lew-antisym : {m n : Word} → isTrue (lew m n) → isTrue (lew n m) → m ≡ n
lew-antisym =
  %welimP (λ v → (n : Word) → isTrue (lew v n) → isTrue (lew n v) → v ≡ n) m
    (λ n →
       %welimP (λ z → isTrue (lew #0 z) → isTrue (lew z #0) → #0 ≡ z) n (λ a b i → #0)
         (λ k g a b → Empty-rec {_} {#0 ≡ %wsucc k} b))
    (λ m1 h n →
       %welimP (λ z → isTrue (lew (%wsucc m1) z) → isTrue (lew z (%wsucc m1)) → %wsucc m1 ≡ z) n
         (λ a b → Empty-rec {_} {%wsucc m1 ≡ #0} a) (λ n1 g a b i → %wsucc (h n1 a b i))) n
lew-order : TotalOrder lew
lew-order =
  (lew-refl-s , λ x0 x1 → lew-total {x0} {x1} , λ x0 x1 x2 → lew-trans {x0} {x1} {x2}
  , λ x0 x1 → lew-antisym {x0} {x1})
-- ... and the comparator that runs: one machine comparison, whatever the size of the words; its laws
-- are lew's, transported along the path between the two comparators
lewf : Word → Word → Bool
lewf a b = not (wlt b a)
lew≡lewf : (a b : Word) → lew a b ≡ lewf a b
lew≡lewf a =
  %welimP (λ v → (b : Word) → lew v b ≡ lewf v b) a
    (λ b → %welimP (λ z → lew #0 z ≡ lewf #0 z) b (λ i → true) (λ m g i → true))
    (λ n h b → %welimP (λ z → lew (%wsucc n) z ≡ lewf (%wsucc n) z) b (λ i → false) (λ m g → h m))
lew≡lewf-ext : lew ≡ lewf
lew≡lewf-ext =
  funExt {lzero} {lzero} {Word} {Word → Bool} {lew} {lewf}
    (λ a → funExt {lzero} {lzero} {Word} {Bool} {lew a} {lewf a} (λ b → lew≡lewf a b))
wordOrd : Ord
wordOrd = mkOrd {_} {lewf} (subst {_} {_} {_} {TotalOrder {Word}} lew≡lewf-ext lew-order)
-- ---------------------------------------------------------------- instance: three colours, no magnitude
data Colour = red | green | blue
lec : Colour → Colour → Bool
lec a b =
  case a of
    red → true
    green → (case b of red → false; green → true; blue → true)
    blue → (case b of red → false; green → false; blue → true)
lec-refl : (a : Colour) → isTrue (lec a a)
lec-refl a = case a return (λ v → isTrue (lec v v)) of red → unit; green → unit; blue → unit
lec-total : {x y : Colour} → lec x y ≡ false → isTrue (lec y x)
lec-total =
  (case x return (λ v → (y : Colour) → lec v y ≡ false → isTrue (lec y v)) of
     red → λ y e → Empty-rec {_} {isTrue (lec y red)} (true≢false e)
     green → 
       λ y →
         case y return (λ w → lec green w ≡ false → isTrue (lec w green)) of
           red → λ e → unit
           green → λ e → Empty-rec {_} {isTrue (lec green green)} (true≢false e)
           blue → λ e → Empty-rec {_} {isTrue (lec blue green)} (true≢false e)
     blue → 
       λ y →
         case y return (λ w → lec blue w ≡ false → isTrue (lec w blue)) of
           red → λ e → unit
           green → λ e → unit
           blue → λ e → Empty-rec {_} {isTrue (lec blue blue)} (true≢false e)) y
lec-trans : {x y z : Colour} → isTrue (lec x y) → isTrue (lec y z) → isTrue (lec x z)
lec-trans =
  (case x return (λ v → (y z : Colour) → isTrue (lec v y) → isTrue (lec y z) → isTrue (lec v z)) of
     red → λ y z p q → unit
     green → 
       λ y →
         case y return (λ w →
                          (z : Colour) →
                          isTrue (lec green w) → isTrue (lec w z) → isTrue (lec green z)) of
           red → λ z p q → Empty-rec {_} {isTrue (lec green z)} p
           green → λ z p q → q
           blue → 
             λ z →
               case z return (λ u →
                                isTrue (lec green blue) →
                                isTrue (lec blue u) → isTrue (lec green u)) of
                 red → λ p q → Empty-rec {_} {isTrue (lec green red)} q
                 green → λ p q → Empty-rec {_} {isTrue (lec green green)} q
                 blue → λ p q → unit
     blue → 
       λ y →
         case y return (λ w →
                          (z : Colour) →
                          isTrue (lec blue w) → isTrue (lec w z) → isTrue (lec blue z)) of
           red → λ z p q → Empty-rec {_} {isTrue (lec blue z)} p
           green → λ z p q → Empty-rec {_} {isTrue (lec blue z)} p
           blue → λ z p q → q) y z
lec-antisym : {x y : Colour} → isTrue (lec x y) → isTrue (lec y x) → x ≡ y
lec-antisym =
  (case x return (λ v → (y : Colour) → isTrue (lec v y) → isTrue (lec y v) → v ≡ y) of
     red → 
       λ y →
         case y return (λ w → isTrue (lec red w) → isTrue (lec w red) → red ≡ w) of
           red → λ p q i → red
           green → λ p q → Empty-rec {_} {Path Colour red green} q
           blue → λ p q → Empty-rec {_} {Path Colour red blue} q
     green → 
       λ y →
         case y return (λ w → isTrue (lec green w) → isTrue (lec w green) → green ≡ w) of
           red → λ p q → Empty-rec {_} {Path Colour green red} p
           green → λ p q i → green
           blue → λ p q → Empty-rec {_} {Path Colour green blue} q
     blue → 
       λ y →
         case y return (λ w → isTrue (lec blue w) → isTrue (lec w blue) → blue ≡ w) of
           red → λ p q → Empty-rec {_} {Path Colour blue red} p
           green → λ p q → Empty-rec {_} {Path Colour blue green} p
           blue → λ p q i → blue) y
colourOrd : Ord
colourOrd =
  mkOrd {Colour} {lec}
    (lec-refl , λ x0 x1 → lec-total {x0} {x1} , λ x0 x1 x2 → lec-trans {x0} {x1} {x2}
    , λ x0 x1 → lec-antisym {x0} {x1})
-- ---------------------------------------------------------------- the sortings, run
-- eight elements, the sum written balanced ((1+1)+(1+1))+((1+1)+(1+1)) and chained 1+(1+(…))
n0 = zero
n1 = suc n0
n2 = suc n1
n3 = suc n2
n4 = suc n3
n5 = suc n4
n6 = suc n5
n7 = suc n6
balanced =
  un (un (un (sng n5) (sng n2)) (un (sng n7) (sng n0)))
    (un (un (sng n3) (sng n6)) (un (sng n1) (sng n4)))
chained =
  un (sng n5)
    (un (sng n2) (un (sng n7) (un (sng n0) (un (sng n3) (un (sng n6) (un (sng n1) (sng n4)))))))
sorted8 = cons n0 (cons n1 (cons n2 (cons n3 (cons n4 (cons n5 (cons n6 (cons n7 nil)))))))
#same fst (msort {natOrd} balanced) = sorted8
#same fst (msort {natOrd} chained) = sorted8
-- the same bag: the sorting is fixed by the declaration, not by how the sum was written
#same fst (msort {natOrd} (un balanced emp)) = sorted8
#show fst (msort {natOrd} balanced)
#show fst (msort {natOrd} chained)
-- words: one machine comparison per step, whatever the size
wbalanced =
  un (un (un (sng #5) (sng #2)) (un (sng #7) (sng #0)))
    (un (un (sng #3) (sng #6)) (un (sng #1) (sng #4)))
wchained =
  un (sng #5)
    (un (sng #2) (un (sng #7) (un (sng #0) (un (sng #3) (un (sng #6) (un (sng #1) (sng #4)))))))
wsorted = cons #0 (cons #1 (cons #2 (cons #3 (cons #4 (cons #5 (cons #6 (cons #7 nil)))))))
#same fst (msort {wordOrd} wbalanced) = wsorted
#same fst (msort {wordOrd} wchained) = wsorted
#show fst (msort {wordOrd} wbalanced)
#show fst (msort {wordOrd} wchained)
wlarge =
  un
    (un (un (sng #500000000000000000000005) (sng #200000000000000000000002))
       (un (sng #700000000000000000000007) (sng #7)))
    (un (un (sng #300000000000000000000003) (sng #600000000000000000000006))
       (un (sng #100000000000000000000001) (sng #400000000000000000000004)))
#show fst (msort {wordOrd} wlarge)
-- colours: compared by lec alone
colours = un (un (sng blue) (sng red)) (un (sng green) (un (sng red) (sng blue)))
#same fst (msort {colourOrd} colours) = cons red
                                          (cons red (cons green (cons blue (cons blue nil))))
#show fst (msort {colourOrd} colours)
