-- tests/proc.cub — readings for lib/proc.cub's signature inclusion, sessions, push events and
-- choreographies (plan 7.1, 7.3; D24). Loaded after lib/proc.cub.
-- ---------------------------------------------------------------- inclusion: KVS in KVLS
incl-kv : Incl KVS KVLS
incl-kv = (kv , (λ c r → r))
pr1-lifted : Proc {lzero} KVLS Word
pr1-lifted = lift-proc {KVS} {KVLS} {Word} incl-kv (pr1 {lsuc lzero})
#same fst (runp {KVLS} {Word} {(Word → Word) × Word} pr1-lifted kvl-world (empty-st , #0)) = done #12
-- lifted, nothing is logged: the inclusion issues only kv commands
#same snd (snd (runp {KVLS} {Word} {(Word → Word) × Word} pr1-lifted kvl-world (empty-st , #0))) = #0
-- ---------------------------------------------------------------- a session: writes before reads
-- a put is allowed only while no get has been answered
no-get : Hist KVS → Bool
no-get tr = case tr of nil → true; cons e r → (case fst e of get k → false; put k v → rec r)
write-then-read : Session KVS
write-then-read tr c = case c of get k → true; put k v → no-get tr
-- pr1 (two puts, two gets) follows it: the typed process is the pair with the proof by computation
pr1-typed : SProc {Word → Word} KVS Word write-then-read kv-world empty-st
pr1-typed = (pr1 {lzero} , unit)
#same fst (runp {KVS} {Word} {Hist KVS × (Word → Word)} (pr1 {lzero}) (session-guard {KVS} {Word → Word} write-then-read kv-world) (nil , empty-st)) = done #12
-- a get before a put: refused by the guard where the world itself would have answered
pr-late-put : Proc {lzero} KVS Word
pr-late-put = bind {lzero} {KVS} {Word} {Word} (cmd {lzero} {KVS} (get #1)) (λ a → bind {lzero} {KVS} {Unit} {Word} (cmd {lzero} {KVS} (put #1 #5)) (λ u → ret {lzero} {KVS} {Word} a))
#same fst (runp {KVS} {Word} {Hist KVS × (Word → Word)} pr-late-put (session-guard {KVS} {Word → Word} write-then-read kv-world) (nil , empty-st)) = stopped
#same fst (runp {KVS} {Word} {Word → Word} pr-late-put kv-world empty-st) = done #0
-- ---------------------------------------------------------------- push: a process fed events
sum2 : Proc {lzero} (PushS Word) Word
sum2 = bind {lzero} {PushS Word} {Word} {Word} (cmd {lzero} {PushS Word} recv) (λ a → bind {lzero} {PushS Word} {Word} {Word} (cmd {lzero} {PushS Word} recv) (λ b → ret {lzero} {PushS Word} {Word} (%wadd a b)))
#same fst (runp {PushS Word} {Word} {List Word} sum2 (feed-world {Word}) (cons #3 (cons #4 nil))) = done #7
#same fst (runp {PushS Word} {Word} {List Word} sum2 (feed-world {Word}) (cons #3 nil)) = stopped
-- ---------------------------------------------------------------- choreographies
-- 1 sends 5 to 2; 2 chooses: either sends 7 back or 8 back. Role 1 is told the choice: in both
-- branches 2's first step towards 1 is a communication
g1 : Chor
g1 = xfer #1 #2 #5 (choice #2 (xfer #2 #1 #7 cend) (xfer #2 #1 #8 cend))
#same projectable g1 = true
-- 2 chooses, but in the left branch 1 acts first (so 1 is not told) and the branches differ for 1
g-bad : Chor
g-bad = xfer #1 #2 #5 (choice #2 (xfer #1 #3 #7 cend) cend)
#same projectable g-bad = false
-- a role that behaves the same in both branches needs no telling
g-same : Chor
g-same = choice #2 (xfer #2 #1 #7 (xfer #3 #1 #1 cend)) (xfer #2 #1 #8 (xfer #3 #1 #1 cend))
#same projectable g-same = true
-- a scripted local world: outgoing values and labels are logged (latest first); incoming values
-- and offered labels come from a queue; pick always answers 0
LocSt : Type
LocSt = List Word × List Word
loc-world : World LocS LocSt
loc-world c st =
  case c return (λ x → Sum (loc-resp x × LocSt) LocSt) of
    send t v → inl (unit , (cons v (fst st) , snd st))
    recvf f → (case snd st of nil → inr st; cons w r → inl (w , (fst st , r)))
    pick → inl (#0 , st)
    tell l → inl (unit , (cons l (fst st) , snd st))
    offer f → (case snd st of nil → inr st; cons w r → inl (w , (fst st , r)))
run1 : Outcome Unit × LocSt
run1 = runp {LocS} {Unit} {LocSt} (project #1 g1 unit) loc-world (nil , cons #0 (cons #7 nil))
#same fst run1 = done unit
#same fst (snd run1) = cons #5 nil
run2 : Outcome Unit × LocSt
run2 = runp {LocS} {Unit} {LocSt} (project #2 g1 unit) loc-world (nil , cons #5 nil)
#same fst run2 = done unit
#same fst (snd run2) = cons #7 (cons #0 nil)
-- role 1 offered the right branch receives 8 instead
run1r : Outcome Unit × LocSt
run1r = runp {LocS} {Unit} {LocSt} (project #1 g1 unit) loc-world (nil , cons #1 (cons #8 nil))
#same fst run1r = done unit
#same snd (snd run1r) = nil
-- ---------------------------------------------------------------- supervisors (D25)
-- a registry: key 7 is pr3 (put at 0 then get), anything else pr1
reg1 : PKey → Proc {lzero} KVS Word
reg1 k = case weq k #7 of true → pr3 {lzero}; false → pr1 {lzero}
-- the supervisor process over the flaky world: the child is refused twice and done on the third
-- spawn; three handles were spawned
sup-run : Outcome (Outcome Word) × SupSt Word ((Word → Word) × Nat)
sup-run = runp {SupS Word} {Outcome Word} {SupSt Word ((Word → Word) × Nat)} (supervise-by {Word} 5 (upto3 {Word}) #7) (sup-world {KVS} {Word} {(Word → Word) × Nat} reg1 flaky) ((empty-st , zero) , (nil , (nil , #0)))
#same fst sup-run = done (done #9)
#same snd (snd (snd (snd sup-run))) = #3
-- a handle killed from outside: the await answers failed external, the strategy gives up on it
sup-killed : Outcome (Outcome Word) × SupSt Word ((Word → Word) × Nat)
sup-killed = runp {SupS Word} {Outcome Word} {SupSt Word ((Word → Word) × Nat)} (supervise-by {Word} 5 (upto3 {Word}) #7) (sup-world {KVS} {Word} {(Word → Word) × Nat} reg1 flaky) ((empty-st , zero) , (nil , (cons #0 nil , #0)))
#same fst sup-killed = done (failed external)
-- watch reports the child's outcome once: pr1 under the flaky world is done
#same fst (runp {SupS Word} {Outcome Word} {SupSt Word ((Word → Word) × Nat)} (watch {Word} #1) (sup-world {KVS} {Word} {(Word → Word) × Nat} reg1 flaky) ((empty-st , zero) , (nil , (nil , #0)))) = done (done #12)
-- a strategy restarting on external failure too, with the first two handles killed: done on the third
restart-all : {A : Type} → Strategy A
restart-all o n = case o of done a → give-up; stopped → lt3 n; failed r → lt3 n
sup-killed2 : Outcome (Outcome Word) × SupSt Word ((Word → Word) × Nat)
sup-killed2 = runp {SupS Word} {Outcome Word} {SupSt Word ((Word → Word) × Nat)} (supervise-by {Word} 5 (restart-all {Word}) #1) (sup-world {KVS} {Word} {(Word → Word) × Nat} reg1 flaky) ((empty-st , zero) , (nil , (cons #0 (cons #1 nil) , #0)))
#same fst sup-killed2 = done (done #12)
-- ---------------------------------------------------------------- named worlds (D27)
kv-named : Named KVS (Word → Word)
kv-named = (#1 , kv-world)
registry1 : Registry KVS (Word → Word)
registry1 = cons kv-named nil
#same fst (runp {KVS} {Word} {Word → Word} (pr1 {lzero}) (find-world {KVS} {Word → Word} #1 registry1 kv-world) empty-st) = done #12
-- ---------------------------------------------------------------- the guarded form
-- a terminating process is a guarded one; run against the key-value world it arrives within its
-- four commands' ticks and not before
#same grun-for {KVS} {Word} {Word → Word} 4 kv-world (λ κ → to-guarded {κ} {KVS} {Word} (pr1 {lzero})) empty-st = arrived (done #12 , (λ j → case weq j #2 of true → #7; false → (case weq j #1 of true → #5; false → #0)))
gpr1-run : Within (Outcome Word × (Word → Word))
gpr1-run = grun-for {KVS} {Word} {Word → Word} 4 kv-world (λ κ → to-guarded {κ} {KVS} {Word} (pr1 {lzero})) empty-st
#same (case gpr1-run of arrived r → fst r; pending → stopped) = done #12
#same grun-for {KVS} {Word} {Word → Word} 3 kv-world (λ κ → to-guarded {κ} {KVS} {Word} (pr1 {lzero})) empty-st = pending
-- a refusal arrives at its tick: pr2's put at key 0 is the second command
#same grun-for {KVS} {Word} {Word → Word} 9 kv-world (λ κ → to-guarded {κ} {KVS} {Word} (pr2 {lzero})) empty-st = arrived (stopped , (λ j → case weq j #1 of true → #5; false → #0))
-- a process that runs forever: put the counter at key 1 and count; observed through a budget of
-- five commands, it is stopped by the budget with the counter at 4 in the store
counter : GProc κ KVS Unit
counter = gloop {κ} {KVS} {Word} {Unit} (λ x → put #1 x) (λ x u → %wsucc x) #0
counter-run : Within (Outcome Unit × (Nat × (Word → Word)))
counter-run = grun-for {KVS} {Unit} {Nat × (Word → Word)} 20 (budget {KVS} {Word → Word} kv-world) (λ κ → counter {κ}) (5 , empty-st)
#same (case counter-run of arrived r → fst r; pending → done unit) = stopped
#same (case counter-run of arrived r → snd (snd r) #1; pending → #0) = #4
-- without the budget it never arrives, at any fuel
#same grun-for {KVS} {Unit} {Word → Word} 30 kv-world (λ κ → counter {κ}) empty-st = pending
-- the world pushing events: a feed of three summed by a loop over recv
summing : Word → GProc κ (PushS Word) Unit
summing x = gloop {κ} {PushS Word} {Word} {Unit} (λ x → recv) (λ x e → %wadd x e) x
-- the feed ends after three events: the loop is refused there (its sum is in no state; the tick
-- count is what is observed)
#same grun-for {PushS Word} {Unit} {List Word} 3 (feed-world {Word}) (λ κ → summing {κ} #0) (cons #3 (cons #4 (cons #5 nil))) = arrived (stopped , nil)
#same grun-for {PushS Word} {Unit} {List Word} 2 (feed-world {Word}) (λ κ → summing {κ} #0) (cons #3 (cons #4 (cons #5 nil))) = pending
-- handled through the logging handler: a silent tick per handled command, so pr1 arrives within
-- 4 commands + 4 taus + 2 logs
gpr1-logged : Within (Outcome Word × ((Word → Word) × Word))
gpr1-logged = grun-for {KVLS} {Word} {(Word → Word) × Word} 10 kvl-world (λ κ → ghandle {κ} {KVS} {KVLS} {Word} logging (to-guarded {κ} {KVS} {Word} (pr1 {lzero}))) (empty-st , #0)
#same (case gpr1-logged of arrived r → fst r; pending → stopped) = done #12
#same (case gpr1-logged of arrived r → snd (snd r); pending → #0) = #2
-- lifted along the inclusion: nothing logged
#same (case grun-for {KVLS} {Word} {(Word → Word) × Word} 10 kvl-world (λ κ → glift {κ} {KVS} {KVLS} {Word} incl-kv (to-guarded {κ} {KVS} {Word} (pr1 {lzero}))) (empty-st , #0) of arrived r → snd (snd r); pending → #9) = #0
-- replay of a guarded run: recorded under the key-value world, replayed from the record alone
grec : Within (Outcome Word × ((Word → Word) × List Word))
grec = grun-for {KVS} {Word} {(Word → Word) × List Word} 4 (recording {KVS} {Word → Word} kv-enc kv-world) (λ κ → to-guarded {κ} {KVS} {Word} (pr1 {lzero})) (empty-st , nil)
glog : List Word
glog = case grec of arrived r → rev-list (snd (snd r)) nil; pending → nil
#same glog = cons #0 (cons #0 (cons #5 (cons #7 nil)))
#same (case grun-for {KVS} {Word} {List Word} 4 (replaying {KVS} kv-dec) (λ κ → to-guarded {κ} {KVS} {Word} (pr1 {lzero})) glog of arrived r → fst r; pending → stopped) = done #12
-- the monad law at the observation: gbind (gret a) f runs as f a
#same grun-for {KVS} {Word} {Word → Word} 4 kv-world (λ κ → gbind {κ} {KVS} (gret #3) (λ a → to-guarded {κ} {KVS} {Word} (pr1 {lzero}))) empty-st = grun-for {KVS} {Word} {Word → Word} 4 kv-world (λ κ → to-guarded {κ} {KVS} {Word} (pr1 {lzero})) empty-st
