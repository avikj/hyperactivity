-- choreographic projection as specialization against the role (§12 item 24, plan 7.3): the global
-- program is lib/proc.cub's project-raw over a fixed choreography, a function of the role; the
-- specializer (lib/specialize.cub's residual: the role a now value of the schedule, step 1, then
-- normalization and rewriting) leaves the role's local process as its residual. Each residual is
-- shown equal to the process written by hand for that role (both normal forms), and run.
-- Loaded after lib/specialize.cub, lib/proc.cub and lib/choreo.cub.
-- a three-party choreography: 1 sends 5 to 2; 2 chooses, telling 3: it sends 7 or 8 to 3; then 3
-- sends 9 to 1
g3 : Chor
g3 = xfer #1 #2 #5 (choice #2 (xfer #2 #3 #7 (xfer #3 #1 #9 cend)) (xfer #2 #3 #8 (xfer #3 #1 #9 cend)))
#same projectable g3 = true
PL : Type (lsuc lzero)
PL = Proc {lzero} LocS Unit
-- the role is binder 0 of the global program, staged now; nothing is rewritten
sch-role = sched #0 (lcons (#0 , st-now) lnil) lnil
global3 = code (λ (m : Word) → project-raw m g3)
res me = residual sch-role PL lnil global3 (lcons (cwlit me) lnil)
-- the local processes as one would write them
hand1 : PL
hand1 = bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (send #2 #5)) (λ u →
          bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (offer #2)) (λ lbl →
            case weq lbl #0 of
              true → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (recvf #3)) (λ w → ret {lzero} {LocS} {Unit} unit)
              false → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (recvf #3)) (λ w → ret {lzero} {LocS} {Unit} unit)))
hand2 : PL
hand2 = bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (recvf #1)) (λ w →
          bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} pick) (λ lbl →
            bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (tell lbl)) (λ u →
              case weq lbl #0 of
                true → bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (send #3 #7)) (λ u2 → ret {lzero} {LocS} {Unit} unit)
                false → bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (send #3 #8)) (λ u2 → ret {lzero} {LocS} {Unit} unit))))
hand3 : PL
hand3 = bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (offer #2)) (λ lbl →
          case weq lbl #0 of
            true → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (recvf #2)) (λ w →
                     bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (send #1 #9)) (λ u → ret {lzero} {LocS} {Unit} unit))
            false → bind {lzero} {LocS} {Word} {Unit} (cmd {lzero} {LocS} (recvf #2)) (λ w →
                      bind {lzero} {LocS} {Unit} {Unit} (cmd {lzero} {LocS} (send #1 #9)) (λ u → ret {lzero} {LocS} {Unit} unit)))
-- the residual against each role is that role's process
#same res #1 = normalize PL (code hand1)
#same res #2 = normalize PL (code hand2)
#same res #3 = normalize PL (code hand3)
-- and they are three different processes (the role was consumed; lib/match.cub's code-same
-- covers their forms, so it says true of a residual and itself)
#same code-same (res #2) (res #2) = true
#same code-same (res #1) (res #2) = false
#same code-same (res #2) (res #3) = false
-- with the role left at run time the residual is a function of it, not any one role's process
#same (case residual (sched #0 lnil lnil) (Word → PL) lnil global3 lnil of clam b → true; _ → false) = true
-- the residual runs: role 3 offered the left branch, given 7, sends 9 to 1
LocSt3 : Type
LocSt3 = List Word × List Word
loc-world3 : World LocS LocSt3
loc-world3 c st =
  case c return (λ x → Sum (loc-resp x × LocSt3) LocSt3) of
    send t v → inl (unit , (cons v (fst st) , snd st))
    recvf f → (case snd st of nil → inr st; cons w r → inl (w , (fst st , r)))
    pick → inl (#0 , st)
    tell l → inl (unit , (cons l (fst st) , snd st))
    offer f → (case snd st of nil → inr st; cons w r → inl (w , (fst st , r)))
run3 = runp LocS Unit LocSt3 (eval-g lnil (res #3)) loc-world3 (nil , cons #0 (cons #7 nil))
#same fst run3 = done unit
#same fst (snd run3) = cons #9 nil
-- role 2's residual: receives 5, picks 0, tells it, sends 7
run2 = runp LocS Unit LocSt3 (eval-g lnil (res #2)) loc-world3 (nil , cons #5 nil)
#same fst (snd run2) = cons #7 (cons #0 nil)
