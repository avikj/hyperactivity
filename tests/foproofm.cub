-- tests/foproofm.cub — lib/foproofm.cub's readings: evc, the C subset's meaning on C's uint64_t words,
-- agrees with evu (its meaning on unbounded words) on every construct and primitive of
-- tests/foproofc.cub, and answers a limit (mlim) exactly where C's words part from exact ones: an
-- addition or multiplication from 2^64 up, a literal from 2^64 up; subtraction is the runtime's
-- truncating n1. Loaded after lib/foproofm.cub (on its own line: it needs only the C link).
obs-c v = case v of cw w → some w; _ → none
obs-m v = case v of mw w → some w; mlim → some #18446744073709551616; _ → none
-- tests/foproofc.cub's table: #3 a two-parameter definition, #4 a closure's definition
qm-G : Word → FQ
qm-G g = if weq g #3 then fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)) else (if weq g #4 then fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)) else fql #0)
qm-AN : Word → Nat
qm-AN g = if weq g #3 then 2 else (if weq g #4 then 2 else zero)
qm-df : Word → Bool
qm-df g = if weq g #3 then true else weq g #4
qm-GC : Word → CA
qm-GC g = fq-to-ca (qm-G g) ckt (qm-AN g)
u-of t = obs-c (evu qm-GC qm-AN qm-df (dnat #64) (fq-to-ca t ckt zero) csnil)
m-of t = obs-m (evc qm-GC qm-AN qm-df (dnat #64) (fq-to-ca t ckt zero) msnil)
-- every construct and primitive: the two meanings agree (no limit is reached)
#same m-of (fql #7) = u-of (fql #7)
#same m-of (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4)))) = u-of (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4))))
#same m-of (fqprim #1 (fq2 (fql #9) (fql #4))) = u-of (fqprim #1 (fq2 (fql #9) (fql #4)))
#same m-of (fqprim #2 (fq2 (fql #9) (fql #4))) = u-of (fqprim #2 (fq2 (fql #9) (fql #4)))
#same m-of (fqprim #3 (fq2 (fql #9) (fql #9))) = u-of (fqprim #3 (fq2 (fql #9) (fql #9)))
#same m-of (fqprim #4 (fq2 (fql #3) (fql #9))) = u-of (fqprim #4 (fq2 (fql #3) (fql #9)))
#same m-of (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone))) = u-of (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone)))
#same m-of (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4)))) = u-of (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4))))
#same m-of (fqif (fql #0) (fql #1) (fql #2)) = u-of (fqif (fql #0) (fql #1) (fql #2))
#same m-of (fqif (fql #5) (fql #1) (fql #2)) = u-of (fqif (fql #5) (fql #1) (fql #2))
#same m-of (fqcall #3 (fq2 (fql #9) (fql #6))) = u-of (fqcall #3 (fq2 (fql #9) (fql #6)))
#same m-of (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3))) = u-of (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3)))
#same m-of (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero))))) = u-of (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero)))))
#same m-of (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8)))) = u-of (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8))))
#same m-of (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16))))) = u-of (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16)))))
#same m-of (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4))) = u-of (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4)))
#same m-of (fq-w64 (fqprim #14 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) = u-of (fq-w64 (fqprim #14 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))
#same m-of (fq-w64 (fqprim #15 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) = u-of (fq-w64 (fqprim #15 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))
#same m-of (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) = u-of (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))
#same m-of (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5)))) = u-of (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5))))
#same m-of (fqprim #18 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))) = u-of (fqprim #18 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))
#same m-of (fq-wf (fqprim #19 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) = u-of (fq-wf (fqprim #19 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))
#same m-of (fq-wf (fqprim #20 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) = u-of (fq-wf (fqprim #20 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))
#same m-of (fq-wf (fqprim #21 (fq2 (fq-f64 (fql #4611686018427387904)) (fq-f64 (fql #4611686018427387904))))) = u-of (fq-wf (fqprim #21 (fq2 (fq-f64 (fql #4611686018427387904)) (fq-f64 (fql #4611686018427387904)))))
#same m-of (fq-wf (fqprim #22 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) = u-of (fq-wf (fqprim #22 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))
#same m-of (fqprim #23 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4607182418800017408)))) = u-of (fqprim #23 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4607182418800017408))))
#same m-of (fqprim #24 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))) = u-of (fqprim #24 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))
#same m-of (fq-p1 #29 (fql #3)) = u-of (fq-p1 #29 (fql #3))
#same m-of (fq-p1 #27 (fql #3)) = u-of (fq-p1 #27 (fql #3))
#same m-of (fq-p1 #28 (fql #4613937818241073152)) = u-of (fq-p1 #28 (fql #4613937818241073152))
#same m-of (fq-p1 #40 (fql #4294967301)) = u-of (fq-p1 #40 (fql #4294967301))
-- the limits: words from 2^64 up (u-of shows the exact word; m-of a limit, shown as 2^64); the
-- multiplications' right operands are small (dmulw multiplies by repeated addition)
#same u-of (fqprim #0 (fq2 (fql #18446744073709551615) (fql #1))) = some #18446744073709551616
#same evc qm-GC qm-AN qm-df zero (caprim #0 (cacons (caw #18446744073709551615) (cacons (caw #1) canil))) msnil = mlim
#same evc qm-GC qm-AN qm-df zero (caprim #0 (cacons (caw #18446744073709551614) (cacons (caw #1) canil))) msnil = mw #18446744073709551615
#same evc qm-GC qm-AN qm-df zero (caprim #2 (cacons (caw #9223372036854775808) (cacons (caw #2) canil))) msnil = mlim
#same evc qm-GC qm-AN qm-df zero (caprim #2 (cacons (caw #4611686018427387904) (cacons (caw #3) canil))) msnil = mw #13835058055282163712
#same evc qm-GC qm-AN qm-df zero (caw #18446744073709551616) msnil = mlim
#same evc qm-GC qm-AN qm-df zero (caw #18446744073709551615) msnil = mw #18446744073709551615
-- subtraction is truncating, as the source's: 0 - 1 is 0 (C's n1), not 2^64 - 1
#same evc qm-GC qm-AN qm-df zero (caprim #1 (cacons (caw #0) (cacons (caw #1) canil))) msnil = mw #0
#same u-of (fqprim #1 (fq2 (fql #0) (fql #1))) = some #0
-- a limit nobody reads changes nothing; one that is read is the answer's
#same evc qm-GC qm-AN qm-df zero (cablk zero (caprim #0 (cacons (caw #18446744073709551615) (cacons (caw #1) canil))) (caw #5)) msnil = mw #5
#same evc qm-GC qm-AN qm-df zero (cablk zero (caprim #0 (cacons (caw #18446744073709551615) (cacons (caw #1) canil))) (caprim #3 (cacons (cav zero) (cacons (caw #0) canil)))) msnil = mlim
-- inside a cell: the cell holds it, and an operation on the cell answers it
#same haslim (evc qm-GC qm-AN qm-df zero (cacon #0 (cacons (caw #18446744073709551616) (cacons (caw #1) canil))) msnil) = true
#same evc qm-GC qm-AN qm-df zero (caproj #1 (cacon #0 (cacons (caw #18446744073709551616) (cacons (caw #1) canil)))) msnil = mlim
-- through a call: the arguments hold a limit, the callee's locals are all limits
#same evc qm-GC qm-AN qm-df (dnat #4) (cacall #3 (cacons (caw #18446744073709551616) (cacons (caw #1) canil))) msnil = mlim
#same evc qm-GC qm-AN qm-df (dnat #4) (cacall #3 (cacons (caw #9) (cacons (caw #4) canil))) msnil = mw #5
