-- tests/native/rec.cub — a record for tests/native/main.c (B18, records by value from C): Pt's fields are
-- Nat, represented by Word (lib/prim.cub), so struct Pt is two uint64_t
data Pt = pt (a : Nat) (b : Nat)

swapPt : Pt → Pt
swapPt p = case p of pt a b → pt (plus b 1) a

sumPt : Pt → Nat → Nat
sumPt p k = case p of pt a b → plus (plus a b) k

-- item 18, the rest: a sum of records (from C a uint64_t tag and a union of one struct per constructor),
-- a record holding records inline, and B12's primitive fields at their C widths
data Shape = circ (r : Nat) | rect (w : Nat) (h : Nat)

area : Shape → Nat
area s = case s of circ r → plus r r; rect w h → plus w h

grow : Shape → Shape
grow s = case s of circ r → rect r 1; rect w h → circ (plus w h)

data Seg = seg (p : Pt) (q : Pt) (k : Nat)

segswap : Seg → Seg
segswap s = case s of seg p q k → seg q p (plus k 1)

data Px = px (a : UInt32) (f : Float32) (d : Float64) (i : Int64)

pxmix : Px → Px
pxmix p = case p of px a f d i → px (u32add a (u32 #1)) f (f64add d d) (i64add i i)
