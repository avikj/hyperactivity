-- tests/native/rec.cub — a record for tests/native/main.c (B18, records by value from C): Pt's fields are
-- Nat, represented by Word (lib/prim.cub), so struct Pt is two uint64_t
data Pt = pt (a : Nat) (b : Nat)

swapPt : Pt → Pt
swapPt p = case p of pt a b → pt (plus b 1) a

sumPt : Pt → Nat → Nat
sumPt p k = case p of pt a b → plus (plus a b) k
