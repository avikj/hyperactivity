-- tests/quote.cub — typed readings: a value's normal form at its type, as a code (quote in
-- lib/check.cub). Loaded after lib/std.cub.
-- Each normal form is compared with the code (code t) writes for the expected term (the C code
-- writer, independent of quote), and two laws are checked: evaluating the code gives a value
-- convertible with the original (conv), and quoting that value gives the same code again.
qe T v = eval-g lnil (fromopt (quote-top T v) cword)
law-conv T v = conv T v (qe T v)
-- a path applied at an endpoint under a binder: the endpoint (an untyped reading leaves it stuck)
f : Path Nat zero zero → Nat
f p = p i0
#same fromopt (quote-top (PathP (λ (i : I) → Nat) zero zero → Nat) f) cword = code (λ p → zero)
#same f = (λ p → zero)
#same law-conv (PathP (λ (i : I) → Nat) zero zero → Nat) f = true
-- η at Σ and at Π
g : Nat × Nat → Nat × Nat
g s = s
#same fromopt (quote-top (Nat × Nat → Nat × Nat) g) cword = code (λ s → (fst s , snd s))
#same law-conv (Nat × Nat → Nat × Nat) g = true
ap1 : (Nat → Nat) → Nat → Nat
ap1 F = F
#same fromopt (quote-top ((Nat → Nat) → Nat → Nat) ap1) cword = code (λ F n → F n)
#same law-conv ((Nat → Nat) → Nat → Nat) ap1 = true
-- a path variable read at its line: η at path types
sq : {A : Type} {x y : A} → x ≡ y → x ≡ y
sq p = p
#same fromopt
        (quote-top ((A : Type) → (x y : A) → PathP (λ (i : I) → A) x y → PathP (λ (i : I) → A) x y)
           (λ x0 x1 x2 → sq {x0} {x1} {x2})) cword = code (λ A x y p (i : I) → p i)
-- Glue
gl : Type → Type
gl A = Glue A []
#same fromopt (quote-top (Type → Type) gl) cword = code (λ A → Glue A [])
-- a constructor of a data type with parameters
c1 : {A : Type} → A → List A
c1 a = cons a nil
#same fromopt (quote-top ((A : Type) → A → List A) (λ x0 → c1 {x0})) cword = code
                                                                               (λ A a → cons a nil)
#same law-conv ((A : Type) → A → List A) (λ x0 → c1 {x0}) = true
-- a stuck elimination with a motive: its branches at the motive, a hypothesis as (rec k)
h : Nat → Nat
h n = case n return (λ y → Nat) of zero → zero; suc k → suc (rec k)
#same fromopt (quote-top (Nat → Nat) h) cword = code
                                                  (λ n →
                                                     case n return (λ y → Nat) of
                                                       zero → zero
                                                       suc k → suc (rec k))
#same law-conv (Nat → Nat) h = true
-- a stuck elimination with a motive whose branches are functions: η inside the branches
hf : Nat → Nat → Nat
hf n = case n return (λ y → Nat → Nat) of zero → λ m → m; suc k → rec k
#same fromopt (quote-top (Nat → Nat → Nat) hf) cword = code
                                                         (λ n m →
                                                            (case n return (λ y → Nat → Nat) of
                                                               zero → λ m2 → m2
                                                               suc k → λ m2 → rec k m2) m)
#same law-conv (Nat → Nat → Nat) hf = true
-- a case written without a motive where a type is expected: that type its motive, and its stuck
-- value read back with it
h2 : Nat → Nat → Nat
h2 n = case n of zero → λ m → m; suc k → λ m → k
#same fromopt (quote-top (Nat → Nat → Nat) h2) cword = code
                                                         (λ n m →
                                                            (case n return λ _ → Nat → Nat of
                                                               zero → λ m2 → m2
                                                               suc k → λ m2 → k) m)
-- the endpoint rule under a case reached at its type
h3 : Bool → Path Nat zero zero → Nat
h3 b p = if b then p i0 else zero
#same fromopt (quote-top (Bool → PathP (λ (i : I) → Nat) zero zero → Nat) h3) cword = code
                                                                                        (λ b p →
                                                                                           case b return λ _ → Nat of
                                                                                             true → zero
                                                                                             false → zero)
-- words: a stuck word elimination and a stuck operation
#same law-conv (Word → Word → Word) plusw = true
w1 : Word → Bool
w1 a = %wlt a #3
#same law-conv (Word → Bool) w1 = true
-- a stuck transport in a data type
tlist : {A B : Type} → A ≡ B → List A → List B
tlist p l = transport (λ i → List (p i)) l
#same law-conv ((A B : Type) → PathP (λ (i : I) → Type) A B → List A → List B)
        (λ x0 x1 → tlist {x0} {x1}) = true
-- quoting the value of a code gives the code again
#same quote-top (PathP (λ (i : I) → Nat) zero zero → Nat)
        (qe (PathP (λ (i : I) → Nat) zero zero → Nat) f) = quote-top
                                                             (PathP (λ (i : I) → Nat) zero zero →
                                                              Nat) f
#same quote-top (Nat × Nat → Nat × Nat) (qe (Nat × Nat → Nat × Nat) g) = quote-top
                                                                           (Nat × Nat → Nat × Nat)
                                                                           g
#same quote-top (Nat → Nat → Nat) (qe (Nat → Nat → Nat) hf) = quote-top (Nat → Nat → Nat) hf
#same quote-top (Nat → Nat → Nat) (qe (Nat → Nat → Nat) h2) = quote-top (Nat → Nat → Nat) h2
#same quote-top (Word → Word → Word) (qe (Word → Word → Word) plusw) = quote-top
                                                                         (Word → Word → Word) plusw
#same quote-top ((A B : Type) → PathP (λ (i : I) → Type) A B → List A → List B)
        (qe ((A B : Type) → PathP (λ (i : I) → Type) A B → List A → List B)
           (λ x0 x1 → tlist {x0} {x1})) = quote-top
                                         ((A B : Type) →
                                          PathP (λ (i : I) → Type) A B → List A → List B)
                                         (λ x0 x1 → tlist {x0} {x1})
-- a typed reading of a checked definition is its normal form at its type
#show f
#show hf
#show λ x0 x1 → tlist {x0} {x1}
