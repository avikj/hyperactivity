#same obs-k (evq qt-G (dnat #64) (fq-p1 #40 (fql #4294967301)) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-p1 #40 (fql #4294967301))))
-- ---------------------------------------------------------------- the word route, end to end
-- run.py's proved (lib/foproof.cub's ex-c) and proved-fib (fibx, read as fib-c): from the source's
-- meaning to what the printed form computes, at every argument and fuel
qw-G : Word → FQ
qw-G g = fql #0
ex-qpath : (x : Word) (N : Nat) → qle-w (evq qw-G N (fw-to-fq (spec-w std-vrule ex-c)) (kqcons (kqw x) kqnil)) (ex-f x)
ex-qpath x N = subst {lzero} {lzero} {Word} {λ u → qle-w (evq qw-G N (fw-to-fq (spec-w std-vrule ex-c)) (kqcons (kqw x) kqnil)) u} {wc-ev ex-c (envx x)} {ex-f x} (ex-means x)
  (fw-path std-vrule ex-c qw-G (envx x) (kqcons (kqw x) kqnil) N (fenv-x x))
#same fw-to-fo (spec-w std-vrule ex-c) = fq-to-fo (fw-to-fq (spec-w std-vrule ex-c))
#same evq qw-G (dnat #64) (fw-to-fq (spec-w std-vrule ex-c)) (kqcons (kqw #4) kqnil) = kqw #13
fib-qpath : (x : Word) (N : Nat) → qle-w (evq qw-G N (fw-to-fq (spec-w std-vrule fib-c)) (kqcons (kqw x) kqnil)) (fib-wp x)
fib-qpath x N = subst {lzero} {lzero} {Word} {λ u → qle-w (evq qw-G N (fw-to-fq (spec-w std-vrule fib-c)) (kqcons (kqw x) kqnil)) u} {fo-ev (spec-w std-vrule fib-c) (envx x)} {fib-wp x} (fib-path x)
  (fw-sound qw-G (spec-w std-vrule fib-c) q-id (envx x) (kqcons (kqw x) kqnil) N (fenv-x x))
#same wc-of (under-lams (normalize (Word → Word) (code (λ (w : Word) → fibx w)))) = some fib-c
#same snd (specialize-proved (Word → Word) lnil (code (λ (w : Word) → fibx w))) = fq-to-fo (wrap-fq #1 (fw-to-fq (spec-w std-vrule fib-c)))
#same evq qw-G (dnat #400) (fw-to-fq (spec-w std-vrule fib-c)) (kqcons (kqw #90) kqnil) = kqw #2880067194370816120
