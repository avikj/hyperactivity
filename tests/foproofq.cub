-- tests/foproofq.cub — lib/foproofq.cub's readings: the checked meaning of the first-order form (evq)
-- agrees with lib/fo.cub's eval-fo construct by construct, on every form the printers produce; the
-- word route's path end to end for run.py's two word programs. Loaded after tests/foproofq-progs.cub
-- (generated: the data route's path for every other run.py proved program).
-- a word, as each evaluator answers it
obs-k v = case v of kqw w → some w; _ → none
obs-f v = case v of vw w → some w; _ → none
-- a table: #3 a two-parameter definition (its parameters the first deepest), #4 a closure's
-- definition (its argument innermost, its captures above)
qt-G : Word → FQ
qt-G g = if weq g #3 then fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)) else (if weq g #4 then fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)) else fql #0)
qt-F g = fq-to-fo (qt-G g)
-- every construct and primitive the printers emit, the two meanings side by side
#same obs-k (evq qt-G (dnat #64) (fql #7) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fql #7)))
#same obs-k (evq qt-G (dnat #64) (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4)))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #1 (fq2 (fql #9) (fql #4))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #1 (fq2 (fql #9) (fql #4)))))
#same obs-k (evq qt-G (dnat #64) (fqprim #2 (fq2 (fql #9) (fql #4))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #2 (fq2 (fql #9) (fql #4)))))
#same obs-k (evq qt-G (dnat #64) (fqprim #3 (fq2 (fql #9) (fql #9))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #3 (fq2 (fql #9) (fql #9)))))
#same obs-k (evq qt-G (dnat #64) (fqprim #4 (fq2 (fql #3) (fql #9))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #4 (fq2 (fql #3) (fql #9)))))
#same obs-k (evq qt-G (dnat #64) (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone)))))
#same obs-k (evq qt-G (dnat #64) (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4)))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4))))))
#same obs-k (evq qt-G (dnat #64) (fqif (fql #0) (fql #1) (fql #2)) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqif (fql #0) (fql #1) (fql #2))))
#same obs-k (evq qt-G (dnat #64) (fqif (fql #5) (fql #1) (fql #2)) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqif (fql #5) (fql #1) (fql #2))))
#same obs-k (evq qt-G (dnat #64) (fqapp (fqlam (fqprim #0 (fq2 (fqv zero) (fql #1)))) (fq1 (fql #41))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqapp (fqlam (fqprim #0 (fq2 (fqv zero) (fql #1)))) (fq1 (fql #41)))))
#same obs-k (evq qt-G (dnat #64) (fqcall #3 (fq2 (fql #9) (fql #6))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqcall #3 (fq2 (fql #9) (fql #6)))))
#same obs-k (evq qt-G (dnat #64) (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3)))))
#same obs-k (evq qt-G (dnat #64) (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero))))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero)))))))
#same obs-k (evq qt-G (dnat #64) (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero))))) kqnil) = some #10
-- the byte layer: a fresh string, a 64-bit store and load (Int64 by its bits), its length, 32 bits
#same obs-k (evq qt-G (dnat #64) (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8)))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16))))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16)))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4)))))
-- Int64 and Float64 by their bits, through the conversions the printers wrap them in (fq-p1: the
-- unary ones, a mirror value a word of bits on both sides)
#same obs-k (evq qt-G (dnat #64) (fq-w64 (fqprim #14 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-w64 (fqprim #14 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))))
#same obs-k (evq qt-G (dnat #64) (fq-w64 (fqprim #15 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-w64 (fqprim #15 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))))
#same obs-k (evq qt-G (dnat #64) (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5)))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #18 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #18 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))))
#same obs-k (evq qt-G (dnat #64) (fq-wf (fqprim #19 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-wf (fqprim #19 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))))
#same obs-k (evq qt-G (dnat #64) (fq-wf (fqprim #20 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-wf (fqprim #20 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))))
#same obs-k (evq qt-G (dnat #64) (fq-wf (fqprim #21 (fq2 (fq-f64 (fql #4611686018427387904)) (fq-f64 (fql #4611686018427387904))))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-wf (fqprim #21 (fq2 (fq-f64 (fql #4611686018427387904)) (fq-f64 (fql #4611686018427387904)))))))
#same obs-k (evq qt-G (dnat #64) (fq-wf (fqprim #22 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-wf (fqprim #22 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #23 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4607182418800017408)))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #23 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4607182418800017408))))))
#same obs-k (evq qt-G (dnat #64) (fqprim #24 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))) kqnil)
    = obs-f (eval-fo qt-F lnil (fq-to-fo (fqprim #24 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))))
#same obs-k (evq qt-G (dnat #64) (fq-p1 #29 (fql #3)) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-p1 #29 (fql #3))))
#same obs-k (evq qt-G (dnat #64) (fq-p1 #27 (fql #3)) kqnil) = obs-f (eval-fo qt-F lnil (fq-to-fo (fq-p1 #27 (fql #3))))
