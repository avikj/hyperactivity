-- qp-cmp: U1's definitions (from tests/foproofu-progs.cub)
qp-cmp-uks : List Word
qp-cmp-uks = nil
qp-cmp-udf : Word → Bool
qp-cmp-udf g = kmemu g qp-cmp-uks
qp-cmp-uAN : Word → Nat
qp-cmp-uAN g = if wlt g dcbase then dnat (qp-cmp-A g) else (if wlt g dclbase then suc (qp-cmp-D (wsub g dcbase)) else dnat (qp-cmp-A g))
qp-cmp-MK : Kd
qp-cmp-MK = (kcons (kw) (kcons (kw) knil))
qp-cmp-S : KS
qp-cmp-S = kinfer (q-ft (fr-tab (fst std-frule) qp-cmp-T) (fr-tab (fst std-frule) qp-cmp-GT) qp-cmp-D qp-cmp-A) qp-cmp-uks qp-cmp-uAN (fc-to-fq 2 (fr-bu (fst std-frule) (dconv qp-cmp-m))) qp-cmp-MK
