-- qp-tags: U1's definitions (from tests/foproofu-progs.cub)
qp-tags-uks : List Word
qp-tags-uks = nil
qp-tags-udf : Word → Bool
qp-tags-udf g = kmemu g qp-tags-uks
qp-tags-uAN : Word → Nat
qp-tags-uAN g = if wlt g dcbase then dnat (qp-tags-A g) else (if wlt g dclbase then suc (qp-tags-D (wsub g dcbase)) else dnat (qp-tags-A g))
qp-tags-MK : Kd
qp-tags-MK = (kcons (kdc #45) knil)
qp-tags-S : KS
qp-tags-S = kinfer (q-ft (fr-tab (fst std-frule) qp-tags-T) (fr-tab (fst std-frule) qp-tags-GT) qp-tags-D qp-tags-A) qp-tags-uks qp-tags-uAN (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-tags-m))) qp-tags-MK
