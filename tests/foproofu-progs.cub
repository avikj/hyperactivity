-- qp-data: the kinds of its first-order table
qp-data-uks : List Word
qp-data-uks = (cons #1 (cons #2 (cons (wadd dcbase #0) nil)))
qp-data-udf : Word → Bool
qp-data-udf g = kmemu g qp-data-uks
qp-data-uAN : Word → Nat
qp-data-uAN g = if wlt g dcbase then dnat (qp-data-A g) else (if wlt g dclbase then suc (qp-data-D (wsub g dcbase)) else dnat (qp-data-A g))
qp-data-MK : Kd
qp-data-MK = knil
qp-data-S : KS
qp-data-S = kinfer (q-ft (fr-tab (fst std-frule) qp-data-T) (fr-tab (fst std-frule) qp-data-GT) qp-data-D qp-data-A) qp-data-uks qp-data-uAN (fc-to-fq 0 (fr-bu (fst std-frule) (dconv qp-data-m))) qp-data-MK
