-- item 17's kept specializations with workers and a bound (lang.c's NatAt): run with
-- CUBICAL_WORKERS=4 (and under TSan) and CUBICAL_NATIVE_AT_MAX=4. Twelve values of the known
-- argument, reached from independent branches of one reading, specialize concurrently; only four are
-- kept at a time, the least recently called evicted (its library closed), and an evicted value
-- called again is specialized again with the same answer
lam-body f = case f of flam b → b; _ → f
scalet : Word → Word → Word
scalet e b = %welimP (λ v → Word) e #0 (λ k r → %wadd r b)
#native scalet 2 at 1 = λ (e : Word) → emit-lib-u (lcons (#0 , (#1 , lam-body (specialize (Word → Word) lnil (clam (capp (capp (code scalet) (cwlit e)) (cvar #0)))))) lnil)
-- Σ_{e=1}^{12} e·(e+1) = 728
sum-scalet : Word → Word
sum-scalet e = %welimP (λ v → Word) e #0 (λ k r → %wadd r (scalet (%wadd k #1) (%wadd k #2)))
#same sum-scalet #12 = #728
-- again: the evicted values specialized again (from the cache by key), the kept ones called
#same sum-scalet #12 = #728
#same %wadd (scalet #1 #5) (%wadd (scalet #12 #2) (scalet #7 #3)) = #50
#same scalet #3 #5 = #15
