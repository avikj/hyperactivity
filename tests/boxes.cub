-- tests/boxes.cub — the paper's checked Agda terms (docs/index.html), stated and proved in
-- the machine's language and checked by lib/check.cub over lib/std.cub. Module parameters
-- become leading Π-binders; records become Σ-types with projections; implicit arguments
-- are explicit; Type ℓ is (U l).
-- ---- box 0 (0.8): the singleton is contractible
singleton-contractible : {l : Level} {A : Type l} {x : A} → isContr ((y : A) × x ≡ y)
singleton-contractible = ((x , λ i → x) , λ z i → (snd z i , λ j → snd z (i /\ j)))
-- ---- box 2 (1.2): every map is the partition of its domain by its output
partition : {l : Level} {A B : Type l} → (f : A → B) → Equiv A ((b : B) × fiber f b)
partition f =
  isoToEquiv {l} {A} {(b : B) × fiber f b} (λ a → (f a , a , λ i → f a)) (λ z → fst (snd z))
    (λ z i → (snd (snd z) i , fst (snd z) , λ j → snd (snd z) (i /\ j))) (λ a i → a)
-- ---- box 3 (3.2): every reversible operation is a transport
its-equivalence : {l : Level} {A B : Type l} {f : A → B} {g : B → A} →
                                                         ((b : B) → f (g b) ≡ b) →
                                                         ((a : A) → g (f a) ≡ a) → Equiv A B
its-equivalence fg gf = isoToEquiv f g fg gf
its-path : {l : Level} {A B : Type l} {f : A → B} {g : B → A} →
                                                  ((b : B) → f (g b) ≡ b) →
                                                  ((a : A) → g (f a) ≡ a) → A ≡ B
its-path fg gf = ua (its-equivalence {_} {_} {_} {f} {g} fg gf)
reversible-is-transport : {l : Level} {A B : Type l} {f : A → B} {g : B → A} →
                                                                 (fg : (b : B) → f (g b) ≡ b) →
                                                                 (gf : (a : A) → g (f a) ≡ a) →
                                                                 {a : A} →
                                                                 transport
                                                                   (its-path {_} {_} {_} {f} {g} fg
                                                                      gf) a ≡ f a
reversible-is-transport fg gf = uaβ {_} {_} {_} (its-equivalence {_} {_} {_} {f} {g} fg gf) {a}
the-path-is-unique : {l : Level} {A B : Type l} {f : A → B} {g : B → A} →
                                                            (fg : (b : B) → f (g b) ≡ b) →
                                                            (gf : (a : A) → g (f a) ≡ a) →
                                                            pathToEquiv
                                                              (its-path {_} {_} {_} {f} {g} fg gf) ≡ its-equivalence
                                                                                                       {_}
                                                                                                       {_}
                                                                                                       {_}
                                                                                                       {f}
                                                                                                       {g}
                                                                                                       fg
                                                                                                       gf
the-path-is-unique fg gf = pathToEquiv-ua (its-equivalence {_} {_} {_} {f} {g} fg gf)
-- ---- box 4 (3.5): a grading on a group vanishes
+≡0→≡0 : {m n : Nat} → plus m n ≡ zero → m ≡ zero
+≡0→≡0 p =
  (case m return (λ y → plus y n ≡ zero → y ≡ zero) of
     zero → λ q i → zero
     suc k → λ q → Empty-rec {_} {Path Nat (suc k) zero} (snotz q)) p
grading-vanishes : {G : Type} {op : G → G → G} {e : G} {inv : G → G} →
                                                       ((g : G) → op g (inv g) ≡ e) →
                                                       {len : G → Nat} →
                                                       len e ≡ zero →
                                                       ((g h : G) →
                                                        len (op g h) ≡ plus (len g) (len h)) →
                                                       {g : G} → len g ≡ zero
grading-vanishes invr lene lenop =
  +≡0→≡0 {len g} {len (inv g)}
    (transN (symN (lenop g (inv g))) (transN {len (op g (inv g))} (λ i → len (invr g i)) lene))
-- ---- box 6 (4.2): Lawvere's fixed point theorem, Cantor
PtSurj : {A B : Type} → (A → A → B) → Type
PtSurj phi = (g : A → B) → (a : A) × phi a ≡ g
twist : {A B : Type} → (A → A → B) → (B → B) → A → B
twist phi f a = f (phi a a)
lawvere-one-row : {A B : Type} {phi : A → A → B} {f : B → B} →
                                                 (a : A) × phi a ≡ twist phi f → (b : B) × f b ≡ b
lawvere-one-row row = (phi (fst row) (fst row) , λ i → snd row (~ i) (fst row))
lawvere : {A B : Type} {phi : A → A → B} → PtSurj phi → (f : B → B) → (b : B) × f b ≡ b
lawvere surj f = lawvere-one-row {_} {_} {phi} {f} (surj (twist phi f))
noFix→noPtSurj : {A B : Type} →
                 (phi : A → A → B) → {f : B → B} → ((b : B) → Neg (f b ≡ b)) → Neg (PtSurj phi)
noFix→noPtSurj phi nofix =
  λ surj → nofix (fst (lawvere {_} {_} {phi} surj f)) (snd (lawvere {_} {_} {phi} surj f))
not-no-fix : (b : Bool) → Neg (not b ≡ b)
not-no-fix b =
  case b return (λ y → Neg (not y ≡ y)) of
    true → λ p → true≢false (λ i → p (~ i))
    false → λ p → true≢false p
cantor : {A : Type} → (phi : A → A → Bool) → Neg (PtSurj phi)
cantor phi = noFix→noPtSurj {_} {_} phi {not} not-no-fix
-- ---- box 11 (7.2): the quarter-turn squares to negation, on the nose
sigma : Int × Int → Int × Int
sigma p = (negZ (snd p) , fst p)
sigma²≡neg : (p : Int × Int) → sigma (sigma p) ≡ (negZ (fst p) , negZ (snd p))
sigma²≡neg p = λ i → (negZ (fst p) , negZ (snd p))
-- ---- box 12 (8.6): decide = verify
decide : {l : Level} {A B : Type l} → (f : A → B) → A → (b : B) × fiber f b
decide f a = (f a , a , λ i → f a)
verify : {l : Level} {A B : Type l} {f : A → B} → (b : B) × fiber f b → A
verify z = fst (snd z)
verify-inverts-decide : {l : Level} {A B : Type l} →
                                    (f : A → B) → {a : A} → verify {_} {_} {_} {f} (decide f a) ≡ a
verify-inverts-decide f = λ i → a
witness-self-certifies : {l : Level} {A B : Type l} →
                                     (f : A → B) → {a : A} → snd (snd (decide f a)) ≡ (λ j → f a)
witness-self-certifies f = λ i j → f a
-- ---- box 7 (4.6–4.9): Gödel, from consistency, D1 and the fixed point; a countermodel; the diagonal
NegL : {l : Level} → Type l → Type l
NegL A = A → Empty
Theory : {l : Level} → Type (lsuc l)
Theory = (Sent : Type l) × (Sent → Type l) × (Sent → Sent) × (Sent → Sent)
Sent : {l : Level} → Theory {l} → Type l
Sent T = fst T
Pf : {l : Level} {T : Theory {l}} → Sent T → Type l
Pf s = fst (snd T) s
neg : {l : Level} {T : Theory {l}} → Sent T → Sent T
neg s = fst (snd (snd T)) s
prov : {l : Level} {T : Theory {l}} → Sent T → Sent T
prov s = snd (snd (snd T)) s
Consistent : {l : Level} → Theory {l} → Type l
Consistent T = (s : Sent T) → Pf s → Pf (neg s) → Empty
HBL1 : {l : Level} → Theory {l} → Type l
HBL1 T = (s : Sent T) → Pf s → Pf (prov s)
GoedelFix : {l : Level} {T : Theory {l}} → Sent T → Type l
GoedelFix G = (Pf G → Pf (neg (prov G))) × (Pf (neg (prov G)) → Pf G)
OmegaBad : {l : Level} {T : Theory {l}} → Sent T → Type l
OmegaBad G = Pf (prov G) × NegL (Pf G)
Independent : {l : Level} {T : Theory {l}} → Sent T → Type l
Independent s = NegL (Pf s) × NegL (Pf (neg s))
goedelHalfOne : {l : Level} {T : Theory {l}} {G : Sent T} →
                                             Consistent T → HBL1 T → GoedelFix G → NegL (Pf G)
goedelHalfOne con d1 gf = λ pG → con (prov G) (d1 G pG) (fst gf pG)
fixIsAlwaysVacuous : {l : Level} {T : Theory {l}} {G : Sent T} →
                                                  Consistent T →
                                                  HBL1 T → GoedelFix G → Pf G → Pf (neg (prov G))
fixIsAlwaysVacuous con d1 gf a = Empty-rec {_} {Pf (neg (prov G))} (goedelHalfOne con d1 gf a)
provNegEmpty : {l : Level} {T : Theory {l}} {G : Sent T} →
                                            Consistent T →
                                            HBL1 T → GoedelFix G → NegL (Pf (neg (prov G)))
provNegEmpty con d1 gf = λ pNP → goedelHalfOne con d1 gf (snd gf pNP)
-- the countermodel: four sentences, consistency, D1 and the fixed point, and ⊢ ¬G
data W = wtop | wbot | wg | wng
wneg : W → W
wneg w = case w of wtop → wbot; wbot → wtop; wg → wng; wng → wg
wPf : W → Type
wPf w = case w of wtop → Unit; wbot → Empty; wg → Empty; wng → Unit
Wit : Theory {lzero}
Wit = (W , wPf , wneg , λ s → wtop)
witCon : Consistent Wit
witCon =
  λ s →
    case s return (λ y → wPf y → wPf (wneg y) → Empty) of
      wtop → λ a b → b
      wbot → λ a b → a
      wg → λ a b → a
      wng → λ a b → b
witHBL1 : HBL1 Wit
witHBL1 = λ s p → unit
witFix : GoedelFix {lzero} {Wit} wg
witFix = (λ a → Empty-rec {_} {Empty} a , λ b → Empty-rec {_} {Empty} b)
witProvesNegG : wPf (wneg wg)
witProvesNegG = unit
noHalfTwo : ((T : Theory {lzero}) →
             (G : Sent T) → Consistent T → HBL1 T → GoedelFix G → NegL (Pf (neg G))) → Empty
noHalfTwo half2 = half2 Wit wg witCon witHBL1 witFix witProvesNegG
-- representability, as the structure the diagonal lemma needs
HasDiagonal : {l : Level} → Theory {l} → Type (lsuc l)
HasDiagonal T =
  (imp : Sent T → Sent T → Sent T) ×
  ((a b : Sent T) → Pf (imp a b) → Pf a → Pf b) ×
  (Form : Type l) ×
  (apF : Form → Sent T → Sent T) ×
  ((f : Form) → (G : Sent T) × Pf (imp G (apF f G)) × Pf (imp (apF f G) G)) ×
  (negProv : Form) × ((s : Sent T) → apF negProv s ≡ neg (prov s))
dimp : {l : Level} {T : Theory {l}} → HasDiagonal T → Sent T → Sent T → Sent T
dimp D = fst D
dmp : {l : Level} {T : Theory {l}} {D : HasDiagonal T} {a b : Sent T} →
                                                       Pf (dimp D a b) → Pf a → Pf b
dmp = fst (snd D) a b
dForm : {l : Level} {T : Theory {l}} → HasDiagonal T → Type l
dForm D = fst (snd (snd D))
dapp : {l : Level} {T : Theory {l}} {D : HasDiagonal T} → dForm D → Sent T → Sent T
dapp = fst (snd (snd (snd D)))
diag-fix : {l : Level} {T : Theory {l}} {D : HasDiagonal T} →
                                    (f : dForm D) →
                                    (G : Sent T) ×
                                    Pf (dimp D G (dapp f G)) × Pf (dimp D (dapp f G) G)
diag-fix = fst (snd (snd (snd (snd D))))
dnegProv : {l : Level} {T : Theory {l}} → (D : HasDiagonal T) → dForm D
dnegProv D = fst (snd (snd (snd (snd (snd D)))))
dnegProv-is : {l : Level} {T : Theory {l}} →
                          (D : HasDiagonal T) → (s : Sent T) → dapp (dnegProv D) s ≡ neg (prov s)
dnegProv-is D = snd (snd (snd (snd (snd (snd D)))))
goedelSentence : {l : Level} {T : Theory {l}} → HasDiagonal T → Sent T
goedelSentence D = fst (diag-fix (dnegProv D))
diagonalGivesGoedelFix : {l : Level} {T : Theory {l}} →
                                     (D : HasDiagonal T) → GoedelFix (goedelSentence D)
diagonalGivesGoedelFix D =
  let G = goedelSentence D
      fx = diag-fix (dnegProv D)
  in (λ pG → subst {_} {_} {_} {Pf {l} {T}} (dnegProv-is D G) (dmp (fst (snd fx)) pG)
     , λ pNP →
         dmp (snd (snd fx))
           (subst {_} {_} {_} {Pf {l} {T}} {_} {dapp (dnegProv D) G} (λ i → dnegProv-is D G (~ i))
              pNP))
-- full independence, given ω-consistency and contraposition, double negation, transitivity
internalFix : {l : Level} {T : Theory {l}} {D : HasDiagonal T} →
                                           ((a b : Sent T) →
                                            Pf (dimp D a b) → Pf (dimp D (neg b) (neg a))) →
                                           ((a : Sent T) → Pf (dimp D (neg (neg a)) a)) →
                                           ((a b c : Sent T) →
                                            Pf (dimp D a b) → Pf (dimp D b c) → Pf (dimp D a c)) →
                                           Pf
                                             (dimp D (neg (goedelSentence D))
                                                (prov (goedelSentence D)))
internalFix contra dne trans =
  let G = goedelSentence D
      bwd = subst {_} {_} {_} {λ s → Pf (dimp D s G)} (dnegProv-is D G)
              (snd (snd (diag-fix (dnegProv D))))
  in trans (neg G) (neg (neg (prov G))) (prov G) (contra (neg (prov G)) G bwd) (dne (prov G))
secondConjunct : {l : Level} {T : Theory {l}} {D : HasDiagonal T} →
                                              ((a b : Sent T) →
                                               Pf (dimp D a b) → Pf (dimp D (neg b) (neg a))) →
                                              ((a : Sent T) → Pf (dimp D (neg (neg a)) a)) →
                                              ((a b c : Sent T) →
                                               Pf (dimp D a b) → Pf (dimp D b c) → Pf (dimp D a c)) →
                                              NegL (Pf (goedelSentence D)) →
                                              NegL (OmegaBad (goedelSentence D)) →
                                              NegL (Pf (neg (goedelSentence D)))
secondConjunct contra dne trans notG notOmega =
  λ pNegG → notOmega (dmp (internalFix contra dne trans) pNegG , notG)
independenceFromRepresentability : {l : Level} {T : Theory {l}} {D : HasDiagonal T} →
                                                                ((a b : Sent T) →
                                                                 Pf (dimp D a b) →
                                                                 Pf (dimp D (neg b) (neg a))) →
                                                                ((a : Sent T) →
                                                                 Pf (dimp D (neg (neg a)) a)) →
                                                                ((a b c : Sent T) →
                                                                 Pf (dimp D a b) →
                                                                 Pf (dimp D b c) → Pf (dimp D a c)) →
                                                                Consistent T →
                                                                HBL1 T →
                                                                NegL (OmegaBad (goedelSentence D)) →
                                                                Independent (goedelSentence D)
independenceFromRepresentability contra dne trans con d1 notOmega =
  let half = goedelHalfOne con d1 (diagonalGivesGoedelFix D)
  in (half , secondConjunct contra dne trans half notOmega)
-- ---- box 9 (5.13): equal length. A trace of n steps from s to t, by recursion on n
-- (Trace 0 s t is s = t; Trace (n+1) s t is a step to some u and a trace from u)
Trace : {S : Type} → (S → S → Type) → Nat → S → S → Type
Trace Step n s t =
  (case n return (λ y → S → S → Type) of
     zero → λ s t → s ≡ t
     suc m → λ s t → (u : S) × Step s u × rec m u t) s t
Normal : {S : Type} → (S → S → Type) → S → Type
Normal Step t = (u : S) → Step t u → Empty
Diamond : {S : Type} → (S → S → Type) → Type
Diamond Step = (s a b : S) → Step s a → Step s b → Sum (a ≡ b) ((c : S) × Step a c × Step b c)
-- any available first interaction removes exactly one unit from any terminating reduction
peel : {S : Type} {Step : S → S → Type} →
                  Diamond Step →
                  {n : Nat} {s u t : S} →
                            Step s u → Trace Step (suc n) s t → Normal Step t → Trace Step n u t
peel diamond =
  (case n return (λ y →
                    (s u t : S) →
                    Step s u → Trace Step (suc y) s t → Normal Step t → Trace Step y u t) of
     zero → 
       λ s u t jump tr normal →
         case diamond s (fst tr) u (fst (snd tr)) jump of
           inl same → concat {_} {_} {u} (λ i → same (~ i)) (snd (snd tr))
           inr w → 
             Empty-rec {_} {u ≡ t}
               (normal (fst w)
                  (subst {_} {_} {_} {λ v → Step v (fst w)} (snd (snd tr)) (fst (snd w))))
     suc m → 
       λ s u t jump tr normal →
         case diamond s (fst tr) u (fst (snd tr)) jump of
           inl same → subst {_} {_} {_} {λ v → Trace Step (suc m) v t} same (snd (snd tr))
           inr w → 
             (fst w , snd (snd w) , rec m (fst tr) (fst w) t (fst (snd w)) (snd (snd tr)) normal))
    s u t
normal-length-zero : {S : Type} {Step : S → S → Type} {n : Nat} {s t : S} →
                                                                Normal Step s →
                                                                Trace Step n s t → n ≡ zero
normal-length-zero =
  (case n return (λ y → (s t : S) → Normal Step s → Trace Step y s t → y ≡ zero) of
     zero → λ s t normal tr i → zero
     suc m → 
       λ s t normal tr → Empty-rec {_} {Path Nat (suc m) zero} (normal (fst tr) (fst (snd tr)))) s
    t
zero-endpoints : {S : Type} {Step : S → S → Type} {s t : S} → Trace Step zero s t → s ≡ t
zero-endpoints tr = tr
-- all complete reductions of this object to this normal form have one length
same-normalization-length : {S : Type} {Step : S → S → Type} →
                                       Diamond Step →
                                       {n m : Nat} {s t : S} →
                                                   Trace Step n s t →
                                                   Trace Step m s t → Normal Step t → n ≡ m
same-normalization-length diamond =
  (case n return (λ y →
                    (m : Nat) →
                    (s t : S) → Trace Step y s t → Trace Step m s t → Normal Step t → y ≡ m) of
     zero → 
       λ m s t tr1 tr2 normal →
         symN
           (normal-length-zero {_} {Step} {m} {_} {t}
              (subst {_} {_} {_} {λ v → Normal Step v} {_} {s} (λ i → tr1 (~ i)) normal) tr2)
     suc k → 
       λ m s t tr1 tr2 normal →
         (case m return (λ y → Trace Step y s t → suc k ≡ y) of
            zero → 
              λ tr →
                Empty-rec {_} {Path Nat (suc k) zero}
                  (normal (fst tr1) (subst {_} {_} {_} {λ v → Step v (fst tr1)} tr (fst (snd tr1))))
            suc m1 → 
              λ tr i →
                suc
                  (rec k m1 (fst tr1) t (snd (snd tr1))
                     (peel {_} {Step} diamond {m1} (fst (snd tr1)) tr normal) normal i)) tr2) m s t
normalization-is-geodesic : {S : Type} {Step : S → S → Type} →
                                       Diamond Step →
                                       {n m : Nat} {s t : S} →
                                                   Trace Step n s t →
                                                   Trace Step m s t → Normal Step t → le n m
normalization-is-geodesic diamond tr1 tr2 normal =
  subst {_} {_} {_} {λ x → le n x}
    (same-normalization-length {_} {Step} diamond {n} {m} {s} tr1 tr2 normal) (le-refl n)
-- ---- box 15 (9.7–9.8): every + is a merge; the information is fixed by the endpoints
data Shape = one | node (l : Shape) (r : Shape)
size : Shape → Nat
size t = case t of one → suc zero; node l r → plus (rec l) (rec r)
cost : Shape → Nat
cost t = case t of one → zero; node l r → plus (plus (size l) (size r)) (plus (rec l) (rec r))
paid : Nat → Shape → Nat
paid d t =
  (case t return (λ y → Nat → Nat) of
     one → λ d → d
     node l r → λ d → plus (rec l (suc d)) (rec r (suc d))) d
-- the arithmetic the solver did: rearrangements under the semiring laws. Paths are combined by
-- lemmas (cong2N, in lib/std.cub), not pointwise under a dimension: checking an application looks
-- only at types
times-distl : (d a b : Nat) → times d (plus a b) ≡ plus (times d a) (times d b)
times-distl d a b =
  transN (times-comm d (plus a b))
    (transN (times-distr a b d) (cong2N plus (times-comm a d) (times-comm b d)))
swap-mid : (a b c d : Nat) → plus (plus a b) (plus c d) ≡ plus (plus a c) (plus b d)
swap-mid a b c d =
  transN (plus-assoc a b (plus c d))
    (transN (congN (plus a) (symN (plus-assoc b c d)))
       (transN (congN (plus a) (congN (λ x → plus x d) (plus-comm b c)))
          (transN (congN (plus a) (plus-assoc c b d)) (symN (plus-assoc a c (plus b d))))))
rearrange6 : (a b c d e f : Nat) →
             plus (plus a (plus b c)) (plus d (plus e f)) ≡ plus (plus (plus b e) (plus a d))
                                                              (plus c f)
rearrange6 a b c d e f =
  transN (cong2N plus (symN (plus-assoc a b c)) (symN (plus-assoc d e f)))
    (transN (swap-mid (plus a b) c (plus d e) f)
       (transN (congN (λ x → plus x (plus c f)) (swap-mid a b d e))
          (congN (λ x → plus x (plus c f)) (plus-comm (plus a d) (plus b e)))))
paid≡ : (t : Shape) → (d : Nat) → paid d t ≡ plus (cost t) (times d (size t))
paid≡ t =
  case t return (λ y → (d : Nat) → paid d y ≡ plus (cost y) (times d (size y))) of
    one → λ d → symN (times-one d)
    node l r → 
      λ d →
        transN (cong2N plus (rec l (suc d)) (rec r (suc d)))
          (transN
             (rearrange6 (cost l) (size l) (times d (size l)) (cost r) (size r) (times d (size r)))
             (congN (plus (plus (plus (size l) (size r)) (plus (cost l) (cost r))))
                (symN (times-distl d (size l) (size r)))))
-- the sum of the intermediate sums is the sum over elements of their depth
cost≡depth : (t : Shape) → cost t ≡ paid zero t
cost≡depth t = symN (transN (paid≡ t zero) (plus-zero (cost t)))
bal : Nat → Shape
bal k = case k of zero → one; suc j → node (rec j) (rec j)
double : (x : Nat) → plus x x ≡ times 2 x
double x = congN (plus x) (symN (plus-zero x))
size-bal : (k : Nat) → size (bal k) ≡ pow 2 k
size-bal k =
  case k return (λ y → size (bal y) ≡ pow 2 y) of
    zero → λ i → suc zero
    suc j → transN (cong2N plus (rec j) (rec j)) (double (pow 2 j))
cost-bal-step : (k x : Nat) →
                plus (plus x x) (plus (times k x) (times k x)) ≡ times (suc k) (times 2 x)
cost-bal-step k x =
  cong2N plus (double x) (transN (symN (times-distl k x x)) (congN (times k) (double x)))
cost-bal : (k : Nat) → cost (bal k) ≡ times k (pow 2 k)
cost-bal k =
  case k return (λ y → cost (bal y) ≡ times y (pow 2 y)) of
    zero → λ i → zero
    suc j → 
      transN (cong2N plus (cong2N plus (size-bal j) (size-bal j)) (cong2N plus (rec j) (rec j)))
        (cost-bal-step j (pow 2 j))
chain4 : Shape
chain4 = node one (node one (node one one))
chain8 : Shape
chain8 = node one (node one (node one (node one (node one (node one (node one one))))))
#check (λ i → 9) : cost chain4 ≡ 9
#check (λ i → 35) : cost chain8 ≡ 35
-- the interleavings of a run of a with a run of b
il : Nat → Nat → Nat
il a =
  case a return (λ y → Nat → Nat) of
    zero → λ b → suc zero
    suc a1 → 
      λ b → case b return (λ y → Nat) of zero → suc zero; suc b1 → plus (rec a1 (suc b1)) (rec b1)
times-one-left : (x : Nat) → times (suc zero) x ≡ x
times-one-left x = plus-zero x
il-split : (X Y A B a b : Nat) →
           times (plus X Y) (times (times (suc a) A) (times (suc b) B)) ≡ plus
                                                                            (times (suc a)
                                                                               (times X
                                                                                  (times A
                                                                                     (times (suc b)
                                                                                        B))))
                                                                            (times (suc b)
                                                                               (times Y
                                                                                  (times
                                                                                     (times (suc a)
                                                                                        A) B)))
il-split X Y A B a b =
  transN (times-distr X Y (times (times (suc a) A) (times (suc b) B)))
    (cong2N plus
       (transN (congN (times X) (times-assoc (suc a) A (times (suc b) B)))
          (transN (symN (times-assoc X (suc a) (times A (times (suc b) B))))
             (transN (congN (λ z → times z (times A (times (suc b) B))) (times-comm X (suc a)))
                (times-assoc (suc a) X (times A (times (suc b) B))))))
       (transN (congN (times Y) (symN (times-assoc (times (suc a) A) (suc b) B)))
          (transN
             (congN (times Y) (congN (λ z → times z B) (times-comm (times (suc a) A) (suc b))))
             (transN (congN (times Y) (times-assoc (suc b) (times (suc a) A) B))
                (transN (symN (times-assoc Y (suc b) (times (times (suc a) A) B)))
                   (transN
                      (congN (λ z → times z (times (times (suc a) A) B)) (times-comm Y (suc b)))
                      (times-assoc (suc b) Y (times (times (suc a) A) B))))))))
il-close : (a b K : Nat) →
           plus (times (suc a) K) (times (suc b) K) ≡ times (suc (plus a (suc b))) K
il-close a b K =
  transN (plus-assoc K (times a K) (plus K (times b K)))
    (congN (plus K) (symN (times-distr a (suc b) K)))
-- an ordering of the whole is the interleaving with an ordering of each run
il-fact : (a b : Nat) → times (il a b) (times (fact a) (fact b)) ≡ fact (plus a b)
il-fact a =
  case a return (λ y → (b : Nat) → times (il y b) (times (fact y) (fact b)) ≡ fact (plus y b)) of
    zero → λ b → transN (times-one-left (times (suc zero) (fact b))) (times-one-left (fact b))
    suc a1 → 
      λ b →
        case b return (λ y →
                         times (il (suc a1) y) (times (fact (suc a1)) (fact y)) ≡ fact
                                                                                    (plus (suc a1)
                                                                                       y)) of
          zero → 
            transN (times-one-left (times (fact (suc a1)) (suc zero)))
              (transN (times-one (fact (suc a1))) (congN fact (symN (plus-zero (suc a1)))))
          suc b1 → 
            transN (il-split (il a1 (suc b1)) (il (suc a1) b1) (fact a1) (fact b1) a1 b1)
              (transN
                 (cong2N (λ x y → plus (times (suc a1) x) (times (suc b1) y)) (rec a1 (suc b1))
                    (transN (rec b1) (congN fact (symN (plus-suc a1 b1)))))
                 (il-close a1 b1 (fact (plus a1 (suc b1)))))
-- what every merge settles, multiplied over the sum: n! whatever the shape
info : Shape → Nat
info t = case t of one → suc zero; node l r → times (il (size l) (size r)) (times (rec l) (rec r))
info≡ : (t : Shape) → info t ≡ fact (size t)
info≡ t =
  case t return (λ y → info y ≡ fact (size y)) of
    one → λ i → suc zero
    node l r → 
      transN (cong2N (λ x y → times (il (size l) (size r)) (times x y)) (rec l) (rec r))
        (il-fact (size l) (size r))
