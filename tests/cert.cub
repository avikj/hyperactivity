-- tests/cert.cub — certificates end to end (plan 18.13, F32): the unverified search over codes
-- (lib/lin.cub: enumeration and the directed Fourier–Motzkin search) produces multipliers; the
-- verified checker over the typed fragment (lib/linproof.cub: cert-check with cert-sound) accepts
-- them; the soundness theorem applied at an environment is a witness of the goal. Loaded after
-- lib/match.cub lib/lin.cub lib/check.cub lib/std.cub lib/linproof.cub lib/eqproof.cub.
-- ---------------------------------------------------------------- the bridge, untyped
-- a code of the fragment read as the typed fragment, hypotheses and multipliers likewise (these
-- are untyped, as the search is; what they produce is checked by the typed checker)
to-lincode c =
  case c of
    cwlit n → lc-lit n
    cvar v → lc-var v
    cwsucc a → lc-suc (to-lincode a)
    cwop o a b → lc-add (to-lincode a) (to-lincode b)
    cann t T → to-lincode t
    _ → lc-lit #0
to-hyps hs = case hs of lnil → hnil; lcons h r → hcons (to-lincode (fst h)) (to-lincode (snd h)) (to-hyps r)
to-mults l = case l of lnil → munil; lcons c r → mucons c (to-mults r)
unwrap o = case o of some x → x; none → lnil
-- the search's certificate for the decoder's obligation checks under the verified checker
goal1a = cwop #2 (cvar #0) (cwlit #4)
goal1b = cvar #2
#same to-mults (unwrap (omega-cert hs1 goal1a goal1b)) = mucons #1 (mucons #1 munil)
#same cert-check (to-hyps hs1) (to-mults (unwrap (omega-cert hs1 goal1a goal1b))) (to-lincode goal1a) (to-lincode goal1b) = true
-- the chain of four and the multiplier above one, found directed, check verified
#same cert-check (to-hyps lhyp2) (to-mults (unwrap (omega-cert lhyp2 (cwop #2 (cvar #0) (cwlit #2)) (cvar #4)))) (to-lincode (cwop #2 (cvar #0) (cwlit #2))) (to-lincode (cvar #4)) = true
goal3a = cwop #2 (cwop #2 (cvar #0) (cvar #0)) (cwop #2 (cvar #0) (cvar #0))
#same cert-check (to-hyps lhyp3) (to-mults (unwrap (omega-cert lhyp3 goal3a (cvar #2)))) (to-lincode goal3a) (to-lincode (cvar #2)) = true
-- the Nat-specific step (a variable dropped from the left): found and checked
#same cert-check (to-hyps lhyp4) (to-mults (unwrap (omega-cert lhyp4 (cvar #0) (cwlit #3)))) (to-lincode (cvar #0)) (to-lincode (cwlit #3)) = true
-- what the search refutes has no certificate to check: the empty list is refused
#same cert-check (to-hyps hs1) (to-mults (unwrap (omega-cert hs1 (cwop #2 (cvar #0) (cwlit #9)) goal1b))) (to-lincode (cwop #2 (cvar #0) (cwlit #9))) (to-lincode goal1b) = false
-- the two searches agree where both reach
#same find-cert #2 hs1 goal1a goal1b = omega-cert hs1 goal1a goal1b
-- ---------------------------------------------------------------- the theorem applied
-- at the environment off = 1, i = 2, n = 20 the hypotheses hold with witnesses 1 and 10; the
-- certificate's soundness gives off + 4 ≤ n with its witness, which computes: 20 − 5 = 15
env1 : Env
env1 v = case weq v #0 of true → #1; false → (case weq v #1 of true → #2; false → #20)
hyp1t : Hyps
hyp1t = hcons (lc-var #0) (lc-var #1) (hcons (lc-add (lc-var #1) (lc-lit #8)) (lc-var #2) hnil)
holds1 : Holds env1 hyp1t
holds1 = ((#1 , λ i → #2) , ((#10 , λ i → #20) , unit))
cert1 : Mults
cert1 = mucons #1 (mucons #1 munil)
goal1 : Lew (wev env1 (lc-add (lc-var #0) (lc-lit #4))) (wev env1 (lc-var #2))
goal1 = cert-sound env1 hyp1t cert1 (lc-add (lc-var #0) (lc-lit #4)) (lc-var #2) holds1 (λ i → true)
#same fst goal1 = #15
#same wev env1 (lc-add (lc-var #0) (lc-lit #4)) = #5
-- the witness really is a witness: a + d = b at the environment
#same plusw (wev env1 (lc-add (lc-var #0) (lc-lit #4))) (fst goal1) = #20
-- ---------------------------------------------------------------- equalities from codes
-- hypotheses and a goal as codes (globals 0 = f, 1 = g, 2 = c; variable 0 schematic), read as
-- terms, the trace searched for, checked by the verified checker
ceqs = lcons (capp (cglob #0) (cvar #0) , capp (cglob #1) (cvar #0)) (lcons (capp (cglob #1) (cglob #2) , cglob #2) lnil)
cgoal = capp (cglob #0) (capp (cglob #0) (cglob #2))
eq-from-codes hs s t n =
  obind (eqs-of-codes hs) (λ es → obind (tm-of-code s) (λ ts → obind (tm-of-code t) (λ tgt →
    case find-trace n es ts tgt of notr → none; atrace tr → some (check-eq es tr ts tgt))))
#same eq-from-codes ceqs cgoal (cglob #2) #4 = some true
#same eq-from-codes ceqs cgoal (cglob #1) #4 = none
#same eq-from-codes ceqs (clam cgoal) (cglob #2) #4 = none
-- ---------------------------------------------------------------- integers (lib/intproof.cub, lib/intlin.cub)
-- the obligation x + 3 ≤ z from x ≤ y − 2 and y ≤ z − 1 over Int: the search finds the
-- multipliers (1, 1), the verified checker accepts them, and the theorem applied at
-- x = −5, y = −3, z = 0 gives the claim with its witness: (x + 3) + d = z as differences, d = 2
ihs2 : IHyps
ihs2 = ihcons (ic-var #0) (ic-add (ic-var #1) (ic-lit (negsuc (suc zero)))) (ihcons (ic-var #1) (ic-add (ic-var #2) (ic-lit (negsuc zero))) ihnil)
igoal-a : IntCode
igoal-a = ic-add (ic-var #0) (ic-lit (pos (suc (suc (suc zero)))))
igoal-b : IntCode
igoal-b = ic-var #2
#same int-omega-cert ihs2 igoal-a igoal-b = some (lcons #1 (lcons #1 lnil))
#same int-cert-check ihs2 (int-cert-of (int-omega-cert ihs2 igoal-a igoal-b)) igoal-a igoal-b = true
#same int-find-cert #2 ihs2 igoal-a igoal-b = int-omega-cert ihs2 igoal-a igoal-b
-- the claim refuted by the search (x + 4 ≤ z) has no certificate to check
#same int-cert-check ihs2 (int-cert-of (int-omega-cert ihs2 (ic-add (ic-var #0) (ic-lit (pos (suc (suc (suc (suc zero))))))) igoal-b)) (ic-add (ic-var #0) (ic-lit (pos (suc (suc (suc (suc zero))))))) igoal-b = false
ienv2 : IEnv
ienv2 = ienv (cons (negsuc (suc (suc (suc (suc zero))))) (cons (negsuc (suc (suc zero))) (cons (pos zero) nil)))
icert2 : Mults
icert2 = mucons #1 (mucons #1 munil)
-- the hypotheses hold at the environment: −5 ≤ −5 and −3 ≤ −1, as differences (witnesses 0 and 2)
iholds2 : IHolds ienv2 ihs2
iholds2 = ((#0 , λ i → #5) , ((#2 , λ i → #3) , unit))
igoal2 : LeZ2 (zev2 ienv2 igoal-a) (zev2 ienv2 igoal-b)
igoal2 = int-cert-sound ienv2 ihs2 icert2 igoal-a igoal-b iholds2 (λ i → true)
#same fst igoal2 = #2
#same fromZ2 (zev2 ienv2 igoal-a) = negsuc (suc zero)
-- the witness really is one: (x + 3)⁺ + z⁻ + d = z⁺ + (x + 3)⁻ at the environment
#same plusw (plusw (fst (zev2 ienv2 igoal-a)) (snd (zev2 ienv2 igoal-b))) (fst igoal2) = plusw (fst (zev2 ienv2 igoal-b)) (snd (zev2 ienv2 igoal-a))
-- the order laws proved by the checker compute: transitivity's witness is the sum of the witnesses
#same fst (leZ-add (negsuc zero) (pos zero) (pos zero) (pos (suc zero)) (#1 , λ i → #1) (#1 , λ i → #1)) = #2
