-- tests/native.cub — the call boundary, net → native (B18): a definition's compiled form (the
-- unboxed C of lib/emitu.cub, built as a shared library) entered by #native; the definition then
-- calls it on word arguments and computes on the net on any other. Loaded after the back end
-- (lib/lower.cub, lib/specialize.cub, lib/emitu.cub).
lam-body f = case f of flam b → b; _ → f
plusw-fo = lam-body (lam-body (specialize (Word → Word → Word) lnil (code plusw)))
#native plusw 2 = emit-lib-u (lcons (#0 , (#2 , plusw-fo)) lnil)
#same plusw #3 #4 = #7
#same plusw #1000000 #1000000 = #2000000
-- not words: the net's own definition
#same (λ (x : Word) → plusw x #0) = (λ (x : Word) → x)
-- a byte string across the boundary: the two-load sum (lib/repr.cub's sum2, a checked definition
-- over Bytes 32) entered native; the buffer is boxed as the emitted runtime's V on the way in
sum2-def : Bytes 32 → Word
sum2-def b = plusw (i64toWord (load64 32 b 16 (8 , λ i → 32))) (i64toWord (load64 32 b 0 (24 , λ i → 32)))
#native sum2-def 1 = emit-lib-u (lcons (#0 , (#1 , lam-body sum2)) lnil)
#same sum2-def (store64 32 (store64 32 (bytes 32) 0 (24 , λ i → 32) (i64 #5)) 16 (8 , λ i → 32) (i64 #9)) = #14
-- a constructor across the boundary: the length of a list (lib/lower.cub's LW), its recursion
-- lifted to a C function, entered with the list boxed as the emitted runtime's V (tag c+1 with
-- the fields boxed) and the result a word of NW rebuilt from the boxed result
len-base = lcons (gidx (code zw) , (#0 , flit #0)) (lcons (gidx (code sw) , (#1 , fprim P-add (lcons (fvar #0) (lcons (flit #1) lnil)))) lnil)
len-lib = case lift #10 (lower c-len) of lifted t2 ds k → emit-lib-boxed-u (lcons (#0 , (#1 , fapply t2 (lcons (fvar #0) lnil))) (lapp2 len-base ds))
#native lenw 1 = len-lib
#same lenw (lwcons #7 (lwcons #8 (lwcons #9 lwnil))) = #3
-- and a constructor coming back: a list extended natively, the result rebuilt from the boxed V
-- (tag c+1 and the fields, by the result's data type named in the entry's box<d>)
consw : LW → LW
consw l = lwcons #1 l
cons-lib = emit-lib-boxed-u (lcons (#0 , (#1 , lam-body (lower (code (λ (l : LW) → lwcons #1 l))))) lnil)
#native consw 1 = cons-lib
#same consw (lwcons #7 lwnil) = lwcons #1 (lwcons #7 lwnil)
-- opaque handles (B18, V_NATIVE): a C library written by hand (tests/native/handle.c), its
-- functions entered by #native … from. A `void *` result is a handle of type Native: the net
-- holds it without reading it, passes it to that library's entries, and runs the library's
-- cubical_release once when the last copy is erased
postulate
  buf-new : Word → Native
  buf-push : Native → Word → Native
  buf-sum : Native → Word
  buf-len : Native → Word
  buf-live : Word → Word
  buf-made : Word → Word
#native buf-new 1 from "tests/native/handle.c" "buf_new"
#native buf-push 2 from "tests/native/handle.c" "buf_push"
#native buf-sum 1 from "tests/native/handle.c" "buf_sum"
#native buf-len 1 from "tests/native/handle.c" "buf_len"
#native buf-live 1 from "tests/native/handle.c" "buf_live"
#native buf-made 1 from "tests/native/handle.c" "buf_made"
#same buf-sum (buf-push (buf-push (buf-push (buf-new #0) #3) #4) #5) = #12
#same buf-len (buf-push (buf-push (buf-new #0) #3) #4) = #2
-- every handle of those readings is finalized when its reading is done: none alive, seven made
#same buf-live #0 = #0
#same buf-made #0 = #7
-- a handle shared by two readers: one C object, read twice, finalized once
#same (λ (b : Native) → plusw (buf-sum b) (buf-len b)) (buf-push (buf-new #0) #7) = #8
#same buf-live #0 = #0
-- a handle printed: the entry that made it (its address is not part of a reading); the printed
-- copies are dropped by the reading
#same buf-new #0 = buf-new #1
#same buf-live #0 = #0
-- identity: %view gives a handle's serial number, so two handles are equal when they are one object
-- (untyped: %view is the checker's)
same-handle a b = case %view a of wnative i k → (case %view b of wnative j k2 → %weq i j; _ → false); _ → false
#same (λ (b : Native) → same-handle b b) (buf-new #0) = true
#same same-handle (buf-new #0) (buf-new #1) = false
#same buf-live #0 = #0
-- a handle passed where a word is expected: not called natively (the entry takes words), the
-- postulate stays stuck
#same buf-live #2 = #0
-- boxed results kept native (#native … keep): consw's result stays the emitted runtime's V, passed
-- to lenw as it is (no cells built between the two compiled calls); read by the net, it is
-- unboxed into cells
consk : LW → LW
consk l = lwcons #1 l
#native consk 1 keep = cons-lib
#same lenw (consk (consk (lwcons #7 lwnil))) = #3
#same consk (consk (lwcons #7 lwnil)) = lwcons #1 (lwcons #1 (lwcons #7 lwnil))
#same (case consk lwnil of lwnil → #0; lwcons x r → x) = #1
-- represented values by their layout (B18): a definition over Nat compiled with Nat laid out as
-- Word (lib/repr.cub's program-rep: plus the native addition by its op line, suc through to and
-- from) takes and returns words in C; the call converts at the boundary by the representation's
-- to (the argument) and from (the result), and falls back to the definition over the
-- representation (to ∘ dbln ∘ from), so both paths agree
dbln : Nat → Nat
dbln n = plus n (suc n)
#native dbln 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (n : Nat) → dbln n))))
#same dbln 20 = 41
#same dbln (suc (suc zero)) = 5
#same plus (dbln 3) 1 = 8
-- a specialization cached by key (item 17): the program is named before it is computed, by its
-- expression with each checked definition by its codebase key, the values written in it (5, 6
-- here: the run-known values) and the libraries the specializer and printer come from; the same
-- specialization again, here or in a later run, is read from the cache without the specializer or
-- the C compiler ("specialization cached by key, 0 steps"); another value is another key
add5 : Nat → Nat
add5 n = plus 5 n
add5b : Nat → Nat
add5b n = plus 5 n
add6 : Nat → Nat
add6 n = plus 6 n
#native add5 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (n : Nat) → add5 n))))
#native add5b 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (n : Nat) → add5 n))))
#native add6 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (n : Nat) → add6 n))))
#same add5 10 = 15
#same add5b 10 = 15
#same add6 10 = 16

-- B18, records by value: a record of word-represented fields (Pt, two Nat as Word) is emitted as the C struct
-- struct T<di> { tag; union { struct { f0; f1; } c0; } u; } and the entry takes and returns it by value; the
-- machine calls it through a trampoline appended to the program (the struct's fields as words in, the result's
-- fields as words out), each field crossing as its representation (to before, from after)
data Pt = pt (a : Nat) (b : Nat)

swapPt : Pt → Pt
swapPt p = case p of pt a b → pt (plus b 1) a

sumPt : Pt → Nat → Nat
sumPt p k = case p of pt a b → plus (plus a b) k

#native swapPt 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (p : Pt) → swapPt p))))
#native sumPt 2 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (p : Pt) (k : Nat) → sumPt p k))))
#same swapPt (pt 3 40) = pt 41 3
#same swapPt (pt 7 8) = pt 9 7
#same sumPt (pt 3 40) 2 = 45
#same sumPt (swapPt (pt 5 6)) 0 = 12

-- item 18, the rest of the record crossing. A sum of records (Shape) is the emitted tagged struct
-- T<di> { tag; union { struct { f0; } c0; struct { f0; f1; } c1; } u; } by value: its slots are the tag
-- and the widest constructor's fields (three words), the trampoline switches on the tag both ways, and
-- the fallback rebuilds the record by branching on the tag slot. A record field that is itself a record
-- (Seg's Pt ends) is inline: Seg is flat in the emitted program (struct T<Seg> { …; T<Pt> f0; T<Pt> f1;
-- uint64_t f2; }), five slots in and out
data Shape = circ (r : Nat) | rect (w : Nat) (h : Nat)

area : Shape → Nat
area s = case s of circ r → plus r r; rect w h → plus w h

grow : Shape → Shape
grow s = case s of circ r → rect r 1; rect w h → circ (plus w h)

data Seg = seg (p : Pt) (q : Pt) (k : Nat)

segsum : Seg → Nat
segsum s = case s of seg p q k → (case p of pt a b → (case q of pt c d → plus (plus a b) (plus (plus c d) k)))

segswap : Seg → Seg
segswap s = case s of seg p q k → seg q p (plus k 1)

#native area 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (s : Shape) → area s))))
#native grow 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (s : Shape) → grow s))))
#native segsum 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (s : Seg) → segsum s))))
#native segswap 1 = emit-lib-u (lift-program #100000 (program-rep lnil #20 (code (λ (s : Seg) → segswap s))))
#same area (rect 3 4) = 7
#same area (circ 5) = 10
#same grow (rect 3 4) = circ 7
#same grow (circ 5) = rect 5 1
#same grow (grow (circ 5)) = circ 6
#same area (grow (rect 2 9)) = 22
#same segsum (seg (pt 1 2) (pt 3 4) 5) = 15
#same segswap (seg (pt 1 2) (pt 3 4) 5) = seg (pt 3 4) (pt 1 2) 6
#same segsum (segswap (seg (pt 10 20) (pt 30 40) 0)) = 101

-- the same crossing into C written by hand (tests/native/rec.c): struct Shape with its own member names,
-- struct Seg holding struct Pt inline, and struct Px of B12's primitive fields — UInt32 uint32_t, Float32
-- float, Float64 double, Int64 int64_t — each slot the field's bits (32 for UInt32 and Float32)
data Px = px (a : UInt32) (f : Float32) (d : Float64) (i : Int64)

-- each definition is a probe (the identity, or 0): the answer tells that the C entry ran, not the
-- definition the call falls back to (the emitted crossings above check the fallback's agreement)
shape-area : Shape → Nat
shape-area s = 0
shape-grow : Shape → Shape
shape-grow s = s
seg-swap : Seg → Seg
seg-swap s = s
px-mix : Px → Px
px-mix p = p
px-fbits : Px → Word → Word
px-fbits p k = k

#native shape-area 1 from "tests/native/rec.c" "shape_area"
#native shape-grow 1 from "tests/native/rec.c" "shape_grow"
#native seg-swap 1 from "tests/native/rec.c" "seg_swap"
#native px-mix 1 from "tests/native/rec.c" "px_mix"
#native px-fbits 2 from "tests/native/rec.c" "px_fbits"
#same shape-area (rect 3 4) = 7
#same shape-area (circ 6) = 12
#same shape-grow (rect 3 4) = circ 7
#same shape-grow (circ 5) = rect 5 1
#same seg-swap (seg (pt 1 2) (pt 3 4) 5) = seg (pt 3 4) (pt 1 2) 6
#same px-mix (px (u32 #7) (f32ofbits (u32 #1069547520)) (f64 #3) (i64 #20)) = px (u32 #8) (f32ofbits (u32 #1069547520)) (f64 #6) (i64 #40)
#same px-fbits (px (u32 #7) (f32ofbits (u32 #1069547520)) (f64 #3) (i64 #20)) #1 = #1069547521

-- item 17's re-entry: #native f n at k = P specializes f on its first k arguments while the program runs.
-- scaleat e b adds b e times; on the first call with e = 3 the net computes P 3 (the specializer
-- unrolls the loop: ((0 + b) + b) + b), the machine compiles and enters it and keeps it under 3; later
-- calls with 3 call it at once, e = 4 is another specialization, and a second run reads both from the
-- specialization cache by key (`native at run: … [specialization cached by key]`). Calls inside a
-- definition (use-scaleat) reach the same kept specialization
scaleat : Word → Word → Word
scaleat e b = %welimP (λ v → Word) e #0 (λ k r → %wadd r b)
#native scaleat 2 at 1 = λ (e : Word) → emit-lib-u (lcons (#0 , (#1 , lam-body (specialize (Word → Word) lnil (clam (capp (capp (code scaleat) (cwlit e)) (cvar #0)))))) lnil)
#same scaleat #3 #5 = #15
#same scaleat #3 #7 = #21
#same scaleat #4 #5 = #20
#same scaleat #3 #100 = #300
use-scaleat : Word → Word
use-scaleat w = %wadd (scaleat #3 w) (scaleat #3 (%wadd w #1))
#same use-scaleat #10 = #63
-- not words: the definition on the net
#same (λ (x : Word) → scaleat #2 x) = (λ (x : Word) → %wadd (%wadd #0 x) x)
-- the first reading after a plain #native is the compiled code's answer, not the definition's (a
-- probe: the program is add100's, the definition the identity, so the answer tells which ran; a
-- reading that neither called nor fell back would answer #1). A definition compiled before the
-- #native (useprobe) keeps the definition it was compiled against
probe100 : Word → Word
probe100 x = plusw x #100
probe : Word → Word
probe x = x
useprobe : Word → Word
useprobe x = probe x
#native probe 1 = emit-lib-u (lcons (#0 , (#1 , lam-body (specialize (Word → Word) lnil (code probe100)))) lnil)
#same probe #1 = #101
#same probe #2 = #102
#same useprobe #5 = #5
