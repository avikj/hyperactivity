-- per program: every run.py proved program the UNBOXED route prints, with the harness's arguments
-- (lib/region.cub's two, as run.py's proved-region defines it)
import "../lib/foproofd.cub"
p0 : Ptr 16
p0 = (0 , (8 , λ i → 16))
p8 : Ptr 16
p8 = (8 , (0 , λ i → 16))
two : Word → RM 16 Int64
two w = rthen (wr p0 (i64 w)) (rthen (wr p8 (i64 (%wsucc w))) (rbind (rd p0) (λ a → rmap (λ b → i64add a b) (rd p8))))
prog-two : Word → Word
prog-two w = i64toWord (eval-fresh 16 (two w))
-- proved: run.py answers 13
cp-ex-ds = (cu-harness (fo-args-fq (lcons (flit #4) lnil)) (lcons (#0 , (#1 , fw-to-fq (spec-w std-vrule ex-c))) lnil))
cp-ex-tr = cu-tr cp-ex-ds
#same cu-kok (cu-kinds cp-ex-ds) cp-ex-ds = true
#same cu-wt cp-ex-tr = true
#same cu-ebodies cp-ex-tr = ca-bodies (ca-harness (fo-args-fq (lcons (flit #4) lnil)) (lcons (#0 , (#1 , fw-to-fq (spec-w std-vrule ex-c))) lnil))
#show cu-sigs cp-ex-tr
#same cu-run cp-ex-tr (dnat #64) = mw #13
