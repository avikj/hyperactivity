#same c-of (fq-wf (fqprim #20 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904))))) = q-of (fq-wf (fqprim #20 (fq2 (fq-f64 (fql #4607182418800017408)) (fq-f64 (fql #4611686018427387904)))))
