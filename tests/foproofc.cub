-- tests/foproofc.cub — lib/foproofc.cub's readings: the C link's meaning (evc, over the checked translation
-- fq-to-ca) agrees with the first-order form's checked meaning (evq) construct by construct, on every
-- form and primitive the printers produce; the printer's text for a program; the word route's path to the
-- C end to end for run.py's two word programs. Loaded after tests/foproofc-progs.cub (generated: the
-- data route's path to the C for every other run.py proved program).
obs-q v = case v of kqw w → some w; _ → none
obs-cv v = case v of cw w → some w; _ → none
-- the table of tests/foproofq.cub: #3 a two-parameter definition, #4 a closure's definition (one capture,
-- its argument innermost); its C functions, their parameter counts, the keys with a dispatcher case
qc-G : Word → FQ
qc-G g = if weq g #3 then fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)) else (if weq g #4 then fqprim #1 (fq2 (fqv (suc zero)) (fqv zero)) else fql #0)
qc-AN : Word → Nat
qc-AN g = if weq g #3 then 2 else (if weq g #4 then 2 else zero)
qc-df : Word → Bool
qc-df g = if weq g #3 then true else weq g #4
qc-GC : Word → CA
qc-GC g = fq-to-ca (qc-G g) ckt (qc-AN g)
-- a closed term's C, at the scope with nothing in it
c-of t = obs-cv (evc qc-GC qc-AN qc-df (dnat #64) (fq-to-ca t ckt zero) csnil)
q-of t = obs-q (evq qc-G (dnat #64) t kqnil)
-- every construct and primitive the printers emit, the two meanings side by side (each term also well
-- formed for the C link: ca-ok, the translation's precondition)
#same c-of (fql #7) = q-of (fql #7)
#same ca-ok qc-AN qc-df (fql #7) ckt = true
#same c-of (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4)))) = q-of (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4))))
#same ca-ok qc-AN qc-df (fqlet (fql #3) (fqprim #0 (fq2 (fqv zero) (fql #4)))) ckt = true
#same c-of (fqprim #1 (fq2 (fql #9) (fql #4))) = q-of (fqprim #1 (fq2 (fql #9) (fql #4)))
#same ca-ok qc-AN qc-df (fqprim #1 (fq2 (fql #9) (fql #4))) ckt = true
#same c-of (fqprim #2 (fq2 (fql #9) (fql #4))) = q-of (fqprim #2 (fq2 (fql #9) (fql #4)))
#same ca-ok qc-AN qc-df (fqprim #2 (fq2 (fql #9) (fql #4))) ckt = true
#same c-of (fqprim #3 (fq2 (fql #9) (fql #9))) = q-of (fqprim #3 (fq2 (fql #9) (fql #9)))
#same ca-ok qc-AN qc-df (fqprim #3 (fq2 (fql #9) (fql #9))) ckt = true
#same c-of (fqprim #4 (fq2 (fql #3) (fql #9))) = q-of (fqprim #4 (fq2 (fql #3) (fql #9)))
#same ca-ok qc-AN qc-df (fqprim #4 (fq2 (fql #3) (fql #9))) ckt = true
#same c-of (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone))) = q-of (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone)))
#same ca-ok qc-AN qc-df (fqsw (fqcon #9 #1 (fq2 (fql #3) (fql #10))) (fqalt #0 zero (fql #0) (fqalt #1 2 (fqprim #1 (fq2 (fqv (suc zero)) (fqv zero))) fqanone))) ckt = true
#same c-of (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4)))) = q-of (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4))))
#same ca-ok qc-AN qc-df (fqproj #9 #1 #1 (fqcon #9 #1 (fq2 (fql #3) (fql #4)))) ckt = true
#same c-of (fqif (fql #0) (fql #1) (fql #2)) = q-of (fqif (fql #0) (fql #1) (fql #2))
#same ca-ok qc-AN qc-df (fqif (fql #0) (fql #1) (fql #2)) ckt = true
#same c-of (fqif (fql #5) (fql #1) (fql #2)) = q-of (fqif (fql #5) (fql #1) (fql #2))
#same ca-ok qc-AN qc-df (fqif (fql #5) (fql #1) (fql #2)) ckt = true
-- a λ as a value (fqlam) is outside the C subset: no printer on the proved route emits one (the word
-- route's main takes its parameters, the data route's λs are lifted to closures by key, fqclos), and
-- the translation's precondition refuses it
#same ca-ok qc-AN qc-df (fqapp (fqlam (fqprim #0 (fq2 (fqv zero) (fql #1)))) (fq1 (fql #41))) ckt = false
#same q-of (fqapp (fqlam (fqprim #0 (fq2 (fqv zero) (fql #1)))) (fq1 (fql #41))) = some #42
#same c-of (fqcall #3 (fq2 (fql #9) (fql #6))) = q-of (fqcall #3 (fq2 (fql #9) (fql #6)))
#same ca-ok qc-AN qc-df (fqcall #3 (fq2 (fql #9) (fql #6))) ckt = true
#same c-of (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3))) = q-of (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3)))
#same ca-ok qc-AN qc-df (fqapp (fqclos #4 (fq1 (fql #10))) (fq1 (fql #3))) ckt = true
#same c-of (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero))))) = q-of (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero)))))
#same ca-ok qc-AN qc-df (fq-welim (fql #5) (fql #0) (fqprim #0 (fq2 (fqv zero) (fqv (suc zero))))) ckt = true
#same c-of (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8)))) = q-of (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8))))
#same ca-ok qc-AN qc-df (fq-w64 (fqprim #8 (fq2 (fqprim #9 (fq3 (fqprim #12 (fq1 (fql #16))) (fql #8) (fq-i64 (fql #77)))) (fql #8)))) ckt = true
#same c-of (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16))))) = q-of (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16)))))
#same ca-ok qc-AN qc-df (fqprim #13 (fq1 (fqprim #12 (fq1 (fql #16))))) ckt = true
#same c-of (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4))) = q-of (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4)))
#same ca-ok qc-AN qc-df (fqprim #10 (fq2 (fqprim #11 (fq3 (fqprim #12 (fq1 (fql #8))) (fql #4) (fql #9))) (fql #4))) ckt = true
#same c-of (fq-w64 (fqprim #14 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) = q-of (fq-w64 (fqprim #14 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))
