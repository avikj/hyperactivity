-- the printer: a program's C through the checked link is the C lib/emitc.cub prints from the first-order
-- form, character for character (two definitions and a call, a closure applied)
#same ca-prog (ca-tr-defs (lcons (#0 , (#0 , fqcall #3 (fq2 (fql #9) (fql #6)))) (lcons (#3 , (#2 , qc-G #3)) lnil))) = emit-prog (lcons (#0 , (#0 , fq-to-fo (fqcall #3 (fq2 (fql #9) (fql #6))))) (lcons (#3 , (#2 , fq-to-fo (qc-G #3))) lnil))
-- ---------------------------------------------------------------- the word route, end to end, to the C
-- run.py's proved (lib/foproof.cub's ex-c) and proved-fib (fib-c): at every argument and fuel, whenever
-- the first-order form has a value, the C the proved route prints computes what the source code computes
ex-cpath : (x : Word) (N : Nat) → kq-nb (evq (λ g → fqnet) N (fw-to-fq (spec-w std-vrule ex-c)) (kqcons (kqw x) kqnil))
  → evc (λ g → caunsup) (λ g → zero) (λ g → false) N (fq-to-ca (fw-to-fq (spec-w std-vrule ex-c)) ckt (suc zero)) (csb zero (cw x) csnil) ≡ cw (wc-ev ex-c (envx x))
ex-cpath x N hn = ca-fw-path std-vrule ex-c x N (λ j → true) hn
fib-cpath : (x : Word) (N : Nat) → kq-nb (evq (λ g → fqnet) N (fw-to-fq (spec-w std-vrule fib-c)) (kqcons (kqw x) kqnil))
  → evc (λ g → caunsup) (λ g → zero) (λ g → false) N (fq-to-ca (fw-to-fq (spec-w std-vrule fib-c)) ckt (suc zero)) (csb zero (cw x) csnil) ≡ cw (wc-ev fib-c (envx x))
fib-cpath x N hn = ca-fw-path std-vrule fib-c x N (λ j → true) hn
-- what run.py's proved prints is that C: the word route's table, its main the instance's
#same specialize-proved-q (Word → Word) lnil (code (λ (w : Word) → fibx w)) = (#1 , lcons (#0 , (#1 , fw-to-fq (spec-w std-vrule fib-c))) lnil)
#same ca-table (ca-tr-defs (lcons (#0 , (#1 , fw-to-fq (spec-w std-vrule ex-c))) lnil)) #0 = fq-to-ca (fw-to-fq (spec-w std-vrule ex-c)) ckt (suc zero)
#same obs-cv (evc (λ g → caunsup) (λ g → zero) (λ g → false) (dnat #64) (fq-to-ca (fw-to-fq (spec-w std-vrule ex-c)) ckt (suc zero)) (csb zero (cw #4) csnil)) = some #13
#same obs-cv (evc (λ g → caunsup) (λ g → zero) (λ g → false) (dnat #400) (fq-to-ca (fw-to-fq (spec-w std-vrule fib-c)) ckt (suc zero)) (csb zero (cw #90) csnil)) = some #2880067194370816120
