#same ca-ok qc-AN qc-df (fq-w64 (fqprim #15 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) ckt = true
#same c-of (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) = q-of (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7)))))
#same ca-ok qc-AN qc-df (fq-w64 (fqprim #16 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #7))))) ckt = true
#same c-of (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5)))) = q-of (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5))))
#same ca-ok qc-AN qc-df (fqprim #17 (fq2 (fq-i64 (fql #5)) (fq-i64 (fql #5)))) ckt = true
