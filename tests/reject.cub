-- tests/reject.cub — the checker rejects: one ill-typed term per typing rule, each next to the
-- nearest term it accepts. Loaded after lib/std.cub.
data Two = t0 | t1
data Box (A : Type) = box (a : A)
-- application: a function, and an argument of its domain
#check (λ A f x → f x) : (A : Type) → (A → A) → A → A
#fail
#check (λ A x → x x) : (A : Type) → A → A
#fail
#check (λ A B f y → f y) : (A B : Type) → (A → A) → B → A
-- projections: of a Σ
#check (λ A p → fst p) : (A : Type) → A × A → A
#fail
#check (λ A p → fst p) : (A : Type) → A → A
#fail
#check (λ A B p → snd p) : (A B : Type) → A × B → A
-- the dependent second component is checked at the first's value
#check (true , unit) : (b : Bool) × (if b then Unit else Empty)
#fail
#check (false , unit) : (b : Bool) × (if b then Unit else Empty)
-- path application: to an interval, not a term
#check (λ A x p → p i0) : (A : Type) → (x : A) → x ≡ x → A
#fail
#check (λ A x p → p x) : (A : Type) → (x : A) → PathP (λ (i : I) → A) x x → A
-- interval terms and faces are made of dimensions
#fail
#check (λ A x p → p (~ x)) : (A : Type) → (x : A) → PathP (λ (i : I) → A) x x → A
#fail
#check (λ A x (i : I) → comp (λ (j : I) → A) (λ (j : I) → [ x = 0 ↦ x ]) x) : (A : Type) →
                                                                              (x : A) →
                                                                              PathP (λ (i : I) → A)
                                                                                x x
-- λ and pairs only at Π and Σ
#fail
#check (λ A x → x) : (A : Type) → A
#fail
#check (λ A → (A , A)) : (A : Type) → A → A
#fail
#check (λ A (i : I) → A) : Type → Type
-- the universe: (U l) at (U (lsuc l)), not at itself; a level is a Level
#check Type : Type 1
#fail
#check Type : Type
#fail
#check Type 1 : Type 1
#fail
#check (λ A → Type A) : Type → Type
#fail
#check (λ A → lsuc A) : Type → Level
-- Π and Σ: the domain is a type; a family over U lives one level up
#check ((x : Type) → x) : Type 1
#fail
#check ((x : Type) → x) : Type
#fail
#check (λ A a → a → A) : (A : Type) → A → Type
#fail
#check (λ A a → A × a) : (A : Type) → A → Type
-- PathP: the endpoints at the line's ends
#check (λ A x → x ≡ x) : (A : Type) → A → Type
#fail
#check (λ A B x y → PathP (λ (i : I) → A) x y) : (A B : Type) → A → B → Type
#fail
#check (λ A x → PathP (λ (i : I) → x) x x) : (A : Type) → A → Type
-- a line: its endpoints are the declared ones
#fail
#check (λ A x y (i : I) → x) : (A : Type) → (x y : A) → PathP (λ (i : I) → A) x y
-- systems: overlapping branches agree; branches at the type
#check (λ A x i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 0 ↦ x , i = 1 ↦ x ]) x) : (A : Type) →
                                                                                    (x : A) → x ≡ x
#fail
#check (λ A x y (i : I) →
          comp (λ (j : I) → A) (λ (j : I) → [ i = 0 ↦ x , i = 0 ↦ y , i = 1 ↦ x ]) x) : (A : Type) →
                                                                                        (x : A) →
                                                                                        A →
                                                                                        PathP
                                                                                          (λ (i : I) →
                                                                                             A) x x
#fail
#check (λ A B x b (i : I) → comp (λ (j : I) → A) (λ (j : I) → [ i = 0 ↦ b , i = 1 ↦ x ]) x) : (A B : Type) →
                                                                                              (x : A) →
                                                                                              B →
                                                                                              PathP
                                                                                                (λ (i : I) →
                                                                                                   A)
                                                                                                x x
-- there is no regularity: a composition along a constant line is not its base
#fail
#check (λ A x (i : I) → comp (λ (j : I) → A) (λ (j : I) → [ i = 0 ↦ x ]) x) : (A : Type) →
                                                                              (x : A) →
                                                                              PathP (λ (i : I) → A)
                                                                                x x
-- comp: the line is a line of types; the tube's faces do not depend on it
#fail
#check (λ A x → comp (λ (i : I) → x) (λ (i : I) → []) x) : (A : Type) → A → A
#fail
#check (λ A x → comp (λ (i : I) → A) (λ (i : I) → [ i = 0 ↦ x ]) x) : (A : Type) → A → A
-- Glue: the system gives types with equivalences into the base
#check (λ A → Glue A [ tt ↦ (A , idEquiv {lzero} {A}) ]) : Type → Type
#fail
#check (λ A B → Glue A [ tt ↦ (B , idEquiv {lzero} {A}) ]) : Type → Type → Type
#fail
#check (λ A a → Glue A [ tt ↦ (A , a) ]) : (A : Type) → A → Type
-- unglue of a Glue element only
#fail
#check (λ A a → unglue [ tt ↦ (A , idEquiv {lzero} {A}) ] a) : (A : Type) → A → A
-- annotation: the term at its declared type
#check (λ A a → the A a) : (A : Type) → A → A
#fail
#check (λ A B a → the B a) : (A : Type) → Type → A → A
-- let: the body at the let's value
#check (λ A a → let y = a in y) : (A : Type) → A → A
#fail
#check (λ A B a b → let y = b in y) : (A B : Type) → A → B → A
-- data types: parameters at their types, constructors' fields at theirs, of the right type
#check List Nat : Type
#fail
#check List zero : Type
#check box zero : Box Nat
#fail
#check box true : Box Nat
#fail
#check t0 : Box Nat
#fail
#check box zero : Nat
-- elimination: the motive over the data type, each branch at its constructor
#check (λ b → case b return (λ y → Nat) of true → zero; false → suc zero) : Bool → Nat
#fail
#check (λ b → case b return (λ y → Nat) of true → zero; false → true) : Bool → Nat
#fail
#check (λ b → case b return (λ y → Two) of true → t0; false → t1) : Bool → Nat
#fail
#check (λ b → case b return (λ y → Bool) of true → zero; false → zero) : Two → Nat
#fail
#check (λ b → case b return (λ y → Type) of true → Nat; false → Nat) : Bool → Nat
-- the induction hypothesis has the motive's type at the field
#check (λ n → case n of zero → zero; suc k → suc (rec k)) : Nat → Nat
#fail
#check (λ n → case n of zero → zero; suc k → (rec k , k)) : Nat → Nat
-- a case without a motive in a type: inferred from its branches
#check (λ b u → u) : (b : Bool) → (if b then Unit else Empty) → if b then Unit else Empty
#fail
#check (b : Bool) × (case b of true → Unit; false → zero) : Type
-- case: every branch at the type
#fail
#check (λ n → case n of zero → true; suc k → k) : Nat → Bool
-- a path constructor's branch agrees with the elimination of its boundary
data Circ = base | loop (i : I) [ i = 0 ↦ base , i = 1 ↦ base ]
#check (λ c → case c of base → true; loop i → true) : Circ → Bool
#fail
#check (λ c → case c of base → true; loop i → false) : Circ → Bool
-- data declarations: strictly positive, parameters uniform, boundaries of earlier constructors,
-- levels closed
#fail
data Neg2 = mk (f : (Neg2 → Bool) → Bool)
#fail
data Bad = bad (f : Bad → Nat)
#fail
data Bad2 = bad2 (p : (Bad2 → Nat) × Nat)
data Good = good (f : Nat → Good) (p : Good × (Nat → Good)) | gnil
#fail
data Nu (A : Type) = nu (a : A) (r : Nu Bool)
#fail
data Late = l1 (i : I) [ i = 0 ↦ l2 , i = 1 ↦ l2 ] | l2
data Lv (A : Type) = lv (a : Type 1)
#fail
data Lw (l : Level) = lw (a : Type l)
-- words
#check %wadd #2 #3 : Word
#fail
#check %wadd #2 true : Word
#fail
#check %wadd #2 #3 : Bool
#fail
#check %weq #2 #3 : Word
#fail
#check %wsucc zero : Word
#check (λ w → %welimP (λ v → Nat) w zero (λ n h → suc h)) : Word → Nat
#fail
#check (λ w → %welimP (λ v → Nat) w true (λ n h → suc h)) : Word → Nat
#fail
#check (λ w → %welimP (λ v → Nat) w zero (λ n h h → n)) : Word → Nat
#fail
#check (λ w → %welimP (λ v → Nat) w zero (λ n h → suc h)) : Word → Bool
-- equality: η holds for functions and pairs, nothing more
#check (λ A f i → f) : (A : Type) → (f : A → A) → f ≡ (λ x → f x)
#check (λ A p i → p) : (A : Type) → (p : A × A) → p ≡ (fst p , snd p)
#fail
#check (λ A p (i : I) → p) : (A : Type) → (p : A × A) → PathP (λ (i : I) → A × A) p (snd p , fst p)
#fail
#check (λ A x y (i : I) → x) : (A : Type) → (x y : A) → PathP (λ (i : I) → A) x y
#fail
#check (λ f (i : I) → f) : (f : Bool → Bool) → PathP (λ (i : I) → Bool → Bool) f (λ b → not (f b))
-- universes are not cumulative and do not contain themselves at any level
#fail
#check (Type → Nat) : Type
#fail
#check (λ l → Type l) : (l : Level) → Type l
#check (λ l → Type l) : (l : Level) → Type (lsuc l)
-- a program's names do not reach the checker: its constructors and entry points stay its own
data Mine = tlam | bx (a : Bool) | lcons | tx | ok
chk-def x y = false
idb : Bool → Bool
idb b = case b of true → false; false → true
data Pt = pt
#fail
#check (λ b → zero) : Bool → Bool
