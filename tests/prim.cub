-- prim.cub — primitive types (Int64, UInt32, Float64, Bytes), representations and layouts (plan B12)
-- over lib/prim.cub, and the first-order criterion (plan B13) over lib/stage.cub

-- ---------------------------------------------------------------- the operations compute
#same i64toWord (i64add (i64 #5) (i64 #7)) = #12
#same i64toWord (i64mul (i64 #6) (i64 #7)) = #42
#same i64lt (i64 #5) (i64 #7) = true
#same u32toWord (u32add (u32 #4294967295) (u32 #2)) = #1
#same f64lt (f64div (f64 #1) (f64 #4)) (f64 #1) = true
#same f64eq (f64add (f64 #1) (f64 #2)) (f64 #3) = true

-- ---------------------------------------------------------------- the byte layer: a store then a load at
-- a literal offset, with the proof that it fits; at a variable offset the proof is not there
r32 : UInt32
r32 = load32 16 (store32 16 (bytes 16) 12 (0 , λ i → 16) (u32 #258)) 12 (0 , λ i → 16)
#same u32toWord r32 = #258
#fail
r32bad : (off : Nat) → UInt32
r32bad off = load32 16 (bytes 16) off (0 , λ i → 16)

-- ---------------------------------------------------------------- layouts: automatic (a union of the
-- constructors' structs, a recursive field a pointer, a field at :0 omitted), and by representation
data Pt = pt (x : Word) (y : Word)
#layout Pt
data BVec = bvec (k : Nat) (v : Word) (bound :0 le k 4)
#layout BVec
#layout List
#layout Nat
#layout Nat as Word
#layout Bool
-- a type with path constructors has no automatic layout
data Circ = cb | cl (i : I) [ i = 0 ↦ cb , i = 1 ↦ cb ]
#layout Circ

-- ---------------------------------------------------------------- a set truncation represented by its
-- canonical form (plan B12 2.3): ∥Int∥₂ by Int; the laws are theorems, from-to by the dependent
-- elimination into a family of propositions (the hypotheses of the path-typed fields are lines)
data Tr2 (A : Type) = tr2 (a : A)
  | sq2 (x : Tr2 A) (y : Tr2 A) (p : PathP (λ (m : I) → Tr2 A) x y) (q : PathP (λ (m : I) → Tr2 A) x y) (i : I) (j : I)
      [ i = 0 ↦ p @ j , i = 1 ↦ q @ j , j = 0 ↦ x , j = 1 ↦ y ]
tr2rec : {A B : Type} → isSet B → (A → B) → Tr2 A → B
tr2rec s f x = case x return (λ w → B) of
    tr2 a → f a
    sq2 x1 y1 p q i j → s (rec x1) (rec y1) (rec p) (rec q) i j
isSetTr2 : {A : Type} → isSet (Tr2 A)
isSetTr2 = λ a b p q i j → sq2 a b p q i j
tr2toInt : Tr2 Int → Int
tr2toInt = tr2rec isSetInt (λ z → z)
P2 : Tr2 Int → Type
P2 y = tr2 (tr2toInt y) ≡ y
isPropP2 : (y : Tr2 Int) → isProp (P2 y)
isPropP2 y = isSetTr2 (tr2 (tr2toInt y)) y
-- the square over sq2 in the family of propositions P2, from its four sides
sqfill : (a b : Tr2 Int) (p q : a ≡ b) (ra : P2 a) (rb : P2 b) (rp : PathP (λ j → P2 (p j)) ra rb) (rq : PathP (λ j → P2 (q j)) ra rb) →
  PathP (λ i → PathP (λ j → P2 (sq2 a b p q i j)) ra rb) rp rq
sqfill a b p q ra rb rp rq =
  isProp→PathP {lzero} {PathP (λ j → P2 (p j)) ra rb} {PathP (λ j → P2 (q j)) ra rb} (λ i → PathP (λ j → P2 (sq2 a b p q i j)) ra rb)
    (isPropPathP (λ j → P2 (q j)) (isProp→isSet (isPropP2 b)) ra rb) rp rq
tr2-from-to : (x : Tr2 Int) → P2 x
tr2-from-to x = case x return (λ y → P2 y) of
    tr2 z → λ i → tr2 z
    sq2 a b p q i j → sqfill a b p q (rec a) (rec b) (rec p) (rec q) i j
-- the first-order criterion (plan B13, lib/stage.cub): a region over a set truncation is not
-- first-order (higher) until the truncation has a representation
#fo (the (Tr2 Int → Int) (λ x → tr2toInt x))
represent Tr2 by Int where
  to : Tr2 Int → Int = tr2toInt
  from : Int → Tr2 Int = tr2
  to-from : (z : Int) → to (from z) ≡ z = λ z → λ i → z
  from-to : (x : Tr2 Int) → from (to x) ≡ x = tr2-from-to
#layout Tr2
#fo (the (Tr2 Int → Int) (λ x → tr2toInt x))
-- ---------------------------------------------------------------- a quotient by canonical forms (plan B12
-- 2.3, item 12): ℤ as pairs of naturals modulo a + d ≡ c + b, a set quotient (the squash makes it a
-- set), represented by Int through the canonical-form maps: to sends a pair to its difference's
-- normal form, from an integer to its canonical pair (n , 0) or (0 , n + 1)
data ZQ = zq (a : Nat) (b : Nat)
  | zeq (a : Nat) (b : Nat) (c : Nat) (d : Nat) (e : PathP (λ (m : I) → Nat) (plus a d) (plus c b)) (i : I) [ i = 0 ↦ zq a b , i = 1 ↦ zq c d ]
  | zsq (x : ZQ) (y : ZQ) (p : PathP (λ (m : I) → ZQ) x y) (q : PathP (λ (m : I) → ZQ) x y) (i : I) (j : I)
      [ i = 0 ↦ p @ j , i = 1 ↦ q @ j , j = 0 ↦ x , j = 1 ↦ y ]
isSetZQ : isSet ZQ
isSetZQ = λ a b p q i j → zsq a b p q i j
-- the difference's normal form (split on the second argument first, so that subN n zero is pos n)
subN : Nat → Nat → Int
subN a b = (case b return (λ y → Nat → Int) of
    zero → λ x → pos x
    suc b2 → λ x → case x return (λ x2 → Int) of zero → negsuc b2; suc a2 → rec b2 a2) a
-- a common summand cancels
subN-cancel : (k a b : Nat) → subN (plus k a) (plus k b) ≡ subN a b
subN-cancel k a b = case k return (λ y → subN (plus y a) (plus y b) ≡ subN a b) of
    zero → λ i → subN a b
    suc k2 → rec k2
-- the normal form respects the relation
subN-resp : (a b c d : Nat) → plus a d ≡ plus c b → subN a b ≡ subN c d
subN-resp a b c d e =
  concat {lzero} {Int} {subN a b} {subN (plus d a) (plus d b)} {subN c d} (sym (subN-cancel d a b))
    (concat {lzero} {Int} {subN (plus d a) (plus d b)} {subN (plus a d) (plus d b)} {subN c d} (λ i → subN (plus-comm d a i) (plus d b))
      (concat {lzero} {Int} {subN (plus a d) (plus d b)} {subN (plus c b) (plus d b)} {subN c d} (λ i → subN (e i) (plus d b))
        (concat {lzero} {Int} {subN (plus c b) (plus d b)} {subN (plus b c) (plus b d)} {subN c d} (λ i → subN (plus-comm c b i) (plus-comm d b i)) (subN-cancel b c d))))
zqToInt : ZQ → Int
zqToInt x = case x return (λ w → Int) of
    zq a b → subN a b
    zeq a b c d e i → subN-resp a b c d e i
    zsq x1 y1 p q i j → isSetInt (rec x1) (rec y1) (rec p) (rec q) i j
intToZQ : Int → ZQ
intToZQ z = case z of pos n → zq n zero; negsuc n → zq zero (suc n)
-- every pair is related to its canonical pair
zq-canon : (a b : Nat) → intToZQ (subN a b) ≡ zq a b
zq-canon a b = (case b return (λ y → (x : Nat) → intToZQ (subN x y) ≡ zq x y) of
    zero → λ x → λ i → zq x zero
    suc b2 → λ x → case x return (λ x2 → intToZQ (subN x2 (suc b2)) ≡ zq x2 (suc b2)) of
        zero → λ i → zq zero (suc b2)
        suc a2 → concat {lzero} {ZQ} {intToZQ (subN a2 b2)} {zq a2 b2} {zq (suc a2) (suc b2)} (rec b2 a2)
                   (λ i → zeq a2 b2 (suc a2) (suc b2) (plus-suc a2 b2) i)) a
PZ : ZQ → Type
PZ y = intToZQ (zqToInt y) ≡ y
isPropPZ : (y : ZQ) → isProp (PZ y)
isPropPZ y = isSetZQ (intToZQ (zqToInt y)) y
zsqfill : (a b : ZQ) (p q : a ≡ b) (ra : PZ a) (rb : PZ b) (rp : PathP (λ j → PZ (p j)) ra rb) (rq : PathP (λ j → PZ (q j)) ra rb) →
  PathP (λ i → PathP (λ j → PZ (zsq a b p q i j)) ra rb) rp rq
zsqfill a b p q ra rb rp rq =
  isProp→PathP {lzero} {PathP (λ j → PZ (p j)) ra rb} {PathP (λ j → PZ (q j)) ra rb} (λ i → PathP (λ j → PZ (zsq a b p q i j)) ra rb)
    (isPropPathP (λ j → PZ (q j)) (isProp→isSet (isPropPZ b)) ra rb) rp rq
zq-from-to : (x : ZQ) → PZ x
zq-from-to x = case x return (λ y → PZ y) of
    zq a b → zq-canon a b
    zeq a b c d e i → isProp→PathP {lzero} {PZ (zq a b)} {PZ (zq c d)} (λ j → PZ (zeq a b c d e j)) (isPropPZ (zq c d)) (zq-canon a b) (zq-canon c d) i
    zsq a b p q i j → zsqfill a b p q (rec a) (rec b) (rec p) (rec q) i j
-- a region over the quotient is higher until it has a representation
#fo (the (ZQ → Int) (λ x → zqToInt x))
represent ZQ by Int where
  to : ZQ → Int = zqToInt
  from : Int → ZQ = intToZQ
  to-from : (z : Int) → to (from z) ≡ z = λ z → case z return (λ y → zqToInt (intToZQ y) ≡ y) of pos n → (λ i → pos n); negsuc n → (λ i → negsuc n)
  from-to : (x : ZQ) → from (to x) ≡ x = zq-from-to
#layout ZQ
#fo (the (ZQ → Int) (λ x → zqToInt x))
-- the canonical forms compute: (5 , 2) and (7 , 4) are one integer, 3
#same zqToInt (zq 5 2) = pos 3
#same zqToInt (zq 2 5) = negsuc 2
#same intToZQ (zqToInt (zq 7 4)) = zq 3 zero
#same zqToInt (zeq 5 2 7 4 (λ i → 9) i0) = pos 3
-- a wrong law is rejected at its type
#fail
represent Pt by Word where
  to : Pt → Word = λ p → case p of pt x y → x
  from : Word → Pt = λ w → pt w w
  to-from : (w : Word) → to (from w) ≡ w = λ w → λ i → w
  from-to : (p : Pt) → from (to p) ≡ p = λ p → λ i → p
-- ---------------------------------------------------------------- the trusted surface
#trusted

-- ---------------------------------------------------------------- the first-order criterion (plan B13)
-- plus on Nat (represented by Word) is first-order; a path is dim; a transport along ua is kan as
-- written and first-order once normalized (the specializer's step 2); a universe at the boundary is
-- higher; a word function is first-order
#fo plus
data C1 = cb | cl (i : I) [ i = 0 ↦ cb , i = 1 ↦ cb ]
cloop : PathP (λ (i : I) → C1) cb cb
cloop = λ i → cl i
#fo cloop
notnot : (b : Bool) → not (not b) ≡ b
notnot b = case b return (λ y → not (not y) ≡ y) of true → λ i → true; false → λ i → false
notEquiv : Equiv Bool Bool
notEquiv = isoToEquiv not not notnot notnot
trb : Bool
trb = transport (ua notEquiv) true
#same first-order Bool (code (comp (λ (i : I) → ua {lzero} {Bool} {Bool} notEquiv i) (λ (i : I) → []) true)) = not-fo kan (code (comp (λ (i : I) → ua {lzero} {Bool} {Bool} notEquiv i) (λ (i : I) → []) true))
#fo trb
#fo (the ((A : Type) → A → A) (λ A x → x))
#fo (the (C1 → Nat) (λ c → zero))
#fo (the (Word → Word) (λ w → wadd w #1))
-- a constructor applied to a field: its fields are read as a list (fo-list once read its tail as a code)
#fo (the (Nat → Nat) (λ a → suc a))
#fo (the (Nat → Int) (λ a → pos (suc a)))
#fo (the ((n :0 Nat) → Bytes n → Nat) (λ n b → n))
#fo (the ((n : Nat) → Bytes n → Nat) (λ n b → n))
-- ---------------------------------------------------------------- memory the program does not own (plan C20)
-- the bytes at the address of a byte string are its bytes
rt : Bytes 8
rt = region-at (ptr-of 8 (store64 8 (bytes 8) 0 (le-refl 8) (i64 #77))) 8
#same load64 8 rt 0 (le-refl 8) = i64 #77
-- #safe f: the trusted definitions f reaches, through its type and term
#safe plus
#safe rt
#safe toNat-plusw
safe-wrap : Int64 → Int64
safe-wrap a = i64add a (i64 #1)
#safe safe-wrap
#safe Tr2
-- ---------------------------------------------------------------- foreign functions (plan D27)
foreign labs "labs" : Int64 → Int64
#same labs (i64sub (i64 #0) (i64 #5)) = i64 #5
foreign sqrt "sqrt" : Float64 → Float64
#same sqrt (f64 #16) = f64 #4
foreign strlen "strlen" : (n :0 Nat) → Bytes n → Int64
#same strlen 8 (bytes 8) = i64 #0
#same strlen 8 (store64 8 (bytes 8) 0 (le-refl 8) (i64 #16705)) = i64 #2
#safe strlen
-- ---------------------------------------------------------------- arrays (plan C22), and stuck primitive operations
-- two stuck operations on the same variables are equal; on different ones not
#check (λ (a : Int64) (b : Int64) → λ (i : I) → i64add a b) : (a b : Int64) → i64add a b ≡ i64add a b
#fail
#check (λ (a : Int64) (b : Int64) → λ (i : I) → i64add a b) : (a b : Int64) → i64add a b ≡ i64add b a
#check (λ (n : Nat) (b : Bytes n) (h : le 8 n) → λ (i : I) → load64 n b 0 h) : (n : Nat) (b : Bytes n) (h : le 8 n) → load64 n b 0 h ≡ load64 n b 0 h
a3 : Array 3
a3 = tabulate 3 (λ i → i64 (fromNat (times i i)))
#same index 3 a3 2 (le-refl 3) = i64 #4
#same index 3 a3 1 (le-pred 1 3 (le-pred 2 3 (le-refl 3))) = i64 #1
#same index 3 (update 3 a3 0 (le-pred 0 3 (le-pred 1 3 (le-pred 2 3 (le-refl 3)))) (i64 #9)) 0 (le-zero 3) = i64 #9

-- a stuck primitive operation has a code (cprim): a definition over the byte layer quotes under an
-- unknown buffer, so the specializer can read it, and evaluating the code back is the same value
le8-16 : le 8 16
le8-16 = (8 , λ i → 16)
ld2 : (b : Bytes 16) → Int64
ld2 b = i64add (load64 16 b 0 le8-16) (load64 16 b 8 (le-refl 16))
#same (case quote-top (Bytes 16 → Int64) ld2 of some c → true; none → false) = true
#same eval-g lnil (fromopt (quote-top (Bytes 16 → Int64) ld2) cword) (store64 16 (store64 16 (bytes 16) 0 le8-16 (i64 #5)) 8 (le-refl 16) (i64 #7)) = i64 #12

-- ---------------------------------------------------------------- arrays over Fin n and their laws (plan C22)
sq : Fin 3 → Int64
sq p = i64 (fromNat (times (fst p) (fst p)))
f2 : Fin 3
f2 = (2 , le-refl 3)
f1 : Fin 3
f1 = (1 , le-pred 2 3 (le-refl 3))
#same aindex 3 (atab 3 sq) f2 = i64 #4
#same aindex 3 (atab 3 sq) f1 = i64 #1
-- the laws are checked terms; their readings compute: a read after a write elsewhere is the old value
#same index 3 (update 3 a3 2 (le-refl 3) (i64 #9)) 1 (snd f1) = i64 #1
#same index 3 (update 3 a3 1 (snd f1) (i64 #9)) 1 (snd f1) = i64 #9
rt-arr : (n : Nat) → (a : Array n) → atab n (aindex n a) ≡ a
rt-arr = λ n → tabulate-index n
eqv : Equiv (Fin 3 → Int64) (Array 3)
eqv = Fin→Array 3
#same aindex 3 (fst eqv sq) f1 = i64 #1
-- two dimensions, row-major: a 2×3 holding its own flat index, so row i column j holds 3i + j
m23 : Array2 2 3
m23 = atab 6 (λ p → i64 (fromNat (fst p)))
#same index2 2 3 m23 1 2 (le-refl 2) (le-refl 3) = i64 #5
#same index2 2 3 m23 0 1 (le-pred 1 2 (le-refl 2)) (snd f1) = i64 #1
#same index2 2 3 (update2 2 3 m23 1 0 (le-refl 2) (le-zero 3) (i64 #7)) 1 0 (le-refl 2) (le-zero 3) = i64 #7
