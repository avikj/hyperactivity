-- tests/guarded.cub — guarded recursion: later types ▸ κ A (functions from the ticks of a clock),
-- the delayed fixed point, total streams by clock quantification and forceκ. Loaded after
-- lib/std.cub, which has Stream, smap, Str, hd, tl, nth.
-- ---------------------------------------------------------------- recursion through functions
-- each definition calls itself only where a later value is expected; the elaborator makes it a
-- guarded fixed point and inserts the ticks
nats : Stream κ Nat
nats = 0 ∷ smap suc nats
zipWith : (A → B → C) → Stream κ A → Stream κ B → Stream κ C
zipWith f (a ∷ s) (b ∷ t) = f a b ∷ zipWith f s t
fibs : Stream κ Nat
fibs = 0 ∷ 1 ∷ zipWith plus fibs (stail fibs)
interleave : Stream κ A → ▸ κ (Stream κ A) → Stream κ A
interleave (h ∷ t) u = h ∷ interleave u t
evens-odds : Stream κ Nat
evens-odds = interleave (smap double nats) (smap (λ n → suc (double n)) nats)
  where
    double : Nat → Nat
    double n = plus n n
-- a stream from a seed
iterate : (A → A) → A → Stream κ A
iterate f a = a ∷ iterate f (f a)
-- ---------------------------------------------------------------- observing total streams
#same nth 5 (λ κ → nats {κ}) = 5
#same nth 10 (λ κ → fibs {κ}) = 55
#same nth 6 (λ κ → evens-odds {κ}) = 6
#same nth 3 (λ κ → iterate {κ} {Nat} (λ n → plus n n) 1) = 8
#same hd (tl (tl (λ κ → nats {κ}))) = 2
-- ---------------------------------------------------------------- continuations into a later type
-- a process with dependent responses: its continuation is a function into a later process (18.18);
-- bind and map by guarded recursion, the recursive call under the continuation's λ given its tick
GResp : Bool → Type
GResp b = if b then Nat else Bool
data GProc (κ : Clock) (A : Type) = gdone (a : A) | gissue (c : Bool) (k : GResp c → ▸ κ (GProc κ A))
gbind : GProc κ A → (A → GProc κ B) → GProc κ B
gbind (gdone a) f = f a
gbind (gissue c k) f = gissue c (λ r → gbind (k r) f)
gmap : (A → B) → GProc κ A → GProc κ B
gmap f (gdone a) = gdone (f a)
gmap f (gissue c k) = gissue c (λ r → gmap f (k r))
-- the tick λ written out
gmap2 : (A → B) → GProc κ A → GProc κ B
gmap2 f (gdone a) = gdone (f a)
gmap2 f (gissue c k) = gissue c (λ r → λ α → gmap2 f (k r α))
-- ---------------------------------------------------------------- the rules
-- written directly: the fixed point and the ticks
ones : Stream κ Nat
ones = fix (λ r → 1 ∷ λ α → r α)
#same nth 4 (λ κ → ones {κ}) = 1
-- next and ⊛: later values as an applicative
#check λ κ (f : ▸ κ (Nat → Nat)) (x : ▸ κ Nat) → f ⊛ x : (κ : Clock) → ▸ κ (Nat → Nat) → ▸ κ Nat → ▸ κ Nat
#check λ κ (x : Nat) → next {lzero} {κ} {Nat} x : (κ : Clock) → Nat → ▸ κ Nat
-- the fixed point's unfolding is a path one tick later
#check λ κ (f : ▸ κ Nat → Nat) → pfix {lzero} {κ} {Nat} f : (κ : Clock) → (f : ▸ κ Nat → Nat) → dfix {lzero} {κ} {Nat} f ≡ next {lzero} {κ} {Nat} (fix {lzero} {κ} {Nat} f)
-- a later value is not a value now
#fail
#check λ κ (x : ▸ κ Nat) → x : (κ : Clock) → ▸ κ Nat → Nat
-- the fixed point of a function that needs its argument now does not exist
#fail
#check λ κ → fix {lzero} {κ} {Nat} (λ r → r) : (κ : Clock) → Nat
-- timelessness: one tick is not two
#fail
#check λ κ (x : ▸ κ (▸ κ Nat)) → λ α → x α α : (κ : Clock) → ▸ κ (▸ κ Nat) → ▸ κ Nat
#check λ κ (x : ▸ κ (▸ κ Nat)) → λ α β → x α β : (κ : Clock) → ▸ κ (▸ κ Nat) → ▸ κ (▸ κ Nat)
-- a variable bound after the tick is not applied to it
#fail
#check λ κ → λ α (y : ▸ κ Nat) → y α : (κ : Clock) → ▸ κ (▸ κ Nat → Nat)
-- ticks are bound, never stored, returned, named by let, or written as ⋄
#fail
#check λ κ (α : Tick κ) → α : (κ : Clock) → Tick κ → Tick κ
#fail
#check λ κ (x : ▸ κ Nat) → λ α → let β = α in x β : (κ : Clock) → ▸ κ Nat → ▸ κ Nat
#fail
#check λ κ (x : ▸ κ Nat) → x ⋄ : (κ : Clock) → ▸ κ Nat → Nat
#fail
#check Tick κ0 : Type
#fail
#check Clock : Type
-- a definition that needs its own value now is not productive: rejected where the call stands
#fail
bad : Stream κ Nat
bad = smap suc bad
#fail
stuck : Stream κ Nat
stuck = shead stuck ∷ next stuck
-- transport along a line of stream types moves each later tail pointwise (a tick does not vary);
-- the elements read are numerals again (composition is generalized: no formal composition is left)
nats-tr : Str Nat
nats-tr κ = transport (λ i → Stream κ Nat) (nats {κ})
#same nth 3 nats-tr = 3
-- a typed reading of a later value: a function of a fresh tick
#show the (▸ κ0 Nat) (next 1)
-- ---------------------------------------------------------------- ticks written out
-- a recursive call under a tick λ written by hand is the fixed point's later self at that tick
ones' : Stream κ Nat
ones' = 1 ∷ λ α → ones'
#same nth 4 (λ κ → ones' {κ}) = 1
fromS : Nat → Stream κ Nat
fromS n = n ∷ λ α → fromS (suc n)
#same nth 4 (λ κ → fromS {κ} 2) = 6
-- an interval variable bound after a tick may stand in what is applied to it: the interval does
-- not vary in time (a path of later values is a later path, and back)
#check λ κ (x y : ▸ κ Nat) (p : x ≡ y) → λ α (i : I) → p i α : (κ : Clock) → (x y : ▸ κ Nat) → x ≡ y → (α : Tick κ) → x α ≡ y α
#check λ κ (x y : ▸ κ Nat) (p : (α : Tick κ) → x α ≡ y α) → λ (i : I) α → p α i : (κ : Clock) → (x y : ▸ κ Nat) → ((α : Tick κ) → x α ≡ y α) → x ≡ y
-- ---------------------------------------------------------------- pfix computes at ⋄
-- at ⋄ both ends of pfix f are fix f, and so is every point between
#same (λ (i : I) → pfix {lzero} {κ0} {Nat} (λ r → 1) i ⋄) = λ (i : I) → 1
-- a guarded recursive type: a fixed point in the universe (level polymorphism: fix at Type), unfolded
-- and folded by transport along pfix
GF : ▸ κ Type → Type
GF X = Nat × ((α : Tick κ) → X α)
G : Clock → Type
G κ = fix {lsuc lzero} {κ} {Type} (GF {κ})
unfoldG : G κ → Nat × ▸ κ (G κ)
unfoldG {κ} g = transport (λ i → GF {κ} (pfix {lsuc lzero} {κ} {Type} (GF {κ}) i)) g
foldG : Nat × ▸ κ (G κ) → G κ
foldG {κ} p = transport (λ i → GF {κ} (pfix {lsuc lzero} {κ} {Type} (GF {κ}) (~ i))) p
-- its elements by guarded recursion (the later component of the pair gets its tick)
fromG : Nat → G κ
fromG n = foldG (n , fromG (suc n))
hdG : ((κ : Clock) → G κ) → Nat
hdG g = fst (unfoldG {κ0} (g κ0))
tlG : ((κ : Clock) → G κ) → (κ : Clock) → G κ
tlG g = forceκ {lzero} {G} (λ κ → snd (unfoldG {κ} (g κ)))
-- read through forceκ: the transports along pfix at ⋄ are along constant lines, and the numerals
-- come back canonical
#same hdG (λ κ → fromG {κ} 5) = 5
#same hdG (tlG (tlG (λ κ → fromG {κ} 5))) = 7
-- a stream of types: the guarded type's later part at a tick is a type
#check λ κ (g : G κ) → snd (unfoldG {κ} g) : (κ : Clock) → G κ → ▸ κ (G κ)
