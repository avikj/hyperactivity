-- qp-num: U1's definitions (from tests/foproofu-progs.cub)
qp-num-uks : List Word
qp-num-uks = nil
qp-num-udf : Word → Bool
qp-num-udf g = kmemu g qp-num-uks
qp-num-uAN : Word → Nat
qp-num-uAN g = if wlt g dcbase then dnat (qp-num-A g) else (if wlt g dclbase then suc (qp-num-D (wsub g dcbase)) else dnat (qp-num-A g))
qp-num-MK : Kd
qp-num-MK = (kcons (kw) knil)
qp-num-S : KS
qp-num-S = kinfer (q-ft (fr-tab (fst std-frule) qp-num-T) (fr-tab (fst std-frule) qp-num-GT) qp-num-D qp-num-A) qp-num-uks qp-num-uAN (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-num-m))) qp-num-MK
-- qp-num: the unboxed C link
qp-num-GU : Word → CU
qp-num-GU g = fq-to-cu-def qp-num-S g (qp-num-uAN g) ((q-ft (fr-tab (fst std-frule) qp-num-T) (fr-tab (fst std-frule) qp-num-GT) qp-num-D qp-num-A) g)
qp-num-GCb : Word → CA
qp-num-GCb g = fq-to-ca ((q-ft (fr-tab (fst std-frule) qp-num-T) (fr-tab (fst std-frule) qp-num-GT) qp-num-D qp-num-A) g) ckt (qp-num-uAN g)
qp-num-cks : List Word
qp-num-cks = nil
qp-num-dc : Word → Bool
qp-num-dc g = kmemu g qp-num-cks
qp-num-hdf : (g : Word) → qp-num-dc g ≡ true → qp-num-udf g ≡ true
qp-num-hdf = ukeys-ok (λ x → kmemu x qp-num-uks) qp-num-cks (λ i → true)
qp-num-hsk : (g : Word) → qp-num-dc g ≡ true → ks-SK qp-num-S g ≡ kanys (qp-num-uAN g)
qp-num-hsk g h = kanysb-ok (ks-SK qp-num-S g) (qp-num-uAN g) (ukeys-ok (λ x → kanysb (ks-SK qp-num-S x) (qp-num-uAN x)) qp-num-cks (λ i → true) g h)
