-- it (a limit hit or refined), in every refining scope whose values have the arguments' kinds
qp-calls-upath : (n : Nat) (x1 : DV) (v1 : KQ) (m : Nat) (s : CS) (su : MSt) → qa-ok qp-calls-D qp-calls-T (qa1 x1 v1 qa0) → Corr qp-calls-uAN qp-calls-udf 1 (kqcons v1 kqnil) s → UCorr qp-calls-uAN qp-calls-dc 1 (kqcons v1 kqnil) su → EnvK (ks-T qp-calls-S) (kpush qp-calls-MK (λ n → ka)) (kqcons v1 kqnil)
  → qrel qp-calls-D (derase (dsev qp-calls-G n qp-calls-m (qa-ρ (qa1 x1 v1 qa0)))) (evq (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kqcons v1 kqnil)) × (CRC qp-calls-uAN qp-calls-udf (evq (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kqcons v1 kqnil)) (evc qp-calls-GCb qp-calls-uAN qp-calls-udf (fr-addn n m) (fq-to-ca (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt 1) (c2ms s)) × UR qp-calls-uAN qp-calls-dc (evq (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kqcons v1 kqnil)) (evcu qp-calls-GU qp-calls-uAN qp-calls-dc (fr-addn n m) (fq-to-cu qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (λ i → ct-of (ksyn qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) kmt (kpush qp-calls-MK (λ n → ka))))) su))
qp-calls-upath n x1 v1 m s su ha hc hu he =
  (q-path-n std-frule qp-calls-G qp-calls-T qp-calls-GT qp-calls-gok qp-calls-D qp-calls-A qp-calls-gq n qp-calls-m (qa1 x1 v1 qa0) m (dtok-auto qp-calls-T qp-calls-m (λ j → true)) ha (λ j → true) ,
   (cm-sound-t qp-calls-uAN qp-calls-udf qp-calls-udf (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) qp-calls-GCb (λ g h → h) qp-calls-ctok (λ g h → λ i → qp-calls-GCb g) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) 1 (kqcons v1 kqnil) s (λ i → true) hc ,
    cu-sound-k qp-calls-S qp-calls-uAN qp-calls-udf qp-calls-dc qp-calls-dc (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) qp-calls-GU (λ g h → h) qp-calls-hdf qp-calls-hsk qp-calls-utok qp-calls-utk qp-calls-utl (λ g h → λ i → qp-calls-GU g) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (kqcons v1 kqnil) su (λ i → true) (λ i → true) hu he))
-- at a word: when the first-order form answers w, the boxed and the unboxed C each answer w or hit a limit
qp-calls-uword : (n : Nat) (x1 : DV) (v1 : KQ) (m : Nat) (s : CS) (su : MSt) (w : Word) → qa-ok qp-calls-D qp-calls-T (qa1 x1 v1 qa0) → Corr qp-calls-uAN qp-calls-udf 1 (kqcons v1 kqnil) s → UCorr qp-calls-uAN qp-calls-dc 1 (kqcons v1 kqnil) su → EnvK (ks-T qp-calls-S) (kpush qp-calls-MK (λ n → ka)) (kqcons v1 kqnil)
  → (evq (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kqcons v1 kqnil)) ≡ kqw w → Sum (haslim (evc qp-calls-GCb qp-calls-uAN qp-calls-udf (fr-addn n m) (fq-to-ca (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt 1) (c2ms s)) ≡ true) ((evc qp-calls-GCb qp-calls-uAN qp-calls-udf (fr-addn n m) (fq-to-ca (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt 1) (c2ms s)) ≡ mw w) × Sum (haslim (evcu qp-calls-GU qp-calls-uAN qp-calls-dc (fr-addn n m) (fq-to-cu qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (λ i → ct-of (ksyn qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) kmt (kpush qp-calls-MK (λ n → ka))))) su) ≡ true) ((evcu qp-calls-GU qp-calls-uAN qp-calls-dc (fr-addn n m) (fq-to-cu qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (λ i → ct-of (ksyn qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) kmt (kpush qp-calls-MK (λ n → ka))))) su) ≡ mw w)
qp-calls-uword n x1 v1 m s su w ha hc hu he hw =
  cu-agree qp-calls-uAN qp-calls-udf qp-calls-dc w (evc qp-calls-GCb qp-calls-uAN qp-calls-udf (fr-addn n m) (fq-to-ca (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt 1) (c2ms s)) (evcu qp-calls-GU qp-calls-uAN qp-calls-dc (fr-addn n m) (fq-to-cu qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (λ i → ct-of (ksyn qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) kmt (kpush qp-calls-MK (λ n → ka))))) su) (subst {lzero} {lzero} {KQ} {λ v → CRC qp-calls-uAN qp-calls-udf v (evc qp-calls-GCb qp-calls-uAN qp-calls-udf (fr-addn n m) (fq-to-ca (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt 1) (c2ms s))} {(evq (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kqcons v1 kqnil))} {kqw w} hw (fst (snd (qp-calls-upath n x1 v1 m s su ha hc hu he))))
    (subst {lzero} {lzero} {KQ} {λ v → UR qp-calls-uAN qp-calls-dc v (evcu qp-calls-GU qp-calls-uAN qp-calls-dc (fr-addn n m) (fq-to-cu qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (λ i → ct-of (ksyn qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) kmt (kpush qp-calls-MK (λ n → ka))))) su)} {(evq (q-ft (fr-tab (fst std-frule) qp-calls-T) (fr-tab (fst std-frule) qp-calls-GT) qp-calls-D qp-calls-A) (fr-addn n m) (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) (kqcons v1 kqnil))} {kqw w} hw (snd (snd (qp-calls-upath n x1 v1 m s su ha hc hu he))))
#same obs-u (evcu qp-calls-GU qp-calls-uAN qp-calls-dc (dnat #64) (fq-to-cu qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) ckt (kpush qp-calls-MK (λ n → ka)) (λ l → ct-of (knth qp-calls-MK l)) 1 (λ i → ct-of (ksyn qp-calls-S (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-calls-m))) kmt (kpush qp-calls-MK (λ n → ka))))) (ms-push (evcu qp-calls-GU qp-calls-uAN qp-calls-dc (dnat #64) (fq-to-cu qp-calls-S (fo-args-fq (lcons (flit #4) lnil)) ckl (λ n → ka) (λ l → ctb) zero (λ i → ctb)) msnil) zero msnil)) = some #9
qp-calls-uds = (cu-harness (fo-args-fq (lcons (flit #4) lnil)) (dc-prog-defs-q (fromopt (dc-prog dq-c8) dc-dflt)))
qp-calls-utr = cu-tr qp-calls-uds
#same cu-tg qp-calls-utr #865 = qp-calls-GU #865
#same cu-tg qp-calls-utr #864 = qp-calls-GU #864
-- qp-bytes: U1's definitions (from tests/foproofu-progs.cub)
qp-bytes-uks : List Word
qp-bytes-uks = nil
qp-bytes-udf : Word → Bool
qp-bytes-udf g = kmemu g qp-bytes-uks
qp-bytes-uAN : Word → Nat
qp-bytes-uAN g = if wlt g dcbase then dnat (qp-bytes-A g) else (if wlt g dclbase then suc (qp-bytes-D (wsub g dcbase)) else dnat (qp-bytes-A g))
qp-bytes-MK : Kd
qp-bytes-MK = (kcons (kw) knil)
qp-bytes-S : KS
qp-bytes-S = kinfer (q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) qp-bytes-uks qp-bytes-uAN (fc-to-fq 1 (fr-bu (fst std-frule) (dconv qp-bytes-m))) qp-bytes-MK
-- qp-bytes: the unboxed C link
qp-bytes-GU : Word → CU
qp-bytes-GU g = fq-to-cu-def qp-bytes-S g (qp-bytes-uAN g) ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g)
qp-bytes-GCb : Word → CA
qp-bytes-GCb g = fq-to-ca ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) ckt (qp-bytes-uAN g)
qp-bytes-cks : List Word
qp-bytes-cks = nil
qp-bytes-dc : Word → Bool
qp-bytes-dc g = kmemu g qp-bytes-cks
qp-bytes-hdf : (g : Word) → qp-bytes-dc g ≡ true → qp-bytes-udf g ≡ true
qp-bytes-hdf = ukeys-ok (λ x → kmemu x qp-bytes-uks) qp-bytes-cks (λ i → true)
qp-bytes-hsk : (g : Word) → qp-bytes-dc g ≡ true → ks-SK qp-bytes-S g ≡ kanys (qp-bytes-uAN g)
qp-bytes-hsk g h = kanysb-ok (ks-SK qp-bytes-S g) (qp-bytes-uAN g) (ukeys-ok (λ x → kanysb (ks-SK qp-bytes-S x) (qp-bytes-uAN x)) qp-bytes-cks (λ i → true) g h)
qp-bytes-kko : kkeys-ok qp-bytes-S qp-bytes-udf (q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) qp-bytes-uks ≡ true
qp-bytes-kko = λ i → true
qp-bytes-utok : (g : Word) → qp-bytes-udf g ≡ true → uok qp-bytes-uAN qp-bytes-udf qp-bytes-dc ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) ckt ≡ true
qp-bytes-utok = ukeys-ok (λ g → uok qp-bytes-uAN qp-bytes-udf qp-bytes-dc ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) ckt) qp-bytes-uks (λ i → true)
qp-bytes-ctok : (g : Word) → qp-bytes-udf g ≡ true → ca-ok qp-bytes-uAN qp-bytes-udf ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) ckt ≡ true
qp-bytes-ctok = ukeys-ok (λ g → ca-ok qp-bytes-uAN qp-bytes-udf ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) ckt) qp-bytes-uks (λ i → true)
qp-bytes-utk : (g : Word) → qp-bytes-udf g ≡ true → (kok qp-bytes-S qp-bytes-udf ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) kmt (spk qp-bytes-S g)) ≡ true
qp-bytes-utk g h = andl (kok qp-bytes-S qp-bytes-udf ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) kmt (spk qp-bytes-S g)) (kle (ksyn qp-bytes-S ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) kmt (spk qp-bytes-S g)) (ks-SR qp-bytes-S g)) (kkeys-ok-k qp-bytes-S qp-bytes-udf (q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) qp-bytes-uks qp-bytes-kko g h)
qp-bytes-utl : (g : Word) → qp-bytes-udf g ≡ true → (kle (ksyn qp-bytes-S ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) kmt (spk qp-bytes-S g)) (ks-SR qp-bytes-S g)) ≡ true
qp-bytes-utl g h = andr (kok qp-bytes-S qp-bytes-udf ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) kmt (spk qp-bytes-S g)) (kle (ksyn qp-bytes-S ((q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) g) kmt (spk qp-bytes-S g)) (ks-SR qp-bytes-S g)) (kkeys-ok-k qp-bytes-S qp-bytes-udf (q-ft (fr-tab (fst std-frule) qp-bytes-T) (fr-tab (fst std-frule) qp-bytes-GT) qp-bytes-D qp-bytes-A) qp-bytes-uks qp-bytes-kko g h)
