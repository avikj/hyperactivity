-- tests/check.cub — the type checker (a term, lib/check.cub) on codes of terms.
idf : {A : Type} → A → A
idf x = x
refl : {A : Type} {x : A} → PathP (λ i → A) x x
refl = λ i → x
#fail
#check (λ A x y i → x) : (A : Type) → (x y : A) → PathP (λ i → A) x y
#fail
#check (λ A x → A) : (A : Type) → A → A
sym : {A : Type} {x y : A} → PathP (λ i → A) x y → PathP (λ i → A) y x
sym p = λ i → p (~ i)
funext : {A B : Type} {f g : A → B} →
                      ((x : A) → PathP (λ i → B) (f x) (g x)) → PathP (λ i → A → B) f g
funext h = λ i x → h x i
#check (λ A x y p → idf p) : (A : Type) → (x y : A) → PathP (λ i → A) x y → PathP (λ i → A) x y
transport : {A B : Type} → PathP (λ i → Type) A B → A → B
transport p a = comp (λ i → p i) (λ i → []) a
#fail
#check (λ A B p a → comp (λ i → p i) (λ i → []) a) : (A B : Type) → PathP (λ i → Type) A B → A → A
-- composition of paths by hcomp, with a tube on both ends of the square
concat : {A : Type} {x y z : A} → PathP (λ i → A) x y → PathP (λ i → A) y z → PathP (λ i → A) x z
concat p q = λ i → comp (λ j → A) (λ j → [ i = 0 ↦ x , i = 1 ↦ q j ]) (p i)
-- a tube that does not agree with the base is rejected
#fail
#check (λ A x y z p q i → comp (λ j → A) (λ j → [ i = 0 ↦ z , i = 1 ↦ q j ]) (p i)) : (A : Type) →
                                                                                      (x y z : A) →
                                                                                      PathP
                                                                                        (λ i → A) x
                                                                                        y →
                                                                                      PathP
                                                                                        (λ i → A) y
                                                                                        z →
                                                                                      PathP
                                                                                        (λ i → A) x
                                                                                        z
-- equivalences and univalence through the Glue rule
Contr : Type → Type
Contr X = (c : X) × ((x : X) → PathP (λ i → X) c x)
fib : {X Y : Type} → (X → Y) → Y → Type
fib f y = (x : X) × PathP (λ i → Y) (f x) y
Equiv : Type → Type → Type
Equiv X Y = (f : X → Y) × ((y : Y) → Contr (fib f y))
idequiv : {X : Type} → Equiv X X
idequiv = (λ x → x , λ y → ((y , λ i → y) , λ z i → (snd z (~ i) , λ j → snd z (~ i \/ j))))
ua : {A B : Type} → Equiv A B → PathP (λ i → Type) A B
ua e = λ i → Glue B [ i = 0 ↦ (A , e) , i = 1 ↦ (B , idequiv {B}) ]
#fail
#check (λ A B e i → Glue B [ i = 1 ↦ (A , e) , i = 0 ↦ (B , idequiv {B}) ]) : (A B : Type) →
                                                                              Equiv A B →
                                                                              PathP (λ i → Type) A
                                                                                B
-- a checked definition also runs on the machine
postulate T0 t0
#same idf {T0} t0 = t0
-- data types, checked: declarations, constructors, elimination, hcomp
data B = bt | bf
bnot : B → B
bnot x = case x of bt → bf; bf → bt
bnot2 : B → B
bnot2 x = case x return (λ y → B) of bt → bf; bf → bt
#fail
#check (λ x → case x of bt → bf; bf → λ y → y) : B → B
data N2 = z2 | s2 (n : N2)
one : N2
one = s2 z2
#fail
#check s2 bt : N2
-- recursion is elimination with induction hypotheses: (rec k) has type P k
add2 : N2 → N2 → N2
add2 m n = case m of z2 → n; s2 k → s2 (rec k)
#same add2 (s2 z2) (s2 z2) = s2 (s2 z2)
add2-zero : (n : N2) → PathP (λ i → N2) (add2 n z2) n
add2-zero n =
  case n return (λ y → PathP (λ i → N2) (add2 y z2) y) of z2 → λ i → z2; s2 k → λ i → s2 (rec k i)
#fail
#check (λ n → case n return (λ y → PathP (λ i → N2) (add2 y z2) y) of z2 → λ i → z2; s2 k → rec k) : (n : N2) →
                                                                                                     PathP
                                                                                                       (λ i →
                                                                                                          N2)
                                                                                                       (add2
                                                                                                          n
                                                                                                          z2)
                                                                                                       n
#fail
#check (λ m → case m of z2 → bt; s2 k → s2 (rec k)) : N2 → B
-- fields recursive under Π codomains and Σ components (18.18): the hypothesis of a function-typed
-- field is a function to the motive, (rec k) x; of a pair, at its recursive components (both: a
-- pair of hypotheses); structural recursion writes f (k x), f (snd c x), f (fst p)
data Tree = leaf | node (k : N2 → Tree)
tsize : Tree → N2
tsize t = case t of leaf → z2; node k → s2 (rec k z2)
#same tsize (node (λ n → node (λ m → leaf))) = s2 (s2 z2)
tsize2 : Tree → N2
tsize2 leaf = z2
tsize2 (node k) = s2 (tsize2 (k z2))
#same tsize2 (node (λ n → case n of z2 → leaf; s2 m → node (λ q → leaf))) = s2 z2
data Rose = rose (c : B × (B → Rose)) | rleaf
rsize : Rose → N2
rsize r = case r of rleaf → z2; rose c → s2 (rec c bt)
#same rsize (rose (bt , λ b → rose (bf , λ c → rleaf))) = s2 (s2 z2)
rsize2 : Rose → N2
rsize2 rleaf = z2
rsize2 (rose c) = s2 (rsize2 (snd c bt))
#same rsize2 (rose (bt , λ b → rose (bf , λ c → rleaf))) = s2 (s2 z2)
data Both = both (p : Both × (B → Both)) | bleaf
bsize : Both → N2
bsize r = case r of bleaf → z2; both p → s2 (add2 (fst (rec p)) (snd (rec p) bt))
#same bsize (both (both (bleaf , λ b → bleaf) , λ b → both (bleaf , λ c → bleaf))) = s2 (s2 (s2 z2))
bsize2 : Both → N2
bsize2 bleaf = z2
bsize2 (both p) = s2 (add2 (bsize2 (fst p)) (bsize2 (snd p bt)))
#same bsize2 (both (both (bleaf , λ b → bleaf) , λ b → both (bleaf , λ c → bleaf))) = s2 (s2 (s2 z2))
-- dependent elimination: the motive varies with the scrutinee
bdep : (x : B) → case x return (λ y → Type) of bt → B; bf → N2
bdep x = case x return (λ y → case y return (λ z → Type) of bt → B; bf → N2) of bt → bf; bf → z2
-- the circle: a path constructor, elimination with its loop branch
data C1 = cb | cl (i : I) [ i = 0 ↦ cb , i = 1 ↦ cb ]
cloop : PathP (λ i → C1) cb cb
cloop = λ i → cl i
cflip : C1 → C1
cflip x = case x return (λ y → C1) of cb → cb; cl i → cl (~ i)
-- a loop branch must agree with the eliminated boundary
#check (λ x → case x of cb → bt; cl i → bt) : C1 → B
#fail
#check (λ x → case x of cb → bt; cl i → bf) : C1 → B
#check (λ x → case x return (λ y → C1) of cb → cb; cl i → cl (i /\ ~ i)) : C1 → C1
#fail
#check (λ x → case x return (λ y → C1) of cb → hcompD (λ j → []) cb; cl i → cl i) : C1 → C1
-- formal hcomp in a data type, and elimination on it
#check hcompD (λ j → []) cb : C1
#check (λ i → hcompD (λ j → []) cb) : PathP (λ i → C1) (hcompD (λ j → []) cb) (hcompD (λ j → []) cb)
-- elimination on it composes in the motive: with an empty tube, a transport (generalized
-- composition), so the formal hcomp is gone
#check (λ i → cb) : PathP (λ i → C1) (cflip (hcompD (λ j → []) cb)) cb
-- in a type without path constructors a formal composition is a value only where its tube
-- covers every closed point (so every closed instance reduces)
#fail
#check hcompD (λ j → []) z2 : N2
#check λ (i : I) → hcompD (λ j → [ i = 0 ↦ z2 , i = 1 ↦ z2 ]) z2 : PathP (λ i → N2) z2 z2
#fail
#check hcompD (λ j → [ j = 0 ↦ cb ]) cb : C1
-- an inductive family generated by rules, from a uniform data type and recursion into U:
-- Trace S St n s t (n steps of St from s to t) is a list of states with its validity
data Ls (S : Type) = lnl | lcs (u : S) (r : Ls S)
lenl : {S : Type} → Ls S → N2
lenl l = case l of lnl → z2; lcs u r → s2 (rec r)
valid : {S : Type} → (S → S → Type) → Ls S → N2 → S → S → Type
valid St l n s t =
  (case l return (λ y → N2 → S → S → Type) of
     lnl → λ n s t → PathP (λ i → N2) n z2 × PathP (λ i → S) s t
     lcs u r → λ n s t → (m : N2) × PathP (λ i → N2) n (s2 m) × St s u × rec r m u t) n s t
Trace : {S : Type} → (S → S → Type) → N2 → S → S → Type
Trace St n s t = (l : Ls S) × valid St l n s t
done : {S : Type} → (St : S → S → Type) → {s : S} → Trace St z2 s s
done St = (lnl , λ i → z2 , λ i → s)
step : {S : Type} {St : S → S → Type} {m : N2} {s u t : S} →
                                               St s u → Trace St m u t → Trace St (s2 m) s t
step st tr = (lcs u (fst tr) , m , λ i → s2 m , st , snd tr)
-- elimination of the family by recursion on the derivation: a trace's length is its index
trace-length : {S : Type} {St : S → S → Type} {l : Ls S} {n : N2} {s t : S} →
                                                                  valid St l n s t →
                                                                  PathP (λ i → N2) (lenl l) n
trace-length v =
  (case l return (λ y → (n : N2) → (s t : S) → valid St y n s t → PathP (λ i → N2) (lenl y) n) of
     lnl → λ n s t v i → fst v (~ i)
     lcs u r → 
       λ n s t v →
         concat {N2} {s2 (lenl r)} {s2 (fst v)} {n}
           (λ i → s2 (rec r (fst v) u t (snd (snd (snd v))) i)) (λ i → fst (snd v) (~ i))) n s t v
#fail
#check (λ S St l →
          case l return (λ y →
                           (n : N2) →
                           (s t : S) → valid {S} St y n s t → PathP (λ i → N2) (lenl {S} y) n) of
            lnl → λ n s t v i → fst v (~ i)
            lcs u r → λ n s t v i → s2 (rec r (fst v) u t (snd (snd (snd v))) i)) : (S : Type) →
                                                                                    (St : S →
                                                                                          S → Type) →
                                                                                    (l : Ls S) →
                                                                                    (n : N2) →
                                                                                    (s t : S) →
                                                                                    valid {S} St l
                                                                                      n s t →
                                                                                    PathP
                                                                                      (λ i → N2)
                                                                                      (lenl {S} l)
                                                                                      n
-- a recursive path constructor: its branch agrees on the boundary with the hypotheses
data Tr (T : Type) = tin (t : T) | tsq (x : Tr T) (y : Tr T) (i : I) [ i = 0 ↦ x , i = 1 ↦ y ]
trmap : {A C : Type} → (A → C) → Tr A → Tr C
trmap f t = case t of tin a → tin (f a); tsq x y i → tsq (rec x) (rec y) i
#fail
#check (λ A C f t → case t of tin a → tin (f a); tsq x y i → tsq (rec y) (rec x) i) : (A C : Type) →
                                                                                      (A → C) →
                                                                                      Tr A → Tr C
-- a parameterized higher inductive type
data Su (T : Type) = sn | ss | sm (t : T) (i : I) [ i = 0 ↦ sn , i = 1 ↦ ss ]
meridian : {T : Type} → T → PathP (λ i → Su T) sn ss
meridian t = λ i → sm t i
#check (λ T t → comp (λ i → Su T) (λ i → []) (sm t i0)) : (T : Type) → T → Su T
-- strict positivity, and boundaries made of earlier constructors
#fail
data Neg = mk (f : Neg → B)
-- a path in the type itself, of any dimension, is a map from the interval into it: positive (the
-- set truncation; a square of such paths for the groupoid truncation's argument)
data St (T : Type) = sti (t : T)
  | sts (x : St T) (y : St T) (p : PathP (λ (m : I) → St T) x y) (q : PathP (λ (m : I) → St T) x y) (i : I) (j : I)
      [ i = 0 ↦ p @ j , i = 1 ↦ q @ j , j = 0 ↦ x , j = 1 ↦ y ]
data Gt (T : Type) = gti (t : T)
  | gts (x : Gt T) (y : Gt T) (p : PathP (λ (m : I) → Gt T) x y) (q : PathP (λ (m : I) → Gt T) x y)
      (r : PathP (λ (m : I) → PathP (λ (n : I) → Gt T) x y) p q) (s : PathP (λ (m : I) → PathP (λ (n : I) → Gt T) x y) p q)
      (i : I) (j : I) (k : I)
      [ i = 0 ↦ r @ j @ k , i = 1 ↦ s @ j @ k , j = 0 ↦ p @ k , j = 1 ↦ q @ k , k = 0 ↦ x , k = 1 ↦ y ]
-- but a path of functions out of the type is not
#fail
data NegP = mkp (f : PathP (λ (m : I) → NegP → B) (λ x → bt) (λ x → bt))
#fail
data Ov = o1 | o2 | ov (i : I) [ i = 0 ↦ o1 , i = 0 ↦ o2 ]
-- the evaluator over codes of data
#same eval-g t0 (code (s2 (s2 z2))) = s2 (s2 z2)
#same eval-g t0 (code (case cl i1 return (λ y → C1) of cb → cb; cl i → cl (~ i))) = cb
-- universe levels: one definition at every level
pidf : {l : Level} {A : Type l} → A → A
pidf x = x
#check (λ A x → pidf x) : (A : Type) → A → A
#check (λ A x → pidf x) : (A : Type 1) → A → A
#fail
#check (λ A x → pidf {lzero} {A} x) : (A : Type 1) → A → A
pconst : {l m : Level} {A : Type l} {B : Type m} → A → B → A
pconst a b = a
#check (λ l A → Type l) : (l : Level) → Type l → Type (lsuc l)
lmaxc : {l m : Level} → Type l → Type m → Type (lmax l m)
lmaxc A B = A → B
-- levels are equal as joins: max l m = max m (max l l)
#check (λ l m A → A) : (l m : Level) → Type (lmax l m) → Type (lmax m (lmax l l))
#check (λ l A → A) : (l : Level) → Type (lmax l lzero) → Type l
#check (λ l A → A) : (l : Level) → Type (lsuc (lmax l l)) → Type (lmax (lsuc l) (lsuc lzero))
#fail
#check (λ l m A → A) : (l m : Level) → Type (lmax l m) → Type (lsuc l)
#fail
#check (λ l A → A) : (l : Level) → Type (lsuc l) → Type l
#fail
#check (λ l A → Type l) : (l : Level) → Type l → Type l
pId : {l : Level} {A : Type l} → A → A → Type l
pId x y = PathP (λ i → A) x y
prefl : {l : Level} {A : Type l} {x : A} → pId x x
prefl = λ i → x
#fail
#check (Level → Type) : Type
#fail
data Bx (l : Level) (A : Type l) = bx (a : A)
-- a level-polymorphic definition runs on the machine, which carries levels and ignores them
#same pidf {lzero} {T0} t0 = t0
#same eval-g t0 (code (Type (lsuc lzero))) = Type 1
-- an equation between two checked definitions, proved: the evidence checked at Π n. L n = R n
addz : N2 → N2
addz n = add2 n z2
idn : N2 → N2
idn n = n
#check add2-zero : (n : N2) → PathP (λ i → N2) (addz n) (idn n)
#same addz (s2 (s2 z2)) = s2 (s2 z2)
rfl2 : (n : N2) → PathP (λ i → N2) n n
rfl2 n = λ i → n
#fail
#check rfl2 : (n : N2) → PathP (λ i → N2) (addz n) (idn n)
-- the optimizer as a term: map fusion, a checked term producing the fused map and a proof that it
-- equals the two maps
lmapc : {S : Type} → (S → S) → Ls S → Ls S
lmapc f l = case l of lnl → lnl; lcs u r → lcs (f u) (rec r)
fuse : {S : Type} →
       (f g : S → S) →
       (R : Ls S → Ls S) × ((l : Ls S) → PathP (λ i → Ls S) (lmapc f (lmapc g l)) (R l))
fuse f g =
  (λ l → lmapc (λ x → f (g x)) l
  , λ l →
      case l return (λ y → PathP (λ i → Ls S) (lmapc f (lmapc g y)) (lmapc (λ x → f (g x)) y)) of
        lnl → λ i → lnl
        lcs u r → λ i → lcs (f (g u)) (rec r i))
twomaps : Ls N2 → Ls N2
twomaps l = lmapc s2 (lmapc s2 l)
fuse-s2 : (R : Ls N2 → Ls N2) × ((l : Ls N2) → PathP (λ i → Ls N2) (twomaps l) (R l))
fuse-s2 = fuse {N2} s2 s2
#same twomaps (lcs z2 (lcs (s2 z2) lnl)) = lcs (s2 (s2 z2)) (lcs (s2 (s2 (s2 z2))) lnl)
#same fst fuse-s2 (lcs z2 (lcs (s2 z2) lnl)) = lcs (s2 (s2 z2)) (lcs (s2 (s2 (s2 z2))) lnl)
-- a pair whose map is not proved equal to twomaps is not an optimizer of it
notopt : (R : Ls N2 → Ls N2) × ((l : Ls N2) → PathP (λ i → Ls N2) (R l) (R l))
notopt = (λ l → l , λ l i → l)
#fail
#check notopt : (R : Ls N2 → Ls N2) × ((l : Ls N2) → PathP (λ i → Ls N2) (twomaps l) (R l))
-- nested eliminations without a motive convert: the inner one's type is unknown
#check (λ S f g r i → lmapc f (lmapc g r)) : (S : Type) →
                                             (f g : S → S) →
                                             (r : Ls S) →
                                             PathP (λ i → Ls S) (lmapc f (lmapc g r))
                                               (lmapc f (lmapc g r))
-- multiplicities (B11): a binder at :0 is erased (it is not used), one at :1 is consumed exactly
-- once; a data type with a field at 1 is linear: its constructor is applied only in a primitive,
-- and a checked definition neither drops nor duplicates a value of it
data Tk = tk (n :1 N2)
primitive mkTk : N2 → Tk = λ n → tk n
useTk : Tk → N2
useTk t = case t of tk n → n
#fail
dropTk : Tk → N2
dropTk t = z2
#fail
dupTk : Tk → N2
dupTk t = case useTk t of z2 → useTk t; s2 k → k
#fail
mkTk2 : N2 → Tk
mkTk2 n = tk n
#fail
used0 : (n :0 N2) → N2
used0 n = n
fine0 : (n :0 N2) → N2
fine0 n = z2
once1 : (n :1 N2) → N2
once1 n = n
#fail
twice1 : (n :1 N2) → N2
twice1 n = add2 n n
-- a branch mentioning the scrutinee rebuilds it from the fields: one use
once2 : (n :1 N2) → N2
once2 n = case n of z2 → n; s2 k → z2
#usage fine0
#usage useTk
#usage lenl
